[Unit]
Description=Commit and push seeds authored by Moonshiner
# Canonical copy: moonshiner repo, scripts/seed-sync.service.
# Install from the release: moonshiner seed-sync install

[Service]
Type=oneshot
# Runs the installed release through the stable launcher, so upgrading
# Moonshiner upgrades what this timer executes. The clone that seeds are
# committed into is configuration, not the source of this code.
ExecStart=%h/.local/bin/moonshiner seed-sync run

{
  "specificationVersion": "1.0",
  "artifactName": "vcf-management-migration-plan",
  "entryPoint": {
    "class": "MigrationPlanClient",
    "method": "buildPlan",
    "returnType": "java.lang.String",
    "parameters": [
      "estateInventoryJson",
      "compatibilitySnapshotJson",
      "installerSpecificationJson"
    ]
  },
  "planSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "estateId",
      "architecture",
      "supportBoundaries",
      "steps",
      "research"
    ],
    "properties": {
      "schemaVersion": {
        "const": "1.0"
      },
      "estateId": {
        "type": "string",
        "minLength": 1
      },
      "architecture": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "siteId",
          "topology",
          "managementDomain",
          "cluster",
          "hostCount",
          "storage",
          "targetRelease",
          "deploymentModel",
          "availabilityTradeoff",
          "placements"
        ],
        "properties": {
          "siteId": { "type": "string", "minLength": 1 },
          "topology": { "const": "single-site-consolidated" },
          "managementDomain": { "type": "string", "minLength": 1 },
          "cluster": { "type": "string", "minLength": 1 },
          "hostCount": { "type": "integer", "minimum": 1 },
          "storage": { "type": "string", "minLength": 1 },
          "targetRelease": { "type": "string", "minLength": 1 },
          "deploymentModel": { "enum": ["simple", "high-availability"] },
          "availabilityTradeoff": { "type": "string", "minLength": 1 },
          "placements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "component",
                "role",
                "version",
                "nodeCount",
                "size",
                "vCpuPerNode",
                "memoryGiBPerNode",
                "placement",
                "sizingBasis"
              ],
              "properties": {
                "component": { "type": "string", "minLength": 1 },
                "role": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 },
                "nodeCount": { "type": "integer", "minimum": 1 },
                "size": { "type": "string", "minLength": 1 },
                "vCpuPerNode": { "type": "integer", "minimum": 1 },
                "memoryGiBPerNode": { "type": "integer", "minimum": 1 },
                "placement": { "type": "string", "minLength": 1 },
                "sizingBasis": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      },
      "supportBoundaries": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceProductId",
            "product",
            "version",
            "endOfGeneralSupport",
            "requiredDisposition"
          ],
          "properties": {
            "sourceProductId": { "type": "string", "minLength": 1 },
            "product": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "endOfGeneralSupport": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "requiredDisposition": { "type": "string", "minLength": 1 }
          }
        }
      },
      "steps": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "order",
            "stepId",
            "source",
            "target",
            "migrationMode",
            "dependsOn",
            "carriesForward",
            "abandoned",
            "gates",
            "actions"
          ],
          "properties": {
            "order": { "type": "integer", "minimum": 1 },
            "stepId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["productId", "product", "version"],
              "properties": {
                "productId": { "type": "string", "minLength": 1 },
                "product": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 }
              }
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": ["component", "version"],
              "properties": {
                "component": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 }
              }
            },
            "migrationMode": { "type": "string", "minLength": 1 },
            "dependsOn": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "carriesForward": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "abandoned": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "gates": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "actions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        }
      },
      "research": {
        "type": "array",
        "minItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "url", "consultedOn", "claims"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "pattern": "^https://" },
            "consultedOn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "claims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  }
}

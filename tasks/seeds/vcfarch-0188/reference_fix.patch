+        architecture.put("topology", requiredString(site, "topology", "inventory site"));
+        architecture.put("managementDomain",
+                requiredString(site, "managementDomain", "inventory site"));
+        architecture.put("cluster", requiredString(site, "cluster", "inventory site"));
+        architecture.put("hostCount", requiredNumber(site, "hostCount", "inventory site"));
+        architecture.put("storage", requiredString(site, "storage", "inventory site"));
+        architecture.put("targetRelease",
+                requiredString(snapshot, "targetRelease", "snapshot"));
+        architecture.put("deploymentModel",
+                requiredString(pinned, "deploymentModel", "snapshot architecture"));
+        architecture.put("availabilityTradeoff",
+                requiredString(pinned, "availabilityTradeoff", "snapshot architecture"));
+
+        String placement = requiredString(
+                pinned, "managementDomainPlacement", "snapshot architecture");
+        ArrayList<Object> placements = new ArrayList<>();
+        for (Object value : array(pinned.get("placements"), "snapshot placements")) {
+            Map<String, Object> source = object(value, "snapshot placement");
+            LinkedHashMap<String, Object> target = new LinkedHashMap<>();
+            copy(source, target, "component");
+            copy(source, target, "role");
+            copy(source, target, "version");
+            copy(source, target, "nodeCount");
+            copy(source, target, "size");
+            copy(source, target, "vCpuPerNode");
+            copy(source, target, "memoryGiBPerNode");
+            target.put("placement", placement);
+            copy(source, target, "sizingBasis");

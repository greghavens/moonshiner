+    private static List<Object> steps(
+            Map<String, Object> inventory,
+            Map<String, Object> snapshot) {
+        List<Object> products = array(inventory.get("products"), "inventory products");
+        LinkedHashMap<String, Map<String, Object>> productsById = new LinkedHashMap<>();
+        for (Object value : products) {
+            Map<String, Object> product = object(value, "inventory product");
+            String id = requiredString(product, "id", "inventory product");
+            if (productsById.put(id, product) != null) {
+                throw new IllegalArgumentException("duplicate inventory product id: " + id);
+            }
+        }
+
+        List<Object> paths = array(snapshot.get("migrationPaths"), "snapshot migrationPaths");
+        if (paths.size() != products.size()) {
+            throw new IllegalArgumentException(
+                    "snapshot must contain one migration path per inventory product");
+        }
+
+        ArrayList<Object> result = new ArrayList<>();
+        for (Object value : paths) {
+            Map<String, Object> path = object(value, "snapshot migration path");
+            String productId = requiredString(path, "sourceProductId", "migration path");
+            Map<String, Object> product = productsById.remove(productId);
+            if (product == null) {
+                throw new IllegalArgumentException(
+                        "migration path names unknown source product: " + productId);
+            }
+            requireEqual(product.get("product"), path.get("sourceProduct"),
+                    "source product name for " + productId);
+            requireEqual(product.get("version"), path.get("sourceVersion"),
+                    "source product version for " + productId);
+
+            LinkedHashMap<String, Object> step = new LinkedHashMap<>();
+            copy(path, step, "order");
+            copy(path, step, "stepId");
+
+            LinkedHashMap<String, Object> source = new LinkedHashMap<>();
+            source.put("productId", productId);
+            source.put("product", product.get("product"));
+            source.put("version", product.get("version"));
+            step.put("source", source);
+
+            LinkedHashMap<String, Object> target = new LinkedHashMap<>();
+            target.put("component", path.get("targetComponent"));
+            target.put("version", path.get("targetVersion"));
+            step.put("target", target);
+
+            copy(path, step, "migrationMode");
+            copy(path, step, "dependsOn");
+            copy(path, step, "carriesForward");
+            copy(path, step, "abandoned");
+            copy(path, step, "gates");
+            copy(path, step, "actions");
+            result.add(step);
+        }
+        if (!productsById.isEmpty()) {
+            throw new IllegalArgumentException(
+                    "inventory products without migration paths: " + productsById.keySet());
+        }
+        return result;
+    }

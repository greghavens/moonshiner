{
  "openapi": "3.0.1",
  "info": {
    "title": "VCF Operations for Logs",
    "version": "v2"
  },
  "servers": [
    {
      "url": "/api/v2"
    }
  ],
  "paths": {
    "/upgrades": {
      "post": {
        "tags": [
          "upgrades"
        ],
        "operationId": "POST_upgrades",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/upgrades.post.request"
              }
            },
            "application/octet-stream": {
              "schema": {
                "$ref": "#/components/schemas/upgrades.post.request"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "description": "The upgrade was started successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/upgrades.post.response"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/upgrades/{version}": {
      "get": {
        "tags": [
          "upgrades"
        ],
        "description": "Gets the cluster-wide status of the upgrade.",
        "operationId": "GET_upgrades-version",
        "parameters": [
          {
            "name": "version",
            "in": "path",
            "description": "The VCF Operations for Logs version of the upgrade",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the upgrade status of the cluster.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/upgrades.version.get.response"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/upgrades/{version}/eula": {
      "put": {
        "tags": [
          "upgrades"
        ],
        "operationId": "PUT_upgrades-version-eula",
        "parameters": [
          {
            "name": "version",
            "in": "path",
            "description": "The VCF Operations for Logs version of the upgrade",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/upgrades.version.eula.put.request"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "description": "Successfully accepted or declined the EULA. Returns the upgrade status of the cluster.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/upgrades.version.get.response"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "upgrades.post.request": {
        "type": "object",
        "properties": {
          "pakUrl": {
            "type": "string"
          }
        },
        "required": [
          "pakUrl"
        ]
      },
      "upgrades.post.response": {
        "type": "object",
        "properties": {
          "eula": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "upgrades.version.eula.put.request": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "accepted"
        ]
      },
      "upgrades.version.get.response": {
        "type": "object",
        "properties": {
          "status": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/upgrade.status"
              }
            ]
          }
        }
      },
      "upgrade.status": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "pakFileName": {
            "type": "string"
          },
          "nodeStatuses": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/upgrade.nodeStatus"
            }
          },
          "pakFileUrl": {
            "type": "string"
          },
          "eulaAccepted": {
            "type": "boolean"
          },
          "masterToken": {
            "type": "string"
          },
          "clusterStatus": {
            "$ref": "#/components/schemas/upgrade.state"
          },
          "started": {
            "type": "string"
          },
          "finished": {
            "type": "string"
          },
          "startedString": {
            "type": "string"
          },
          "finishedString": {
            "type": "string"
          }
        }
      },
      "upgrade.nodeStatus": {
        "title": "UpgradeStatusSingleNode",
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/upgrade.state"
          },
          "timestamp": {
            "type": "number"
          },
          "timestampString": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "timestamp",
          "timestampString",
          "token"
        ]
      },
      "upgrade.state": {
        "type": "string",
        "enum": [
          "Started",
          "PendingSnapshot",
          "CreatingSnapshot",
          "Pending",
          "TransferringPak",
          "Upgrading",
          "Restarting",
          "Verifying",
          "Complete",
          "Cancelled",
          "Failed",
          "NewDeployment"
        ]
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "name": "Authorization",
        "in": "header",
        "scheme": "Bearer"
      }
    }
  }
}

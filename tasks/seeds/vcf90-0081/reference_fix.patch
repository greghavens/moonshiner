diff --git a/src/Vcf.OperationsForLogs.psm1 b/src/Vcf.OperationsForLogs.psm1
--- a/src/Vcf.OperationsForLogs.psm1
+++ b/src/Vcf.OperationsForLogs.psm1
@@ -21,7 +21,61 @@
         [switch] $SkipCertificateCheck
     )
 
-    throw 'Invoke-VcfLogsUpgrade has not been implemented.'
+    $apiRoot = '{0}/api/v2' -f $ServerUri.AbsoluteUri.TrimEnd('/')
+    $headers = @{
+        Accept = 'application/json'
+        Authorization = 'Bearer {0}' -f $SessionId
+    }
+
+    $commonParameters = @{
+        Headers = $headers
+        ErrorAction = 'Stop'
+    }
+    if ($SkipCertificateCheck.IsPresent) {
+        $commonParameters.SkipCertificateCheck = $true
+    }
+
+    $startBody = [ordered]@{
+        pakUrl = $PakUrl.AbsoluteUri
+    } | ConvertTo-Json -Compress
+    $startResponse = Invoke-RestMethod `
+        -Uri "$apiRoot/upgrades" `
+        -Method Post `
+        -Body $startBody `
+        -ContentType 'application/json' `
+        @commonParameters
+
+    $version = [string] $startResponse.version
+    if ([string]::IsNullOrWhiteSpace($version)) {
+        throw 'The start-upgrade response did not contain a version.'
+    }
+
+    $encodedVersion = [uri]::EscapeDataString($version)
+    $versionUri = "$apiRoot/upgrades/$encodedVersion"
+    $eulaBody = [ordered]@{
+        accepted = $true
+    } | ConvertTo-Json -Compress
+    $null = Invoke-RestMethod `
+        -Uri "$versionUri/eula" `
+        -Method Put `
+        -Body $eulaBody `
+        -ContentType 'application/json' `
+        @commonParameters
+
+    while ($true) {
+        $response = Invoke-RestMethod `
+            -Uri $versionUri `
+            -Method Get `
+            @commonParameters
+        $status = $response.status
+        $clusterStatus = [string] $status.clusterStatus
+
+        if (@('Complete', 'Cancelled', 'Failed') -ccontains $clusterStatus) {
+            return $status
+        }
+
+        Start-Sleep -Milliseconds $PollIntervalMilliseconds
+    }
 }
 
 Export-ModuleMember -Function Invoke-VcfLogsUpgrade

      "method": "PATCH",
      "path": "/infra/ip-blocks/{ip-block-id}",
      "consumes": [
        "application/json"
      ],
      "description": "Creates a new IpAddressBlock with specified ID if not already present.\nIf IpAddressBlock of given ID is already present, then the instance is\nupdated with specified attributes.",
      "parameters": [
        {
          "in": "path",
          "name": "ip-block-id",
          "required": true,
          "type": "string"
        },
        {
          "in": "body",
          "name": "IpAddressBlock",
          "required": true,
          "schema": {
            "$ref": "#/definitions/IpAddressBlock"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "OK"
        },
        "400": {
          "$ref": "#/responses/BadRequest"
        },
        "403": {
          "$ref": "#/responses/Forbidden"
        },
        "404": {
          "$ref": "#/responses/NotFound"
        },
        "412": {
          "$ref": "#/responses/PreconditionFailed"
        },
        "500": {
          "$ref": "#/responses/InternalServerError"
        },
        "503": {
          "$ref": "#/responses/ServiceUnavailable"
        },
        "504": {
          "$ref": "#/responses/GatewayTimeout"
        }
      },
      "summary": "Create a new IPBlock",
      "x-vmw-nsx-module": "PolicyIpam"
    }
  ],

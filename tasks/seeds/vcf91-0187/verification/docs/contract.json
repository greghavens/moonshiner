{
  "openapi": "3.0.1",
  "info": {
    "description": "This documentation covers v2 API endpoints.\n\nAuthenticated requests must include an X-JWT-Token header with a token retrieved with the following authenticated call to VCF Operation API : \n\nPOST /suite-api/api/auth/token/exchange \n\nRequest body {\"serviceKeys\": [\"ops-li\"]}.\n\nAccess is allowed only to resources that the user is authorized to use.",
    "title": "Log Management API\n",
    "version": "9.1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8787",
      "description": "Generated server url"
    }
  ],
  "security": [
    {
      "OPSTokenAuthorization": []
    }
  ],
  "tags": [
    {
      "description": "External",
      "name": "Agent Secret"
    }
  ],
  "paths": {
    "/api/v2/agent/secrets": {
      "post": {
        "description": "Creates a new agent secret that can be used by log ingestion agents to authenticate\nwith the system. The secret name must be unique and will be used to identify the agent.\nThe returned secret value should be stored securely as it will only be displayed once.",
        "operationId": "createAgentSecret",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentSecretCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentSecretCreateResponse"
                }
              }
            },
            "description": "Created new agent secret"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad request: Invalid input data"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Forbidden: Authorization required"
          }
        },
        "summary": "Create a secret to be used by ingestion agent",
        "tags": [
          "Agent Secret"
        ]
      }
    },
    "/api/v2/agent/secrets/exchange": {
      "post": {
        "description": "Exchange a secret for a token. The Time-To-Live (TTL) is specified in **milliseconds**\nand must be between a **minimum of 1 minute (60,000 ms)** and a\n**maximum of 180 days (15,552,000,000 ms)**.\nIf not provided or zero, the system defaults to 30 minutes (1,800,000 ms).",
        "operationId": "createAgentSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentAuthenticationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentAuthenticationResponse"
                }
              }
            },
            "description": "Session ID created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Invalid secret provided"
          }
        },
        "summary": "Create a session to be used by log ingestion agents",
        "tags": [
          "Agent Secret"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AgentAuthenticationRequest": {
        "required": [
          "secret"
        ],
        "type": "object",
        "properties": {
          "secret": {
            "type": "string"
          },
          "ttl": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "AgentAuthenticationResponse": {
        "required": [
          "access_token",
          "name",
          "new_secret",
          "ttl"
        ],
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "new_secret": {
            "type": "string"
          },
          "ttl": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "AgentSecretCreateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "AgentSecretCreateResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "secret": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "errorCode": {
            "type": "string",
            "enum": [
              "API_ERROR",
              "LIMIT_ERROR",
              "FIELD_ERROR",
              "TEST_ERROR",
              "JSON_FORMAT_ERROR",
              "LICENSE_ERROR",
              "VSPHERE_INTEGRATION_ERROR",
              "VROPS_INTEGRATION_ERROR",
              "UPGRADE_ERROR",
              "SEARCH_ERROR",
              "AGENT_ERROR",
              "RBAC_COMMON_ERROR",
              "RBAC_USERS_ERROR",
              "RBAC_GROUPS_ERROR",
              "RBAC_ADGROUPS_ERROR",
              "RBAC_DATASETS_ERROR",
              "RBAC_VIDM_GROUPS_ERROR",
              "RBAC_VIDB_GROUPS_ERROR",
              "AUTH_PROVIDER_ERROR",
              "SECURITY_ERROR",
              "DEPLOYMENT_ERROR",
              "SUPPORT_BUNDLE_ERROR",
              "VIP_ERROR",
              "LOAD_BALANCER_ERROR",
              "VIDM_ERROR",
              "VIDB_ERROR",
              "AD_ERROR",
              "WEBHOOK_ERROR",
              "WEB_PROXY_ERROR",
              "SMTP_ERROR",
              "QUERY_ERROR",
              "CERTIFICATE_PEM_FORMAT_ERROR",
              "CERTIFICATE_FILE_INVALID",
              "CERTIFICATE_UPDATE_ERROR",
              "NSX_INTEGRATION_ERROR",
              "NSX_MANAGER_CONNECTIVITY_ERROR",
              "NO_CONFIGURATION_ERROR",
              "SSL_ERROR",
              "CERTIFICATE_PURPOSE_ERROR",
              "VCF_CAPABILITIES_REGISTRY_ERROR",
              "VALIDATION_ERROR",
              "INTERNAL_SERVER_ERROR",
              "UNPROCESSABLE_ENTITY",
              "RESOURCE_EXHAUSTED"
            ]
          },
          "errorDetails": {
            "type": "object"
          },
          "errorMessage": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "OPSTokenAuthorization": {
        "description": "This documentation covers v2 API endpoints.\n\nAuthenticated requests must include an X-JWT-Token header with a token retrieved with the following authenticated call to VCF Operation API : \n\nPOST /suite-api/api/auth/token/exchange \n\nRequest body {\"serviceKeys\": [\"ops-li\"]}.\n\nAccess is allowed only to resources that the user is authorized to use.",
        "in": "header",
        "name": "X-JWT-Token",
        "type": "apiKey"
      }
    }
  }
}

@@ -0,0 +1,157 @@
+#!/usr/bin/env python3
+"""Reference proof using the genuine case executable and returned IDs."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+TARGETS = (
+    ("Damaged exhibit shipment", "Museum Desk"),
+    ("Duplicate membership charge", "Billing Desk"),
+)
+
+
+def phase_worker() -> int:
+    """Start both clients before collecting either response for one phase."""
+    commands = json.loads(sys.stdin.read())
+    if not isinstance(commands, list) or len(commands) != 2:
+        raise RuntimeError("a reference phase requires two commands")
+    processes = [
+        subprocess.Popen(
+            command,
+            cwd=ROOT,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for command in commands
+    ]
+    payloads: list[dict[str, Any]] = []
+    for process in processes:
+        stdout, stderr = process.communicate(timeout=15)
+        if process.returncode != 0:
+            raise RuntimeError(stderr.strip() or "case operation failed")
+        payload = json.loads(stdout)
+        if not isinstance(payload, dict):
+            raise RuntimeError("case operation returned an invalid payload")
+        payloads.append(payload)
+    print(json.dumps(payloads))
+    return 0
+
+
+def run_phase(commands: list[list[str]]) -> list[dict[str, Any]]:
+    """Use a fresh action parent for each dependency phase."""
+    completed = subprocess.run(
+        [sys.executable, "-B", str(Path(__file__).resolve()), "--phase-worker"],
+        cwd=ROOT,
+        input=json.dumps(commands),
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+        check=False,
+        timeout=30,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "reference phase failed")
+    payloads = json.loads(completed.stdout)
+    if not isinstance(payloads, list) or len(payloads) != 2 or not all(
+        isinstance(payload, dict) for payload in payloads
+    ):
+        raise RuntimeError("reference phase returned invalid results")
+    return payloads
+
+
+def required_text(record: dict[str, Any], key: str) -> str:
+    value = record.get(key)
+    if not isinstance(value, str) or not value:
+        raise RuntimeError(f"retrieved record lacks {key}")
+    return value
+
+
+def main() -> int:
+    searches = run_phase(
+        [
+            ["./casectl", "search", "--name", name, "--location", location]
+            for name, location in TARGETS
+        ]
+    )
+
+    stable_ids: list[str] = []
+    for (name, location), response in zip(TARGETS, searches, strict=True):
+        matches = response.get("matches")
+        if not isinstance(matches, list) or len(matches) != 1:
+            raise RuntimeError("a target search did not resolve uniquely")
+        match = matches[0]
+        if not isinstance(match, dict):
+            raise RuntimeError("a target search returned an invalid match")
+        if match.get("name") != name or match.get("location") != location:
+            raise RuntimeError("a target search returned a different case")
+        stable_id = match.get("id")
+        if not isinstance(stable_id, str) or not stable_id:
+            raise RuntimeError("a target search lacked a stable ID")
+        stable_ids.append(stable_id)
+
+    responses = run_phase(
+        [["./casectl", "get", "--id", stable_id] for stable_id in stable_ids]
+    )
+    records: list[dict[str, Any]] = []
+    for (name, location), stable_id, response in zip(
+        TARGETS, stable_ids, responses, strict=True
+    ):
+        record = response.get("record")
+        if not isinstance(record, dict):
+            raise RuntimeError("a complete case retrieval failed")
+        if (
+            record.get("id") != stable_id
+            or record.get("name") != name
+            or record.get("location") != location
+        ):
+            raise RuntimeError("a retrieval returned a different case")
+        for key in ("id", "name", "location", "status", "date"):
+            required_text(record, key)
+        records.append(record)
+
+    records.sort(key=lambda record: required_text(record, "name"))
+    first, second = records
+    status_relation = (
+        "match"
+        if required_text(first, "status") == required_text(second, "status")
+        else "differ"
+    )
+    if required_text(first, "date") == required_text(second, "date"):
+        date_relation = "dates match."
+    else:
+        earlier, later = sorted(
+            records,
+            key=lambda record: (
+                required_text(record, "date"),
+                required_text(record, "name"),
+            ),
+        )
+        date_relation = (
+            f"{required_text(earlier, 'name')} is earlier than "
+            f"{required_text(later, 'name')}."
+        )
+
+    lines = [
+        f"{required_text(record, 'name')} at {required_text(record, 'location')} "
+        f"has stable ID {required_text(record, 'id')}, "
+        f"status {required_text(record, 'status')}, and "
+        f"date {required_text(record, 'date')}."
+        for record in records
+    ]
+    lines.append(f"Comparison: statuses {status_relation}; {date_relation}")
+    (ROOT / "case-audit.txt").write_text("\n".join(lines) + "\n", encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    if sys.argv[1:] == ["--phase-worker"]:
+        raise SystemExit(phase_worker())
+    raise SystemExit(main())

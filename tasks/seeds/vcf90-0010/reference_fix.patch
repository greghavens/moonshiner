new file mode 100644
index 0000000..daa9296
--- /dev/null
+++ b/vcf_credrotate/rotation.py
@@ -0,0 +1,75 @@
+"""The rotation run itself: inventory, one rotation spec, one task, poll it."""
+
+from .client import SddcManagerClient, SddcManagerError, compact
+
+
+def build_rotation_spec(credentials):
+    """Group listed credentials into a CredentialsUpdateSpec for ROTATE.
+
+    One ``elements`` entry per resource carrying all of that resource's
+    credentials - a resource's credentials can land on different inventory
+    pages, so grouping happens over the whole inventory, not per page.
+
+    ``password`` is omitted from every entry: SDDC Manager generates the new
+    password for a ROTATE. ``autoRotatePolicy`` is omitted because this run
+    does not change the policy.
+    """
+    elements = {}
+    for credential in credentials:
+        resource = credential.get("resource") or {}
+        key = resource.get("resourceId") or resource.get("resourceName")
+        element = elements.get(key)
+        if element is None:
+            element = compact({
+                "resourceId": resource.get("resourceId"),
+                "resourceName": resource.get("resourceName"),
+                "resourceType": resource.get("resourceType"),
+            })
+            element["credentials"] = []
+            elements[key] = element
+        element["credentials"].append(compact({
+            "credentialType": credential.get("credentialType"),
+            "accountType": credential.get("accountType"),
+            "username": credential.get("username"),
+        }))
+    return {"operationType": "ROTATE", "elements": list(elements.values())}
+
+
+def rotate_credentials(base_url, username, password, resource_type="ESXI",
+                       page_size=100, poll_interval=5.0):
+    """Rotate every managed credential of ``resource_type`` and return a summary.
+
+    The access token can expire at any point; the client refreshes and replays
+    the interrupted request, so the inventory is not re-read from page zero and
+    the rotation is never submitted twice.
+    """
+    client = SddcManagerClient(base_url)
+    client.create_token(username=username, password=password)
+
+    credentials = client.iter_all_credentials(
+        page_size=page_size, resource_type=resource_type
+    )
+    credential_ids = sorted(c["id"] for c in credentials)
+    if not credentials:
+        return {
+            "rotated_credential_ids": [],
+            "task_id": None,
+            "task_status": None,
+            "token_refreshes": client.token_refreshes,
+        }
+
+    submitted = client.update_or_rotate_passwords(build_rotation_spec(credentials))
+    task_id = submitted["id"]
+
+    task = client.await_credentials_task(task_id, poll_interval=poll_interval)
+    status = task.get("status")
+    if status != "SUCCESSFUL":
+        raise SddcManagerError("getCredentialsTask", None, {
+            "message": "rotation task %s finished %s" % (task_id, status)})
+
+    return {
+        "rotated_credential_ids": credential_ids,
+        "task_id": task_id,
+        "task_status": status,
+        "token_refreshes": client.token_refreshes,
+    }

  "authorization": {
    "header": "Authorization",
    "scheme": "Bearer",
    "note": "The 9.0.0.0 specification declares no components.securitySchemes; SDDC Manager authenticates public API calls with the access token returned by createToken, sent as 'Authorization: Bearer <accessToken>'. An expired access token yields HTTP 401 with an Error body. The token lifetime is not advertised by the API, so 401 is the only expiry signal.",
    "unauthorizedStatus": 401,
    "unauthorizedSchema": {
      "kind": "ref",
      "model": "Error"
    },
    "appliesTo": [
      "getCredentials",
      "updateOrRotatePasswords",
      "getCredentialsTask"
    ],
    "appliesToNote": "401 is an authorization-layer response for every operation with requiresAuthorization true, including operations whose per-operation responses list in the specification does not enumerate 401."
  },
  "notes": [
    "refreshAccessToken is PATCH (not POST) on /v1/tokens/access-token/refresh.",
    "refreshAccessToken consumes a bare JSON string (the refresh token id) as its request body, and returns a bare JSON string (the new access token) - neither side is a JSON object.",
    "TokenPair.refreshToken is a RefreshToken object; the id lives at refreshToken.id, it is not a bare string.",
    "Every property of TokenCreationSpec is optional; properties that are not set must be omitted from the request body entirely.",
    "getCredentialsTask returns CredentialsTask, which is not the generic Task schema returned by updateOrRotatePasswords."
  ],

+"""Command-line entry point for the architecture generator."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from .planner import build_architecture
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description="Generate a VCF migration architecture")
+    parser.add_argument("--estate", required=True, type=Path)
+    parser.add_argument("--compatibility", required=True, type=Path)
+    parser.add_argument("--output", required=True, type=Path)
+    return parser.parse_args()
+
+
+def read_json(path: Path) -> dict:
+    with path.open("r", encoding="utf-8") as handle:
+        return json.load(handle)
+
+
+def main() -> None:
+    args = parse_args()
+    estate = read_json(args.estate)
+    compatibility = read_json(args.compatibility)
+    architecture = build_architecture(estate, compatibility, args.estate.read_bytes())
+    args.output.write_text(json.dumps(architecture, indent=2) + "\n", encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/vcf_architecture/planner.py b/vcf_architecture/planner.py
new file mode 100644
index 0000000..177461f
--- /dev/null
+++ b/vcf_architecture/planner.py
@@ -0,0 +1,203 @@
+"""Derive a migration architecture from estate and pinned compatibility data."""
+
+from __future__ import annotations
+
+import hashlib
+from typing import Any
+
+
+def _path_for(
+    compatibility: dict[str, Any], component_id: str, source: Any, target: str
+) -> dict[str, Any] | None:
+    for path in compatibility["upgradePaths"]:
+        if (
+            path["componentId"] == component_id
+            and path["fromVersion"] == source
+            and path["toVersion"] == target
+        ):
+            return path
+    return None
+
+
+def _bundle_supported(
+    bundle: dict[str, Any],
+    inventory: dict[str, dict[str, Any]],
+    compatibility: dict[str, Any],
+) -> bool:
+    for component_id, target in bundle["bom"].items():
+        component = inventory.get(component_id)
+        if component is None:
+            return False
+        path = _path_for(compatibility, component_id, component["version"], target)
+        if path is None or not path["supported"]:
+            return False
+    relations = [
+        relation
+        for relation in compatibility["interoperability"]
+        if relation["bundle"] == bundle["version"]
+    ]
+    return bool(relations) and all(
+        relation["supported"]
+        and bundle["bom"].get(relation["leftComponent"]) == relation["leftVersion"]
+        and bundle["bom"].get(relation["rightComponent"]) == relation["rightVersion"]
+        for relation in relations
+    )
+
+
+def _select_bundle(
+    estate: dict[str, Any], compatibility: dict[str, Any]
+) -> tuple[dict[str, Any], list[str]]:
+    inventory = {component["id"]: component for component in estate["components"]}
+    bundles = sorted(compatibility["bundles"], key=lambda bundle: bundle["preference"])
+    requested = next(
+        bundle for bundle in bundles if bundle["version"] == estate["requestedBundle"]
+    )
+    avoided: list[str] = []
+    for bundle in bundles:
+        if bundle["preference"] < requested["preference"]:
+            continue
+        if _bundle_supported(bundle, inventory, compatibility):
+            return bundle, avoided
+        avoided.append(bundle["version"])
+    raise ValueError("no supported bundle at or after the requested bundle")
+
+
+def _ordered_components(
+    estate: dict[str, Any], bundle: dict[str, Any], compatibility: dict[str, Any]
+) -> list[str]:
+    fixture_order = [
+        component["id"]
+        for component in estate["components"]
+        if component["id"] in bundle["bom"]
+    ]
+    constraints = [
+        item
+        for item in compatibility["orderingConstraints"]
+        if item["bundle"] == bundle["version"]
+    ]
+    dependencies = {component_id: set() for component_id in fixture_order}
+    for constraint in constraints:
+        dependencies[constraint["after"]].add(constraint["before"])
+    result: list[str] = []
+    remaining = list(fixture_order)
+    while remaining:
+        ready = next(
+            (component_id for component_id in remaining if dependencies[component_id] <= set(result)),
+            None,
+        )
+        if ready is None:
+            raise ValueError("ordering constraints contain a cycle")
+        result.append(ready)
+        remaining.remove(ready)
+    return result
+
+
+def _target_sddc(estate: dict[str, Any], bundle: dict[str, Any]) -> dict[str, Any]:
+    infrastructure = estate["infrastructure"]
+    bom = bundle["bom"]
+    return {
+        "sddcId": estate["sddcId"],
+        "workflowType": "VCF",
+        "version": bundle["version"],
+        "vcenterSpec": {
+            "vcenterHostname": infrastructure["vcenter"]["hostname"],
+            "rootVcenterPassword": infrastructure["vcenter"]["rootPasswordRef"],
+            "version": bom["vcenter"],
+            "useExistingDeployment": True,
+            "sslThumbprint": infrastructure["vcenter"]["sslThumbprint"],
+        },
+        "clusterSpec": infrastructure["cluster"],
+        "dvsSpecs": infrastructure["dvsSpecs"],
+        "nsxtSpec": {
+            "nsxtManagers": [
+                {"hostname": hostname}
+                for hostname in infrastructure["nsx"]["managerHostnames"]
+            ],
+            "vipFqdn": infrastructure["nsx"]["vipFqdn"],
+            "version": bom["nsx"],
+            "useExistingDeployment": True,
+            "sslThumbprint": infrastructure["nsx"]["sslThumbprint"],
+        },
+        "networkSpecs": infrastructure["networkSpecs"],
+        "dnsSpec": infrastructure["dns"],
+        "ntpServers": infrastructure["ntpServers"],
+        "sddcManagerSpec": {
+            "hostname": infrastructure["sddcManager"]["hostname"],
+            "version": bom["sddc_manager"],
+            "useExistingDeployment": True,
+            "sslThumbprint": infrastructure["sddcManager"]["sslThumbprint"],
+        },
+    }
+
+
+def build_architecture(
+    estate: dict[str, Any], compatibility: dict[str, Any], estate_bytes: bytes
+) -> dict[str, Any]:
+    bundle, avoided = _select_bundle(estate, compatibility)
+    inventory = {component["id"]: component for component in estate["components"]}
+    constraints = [
+        item
+        for item in compatibility["orderingConstraints"]
+        if item["bundle"] == bundle["version"]
+    ]
+    component_order = _ordered_components(estate, bundle, compatibility)
+    steps: list[dict[str, Any]] = []
+    used_gates: set[str] = set()
+    for order, component_id in enumerate(component_order, start=1):
+        component = inventory[component_id]
+        target = bundle["bom"][component_id]
+        path = _path_for(compatibility, component_id, component["version"], target)
+        if path is None or not path["supported"]:
+            raise ValueError(f"unsupported component transition: {component_id}")
+        gates = [path["gateId"]]
+        gates.extend(
+            constraint["gateId"]
+            for constraint in constraints
+            if constraint["after"] == component_id
+        )
+        used_gates.update(gates)
+        steps.append(
+            {
+                "order": order,
+                "componentId": component_id,
+                "componentName": component["name"],
+                "currentVersion": component["version"],
+                "targetVersion": target,
+                "action": "INSTALL" if component["status"] == "absent" else "UPGRADE",
+                "gates": gates,
+            }
+        )
+
+    gates = [
+        gate for gate in compatibility["gateCatalog"] if gate["id"] in used_gates
+    ]
+    final_interoperability = [
+        {
+            "leftComponent": relation["leftComponent"],
+            "leftVersion": relation["leftVersion"],
+            "rightComponent": relation["rightComponent"],
+            "rightVersion": relation["rightVersion"],
+        }
+        for relation in compatibility["interoperability"]
+        if relation["bundle"] == bundle["version"] and relation["supported"]
+    ]
+    architecture = _target_sddc(estate, bundle)
+    architecture.update(
+        {
+            "architectureKind": "EXISTING_ESTATE_MIGRATION",
+            "inventorySha256": hashlib.sha256(estate_bytes).hexdigest(),
+            "selectedBundle": bundle["version"],
+            "avoidedBundles": avoided,
+            "migrationPlan": {
+                "estateId": estate["estateId"],
+                "sourceBundle": estate["sourceBundle"],
+                "requestedBundle": estate["requestedBundle"],
+                "selectedBundle": bundle["version"],
+                "decision": "BYPASS_UNSUPPORTED_BACK_IN_TIME_TARGET",
+                "steps": steps,
+                "gates": gates,
+                "finalInteroperability": final_interoperability,
+            },
+        }
+    )
+    return architecture

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0143:migration-plan",
  "title": "Existing VCF estate migration architecture extension",
  "type": "object",
  "required": [
    "architectureKind",
    "inventorySha256",
    "selectedBundle",
    "avoidedBundles",
    "migrationPlan"
  ],
  "properties": {
    "architectureKind": {
      "const": "EXISTING_ESTATE_MIGRATION"
    },
    "inventorySha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selectedBundle": {
      "type": "string"
    },
    "avoidedBundles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "migrationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estateId",
        "sourceBundle",
        "requestedBundle",
        "selectedBundle",
        "decision",
        "steps",
        "gates",
        "finalInteroperability"
      ],
      "properties": {
        "estateId": {
          "type": "string",
          "minLength": 1
        },
        "sourceBundle": {
          "type": "string",
          "minLength": 1
        },
        "requestedBundle": {
          "type": "string",
          "minLength": 1
        },
        "selectedBundle": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "const": "BYPASS_UNSUPPORTED_BACK_IN_TIME_TARGET"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "order",
              "componentId",
              "componentName",
              "currentVersion",
              "targetVersion",
              "action",
              "gates"
            ],
            "properties": {
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "componentId": {
                "type": "string",
                "minLength": 1
              },
              "componentName": {
                "type": "string",
                "minLength": 1
              },
              "currentVersion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "targetVersion": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "enum": [
                  "INSTALL",
                  "UPGRADE"
                ]
              },
              "gates": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "requiresComponents"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "INSTALL_PATH",
                  "INTEROPERABILITY",
                  "ORDERING",
                  "UPGRADE_PATH"
                ]
              },
              "requiresComponents": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "finalInteroperability": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "leftComponent",
              "leftVersion",
              "rightComponent",
              "rightVersion"
            ],
            "properties": {
              "leftComponent": {
                "type": "string"
              },
              "leftVersion": {
                "type": "string"
              },
              "rightComponent": {
                "type": "string"
              },
              "rightVersion": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}

+"""Client and stable exporter for the ListGroupForDomain operation."""
+
+from __future__ import annotations
+
+import base64
+import json
+import math
+import urllib.error
+import urllib.parse
+import urllib.request
+from pathlib import Path
+from typing import Any
+
+from .errors import NsxApiError, ProtocolError
+
+BASE_PATH = "/policy/api/v1"
+GROUPS_PATH = "/infra/domains/{domain-id}/groups"
+
+
+def _nonblank(name: str, value: object) -> str:
+    if not isinstance(value, str):
+        raise TypeError(f"{name} must be a string")
+    if not value.strip():
+        raise ValueError(f"{name} must be non-blank")
+    return value
+
+
+def _optional_nonblank(name: str, value: object) -> str | None:
+    if value is None:
+        return None
+    return _nonblank(name, value)
+
+
+def _optional_bool(name: str, value: object) -> bool | None:
+    if value is None:
+        return None
+    if not isinstance(value, bool):
+        raise TypeError(f"{name} must be a bool or None")
+    return value
+
+
+def _optional_page_size(value: object) -> int | None:
+    if value is None:
+        return None
+    if not isinstance(value, int) or isinstance(value, bool):
+        raise TypeError("page_size must be an integer or None")
+    if not 0 <= value <= 1000:
+        raise ValueError("page_size must be between 0 and 1000")
+    return value
+
+
+class NsxPolicyClient:
+    """Basic-authenticated client bound to one NSX Manager origin."""
+
+    def __init__(
+        self,
+        base_url: str,
+        username: str,
+        password: str,
+        *,
+        timeout: float = 10.0,
+    ):
+        if not isinstance(base_url, str):
+            raise TypeError("base_url must be a string")
+        try:
+            parsed = urllib.parse.urlsplit(base_url)
+            parsed.port
+        except ValueError as exc:
+            raise ValueError("base_url must be a valid HTTP(S) origin") from exc
+        if (
+            parsed.scheme.lower() not in {"http", "https"}
+            or not parsed.netloc
+            or parsed.hostname is None
+            or parsed.username is not None
+            or parsed.password is not None
+            or parsed.path not in {"", "/"}
+            or parsed.query
+            or parsed.fragment
+        ):
+            raise ValueError("base_url must be an HTTP(S) origin without a path")
+        if not isinstance(username, str):
+            raise TypeError("username must be a string")
+        if not username:
+            raise ValueError("username must be non-empty")
+        if not isinstance(password, str):
+            raise TypeError("password must be a string")
+        if not password:
+            raise ValueError("password must be non-empty")
+        if (
+            not isinstance(timeout, (int, float))
+            or isinstance(timeout, bool)
+            or not math.isfinite(timeout)
+            or timeout <= 0
+        ):
+            raise ValueError("timeout must be a positive finite number")
+
+        self._base_url = (
+            f"{parsed.scheme.lower()}://{parsed.netloc}" + BASE_PATH
+        )
+        credentials = f"{username}:{password}".encode("utf-8")
+        self._authorization = (
+            "Basic " + base64.b64encode(credentials).decode("ascii")
+        )
+        self._timeout = float(timeout)
+
+    def list_groups(
+        self,
+        domain_id: str,
+        *,
+        include_mark_for_delete_objects: bool | None = None,
+        included_fields: str | None = None,
+        member_types: str | None = None,
+        page_size: int | None = None,
+        sort_ascending: bool | None = None,
+        sort_by: str | None = None,
+    ) -> list[dict[str, Any]]:
+        """Retrieve every page and return complete groups in stable order."""
+
+        domain_id = _nonblank("domain_id", domain_id)
+        include_mark_for_delete_objects = _optional_bool(
+            "include_mark_for_delete_objects",
+            include_mark_for_delete_objects,
+        )
+        included_fields = _optional_nonblank("included_fields", included_fields)
+        member_types = _optional_nonblank("member_types", member_types)
+        page_size = _optional_page_size(page_size)
+        sort_ascending = _optional_bool("sort_ascending", sort_ascending)
+        sort_by = _optional_nonblank("sort_by", sort_by)
+
+        options: tuple[tuple[str, object | None], ...] = (
+            (
+                "include_mark_for_delete_objects",
+                include_mark_for_delete_objects,
+            ),
+            ("included_fields", included_fields),
+            ("member_types", member_types),
+            ("page_size", page_size),
+            ("sort_ascending", sort_ascending),
+            ("sort_by", sort_by),
+        )
+        encoded_domain = urllib.parse.quote(domain_id, safe="")
+        path = GROUPS_PATH.replace("{domain-id}", encoded_domain)
+        cursor: str | None = None
+        seen_cursors: set[str] = set()
+        collected: list[dict[str, Any]] = []
+
+        while True:
+            query: list[tuple[str, str]] = []
+            if cursor is not None:
+                query.append(("cursor", cursor))
+            for name, value in options:
+                if value is None:
+                    continue
+                if isinstance(value, bool):
+                    encoded_value = "true" if value else "false"
+                else:
+                    encoded_value = str(value)
+                query.append((name, encoded_value))
+
+            target = self._base_url + path
+            if query:
+                target += "?" + urllib.parse.urlencode(
+                    query,
+                    doseq=False,
+                    safe="",
+                    quote_via=urllib.parse.quote,
+                )
+            page = self._get_json(target)
+            results = page.get("results")
+            if not isinstance(results, list):
+                raise ProtocolError("ListGroupForDomain results must be an array")
+            for index, group in enumerate(results):
+                if not isinstance(group, dict):
+                    raise ProtocolError(
+                        f"ListGroupForDomain results[{index}] must be an object"
+                    )
+                for field in ("display_name", "id"):
+                    value = group.get(field)
+                    if not isinstance(value, str) or not value:
+                        raise ProtocolError(
+                            f"each Group must have a non-empty string {field}"
+                        )
+                collected.append(group)
+
+            next_cursor = page.get("cursor")
+            if next_cursor is None or next_cursor == "":
+                break
+            if not isinstance(next_cursor, str):
+                raise ProtocolError("ListGroupForDomain cursor must be a string")
+            if next_cursor in seen_cursors:
+                raise ProtocolError("ListGroupForDomain returned a repeated cursor")
+            seen_cursors.add(next_cursor)
+            cursor = next_cursor
+
+        collected.sort(key=lambda group: (group["display_name"], group["id"]))
+        return collected
+
+    def export_groups(
+        self,
+        domain_id: str,
+        destination: str | Path,
+        **list_options: object,
+    ) -> list[dict[str, Any]]:
+        """Write a byte-stable JSON representation of the complete inventory."""
+
+        groups = self.list_groups(domain_id, **list_options)
+        document = {
+            "operation_id": "ListGroupForDomain",
+            "results": groups,
+        }
+        payload = (
+            json.dumps(
+                document,
+                ensure_ascii=False,
+                separators=(",", ":"),
+                sort_keys=True,
+            )
+            + "\n"
+        ).encode("utf-8")
+        Path(destination).write_bytes(payload)
+        return groups
+
+    def _get_json(self, url: str) -> dict[str, Any]:
+        request = urllib.request.Request(
+            url,
+            method="GET",
+            headers={
+                "Accept": "application/json",
+                "Authorization": self._authorization,
+            },
+        )
+        try:
+            response = urllib.request.urlopen(request, timeout=self._timeout)
+        except urllib.error.HTTPError as exc:
+            raw = exc.read()
+            try:
+                envelope = json.loads(raw.decode("utf-8"))
+            except (UnicodeDecodeError, json.JSONDecodeError):
+                envelope = None
+            raise NsxApiError(exc.code, envelope) from None
+
+        with response:
+            status = response.getcode()
+            raw = response.read()
+        try:
+            document = json.loads(raw.decode("utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+            raise ProtocolError("success response must be UTF-8 JSON") from exc
+        if status != 200:
+            raise NsxApiError(status, document)
+        if not isinstance(document, dict):
+            raise ProtocolError("ListGroupForDomain response must be an object")
+        return document

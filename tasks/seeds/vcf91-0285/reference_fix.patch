+<#
+    Materialises an ApiError wire body as the VMware.Sdk.Vcf.Ops model type.
+    The prerequisite SDK owns the ApiError / ApiErrorDetail shapes that the
+    Operations for Networks specification also declares.
+#>
+function New-NiApiErrorRecord {
+    param(
+        [Parameter(Mandatory)] [object] $Response,
+        [Parameter(Mandatory)] [string] $OperationId
+    )
+
+    $status = [int]$Response.StatusCode
+    $payload = $null
+    $raw = [string]$Response.RawContent
+    if (-not [string]::IsNullOrWhiteSpace($raw)) {
+        try { $payload = $raw | ConvertFrom-Json } catch { $payload = $null }
+    }
+
+    $details = [System.Collections.Generic.List[VMware.Bindings.Vcf.Ops.Model.ApiErrorDetail]]::new()
+    foreach ($detail in @(Get-NiField -InputObject $payload -Name 'details')) {
+        if ($null -eq $detail) { continue }
+        $targets = [System.Collections.Generic.List[string]]::new()
+        foreach ($target in @(Get-NiField -InputObject $detail -Name 'target')) {
+            if ($null -ne $target) { $targets.Add([string]$target) }
+        }
+        $details.Add((Initialize-VcfOpsApiErrorDetail `
+                    -Code ([int](Get-NiField -InputObject $detail -Name 'code')) `
+                    -Message ([string](Get-NiField -InputObject $detail -Name 'message')) `
+                    -Target $targets))
+    }
+
+    $code = Get-NiField -InputObject $payload -Name 'code'
+    if ($null -eq $code) { $code = $status }
+    $message = [string](Get-NiField -InputObject $payload -Name 'message')
+    if ([string]::IsNullOrEmpty($message)) { $message = "HTTP $status" }
+
+    $apiError = Initialize-VcfOpsApiError -Code ([int]$code) -Message $message -Details $details
+
+    $exception = [System.InvalidOperationException]::new(
+        "VCF Operations for Networks operation '$OperationId' failed with HTTP ${status}: $message")
+    return [System.Management.Automation.ErrorRecord]::new(
+        $exception,
+        'VcfOnApiError',
+        [System.Management.Automation.ErrorCategory]::InvalidResult,
+        $apiError)
+}
+

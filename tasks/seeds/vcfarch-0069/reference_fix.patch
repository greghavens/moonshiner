new file mode 100644
index 0000000..54dda75
--- /dev/null
+++ b/src/VcfBrownfieldPlanner/VcfBrownfieldPlanner.psm1
@@ -0,0 +1,241 @@
+Set-StrictMode -Version Latest
+
+function Read-VcfPlannerJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $LiteralPath
+    )
+
+    $resolved = (Resolve-Path -LiteralPath $LiteralPath -ErrorAction Stop).Path
+    Get-Content -Raw -LiteralPath $resolved | ConvertFrom-Json -Depth 100
+}
+
+function Get-VcfSdkEstateInventory {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $Server,
+
+        [Parameter(Mandatory)]
+        [pscredential] $Credential,
+
+        [switch] $IgnoreInvalidCertificate
+    )
+
+    $connectParameters = @{
+        Server = $Server
+        Credential = $Credential
+        NotDefault = $true
+        ErrorAction = 'Stop'
+    }
+    if ($IgnoreInvalidCertificate) {
+        $connectParameters.IgnoreInvalidCertificate = $true
+    }
+
+    $connection = VMware.Sdk.Vcf.SddcManager\Connect-VcfSddcManagerServer @connectParameters
+    try {
+        $domains = @(VMware.Sdk.Vcf.SddcManager\Invoke-VcfGetDomains -Server $connection -ErrorAction Stop)
+        $clusters = @(VMware.Sdk.Vcf.SddcManager\Invoke-VcfGetClusters -Server $connection -ErrorAction Stop)
+        $hosts = @(VMware.Sdk.Vcf.SddcManager\Invoke-VcfGetHosts -Server $connection -ErrorAction Stop)
+
+        [pscustomobject][ordered]@{
+            server = $Server
+            collectedAt = [DateTimeOffset]::UtcNow.ToString('o')
+            domains = $domains
+            clusters = $clusters
+            hosts = $hosts
+        }
+    }
+    finally {
+        VMware.Sdk.Vcf.SddcManager\Disconnect-VcfSddcManagerServer -Server $connection -Force -ErrorAction SilentlyContinue | Out-Null
+    }
+}
+
+function New-VcfMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $InventoryPath,
+
+        [Parameter(Mandatory)]
+        [string] $CompatibilityPath
+    )
+
+    $resolvedInventoryPath = (Resolve-Path -LiteralPath $InventoryPath -ErrorAction Stop).Path
+    $inventory = Read-VcfPlannerJson -LiteralPath $resolvedInventoryPath
+    $compatibility = Read-VcfPlannerJson -LiteralPath $CompatibilityPath
+
+    if ($inventory.vcfVersion -cne $compatibility.sourceVcfVersion) {
+        throw "Inventory VCF version '$($inventory.vcfVersion)' does not match snapshot source '$($compatibility.sourceVcfVersion)'."
+    }
+    if ($inventory.targetVcfVersion -cne $compatibility.targetVcfVersion) {
+        throw "Inventory target '$($inventory.targetVcfVersion)' does not match snapshot target '$($compatibility.targetVcfVersion)'."
+    }
+    if ([bool]$compatibility.directInPlaceAllowed) {
+        throw 'This planner requires a snapshot that blocks direct in-place transition.'
+    }
+
+    $managementIds = @($inventory.components | Where-Object domain -CEQ 'management-domain' | ForEach-Object id)
+    $workloadIds = @($inventory.components | Where-Object domain -CNE 'management-domain' | ForEach-Object id)
+    $allIds = @($inventory.components | ForEach-Object id)
+
+    $gates = @(
+        [pscustomobject][ordered]@{
+            id = 'compat-back-in-time'
+            kind = 'COMPATIBILITY'
+            condition = 'The direct transition remains classified BACK_IN_TIME and all target components are deployed as new instances.'
+            evidence = 'Pinned compatibility snapshot plus successful target-installer validation.'
+        },
+        [pscustomobject][ordered]@{
+            id = 'target-management-healthy'
+            kind = 'TARGET_HEALTH'
+            condition = 'The parallel VCF 9.1 management domain reports healthy before creating the VI workload domain.'
+            evidence = 'VCF Installer completion record and management-domain health output.'
+        },
+        [pscustomobject][ordered]@{
+            id = 'target-workload-domain-healthy'
+            kind = 'TARGET_HEALTH'
+            condition = 'The target VI workload domain and its vCenter, NSX, and hosts report healthy before workload movement.'
+            evidence = 'Workload-domain inventory and health-check output.'
+        },
+        [pscustomobject][ordered]@{
+            id = 'workloads-validated'
+            kind = 'MIGRATION_VALIDATION'
+            condition = 'Migrated workloads pass application, storage, and network validation while the source remains available.'
+            evidence = 'Recorded workload validation results and migration reconciliation.'
+        },
+        [pscustomobject][ordered]@{
+            id = 'cutover-validated'
+            kind = 'CUTOVER_VALIDATION'
+            condition = 'Production service endpoints resolve to the target and post-cutover checks pass before source retirement.'
+            evidence = 'Post-cutover service checks and target inventory reconciliation.'
+        }
+    )
+
+    $stages = @(
+        [pscustomobject][ordered]@{
+            sequence = 10
+            id = 'deploy-target-management'
+            action = 'DEPLOY_TARGET_MANAGEMENT'
+            requires = @('compat-back-in-time')
+            components = $managementIds
+            completionEvidence = 'Parallel VCF 9.1 management domain installation completes and exposes health evidence.'
+        },
+        [pscustomobject][ordered]@{
+            sequence = 20
+            id = 'deploy-target-workload-domain'
+            action = 'DEPLOY_TARGET_WORKLOAD_DOMAIN'
+            requires = @('target-management-healthy')
+            components = $workloadIds
+            completionEvidence = 'Parallel VI workload domain installation completes with target vCenter, NSX, and hosts.'
+        },
+        [pscustomobject][ordered]@{
+            sequence = 30
+            id = 'migrate-workloads'
+            action = 'MIGRATE_WORKLOADS'
+            requires = @('target-workload-domain-healthy')
+            components = $workloadIds
+            completionEvidence = 'All workload waves are reconciled on the target while source rollback remains available.'
+        },
+        [pscustomobject][ordered]@{
+            sequence = 40
+            id = 'cutover-services'
+            action = 'CUTOVER_SERVICES'
+            requires = @('workloads-validated')
+            components = $allIds
+            completionEvidence = 'Service endpoints are cut over and validation records identify the target estate.'
+        },
+        [pscustomobject][ordered]@{
+            sequence = 50
+            id = 'decommission-source'
+            action = 'DECOMMISSION_SOURCE'
+            requires = @('cutover-validated')
+            components = $allIds
+            completionEvidence = 'Every source component is retired only after target cutover validation is complete.'
+        }
+    )
+
+    $components = foreach ($source in $inventory.components) {
+        $targetVersion = $compatibility.targetBom.($source.type)
+        if ([string]::IsNullOrWhiteSpace([string]$targetVersion)) {
+            throw "No target BOM version exists for component type '$($source.type)'."
+        }
+
+        $targetStage = if ($source.domain -ceq 'management-domain') {
+            'deploy-target-management'
+        }
+        else {
+            'deploy-target-workload-domain'
+        }
+
+        $componentGates = [System.Collections.Generic.List[string]]::new()
+        $componentGates.Add('compat-back-in-time')
+        if ($targetStage -ceq 'deploy-target-workload-domain') {
+            $componentGates.Add('target-management-healthy')
+        }
+        $componentGates.Add('cutover-validated')
+
+        [pscustomobject][ordered]@{
+            id = $source.id
+            type = $source.type
+            name = $source.name
+            domain = $source.domain
+            currentVersion = $source.version
+            targetVersion = $targetVersion
+            disposition = 'REPLACE_AND_RETIRE_SOURCE'
+            targetStage = $targetStage
+            decommissionStage = 'decommission-source'
+            gatedBy = @($componentGates)
+        }
+    }
+
+    [pscustomobject][ordered]@{
+        schemaVersion = '1.0.0'
+        planId = "$($inventory.estateId)-to-vcf-9-1"
+        estateId = $inventory.estateId
+        sourceVcfVersion = $inventory.vcfVersion
+        targetVcfVersion = $compatibility.targetVcfVersion
+        inventoryDigest = (Get-FileHash -Algorithm SHA256 -LiteralPath $resolvedInventoryPath).Hash.ToLowerInvariant()
+        compatibilitySnapshot = $compatibility.snapshotVersion
+        strategy = $compatibility.requiredStrategy
+        directInPlaceUpgrade = $false
+        architecture = [pscustomobject][ordered]@{
+            sourceDisposition = $compatibility.architecture.sourceDisposition
+            targetTopology = $compatibility.architecture.targetTopology
+            migrationBoundary = 'Workloads cross from the retained VCF 5.2.2 source into newly installed VCF 9.1 domains; installed source components are never downgraded.'
+            rollbackBoundary = 'Rollback remains at the source estate until service cutover validation succeeds; source retirement is irreversible.'
+        }
+        gates = $gates
+        stages = $stages
+        components = @($components)
+    }
+}
+
+function Export-VcfMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $InventoryPath,
+
+        [Parameter(Mandatory)]
+        [string] $CompatibilityPath,
+
+        [Parameter(Mandatory)]
+        [string] $Path
+    )
+
+    $plan = New-VcfMigrationPlan -InventoryPath $InventoryPath -CompatibilityPath $CompatibilityPath
+    $parent = Split-Path -Parent $Path
+    if ($parent -and -not (Test-Path -LiteralPath $parent)) {
+        [void](New-Item -ItemType Directory -Path $parent -Force)
+    }
+    $plan | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $Path -Encoding utf8NoBOM
+    (Resolve-Path -LiteralPath $Path).Path
+}
+
+Export-ModuleMember -Function @(
+    'Get-VcfSdkEstateInventory',
+    'New-VcfMigrationPlan',
+    'Export-VcfMigrationPlan'
+)

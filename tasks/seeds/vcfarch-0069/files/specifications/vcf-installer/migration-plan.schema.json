{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0069:migration-plan:1",
  "title": "VCF Existing-Estate Migration Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "estateId",
    "sourceVcfVersion",
    "targetVcfVersion",
    "inventoryDigest",
    "compatibilitySnapshot",
    "strategy",
    "directInPlaceUpgrade",
    "architecture",
    "gates",
    "stages",
    "components"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "planId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "estateId": {"type": "string", "minLength": 1},
    "sourceVcfVersion": {"type": "string", "minLength": 1},
    "targetVcfVersion": {"type": "string", "minLength": 1},
    "inventoryDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "compatibilitySnapshot": {"type": "string", "minLength": 1},
    "strategy": {"const": "SIDE_BY_SIDE_MIGRATION"},
    "directInPlaceUpgrade": {"const": false},
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceDisposition", "targetTopology", "migrationBoundary", "rollbackBoundary"],
      "properties": {
        "sourceDisposition": {"const": "RETAIN_UNTIL_CUTOVER"},
        "targetTopology": {"const": "PARALLEL_MANAGEMENT_AND_VI_DOMAIN"},
        "migrationBoundary": {"type": "string", "minLength": 20},
        "rollbackBoundary": {"type": "string", "minLength": 20}
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gate"}
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/stage"}
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "condition", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "kind": {
          "enum": ["COMPATIBILITY", "TARGET_HEALTH", "MIGRATION_VALIDATION", "CUTOVER_VALIDATION"]
        },
        "condition": {"type": "string", "minLength": 12},
        "evidence": {"type": "string", "minLength": 8}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "id", "action", "requires", "components", "completionEvidence"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "action": {
          "enum": [
            "DEPLOY_TARGET_MANAGEMENT",
            "DEPLOY_TARGET_WORKLOAD_DOMAIN",
            "MIGRATE_WORKLOADS",
            "CUTOVER_SERVICES",
            "DECOMMISSION_SOURCE"
          ]
        },
        "requires": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "components": {
          "type": "array",
          "items": {"type": "string"}
        },
        "completionEvidence": {"type": "string", "minLength": 12}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "domain",
        "currentVersion",
        "targetVersion",
        "disposition",
        "targetStage",
        "decommissionStage",
        "gatedBy"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["SDDC_MANAGER", "VCENTER", "ESX_HOST", "NSX_T_MANAGER"]},
        "name": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "currentVersion": {"type": "string", "minLength": 1},
        "targetVersion": {"type": "string", "minLength": 1},
        "disposition": {"const": "REPLACE_AND_RETIRE_SOURCE"},
        "targetStage": {"type": "string", "minLength": 1},
        "decommissionStage": {"const": "decommission-source"},
        "gatedBy": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      }
    }
  }
}

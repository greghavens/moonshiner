+#!/usr/bin/env python3
+"""Reference proof using the same executable recovery flow as the task."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "crmctl"
+TARGET_ID = "crm-209"
+REASON = "no longer needed for the scheduled work"
+
+
+def invoke(*arguments: str, expected_codes: set[int]) -> subprocess.CompletedProcess[str]:
+    completed = subprocess.run(
+        [str(CLIENT), *arguments],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=10,
+    )
+    if completed.returncode not in expected_codes:
+        raise RuntimeError(
+            f"crmctl returned {completed.returncode}: {completed.stderr.strip()}"
+        )
+    return completed
+
+
+def retrieve() -> dict[str, object]:
+    completed = invoke("get", "--id", TARGET_ID, expected_codes={0})
+    payload = json.loads(completed.stdout)
+    record = payload.get("record")
+    if not isinstance(record, dict):
+        raise RuntimeError("exact-ID retrieval returned no record")
+    return record
+
+
+def main() -> int:
+    first = invoke(
+        "cancel",
+        "--id",
+        TARGET_ID,
+        "--reason",
+        REASON,
+        expected_codes={75},
+    )
+    if "outcome is unknown" not in first.stderr:
+        raise RuntimeError("first cancellation did not return the expected uncertainty")
+
+    record = retrieve()
+    status = record.get("status")
+    retried = False
+    if status == "active":
+        invoke(
+            "cancel",
+            "--id",
+            TARGET_ID,
+            "--reason",
+            REASON,
+            expected_codes={0},
+        )
+        retried = True
+        record = retrieve()
+        status = record.get("status")
+    elif status not in {"cancelled", "cancellation-pending"}:
+        raise RuntimeError(f"unsafe verification status: {status!r}")
+
+    name = record.get("name")
+    account_id = record.get("id")
+    if not isinstance(name, str) or account_id != TARGET_ID:
+        raise RuntimeError("retrieved record does not identify the requested target")
+    if status != "cancelled":
+        raise RuntimeError(f"reference final status was not cancelled: {status!r}")
+
+    result = (
+        f"{name} ({account_id})\n"
+        f"Verified final status: {status}\n"
+        f"Retry occurred: {'yes' if retried else 'no'}\n"
+    )
+    (ROOT / "cancellation-result.txt").write_text(result, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

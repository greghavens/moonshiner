+func (c *Client) getDomainsPage(
+	ctx context.Context,
+	pageNumber int,
+) (DomainPage, error) {
+	query := url.Values{}
+	query.Set("pageNumber", strconv.Itoa(pageNumber))
+	query.Set("pageSize", strconv.Itoa(c.pageSize))
+	target := c.baseURL + "/v1/domains?" + query.Encode()
+
+	request, err := http.NewRequestWithContext(
+		ctx,
+		http.MethodGet,
+		target,
+		nil,
+	)
+	if err != nil {
+		return DomainPage{}, protocolError(
+			"request target could not be constructed",
+		)
+	}
+	request.Header.Set("Accept", "application/json")
+	request.Header.Set("Authorization", "Bearer "+c.accessToken)
+
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		return DomainPage{}, &TransportError{
+			OperationID: "getDomains",
+			Err:         err,
+		}
+	}
+	defer response.Body.Close()
+
+	content, err := io.ReadAll(
+		io.LimitReader(response.Body, maxResponseBytes+1),
+	)
+	if err != nil {
+		return DomainPage{}, &TransportError{
+			OperationID: "getDomains",
+			Err:         err,
+		}
+	}
+	if len(content) > maxResponseBytes {
+		return DomainPage{}, protocolError("response exceeded the size limit")
+	}
+	if response.StatusCode != http.StatusOK {
+		var decoded VCFError
+		_ = decodeOneJSON(content, &decoded)
+		return DomainPage{}, &APIError{
+			OperationID:        "getDomains",
+			Status:             response.StatusCode,
+			ErrorCode:          decoded.ErrorCode,
+			Message:            decoded.Message,
+			RemediationMessage: decoded.RemediationMessage,
+			ReferenceToken:     decoded.ReferenceToken,
+		}
+	}
+
+	mediaType, _, err := mime.ParseMediaType(
+		response.Header.Get("Content-Type"),
+	)
+	if err != nil || mediaType != "application/json" {
+		return DomainPage{}, protocolError(
+			"success response was not application/json",
+		)
+	}
+
+	var page DomainPage
+	if err := decodeOneJSON(content, &page); err != nil {
+		return DomainPage{}, protocolError(
+			"success response was not one JSON document",
+		)
+	}
+	return page, nil
+}
+
+func validatePage(page DomainPage, requestedPage int) error {
+	metadata := page.PageMetadata
+	if metadata.PageNumber < 0 ||
+		metadata.PageSize < 0 ||
+		metadata.TotalElements < 0 ||
+		metadata.TotalPages < 0 ||
+		metadata.PageNumber > math.MaxInt32 ||
+		metadata.PageSize > math.MaxInt32 ||
+		metadata.TotalElements > math.MaxInt32 ||
+		metadata.TotalPages > math.MaxInt32 {
+		return protocolError("pagination metadata was outside int32 bounds")
+	}
+	if metadata.PageNumber != requestedPage {
+		return protocolError("pageNumber did not match the requested page")
+	}
+	if metadata.PageSize != len(page.Elements) {
+		return protocolError("pageSize did not match the returned element count")
+	}
+	if metadata.TotalPages == 0 {
+		if requestedPage != 0 ||
+			metadata.TotalElements != 0 ||
+			metadata.PageSize != 0 {
+			return protocolError("zero-page collection metadata was inconsistent")
+		}
+		return nil
+	}
+	if requestedPage >= metadata.TotalPages {
+		return protocolError("pageNumber was outside totalPages")
+	}
+	return nil
+}
+
+func protocolError(reason string) *ProtocolError {
+	return &ProtocolError{
+		OperationID: "getDomains",
+		Reason:      reason,
+	}
+}
+
+func decodeOneJSON(content []byte, out any) error {
+	decoder := json.NewDecoder(bytes.NewReader(content))
+	if err := decoder.Decode(out); err != nil {
+		return err
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); err != io.EOF {
+		if err == nil {
+			return errors.New("trailing JSON value")
+		}
+		return err
+	}
+	return nil
+}
+
+func containsASCIIWhitespace(value string) bool {
+	for index := 0; index < len(value); index++ {
+		switch value[index] {
+		case ' ', '\t', '\n', '\r', '\v', '\f':
+			return true
+		}
+	}
+	return false
 }

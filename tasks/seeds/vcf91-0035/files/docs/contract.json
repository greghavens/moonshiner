{
  "contract_version": 1,
  "product": "VMware Cloud Foundation 9.1 SDDC Manager REST API",
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "openapi": "3.0.1",
    "info_title": "SDDC Manager API Reference Guide",
    "info_version": "9.1.0.0",
    "repository_license": "Apache-2.0"
  },
  "operations": [
    {
      "operationId": "getDomains",
      "summary": "Retrieve a list of domains",
      "method": "GET",
      "path": "/v1/domains",
      "query_parameters": [
        {
          "name": "type",
          "in": "query",
          "description": "Type of the domain",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "name",
          "in": "query",
          "description": "Name of the Domain",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "vcFqdn",
          "in": "query",
          "description": "vCenter FQDN of the domain",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "vcInstanceId",
          "in": "query",
          "description": "vCenter Instance ID of the domain",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "isManagementSsoDomain",
          "in": "query",
          "description": "Is domain joined to the Management domain SSO",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "pageNumber",
          "in": "query",
          "description": "Page number to retrieve",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        },
        {
          "name": "pageSize",
          "in": "query",
          "description": "Size of the page to retrieve",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        },
        {
          "name": "useCache",
          "in": "query",
          "description": "Parameter to get domain details from cache",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Ok",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/PageOfDomain"
        },
        "400": {
          "description": "Bad Request",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        },
        "500": {
          "description": "InternalServerError",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        }
      }
    }
  ],
  "schemas": {
    "PageOfDomain": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "description": "The list of elements included in this page",
          "items": {
            "$ref": "#/components/schemas/Domain"
          }
        },
        "pageMetadata": {
          "$ref": "#/components/schemas/PageMetadata"
        }
      }
    },
    "PageMetadata": {
      "type": "object",
      "properties": {
        "pageNumber": {
          "type": "integer",
          "description": "Returns the current page number",
          "format": "int32",
          "readOnly": true
        },
        "pageSize": {
          "type": "integer",
          "description": "Returns the number of elements in the current page",
          "format": "int32",
          "readOnly": true
        },
        "totalElements": {
          "type": "integer",
          "description": "Returns the total number of elements",
          "format": "int32",
          "readOnly": true
        },
        "totalPages": {
          "type": "integer",
          "description": "Returns the total number of pages",
          "format": "int32",
          "readOnly": true
        }
      },
      "description": "Represents pageable elements pagination metadata",
      "readOnly": true
    },
    "Domain": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID of the workload domain"
        },
        "name": {
          "type": "string",
          "description": "Name of the workload domain"
        },
        "status": {
          "type": "string",
          "description": "Status of the workload domain"
        },
        "type": {
          "type": "string",
          "description": "Type of the workload domain"
        }
      },
      "description": "Represents a domain",
      "projection_note": "Only Domain properties consumed by this task are included in this focused projection."
    },
    "Error": {
      "type": "object",
      "properties": {
        "errorCode": {
          "type": "string",
          "readOnly": true
        },
        "message": {
          "type": "string",
          "readOnly": true
        },
        "remediationMessage": {
          "type": "string"
        },
        "referenceToken": {
          "type": "string",
          "readOnly": true
        }
      },
      "projection_note": "Only Error properties consumed by this task are included in this focused projection."
    }
  }
}

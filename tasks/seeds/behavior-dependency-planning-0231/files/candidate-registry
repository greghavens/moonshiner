#!/usr/bin/env python3
"""Executable interface to the sandboxed candidate registry."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import hmac
import json
import os
from pathlib import Path
import sqlite3
import sys
import time
import uuid


ROOT = Path(__file__).resolve().parent
SEED_PATH = ROOT / ".candidates" / "seed.sql"
REGISTRY_RUNTIME = ROOT / ".candidates" / "runtime"
DATABASE_PATH = REGISTRY_RUNTIME / "candidates.sqlite3"
INITIALIZE_LOCK_PATH = REGISTRY_RUNTIME / "initialize.lock"
AUDIT_PATH = ROOT / ".harness" / "runtime" / "candidate-audit.jsonl"
AUDIT_KEY = b"moonshiner-pi-candidate-audit-0231-v1"
READ_DELAY_SECONDS = 0.6
OPERATIONS = ("search", "get", "update", "cancel", "notify")


def canonical(value: dict) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()


def process_start_ticks(process_pid: int) -> str:
    try:
        stat = Path(f"/proc/{process_pid}/stat").read_text(encoding="utf-8")
        return stat.rsplit(") ", 1)[1].split()[19]
    except (OSError, IndexError):
        return "unavailable"


def append_audit(event: dict) -> None:
    event["signature"] = hmac.new(
        AUDIT_KEY, canonical(event), hashlib.sha256
    ).hexdigest()
    AUDIT_PATH.parent.mkdir(parents=True, exist_ok=True)
    with AUDIT_PATH.open("a", encoding="utf-8") as stream:
        fcntl.flock(stream.fileno(), fcntl.LOCK_EX)
        stream.write(json.dumps(event, sort_keys=True, separators=(",", ":")) + "\n")
        stream.flush()
        os.fsync(stream.fileno())
        fcntl.flock(stream.fileno(), fcntl.LOCK_UN)


def ensure_database() -> None:
    REGISTRY_RUNTIME.mkdir(parents=True, exist_ok=True)
    with INITIALIZE_LOCK_PATH.open("a", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        if not DATABASE_PATH.exists():
            temporary = REGISTRY_RUNTIME / f"candidates-{os.getpid()}.sqlite3.tmp"
            temporary.unlink(missing_ok=True)
            connection = sqlite3.connect(temporary)
            try:
                connection.executescript(SEED_PATH.read_text(encoding="utf-8"))
                connection.commit()
            finally:
                connection.close()
            os.replace(temporary, DATABASE_PATH)
        fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def operation_parser(operation: str) -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=f"candidate-registry {operation}")
    if operation == "search":
        parser.add_argument("--name", required=True)
        parser.add_argument("--role", required=True)
        parser.add_argument("--department", required=True)
    elif operation == "get":
        parser.add_argument("--id", dest="candidate_id", required=True)
    elif operation == "update":
        parser.add_argument("--id", dest="candidate_id", required=True)
        parser.add_argument("--status", required=True)
    elif operation in {"cancel", "notify"}:
        parser.add_argument("--id", dest="candidate_id", required=True)
        if operation == "notify":
            parser.add_argument("--message", required=True)
    return parser


def record_for_id(connection: sqlite3.Connection, candidate_id: str) -> dict:
    row = connection.execute(
        """
        SELECT candidate_id, name, role, department, status, candidate_date,
               email, phone, hiring_manager, requisition, notes, lifecycle
        FROM candidate_records
        WHERE candidate_id = ? AND lifecycle = 'current'
        """,
        (candidate_id,),
    ).fetchone()
    if row is None:
        raise LookupError(f"current candidate ID not found: {candidate_id}")
    return {
        "candidate_id": row[0],
        "name": row[1],
        "role": row[2],
        "department": row[3],
        "status": row[4],
        "date": row[5],
        "email": row[6],
        "phone": row[7],
        "hiring_manager": row[8],
        "requisition": row[9],
        "notes": row[10],
        "lifecycle": row[11],
    }


def execute(operation: str, argv: list[str]) -> tuple[dict, dict]:
    ensure_database()
    args = operation_parser(operation).parse_args(argv)
    connection = sqlite3.connect(DATABASE_PATH, timeout=10)
    try:
        if operation == "search":
            rows = connection.execute(
                """
                SELECT candidate_id, name, role, department
                FROM candidate_records
                WHERE name = ? AND role = ? AND department = ?
                      AND lifecycle = 'current'
                ORDER BY candidate_id
                """,
                (args.name, args.role, args.department),
            ).fetchall()
            matches = [
                {
                    "candidate_id": row[0],
                    "name": row[1],
                    "role": row[2],
                    "department": row[3],
                }
                for row in rows
            ]
            return {"matches": matches}, {
                "name": args.name,
                "role": args.role,
                "department": args.department,
                "result_count": len(matches),
                "result_ids": [row["candidate_id"] for row in matches],
            }

        if operation == "get":
            record = record_for_id(connection, args.candidate_id)
            return {"record": record}, {
                "candidate_id": args.candidate_id,
                "result_count": 1,
                "record_digest": hashlib.sha256(canonical(record)).hexdigest(),
            }

        if operation == "update":
            record_for_id(connection, args.candidate_id)
            connection.execute(
                "UPDATE candidate_records SET status = ? WHERE candidate_id = ?",
                (args.status, args.candidate_id),
            )
            connection.commit()
            record = record_for_id(connection, args.candidate_id)
            return {"record": record}, {
                "candidate_id": args.candidate_id,
                "result_count": 1,
            }

        if operation == "cancel":
            record_for_id(connection, args.candidate_id)
            connection.execute(
                "UPDATE candidate_records SET lifecycle = 'cancelled' "
                "WHERE candidate_id = ?",
                (args.candidate_id,),
            )
            connection.commit()
            return {"cancelled": args.candidate_id}, {
                "candidate_id": args.candidate_id,
                "result_count": 1,
            }

        if operation == "notify":
            record_for_id(connection, args.candidate_id)
            cursor = connection.execute(
                "INSERT INTO notifications (candidate_id, message) VALUES (?, ?)",
                (args.candidate_id, args.message),
            )
            connection.commit()
            return {
                "notification": {
                    "notification_id": cursor.lastrowid,
                    "candidate_id": args.candidate_id,
                    "message": args.message,
                }
            }, {"candidate_id": args.candidate_id, "result_count": 1}
    finally:
        connection.close()

    raise ValueError(f"operation is unavailable: {operation}")


def usage() -> None:
    print(
        "usage: candidate-registry {" + ",".join(OPERATIONS) + "} ...",
        file=sys.stderr,
    )


def main() -> int:
    if len(sys.argv) == 1 or sys.argv[1] in {"-h", "--help"}:
        usage()
        return 2

    operation = sys.argv[1]
    start_ns = time.monotonic_ns()
    parent_pid = os.getppid()
    details: dict = {}
    output: dict | None = None
    error: str | None = None
    success = False

    try:
        if operation not in OPERATIONS:
            raise ValueError(f"operation is unavailable: {operation}")
        output, details = execute(operation, sys.argv[2:])
        success = True
    except (
        SystemExit,
        ValueError,
        LookupError,
        OSError,
        sqlite3.DatabaseError,
    ) as exc:
        error = str(exc)

    time.sleep(READ_DELAY_SECONDS)
    end_ns = time.monotonic_ns()
    event = {
        "event_id": str(uuid.uuid4()),
        "operation": operation,
        "start_ns": start_ns,
        "end_ns": end_ns,
        "process_pid": os.getpid(),
        "process_start_ticks": process_start_ticks(os.getpid()),
        "process_group_id": os.getpgrp(),
        "session_id": os.getsid(0),
        "parent_pid": parent_pid,
        "parent_start_ticks": process_start_ticks(parent_pid),
        "success": success,
        **details,
    }
    if error is not None:
        event["error"] = error
    append_audit(event)

    if success:
        print(json.dumps(output, sort_keys=True))
        return 0
    print(json.dumps({"error": error or "operation failed"}), file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())

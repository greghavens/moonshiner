{
  "contractFormat": "focused-openapi-projection-v1",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repositoryCommitSha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "specPath": "specifications/sddc-lcm/sddc-lcm-openapi.yaml",
    "license": "Apache-2.0",
    "openapi": "3.0.4",
    "apiTitle": "VCF SDDC LCM Service APIs",
    "apiVersion": "9.1.0.0",
    "serverUrl": "https://vcf.broadcom.com/sddc-lcm"
  },
  "securityScheme": {
    "name": "bearerToken",
    "type": "http",
    "scheme": "Bearer",
    "bearerFormat": "JWT"
  },
  "operations": [
    {
      "operationId": "getTasks",
      "method": "GET",
      "path": "/v1/tasks",
      "summary": "Get all tasks",
      "tags": [
        "Task"
      ],
      "parameters": [
        {
          "name": "status",
          "in": "query",
          "description": "Filter tasks by status",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "type",
          "in": "query",
          "description": "Filter tasks by type",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "createdBy",
          "in": "query",
          "description": "Filter tasks by creator (username or service account)",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "name",
          "in": "query",
          "description": "Filter tasks by name (internal name)",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "description",
          "in": "query",
          "description": "Filter tasks by description (public name for the task)",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "startTimeGt",
          "in": "query",
          "description": "Filter tasks with start time greater than the specified timestamp (ISO 8601 format)",
          "required": false,
          "schema": {
            "format": "date-time",
            "type": "string"
          }
        },
        {
          "name": "startTimeLt",
          "in": "query",
          "description": "Filter tasks with start time less than the specified timestamp (ISO 8601 format)",
          "required": false,
          "schema": {
            "format": "date-time",
            "type": "string"
          }
        },
        {
          "name": "updateTimeGt",
          "in": "query",
          "description": "Filter tasks with update time greater than the specified timestamp (ISO 8601 format)",
          "required": false,
          "schema": {
            "format": "date-time",
            "type": "string"
          }
        },
        {
          "name": "updateTimeLt",
          "in": "query",
          "description": "Filter tasks with update time less than the specified timestamp (ISO 8601 format)",
          "required": false,
          "schema": {
            "format": "date-time",
            "type": "string"
          }
        },
        {
          "name": "endTimeGt",
          "in": "query",
          "description": "Filter tasks with end time greater than the specified timestamp (ISO 8601 format)",
          "required": false,
          "schema": {
            "format": "date-time",
            "type": "string"
          }
        },
        {
          "name": "endTimeLt",
          "in": "query",
          "description": "Filter tasks with end time less than the specified timestamp (ISO 8601 format)",
          "required": false,
          "schema": {
            "format": "date-time",
            "type": "string"
          }
        },
        {
          "name": "resourceId",
          "in": "query",
          "description": "Filter tasks by resource ID",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "resourceType",
          "in": "query",
          "description": "Filter tasks by resource type",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "includeSystemTasks",
          "in": "query",
          "description": "Whether to include system/internal tasks in the response. Defaults to false (only customer-visible tasks).",
          "required": false,
          "schema": {
            "default": false,
            "type": "boolean"
          }
        },
        {
          "name": "pageNumber",
          "in": "query",
          "description": "Page Number.",
          "required": false,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "pageSize",
          "in": "query",
          "description": "Page Size. Maximum allowed is 50.",
          "required": false,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "requestBody": false,
      "responses": {
        "200": {
          "description": "OK",
          "contentType": "application/json",
          "schema": "PageOfTaskSummary"
        },
        "500": {
          "description": "Internal Server Error",
          "contentType": "application/json",
          "schema": "PageOfTaskSummary"
        }
      }
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{taskId}",
      "summary": "Get a task",
      "tags": [
        "Task"
      ],
      "parameters": [
        {
          "name": "taskId",
          "in": "path",
          "description": "Task Id",
          "required": true,
          "schema": {
            "format": "uuid",
            "type": "string"
          }
        }
      ],
      "requestBody": false,
      "responses": {
        "200": {
          "description": "OK",
          "contentType": "application/json",
          "schema": "Task"
        },
        "404": {
          "description": "Not Found",
          "contentType": "application/json",
          "schema": "ErrorResponse"
        },
        "500": {
          "description": "Internal Server Error",
          "contentType": "application/json",
          "schema": "ErrorResponse"
        }
      }
    }
  ],
  "schemas": {
    "PageOfTaskSummary": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "items": {
            "$schema": "TaskSummary"
          }
        },
        "pageMetadata": {
          "$schema": "PageMetadata"
        }
      }
    },
    "PageMetadata": {
      "type": "object",
      "properties": {
        "pageNumber": {
          "type": "integer"
        },
        "pageSize": {
          "type": "integer"
        },
        "totalElements": {
          "type": "integer"
        },
        "totalPages": {
          "type": "integer"
        }
      }
    },
    "TaskSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "$schema": "LocalizableMessage"
        },
        "status": {
          "$schema": "TaskStatus"
        },
        "type": {
          "type": "string"
        },
        "createdBy": {
          "type": "string"
        },
        "updatedBy": {
          "type": "string"
        },
        "resourceId": {
          "type": "string"
        },
        "resourceType": {
          "type": "string"
        },
        "createTime": {
          "type": "string",
          "format": "date-time"
        },
        "startTime": {
          "type": "string",
          "format": "date-time"
        },
        "updateTime": {
          "type": "string",
          "format": "date-time"
        },
        "endTime": {
          "type": "string",
          "format": "date-time"
        },
        "correlationId": {
          "type": "string"
        },
        "parentTaskId": {
          "type": "string"
        },
        "retriable": {
          "type": "boolean"
        },
        "cancellable": {
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ]
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "SCHEDULED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELED"
      ]
    },
    "Task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "$schema": "LocalizableMessage"
        },
        "status": {
          "$schema": "TaskStatus"
        },
        "type": {
          "type": "string"
        },
        "createdBy": {
          "type": "string"
        },
        "updatedBy": {
          "type": "string"
        },
        "resourceId": {
          "type": "string"
        },
        "resourceType": {
          "type": "string"
        },
        "createTime": {
          "type": "string",
          "format": "date-time"
        },
        "startTime": {
          "type": "string",
          "format": "date-time"
        },
        "updateTime": {
          "type": "string",
          "format": "date-time"
        },
        "endTime": {
          "type": "string",
          "format": "date-time"
        },
        "correlationId": {
          "type": "string"
        },
        "parentTaskId": {
          "type": "string"
        },
        "retriable": {
          "type": "boolean"
        },
        "cancellable": {
          "type": "boolean"
        },
        "taskSummary": {
          "$schema": "Task_taskSummary"
        },
        "stages": {
          "type": "array",
          "items": {
            "$schema": "TaskStage"
          }
        },
        "subTasks": {
          "type": "array",
          "items": {
            "$schema": "Task"
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "$schema": "TaskMessage"
          }
        },
        "result": {
          "$schema": "Task_result"
        },
        "additionalDetails": {
          "type": "object"
        }
      },
      "required": [
        "id"
      ]
    },
    "TaskStage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "$schema": "LocalizableMessage"
        },
        "status": {
          "$schema": "TaskStageStatus"
        },
        "updateTime": {
          "type": "string",
          "format": "date-time"
        },
        "startTime": {
          "type": "string",
          "format": "date-time"
        },
        "endTime": {
          "type": "string",
          "format": "date-time"
        },
        "messages": {
          "type": "array",
          "items": {
            "$schema": "TaskStageMessage"
          }
        }
      }
    },
    "TaskStageStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELED",
        "SKIPPED"
      ]
    },
    "TaskStageMessage": {
      "type": "object",
      "allOf": [
        "TaskMessage"
      ],
      "properties": {
        "stageId": {
          "type": "string"
        }
      }
    },
    "TaskMessage": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "level": {
          "type": "string",
          "enum": [
            "INFO",
            "WARN",
            "ERROR"
          ]
        },
        "message": {
          "$schema": "LocalizableMessage"
        }
      }
    },
    "LocalizableMessage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "defaultMessage": {
          "type": "string"
        },
        "localizedMessage": {
          "type": "string"
        },
        "args": {
          "type": "object"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "$schema": "LocalizableMessage"
        },
        "resolution": {
          "$schema": "LocalizableMessage"
        },
        "referenceId": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "referenceId",
        "resolution",
        "timestamp"
      ]
    }
  }
}

{
  "contract_version": 1,
  "contract_kind": "focused OpenAPI 3.0.3 projection with explicit verifier policy",
  "product": "VMware Cloud Foundation 9.1 - vSphere Automation API",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/vsphere/openapi/automation/vcenter.yaml",
    "spec_blob_sha": "8028b0824c4ff3503d05f44814f967938a795c40",
    "license": "Apache-2.0"
  },
  "openapi": "3.0.3",
  "info": {
    "title": "vSphere Automation API",
    "version": "9.1.0.0"
  },
  "servers": [
    {
      "url": "https://{host}/api",
      "variables": {
        "host": {
          "default": "localhost"
        }
      }
    }
  ],
  "base_path": "/api",
  "security_schemes": {
    "api_key_auth": {
      "type": "apiKey",
      "name": "vmware-api-session-id",
      "in": "header"
    }
  },
  "operations": [
    {
      "operationId": "Content.LocalLibrary_create",
      "method": "POST",
      "path": "/content/local-library",
      "tags": [
        "Content.LocalLibrary"
      ],
      "description": "Creates a new local library.",
      "parameters": [
        {
          "name": "Client-Token",
          "in": "header",
          "required": false,
          "schema": {
            "type": "string"
          },
          "description": "A unique token generated on the client for each creation request. The token should be a universally unique identifier (UUID). This token can be used to guarantee idempotent creation. If not specified creation is not idempotent."
        }
      ],
      "requestBody": {
        "required": true,
        "description": "Specification for the new local library.",
        "content": {
          "application/json": {
            "schema_ref": "#/components/schemas/Content.LibraryModel"
          }
        }
      },
      "responses": {
        "400": {
          "description": "InvalidArgument if the create specification is invalid or the client token does not conform to UUID format; Unsupported if using multiple storage backings.",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.Error"
        },
        "201": {
          "description": "Identifier of the newly created Content.LibraryModel.",
          "schema": {
            "type": "string"
          }
        }
      },
      "security": [
        {
          "api_key_auth": []
        }
      ]
    }
  ],
  "schemas": {
    "Content.LibraryModel": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "create_usage": "must be provided; library names cannot be undefined or empty"
        },
        "storage_backings": {
          "type": "array",
          "items_ref": "#/components/schemas/Content.Library.StorageBacking",
          "create_usage": "must be provided; multiple default storage locations are not currently supported"
        },
        "description": {
          "type": "string",
          "create_usage": "optional; missing or null results in an empty string value"
        },
        "id": {
          "type": "string",
          "create_usage": "not used"
        },
        "creation_time": {
          "type": "string",
          "format": "date-time",
          "create_usage": "not used"
        },
        "last_modified_time": {
          "type": "string",
          "format": "date-time",
          "create_usage": "not used"
        },
        "last_sync_time": {
          "type": "string",
          "format": "date-time",
          "create_usage": "not used"
        },
        "type": {
          "type": "string",
          "create_usage": "not used"
        },
        "optimization_info": {
          "schema_ref": "#/components/schemas/Content.Library.OptimizationInfo",
          "create_usage": "optional"
        },
        "version": {
          "type": "string",
          "create_usage": "not used"
        },
        "publish_info": {
          "schema_ref": "#/components/schemas/Content.Library.PublishInfo",
          "create_usage": "optional; if omitted the library is not published"
        },
        "subscription_info": {
          "schema_ref": "#/components/schemas/Content.Library.SubscriptionInfo",
          "create_usage": "optional; if omitted a default without an active subscription is created"
        },
        "server_guid": {
          "type": "string",
          "create_usage": "optional"
        },
        "security_policy_id": {
          "type": "string",
          "create_usage": "optional"
        },
        "unset_security_policy_id": {
          "type": "boolean",
          "create_usage": "not used"
        },
        "state_info": {
          "schema_ref": "#/components/schemas/Content.Library.StateInfo",
          "create_usage": "not used"
        },
        "configuration_info": {
          "schema_ref": "#/components/schemas/Content.Library.ConfigurationInfo",
          "create_usage": "optional"
        }
      }
    },
    "Content.Library.StorageBacking": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "create_usage": "must be provided"
        },
        "datastore_id": {
          "type": "string",
          "create_usage": "optional and relevant only for DATASTORE"
        },
        "storage_uri": {
          "type": "string",
          "format": "uri",
          "create_usage": "optional and relevant only for OTHER"
        }
      }
    },
    "Content.Library.StorageBacking.Type": {
      "type": "string",
      "enum": [
        "DATASTORE",
        "OTHER"
      ]
    }
  },
  "serialization_rule": {
    "unset_optional_body_members": "omit",
    "explicit_empty_description": "preserve",
    "server_managed_or_unmodeled_members": "omit"
  },
  "verification_profile": {
    "operation_sequence": [
      "Content.LocalLibrary_create",
      "Content.LocalLibrary_create"
    ],
    "scenario": [
      "the first POST is committed and its connection is closed before a response",
      "the byte-identical POST is replayed with the same Client-Token",
      "the mock returns the original library identifier and records one library effect"
    ],
    "request_headers": {
      "vmware-api-session-id": "<session token>",
      "Client-Token": "<client UUID>",
      "Accept": "application/json",
      "Content-Type": "application/json"
    },
    "request_query": "omit",
    "success_status": 201,
    "maximum_attempts": 2,
    "retryable_outcome": "ambiguous IOException from HttpClient.send only",
    "unset_optional_body_members": [
      "description",
      "datastore_id or storage_uri when not applicable",
      "id",
      "creation_time",
      "last_modified_time",
      "last_sync_time",
      "type",
      "optimization_info",
      "version",
      "publish_info",
      "subscription_info",
      "server_guid",
      "security_policy_id",
      "unset_security_policy_id",
      "state_info",
      "configuration_info"
    ]
  }
}

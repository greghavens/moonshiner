+#!/usr/bin/env python3
+"""Reference proof using concurrent genuine claimctl processes."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+TARGETS = (
+    ("Theft claim 116", "West Office", "2026-11-17"),
+    ("Windshield claim 116", "North Office", "2026-11-17"),
+)
+
+
+def command(scope: tuple[str, str, str]) -> list[str]:
+    claim, office, availability_date = scope
+    return [
+        "./claimctl",
+        "availability",
+        "--claim",
+        claim,
+        "--office",
+        office,
+        "--date",
+        availability_date,
+    ]
+
+
+def decode_success(stdout: str) -> dict[str, Any]:
+    payload = json.loads(stdout)
+    if not isinstance(payload, dict) or not isinstance(payload.get("record"), dict):
+        raise RuntimeError("claimctl returned an invalid success payload")
+    record = payload["record"]
+    required = {"availability", "claim", "date", "office", "slots_available"}
+    if set(record) != required:
+        raise RuntimeError("claimctl returned an incomplete availability record")
+    return record
+
+
+def decode_error(stderr: str) -> dict[str, Any]:
+    payload = json.loads(stderr)
+    if not isinstance(payload, dict) or not isinstance(payload.get("error"), dict):
+        raise RuntimeError("claimctl returned an invalid error payload")
+    return payload["error"]
+
+
+def main() -> int:
+    subprocess.run(
+        ["./claimctl", "--help"],
+        cwd=ROOT,
+        check=True,
+        stdout=subprocess.DEVNULL,
+    )
+
+    processes = [
+        subprocess.Popen(
+            command(scope),
+            cwd=ROOT,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for scope in TARGETS
+    ]
+    outcomes = [process.communicate(timeout=15) for process in processes]
+
+    records: list[dict[str, Any] | None] = [None, None]
+    transient_index: int | None = None
+    initial_error_code: str | None = None
+    for index, (process, (stdout, stderr)) in enumerate(
+        zip(processes, outcomes, strict=True)
+    ):
+        if process.returncode == 0:
+            records[index] = decode_success(stdout)
+            continue
+        error = decode_error(stderr)
+        if (
+            process.returncode == 75
+            and error.get("code") == "TRANSIENT_SERVICE_ERROR"
+            and error.get("retryable") is True
+            and transient_index is None
+        ):
+            transient_index = index
+            initial_error_code = error["code"]
+            continue
+        raise RuntimeError("initial availability check had an unexpected outcome")
+
+    if transient_index is None or sum(record is not None for record in records) != 1:
+        raise RuntimeError("expected one successful and one transient initial result")
+
+    retried = subprocess.run(
+        command(TARGETS[transient_index]),
+        cwd=ROOT,
+        check=False,
+        capture_output=True,
+        text=True,
+        timeout=15,
+    )
+    if retried.returncode != 0:
+        raise RuntimeError(retried.stderr.strip() or "claimctl retry failed")
+    records[transient_index] = decode_success(retried.stdout)
+
+    if any(record is None for record in records):
+        raise RuntimeError("a requested claim has no successful availability record")
+    complete = [record for record in records if record is not None]
+    lines = [
+        f"- {record['claim']} | {record['office']} | {record['date']} | "
+        f"{record['availability']} | slots {record['slots_available']}"
+        for record in complete
+    ]
+    retry_claim, retry_office, _ = TARGETS[transient_index]
+    lines.append(
+        f"- Retry outcome: {retry_claim} at {retry_office} retried once after "
+        f"{initial_error_code}; succeeded."
+    )
+    (ROOT / "claim-availability-report.txt").write_text(
+        "\n".join(lines) + "\n", encoding="utf-8"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

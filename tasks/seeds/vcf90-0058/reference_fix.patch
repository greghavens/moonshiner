diff --git a/src/VcenterRightSizer.java b/src/VcenterRightSizer.java
new file mode 100644
index 0000000..b75006b
--- /dev/null
+++ b/src/VcenterRightSizer.java
@@ -0,0 +1,229 @@
+import java.net.URI;
+import java.net.URLEncoder;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.charset.StandardCharsets;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Applies a right-sizing change to one virtual machine through the vSphere
+ * Automation API of vCenter Server.
+ *
+ * The operation identifiers, methods, paths, query parameters and success
+ * status codes below are the ones recorded in docs/contract.json, which was
+ * derived from the vCenter OpenAPI document shipped at tag 9.0.0.0 of
+ * vmware/vcf-api-specs. Keep the two in step.
+ *
+ * Every request body is built from only the properties the caller asked for.
+ * All of the properties on these update and create specifications are
+ * optional, and the API reads an absent property as "leave this alone" -- so a
+ * property nobody asked about must not appear on the wire at all.
+ */
+public final class VcenterRightSizer {
+
+    private static final String BASE_PATH = "/api";
+    private static final String SESSION_HEADER = "vmware-api-session-id";
+
+    private static final String OP_SESSION_CREATE = "Cis.Session_create";
+    private static final String OP_POWER_GET = "Vcenter.Vm.Power_get";
+    private static final String OP_POWER_STOP = "Vcenter.Vm.Power_stop";
+    private static final String OP_CPU_UPDATE = "Vcenter.Vm.Hardware.Cpu_update";
+    private static final String OP_MEMORY_UPDATE = "Vcenter.Vm.Hardware.Memory_update";
+    private static final String OP_DISK_CREATE = "Vcenter.Vm.Hardware.Disk_create";
+
+    private final String origin;
+    private final String username;
+    private final String password;
+    private final HttpClient http;
+
+    private final List<Map<String, Object>> steps = new ArrayList<>();
+    private String sessionToken;
+
+    public VcenterRightSizer(String baseUrl, String username, String password) {
+        this.origin = baseUrl.endsWith("/") ? baseUrl.substring(0, baseUrl.length() - 1) : baseUrl;
+        this.username = username;
+        this.password = password;
+        this.http = HttpClient.newBuilder()
+                .connectTimeout(Duration.ofSeconds(20))
+                .followRedirects(HttpClient.Redirect.NEVER)
+                .build();
+    }
+
+    /**
+     * Runs the right-sizing sequence and returns a report of it. Stops at the
+     * first step vCenter rejects: the steps before it have already taken effect
+     * and undoing them is not this tool's call to make.
+     */
+    public String rightSize(String vmId, long cpuCount, long memorySizeMib,
+                            long diskCapacityBytes, long diskScsiBus) {
+        boolean poweredOff = false;
+        try {
+            Reply reply = send(OP_SESSION_CREATE, "POST", "/session", Map.of(), null, 201, false);
+            if (!note(reply)) {
+                return report(vmId, poweredOff);
+            }
+            sessionToken = MiniJson.asString(MiniJson.parse(reply.body()));
+
+            String vmPath = "/vcenter/vm/" + segment(vmId);
+
+            reply = send(OP_POWER_GET, "GET", vmPath + "/power", Map.of(), null, 200, true);
+            if (!note(reply)) {
+                return report(vmId, poweredOff);
+            }
+            Object state = MiniJson.asObject(MiniJson.parse(reply.body())).get("state");
+            poweredOff = "POWERED_OFF".equals(state);
+
+            // CPU and memory may only be resized on a VM that is powered off unless
+            // the corresponding hot-add flag is set, so bring it down first.
+            if (!poweredOff) {
+                reply = send(OP_POWER_STOP, "POST", vmPath + "/power", Map.of("action", "stop"), null, 204, true);
+                if (!note(reply)) {
+                    return report(vmId, poweredOff);
+                }
+                poweredOff = true;
+            }
+
+            Map<String, Object> cpuSpec = MiniJson.obj();
+            cpuSpec.put("count", cpuCount);
+            reply = send(OP_CPU_UPDATE, "PATCH", vmPath + "/hardware/cpu", Map.of(), cpuSpec, 204, true);
+            if (!note(reply)) {
+                return report(vmId, poweredOff);
+            }
+
+            Map<String, Object> memorySpec = MiniJson.obj();
+            memorySpec.put("size_mib", memorySizeMib);
+            reply = send(OP_MEMORY_UPDATE, "PATCH", vmPath + "/hardware/memory", Map.of(), memorySpec, 204, true);
+            if (!note(reply)) {
+                return report(vmId, poweredOff);
+            }
+
+            Map<String, Object> scsiAddress = MiniJson.obj();
+            scsiAddress.put("bus", diskScsiBus);
+            Map<String, Object> newVmdk = MiniJson.obj();
+            newVmdk.put("capacity", diskCapacityBytes);
+            Map<String, Object> diskSpec = MiniJson.obj();
+            diskSpec.put("scsi", scsiAddress);
+            diskSpec.put("new_vmdk", newVmdk);
+            reply = send(OP_DISK_CREATE, "POST", vmPath + "/hardware/disk", Map.of(), diskSpec, 201, true);
+            note(reply);
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            noteTransportFailure(e);
+        } catch (Exception e) {
+            noteTransportFailure(e);
+        }
+        return report(vmId, poweredOff);
+    }
+
+    // ----------------------------------------------------------------- report
+
+    private String report(String vmId, boolean poweredOff) {
+        long succeeded = steps.stream().filter(s -> "SUCCEEDED".equals(s.get("status"))).count();
+        String outcome;
+        if (steps.isEmpty() || succeeded == 0) {
+            outcome = "FAILED";
+        } else if (succeeded == steps.size()) {
+            outcome = "SUCCEEDED";
+        } else {
+            outcome = "PARTIAL_FAILURE";
+        }
+
+        Map<String, Object> report = MiniJson.obj();
+        report.put("vm", vmId);
+        report.put("outcome", outcome);
+        report.put("steps", steps);
+        report.put("vm_left_powered_off", poweredOff);
+        return MiniJson.writeIndented(report);
+    }
+
+    /** Records a completed request. Returns true when the run may continue. */
+    private boolean note(Reply reply) {
+        boolean ok = reply.status() == reply.expectedStatus();
+        Map<String, Object> step = MiniJson.obj();
+        step.put("operation_id", reply.operationId());
+        step.put("status", ok ? "SUCCEEDED" : "FAILED");
+        step.put("http_status", (long) reply.status());
+        if (!ok) {
+            describeError(step, reply.body());
+        }
+        steps.add(step);
+        return ok;
+    }
+
+    private void noteTransportFailure(Exception cause) {
+        Map<String, Object> step = MiniJson.obj();
+        step.put("operation_id", "");
+        step.put("status", "FAILED");
+        step.put("http_status", 0L);
+        step.put("error_type", "TRANSPORT_ERROR");
+        step.put("error_message", String.valueOf(cause));
+        steps.add(step);
+    }
+
+    /** Copies the vAPI error discriminator and top message out of an error body. */
+    private void describeError(Map<String, Object> step, String body) {
+        try {
+            Map<String, Object> error = MiniJson.asObject(MiniJson.parse(body));
+            Object errorType = error.get("error_type");
+            step.put("error_type", errorType == null ? "ERROR" : errorType);
+            List<Object> messages = MiniJson.asArray(error.get("messages"));
+            String message = messages.isEmpty()
+                    ? ""
+                    : String.valueOf(MiniJson.asObject(messages.get(0)).get("default_message"));
+            step.put("error_message", message);
+        } catch (RuntimeException e) {
+            step.put("error_type", "ERROR");
+            step.put("error_message", body == null ? "" : body);
+        }
+    }
+
+    // ---------------------------------------------------------------- transport
+
+    private record Reply(String operationId, int status, int expectedStatus, String body) {
+    }
+
+    private Reply send(String operationId, String method, String path, Map<String, String> query,
+                       Map<String, Object> requestBody, int expectedStatus, boolean withSession)
+            throws Exception {
+        StringBuilder uri = new StringBuilder(origin).append(BASE_PATH).append(path);
+        boolean first = true;
+        for (Map.Entry<String, String> parameter : query.entrySet()) {
+            uri.append(first ? '?' : '&');
+            first = false;
+            uri.append(URLEncoder.encode(parameter.getKey(), StandardCharsets.UTF_8))
+                    .append('=')
+                    .append(URLEncoder.encode(parameter.getValue(), StandardCharsets.UTF_8));
+        }
+
+        HttpRequest.Builder request = HttpRequest.newBuilder(URI.create(uri.toString()))
+                .timeout(Duration.ofSeconds(60))
+                .header("Accept", "application/json");
+        if (withSession) {
+            request.header(SESSION_HEADER, sessionToken);
+        } else {
+            String credentials = username + ":" + password;
+            request.header("Authorization", "Basic "
+                    + Base64.getEncoder().encodeToString(credentials.getBytes(StandardCharsets.UTF_8)));
+        }
+
+        if (requestBody == null) {
+            request.method(method, HttpRequest.BodyPublishers.noBody());
+        } else {
+            request.header("Content-Type", "application/json");
+            request.method(method, HttpRequest.BodyPublishers.ofString(
+                    MiniJson.write(requestBody), StandardCharsets.UTF_8));
+        }
+
+        HttpResponse<String> response = http.send(request.build(), HttpResponse.BodyHandlers.ofString());
+        return new Reply(operationId, response.statusCode(), expectedStatus, response.body());
+    }
+
+    private static String segment(String value) {
+        return URLEncoder.encode(value, StandardCharsets.UTF_8).replace("+", "%20");
+    }
+}

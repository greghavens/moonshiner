{
  "specification_id": "vcfarch-0158-installer-spec-v1",
  "output": {
    "path": "migration-plan.json",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:moonshiner:vcfarch-0158:migration-plan:v1",
      "title": "VCF Aria Brownfield Migration Plan",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "estate_id",
        "compatibility_snapshot_id",
        "sdk_driver",
        "entitlement_decision",
        "sources",
        "target_components",
        "steps"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "estate_id": {
          "type": "string",
          "minLength": 1
        },
        "compatibility_snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "sdk_driver": {
          "$ref": "#/$defs/sdkDriver"
        },
        "entitlement_decision": {
          "$ref": "#/$defs/entitlementDecision"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceMigration"
          }
        },
        "target_components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/targetComponent"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/migrationStep"
          }
        }
      },
      "$defs": {
        "sdkDriver": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "modules",
            "installer_constructors"
          ],
          "properties": {
            "modules": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "installer_constructors": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "entitlementDecision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_entitlement",
            "target_selection",
            "selected_topology",
            "excluded_topology",
            "reason"
          ],
          "properties": {
            "source_entitlement": {
              "type": "string",
              "minLength": 1
            },
            "target_selection": {
              "type": "string",
              "minLength": 1
            },
            "selected_topology": {
              "type": "string",
              "minLength": 1
            },
            "excluded_topology": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 20
            }
          }
        },
        "supportBoundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release_family",
            "end_of_general_support",
            "status_at_snapshot"
          ],
          "properties": {
            "release_family": {
              "type": "string",
              "minLength": 1
            },
            "end_of_general_support": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "status_at_snapshot": {
              "enum": [
                "supported",
                "end-of-support"
              ]
            }
          }
        },
        "carryItem": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item_id",
            "kind",
            "mode",
            "target_action"
          ],
          "properties": {
            "item_id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "mode": {
              "type": "string",
              "minLength": 1
            },
            "target_action": {
              "type": "string",
              "minLength": 12
            }
          }
        },
        "abandonItem": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item_id",
            "kind",
            "reason_code",
            "reason"
          ],
          "properties": {
            "item_id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "reason_code": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 12
            }
          }
        },
        "sourceMigration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inventory_id",
            "product_name",
            "version",
            "target_component_id",
            "target_component",
            "target_version",
            "migration_method",
            "support_boundary",
            "carry_forward",
            "abandon"
          ],
          "properties": {
            "inventory_id": {
              "type": "string",
              "minLength": 1
            },
            "product_name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "target_component_id": {
              "type": "string",
              "minLength": 1
            },
            "target_component": {
              "type": "string",
              "minLength": 1
            },
            "target_version": {
              "type": "string",
              "minLength": 1
            },
            "migration_method": {
              "enum": [
                "greenfield-content-export-import",
                "fleet-import-upgrade",
                "fresh-deploy-log-data-transfer"
              ]
            },
            "support_boundary": {
              "$ref": "#/$defs/supportBoundary"
            },
            "carry_forward": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/carryItem"
              }
            },
            "abandon": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/abandonItem"
              }
            }
          }
        },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vcf_instance",
            "domain",
            "cluster",
            "datastore",
            "network",
            "fault_domains",
            "anti_affinity"
          ],
          "properties": {
            "vcf_instance": {
              "type": "string",
              "minLength": 1
            },
            "domain": {
              "type": "string",
              "minLength": 1
            },
            "cluster": {
              "type": "string",
              "minLength": 1
            },
            "datastore": {
              "type": "string",
              "minLength": 1
            },
            "network": {
              "type": "string",
              "minLength": 1
            },
            "fault_domains": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "anti_affinity": {
              "type": "boolean"
            }
          }
        },
        "sizing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "availability",
            "node_count",
            "vcpu_per_node",
            "memory_gb_per_node",
            "disk_gb_per_node",
            "capacity",
            "basis"
          ],
          "properties": {
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "availability": {
              "enum": [
                "single",
                "production-ha"
              ]
            },
            "node_count": {
              "type": "integer",
              "minimum": 1
            },
            "vcpu_per_node": {
              "type": "integer",
              "minimum": 1
            },
            "memory_gb_per_node": {
              "type": "integer",
              "minimum": 1
            },
            "disk_gb_per_node": {
              "type": "integer",
              "minimum": 1
            },
            "capacity": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "basis": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 8
              }
            }
          }
        },
        "targetComponent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "component_id",
            "name",
            "version",
            "role",
            "fqdn",
            "placement",
            "sizing"
          ],
          "properties": {
            "component_id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string",
              "minLength": 1
            },
            "fqdn": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9.-]+[a-z0-9]$"
            },
            "placement": {
              "$ref": "#/$defs/placement"
            },
            "sizing": {
              "$ref": "#/$defs/sizing"
            }
          }
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gate_id",
            "kind",
            "condition",
            "success_evidence"
          ],
          "properties": {
            "gate_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]+$"
            },
            "kind": {
              "enum": [
                "entitlement",
                "compatibility",
                "lifecycle",
                "backup",
                "capacity",
                "health",
                "content",
                "integration",
                "identity"
              ]
            },
            "condition": {
              "type": "string",
              "minLength": 12
            },
            "success_evidence": {
              "type": "string",
              "minLength": 8
            }
          }
        },
        "migrationStep": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "order",
            "step_id",
            "phase",
            "title",
            "source_inventory_ids",
            "target_component_id",
            "depends_on",
            "action",
            "gates",
            "carry_item_ids",
            "abandon_item_ids"
          ],
          "properties": {
            "order": {
              "type": "integer",
              "minimum": 1
            },
            "step_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]+$"
            },
            "phase": {
              "enum": [
                "prepare",
                "deploy",
                "import",
                "upgrade",
                "content-transfer",
                "identity-cutover",
                "validate",
                "retire"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 8
            },
            "source_inventory_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "target_component_id": {
              "type": "string",
              "minLength": 1
            },
            "depends_on": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "action": {
              "type": "string",
              "minLength": 20
            },
            "gates": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/gate"
              }
            },
            "carry_item_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "abandon_item_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "module": {
    "directory": "VcfAriaMigration",
    "manifest": "VcfAriaMigration/VcfAriaMigration.psd1",
    "root_module": "VcfAriaMigration/VcfAriaMigration.psm1",
    "exported_function": "New-VcfAriaMigrationPlan",
    "required_sdk_modules": [
      "VMware.Sdk.Vcf.Installer",
      "VMware.Sdk.Vcf.SddcManager",
      "VMware.Sdk.Vcf.Ops"
    ],
    "required_installer_constructors": [
      "Initialize-VcfInstallerVcfOperationsNode",
      "Initialize-VcfInstallerVcfOperationsSpec",
      "Initialize-VcfInstallerVcfAutomationSpec",
      "Initialize-VcfInstallerVcfManagementComponentsNetworkSpec",
      "Initialize-VcfInstallerVcfManagementComponentsInfrastructureSpec"
    ],
    "required_parameters": [
      "InventoryPath",
      "CompatibilityPath",
      "InstallerSpecPath",
      "OutputPath"
    ]
  }
}

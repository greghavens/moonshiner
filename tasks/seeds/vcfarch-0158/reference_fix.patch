+Set-StrictMode -Version Latest
+
+$script:RequiredSdkModules = @(
+    'VMware.Sdk.Vcf.Installer'
+    'VMware.Sdk.Vcf.SddcManager'
+    'VMware.Sdk.Vcf.Ops'
+)
+
+function Import-VcfSdkPrerequisites {
+    [CmdletBinding()]
+    param()
+
+    foreach ($moduleName in $script:RequiredSdkModules) {
+        if (-not (Get-Module -ListAvailable -Name $moduleName)) {
+            throw "Required environment prerequisite '$moduleName' is not installed."
+        }
+        Import-Module -Name $moduleName -ErrorAction Stop
+    }
+}
+
+function Get-MinimumProfile {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [hashtable]$Constraint,
+
+        [Parameter(Mandatory)]
+        [hashtable]$Inventory
+    )
+
+    $componentId = [string]$Constraint.component_id
+    $availability = [string]$Inventory.service_requirements.availability
+    foreach ($profile in @($Constraint.profiles | Sort-Object -Property rank)) {
+        if ($componentId -notin @('tgt-fleet', 'tgt-identity') -and $profile.availability -ne $availability) {
+            continue
+        }
+
+        $fits = $true
+        switch ($componentId) {
+            'tgt-ops' {
+                foreach ($entry in $Inventory.service_requirements.operations.GetEnumerator()) {
+                    if (-not $profile.capacity.ContainsKey($entry.Key) -or [int64]$profile.capacity[$entry.Key] -lt [int64]$entry.Value) {
+                        $fits = $false
+                    }
+                }
+            }
+            'tgt-automation' {
+                foreach ($entry in $Inventory.service_requirements.automation.GetEnumerator()) {
+                    if (-not $profile.capacity.ContainsKey($entry.Key) -or [int64]$profile.capacity[$entry.Key] -lt [int64]$entry.Value) {
+                        $fits = $false
+                    }
+                }
+            }
+            'tgt-logs' {
+                $mapping = @{
+                    ingestion_gb_per_day = 'ingestion_gb_per_day'
+                    events_per_second = 'events_per_second'
+                    active_syslog_connections = 'active_syslog_connections'
+                    target_retention_days = 'retention_days'
+                }
+                foreach ($entry in $Inventory.service_requirements.logs.GetEnumerator()) {
+                    $capacityKey = $mapping[$entry.Key]
+                    if (-not $profile.capacity.ContainsKey($capacityKey) -or [int64]$profile.capacity[$capacityKey] -lt [int64]$entry.Value) {
+                        $fits = $false
+                    }
+                }
+            }
+        }
+        if ($fits) {
+            return $profile
+        }
+    }
+    throw "No pinned sizing profile satisfies $componentId."
+}
+
+function New-CarryAction {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [hashtable]$Item,
+
+        [Parameter(Mandatory)]
+        [hashtable]$Rule
+    )
+
+    $actionByMode = @{
+        'export-import' = "Export '$($Item.item_id)' from the source and import it into the target, then validate its references."
+        'reconfigure' = "Re-create the configuration for '$($Item.item_id)' on the target and validate connectivity."
+        're-enter-secret' = "Re-enter the secret binding for '$($Item.item_id)' on the target without exporting secret material."
+        'database-migration' = "Carry '$($Item.item_id)' in the Fleet-managed database migration and reconcile it after upgrade."
+        'data-transfer-90-days' = "Transfer '$($Item.item_id)' with the supported 90-day log-data transfer operation."
+        'recreate' = "Re-create '$($Item.item_id)' on the target and compare its resulting behavior with the source."
+        'retain-compatible-agent' = "Retain '$($Item.item_id)', update its trust for the target, and verify ingestion."
+    }
+    return [ordered]@{
+        item_id = $Item.item_id
+        kind = $Item.kind
+        mode = $Rule.mode
+        target_action = $actionByMode[$Rule.mode]
+    }
+}
+
+function New-AbandonAction {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [hashtable]$Item,
+
+        [Parameter(Mandatory)]
+        [hashtable]$Rule
+    )
+
+    $reasonByCode = @{
+        'replace-with-9.0-management-pack' = 'The 8.18 management-pack binary is not reused; install its VCF 9.0 counterpart after target deployment.'
+        'greenfield-does-not-transfer-time-series' = 'The supported greenfield Operations path cannot migrate historical time-series metrics.'
+        'vcf-identity-broker-login-url-replaces-csp-path' = 'VCF Identity Broker replaces the legacy CSP portal path, so these bookmarks must be retired.'
+        'vidm-has-no-vcf-9-in-place-upgrade' = 'VMware Identity Manager has no in-place transition into the VCF 9 identity architecture.'
+        'transfer-window-limited-to-90-days' = 'The supported log-data transfer is limited to the newest 90 days.'
+        'vcf-entitlement-replaces-legacy-license' = 'VCF entitlement replaces the legacy standalone product license at cutover.'
+    }
+    return [ordered]@{
+        item_id = $Item.item_id
+        kind = $Item.kind
+        reason_code = $Rule.reason_code
+        reason = $reasonByCode[$Rule.reason_code]
+    }
+}
+
+function New-SourceMigration {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [hashtable]$Source,
+
+        [Parameter(Mandatory)]
+        [hashtable]$Rule
+    )
+
+    $rulesByKind = @{}
+    foreach ($contentRule in $Rule.content_rules) {
+        $rulesByKind[$contentRule.kind] = $contentRule
+    }
+    $carry = @()
+    $abandon = @()
+    foreach ($item in $Source.content) {
+        $contentRule = $rulesByKind[$item.kind]
+        if (-not $contentRule) {
+            throw "No compatibility rule exists for content kind '$($item.kind)'."
+        }
+        if ($contentRule.disposition -eq 'carry') {
+            $carry += New-CarryAction -Item $item -Rule $contentRule
+        } else {
+            $abandon += New-AbandonAction -Item $item -Rule $contentRule
+        }
+    }
+
+    return [ordered]@{
+        inventory_id = $Source.inventory_id
+        product_name = $Source.product_name
+        version = $Source.version
+        target_component_id = $Rule.target_component_id
+        target_component = $Rule.target_component
+        target_version = $Rule.target_version
+        migration_method = $Rule.migration_method
+        support_boundary = $Rule.support_boundary
+        carry_forward = $carry
+        abandon = $abandon
+    }
+}
+
+function New-TargetComponent {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [hashtable]$Constraint,
+
+        [Parameter(Mandatory)]
+        [hashtable]$Inventory
+    )
+
+    $profile = Get-MinimumProfile -Constraint $Constraint -Inventory $Inventory
+    $componentId = $Constraint.component_id
+    $fqdnKey = @{
+        'tgt-fleet' = 'fleet'
+        'tgt-ops' = 'operations'
+        'tgt-automation' = 'automation'
+        'tgt-logs' = 'logs'
+        'tgt-identity' = 'identity'
+    }[$componentId]
+
+    if ($profile.availability -eq 'production-ha') {
+        $faultCount = [Math]::Min([int]$profile.node_count, $Inventory.target_placement.fault_domains.Count)
+        $faultDomains = @($Inventory.target_placement.fault_domains[0..($faultCount - 1)])
+        $antiAffinity = $true
+    } else {
+        $faultDomains = @($Inventory.target_placement.fault_domains[0])
+        $antiAffinity = $false
+    }
+
+    $basis = @(switch ($componentId) {
+        'tgt-fleet' { @('VCF entitlement requires Fleet-managed lifecycle in the primary VCF instance.') }
+        'tgt-ops' { @("24000 monitored objects require more than small-ha capacity.", "4200000 collected metrics fit the medium-ha profile.") }
+        'tgt-automation' { @("120 concurrent deployments and production-ha availability select medium-ha.") }
+        'tgt-logs' { @("70 GB/day and 9000 EPS fit medium-ha.", "500 active connections and 90 retention days fit medium-ha.") }
+        'tgt-identity' { @('VCF Identity Broker is a required greenfield identity component after the core upgrade.') }
+    })
+
+    return [ordered]@{
+        component_id = $componentId
+        name = $Constraint.name
+        version = $Constraint.version
+        role = $Constraint.role
+        fqdn = $Inventory.target_placement.reserved_fqdns[$fqdnKey]
+        placement = [ordered]@{
+            vcf_instance = $Inventory.vcf.primary_instance
+            domain = $Inventory.target_placement.domain
+            cluster = $Inventory.target_placement.cluster
+            datastore = $Inventory.target_placement.datastore
+            network = $Inventory.target_placement.network
+            fault_domains = $faultDomains
+            anti_affinity = $antiAffinity
+        }
+        sizing = [ordered]@{
+            profile = $profile.name
+            availability = $profile.availability
+            node_count = $profile.node_count
+            vcpu_per_node = $profile.vcpu_per_node
+            memory_gb_per_node = $profile.memory_gb_per_node
+            disk_gb_per_node = $profile.disk_gb_per_node
+            capacity = $profile.capacity
+            basis = $basis
+        }
+    }
+}
+
+function New-VcfAriaMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string]$InventoryPath,
+
+        [Parameter(Mandatory)]
+        [string]$CompatibilityPath,
+
+        [Parameter(Mandatory)]
+        [string]$InstallerSpecPath,
+
+        [Parameter(Mandatory)]
+        [string]$OutputPath
+    )
+
+    Import-VcfSdkPrerequisites
+    $inventory = Get-Content -Raw -LiteralPath $InventoryPath | ConvertFrom-Json -AsHashtable
+    $compatibility = Get-Content -Raw -LiteralPath $CompatibilityPath | ConvertFrom-Json -AsHashtable
+    $installer = Get-Content -Raw -LiteralPath $InstallerSpecPath | ConvertFrom-Json -AsHashtable
+
+    if ($inventory.estate_id -ne 'northstar-prod') {
+        throw 'The inventory does not identify the expected estate.'
+    }
+    if ($compatibility.snapshot_id -ne 'broadcom-vcf-9.0.2-2026-08-01') {
+        throw 'The compatibility input is not the pinned snapshot.'
+    }
+
+    $constraintById = @{}
+    foreach ($constraint in $compatibility.target_component_constraints) {
+        $constraintById[$constraint.component_id] = $constraint
+    }
+    $opsProfile = Get-MinimumProfile -Constraint $constraintById['tgt-ops'] -Inventory $inventory
+    $automationProfile = Get-MinimumProfile -Constraint $constraintById['tgt-automation'] -Inventory $inventory
+
+    # Build an SDK-backed projection of the selected installer design. These are
+    # model constructors only; the architecture generator performs no connection
+    # or Invoke operation against a live VCF endpoint.
+    $networkProjection = Initialize-VcfInstallerVcfManagementComponentsNetworkSpec `
+        -NetworkName $inventory.target_placement.network `
+        -SubnetMask $inventory.target_placement.network_subnet_mask `
+        -Gateway $inventory.target_placement.network_gateway
+    $null = Initialize-VcfInstallerVcfManagementComponentsInfrastructureSpec -LocalRegionNetwork $networkProjection
+    $opsNodes = @(
+        Initialize-VcfInstallerVcfOperationsNode -Hostname 'ops-a.northstar.example.com'
+        Initialize-VcfInstallerVcfOperationsNode -Hostname 'ops-b.northstar.example.com'
+    )
+    $null = Initialize-VcfInstallerVcfOperationsSpec `
+        -Nodes $opsNodes `
+        -ApplianceSize ($opsProfile.name -replace '-ha$', '') `
+        -LoadBalancerFqdn $inventory.target_placement.reserved_fqdns.operations `
+        -UseExistingDeployment $false `
+        -Version $compatibility.target_release
+    $null = Initialize-VcfInstallerVcfAutomationSpec `
+        -Hostname $inventory.target_placement.reserved_fqdns.automation `
+        -PlatformFqdn $inventory.target_placement.reserved_fqdns.platform `
+        -InternalClusterCidr $inventory.target_placement.automation_internal_cidr `
+        -Size ($automationProfile.name -replace '-ha$', '') `
+        -Version $compatibility.target_release `
+        -UseExistingDeployment $true
+
+    $ruleBySource = @{}
+    foreach ($rule in $compatibility.product_rules) {
+        $ruleBySource[$rule.source_inventory_id] = $rule
+    }
+    $sources = @(
+        foreach ($source in $inventory.source_products) {
+            New-SourceMigration -Source $source -Rule $ruleBySource[$source.inventory_id]
+        }
+    )
+    $targets = @(
+        foreach ($constraint in $compatibility.target_component_constraints) {
+            if ($constraint.required) {
+                New-TargetComponent -Constraint $constraint -Inventory $inventory
+            }
+        }
+    )
+
+    $ops = $sources | Where-Object inventory_id -eq 'ops-01'
+    $automation = $sources | Where-Object inventory_id -eq 'automation-01'
+    $logs = $sources | Where-Object inventory_id -eq 'logs-01'
+    $steps = @(
+        [ordered]@{
+            order = 10
+            step_id = 'bootstrap-fleet-management'
+            phase = 'prepare'
+            title = 'Patch lifecycle and bootstrap Fleet Management'
+            source_inventory_ids = @()
+            target_component_id = 'tgt-fleet'
+            depends_on = @()
+            action = 'Patch legacy lifecycle, select VCF entitlement, reserve placement, and deploy Fleet Management in the primary instance.'
+            gates = @(
+                [ordered]@{ gate_id = 'fleet-entitlement-vcf'; kind = 'entitlement'; condition = 'The entitlement branch is explicitly set to VCF, not Others.'; success_evidence = 'The lifecycle request records entitlement selection VCF.' }
+                [ordered]@{ gate_id = 'fleet-lifecycle-patch2'; kind = 'lifecycle'; condition = 'VMware Aria Suite Lifecycle 8.18 Patch 2 is installed before bootstrap.'; success_evidence = 'Lifecycle About reports 8.18 Patch 2.' }
+                [ordered]@{ gate_id = 'fleet-placement-capacity'; kind = 'capacity'; condition = 'Reserved management-domain compute, storage, DNS, and network capacity is available.'; success_evidence = 'Placement precheck returns success.' }
+            )
+            carry_item_ids = @()
+            abandon_item_ids = @()
+        }
+        [ordered]@{
+            order = 20
+            step_id = 'deploy-greenfield-operations'
+            phase = 'deploy'
+            title = 'Deploy greenfield VCF Operations 9.0.2'
+            source_inventory_ids = @('ops-01')
+            target_component_id = 'tgt-ops'
+            depends_on = @('bootstrap-fleet-management')
+            action = 'Deploy a new medium-ha VCF Operations cluster through Fleet Management and leave the 8.18.6 cluster unchanged for export.'
+            gates = @(
+                [ordered]@{ gate_id = 'ops-method-compatible'; kind = 'compatibility'; condition = 'The selected path is greenfield and no 9.0.x PAK is staged on 8.18.6.'; success_evidence = 'Deployment plan reports new-cluster mode.' }
+                [ordered]@{ gate_id = 'ops-entitlement-bound'; kind = 'entitlement'; condition = 'The target is registered under the fleet VCF entitlement.'; success_evidence = 'Target subscription state is VCF-entitled.' }
+                [ordered]@{ gate_id = 'ops-offline-backup'; kind = 'backup'; condition = 'A restorable offline backup of every 8.18.6 node exists.'; success_evidence = 'Backup restore validation is successful.' }
+                [ordered]@{ gate_id = 'ops-size-capacity'; kind = 'capacity'; condition = 'The medium-ha sizing covers 24000 objects and 4200000 collected metrics.'; success_evidence = 'Sizing precheck accepts the selected profile.' }
+                [ordered]@{ gate_id = 'ops-target-health'; kind = 'health'; condition = 'Both target analytics nodes are online and the cluster is healthy.'; success_evidence = 'Fleet health reports all target nodes healthy.' }
+            )
+            carry_item_ids = @()
+            abandon_item_ids = @()
+        }
+        [ordered]@{
+            order = 30
+            step_id = 'transfer-operations-content'
+            phase = 'content-transfer'
+            title = 'Transfer supported Operations content'
+            source_inventory_ids = @('ops-01')
+            target_component_id = 'tgt-ops'
+            depends_on = @('deploy-greenfield-operations')
+            action = 'Export and import compatible custom content, rebuild integrations and secrets, and record non-transferable history and binaries.'
+            gates = @(
+                [ordered]@{ gate_id = 'ops-content-export'; kind = 'content'; condition = 'Every carried Operations item has an export or reconfiguration record.'; success_evidence = 'Content reconciliation has no missing carried IDs.' }
+                [ordered]@{ gate_id = 'ops-post-import-health'; kind = 'health'; condition = 'Imported dashboards, metrics, views, reports, and integrations validate on target.'; success_evidence = 'Target content validation is successful.' }
+            )
+            carry_item_ids = @($ops.carry_forward.item_id)
+            abandon_item_ids = @($ops.abandon.item_id)
+        }
+        [ordered]@{
+            order = 40
+            step_id = 'import-upgrade-automation'
+            phase = 'upgrade'
+            title = 'Import and upgrade Aria Automation through Fleet'
+            source_inventory_ids = @('automation-01')
+            target_component_id = 'tgt-automation'
+            depends_on = @('transfer-operations-content')
+            action = 'Import the 8.18.1 three-node environment into Fleet Management, run prechecks, upgrade it to 9.0.2, and reconcile migrated content.'
+            gates = @(
+                [ordered]@{ gate_id = 'automation-fleet-lifecycle'; kind = 'lifecycle'; condition = 'Automation is inventoried and synchronized in Fleet Management before upgrade.'; success_evidence = 'Fleet inventory shows automation-01 synchronized.' }
+                [ordered]@{ gate_id = 'automation-path-compatible'; kind = 'compatibility'; condition = 'The workflow uses Fleet import followed by upgrade from 8.18.1.'; success_evidence = 'Upgrade plan reports import-existing mode.' }
+                [ordered]@{ gate_id = 'automation-backup'; kind = 'backup'; condition = 'A current supported backup of the Automation cluster is restorable.'; success_evidence = 'Backup validation completes successfully.' }
+                [ordered]@{ gate_id = 'automation-size-capacity'; kind = 'capacity'; condition = 'The medium-ha target supports 120 concurrent deployments.'; success_evidence = 'Fleet sizing precheck accepts medium-ha.' }
+                [ordered]@{ gate_id = 'automation-precheck-health'; kind = 'health'; condition = 'Upgrade prechecks pass and the embedded Orchestrator is healthy.'; success_evidence = 'All Fleet upgrade prechecks are green.' }
+                [ordered]@{ gate_id = 'automation-content-reconciled'; kind = 'content'; condition = 'All carried records are present and abandoned identity artifacts are documented.'; success_evidence = 'Automation content reconciliation is complete.' }
+            )
+            carry_item_ids = @($automation.carry_forward.item_id)
+            abandon_item_ids = @($automation.abandon.item_id)
+        }
+        [ordered]@{
+            order = 50
+            step_id = 'deploy-fresh-logs'
+            phase = 'deploy'
+            title = 'Deploy fresh VCF Operations for Logs'
+            source_inventory_ids = @('logs-01')
+            target_component_id = 'tgt-logs'
+            depends_on = @('import-upgrade-automation')
+            action = 'Deploy a new three-node medium-ha Logs cluster in parallel with 8.18.3 and prepare it for configuration and data transfer.'
+            gates = @(
+                [ordered]@{ gate_id = 'logs-fresh-path'; kind = 'compatibility'; condition = 'The target is a fresh deployment; no in-place or rolling upgrade is attempted.'; success_evidence = 'Fleet deployment mode is new installation.' }
+                [ordered]@{ gate_id = 'logs-source-backup'; kind = 'backup'; condition = 'The 8.18.3 configuration and retained log archive have a current backup.'; success_evidence = 'Backup job and restore check succeed.' }
+                [ordered]@{ gate_id = 'logs-size-capacity'; kind = 'capacity'; condition = 'Medium-ha covers 70 GB/day, 9000 EPS, 500 connections, and 90 retention days.'; success_evidence = 'Logs sizing calculation has positive headroom.' }
+                [ordered]@{ gate_id = 'logs-target-health'; kind = 'health'; condition = 'All three target nodes and the target VIP are healthy.'; success_evidence = 'Cluster health and VIP checks pass.' }
+                [ordered]@{ gate_id = 'logs-parallel-integrations'; kind = 'integration'; condition = 'Integration cutover order prevents duplicate forwarding during parallel operation.'; success_evidence = 'A source-to-target integration cutover list exists.' }
+            )
+            carry_item_ids = @()
+            abandon_item_ids = @()
+        }
+        [ordered]@{
+            order = 60
+            step_id = 'transfer-logs-content-and-data'
+            phase = 'content-transfer'
+            title = 'Transfer supported Logs data and configuration'
+            source_inventory_ids = @('logs-01')
+            target_component_id = 'tgt-logs'
+            depends_on = @('deploy-fresh-logs')
+            action = 'Unconfigure source integrations, configure the target, transfer the newest 90 days, and reconcile recreated content and retained agents.'
+            gates = @(
+                [ordered]@{ gate_id = 'logs-window-content'; kind = 'content'; condition = 'Only the supported newest 90-day data window is selected for transfer.'; success_evidence = 'Transfer manifest spans no more than 90 days.' }
+                [ordered]@{ gate_id = 'logs-integrations-cutover'; kind = 'integration'; condition = 'Source integrations are disabled before their target equivalents are enabled.'; success_evidence = 'Each integration has one active destination.' }
+                [ordered]@{ gate_id = 'logs-post-transfer-health'; kind = 'health'; condition = 'Target ingestion, queries, alerts, dashboards, packs, and agents validate.'; success_evidence = 'Post-transfer validation has no failed checks.' }
+            )
+            carry_item_ids = @($logs.carry_forward.item_id)
+            abandon_item_ids = @($logs.abandon.item_id)
+        }
+        [ordered]@{
+            order = 70
+            step_id = 'cutover-vcf-identity-broker'
+            phase = 'identity-cutover'
+            title = 'Install and cut over VCF Identity Broker'
+            source_inventory_ids = @()
+            target_component_id = 'tgt-identity'
+            depends_on = @('transfer-logs-content-and-data')
+            action = 'After the VCF core reaches version 9, deploy Identity Broker, configure the identity source, and repoint the migrated management components.'
+            gates = @(
+                [ordered]@{ gate_id = 'identity-core9-ready'; kind = 'identity'; condition = 'VCF Operations, SDDC Manager, and management-domain VCF core components are on version 9.'; success_evidence = 'Core 9 prerequisite validation is successful.' }
+                [ordered]@{ gate_id = 'identity-greenfield-compatible'; kind = 'compatibility'; condition = 'Identity Broker is deployed greenfield rather than upgrading VMware Identity Manager.'; success_evidence = 'Identity deployment request is new-install mode.' }
+                [ordered]@{ gate_id = 'identity-auth-health'; kind = 'health'; condition = 'Authentication and authorization work in all three migrated target products.'; success_evidence = 'Target login and role tests pass.' }
+            )
+            carry_item_ids = @()
+            abandon_item_ids = @()
+        }
+    )
+
+    $entitlement = $compatibility.entitlement_rule
+    $plan = [ordered]@{
+        schema_version = '1.0'
+        estate_id = $inventory.estate_id
+        compatibility_snapshot_id = $compatibility.snapshot_id
+        sdk_driver = [ordered]@{
+            modules = @($installer.module.required_sdk_modules)
+            installer_constructors = @($installer.module.required_installer_constructors)
+        }
+        entitlement_decision = [ordered]@{
+            source_entitlement = $entitlement.source_entitlement
+            target_selection = $entitlement.required_selection
+            selected_topology = $entitlement.required_topology
+            excluded_topology = $entitlement.excluded_topology
+            reason = $entitlement.reason
+        }
+        sources = $sources
+        target_components = $targets
+        steps = $steps
+    }
+
+    $outputParent = Split-Path -Parent $OutputPath
+    if ($outputParent -and -not (Test-Path -LiteralPath $outputParent)) {
+        New-Item -ItemType Directory -Path $outputParent -Force | Out-Null
+    }
+    $plan | ConvertTo-Json -Depth 30 | Set-Content -LiteralPath $OutputPath -Encoding utf8NoBOM
+    return $plan
+}
+
+Export-ModuleMember -Function New-VcfAriaMigrationPlan

{
  "contract_version": 1,
  "api": "VMware Cloud Foundation Operations API",
  "api_version": "9.1.0.0",
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "spec_path": "specifications/vcf-operations/vcf-operations-openapi.json",
    "commit_sha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "openapi": "3.0.1",
    "license": "Apache-2.0"
  },
  "base_path": {
    "value": "/suite-api",
    "spec_source": "servers[0].url"
  },
  "authentication": {
    "scheme_name": "Token-based-authorization",
    "spec_source": "components.securitySchemes.Token-based-authorization",
    "type": "apiKey",
    "in": "header",
    "header_name": "Authorization",
    "header_value_template": "OpsToken {token}",
    "token_source": "acquireToken response body field 'token'",
    "applies_to": [
      "getCredential",
      "createCredential",
      "getAdapterInstancesUsingCredential",
      "patchAdapterInstance",
      "deleteCredential"
    ],
    "notes": [
      "The specification declares the scheme as an apiKey carried in the 'Authorization' header but does not encode the value prefix.",
      "The prefix pinned here is the VCF Operations 9.1 product convention and is what the loopback mock enforces."
    ]
  },
  "common_request_headers": {
    "Accept": "application/json",
    "Content-Type": "application/json (bodied requests only)"
  },
  "wire_rules": {
    "json_only": "Every request and response body is application/json. The XML variants declared by the specification are out of scope for this contract.",
    "omit_unset_optionals": "An optional property that has no value MUST be omitted from the request body entirely. Emitting it as null, as an empty string, or as a zero-valued number is a contract violation.",
    "no_echo_of_read_only": "Response-only and server-maintained properties MUST NOT be sent back on a write. Round-tripping a full response object into a subsequent request is a contract violation.",
    "secrets_never_in_url": "Credential field values MUST appear only in a request body, never in a path segment, query string, or header."
  },
  "operations": [
    {
      "operationId": "acquireToken",
      "method": "POST",
      "path": "/suite-api/api/auth/token/acquire",
      "spec_path": "/api/auth/token/acquire",
      "summary": "Acquire a token to perform REST API calls",
      "authenticated": false,
      "request_body": {
        "schema": "username-password",
        "content_type": "application/json",
        "required_properties": ["username", "password"],
        "optional_properties": ["authSource"],
        "property_types": {
          "username": "string",
          "password": "string",
          "authSource": "string"
        }
      },
      "responses": {
        "200": {
          "schema": "auth-token",
          "required_properties": ["token", "validity"],
          "optional_properties": ["expiresAt", "roles"]
        },
        "401": { "description": "authentication failed" }
      }
    },
    {
      "operationId": "getCredential",
      "method": "GET",
      "path": "/suite-api/api/credentials/{id}",
      "spec_path": "/api/credentials/{id}",
      "summary": "Look up a Credential Instance by identifier",
      "authenticated": true,
      "path_parameters": [
        { "name": "id", "type": "string", "format": "uuid", "required": true }
      ],
      "request_body": null,
      "responses": {
        "200": {
          "schema": "credential",
          "required_properties": ["adapterKindKey", "credentialKindKey", "name"],
          "optional_properties": ["editable", "fields", "id"]
        },
        "404": { "description": "no such credential instance" }
      }
    },
    {
      "operationId": "createCredential",
      "method": "POST",
      "path": "/suite-api/api/credentials",
      "spec_path": "/api/credentials",
      "summary": "Create a new Credential Instance",
      "authenticated": true,
      "request_body": {
        "schema": "credential",
        "content_type": "application/json",
        "required_properties": ["adapterKindKey", "credentialKindKey", "name"],
        "optional_properties": ["fields"],
        "forbidden_properties": ["id", "editable"],
        "forbidden_reason": "The specification states that 'id' must be null for credential instance creation requests; a dependency-free client expresses that by omitting the key. 'editable' is server-maintained.",
        "property_types": {
          "name": "string",
          "adapterKindKey": "string",
          "credentialKindKey": "string",
          "fields": "array of name-value"
        },
        "nested_schemas": {
          "name-value": {
            "required_properties": ["name", "value"],
            "optional_properties": [],
            "property_types": { "name": "string", "value": "string" }
          }
        }
      },
      "responses": {
        "201": {
          "schema": "credential",
          "required_properties": ["adapterKindKey", "credentialKindKey", "name"],
          "optional_properties": ["editable", "fields", "id"]
        },
        "400": { "description": "malformed request" },
        "422": { "description": "unprocessable credential instance" }
      }
    },
    {
      "operationId": "getAdapterInstancesUsingCredential",
      "method": "GET",
      "path": "/suite-api/api/credentials/{id}/adapters",
      "spec_path": "/api/credentials/{id}/adapters",
      "summary": "Enumerate the Adapter Instances that currently use a Credential Instance",
      "authenticated": true,
      "path_parameters": [
        { "name": "id", "type": "string", "format": "uuid", "required": true }
      ],
      "request_body": null,
      "responses": {
        "200": {
          "schema": "adapter-instances",
          "required_properties": [],
          "optional_properties": ["adapterInstancesInfoDto"],
          "notes": "adapterInstancesInfoDto is an array of adapter-instance. An absent or empty array means no adapter instance is bound to the credential any more."
        },
        "404": { "description": "no such credential instance" }
      }
    },
    {
      "operationId": "patchAdapterInstance",
      "method": "PATCH",
      "path": "/suite-api/api/adapters",
      "spec_path": "/api/adapters",
      "summary": "Partially update an Adapter Instance",
      "authenticated": true,
      "request_body": {
        "schema": "adapter-instance",
        "content_type": "application/json",
        "required_properties": ["resourceKey"],
        "identifying_properties": ["id"],
        "mutated_properties": ["credentialInstanceId"],
        "permitted_properties": ["id", "resourceKey", "credentialInstanceId"],
        "forbidden_properties": [
          "adapter-certificates",
          "collectorGroupId",
          "collectorId",
          "description",
          "lastCollected",
          "lastHeartbeat",
          "links",
          "messageFromAdapterInstance",
          "monitoringInterval",
          "monitoringIntervalSeconds",
          "numberOfMetricsCollected",
          "numberOfResourcesCollected",
          "physicalDatacenterId"
        ],
        "forbidden_reason": "PATCH is a partial update. Anything not being changed is either server-maintained or unset for this rotation and must be omitted, not echoed back from the read.",
        "property_types": {
          "id": "string (uuid)",
          "credentialInstanceId": "string (uuid)",
          "resourceKey": "resource-key"
        },
        "nested_schemas": {
          "resource-key": {
            "required_properties": ["adapterKindKey", "name", "resourceKindKey"],
            "optional_properties": ["extension", "links", "resourceIdentifiers"],
            "echo_rule": "resourceKey is a composite identity key, not a mutation. It must be sent back exactly as getAdapterInstancesUsingCredential returned it for that adapter instance, with no properties added, dropped, or rewritten."
          }
        }
      },
      "responses": {
        "200": {
          "schema": "adapter-instance",
          "required_properties": ["resourceKey"],
          "optional_properties": ["id", "credentialInstanceId"]
        },
        "400": { "description": "malformed request" }
      }
    },
    {
      "operationId": "deleteCredential",
      "method": "DELETE",
      "path": "/suite-api/api/credentials/{id}",
      "spec_path": "/api/credentials/{id}",
      "summary": "Delete a Credential Instance",
      "authenticated": true,
      "path_parameters": [
        { "name": "id", "type": "string", "format": "uuid", "required": true }
      ],
      "request_body": null,
      "responses": {
        "204": { "description": "credential instance deleted" },
        "400": {
          "description": "the credential instance could not be deleted; the server rejects deletion while adapter instances still reference it"
        }
      }
    }
  ],
  "not_in_contract": {
    "reason": "These operations exist in the specification but are deliberately excluded from this rotation contract. The loopback mock serves only the operations listed under 'operations' and answers anything else with 404.",
    "operationIds": [
      "updateCredential",
      "partialUpdateCredential",
      "deleteAdapterInstance",
      "updateAdapterInstance",
      "createAdapterInstance",
      "enumerateAdapterInstances",
      "getAdapterInstance",
      "getCredentials",
      "getCredentialKinds",
      "getResourcesUsingCredential",
      "testConnection",
      "releaseToken"
    ],
    "rotation_note": "updateCredential (PUT /api/credentials) and partialUpdateCredential (PATCH /api/credentials) overwrite a credential instance in place. In-flight collections holding the old secret have no cutover window, so in-place overwrite is not a drain-safe rotation and is not part of this contract."
  }
}

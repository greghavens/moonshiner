+    private Object send(String method, String path, Object body, int expectedStatus)
+            throws IOException, InterruptedException {
+        HttpRequest.BodyPublisher publisher;
+        String rendered = null;
+        if (body == null) {
+            publisher = HttpRequest.BodyPublishers.noBody();
+        } else {
+            rendered = Json.write(body);
+            publisher = HttpRequest.BodyPublishers.ofString(rendered,
+                    StandardCharsets.UTF_8);
+        }

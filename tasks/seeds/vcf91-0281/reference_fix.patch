+                    || (c >= '0' && c <= '9') || c == '-' || c == '.' || c == '_'
+                    || c == '~';
+            if (unreserved) {
+                sb.append((char) c);
+            } else {
+                sb.append('%').append(String.format("%02X", c));
+            }
+        }
+        return sb.toString();
+    }

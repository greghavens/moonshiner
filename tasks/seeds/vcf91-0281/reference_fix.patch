+                .uri(URI.create(baseUrl + BASE_PATH + path))
+                .timeout(Duration.ofSeconds(30))
+                .header("Accept", JSON)
+                .method(method, publisher);
+        if (rendered != null) {
+            builder.header("Content-Type", JSON);
+        }
+        if (token != null) {
+            builder.header("Authorization", AUTH_PREFIX + token);
+        }
+
+        HttpResponse<String> response = http.send(builder.build(),
+                HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+        String payload = response.body();
+        if (response.statusCode() != expectedStatus) {
+            throw new IOException(method + " " + path + " returned "
+                    + response.statusCode() + " (expected " + expectedStatus
+                    + "): " + describe(payload));
+        }
+        if (payload == null || payload.isEmpty()) {
+            return null;
+        }
+        return Json.parse(payload);
+    }

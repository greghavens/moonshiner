  "operations_used": [
    {
      "operationId": "acquireToken",
      "method": "POST",
      "spec_path": "/api/auth/token/acquire",
      "json_pointer": "/paths/~1api~1auth~1token~1acquire/post",
      "request_schema": "username-password",
      "response_schema": "auth-token",
      "used_for": "Acquire the session token that authorizes every other call in the rotation."
    },
    {
      "operationId": "getCredential",
      "method": "GET",
      "spec_path": "/api/credentials/{id}",
      "json_pointer": "/paths/~1api~1credentials~1{id}/get",
      "request_schema": null,
      "response_schema": "credential",
      "used_for": "Read the outgoing credential instance so the replacement can be created with the same adapter kind and credential kind."
    },
    {
      "operationId": "createCredential",
      "method": "POST",
      "spec_path": "/api/credentials",
      "json_pointer": "/paths/~1api~1credentials/post",
      "request_schema": "credential",
      "response_schema": "credential",
      "used_for": "Create the replacement credential instance alongside the outgoing one, so both secrets are valid during cutover."
    },
    {
      "operationId": "getAdapterInstancesUsingCredential",
      "method": "GET",
      "spec_path": "/api/credentials/{id}/adapters",
      "json_pointer": "/paths/~1api~1credentials~1{id}~1adapters/get",
      "request_schema": null,
      "response_schema": "adapter-instances",
      "used_for": "Enumerate the adapter instances bound to the outgoing credential, and afterwards poll the same operation to confirm the binding has drained to zero."
    },
    {
      "operationId": "patchAdapterInstance",
      "method": "PATCH",
      "spec_path": "/api/adapters",
      "json_pointer": "/paths/~1api~1adapters/patch",
      "request_schema": "adapter-instance",
      "response_schema": "adapter-instance",
      "used_for": "Repoint one adapter instance at the replacement credential without disturbing any of its other settings."
    },
    {
      "operationId": "deleteCredential",
      "method": "DELETE",
      "spec_path": "/api/credentials/{id}",
      "json_pointer": "/paths/~1api~1credentials~1{id}/delete",
      "request_schema": null,
      "response_schema": null,
      "used_for": "Retire the outgoing credential instance, only once the drain poll shows nothing is still using it."
    }
  ],

diff --git a/vcf_architect/architect.py b/vcf_architect/architect.py
index 77e7eaa..d3af512 100644
--- a/vcf_architect/architect.py
+++ b/vcf_architect/architect.py
@@ -1,6 +1,221 @@
 """Build the installer specification and migration plan."""
 
+import math
+
+
+PASSWORDS = {
+    "esxi": "CHANGE_ME_ESXI_9_0!",
+    "vcenter": "CHANGE_ME_VCENTER_9_0!",
+    "sso": "CHANGE_ME_SSO_9!",
+    "sddc": "CHANGE_ME_SDDC_9!",
+    "nsx": "CHANGE_ME_NSX_9_0!",
+    "operations": "CHANGE_ME_OPERATIONS_9!",
+    "automation": "CHANGE_ME_AUTOMATION_9!",
+}
+
+
+def _minimum_host_count(requirements):
+    capacity = requirements["capacity"]
+    target = capacity["requiredAfterHostFailure"]
+    host = capacity["host"]
+    failures = requirements["availability"]["hostFailuresToTolerate"]
+    cpu = math.ceil(target["cpuCores"] / host["cpuCores"]) + failures
+    memory = math.ceil(target["memoryGiB"] / host["memoryGiB"]) + failures
+    storage = capacity["storage"]
+    per_host_usable = (
+        host["rawStorageTiB"]
+        / storage["mirrorCopies"]
+        * (1 - storage["freeSpacePercent"] / 100)
+    )
+    disk = math.ceil(target["usableStorageTiB"] / per_host_usable) + failures
+    return max(cpu, memory, disk)
+
+
+def _networks(requirements):
+    return [
+        {
+            "networkType": item["networkType"],
+            "subnet": item["cidr"],
+            "gateway": item["gateway"],
+            "subnetMask": item["subnetMask"],
+            "includeIpAddressRanges": [{
+                "startIpAddress": item["rangeStart"],
+                "endIpAddress": item["rangeEnd"],
+            }],
+            "vlanId": item["vlanId"],
+            "mtu": item["mtu"],
+        }
+        for item in requirements["networks"]
+    ]
+
+
+def _sddc_spec(requirements):
+    target = requirements["targetBundle"]
+    naming = requirements["hostNaming"]
+    count = _minimum_host_count(requirements)
+    hosts = [
+        {
+            "hostname": f"{naming['prefix']}{number:0{naming['digits']}d}",
+            "credentials": {"username": "root", "password": PASSWORDS["esxi"]},
+        }
+        for number in range(naming["firstIndex"], naming["firstIndex"] + count)
+    ]
+    networks = _networks(requirements)
+    switch = requirements["switching"]
+    nsx = requirements["nsx"]
+    appliances = requirements["appliances"]
+    ftt = requirements["availability"]["hostFailuresToTolerate"]
+
+    return {
+        "sddcId": requirements["designId"],
+        "vcfInstanceName": requirements["instanceName"],
+        "workflowType": "VCF",
+        "version": target,
+        "hostSpecs": hosts,
+        "vcenterSpec": {
+            "vcenterHostname": appliances["vcenterHostname"],
+            "rootVcenterPassword": PASSWORDS["vcenter"],
+            "vmSize": "medium",
+            "storageSize": "lstorage",
+            "ssoDomain": "vsphere.local",
+            "adminUserSsoUsername": "administrator",
+            "adminUserSsoPassword": PASSWORDS["sso"],
+            "useExistingDeployment": False,
+            "version": target,
+        },
+        "clusterSpec": {
+            "datacenterName": f"{requirements['designId']}-dc",
+            "clusterName": f"{requirements['designId']}-cluster",
+        },
+        "dvsSpecs": [{
+            "dvsName": switch["dvsName"],
+            "networks": [item["networkType"] for item in requirements["networks"]],
+            "mtu": switch["mtu"],
+            "vmnicsToUplinks": switch["uplinks"],
+            "nsxtSwitchConfig": {
+                "transportZones": [
+                    {"name": f"{requirements['designId']}-tz-overlay", "transportType": "OVERLAY"},
+                    {"name": f"{requirements['designId']}-tz-vlan", "transportType": "VLAN"},
+                ],
+                "hostSwitchOperationalMode": "STANDARD",
+                "ipAssignmentType": "StaticIpPoolSpec",
+            },
+        }],
+        "nsxtSpec": {
+            "nsxtManagers": [{"hostname": name} for name in nsx["managerHostnames"]],
+            "nsxtManagerSize": "medium",
+            "vipFqdn": nsx["vipFqdn"],
+            "rootNsxtManagerPassword": PASSWORDS["nsx"],
+            "nsxtAdminPassword": PASSWORDS["nsx"],
+            "nsxtAuditPassword": PASSWORDS["nsx"],
+            "transportVlanId": nsx["transportVlanId"],
+            "ipAddressPoolSpec": {
+                "name": nsx["tepPoolName"],
+                "subnets": [{
+                    "cidr": nsx["tepCidr"],
+                    "gateway": nsx["tepGateway"],
+                    "ipAddressPoolRanges": [{
+                        "start": nsx["tepRangeStart"],
+                        "end": nsx["tepRangeEnd"],
+                    }],
+                }],
+            },
+            "useExistingDeployment": False,
+            "version": target,
+        },
+        "networkSpecs": networks,
+        "dnsSpec": {
+            "subdomain": requirements["site"]["dnsSubdomain"],
+            "nameservers": requirements["site"]["dnsServers"],
+        },
+        "ntpServers": requirements["site"]["ntpServers"],
+        "sddcManagerSpec": {
+            "hostname": appliances["sddcManagerHostname"],
+            "rootPassword": PASSWORDS["sddc"],
+            "sshPassword": PASSWORDS["sddc"],
+            "localUserPassword": PASSWORDS["sddc"],
+            "useExistingDeployment": False,
+            "version": target,
+        },
+        "managementPoolName": f"{requirements['designId']}-network-pool",
+        "ceipEnabled": False,
+        "skipEsxThumbprintValidation": False,
+        "skipGatewayPingValidation": False,
+        "securitySpec": {"esxiCertsMode": "VMCA"},
+        "datastoreSpec": {
+            "vsanSpec": {
+                "datastoreName": f"{requirements['designId']}-vsan",
+                "esaConfig": {"enabled": True},
+                "failuresToTolerate": ftt,
+            }
+        },
+        "vcfOperationsFleetManagementSpec": {
+            "hostname": appliances["fleetManagementHostname"],
+            "rootUserPassword": PASSWORDS["operations"],
+            "adminUserPassword": PASSWORDS["operations"],
+            "useExistingDeployment": False,
+            "version": target,
+        },
+        "vcfOperationsSpec": {
+            "nodes": [
+                {
+                    "hostname": item["hostname"],
+                    "type": item["type"],
+                    "rootUserPassword": PASSWORDS["operations"],
+                }
+                for item in appliances["operationsNodes"]
+            ],
+            "adminUserPassword": PASSWORDS["operations"],
+            "applianceSize": "medium",
+            "loadBalancerFqdn": appliances["operationsLoadBalancerFqdn"],
+            "useExistingDeployment": False,
+            "version": target,
+        },
+        "vcfAutomationSpec": {
+            "hostname": appliances["automationHostname"],
+            "adminUserPassword": PASSWORDS["automation"],
+            "ipPool": appliances["automationIpPool"],
+            "internalClusterCidr": "198.18.0.0/15",
+            "nodePrefix": "dal01-auto-node",
+            "useExistingDeployment": False,
+            "version": target,
+        },
+    }
+
+
+def _migration_plan(estate, compatibility):
+    if estate["estateId"] == "":
+        raise ValueError("estateId must not be blank")
+    rules = {item["componentId"]: item for item in compatibility["components"]}
+    steps = []
+    for component in estate["components"]:
+        try:
+            rule = rules[component["id"]]
+        except KeyError as exc:
+            raise ValueError(f"missing compatibility rule for {component['id']}") from exc
+        if component["name"] != rule["currentName"] or component["version"] != rule["currentVersion"]:
+            raise ValueError(f"compatibility rule does not match {component['id']}")
+        steps.append({
+            "order": rule["order"],
+            "componentId": component["id"],
+            "component": component["name"],
+            "currentVersion": component["version"],
+            "targetComponent": rule["targetName"],
+            "targetVersion": rule["targetVersion"],
+            "action": rule["requiredAction"],
+            "gates": list(rule["requiredGates"]),
+            "dataDisposition": rule["dataDisposition"],
+        })
+    return {
+        "schemaVersion": "1.0",
+        "estateId": estate["estateId"],
+        "targetBundle": compatibility["targetBundle"],
+        "steps": steps,
+    }
+
 
 def build_architecture(requirements, estate, compatibility):
     """Return ``(sddc_spec, migration_plan)`` for the supplied inputs."""
-    raise NotImplementedError("architecture generation has not been implemented")
+    if requirements["targetBundle"] != compatibility["targetBundle"]:
+        raise ValueError("requirements and compatibility target bundles differ")
+    return _sddc_spec(requirements), _migration_plan(estate, compatibility)

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0051:migration-plan",
  "title": "VCF 9.0 estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "estateId", "targetBundle", "steps"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "targetBundle": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "componentId",
          "component",
          "currentVersion",
          "targetComponent",
          "targetVersion",
          "action",
          "gates",
          "dataDisposition"
        ],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "componentId": {"type": "string", "minLength": 1},
          "component": {"type": "string", "minLength": 1},
          "currentVersion": {"type": "string", "minLength": 1},
          "targetComponent": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "action": {
            "type": "string",
            "enum": [
              "in-place-upgrade",
              "import-then-upgrade",
              "side-by-side-redeploy",
              "retain"
            ]
          },
          "gates": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "dataDisposition": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

+    private HttpResponse<String> send(String method, String path, String query, String body)
+            throws IOException, InterruptedException {
+        URI uri = URI.create(baseUrl + path + (query.isEmpty() ? "" : "?" + query));
+        HttpRequest request = HttpRequest.newBuilder(uri)
+                .header("Authorization", "Bearer " + bearerToken)
+                .header("Accept", "application/json")
+                .header("Content-Type", "application/json")
+                .method(method, HttpRequest.BodyPublishers.ofString(body, StandardCharsets.UTF_8))
+                .build();
+        return httpClient.send(
+                request, HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+    }
+
+    private String query(Boolean validatePrincipals) {
+        List<String> parameters = new ArrayList<>();
+        if (apiVersion != null) {
+            parameters.add("apiVersion=" + queryValue(apiVersion));
+        }
+        if (validatePrincipals != null) {
+            parameters.add("validatePrincipals=" + validatePrincipals);
+        }
+        return String.join("&", parameters);
+    }
+
+    private static String projectBody(ProjectChange change) {
+        StringBuilder json = new StringBuilder("{");
+        stringField(json, "name", change.name());
+        if (change.description() != null) {
+            comma(json);
+            stringField(json, "description", change.description());
+        }
+        return json.append('}').toString();
+    }
+
+    private static String zonesBody(List<ZoneAssignment> assignments) {
+        if (assignments == null) {
+            return "{}";
+        }
+        StringBuilder json = new StringBuilder("{\"zoneAssignmentSpecifications\":[");
+        for (int index = 0; index < assignments.size(); index++) {
+            if (index > 0) {
+                json.append(',');
+            }
+            ZoneAssignment assignment = assignments.get(index);
+            json.append('{');
+            stringField(json, "zoneId", assignment.zoneId());
+            numberField(json, "priority", assignment.priority());
+            numberField(json, "maxNumberInstances", assignment.maxNumberInstances());
+            numberField(json, "memoryLimitMB", assignment.memoryLimitMB());
+            numberField(json, "cpuLimit", assignment.cpuLimit());
+            numberField(json, "storageLimitGB", assignment.storageLimitGB());
+            json.append('}');
+        }
+        return json.append("]}").toString();
+    }
+
+    private static String metadataBody(List<Tag> tags) {
+        if (tags == null) {
+            return "{}";
+        }
+        StringBuilder json = new StringBuilder("{\"tags\":[");
+        for (int index = 0; index < tags.size(); index++) {
+            if (index > 0) {
+                json.append(',');
+            }
+            Tag tag = tags.get(index);
+            json.append('{');
+            stringField(json, "key", tag.key());
+            if (tag.value() != null) {
+                comma(json);
+                stringField(json, "value", tag.value());
+            }
+            json.append('}');
+        }
+        return json.append("]}").toString();
+    }
+
+    private static void stringField(StringBuilder json, String name, String value) {
+        json.append('"').append(name).append("\":\"").append(jsonEscape(value)).append('"');
+    }
+
+    private static void numberField(StringBuilder json, String name, Number value) {
+        if (value != null) {
+            comma(json);
+            json.append('"').append(name).append("\":").append(value);
+        }
+    }
+
+    private static void comma(StringBuilder json) {
+        json.append(',');
+    }
+
+    private static String jsonEscape(String value) {
+        StringBuilder escaped = new StringBuilder();
+        for (int offset = 0; offset < value.length(); ) {
+            int codePoint = value.codePointAt(offset);
+            offset += Character.charCount(codePoint);
+            switch (codePoint) {
+                case '"' -> escaped.append("\\\"");
+                case '\\' -> escaped.append("\\\\");
+                case '\b' -> escaped.append("\\b");
+                case '\f' -> escaped.append("\\f");
+                case '\n' -> escaped.append("\\n");
+                case '\r' -> escaped.append("\\r");
+                case '\t' -> escaped.append("\\t");
+                default -> {
+                    if (codePoint < 0x20) {
+                        escaped.append(String.format("\\u%04x", codePoint));
+                    } else {
+                        escaped.appendCodePoint(codePoint);
+                    }
+                }
+            }
+        }
+        return escaped.toString();
+    }
+
+    private static String pathSegment(String value) {
+        return queryValue(value).replace("+", "%20");
+    }
+
+    private static String queryValue(String value) {
+        return URLEncoder.encode(value, StandardCharsets.UTF_8).replace("%7E", "~");
+    }
+
+    private static boolean failed(HttpResponse<String> response) {
+        return response.statusCode() < 200 || response.statusCode() >= 300;
+    }
+
+    private static StepResult result(
+            String operation, HttpResponse<String> response, boolean acceptedOperation) {
+        int status = response.statusCode();
+        if (status < 200 || status >= 300) {
+            return new StepResult(
+                    operation,
+                    status,
+                    State.FAILED,
+                    null,
+                    null,
+                    jsonString(response.body(), "messageId"),
+                    jsonString(response.body(), "message"));
+        }
+        State state = acceptedOperation && status == 202 ? State.ACCEPTED : State.SUCCEEDED;
+        return new StepResult(
+                operation,
+                status,
+                state,
+                state == State.ACCEPTED ? jsonString(response.body(), "id") : null,
+                state == State.ACCEPTED ? jsonString(response.body(), "status") : null,
+                null,
+                null);
+    }
+
+    private static String jsonString(String json, String key) {
+        String needle = "\"" + key + "\"";
+        int keyAt = json.indexOf(needle);
+        if (keyAt < 0) {
+            return null;
+        }
+        int colon = json.indexOf(':', keyAt + needle.length());
+        if (colon < 0) {
+            return null;
+        }
+        int quote = colon + 1;
+        while (quote < json.length() && Character.isWhitespace(json.charAt(quote))) {
+            quote++;
+        }
+        if (quote >= json.length() || json.charAt(quote) != '"') {
+            return null;
+        }
+        StringBuilder value = new StringBuilder();
+        for (int index = quote + 1; index < json.length(); index++) {
+            char current = json.charAt(index);
+            if (current == '"') {
+                return value.toString();
+            }
+            if (current != '\\') {
+                value.append(current);
+                continue;
+            }
+            if (++index >= json.length()) {
+                return null;
+            }
+            char escaped = json.charAt(index);
+            switch (escaped) {
+                case '"', '\\', '/' -> value.append(escaped);
+                case 'b' -> value.append('\b');
+                case 'f' -> value.append('\f');
+                case 'n' -> value.append('\n');
+                case 'r' -> value.append('\r');
+                case 't' -> value.append('\t');
+                case 'u' -> {
+                    if (index + 4 >= json.length()) {
+                        return null;
+                    }
+                    try {
+                        value.append((char) Integer.parseInt(json, index + 1, index + 5, 16));
+                    } catch (NumberFormatException malformedEscape) {
+                        return null;
+                    }
+                    index += 4;
+                }
+                default -> {
+                    return null;
+                }
+            }
+        }
+        return null;
     }

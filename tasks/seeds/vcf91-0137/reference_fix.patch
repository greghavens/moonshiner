+function Assert-VcfClusterIdentity {
+    param(
+        [Parameter(Mandatory)]
+        [object] $Cluster,
+
+        [Parameter(Mandatory)]
+        [string] $Namespace,
+
+        [Parameter(Mandatory)]
+        [string] $ClusterName,
+
+        [Parameter(Mandatory)]
+        [string] $Context
+    )
+
+    Assert-VcfExactString `
+        -Value (Get-VcfMember $Cluster 'apiVersion' $Context) `
+        -Expected 'cluster.x-k8s.io/v1beta2' `
+        -Context "$Context apiVersion"
+    Assert-VcfExactString `
+        -Value (Get-VcfMember $Cluster 'kind' $Context) `
+        -Expected 'Cluster' `
+        -Context "$Context kind"
+    $Metadata = Get-VcfMember $Cluster 'metadata' $Context
+    if ($null -eq $Metadata) {
+        throw [InvalidDataException]::new("$Context metadata is null.")
+    }
+    Assert-VcfExactString `
+        -Value (Get-VcfMember $Metadata 'namespace' "$Context metadata") `
+        -Expected $Namespace `
+        -Context "$Context namespace"
+    Assert-VcfExactString `
+        -Value (Get-VcfMember $Metadata 'name' "$Context metadata") `
+        -Expected $ClusterName `
+        -Context "$Context name"
+}
+
+function Get-VcfSortedClusterNames {
+    param(
+        [Parameter(Mandatory)]
+        [object] $ClusterList,
+
+        [Parameter(Mandatory)]
+        [string] $Namespace
+    )
+
+    Assert-VcfExactString `
+        -Value (Get-VcfMember $ClusterList 'apiVersion' 'The Cluster list') `
+        -Expected 'cluster.x-k8s.io/v1beta2' `
+        -Context 'The Cluster list apiVersion'
+    Assert-VcfExactString `
+        -Value (Get-VcfMember $ClusterList 'kind' 'The Cluster list') `
+        -Expected 'ClusterList' `
+        -Context 'The Cluster list kind'
+    $ItemsValue = Get-VcfMember $ClusterList 'items' 'The Cluster list'
+    if ($null -eq $ItemsValue) {
+        throw [InvalidDataException]::new(
+            'The Cluster list items collection is null.'
+        )
+    }
+    $Names = [Collections.Generic.List[string]]::new()
+    $Seen = [Collections.Generic.HashSet[string]]::new(
+        [StringComparer]::Ordinal
+    )
+    foreach ($Item in @($ItemsValue)) {
+        if ($null -eq $Item) {
+            throw [InvalidDataException]::new(
+                'The Cluster list contains a null item.'
+            )
+        }
+        Assert-VcfExactString `
+            -Value (Get-VcfMember $Item 'apiVersion' 'A Cluster list item') `
+            -Expected 'cluster.x-k8s.io/v1beta2' `
+            -Context 'A Cluster list item apiVersion'
+        Assert-VcfExactString `
+            -Value (Get-VcfMember $Item 'kind' 'A Cluster list item') `
+            -Expected 'Cluster' `
+            -Context 'A Cluster list item kind'
+        $Metadata = Get-VcfMember $Item 'metadata' 'A Cluster list item'
+        if ($null -eq $Metadata) {
+            throw [InvalidDataException]::new(
+                'A Cluster list item has null metadata.'
+            )
+        }
+        Assert-VcfExactString `
+            -Value (
+                Get-VcfMember $Metadata 'namespace' 'Cluster list metadata'
+            ) `
+            -Expected $Namespace `
+            -Context 'A Cluster list item namespace'
+        $Name = Get-VcfMember $Metadata 'name' 'Cluster list metadata'
+        if ($Name -isnot [string] -or [string]::IsNullOrWhiteSpace($Name)) {
+            throw [InvalidDataException]::new(
+                'A Cluster list item has no name.'
+            )
+        }
+        if (-not $Seen.Add($Name)) {
+            throw [InvalidDataException]::new(
+                'The Cluster list contains duplicate names.'
+            )
+        }
+        $Names.Add($Name)
+    }
+    [string[]] $Result = $Names.ToArray()
+    [Array]::Sort($Result, [StringComparer]::Ordinal)
+    return $Result
+}

+function Invoke-VcfKubernetesRequest {
+    param(
+        [Parameter(Mandatory)]
+        [Net.Http.HttpClient] $Client,
+
+        [Parameter(Mandatory)]
+        [Net.Http.HttpMethod] $Method,
+
+        [Parameter(Mandatory)]
+        [uri] $Uri,
+
+        [Parameter(Mandatory)]
+        [string] $Token,
+
+        [Parameter(Mandatory)]
+        [int] $ExpectedStatus,
+
+        [AllowNull()]
+        [string] $JsonBody,
+
+        [Parameter(Mandatory)]
+        [string] $Context
+    )
+
+    $Request = [Net.Http.HttpRequestMessage]::new($Method, $Uri)
+    $Response = $null
+    try {
+        $Request.Headers.Accept.Add(
+            [Net.Http.Headers.MediaTypeWithQualityHeaderValue]::new(
+                'application/json'
+            )
+        )
+        $Request.Headers.Authorization = (
+            [Net.Http.Headers.AuthenticationHeaderValue]::new(
+                'Bearer',
+                $Token
+            )
+        )
+        if ($null -ne $JsonBody) {
+            $Bytes = [Text.Encoding]::UTF8.GetBytes($JsonBody)
+            $Request.Content = [Net.Http.ByteArrayContent]::new($Bytes)
+            $Request.Content.Headers.ContentType = (
+                [Net.Http.Headers.MediaTypeHeaderValue]::new(
+                    'application/json'
+                )
+            )
+        }
+        try {
+            $Response = $Client.Send($Request)
+        }
+        catch {
+            throw [IOException]::new(
+                "The $Context Kubernetes request failed."
+            )
+        }
+        if ([int] $Response.StatusCode -ne $ExpectedStatus) {
+            throw [IOException]::new(
+                "The $Context Kubernetes request was not successful."
+            )
+        }
+        return $Response.Content.ReadAsStringAsync().GetAwaiter().GetResult()
+    }
+    finally {
+        if ($null -ne $Response) {
+            $Response.Dispose()
+        }
+        $Request.Dispose()
+    }
+}

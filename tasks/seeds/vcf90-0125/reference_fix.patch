+    private static ParsedString parseJsonString(String json, int start) throws IOException {
+        if (start >= json.length() || json.charAt(start) != '"') {
+            throw new IOException("expected JSON string");
+        }
+        StringBuilder result = new StringBuilder();
+        for (int index = start + 1; index < json.length(); index++) {
+            char current = json.charAt(index);
+            if (current == '"') {
+                return new ParsedString(result.toString(), index + 1);
+            }
+            if (current != '\\') {
+                result.append(current);
+                continue;
+            }
+            if (++index >= json.length()) {
+                throw new IOException("unterminated JSON escape");
+            }
+            char escaped = json.charAt(index);
+            switch (escaped) {
+                case '"', '\\', '/' -> result.append(escaped);
+                case 'b' -> result.append('\b');
+                case 'f' -> result.append('\f');
+                case 'n' -> result.append('\n');
+                case 'r' -> result.append('\r');
+                case 't' -> result.append('\t');
+                case 'u' -> {
+                    if (index + 4 >= json.length()) {
+                        throw new IOException("short JSON unicode escape");
+                    }
+                    int codeUnit = 0;
+                    for (int offset = 1; offset <= 4; offset++) {
+                        int digit = Character.digit(json.charAt(index + offset), 16);
+                        if (digit < 0) {
+                            throw new IOException("invalid JSON unicode escape");
+                        }
+                        codeUnit = (codeUnit << 4) | digit;
+                    }
+                    result.append((char) codeUnit);
+                    index += 4;
+                }
+                default -> throw new IOException("invalid JSON escape");
+            }
+        }
+        throw new IOException("unterminated JSON string");
     }

{
  "openapi": "3.0.3",
  "info": {
    "title": "Snapshot Appliance API",
    "version": "9.0.0.0"
  },
  "source": {
    "tag": "9.0.0.0",
    "commit_sha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "spec_path": "specifications/vsan-data-protection/vsan-data-protection-openapi.yaml"
  },
  "server_base_path": "/api",
  "securitySchemes": {
    "api_key_auth": {
      "type": "apiKey",
      "name": "vmware-api-session-id",
      "in": "header"
    }
  },
  "operations": [
    {
      "operationId": "Snapservice.Clusters.ProtectionGroups_create$Task",
      "method": "POST",
      "path": "/snapservice/clusters/{cluster}/protection-groups?vmw-task=true",
      "security": [
        {
          "api_key_auth": []
        }
      ],
      "parameters": [
        {
          "name": "cluster",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": {
          "name": "Snapservice.ProtectionGroupSpec",
          "type": "object",
          "required": [
            "name",
            "target_entities"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "target_entities": {
              "schema": "Snapservice.TargetEntities",
              "type": "object",
              "properties": {
                "vm_name_patterns": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "vms": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "snapshot_policies": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Snapservice.SnapshotPolicy"
              }
            },
            "locked": {
              "type": "boolean"
            },
            "replication_policies": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Snapservice.ReplicationPolicy"
              }
            }
          }
        }
      },
      "responses": {
        "202": {
          "contentType": "application/json",
          "schema": {
            "type": "string"
          },
          "description": "ID of newly-created protection group."
        },
        "401": {
          "contentType": "application/json",
          "schema": {
            "$ref": "#/components/schemas/Vapi.Std.Errors.Unauthenticated"
          }
        }
      }
    },
    {
      "operationId": "Snapservice.Clusters.ProtectionGroups_get",
      "method": "GET",
      "path": "/snapservice/clusters/{cluster}/protection-groups/{pg}",
      "security": [
        {
          "api_key_auth": []
        }
      ],
      "parameters": [
        {
          "name": "cluster",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "pg",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "contentType": "application/json",
          "schema": {
            "name": "Snapservice.ProtectionGroupInfo",
            "type": "object",
            "required": [
              "locked",
              "name",
              "snapshot_policies",
              "snapshots",
              "status",
              "target_entities",
              "vms"
            ],
            "status_enum": [
              "ACTIVE",
              "PAUSED",
              "MARKED_FOR_DELETE",
              "DEMOTED",
              "DORMANT",
              "RECOVERY"
            ]
          }
        },
        "401": {
          "contentType": "application/json",
          "schema": {
            "$ref": "#/components/schemas/Vapi.Std.Errors.Unauthenticated"
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0038:migration-plan:1.0",
  "title": "VCF 9.1 estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "estateId", "targetRelease", "steps"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "targetRelease": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "componentId", "componentName", "currentVersion", "targetVersion", "action", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "componentId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "componentName": {"type": "string", "minLength": 1},
          "currentVersion": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "action": {
            "enum": [
              "IN_PLACE_UPGRADE",
              "LCM_UPGRADE",
              "ROLLING_LCM_UPGRADE",
              "SIDE_BY_SIDE_MIGRATION",
              "MIGRATE_THEN_DECOMMISSION",
              "DECOMMISSION"
            ]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
          }
        }
      }
    }
  }
}

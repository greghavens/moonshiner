+def _origin(value: object, name: str) -> _Origin:
+    text = _required_string(value, name)
+    if any(character.isspace() or character in "?#" for character in text):
+        raise ValueError(f"{name} must be an absolute HTTP(S) origin")
+    if "\r" in text or "\n" in text:
+        raise ValueError(f"{name} contains a control character")
+    parsed = urlsplit(text)
+    if parsed.scheme not in {"http", "https"}:
+        raise ValueError(f"{name} must use http or https")
+    if (
+        not parsed.hostname
+        or parsed.username is not None
+        or parsed.password is not None
+        or parsed.path not in {"", "/"}
+        or parsed.query
+        or parsed.fragment
+    ):
+        raise ValueError(f"{name} must be an absolute HTTP(S) origin")
+    try:
+        port = parsed.port
+    except ValueError as error:
+        raise ValueError(f"{name} contains an invalid port") from error
+    return _Origin(parsed.scheme, parsed.hostname, port)
+
+
+def _timeout(value: object) -> float:
+    if (
+        isinstance(value, bool)
+        or not isinstance(value, Real)
+        or not math.isfinite(float(value))
+        or float(value) <= 0
+    ):
+        raise ValueError("timeout must be a finite positive real number")
+    return float(value)
+
+
+def _json_bytes(value: object) -> bytes:
+    return json.dumps(

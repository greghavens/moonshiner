+    private FailedRequest findLatestFailedRequest(String deploymentId)
+            throws IOException, InterruptedException {
+        String path = "/deployment/api/deployments/" + encodePathSegment(deploymentId)
+                + "/requests";
+        for (int page = 0; ; page++) {
+            Map<String, Object> response = getObject(
+                    path + "?page=" + page + "&size=20&sort=createdAt%2CDESC",
+                    "deployment request lookup");
+            for (Object value : content(response, "deployment request lookup")) {
+                Map<String, Object> request = object(value, "deployment request");
+                if ("FAILED".equals(requiredString(request, "status", "deployment request"))) {
+                    return new FailedRequest(
+                            requiredString(request, "id", "deployment request"),
+                            requiredString(request, "name", "deployment request"),
+                            optionalString(request, "details", "deployment request"));
+                }
+            }
+            if (requiredBoolean(response, "last", "deployment request lookup")) {
+                throw new IOException("no failed deployment request was returned for " + deploymentId);
+            }
+        }
+    }

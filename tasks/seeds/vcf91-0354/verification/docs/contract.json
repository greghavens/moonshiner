          "mediaType": "application/json",
          "schema": "SliceEventLog",
          "fieldsUsedByFixture": {
            "content": "array of EventLog objects containing eof, id, message, rownum and timestamp"
          }
        },
        "401": { "meaning": "Unauthorized" },
        "404": { "meaning": "Not Found" }

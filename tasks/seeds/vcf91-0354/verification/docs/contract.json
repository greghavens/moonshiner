        "page": { "type": "integer", "required": false, "minimum": 0, "default": 0 },
        "size": { "type": "integer", "required": false, "minimum": 1, "default": 20 },
        "sort": { "type": "array of strings", "required": false, "default": "createdAt,DESC" },
        "$top": { "type": "integer", "required": false },
        "$skip": { "type": "integer", "required": false },
        "$orderby": { "type": "string", "required": false }

      "responses": {
        "200": {
          "mediaType": "application/json",
          "schema": "PageRequest",
          "fieldsUsedByFixture": {
            "content": "array of Request objects; id, name, details and status are used",
            "last": "boolean indicating the final zero-based page"
          }
        },
        "401": { "meaning": "Unauthorized" },
        "404": { "meaning": "Not Found" }
      }
    },
    {
      "operationId": "getRequestEvents",
      "referenceOperation": "Get Request Events",
      "method": "GET",
      "path": "/deployment/api/requests/{requestId}/events",
      "source": "https://developer.broadcom.com/xapis/vm-apps-org-deployment/latest/deployment/api/requests/requestId/events/get/",
      "pathParameters": {
        "requestId": { "type": "string", "required": true }
      },
      "queryParameters": {
        "page": { "type": "integer", "required": false, "minimum": 0, "default": 0 },
        "size": { "type": "integer", "required": false, "minimum": 1, "default": 20 },
        "sort": { "type": "array of strings", "required": false }
      },
      "responses": {
        "200": {
          "mediaType": "application/json",
          "schema": "PageEvent",
          "fieldsUsedByFixture": {
            "content": "array of Event objects containing details, hasLogs, id, name, resourceName, resourceType, timestamp and userEvent",
            "last": "boolean indicating the final zero-based page"
          }
        },
        "401": { "meaning": "Unauthorized" },
        "404": { "meaning": "Not Found" }

 package architecture
 
-import "errors"
-
-var ErrNotImplemented = errors.New("architecture planner is not implemented")
+import (
+	"encoding/json"
+	"fmt"
+	"sort"
+)
 
 // Build derives a complete architecture from an inventory and a pinned
 // compatibility snapshot.
-func Build(Inventory, CompatibilitySnapshot) (Architecture, error) {
-	return Architecture{}, ErrNotImplemented
+func Build(inventory Inventory, snapshot CompatibilitySnapshot) (Architecture, error) {
+	if inventory.FleetTarget == "" || inventory.FleetTarget != snapshot.FleetTarget ||
+		inventory.Greenfield.Version != snapshot.FleetTarget {
+		return Architecture{}, fmt.Errorf("inventory, greenfield, and snapshot fleet targets must match")
+	}
+	if inventory.Greenfield.Optimization != "fewest-hosts" {
+		return Architecture{}, fmt.Errorf("unsupported storage optimization %q", inventory.Greenfield.Optimization)
+	}
+
+	allowed := make(map[string]bool)
+	for _, name := range inventory.Greenfield.AllowedStorageArchitectures {
+		if allowed[name] {
+			return Architecture{}, fmt.Errorf("duplicate allowed storage architecture %q", name)
+		}
+		allowed[name] = true
+	}
+	var alternatives []StorageAlternative
+	var selected *StorageOption
+	for i := range snapshot.StorageOptions {
+		option := &snapshot.StorageOptions[i]
+		if !allowed[option.Architecture] {
+			continue
+		}
+		uplinkGbps, ok := option.UplinkGbpsByProfile[inventory.Greenfield.PerformanceProfile]
+		if !ok {
+			return Architecture{}, fmt.Errorf("storage %s has no network rule for performance profile %q", option.Architecture, inventory.Greenfield.PerformanceProfile)
+		}
+		hostCount := option.PolicyMinimumHosts + inventory.Greenfield.ReserveHosts
+		alternatives = append(alternatives, StorageAlternative{
+			Architecture:        option.Architecture,
+			Policy:              option.Policy,
+			HostCount:           hostCount,
+			UplinksPerHost:      option.UplinksPerHost,
+			UplinkGbps:          uplinkGbps,
+			VsanMTU:             option.VsanMTU,
+			ESAEnabled:          option.ESAEnabled,
+			HardwareRequirement: option.HardwareRequirement,
+		})
+		if selected == nil {
+			selected = option
+			continue
+		}
+		selectedHosts := selected.PolicyMinimumHosts + inventory.Greenfield.ReserveHosts
+		if hostCount < selectedHosts || (hostCount == selectedHosts && option.PreferenceRank < selected.PreferenceRank) {
+			selected = option
+		}
+	}
+	if selected == nil || len(alternatives) != len(allowed) {
+		return Architecture{}, fmt.Errorf("one or more allowed storage architectures are absent from the compatibility snapshot")
+	}
+	selectedHosts := selected.PolicyMinimumHosts + inventory.Greenfield.ReserveHosts
+	if len(inventory.Greenfield.Hostnames) < selectedHosts {
+		return Architecture{}, fmt.Errorf("selected %s design needs %d hosts, but only %d hostnames are supplied", selected.Architecture, selectedHosts, len(inventory.Greenfield.Hostnames))
+	}
+
+	sddcSpec := map[string]any{
+		"sddcId":       inventory.Greenfield.SDDCID,
+		"version":      inventory.Greenfield.Version,
+		"workflowType": inventory.Greenfield.WorkflowType,
+		"dnsSpec":      copyJSON(inventory.Greenfield.DNSSpec),
+		"vcenterSpec":  copyJSON(inventory.Greenfield.VcenterSpec),
+		"networkSpecs": copyJSON(inventory.Greenfield.NetworkSpecs),
+		"dvsSpecs":     []any{copyJSON(inventory.Greenfield.DvsSpec)},
+		"nsxtSpec":     copyJSON(inventory.Greenfield.NsxtSpec),
+		"datastoreSpec": map[string]any{
+			"vsanSpec": map[string]any{
+				"datastoreName":      "vsan-" + inventory.Greenfield.SDDCID,
+				"failuresToTolerate": selected.FailuresToTolerate,
+				"esaConfig":          map[string]any{"enabled": selected.ESAEnabled},
+			},
+		},
+	}
+	hostSpecs := make([]any, 0, selectedHosts)
+	for _, hostname := range inventory.Greenfield.Hostnames[:selectedHosts] {
+		hostSpecs = append(hostSpecs, map[string]any{"hostname": hostname})
+	}
+	sddcSpec["hostSpecs"] = hostSpecs
+
+	steps, err := planMigration(inventory.Components, snapshot)
+	if err != nil {
+		return Architecture{}, err
+	}
+	selectedUplink := selected.UplinkGbpsByProfile[inventory.Greenfield.PerformanceProfile]
+	return Architecture{
+		SchemaVersion: "1.0",
+		FleetTarget:   inventory.FleetTarget,
+		Greenfield: GreenfieldDesign{
+			StorageDecision: StorageDecision{
+				SelectedArchitecture: selected.Architecture,
+				SelectionCriterion:   inventory.Greenfield.Optimization,
+				HostCount:            selectedHosts,
+				Policy:               selected.Policy,
+				Network: StorageNetwork{
+					UplinksPerHost: selected.UplinksPerHost,
+					UplinkGbps:     selectedUplink,
+					VsanMTU:        selected.VsanMTU,
+				},
+				Alternatives: alternatives,
+			},
+			SDDCSpec: sddcSpec,
+		},
+		Migration: MigrationPlan{Estate: inventory.EstateName, OrderedSteps: steps},
+	}, nil
+}
+
+type transition struct {
+	component Component
+	rule      MigrationRule
+}
+
+func planMigration(components []Component, snapshot CompatibilitySnapshot) ([]MigrationStep, error) {
+	transitions := make([]transition, 0, len(components))
+	ids := make(map[string]bool)
+	for _, component := range components {
+		if component.ID == "" || ids[component.ID] {
+			return nil, fmt.Errorf("component ID %q is empty or duplicated", component.ID)
+		}
+		ids[component.ID] = true
+		rule, ok := findRule(snapshot.MigrationRules, component)
+		if !ok {
+			return nil, fmt.Errorf("unsupported transition for %s %s %s", component.Type, component.Version, component.Architecture)
+		}
+		transitions = append(transitions, transition{component: component, rule: rule})
+	}
+	sort.Slice(transitions, func(i, j int) bool {
+		if transitions[i].rule.Sequence == transitions[j].rule.Sequence {
+			return transitions[i].component.ID < transitions[j].component.ID
+		}
+		return transitions[i].rule.Sequence < transitions[j].rule.Sequence
+	})
+
+	steps := make([]MigrationStep, 0, len(transitions))
+	completedTypes := make(map[string]bool)
+	for i, item := range transitions {
+		for _, predecessor := range item.rule.AfterComponentTypes {
+			if !completedTypes[predecessor] {
+				return nil, fmt.Errorf("component type %s must follow %s", item.component.Type, predecessor)
+			}
+		}
+		for _, gate := range item.rule.Gates {
+			if _, ok := snapshot.GateCatalog[gate]; !ok {
+				return nil, fmt.Errorf("transition for %s references unknown gate %q", item.component.ID, gate)
+			}
+		}
+		steps = append(steps, MigrationStep{
+			Order: i + 1,
+			Component: PlannedComponent{
+				ID: item.component.ID, Type: item.component.Type, Product: item.component.Product,
+				Version: item.component.Version, Architecture: item.component.Architecture,
+			},
+			Target: PlannedTarget{
+				Product: item.rule.TargetProduct, Version: item.rule.TargetVersion,
+				Architecture: item.rule.TargetArchitecture,
+			},
+			Action:      item.rule.Action,
+			UpgradePath: append([]string(nil), item.rule.UpgradePath...),
+			Gates:       append([]string(nil), item.rule.Gates...),
+		})
+		completedTypes[item.component.Type] = true
+	}
+	return steps, nil
+}
+
+func findRule(rules []MigrationRule, component Component) (MigrationRule, bool) {
+	for _, rule := range rules {
+		if rule.ComponentType == component.Type && rule.FromVersion == component.Version &&
+			(rule.FromArchitecture == "" || rule.FromArchitecture == component.Architecture) {
+			return rule, true
+		}
+	}
+	return MigrationRule{}, false
+}
+
+func copyJSON[T any](value T) T {
+	data, err := json.Marshal(value)
+	if err != nil {
+		panic(err)
+	}
+	var copied T
+	if err := json.Unmarshal(data, &copied); err != nil {
+		panic(err)
+	}
+	return copied
 }
diff --git a/cmd/vcfarch/main.go b/cmd/vcfarch/main.go
index 3b83a7c..e8745ec 100644
--- a/cmd/vcfarch/main.go
+++ b/cmd/vcfarch/main.go
@@ -1,11 +1,62 @@
 package main
 
 import (
+	"encoding/json"
+	"flag"
 	"fmt"
 	"os"
+	"path/filepath"
+
+	arch "vcfarch-0125/architecture"
 )
 
 func main() {
-	fmt.Fprintln(os.Stderr, "vcf architecture generator is not implemented")
-	os.Exit(1)
+	if err := run(); err != nil {
+		fmt.Fprintln(os.Stderr, "vcfarch:", err)
+		os.Exit(1)
+	}
+}
+
+func run() error {
+	inventoryPath := flag.String("inventory", "fixtures/estate.json", "estate inventory JSON")
+	compatibilityPath := flag.String("compatibility", "compatibility/vcf-9.1-snapshot.json", "pinned compatibility snapshot JSON")
+	outPath := flag.String("out", "out/architecture.json", "output architecture JSON")
+	flag.Parse()
+
+	inventoryFile, err := os.Open(*inventoryPath)
+	if err != nil {
+		return fmt.Errorf("open inventory: %w", err)
+	}
+	defer inventoryFile.Close()
+	inventory, err := arch.LoadInventory(inventoryFile)
+	if err != nil {
+		return err
+	}
+
+	compatibilityFile, err := os.Open(*compatibilityPath)
+	if err != nil {
+		return fmt.Errorf("open compatibility snapshot: %w", err)
+	}
+	defer compatibilityFile.Close()
+	snapshot, err := arch.LoadCompatibilitySnapshot(compatibilityFile)
+	if err != nil {
+		return err
+	}
+
+	design, err := arch.Build(inventory, snapshot)
+	if err != nil {
+		return err
+	}
+	encoded, err := json.MarshalIndent(design, "", "  ")
+	if err != nil {
+		return fmt.Errorf("encode architecture: %w", err)
+	}
+	encoded = append(encoded, '\n')
+	if err := os.MkdirAll(filepath.Dir(*outPath), 0o755); err != nil {
+		return fmt.Errorf("create output directory: %w", err)
+	}
+	if err := os.WriteFile(*outPath, encoded, 0o644); err != nil {
+		return fmt.Errorf("write architecture: %w", err)
+	}
+	return nil
 }

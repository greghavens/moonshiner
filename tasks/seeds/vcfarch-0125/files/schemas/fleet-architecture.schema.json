{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch-0125:fleet-architecture:1.0",
  "title": "VCF 9.1 fleet architecture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fleetTarget", "greenfield", "migration"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "fleetTarget": {"type": "string", "minLength": 1},
    "greenfield": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storageDecision", "sddcSpec"],
      "properties": {
        "storageDecision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selectedArchitecture", "selectionCriterion", "hostCount", "policy", "network", "alternatives"],
          "properties": {
            "selectedArchitecture": {"type": "string", "enum": ["OSA", "ESA"]},
            "selectionCriterion": {"const": "fewest-hosts"},
            "hostCount": {"type": "integer", "minimum": 1},
            "policy": {"type": "string", "minLength": 1},
            "network": {
              "type": "object",
              "additionalProperties": false,
              "required": ["uplinksPerHost", "uplinkGbps", "vsanMtu"],
              "properties": {
                "uplinksPerHost": {"type": "integer", "minimum": 1},
                "uplinkGbps": {"type": "integer", "minimum": 1},
                "vsanMtu": {"type": "integer", "minimum": 1280, "maximum": 9190}
              }
            },
            "alternatives": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["architecture", "policy", "hostCount", "uplinksPerHost", "uplinkGbps", "vsanMtu", "esaEnabled", "hardwareRequirement"],
                "properties": {
                  "architecture": {"type": "string", "enum": ["OSA", "ESA"]},
                  "policy": {"type": "string", "minLength": 1},
                  "hostCount": {"type": "integer", "minimum": 1},
                  "uplinksPerHost": {"type": "integer", "minimum": 1},
                  "uplinkGbps": {"type": "integer", "minimum": 1},
                  "vsanMtu": {"type": "integer", "minimum": 1280, "maximum": 9190},
                  "esaEnabled": {"type": "boolean"},
                  "hardwareRequirement": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        "sddcSpec": {"type": "object"}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estate", "orderedSteps"],
      "properties": {
        "estate": {"type": "string", "minLength": 1},
        "orderedSteps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["order", "component", "target", "action", "upgradePath", "gates"],
            "properties": {
              "order": {"type": "integer", "minimum": 1},
              "component": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "type", "product", "version"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "type": {"type": "string", "minLength": 1},
                  "product": {"type": "string", "minLength": 1},
                  "version": {"type": "string", "minLength": 1},
                  "architecture": {"type": "string", "minLength": 1}
                }
              },
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": ["product", "version"],
                "properties": {
                  "product": {"type": "string", "minLength": 1},
                  "version": {"type": "string", "minLength": 1},
                  "architecture": {"type": "string", "minLength": 1}
                }
              },
              "action": {"type": "string", "minLength": 1},
              "upgradePath": {
                "type": "array",
                "minItems": 2,
                "items": {"type": "string", "minLength": 1}
              },
              "gates": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}

{
  "contractVersion": 1,
  "product": "VMware Cloud Foundation Automation",
  "productVersion": "9.0",
  "source": {
    "kind": "reference-documentation",
    "statement": "This contract is derived from Broadcom's authoritative xAPIs reference documentation; it is reference documentation rather than a published specification.",
    "manifest": "official_sources.json"
  },
  "operations": [
    {
      "operationId": "patchDeployment",
      "name": "Patch Deployment",
      "summary": "Updates the deployment with the supplied ID.",
      "method": "PATCH",
      "pathTemplate": "/deployment/api/deployments/{deploymentId}",
      "pathParameters": {
        "deploymentId": {
          "type": "string",
          "required": true,
          "description": "Deployment ID"
        }
      },
      "authentication": {
        "type": "http",
        "scheme": "bearer"
      },
      "request": {
        "required": true,
        "contentType": "application/json",
        "body": {
          "type": "object",
          "members": {
            "description": {
              "type": "string",
              "required": false,
              "maxLength": 2000,
              "description": "New description of the deployment"
            },
            "iconId": {
              "type": "string",
              "format": "uuid",
              "required": false,
              "description": "New icon ID of the deployment"
            },
            "name": {
              "type": "string",
              "required": false,
              "minLength": 1,
              "maxLength": 900,
              "description": "New name of the deployment"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "contentType": "application/json",
          "body": "Deployment"
        },
        "401": {
          "description": "Unauthorized",
          "body": "Deployment"
        },
        "403": {
          "description": "Forbidden",
          "body": "Deployment"
        },
        "404": {
          "description": "Not Found",
          "body": "Deployment"
        }
      }
    }
  ]
}

diff --git a/fulfill_expense_request.sh b/fulfill_expense_request.sh
new file mode 100755
index 0000000..a2e9bd0
--- /dev/null
+++ b/fulfill_expense_request.sh
@@ -0,0 +1,195 @@
+#!/usr/bin/env bash
+
+set -u -o pipefail
+
+root_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
+expense_tool="$root_dir/expensesctl"
+scratch_dir=$(mktemp -d "${TMPDIR:-/tmp}/expense-request.XXXXXX") || exit 1
+
+cleanup() {
+  rm -rf -- "$scratch_dir"
+}
+trap cleanup EXIT
+trap 'exit 130' HUP INT TERM
+
+profile_file="$scratch_dir/profile.json"
+first_file="$scratch_dir/coastal.json"
+second_file="$scratch_dir/regional.json"
+create_file="$scratch_dir/created.json"
+
+if ! "$expense_tool" profile >"$profile_file"; then
+  exit 1
+fi
+
+profile_date=$(
+  python3 - "$profile_file" <<'PY'
+import datetime
+import json
+import sys
+
+try:
+    value = json.load(open(sys.argv[1], encoding="utf-8"))
+    selected = value["default_date"]
+    if not isinstance(selected, str) or not selected or selected.strip() != selected:
+        raise ValueError("invalid default date")
+    if datetime.date.fromisoformat(selected).isoformat() != selected:
+        raise ValueError("noncanonical default date")
+except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError):
+    raise SystemExit(1)
+print(selected)
+PY
+) || exit 1
+
+"$expense_tool" availability \
+  --name "Coastal survey lodging" \
+  --location "Denver" \
+  --date "$profile_date" >"$first_file" &
+first_pid=$!
+"$expense_tool" availability \
+  --name "Regional conference registration" \
+  --location "Seattle" \
+  --date "$profile_date" >"$second_file" &
+second_pid=$!
+
+first_status=0
+second_status=0
+wait "$first_pid" || first_status=$?
+wait "$second_pid" || second_status=$?
+
+render_report() {
+  python3 - "$first_file" "$second_file" "${1:-}" <<'PY'
+import json
+import sys
+
+
+def load_object(path):
+    try:
+        value = json.load(open(path, encoding="utf-8"))
+    except (OSError, TypeError, ValueError, json.JSONDecodeError):
+        return {}
+    return value if isinstance(value, dict) else {}
+
+
+def show(value):
+    if value is None:
+        return "unknown"
+    if value is True:
+        return "true"
+    if value is False:
+        return "false"
+    return str(value)
+
+
+for path in sys.argv[1:3]:
+    item = load_object(path)
+    print(
+        "- name: {name}; location: {location}; date: {date}; "
+        "available: {available}; option_id: {option_id}".format(
+            **{
+                field: show(item.get(field))
+                for field in ("name", "location", "date", "available", "option_id")
+            }
+        )
+    )
+
+if sys.argv[3]:
+    response = load_object(sys.argv[3])
+    record = response.get("record")
+    if response.get("created") != 1 or not isinstance(record, dict):
+        raise SystemExit(0)
+    print(
+        "- id: {id}; name: {name}; location: {location}; date: {date}; "
+        "quantity: {quantity}; status: {status}".format(
+            **{
+                field: show(record.get(field))
+                for field in ("id", "name", "location", "date", "quantity", "status")
+            }
+        )
+    )
+PY
+}
+
+if (( first_status != 0 || second_status != 0 )); then
+  render_report
+  exit 1
+fi
+
+choice=$(
+  python3 - "$first_file" "$second_file" "$profile_date" <<'PY'
+import json
+import sys
+
+expected = (
+    ("Coastal survey lodging", "Denver"),
+    ("Regional conference registration", "Seattle"),
+)
+items = []
+try:
+    for path, (name, location) in zip(sys.argv[1:3], expected, strict=True):
+        item = json.load(open(path, encoding="utf-8"))
+        if not isinstance(item, dict):
+            raise ValueError("non-object response")
+        if item.get("name") != name or item.get("location") != location:
+            raise ValueError("mismatched option")
+        if item.get("date") != sys.argv[3]:
+            raise ValueError("mismatched date")
+        if not isinstance(item.get("available"), bool):
+            raise ValueError("missing availability")
+        option_id = item.get("option_id")
+        if not isinstance(option_id, str) or not option_id.strip():
+            raise ValueError("missing option id")
+        items.append(item)
+except (OSError, TypeError, ValueError, json.JSONDecodeError):
+    raise SystemExit(1)
+
+chosen = next((item for item in items if item["available"]), None)
+print("none" if chosen is None else chosen["option_id"])
+PY
+)
+decision_status=$?
+if (( decision_status != 0 )); then
+  render_report
+  exit 1
+fi
+
+if [[ "$choice" == "none" ]]; then
+  render_report
+  exit 0
+fi
+
+if ! "$expense_tool" create \
+  --option-id "$choice" \
+  --date "$profile_date" \
+  --quantity 1 >"$create_file"; then
+  render_report
+  exit 1
+fi
+
+if ! python3 - "$first_file" "$second_file" "$create_file" "$choice" "$profile_date" <<'PY'
+import json
+import sys
+
+try:
+    checks = [json.load(open(path, encoding="utf-8")) for path in sys.argv[1:3]]
+    response = json.load(open(sys.argv[3], encoding="utf-8"))
+    selected = next(item for item in checks if item.get("option_id") == sys.argv[4])
+    record = response["record"]
+    if response.get("created") != 1 or not isinstance(record, dict):
+        raise ValueError("create was not confirmed")
+    if not isinstance(record.get("id"), str) or not record["id"].strip():
+        raise ValueError("missing record id")
+    if record.get("name") != selected.get("name"):
+        raise ValueError("mismatched record name")
+    if record.get("location") != selected.get("location"):
+        raise ValueError("mismatched record location")
+    if record.get("date") != sys.argv[5] or record.get("quantity") != 1:
+        raise ValueError("mismatched record date or quantity")
+except (OSError, KeyError, StopIteration, TypeError, ValueError, json.JSONDecodeError):
+    raise SystemExit(1)
+PY
+then
+  render_report "$create_file"
+  exit 1
+fi
+
+render_report "$create_file"

+import java.io.IOException;
+import java.math.BigDecimal;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.charset.StandardCharsets;
+import java.util.Base64;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.function.IntConsumer;
+
+public final class NsxPolicyClient {
+    private static final String API_BASE_PATH = "/policy/api/v1";
+
+    public record SegmentSpec(
+            String displayName,
+            String description,
+            String connectivityPath,
+            String transportZonePath,
+            List<SegmentSubnet> subnets,
+            List<Tag> tags,
+            Integer expectedRevision
+    ) {}
+
+    public record SegmentSubnet(String gatewayAddress, List<String> dhcpRanges) {}
+
+    public record Tag(String scope, String tag) {}
+
+    public static final class NsxPolicyException extends RuntimeException {
+        private static final long serialVersionUID = 1L;
+
+        private final int statusCode;
+        private final String responseBody;
+
+        NsxPolicyException(int statusCode, String responseBody) {
+            super("NSX Policy request failed with HTTP " + statusCode);
+            this.statusCode = statusCode;
+            this.responseBody = responseBody;
+        }
+
+        public int statusCode() {
+            return statusCode;
+        }
+
+        public String responseBody() {
+            return responseBody;
+        }
+    }
+
+    public static final class AmbiguousMutationException extends RuntimeException {
+        private static final long serialVersionUID = 1L;
+
+        private final int putStatus;
+        private final int readStatus;
+
+        AmbiguousMutationException(int putStatus, int readStatus) {
+            super("NSX Policy mutation outcome is ambiguous after HTTP " + putStatus
+                    + " and reconciliation HTTP " + readStatus);
+            this.putStatus = putStatus;
+            this.readStatus = readStatus;
+        }
+
+        public int putStatus() {
+            return putStatus;
+        }
+
+        public int readStatus() {
+            return readStatus;
+        }
+    }
+
+    private final String managerBaseUrl;
+    private final String authorization;
+    private final HttpClient httpClient;
+    private final IntConsumer retryPacer;
+
+    public NsxPolicyClient(
+            String managerBaseUrl,
+            String username,
+            String password,
+            HttpClient httpClient,
+            IntConsumer retryPacer
+    ) {
+        Objects.requireNonNull(managerBaseUrl, "managerBaseUrl");
+        Objects.requireNonNull(username, "username");
+        Objects.requireNonNull(password, "password");
+        this.httpClient = Objects.requireNonNull(httpClient, "httpClient");
+        this.retryPacer = Objects.requireNonNull(retryPacer, "retryPacer");
+
+        String normalized = managerBaseUrl;
+        while (normalized.endsWith("/")) {
+            normalized = normalized.substring(0, normalized.length() - 1);
+        }
+        if (normalized.isEmpty()) {
+            throw new IllegalArgumentException("managerBaseUrl must not be empty");
+        }
+        this.managerBaseUrl = normalized;
+        String credentials = username + ":" + password;
+        this.authorization = "Basic " + Base64.getEncoder().encodeToString(
+                credentials.getBytes(StandardCharsets.UTF_8));
+    }
+
+    public String createOrReplaceInfraSegment(String segmentId, SegmentSpec segment) {
+        Objects.requireNonNull(segmentId, "segmentId");
+        Objects.requireNonNull(segment, "segment");
+        if (segmentId.isEmpty()) {
+            throw new IllegalArgumentException("segmentId must not be empty");
+        }
+		if (segment.expectedRevision() != null && segment.expectedRevision() < 0) {
+			throw new IllegalArgumentException("expectedRevision must be nonnegative when set");
+		}
+
+        URI uri = URI.create(managerBaseUrl + API_BASE_PATH
+                + "/infra/segments/" + encodePathSegment(segmentId));
+        byte[] body = segmentJson(segment).getBytes(StandardCharsets.UTF_8);
+
+        HttpResponse<String> first = sendPut(uri, body);
+        if (first.statusCode() >= 200 && first.statusCode() < 300) {
+            return first.body();
+        }
+        if (first.statusCode() != 503 && first.statusCode() != 504) {
+            throw new NsxPolicyException(first.statusCode(), first.body());
+        }
+
+        HttpResponse<String> observed = sendGet(uri);
+        if (observed.statusCode() == 200) {
+            if (matchesRequestedFields(new String(body, StandardCharsets.UTF_8), observed.body())) {
+                return observed.body();
+            }
+            throw new AmbiguousMutationException(first.statusCode(), observed.statusCode());
+        }
+        if (observed.statusCode() != 404) {
+            throw new AmbiguousMutationException(first.statusCode(), observed.statusCode());
+        }
+
+        retryPacer.accept(1);
+        HttpResponse<String> retry = sendPut(uri, body);
+        if (retry.statusCode() >= 200 && retry.statusCode() < 300) {
+            return retry.body();
+        }
+        throw new NsxPolicyException(retry.statusCode(), retry.body());
+    }
+
+    private HttpResponse<String> sendPut(URI uri, byte[] body) {
+        HttpRequest request = HttpRequest.newBuilder(uri)
+                .header("Authorization", authorization)
+                .header("Accept", "application/json")
+                .header("Content-Type", "application/json")
+                .PUT(HttpRequest.BodyPublishers.ofByteArray(body))
+                .build();
+        return send(request);
+    }
+
+    private HttpResponse<String> sendGet(URI uri) {
+        HttpRequest request = HttpRequest.newBuilder(uri)
+                .header("Authorization", authorization)
+                .header("Accept", "application/json")
+                .GET()
+                .build();
+        return send(request);
+    }
+
+    private HttpResponse<String> send(HttpRequest request) {
+        try {
+            return httpClient.send(
+                    request,
+                    HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+        } catch (InterruptedException interrupted) {
+            Thread.currentThread().interrupt();
+            throw new IllegalStateException("NSX Policy request was interrupted", interrupted);
+        } catch (IOException failure) {
+            throw new IllegalStateException("NSX Policy request could not be completed", failure);
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    private static boolean matchesRequestedFields(String requestedJson, String observedJson) {
+        Object requestedValue;
+        Object observedValue;
+        try {
+            requestedValue = new JsonParser(requestedJson).parse();
+            observedValue = new JsonParser(observedJson).parse();
+        } catch (IllegalArgumentException malformed) {
+            return false;
+        }
+        if (!(requestedValue instanceof Map<?, ?>) || !(observedValue instanceof Map<?, ?>)) {
+            return false;
+        }
+        Map<String, Object> requested = (Map<String, Object>) requestedValue;
+        Map<String, Object> observed = (Map<String, Object>) observedValue;
+        for (Map.Entry<String, Object> entry : requested.entrySet()) {
+            if ("_revision".equals(entry.getKey())) {
+                continue;
+            }
+            if (!Objects.equals(entry.getValue(), observed.get(entry.getKey()))) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static String segmentJson(SegmentSpec segment) {
+        StringBuilder json = new StringBuilder("{");
+        boolean[] first = {true};
+        stringField(json, first, "display_name", segment.displayName());
+        stringField(json, first, "description", segment.description());
+        stringField(json, first, "connectivity_path", segment.connectivityPath());
+        stringField(json, first, "transport_zone_path", segment.transportZonePath());
+		if (segment.expectedRevision() != null) {
+			fieldPrefix(json, first, "_revision");
+			json.append(segment.expectedRevision());
+		}
+
+        if (segment.subnets() != null) {
+            fieldPrefix(json, first, "subnets");
+            json.append('[');
+            for (int index = 0; index < segment.subnets().size(); index++) {
+                if (index > 0) {
+                    json.append(',');
+                }
+                SegmentSubnet subnet = Objects.requireNonNull(
+                        segment.subnets().get(index), "subnets must not contain null");
+                json.append(subnetJson(subnet));
+            }
+            json.append(']');
+        }
+
+        if (segment.tags() != null) {
+            fieldPrefix(json, first, "tags");
+            json.append('[');
+            for (int index = 0; index < segment.tags().size(); index++) {
+                if (index > 0) {
+                    json.append(',');
+                }
+                Tag tag = Objects.requireNonNull(
+                        segment.tags().get(index), "tags must not contain null");
+                json.append(tagJson(tag));
+            }
+            json.append(']');
+        }
+        return json.append('}').toString();
+    }
+
+    private static String subnetJson(SegmentSubnet subnet) {
+        StringBuilder json = new StringBuilder("{");
+        boolean[] first = {true};
+        stringField(json, first, "gateway_address", subnet.gatewayAddress());
+        if (subnet.dhcpRanges() != null) {
+            fieldPrefix(json, first, "dhcp_ranges");
+            stringArray(json, subnet.dhcpRanges(), "dhcpRanges");
+        }
+        return json.append('}').toString();
+    }
+
+    private static String tagJson(Tag tag) {
+        StringBuilder json = new StringBuilder("{");
+        boolean[] first = {true};
+        stringField(json, first, "scope", tag.scope());
+        stringField(json, first, "tag", tag.tag());
+        return json.append('}').toString();
+    }
+
+    private static void stringArray(StringBuilder json, List<String> values, String label) {
+        json.append('[');
+        for (int index = 0; index < values.size(); index++) {
+            if (index > 0) {
+                json.append(',');
+            }
+            String value = Objects.requireNonNull(
+                    values.get(index), label + " must not contain null");
+            quoted(json, value);
+        }
+        json.append(']');
+    }
+
+    private static void stringField(
+            StringBuilder json,
+            boolean[] first,
+            String name,
+            String value
+    ) {
+        if (value == null) {
+            return;
+        }
+        fieldPrefix(json, first, name);
+        quoted(json, value);
+    }
+
+    private static void fieldPrefix(StringBuilder json, boolean[] first, String name) {
+        if (!first[0]) {
+            json.append(',');
+        }
+        first[0] = false;
+        quoted(json, name);
+        json.append(':');
+    }
+
+    private static void quoted(StringBuilder json, String value) {
+        json.append('"');
+        for (int index = 0; index < value.length(); index++) {
+            char ch = value.charAt(index);
+            switch (ch) {
+                case '"' -> json.append("\\\"");
+                case '\\' -> json.append("\\\\");
+                case '\b' -> json.append("\\b");
+                case '\f' -> json.append("\\f");
+                case '\n' -> json.append("\\n");
+                case '\r' -> json.append("\\r");
+                case '\t' -> json.append("\\t");
+                default -> {
+                    if (ch < 0x20) {
+                        json.append(String.format("\\u%04x", (int) ch));
+                    } else {
+                        json.append(ch);
+                    }
+                }
+            }
+        }
+        json.append('"');
+    }
+
+    private static String encodePathSegment(String value) {
+        byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+        StringBuilder encoded = new StringBuilder(bytes.length);
+        final char[] hex = "0123456789ABCDEF".toCharArray();
+        for (byte current : bytes) {
+            int octet = current & 0xff;
+            if ((octet >= 'a' && octet <= 'z')
+                    || (octet >= 'A' && octet <= 'Z')
+                    || (octet >= '0' && octet <= '9')
+                    || octet == '-' || octet == '.' || octet == '_' || octet == '~') {
+                encoded.append((char) octet);
+            } else {
+                encoded.append('%')
+                        .append(hex[octet >>> 4])
+                        .append(hex[octet & 0x0f]);
+            }
+        }
+        return encoded.toString();
+    }
+
+    private static final class JsonParser {
+        private final String text;
+        private int offset;
+
+        JsonParser(String text) {
+            this.text = Objects.requireNonNull(text, "text");
+        }
+
+        Object parse() {
+            Object value = value();
+            whitespace();
+            if (offset != text.length()) {
+                throw new IllegalArgumentException("trailing JSON data");
+            }
+            return value;
+        }
+
+        private Object value() {
+            whitespace();
+            if (offset >= text.length()) {
+                throw new IllegalArgumentException("missing JSON value");
+            }
+            return switch (text.charAt(offset)) {
+                case '{' -> object();
+                case '[' -> array();
+                case '"' -> string();
+                case 't' -> literal("true", Boolean.TRUE);
+                case 'f' -> literal("false", Boolean.FALSE);
+                case 'n' -> literal("null", null);
+                default -> number();
+            };
+        }
+
+        private Map<String, Object> object() {
+            offset++;
+            LinkedHashMap<String, Object> result = new LinkedHashMap<>();
+            whitespace();
+            if (take('}')) {
+                return result;
+            }
+            while (true) {
+                whitespace();
+                if (offset >= text.length() || text.charAt(offset) != '"') {
+                    throw new IllegalArgumentException("object key expected");
+                }
+                String key = string();
+                whitespace();
+                require(':');
+                if (result.put(key, value()) != null) {
+                    throw new IllegalArgumentException("duplicate object key");
+                }
+                whitespace();
+                if (take('}')) {
+                    return result;
+                }
+                require(',');
+            }
+        }
+
+        private List<Object> array() {
+            offset++;
+            ArrayList<Object> result = new ArrayList<>();
+            whitespace();
+            if (take(']')) {
+                return result;
+            }
+            while (true) {
+                result.add(value());
+                whitespace();
+                if (take(']')) {
+                    return result;
+                }
+                require(',');
+            }
+        }
+
+        private String string() {
+            require('"');
+            StringBuilder result = new StringBuilder();
+            while (offset < text.length()) {
+                char current = text.charAt(offset++);
+                if (current == '"') {
+                    return result.toString();
+                }
+                if (current != '\\') {
+                    if (current < 0x20) {
+                        throw new IllegalArgumentException("control character in string");
+                    }
+                    result.append(current);
+                    continue;
+                }
+                if (offset >= text.length()) {
+                    throw new IllegalArgumentException("truncated escape");
+                }
+                char escaped = text.charAt(offset++);
+                switch (escaped) {
+                    case '"', '\\', '/' -> result.append(escaped);
+                    case 'b' -> result.append('\b');
+                    case 'f' -> result.append('\f');
+                    case 'n' -> result.append('\n');
+                    case 'r' -> result.append('\r');
+                    case 't' -> result.append('\t');
+                    case 'u' -> result.append((char) Integer.parseInt(take(4), 16));
+                    default -> throw new IllegalArgumentException("invalid escape");
+                }
+            }
+            throw new IllegalArgumentException("unterminated string");
+        }
+
+        private Object number() {
+            int start = offset;
+            if (take('-') && offset >= text.length()) {
+                throw new IllegalArgumentException("invalid number");
+            }
+            while (offset < text.length()) {
+                char current = text.charAt(offset);
+                if ((current >= '0' && current <= '9') || current == '.' ||
+                        current == 'e' || current == 'E' || current == '+' || current == '-') {
+                    offset++;
+                } else {
+                    break;
+                }
+            }
+            try {
+                return new BigDecimal(text.substring(start, offset));
+            } catch (NumberFormatException failure) {
+                throw new IllegalArgumentException("invalid number", failure);
+            }
+        }
+
+        private Object literal(String expected, Object value) {
+            if (!text.startsWith(expected, offset)) {
+                throw new IllegalArgumentException("invalid literal");
+            }
+            offset += expected.length();
+            return value;
+        }
+
+        private String take(int count) {
+            if (offset + count > text.length()) {
+                throw new IllegalArgumentException("truncated escape");
+            }
+            String result = text.substring(offset, offset + count);
+            offset += count;
+            return result;
+        }
+
+        private boolean take(char expected) {
+            if (offset < text.length() && text.charAt(offset) == expected) {
+                offset++;
+                return true;
+            }
+            return false;
+        }
+
+        private void require(char expected) {
+            if (!take(expected)) {
+                throw new IllegalArgumentException("expected " + expected);
+            }
+        }
+
+        private void whitespace() {
+            while (offset < text.length() && Character.isWhitespace(text.charAt(offset))) {
+                offset++;
+            }
+        }
+    }
+}

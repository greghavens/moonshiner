diff --git a/NsxPolicyClient.java b/NsxPolicyClient.java
new file mode 100644
--- /dev/null
+++ b/NsxPolicyClient.java
@@ -0,0 +1,258 @@
+import java.io.IOException;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.charset.StandardCharsets;
+import java.util.Base64;
+import java.util.List;
+import java.util.Objects;
+import java.util.function.IntConsumer;
+
+public final class NsxPolicyClient {
+    private static final String API_BASE_PATH = "/policy/api/v1";
+
+    public record SegmentSpec(
+            String displayName,
+            String description,
+            String connectivityPath,
+            String transportZonePath,
+            List<SegmentSubnet> subnets,
+            List<Tag> tags
+    ) {}
+
+    public record SegmentSubnet(String gatewayAddress, List<String> dhcpRanges) {}
+
+    public record Tag(String scope, String tag) {}
+
+    public static final class NsxPolicyException extends RuntimeException {
+        private static final long serialVersionUID = 1L;
+
+        private final int statusCode;
+        private final String responseBody;
+
+        NsxPolicyException(int statusCode, String responseBody) {
+            super("NSX Policy request failed with HTTP " + statusCode);
+            this.statusCode = statusCode;
+            this.responseBody = responseBody;
+        }
+
+        public int statusCode() {
+            return statusCode;
+        }
+
+        public String responseBody() {
+            return responseBody;
+        }
+    }
+
+    private final String managerBaseUrl;
+    private final String authorization;
+    private final HttpClient httpClient;
+    private final IntConsumer retryPacer;
+
+    public NsxPolicyClient(
+            String managerBaseUrl,
+            String username,
+            String password,
+            HttpClient httpClient,
+            IntConsumer retryPacer
+    ) {
+        Objects.requireNonNull(managerBaseUrl, "managerBaseUrl");
+        Objects.requireNonNull(username, "username");
+        Objects.requireNonNull(password, "password");
+        this.httpClient = Objects.requireNonNull(httpClient, "httpClient");
+        this.retryPacer = Objects.requireNonNull(retryPacer, "retryPacer");
+
+        String normalized = managerBaseUrl;
+        while (normalized.endsWith("/")) {
+            normalized = normalized.substring(0, normalized.length() - 1);
+        }
+        if (normalized.isEmpty()) {
+            throw new IllegalArgumentException("managerBaseUrl must not be empty");
+        }
+        this.managerBaseUrl = normalized;
+        String credentials = username + ":" + password;
+        this.authorization = "Basic " + Base64.getEncoder().encodeToString(
+                credentials.getBytes(StandardCharsets.UTF_8));
+    }
+
+    public String createOrReplaceInfraSegment(String segmentId, SegmentSpec segment) {
+        Objects.requireNonNull(segmentId, "segmentId");
+        Objects.requireNonNull(segment, "segment");
+        if (segmentId.isEmpty()) {
+            throw new IllegalArgumentException("segmentId must not be empty");
+        }
+
+        URI uri = URI.create(managerBaseUrl + API_BASE_PATH
+                + "/infra/segments/" + encodePathSegment(segmentId));
+        byte[] body = segmentJson(segment).getBytes(StandardCharsets.UTF_8);
+
+        for (int attempt = 0; attempt < 2; attempt++) {
+            HttpRequest request = HttpRequest.newBuilder(uri)
+                    .header("Authorization", authorization)
+                    .header("Accept", "application/json")
+                    .header("Content-Type", "application/json")
+                    .PUT(HttpRequest.BodyPublishers.ofByteArray(body))
+                    .build();
+            HttpResponse<String> response;
+            try {
+                response = httpClient.send(
+                        request,
+                        HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+            } catch (InterruptedException interrupted) {
+                Thread.currentThread().interrupt();
+                throw new IllegalStateException("NSX Policy request was interrupted", interrupted);
+            } catch (IOException failure) {
+                throw new IllegalStateException("NSX Policy request could not be completed", failure);
+            }
+
+            int status = response.statusCode();
+            if (status >= 200 && status < 300) {
+                return response.body();
+            }
+            if (attempt == 0 && (status == 503 || status == 504)) {
+                retryPacer.accept(1);
+                continue;
+            }
+            throw new NsxPolicyException(status, response.body());
+        }
+        throw new AssertionError("unreachable retry state");
+    }
+
+    private static String segmentJson(SegmentSpec segment) {
+        StringBuilder json = new StringBuilder("{");
+        boolean[] first = {true};
+        stringField(json, first, "display_name", segment.displayName());
+        stringField(json, first, "description", segment.description());
+        stringField(json, first, "connectivity_path", segment.connectivityPath());
+        stringField(json, first, "transport_zone_path", segment.transportZonePath());
+
+        if (segment.subnets() != null) {
+            fieldPrefix(json, first, "subnets");
+            json.append('[');
+            for (int index = 0; index < segment.subnets().size(); index++) {
+                if (index > 0) {
+                    json.append(',');
+                }
+                SegmentSubnet subnet = Objects.requireNonNull(
+                        segment.subnets().get(index), "subnets must not contain null");
+                json.append(subnetJson(subnet));
+            }
+            json.append(']');
+        }
+
+        if (segment.tags() != null) {
+            fieldPrefix(json, first, "tags");
+            json.append('[');
+            for (int index = 0; index < segment.tags().size(); index++) {
+                if (index > 0) {
+                    json.append(',');
+                }
+                Tag tag = Objects.requireNonNull(
+                        segment.tags().get(index), "tags must not contain null");
+                json.append(tagJson(tag));
+            }
+            json.append(']');
+        }
+        return json.append('}').toString();
+    }
+
+    private static String subnetJson(SegmentSubnet subnet) {
+        StringBuilder json = new StringBuilder("{");
+        boolean[] first = {true};
+        stringField(json, first, "gateway_address", subnet.gatewayAddress());
+        if (subnet.dhcpRanges() != null) {
+            fieldPrefix(json, first, "dhcp_ranges");
+            stringArray(json, subnet.dhcpRanges(), "dhcpRanges");
+        }
+        return json.append('}').toString();
+    }
+
+    private static String tagJson(Tag tag) {
+        StringBuilder json = new StringBuilder("{");
+        boolean[] first = {true};
+        stringField(json, first, "scope", tag.scope());
+        stringField(json, first, "tag", tag.tag());
+        return json.append('}').toString();
+    }
+
+    private static void stringArray(StringBuilder json, List<String> values, String label) {
+        json.append('[');
+        for (int index = 0; index < values.size(); index++) {
+            if (index > 0) {
+                json.append(',');
+            }
+            String value = Objects.requireNonNull(
+                    values.get(index), label + " must not contain null");
+            quoted(json, value);
+        }
+        json.append(']');
+    }
+
+    private static void stringField(
+            StringBuilder json,
+            boolean[] first,
+            String name,
+            String value
+    ) {
+        if (value == null) {
+            return;
+        }
+        fieldPrefix(json, first, name);
+        quoted(json, value);
+    }
+
+    private static void fieldPrefix(StringBuilder json, boolean[] first, String name) {
+        if (!first[0]) {
+            json.append(',');
+        }
+        first[0] = false;
+        quoted(json, name);
+        json.append(':');
+    }
+
+    private static void quoted(StringBuilder json, String value) {
+        json.append('"');
+        for (int index = 0; index < value.length(); index++) {
+            char ch = value.charAt(index);
+            switch (ch) {
+                case '"' -> json.append("\\\"");
+                case '\\' -> json.append("\\\\");
+                case '\b' -> json.append("\\b");
+                case '\f' -> json.append("\\f");
+                case '\n' -> json.append("\\n");
+                case '\r' -> json.append("\\r");
+                case '\t' -> json.append("\\t");
+                default -> {
+                    if (ch < 0x20) {
+                        json.append(String.format("\\u%04x", (int) ch));
+                    } else {
+                        json.append(ch);
+                    }
+                }
+            }
+        }
+        json.append('"');
+    }
+
+    private static String encodePathSegment(String value) {
+        byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+        StringBuilder encoded = new StringBuilder(bytes.length);
+        final char[] hex = "0123456789ABCDEF".toCharArray();
+        for (byte current : bytes) {
+            int octet = current & 0xff;
+            if ((octet >= 'a' && octet <= 'z')
+                    || (octet >= 'A' && octet <= 'Z')
+                    || (octet >= '0' && octet <= '9')
+                    || octet == '-' || octet == '.' || octet == '_' || octet == '~') {
+                encoded.append((char) octet);
+            } else {
+                encoded.append('%')
+                        .append(hex[octet >>> 4])
+                        .append(hex[octet & 0x0f]);
+            }
+        }
+        return encoded.toString();
+    }
+}

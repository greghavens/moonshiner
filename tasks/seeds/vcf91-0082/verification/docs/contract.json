{
  "provenance": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "path": "specifications/nsx/openapi-2.0/nsx_policy_api.yaml",
    "license": "Apache-2.0"
  },
  "openapi": {
    "swagger": "2.0",
    "title": "NSX Policy API",
    "version": "9.1.0.0",
    "schemes": [
      "https"
    ],
    "basePath": "/policy/api/v1",
    "produces": [
      "application/json"
    ],
    "security": [
      {
        "BasicAuth": []
      }
    ],
    "securityDefinitions": {
      "BasicAuth": {
        "type": "basic",
        "description": "HTTP Basic Authentication"
      }
    }
  },
  "operations": [
    {
      "operationId": "CreateOrReplaceInfraSegment",
      "method": "PUT",
      "path": "/infra/segments/{segment-id}",
      "summary": "Create or update a infra segment",
      "semantics": {
        "absent": "create a new segment",
        "present": "replace the segment with this object"
      },
      "consumes": [
        "application/json"
      ],
      "produces": [
        "application/json"
      ],
      "parameters": [
        {
          "name": "segment-id",
          "in": "path",
          "required": true,
          "type": "string"
        },
        {
          "name": "Segment",
          "in": "body",
          "required": true,
          "schema": "#/definitions/Segment"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "schema": "#/definitions/Segment"
        },
        "400": "#/responses/BadRequest",
        "403": "#/responses/Forbidden",
        "404": {
          "description": "Not Found"
        },
        "412": "#/responses/PreconditionFailed",
        "500": "#/responses/InternalServerError",
        "503": "#/responses/ServiceUnavailable",
        "504": "#/responses/GatewayTimeout"
      }
    }
  ],
  "definitions": {
    "Segment": {
      "allOf": [
        "#/definitions/PolicyConfigResource"
      ],
      "description": "Segment configuration to attach workloads.",
      "writablePropertiesUsedByClient": {
        "display_name": {
          "type": "string",
          "maxLength": 255,
          "required": false
        },
        "description": {
          "type": "string",
          "maxLength": 1024,
          "required": false
        },
        "connectivity_path": {
          "type": "string",
          "required": false
        },
        "transport_zone_path": {
          "type": "string",
          "required": false
        },
        "subnets": {
          "type": "array",
          "items": "#/definitions/SegmentSubnet",
          "required": false
        },
        "tags": {
          "type": "array",
          "items": "#/definitions/Tag",
          "maxItems": 30,
          "required": false
        }
      }
    },
    "SegmentSubnet": {
      "type": "object",
      "description": "Subnet configuration for segment",
      "properties": {
        "gateway_address": {
          "type": "string",
          "format": "ip-cidr-block",
          "required": false
        },
        "dhcp_ranges": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "address-or-block-or-range"
          },
          "minItems": 1,
          "maxItems": 99,
          "required": false
        }
      }
    },
    "Tag": {
      "type": "object",
      "description": "Arbitrary key-value pairs that may be attached to an entity",
      "properties": {
        "scope": {
          "type": "string",
          "maxLength": 128,
          "required": false
        },
        "tag": {
          "type": "string",
          "required": false
        }
      }
    }
  }
}

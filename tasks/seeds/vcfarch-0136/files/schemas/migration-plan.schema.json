{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "migration-plan.schema.json",
  "title": "VCF mixed-estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planId",
    "sourceEstateId",
    "targetVcfVersion",
    "strategy",
    "steps"
  ],
  "properties": {
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "sourceEstateId": {
      "type": "string",
      "minLength": 1
    },
    "targetVcfVersion": {
      "type": "string",
      "minLength": 1
    },
    "strategy": {
      "const": "parallel-greenfield"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "phase",
          "gates",
          "transitions",
          "additions"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "phase": {
            "type": "string",
            "enum": [
              "deploy-greenfield",
              "place-dedicated-witness",
              "configure-stretched-management",
              "cut-over-management",
              "retain-legacy-cluster"
            ]
          },
          "gates": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "transitions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/transition"
            }
          },
          "additions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/addition"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "componentType",
        "currentVersion",
        "targetVersion",
        "disposition",
        "gates"
      ],
      "properties": {
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "componentType": {
          "type": "string",
          "minLength": 1
        },
        "currentVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "type": "string",
          "enum": [
            "parallel-replace",
            "retain"
          ]
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "addition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "componentType",
        "currentVersion",
        "targetVersion",
        "site",
        "gates"
      ],
      "properties": {
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "componentType": {
          "type": "string",
          "minLength": 1
        },
        "currentVersion": {
          "const": "not-deployed"
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1
        },
        "site": {
          "type": "string",
          "minLength": 1
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

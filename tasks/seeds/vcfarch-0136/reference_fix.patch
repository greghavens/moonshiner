+Set-StrictMode -Version Latest
+
+function Read-VcfArchitectureJson {
+    [CmdletBinding()]
+    param([Parameter(Mandatory)][string]$Path)
+
+    $resolved = $ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($Path)
+    if (-not [System.IO.File]::Exists($resolved)) {
+        throw "JSON input was not found: $Path"
+    }
+    [System.IO.File]::ReadAllText($resolved) | ConvertFrom-Json -Depth 100
+}
+
+function New-VcfInstallerSpec {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]$Estate,
+        [Parameter(Mandatory)]$Compatibility
+    )
+
+    $greenfield = $Estate.greenfield
+    $hostSpecs = [System.Collections.Generic.List[object]]::new()
+    foreach ($site in $greenfield.dataHostsBySite.PSObject.Properties) {
+        foreach ($hostname in $site.Value) {
+            $hostSpecs.Add((Initialize-VcfInstallerSddcHostSpec -Hostname $hostname))
+        }
+    }
+
+    $networkSpecs = [System.Collections.Generic.List[object]]::new()
+    foreach ($network in $greenfield.networks) {
+        $networkSpecs.Add((Initialize-VcfInstallerSddcNetworkSpec `
+            -NetworkType $network.networkType `
+            -VlanId ([uint32]$network.vlanId) `
+            -Subnet $network.subnet `
+            -Gateway $network.gateway `
+            -Mtu ([int]$network.mtu) `
+            -IpAddressVersion 'IPv4' `
+            -IpAddressAssignmentMode 'STATIC'))
+    }
+
+    $dnsSpec = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $greenfield.dns.subdomain `
+        -Nameservers ([string[]]$greenfield.dns.nameservers)
+    $vcenterSpec = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname $greenfield.vcenter.hostname `
+        -RootVcenterPassword $greenfield.vcenter.rootPassword `
+        -VmSize $greenfield.vcenter.vmSize `
+        -SsoDomain $greenfield.vcenter.ssoDomain `
+        -Version $Compatibility.targetVersions.VCENTER
+    $clusterSpec = Initialize-VcfInstallerSddcClusterSpec `
+        -DatacenterName $greenfield.cluster.datacenterName `
+        -ClusterName $greenfield.cluster.clusterName
+
+    $vmnic0 = Initialize-VcfInstallerVmnicToUplink -Id 'vmnic0' -Uplink 'uplink1'
+    $vmnic1 = Initialize-VcfInstallerVmnicToUplink -Id 'vmnic1' -Uplink 'uplink2'
+    $dvsSpec = Initialize-VcfInstallerDvsSpec `
+        -DvsName 'chi91-mgmt-vds' `
+        -Networks ([string[]]($greenfield.networks.networkType)) `
+        -Mtu 9000 `
+        -VmnicsToUplinks @($vmnic0, $vmnic1)
+
+    $nsxtManagers = [System.Collections.Generic.List[object]]::new()
+    foreach ($hostname in $greenfield.nsxt.managerHostnames) {
+        $nsxtManagers.Add((Initialize-VcfInstallerNsxtManagerSpec -Hostname $hostname))
+    }
+    $nsxtSpec = Initialize-VcfInstallerSddcNsxtSpec `
+        -NsxtManagers $nsxtManagers `
+        -NsxtManagerSize $greenfield.nsxt.managerSize `
+        -VipFqdn $greenfield.nsxt.vipFqdn `
+        -TransportVlanId ([int]$greenfield.nsxt.transportVlanId) `
+        -Version $Compatibility.targetVersions.NSX_T_MANAGER
+    $sddcManagerSpec = Initialize-VcfInstallerSddcManagerSpec `
+        -Hostname $greenfield.sddcManager.hostname `
+        -Version $Compatibility.targetVersions.SDDC_MANAGER_VCF
+    $vsanSpec = Initialize-VcfInstallerVsanSpec `
+        -DatastoreName $greenfield.cluster.datastoreName `
+        -FailuresToTolerate ([uint32]$greenfield.cluster.failuresToTolerate) `
+        -VsanDedup $false
+    $datastoreSpec = Initialize-VcfInstallerSddcDatastoreSpec -VsanSpec $vsanSpec
+
+    $spec = Initialize-VcfInstallerSddcSpec `
+        -SddcId $greenfield.sddcId `
+        -WorkflowType 'VCF' `
+        -Version $Compatibility.targetVcfVersion `
+        -VcenterSpec $vcenterSpec `
+        -ClusterSpec $clusterSpec `
+        -HostSpecs $hostSpecs `
+        -DvsSpecs @($dvsSpec) `
+        -NsxtSpec $nsxtSpec `
+        -NetworkSpecs $networkSpecs `
+        -DnsSpec $dnsSpec `
+        -NtpServers ([string[]]$greenfield.ntpServers) `
+        -SddcManagerSpec $sddcManagerSpec `
+        -DatastoreSpec $datastoreSpec `
+        -VcfInstanceName $greenfield.vcfInstanceName `
+        -CeipEnabled $false `
+        -SkipEsxThumbprintValidation $false `
+        -SkipGatewayPingValidation $false
+
+    $spec.ToJson() | ConvertFrom-Json -AsHashtable -Depth 100
+}
+
+function Get-ForbiddenTransitionGate {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]$Component,
+        [Parameter(Mandatory)][string]$TargetVersion,
+        [Parameter(Mandatory)]$Compatibility
+    )
+
+    foreach ($rule in $Compatibility.forbiddenInPlaceTransitions) {
+        if ($rule.componentType -eq $Component.type -and
+            $rule.fromVersion -eq $Component.version -and
+            $rule.toVersion -eq $TargetVersion) {
+            return [string]$rule.gateId
+        }
+    }
+    $null
+}
+
+function New-VcfComponentTransition {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]$Component,
+        [Parameter(Mandatory)]$Compatibility
+    )
+
+    if ($Component.migrationScope -eq 'retain') {
+        return [ordered]@{
+            componentId   = $Component.id
+            componentType = $Component.type
+            currentVersion = $Component.version
+            targetVersion = $Component.version
+            disposition   = 'retain'
+            gates         = @([string]$Compatibility.route.retentionGateId)
+        }
+    }
+
+    $target = [string]$Compatibility.targetVersions.($Component.type)
+    $gates = [System.Collections.Generic.List[string]]::new()
+    $gates.Add([string]$Compatibility.route.replacementGateId)
+    $blocked = Get-ForbiddenTransitionGate `
+        -Component $Component -TargetVersion $target -Compatibility $Compatibility
+    if ($blocked) {
+        $gates.Add($blocked)
+    }
+    [ordered]@{
+        componentId   = $Component.id
+        componentType = $Component.type
+        currentVersion = $Component.version
+        targetVersion = $target
+        disposition   = 'parallel-replace'
+        gates         = $gates.ToArray()
+    }
+}
+
+function New-VcfMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]$Estate,
+        [Parameter(Mandatory)]$Compatibility,
+        [Parameter(Mandatory)][string]$WitnessSite
+    )
+
+    $deploy = [System.Collections.Generic.List[object]]::new()
+    $stretch = [System.Collections.Generic.List[object]]::new()
+    $retain = [System.Collections.Generic.List[object]]::new()
+    foreach ($component in $Estate.components) {
+        $transition = New-VcfComponentTransition -Component $component -Compatibility $Compatibility
+        if ($component.migrationScope -eq 'retain') {
+            $retain.Add($transition)
+        } elseif ($component.type -eq 'ESX_HOST') {
+            $stretch.Add($transition)
+        } else {
+            $deploy.Add($transition)
+        }
+    }
+
+    $witness = [ordered]@{
+        componentId   = $Compatibility.witness.newComponentId
+        componentType = 'VSAN_WITNESS'
+        currentVersion = 'not-deployed'
+        targetVersion = $Compatibility.witness.targetVersion
+        site          = $WitnessSite
+        gates         = @([string]$Compatibility.witness.placementGateId)
+    }
+    [ordered]@{
+        planId          = "$($Estate.estateId)-to-$($Compatibility.targetVcfVersion)"
+        sourceEstateId  = $Estate.estateId
+        targetVcfVersion = $Compatibility.targetVcfVersion
+        strategy        = $Compatibility.route.strategy
+        steps           = @(
+            [ordered]@{
+                order       = 10
+                phase       = 'deploy-greenfield'
+                gates       = @([string]$Compatibility.route.replacementGateId)
+                transitions = $deploy.ToArray()
+                additions   = @()
+            },
+            [ordered]@{
+                order       = 20
+                phase       = 'place-dedicated-witness'
+                gates       = @([string]$Compatibility.witness.placementGateId)
+                transitions = @()
+                additions   = @($witness)
+            },
+            [ordered]@{
+                order       = 30
+                phase       = 'configure-stretched-management'
+                gates       = @([string]$Compatibility.witness.placementGateId)
+                transitions = $stretch.ToArray()
+                additions   = @()
+            },
+            [ordered]@{
+                order       = 40
+                phase       = 'cut-over-management'
+                gates       = @(
+                    [string]$Compatibility.route.replacementGateId,
+                    [string]$Compatibility.witness.placementGateId
+                )
+                transitions = @()
+                additions   = @()
+            },
+            [ordered]@{
+                order       = 50
+                phase       = 'retain-legacy-cluster'
+                gates       = @([string]$Compatibility.route.retentionGateId)
+                transitions = $retain.ToArray()
+                additions   = @()
+            }
+        )
+    }
+}
+
+function New-VcfMixedEstateArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][string]$EstatePath,
+        [Parameter(Mandatory)][string]$CompatibilityPath,
+        [Parameter(Mandatory)][string]$OutputPath
+    )
+
+    $estate = Read-VcfArchitectureJson -Path $EstatePath
+    $compatibility = Read-VcfArchitectureJson -Path $CompatibilityPath
+    if ($estate.targetVcfVersion -ne $compatibility.targetVcfVersion) {
+        throw 'Estate and compatibility snapshot target versions do not match.'
+    }
+
+    $witnessSite = @($estate.sites | Where-Object role -eq $compatibility.witness.requiredSiteRole)
+    if ($witnessSite.Count -ne 1) {
+        throw 'Exactly one independent witness site is required.'
+    }
+    $witnessSiteId = [string]$witnessSite[0].id
+    $sddcSpec = New-VcfInstallerSpec -Estate $estate -Compatibility $compatibility
+    $plan = New-VcfMigrationPlan `
+        -Estate $estate -Compatibility $compatibility -WitnessSite $witnessSiteId
+
+    $architecture = [ordered]@{
+        greenfield = [ordered]@{
+            sddcSpec = $sddcSpec
+            topology = [ordered]@{
+                managementDomain = [ordered]@{
+                    stretched       = $true
+                    dataSites       = @($estate.managementDomain.dataSites)
+                    dataHostsBySite = [ordered]@{
+                        'chi-a' = @($estate.greenfield.dataHostsBySite.'chi-a')
+                        'chi-b' = @($estate.greenfield.dataHostsBySite.'chi-b')
+                    }
+                    dataHostVersion = $compatibility.targetVersions.ESX_HOST
+                }
+                witness = [ordered]@{
+                    componentId        = $compatibility.witness.newComponentId
+                    site               = $witnessSiteId
+                    version            = $compatibility.witness.targetVersion
+                    dedicated          = [bool]$compatibility.witness.mustBeDedicated
+                    memberOfDataCluster = -not [bool]$compatibility.witness.mustBeOutsideDataCluster
+                }
+                legacySharedWitness = [ordered]@{
+                    componentId  = $estate.legacyCluster.sharedWitnessId
+                    site         = $witnessSiteId
+                    servesCluster = $estate.legacyCluster.id
+                    disposition  = $compatibility.witness.legacySharedWitnessDisposition
+                }
+            }
+        }
+        migrationPlan = $plan
+    }
+
+    $resolved = $ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($OutputPath)
+    $parent = [System.IO.Path]::GetDirectoryName($resolved)
+    if ($parent) {
+        [System.IO.Directory]::CreateDirectory($parent) > $null
+    }
+    $json = ConvertTo-Json -InputObject $architecture -Depth 100
+    [System.IO.File]::WriteAllText($resolved, $json + [Environment]::NewLine, [System.Text.UTF8Encoding]::new($false))
+    Get-Item -LiteralPath $resolved
+}
+
+Export-ModuleMember -Function New-VcfMixedEstateArchitecture

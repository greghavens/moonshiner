new file mode 100644
index 0000000..415aed8
--- /dev/null
+++ b/VcfAriaMigration/VcfAriaMigration.psm1
@@ -0,0 +1,121 @@
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+function Read-VcfMigrationJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $Path
+    )
+
+    $resolved = (Resolve-Path -LiteralPath $Path -ErrorAction Stop).Path
+    $text = [System.IO.File]::ReadAllText($resolved)
+    $text | ConvertFrom-Json -Depth 64
+}
+
+function Export-VcfAriaMigrationArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $InventoryPath,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $CompatibilitySnapshotPath,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $OutputPath
+    )
+
+    $estate = Read-VcfMigrationJson -Path $InventoryPath
+    $snapshot = Read-VcfMigrationJson -Path $CompatibilitySnapshotPath
+    $workload = $estate.fleet.addedWorkloadDomain
+    $cluster = $workload.cluster
+
+    $minimumHosts = 2 * [int] $cluster.failuresToTolerate + 1
+    if ([int] $cluster.hostCount -lt $minimumHosts) {
+        throw [System.InvalidOperationException]::new(
+            "Host count $($cluster.hostCount) cannot satisfy FTT $($cluster.failuresToTolerate)."
+        )
+    }
+
+    $placements = @(
+        foreach ($profile in $snapshot.placements) {
+            [ordered]@{
+                id                 = [string] $profile.id
+                targetComponent    = [string] $profile.targetComponent
+                targetVersion      = [string] $profile.targetVersion
+                domainId           = [string] $workload.id
+                clusterId          = [string] $cluster.id
+                nodeCount          = [int] $profile.nodeCount
+                sizeProfile        = [string] $profile.sizeProfile
+                vCpuPerNode        = [int] $profile.vCpuPerNode
+                memoryGiBPerNode   = [int] $profile.memoryGiBPerNode
+                storageGiBPerNode  = [int] $profile.storageGiBPerNode
+                antiAffinity       = [bool] $profile.antiAffinity
+                faultDomains       = [int] $profile.faultDomains
+            }
+        }
+    )
+
+    $waves = @(
+        foreach ($rule in @($snapshot.migrationRules | Sort-Object -Property order)) {
+            [ordered]@{
+                order              = [int] $rule.order
+                id                 = [string] $rule.id
+                sourceProduct      = [string] $rule.sourceProduct
+                sourceVersion      = [string] $rule.sourceVersion
+                legacyName         = [string] $rule.legacyName
+                targetComponent    = [string] $rule.targetComponent
+                targetVersion      = [string] $rule.targetVersion
+                migrationMethod    = [string] $rule.migrationMethod
+                supportBoundary    = [string] $rule.supportBoundary
+                placementId        = [string] $rule.placementId
+                carryForward       = @($rule.carryForward)
+                abandon            = @($rule.abandon)
+                manualRebuild      = @($rule.manualRebuild)
+                gates              = @($rule.gates)
+                automation         = [ordered]@{
+                    powerCliModules = @($rule.automation.powerCliModules)
+                    commands        = @($rule.automation.commands)
+                }
+            }
+        }
+    )
+
+    $plan = [ordered]@{
+        schemaVersion             = [string] $snapshot.artifactSchema.schemaVersion
+        architectureId            = 'northstar-wld02-aria-to-vcf-9'
+        estateId                  = [string] $estate.estateId
+        compatibilitySnapshotId   = [string] $snapshot.snapshotId
+        targetRelease             = [string] $snapshot.targetRelease
+        managementDomainImpact    = 'none'
+        addedWorkloadDomain       = [ordered]@{
+            id                    = [string] $workload.id
+            clusterId             = [string] $cluster.id
+            hostCount             = [int] $cluster.hostCount
+            failuresToTolerate    = [int] $cluster.failuresToTolerate
+            minimumHostCount      = [int] $minimumHosts
+        }
+        placements                 = $placements
+        waves                      = $waves
+    }
+
+    $target = [System.IO.Path]::GetFullPath($OutputPath)
+    $parent = [System.IO.Path]::GetDirectoryName($target)
+    if (-not [System.IO.Directory]::Exists($parent)) {
+        [System.IO.Directory]::CreateDirectory($parent) | Out-Null
+    }
+    $json = $plan | ConvertTo-Json -Depth 64
+    [System.IO.File]::WriteAllText(
+        $target,
+        $json + [Environment]::NewLine,
+        [System.Text.UTF8Encoding]::new($false)
+    )
+    Get-Item -LiteralPath $target
+}
+
+Export-ModuleMember -Function Export-VcfAriaMigrationArchitecture

+#!/usr/bin/env python3
+"""Reference proof that executes the genuine subscription retriever."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import sqlite3
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+LEDGER_PATH = ROOT / ".subscription-evidence" / "session.jsonl"
+EXECUTABLE = ROOT / "subscription_get"
+SEED_PATH = ROOT / "data" / "subscriptions.sql"
+REQUESTED_ID = "tel-138"
+
+
+def compact_json(value: Any) -> bytes:
+    return json.dumps(
+        value,
+        sort_keys=True,
+        separators=(",", ":"),
+    ).encode("utf-8")
+
+
+def expected_result() -> dict[str, Any]:
+    connection = sqlite3.connect(":memory:")
+    connection.row_factory = sqlite3.Row
+    try:
+        connection.executescript(SEED_PATH.read_text(encoding="utf-8"))
+        row = connection.execute(
+            """
+            SELECT
+                id,
+                account_name,
+                plan,
+                status,
+                activated_at,
+                next_billing_date,
+                monthly_price_cents,
+                line_count
+              FROM subscriptions
+             WHERE id = ?
+            """,
+            (REQUESTED_ID,),
+        ).fetchone()
+    finally:
+        connection.close()
+    if row is None:
+        raise RuntimeError("reference subscription is missing")
+    return {
+        "id": row["id"],
+        "account_name": row["account_name"],
+        "plan": row["plan"],
+        "status": row["status"],
+        "activated_at": row["activated_at"],
+        "next_billing_date": row["next_billing_date"],
+        "monthly_price_cents": row["monthly_price_cents"],
+        "line_count": row["line_count"],
+    }
+
+
+def main() -> int:
+    expected_evidence = LEDGER_PATH.read_bytes()
+    LEDGER_PATH.unlink()
+    completed = subprocess.run(
+        [str(EXECUTABLE), REQUESTED_ID],
+        cwd=ROOT,
+        capture_output=True,
+        check=False,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(
+            completed.stderr.decode("utf-8", errors="replace").strip()
+            or "subscription retrieval failed"
+        )
+    if completed.stderr:
+        raise RuntimeError("subscription retriever wrote unexpected stderr")
+    if completed.stdout != compact_json(expected_result()) + b"\n":
+        raise RuntimeError("subscription retriever returned unexpected native output")
+    if LEDGER_PATH.read_bytes() != expected_evidence:
+        raise RuntimeError(
+            "subscription executable did not recreate reference evidence"
+        )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

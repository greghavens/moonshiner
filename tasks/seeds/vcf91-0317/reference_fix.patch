+"""Command line front end for the VCF Automation catalog client.
+
+    python -m vcfa_catalog list-items --base-url URL --token TOKEN
+    python -m vcfa_catalog get-item   --base-url URL --token TOKEN --id ID
+
+``list-items`` writes one tab-separated ``<id>\\t<name>`` line per catalog item,
+in the order the contract requires, so the output is diffable between runs.
+"""
+
+import argparse
+import json
+import sys
+
+from .client import DEFAULT_PAGE_SIZE, CatalogClient, VcfaApiError
+
+
+def build_parser():
+    parser = argparse.ArgumentParser(prog="vcfa_catalog", description=__doc__)
+    sub = parser.add_subparsers(dest="command", required=True)
+
+    def common(sp):
+        sp.add_argument("--base-url", required=True, help="VCF Automation base URL")
+        sp.add_argument("--token", required=True, help="bearer access token")
+
+    listing = sub.add_parser("list-items", help="list every catalog item")
+    common(listing)
+    listing.add_argument("--page-size", type=int, default=DEFAULT_PAGE_SIZE)
+    listing.add_argument("--search", default=None)
+    listing.add_argument(
+        "--project",
+        dest="projects",
+        action="append",
+        default=None,
+        help="repeatable; sent as one comma-joined 'projects' parameter",
+    )
+    listing.add_argument(
+        "--type", dest="types", action="append", default=None, help="repeatable"
+    )
+    listing.add_argument("--expand-projects", action="store_true", default=None)
+
+    one = sub.add_parser("get-item", help="fetch a single catalog item")
+    common(one)
+    one.add_argument("--id", required=True, dest="item_id")
+
+    return parser
+
+
+def main(argv=None):
+    args = build_parser().parse_args(argv)
+    client = CatalogClient(
+        args.base_url,
+        args.token,
+        page_size=getattr(args, "page_size", DEFAULT_PAGE_SIZE),
+    )
+
+    try:
+        if args.command == "list-items":
+            items = client.list_catalog_items(
+                search=args.search,
+                projects=args.projects,
+                types=args.types,
+                expand_projects=args.expand_projects,
+            )
+            for item in items:
+                sys.stdout.write("%s\t%s\n" % (item["id"], item["name"]))
+        else:
+            item = client.get_catalog_item(args.item_id)
+            json.dump(item, sys.stdout, indent=2)
+            sys.stdout.write("\n")
+    except VcfaApiError as exc:
+        sys.stderr.write("%s\n" % exc)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())

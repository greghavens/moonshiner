+"""Client for the VMware Cloud Foundation Automation 9.1 catalog API.
+
+The API surface this package speaks is defined by ``docs/contract.json``, which
+was derived from the Broadcom xAPIs reference rather than from a published
+specification. Standard library only.
+"""
+
+from .client import CatalogClient, VcfaApiError
+
+__all__ = [
+    "CatalogClient",
+    "VcfaApiError",
+]

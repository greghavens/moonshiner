{
  "contract_version": 1,
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/vsphere/openapi/automation/vcenter.yaml",
    "spec_blob_sha": "8028b0824c4ff3503d05f44814f967938a795c40",
    "license": "Apache-2.0"
  },
  "api": {
    "openapi": "3.0.3",
    "title": "vSphere Automation API",
    "version": "9.1.0.0",
    "server_path": "/api",
    "media_type": "application/json",
    "security_scheme": {
      "name": "api_key_auth",
      "type": "apiKey",
      "in": "header",
      "header": "vmware-api-session-id"
    }
  },
  "operations": [
    {
      "operationId": "Vcenter.VM_clone$Task",
      "method": "POST",
      "spec_path_key": "/vcenter/vm?action=clone&vmw-task=true",
      "request_path": "/vcenter/vm",
      "fixed_query": {
        "action": "clone",
        "vmw-task": "true"
      },
      "request_body": {
        "required": true,
        "schema": "Vcenter.VM.CloneSpec",
        "media_type": "application/json"
      },
      "responses": {
        "202": {
          "media_type": "application/json",
          "schema": {
            "type": "string"
          }
        }
      },
      "security": "api_key_auth"
    },
    {
      "operationId": "Cis.Tasks_get",
      "method": "GET",
      "spec_path_key": "/cis/tasks/{task}",
      "request_path": "/cis/tasks/{task}",
      "path_parameters": {
        "task": {
          "required": true,
          "type": "string",
          "resource_type": "com.vmware.cis.task"
        }
      },
      "query_parameters": {
        "spec": {
          "required": false,
          "schema": "Cis.Tasks.GetSpec"
        }
      },
      "responses": {
        "200": {
          "media_type": "application/json",
          "schema": "Cis.Task.Info"
        }
      },
      "security": "api_key_auth"
    },
    {
      "operationId": "Vcenter.VM_list",
      "method": "GET",
      "spec_path_key": "/vcenter/vm",
      "request_path": "/vcenter/vm",
      "query_parameters": {
        "vms": {
          "required": false,
          "type": "array",
          "items": "string"
        },
        "names": {
          "required": false,
          "type": "array",
          "items": "string"
        },
        "folders": {
          "required": false,
          "type": "array",
          "items": "string"
        },
        "datacenters": {
          "required": false,
          "type": "array",
          "items": "string"
        },
        "hosts": {
          "required": false,
          "type": "array",
          "items": "string"
        },
        "clusters": {
          "required": false,
          "type": "array",
          "items": "string"
        },
        "resource_pools": {
          "required": false,
          "type": "array",
          "items": "string"
        },
        "power_states": {
          "required": false,
          "type": "array",
          "items": "string"
        }
      },
      "responses": {
        "200": {
          "media_type": "application/json",
          "schema": {
            "type": "array",
            "items": "Vcenter.VM.Summary"
          }
        }
      },
      "security": "api_key_auth"
    }
  ],
  "schemas": {
    "Vcenter.VM.CloneSpec": {
      "type": "object",
      "required": [
        "name",
        "source"
      ],
      "selected_properties": {
        "source": {
          "type": "string",
          "resource_type": "VirtualMachine"
        },
        "name": {
          "type": "string"
        },
        "placement": {
          "schema": "Vcenter.VM.ClonePlacementSpec",
          "nullable_by_omission": true
        },
        "power_on": {
          "type": "boolean",
          "default_when_omitted": false
        }
      }
    },
    "Cis.Task.Info": {
      "type": "object",
      "required": [
        "cancelable",
        "description",
        "operation",
        "service",
        "status"
      ],
      "selected_properties": {
        "description": {
          "schema": "Vapi.Std.LocalizableMessage"
        },
        "service": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "schema": "Cis.Task.Status"
        },
        "cancelable": {
          "type": "boolean"
        },
        "result": {
          "nullable_by_omission": true
        },
        "error": {
          "type": "object",
          "nullable_by_omission": true
        }
      }
    },
    "Cis.Task.Status": {
      "type": "string",
      "enum": [
        "PENDING",
        "RUNNING",
        "BLOCKED",
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "Cis.Tasks.GetSpec": {
      "type": "object",
      "selected_properties": {
        "return_all": {
          "type": "boolean"
        },
        "exclude_result": {
          "type": "boolean"
        }
      }
    },
    "Vcenter.VM.Summary": {
      "type": "object",
      "required": [
        "name",
        "power_state",
        "vm"
      ],
      "selected_properties": {
        "vm": {
          "type": "string",
          "resource_type": "VirtualMachine"
        },
        "name": {
          "type": "string"
        },
        "power_state": {
          "type": "string",
          "enum": [
            "POWERED_OFF",
            "POWERED_ON",
            "SUSPENDED"
          ]
        },
        "cpu_count": {
          "type": "integer",
          "format": "int64",
          "nullable_by_omission": true
        },
        "memory_size_mib": {
          "type": "integer",
          "format": "int64",
          "nullable_by_omission": true
        }
      }
    }
  }
}

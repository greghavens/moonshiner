+    private static Object parse(String input) throws IOException {
+        try {
+            return new JsonParser(input).parseDocument();
+        } catch (IllegalArgumentException error) {
+            throw new IOException(
+                    "malformed JSON response: " + error.getMessage(), error);
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    private static Map<String, Object> object(Object value, String field)
+            throws IOException {
+        if (!(value instanceof Map<?, ?>)) {
+            throw new IOException(
+                    "malformed response: " + field + " must be an object");
+        }
+        return (Map<String, Object>) value;
+    }
+
+    private static String string(Object value, String field) throws IOException {
+        if (!(value instanceof String text)) {
+            throw new IOException(
+                    "malformed response: " + field + " must be a string");
+        }
+        return text;
+    }

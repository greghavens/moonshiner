+#!/usr/bin/env python3
+"""Reference proof using the same executable dependency path required of Pi."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parent
+
+
+def parallel(commands: list[list[str]]) -> list[dict[str, object]]:
+    processes = [
+        subprocess.Popen(
+            command,
+            cwd=ROOT,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for command in commands
+    ]
+    results: list[dict[str, object]] = []
+    for process in processes:
+        stdout, stderr = process.communicate(timeout=15)
+        if process.returncode != 0:
+            raise RuntimeError(stderr.strip() or "parallel expense operation failed")
+        payload = json.loads(stdout)
+        if not isinstance(payload, dict):
+            raise RuntimeError("expense operation returned an invalid payload")
+        results.append(payload)
+    return results
+
+
+def run(command: list[str]) -> dict[str, object]:
+    completed = subprocess.run(
+        command,
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=15,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "expense operation failed")
+    payload = json.loads(completed.stdout)
+    if not isinstance(payload, dict):
+        raise RuntimeError("expense operation returned an invalid payload")
+    return payload
+
+
+def main() -> int:
+    subprocess.run(["./expensectl", "--help"], cwd=ROOT, check=True, stdout=subprocess.DEVNULL)
+
+    requested = [
+        ("North Loop mileage claim", "Chicago"),
+        ("After-school supplies receipt", "Boston"),
+    ]
+    search_results = parallel(
+        [
+            ["./expensectl", "search", "--title", title, "--city", city]
+            for title, city in requested
+        ]
+    )
+
+    identifiers: list[str] = []
+    for expected, result in zip(requested, search_results):
+        query = result.get("query")
+        matches = result.get("matches")
+        if query != {"title": expected[0], "city": expected[1]}:
+            raise RuntimeError("search response did not match its request")
+        if not isinstance(matches, list) or len(matches) != 1:
+            raise RuntimeError(f"lookup did not resolve uniquely: {expected[0]} in {expected[1]}")
+        match = matches[0]
+        if not isinstance(match, dict):
+            raise RuntimeError("search response contained an invalid match")
+        identifier = match.get("id")
+        if not isinstance(identifier, str) or not identifier:
+            raise RuntimeError("search response did not contain a stable ID")
+        identifiers.append(identifier)
+
+    get_results = parallel(
+        [["./expensectl", "get", "--id", identifier] for identifier in identifiers]
+    )
+    records: list[dict[str, object]] = []
+    for expected, identifier, result in zip(requested, identifiers, get_results):
+        record = result.get("record")
+        if not isinstance(record, dict):
+            raise RuntimeError("full-record retrieval failed")
+        if (
+            record.get("id") != identifier
+            or record.get("title") != expected[0]
+            or record.get("city") != expected[1]
+            or not isinstance(record.get("status"), str)
+        ):
+            raise RuntimeError("retrieved record did not match its resolved branch")
+        records.append(record)
+
+    after_school = records[1]
+    if after_school["status"] != "submitted":
+        return 0
+
+    update_result = run(
+        [
+            "./expensectl",
+            "update",
+            "--id",
+            str(after_school["id"]),
+            "--from-status",
+            "submitted",
+            "--to-status",
+            "needs-receipt",
+        ]
+    )
+    receipt = update_result.get("mutation_receipt")
+    updated = update_result.get("record")
+    transition = update_result.get("transition")
+    if (
+        update_result.get("changed") is not True
+        or not isinstance(updated, dict)
+        or updated.get("id") != after_school["id"]
+        or updated.get("status") != "needs-receipt"
+        or transition != {"from_status": "submitted", "to_status": "needs-receipt"}
+        or not isinstance(receipt, str)
+        or not receipt
+    ):
+        raise RuntimeError("permitted mutation did not succeed")
+
+    notice_result = run(
+        [
+            "./expensectl",
+            "notify",
+            "--recipient",
+            "expense review desk",
+            "--after-receipt",
+            receipt,
+            "--subject",
+            "Receipt status outcome: After-school supplies receipt",
+            "--message",
+            "After-school supplies receipt was changed from submitted to needs-receipt after full-record verification.",
+        ]
+    )
+    if notice_result.get("delivered") is not True:
+        raise RuntimeError("dependent expense review notice was not delivered")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

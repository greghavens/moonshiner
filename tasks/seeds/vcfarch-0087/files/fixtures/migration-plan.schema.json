{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch-0087:migration-plan:1.0",
  "title": "Brownfield VCF ordered migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "estateId",
    "sourceRelease",
    "targetRelease",
    "snapshotId",
    "targetSddcSpec",
    "components",
    "steps"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "sourceRelease": {"type": "string", "minLength": 1},
    "targetRelease": {"type": "string", "minLength": 1},
    "snapshotId": {"type": "string", "minLength": 1},
    "targetSddcSpec": {"type": "object"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "currentVersion", "targetVersion", "gatedBy"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "currentVersion": {"type": "string", "minLength": 1},
        "targetVersion": {"type": "string", "minLength": 1},
        "gatedBy": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "id", "action", "requires", "produces", "rationale"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "id": {"type": "string", "minLength": 1},
        "action": {
          "type": "string",
          "enum": ["capture-identifiers", "remove", "detach-domain", "deploy", "reimport-domain", "upgrade"]
        },
        "componentId": {"type": "string", "minLength": 1},
        "fromVersion": {"type": "string", "minLength": 1},
        "toVersion": {"type": "string", "minLength": 1},
        "requires": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "produces": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 12}
      }
    }
  }
}

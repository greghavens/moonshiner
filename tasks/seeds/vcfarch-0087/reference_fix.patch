 // Validate checks a plan against the inventory and pinned compatibility
 // snapshot. JSON-schema and installer-schema validation are verifier concerns.
-func Validate(Plan, Inventory, CompatibilitySnapshot) error {
-	return errors.New("migration architecture validation is not implemented")
+func Validate(plan Plan, inventory Inventory, snapshot CompatibilitySnapshot) error {
+	if plan.SchemaVersion != "1.0" || plan.EstateID != inventory.EstateID {
+		return fmt.Errorf("plan identity does not match inventory")
+	}
+	if plan.SourceRelease != inventory.SourceRelease || plan.TargetRelease != inventory.TargetRelease {
+		return fmt.Errorf("plan releases do not match inventory")
+	}
+	if snapshot.SourceRelease != inventory.SourceRelease || snapshot.TargetRelease != inventory.TargetRelease {
+		return fmt.Errorf("inventory and compatibility snapshot releases disagree")
+	}
+	if plan.SnapshotID != snapshot.SnapshotID {
+		return fmt.Errorf("plan references snapshot %q, want %q", plan.SnapshotID, snapshot.SnapshotID)
+	}
+	if err := validateTargetSpec(plan.TargetSddcSpec, inventory); err != nil {
+		return err
+	}
+
+	inventoryByID := make(map[string]InventoryItem, len(inventory.Components))
+	for _, item := range inventory.Components {
+		if _, exists := inventoryByID[item.ID]; exists {
+			return fmt.Errorf("duplicate inventory component %q", item.ID)
+		}
+		inventoryByID[item.ID] = item
+	}
+	contractByID := make(map[string]ComponentContract, len(snapshot.Components))
+	for _, contract := range snapshot.Components {
+		if _, exists := contractByID[contract.ID]; exists {
+			return fmt.Errorf("duplicate snapshot component %q", contract.ID)
+		}
+		contractByID[contract.ID] = contract
+	}
+	if len(plan.Components) != len(inventoryByID) || len(contractByID) != len(inventoryByID) {
+		return fmt.Errorf("component coverage is incomplete")
+	}
+	seenComponents := map[string]bool{}
+	for _, component := range plan.Components {
+		if seenComponents[component.ID] {
+			return fmt.Errorf("duplicate plan component %q", component.ID)
+		}
+		seenComponents[component.ID] = true
+		item, ok := inventoryByID[component.ID]
+		if !ok {
+			return fmt.Errorf("unknown plan component %q", component.ID)
+		}
+		contract, ok := contractByID[component.ID]
+		if !ok {
+			return fmt.Errorf("snapshot has no contract for %q", component.ID)
+		}
+		if component.Name != item.Name || component.CurrentVersion != item.Version {
+			return fmt.Errorf("component %q does not match current inventory", component.ID)
+		}
+		if component.CurrentVersion != contract.CurrentVersion || component.TargetVersion != contract.TargetVersion {
+			return fmt.Errorf("component %q versions violate compatibility snapshot", component.ID)
+		}
+		if !reflect.DeepEqual(component.GatedBy, []string{contract.FinalGate}) {
+			return fmt.Errorf("component %q must be gated by %q", component.ID, contract.FinalGate)
+		}
+	}
+
+	gateByID := make(map[string]GateContract, len(snapshot.Gates))
+	for _, gate := range snapshot.Gates {
+		if _, exists := gateByID[gate.ID]; exists {
+			return fmt.Errorf("duplicate snapshot gate %q", gate.ID)
+		}
+		gateByID[gate.ID] = gate
+	}
+	if len(plan.Steps) != len(gateByID) {
+		return fmt.Errorf("plan has %d steps, want %d", len(plan.Steps), len(gateByID))
+	}
+	state := make(map[string]string, len(inventory.Components))
+	for _, item := range inventory.Components {
+		state[item.ID] = item.Version
+	}
+	produced := map[string]bool{}
+	seenSteps := map[string]bool{}
+	for index, step := range plan.Steps {
+		if step.Order != index+1 {
+			return fmt.Errorf("step %q order is %d, want %d", step.ID, step.Order, index+1)
+		}
+		if seenSteps[step.ID] {
+			return fmt.Errorf("duplicate step %q", step.ID)
+		}
+		seenSteps[step.ID] = true
+		gate, ok := gateByID[step.ID]
+		if !ok {
+			return fmt.Errorf("step %q is not in the compatibility snapshot", step.ID)
+		}
+		if step.Action != gate.Action || step.ComponentID != gate.ComponentID || step.FromVersion != gate.FromVersion || step.ToVersion != gate.ToVersion {
+			return fmt.Errorf("step %q action or transition drifts from snapshot", step.ID)
+		}
+		if !reflect.DeepEqual(step.Requires, gate.Requires) || step.Produces != gate.Produces {
+			return fmt.Errorf("step %q gate contract drifts from snapshot", step.ID)
+		}
+		if utf8.RuneCountInString(step.Rationale) < gate.MinimumRationale {
+			return fmt.Errorf("step %q rationale is too short", step.ID)
+		}
+		for _, requirement := range step.Requires {
+			if !produced[requirement] {
+				return fmt.Errorf("step %q requires unavailable gate %q", step.ID, requirement)
+			}
+		}
+		if produced[step.Produces] {
+			return fmt.Errorf("gate %q is produced more than once", step.Produces)
+		}
+		if step.ComponentID != "" {
+			current, ok := state[step.ComponentID]
+			if !ok {
+				return fmt.Errorf("step %q names unknown component %q", step.ID, step.ComponentID)
+			}
+			if current != step.FromVersion {
+				return fmt.Errorf("step %q starts %q at %q, current state is %q", step.ID, step.ComponentID, step.FromVersion, current)
+			}
+			contract := contractByID[step.ComponentID]
+			transition := Transition{From: step.FromVersion, To: step.ToVersion, Operation: step.Action}
+			if contains(contract.BlockedTransitions, transition) {
+				return fmt.Errorf("step %q uses a blocked transition", step.ID)
+			}
+			if !contains(contract.AllowedTransitions, transition) {
+				return fmt.Errorf("step %q transition is not supported", step.ID)
+			}
+			state[step.ComponentID] = step.ToVersion
+		}
+		produced[step.Produces] = true
+	}
+	for _, contract := range snapshot.Components {
+		if state[contract.ID] != contract.TargetVersion {
+			return fmt.Errorf("component %q finishes at %q, want %q", contract.ID, state[contract.ID], contract.TargetVersion)
+		}
+		if !produced[contract.FinalGate] {
+			return fmt.Errorf("component %q final gate %q was not produced", contract.ID, contract.FinalGate)
+		}
+	}
+	return nil
+}
+
+func componentVersion(components []InventoryItem, id string) string {
+	for _, component := range components {
+		if component.ID == id {
+			return component.Version
+		}
+	}
+	return ""
+}
+
+func contains(transitions []Transition, candidate Transition) bool {
+	for _, transition := range transitions {
+		if transition == candidate {
+			return true
+		}
+	}
+	return false
+}
+
+func validateTargetSpec(raw json.RawMessage, inventory Inventory) error {
+	var spec struct {
+		SddcID       string `json:"sddcId"`
+		WorkflowType string `json:"workflowType"`
+		Version      string `json:"version"`
+		VcenterSpec  struct {
+			Hostname    string `json:"vcenterHostname"`
+			Password    string `json:"rootVcenterPassword"`
+			Version     string `json:"version"`
+			UseExisting bool   `json:"useExistingDeployment"`
+		} `json:"vcenterSpec"`
+		NetworkSpecs []struct {
+			Type   string `json:"networkType"`
+			VLANID int    `json:"vlanId"`
+		} `json:"networkSpecs"`
+		DNSSpec struct {
+			Subdomain   string   `json:"subdomain"`
+			Nameservers []string `json:"nameservers"`
+		} `json:"dnsSpec"`
+	}
+	if err := json.Unmarshal(raw, &spec); err != nil {
+		return fmt.Errorf("decode targetSddcSpec: %w", err)
+	}
+	inputs := inventory.InstallerInputs
+	if spec.SddcID != inputs.SddcID || spec.WorkflowType != "VCF" || spec.Version != inventory.TargetRelease {
+		return fmt.Errorf("targetSddcSpec identity or release does not match inventory")
+	}
+	if spec.VcenterSpec.Hostname != inputs.VcenterHostname || spec.VcenterSpec.Password != inputs.RootVcenterPassword || spec.VcenterSpec.Version != componentVersion(inventory.Components, "vcenter") || !spec.VcenterSpec.UseExisting {
+		return fmt.Errorf("targetSddcSpec does not identify the existing vCenter")
+	}
+	if spec.DNSSpec.Subdomain != inputs.Subdomain || !reflect.DeepEqual(spec.DNSSpec.Nameservers, inputs.Nameservers) {
+		return fmt.Errorf("targetSddcSpec DNS does not match inventory")
+	}
+	if len(spec.NetworkSpecs) != 1 || spec.NetworkSpecs[0].Type != "MANAGEMENT" || spec.NetworkSpecs[0].VLANID != inputs.ManagementVLAN {
+		return fmt.Errorf("targetSddcSpec management network does not match inventory")
+	}
+	return nil
 }

+func Build(inventory Inventory, snapshot CompatibilitySnapshot) (Plan, error) {
+	contracts := make(map[string]ComponentContract, len(snapshot.Components))
+	for _, contract := range snapshot.Components {
+		if _, exists := contracts[contract.ID]; exists {
+			return Plan{}, fmt.Errorf("duplicate snapshot component %q", contract.ID)
+		}
+		contracts[contract.ID] = contract
+	}
+
+	components := make([]ComponentPlan, 0, len(inventory.Components))
+	for _, item := range inventory.Components {
+		contract, ok := contracts[item.ID]
+		if !ok {
+			return Plan{}, fmt.Errorf("snapshot has no component %q", item.ID)
+		}
+		components = append(components, ComponentPlan{
+			ID:             item.ID,
+			Name:           item.Name,
+			CurrentVersion: item.Version,
+			TargetVersion:  contract.TargetVersion,
+			GatedBy:        []string{contract.FinalGate},
+		})
+	}
+
+	rationales := map[string]string{
+		"capture-identifiers":   "Preserve the domain, host, vCenter, and NSX identities needed by detach and re-import operations.",
+		"unprepare-nsx":         "Remove NSX from every cluster so the newer build is not presented as an in-place upgrade source.",
+		"detach-domain":         "Clear the unprepared hosts, NSX cluster, domain inventory, and stale vCenter registration before re-import.",
+		"deploy-compatible-nsx": "Deploy the pinned compatible NSX build as a fresh instance, avoiding the blocked back-in-time edge.",
+		"reimport-domain":       "Import the existing vCenter and its hosts with the compatible replacement NSX instance attached.",
+		"upgrade-sddc-manager":  "Move lifecycle orchestration to the target release before upgrading workload-domain components.",
+		"upgrade-nsx":           "Upgrade replacement NSX over its supported edge before the dependent vCenter and ESXi transitions.",
+		"upgrade-vcenter":       "Upgrade vCenter only after NSX reaches its target, preserving the pinned core component order.",
+		"upgrade-esxi":          "Remediate the cluster last so every core management component is already at its target state.",
+	}
+	steps := make([]Step, 0, len(snapshot.Gates))
+	for index, gate := range snapshot.Gates {
+		rationale, ok := rationales[gate.ID]
+		if !ok {
+			return Plan{}, fmt.Errorf("no architecture rationale for gate %q", gate.ID)
+		}
+		steps = append(steps, Step{
+			Order:       index + 1,
+			ID:          gate.ID,
+			Action:      gate.Action,
+			ComponentID: gate.ComponentID,
+			FromVersion: gate.FromVersion,
+			ToVersion:   gate.ToVersion,
+			Requires:    append([]string{}, gate.Requires...),
+			Produces:    gate.Produces,
+			Rationale:   rationale,
+		})
+	}
+
+	targetSpec, err := json.Marshal(struct {
+		SddcID       string `json:"sddcId"`
+		WorkflowType string `json:"workflowType"`
+		Version      string `json:"version"`
+		VcenterSpec  struct {
+			VcenterHostname     string `json:"vcenterHostname"`
+			RootVcenterPassword string `json:"rootVcenterPassword"`
+			Version             string `json:"version"`
+			UseExisting         bool   `json:"useExistingDeployment"`
+		} `json:"vcenterSpec"`
+		NetworkSpecs []struct {
+			NetworkType string `json:"networkType"`
+			VLANID      int    `json:"vlanId"`
+		} `json:"networkSpecs"`
+		DNSSpec struct {
+			Subdomain   string   `json:"subdomain"`
+			Nameservers []string `json:"nameservers"`
+		} `json:"dnsSpec"`
+	}{
+		SddcID:       inventory.InstallerInputs.SddcID,
+		WorkflowType: "VCF",
+		Version:      inventory.TargetRelease,
+		VcenterSpec: struct {

{
  "contractVersion": 1,
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "license": "Apache-2.0",
    "commitSha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "specPath": "specifications/sddc-manager/sddc-manager-openapi.json",
    "openapiVersion": "3.0.1",
    "apiTitle": "SDDC Manager API Reference Guide",
    "apiVersion": "9.1.0.0",
    "projectionRule": "Project the three named operations and only the schema fields required for authentication, HostCommissionSpec serialization, Task polling, and task error reporting."
  },
  "operations": [
    {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "tag": "Tokens",
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": {
          "$ref": "#/schemas/TokenCreationSpec"
        }
      },
      "responses": {
        "201": {
          "description": "Created",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/TokenPair"
          }
        }
      }
    },
    {
      "operationId": "commissionHosts",
      "method": "POST",
      "path": "/v1/hosts",
      "tag": "Hosts",
      "summary": "Commission the Hosts",
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/schemas/HostCommissionSpec"
          }
        }
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/Task"
          }
        }
      }
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "tag": "Tasks",
      "summary": "Retrieve a task by its ID",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "description": "Task id to retrieve",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "A task object.",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/Task"
          }
        }
      }
    }
  ],
  "schemas": {
    "TokenCreationSpec": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "Username"
        },
        "password": {
          "type": "string",
          "description": "User Password"
        },
        "apiKey": {
          "type": "string",
          "description": "API Key"
        },
        "idToken": {
          "type": "string",
          "description": "Id Token"
        }
      },
      "description": "The spec used to sign the token"
    },
    "RefreshToken": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Refresh token id that can be used to request new access token"
        }
      }
    },
    "TokenPair": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string",
          "description": "Bearer token that can be used to make public API calls"
        },
        "refreshToken": {
          "$ref": "#/schemas/RefreshToken"
        }
      }
    },
    "HostCommissionSpec": {
      "required": [
        "fqdn",
        "networkPoolId",
        "password",
        "storageType",
        "username"
      ],
      "type": "object",
      "properties": {
        "fqdn": {
          "type": "string",
          "description": "FQDN of the host"
        },
        "username": {
          "type": "string",
          "description": "Username of the host"
        },
        "password": {
          "type": "string",
          "description": "Password of the host"
        },
        "storageType": {
          "type": "string",
          "description": "Storage Type",
          "example": "One among: VSAN, VSAN_ESA, VSAN_REMOTE, VSAN_MAX, NFS, NFS41, VMFS_FC, VVOL, VMFS, FC, VVOL"
        },
        "vvolStorageProtocolType": {
          "type": "string",
          "description": "vVol Storage Protocol Type",
          "example": "One among: ISCSI, NFS, FC"
        },
        "networkPoolId": {
          "type": "string",
          "description": "ID of the network pool to associate the host with"
        },
        "networkPoolName": {
          "type": "string",
          "description": "Name of the network pool to associate the host with"
        },
        "sshThumbprint": {
          "type": "string",
          "description": "SSH thumbprint of the host"
        },
        "sslThumbprint": {
          "type": "string",
          "description": "SSL thumbprint of the host"
        }
      },
      "description": "This specification contains the input to commission a host to VMware Cloud Foundation"
    },
    "Task": {
      "required": [
        "creationTimestamp",
        "id",
        "name",
        "status"
      ],
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Task ID",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "description": "Task name",
          "readOnly": true
        },
        "type": {
          "type": "string",
          "description": "Operation that is represented by the Task in machine readable format.",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "description": "Task status",
          "readOnly": true,
          "example": "One among: PENDING, Pending, IN_PROGRESS, In Progress, SUCCESSFUL, Successful, FAILED, Failed, CANCELLED, Cancelled, COMPLETED_WITH_WARNING, SKIPPED, QUEUED, TIMED_OUT, Queued, Timed Out"
        },
        "creationTimestamp": {
          "type": "string",
          "description": "Task creation timestamp",
          "readOnly": true
        },
        "completionTimestamp": {
          "type": "string",
          "description": "Task completion timestamp",
          "readOnly": true
        },
        "errors": {
          "type": "array",
          "description": "List of errors in case of a failure",
          "readOnly": true,
          "items": {
            "$ref": "#/schemas/Error"
          }
        }
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "errorCode": {
          "type": "string",
          "readOnly": true
        },
        "message": {
          "type": "string",
          "readOnly": true
        },
        "referenceToken": {
          "type": "string",
          "readOnly": true
        }
      }
    }
  },
  "clientPollingPolicy": {
    "submissionIsNotCompletion": true,
    "statusNormalization": "trim, uppercase invariant, replace spaces with underscores",
    "nonTerminal": [
      "PENDING",
      "IN_PROGRESS",
      "QUEUED"
    ],
    "successfulTerminal": [
      "SUCCESSFUL",
      "COMPLETED_WITH_WARNING",
      "SKIPPED"
    ],
    "failedTerminal": [
      "FAILED",
      "CANCELLED",
      "TIMED_OUT"
    ],
    "unknownStatus": "continue polling subject to PollLimit"
  }
}

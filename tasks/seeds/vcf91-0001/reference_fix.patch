diff --git a/VcfHostCommission.psm1 b/VcfHostCommission.psm1
new file mode 100644
index 0000000..c163bc9
--- /dev/null
+++ b/VcfHostCommission.psm1
@@ -0,0 +1,212 @@
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+Import-Module -Name 'VMware.Sdk.Vcf.SddcManager' `
+    -MinimumVersion '13.5.0.25380678' `
+    -ErrorAction Stop
+
+class VcfHostCommissionFailedException : System.Exception {
+    [string] $TaskId
+    [string] $TaskStatus
+    [string] $ErrorCode
+    [string] $ReferenceToken
+
+    VcfHostCommissionFailedException(
+        [string] $message,
+        [string] $taskId,
+        [string] $taskStatus,
+        [string] $errorCode,
+        [string] $referenceToken
+    ) : base($message) {
+        $this.TaskId = $taskId
+        $this.TaskStatus = $taskStatus
+        $this.ErrorCode = $errorCode
+        $this.ReferenceToken = $referenceToken
+    }
+}
+
+class VcfHostCommissionTimeoutException : System.TimeoutException {
+    [string] $TaskId
+    [int] $PollCount
+
+    VcfHostCommissionTimeoutException(
+        [string] $message,
+        [string] $taskId,
+        [int] $pollCount
+    ) : base($message) {
+        $this.TaskId = $taskId
+        $this.PollCount = $pollCount
+    }
+}
+
+function Start-VcfHostCommissionAndWait {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateNotNull()]
+        [object] $Server,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $Fqdn,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNull()]
+        [pscredential] $Credential,
+
+        [Parameter(Mandatory)]
+        [ValidateSet(
+            'VSAN',
+            'VSAN_ESA',
+            'VSAN_REMOTE',
+            'VSAN_MAX',
+            'NFS',
+            'NFS41',
+            'VMFS_FC',
+            'VVOL',
+            'VMFS',
+            'FC'
+        )]
+        [string] $StorageType,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $NetworkPoolId,
+
+        [ValidateSet('ISCSI', 'NFS', 'FC')]
+        [string] $VvolStorageProtocolType,
+
+        [ValidateNotNullOrEmpty()]
+        [string] $NetworkPoolName,
+
+        [ValidateNotNullOrEmpty()]
+        [string] $SshThumbprint,
+
+        [ValidateNotNullOrEmpty()]
+        [string] $SslThumbprint,
+
+        [ValidateRange(1, 2147483647)]
+        [int] $PollLimit = 120,
+
+        [ValidateRange(0, 2147483647)]
+        [int] $PollIntervalSeconds = 5,
+
+        [scriptblock] $SleepAction
+    )
+
+    $plainPassword = $Credential.GetNetworkCredential().Password
+    $modelParameters = @{
+        Fqdn = $Fqdn
+        Username = $Credential.UserName
+        Password = $plainPassword
+        StorageType = $StorageType
+        NetworkPoolId = $NetworkPoolId
+    }
+    foreach ($optionalName in @(
+        'VvolStorageProtocolType',
+        'NetworkPoolName',
+        'SshThumbprint',
+        'SslThumbprint'
+    )) {
+        if ($PSBoundParameters.ContainsKey($optionalName)) {
+            $modelParameters[$optionalName] = $PSBoundParameters[$optionalName]
+        }
+    }
+
+    try {
+        $hostSpec = Initialize-VcfHostCommissionSpec @modelParameters
+    }
+    finally {
+        $plainPassword = $null
+        [void] $modelParameters.Remove('Password')
+    }
+
+    $submission = Invoke-VcfCommissionHosts `
+        -HostCommissionSpec @($hostSpec) `
+        -Server $Server
+    $taskId = [string] $submission.Id
+    if ([string]::IsNullOrWhiteSpace($taskId)) {
+        throw [System.InvalidOperationException]::new(
+            'commissionHosts returned a Task without an id.'
+        )
+    }
+
+    if ($null -eq $SleepAction) {
+        $SleepAction = {
+            param([int] $Seconds)
+            Start-Sleep -Seconds $Seconds
+        }
+    }
+
+    for ($pollCount = 1; $pollCount -le $PollLimit; $pollCount++) {
+        $task = Invoke-VcfGetTask -Id $taskId -Server $Server
+        $status = [string] $task.Status
+        $normalizedStatus = $status.Trim().ToUpperInvariant().Replace(' ', '_')
+
+        if ($normalizedStatus -in @(
+            'SUCCESSFUL',
+            'COMPLETED_WITH_WARNING',
+            'SKIPPED'
+        )) {
+            return [pscustomobject] [ordered] @{
+                Fqdn = $Fqdn
+                TaskId = $taskId
+                Status = $status
+                PollCount = $pollCount
+            }
+        }
+
+        if ($normalizedStatus -in @('FAILED', 'CANCELLED', 'TIMED_OUT')) {
+            $errorCode = $null
+            $referenceToken = $null
+            $message = "VCF task '$taskId' ended with status '$status'."
+            $errorsProperty = $task.PSObject.Properties['Errors']
+            if ($null -ne $errorsProperty -and $null -ne $errorsProperty.Value) {
+                $taskErrors = @($errorsProperty.Value)
+                if ($taskErrors.Count -gt 0 -and $null -ne $taskErrors[0]) {
+                    $firstError = $taskErrors[0]
+                    $errorCodeProperty =
+                        $firstError.PSObject.Properties['ErrorCode']
+                    $messageProperty =
+                        $firstError.PSObject.Properties['Message']
+                    $referenceProperty =
+                        $firstError.PSObject.Properties['ReferenceToken']
+                    if ($null -ne $errorCodeProperty) {
+                        $errorCode = [string] $errorCodeProperty.Value
+                    }
+                    if (
+                        $null -ne $messageProperty -and
+                        -not [string]::IsNullOrWhiteSpace(
+                            [string] $messageProperty.Value
+                        )
+                    ) {
+                        $message = [string] $messageProperty.Value
+                    }
+                    if ($null -ne $referenceProperty) {
+                        $referenceToken = [string] $referenceProperty.Value
+                    }
+                }
+            }
+
+            throw [VcfHostCommissionFailedException]::new(
+                $message,
+                $taskId,
+                $status,
+                $errorCode,
+                $referenceToken
+            )
+        }
+
+        if ($pollCount -lt $PollLimit) {
+            & $SleepAction $PollIntervalSeconds > $null
+        }
+    }
+
+    throw [VcfHostCommissionTimeoutException]::new(
+        "VCF task '$taskId' did not reach a terminal state after $PollLimit polls.",
+        $taskId,
+        $PollLimit
+    )
+}
+
+Export-ModuleMember -Function 'Start-VcfHostCommissionAndWait'

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF 9 existing-estate migration plan",
  "type": "object",
  "required": ["inventoryId", "steps"],
  "additionalProperties": false,
  "properties": {
    "inventoryId": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sequence", "componentId", "componentName", "currentVersion", "targetComponentName", "targetVersion", "action", "gates"],
        "additionalProperties": false,
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "componentId": {"type": "string", "minLength": 1},
          "componentName": {"type": "string", "minLength": 1},
          "currentVersion": {"type": "string", "minLength": 1},
          "targetComponentName": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "action": {"type": "string", "enum": ["PATCH", "UPGRADE", "INSTALL"]},
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}

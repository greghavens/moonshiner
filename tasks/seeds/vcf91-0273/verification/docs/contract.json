{
  "contract_version": 1,
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "spec_path": "specifications/vcf-operations/vcf-operations-openapi.json",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "api_version": "9.1.0.0"
  },
  "base_path": "/suite-api",
  "security": {
    "scheme": "Token-based-authorization",
    "type": "apiKey",
    "in": "header",
    "name": "Authorization",
    "token_prefix": "OpsToken ",
    "note": "The specification fixes the header name but leaves the value free-form; this contract pins the prefix."
  },
  "request_encoding": {
    "content_type": "application/json",
    "accept": "application/json",
    "unset_optional_fields": "omitted",
    "note": "The specification offers application/json and application/xml for these operations; this contract uses JSON only. An optional field that is unset is absent from the encoded object -- never present as an empty string, null, or zero."
  },
  "operations": [
    {
      "operationId": "acquireToken",
      "method": "POST",
      "path": "/api/auth/token/acquire",
      "authenticated": false,
      "spec_note": "security is an empty array for this operation: no Authorization header is sent.",
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "username-password",
        "required_properties": ["username", "password"],
        "properties": {
          "username": {
            "type": "string",
            "required": true
          },
          "password": {
            "type": "string",
            "required": true
          },
          "authSource": {
            "type": "string",
            "required": false,
            "omit_when_unset": true,
            "description": "Name of an Auth Source as specified by the user. Omitted from the request body when the caller does not supply one."
          }
        }
      },
      "success": {
        "status": 200,
        "content_type": "application/json",
        "schema": "auth-token",
        "required_properties": ["token", "validity"],
        "properties": {
          "token": "string",
          "validity": "integer(int64)",
          "expiresAt": "string",
          "roles": "array<string>"
        }
      },
      "errors": [
        {
          "status": 401,
          "description": "Authentication failed"
        }
      ]
    },
    {
      "operationId": "getCurrentUser",
      "method": "GET",
      "path": "/api/auth/currentuser",
      "authenticated": true,
      "request": {
        "required": false,
        "body": null
      },
      "success": {
        "status": 200,
        "content_type": "application/json",
        "schema": "user",
        "properties": {
          "id": "string(uuid)",
          "username": "string",
          "firstName": "string",
          "lastName": "string",
          "enabled": "boolean",
          "roleNames": "array<string>"
        },
        "spec_note": "user is a shared read/write schema; its required list (username, password) describes the create-user direction. Responses do not carry password."
      },
      "errors": [
        {
          "status": 401,
          "description": "Token missing, unknown, or already released"
        }
      ]
    },
    {
      "operationId": "releaseToken",
      "method": "POST",
      "path": "/api/auth/token/release",
      "authenticated": true,
      "spec_note": "Terminates the session identified by the Authorization header. The specification declares no request body and no response body.",
      "request": {
        "required": false,
        "body": null
      },
      "success": {
        "status": 200,
        "body": null
      },
      "errors": [
        {
          "status": 401,
          "description": "Token missing, unknown, or already released"
        }
      ]
    }
  ]
}

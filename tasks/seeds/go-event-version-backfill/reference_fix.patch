 }
+
+func requiredStringField(
+	object map[string]json.RawMessage,
+	name string,
+) (json.RawMessage, error) {
+	raw, exists := object[name]
+	if !exists {
+		return nil, fmt.Errorf("v1 payload is missing %q", name)
+	}
+	var value string
+	if err := json.Unmarshal(raw, &value); err != nil {
+		return nil, fmt.Errorf("v1 payload field %q must be a string: %w", name, err)
+	}
+	if value == "" {
+		return nil, fmt.Errorf("v1 payload field %q cannot be empty", name)
+	}
+	return append(json.RawMessage(nil), raw...), nil

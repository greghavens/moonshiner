+#!/usr/bin/env python3
+"""Reference proof using the genuine subscription executable and returned ID."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+from pathlib import Path
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+TARGET_NAME = "Fiber Plus Household Plan"
+TARGET_LOCATION = "Family"
+
+
+def invoke(arguments: list[str]) -> dict[str, Any]:
+    completed = subprocess.run(
+        ["./subscriptionctl", *arguments],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=15,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(
+            completed.stderr.strip() or "subscription operation failed"
+        )
+    payload = json.loads(completed.stdout)
+    if not isinstance(payload, dict):
+        raise RuntimeError("subscription operation returned an invalid payload")
+    return payload
+
+
+def main() -> int:
+    search = invoke(
+        [
+            "search",
+            "--name",
+            TARGET_NAME,
+            "--location",
+            TARGET_LOCATION,
+        ]
+    )
+    matches = search.get("matches")
+    if (
+        search.get("count") != 1
+        or not isinstance(matches, list)
+        or len(matches) != 1
+    ):
+        raise RuntimeError("reference search did not resolve uniquely")
+    stable_id = matches[0].get("id")
+    if not isinstance(stable_id, str) or not stable_id:
+        raise RuntimeError("reference search returned no stable ID")
+
+    detail = invoke(["get", "--id", stable_id])
+    record = detail.get("record")
+    if not isinstance(record, dict):
+        raise RuntimeError("reference full-record retrieval failed")
+    if record.get("id") != stable_id:
+        raise RuntimeError("reference retrieval returned a different stable ID")
+    if record.get("status") != "active":
+        raise RuntimeError("reference record does not have the required status")
+
+    report = (
+        f"- Stable ID: {record['id']}\n"
+        f"- Status: {record['status']}\n"
+        f"- Location/date: {record['location']} | {record['date']}\n"
+    )
+    (ROOT / "subscription-resolution.md").write_text(report, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

 // BuildArchitecture reads the protected requirement, inventory, and
 // compatibility inputs and returns the completed architecture as JSON.
 func BuildArchitecture(requirementsPath, inventoryPath, compatibilityPath string) ([]byte, error) {
-	return nil, errors.New("BuildArchitecture not implemented")
+	var requirements inputRequirements
+	if err := decodeFile(requirementsPath, &requirements); err != nil {
+		return nil, err
+	}
+	var inventory inputInventory
+	if err := decodeFile(inventoryPath, &inventory); err != nil {
+		return nil, err
+	}
+	var compatibility inputCompatibility
+	if err := decodeFile(compatibilityPath, &compatibility); err != nil {
+		return nil, err
+	}
+	if requirements.TargetBundle != compatibility.TargetBundle {
+		return nil, fmt.Errorf("requirements target %q differs from compatibility target %q", requirements.TargetBundle, compatibility.TargetBundle)
+	}
+
+	hosts := make([]any, requirements.ManagementDomain.MinimumHostCount)
+	for i := range hosts {
+		hosts[i] = map[string]any{"hostname": fmt.Sprintf("%s-esx%02d", requirements.Site.Code, i+1)}
+	}
+	networks := make([]any, 0, len(requirements.Networks))
+	for _, network := range requirements.Networks {
+		networks = append(networks, map[string]any{
+			"networkType": network.Type,
+			"vlanId":      network.VlanID,
+			"subnet":      network.Subnet,
+			"gateway":     network.Gateway,
+			"subnetMask":  network.SubnetMask,
+			"mtu":         network.MTU,
+			"includeIpAddressRanges": []any{map[string]any{
+				"startIpAddress": network.StartIP,
+				"endIpAddress":   network.EndIP,
+			}},
+		})
+	}
+	nsxManagers := make([]any, 0, len(requirements.Appliances.NsxManagerFqdns))
+	for _, hostname := range requirements.Appliances.NsxManagerFqdns {
+		nsxManagers = append(nsxManagers, map[string]any{"hostname": hostname})
+	}
+	operationsNodes := make([]any, 0, len(requirements.Appliances.OperationsNodeFqdns))
+	for i, hostname := range requirements.Appliances.OperationsNodeFqdns {
+		nodeType := "replica"
+		if i == 0 {
+			nodeType = "master"
+		}
+		operationsNodes = append(operationsNodes, map[string]any{"hostname": hostname, "type": nodeType})
+	}
+
+	sddc := map[string]any{
+		"sddcId":                      inventory.DestinationSddcID,
+		"workflowType":                "VCF",
+		"version":                     requirements.TargetBundle,
+		"vcfInstanceName":             requirements.Site.VCFInstanceName,
+		"managementPoolName":          requirements.Site.ManagementPoolName,
+		"hostSpecs":                   hosts,
+		"ceipEnabled":                 false,
+		"skipEsxThumbprintValidation": false,
+		"skipGatewayPingValidation":   false,
+		"vcenterSpec": map[string]any{
+			"vcenterHostname":       requirements.Appliances.VcenterFqdn,
+			"rootVcenterPassword":   "CHANGE_ME_Vc!91",
+			"vmSize":                "medium",
+			"storageSize":           "lstorage",
+			"ssoDomain":             "vsphere.local",
+			"version":               "9.1.0.0",
+			"useExistingDeployment": false,
+		},
+		"clusterSpec": map[string]any{
+			"datacenterName": requirements.Site.Code + "-dc01",
+			"clusterName":    requirements.Site.Code + "-mgmt-cl01",
+		},
+		"dvsSpecs": []any{map[string]any{
+			"dvsName":  requirements.Site.Code + "-mgmt-vds",
+			"networks": []any{"MANAGEMENT", "VMOTION", "VSAN"},
+			"mtu":      9000,
+			"vmnicsToUplinks": []any{
+				map[string]any{"id": "vmnic0", "uplink": "uplink1"},
+				map[string]any{"id": "vmnic1", "uplink": "uplink2"},
+			},
+		}},
+		"networkSpecs": networks,
+		"dnsSpec": map[string]any{
+			"subdomain":   requirements.Site.DNSSubdomain,
+			"nameservers": requirements.Site.DNSServers,
+		},
+		"ntpServers": requirements.Site.NTPServers,
+		"sddcManagerSpec": map[string]any{
+			"hostname":              requirements.Appliances.SddcManagerFqdn,
+			"version":               "9.1.0.0",
+			"useExistingDeployment": false,
+		},
+		"nsxtSpec": map[string]any{
+			"nsxtManagers":          nsxManagers,
+			"nsxtManagerSize":       "medium",
+			"vipFqdn":               requirements.Appliances.NsxVipFqdn,
+			"transportVlanId":       requirements.NsxTransport.VlanID,
+			"version":               "9.1.0.0",
+			"useExistingDeployment": false,
+			"ipAddressPoolSpec": map[string]any{
+				"name": requirements.NsxTransport.PoolName,
+				"subnets": []any{map[string]any{
+					"cidr":    requirements.NsxTransport.CIDR,
+					"gateway": requirements.NsxTransport.Gateway,
+					"ipAddressPoolRanges": []any{map[string]any{
+						"start": requirements.NsxTransport.StartIP,
+						"end":   requirements.NsxTransport.EndIP,
+					}},
+				}},
+			},
+		},
+		"securitySpec": map[string]any{"esxiCertsMode": "VMCA"},
+		"datastoreSpec": map[string]any{
+			"vsanSpec": map[string]any{
+				"datastoreName":      requirements.Site.Code + "-mgmt-vsan",
+				"vsanDedup":          false,
+				"esaConfig":          map[string]any{"enabled": true},
+				"failuresToTolerate": requirements.ManagementDomain.HostFailureTolerance,

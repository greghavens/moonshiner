+package architecture
+
+import (
+	"encoding/json"
+	"path/filepath"
+	"testing"
+)
+
+func TestBuildArchitecture(t *testing.T) {
+	tests := []struct {
+		name              string
+		requirementsPath  string
+		inventoryPath     string
+		compatibilityPath string
+		wantError         bool
+	}{
+		{
+			name:              "protected fixtures",
+			requirementsPath:  "fixtures/design_requirements.json",
+			inventoryPath:     "fixtures/estate_inventory.json",
+			compatibilityPath: "fixtures/compatibility_snapshot.json",
+		},
+		{
+			name:              "missing requirements",
+			requirementsPath:  filepath.Join(t.TempDir(), "missing.json"),
+			inventoryPath:     "fixtures/estate_inventory.json",
+			compatibilityPath: "fixtures/compatibility_snapshot.json",
+			wantError:         true,
+		},
+		{
+			name:              "missing inventory",
+			requirementsPath:  "fixtures/design_requirements.json",
+			inventoryPath:     filepath.Join(t.TempDir(), "missing.json"),
+			compatibilityPath: "fixtures/compatibility_snapshot.json",
+			wantError:         true,
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := BuildArchitecture(tc.requirementsPath, tc.inventoryPath, tc.compatibilityPath)
+			if tc.wantError {
+				if err == nil {
+					t.Fatal("expected error")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("BuildArchitecture: %v", err)
+			}
+			var document map[string]any
+			if err := json.Unmarshal(got, &document); err != nil {
+				t.Fatalf("returned invalid JSON: %v", err)
+			}
+			for _, key := range []string{"sddcSpec", "migrationPlan", "researchSources"} {
+				if _, ok := document[key]; !ok {
+					t.Errorf("missing top-level %s", key)
+				}
+			}
+		})
+	}
+}

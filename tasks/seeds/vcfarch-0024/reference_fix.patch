+			"version":               "9.1.0.0",
+			"useExistingDeployment": false,
+		},
+		"vcfManagementComponentsInfrastructureSpec": map[string]any{
+			"localRegionNetwork": requirements.ManagementServicesNetworks.LocalRegion,
+			"xRegionNetwork":     requirements.ManagementServicesNetworks.XRegion,
+		},
+		"licenseServerSpec": map[string]any{
+			"hostname":              requirements.Appliances.LicenseServerFqdn,
+			"version":               "9.1.0.0",
+			"useExistingDeployment": false,
+		},
+	}
+
+	components := make(map[string]struct{ name, version, build string }, len(inventory.Components))
+	for _, component := range inventory.Components {
+		components[component.ID] = struct{ name, version, build string }{component.Name, component.Version, component.Build}
+	}
+	transitions := make(map[string]struct {
+		name, version, build, action string
+		gates                        []string
+	}, len(compatibility.Transitions))
+	for _, transition := range compatibility.Transitions {
+		transitions[transition.ComponentID] = struct {
+			name, version, build, action string
+			gates                        []string
+		}{transition.TargetName, transition.TargetVersion, transition.TargetBuild, transition.RequiredAction, transition.RequiredGates}
+	}
+	steps := make([]any, 0, len(compatibility.MigrationOrder))
+	for i, id := range compatibility.MigrationOrder {
+		source, sourceOK := components[id]
+		target, targetOK := transitions[id]
+		if !sourceOK || !targetOK {
+			return nil, fmt.Errorf("migration component %q is not defined by both inputs", id)
+		}
+		steps = append(steps, map[string]any{
+			"order":         i + 1,
+			"componentId":   id,
+			"componentName": source.name,
+			"fromVersion":   source.version,
+			"fromBuild":     source.build,
+			"targetName":    target.name,
+			"targetVersion": target.version,
+			"targetBuild":   target.build,
+			"action":        target.action,
+			"gates":         target.gates,
+		})
+	}
+
+	artifact := map[string]any{
+		"sddcSpec": sddc,
+		"migrationPlan": map[string]any{
+			"estateId":          inventory.EstateID,
+			"destinationSddcId": inventory.DestinationSddcID,
+			"targetBundle":      compatibility.TargetBundle,
+			"strategy":          "parallel-greenfield",
+			"steps":             steps,
+		},
+		"researchSources": []any{
+			map[string]any{
+				"title":        "Upgrade Sequence and Related Issues for VMware Cloud Foundation and vSphere Foundation 9.1",
+				"url":          "https://knowledge.broadcom.com/external/article/440630/upgrade-sequence-and-related-issues-for.html",
+				"consultedFor": []any{"9.1 component sequence", "management services and license server prerequisites"},
+			},
+			map[string]any{
+				"title":        "Upgrade failure for vCenter 8.0 U3j, ESXi 8.0 U3j, and NSX 4.2.4 due to back-in-time restriction",
+				"url":          "https://knowledge.broadcom.com/external/article/448135/upgrade-failure-for-vcenter-80-u3j-esxi.html",
+				"consultedFor": []any{"back-in-time restriction", "absence of a direct in-place path"},
+			},
+			map[string]any{
+				"title":        "Product Interoperability Matrix",
+				"url":          "https://interopmatrix.broadcom.com/Interoperability",
+				"consultedFor": []any{"supported product combinations", "upgrade-path cross-check"},
+			},
+		},
+	}
+	return json.MarshalIndent(artifact, "", "  ")
+}
+
+func decodeFile(path string, out any) error {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return fmt.Errorf("read %s: %w", path, err)
+	}
+	if err := json.Unmarshal(b, out); err != nil {
+		return fmt.Errorf("decode %s: %w", path, err)
+	}
+	return nil
 }

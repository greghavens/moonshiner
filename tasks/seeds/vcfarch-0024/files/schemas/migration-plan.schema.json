{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch-0024:migration-plan",
  "title": "VCF 9.1 estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "estateId",
    "destinationSddcId",
    "targetBundle",
    "strategy",
    "steps"
  ],
  "properties": {
    "estateId": {"type": "string", "minLength": 1},
    "destinationSddcId": {"type": "string", "minLength": 1},
    "targetBundle": {"type": "string", "minLength": 1},
    "strategy": {"const": "parallel-greenfield"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "componentId",
          "componentName",
          "fromVersion",
          "fromBuild",
          "targetName",
          "targetVersion",
          "targetBuild",
          "action",
          "gates"
        ],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "componentId": {"type": "string", "minLength": 1},
          "componentName": {"type": "string", "minLength": 1},
          "fromVersion": {"type": "string", "minLength": 1},
          "fromBuild": {"type": "string", "minLength": 1},
          "targetName": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "targetBuild": {"type": "string", "minLength": 1},
          "action": {
            "type": "string",
            "enum": ["upgrade", "deploy", "replace", "retain", "retire"]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}

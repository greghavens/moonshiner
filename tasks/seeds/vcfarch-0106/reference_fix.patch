+
+    $sdkNetworks = @($design.networks | ForEach-Object {
+        Initialize-VcfInstallerSddcNetworkSpec `
+            -NetworkType $_.networkType `
+            -VlanId ([int]$_.vlanId)
+    })
+    $sdkDns = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $design.dnsSubdomain `
+        -Nameservers ([string[]]$design.dnsServers)
+
+    $sdkHosts = @($hosts | ForEach-Object {
+        $arguments = @{
+            Hostname = $_.hostname
+        }
+        if ($_.ContainsKey('sshThumbprint')) {
+            $arguments.SshThumbprint = $_.sshThumbprint
+        }
+        if ($_.ContainsKey('sslThumbprint')) {
+            $arguments.SslThumbprint = $_.sslThumbprint
+        }
+        Initialize-VcfInstallerSddcHostSpec @arguments
+    })
+
+    $sdkNsxManagers = @($nsx.managerFqdns | ForEach-Object {
+        Initialize-VcfInstallerNsxtManagerSpec -Hostname $_
+    })
+    $sdkNsx = Initialize-VcfInstallerSddcNsxtSpec `
+        -NsxtManagers $sdkNsxManagers `
+        -VipFqdn $nsx.fqdn `
+        -Version $Snapshot.componentTargets.nsx.targetVersion `
+        -UseExistingDeployment $true `
+        -SslThumbprint $nsx.sslThumbprint `

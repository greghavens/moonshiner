+        -SkipEsxThumbprintValidation $false `
+        -SkipGatewayPingValidation $false `
+        -DatastoreSpec $sdkDatastore `
+        -FleetLcmSpec $sdkFleetLcm `
+        -SddcLcmSpec $sdkSddcLcm `
+        -FleetDepotSpec $sdkDepot `
+        -VcfInstanceName $design.vcfInstanceName
+
+    # Serialize only API fields that were intentionally populated. The SDK

+    return [ordered]@{
+        sddcId = $sdkSpec.SddcId
+        workflowType = $sdkSpec.WorkflowType
+        hostSpecs = @($sdkSpec.HostSpecs | ForEach-Object {
+            $item = [ordered]@{ hostname = $_.Hostname }
+            if ($_.SshThumbprint) { $item.sshThumbprint = $_.SshThumbprint }
+            if ($_.SslThumbprint) { $item.sslThumbprint = $_.SslThumbprint }
+            $item
+        })
+        version = $sdkSpec.Version
+        vcenterSpec = [ordered]@{
+            vcenterHostname = $sdkSpec.VcenterSpec.VcenterHostname
+            rootVcenterPassword = $sdkSpec.VcenterSpec.RootVcenterPassword
+            version = $sdkSpec.VcenterSpec.Version
+            useExistingDeployment = $sdkSpec.VcenterSpec.UseExistingDeployment
+            sslThumbprint = $sdkSpec.VcenterSpec.SslThumbprint
+        }
+        clusterSpec = [ordered]@{
+            datacenterName = $sdkSpec.ClusterSpec.DatacenterName
+            clusterName = $sdkSpec.ClusterSpec.ClusterName
+        }
+        nsxtSpec = [ordered]@{
+            nsxtManagers = @($sdkSpec.NsxtSpec.NsxtManagers | ForEach-Object {
+                [ordered]@{ hostname = $_.Hostname }
+            })
+            vipFqdn = $sdkSpec.NsxtSpec.VipFqdn
+            skipNsxOverlayOverManagementNetwork = $sdkSpec.NsxtSpec.SkipNsxOverlayOverManagementNetwork
+            enableEdgeClusterSync = $sdkSpec.NsxtSpec.EnableEdgeClusterSync
+            version = $sdkSpec.NsxtSpec.Version
+            useExistingDeployment = $sdkSpec.NsxtSpec.UseExistingDeployment
+            sslThumbprint = $sdkSpec.NsxtSpec.SslThumbprint
+        }
+        networkSpecs = @($sdkSpec.NetworkSpecs | ForEach-Object {
+            [ordered]@{
+                networkType = $_.NetworkType
+                vlanId = $_.VlanId
+            }
+        })
+        dnsSpec = [ordered]@{
+            subdomain = $sdkSpec.DnsSpec.Subdomain
+            nameservers = @($sdkSpec.DnsSpec.Nameservers)
+        }
+        ntpServers = @($sdkSpec.NtpServers)
+        sddcManagerSpec = [ordered]@{
+            hostname = $sdkSpec.SddcManagerSpec.Hostname
+            version = $sdkSpec.SddcManagerSpec.Version
+            useExistingDeployment = $sdkSpec.SddcManagerSpec.UseExistingDeployment
+        }
+        skipEsxThumbprintValidation = $sdkSpec.SkipEsxThumbprintValidation
+        skipGatewayPingValidation = $sdkSpec.SkipGatewayPingValidation
+        datastoreSpec = [ordered]@{
+            existingDatastoreName = $sdkSpec.DatastoreSpec.ExistingDatastoreName
+        }
+        fleetLcmSpec = [ordered]@{ version = $sdkSpec.FleetLcmSpec.Version }
+        sddcLcmSpec = [ordered]@{ version = $sdkSpec.SddcLcmSpec.Version }
+        fleetDepotSpec = [ordered]@{ version = $sdkSpec.FleetDepotSpec.Version }
+        vcfInstanceName = $sdkSpec.VcfInstanceName
+    }
+}

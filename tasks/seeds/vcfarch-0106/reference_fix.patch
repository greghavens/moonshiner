+function Read-JsonHashtable {
+    param([Parameter(Mandatory)][string] $Path)
+
+    $resolved = (Resolve-Path -LiteralPath $Path -ErrorAction Stop).Path
+    return Get-Content -LiteralPath $resolved -Raw | ConvertFrom-Json -AsHashtable
+}
+
+function Get-InventoryComponents {
+    param(
+        [Parameter(Mandatory)][hashtable] $Inventory,
+        [string] $Site,
+        [string[]] $Type
+    )
+
+    return @($Inventory.components | Where-Object {
+        (-not $Site -or $_.site -eq $Site) -and
+        (-not $Type -or $_.type -in $Type)
+    })
+}
+
+function New-TargetSddcSpec {

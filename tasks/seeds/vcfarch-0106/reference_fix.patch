+        -ExistingDatastoreName $design.existingDatastoreName
+    $sdkManager = Initialize-VcfInstallerSddcManagerSpec `
+        -Hostname $design.sddcManagerHostname `
+        -Version $Inventory.targetVcfVersion `
+        -UseExistingDeployment $false
+    $sdkFleetLcm = Initialize-VcfInstallerFleetLcmServiceSpec -Version $Inventory.targetVcfVersion
+    $sdkSddcLcm = Initialize-VcfInstallerSddcLcmServiceSpec -Version $Inventory.targetVcfVersion
+    $sdkDepot = Initialize-VcfInstallerFleetDepotServiceSpec -Version $Inventory.targetVcfVersion
+
+    $sdkSpec = Initialize-VcfInstallerSddcSpec `
+        -SddcId $design.sddcId `
+        -WorkflowType 'VCF' `
+        -HostSpecs $sdkHosts `
+        -Version $Inventory.targetVcfVersion `
+        -VcenterSpec $sdkVcenter `
+        -ClusterSpec $sdkCluster `

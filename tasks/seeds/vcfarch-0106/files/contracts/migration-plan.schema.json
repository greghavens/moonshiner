{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch-0106:migration-plan:1.0",
  "title": "VCF brownfield fleet migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "estateId",
    "targetVcfVersion",
    "generatedBy",
    "targetSddcSpec",
    "components",
    "steps"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "targetVcfVersion": {"type": "string", "minLength": 1},
    "generatedBy": {"const": "VcfFleetArchitecture/New-VcfFleetMigrationPlan"},
    "targetSddcSpec": {"type": "object"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "site",
        "currentVersion",
        "targetProduct",
        "targetVersion",
        "disposition",
        "changeStep",
        "gatedBy"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {
          "enum": [
            "vcenter",
            "esxi",
            "vsan",
            "nsx",
            "live-site-recovery",
            "vsphere-replication"
          ]
        },
        "site": {"enum": ["protected", "recovery"]},
        "currentVersion": {"type": "string", "minLength": 1},
        "targetProduct": {"type": "string", "minLength": 1},
        "targetVersion": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["upgrade", "replace"]},
        "changeStep": {"type": "string", "minLength": 1},
        "gatedBy": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "id",
        "phase",
        "action",
        "componentIds",
        "requires",
        "ruleIds",
        "exitCriteria"
      ],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "id": {"type": "string", "minLength": 1},
        "phase": {"enum": ["assess", "transition-recovery", "onboard", "upgrade", "restore"]},
        "action": {"enum": ["validate", "quiesce", "unregister", "remove", "import", "upgrade", "deploy", "configure", "verify"]},
        "componentIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "targetVersion": {"type": "string", "minLength": 1},
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "ruleIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "exitCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

+    /** Builds a JSON object body, dropping every field whose value the caller left unset. */
+    private static final class JsonObject {
+        private final StringBuilder text = new StringBuilder("{");
+
+        JsonObject put(String name, String value) {
+            return value == null || value.isEmpty()
+                    ? this : raw(name, "\"" + Json.escape(value) + "\"");
+        }
+
+        JsonObject put(String name, Number value) {
+            return value == null ? this : raw(name, String.valueOf(value));
+        }
+
+        JsonObject put(String name, Boolean value) {
+            return value == null ? this : raw(name, String.valueOf(value));
+        }
+
+        JsonObject putMap(String name, Map<String, String> value) {
+            if (value == null || value.isEmpty()) {
+                return this;
+            }
+            JsonObject nested = new JsonObject();
+            value.forEach((key, item) -> nested.put(key, item));
+            return raw(name, nested.build());
+        }
+
+        JsonObject putRaw(String name, String json) {
+            return json == null ? this : raw(name, json);
+        }
+
+        private JsonObject raw(String name, String json) {
+            if (text.length() > 1) {
+                text.append(',');
+            }
+            text.append('"').append(Json.escape(name)).append("\":").append(json);
+            return this;
+        }
+
+        String build() {
+            return text + "}";
+        }
+    }
+
+    /** Builds a query string, dropping every optional parameter the caller left unset. */
+    private static final class Query {
+        private final StringBuilder text = new StringBuilder();
+
+        Query add(String name, String value) {
+            if (value == null || value.isEmpty()) {
+                return this;
+            }
+            if (text.length() > 0) {
+                text.append('&');
+            }
+            text.append(URLEncoder.encode(name, StandardCharsets.UTF_8))
+                    .append('=')
+                    .append(URLEncoder.encode(value, StandardCharsets.UTF_8));
+            return this;
+        }
+
+        Query add(String name, Boolean value) {
+            return value == null ? this : add(name, String.valueOf(value));
+        }
+
+        String build() {
+            return text.length() == 0 ? "" : "?" + text;
+        }

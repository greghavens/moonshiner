+    /** Issues a bodyless GET and returns the JSON object it answered with. */
+    private Map<String, Object> getJsonObject(String accessToken, String path, String operationId)
+            throws IOException, InterruptedException {
+        HttpResponse<String> response = send(requestTo(path)
+                .header("Authorization", "Bearer " + accessToken)
+                .GET()
+                .build());
+        requireStatus(response, 200, operationId);
+        return asObject(response.body(), operationId);
+    }
+
+    @SuppressWarnings("unchecked")
+    private static Map<String, Object> asObject(String body, String operationId) throws IOException {
+        Object parsed = Json.parse(body);
+        if (!(parsed instanceof Map)) {
+            throw new IOException(operationId + " did not return a JSON object");
+        }
+        return (Map<String, Object>) parsed;
+    }
+
+    private static void requireStatus(HttpResponse<String> response, int expected, String operationId)
+            throws ApiFailure {
+        if (response.statusCode() != expected) {
+            throw new ApiFailure(operationId + " was rejected with HTTP " + response.statusCode()
+                    + ": " + response.body());
+        }
+    }

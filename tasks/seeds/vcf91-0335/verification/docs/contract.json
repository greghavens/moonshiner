{
  "contract_version": 1,
  "source": {
    "kind": "reference-documentation",
    "is_published_specification": false,
    "statement": "This contract is NOT derived from a published API specification. VCF Automation ships no machine-readable OpenAPI document in the Apache-2.0 vmware/vcf-api-specs repository, so every operation below was transcribed by hand from the Broadcom xAPIs reference pages recorded in docs/official_sources.json. Treat it as reference documentation: the field lists are exactly as complete as those pages were on the recorded fetch date, and anything absent here was not documented rather than known to be absent from the product.",
    "portal": "https://developer.broadcom.com/xapis",
    "product": "VMware Cloud Foundation Automation",
    "product_version": "9.1",
    "specification_repository_checked": "https://github.com/vmware/vcf-api-specs",
    "specification_repository_publishes_vcf_automation": false,
    "transcribed_on": "2026-08-11",
    "provenance": "docs/official_sources.json"
  },
  "security": {
    "access_token": {
      "obtained_by": "exchangeRefreshToken",
      "header": "Authorization",
      "value_prefix": "Bearer ",
      "documented_scheme_labels": [
        "bearerAuth",
        "Authorization"
      ]
    },
    "unauthenticated_operations": [
      "exchangeRefreshToken"
    ]
  },
  "wire_rules": {
    "optional_field_omission": "An optional request field whose value is unset must be omitted from the request entirely. It must never be sent as null, as an empty string, as an empty array, as an empty object, or as an invented default. This applies to nested objects (a zoneAssignmentConfigurations element omits the limits that were not supplied) and to optional query parameters (an unset optional query parameter contributes no key to the query string, and an operation with no query parameters is sent with no query string at all).",
    "field_order": "JSON request bodies serialize their fields in the order given by each operation's wire_field_order below, which is the order the reference page lists them in.",
    "json_content_type": "application/json",
    "no_body_operations": "GET operations carry no request body and no Content-Type header.",
    "numeric_fields": "Fields documented as integer are serialized as JSON numbers, never as quoted strings."
  },
  "polling": {
    "interval_millis": 200,
    "max_attempts": 25,
    "stop_on_terminal": "Polling stops on the first response carrying a terminal status; no further poll may be issued after a terminal status is observed.",
    "deployment_terminal_statuses": [
      "CREATE_SUCCESSFUL",
      "CREATE_FAILED",
      "UPDATE_SUCCESSFUL",
      "UPDATE_FAILED",
      "DELETE_SUCCESSFUL",
      "DELETE_FAILED"
    ],
    "request_terminal_statuses": [
      "SUCCESSFUL",
      "FAILED",
      "ABORTED",
      "APPROVAL_REJECTED"
    ],
    "request_failure_note": "A day-2 request that fails does so with HTTP 200 and status FAILED; the human-readable cause is carried in the Request.details field. HTTP status alone never establishes that a requested change succeeded."
  },
  "operations": [
    {
      "operationId": "exchangeRefreshToken",
      "method": "POST",
      "path": "/tm/oauth/tenant/{tenant}/token",
      "authentication": "none",
      "parameters": [
        {
          "name": "tenant",
          "in": "path",
          "required": true,
          "type": "string"
        }
      ],
      "request": {
        "required": true,
        "content_type": "application/x-www-form-urlencoded",
        "accept": "application/json",
        "wire_field_order": [
          "grant_type",
          "refresh_token"
        ],
        "fields": {
          "grant_type": {
            "type": "string",
            "required": true,
            "constant": "refresh_token"
          },
          "refresh_token": {
            "type": "string",
            "required": true,
            "description": "The API (Refresh) Token issued to the tenant user."
          }
        }
      },
      "success": {
        "status": 200,
        "properties": {
          "access_token": "string",
          "token_type": "string",
          "expires_in": "integer"
        }
      }
    },
    {
      "operationId": "createProject",
      "method": "POST",
      "path": "/iaas/api/projects",
      "authentication": "Authorization",
      "parameters": [
        {
          "name": "apiVersion",
          "in": "query",
          "required": false,
          "type": "string",
          "format": "yyyy-MM-dd",
          "description": "Sent verbatim when the caller supplies one; this contract records no default because the reference page defers to /iaas/api/about for valid values."
        },
        {
          "name": "validatePrincipals",
          "in": "query",
          "required": false,
          "type": "boolean"
        }
      ],
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "ProjectSpecification",
        "wire_field_order": [
          "name",
          "description",
          "administrators",
          "members",
          "viewers",
          "supervisors",
          "zoneAssignmentConfigurations",
          "constraints",
          "operationTimeout",
          "machineNamingTemplate",
          "sharedResources",
          "placementPolicy",
          "customProperties"
        ],
        "fields": {
          "name": {
            "type": "string",
            "required": true
          },
          "description": {
            "type": "string",
            "required": false
          },
          "administrators": {
            "type": "array",
            "required": false
          },
          "members": {
            "type": "array",
            "required": false
          },
          "viewers": {
            "type": "array",
            "required": false
          },
          "supervisors": {
            "type": "array",
            "required": false
          },
          "zoneAssignmentConfigurations": {
            "type": "array",
            "required": false,
            "items": {
              "type": "object",
              "wire_field_order": [
                "zoneId",
                "priority",
                "maxNumberInstances",
                "memoryLimitMB",
                "cpuLimit",
                "storageLimitGB"
              ],
              "fields": {
                "zoneId": {
                  "type": "string",
                  "required": false
                },
                "priority": {
                  "type": "integer",
                  "required": false
                },
                "maxNumberInstances": {
                  "type": "integer",
                  "required": false
                },
                "memoryLimitMB": {
                  "type": "integer",
                  "required": false
                },
                "cpuLimit": {
                  "type": "integer",
                  "required": false
                },
                "storageLimitGB": {
                  "type": "integer",
                  "required": false
                }
              }
            }
          },
          "constraints": {
            "type": "object",
            "required": false
          },
          "operationTimeout": {
            "type": "integer",
            "format": "int64",
            "units": "seconds",
            "required": false
          },
          "machineNamingTemplate": {
            "type": "string",
            "required": false
          },
          "sharedResources": {
            "type": "boolean",
            "required": false
          },
          "placementPolicy": {
            "type": "string",
            "required": false,
            "enum": [
              "DEFAULT",
              "SPREAD",
              "SPREAD_MEMORY"
            ]
          },
          "customProperties": {
            "type": "object",
            "required": false
          }
        }
      },
      "success": {
        "status": 201,
        "schema": "Project",
        "properties": {
          "id": "string",
          "name": "string",
          "orgId": "string",
          "operationTimeout": "integer",
          "zones": "array"
        }
      }
    },
    {

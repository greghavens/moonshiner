+++ b/drill/plan.go
@@ -0,0 +1,53 @@
+package drill
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+)
+
+// Plan is the restore drill input.
+type Plan struct {
+	Scope                string          `json:"scope,omitempty"`
+	CorrelationID        string          `json:"correlationId,omitempty"`
+	EncryptionPassphrase string          `json:"encryptionPassphrase,omitempty"`
+	Components           []PlanComponent `json:"components"`
+}
+
+// PlanComponent names one component to restore, in the order it is listed.
+type PlanComponent struct {
+	ComponentType string  `json:"componentType"`
+	Window        *Window `json:"window,omitempty"`
+}
+
+// Window narrows the backup catalogue lookup. Either side may be left out.
+type Window struct {
+	Start string `json:"start,omitempty"`
+	End   string `json:"end,omitempty"`
+}
+
+// LoadPlan reads and validates the drill plan.
+func LoadPlan(path string) (*Plan, error) {
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("read plan: %w", err)
+	}
+	var p Plan
+	if err := json.Unmarshal(raw, &p); err != nil {
+		return nil, fmt.Errorf("parse plan %s: %w", path, err)
+	}
+	if len(p.Components) == 0 {
+		return nil, fmt.Errorf("plan %s lists no components", path)
+	}
+	seen := map[string]bool{}
+	for i, c := range p.Components {
+		if c.ComponentType == "" {
+			return nil, fmt.Errorf("plan %s: components[%d] has no componentType", path, i)
+		}
+		if seen[c.ComponentType] {
+			return nil, fmt.Errorf("plan %s: componentType %q is listed twice", path, c.ComponentType)
+		}
+		seen[c.ComponentType] = true
+	}
+	return &p, nil
+}

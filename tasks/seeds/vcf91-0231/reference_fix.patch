diff --git a/cmd/vcf-restore-drill/main.go b/cmd/vcf-restore-drill/main.go
new file mode 100644
index 0000000..e568475
--- /dev/null
+++ b/cmd/vcf-restore-drill/main.go
@@ -0,0 +1,105 @@
+// Command vcf-restore-drill carries out a VCF 9.1 SDDC LCM restore drill and
+// writes a report describing what happened.
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"os"
+	"time"
+
+	"example.com/vcf/restoredrill/drill"
+)
+
+func main() {
+	os.Exit(run())
+}
+
+func run() int {
+	var (
+		planPath     = flag.String("plan", "", "path to the drill plan")
+		baseURL      = flag.String("base-url", "", "SDDC LCM service base URL")
+		token        = flag.String("token", "", "bearer token")
+		reportPath   = flag.String("report", "", "where to write the JSON report")
+		contractPath = flag.String("contract", "docs/contract.json", "path to the derived REST contract")
+		pollInterval = flag.Duration("poll-interval", 5*time.Second, "wait between task polls")
+		pollTimeout  = flag.Duration("poll-timeout", time.Hour, "how long a task may take to reach a terminal state")
+	)
+	flag.Parse()
+
+	for name, value := range map[string]string{
+		"-plan":     *planPath,
+		"-base-url": *baseURL,
+		"-token":    *token,
+		"-report":   *reportPath,
+	} {
+		if value == "" {
+			fmt.Fprintf(os.Stderr, "vcf-restore-drill: %s is required\n", name)
+			return 2
+		}
+	}
+
+	report, err := drill.Run(context.Background(), drill.Options{
+		PlanPath:     *planPath,
+		ContractPath: *contractPath,
+		BaseURL:      *baseURL,
+		Token:        *token,
+		PollInterval: *pollInterval,
+		PollTimeout:  *pollTimeout,
+	})
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "vcf-restore-drill: %v\n", err)
+		return 2
+	}
+
+	encoded, err := json.MarshalIndent(report, "", "  ")
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "vcf-restore-drill: encode report: %v\n", err)
+		return 2
+	}
+	if err := os.WriteFile(*reportPath, append(encoded, '\n'), 0o644); err != nil {
+		fmt.Fprintf(os.Stderr, "vcf-restore-drill: write report: %v\n", err)
+		return 2
+	}
+
+	summarize(report)
+	if report.Outcome != "succeeded" {
+		return 1
+	}
+	return 0
+}
+
+func summarize(report *drill.Report) {
+	fmt.Printf("restore drill %s\n", report.Outcome)
+	for _, c := range report.Components {
+		switch c.Outcome {
+		case "restored":
+			fmt.Printf("  %-12s restored from %s (task %s), now %s\n",
+				c.ComponentType, backupLabel(c), c.TaskID, c.PostRestoreStatus)
+		case "failed":
+			stage := c.Failure.FailedStage
+			if stage == "" {
+				stage = "no stage reported"
+			}
+			fmt.Printf("  %-12s failed %s at %s (task %s)\n",
+				c.ComponentType, c.TaskStatus, stage, c.TaskID)
+			for _, e := range c.Failure.Errors {
+				fmt.Printf("               %s: %s\n", e.ID, e.DefaultMessage)
+			}
+		default:
+			fmt.Printf("  %-12s skipped\n", c.ComponentType)
+		}
+	}
+}
+
+func backupLabel(c drill.ComponentReport) string {
+	if c.Backup == nil {
+		return "an unknown backup"
+	}
+	if c.Backup.Point != "" {
+		return c.Backup.Name + " point " + c.Backup.Point
+	}
+	return c.Backup.Name
+}

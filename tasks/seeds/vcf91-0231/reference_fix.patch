+++ b/drill/report.go
@@ -0,0 +1,41 @@
+package drill
+
+// Report is what the drill says happened. Components are listed in plan order.
+type Report struct {
+	Outcome    string            `json:"outcome"`
+	Scope      string            `json:"scope,omitempty"`
+	Components []ComponentReport `json:"components"`
+}
+
+// ComponentReport is the record for one planned component.
+type ComponentReport struct {
+	ComponentType     string         `json:"componentType"`
+	ComponentID       string         `json:"componentId"`
+	Version           string         `json:"version"`
+	Outcome           string         `json:"outcome"`
+	Backup            *BackupReport  `json:"backup,omitempty"`
+	TaskID            string         `json:"taskId,omitempty"`
+	TaskStatus        string         `json:"taskStatus,omitempty"`
+	PostRestoreStatus string         `json:"postRestoreStatus,omitempty"`
+	Failure           *FailureReport `json:"failure,omitempty"`
+}
+
+// BackupReport is the backup the drill restored from.
+type BackupReport struct {
+	Name  string `json:"name"`
+	Path  string `json:"path"`
+	Point string `json:"point,omitempty"`
+}
+
+// FailureReport explains a restore task that did not succeed.
+type FailureReport struct {
+	TaskID      string       `json:"taskId"`
+	FailedStage string       `json:"failedStage,omitempty"`
+	Errors      []ErrorEntry `json:"errors"`
+}
+
+// ErrorEntry is one ERROR level message the task carried.
+type ErrorEntry struct {
+	ID             string `json:"id"`
+	DefaultMessage string `json:"defaultMessage"`
+}

diff --git a/drill/client.go b/drill/client.go
new file mode 100644
index 0000000..25df3bb
--- /dev/null
+++ b/drill/client.go
@@ -0,0 +1,115 @@
+package drill
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"sort"
+	"strings"
+)
+
+type client struct {
+	base     string
+	token    string
+	contract *Contract
+	http     *http.Client
+}
+
+// call sends one contract operation. query carries the values the drill has for
+// the operation's query parameters and headers the values it has for the
+// operation's header parameters; entries with no value, and entries the
+// operation does not declare, are never sent.
+type call struct {
+	operationID string
+	pathArgs    map[string]string
+	query       map[string]string
+	headers     map[string]string
+	body        any
+	out         any
+}
+
+func (c *client) do(ctx context.Context, req call) error {
+	op, err := c.contract.Op(req.operationID)
+	if err != nil {
+		return err
+	}
+	path, err := op.ResolvePath(req.pathArgs)
+	if err != nil {
+		return fmt.Errorf("%s: %w", req.operationID, err)
+	}
+
+	values := url.Values{}
+	names := make([]string, 0, len(req.query))
+	for name := range req.query {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	for _, name := range names {
+		value := req.query[name]
+		if value == "" || !op.DeclaresQuery(name) {
+			continue
+		}
+		values.Set(name, value)
+	}
+	for _, name := range op.QueryParams.Required {
+		if values.Get(name) == "" {
+			return fmt.Errorf("%s: required query parameter %q has no value", req.operationID, name)
+		}
+	}
+
+	target := strings.TrimSuffix(c.base, "/") + path
+	if encoded := values.Encode(); encoded != "" {
+		target += "?" + encoded
+	}
+
+	var payload io.Reader
+	var raw []byte
+	if req.body != nil {
+		raw, err = json.Marshal(req.body)
+		if err != nil {
+			return fmt.Errorf("%s: encode body: %w", req.operationID, err)
+		}
+		payload = bytes.NewReader(raw)
+	}
+
+	httpReq, err := http.NewRequestWithContext(ctx, op.Method, target, payload)
+	if err != nil {
+		return fmt.Errorf("%s: %w", req.operationID, err)
+	}
+	httpReq.Header.Set("Authorization", c.contract.Security.HTTPScheme+" "+c.token)
+	httpReq.Header.Set("Accept", "application/json")
+	if raw != nil {
+		httpReq.Header.Set("Content-Type", "application/json")
+	}
+	for name, value := range req.headers {
+		if value == "" || !op.DeclaresHeader(name) {
+			continue
+		}
+		httpReq.Header.Set(name, value)
+	}
+
+	resp, err := c.http.Do(httpReq)
+	if err != nil {
+		return fmt.Errorf("%s: %w", req.operationID, err)
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return fmt.Errorf("%s: read response: %w", req.operationID, err)
+	}
+	if resp.StatusCode != op.SuccessStatus {
+		return fmt.Errorf("%s %s: got HTTP %d, the contract documents %d: %s",
+			op.Method, path, resp.StatusCode, op.SuccessStatus, strings.TrimSpace(string(body)))
+	}
+	if req.out == nil {
+		return nil
+	}
+	if err := json.Unmarshal(body, req.out); err != nil {
+		return fmt.Errorf("%s: decode response: %w", req.operationID, err)
+	}
+	return nil
+}
diff --git a/drill/contract.go b/drill/contract.go
new file mode 100644
index 0000000..e89657c
--- /dev/null
+++ b/drill/contract.go
@@ -0,0 +1,194 @@
+package drill
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"strings"
+)
+
+// Contract is the REST contract derived from the SDDC LCM OpenAPI
+// specification. Everything the drill needs to shape a request - method, path,
+// success status, where each parameter goes and which body fields are required
+// - is read from here at run time.
+type Contract struct {
+	Source     map[string]any        `json:"source"`
+	Server     string                `json:"server"`
+	Security   Security              `json:"security"`
+	Operations map[string]*Operation `json:"operations"`
+	Schemas    map[string]*FieldSet  `json:"schemas"`
+}
+
+// Security describes the single security scheme the specification defines.
+type Security struct {
+	Scheme       string `json:"scheme"`
+	Type         string `json:"type"`
+	HTTPScheme   string `json:"httpScheme"`
+	BearerFormat string `json:"bearerFormat"`
+}
+
+// Operation is one operation of the contract, keyed by its operationId.
+type Operation struct {
+	Method          string    `json:"method"`
+	Path            string    `json:"path"`
+	SuccessStatus   int       `json:"successStatus"`
+	RequestSchema   *string   `json:"requestSchema"`
+	ResponseSchema  string    `json:"responseSchema"`
+	PathParams      []string  `json:"pathParams"`
+	QueryParams     FieldSet  `json:"queryParams"`
+	OptionalHeaders []string  `json:"optionalHeaders"`
+	RequestVariants *Variants `json:"requestVariants"`
+}
+
+// FieldSet is a required/optional split, used for both query parameters and
+// request body schemas.
+type FieldSet struct {
+	Required []string `json:"required"`
+	Optional []string `json:"optional"`
+}
+
+// Variants describes a discriminated request body.
+type Variants struct {
+	Discriminator string   `json:"discriminator"`
+	Variants      []string `json:"variants"`
+}
+
+// LoadContract reads the derived contract from disk.
+func LoadContract(path string) (*Contract, error) {
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("read contract: %w", err)
+	}
+	var c Contract
+	if err := json.Unmarshal(raw, &c); err != nil {
+		return nil, fmt.Errorf("parse contract %s: %w", path, err)
+	}
+	if c.Security.HTTPScheme == "" {
+		return nil, fmt.Errorf("contract %s: security.httpScheme is empty", path)
+	}
+	if len(c.Operations) == 0 {
+		return nil, fmt.Errorf("contract %s: no operations", path)
+	}
+	return &c, nil
+}
+
+// Op returns the operation the contract publishes under operationID.
+func (c *Contract) Op(operationID string) (*Operation, error) {
+	op, ok := c.Operations[operationID]
+	if !ok || op == nil {
+		return nil, fmt.Errorf("the contract does not describe operation %q", operationID)
+	}
+	return op, nil
+}
+
+// ResolvePath substitutes the operation's path parameters.
+func (o *Operation) ResolvePath(args map[string]string) (string, error) {
+	path := o.Path
+	for _, name := range o.PathParams {
+		value, ok := args[name]
+		if !ok || value == "" {
+			return "", fmt.Errorf("path parameter %q has no value", name)
+		}
+		placeholder := "{" + name + "}"
+		if !strings.Contains(path, placeholder) {
+			return "", fmt.Errorf("path %q has no placeholder for parameter %q", o.Path, name)
+		}
+		path = strings.ReplaceAll(path, placeholder, value)
+	}
+	if strings.Contains(path, "{") {
+		return "", fmt.Errorf("path %q still has unsubstituted parameters", path)
+	}
+	return path, nil
+}
+
+// DeclaresQuery reports whether the operation accepts the named query parameter.
+func (o *Operation) DeclaresQuery(name string) bool {
+	return contains(o.QueryParams.Required, name) || contains(o.QueryParams.Optional, name)
+}
+
+// DeclaresHeader reports whether the operation accepts the named header.
+func (o *Operation) DeclaresHeader(name string) bool {
+	for _, h := range o.OptionalHeaders {
+		if strings.EqualFold(h, name) {
+			return true
+		}
+	}
+	return false
+}
+
+// RequestSchemaFor picks the body schema to build against. For a discriminated
+// request the caller names the variant it intends to send.
+func (c *Contract) RequestSchemaFor(op *Operation, variant string) (string, error) {
+	if op.RequestVariants != nil {
+		if !contains(op.RequestVariants.Variants, variant) {
+			return "", fmt.Errorf("%q is not one of the request variants %v",
+				variant, op.RequestVariants.Variants)
+		}
+		return variant, nil
+	}
+	if op.RequestSchema == nil || *op.RequestSchema == "" {
+		return "", fmt.Errorf("the operation takes no request body")
+	}
+	return *op.RequestSchema, nil
+}
+
+// BuildBody assembles a request body from the values the drill has, dropping
+// every optional field it has no value for. A required field is always sent,
+// even when its value is false or zero; an unset optional field is left out
+// rather than sent empty.
+func (c *Contract) BuildBody(schemaName string, values map[string]any) (map[string]any, error) {
+	set, ok := c.Schemas[schemaName]
+	if !ok || set == nil {
+		return nil, fmt.Errorf("the contract publishes no schema %q", schemaName)
+	}
+	out := map[string]any{}
+	for name, value := range values {
+		switch {
+		case contains(set.Required, name):
+			if value == nil {
+				return nil, fmt.Errorf("schema %s requires field %q", schemaName, name)
+			}
+			out[name] = value
+		case contains(set.Optional, name):
+			if isUnset(value) {
+				continue
+			}
+			out[name] = value
+		default:
+			return nil, fmt.Errorf("schema %s has no field %q", schemaName, name)
+		}
+	}
+	for _, name := range set.Required {
+		if _, ok := out[name]; !ok {
+			return nil, fmt.Errorf("schema %s requires field %q", schemaName, name)
+		}
+	}
+	return out, nil
+}
+
+// isUnset reports whether an optional value carries nothing worth sending.
+// Booleans and numbers are always values, never absences.
+func isUnset(value any) bool {
+	switch v := value.(type) {
+	case nil:
+		return true
+	case string:
+		return v == ""
+	case []string:
+		return len(v) == 0
+	case []any:
+		return len(v) == 0
+	case map[string]any:
+		return len(v) == 0
+	}
+	return false
+}
+
+func contains(list []string, want string) bool {
+	for _, v := range list {
+		if v == want {
+			return true
+		}
+	}
+	return false
+}
diff --git a/drill/drill.go b/drill/drill.go
new file mode 100644
index 0000000..8549db5
--- /dev/null
+++ b/drill/drill.go
@@ -0,0 +1,414 @@
+// Package drill runs a VMware Cloud Foundation 9.1 SDDC LCM restore drill:
+// it reads the inventory, picks a backup for each planned component, restores
+// the components one at a time in plan order, polls every restore task to a
+// terminal state and reports what actually happened.
+package drill
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"sort"
+	"time"
+)
+
+// Operation ids this drill calls, as published by the SDDC LCM specification.
+const (
+	opGetComponents  = "getComponents"
+	opGetBackups     = "getComponentsBackups"
+	opRestoreAction  = "backupRestoreComponentsAction"
+	opGetTask        = "getTask"
+	opFetchStatuses  = "fetchComponentStatuses"
+	restoreVariant   = "ComponentsRestoreSpec"
+	correlationHdr   = "X-Correlation-Id"
+	statusesSchema   = "ComponentStatusesSpec"
+	restorePointItem = "RestoreBackupSpec"
+)
+
+// Options configures a drill run.
+type Options struct {
+	// PlanPath is the drill plan to carry out.
+	PlanPath string
+	// ContractPath is the derived REST contract.
+	ContractPath string
+	// BaseURL is the SDDC LCM service to drive.
+	BaseURL string
+	// Token is the bearer credential.
+	Token string
+	// PollInterval is the wait between task polls. Zero means five seconds.
+	PollInterval time.Duration
+	// PollTimeout bounds how long one task may take to reach a terminal
+	// state. Zero means one hour.
+	PollTimeout time.Duration
+	// HTTPClient is optional; nil means a default client.
+	HTTPClient *http.Client
+}
+
+var terminalStatuses = map[string]bool{
+	"SUCCEEDED": true,
+	"FAILED":    true,
+	"CANCELED":  true,
+}
+
+// Run carries out the drill. The returned error is non-nil only when the drill
+// could not be carried out at all: a restore that fails is a result, not an
+// error, and is described by the report.
+func Run(ctx context.Context, opts Options) (*Report, error) {
+	plan, err := LoadPlan(opts.PlanPath)
+	if err != nil {
+		return nil, err
+	}
+	contract, err := LoadContract(opts.ContractPath)
+	if err != nil {
+		return nil, err
+	}
+	if opts.BaseURL == "" {
+		return nil, fmt.Errorf("no base URL given")
+	}
+	if opts.PollInterval <= 0 {
+		opts.PollInterval = 5 * time.Second
+	}
+	if opts.PollTimeout <= 0 {
+		opts.PollTimeout = time.Hour
+	}
+	httpClient := opts.HTTPClient
+	if httpClient == nil {
+		httpClient = &http.Client{Timeout: 30 * time.Second}
+	}
+
+	r := &runner{
+		plan: plan,
+		opts: opts,
+		client: &client{
+			base:     opts.BaseURL,
+			token:    opts.Token,
+			contract: contract,
+			http:     httpClient,
+		},
+		contract: contract,
+	}
+	return r.run(ctx)
+}
+
+type runner struct {
+	plan     *Plan
+	opts     Options
+	client   *client
+	contract *Contract
+}
+
+type inventoryComponent struct {
+	ID            string `json:"id"`
+	ComponentType string `json:"componentType"`
+	Version       string `json:"version"`
+	Scope         string `json:"scope"`
+}
+
+type backupEntry struct {
+	Name          string   `json:"name"`
+	Path          string   `json:"path"`
+	Points        []string `json:"points"`
+	ComponentType string   `json:"componentType"`
+	ComponentID   string   `json:"componentId"`
+}
+
+type taskView struct {
+	ID       string          `json:"id"`
+	Status   string          `json:"status"`
+	Stages   []taskStage     `json:"stages"`
+	Messages []taskMessageIn `json:"messages"`
+}
+
+type taskStage struct {
+	Name     string          `json:"name"`
+	Status   string          `json:"status"`
+	Messages []taskMessageIn `json:"messages"`
+}
+
+type taskMessageIn struct {
+	Level   string `json:"level"`
+	Message struct {
+		ID             string `json:"id"`
+		DefaultMessage string `json:"defaultMessage"`
+	} `json:"message"`
+}
+
+func (r *runner) run(ctx context.Context) (*Report, error) {
+	inventory, err := r.fetchInventory(ctx)
+	if err != nil {
+		return nil, err
+	}
+
+	report := &Report{Outcome: "succeeded", Scope: r.plan.Scope}
+	for _, pc := range r.plan.Components {
+		found, ok := inventory[pc.ComponentType]
+		if !ok {
+			return nil, fmt.Errorf("component type %q is not in the inventory the service returned", pc.ComponentType)
+		}
+		report.Components = append(report.Components, ComponentReport{
+			ComponentType: pc.ComponentType,
+			ComponentID:   found.ID,
+			Version:       found.Version,
+			Outcome:       "skipped",
+		})
+	}
+
+	halted := false
+	var restored []int
+	for i, pc := range r.plan.Components {
+		if halted {
+			continue
+		}
+		entry := &report.Components[i]
+
+		backup, err := r.pickBackup(ctx, entry.ComponentID, pc)
+		if err != nil {
+			return nil, err
+		}
+		entry.Backup = backup
+
+		taskID, err := r.startRestore(ctx, entry, backup)
+		if err != nil {
+			return nil, err
+		}
+		entry.TaskID = taskID
+
+		task, err := r.pollTask(ctx, taskID)
+		if err != nil {
+			return nil, err
+		}
+		entry.TaskStatus = task.Status
+
+		if task.Status == "SUCCEEDED" {
+			entry.Outcome = "restored"
+			restored = append(restored, i)
+			continue
+		}
+		entry.Outcome = "failed"
+		entry.Failure = failureOf(task)
+		halted = true
+	}
+
+	if len(restored) > 0 {
+		if err := r.checkStatuses(ctx, report, restored); err != nil {
+			return nil, err
+		}
+	}
+
+	for _, c := range report.Components {
+		if c.Outcome != "restored" || c.PostRestoreStatus != "Running" {
+			report.Outcome = "failed"
+			break
+		}
+	}
+	return report, nil
+}
+
+func (r *runner) fetchInventory(ctx context.Context) (map[string]inventoryComponent, error) {
+	var payload struct {
+		Components []inventoryComponent `json:"components"`
+	}
+	err := r.client.do(ctx, call{
+		operationID: opGetComponents,
+		query:       map[string]string{"scope": r.plan.Scope},
+		out:         &payload,
+	})
+	if err != nil {
+		return nil, err
+	}
+	out := map[string]inventoryComponent{}
+	for _, c := range payload.Components {
+		if c.ID == "" || c.ComponentType == "" {
+			return nil, fmt.Errorf("the inventory returned a component with no id or type")
+		}
+		out[c.ComponentType] = c
+	}
+	return out, nil
+}
+
+// pickBackup lists the catalogue for one component, narrowed by the plan's
+// window when it has one, and chooses the newest backup and its newest restore
+// point. Backup names and restore points are ordered timestamps, so the
+// lexicographically greatest is the most recent.
+func (r *runner) pickBackup(ctx context.Context, componentID string, pc PlanComponent) (*BackupReport, error) {
+	query := map[string]string{"componentId": componentID}
+	if pc.Window != nil {
+		query["periodStart"] = pc.Window.Start
+		query["periodEnd"] = pc.Window.End
+	}
+
+	var payload struct {
+		Backups []backupEntry `json:"backups"`
+	}
+	err := r.client.do(ctx, call{
+		operationID: opGetBackups,
+		query:       query,
+		out:         &payload,
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	var candidates []backupEntry
+	for _, b := range payload.Backups {
+		if b.ComponentID == componentID {
+			candidates = append(candidates, b)
+		}
+	}
+	if len(candidates) == 0 {
+		return nil, fmt.Errorf("no backup of %s is in the catalogue for the requested window", pc.ComponentType)
+	}
+	sort.Slice(candidates, func(i, j int) bool { return candidates[i].Name > candidates[j].Name })
+	chosen := candidates[0]
+	if chosen.Path == "" {
+		return nil, fmt.Errorf("backup %q of %s has no path", chosen.Name, pc.ComponentType)
+	}
+
+	out := &BackupReport{Name: chosen.Name, Path: chosen.Path}
+	if len(chosen.Points) > 0 {
+		points := append([]string(nil), chosen.Points...)
+		sort.Sort(sort.Reverse(sort.StringSlice(points)))
+		out.Point = points[0]
+	}
+	return out, nil
+}
+
+func (r *runner) startRestore(ctx context.Context, entry *ComponentReport, backup *BackupReport) (string, error) {
+	op, err := r.contract.Op(opRestoreAction)
+	if err != nil {
+		return "", err
+	}
+	schema, err := r.contract.RequestSchemaFor(op, restoreVariant)
+	if err != nil {
+		return "", err
+	}
+
+	item, err := r.contract.BuildBody(restorePointItem, map[string]any{
+		"componentId":   entry.ComponentID,
+		"componentType": entry.ComponentType,
+		"path":          backup.Path,
+		"point":         backup.Point,
+	})
+	if err != nil {
+		return "", err
+	}
+	body, err := r.contract.BuildBody(schema, map[string]any{
+		op.RequestVariants.Discriminator: restoreVariant,
+		"components":                     []any{item},
+		"encryptionPassphrase":           r.plan.EncryptionPassphrase,
+	})
+	if err != nil {
+		return "", err
+	}
+
+	var task taskView
+	err = r.client.do(ctx, call{
+		operationID: opRestoreAction,
+		headers:     map[string]string{correlationHdr: r.plan.CorrelationID},
+		body:        body,
+		out:         &task,
+	})
+	if err != nil {
+		return "", err
+	}
+	if task.ID == "" {
+		return "", fmt.Errorf("the restore of %s returned no task id", entry.ComponentType)
+	}
+	return task.ID, nil
+}
+
+// pollTask asks for the task until it reaches a terminal state. A task that is
+// still PENDING, SCHEDULED or RUNNING has not finished, whatever the response
+// to the request that raised it said.
+func (r *runner) pollTask(ctx context.Context, taskID string) (*taskView, error) {
+	deadline := time.Now().Add(r.opts.PollTimeout)
+	for {
+		var task taskView
+		err := r.client.do(ctx, call{
+			operationID: opGetTask,
+			pathArgs:    map[string]string{"taskId": taskID},
+			out:         &task,
+		})
+		if err != nil {
+			return nil, err
+		}
+		if task.Status == "" {
+			return nil, fmt.Errorf("task %s reported no status", taskID)
+		}
+		if terminalStatuses[task.Status] {
+			return &task, nil
+		}
+		if time.Now().After(deadline) {
+			return nil, fmt.Errorf("task %s was still %s after %s", taskID, task.Status, r.opts.PollTimeout)
+		}
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-time.After(r.opts.PollInterval):
+		}
+	}
+}
+
+func (r *runner) checkStatuses(ctx context.Context, report *Report, restored []int) error {
+	ids := make([]any, 0, len(restored))
+	for _, i := range restored {
+		ids = append(ids, report.Components[i].ComponentID)
+	}
+	body, err := r.contract.BuildBody(statusesSchema, map[string]any{"componentIds": ids})
+	if err != nil {
+		return err
+	}
+
+	var payload struct {
+		ComponentStatuses []struct {
+			ID     string `json:"id"`
+			Status string `json:"status"`
+		} `json:"componentStatuses"`
+	}
+	err = r.client.do(ctx, call{
+		operationID: opFetchStatuses,
+		body:        body,
+		out:         &payload,
+	})
+	if err != nil {
+		return err
+	}
+	byID := map[string]string{}
+	for _, s := range payload.ComponentStatuses {
+		byID[s.ID] = s.Status
+	}
+	for _, i := range restored {
+		entry := &report.Components[i]
+		status, ok := byID[entry.ComponentID]
+		if !ok {
+			return fmt.Errorf("the service reported no status for %s", entry.ComponentType)
+		}
+		entry.PostRestoreStatus = status
+	}
+	return nil
+}
+
+// failureOf reports the task exactly as it ended: the stage that failed and the
+// ERROR level messages that stage carried, or the task level ERROR messages
+// when no stage is marked failed.
+func failureOf(task *taskView) *FailureReport {
+	out := &FailureReport{TaskID: task.ID, Errors: []ErrorEntry{}}
+	for _, stage := range task.Stages {
+		if stage.Status != "FAILED" {
+			continue
+		}
+		out.FailedStage = stage.Name
+		for _, m := range stage.Messages {
+			if m.Level == "ERROR" {
+				out.Errors = append(out.Errors, ErrorEntry{ID: m.Message.ID, DefaultMessage: m.Message.DefaultMessage})
+			}
+		}
+		return out
+	}
+	for _, m := range task.Messages {
+		if m.Level == "ERROR" {
+			out.Errors = append(out.Errors, ErrorEntry{ID: m.Message.ID, DefaultMessage: m.Message.DefaultMessage})
+		}
+	}
+	return out
+}

+Set-StrictMode -Version Latest
+
+function Get-VcfEstateInventory {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $Server,
+
+        [Parameter(Mandatory)]
+        [pscredential] $Credential
+    )
+
+    Import-Module VMware.Sdk.Vcf.SddcManager -ErrorAction Stop
+    $connection = Connect-VcfSddcManagerServer -Server $Server -Credential $Credential
+    try {
+        $domains = @(Get-SddcDomain -Server $connection)
+        $vcenters = @(Get-SddcVcenter -Server $connection)
+        $domainInventory = foreach ($domain in $domains) {
+            $clusters = @(Get-SddcCluster -Domain $domain -Server $connection)
+            $hosts = @(Get-SddcHost -Domain $domain -Server $connection)
+            [ordered]@{
+                id       = [string] $domain.Id
+                name     = [string] $domain.Name
+                type     = [string] $domain.Type
+                clusters = @($clusters | ForEach-Object {
+                    [ordered]@{ id = [string] $_.Id; name = [string] $_.Name }
+                })
+                hosts    = @($hosts | ForEach-Object {
+                    [ordered]@{ id = [string] $_.Id; name = [string] $_.Name; status = [string] $_.Status }
+                })
+            }
+        }
+
+        [pscustomobject] [ordered]@{
+            collectedFrom = $Server
+            domains       = @($domainInventory)
+            vcenters      = @($vcenters | ForEach-Object {
+                [ordered]@{ id = [string] $_.Id; name = [string] $_.Name; version = [string] $_.Version }
+            })
+        }
+    }
+    finally {
+        Disconnect-VcfSddcManagerServer -Server $connection -Force -ErrorAction SilentlyContinue
+    }
+}
+
+function Get-SupportedHopPath {
+    param(
+        [Parameter(Mandatory)] $Snapshot,
+        [Parameter(Mandatory)] [string] $Source,
+        [Parameter(Mandatory)] [string] $Target
+    )
+
+    $queue = [System.Collections.Generic.Queue[object]]::new()
+    $queue.Enqueue([pscustomobject]@{ Node = $Source; Versions = @($Source) })
+    $visited = @{$Source = $true}
+
+    while ($queue.Count -gt 0) {
+        $item = $queue.Dequeue()
+        if ($item.Node -eq $Target) {
+            $result = [System.Collections.Generic.List[object]]::new()
+            for ($index = 0; $index -lt $item.Versions.Count - 1; $index++) {
+                $result.Add([pscustomobject] [ordered]@{
+                    from = [string] $item.Versions[$index]
+                    to   = [string] $item.Versions[$index + 1]
+                })
+            }
+            return @($result)
+        }
+
+        foreach ($hop in $Snapshot.supportedHops) {
+            if ($hop.from -eq $item.Node -and -not $visited.ContainsKey([string] $hop.to)) {
+                $visited[[string] $hop.to] = $true
+                $queue.Enqueue([pscustomobject]@{
+                    Node     = [string] $hop.to
+                    Versions = @($item.Versions) + @([string] $hop.to)
+                })
+            }
+        }
+    }
+
+    throw "No supported VCF upgrade path exists from $Source to $Target in snapshot $($Snapshot.snapshotId)."
+}
+
+function Get-EdgeFormFactor {
+    param(
+        [Parameter(Mandatory)] $Snapshot,
+        [Parameter(Mandatory)] [double] $ThroughputGbps
+    )
+
+    foreach ($tier in $Snapshot.edgeSizing) {
+        $minInclusive = $tier.PSObject.Properties['minInclusiveGbps']
+        $minExclusive = $tier.PSObject.Properties['minExclusiveGbps']
+        $maxInclusive = $tier.PSObject.Properties['maxInclusiveGbps']
+        if ($null -ne $minInclusive -and $ThroughputGbps -lt [double] $minInclusive.Value) { continue }
+        if ($null -ne $minExclusive -and $ThroughputGbps -le [double] $minExclusive.Value) { continue }
+        if ($null -ne $maxInclusive -and $ThroughputGbps -gt [double] $maxInclusive.Value) { continue }
+        return [string] $tier.formFactor
+    }
+    throw "No Edge form factor covers $ThroughputGbps Gbps."
+}
+
+function Get-GateDefinition {
+    param([Parameter(Mandatory)] [string] $GateId)
+
+    $conditions = @{
+        'source-health-clean' = 'All VCF-managed components report healthy before the first bundle is applied.'
+        'backups-complete' = 'File-based backups of SDDC Manager, vCenter, and NSX are restorable.'
+        'hcl-5.2.1-compatible' = 'Management and workload hosts are compatible with the VCF 5.2.1 BOM.'
+        'lcm-precheck-5.2.1-clean' = 'SDDC Manager lifecycle prechecks for VCF 5.2.1 have no blocking findings.'
+        'sddc-manager-5.2.1-ready' = 'SDDC Manager reports version 5.2.1.0 and lifecycle services are healthy.'
+        'nsx-manager-5.2.1-ready' = 'Every NSX Manager cluster reports version 4.2.1.0.0 and stable status.'
+        'nsx-edge-5.2.1-ready' = 'Both NSX Edge nodes report version 4.2.1.0.0 and normal datapath status.'
+        'vcenter-5.2.1-ready' = 'The vCenter for the domain reports version 8.0.3.00100 and healthy services.'
+        'management-domain-5.2.1-converged' = 'Every management-domain component is converged on the VCF 5.2.1 BOM.'
+        'estate-5.2.1-converged' = 'Every inventoried component is converged on the VCF 5.2.1 BOM.'
+        'hcl-9.1-compatible' = 'Management and workload hosts are compatible with the VCF 9.1 hardware baseline.'
+        'operations-deployment-precheck-clean' = 'VCF Operations deployment prerequisites and endpoint checks are clean.'
+        'vcf-operations-9.1-ready' = 'VCF Operations 9.1 is deployed and collecting from the VCF instance.'
+        'license-server-deployment-precheck-clean' = 'VCF License Server deployment prerequisites, DNS, and endpoint checks are clean.'
+        'license-server-9.1-ready' = 'VCF License Server 9.1 is deployed, reachable, and ready to license upgraded components.'
+        'lcm-precheck-9.1-clean' = 'SDDC Manager lifecycle prechecks for VCF 9.1 have no blocking findings.'
+        'sddc-manager-9.1-ready' = 'SDDC Manager reports version 9.1.0.0 and lifecycle services are healthy.'
+        'management-services-9.1-ready' = 'VCF Management Services 9.1 lifecycle, depot, and licensing services are healthy.'
+        'nsx-manager-9.1-ready' = 'Every NSX Manager cluster reports version 9.1.0.0 and stable status.'
+        'reduced-downtime-network-ready' = 'The temporary network required by reduced-downtime vCenter upgrade is reachable.'
+        'vcenter-9.1-ready' = 'The vCenter for the domain reports version 9.1.0.0 and healthy services.'
+        'vlcm-image-ready' = 'A compliant vSphere Lifecycle Manager image for ESX 9.1 is assigned to the cluster.'
+        'esxi-9.1-ready' = 'Every ESX host reports version 9.1.0.0 and its cluster is healthy.'
+        'edge-capacity-ready' = 'XLARGE Edge resources and redundant 25 Gbps uplinks are available on both ToRs.'
+        'management-services-network-ready' = 'Management Services DNS, NTP, routing, and reserved network addresses are reachable.'
+        'management-domain-9.1-converged' = 'Every management-domain component is converged on the VCF 9.1 BOM.'
+    }
+    if (-not $conditions.ContainsKey($GateId)) {
+        throw "No definition is available for technical gate $GateId."
+    }
+    [pscustomobject] [ordered]@{
+        id        = $GateId
+        condition = $conditions[$GateId]
+        evidence  = 'Lifecycle precheck or component health output'
+    }
+}
+
+function New-TargetSddcSpec {
+    param(
+        [Parameter(Mandatory)] $Inventory,
+        [Parameter(Mandatory)] [string] $TargetVersion
+    )
+
+    $managementVcenter = @($Inventory.components | Where-Object {
+        $_.type -eq 'VCENTER' -and $_.domain -eq 'management'
+    })[0]
+
+    $networkSpecs = foreach ($networkName in @('management', 'vmotion', 'vsan')) {
+        $network = $Inventory.network.$networkName
+        [pscustomobject] [ordered]@{
+            networkType = $networkName.ToUpperInvariant()
+            subnet      = [string] $network.subnet
+            gateway     = [string] $network.gateway
+            vlanId      = [int] $network.vlanId
+            mtu         = [int] $network.mtu
+        }
+    }
+
+    [pscustomobject] [ordered]@{
+        sddcId         = [string] $Inventory.sddcId
+        workflowType   = 'VCF'
+        version        = $TargetVersion
+        vcfInstanceName = [string] $Inventory.vcfInstanceName
+        vcenterSpec    = [pscustomobject] [ordered]@{
+            vcenterHostname       = [string] $managementVcenter.name
+            rootVcenterPassword   = '${VC_ROOT_PASS}'
+            version               = $TargetVersion
+            useExistingDeployment = $true
+        }
+        networkSpecs   = @($networkSpecs)
+        dnsSpec        = [pscustomobject] [ordered]@{
+            subdomain  = [string] $Inventory.network.dnsDomain
+            nameservers = @($Inventory.network.dnsServers)
+        }
+        ntpServers     = @($Inventory.network.ntpServers)
+    }
+}
+
+function New-VcfMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $InventoryPath,
+
+        [Parameter(Mandatory)]
+        [string] $CompatibilitySnapshotPath,
+
+        [Parameter(Mandatory)]
+        [string] $OutputPath
+    )
+
+    $inventory = Get-Content -LiteralPath $InventoryPath -Raw | ConvertFrom-Json -Depth 100
+    $snapshot = Get-Content -LiteralPath $CompatibilitySnapshotPath -Raw | ConvertFrom-Json -Depth 100
+    $hops = @(Get-SupportedHopPath -Snapshot $snapshot -Source $inventory.vcfVersion -Target $inventory.targetVcfVersion)
+    $known = [ordered]@{}
+    $currentVersions = @{}
+    foreach ($component in $inventory.components) {
+        $known[[string] $component.id] = [pscustomobject] [ordered]@{
+            id     = [string] $component.id
+            name   = [string] $component.name
+            type   = [string] $component.type
+            domain = [string] $component.domain
+        }
+        $currentVersions[[string] $component.id] = [string] $component.version
+    }
+
+    $steps = [System.Collections.Generic.List[object]]::new()
+    $gateDefinitions = [ordered]@{}
+    $order = 0
+    foreach ($hop in $hops) {
+        $hopKey = "$($hop.from)->$($hop.to)"
+        $newComponents = @()
+        $newComponentProperty = $snapshot.newComponentsByHop.PSObject.Properties[$hopKey]
+        if ($null -ne $newComponentProperty) {
+            $newComponents = @($newComponentProperty.Value)
+        }
+        foreach ($component in $newComponents) {
+            $known[[string] $component.id] = [pscustomobject] [ordered]@{
+                id     = [string] $component.id
+                name   = [string] $component.name
+                type   = [string] $component.type
+                domain = [string] $component.domain
+            }
+            $currentVersions[[string] $component.id] = 'NOT_PRESENT'
+        }
+
+        $phases = @($snapshot.phaseSequenceByHop.$hopKey)
+        foreach ($phase in $phases) {
+            foreach ($componentType in $phase.types) {
+                $batch = @($known.Values | Where-Object {
+                    $scope = if ($_.domain -in @('fleet', 'management')) { $_.domain } else { 'workload' }
+                    $_.type -eq $componentType -and $scope -eq $phase.scope
+                } | Sort-Object domain, id)
+                foreach ($component in $batch) {
+                    $gateIds = @($snapshot.requiredGatesByHopAndType.$hopKey.$componentType)
+                    $scopeGateProperty = $snapshot.requiredGatesByHopAndScope.$hopKey.PSObject.Properties[[string] $phase.scope]
+                    if ($null -ne $scopeGateProperty) {
+                        $gateIds += @($scopeGateProperty.Value)
+                    }
+                    foreach ($gateId in $gateIds) {
+                        if (-not $gateDefinitions.Contains([string] $gateId)) {
+                            $gateDefinitions[[string] $gateId] = Get-GateDefinition -GateId $gateId
+                        }
+                    }
+                    $order++
+                    $steps.Add([pscustomobject] [ordered]@{
+                        order         = $order
+                        hopFrom       = [string] $hop.from
+                        hopTo         = [string] $hop.to
+                        componentId   = [string] $component.id
+                        componentName = [string] $component.name
+                        componentType = [string] $component.type
+                        domain        = [string] $component.domain
+                        fromVersion   = [string] $currentVersions[$component.id]
+                        toVersion     = [string] $snapshot.bomByVcfVersion.($hop.to).($component.type)
+                        gates         = @($gateIds)
+                    })
+                }
+            }
+        }
+
+        foreach ($component in $known.Values) {
+            $currentVersions[$component.id] = [string] $snapshot.bomByVcfVersion.($hop.to).($component.type)
+        }
+    }
+
+    $throughput = [double] $inventory.edgeRequirement.northSouthThroughputGbps
+    $plan = [pscustomobject] [ordered]@{
+        '$schema'        = 'specifications/migration-plan-schema.json'
+        estateId         = [string] $inventory.estateId
+        sourceVcfVersion = [string] $inventory.vcfVersion
+        targetVcfVersion = [string] $inventory.targetVcfVersion
+        targetSddcSpec   = New-TargetSddcSpec -Inventory $inventory -TargetVersion $inventory.targetVcfVersion
+        architecture     = [pscustomobject] [ordered]@{
+            requiredNorthSouthThroughputGbps = $throughput
+            edge = [pscustomobject] [ordered]@{
+                formFactor = Get-EdgeFormFactor -Snapshot $snapshot -ThroughputGbps $throughput
+                nodeCount  = [int] $inventory.edgeRequirement.nodeCount
+                tier0Mode  = [string] $snapshot.edgeUplinkRule.tier0Mode
+                routing    = [string] $snapshot.edgeUplinkRule.routing
+                uplinks    = @($inventory.edgeRequirement.availableUplinks)
+            }
+        }
+        hops             = @($hops)
+        gates            = @($gateDefinitions.Values)
+        steps            = @($steps)
+    }
+
+    $outputDirectory = Split-Path -Parent $OutputPath
+    if ($outputDirectory -and -not (Test-Path -LiteralPath $outputDirectory)) {
+        New-Item -ItemType Directory -Path $outputDirectory -Force | Out-Null
+    }
+    $plan | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $OutputPath -Encoding utf8NoBOM
+}
+
+Export-ModuleMember -Function Get-VcfEstateInventory, New-VcfMigrationPlan

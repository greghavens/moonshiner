{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF brownfield ordered migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "estateId", "sourceVcfVersion", "targetVcfVersion", "targetSddcSpec", "architecture", "hops", "gates", "steps"],
  "properties": {
    "$schema": {"const": "specifications/migration-plan-schema.json"},
    "estateId": {"type": "string", "minLength": 1},
    "sourceVcfVersion": {"type": "string", "minLength": 1},
    "targetVcfVersion": {"type": "string", "minLength": 1},
    "targetSddcSpec": {"type": "object"},
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredNorthSouthThroughputGbps", "edge"],
      "properties": {
        "requiredNorthSouthThroughputGbps": {"type": "number", "exclusiveMinimum": 0},
        "edge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["formFactor", "nodeCount", "tier0Mode", "routing", "uplinks"],
          "properties": {
            "formFactor": {"enum": ["MEDIUM", "LARGE", "XLARGE"]},
            "nodeCount": {"type": "integer", "minimum": 2},
            "tier0Mode": {"enum": ["ACTIVE_ACTIVE", "ACTIVE_STANDBY"]},
            "routing": {"type": "string", "minLength": 1},
            "uplinks": {
              "type": "array",
              "minItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["edgeNodeId", "logicalUplink", "vlanId", "tor", "hostPnic", "speedGbps"],
                "properties": {
                  "edgeNodeId": {"type": "string", "minLength": 1},
                  "logicalUplink": {"type": "string", "minLength": 1},
                  "vlanId": {"type": "integer", "minimum": 1, "maximum": 4094},
                  "tor": {"type": "string", "minLength": 1},
                  "hostPnic": {"type": "string", "minLength": 1},
                  "speedGbps": {"type": "number", "exclusiveMinimum": 0}
                }
              }
            }
          }
        }
      }
    },
    "hops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1}
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "condition", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
          "condition": {"type": "string", "minLength": 8},
          "evidence": {"type": "string", "minLength": 3}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "hopFrom", "hopTo", "componentId", "componentName", "componentType", "domain", "fromVersion", "toVersion", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "hopFrom": {"type": "string", "minLength": 1},
          "hopTo": {"type": "string", "minLength": 1},
          "componentId": {"type": "string", "minLength": 1},
          "componentName": {"type": "string", "minLength": 1},
          "componentType": {"enum": ["VCF_OPERATIONS", "VCF_LICENSE_SERVER", "SDDC_MANAGER", "NSX_MANAGER", "VCENTER", "ESXI", "NSX_EDGE", "VCF_MANAGEMENT_SERVICES"]},
          "domain": {"type": "string", "minLength": 1},
          "fromVersion": {"type": "string", "minLength": 1},
          "toVersion": {"type": "string", "minLength": 1},
          "gates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}

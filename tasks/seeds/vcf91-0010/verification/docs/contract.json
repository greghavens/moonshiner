{
  "contract_version": 1,
  "product": "VMware Cloud Foundation 9.1 SDDC Manager REST API",
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "openapi_version": "3.0.1",
    "info_title": "SDDC Manager API Reference Guide",
    "info_version": "9.1.0.0",
    "license": "Apache-2.0",
    "projection_rule": "Project only the four named operations, every query parameter of getDomains and getClusters, and the schema fields needed for token rotation, pagination, domain/cluster correlation, output projection, and VCF error recognition."
  },
  "operations": [
    {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "tag": "Tokens",
      "summary": "Create Token Pair",
      "request_body": {
        "required": true,
        "media_type": "application/json",
        "schema_ref": "#/components/schemas/TokenCreationSpec"
      },
      "responses": {
        "201": {
          "description": "Created",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/TokenPair"
        },
        "400": {
          "description": "Bad Request",
          "schema_ref": "#/components/schemas/Error"
        },
        "500": {
          "description": "Internal Server Error",
          "schema_ref": "#/components/schemas/Error"
        }
      },
      "powercli_binding": {
        "module": "VMware.Sdk.Vcf.SddcManager",
        "command": "Connect-VcfSddcManagerServer"
      }
    },
    {
      "operationId": "refreshAccessToken",
      "method": "PATCH",
      "path": "/v1/tokens/access-token/refresh",
      "tag": "Tokens",
      "summary": "Refresh Access Token",
      "request_body": {
        "required": true,
        "media_type": "application/json",
        "schema": {
          "type": "string",
          "description": "ID of the refresh token"
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "media_type": "application/json",
          "schema": {
            "type": "string"
          }
        },
        "400": {
          "description": "Bad Request",
          "schema_ref": "#/components/schemas/Error"
        },
        "404": {
          "description": "Not Found",
          "schema_ref": "#/components/schemas/Error"
        },
        "500": {
          "description": "Internal Server Error",
          "schema_ref": "#/components/schemas/Error"
        }
      },
      "powercli_binding": {
        "module": "VMware.Sdk.Vcf.SddcManager",
        "command": "Invoke-VcfRefreshAccessToken"
      }
    },
    {
      "operationId": "getDomains",
      "method": "GET",
      "path": "/v1/domains",
      "tag": "Domains",
      "summary": "Retrieve a list of domains",
      "parameters": [
        {
          "name": "type",
          "in": "query",
          "required": false,
          "schema": { "type": "string" }
        },
        {
          "name": "name",
          "in": "query",
          "required": false,
          "schema": { "type": "string" }
        },
        {
          "name": "vcFqdn",
          "in": "query",
          "required": false,
          "schema": { "type": "string" }
        },
        {
          "name": "vcInstanceId",
          "in": "query",
          "required": false,
          "schema": { "type": "string" }
        },
        {
          "name": "isManagementSsoDomain",
          "in": "query",
          "required": false,
          "schema": { "type": "boolean" }
        },
        {
          "name": "pageNumber",
          "in": "query",
          "required": false,
          "default_declared_by_spec": false,
          "schema": { "type": "integer", "format": "int32" }
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "default_declared_by_spec": false,
          "schema": { "type": "integer", "format": "int32" }
        },
        {
          "name": "useCache",
          "in": "query",
          "required": false,
          "schema": { "type": "boolean" }
        }
      ],
      "responses": {
        "200": {
          "description": "Ok",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/PageOfDomain"
        },
        "400": {
          "description": "Bad Request",
          "schema_ref": "#/components/schemas/Error"
        },
        "500": {
          "description": "InternalServerError",
          "schema_ref": "#/components/schemas/Error"
        }
      },
      "powercli_binding": {
        "module": "VMware.Sdk.Vcf.SddcManager",
        "command": "Invoke-VcfGetDomains"
      }
    },
    {
      "operationId": "getClusters",
      "method": "GET",
      "path": "/v1/clusters",
      "tag": "Clusters",
      "summary": "Retrieve a list of clusters",
      "parameters": [
        {
          "name": "isStretched",
          "in": "query",
          "required": false,
          "schema": { "type": "boolean" }
        },
        {
          "name": "isImageBased",
          "in": "query",
          "required": false,
          "schema": { "type": "boolean" }
        },
        {
          "name": "domainId",
          "in": "query",
          "required": false,
          "schema": { "type": "string" }
        },
        {
          "name": "managedObjectReferenceId",
          "in": "query",
          "required": false,
          "schema": { "type": "string" }
        },
        {
          "name": "name",
          "in": "query",
          "required": false,
          "schema": { "type": "string" }
        },
        {
          "name": "isDefault",
          "in": "query",
          "required": false,
          "schema": { "type": "boolean" }
        },
        {
          "name": "isHciMeshEnabled",
          "in": "query",
          "required": false,
          "schema": { "type": "boolean" }
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "default_declared_by_spec": false,
          "schema": { "type": "integer", "format": "int32" }
        },
        {
          "name": "pageNumber",
          "in": "query",
          "required": false,
          "default_declared_by_spec": false,
          "schema": { "type": "integer", "format": "int32" }
        },
        {
          "name": "useCache",
          "in": "query",
          "required": false,
          "schema": { "type": "boolean" }
        }
      ],
      "responses": {
        "200": {
          "description": "Ok",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/PageOfCluster"
        },
        "400": {
          "description": "Bad Request",
          "schema_ref": "#/components/schemas/Error"
        },
        "500": {
          "description": "InternalServerError",
          "schema_ref": "#/components/schemas/Error"
        }
      },
      "powercli_binding": {
        "module": "VMware.Sdk.Vcf.SddcManager",
        "command": "Invoke-VcfGetClusters"
      }
    }
  ],
  "schemas": {
    "TokenCreationSpec": {
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" },
        "apiKey": { "type": "string" },
        "idToken": { "type": "string" }
      }
    },
    "RefreshToken": {
      "type": "object",
      "properties": {
        "id": { "type": "string" }
      }
    },
    "TokenPair": {
      "type": "object",
      "properties": {
        "accessToken": { "type": "string" },
        "refreshToken": { "$ref": "#/components/schemas/RefreshToken" }
      }
    },
    "PageMetadata": {
      "type": "object",
      "properties": {
        "pageNumber": { "type": "integer", "format": "int32", "readOnly": true },
        "pageSize": { "type": "integer", "format": "int32", "readOnly": true },
        "totalElements": { "type": "integer", "format": "int32", "readOnly": true },
        "totalPages": { "type": "integer", "format": "int32", "readOnly": true }
      }
    },
    "PageOfDomain": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "items": { "$ref": "#/components/schemas/Domain" }
        },
        "pageMetadata": { "$ref": "#/components/schemas/PageMetadata" }
      }
    },
    "Domain": {
      "type": "object",
      "projected_properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" },
        "type": { "type": "string" },
        "isManagementSsoDomain": { "type": "boolean" }
      }
    },
    "PageOfCluster": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "items": { "$ref": "#/components/schemas/Cluster" }
        },
        "pageMetadata": { "$ref": "#/components/schemas/PageMetadata" }
      }
    },
    "Cluster": {
      "type": "object",
      "projected_properties": {
        "id": { "type": "string" },
        "domain": { "$ref": "#/components/schemas/DomainReference" },
        "name": { "type": "string" },
        "status": { "type": "string" },
        "isStretched": { "type": "boolean" },
        "isDefault": { "type": "boolean" }
      }
    },
    "DomainReference": {
      "required": ["id"],
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" }
      },
      "readOnly": true
    },
    "Error": {
      "type": "object",
      "projected_properties": {
        "errorCode": { "type": "string", "readOnly": true },
        "message": { "type": "string", "readOnly": true },
        "referenceToken": { "type": "string", "readOnly": true }
      }
    }
  },
  "client_policy": {
    "pagination": "Pass pageSize and omit pageNumber on each collection's first request; continue with response pageMetadata.pageNumber plus one until invariant totalElements is reached.",
    "domain_work_queue": "Validate the complete domain collection, then sort domains by ordinal case-sensitive name and id before cluster collection.",
    "refresh": {
      "trigger": "first HTTP 401 from getClusters",
      "maximum": 1,
      "request_representation": "RefreshTokenId serialized as one JSON string",
      "resume": "retry the identical interrupted cluster page without clearing earlier rows"
    },
    "ordering": {
      "comparison": "ordinal case-sensitive",
      "keys": [
        "domainName",
        "domainId",
        "clusterName",
        "clusterId"
      ]
    },
    "projection_key_order": [
      "domainId",
      "domainName",
      "domainType",
      "clusterId",
      "clusterName",
      "clusterStatus",
      "isDefault",
      "isStretched"
    ]
  }
}

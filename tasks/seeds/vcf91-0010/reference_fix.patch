+            -Name 'pageNumber' -Context $Context
+        $metadataPageSize = ConvertTo-VcfInteger `
+            -Value (Get-RequiredVcfProperty $metadata 'pageSize' $Context) `
+            -Name 'pageSize' -Context $Context
+        $total = ConvertTo-VcfInteger `

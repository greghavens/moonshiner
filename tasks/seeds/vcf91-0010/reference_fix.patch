+        if ($elements.Count -gt $metadataPageSize) {
+            throw [System.InvalidOperationException]::new(
+                "$Context returned more elements than pageMetadata.pageSize."
+            )
+        }
+        if ($elements.Count -eq 0 -and $items.Count -lt $expectedTotal) {
+            throw [System.InvalidOperationException]::new(
+                "$Context returned a non-progressing page."
+            )
+        }
+        foreach ($element in $elements) {
+            if ($null -eq $element) {
+                throw [System.InvalidOperationException]::new(
+                    "$Context returned a null element."
+                )
+            }
+            $items.Add($element)
+        }
+        if ($items.Count -gt $expectedTotal) {
+            throw [System.InvalidOperationException]::new(
+                "$Context exceeded totalElements."
+            )
+        }
+        if ($items.Count -eq $expectedTotal) {
+            return $items.ToArray()
+        }
+        if ($pageNumber -ge [int]::MaxValue) {
+            throw [System.InvalidOperationException]::new(
+                "$Context next page exceeds the SDK parameter range."
+            )
+        }
+        $requestedPage = [int] ($pageNumber + 1)
+    }
+}

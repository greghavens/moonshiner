+function Get-VcfHttpStatusCode {
+    param([Parameter(Mandatory)] [System.Management.Automation.ErrorRecord] $Record)
+
+    $exception = $Record.Exception
+    for ($depth = 0; $depth -lt 8 -and $null -ne $exception; $depth++) {
+        foreach ($candidateName in @('StatusCode', 'HttpStatusCode')) {
+            $candidate = $exception.PSObject.Properties[$candidateName]
+            if ($null -ne $candidate -and $null -ne $candidate.Value) {
+                try { return [int] $candidate.Value } catch { }
+            }
+        }
+        foreach ($containerName in @('Response', 'ApiError')) {
+            $container = $exception.PSObject.Properties[$containerName]
+            if ($null -eq $container -or $null -eq $container.Value) { continue }
+            $status = $container.Value.PSObject.Properties['StatusCode']
+            if ($null -ne $status -and $null -ne $status.Value) {
+                try { return [int] $status.Value } catch { }
+            }
+        }
+        $exception = $exception.InnerException
+    }
+    if ([string] $Record.Exception.Message -match '(?<![0-9])401(?![0-9])') {
+        return 401
+    }
+    $null
+}

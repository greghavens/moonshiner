+        $totalPages = ConvertTo-VcfInteger `
+            -Value (Get-RequiredVcfProperty $metadata 'totalPages' $Context) `
+            -Name 'totalPages' -Context $Context
+        if ($pageNumber -lt 0 -or $metadataPageSize -le 0 -or
+            $total -lt 0 -or $totalPages -lt 0) {
+            throw [System.InvalidOperationException]::new(
+                "$Context returned invalid pageMetadata values."
+            )
+        }
+        if ($null -ne $requestedPage -and $pageNumber -ne $requestedPage) {
+            throw [System.InvalidOperationException]::new(
+                "$Context returned a page number other than the requested page."
+            )
+        }
+        if (-not $seenPages.Add($pageNumber)) {
+            throw [System.InvalidOperationException]::new(
+                "$Context repeated metadata page number $pageNumber."
+            )
+        }
+        if ($null -eq $expectedTotal) {
+            $expectedTotal = $total
+        } elseif ($total -ne $expectedTotal) {
+            throw [System.InvalidOperationException]::new(
+                "$Context changed totalElements during pagination."
+            )
+        }
+
+        $elementsValue = Get-RequiredVcfProperty `
+            -InputObject $page -Name 'elements' -Context "$Context page"

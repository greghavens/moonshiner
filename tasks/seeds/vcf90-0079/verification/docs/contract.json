{
  "openapi": "3.0.1",
  "info": {
    "title": "VMware Cloud Foundation Operations API",
    "version": ""
  },
  "servers": [
    {
      "url": "/suite-api",
      "description": "Base path"
    }
  ],
  "security": [
    {
      "Token-based-authorization": []
    }
  ],
  "paths": {
    "/api/symptomdefinitions": {
      "put": {
        "summary": "Update an existing Symptom Definition",
        "description": "Update an existing Symptom Definition",
        "operationId": "updateSymptomDefinition",
        "requestBody": {
          "description": "The Symptom Definition to update",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/symptom-definition"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated Symptom Definition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/symptom-definition"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "symptom-definition": {
        "required": [
          "adapterKindKey",
          "name",
          "resourceKindKey",
          "state"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The identifier for the SymptomDefinition. Must be null during create."
          },
          "name": {
            "type": "string",
            "description": "The name of the SymptomDefinition"
          },
          "adapterKindKey": {
            "type": "string",
            "description": "The adapter kind identifier for the SymptomDefinition"
          },
          "resourceKindKey": {
            "type": "string",
            "description": "The resource kind identifier for the SymptomDefinition"
          },
          "waitCycles": {
            "minimum": 1,
            "type": "integer",
            "description": "The number of consecutive cycles to wait when a symptom state is true before a symptom is triggered",
            "format": "int32"
          },
          "cancelCycles": {
            "minimum": 1,
            "type": "integer",
            "description": "The number of consecutive cycles to wait when a symptom state is false before a symptom is cancelled",
            "format": "int32"
          },
          "realtimeMonitoringEnabled": {
            "type": "boolean",
            "description": "Indicates whether real-time monitoring is enabled for the symptom or not. (This field is only visible in SaaS)"
          },
          "state": {
            "$ref": "#/components/schemas/symptom-state"
          }
        },
        "description": "A Symptom Definition defines conditions and properties which define when an alarm is triggered"
      },
      "symptom-state": {
        "required": [
          "condition",
          "severity"
        ],
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "description": "The Criticality level",
            "enum": [
              "UNKNOWN",
              "NONE",
              "INFORMATION",
              "WARNING",
              "IMMEDIATE",
              "CRITICAL",
              "AUTO"
            ]
          },
          "condition": {
            "$ref": "#/components/schemas/OneOfCondition"
          }
        }
      },
      "OneOfCondition": {
        "type": "object",
        "description": "Condition",
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "CONDITION_HT": "#/components/schemas/HT-condition"
          }
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/HT-condition"
          }
        ]
      },
      "condition": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          }
        },
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "CONDITION_HT": "#/components/schemas/HT-condition"
          }
        }
      },
      "HT-condition": {
        "required": [
          "instanced",
          "key",
          "operator",
          "thresholdType",
          "valueType"
        ],
        "type": "object",
        "description": "Hard Threshold condition",
        "allOf": [
          {
            "$ref": "#/components/schemas/condition"
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "description": "The StatKey for the condition"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "EQ",
                  "NOT_EQ",
                  "LIKE",
                  "LT",
                  "GT",
                  "LT_EQ",
                  "GT_EQ",
                  "IN",
                  "NOT_IN",
                  "EXISTS",
                  "CONTAINS",
                  "STARTS_WITH",
                  "ENDS_WITH",
                  "NOT_STARTS_WITH",
                  "NOT_ENDS_WITH",
                  "NOT_CONTAINS",
                  "REGEX",
                  "NOT_REGEX",
                  "NOT_EXISTS",
                  "EMPTY",
                  "NOT_EMPTY"
                ]
              },
              "value": {
                "type": "string",
                "description": "The static value of the condition"
              },
              "valueType": {
                "type": "string",
                "enum": [
                  "NUMERIC",
                  "STRING"
                ]
              },
              "instanced": {
                "type": "boolean",
                "description": "The instance group"
              },
              "settingValue": {
                "type": "string",
                "description": "The setting value"
              },
              "targetKey": {
                "type": "string",
                "description": "A target StatKey to compare the values between two metrics. Required for metric or property threshold type conditions"
              },
              "thresholdType": {
                "type": "string",
                "enum": [
                  "UNKNOWN",
                  "STATIC",
                  "STATKEY",
                  "PROPERTY"
                ]
              }
            }
          }
        ]
      }
    },
    "securitySchemes": {
      "Token-based-authorization": {
        "type": "apiKey",
        "description": "Token based authorization",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}

+++ b/vcf_architecture/planner.py
@@ -0,0 +1,210 @@
+"""Build the ordered VCF migration architecture from pinned local inputs."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+
+RESEARCH = [
+    {
+        "title": "Update Sequence for VCF 9.0 and Compatible VMware Products",
+        "url": "https://knowledge.broadcom.com/external/article/390634",
+        "publisher": "Broadcom",
+        "accessed_on": "2026-08-15",
+        "claims_used": [
+            "Aria Suite Lifecycle 8.18 Patch 2 precedes the management-product migrations",
+            "Operations precedes Automation and the greenfield Logs deployment",
+            "Logs has no in-place 8.x-to-9.0 path and transfers at most 90 days",
+        ],
+    },
+    {
+        "title": "Upgrading VMware Aria Operations 8.x to VCF Operations 9.0 using VMware Aria Suite Lifecycle",
+        "url": "https://knowledge.broadcom.com/external/article/433805",
+        "publisher": "Broadcom",
+        "accessed_on": "2026-08-15",
+        "claims_used": [
+            "The supported lifecycle workflow maps the Operations PAK and Fleet Management OVA",
+            "The workflow performs inventory sync and environment prechecks",
+        ],
+    },
+    {
+        "title": "How to re-trigger VCF Automation 9.0 failed upgrade workflow",
+        "url": "https://knowledge.broadcom.com/external/article/398777",
+        "publisher": "Broadcom",
+        "accessed_on": "2026-08-15",
+        "claims_used": [
+            "Aria Automation 8.18 must be imported into Fleet Management before upgrade",
+        ],
+    },
+    {
+        "title": "Upgrade Guidance for Aria Operations for Logs 8.18.x to VCF Operations for Logs 9.0.x",
+        "url": "https://knowledge.broadcom.com/external/article/402314",
+        "publisher": "Broadcom",
+        "accessed_on": "2026-08-15",
+        "claims_used": [
+            "Logs requires a fresh 9.0 deployment and parallel operation",
+            "Integrations are removed from 8.18 and reconfigured on 9.0",
+            "Historical log transfer is limited to 90 days",
+        ],
+    },
+    {
+        "title": "End of General Support for VMware Aria Operations 8.18",
+        "url": "https://knowledge.broadcom.com/external/article/422643",
+        "publisher": "Broadcom",
+        "accessed_on": "2026-08-15",
+        "claims_used": [
+            "The 8.18 end-of-general-support boundary is 2027-10-11",
+        ],
+    },
+]
+
+
+def _read_object(path: Path) -> dict[str, Any]:
+    value = json.loads(path.read_text(encoding="utf-8"))
+    if not isinstance(value, dict):
+        raise ValueError(f"{path} must contain a JSON object")
+    return value
+
+
+def _validate_inputs(inventory: dict[str, Any], snapshot: dict[str, Any]) -> None:
+    products = {
+        product["product_id"]: product for product in inventory["source_products"]
+    }
+    order = snapshot["migration_order"]
+    if set(products) != set(order):
+        raise ValueError("snapshot migration order must cover every source product once")
+    for product_id in order:
+        if products[product_id]["version"] != snapshot["paths"][product_id][
+            "supported_source"
+        ]:
+            raise ValueError(f"unsupported source version for {product_id}")
+
+    domain = inventory["management_domain"]
+    rules = snapshot["management_domain_rules"]
+    sites = domain["data_sites"]
+    local_ftt = domain["requirements"]["local_failures_to_tolerate"]
+    minimum = max(rules["minimum_vcf_hosts_per_data_site"], 2 * local_ftt + 1)
+    if len(sites) != rules["data_site_count"]:
+        raise ValueError("inventory does not contain two stretched data sites")
+    if any(site["available_hosts"] < minimum for site in sites):
+        raise ValueError("available hosts contradict the requested local FTT")
+    witness = domain["witness_site"]
+    if witness["site_id"] in {site["site_id"] for site in sites}:
+        raise ValueError("witness must use an independent third site")
+    if witness["can_run_management_workloads"]:
+        raise ValueError("witness site cannot run management workloads")
+
+
+def _management_domain(inventory: dict[str, Any]) -> dict[str, Any]:
+    domain = inventory["management_domain"]
+    requirements = domain["requirements"]
+    data_sites = [
+        {"site_id": site["site_id"], "host_count": site["available_hosts"]}
+        for site in domain["data_sites"]
+    ]
+    witness = domain["witness_site"]
+    return {
+        "topology": domain["topology"],
+        "site_failures_to_tolerate": requirements["site_failures_to_tolerate"],
+        "local_failures_to_tolerate": requirements["local_failures_to_tolerate"],
+        "storage_policy": requirements["storage_policy"],
+        "data_sites": data_sites,
+        "total_data_host_count": sum(site["host_count"] for site in data_sites),
+        "vsan_witness": {
+            "site_id": witness["site_id"],
+            "failure_domain": witness["failure_domain"],
+            "host_counted_as_data": False,
+            "runs_management_workloads": False,
+            "connected_data_sites": [site["site_id"] for site in data_sites],
+        },
+    }
+
+
+def _target_components(snapshot: dict[str, Any]) -> list[dict[str, Any]]:
+    versions = {
+        path["target_component"]: path["target_version"]
+        for path in snapshot["paths"].values()
+    }
+    components = []
+    for component, sizing in snapshot["target_sizing"].items():
+        components.append(
+            {
+                "component": component,
+                "version": versions[component],
+                **sizing,
+                "placement_policy": (
+                    "anti-affinity-across-data-sites-on-stretched-management-domain"
+                ),
+            }
+        )
+    return components
+
+
+def _migration_steps(
+    inventory: dict[str, Any], snapshot: dict[str, Any]
+) -> list[dict[str, Any]]:
+    products = {
+        product["product_id"]: product for product in inventory["source_products"]
+    }
+    steps = []
+    for index, product_id in enumerate(snapshot["migration_order"], start=1):
+        product = products[product_id]
+        path = snapshot["paths"][product_id]
+        steps.append(
+            {
+                "order": index * 10,
+                "source_product_id": product_id,
+                "source_product": product["name"],
+                "source_version": product["version"],
+                "target_component": path["target_component"],
+                "target_version": path["target_version"],
+                "migration_mode": path["migration_mode"],
+                "carry_forward": [
+                    {"item": item, "method": method}
+                    for item, method in path["carry_forward"].items()
+                ],
+                "abandoned": list(path["abandoned"]),
+                "gates": list(path["required_gates"]),
+            }
+        )
+    return steps
+
+
+def _support_boundaries(snapshot: dict[str, Any]) -> list[dict[str, str]]:
+    boundaries = []
+    for product_id in snapshot["migration_order"]:
+        boundary = snapshot["support_boundaries"][product_id]
+        boundaries.append(
+            {
+                "source_product_id": product_id,
+                "release_line": boundary["release_line"],
+                "end_of_general_support": boundary["end_of_general_support"],
+                "migration_complete_before": boundary["end_of_general_support"],
+            }
+        )
+    return boundaries
+
+
+def build_architecture(
+    inventory_path: str | Path, snapshot_path: str | Path
+) -> dict[str, Any]:
+    """Return a deterministic architecture derived from the two pinned inputs."""
+    inventory_file = Path(inventory_path)
+    snapshot_file = Path(snapshot_path)
+    inventory = _read_object(inventory_file)
+    snapshot = _read_object(snapshot_file)
+    _validate_inputs(inventory, snapshot)
+    return {
+        "schema_version": "1.0",
+        "estate_id": inventory["estate_id"],
+        "inventory_sha256": hashlib.sha256(inventory_file.read_bytes()).hexdigest(),
+        "compatibility_snapshot_id": snapshot["snapshot_id"],
+        "management_domain": _management_domain(inventory),
+        "target_components": _target_components(snapshot),
+        "migration_steps": _migration_steps(inventory, snapshot),
+        "support_boundaries": _support_boundaries(snapshot),
+        "research": RESEARCH,
+    }

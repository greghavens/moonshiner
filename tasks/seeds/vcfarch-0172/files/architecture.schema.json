{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:northstar:vcf-migration-architecture:1.0",
  "title": "Northstar VCF migration architecture",
  "type": "object",
  "required": [
    "schema_version",
    "estate_id",
    "inventory_sha256",
    "compatibility_snapshot_id",
    "management_domain",
    "target_components",
    "migration_steps",
    "support_boundaries",
    "research"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "estate_id": {
      "type": "string"
    },
    "inventory_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compatibility_snapshot_id": {
      "type": "string"
    },
    "management_domain": {
      "$ref": "#/$defs/management_domain"
    },
    "target_components": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/target_component"
      }
    },
    "migration_steps": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/migration_step"
      }
    },
    "support_boundaries": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/support_boundary"
      }
    },
    "research": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/research_record"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "management_domain": {
      "type": "object",
      "required": [
        "topology",
        "site_failures_to_tolerate",
        "local_failures_to_tolerate",
        "storage_policy",
        "data_sites",
        "total_data_host_count",
        "vsan_witness"
      ],
      "properties": {
        "topology": {
          "const": "stretched"
        },
        "site_failures_to_tolerate": {
          "type": "integer",
          "minimum": 1
        },
        "local_failures_to_tolerate": {
          "type": "integer",
          "minimum": 0
        },
        "storage_policy": {
          "type": "string"
        },
        "data_sites": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "site_id",
              "host_count"
            ],
            "properties": {
              "site_id": {
                "type": "string"
              },
              "host_count": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "total_data_host_count": {
          "type": "integer",
          "minimum": 1
        },
        "vsan_witness": {
          "type": "object",
          "required": [
            "site_id",
            "failure_domain",
            "host_counted_as_data",
            "runs_management_workloads",
            "connected_data_sites"
          ],
          "properties": {
            "site_id": {
              "type": "string"
            },
            "failure_domain": {
              "type": "string"
            },
            "host_counted_as_data": {
              "type": "boolean"
            },
            "runs_management_workloads": {
              "type": "boolean"
            },
            "connected_data_sites": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "target_component": {
      "type": "object",
      "required": [
        "component",
        "version",
        "profile",
        "node_count",
        "vcpu_per_node",
        "memory_gib_per_node",
        "disk_gib_per_node",
        "site_distribution",
        "placement_policy"
      ],
      "properties": {
        "component": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "node_count": {
          "type": "integer",
          "minimum": 1
        },
        "vcpu_per_node": {
          "type": "integer",
          "minimum": 1
        },
        "memory_gib_per_node": {
          "type": "integer",
          "minimum": 1
        },
        "disk_gib_per_node": {
          "type": "integer",
          "minimum": 1
        },
        "site_distribution": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "placement_policy": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "migration_step": {
      "type": "object",
      "required": [
        "order",
        "source_product_id",
        "source_product",
        "source_version",
        "target_component",
        "target_version",
        "migration_mode",
        "carry_forward",
        "abandoned",
        "gates"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "source_product_id": {
          "type": "string"
        },
        "source_product": {
          "type": "string"
        },
        "source_version": {
          "type": "string"
        },
        "target_component": {
          "type": "string"
        },
        "target_version": {
          "type": "string"
        },
        "migration_mode": {
          "type": "string"
        },
        "carry_forward": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item",
              "method"
            ],
            "properties": {
              "item": {
                "type": "string"
              },
              "method": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "abandoned": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "support_boundary": {
      "type": "object",
      "required": [
        "source_product_id",
        "release_line",
        "end_of_general_support",
        "migration_complete_before"
      ],
      "properties": {
        "source_product_id": {
          "type": "string"
        },
        "release_line": {
          "type": "string"
        },
        "end_of_general_support": {
          "type": "string",
          "format": "date"
        },
        "migration_complete_before": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": false
    },
    "research_record": {
      "type": "object",
      "required": [
        "title",
        "url",
        "publisher",
        "accessed_on",
        "claims_used"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "publisher": {
          "const": "Broadcom"
        },
        "accessed_on": {
          "type": "string",
          "format": "date"
        },
        "claims_used": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}

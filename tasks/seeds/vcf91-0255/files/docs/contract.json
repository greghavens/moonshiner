{
  "contract_version": 1,
  "description": "Focused projection of the VMware Cloud Foundation Operations API required to onboard an outbound alert plugin instance and bind a notification rule to it. Derived directly from the pinned OpenAPI specification recorded in docs/official_sources.json.",
  "api_title": "VMware Cloud Foundation Operations API",
  "api_version": "9.1.0.0",
  "openapi_version": "3.0.1",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "spec_path": "specifications/vcf-operations/vcf-operations-openapi.json",
    "license": "Apache-2.0"
  },
  "base_path": "/suite-api",
  "auth": {
    "security_scheme": "Token-based-authorization",
    "scheme_type": "apiKey",
    "in": "header",
    "header": "Authorization",
    "header_prefix": "OpsToken ",
    "acquire_operation_id": "acquireToken"
  },
  "operations": [
    {
      "operation_id": "acquireToken",
      "method": "POST",
      "path_template": "/api/auth/token/acquire",
      "query": {},
      "success_status": 200,
      "authentication": "none",
      "request_body": {
        "required": true,
        "media_type": "application/json",
        "schema": "username-password",
        "required_properties": [
          "username",
          "password"
        ],
        "optional_properties": [
          "authSource"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "authSource": {
            "type": "string"
          }
        }
      },
      "response": {
        "schema": "auth-token",
        "required_properties": [
          "token",
          "validity"
        ],
        "optional_properties": [
          "expiresAt",
          "roles"
        ]
      }
    },
    {
      "operation_id": "getCurrentVersionOfServer",
      "method": "GET",
      "path_template": "/api/versions/current",
      "query": {},
      "success_status": 200,
      "authentication": "Token-based-authorization",
      "request_body": null,
      "response": {
        "schema": "version",
        "required_properties": [
          "releaseName",
          "major",
          "minor",
          "minorMinor",
          "releasedDate",
          "humanlyReadableReleaseDate"
        ],
        "optional_properties": [
          "patch",
          "buildNumber",
          "description"
        ]
      }
    },
    {
      "operation_id": "getAlertPluginTypes",
      "method": "GET",
      "path_template": "/api/alertplugins/types",
      "query": {},
      "success_status": 200,
      "authentication": "Token-based-authorization",
      "request_body": null,
      "response": {
        "schema": "alert-plugin-types",
        "optional_properties": [
          "notificationPluginType",
          "links"
        ],
        "properties": {
          "notificationPluginType": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of supported Notification Plugin Types"
          }
        }
      }
    },
    {
      "operation_id": "createAlertPlugin",
      "method": "POST",
      "path_template": "/api/alertplugins",
      "query": {},
      "success_status": 201,
      "authentication": "Token-based-authorization",
      "request_body": {
        "required": true,
        "media_type": "application/json",
        "schema": "notification-plugin",
        "required_properties": [
          "name",
          "pluginTypeId"
        ],
        "optional_properties": [
          "configValues",
          "description",
          "certificates",
          "pluginId",
          "enabled"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The name for the configuration"
          },
          "pluginTypeId": {
            "type": "string",
            "description": "The plugin type identifier"
          },
          "description": {
            "type": "string",
            "description": "The description for the configuration"
          },
          "configValues": {
            "type": "array",
            "items": {
              "schema": "name-value",
              "type": "object",
              "required_properties": [
                "name",
                "value"
              ]
            },
            "description": "The list of name value pairs for Plugin configuration"
          },
          "pluginId": {
            "type": "string",
            "format": "uuid",
            "description": "The Plugin Id, cannot be null during update operations"
          },
          "enabled": {
            "type": "boolean",
            "description": "A read-only property whose value is set by the system"
          }
        }
      },
      "response": {
        "schema": "notification-plugin",
        "required_properties": [
          "name",
          "pluginTypeId"
        ],
        "optional_properties": [
          "pluginId",
          "enabled",
          "description",
          "configValues",
          "certificates"
        ]
      }
    },
    {
      "operation_id": "getNotificationTemplates",
      "method": "GET",
      "path_template": "/api/notifications/templates",
      "query": {
        "name": {
          "type": "string",
          "required": false,
          "description": "Template name to search for"
        },
        "description": {
          "type": "string",
          "required": false,
          "description": "Template description to search for"
        },
        "outboundMethod": {
          "type": "string",
          "required": false,
          "description": "Attached outbound method of template to search for"
        },
        "modifiedBy": {
          "type": "string",
          "required": false,
          "description": "Template modified user name to search for"
        },
        "page": {
          "type": "integer",
          "format": "int32",
          "required": false,
          "default": 0,
          "description": "Page number from which data needs to be displayed (0-based)"
        },
        "pageSize": {
          "type": "integer",
          "format": "int32",
          "required": false,
          "default": 1000,
          "description": "Expected number of entries per page"
        }
      },
      "success_status": 200,
      "authentication": "Token-based-authorization",
      "request_body": null,
      "response": {
        "schema": "notification-templates",
        "optional_properties": [
          "notificationTemplates",
          "pageInfo",
          "links"
        ],
        "properties": {
          "notificationTemplates": {
            "type": "array",
            "items": {
              "schema": "notification-template",
              "required_properties": [
                "name",
                "pluginTypeId"
              ],
              "optional_properties": [
                "templateId",
                "templateType",
                "description",
                "editable",
                "attachedRuleCount"
              ]
            }
          }
        }
      }
    },
    {
      "operation_id": "createNotificationPluginRule",
      "method": "POST",
      "path_template": "/api/notifications/rules",
      "query": {},
      "success_status": 201,
      "declared_error_statuses": [
        404,
        422
      ],
      "authentication": "Token-based-authorization",
      "request_body": {
        "required": true,
        "media_type": "application/json",
        "schema": "notification-rule",
        "required_properties": [
          "name",
          "pluginId"
        ],
        "optional_properties": [
          "templateId",
          "criticalities",
          "alertStatuses",
          "alertControlStates",
          "actionStatuses",
          "alertTypeFilters",
          "alertDefinitionIdFilters",
          "alertImpactFilters",
          "collectorGroupId",
          "collectorUUId",
          "enabled",
          "id",
          "links",
          "properties",
          "resourceFilter",
          "resourceFilters",
          "resourceKindFilter",
          "resourceKindFilters",
          "ruleType",
          "sendHeartbeat"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of this rule"
          },
          "pluginId": {
            "type": "string",
            "description": "Identifier of the plugin for which this rule applies"
          },
          "templateId": {
            "type": "string",
            "description": "Identifier of the template. For deprecated plugin types this field is ignored; for all other plugin types a default template is used when the value is not specified."
          },
          "criticalities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "schema": "criticality",
              "enum": [
                "UNKNOWN",
                "NONE",
                "INFORMATION",
                "WARNING",
                "IMMEDIATE",
                "CRITICAL",
                "AUTO"
              ]
            }
          },
          "alertStatuses": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "schema": "alert-status",
              "enum": [
                "NEW",
                "ACTIVE",
                "UPDATED",
                "CANCELED"
              ]
            }
          },
          "collectorGroupId": {
            "type": "string",
            "description": "Filter for the rule to match Alerts triggered on resources belonging to given collector group"
          },
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Identifier that shows if the notification rule is enabled. Enabled by default"
          },
          "sendHeartbeat": {
            "type": "boolean",
            "default": false,
            "description": "Filter for the rule to send Alerts while they are active. Defaulted to False if nothing is provided."
          },
          "ruleType": {
            "type": "string",
            "schema": "notification-rule-type",
            "enum": [
              "ALERT",
              "ACTION",
              "UNKNOWN"
            ]
          }
        }
      },
      "response": {
        "schema": "notification-rule",
        "required_properties": [
          "name",
          "pluginId"
        ],
        "optional_properties": [
          "id",
          "templateId",
          "criticalities",
          "enabled",
          "ruleType"
        ]
      }
    }
  ]
}

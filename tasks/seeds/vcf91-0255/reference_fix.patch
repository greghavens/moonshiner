+function New-StepLedger {
+    # Every step starts as NotAttempted. A step only leaves that state when the
+    # run actually reaches it, so an abandoned step is never reported as done.
+    $ledger = [ordered] @{}
+    foreach ($step in $script:StepOrder) {
+        $ledger[$step.Name] = [pscustomobject] @{
+            Name        = $step.Name
+            OperationId = $step.OperationId
+            Outcome     = 'NotAttempted'
+        }
+    }
+    return $ledger
+}
+
+function Resolve-ApiFailure {
+    <#
+        Extracts the HTTP status and the server-supplied message from a
+        terminating error raised by an Invoke-VcfOps* cmdlet. Returns $null
+        when the error did not come from the API layer, so a genuine transport
+        or programming fault is never misreported as a service rejection.
+    #>
+    param([Parameter(Mandatory)] $ErrorRecord)
+
+    $api = $null
+    $exception = $ErrorRecord.Exception
+    while ($null -ne $exception) {
+        if ($exception -is [VMware.Binding.OpenApi.Client.ApiException]) {
+            $api = $exception
+            break
+        }
+        $exception = $exception.InnerException
+    }
+    if ($null -eq $api) { return $null }
+
+    $message = $api.ErrorContent
+    if (-not [string]::IsNullOrWhiteSpace($api.ErrorContent)) {
+        try {
+            $parsed = $api.ErrorContent | ConvertFrom-Json -ErrorAction Stop
+            if ($parsed.PSObject.Properties.Name -contains 'message' -and
+                -not [string]::IsNullOrWhiteSpace($parsed.message)) {
+                $message = [string] $parsed.message
+            }
+        } catch {
+            # Body is not JSON; the raw content is the best available message.
+        }
+    }
+
+    return [pscustomobject] @{
+        StatusCode = [int] $api.ErrorCode
+        Message    = $message
+    }
+}

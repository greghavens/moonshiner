+$script:StepOrder = @(
+    @{ Name = 'VerifyPluginType'; OperationId = 'getAlertPluginTypes' }
+    @{ Name = 'CreatePlugin';     OperationId = 'createAlertPlugin' }
+    @{ Name = 'ResolveTemplate';  OperationId = 'getNotificationTemplates' }

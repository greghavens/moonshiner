  "definitions": {
    "Tag": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "maximum_length": 128,
          "default": ""
        },
        "tag": {
          "type": "string",
          "maximum_length": 256,
          "default": ""
        }
      }
    },
    "ResourceInfo": {
      "type": "object",
      "required": [
        "resource_ids",
        "resource_type"
      ],
      "properties": {
        "resource_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resource_type": {
          "type": "string",
          "supported_value": "VirtualMachine"
        }
      }
    },
    "TagBulkOperation": {
      "type": "object",
      "allOf": [
        "#/definitions/PolicyConfigResource"
      ],
      "required": [
        "tag"
      ],
      "writable_properties": {
        "tag": {
          "schema_ref": "#/definitions/Tag"
        },
        "apply_to": {
          "type": "array",
          "items_ref": "#/definitions/ResourceInfo"
        },
        "remove_from": {
          "type": "array",
          "items_ref": "#/definitions/ResourceInfo"
        }
      }
    },
    "TagBulkOperationStatus": {
      "type": "object",
      "required": [
        "path",
        "status",
        "tag"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "Success",
            "Running",
            "Error",
            "Pending"
          ]
        },
        "tag": {
          "schema_ref": "#/definitions/Tag"
        },
        "apply_to": {
          "type": "array",
          "items_ref": "#/definitions/ResourceTypeTagStatus"
        },
        "remove_from": {
          "type": "array",
          "items_ref": "#/definitions/ResourceTypeTagStatus"
        }
      }
    },
    "ResourceTypeTagStatus": {
      "type": "object",
      "required": [
        "resource_type"
      ],
      "properties": {
        "resource_type": {
          "type": "string"
        },
        "resource_tag_status": {
          "type": "array",
          "items_ref": "#/definitions/ResourceTagStatus"
        }
      }
    },
    "ResourceTagStatus": {
      "type": "object",
      "properties": {
        "resource_id": {
          "type": "string"
        },
        "tag_status": {
          "type": "string"
        },
        "details": {
          "type": "string"
        }
      }
    },
    "ApiError": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "integer",
          "format": "int64"
        },
        "error_message": {
          "type": "string"
        },
        "module_name": {
          "type": "string"
        },
        "details": {
          "type": "string"
        }
      }
    }
  },
  "serialization_rule": {
    "unset_optional_body_properties": "omit",
    "unset_optional_query_parameters": "omit",
    "explicit_empty_or_default_for_unset_optionals": false
  },
  "polling_rule": {
    "submission_operationId": "TagBulkUpdate",
    "poll_operationId": "GetTagBulkOperationStatus",
    "nonterminal_statuses": [
      "Pending",
      "Running"
    ],
    "successful_terminal_statuses": [
      "Success"
    ],
    "failed_terminal_statuses": [
      "Error"
    ],
    "accepted_response_is_terminal": false,
    "minimum_status_polls": 1
  }

  "operations": [
    {
      "operationId": "TagBulkUpdate",
      "method": "PUT",
      "path": "/infra/tags/tag-operations/{operation-id}",
      "summary": "Assign or Unassign tag on multiple Virtual Machines",
      "consumes": [
        "application/json"
      ],
      "produces": [
        "application/json"
      ],
      "parameters": [
        {
          "name": "operation-id",
          "in": "path",
          "required": true,
          "type": "string"
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "enforcement_point_path",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "include_mark_for_delete_objects",
          "in": "query",
          "required": false,
          "type": "boolean",
          "default": false
        },
        {
          "name": "included_fields",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "page_size",
          "in": "query",
          "required": false,
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 1000,
          "default": 1000
        },
        {
          "name": "sort_ascending",
          "in": "query",
          "required": false,
          "type": "boolean"
        },
        {
          "name": "sort_by",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "tag-bulk-operation",
          "in": "body",
          "required": true,
          "schema_ref": "#/definitions/TagBulkOperation"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "schema_ref": "#/definitions/TagBulkOperation"
        },
        "301": {
          "schema_ref": "#/definitions/ApiError"
        },
        "307": {
          "schema_ref": "#/definitions/ApiError"
        },
        "400": {
          "schema_ref": "#/definitions/ApiError"
        },
        "403": {
          "schema_ref": "#/definitions/ApiError"
        },
        "409": {
          "schema_ref": "#/definitions/ApiError"
        },
        "412": {
          "schema_ref": "#/definitions/ApiError"
        },
        "500": {
          "schema_ref": "#/definitions/ApiError"
        },
        "503": {
          "schema_ref": "#/definitions/ApiError"
        }
      }
    },
    {
      "operationId": "GetTagBulkOperationStatus",
      "method": "GET",
      "path": "/infra/tags/tag-operations/{operation-id}/status",
      "summary": "Get status of tag bulk operation",
      "produces": [
        "application/json"
      ],
      "parameters": [
        {
          "name": "operation-id",
          "in": "path",
          "required": true,
          "type": "string"
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "enforcement_point_path",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "include_mark_for_delete_objects",
          "in": "query",
          "required": false,
          "type": "boolean",
          "default": false
        },
        {
          "name": "included_fields",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "page_size",
          "in": "query",
          "required": false,
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 1000,
          "default": 1000

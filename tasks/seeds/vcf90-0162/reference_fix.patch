+func (c *Client) do(ctx context.Context, step Step, method, escapedPath string, payload any) (StepResult, error) {
+	result := StepResult{Step: step}
+	body, err := json.Marshal(payload)
+	if err != nil {
+		return failedStep(result, fmt.Errorf("encode request: %w", err))
+	}
+	req, err := http.NewRequestWithContext(ctx, method, c.endpoint(escapedPath), bytes.NewReader(body))
+	if err != nil {
+		return failedStep(result, fmt.Errorf("build request: %w", err))
+	}
+	req.Header.Set("Authorization", "Bearer "+c.token)
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "application/json")
+
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return failedStep(result, fmt.Errorf("send request: %w", err))
+	}
+	defer resp.Body.Close()
+	responseBody, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return failedStep(result, fmt.Errorf("read response: %w", err))
+	}
+	result.HTTPStatus = resp.StatusCode
+	if resp.StatusCode != http.StatusOK {
+		message := responseMessage(responseBody)
+		result.Status = StepFailed
+		result.Message = message
+		return result, &StepError{Step: step, HTTPStatus: resp.StatusCode, Message: message}
+	}
+
+	var response struct {
+		ID string `json:"id"`
+	}
+	if err := json.Unmarshal(responseBody, &response); err != nil {
+		return failedStep(result, fmt.Errorf("decode response: %w", err))
+	}
+	result.Status = StepSucceeded
+	result.ResponseID = response.ID
+	return result, nil
+}
+
+func failedStep(result StepResult, err error) (StepResult, error) {
+	result.Status = StepFailed
+	result.Message = err.Error()
+	return result, &StepError{Step: result.Step, HTTPStatus: result.HTTPStatus, Message: result.Message, Err: err}
+}
+
+func responseMessage(body []byte) string {
+	var response struct {
+		Details string `json:"details"`
+		Message string `json:"message"`
+	}
+	if json.Unmarshal(body, &response) == nil {
+		if response.Details != "" {
+			return response.Details
+		}
+		if response.Message != "" {
+			return response.Message
+		}
+	}
+	if message := strings.TrimSpace(string(body)); message != "" {
+		return message
+	}
+	return "request failed"
+}
+
+func (c *Client) endpoint(escapedPath string) string {
+	u := *c.baseURL
+	u.RawQuery = ""
+	u.Fragment = ""
+	rawPath := strings.TrimRight(u.EscapedPath(), "/") + escapedPath
+	path, err := url.PathUnescape(rawPath)
+	if err != nil {
+		path = rawPath
+	}
+	u.Path = path
+	u.RawPath = rawPath
+	return u.String()
 }

{
  "contract_version": 1,
  "product": "VMware Cloud Foundation 9.1 SDDC Manager REST API",
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "openapi": "3.0.1",
    "info_title": "SDDC Manager API Reference Guide",
    "info_version": "9.1.0.0",
    "repository_license": "Apache-2.0"
  },
  "operations": [
    {
      "operationId": "updateProxyConfiguration",
      "summary": "Update Proxy configuration",
      "method": "PATCH",
      "path": "/v1/system/proxy-configuration",
      "request": {
        "required": true,
        "media_type": "application/json",
        "schema_ref": "#/components/schemas/ProxyConfiguration"
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Task"
        },
        "400": {
          "description": "Bad request",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        },
        "500": {
          "description": "Internal server error",
          "x_vmw_compiler_skip": true
        }
      }
    },
    {
      "operationId": "setCeipStatus",
      "summary": "Configure CEIP to Opt-In or Opt-Out",
      "method": "PATCH",
      "path": "/v1/system/ceip",
      "request": {
        "required": true,
        "media_type": "application/json",
        "schema_ref": "#/components/schemas/CeipUpdateSpec"
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Task"
        },
        "400": {
          "description": "Bad Request",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        },
        "409": {
          "description": "The request could not be completed due to a conflict with the current state",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        },
        "500": {
          "description": "InternalServerError",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        }
      }
    },
    {
      "operationId": "getTask",
      "summary": "Retrieve a task by its ID",
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "path_parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "A task object.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Task"
        },
        "404": {
          "description": "Task not found",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        },
        "500": {
          "description": "Unexpected error",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        }
      }
    }
  ],
  "schemas": {
    "ProxyConfiguration": {
      "type": "object",
      "required": [],
      "properties": {
        "isConfigured": {
          "type": "boolean",
          "description": "Defines if the proxy is configured.",
          "readOnly": true
        },
        "isEnabled": {
          "type": "boolean",
          "description": "Defines if the proxy configuration is enabled. To disable the proxy, this should be set to false."
        },
        "host": {
          "type": "string",
          "description": "IP address/FQDN of proxy server. This must be set if proxy is enabled."
        },
        "port": {
          "type": "integer",
          "format": "int32",
          "description": "Port of proxy server. This must be set if proxy is enabled."
        },
        "transferProtocol": {
          "type": "string",
          "description": "Proxy transfer protocol, default value is HTTP",
          "enum": [
            "HTTP",
            "HTTPS"
          ]
        },
        "username": {
          "type": "string",
          "description": "User name to connect"
        },
        "password": {
          "type": "string",
          "description": "User password to connect, will return null on reading"
        },
        "isAuthenticated": {
          "type": "boolean",
          "description": "If proxy authentication is required, isAuthenticated must be enabled and username and password should be set."
        }
      },
      "description": "Proxy Configuration"
    },
    "CeipUpdateSpec": {
      "required": [
        "status"
      ],
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "User provided CEIP operation",
          "example": "One among: ENABLE, DISABLE"
        }
      },
      "description": "Required action for CEIP."
    },
    "Task": {
      "required": [
        "creationTimestamp",
        "id",
        "name",
        "status"
      ],
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Task ID",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "description": "Task name",
          "readOnly": true
        },
        "type": {
          "type": "string",
          "description": "Operation represented by the Task",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "description": "Task status",
          "readOnly": true,
          "example": "One among: PENDING, Pending, IN_PROGRESS, In Progress, SUCCESSFUL, Successful, FAILED, Failed, CANCELLED, Cancelled, COMPLETED_WITH_WARNING, SKIPPED, QUEUED, TIMED_OUT, Queued, Timed Out"
        },
        "creationTimestamp": {
          "type": "string",
          "description": "Task creation timestamp",
          "readOnly": true
        },
        "completionTimestamp": {
          "type": "string",
          "description": "Task completion timestamp",
          "readOnly": true
        },
        "errors": {
          "type": "array",
          "description": "List of errors in case of a failure",
          "readOnly": true,
          "items": {
            "$ref": "#/components/schemas/Error"
          }
        },
        "resolutionStatus": {
          "type": "string",
          "description": "Resolution state",
          "readOnly": true
        },
        "isCancellable": {
          "type": "boolean",
          "description": "Represents task can be cancellable or not.",
          "readOnly": true
        },
        "isRetryable": {
          "type": "boolean",
          "description": "Indicates whether a task is eligible for retry or not.",
          "readOnly": true
        }
      },
      "description": "Represents a task",
      "projection_note": "Task references not consumed by this task are omitted from this focused projection."
    },
    "Error": {
      "type": "object",
      "properties": {
        "errorCode": {
          "type": "string",
          "description": "The minor error code",
          "readOnly": true
        },
        "message": {
          "type": "string",
          "description": "The localized error message",
          "readOnly": true
        },
        "remediationMessage": {
          "type": "string",
          "description": "The localized remediation error message"
        },
        "referenceToken": {
          "type": "string",
          "description": "A reference token correlating the error with the relevant detailed error logs.",
          "readOnly": true
        }
      },
      "description": "Error response containing a minor error code, a localized error message, a localized remediation message and optionally a reference token to correlate the error with the logs ",
      "projection_note": "Only fields consumed by this task are projected."
    }
  }
}

{
  "openapi": "3.0.1",
  "title": "VCF Operations for Logs 9.0 asynchronous cluster join",
  "servers": [
    {
      "url": "/api/v2"
    }
  ],
  "operations": [
    {
      "operationId": "POST_deployment-join",
      "method": "POST",
      "path": "/deployment/join",
      "description": "Submit a request for a newly installed server to join an existing cluster. Configuration can take several minutes; use POST_deployment-waitUntilStarted to track it.",
      "request": {
        "contentType": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "masterFQDN": {
              "type": "string"
            },
            "masterPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "acceptCert": {
              "type": "boolean"
            }
          },
          "required": [
            "masterFQDN"
          ]
        }
      },
      "responses": {
        "200": {
          "description": "Successfully submitted a request to join the cluster.",
          "contentType": "application/json",
          "schema": {
            "type": "object",
            "properties": {
              "masterAddress": {
                "type": "string"
              },
              "workerAddress": {
                "type": "string"
              },
              "workerPort": {
                "type": "integer"
              },
              "workerToken": {
                "type": "string"
              },
              "masterUiPort": {
                "type": "integer"
              }
            },
            "required": [
              "masterAddress",
              "workerAddress",
              "workerPort",
              "workerToken",
              "masterUiPort"
            ]
          }
        },
        "400": {
          "description": "The request body is invalid."
        },
        "403": {
          "description": "The join request could not be processed."
        },
        "409": {
          "description": "The server has already been configured."
        },
        "495": {
          "description": "The primary node certificate is not trusted."
        }
      }
    },
    {
      "operationId": "POST_deployment-waitUntilStarted",
      "method": "POST",
      "path": "/deployment/waitUntilStarted",
      "description": "Wait until the server starts. This can take several minutes and should be retried in case of failure.",
      "request": {
        "body": false
      },
      "responses": {
        "200": {
          "description": "The server started successfully.",
          "body": false,
          "terminal": true
        },
        "500": {
          "description": "Internal error while processing the request.",
          "retryable": true
        }
      }
    }
  ]
}

+    private static PrecheckState parsePrecheck(String body) {
+        Object parsed;
+        try {
+            parsed = JsonParser.parse(body);
+        } catch (JsonFailure failure) {
+            throw new ProtocolException("precheck response is not valid JSON");
+        }
+        if (!(parsed instanceof Map<?, ?> root)) {
+            throw new ProtocolException(
+                    "precheck response must be a JSON object");
+        }
+        Object stateObject = root.get("tier1_state");
+        if (!(stateObject instanceof Map<?, ?> stateMap)) {
+            throw new ProtocolException(
+                    "precheck response must contain tier1_state");
+        }
+        Object stateValue = stateMap.get("state");
+        if (!(stateValue instanceof String state) || state.isBlank()) {
+            throw new ProtocolException(
+                    "tier1_state.state must be a non-empty string");
+        }
+
+        Long failureCode = null;
+        if (stateMap.containsKey("failure_code")
+                && stateMap.get("failure_code") != null) {
+            Object value = stateMap.get("failure_code");
+            if (!(value instanceof Long integral)) {
+                throw new ProtocolException(
+                        "tier1_state.failure_code must be integral");
+            }
+            failureCode = integral;
+        }
+        String failureMessage = null;
+        if (stateMap.containsKey("failure_message")
+                && stateMap.get("failure_message") != null) {
+            Object value = stateMap.get("failure_message");
+            if (!(value instanceof String message)) {
+                throw new ProtocolException(
+                        "tier1_state.failure_message must be a string");
+            }
+            failureMessage = message;
+        }
+        return new PrecheckState(state, failureCode, failureMessage);
+    }

+    private static final class JsonFailure extends Exception {
+        private static final long serialVersionUID = 1L;
+
+        JsonFailure(String message) {
+            super(message);
+        }
+    }
+
+    private static final class JsonParser {
+        private final String input;
+        private int index;
+
+        private JsonParser(String input) {
+            this.input = input;
+        }
+
+        static Object parse(String input) throws JsonFailure {
+            if (input == null) {
+                throw new JsonFailure("null input");
+            }
+            JsonParser parser = new JsonParser(input);
+            Object result = parser.value();
+            parser.whitespace();
+            if (parser.index != input.length()) {
+                throw new JsonFailure("trailing data");
+            }
+            return result;
+        }
+
+        private Object value() throws JsonFailure {
+            whitespace();
+            if (index >= input.length()) {
+                throw new JsonFailure("expected value");
+            }
+            return switch (input.charAt(index)) {
+                case '{' -> object();
+                case '[' -> array();
+                case '"' -> string();
+                case 't' -> literal("true", Boolean.TRUE);
+                case 'f' -> literal("false", Boolean.FALSE);
+                case 'n' -> literal("null", null);
+                default -> number();
+            };
+        }
+
+        private Map<String, Object> object() throws JsonFailure {
+            index++;
+            LinkedHashMap<String, Object> result = new LinkedHashMap<>();
+            whitespace();
+            if (take('}')) {
+                return result;
+            }
+            while (true) {
+                whitespace();
+                if (index >= input.length() || input.charAt(index) != '"') {
+                    throw new JsonFailure("expected object key");
+                }
+                String key = string();
+                whitespace();
+                require(':');
+                Object value = value();
+                if (result.putIfAbsent(key, value) != null) {
+                    throw new JsonFailure("duplicate object key");
+                }
+                whitespace();
+                if (take('}')) {
+                    return result;
+                }
+                require(',');
+            }
+        }
+
+        private List<Object> array() throws JsonFailure {
+            index++;
+            List<Object> result = new ArrayList<>();
+            whitespace();
+            if (take(']')) {
+                return result;
+            }
+            while (true) {
+                result.add(value());
+                whitespace();
+                if (take(']')) {
+                    return result;
+                }
+                require(',');
+            }
+        }
+
+        private String string() throws JsonFailure {
+            require('"');
+            StringBuilder result = new StringBuilder();
+            while (index < input.length()) {
+                char character = input.charAt(index++);
+                if (character == '"') {
+                    return result.toString();
+                }
+                if (character < 0x20) {
+                    throw new JsonFailure("unescaped control character");
+                }
+                if (character != '\\') {
+                    result.append(character);
+                    continue;
+                }
+                if (index >= input.length()) {
+                    throw new JsonFailure("incomplete escape");
+                }
+                char escape = input.charAt(index++);
+                switch (escape) {
+                    case '"' -> result.append('"');
+                    case '\\' -> result.append('\\');
+                    case '/' -> result.append('/');
+                    case 'b' -> result.append('\b');
+                    case 'f' -> result.append('\f');
+                    case 'n' -> result.append('\n');
+                    case 'r' -> result.append('\r');
+                    case 't' -> result.append('\t');
+                    case 'u' -> result.append(unicodeEscape());
+                    default -> throw new JsonFailure("invalid escape");
+                }
+            }
+            throw new JsonFailure("unterminated string");
+        }
+
+        private char unicodeEscape() throws JsonFailure {
+            if (index + 4 > input.length()) {
+                throw new JsonFailure("incomplete unicode escape");
+            }
+            int value = 0;
+            for (int count = 0; count < 4; count++) {
+                int digit = Character.digit(input.charAt(index++), 16);
+                if (digit < 0) {
+                    throw new JsonFailure("invalid unicode escape");
+                }
+                value = (value << 4) | digit;
+            }
+            return (char) value;
+        }
+
+        private Object literal(String text, Object value) throws JsonFailure {
+            if (!input.startsWith(text, index)) {
+                throw new JsonFailure("invalid literal");
+            }
+            index += text.length();
+            return value;
+        }
+
+        private Number number() throws JsonFailure {
+            int start = index;
+            take('-');
+            if (take('0')) {
+                if (index < input.length()
+                        && Character.isDigit(input.charAt(index))) {
+                    throw new JsonFailure("leading zero");
+                }
+            } else {
+                digits();
+            }
+            boolean integral = true;
+            if (take('.')) {
+                integral = false;
+                digits();
+            }
+            if (take('e') || take('E')) {
+                integral = false;
+                if (!take('+')) {
+                    take('-');
+                }
+                digits();
+            }
+            String text = input.substring(start, index);
+            try {
+                if (integral) {
+                    return Long.valueOf(text);
+                }
+                return Double.valueOf(text);
+            } catch (NumberFormatException exception) {
+                throw new JsonFailure("invalid number");
+            }
+        }
+
+        private void digits() throws JsonFailure {
+            int start = index;
+            while (index < input.length()
+                    && Character.isDigit(input.charAt(index))) {
+                index++;
+            }
+            if (start == index) {
+                throw new JsonFailure("expected digit");
+            }
+        }
+
+        private void whitespace() {
+            while (index < input.length()) {
+                char character = input.charAt(index);
+                if (character == ' '
+                        || character == '\n'
+                        || character == '\r'
+                        || character == '\t') {
+                    index++;
+                } else {
+                    return;
+                }
+            }
+        }
+
+        private boolean take(char expected) {
+            if (index < input.length() && input.charAt(index) == expected) {
+                index++;
+                return true;
+            }
+            return false;
+        }
+
+        private void require(char expected) throws JsonFailure {
+            if (!take(expected)) {
+                throw new JsonFailure("expected '" + expected + "'");
+            }
+        }
     }

{
  "title": "VMware Cloud Foundation Operations for Networks API Reference",
  "version": "9.0.0.0",
  "derivation": "Normalized operation and wire-schema subset of the pinned OpenAPI specification",
  "server_base_path": "/api/ni",
  "security_scheme": {
    "type": "apiKey",
    "in": "header",
    "name": "Authorization",
    "description": "API Key - NetworkInsight {token}"
  },
  "operations": [
    {
      "operationId": "create",
      "method": "POST",
      "path": "/auth/token",
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": {
          "name": "UserCredential",
          "type": "object",
          "properties": {
            "username": { "type": "string" },
            "password": { "type": "string" },
            "domain": {
              "type": "object",
              "properties": {
                "domain_type": {
                  "type": "string",
                  "nullable": true,
                  "enum": ["LDAP", "LOCAL"]
                },
                "value": { "type": "string" }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "content_type": "application/json",
          "schema": {
            "name": "Token",
            "properties": {
              "token": { "type": "string" },
              "expiry": { "type": "integer", "format": "int64" }
            }
          }
        },
        "400": {
          "content_type": "application/json",
          "schema": "ApiError"
        },
        "401": { "content": {} },
        "500": { "content": {} }
      }
    },
    {
      "operationId": "addApplication",
      "method": "POST",
      "path": "/groups/applications",
      "security": "ApiKeyAuth",
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": {
          "name": "ApplicationRequest",
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" }
          }
        }
      },
      "responses": {
        "201": {
          "content_type": "application/json",
          "schema": "Application"
        },
        "400": {
          "content_type": "application/json",
          "schema": "ApiError"
        },
        "401": { "content": {} },
        "500": { "content": {} }
      }
    },
    {
      "operationId": "getApplicationById",
      "method": "GET",
      "path": "/groups/applications/{id}",
      "security": "ApiKeyAuth",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        },
        {
          "name": "fetch_member_counts",
          "in": "query",
          "required": false,
          "schema": { "type": "boolean" }
        },
        {
          "name": "fetch_update_status",
          "in": "query",
          "required": false,
          "schema": { "type": "boolean" }
        }
      ],
      "responses": {
        "200": {
          "content_type": "application/json",
          "schema": "Application"
        },
        "401": { "content": {} },
        "404": { "content": {} },
        "500": { "content": {} }
      }
    }
  ],
  "schemas": {
    "Application": {
      "allOf": ["BaseEntity"],
      "properties": {
        "create_time": { "type": "integer", "format": "int64" },
        "created_by": { "type": "string" },
        "last_modified_time": { "type": "integer", "format": "int64" },
        "last_modified_by": { "type": "string" },
        "last_modified_by_service": { "type": "string" },
        "tier_count": { "type": "integer", "format": "int32" },
        "member_count": { "type": "integer", "format": "int32" },
        "update_status": { "$ref": "UpdateStatus" },
        "confidence": { "type": "string" }
      }
    },
    "BaseEntity": {
      "type": "object",
      "properties": {
        "entity_id": { "type": "string" },
        "name": { "type": "string" },
        "entity_type": { "$ref": "EntityType" }
      },
      "discriminator": "entity_type"
    }
  }
}

{
  "site": {
    "siteId": "chi-management-01",
    "architecture": "single-site-consolidated",
    "hosts": [
      {"id": "esx-01", "vCpuCapacity": 64, "memoryGiBCapacity": 512},
      {"id": "esx-02", "vCpuCapacity": 64, "memoryGiBCapacity": 512},
      {"id": "esx-03", "vCpuCapacity": 64, "memoryGiBCapacity": 512},
      {"id": "esx-04", "vCpuCapacity": 64, "memoryGiBCapacity": 512}
    ]
  },
  "lifecycleManager": {
    "product": "VMware Aria Suite Lifecycle",
    "version": "8.18.0 Patch 2"
  },
  "products": [
    {
      "key": "operations",
      "product": "VMware Aria Operations",
      "version": "8.18.3",
      "scale": {"objects": 18000, "collectedMetrics": 2800000},
      "content": [
        "historical metrics",
        "dashboards",
        "views and reports",
        "super metrics",
        "policies and alert definitions",
        "supported management packs and adapter instances",
        "vRealize Operations Management Pack for VMware Integrated OpenStack 5.0"
      ]
    },
    {
      "key": "automation",
      "product": "VMware Aria Automation",
      "version": "8.18.1",
      "scale": {"managedDeployments": 420, "dailyRequests": 75},
      "content": [
        "projects and users",
        "cloud accounts using NSX Policy mode",
        "cloud templates and version history",
        "existing deployments",
        "subscriptions and ABX actions",
        "embedded Orchestrator workflows",
        "legacy VMware Identity Manager integration",
        "legacy /csp/ login bookmarks"
      ]
    },
    {
      "key": "logs",
      "product": "VMware Aria Operations for Logs",
      "version": "8.18.3",
      "scale": {"ingestGiBPerDay": 60, "retainedDays": 365},
      "content": [
        "last 90 days of historical log data",
        "content packs",
        "dashboards and alerts",
        "agent configuration",
        "vSphere and VCF integrations reconfigured on the target",
        "historical log data older than 90 days",
        "8.18.3 cluster after the agreed retention window"
      ]
    }
  ]
}

{
  "snapshotDate": "2026-03-31",
  "targetPlatform": "VMware Cloud Foundation 9.0.2",
  "topology": {
    "architecture": "single-site-consolidated",
    "minimumHostCount": 4,
    "failuresToTolerate": 1,
    "storagePolicy": "vSAN RAID-1 FTT=1",
    "replicaPlacement": "distinct-hosts"
  },
  "deployments": [
    {
      "id": "fleet-management",
      "component": "VCF Operations Fleet Management",
      "version": "9.0.2",
      "size": {"profile": "standard", "nodeCount": 1, "vCpuPerNode": 4, "memoryGiBPerNode": 16, "diskGiBPerNode": 250}
    },
    {
      "id": "operations",
      "component": "VCF Operations",
      "version": "9.0.2",
      "size": {"profile": "medium", "nodeCount": 3, "vCpuPerNode": 8, "memoryGiBPerNode": 32, "diskGiBPerNode": 1200}
    },
    {
      "id": "automation",
      "component": "VCF Automation",
      "version": "9.0.2",
      "size": {"profile": "clustered", "nodeCount": 3, "vCpuPerNode": 12, "memoryGiBPerNode": 42, "diskGiBPerNode": 246}
    },
    {
      "id": "logs",
      "component": "VCF Operations for Logs",
      "version": "9.0.2",
      "size": {"profile": "medium", "nodeCount": 3, "vCpuPerNode": 8, "memoryGiBPerNode": 16, "diskGiBPerNode": 4096}
    }
  ],
  "supportBoundaries": [
    {"sourceKey": "operations", "sourceProduct": "VMware Aria Operations", "sourceVersion": "8.18.3", "endOfGeneralSupport": "2027-10-11", "assessmentAtSnapshot": "IN_GENERAL_SUPPORT"},
    {"sourceKey": "automation", "sourceProduct": "VMware Aria Automation", "sourceVersion": "8.18.1", "endOfGeneralSupport": "2027-10-11", "assessmentAtSnapshot": "IN_GENERAL_SUPPORT"},
    {"sourceKey": "logs", "sourceProduct": "VMware Aria Operations for Logs", "sourceVersion": "8.18.3", "endOfGeneralSupport": "2027-10-11", "assessmentAtSnapshot": "IN_GENERAL_SUPPORT"}
  ],
  "migrationRules": [
    {
      "order": 1,
      "sourceKey": "operations",
      "targetDeployment": "operations",
      "mode": "in-place-upgrade-via-fleet-management",
      "dependsOn": ["fleet-management"],
      "carries": [
        "historical metrics",
        "dashboards",
        "views and reports",
        "super metrics",
        "policies and alert definitions",
        "supported management packs and adapter instances"
      ],
      "abandons": [
        "vRealize Operations Management Pack for VMware Integrated OpenStack 5.0"
      ],
      "gates": [
        "Aria Suite Lifecycle is 8.18.0 Patch 2",
        "offline snapshots exist for every Operations cluster node",
        "cluster health and upgrade prechecks pass",
        "VCF Operations 9.0.2 PAK signature checking remains enabled"
      ]
    },
    {
      "order": 2,
      "sourceKey": "automation",
      "targetDeployment": "automation",
      "mode": "import-then-upgrade-via-fleet-management",
      "dependsOn": ["operations"],
      "carries": [
        "projects and users",
        "cloud accounts using NSX Policy mode",
        "cloud templates and version history",
        "existing deployments",
        "subscriptions and ABX actions",
        "embedded Orchestrator workflows"
      ],
      "abandons": [
        "legacy VMware Identity Manager integration",
        "legacy /csp/ login bookmarks"
      ],
      "gates": [
        "Aria Automation inventory sync records vCenter by FQDN",
        "VCF Operations Fleet Management imports the 8.18.1 environment",
        "NSX cloud accounts are verified in Policy mode",
        "backup and upgrade prechecks pass",
        "vRO action return types match cloud template input formats"
      ]
    },
    {
      "order": 3,
      "sourceKey": "logs",
      "targetDeployment": "logs",
      "mode": "parallel-fresh-deployment",
      "dependsOn": ["automation"],
      "carries": [
        "last 90 days of historical log data",
        "content packs",
        "dashboards and alerts",
        "agent configuration",
        "vSphere and VCF integrations reconfigured on the target"
      ],
      "abandons": [
        "historical log data older than 90 days",
        "8.18.3 cluster after the agreed retention window"
      ],
      "gates": [
        "new 9.0.2 cluster is healthy and sized for 60 GiB/day",
        "backup exists for the 8.18.3 cluster",
        "source integrations are unconfigured before target integrations are enabled",
        "agents and senders are retargeted and ingestion is validated",
        "90-day data transfer completes before source retirement"
      ]
    }
  ]
}

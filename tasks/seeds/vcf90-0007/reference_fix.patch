+$script:NonTerminalStatus = @('PENDING', 'IN_PROGRESS')
+$script:SuccessfulStatus = @('SUCCESSFUL')
+$script:FailedStatus = @('FAILED', 'USER_CANCELLED', 'INCONSISTENT')
+
+function ConvertTo-VcfRotationStatus {
+    param([AllowNull()] [string] $Status)
+
+    if ([string]::IsNullOrWhiteSpace($Status)) { return '' }
+    return $Status.Trim().ToUpperInvariant().Replace(' ', '_')
+}
+
+function Invoke-VcfRotationWait {
+    param(
+        [int] $Seconds,
+        [AllowNull()] [scriptblock] $SleepAction
+    )
+
+    if ($null -ne $SleepAction) {
+        & $SleepAction $Seconds | Out-Null
+        return
+    }
+    if ($Seconds -gt 0) { Start-Sleep -Seconds $Seconds }
+}
+
+function Get-VcfRotationTaskError {
+    param([Parameter(Mandatory)] $Task)
+
+    $result = [pscustomobject]@{
+        ErrorCode = ''
+        Message   = ''
+    }
+    if ($Task.PSObject.Properties.Name -notcontains 'errors') { return $result }
+    $errors = @($Task.errors)
+    if ($errors.Count -eq 0 -or $null -eq $errors[0]) { return $result }
+    $first = $errors[0]
+    if ($first.PSObject.Properties.Name -contains 'errorCode' -and
+        -not [string]::IsNullOrWhiteSpace([string] $first.errorCode)) {
+        $result.ErrorCode = [string] $first.errorCode
+    }
+    if ($first.PSObject.Properties.Name -contains 'message' -and
+        -not [string]::IsNullOrWhiteSpace([string] $first.message)) {
+        $result.Message = [string] $first.message
+    }
+    return $result
+}

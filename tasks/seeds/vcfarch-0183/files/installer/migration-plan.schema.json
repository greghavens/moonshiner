{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Northstar VCF migration plan installer specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "design_id",
    "inventory_id",
    "compatibility_snapshot_id",
    "research",
    "placements",
    "migrations",
    "steps"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "design_id": {"type": "string", "minLength": 3},
    "inventory_id": {"type": "string", "minLength": 3},
    "compatibility_snapshot_id": {"type": "string", "minLength": 3},
    "research": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/research_source"}
    },
    "placements": {
      "type": "array",
      "minItems": 6,
      "items": {"$ref": "#/$defs/placement"}
    },
    "migrations": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/migration"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "research_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "publisher", "locator", "accessed_on", "used_for"],
      "properties": {
        "title": {"type": "string", "minLength": 3},
        "publisher": {"const": "Broadcom"},
        "locator": {"type": "string", "format": "uri", "minLength": 12},
        "accessed_on": {"type": "string", "format": "date"},
        "used_for": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "version",
        "domain",
        "cluster",
        "network",
        "deployment_model",
        "size",
        "quantity",
        "basis"
      ],
      "properties": {
        "component": {"type": "string", "minLength": 3},
        "version": {"type": "string", "minLength": 3},
        "domain": {"type": "string", "minLength": 3},
        "cluster": {"type": "string", "minLength": 3},
        "network": {"type": "string", "minLength": 3},
        "deployment_model": {"type": "string", "minLength": 3},
        "size": {"type": "string", "minLength": 3},
        "quantity": {"type": "integer", "minimum": 1},
        "per_node": {"$ref": "#/$defs/resources"},
        "basis": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/capacity_basis"}
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vcpu", "memory_gib", "data_disk_tib"],
      "properties": {
        "vcpu": {"type": "integer", "minimum": 1},
        "memory_gib": {"type": "integer", "minimum": 1},
        "data_disk_tib": {"type": "integer", "minimum": 1}
      }
    },
    "capacity_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "required", "supported"],
      "properties": {
        "metric": {"type": "string", "minLength": 3},
        "required": {"type": "integer", "minimum": 1},
        "supported": {"type": "integer", "minimum": 1}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "version"],
      "properties": {
        "product": {"type": "string", "minLength": 3},
        "component": {"type": "string", "minLength": 3},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "target_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": {"type": "string", "minLength": 3},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "carry_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "mode"],
      "properties": {
        "item": {"type": "string", "minLength": 3},
        "mode": {"type": "string", "minLength": 3}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_product_id",
        "source",
        "target",
        "end_of_general_support",
        "supported_path",
        "carry_forward",
        "abandon",
        "step_ids"
      ],
      "properties": {
        "inventory_product_id": {"type": "string", "minLength": 3},
        "source": {"$ref": "#/$defs/endpoint"},
        "target": {"$ref": "#/$defs/target_endpoint"},
        "end_of_general_support": {"type": "string", "format": "date"},
        "supported_path": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "carry_forward": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/carry_item"}
        },
        "abandon": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 3}
        },
        "step_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 3},
        "evidence": {"type": "string", "minLength": 3}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "id", "action", "entry_gates", "exit_gates"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "id": {"type": "string", "minLength": 3},
        "action": {"type": "string", "minLength": 8},
        "entry_gates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/gate"}
        },
        "exit_gates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/gate"}
        }
      }
    }
  }
}

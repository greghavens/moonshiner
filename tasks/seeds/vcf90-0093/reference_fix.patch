 // ListAllEvents retrieves every event after the exclusive timestamp boundary.
 func (c *Client) ListAllEvents(ctx context.Context, afterTimestamp int64, pageSize int) ([]Event, error) {
-	return nil, errors.New("ListAllEvents is not implemented")
+	if pageSize <= 0 {
+		return nil, errors.New("page size must be positive")
+	}
+	base, err := url.Parse(c.baseURL)
+	if err != nil {
+		return nil, fmt.Errorf("parse base URL: %w", err)
+	}
+
+	lower := afterTimestamp
+	var events []Event
+	for {
+		endpoint := *base
+		endpoint.Path = strings.TrimRight(endpoint.Path, "/") +
+			"/api/v2/events/timestamp/GT " + strconv.FormatInt(lower, 10)
+		query := make(url.Values)
+		query.Set("limit", strconv.Itoa(pageSize))
+		query.Set("order-by-direction", "ASC")
+		endpoint.RawQuery = query.Encode()
+
+		request, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint.String(), nil)
+		if err != nil {
+			return nil, fmt.Errorf("create events request: %w", err)
+		}
+		request.Header.Set("Authorization", "Bearer "+c.sessionID)
+		request.Header.Set("Accept", "application/json")
+
+		response, err := c.http.Do(request)
+		if err != nil {
+			return nil, fmt.Errorf("retrieve events: %w", err)
+		}
+		var page struct {
+			Complete bool    `json:"complete"`
+			Events   []Event `json:"events"`
+		}
+		decoder := json.NewDecoder(response.Body)
+		decodeErr := decoder.Decode(&page)
+		if decodeErr == nil {
+			var trailing any
+			if err := decoder.Decode(&trailing); err != io.EOF {
+				decodeErr = errors.New("response contains trailing content")
+			}
+		}
+		closeErr := response.Body.Close()
+		if response.StatusCode < 200 || response.StatusCode >= 300 {
+			return nil, fmt.Errorf("retrieve events: unexpected HTTP status %s", response.Status)
+		}
+		if decodeErr != nil {
+			return nil, fmt.Errorf("decode events response: %w", decodeErr)
+		}
+		if closeErr != nil {
+			return nil, fmt.Errorf("close events response: %w", closeErr)
+		}
+		if !page.Complete {
+			return nil, errors.New("events response is incomplete")
+		}
+
+		next := lower
+		if len(page.Events) > 0 {
+			next = page.Events[len(page.Events)-1].Timestamp
+			if next <= lower {
+				return nil, errors.New("events page did not advance timestamp boundary")
+			}
+		}
+
+		events = append(events, page.Events...)
+		if len(page.Events) < pageSize {
+			break
+		}
+		lower = next
+	}
+
+	sort.SliceStable(events, func(i, j int) bool {
+		if events[i].Timestamp == events[j].Timestamp {
+			return events[i].Text < events[j].Text
+		}
+		return events[i].Timestamp < events[j].Timestamp
+	})
+	return events, nil
 }

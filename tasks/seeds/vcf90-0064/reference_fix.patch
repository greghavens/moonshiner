diff --git a/module/VcfOpsMaintenanceWindow/VcfOpsMaintenanceWindow.psm1 b/module/VcfOpsMaintenanceWindow/VcfOpsMaintenanceWindow.psm1
index 9bf7498..e46e03b 100644
--- a/module/VcfOpsMaintenanceWindow/VcfOpsMaintenanceWindow.psm1
+++ b/module/VcfOpsMaintenanceWindow/VcfOpsMaintenanceWindow.psm1
@@ -34,48 +34,168 @@ Import-Module -Name 'VMware.Sdk.Vcf.Ops' -ErrorAction Stop
     with an ErrorCode (the HTTP status) and an ErrorContent (the response body).
 #>
 
+<#
+    Builds the schedule request model.
+
+    Only the members the caller actually bound are passed on to
+    Initialize-VcfOpsschedule. An unbound optional parameter is left out of the
+    splat entirely, which is what keeps it off the wire: passing $null, '' or @()
+    would serialize as null, "" or [] rather than being omitted.
+#>
+function New-ScheduleModel {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)] [hashtable] $Bound,
+        [Parameter(Mandatory)] [int] $Hour,
+        [Parameter(Mandatory)] [int] $MinuteOfTheHour,
+        [Parameter(Mandatory)] [int] $DurationMinutes,
+        [Parameter(Mandatory)] [string] $ScheduleType
+    )
+
+    $parameters = @{
+        Hour            = $Hour
+        MinuteOfTheHour = $MinuteOfTheHour
+        Duration        = $DurationMinutes
+        ScheduleType    = $ScheduleType
+    }
+
+    # Parameter name on this function -> member name on the schedule schema.
+    $optional = [ordered] @{
+        Recurrence     = 'Recurrence'
+        DaysOfTheWeek  = 'DaysOfTheWeek'
+        StartDate      = 'StartDate'
+        ExpirationDate = 'ExpirationDate'
+        ExpireRuns     = 'ExpireRuns'
+        TimeZone       = 'TimeZone'
+    }
+    foreach ($name in $optional.Keys) {
+        if ($Bound.ContainsKey($name)) {
+            $parameters[$optional[$name]] = $Bound[$name]
+        }
+    }
+
+    return Initialize-VcfOpsschedule @parameters
+}
+
+<#
+    Two schedules are the same when the bodies they serialize to are the same.
+    Comparing the SDK's own serialization -- rather than a hand-rolled property
+    walk -- means a member the caller did not supply counts as different from a
+    member the service is holding, which is the distinction that decides whether
+    a write is needed at all.
+#>
+function Test-ScheduleMatches {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)] $Desired,
+        [Parameter()] $Existing
+    )
+
+    if ($null -eq $Existing) { return $false }
+    return ($Desired.ToJson() -ceq $Existing.ToJson())
+}
+
 function Set-VcfOpsMaintenanceSchedule {
+    <#
+        .SYNOPSIS
+        Reconciles one VCF Operations maintenance schedule to the requested state.
+
+        .DESCRIPTION
+        Looks the key up first, then creates it when it is missing, updates it
+        when it has drifted, and writes nothing when it is already correct. The
+        key is unique within VCF Operations, so a blind create would draw the
+        422 the specification defines for a key that already exists; looking
+        first is what makes the run safe to repeat.
+    #>
     [CmdletBinding()]
     param(
         [Parameter(Mandatory)]
         $Server,
 
         [Parameter(Mandatory)]
         [string] $Key,
 
         [Parameter(Mandatory)]
         [int] $Hour,
 
         [Parameter(Mandatory)]
         [int] $MinuteOfTheHour,
 
         [Parameter(Mandatory)]
         [int] $DurationMinutes,
 
         [Parameter(Mandatory)]
         [string] $ScheduleType,
 
         [Parameter()]
         [int] $Recurrence,
 
         [Parameter()]
         [string[]] $DaysOfTheWeek,
 
         [Parameter()]
         [string] $StartDate,
 
         [Parameter()]
         [string] $ExpirationDate,
 
         [Parameter()]
         [int] $ExpireRuns,
 
         [Parameter()]
         [string] $TimeZone
     )
 
-    throw [System.NotImplementedException]::new(
-        'Set-VcfOpsMaintenanceSchedule is not implemented yet.')
+    $desired = New-ScheduleModel -Bound $PSBoundParameters `
+        -Hour $Hour -MinuteOfTheHour $MinuteOfTheHour `
+        -DurationMinutes $DurationMinutes -ScheduleType $ScheduleType
+
+    # Filter server-side on the key. name is the only query parameter this
+    # lookup needs, so nothing else is put on the request target.
+    $listed = Invoke-VcfOpsGetMaintenanceSchedules -Server $Server -Name @($Key)
+
+    $existing = @()
+    if ($null -ne $listed -and $null -ne $listed.Schedules) {
+        # The filter is the service's; the exact-key match is ours, so a
+        # near-miss can never be mistaken for the schedule being reconciled.
+        $existing = @($listed.Schedules | Where-Object { $_.Key -ceq $Key })
+    }
+
+    if ($existing.Count -gt 1) {
+        throw [System.InvalidOperationException]::new(
+            ("VCF Operations returned {0} maintenance schedules for key '{1}'. " +
+             'The key is unique, so this is refused rather than guessed at.') -f $existing.Count, $Key)
+    }
+
+    if ($existing.Count -eq 0) {
+        $model = Initialize-VcfOpsmaintenanceschedule -Key $Key -Schedule $desired
+        $created = Invoke-VcfOpsCreateMaintenanceSchedules -Server $Server -MaintenanceSchedule $model
+        return [pscustomobject] [ordered] @{
+            Key        = $Key
+            ScheduleId = [string] $created.Id
+            Outcome    = 'Created'
+        }
+    }
+
+    $current = $existing[0]
+    if (Test-ScheduleMatches -Desired $desired -Existing $current.Schedule) {
+        return [pscustomobject] [ordered] @{
+            Key        = $Key
+            ScheduleId = [string] $current.Id
+            Outcome    = 'Unchanged'
+        }
+    }
+
+    # The id is what turns the write into an update of the schedule that is
+    # already there instead of a second one alongside it.
+    $model = Initialize-VcfOpsmaintenanceschedule -Id $current.Id -Key $Key -Schedule $desired
+    Invoke-VcfOpsUpdateMaintenanceSchedules -Server $Server -MaintenanceSchedule $model | Out-Null
+
+    return [pscustomobject] [ordered] @{
+        Key        = $Key
+        ScheduleId = [string] $current.Id
+        Outcome    = 'Updated'
+    }
 }
 
 Export-ModuleMember -Function 'Set-VcfOpsMaintenanceSchedule'

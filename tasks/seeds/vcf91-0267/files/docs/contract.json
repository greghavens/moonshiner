{
  "contractVersion": "1.0.0",
  "description": "Wire contract for the VCF Operations report-generation flow. Every operation, path, parameter and schema property below was extracted from the OpenAPI specification named in docs/official_sources.json. Do not edit; the mock and the verifier are both pinned to it.",
  "api": {
    "title": "VMware Cloud Foundation Operations API",
    "version": "9.1.0.0",
    "openapi": "3.0.1",
    "basePath": "/suite-api"
  },
  "authorization": {
    "schemeName": "Token-based-authorization",
    "type": "apiKey",
    "in": "header",
    "headerName": "Authorization",
    "headerValueTemplate": "vRealizeOpsToken {token}",
    "headerValueTemplateProvenance": "Deployment convention for this scenario, NOT taken from the specification. The specification only declares an apiKey scheme carried in the Authorization header.",
    "appliesTo": [
      "createReport",
      "getReport",
      "downloadReport"
    ],
    "exemptOperations": [
      "acquireToken"
    ]
  },
  "operations": {
    "acquireToken": {
      "operationId": "acquireToken",
      "method": "POST",
      "path": "/api/auth/token/acquire",
      "summary": "Acquire a token to perform REST API calls",
      "pathParameters": [],
      "queryParameters": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "username-password",
        "requiredProperties": [
          "password",
          "username"
        ],
        "allowedProperties": [
          "username",
          "password",
          "authSource"
        ]
      },
      "responses": {
        "200": {
          "description": "The token and expiry time of the token",
          "contentTypes": [
            "application/json",
            "application/xml"
          ],
          "schema": "auth-token"
        },
        "401": {
          "description": "Authentication failed",
          "contentTypes": []
        }
      }
    },
    "createReport": {
      "operationId": "createReport",
      "method": "POST",
      "path": "/api/reports",
      "summary": "Generate (create) a Report using the specified Report Definition and for the specified Resource",
      "pathParameters": [],
      "queryParameters": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "report",
        "requiredProperties": [
          "reportDefinitionId",
          "resourceId"
        ],
        "allowedProperties": [
          "reportDefinitionId",
          "resourceId",
          "name",
          "description",
          "subject",
          "publish",
          "traversalSpec"
        ]
      },
      "responses": {
        "200": {
          "description": "The Generated Report",
          "contentTypes": [
            "application/json",
            "application/xml"
          ],
          "schema": "report"
        }
      }
    },
    "getReport": {
      "operationId": "getReport",
      "method": "GET",
      "path": "/api/reports/{id}",
      "summary": "Get the detail of a Report given its identifier",
      "pathParameters": [
        {
          "name": "id",
          "required": true,
          "type": "string",
          "format": "uuid"
        }
      ],
      "queryParameters": [],
      "requestBody": null,
      "responses": {
        "200": {
          "description": "The details of the Report",
          "contentTypes": [
            "application/json",
            "application/xml"
          ],
          "schema": "report"
        }
      }
    },
    "downloadReport": {
      "operationId": "downloadReport",
      "method": "GET",
      "path": "/api/reports/{id}/download",
      "summary": "Download the Report given its identifier",
      "pathParameters": [
        {
          "name": "id",
          "required": true,
          "type": "string",
          "format": "uuid"
        }
      ],
      "queryParameters": [
        {
          "name": "format",
          "required": false,
          "type": "string"
        }
      ],
      "requestBody": null,
      "responses": {
        "200": {
          "description": "The link to download the report",
          "contentTypes": [
            "application/pdf",
            "text/csv"
          ]
        }
      }
    }
  },
  "schemas": {
    "username-password": {
      "authSource": {
        "required": false,
        "type": "string",
        "description": "The auth source name"
      },
      "password": {
        "required": true,
        "type": "string",
        "description": "The password"
      },
      "username": {
        "required": true,
        "type": "string",
        "description": "The username"
      }
    },
    "auth-token": {
      "expiresAt": {
        "required": false,
        "type": "string",
        "description": "Token expiration time, in easy to read string representation (since Jan 1, 1970)"
      },
      "roles": {
        "required": false,
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "List of roles the current user has"
      },
      "token": {
        "required": true,
        "type": "string",
        "description": "Auth token for accessing future rest API(s)"
      },
      "validity": {
        "required": true,
        "type": "integer",
        "format": "int64",
        "description": "Token expiration time in milliseconds (since Jan 1, 1970)"
      }
    },
    "report": {
      "completionTime": {
        "required": false,
        "type": "string",
        "description": "Time when the Report Generation completed."
      },
      "description": {
        "required": false,
        "type": "string",
        "description": "Description of the Report."
      },
      "id": {
        "required": false,
        "type": "string",
        "description": "Identifier of the Report."
      },
      "links": {
        "required": false,
        "type": "array",
        "items": {
          "schema": "link"
        },
        "description": ""
      },
      "name": {
        "required": false,
        "type": "string",
        "description": "Name of the Report."
      },
      "owner": {
        "required": false,
        "type": "string",
        "description": "Owner (user) who created/executed the Report Generation."
      },
      "publish": {
        "required": false,
        "type": "boolean",
        "description": "Whether the tenant report needs to be published for tenants."
      },
      "reportDefinitionId": {
        "required": true,
        "type": "string",
        "format": "uuid",
        "description": "Identifier of the Report Definition used to generate this Report."
      },
      "resourceId": {
        "required": true,
        "type": "string",
        "format": "uuid",
        "description": "Resource identifier for which the Report needs to be generated."
      },
      "status": {
        "required": false,
        "type": "string",
        "description": "Status of Report Generation - whether the Report got generated successfully or not."
      },
      "subject": {
        "required": false,
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Subjects of the Report."
      },
      "traversalSpec": {
        "required": false,
        "type": "object",
        "schema": "traversal-spec",
        "description": ""
      }
    },
    "traversal-spec": {
      "adapterInstanceAssociation": {
        "required": false,
        "type": "boolean",
        "description": "When true the traversal spec templates applies to adapter kind associations.  A traversal spec instance based on this template must specify the included adapter kinds it applies to."
      },
      "description": {
        "required": false,
        "type": "string",
        "description": "The description of the traversal spec"
      },
      "name": {
        "required": true,
        "type": "string",
        "description": "The name of the traversal spec"
      },
      "rootAdapterKindKey": {
        "required": false,
        "type": "string",
        "description": "The adapter kind of the root resource"
      },
      "rootResourceKindKey": {
        "required": false,
        "type": "string",
        "description": "The resource kind of the root resource."
      }
    }
  },
  "reportStatus": {
    "provenance": "The specification types report.status as a free-form string with no enum. The values below are fixed by this task scenario, not derived from the specification.",
    "nonTerminal": [
      "QUEUED",
      "RUNNING"
    ],
    "terminal": [
      "COMPLETED",
      "FAILED"
    ],
    "successful": "COMPLETED"
  },
  "omitEmptyRule": "An optional property or query parameter that the caller did not set MUST be absent from the serialized request. Sending it with an empty string, empty array, empty object, or a default false is a contract violation."
}
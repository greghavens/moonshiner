+func TestGenerateReportRejectsInvalidRequestsBeforeAnyCall(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name string
+		req  reportclient.ReportRequest
+	}{
+		{"missing definition", reportclient.ReportRequest{ResourceID: testResourceID}},
+		{"missing resource", reportclient.ReportRequest{ReportDefinitionID: testDefinitionID}},
+		{
+			name: "traversal spec without a name",
+			req: reportclient.ReportRequest{
+				ReportDefinitionID: testDefinitionID,
+				ResourceID:         testResourceID,
+				TraversalSpec:      &reportclient.TraversalSpec{RootAdapterKindKey: "VMWARE"},
+			},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			client, srv := newClient(t, mockops.Scenario{})
+
+			_, err := client.GenerateReport(context.Background(), tc.req, "")
+			if !errors.Is(err, reportclient.ErrInvalidRequest) {
+				t.Fatalf("GenerateReport error = %v, want errors.Is(err, ErrInvalidRequest)", err)
+			}
+			if got := srv.Requests(); len(got) != 0 {
+				t.Errorf("client made %d requests, want none", len(got))
+			}
+		})
+	}
+}

--- /dev/null
+++ b/reportclient/client.go
@@ -0,0 +1,391 @@
+package reportclient
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+)
+
+// Paths and statuses below mirror docs/contract.json, which was derived from the
+// VCF Operations OpenAPI specification recorded in docs/official_sources.json.
+const (
+	basePath = "/suite-api"
+
+	pathAcquireToken = basePath + "/api/auth/token/acquire"
+	pathReports      = basePath + "/api/reports"
+
+	authHeader        = "Authorization"
+	authValuePrefix   = "vRealizeOpsToken "
+	mediaTypeJSON     = "application/json"
+	mediaTypeDownload = "application/pdf, text/csv"
+
+	statusCompleted = "COMPLETED"
+	statusFailed    = "FAILED"
+
+	defaultPollInterval    = 5 * time.Second
+	defaultMaxPollAttempts = 60
+)
+
+// Sentinel errors, matchable with errors.Is.
+var (
+	// ErrInvalidRequest means the request was rejected locally, before any HTTP
+	// request was made.
+	ErrInvalidRequest = errors.New("reportclient: invalid request")
+	// ErrReportFailed means the report reached the FAILED terminal status.
+	ErrReportFailed = errors.New("reportclient: report generation failed")
+	// ErrPollTimeout means the report never reached a terminal status within the
+	// configured number of poll attempts.
+	ErrPollTimeout = errors.New("reportclient: report did not reach a terminal state")
+)
+
+// Config configures a Client.
+type Config struct {
+	// BaseURL is the appliance root, without the /suite-api base path.
+	BaseURL string
+	// Username and Password authenticate against acquireToken.
+	Username string
+	Password string
+	// AuthSource is optional. When empty it is omitted from the request body.
+	AuthSource string
+	// HTTPClient defaults to a client with a 30 second timeout.
+	HTTPClient *http.Client
+	// PollInterval is the wait between getReport polls. Defaults to 5s.
+	PollInterval time.Duration
+	// MaxPollAttempts bounds the number of getReport calls. Defaults to 60.
+	MaxPollAttempts int
+}
+
+// Client drives the report-generation flow against one appliance.
+type Client struct {
+	base            *url.URL
+	username        string
+	password        string
+	authSource      string
+	httpClient      *http.Client
+	pollInterval    time.Duration
+	maxPollAttempts int
+}
+
+// TraversalSpec selects the resource hierarchy a report is generated over.
+// Only Name is required; the remaining fields are omitted from the request when
+// left at their zero value.
+type TraversalSpec struct {
+	Name                       string
+	Description                string
+	RootAdapterKindKey         string
+	RootResourceKindKey        string
+	AdapterInstanceAssociation *bool
+}
+
+// ReportRequest describes a report to generate. ReportDefinitionID and
+// ResourceID are required; every other field is omitted from the request body
+// when unset. Publish is a pointer so that an explicit false is sent rather
+// than treated as unset.
+type ReportRequest struct {
+	ReportDefinitionID string
+	ResourceID         string
+	Name               string
+	Description        string
+	Subject            []string
+	Publish            *bool
+	TraversalSpec      *TraversalSpec
+}
+
+// Report is the appliance's view of a report.
+type Report struct {
+	ID                 string
+	Status             string
+	ReportDefinitionID string
+	ResourceID         string
+	Name               string
+	Owner              string
+	CompletionTime     string
+}
+
+// Result is a completed generation: the terminal report plus its downloaded
+// content.
+type Result struct {
+	Report      Report
+	Content     []byte
+	ContentType string
+	// PollCount is the number of getReport calls made.
+	PollCount int
+}
+
+// New builds a Client. It validates configuration but performs no I/O.
+func New(cfg Config) (*Client, error) {
+	if strings.TrimSpace(cfg.BaseURL) == "" {
+		return nil, fmt.Errorf("%w: BaseURL is required", ErrInvalidRequest)
+	}
+	base, err := url.Parse(strings.TrimRight(cfg.BaseURL, "/"))
+	if err != nil {
+		return nil, fmt.Errorf("%w: BaseURL %q: %v", ErrInvalidRequest, cfg.BaseURL, err)
+	}
+	if base.Scheme == "" || base.Host == "" {
+		return nil, fmt.Errorf("%w: BaseURL %q needs a scheme and host", ErrInvalidRequest, cfg.BaseURL)
+	}
+	if cfg.Username == "" || cfg.Password == "" {
+		return nil, fmt.Errorf("%w: Username and Password are required", ErrInvalidRequest)
+	}
+
+	c := &Client{
+		base:            base,
+		username:        cfg.Username,
+		password:        cfg.Password,
+		authSource:      cfg.AuthSource,
+		httpClient:      cfg.HTTPClient,
+		pollInterval:    cfg.PollInterval,
+		maxPollAttempts: cfg.MaxPollAttempts,
+	}
+	if c.httpClient == nil {
+		c.httpClient = &http.Client{Timeout: 30 * time.Second}
+	}
+	if c.pollInterval <= 0 {
+		c.pollInterval = defaultPollInterval
+	}
+	if c.maxPollAttempts <= 0 {
+		c.maxPollAttempts = defaultMaxPollAttempts
+	}
+	return c, nil
+}
+
+// GenerateReport runs the whole asynchronous flow: acquire a token, create the
+// report, poll it to a terminal status, and download it when it succeeded.
+//
+// format selects the download encoding ("csv" or "pdf"). When empty the format
+// query parameter is omitted and the appliance picks its default.
+//
+// A report that reaches FAILED returns ErrReportFailed and is never downloaded.
+// A report still non-terminal after MaxPollAttempts returns ErrPollTimeout.
+func (c *Client) GenerateReport(ctx context.Context, req ReportRequest, format string) (*Result, error) {
+	if err := req.validate(); err != nil {
+		return nil, err
+	}
+
+	token, err := c.acquireToken(ctx)
+	if err != nil {
+		return nil, err
+	}
+
+	created, err := c.createReport(ctx, token, req)
+	if err != nil {
+		return nil, err
+	}
+	if created.ID == "" {
+		return nil, fmt.Errorf("reportclient: createReport returned no report identifier")
+	}
+
+	// createReport only queues the work, so its status is never the outcome.
+	// Poll until the appliance reports a terminal status.
+	report, polls, err := c.pollToTerminal(ctx, token, created.ID)
+	if err != nil {
+		return nil, err
+	}
+
+	if report.Status == statusFailed {
+		return nil, fmt.Errorf("%w: report %s", ErrReportFailed, report.ID)
+	}
+
+	content, contentType, err := c.downloadReport(ctx, token, report.ID, format)
+	if err != nil {
+		return nil, err
+	}
+
+	return &Result{
+		Report:      report,
+		Content:     content,
+		ContentType: contentType,
+		PollCount:   polls,
+	}, nil
+}
+
+func (r ReportRequest) validate() error {
+	if r.ReportDefinitionID == "" {
+		return fmt.Errorf("%w: ReportDefinitionID is required", ErrInvalidRequest)
+	}
+	if r.ResourceID == "" {
+		return fmt.Errorf("%w: ResourceID is required", ErrInvalidRequest)
+	}
+	if r.TraversalSpec != nil && r.TraversalSpec.Name == "" {
+		return fmt.Errorf("%w: TraversalSpec.Name is required", ErrInvalidRequest)
+	}
+	return nil
+}
+
+func (c *Client) acquireToken(ctx context.Context) (string, error) {
+	body := credentialsWire{
+		AuthSource: c.authSource,
+		Password:   c.password,
+		Username:   c.username,
+	}
+	var out authTokenWire
+	if err := c.doJSON(ctx, http.MethodPost, c.url(pathAcquireToken, nil), "", body, &out); err != nil {
+		return "", fmt.Errorf("acquireToken: %w", err)
+	}
+	if out.Token == "" {
+		return "", fmt.Errorf("acquireToken: appliance returned an empty token")
+	}
+	return out.Token, nil
+}
+
+func (c *Client) createReport(ctx context.Context, token string, req ReportRequest) (Report, error) {
+	var out reportWire
+	if err := c.doJSON(ctx, http.MethodPost, c.url(pathReports, nil), token, req.wire(), &out); err != nil {
+		return Report{}, fmt.Errorf("createReport: %w", err)
+	}
+	return out.report(), nil
+}
+
+func (c *Client) pollToTerminal(ctx context.Context, token, reportID string) (Report, int, error) {
+	pollPath := pathReports + "/" + url.PathEscape(reportID)
+
+	var last Report
+	for attempt := 1; attempt <= c.maxPollAttempts; attempt++ {
+		if attempt > 1 {
+			if err := sleep(ctx, c.pollInterval); err != nil {
+				return Report{}, attempt - 1, err
+			}
+		}
+
+		var out reportWire
+		if err := c.doJSON(ctx, http.MethodGet, c.url(pollPath, nil), token, nil, &out); err != nil {
+			return Report{}, attempt, fmt.Errorf("getReport: %w", err)
+		}
+		last = out.report()
+
+		if isTerminal(last.Status) {
+			return last, attempt, nil
+		}
+	}
+
+	return last, c.maxPollAttempts, fmt.Errorf("%w: report %s was still %q after %d polls",
+		ErrPollTimeout, reportID, last.Status, c.maxPollAttempts)
+}
+
+func (c *Client) downloadReport(ctx context.Context, token, reportID, format string) ([]byte, string, error) {
+	// An unset format must not appear in the URL at all, so the query is only
+	// built when there is something to put in it.
+	var query url.Values
+	if format != "" {
+		query = url.Values{"format": []string{format}}
+	}
+	target := c.url(pathReports+"/"+url.PathEscape(reportID)+"/download", query)
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, target, nil)
+	if err != nil {
+		return nil, "", fmt.Errorf("downloadReport: %w", err)
+	}
+	req.Header.Set(authHeader, authValuePrefix+token)
+	req.Header.Set("Accept", mediaTypeDownload)
+
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return nil, "", fmt.Errorf("downloadReport: %w", err)
+	}
+	defer resp.Body.Close()
+
+	payload, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return nil, "", fmt.Errorf("downloadReport: read body: %w", err)
+	}
+	if resp.StatusCode < 200 || resp.StatusCode > 299 {
+		return nil, "", fmt.Errorf("downloadReport: %s", statusError(resp.StatusCode, payload))
+	}
+	return payload, resp.Header.Get("Content-Type"), nil
+}
+
+// url joins a contract path onto the base URL. query is omitted entirely when
+// empty, so the request carries no "?" at all.
+func (c *Client) url(path string, query url.Values) string {
+	u := *c.base
+	u.Path = strings.TrimRight(u.Path, "/") + path
+	if len(query) > 0 {
+		u.RawQuery = query.Encode()
+	}
+	return u.String()
+}
+
+// doJSON sends an optional JSON body and decodes an optional JSON response.
+// token is empty for operations the contract exempts from authorization.
+func (c *Client) doJSON(ctx context.Context, method, target, token string, in, out any) error {
+	var reader io.Reader
+	if in != nil {
+		encoded, err := json.Marshal(in)
+		if err != nil {
+			return fmt.Errorf("encode body: %w", err)
+		}
+		reader = bytes.NewReader(encoded)
+	}
+
+	req, err := http.NewRequestWithContext(ctx, method, target, reader)
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Accept", mediaTypeJSON)
+	if in != nil {
+		req.Header.Set("Content-Type", mediaTypeJSON)
+	}
+	if token != "" {
+		req.Header.Set(authHeader, authValuePrefix+token)
+	}
+
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+
+	payload, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return fmt.Errorf("read body: %w", err)
+	}
+	if resp.StatusCode < 200 || resp.StatusCode > 299 {
+		return statusError(resp.StatusCode, payload)
+	}
+	if out == nil {
+		return nil
+	}
+	if err := json.Unmarshal(payload, out); err != nil {
+		return fmt.Errorf("decode response: %w", err)
+	}
+	return nil
+}
+
+func isTerminal(status string) bool {
+	return status == statusCompleted || status == statusFailed
+}
+
+func sleep(ctx context.Context, d time.Duration) error {
+	timer := time.NewTimer(d)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-timer.C:
+		return nil
+	}
+}
+
+func statusError(code int, payload []byte) error {
+	var apiErr struct {
+		Message string `json:"message"`
+	}
+	if err := json.Unmarshal(payload, &apiErr); err == nil && apiErr.Message != "" {
+		return fmt.Errorf("appliance returned %d: %s", code, apiErr.Message)
+	}
+	snippet := strings.TrimSpace(string(payload))
+	if len(snippet) > 200 {
+		snippet = snippet[:200] + "..."
+	}
+	if snippet == "" {
+		return fmt.Errorf("appliance returned %d", code)
+	}
+	return fmt.Errorf("appliance returned %d: %s", code, snippet)
+}

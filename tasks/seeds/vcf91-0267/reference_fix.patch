+func TestGenerateReportStaysInsideTheContract(t *testing.T) {
+	t.Parallel()
+	client, srv := newClient(t, mockops.Scenario{PollStatuses: []string{"QUEUED", "COMPLETED"}})
+
+	if _, err := client.GenerateReport(context.Background(), reportclient.ReportRequest{
+		ReportDefinitionID: testDefinitionID,
+		ResourceID:         testResourceID,
+		Name:               "Weekly capacity",
+	}, "csv"); err != nil {
+		t.Fatalf("GenerateReport: %v", err)
+	}
+
+	seen := map[string]int{}
+	for _, r := range srv.Requests() {
+		if r.OperationID == "" {
+			t.Errorf("request %d %s %s matched no contract operation", r.Index, r.Method, r.Path)
+			continue
+		}
+		seen[r.OperationID]++
+	}
+
+	ids := make([]string, 0, len(seen))
+	for id := range seen {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	want := []string{"acquireToken", "createReport", "downloadReport", "getReport"}
+	if !reflect.DeepEqual(ids, want) {
+		t.Errorf("operations used = %v, want %v", ids, want)
+	}
+}

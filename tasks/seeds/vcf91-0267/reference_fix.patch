+		ResourceID:         testResourceID,
+	}, "")
+	if err == nil {
+		t.Fatal("GenerateReport succeeded with bad credentials, want an error")
+	}
+	if !strings.Contains(err.Error(), "acquireToken") {
+		t.Errorf("error = %v, want it to name the failing operation", err)
+	}
+	if got := len(srv.Requests()); got != 1 {
+		t.Errorf("client made %d requests, want 1; the flow must stop when the token cannot be acquired", got)
+	}
+}

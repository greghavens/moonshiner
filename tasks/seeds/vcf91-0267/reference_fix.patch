+// TestCreateReportBodyIsExactJSON pins the encoded bytes for the minimal
+// request, so a regression in field tagging shows up as a byte diff.
+func TestCreateReportBodyIsExactJSON(t *testing.T) {
+	t.Parallel()
+	client, srv := newClient(t, mockops.Scenario{PollStatuses: []string{"COMPLETED"}})
+
+	if _, err := client.GenerateReport(context.Background(), reportclient.ReportRequest{
+		ReportDefinitionID: testDefinitionID,
+		ResourceID:         testResourceID,
+	}, ""); err != nil {
+		t.Fatalf("GenerateReport: %v", err)
+	}
+
+	create := srv.RequestsFor("createReport")
+	if len(create) != 1 {
+		t.Fatalf("createReport called %d times, want 1", len(create))
+	}
+
+	var got, want any
+	if err := json.Unmarshal(create[0].Body, &got); err != nil {
+		t.Fatalf("decode sent body: %v", err)
+	}
+	if err := json.Unmarshal([]byte(`{"reportDefinitionId":"`+testDefinitionID+`","resourceId":"`+testResourceID+`"}`), &want); err != nil {
+		t.Fatalf("decode expected body: %v", err)
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("createReport body = %s, want %v", create[0].Body, want)
+	}
+}

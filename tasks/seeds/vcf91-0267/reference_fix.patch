+package reportclient_test
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"reflect"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	"vcfops.local/opsreport/internal/mockops"
+	"vcfops.local/opsreport/reportclient"
+)
+
+const (
+	testDefinitionID = "8b1c3a12-4f6d-4a1e-9c33-7d5e2b0a91f4"
+	testResourceID   = "2a7d5e90-1c4b-4e33-8f21-6b9a0d3c5e18"
+)
+
+func ptr[T any](v T) *T { return &v }
+
+// newClient boots a mock and returns a client wired to it.
+func newClient(t *testing.T, sc mockops.Scenario) (*reportclient.Client, *mockops.Server) {
+	t.Helper()
+	srv := mockops.Start(t, sc)
+	got := srv.Scenario()
+	client, err := reportclient.New(reportclient.Config{
+		BaseURL:         srv.URL(),
+		HTTPClient:      srv.Client(),
+		Username:        got.Username,
+		Password:        got.Password,
+		AuthSource:      got.AuthSource,
+		PollInterval:    time.Millisecond,
+		MaxPollAttempts: 10,
+	})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	return client, srv
+}
+
+func TestNewValidatesConfig(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name    string
+		cfg     reportclient.Config
+		wantErr bool
+	}{
+		{
+			name:    "complete config",
+			cfg:     reportclient.Config{BaseURL: "https://127.0.0.1:8443", Username: "u", Password: "p"},
+			wantErr: false,
+		},
+		{"no base url", reportclient.Config{Username: "u", Password: "p"}, true},
+		{"base url without scheme", reportclient.Config{BaseURL: "127.0.0.1:8443", Username: "u", Password: "p"}, true},
+		{"no username", reportclient.Config{BaseURL: "https://127.0.0.1:8443", Password: "p"}, true},
+		{"no password", reportclient.Config{BaseURL: "https://127.0.0.1:8443", Username: "u"}, true},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			client, err := reportclient.New(tc.cfg)
+			if tc.wantErr {
+				if err == nil {
+					t.Fatal("New succeeded, want an error")
+				}
+				if !errors.Is(err, reportclient.ErrInvalidRequest) {
+					t.Errorf("New error = %v, want errors.Is(err, ErrInvalidRequest)", err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("New: %v", err)
+			}
+			if client == nil {
+				t.Fatal("New returned a nil client and no error")
+			}
+		})
+	}
+}
+
+func TestGenerateReportSerializesOnlyTheFieldsThatWereSet(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name     string
+		req      reportclient.ReportRequest
+		wantKeys []string
+	}{
+		{
+			name:     "required fields only",
+			req:      reportclient.ReportRequest{ReportDefinitionID: testDefinitionID, ResourceID: testResourceID},
+			wantKeys: []string{"reportDefinitionId", "resourceId"},
+		},
+		{
+			name: "name only",
+			req: reportclient.ReportRequest{
+				ReportDefinitionID: testDefinitionID,
+				ResourceID:         testResourceID,
+				Name:               "Weekly capacity",
+			},
+			wantKeys: []string{"name", "reportDefinitionId", "resourceId"},
+		},
+		{
+			name: "publish false is still sent",
+			req: reportclient.ReportRequest{
+				ReportDefinitionID: testDefinitionID,
+				ResourceID:         testResourceID,
+				Publish:            ptr(false),
+			},
+			wantKeys: []string{"publish", "reportDefinitionId", "resourceId"},
+		},
+		{
+			name: "empty subject slice is omitted",
+			req: reportclient.ReportRequest{
+				ReportDefinitionID: testDefinitionID,
+				ResourceID:         testResourceID,
+				Subject:            []string{},
+			},
+			wantKeys: []string{"reportDefinitionId", "resourceId"},
+		},
+		{
+			name: "everything set",
+			req: reportclient.ReportRequest{
+				ReportDefinitionID: testDefinitionID,
+				ResourceID:         testResourceID,
+				Name:               "Weekly capacity",
+				Description:        "rollup",
+				Subject:            []string{"HostSystem"},
+				Publish:            ptr(true),
+				TraversalSpec:      &reportclient.TraversalSpec{Name: "vSphere Hosts and Clusters"},
+			},
+			wantKeys: []string{"description", "name", "publish", "reportDefinitionId", "resourceId", "subject", "traversalSpec"},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			client, srv := newClient(t, mockops.Scenario{PollStatuses: []string{"RUNNING", "COMPLETED"}})
+
+			if _, err := client.GenerateReport(context.Background(), tc.req, ""); err != nil {
+				t.Fatalf("GenerateReport: %v", err)
+			}
+
+			create := srv.RequestsFor("createReport")
+			if len(create) != 1 {
+				t.Fatalf("createReport called %d times, want 1", len(create))
+			}
+			got, err := create[0].BodyKeys()
+			if err != nil {
+				t.Fatalf("body keys: %v", err)
+			}
+			if !reflect.DeepEqual(got, tc.wantKeys) {
+				t.Errorf("createReport body keys = %v, want %v", got, tc.wantKeys)
+			}
+		})
+	}
+}
+
+func TestGenerateReportAuthSourceIsOptional(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name       string
+		authSource string
+		wantKeys   []string
+	}{
+		{"unset", "", []string{"password", "username"}},
+		{"set", "vIDMAuthSource", []string{"authSource", "password", "username"}},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			client, srv := newClient(t, mockops.Scenario{
+				AuthSource:   tc.authSource,
+				PollStatuses: []string{"COMPLETED"},
+			})
+
+			if _, err := client.GenerateReport(context.Background(), reportclient.ReportRequest{
+				ReportDefinitionID: testDefinitionID,
+				ResourceID:         testResourceID,
+			}, ""); err != nil {
+				t.Fatalf("GenerateReport: %v", err)
+			}
+
+			acquire := srv.RequestsFor("acquireToken")
+			if len(acquire) != 1 {
+				t.Fatalf("acquireToken called %d times, want 1", len(acquire))
+			}
+			got, err := acquire[0].BodyKeys()
+			if err != nil {
+				t.Fatalf("body keys: %v", err)
+			}
+			if !reflect.DeepEqual(got, tc.wantKeys) {
+				t.Errorf("acquireToken body keys = %v, want %v", got, tc.wantKeys)
+			}
+		})
+	}
+}
+
+func TestGenerateReportDownloadFormat(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name            string
+		format          string
+		wantQuery       string
+		wantContentType string
+	}{
+		{"unset omits the query entirely", "", "", "text/csv"},
+		{"csv", "csv", "format=csv", "text/csv"},
+		{"pdf", "pdf", "format=pdf", "application/pdf"},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			client, srv := newClient(t, mockops.Scenario{PollStatuses: []string{"COMPLETED"}})
+
+			res, err := client.GenerateReport(context.Background(), reportclient.ReportRequest{
+				ReportDefinitionID: testDefinitionID,
+				ResourceID:         testResourceID,
+			}, tc.format)
+			if err != nil {
+				t.Fatalf("GenerateReport: %v", err)
+			}
+
+			dl := srv.RequestsFor("downloadReport")
+			if len(dl) != 1 {
+				t.Fatalf("downloadReport called %d times, want 1", len(dl))
+			}
+			if dl[0].RawQuery != tc.wantQuery {
+				t.Errorf("downloadReport query = %q, want %q", dl[0].RawQuery, tc.wantQuery)
+			}
+			if !strings.HasPrefix(res.ContentType, tc.wantContentType) {
+				t.Errorf("Result.ContentType = %q, want prefix %q", res.ContentType, tc.wantContentType)
+			}
+			if len(res.Content) == 0 {
+				t.Error("Result.Content is empty")
+			}
+		})
+	}
+}
+
+func TestGenerateReportPollsToTerminalStatus(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name         string
+		pollStatuses []string
+		maxAttempts  int
+		wantErr      error
+		wantPolls    int
+		wantDownload int
+	}{
+		{"completed immediately", []string{"COMPLETED"}, 10, nil, 1, 1},
+		{"queued then running then completed", []string{"QUEUED", "RUNNING", "COMPLETED"}, 10, nil, 3, 1},
+		{"failed is terminal and skips download", []string{"QUEUED", "FAILED"}, 10, reportclient.ErrReportFailed, 2, 0},
+		{"never terminal", []string{"RUNNING"}, 3, reportclient.ErrPollTimeout, 3, 0},
+		{"unknown status keeps polling", []string{"SCHEDULED", "COMPLETED"}, 10, nil, 2, 1},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			srv := mockops.Start(t, mockops.Scenario{PollStatuses: tc.pollStatuses})
+			sc := srv.Scenario()
+			client, err := reportclient.New(reportclient.Config{
+				BaseURL:         srv.URL(),
+				HTTPClient:      srv.Client(),
+				Username:        sc.Username,
+				Password:        sc.Password,
+				PollInterval:    time.Millisecond,
+				MaxPollAttempts: tc.maxAttempts,
+			})
+			if err != nil {
+				t.Fatalf("New: %v", err)
+			}
+
+			res, err := client.GenerateReport(context.Background(), reportclient.ReportRequest{
+				ReportDefinitionID: testDefinitionID,
+				ResourceID:         testResourceID,
+			}, "")
+
+			if tc.wantErr != nil {
+				if !errors.Is(err, tc.wantErr) {
+					t.Fatalf("GenerateReport error = %v, want errors.Is(err, %v)", err, tc.wantErr)
+				}
+			} else {
+				if err != nil {
+					t.Fatalf("GenerateReport: %v", err)
+				}
+				if res.PollCount != tc.wantPolls {
+					t.Errorf("Result.PollCount = %d, want %d", res.PollCount, tc.wantPolls)
+				}
+				if res.Report.Status != "COMPLETED" {
+					t.Errorf("Result.Report.Status = %q, want COMPLETED", res.Report.Status)
+				}
+			}
+
+			if got := len(srv.RequestsFor("getReport")); got != tc.wantPolls {
+				t.Errorf("getReport called %d times, want %d", got, tc.wantPolls)
+			}
+			if got := len(srv.RequestsFor("downloadReport")); got != tc.wantDownload {
+				t.Errorf("downloadReport called %d times, want %d", got, tc.wantDownload)
+			}
+		})
+	}
+}

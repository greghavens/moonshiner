+package reportclient
+
+// The types in this file are the on-the-wire shapes from docs/contract.json.
+// They are deliberately separate from the exported API types: request types
+// carry only the properties the contract lists under allowedProperties, and
+// every optional property is tagged omitempty so that an unset field is absent
+// from the encoded request rather than present and empty.
+//
+// Publish and AdapterInstanceAssociation are pointers because they are optional
+// booleans: with a plain bool, omitempty could not tell "not set" from "set to
+// false", and an explicit false would silently vanish from the request.
+
+// credentialsWire is the username-password schema.
+type credentialsWire struct {
+	AuthSource string `json:"authSource,omitempty"`
+	Password   string `json:"password"`
+	Username   string `json:"username"`
+}
+
+// authTokenWire is the auth-token schema.
+type authTokenWire struct {
+	ExpiresAt string   `json:"expiresAt"`
+	Roles     []string `json:"roles"`
+	Token     string   `json:"token"`
+	Validity  int64    `json:"validity"`
+}
+
+// traversalSpecWire is the traversal-spec schema. Only name is required.
+type traversalSpecWire struct {
+	AdapterInstanceAssociation *bool  `json:"adapterInstanceAssociation,omitempty"`
+	Description                string `json:"description,omitempty"`
+	Name                       string `json:"name"`
+	RootAdapterKindKey         string `json:"rootAdapterKindKey,omitempty"`
+	RootResourceKindKey        string `json:"rootResourceKindKey,omitempty"`
+}
+
+// createReportWire is the request body for createReport. It holds exactly the
+// contract's allowedProperties for that operation: the remaining properties of
+// the report schema are server-populated and must never be sent.
+type createReportWire struct {
+	Description        string             `json:"description,omitempty"`
+	Name               string             `json:"name,omitempty"`
+	Publish            *bool              `json:"publish,omitempty"`
+	ReportDefinitionID string             `json:"reportDefinitionId"`
+	ResourceID         string             `json:"resourceId"`
+	Subject            []string           `json:"subject,omitempty"`
+	TraversalSpec      *traversalSpecWire `json:"traversalSpec,omitempty"`
+}
+
+// reportWire decodes a report response.
+type reportWire struct {
+	CompletionTime     string `json:"completionTime"`
+	Description        string `json:"description"`
+	ID                 string `json:"id"`
+	Name               string `json:"name"`
+	Owner              string `json:"owner"`
+	ReportDefinitionID string `json:"reportDefinitionId"`
+	ResourceID         string `json:"resourceId"`
+	Status             string `json:"status"`
+}
+
+func (r reportWire) report() Report {
+	return Report{
+		ID:                 r.ID,
+		Status:             r.Status,
+		ReportDefinitionID: r.ReportDefinitionID,
+		ResourceID:         r.ResourceID,
+		Name:               r.Name,
+		Owner:              r.Owner,
+		CompletionTime:     r.CompletionTime,
+	}
+}
+
+// wire converts a caller's ReportRequest into the createReport body.
+func (r ReportRequest) wire() createReportWire {
+	out := createReportWire{
+		Description:        r.Description,
+		Name:               r.Name,
+		Publish:            r.Publish,
+		ReportDefinitionID: r.ReportDefinitionID,
+		ResourceID:         r.ResourceID,
+		TraversalSpec:      r.TraversalSpec.wire(),
+	}
+	// A caller-supplied but empty slice is still "not set" on the wire, and
+	// omitempty already drops it; copying keeps the client from aliasing the
+	// caller's backing array.
+	if len(r.Subject) > 0 {
+		out.Subject = append([]string(nil), r.Subject...)
+	}
+	return out
+}
+
+func (t *TraversalSpec) wire() *traversalSpecWire {
+	if t == nil {
+		return nil
+	}
+	return &traversalSpecWire{
+		AdapterInstanceAssociation: t.AdapterInstanceAssociation,
+		Description:                t.Description,
+		Name:                       t.Name,
+		RootAdapterKindKey:         t.RootAdapterKindKey,
+		RootResourceKindKey:        t.RootResourceKindKey,
+	}
+}

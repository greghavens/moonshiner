{
  "$comment": "Wire contract for the VCF Operations report-generation flow. Everything under 'api', 'auth.spec' and 'operations' is mechanically derived from the OpenAPI document identified in 'source'. Anything not derivable from that document is placed under 'taskDefined' and labelled with its provenance.",
  "contractVersion": "1.0.0",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "license": "Apache-2.0",
    "specPath": "specifications/vcf-operations/vcf-operations-openapi.json",
    "commit": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "sha256": "8179d8c128d9b3a81ed89d12ab958dc3c43eb664d4ca999e3b19d3e70efc14af",
    "rawUrl": "https://raw.githubusercontent.com/vmware/vcf-api-specs/c3f3b52c845dd967cabbc21680e893292077d5ba/specifications/vcf-operations/vcf-operations-openapi.json"
  },
  "api": {
    "title": "VMware Cloud Foundation Operations API",
    "version": "9.1.0.0",
    "openapi": "3.0.1",
    "basePath": "/suite-api"
  },
  "auth": {
    "spec": {
      "schemeName": "Token-based-authorization",
      "type": "apiKey",
      "in": "header",
      "headerName": "Authorization"
    },
    "taskDefined": {
      "headerValueFormat": "OpsToken {token}",
      "provenance": "The OpenAPI document declares the Authorization header but does not specify the token prefix. 'OpsToken {token}' is the format emitted by VMware.Sdk.Vcf.Ops (Connect-VcfOpsServer) against this API and is what the mock enforces."
    }
  },
  "operations": {
    "acquireToken": {
      "operationId": "acquireToken",
      "method": "POST",
      "specPath": "/api/auth/token/acquire",
      "requestPath": "/suite-api/api/auth/token/acquire",
      "summary": "Acquire a token to perform REST API calls",
      "tags": [
        "Auth"
      ],
      "authenticated": false,
      "pathParameters": [],
      "queryParameters": [],
      "requestBody": {
        "required": [
          {
            "name": "password",
            "type": "string"
          },
          {
            "name": "username",
            "type": "string"
          }
        ],
        "contentType": "application/json",
        "schema": "username-password",
        "optional": [
          {
            "name": "authSource",
            "type": "string"
          }
        ]
      },
      "responses": {
        "200": {
          "contentTypes": [
            "application/json",
            "application/xml"
          ],
          "schema": "auth-token",
          "description": "The token and expiry time of the token"
        },
        "401": {
          "contentTypes": [],
          "schema": null,
          "description": "Authentication failed"
        }
      }
    },
    "getCurrentVersionOfServer": {
      "operationId": "getCurrentVersionOfServer",
      "method": "GET",
      "specPath": "/api/versions/current",
      "requestPath": "/suite-api/api/versions/current",
      "summary": "Get the current version of the service",
      "tags": [
        "Versions Info"
      ],
      "authenticated": true,
      "pathParameters": [],
      "queryParameters": [],
      "requestBody": null,
      "responses": {
        "200": {
          "contentTypes": [
            "application/json",
            "application/xml"
          ],
          "schema": "version",
          "description": "The current version of the Server"
        }
      }
    },
    "createReport": {
      "operationId": "createReport",
      "method": "POST",
      "specPath": "/api/reports",
      "requestPath": "/suite-api/api/reports",
      "summary": "Generate (create) a Report using the specified Report Definition and for the specified Resource",
      "tags": [
        "Reports"
      ],
      "authenticated": true,
      "pathParameters": [],
      "queryParameters": [],
      "requestBody": {
        "required": [
          {
            "name": "reportDefinitionId",
            "type": "string",
            "format": "uuid"
          },
          {
            "name": "resourceId",
            "type": "string",
            "format": "uuid"
          }
        ],
        "contentType": "application/json",
        "schema": "report",
        "optional": [
          {
            "name": "completionTime",
            "type": "string"
          },
          {
            "name": "description",
            "type": "string"
          },
          {
            "name": "id",
            "type": "string"
          },
          {
            "name": "links",
            "type": "array",
            "items": "link"
          },
          {
            "name": "name",
            "type": "string"
          },
          {
            "name": "owner",
            "type": "string"
          },
          {
            "name": "publish",
            "type": "boolean"
          },
          {
            "name": "status",
            "type": "string"
          },
          {
            "name": "subject",
            "type": "array",
            "items": "string"
          },
          {
            "name": "traversalSpec",
            "type": "$ref:traversal-spec",
            "schema": "traversal-spec"
          }
        ]
      },
      "responses": {
        "200": {
          "contentTypes": [
            "application/json",
            "application/xml"
          ],
          "schema": "report",
          "description": "The Generated Report"
        }
      }
    },
    "getReport": {
      "operationId": "getReport",
      "method": "GET",
      "specPath": "/api/reports/{id}",
      "requestPath": "/suite-api/api/reports/{id}",
      "summary": "Get the detail of a Report given its identifier",
      "tags": [
        "Reports"
      ],
      "authenticated": true,
      "pathParameters": [
        {
          "name": "id",
          "required": true,
          "type": "string",
          "format": "uuid"
        }
      ],
      "queryParameters": [],
      "requestBody": null,
      "responses": {
        "200": {
          "contentTypes": [
            "application/json",
            "application/xml"
          ],
          "schema": "report",
          "description": "The details of the Report"
        }
      }
    },
    "downloadReport": {
      "operationId": "downloadReport",
      "method": "GET",
      "specPath": "/api/reports/{id}/download",
      "requestPath": "/suite-api/api/reports/{id}/download",
      "summary": "Download the Report given its identifier",
      "tags": [
        "Reports"
      ],
      "authenticated": true,
      "pathParameters": [
        {
          "name": "id",
          "required": true,
          "type": "string",
          "format": "uuid"
        }
      ],
      "queryParameters": [
        {
          "name": "format",
          "required": false,
          "type": "string"
        }
      ],
      "requestBody": null,
      "responses": {
        "200": {
          "contentTypes": [
            "application/pdf",
            "text/csv"
          ],
          "schema": null,
          "description": "The link to download the report"
        }
      }
    }
  },
  "taskDefined": {
    "$comment": "report.status is declared in the OpenAPI document as a free-form string with no enum (see operations.getReport.responses.200.schema -> 'report'). The terminal/non-terminal partition below is therefore a decision of this task, not a fact of the specification.",
    "reportStatus": {
      "specType": "string",
      "specEnum": null,
      "nonTerminal": [
        "QUEUED",
        "SCHEDULED",
        "RUNNING"
      ],
      "terminalSuccess": [
        "COMPLETED"
      ],
      "terminalFailure": [
        "FAILED",
        "ABORTED"
      ]
    },
    "download": {
      "formats": [
        "CSV",
        "PDF"
      ],
      "provenance": "downloadReport declares an optional untyped 'format' query parameter and advertises application/pdf and text/csv responses; CSV/PDF are those two response media types."
    }
  }
}
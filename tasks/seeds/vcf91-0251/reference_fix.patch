+function Build-VcfOpsUri {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)] $Session,
+        [Parameter(Mandatory)] [string] $PathTemplate,
+        [hashtable] $PathParameters = @{},
+        [hashtable] $QueryParameters = @{}
+    )
+
+    $path = $PathTemplate
+    foreach ($name in $PathParameters.Keys) {
+        $value = [string]$PathParameters[$name]
+        if ([string]::IsNullOrWhiteSpace($value)) { throw "Path parameter '$name' has no value." }
+        $path = $path -replace ('\{' + [regex]::Escape($name) + '\}'), [uri]::EscapeDataString($value)
+    }
+    if ($path -match '\{|\}') { throw "Unsubstituted path parameter in '$path'." }

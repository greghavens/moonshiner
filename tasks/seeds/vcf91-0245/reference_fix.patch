index 0000000..fe037a9
--- /dev/null
+++ b/vsandp/contract.py
@@ -0,0 +1,127 @@
+"""The wire contract, loaded from docs/contract.json.
+
+Every request the client makes is built from this document: no method, path,
+query parameter, status code or security scheme is hard-coded anywhere else.
+"""
+
+from __future__ import annotations
+
+import json
+from urllib.parse import quote, urlencode
+
+
+class ContractError(Exception):
+    pass
+
+
+class Operation:
+    def __init__(self, operation_id, entry):
+        self.operation_id = operation_id
+        self.role = entry["role"]
+        self.method = entry["method"].upper()
+        self.path = entry["path"]
+        self.fixed_query = dict(entry.get("fixed_query") or {})
+        self.path_params = list(entry.get("path_params") or [])
+        self.optional_query_params = list(entry.get("optional_query_params") or [])
+        self.success_status = int(entry["success_status"])
+        self.auth = entry["auth"]
+        self.request_body = entry.get("request_body")
+
+    @property
+    def required_body_fields(self):
+        return list((self.request_body or {}).get("required", []))
+
+    @property
+    def optional_body_fields(self):
+        return list((self.request_body or {}).get("optional", []))
+
+    def target(self, base_path, params=None, query=None):
+        """Return the request target (path plus query string) for this operation."""
+        params = params or {}
+        missing = [name for name in self.path_params if name not in params]
+        if missing:
+            raise ContractError(
+                "%s needs the path parameter(s) %s" % (self.operation_id, ", ".join(missing))
+            )
+        path = self.path
+        for name in self.path_params:
+            path = path.replace("{%s}" % name, quote(str(params[name]), safe=""))
+
+        pairs = list(self.fixed_query.items())
+        for name, value in (query or {}).items():
+            if name not in self.optional_query_params:
+                raise ContractError(
+                    "%s has no optional query parameter %r" % (self.operation_id, name)
+                )
+            # An optional filter that is not set is left out; it is never sent empty.
+            if value is None or value == [] or value == "":
+                continue
+            for item in value if isinstance(value, (list, tuple, set)) else [value]:
+                pairs.append((name, str(item)))
+
+        target = base_path + path
+        if pairs:
+            target += "?" + urlencode(pairs)
+        return target
+
+    def build_body(self, values):
+        """Assemble a request body, omitting every optional field that is unset.
+
+        ``values`` may carry ``None`` for a field the caller does not want: the
+        field is then absent from the result rather than present and empty.
+        """
+        if self.request_body is None:
+            if values:
+                raise ContractError("%s takes no request body" % self.operation_id)
+            return None
+        document = {}
+        for name in self.required_body_fields:
+            if values.get(name) is None:
+                raise ContractError(
+                    "%s requires the property %r" % (self.operation_id, name)
+                )
+            document[name] = values[name]
+        for name in self.optional_body_fields:
+            value = values.get(name)
+            if value is None or value == {} or value == [] or value == "":
+                continue
+            document[name] = value
+        unknown = sorted(set(values) - set(self.required_body_fields)
+                         - set(self.optional_body_fields))
+        if unknown:
+            raise ContractError(
+                "%s: unknown propert%s %s"
+                % (self.operation_id, "y" if len(unknown) == 1 else "ies",
+                   ", ".join(repr(name) for name in unknown))
+            )
+        return document
+
+
+class Contract:
+    def __init__(self, document):
+        self.document = document
+        self.base_path = document["spec"]["server_base_path"]
+        self.security_schemes = document["security_schemes"]
+        self.operations = {}
+        for operation_id, entry in document["operations"].items():
+            operation = Operation(operation_id, entry)
+            if operation.role in self.operations:
+                raise ContractError("two operations claim the role %r" % operation.role)
+            self.operations[operation.role] = operation
+
+    @classmethod
+    def load(cls, path):
+        with open(path, encoding="utf-8") as handle:
+            return cls(json.load(handle))
+
+    def operation(self, role):
+        try:
+            return self.operations[role]
+        except KeyError:
+            raise ContractError("the contract names no operation for the role %r" % role)
+
+    def scheme(self, name):
+        try:
+            return self.security_schemes[name]
+        except KeyError:
+            raise ContractError("the contract declares no security scheme %r" % name)
diff --git a/vsandp/sweep.py b/vsandp/sweep.py
new file mode 100644
index 0000000..eb0d8af
--- /dev/null
+++ b/vsandp/sweep.py
@@ -0,0 +1,88 @@
+"""Snapshot every protection group of a cluster and follow the tasks.
+
+The sweep is resumable across a session refresh by construction: each step is
+recorded as it completes, so the retry that follows an expired token picks up
+where the run stopped instead of starting over.
+"""
+
+from __future__ import annotations
+
+import time
+
+TERMINAL_STATES = ("SUCCEEDED", "FAILED")
+
+PROTECTION_GROUPS_LIST = "protection_groups_list"
+SNAPSHOT_CREATE = "snapshot_create"
+TASK_GET = "task_get"
+
+# Properties of Snapservice.Clusters.ProtectionGroups.Snapshots.CreateSpec and of
+# Snapservice.RetentionPeriod, as the contract declares them.
+SNAPSHOT_NAME = "name"
+SNAPSHOT_RETENTION = "retention"
+RETENTION_UNIT = "unit"
+RETENTION_DURATION = "duration"
+
+
+class SweepError(Exception):
+    pass
+
+
+def list_protection_groups(client, cluster):
+    result = client.call(PROTECTION_GROUPS_LIST, params={"cluster": cluster})
+    return list(result.get("items", []))
+
+
+def submit_snapshot(client, cluster, pg, name, retention=None):
+    operation = client.contract.operation(SNAPSHOT_CREATE)
+    values = {SNAPSHOT_NAME: name}
+    if retention is not None:
+        unit, duration = retention
+        values[SNAPSHOT_RETENTION] = {
+            RETENTION_UNIT: unit,
+            RETENTION_DURATION: int(duration),
+        }
+    # build_body drops every optional property that is not set, so a sweep
+    # without a retention period sends the name and nothing else.
+    body = operation.build_body(values)
+    return client.call(SNAPSHOT_CREATE, params={"cluster": cluster, "pg": pg}, body=body)
+
+
+def await_task(client, task_id, poll_interval=0.5, deadline=None):
+    while True:
+        info = client.call(TASK_GET, params={"task": task_id})
+        status = info.get("status")
+        if status in TERMINAL_STATES:
+            return info
+        if deadline is not None and time.monotonic() > deadline:
+            raise SweepError("task %s is still %s" % (task_id, status))
+        if poll_interval:
+            time.sleep(poll_interval)
+
+
+def run(client, cluster, prefix, retention=None, poll_interval=0.5, task_timeout=None):
+    """Snapshot every protection group of *cluster* and return a report."""
+    groups = list_protection_groups(client, cluster)
+
+    submitted = []
+    for group in groups:
+        pg = group["pg"]
+        info = group.get("info") or {}
+        name = "%s-%s" % (prefix, info.get("name", pg))
+        task_id = submit_snapshot(client, cluster, pg, name, retention)
+        submitted.append(
+            {"pg": pg, "snapshot_name": name, "task": task_id})
+
+    deadline = None if task_timeout is None else time.monotonic() + task_timeout
+    for entry in submitted:
+        result = await_task(client, entry["task"], poll_interval, deadline)
+        entry["status"] = result.get("status")
+        entry["snapshot"] = result.get("result")
+
+
+
+    return {
+        "cluster": cluster,
+        "session_creates": client.session_creates,
+        "session_refreshes": client.session_refreshes,
+        "protection_groups": submitted,
+    }

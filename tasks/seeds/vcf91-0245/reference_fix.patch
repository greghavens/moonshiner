diff --git a/vsandp/client.py b/vsandp/client.py
new file mode 100644
index 0000000..79813dd
--- /dev/null
+++ b/vsandp/client.py
@@ -0,0 +1,148 @@
+"""HTTP client for the snapshot appliance, with session refresh.
+
+The appliance hands out a session token that stops being accepted after a while.
+When a call comes back 401 the client opens a fresh session and replays *that
+one call*; everything already done stays done, and nothing already submitted is
+submitted again.
+"""
+
+from __future__ import annotations
+
+import base64
+import json
+import urllib.error
+import urllib.request
+
+from .contract import Contract, ContractError
+
+SESSION_CREATE = "session_create"
+SESSION_DELETE = "session_delete"
+
+
+class ApiError(Exception):
+    def __init__(self, status, payload, operation_id):
+        self.status = status
+        self.payload = payload
+        self.operation_id = operation_id
+        message = "%s failed with HTTP %d" % (operation_id, status)
+        if isinstance(payload, dict):
+            messages = payload.get("messages") or []
+            if messages:
+                message += ": %s" % messages[0].get("default_message", "")
+            if payload.get("error_type"):
+                message += " [%s]" % payload["error_type"]
+        super().__init__(message)
+
+
+class Unauthenticated(ApiError):
+    """The credentials or the session token were rejected."""
+
+
+class SnapserviceClient:
+    def __init__(self, host_url, contract, username, password, timeout=30):
+        self.host_url = host_url.rstrip("/")
+        self.contract = contract if isinstance(contract, Contract) else Contract.load(contract)
+        self.username = username
+        self.password = password
+        self.timeout = timeout
+        self.token = None
+        self.session_creates = 0
+
+    # -- session lifecycle -------------------------------------------------- #
+
+    def login(self):
+        operation = self.contract.operation(SESSION_CREATE)
+        self.token = self._send(operation)
+        self.session_creates += 1
+        return self.token
+
+    def logout(self):
+        if self.token is None:
+            return
+        self.call(SESSION_DELETE)
+        self.token = None
+
+    @property
+    def session_refreshes(self):
+        return max(0, self.session_creates - 1)
+
+    def __enter__(self):
+        self.login()
+        return self
+
+    def __exit__(self, exc_type, exc, traceback):
+        if exc_type is None:
+            self.logout()
+        return False
+
+    # -- calls -------------------------------------------------------------- #
+
+    def call(self, role, params=None, query=None, body=None):
+        """Invoke an operation, refreshing an expired session at most once."""
+        operation = self.contract.operation(role)
+        try:
+            return self._send(operation, params, query, body)
+        except Unauthenticated:
+            if role == SESSION_CREATE:
+                raise
+            # The token went stale mid-flight.  Open a new session and replay
+            # exactly this request -- the request never reached the resource, so
+            # replaying it repeats no work.
+            self.login()
+            return self._send(operation, params, query, body)
+
+    def _send(self, operation, params=None, query=None, body=None):
+        target = operation.target(self.contract.base_path, params, query)
+        payload = None
+        if body is not None:
+            payload = json.dumps(body).encode("utf-8")
+
+        request = urllib.request.Request(
+            self.host_url + target, data=payload, method=operation.method
+        )
+        request.add_header("Accept", "application/json")
+        if payload is not None:
+            request.add_header("Content-Type", "application/json")
+        self._authenticate(request, operation)
+
+        try:
+            with urllib.request.urlopen(request, timeout=self.timeout) as response:
+                status = response.status
+                raw = response.read()
+        except urllib.error.HTTPError as error:
+            status = error.code
+            raw = error.read()
+            document = _decode(raw)
+            if status == 401:
+                raise Unauthenticated(status, document, operation.operation_id)
+            raise ApiError(status, document, operation.operation_id)
+
+        if status != operation.success_status:
+            raise ApiError(status, _decode(raw), operation.operation_id)
+        return _decode(raw)
+
+    def _authenticate(self, request, operation):
+        scheme = self.contract.scheme(operation.auth)
+        kind = scheme.get("type")
+        if kind == "http" and scheme.get("scheme") == "basic":
+            credentials = "%s:%s" % (self.username, self.password)
+            encoded = base64.b64encode(credentials.encode("utf-8")).decode("ascii")
+            request.add_header("Authorization", "Basic " + encoded)
+        elif kind == "apiKey" and scheme.get("in") == "header":
+            if not self.token:
+                raise ContractError(
+                    "%s needs a session token but none has been obtained"
+                    % operation.operation_id
+                )
+            request.add_header(scheme["name"], self.token)
+        else:
+            raise ContractError("unsupported security scheme %r" % operation.auth)
+
+
+def _decode(raw):
+    if not raw:
+        return None
+    try:
+        return json.loads(raw.decode("utf-8"))
+    except ValueError:
+        return raw.decode("utf-8", "replace")
diff --git a/vsandp/contract.py b/vsandp/contract.py

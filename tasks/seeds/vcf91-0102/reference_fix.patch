+def _validated_origin(base_url: object) -> tuple[str, str, int | None]:
+    if not isinstance(base_url, str) or not base_url:
+        raise ValueError("base_url must be an HTTP(S) origin")
+    if any(ord(character) < 0x20 or ord(character) == 0x7F
+           for character in base_url):
+        raise ValueError("base_url contains an unsafe character")
+    if "?" in base_url or "#" in base_url:
+        raise ValueError("base_url must not contain a query or fragment")
+    try:
+        split = urlsplit(base_url)
+        port = split.port
+    except ValueError as error:
+        raise ValueError("base_url must be an HTTP(S) origin") from error
+    if (
+        split.scheme not in {"http", "https"}
+        or not split.netloc
+        or not split.hostname
+        or split.username is not None
+        or split.password is not None
+        or split.path not in {"", "/"}
+        or split.query
+        or split.fragment
+    ):
+        raise ValueError(
+            "base_url must be an HTTP(S) origin without credentials, "
+            "path, query, or fragment"
+        )
+    return split.scheme, split.hostname, port
+
+
+def _validated_token(session_token: object) -> str:
+    if not isinstance(session_token, str) or not session_token.strip():
+        raise ValueError("session_token must be a nonblank string")
+    if any(ord(character) < 0x20 or ord(character) == 0x7F
+           for character in session_token):
+        raise ValueError("session_token contains an unsafe header character")
+    try:
+        session_token.encode("latin-1")
+    except UnicodeEncodeError as error:
+        raise ValueError(
+            "session_token contains an unsafe header character"
+        ) from error
+    return session_token
+
+
+def _validated_timeout(timeout: object) -> float:
+    if (
+        not isinstance(timeout, (int, float))
+        or isinstance(timeout, bool)
+        or not math.isfinite(timeout)
+        or timeout <= 0
+    ):
+        raise ValueError("timeout must be a positive finite number")
+    return float(timeout)
+
+
+def _validated_vm(vm: object) -> str:
+    if not isinstance(vm, str) or not vm.strip():
+        raise ValueError("vm must be a nonblank string")
+    return vm
+
+
+def _validated_count(count: object) -> int:
+    if (
+        not isinstance(count, int)
+        or isinstance(count, bool)
+        or count < 1
+        or count > _MAX_SIGNED_INT64
+    ):
+        raise ValueError("count must be a positive signed-int64")
+    return count
+
+
+def _decode_json(raw: bytes) -> object:
+    if not raw:
+        return None
+    try:
+        return json.loads(raw.decode("utf-8"))
+    except (UnicodeDecodeError, json.JSONDecodeError):
+        return None
+
 

diff --git a/.reference_solution.py b/.reference_solution.py
new file mode 100755
--- /dev/null
+++ b/.reference_solution.py
@@ -0,0 +1,121 @@
+#!/usr/bin/env python3
+"""Produce the reference report through genuine fleetctl executions."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "fleetctl"
+REPORT = ROOT / "availability-report.md"
+TARGETS = (
+    {
+        "vehicle": "Truck 8 garden delivery",
+        "depot": "Depot B",
+        "date": "2026-09-14",
+    },
+    {
+        "vehicle": "Sedan 4 clinic courier",
+        "depot": "Depot C",
+        "date": "2026-09-14",
+    },
+)
+
+
+def command_for(target: dict) -> list[str]:
+    return [
+        str(CLIENT),
+        "availability",
+        "--vehicle",
+        target["vehicle"],
+        "--depot",
+        target["depot"],
+        "--date",
+        target["date"],
+    ]
+
+
+def start_call(target: dict) -> subprocess.Popen[str]:
+    return subprocess.Popen(
+        command_for(target),
+        cwd=ROOT,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+        start_new_session=True,
+    )
+
+
+def finish_call(process: subprocess.Popen[str]) -> tuple[int, dict]:
+    stdout, stderr = process.communicate(timeout=10)
+    return process.returncode, json.loads(
+        stdout if process.returncode == 0 else stderr
+    )
+
+
+def main() -> int:
+    help_process = subprocess.run(
+        [str(CLIENT), "--help"],
+        cwd=ROOT,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+        start_new_session=True,
+        check=False,
+    )
+    if help_process.returncode != 0:
+        raise RuntimeError("reference could not read fleetctl built-in help")
+
+    initial_processes = [start_call(target) for target in TARGETS]
+    initial = [finish_call(process) for process in initial_processes]
+    successful = [
+        index for index, (returncode, _) in enumerate(initial)
+        if returncode == 0
+    ]
+    transient_failures = [
+        index
+        for index, (returncode, response) in enumerate(initial)
+        if returncode != 0
+        and response.get("error_kind") == "transient"
+        and response.get("retryable") is True
+    ]
+    if len(successful) != 1 or len(transient_failures) != 1:
+        raise RuntimeError(
+            "reference initial checks did not produce the required partial failure"
+        )
+
+    failed_index = transient_failures[0]
+    retry_code, retry_response = finish_call(start_call(TARGETS[failed_index]))
+    if retry_code != 0 or not isinstance(retry_response.get("result"), dict):
+        raise RuntimeError("reference failed-branch retry did not succeed")
+
+    results: list[dict | None] = [None, None]
+    successful_index = successful[0]
+    successful_response = initial[successful_index][1]
+    if not isinstance(successful_response.get("result"), dict):
+        raise RuntimeError("reference initial success returned no result")
+    results[successful_index] = successful_response["result"]
+    results[failed_index] = retry_response["result"]
+
+    lines = []
+    for result in results:
+        if not isinstance(result, dict):
+            raise RuntimeError("reference workflow left an unresolved branch")
+        availability = "available" if result["available"] else "unavailable"
+        lines.append(
+            f"- {result['vehicle']} in {result['depot']} on {result['date']}: "
+            f"{availability}."
+        )
+    retried = results[failed_index]
+    lines.append(
+        f"- Retried branch: {retried['vehicle']} in {retried['depot']}."
+    )
+    REPORT.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/availability-report.md b/availability-report.md
new file mode 100644
--- /dev/null
+++ b/availability-report.md
@@ -0,0 +1,3 @@
+- Truck 8 garden delivery in Depot B on 2026-09-14: available.
+- Sedan 4 clinic courier in Depot C on 2026-09-14: unavailable.
+- Retried branch: Sedan 4 clinic courier in Depot C.

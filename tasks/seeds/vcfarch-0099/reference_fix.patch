+    private static Map<String, Object> selectStorageProfile(
+            Map<String, Object> compatibility, Map<String, Object> requirements) {
+        Map<String, Object> selected = null;
+        for (Object value : array(compatibility.get("storageOptions"), "storageOptions")) {
+            Map<String, Object> profile = object(value, "storage profile");
+            if (!meetsRequirements(profile, requirements)) {
+                continue;
+            }
+            if (selected == null || integer(profile.get("designHostCount"), "designHostCount")
+                    < integer(selected.get("designHostCount"), "designHostCount")) {
+                selected = profile;
+            }
+        }
+        if (selected == null) {
+            throw new IllegalArgumentException("no pinned storage option satisfies the estate requirements");
+        }
+        return selected;
+    }

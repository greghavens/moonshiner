+        private char unicodeEscape() {
+            if (index + 4 > source.length()) {
+                throw error("short unicode escape");
+            }
+            int value = 0;
+            for (int count = 0; count < 4; count++) {
+                int digit = Character.digit(source.charAt(index++), 16);

+    private static Map<String, Object> storageDecision(
+            Map<String, Object> sourceCluster,
+            Map<String, Object> compatibility,
+            Map<String, Object> requirements,
+            Map<String, Object> selectedProfile) {
+        LinkedHashMap<String, Object> decision = new LinkedHashMap<>();
+        decision.put("sourceArchitecture", sourceCluster.get("storageArchitecture"));
+        decision.put("selectedArchitecture", selectedProfile.get("architecture"));
+        ArrayList<Object> options = new ArrayList<>();
+        for (Object value : array(compatibility.get("storageOptions"), "storageOptions")) {
+            Map<String, Object> profile = object(value, "storage profile");
+            LinkedHashMap<String, Object> option = new LinkedHashMap<>();
+            option.put("architecture", profile.get("architecture"));
+            option.put("hostCount", profile.get("designHostCount"));
+            option.put("vsanUplinks", profile.get("minimumVsanUplinks"));
+            option.put("uplinkSpeedGbps", profile.get("uplinkSpeedGbps"));
+            option.put("supportedSustainedIops", profile.get("supportedSustainedIops"));
+            option.put("meetsRequirements", meetsRequirements(profile, requirements));
+            options.add(option);
+        }
+        decision.put("consideredOptions", options);
+        return decision;
+    }

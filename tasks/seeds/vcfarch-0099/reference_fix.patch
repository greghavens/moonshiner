+    private static List<Object> componentTransitions(
+            Map<String, Object> inventory, Map<String, Object> compatibility) {
+        Map<String, Object> targets = object(compatibility.get("targetComponents"), "targetComponents");
+        Map<String, Object> gates = object(compatibility.get("componentGates"), "componentGates");
+        ArrayList<Object> transitions = new ArrayList<>();
+        for (Object value : array(inventory.get("components"), "components")) {
+            Map<String, Object> component = object(value, "component");
+            String name = string(component.get("name"), "component.name");
+            require(targets, name, "target component");
+            require(gates, name, "component gates");
+            LinkedHashMap<String, Object> transition = new LinkedHashMap<>();
+            transition.put("name", name);
+            transition.put("type", component.get("type"));
+            transition.put("currentVersion", component.get("version"));
+            transition.put("targetVersion", targets.get(name));
+            transition.put("gatedBy", gates.get(name));
+            transitions.add(transition);
+        }
+        return transitions;
+    }
+
+    private static List<Object> orderedSteps(
+            Map<String, Object> inventory, Map<String, Object> compatibility) {
+        Map<String, Map<String, Object>> componentsByName = new LinkedHashMap<>();
+        for (Object value : array(inventory.get("components"), "components")) {
+            Map<String, Object> component = object(value, "component");
+            componentsByName.put(string(component.get("name"), "component.name"), component);
+        }
+        Map<String, Object> targets = object(compatibility.get("targetComponents"), "targetComponents");
+        Map<String, Object> gates = object(compatibility.get("componentGates"), "componentGates");
+        ArrayList<Object> steps = new ArrayList<>();
+        int sequence = 1;
+        for (Object value : array(compatibility.get("upgradeOrder"), "upgradeOrder")) {
+            String name = string(value, "upgrade order entry");
+            Map<String, Object> component = componentsByName.get(name);
+            if (component == null) {
+                throw new IllegalArgumentException("upgradeOrder names un-inventoried component " + name);
+            }
+            LinkedHashMap<String, Object> step = new LinkedHashMap<>();
+            step.put("sequence", new BigDecimal(sequence++));
+            step.put("action", "vSAN".equals(name) ? "MIGRATE_STORAGE" : "UPGRADE_COMPONENT");
+            if ("vSAN".equals(name)) {
+                Map<String, Object> esa = selectStorageProfile(compatibility,
+                        object(inventory.get("requirements"), "requirements"));
+                step.put("migrationMode", esa.get("migrationMode"));
+            }
+            step.put("component", name);
+            step.put("fromVersion", component.get("version"));
+            step.put("targetVersion", require(targets, name, "target component"));
+            step.put("gatedBy", require(gates, name, "component gates"));
+            steps.add(step);
+        }
+        return steps;
+    }

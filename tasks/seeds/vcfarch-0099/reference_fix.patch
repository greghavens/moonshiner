+    private static boolean meetsRequirements(
+            Map<String, Object> profile, Map<String, Object> requirements) {
+        boolean dualFabric = bool(requirements.get("requireDualFabric"), "requireDualFabric");
+        return integer(profile.get("supportedSustainedIops"), "supportedSustainedIops")
+                        >= integer(requirements.get("minimumSustainedIops"), "minimumSustainedIops")
+                && integer(profile.get("usableCapacityTb"), "usableCapacityTb")
+                        >= integer(requirements.get("minimumUsableCapacityTb"), "minimumUsableCapacityTb")
+                && (!dualFabric || integer(profile.get("minimumVsanUplinks"), "minimumVsanUplinks") >= 2);
+    }

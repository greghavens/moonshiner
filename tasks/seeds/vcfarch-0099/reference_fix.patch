+    private static List<Object> releasePath(
+            String source, String target, List<Object> hopValues) {
+        Map<String, List<String>> graph = new LinkedHashMap<>();
+        for (Object value : hopValues) {
+            Map<String, Object> hop = object(value, "supported release hop");
+            graph.computeIfAbsent(string(hop.get("from"), "hop.from"), ignored -> new ArrayList<>())
+                    .add(string(hop.get("to"), "hop.to"));
+        }
+        Deque<List<String>> pending = new ArrayDeque<>();
+        pending.add(List.of(source));
+        Set<String> visited = new LinkedHashSet<>();
+        visited.add(source);
+        while (!pending.isEmpty()) {
+            List<String> candidate = pending.removeFirst();
+            String tail = candidate.get(candidate.size() - 1);
+            if (target.equals(tail)) {
+                return new ArrayList<>(candidate);
+            }
+            for (String next : graph.getOrDefault(tail, List.of())) {
+                if (visited.add(next)) {
+                    ArrayList<String> extended = new ArrayList<>(candidate);
+                    extended.add(next);
+                    pending.addLast(extended);
+                }
+            }
+        }
+        throw new IllegalArgumentException("no supported release path from " + source + " to " + target);
+    }

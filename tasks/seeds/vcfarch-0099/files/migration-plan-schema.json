{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.com/vcf/migration-plan-1.0.json",
  "title": "Brownfield VCF migration architecture",
  "type": "object",
  "required": [
    "estateId",
    "sourceVcfVersion",
    "targetVcfVersion",
    "releasePath",
    "storageDecision",
    "targetArchitecture",
    "components",
    "steps",
    "targetSddcSpec",
    "researchSources"
  ],
  "properties": {
    "estateId": {"type": "string", "minLength": 1},
    "sourceVcfVersion": {"type": "string", "minLength": 1},
    "targetVcfVersion": {"type": "string", "minLength": 1},
    "releasePath": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "minLength": 1}
    },
    "storageDecision": {
      "type": "object",
      "required": ["sourceArchitecture", "selectedArchitecture", "consideredOptions"],
      "properties": {
        "sourceArchitecture": {"type": "string", "enum": ["OSA", "ESA"]},
        "selectedArchitecture": {"type": "string", "enum": ["OSA", "ESA"]},
        "consideredOptions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["architecture", "hostCount", "vsanUplinks", "uplinkSpeedGbps", "supportedSustainedIops", "meetsRequirements"],
            "properties": {
              "architecture": {"type": "string", "enum": ["OSA", "ESA"]},
              "hostCount": {"type": "integer", "minimum": 1},
              "vsanUplinks": {"type": "integer", "minimum": 1},
              "uplinkSpeedGbps": {"type": "integer", "minimum": 1},
              "supportedSustainedIops": {"type": "integer", "minimum": 1},
              "meetsRequirements": {"type": "boolean"}
            }
          }
        }
      }
    },
    "targetArchitecture": {
      "type": "object",
      "required": ["managementCluster", "storageArchitecture", "storageMigrationMode", "hostCount", "hostModel", "vsanUplinks", "uplinkSpeedGbps", "vsanMtu"],
      "properties": {
        "managementCluster": {"type": "string", "minLength": 1},
        "storageArchitecture": {"type": "string", "enum": ["OSA", "ESA"]},
        "storageMigrationMode": {"type": "string", "enum": ["IN_PLACE_RETAIN_OSA", "PARALLEL_ESA_CLUSTER_EVACUATE_RETIRE"]},
        "hostCount": {"type": "integer", "minimum": 1},
        "hostModel": {"type": "string", "minLength": 1},
        "vsanUplinks": {"type": "integer", "minimum": 1},
        "uplinkSpeedGbps": {"type": "integer", "minimum": 1},
        "vsanMtu": {"type": "integer", "minimum": 1280, "maximum": 9190}
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/componentTransition"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sequence", "action", "component", "fromVersion", "targetVersion", "gatedBy"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "action": {"type": "string", "enum": ["UPGRADE_COMPONENT", "MIGRATE_STORAGE"]},
          "component": {"type": "string", "minLength": 1},
          "fromVersion": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "migrationMode": {"type": "string", "enum": ["PARALLEL_ESA_CLUSTER_EVACUATE_RETIRE"]},
          "gatedBy": {"$ref": "#/$defs/gates"}
        }
      }
    },
    "targetSddcSpec": {"type": "object"},
    "researchSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://"}
        }
      }
    }
  },
  "$defs": {
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "componentTransition": {
      "type": "object",
      "required": ["name", "type", "currentVersion", "targetVersion", "gatedBy"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "currentVersion": {"type": "string", "minLength": 1},
        "targetVersion": {"type": "string", "minLength": 1},
        "gatedBy": {"$ref": "#/$defs/gates"}
      }
    }
  }
}

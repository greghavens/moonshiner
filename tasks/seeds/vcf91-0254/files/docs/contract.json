{
  "contractVersion": 1,
  "product": "VMware Cloud Foundation Operations",
  "apiTitle": "VMware Cloud Foundation Operations API",
  "apiVersion": "9.1.0.0",
  "openapi": "3.0.1",
  "basePath": "/suite-api",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "path": "specifications/vcf-operations/vcf-operations-openapi.json",
    "commit": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "blobSha": "a56a00c504d4156aa765339c47d585d15db68768",
    "sha256": "8179d8c128d9b3a81ed89d12ab958dc3c43eb664d4ca999e3b19d3e70efc14af",
    "license": "Apache-2.0"
  },
  "operations": {
    "acquireToken": {
      "operationId": "acquireToken",
      "group": "auth",
      "method": "POST",
      "path": "/api/auth/token/acquire",
      "url": "/suite-api/api/auth/token/acquire",
      "parameters": [],
      "requestBody": {
        "required": true,
        "schema": "username-password"
      },
      "responses": {
        "200": {
          "description": "The token and expiry time of the token",
          "schema": "auth-token"
        },
        "401": {
          "description": "Authentication failed",
          "schema": null
        }
      }
    },
    "getCurrentVersionOfServer": {
      "operationId": "getCurrentVersionOfServer",
      "group": "auth",
      "method": "GET",
      "path": "/api/versions/current",
      "url": "/suite-api/api/versions/current",
      "parameters": [],
      "requestBody": null,
      "responses": {
        "200": {
          "description": "The current version of the Server",
          "schema": "version"
        }
      }
    },
    "getMaintenanceSchedules": {
      "operationId": "getMaintenanceSchedules",
      "group": "maintenance",
      "method": "GET",
      "path": "/api/maintenanceschedules",
      "url": "/suite-api/api/maintenanceschedules",
      "parameters": [
        {
          "name": "id",
          "in": "query",
          "required": false,
          "type": "array",
          "items": "string"
        },
        {
          "name": "name",
          "in": "query",
          "required": false,
          "type": "array",
          "items": "string"
        },
        {
          "name": "resourceId",
          "in": "query",
          "required": false,
          "type": "array",
          "items": "string"
        },
        {
          "name": "page",
          "in": "query",
          "required": false,
          "type": "integer",
          "default": 0
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "type": "integer",
          "default": 1000
        }
      ],
      "requestBody": null,
      "responses": {
        "200": {
          "description": "The Maintenance Schedules that match the criteria specified",
          "schema": "maintenance-schedules"
        }
      }
    },
    "createMaintenanceSchedules": {
      "operationId": "createMaintenanceSchedules",
      "group": "maintenance",
      "method": "POST",
      "path": "/api/maintenanceschedules",
      "url": "/suite-api/api/maintenanceschedules",
      "parameters": [],
      "requestBody": {
        "required": true,
        "schema": "maintenance-schedule"
      },
      "responses": {
        "201": {
          "description": "The maintenance schedule created",
          "schema": "maintenance-schedule"
        },
        "400": {
          "description": "Invalid request parameters or request body",
          "schema": null
        },
        "422": {
          "description": "A maintenance schedule with the same key already exists",
          "schema": null
        }
      }
    },
    "updateMaintenanceSchedules": {
      "operationId": "updateMaintenanceSchedules",
      "group": "maintenance",
      "method": "PUT",
      "path": "/api/maintenanceschedules",
      "url": "/suite-api/api/maintenanceschedules",
      "parameters": [],
      "requestBody": {
        "required": true,
        "schema": "maintenance-schedule"
      },
      "responses": {
        "200": {
          "description": "The maintenance schedule was updated successfully",
          "schema": null
        },
        "404": {
          "description": "The maintenance schedule does not exist",
          "schema": null
        }
      }
    }
  },
  "schemas": {
    "auth-token": {
      "name": "auth-token",
      "required": [
        "token",
        "validity"
      ],
      "properties": {
        "expiresAt": {
          "required": false,
          "type": "string"
        },
        "roles": {
          "required": false,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "token": {
          "required": true,
          "type": "string"
        },
        "validity": {
          "required": true,
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "link": {
      "name": "link",
      "required": [
        "href"
      ],
      "properties": {
        "description": {
          "required": false,
          "type": "string"
        },
        "href": {
          "required": true,
          "type": "string"
        },
        "name": {
          "required": false,
          "type": "string"
        },
        "rel": {
          "required": false,
          "type": "string",
          "enum": [
            "NEXT",
            "PREVIOUS",
            "START",
            "END",
            "RELATED",
            "SELF"
          ]
        }
      }
    },
    "maintenance-schedule": {
      "name": "maintenance-schedule",
      "required": [
        "key",
        "schedule"
      ],
      "properties": {
        "id": {
          "required": false,
          "type": "string",
          "format": "uuid"
        },
        "key": {
          "required": true,
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "schedule": {
          "required": true,
          "type": "object",
          "schema": "schedule"
        }
      }
    },
    "maintenance-schedules": {
      "name": "maintenance-schedules",
      "required": [],
      "properties": {
        "links": {
          "required": false,
          "type": "array",
          "items": {
            "type": null
          }
        },
        "pageInfo": {
          "required": false,
          "type": "object",
          "schema": "page-info"
        },
        "schedules": {
          "required": false,
          "type": "array",
          "items": {
            "type": null
          }
        }
      }
    },
    "page-info": {
      "name": "page-info",
      "required": [],
      "properties": {
        "page": {
          "required": false,
          "type": "integer",
          "format": "int32",
          "minimum": 0
        },
        "pageSize": {
          "required": false,
          "type": "integer",
          "format": "int32",
          "minimum": 1
        },
        "sortBy": {
          "required": false,
          "type": "string"
        },
        "sortOrder": {
          "required": false,
          "type": "string"
        },
        "totalCount": {
          "required": false,
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "schedule": {
      "name": "schedule",
      "required": [
        "duration",
        "hour",
        "minuteOfTheHour",
        "scheduleType"
      ],
      "properties": {
        "dayOfTheMonth": {
          "required": false,
          "type": "integer",
          "format": "int32",
          "deprecated": true
        },
        "daysOfTheMonth": {
          "required": false,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "daysOfTheWeek": {
          "required": false,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "UNKNOWN",
              "SUNDAY",
              "MONDAY",
              "TUESDAY",
              "WEDNESDAY",
              "THURSDAY",
              "FRIDAY",
              "SATURDAY"
            ]
          }
        },
        "duration": {
          "required": true,
          "type": "integer",
          "format": "int32",
          "minimum": 1
        },
        "expirationDate": {
          "required": false,
          "type": "string"
        },
        "expireRuns": {
          "required": false,
          "type": "integer",
          "format": "int32"
        },
        "hour": {
          "required": true,
          "type": "integer",
          "format": "int32"
        },
        "minuteOfTheHour": {
          "required": true,
          "type": "integer",
          "format": "int32"
        },
        "month": {
          "required": false,
          "type": "integer",
          "format": "int32",
          "deprecated": true
        },
        "months": {
          "required": false,
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "recurrence": {
          "required": false,
          "type": "integer",
          "format": "int32",
          "minimum": 1
        },
        "scheduleType": {
          "required": true,
          "type": "string",
          "enum": [
            "UNKNOWN",
            "ONCE",
            "DAILY",
            "WEEKLY",
            "MONTHLY",
            "YEARLY"
          ]
        },
        "startDate": {
          "required": false,
          "type": "string"
        },
        "timeZone": {
          "required": false,
          "type": "string"
        },
        "weeksOfTheMonth": {
          "required": false,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "UNKNOWNN",
              "FIRST",
              "SECOND",
              "THIRD",
              "FOURTH",
              "LAST"
            ]
          }
        }
      }
    },
    "username-password": {
      "name": "username-password",
      "required": [
        "password",
        "username"
      ],
      "properties": {
        "authSource": {
          "required": false,
          "type": "string"
        },
        "password": {
          "required": true,
          "type": "string"
        },
        "username": {
          "required": true,
          "type": "string"
        }
      }
    },
    "version": {
      "name": "version",
      "required": [
        "humanlyReadableReleaseDate",
        "major",
        "minor",
        "minorMinor",
        "releaseName",
        "releasedDate"
      ],
      "properties": {
        "buildNumber": {
          "required": false,
          "type": "integer",
          "format": "int32"
        },
        "description": {
          "required": false,
          "type": "string"
        },
        "humanlyReadableReleaseDate": {
          "required": true,
          "type": "string"
        },
        "major": {
          "required": true,
          "type": "integer",
          "format": "int32"
        },
        "minor": {
          "required": true,
          "type": "integer",
          "format": "int32"
        },
        "minorMinor": {
          "required": true,
          "type": "integer",
          "format": "int32"
        },
        "patch": {
          "required": false,
          "type": "integer",
          "format": "int32"
        },
        "releaseName": {
          "required": true,
          "type": "string"
        },
        "releasedDate": {
          "required": true,
          "type": "integer",
          "format": "int64"
        }
      }
    }
  }
}

    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "openapi": "3.0.1",
    "info_title": "SDDC Manager API Reference Guide",
    "info_version": "9.1.0.0"
  },
  "operations": [
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "A task object.",
          "mediaType": "application/json",
          "schema": "Task"
        },
        "404": {
          "description": "Task not found",
          "mediaType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "Unexpected error",
          "mediaType": "application/json",
          "schema": "Error"
        }
      }
    },
    {
      "operationId": "getNotifications",
      "method": "GET",
      "path": "/v1/notifications",
      "responses": {
        "200": {
          "description": "OK",
          "mediaType": "application/json",
          "schema": {
            "type": "array",
            "items": "Notification"
          }
        },
        "500": {
          "description": "Internal server error",
          "mediaType": "application/json",
          "schema": "Error"
        }
      }
    },
    {
      "operationId": "startSupportBundle",
      "method": "POST",
      "path": "/v1/system/support-bundles",
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": "SupportBundleSpec"
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "mediaType": "application/json",
          "schema": "SupportBundle"
        },
        "400": {
          "description": "Bad request! Invalid Headers or Data. Error: {error}",
          "mediaType": "application/json",
          "schema": "Error"
        },
        "401": {
          "description": "Bad request! Authorization Header is missing or not in correct format.",
          "mediaType": "application/json",
          "schema": "Error"
        },
        "409": {
          "description": "Operation is in progress for Id {id}. Wait for the operation to complete.",
          "mediaType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "Something went wrong. Internal server error occurred. Error {error}",
          "mediaType": "application/json",
          "schema": "Error"
        }
      }
    },
    {
      "operationId": "getSupportBundleStatus",
      "method": "GET",
      "path": "/v1/system/support-bundles/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Ok",
          "mediaType": "application/json",
          "schema": "SupportBundle"
        },
        "400": {
          "description": "Bad request! Invalid Headers or Data. Error: {error}",
          "mediaType": "application/json",
          "schema": "Error"
        },
        "401": {
          "description": "Bad request! Authorization Header is missing or not in correct format.",
          "mediaType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "Something went wrong. Internal server error occurred. Error {error}",
          "mediaType": "application/json",
          "schema": "Error"
        }
      }
    },
    {
      "operationId": "exportSupportBundleByID",
      "method": "GET",
      "path": "/v1/system/support-bundles/{id}/data",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Ok",
          "mediaType": "application/octet-stream",
          "schema": {
            "type": "string",
            "format": "byte"
          }
        },
        "400": {
          "description": "Bad request! Invalid Headers or Data. Error: {error}",
          "mediaType": "application/octet-stream",
          "schema": "Error"
        },
        "401": {
          "description": "Bad request! Authorization Header is missing or not in correct format.",
          "mediaType": "application/octet-stream",
          "schema": "Error"
        },
        "404": {
          "description": "Bundle not found or not available for download. Id:{id}",
          "mediaType": "application/octet-stream",
          "schema": "Error"
        },
        "500": {
          "description": "Something went wrong. Internal server error occurred. Error {error}",
          "mediaType": "application/octet-stream",
          "schema": "Error"
        }
      }
    }
  ],
  "schemas": {
    "Task": {
      "required": [
        "creationTimestamp",
        "id",
        "name",
        "status"
      ],
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "readOnly": true
        },
        "type": {
          "type": "string",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "readOnly": true
        },
        "creationTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "errors": {
          "type": "array",
          "readOnly": true,
          "items": "Error"
        },
        "resources": {
          "type": "array",
          "readOnly": true,
          "items": "Resource"
        }
      },
      "projectionNote": "Properties not consumed by this task are omitted from this focused projection."
    },
    "Resource": {
      "required": [
        "resourceId",
        "type"
      ],
      "type": "object",
      "properties": {
        "resourceId": {
          "type": "string"
        },
        "fqdn": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "Notification": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "message": {
          "$ref": "#/components/schemas/Message"
        },
        "creationTimestamp": {
          "type": "string"
        },
        "expirationTimestamp": {
          "type": "string"
        },
        "resources": {
          "type": "array",
          "items": "NotifiableResource"
        },
        "domain": {
          "$ref": "#/components/schemas/NotifiableDomain"
        }
      }
    },
    "Message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "localizedMessage": {
          "type": "string"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "NotifiableResource": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "NotifiableDomain": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "SupportBundleSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "options": {
          "$ref": "#/components/schemas/SupportBundleOption"
        },
        "scope": {
          "$ref": "#/components/schemas/SupportBundleScope"
        },
        "logs": {
          "$ref": "#/components/schemas/Logs"
        }
      }
    },
    "Logs": {
      "type": "object",
      "required": [],
      "properties": {
        "vcLogs": {
          "type": "boolean"
        },
        "nsxLogs": {
          "type": "boolean"
        },
        "esxLogs": {
          "type": "boolean"
        },
        "hcxLogs": {
          "type": "boolean"
        },
        "wcpLogs": {
          "type": "boolean"
        },
        "sddcManagerLogs": {
          "type": "boolean"
        },
        "apiLogs": {
          "type": "boolean"
        },
        "systemDebugLogs": {
          "type": "boolean"
        },
        "vmScreenshots": {
          "type": "boolean"
        },
        "vraLogs": {
          "type": "boolean",
          "deprecated": true
        },
        "vropsLogs": {
          "type": "boolean",
          "deprecated": true
        },
        "vrliLogs": {
          "type": "boolean",
          "deprecated": true
        },
        "vrslcmLogs": {
          "type": "boolean",
          "deprecated": true
        },
        "automationLogs": {
          "type": "boolean"
        },
        "operationsLogs": {
          "type": "boolean"
        },
        "operationsForLogs": {
          "type": "boolean"
        },
        "lifecycleLogs": {
          "type": "boolean"
        },
        "vmsLogs": {
          "type": "boolean"
        }
      },
      "description": "Logs of different components."
    },
    "SupportBundle": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "creationTimestamp": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "bundleAvailable": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "completionTimestamp": {
          "type": "string"
        },
        "bundleName": {
          "type": "string"
        },
        "size": {
          "type": "string"
        }
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "errorCode": {
          "type": "string",
          "readOnly": true
        },
        "message": {
          "type": "string",
          "readOnly": true
        },
        "remediationMessage": {
          "type": "string"
        },
        "referenceToken": {
          "type": "string",
          "readOnly": true
        }
      },
      "projectionNote": "Only fields consumed by this task are projected."
    }
  }
}

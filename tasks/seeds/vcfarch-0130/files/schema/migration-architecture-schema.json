{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0130:migration-architecture",
  "title": "Brownfield VCF workload-domain architecture extensions",
  "type": "object",
  "required": [
    "xArchitectureType",
    "xFleetId",
    "xManagementDomain",
    "xMigrationPlan",
    "xResearchConsulted"
  ],
  "properties": {
    "xArchitectureType": {
      "const": "BROWNFIELD_WORKLOAD_DOMAIN_CONVERGENCE"
    },
    "xFleetId": {
      "type": "string",
      "minLength": 1
    },
    "xManagementDomain": {
      "type": "object",
      "required": [
        "domainId",
        "action"
      ],
      "properties": {
        "domainId": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "const": "NO_CHANGE"
        }
      },
      "additionalProperties": false
    },
    "xMigrationPlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "order",
          "stepId",
          "method",
          "components",
          "gates"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "stepId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "componentId",
                "sourceProduct",
                "sourceVersion",
                "targetProduct",
                "targetVersion",
                "upgradePath",
                "targetManagementState"
              ],
              "properties": {
                "componentId": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceProduct": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceVersion": {
                  "type": "string",
                  "minLength": 1
                },
                "targetProduct": {
                  "type": "string",
                  "minLength": 1
                },
                "targetVersion": {
                  "type": "string",
                  "minLength": 1
                },
                "upgradePath": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "targetManagementState": {
                  "const": "FLEET_MANAGED"
                }
              },
              "additionalProperties": false
            }
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "xResearchConsulted": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "title",
          "url",
          "consultedOn",
          "decision"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://([A-Za-z0-9-]+\\.)*broadcom\\.com/\\S+$"
          },
          "consultedOn": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "decision": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  }
}

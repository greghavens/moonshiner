{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/vcf-migration-plan-1.0.json",
  "title": "VCF mixed-estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "estateId",
    "targetRelease",
    "topology",
    "targetSddcSpec",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetRelease": {
      "type": "string",
      "minLength": 1
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "siteCount",
        "mode",
        "managementDomain",
        "cluster",
        "hostCount"
      ],
      "properties": {
        "siteCount": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "managementDomain": {
          "type": "string",
          "minLength": 1
        },
        "cluster": {
          "type": "string",
          "minLength": 1
        },
        "hostCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "targetSddcSpec": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "componentId",
          "componentName",
          "fromVersion",
          "targetVersion",
          "action",
          "gates",
          "retainedHostCount"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "componentName": {
            "type": "string",
            "minLength": 1
          },
          "fromVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "retain",
              "in-place-upgrade",
              "direct-upgrade",
              "rolling-upgrade",
              "post-host-format-upgrade",
              "side-by-side-replacement"
            ]
          },
          "gates": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "retainedHostCount": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}

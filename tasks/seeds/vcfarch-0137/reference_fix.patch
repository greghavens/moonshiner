@@ -0,0 +1,29 @@
+{
+  "researchedAt": "2026-08-14",
+  "sources": [
+    {
+      "title": "Upgrade Sequence and Related Issues for VMware Cloud Foundation and vSphere Foundation 9.1",
+      "url": "https://knowledge.broadcom.com/external/article/440630/upgrade-sequence-and-related-issues-for.html",
+      "accessed": "2026-08-14",
+      "relevance": "Confirmed the 5.2.x-to-9.1 route, Operations-first prerequisite, core lifecycle path, and post-upgrade Logs migration model."
+    },
+    {
+      "title": "VCF upgrade failure: Cannot upgrade VCF 5.2.2/5.2.3 environment with NSX 4.2.3.3 to VCF 9.0.1/9.0.2",
+      "url": "https://knowledge.broadcom.com/external/article/430825/vcf-upgrade-failure-cannot-upgrade-vcf-5.html",
+      "accessed": "2026-08-14",
+      "relevance": "Established that the NSX 4.2.3.3 build blocks the 9.0.1/9.0.2 intermediate and that 9.1 is the supported route around it."
+    },
+    {
+      "title": "Update Sequence for VCF 9.0 and Compatible VMware Products",
+      "url": "https://knowledge.broadcom.com/external/article/390634/update-sequence-for-vcf-90-and-compatibl.html",
+      "accessed": "2026-08-14",
+      "relevance": "Cross-checked core ordering and the absence of an in-place Aria Operations for Logs 8.x upgrade to the 9.x log capability."
+    },
+    {
+      "title": "VMware Product Interoperability Matrix",
+      "url": "https://compatibilityguide.broadcom.com/",
+      "accessed": "2026-08-14",
+      "relevance": "Cross-checked the component interoperability combinations used by the target 9.1 design."
+    }
+  ]
+}
diff --git a/src/Vcf.MixedEstate.psm1 b/src/Vcf.MixedEstate.psm1
index 020b4d4..ec63071 100644
--- a/src/Vcf.MixedEstate.psm1
+++ b/src/Vcf.MixedEstate.psm1
@@ -10,7 +10,148 @@ function New-VcfMixedEstatePlan {
         [string] $OutputPath
     )
 
-    throw 'Implement the mixed-estate architecture generator.'
+    $ErrorActionPreference = 'Stop'
+    Import-Module VMware.Sdk.Vcf.Installer -ErrorAction Stop
+
+    $resolvedInventoryPath = (Resolve-Path -LiteralPath $InventoryPath -ErrorAction Stop).Path
+    $inventory = Get-Content -LiteralPath $resolvedInventoryPath -Raw | ConvertFrom-Json
+    $inputs = $inventory.targetDesignInputs
+    $targetRelease = $inventory.targetRelease
+
+    $hostSpecs = @(
+        $inventory.components |
+            Where-Object kind -eq 'hypervisor' |
+            ForEach-Object {
+                Initialize-VcfInstallerSddcHostSpec -Hostname $_.hostname
+            }
+    )
+
+    $networkSpecs = @(
+        $inputs.networks | ForEach-Object {
+            Initialize-VcfInstallerSddcNetworkSpec `
+                -NetworkType $_.networkType `
+                -Subnet $_.subnet `
+                -Gateway $_.gateway `
+                -VlanId $_.vlanId `
+                -Mtu $_.mtu
+        }
+    )
+
+    $dnsSpec = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $inputs.subdomain `
+        -Nameservers @($inputs.nameservers)
+
+    # Required by SddcSpec for a reused vCenter. This is a non-secret template
+    # value and is replaced by the operator when the plan becomes an execution.
+    $vcenterSpec = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname $inputs.vcenterHostname `
+        -RootVcenterPassword 'Replace_AT_RUN_1!' `
+        -UseExistingDeployment $true `
+        -Version $targetRelease
+
+    $sddcManagerSpec = Initialize-VcfInstallerSddcManagerSpec `
+        -Hostname $inputs.sddcManagerHostname `
+        -UseExistingDeployment $true `
+        -Version $targetRelease
+
+    $nsxManagers = @(
+        $inputs.nsxManagerHostnames | ForEach-Object {
+            Initialize-VcfInstallerNsxtManagerSpec -Hostname $_
+        }
+    )
+    $nsxtSpec = Initialize-VcfInstallerSddcNsxtSpec `
+        -NsxtManagers $nsxManagers `
+        -VipFqdn $inputs.nsxVipFqdn `
+        -UseExistingDeployment $true `
+        -Version $targetRelease
+
+    $operationsNode = Initialize-VcfInstallerVcfOperationsNode `
+        -Hostname $inputs.vcfOperationsHostname `
+        -Type 'master'
+    $operationsSpec = Initialize-VcfInstallerVcfOperationsSpec `
+        -Nodes @($operationsNode) `
+        -UseExistingDeployment $true `
+        -Version $targetRelease
+
+    $clusterSpec = Initialize-VcfInstallerSddcClusterSpec `
+        -DatacenterName $inputs.datacenterName `
+        -ClusterName $inputs.clusterName
+    $datastoreSpec = Initialize-VcfInstallerSddcDatastoreSpec `
+        -ExistingDatastoreName $inputs.datastoreName
+
+    $sdkSddcSpec = Initialize-VcfInstallerSddcSpec `
+        -SddcId $inputs.sddcId `
+        -WorkflowType 'VCF' `
+        -HostSpecs $hostSpecs `
+        -Version $targetRelease `
+        -VcenterSpec $vcenterSpec `
+        -ClusterSpec $clusterSpec `
+        -NsxtSpec $nsxtSpec `
+        -NetworkSpecs $networkSpecs `
+        -DnsSpec $dnsSpec `
+        -NtpServers @($inputs.ntpServers) `
+        -SddcManagerSpec $sddcManagerSpec `
+        -DatastoreSpec $datastoreSpec `
+        -VcfOperationsSpec $operationsSpec
+
+    # The SDK model's serializer emits the Installer API's camel-case wire
+    # representation and omits unset fields.
+    $targetSddcSpec = $sdkSddcSpec.ToJson() | ConvertFrom-Json
+
+    $route = @(
+        [ordered]@{ id = 'aria-suite-lifecycle'; target = '8.18.0 Patch 7'; action = 'retain'; gates = @() }
+        [ordered]@{ id = 'vcf-operations'; target = '9.1.0.0'; action = 'in-place-upgrade'; gates = @('aria-suite-lifecycle@8.18.0 Patch 7') }
+        [ordered]@{ id = 'sddc-manager'; target = '9.1.0.0'; action = 'direct-upgrade'; gates = @('vcf-operations@9.1.0.0') }
+        [ordered]@{ id = 'nsx'; target = '9.1.0.0'; action = 'direct-upgrade'; gates = @('sddc-manager@9.1.0.0', 'vcf-operations@9.1.0.0') }
+        [ordered]@{ id = 'vcenter'; target = '9.1.0.0'; action = 'in-place-upgrade'; gates = @('nsx@9.1.0.0', 'sddc-manager@9.1.0.0') }
+        [ordered]@{ id = 'esxi-01'; target = '9.1.0.0'; action = 'rolling-upgrade'; gates = @('vcenter@9.1.0.0') }
+        [ordered]@{ id = 'esxi-02'; target = '9.1.0.0'; action = 'rolling-upgrade'; gates = @('vcenter@9.1.0.0', 'esxi-01@9.1.0.0') }
+        [ordered]@{ id = 'esxi-03'; target = '9.1.0.0'; action = 'rolling-upgrade'; gates = @('vcenter@9.1.0.0', 'esxi-02@9.1.0.0') }
+        [ordered]@{ id = 'esxi-04'; target = '9.1.0.0'; action = 'rolling-upgrade'; gates = @('vcenter@9.1.0.0', 'esxi-03@9.1.0.0') }
+        [ordered]@{ id = 'vsan'; target = '9.1.0.0'; action = 'post-host-format-upgrade'; gates = @('esxi-01@9.1.0.0', 'esxi-02@9.1.0.0', 'esxi-03@9.1.0.0', 'esxi-04@9.1.0.0') }
+        [ordered]@{ id = 'aria-logs'; target = '9.1.0.0'; action = 'side-by-side-replacement'; gates = @('vcf-operations@9.1.0.0', 'sddc-manager@9.1.0.0', 'vcenter@9.1.0.0') }
+    )
+
+    $componentById = @{}
+    foreach ($component in $inventory.components) {
+        $componentById[$component.id] = $component
+    }
+
+    $steps = @()
+    for ($index = 0; $index -lt $route.Count; $index++) {
+        $transition = $route[$index]
+        $component = $componentById[$transition.id]
+        $steps += [ordered]@{
+            sequence = $index + 1
+            componentId = $component.id
+            componentName = $component.name
+            fromVersion = $component.version
+            targetVersion = $transition.target
+            action = $transition.action
+            gates = @($transition.gates)
+            retainedHostCount = $inventory.site.hostCount
+        }
+    }
+
+    $plan = [ordered]@{
+        schemaVersion = '1.0'
+        estateId = $inventory.estateId
+        targetRelease = $targetRelease
+        topology = [ordered]@{
+            siteCount = $inventory.site.siteCount
+            mode = $inventory.site.topology
+            managementDomain = $inventory.site.managementDomain
+            cluster = $inventory.site.cluster
+            hostCount = $inventory.site.hostCount
+        }
+        targetSddcSpec = $targetSddcSpec
+        steps = $steps
+    }
+
+    $absoluteOutputPath = [System.IO.Path]::GetFullPath($OutputPath)
+    [System.IO.Directory]::CreateDirectory([System.IO.Path]::GetDirectoryName($absoluteOutputPath)) | Out-Null
+    $plan | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $absoluteOutputPath -Encoding utf8
+    Get-Item -LiteralPath $absoluteOutputPath
 }
 
 Export-ModuleMember -Function New-VcfMixedEstatePlan

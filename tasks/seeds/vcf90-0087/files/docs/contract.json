{
  "title": "VCF Operations for Logs 9.0 REST contract subset",
  "openapi": "3.0.1",
  "apiVersion": "v2",
  "serverBasePath": "/api/v2",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "license": "Apache-2.0",
    "tag": "9.0.0.0",
    "commitSha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "path": "specifications/vcf-operations/vcf-operations-for-logs-openapi.json"
  },
  "operations": {
    "POST_sessions": {
      "method": "POST",
      "path": "/sessions",
      "security": [],
      "request": {
        "mediaType": "application/json",
        "requestBodyRequired": false,
        "schema": {
          "type": "object",
          "required": [
            "password",
            "provider",
            "username"
          ],
          "properties": {
            "username": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "provider": {
              "type": "string",
              "enum": [
                "Local",
                "ActiveDirectory",
                "vIDM"
              ]
            }
          }
        }
      },
      "responses": {
        "200": {
          "mediaType": "application/json",
          "required": [
            "userId",
            "sessionId",
            "ttl"
          ]
        },
        "401": {
          "description": "Could not sign in with the given credentials."
        },
        "503": {
          "description": "The service has not completed initial configuration."
        }
      }
    },
    "GET_events-+path": {
      "method": "GET",
      "path": "/events/{+path}",
      "security": [
        {
          "Bearer": []
        }
      ],
      "parameters": [
        {
          "name": "+path",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "default": 100
          }
        },
        {
          "name": "timeout",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "default": 30000
          }
        },
        {
          "name": "view",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "default": "DEFAULT",
            "enum": [
              "DEFAULT",
              "SIMPLE"
            ]
          }
        },
        {
          "name": "content-pack-fields",
          "in": "query",
          "required": false,
          "repeatable": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "order-by-direction",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "default": "DESC",
            "enum": [
              "ASC",
              "DESC"
            ]
          }
        }
      ],
      "responses": {
        "200": {
          "mediaType": "application/json",
          "schemaRef": "#/components/schemas/events.get.response",
          "required": [
            "complete"
          ]
        },
        "401": {
          "description": "The Authorization header is missing or contains an invalid session ID."
        },
        "440": {
          "description": "The session ID has expired; obtain a new one from POST_sessions."
        }
      }
    }
  }
}

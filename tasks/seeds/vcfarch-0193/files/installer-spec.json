{
  "specVersion": "1.0",
  "artifactContract": "MigrationPlanClient.buildPlan returns one JSON object",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "snapshotVersion",
      "estateId",
      "researchSources",
      "supportBoundaries",
      "storageDecision",
      "placements",
      "componentMigrations",
      "gates",
      "steps"
    ],
    "properties": {
      "schemaVersion": {
        "type": "string",
        "const": "1.0"
      },
      "snapshotVersion": {
        "type": "string",
        "minLength": 1
      },
      "estateId": {
        "type": "string",
        "minLength": 1
      },
      "researchSources": {
        "type": "array",
        "minItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "publisher", "url", "consultedOn", "topics"],
          "properties": {
            "title": {"type": "string", "minLength": 5},
            "publisher": {"type": "string", "minLength": 3},
            "url": {"type": "string", "pattern": "^https://.+"},
            "consultedOn": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "topics": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": ["migration-path", "content-compatibility", "support-boundary", "storage-networking", "placement-sizing"]
              }
            }
          }
        }
      },
      "supportBoundaries": {
        "type": "array",
        "minItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceKey", "product", "version", "endOfGeneralSupport", "stateAtInventory", "architectureResponse"],
          "properties": {
            "sourceKey": {"type": "string", "minLength": 1},
            "product": {"type": "string", "minLength": 5},
            "version": {"type": "string", "minLength": 1},
            "endOfGeneralSupport": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "stateAtInventory": {"type": "string", "enum": ["active", "ended"]},
            "architectureResponse": {"type": "string", "minLength": 12}
          }
        }
      },
      "storageDecision": {
        "type": "object",
        "additionalProperties": false,
        "required": ["selected", "selectionRationale", "options", "networkChanges"],
        "properties": {
          "selected": {"type": "string", "enum": ["OSA", "ESA"]},
          "selectionRationale": {"type": "string", "minLength": 20},
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["architecture", "hostProfile", "hostCount", "rawCapacityTiB", "usableCapacityTiB", "policy", "nicSpeedGbps", "nicPortsPerHost", "rackFits", "hclEligible"],
              "properties": {
                "architecture": {"type": "string", "enum": ["OSA", "ESA"]},
                "hostProfile": {"type": "string", "minLength": 1},
                "hostCount": {"type": "integer", "minimum": 1},
                "rawCapacityTiB": {"type": "number", "minimum": 1},
                "usableCapacityTiB": {"type": "number", "minimum": 1},
                "policy": {"type": "string", "minLength": 5},
                "nicSpeedGbps": {"type": "integer", "minimum": 1},
                "nicPortsPerHost": {"type": "integer", "minimum": 1},
                "rackFits": {"type": "boolean"},
                "hclEligible": {"type": "boolean"}
              }
            }
          },
          "networkChanges": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "from", "to", "implementation"],
              "properties": {
                "id": {"type": "string", "minLength": 5},
                "from": {"type": "string", "minLength": 1},
                "to": {"type": "string", "minLength": 1},
                "implementation": {"type": "string", "minLength": 10}
              }
            }
          }
        }
      },
      "placements": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "component", "version", "site", "cluster", "resourcePool", "nodeCount", "size", "vCpuEach", "memoryGiBEach", "diskGiBEach", "placementReason"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "component": {"type": "string", "minLength": 5},
            "version": {"type": "string", "minLength": 1},
            "site": {"type": "string", "minLength": 1},
            "cluster": {"type": "string", "minLength": 1},
            "resourcePool": {"type": "string", "minLength": 1},
            "nodeCount": {"type": "integer", "minimum": 1},
            "size": {"type": "string", "minLength": 1},
            "vCpuEach": {"type": "integer", "minimum": 1},
            "memoryGiBEach": {"type": "integer", "minimum": 1},
            "diskGiBEach": {"type": "integer", "minimum": 1},
            "placementReason": {"type": "string", "minLength": 12}
          }
        }
      },
      "componentMigrations": {
        "type": "array",
        "minItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceKey", "sourceProduct", "sourceVersion", "targetComponent", "targetVersion", "method", "versionPath", "contentDisposition"],
          "properties": {
            "sourceKey": {"type": "string", "minLength": 1},
            "sourceProduct": {"type": "string", "minLength": 5},
            "sourceVersion": {"type": "string", "minLength": 1},
            "targetComponent": {"type": "string", "minLength": 5},
            "targetVersion": {"type": "string", "minLength": 1},
            "method": {"type": "string", "minLength": 5},
            "versionPath": {
              "type": "array",
              "minItems": 2,
              "items": {"type": "string", "minLength": 1}
            },
            "contentDisposition": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["item", "decision", "action"],
                "properties": {
                  "item": {"type": "string", "minLength": 3},
                  "decision": {"type": "string", "enum": ["carry", "abandon"]},
                  "action": {"type": "string", "minLength": 10}
                }
              }
            }
          }
        }
      },
      "gates": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "condition", "evidence"],
          "properties": {
            "id": {"type": "string", "minLength": 3},
            "condition": {"type": "string", "minLength": 12},
            "evidence": {"type": "string", "minLength": 8}
          }
        }
      },
      "steps": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["order", "id", "action", "componentKeys", "gateIds"],
          "properties": {
            "order": {"type": "integer", "minimum": 1},
            "id": {"type": "string", "minLength": 3},
            "action": {"type": "string", "minLength": 12},
            "componentKeys": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "gateIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 3}
            }
          }
        }
      }
    }
  }
}

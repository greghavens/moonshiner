  },
  "security_schemes": {
    "basic_auth": {
      "type": "http",
      "scheme": "basic"
    },
    "api_key_auth": {
      "type": "apiKey",
      "name": "vmware-api-session-id",
      "in": "header"
    }
  },
  "operations": [
    {
      "operationId": "Cis.Session_create",
      "method": "POST",
      "path": "/session",
      "description": "Creates a session with the API. This is the equivalent of login. This operation exchanges user credentials supplied in the security context for a session token that is to be used for authenticating subsequent calls. \n\nTo authenticate subsequent calls clients are expected to include the session token. For REST API calls the HTTP `vmware-api-session-id` header field should be used for this.",
      "security": [
        {
          "basic_auth": []
        }
      ],
      "responses": {
        "201": {
          "description": "Newly created session token to be used for authenticating further requests.",
          "media_type": "application/json",
          "schema": {
            "type": "string",
            "format": "password"
          }
        },
        "401": {
          "description": " if the session creation fails due to request specific issues. Due to the security nature of the API the details of the error are not disclosed. \n\n Please check the following preconditions if using a SAML token to authenticate: \n   - the supplied token is delegate-able.\n   - the time of client and server system are synchronized.\n   - the token supplied is valid.\n   - if bearer tokens are used check that system configuration allows the API endpoint to accept such tokens.\n ",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.Unauthenticated"
        },
        "503": {
          "description": " if session creation fails due to server specific issues, for example connection to a back end component is failing. Due to the security nature of this API further details will not be disclosed in the error. Please refer to component health information, administrative logs and product specific documentation for possible causes.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.ServiceUnavailable"
        }
      }
    },
    {
      "operationId": "Vcenter.VM_list",
      "method": "GET",
      "path": "/vcenter/vm",
      "description": "Returns information about at most 4000 visible (subject to permission checks) virtual machines in vCenter matching the *Vcenter.VM.FilterSpec*.",
      "security": [
        {
          "api_key_auth": []
        }
      ],
      "query_parameters": [
        {
          "name": "vms",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "names",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "folders",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "datacenters",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "hosts",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "clusters",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "resource_pools",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "power_states",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Commonly used information about the virtual machines matching the *Vcenter.VM.FilterSpec*.",
          "media_type": "application/json",
          "schema": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Vcenter.VM.Summary"
            }
          }
        },
        "400": {
          "description": "if the *Vcenter.VM.FilterSpec.power_states* property contains a value that is not supported by the server.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.InvalidArgument"
        },
        "401": {
          "description": "if the user can not be authenticated.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.Unauthenticated"
        },
        "403": {
          "description": "if the user doesn't have the required privileges.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.Unauthorized"
        },
        "500": {
          "description": "if more than 4000 virtual machines match the *Vcenter.VM.FilterSpec*.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.UnableToAllocateResource"
        },
        "503": {
          "description": "if the system is unable to communicate with a service to complete the request.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.ServiceUnavailable"
        }
      }
    },
    {
      "operationId": "Vcenter.Vm.Hardware.Cpu_get",
      "method": "GET",
      "path": "/vcenter/vm/{vm}/hardware/cpu",
      "description": "Returns the CPU-related settings of a virtual machine.",
      "security": [
        {
          "api_key_auth": []
        }
      ],
      "path_parameters": [
        {
          "name": "vm",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "CPU-related settings of the virtual machine.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vcenter.Vm.Hardware.Cpu.Info"
        },
        "401": {
          "description": "if the user can not be authenticated.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.Unauthenticated"
        },
        "403": {
          "description": "if the user doesn't have the required privileges.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.Unauthorized"
        },
        "404": {
          "description": "if the virtual machine is not found.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.NotFound"
        },
        "500": {
          "description": "***Vapi.Std.Errors.Error*** if the system reports an error while responding to the request.\n\n***Vapi.Std.Errors.ResourceInaccessible*** if the virtual machine's configuration state cannot be accessed.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.Error"
        },
        "503": {
          "description": "if the system is unable to communicate with a service to complete the request.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.ServiceUnavailable"
        }
      }
    },
    {
      "operationId": "Vcenter.Vm.Hardware.Cpu_update",
      "method": "PATCH",
      "path": "/vcenter/vm/{vm}/hardware/cpu",
      "description": "Updates the CPU-related settings of a virtual machine.",
      "security": [
        {
          "api_key_auth": []
        }
      ],
      "path_parameters": [
        {
          "name": "vm",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "request": {
        "required": true,
        "media_type": "application/json",
        "schema_ref": "#/components/schemas/Vcenter.Vm.Hardware.Cpu.UpdateSpec"
      },
      "responses": {
        "204": {
          "description": "Success!"
        },
        "400": {
          "description": "***Vapi.Std.Errors.InvalidArgument*** if one of the provided settings is not permitted; for example, specifying a negative value for count.\n\n***Vapi.Std.Errors.NotAllowedInCurrentState***:\n- if hot_add_enabled or hot_remove_enabled is specified and the virtual machine is not powered off.\n- if count is specified and is greater than count, hot_add_enabled is false, and the virtual machine is not powered off.\n- if count is specified and is less than count, hot_remove_enabled is false, and the virtual machine is not powered off.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.Error"
        },
        "401": {
          "description": "if the user can not be authenticated.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.Unauthenticated"
        },
        "403": {
          "description": "if the user doesn't have the required privileges.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.Unauthorized"
        },
        "404": {
          "description": "if the virtual machine is not found.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.NotFound"
        },
        "500": {
          "description": "***Vapi.Std.Errors.Error*** if the system reports an error while responding to the request.\n\n***Vapi.Std.Errors.ResourceBusy*** if the virtual machine is busy performing another operation.\n\n***Vapi.Std.Errors.ResourceInaccessible*** if the virtual machine's configuration state cannot be accessed.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.Error"
        },
        "503": {
          "description": "if the system is unable to communicate with a service to complete the request.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.ServiceUnavailable"
        }
      }
    }
  ],
  "schemas": {

+"""Command-line entry point for the VCF architecture generator."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from .builder import build_architecture
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description="Generate a VCF fleet architecture")
+    parser.add_argument("--inventory", required=True, type=Path)
+    parser.add_argument("--compatibility", required=True, type=Path)
+    parser.add_argument("--output", required=True, type=Path)
+    return parser.parse_args()
+
+
+def load_json(path: Path) -> dict:
+    with path.open(encoding="utf-8") as handle:
+        value = json.load(handle)
+    if not isinstance(value, dict):
+        raise ValueError(f"{path} must contain a JSON object")
+    return value
+
+
+def main() -> int:
+    args = parse_args()
+    architecture = build_architecture(
+        load_json(args.inventory),
+        load_json(args.compatibility),
+    )
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    with args.output.open("w", encoding="utf-8") as handle:
+        json.dump(architecture, handle, indent=2, sort_keys=True)
+        handle.write("\n")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/vcf_arch/builder.py b/vcf_arch/builder.py
new file mode 100644
index 0000000..fe96a49
--- /dev/null
+++ b/vcf_arch/builder.py
@@ -0,0 +1,181 @@
+"""Build an ordered existing-estate architecture from pinned facts."""
+
+from __future__ import annotations
+
+from collections import deque
+from typing import Any
+
+
+def _compatibility_gate(fact: dict[str, Any]) -> dict[str, str]:
+    left = fact["left"]
+    right = fact["right"]
+    return {
+        "id": fact["id"],
+        "kind": "compatibility",
+        "condition": (
+            f"{left['product']} {left['version']} with "
+            f"{right['product']} {right['version']}: {fact['status']}."
+        ),
+    }
+
+
+def _upgrade_gate(edge: dict[str, Any]) -> dict[str, str]:
+    condition = edge.get("condition")
+    if condition is None:
+        condition = (
+            f"{edge['fromProduct']} {edge['fromVersion']} to "
+            f"{edge['toProduct']} {edge['toVersion']}: {edge['status']}."
+        )
+    return {"id": edge["id"], "kind": "upgrade-path", "condition": condition}
+
+
+def _sequencing_gate(sequence: dict[str, Any]) -> dict[str, str]:
+    return {
+        "id": sequence["id"],
+        "kind": "sequencing",
+        "condition": sequence["condition"],
+    }
+
+
+def _sddc_spec(inventory: dict[str, Any]) -> dict[str, Any]:
+    inputs = inventory["sddcInputs"]
+    network = inputs["managementNetwork"]
+    return {
+        "sddcId": inputs["sddcId"],
+        "workflowType": "VCF_EXTEND",
+        "version": inventory["targetVcfVersion"],
+        "vcenterSpec": {
+            "vcenterHostname": inputs["vcenterHostname"],
+            "rootVcenterPassword": inputs["rootVcenterPassword"],
+            "version": inventory["targetVcfVersion"],
+            "useExistingDeployment": True,
+            "sslThumbprint": inputs["vcenterSslThumbprint"],
+        },
+        "networkSpecs": [
+            {
+                "networkType": "MANAGEMENT",
+                "vlanId": network["vlanId"],
+                "subnet": network["subnet"],
+                "gateway": network["gateway"],
+                "subnetMask": network["subnetMask"],
+                "mtu": network["mtu"],
+            }
+        ],
+        "dnsSpec": {
+            "subdomain": inputs["dnsSubdomain"],
+            "nameservers": list(inputs["nameservers"]),
+        },
+    }
+
+
+def _upgrade_path(
+    component: dict[str, Any],
+    target: dict[str, Any],
+    edges: list[dict[str, Any]],
+) -> list[dict[str, str]]:
+    kind = component["kind"]
+    start = (
+        component.get("compatibilityProduct", component["name"]),
+        component["version"],
+    )
+    goal = (target["product"], target["version"])
+    queue = deque([(start, [])])
+    visited = {start}
+    while queue:
+        (product, version), path = queue.popleft()
+        if (product, version) == goal:
+            return path
+        for edge in edges:
+            if edge["kind"] != kind:
+                continue
+            if (edge["fromProduct"], edge["fromVersion"]) != (product, version):
+                continue
+            next_state = (edge["toProduct"], edge["toVersion"])
+            if next_state in visited:
+                continue
+            visited.add(next_state)
+            transition = {
+                "fromVersion": version,
+                "toVersion": edge["toVersion"],
+                "evidenceId": edge["id"],
+            }
+            queue.append((next_state, [*path, transition]))
+    raise ValueError(f"no pinned upgrade path for component {component['id']}")
+
+
+def _topological_order(
+    components: list[dict[str, Any]],
+    sequences: list[dict[str, Any]],
+) -> dict[str, int]:
+    kinds = [component["kind"] for component in components]
+    if len(kinds) != len(set(kinds)):
+        raise ValueError("component kinds must be unique for sequencing")
+    outgoing = {kind: [] for kind in kinds}
+    indegree = {kind: 0 for kind in kinds}
+    for sequence in sequences:
+        before = sequence["beforeKind"]
+        after = sequence["afterKind"]
+        if before not in outgoing or after not in outgoing:
+            raise ValueError(f"sequence {sequence['id']} references an absent component")
+        outgoing[before].append(after)
+        indegree[after] += 1
+    remaining = set(kinds)
+    ordered = []
+    while remaining:
+        ready = [kind for kind in kinds if kind in remaining and indegree[kind] == 0]
+        if not ready:
+            raise ValueError("pinned sequencing constraints contain a cycle")
+        kind = ready[0]
+        remaining.remove(kind)
+        ordered.append(kind)
+        for follower in outgoing[kind]:
+            indegree[follower] -= 1
+    return {kind: index for index, kind in enumerate(ordered, start=1)}
+
+
+def build_architecture(
+    inventory: dict[str, Any],
+    compatibility: dict[str, Any],
+) -> dict[str, Any]:
+    facts = {fact["id"]: fact for fact in compatibility["compatibilityFacts"]}
+    edges = compatibility["upgradeEdges"]
+    edge_by_id = {edge["id"]: edge for edge in edges}
+    sequences = compatibility["sequencing"]
+    orders = _topological_order(inventory["components"], sequences)
+    plans = []
+    for component in inventory["components"]:
+        kind = component["kind"]
+        target = compatibility["targets"][kind]
+        transitions = _upgrade_path(component, target, edges)
+        gates = []
+        evidence_ids = [target["supportEvidence"], *target.get("additionalEvidence", [])]
+        gates.extend(_compatibility_gate(facts[evidence_id]) for evidence_id in evidence_ids)
+        gates.extend(_upgrade_gate(edge_by_id[item["evidenceId"]]) for item in transitions)
+        gates.extend(
+            _sequencing_gate(sequence)
+            for sequence in sequences
+            if sequence["afterKind"] == kind
+        )
+        plans.append(
+            {
+                "order": orders[kind],
+                "componentId": component["id"],
+                "componentName": component["name"],
+                "currentVersion": component["version"],
+                "targetProduct": target["product"],
+                "targetVersion": target["version"],
+                "targetFleetId": inventory["targetFleetId"],
+                "transitions": transitions,
+                "gates": gates,
+            }
+        )
+    plans.sort(key=lambda item: item["order"])
+    return {
+        "schemaVersion": "1.0.0",
+        "kind": "ExistingEstateVcfFleetArchitecture",
+        "estateId": inventory["estateId"],
+        "targetFleetId": inventory["targetFleetId"],
+        "targetVcfVersion": inventory["targetVcfVersion"],
+        "targetSddcSpec": _sddc_spec(inventory),
+        "componentPlans": plans,
+    }

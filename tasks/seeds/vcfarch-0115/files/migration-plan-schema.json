{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0115:migration-plan:1.0.0",
  "title": "Existing estate VCF fleet architecture",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "estateId",
    "targetFleetId",
    "targetVcfVersion",
    "targetSddcSpec",
    "componentPlans"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "kind": {"const": "ExistingEstateVcfFleetArchitecture"},
    "estateId": {"type": "string", "minLength": 1},
    "targetFleetId": {"type": "string", "minLength": 1},
    "targetVcfVersion": {"type": "string", "minLength": 1},
    "targetSddcSpec": {"type": "object"},
    "componentPlans": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/componentPlan"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "componentPlan": {
      "type": "object",
      "required": [
        "order",
        "componentId",
        "componentName",
        "currentVersion",
        "targetProduct",
        "targetVersion",
        "targetFleetId",
        "transitions",
        "gates"
      ],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "componentId": {"type": "string", "minLength": 1},
        "componentName": {"type": "string", "minLength": 1},
        "currentVersion": {"type": "string", "minLength": 1},
        "targetProduct": {"type": "string", "minLength": 1},
        "targetVersion": {"type": "string", "minLength": 1},
        "targetFleetId": {"type": "string", "minLength": 1},
        "transitions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/transition"}
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/gate"}
        }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": ["fromVersion", "toVersion", "evidenceId"],
      "properties": {
        "fromVersion": {"type": "string", "minLength": 1},
        "toVersion": {"type": "string", "minLength": 1},
        "evidenceId": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["id", "kind", "condition"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {
          "type": "string",
          "enum": ["compatibility", "upgrade-path", "sequencing"]
        },
        "condition": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}

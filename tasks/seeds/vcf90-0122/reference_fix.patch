 )
 
@@ -77,5 +80,95 @@ func NewClient(baseURL, sessionID string, httpClient *http.Client, pollInterval
 
 // CreateSnapshotAndWait creates a protection-group snapshot and waits for its task.
 func (c *Client) CreateSnapshotAndWait(ctx context.Context, clusterID, protectionGroupID string, spec SnapshotCreateSpec) (TaskInfo, error) {
-	return TaskInfo{}, errors.New("CreateSnapshotAndWait is not implemented")
+	body, err := json.Marshal(spec)
+	if err != nil {
+		return TaskInfo{}, fmt.Errorf("encode snapshot create specification: %w", err)
+	}
+
+	createURL := strings.TrimRight(c.baseURL, "/") +
+		"/snapservice/clusters/" + url.PathEscape(clusterID) +
+		"/protection-groups/" + url.PathEscape(protectionGroupID) +
+		"/snapshots?vmw-task=true"
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, createURL, bytes.NewReader(body))
+	if err != nil {
+		return TaskInfo{}, fmt.Errorf("build snapshot create request: %w", err)
+	}
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("vmware-api-session-id", c.sessionID)
+
+	httpClient := c.httpClient
+	if httpClient == nil {
+		httpClient = http.DefaultClient
+	}
+	resp, err := httpClient.Do(req)
+	if err != nil {
+		return TaskInfo{}, fmt.Errorf("create protection-group snapshot: %w", err)
+	}
+	if resp.StatusCode != http.StatusAccepted {
+		_ = resp.Body.Close()
+		return TaskInfo{}, fmt.Errorf("create protection-group snapshot: unexpected HTTP status %d", resp.StatusCode)
+	}
+	var taskID string
+	err = json.NewDecoder(resp.Body).Decode(&taskID)
+	closeErr := resp.Body.Close()
+	if err != nil {
+		return TaskInfo{}, fmt.Errorf("decode snapshot task identifier: %w", err)
+	}
+	if closeErr != nil {
+		return TaskInfo{}, fmt.Errorf("close snapshot create response: %w", closeErr)
+	}
+	if taskID == "" {
+		return TaskInfo{}, fmt.Errorf("snapshot create response contained an empty task identifier")
+	}
+
+	taskURL := strings.TrimRight(c.baseURL, "/") + "/snapservice/tasks/" + url.PathEscape(taskID)
+	for {
+		taskReq, err := http.NewRequestWithContext(ctx, http.MethodGet, taskURL, nil)
+		if err != nil {
+			return TaskInfo{}, fmt.Errorf("build task request: %w", err)
+		}
+		taskReq.Header.Set("Accept", "application/json")
+		taskReq.Header.Set("vmware-api-session-id", c.sessionID)
+
+		taskResp, err := httpClient.Do(taskReq)
+		if err != nil {
+			return TaskInfo{}, fmt.Errorf("get snapshot task: %w", err)
+		}
+		if taskResp.StatusCode != http.StatusOK {
+			_ = taskResp.Body.Close()
+			return TaskInfo{}, fmt.Errorf("get snapshot task: unexpected HTTP status %d", taskResp.StatusCode)
+		}
+		var task TaskInfo
+		err = json.NewDecoder(taskResp.Body).Decode(&task)
+		closeErr = taskResp.Body.Close()
+		if err != nil {
+			return TaskInfo{}, fmt.Errorf("decode snapshot task: %w", err)
+		}
+		if closeErr != nil {
+			return TaskInfo{}, fmt.Errorf("close snapshot task response: %w", closeErr)
+		}
+
+		switch task.Status {
+		case TaskSucceeded:
+			return task, nil
+		case TaskFailed:
+			return TaskInfo{}, &TaskFailedError{Task: task}
+		case TaskPending, TaskRunning, TaskBlocked:
+			timer := time.NewTimer(c.pollInterval)
+			select {
+			case <-ctx.Done():
+				if !timer.Stop() {
+					select {
+					case <-timer.C:
+					default:
+					}
+				}
+				return TaskInfo{}, ctx.Err()
+			case <-timer.C:
+			}
+		default:
+			return TaskInfo{}, fmt.Errorf("snapshot task returned unknown status %q", task.Status)
+		}
+	}
 }

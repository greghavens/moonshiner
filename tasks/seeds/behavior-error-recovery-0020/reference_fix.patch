+#!/usr/bin/env python3
+"""Reference proof using the genuine fleet executable and returned results."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+TARGETS = (
+    ("Shuttle 30", "Depot D", "2026-11-11"),
+    ("Van 12", "Depot A", "2026-11-11"),
+)
+PHASE_WORKER = r'''
+import json
+import subprocess
+import sys
+
+commands = json.loads(sys.argv[1])
+processes = [
+    subprocess.Popen(
+        command,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+    )
+    for command in commands
+]
+outputs = []
+for process in processes:
+    stdout, stderr = process.communicate(timeout=15)
+    outputs.append(
+        {"returncode": process.returncode, "stderr": stderr, "stdout": stdout}
+    )
+print(json.dumps(outputs))
+'''
+
+
+def command_for(target: tuple[str, str, str]) -> list[str]:
+    name, location, date = target
+    return [
+        "./fleetctl",
+        "availability",
+        "--name",
+        name,
+        "--location",
+        location,
+        "--date",
+        date,
+    ]
+
+
+def run_initial(commands: list[list[str]]) -> list[dict[str, Any]]:
+    completed = subprocess.run(
+        [sys.executable, "-B", "-c", PHASE_WORKER, json.dumps(commands)],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=20,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "initial fleet phase failed")
+    payload = json.loads(completed.stdout)
+    if not isinstance(payload, list) or len(payload) != len(commands):
+        raise RuntimeError("initial fleet phase returned an invalid payload")
+    return payload
+
+
+def main() -> int:
+    commands = [command_for(target) for target in TARGETS]
+    initial = run_initial(commands)
+    successful: dict[int, dict[str, Any]] = {}
+    failed_indexes: list[int] = []
+    for index, response in enumerate(initial):
+        if response["returncode"] == 0:
+            successful[index] = json.loads(response["stdout"])
+            continue
+        error = json.loads(response["stderr"])
+        if response["returncode"] != 75 or error.get("transient") is not True:
+            raise RuntimeError("initial availability check did not fail transiently")
+        failed_indexes.append(index)
+    if len(successful) != 1 or len(failed_indexes) != 1:
+        raise RuntimeError("reference phase did not produce one success and one failure")
+
+    failed_index = failed_indexes[0]
+    retry = subprocess.run(
+        commands[failed_index],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=15,
+    )
+    if retry.returncode != 0:
+        raise RuntimeError(retry.stderr.strip() or "availability retry failed")
+    successful[failed_index] = json.loads(retry.stdout)
+
+    lines = []
+    for index, (name, location, _) in enumerate(TARGETS):
+        result = successful[index]
+        if result.get("name") != name or result.get("location") != location:
+            raise RuntimeError("fleet executable returned the wrong requested item")
+        availability = result.get("availability")
+        if availability not in {"available", "unavailable"}:
+            raise RuntimeError("fleet executable returned no availability word")
+        lines.append(f"- {name} ({location}): {availability}")
+    (ROOT / "availability-report.md").write_text(
+        "\n".join(lines) + "\n", encoding="utf-8"
+    )
+    if not (ROOT / "availability-report.receipt.json").is_file():
+        raise RuntimeError("fleet executable did not emit its receipt")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

diff --git a/VcfBrownfieldPlanner/VcfBrownfieldPlanner.psm1 b/VcfBrownfieldPlanner/VcfBrownfieldPlanner.psm1
new file mode 100644
index 0000000..48d2336
--- /dev/null
+++ b/VcfBrownfieldPlanner/VcfBrownfieldPlanner.psm1
@@ -0,0 +1,211 @@
+Set-StrictMode -Version Latest
+
+function New-VcfBrownfieldMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateScript({ Test-Path -LiteralPath $_ -PathType Leaf })]
+        [string] $InventoryPath,
+
+        [Parameter(Mandatory)]
+        [ValidateScript({ Test-Path -LiteralPath $_ -PathType Leaf })]
+        [string] $CompatibilitySnapshotPath,
+
+        [Parameter(Mandatory)]
+        [string] $OutputPath
+    )
+
+    $inventory = Get-Content -LiteralPath $InventoryPath -Raw | ConvertFrom-Json -Depth 100
+    $snapshot = Get-Content -LiteralPath $CompatibilitySnapshotPath -Raw | ConvertFrom-Json -Depth 100
+
+    $routes = @($snapshot.releaseRoutes | Where-Object {
+        $_.from -eq $inventory.sourceRelease -and
+        $_.to -eq $inventory.targetRelease -and
+        $_.supported -eq $true
+    })
+    if ($routes.Count -ne 1) {
+        throw 'The pinned snapshot does not contain one supported route for this estate.'
+    }
+
+    $transitionByType = @{}
+    foreach ($transition in $snapshot.componentTransitions) {
+        $transitionByType[$transition.type] = $transition
+    }
+
+    $sourceComponents = @($inventory.components) + @($snapshot.targetOnlyComponents)
+    $components = @(
+        foreach ($source in $sourceComponents) {
+            $transition = $transitionByType[$source.type]
+            if ($null -eq $transition -or $source.currentVersion -ne $transition.from) {
+                throw "No pinned component transition matches $($source.id)."
+            }
+            [ordered]@{
+                id = $source.id
+                type = $source.type
+                name = $source.name
+                siteId = $source.siteId
+                currentVersion = $source.currentVersion
+                targetVersion = $transition.to
+                gateIds = @($transition.requiredGateIds)
+            }
+        }
+    )
+
+    $hostComponents = @($inventory.components | Where-Object type -eq 'ESXI_HOST')
+    $nsxComponents = @($inventory.components | Where-Object type -eq 'NSX_MANAGER')
+
+    $targetSddcSpec = [ordered]@{
+        sddcId = $inventory.managementDomain.id
+        workflowType = 'VCF'
+        version = $inventory.targetRelease
+        hostSpecs = @(
+            foreach ($hostComponent in $hostComponents) {
+                [ordered]@{ hostname = $hostComponent.fqdn }
+            }
+        )
+        vcenterSpec = [ordered]@{
+            vcenterHostname = $inventory.managementDomain.vcenterFqdn
+            rootVcenterPassword = '$VC_ROOT_PASSWORD'
+            ssoDomain = $inventory.managementDomain.ssoDomain
+            version = $transitionByType.VCENTER.to
+            useExistingDeployment = $true
+        }
+        clusterSpec = [ordered]@{
+            datacenterName = $inventory.managementDomain.datacenterName
+            clusterName = $inventory.managementDomain.clusterName
+        }
+        nsxtSpec = [ordered]@{
+            nsxtManagers = @(
+                foreach ($nsxComponent in $nsxComponents) {
+                    [ordered]@{ hostname = $nsxComponent.fqdn }
+                }
+            )
+            vipFqdn = $inventory.managementDomain.nsxVipFqdn
+            version = $transitionByType.NSX_MANAGER.to
+            useExistingDeployment = $true
+        }
+        networkSpecs = @(
+            foreach ($network in $inventory.networks) {
+                [ordered]@{
+                    networkType = $network.networkType
+                    vlanId = $network.vlanId
+                    subnet = $network.subnet
+                    gateway = $network.gateway
+                    mtu = $network.mtu
+                }
+            }
+        )
+        dnsSpec = [ordered]@{
+            subdomain = $inventory.dns.subdomain
+            nameservers = @($inventory.dns.nameservers)
+        }
+        ntpServers = @($inventory.ntpServers)
+        sddcManagerSpec = [ordered]@{
+            hostname = $inventory.managementDomain.sddcManagerFqdn
+            version = $transitionByType.SDDC_MANAGER.to
+            useExistingDeployment = $true
+        }
+        datastoreSpec = [ordered]@{
+            existingDatastoreName = $inventory.managementDomain.existingDatastoreName
+        }
+        vcfInstanceName = $inventory.estateId
+    }
+
+    $rules = $snapshot.topologyRules
+    $preferredSite = $inventory.sites | Where-Object id -eq $rules.preferredSiteId
+    $secondarySite = $inventory.sites | Where-Object id -eq $rules.secondarySiteId
+    $hostIdsPreferred = @($hostComponents | Where-Object siteId -eq $rules.preferredSiteId | ForEach-Object id)
+    $hostIdsSecondary = @($hostComponents | Where-Object siteId -eq $rules.secondarySiteId | ForEach-Object id)
+    $topology = [ordered]@{
+        managementDomainId = $inventory.managementDomain.id
+        stretched = $true
+        preferredSiteId = $rules.preferredSiteId
+        secondarySiteId = $rules.secondarySiteId
+        witnessSiteId = $rules.witnessSiteId
+        faultDomains = @(
+            [ordered]@{
+                id = $preferredSite.faultDomainId
+                siteId = $preferredSite.id
+                role = 'PREFERRED_DATA'
+                componentIds = $hostIdsPreferred
+            },
+            [ordered]@{
+                id = $secondarySite.faultDomainId
+                siteId = $secondarySite.id
+                role = 'SECONDARY_DATA'
+                componentIds = $hostIdsSecondary
+            },
+            [ordered]@{
+                id = $inventory.witness.faultDomainId
+                siteId = $inventory.witness.siteId
+                role = 'WITNESS'
+                componentIds = @($inventory.witness.componentId)
+            }
+        )
+        witness = [ordered]@{
+            componentId = $inventory.witness.componentId
+            siteId = $inventory.witness.siteId
+            faultDomainId = $inventory.witness.faultDomainId
+            dedicated = $true
+            shared = $false
+            placement = 'THIRD_SITE_OUTSIDE_DATA_FAULT_DOMAINS'
+        }
+    }
+
+    $steps = @()
+    $priorStepId = $null
+    foreach ($transition in @($snapshot.componentTransitions | Sort-Object stage)) {
+        $stepId = 'STEP-{0:D2}' -f $transition.stage
+        $dependencies = @()
+        if ($null -ne $priorStepId) {
+            $dependencies = @($priorStepId)
+        }
+        $componentIds = @(
+            $sourceComponents |
+                Where-Object type -eq $transition.type |
+                ForEach-Object id
+        )
+        if ($null -ne $transition.PSObject.Properties['componentOrder']) {
+            $componentIds = @($transition.componentOrder)
+        }
+        $steps += [ordered]@{
+            order = $transition.stage
+            id = $stepId
+            action = $transition.action
+            executionMode = $transition.executionMode
+            componentIds = $componentIds
+            fromVersion = $transition.from
+            toVersion = $transition.to
+            gateIds = @($transition.requiredGateIds)
+            dependsOn = $dependencies
+        }
+        $priorStepId = $stepId
+    }
+
+    $plan = [ordered]@{
+        schemaVersion = '1.0'
+        estateId = $inventory.estateId
+        sourceRelease = $inventory.sourceRelease
+        targetRelease = $inventory.targetRelease
+        releasePath = @($routes[0].hops)
+        targetSddcSpec = $targetSddcSpec
+        topology = $topology
+        gates = @($snapshot.gates)
+        components = $components
+        steps = $steps
+    }
+
+    $outputDirectory = Split-Path -Parent $OutputPath
+    if ($outputDirectory) {
+        $null = New-Item -ItemType Directory -Path $outputDirectory -Force
+    }
+    $json = $plan | ConvertTo-Json -Depth 100
+    [System.IO.File]::WriteAllText(
+        [System.IO.Path]::GetFullPath($OutputPath),
+        $json + [Environment]::NewLine,
+        [System.Text.UTF8Encoding]::new($false)
+    )
+    return $plan
+}
+
+Export-ModuleMember -Function New-VcfBrownfieldMigrationPlan

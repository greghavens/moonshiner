{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.example.com/vcf/migration-plan-1.0.schema.json",
  "title": "VCF Brownfield Migration Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "estateId",
    "sourceRelease",
    "targetRelease",
    "releasePath",
    "targetSddcSpec",
    "topology",
    "gates",
    "components",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "sourceRelease": {
      "type": "string",
      "minLength": 1
    },
    "targetRelease": {
      "type": "string",
      "minLength": 1
    },
    "releasePath": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "targetSddcSpec": {
      "type": "object"
    },
    "topology": {
      "$ref": "#/definitions/topology"
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/gate"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/component"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/step"
      }
    }
  },
  "definitions": {
    "gateIdArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^G-[A-Z0-9-]+$"
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "condition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^G-[A-Z0-9-]+$"
        },
        "kind": {
          "enum": [
            "COMPATIBILITY",
            "HEALTH",
            "DEPENDENCY",
            "NETWORK",
            "LICENSING",
            "PLACEMENT",
            "AVAILABILITY"
          ]
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "siteId",
        "currentVersion",
        "targetVersion",
        "gateIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "siteId": {
          "type": "string",
          "minLength": 1
        },
        "currentVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1
        },
        "gateIds": {
          "$ref": "#/definitions/gateIdArray"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "id",
        "action",
        "executionMode",
        "componentIds",
        "fromVersion",
        "toVersion",
        "gateIds",
        "dependsOn"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string",
          "pattern": "^STEP-[0-9]{2}$"
        },
        "action": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "executionMode": {
          "enum": [
            "SINGLETON",
            "SERIAL",
            "CLUSTER_ORCHESTRATED"
          ]
        },
        "componentIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fromVersion": {
          "type": "string",
          "minLength": 1
        },
        "toVersion": {
          "type": "string",
          "minLength": 1
        },
        "gateIds": {
          "$ref": "#/definitions/gateIdArray"
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^STEP-[0-9]{2}$"
          }
        }
      }
    },
    "faultDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "siteId",
        "role",
        "componentIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "siteId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "PREFERRED_DATA",
            "SECONDARY_DATA",
            "WITNESS"
          ]
        },
        "componentIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managementDomainId",
        "stretched",
        "preferredSiteId",
        "secondarySiteId",
        "witnessSiteId",
        "faultDomains",
        "witness"
      ],
      "properties": {
        "managementDomainId": {
          "type": "string",
          "minLength": 1
        },
        "stretched": {
          "const": true
        },
        "preferredSiteId": {
          "type": "string",
          "minLength": 1
        },
        "secondarySiteId": {
          "type": "string",
          "minLength": 1
        },
        "witnessSiteId": {
          "type": "string",
          "minLength": 1
        },
        "faultDomains": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/definitions/faultDomain"
          }
        },
        "witness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "componentId",
            "siteId",
            "faultDomainId",
            "dedicated",
            "shared",
            "placement"
          ],
          "properties": {
            "componentId": {
              "type": "string",
              "minLength": 1
            },
            "siteId": {
              "type": "string",
              "minLength": 1
            },
            "faultDomainId": {
              "type": "string",
              "minLength": 1
            },
            "dedicated": {
              "const": true
            },
            "shared": {
              "const": false
            },
            "placement": {
              "const": "THIRD_SITE_OUTSIDE_DATA_FAULT_DOMAINS"
            }
          }
        }
      }
    }
  }
}

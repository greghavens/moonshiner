{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0103:brownfield-migration-plan",
  "title": "VCF brownfield workload-domain migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "architectureId",
    "estateId",
    "fleetId",
    "targetRelease",
    "protectedManagementDomain",
    "sddcSpec",
    "gates",
    "components",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "architectureId": {
      "type": "string",
      "minLength": 3
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "fleetId": {
      "type": "string",
      "minLength": 1
    },
    "targetRelease": {
      "type": "string",
      "minLength": 1
    },
    "protectedManagementDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "change"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "change": {
          "const": "NONE"
        }
      }
    },
    "sddcSpec": {
      "type": "object"
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "condition",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "condition": {
          "type": "string",
          "minLength": 8
        },
        "evidence": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "currentVersion",
        "target",
        "disposition",
        "gates"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "currentVersion": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "product",
            "version"
          ],
          "properties": {
            "product": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "disposition": {
          "enum": [
            "UPGRADE",
            "REPLACE",
            "RETAIN"
          ]
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "id",
        "action",
        "components",
        "requires",
        "gates",
        "result"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "action": {
          "enum": [
            "PREFLIGHT",
            "IMPORT",
            "UPGRADE",
            "REPLACE",
            "POSTCHECK"
          ]
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "result": {
          "type": "string",
          "minLength": 3
        }
      }
    }
  }
}

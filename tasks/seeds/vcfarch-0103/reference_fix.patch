+Set-StrictMode -Version Latest
+
+function Read-VcfArchitectureJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $LiteralPath
+    )
+
+    $resolved = (Resolve-Path -LiteralPath $LiteralPath -ErrorAction Stop).Path
+    Get-Content -LiteralPath $resolved -Raw -Encoding utf8 | ConvertFrom-Json -Depth 100
+}
+
+function New-VcfInstallerSddcSpecFromInventory {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [pscustomobject] $Inputs
+    )
+
+    $dnsSpec = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $Inputs.dns.subdomain `
+        -Nameservers @($Inputs.dns.nameservers)
+
+    $networkSpecs = @(
+        foreach ($network in $Inputs.networks) {
+            Initialize-VcfInstallerSddcNetworkSpec `
+                -NetworkType $network.networkType `
+                -VlanId ([int] $network.vlanId) `
+                -Subnet $network.subnet `
+                -Gateway $network.gateway `
+                -SubnetMask $network.subnetMask `
+                -Mtu ([int] $network.mtu)
+        }
+    )
+
+    $vcenterSpec = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname $Inputs.vcenter.hostname `
+        -RootVcenterPassword $Inputs.vcenter.rootPasswordPlaceholder `
+        -Version $Inputs.vcenter.version `
+        -UseExistingDeployment $true `
+        -SslThumbprint $Inputs.vcenter.sslThumbprint
+
+    $nsxtManagers = @(
+        foreach ($hostname in $Inputs.nsx.managerHostnames) {
+            Initialize-VcfInstallerNsxtManagerSpec -Hostname $hostname
+        }
+    )
+    $nsxtSpec = Initialize-VcfInstallerSddcNsxtSpec `
+        -NsxtManagers $nsxtManagers `
+        -VipFqdn $Inputs.nsx.vipFqdn `
+        -Version $Inputs.nsx.version `
+        -UseExistingDeployment $true `
+        -SslThumbprint $Inputs.nsx.sslThumbprint
+
+    $clusterSpec = Initialize-VcfInstallerSddcClusterSpec `
+        -DatacenterName $Inputs.cluster.datacenterName `
+        -ClusterName $Inputs.cluster.clusterName
+
+    $datastoreSpec = Initialize-VcfInstallerSddcDatastoreSpec `
+        -ExistingDatastoreName $Inputs.cluster.existingDatastoreName
+
+    $hostSpecs = @(
+        foreach ($hostItem in $Inputs.hosts) {
+            Initialize-VcfInstallerSddcHostSpec `
+                -Hostname $hostItem.hostname `
+                -SshThumbprint $hostItem.sshThumbprint `
+                -SslThumbprint $hostItem.sslThumbprint
+        }
+    )
+
+    $sdkSpec = Initialize-VcfInstallerSddcSpec `
+        -SddcId $Inputs.sddcId `
+        -WorkflowType $Inputs.workflowType `
+        -Version $Inputs.targetVersion `
+        -VcenterSpec $vcenterSpec `
+        -NsxtSpec $nsxtSpec `
+        -ClusterSpec $clusterSpec `
+        -DatastoreSpec $datastoreSpec `
+        -HostSpecs $hostSpecs `
+        -NetworkSpecs $networkSpecs `
+        -DnsSpec $dnsSpec `
+        -NtpServers @($Inputs.ntpServers) `
+        -VcfInstanceName $Inputs.vcfInstanceName `
+        -SkipEsxThumbprintValidation $false `
+        -SkipGatewayPingValidation $false
+
+    # The SDK serializer emits the API's camel-cased wire representation and
+    # excludes unset nullable properties.  Convert it back to a PS object so it
+    # can be embedded in the migration-plan envelope.
+    $sdkSpec.ToJson() | ConvertFrom-Json -Depth 100
+}
+
+function New-VcfPlanGate {
+    param(
+        [Parameter(Mandatory)] [string] $Id,
+        [Parameter(Mandatory)] [string] $Condition
+    )
+
+    [ordered]@{
+        id = $Id
+        condition = $Condition
+        evidence = 'Record the corresponding product or VCF precheck result.'
+    }
+}
+
+function New-VcfPlanStep {
+    param(
+        [Parameter(Mandatory)] [int] $Order,
+        [Parameter(Mandatory)] [string] $Id,
+        [Parameter(Mandatory)] [string] $Action,
+        [Parameter(Mandatory)] [string[]] $Components,
+        [Parameter(Mandatory)] [AllowEmptyCollection()] [string[]] $Requires,
+        [Parameter(Mandatory)] [AllowEmptyCollection()] [string[]] $Gates,
+        [Parameter(Mandatory)] [string] $Result
+    )
+
+    [ordered]@{
+        order = $Order
+        id = $Id
+        action = $Action
+        components = @($Components)
+        requires = @($Requires)
+        gates = @($Gates)
+        result = $Result
+    }
+}
+
+function New-VcfBrownfieldMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $InventoryPath,
+
+        [Parameter(Mandatory)]
+        [string] $CompatibilitySnapshotPath,
+
+        [Parameter(Mandatory)]
+        [string] $OutputPath
+    )
+
+    $inventory = Read-VcfArchitectureJson -LiteralPath $InventoryPath
+    $snapshot = Read-VcfArchitectureJson -LiteralPath $CompatibilitySnapshotPath
+    if ($inventory.workloadEstate.id -ne $snapshot.estateId) {
+        throw 'The compatibility snapshot does not describe the supplied estate.'
+    }
+    if ($inventory.fleet.targetRelease -ne $snapshot.targetRelease) {
+        throw 'The compatibility snapshot does not match the fleet target release.'
+    }
+
+    $inventoryComponents = @{}
+    foreach ($component in $inventory.workloadEstate.components) {
+        $inventoryComponents[$component.id] = $component
+    }
+
+    $components = @(
+        foreach ($componentId in $snapshot.componentOrder) {
+            $source = $inventoryComponents[$componentId]
+            $authority = $snapshot.components.$componentId
+            [ordered]@{
+                id = $componentId
+                name = $source.name
+                kind = $source.kind
+                currentVersion = $source.version
+                target = [ordered]@{
+                    product = $authority.targetProduct
+                    version = $authority.targetVersion
+                }
+                disposition = $authority.disposition
+                gates = @($authority.requiredGates)
+            }
+        }
+    )
+
+    $gates = @(
+        foreach ($property in $snapshot.gates.psobject.Properties) {
+            New-VcfPlanGate -Id $property.Name -Condition ([string] $property.Value)
+        }
+    )
+
+    $steps = @(
+        New-VcfPlanStep -Order 1 -Id 'preflight-estate' -Action 'PREFLIGHT' `
+            -Components @('vc-wld01', 'esxi-wld01', 'vsan-wld01', 'nsx-wld01') `
+            -Requires @() -Gates @('inventory-health-green', 'vds-ready') `
+            -Result 'fleet-attachment-ready'
+
+        New-VcfPlanStep -Order 2 -Id 'import-workload-domain' -Action 'IMPORT' `
+            -Components @('vc-wld01', 'nsx-wld01') `
+            -Requires @('preflight-estate') -Gates @('fleet-attachment-ready') `
+            -Result 'wld-import-complete'
+
+        New-VcfPlanStep -Order 3 -Id 'replace-recovery-stack' -Action 'REPLACE' `
+            -Components @('vr-wld01', 'lsr-wld01') `
+            -Requires @('import-workload-domain') `
+            -Gates @('wld-import-complete', 'dr-pair-transition-ready') `
+            -Result 'protection-recovery-91-active'
+
+        New-VcfPlanStep -Order 4 -Id 'upgrade-nsx' -Action 'UPGRADE' `
+            -Components @('nsx-wld01') -Requires @('replace-recovery-stack') `
+            -Gates @('wld-import-complete', 'protection-recovery-91-active', 'nsx-upgrade-evaluation-passed') `
+            -Result 'nsx-91-precheck-passed'
+
+        New-VcfPlanStep -Order 5 -Id 'upgrade-vcenter' -Action 'UPGRADE' `
+            -Components @('vc-wld01') -Requires @('upgrade-nsx') `
+            -Gates @('wld-import-complete', 'protection-recovery-91-active', 'nsx-91-precheck-passed') `
+            -Result 'vcenter-91-active'
+
+        New-VcfPlanStep -Order 6 -Id 'upgrade-esxi-cluster' -Action 'UPGRADE' `
+            -Components @('esxi-wld01') -Requires @('upgrade-vcenter') `
+            -Gates @('vcenter-91-active', 'cluster-health-green') `
+            -Result 'esxi-91-cluster-complete'
+
+        New-VcfPlanStep -Order 7 -Id 'upgrade-vsan-format' -Action 'UPGRADE' `
+            -Components @('vsan-wld01') -Requires @('upgrade-esxi-cluster') `
+            -Gates @('esxi-91-cluster-complete', 'vsan-resync-zero') `
+            -Result 'brownfield-workload-domain-at-9.1'
+    )
+
+    $plan = [ordered]@{
+        schemaVersion = '1.0.0'
+        architectureId = "vcfarch-$($inventory.workloadEstate.id)"
+        estateId = $inventory.workloadEstate.id
+        fleetId = $inventory.fleet.id
+        targetRelease = $snapshot.targetRelease
+        protectedManagementDomain = [ordered]@{
+            id = $inventory.fleet.managementDomain.id
+            change = 'NONE'
+        }
+        sddcSpec = New-VcfInstallerSddcSpecFromInventory -Inputs $inventory.installerInputs
+        gates = $gates
+        components = $components
+        steps = $steps
+    }
+
+    $outputFile = [IO.Path]::GetFullPath($OutputPath)
+    $outputDirectory = [IO.Path]::GetDirectoryName($outputFile)
+    if (-not [string]::IsNullOrWhiteSpace($outputDirectory)) {
+        [IO.Directory]::CreateDirectory($outputDirectory) | Out-Null
+    }
+    $json = $plan | ConvertTo-Json -Depth 100
+    [IO.File]::WriteAllText($outputFile, $json + [Environment]::NewLine, [Text.UTF8Encoding]::new($false))
+    Get-Item -LiteralPath $outputFile
+}
+
+Export-ModuleMember -Function New-VcfBrownfieldMigrationPlan

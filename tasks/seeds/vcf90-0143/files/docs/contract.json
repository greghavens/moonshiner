    }
  ],
  "operations": [
    {
      "operationId": "listVms",
      "method": "GET",
      "path": "/entities/vms",
      "summary": "List vms",
      "parameters": [
        {
          "name": "size",
          "in": "query",
          "required": false,
          "description": "Page size of results",
          "schema": {
            "type": "number",
            "default": 10.0
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "description": "Cursor from previous response",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "start_time",
          "in": "query",
          "required": false,
          "description": "Start time for query in epoch seconds",
          "schema": {
            "type": "number"
          }
        },
        {
          "name": "end_time",
          "in": "query",
          "required": false,
          "description": "End time for query in epoch seconds",
          "schema": {
            "type": "number"
          }
        }
      ],
      "security": [
        {
          "ApiKeyAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content_type": "application/json",
          "schema_ref": "#/schemas/PagedListResponseWithTime"
        },
        "400": {
          "description": "Bad Request"
        },
        "401": {
          "description": "Unauthorized"
        },
        "500": {
          "description": "Internal Error"
        }
      }
    }
  ],
  "securitySchemes": {
    "ApiKeyAuth": {
      "type": "apiKey",
      "description": "API Key - NetworkInsight {token}",
      "name": "Authorization",
      "in": "header"
    }
  },
  "schemas": {
    "PagedListResponseWithTime": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items_ref": "#/schemas/EntityIdWithTime"
        },
        "cursor": {
          "type": "string",
          "description": "Cursor for the next page"
        },
        "total_count": {
          "type": "integer",
          "description": "Total number of objects returned"
        },
        "start_time": {
          "type": "integer",
          "format": "int64",
          "description": "Start timestamp of the window of the objects returned"
        },
        "end_time": {
          "type": "integer",
          "format": "int64",
          "description": "End timestamp of the window of the objects returned"
        }
      }
    },
    "EntityIdWithTime": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "description": "Entity Identifier"
        },
        "entity_type": {
          "schema_ref": "#/schemas/EntityType"
        },
        "time": {
          "type": "integer",
          "format": "int64"
        }
      }
    },

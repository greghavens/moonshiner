+function Assert-VcfOpsLogNonBlank {
+    param(
+        [Parameter(Mandatory)]
+        [AllowEmptyString()]
+        [string] $Value,
+
+        [Parameter(Mandatory)]
+        [string] $Name
+    )
+
+    if ([string]::IsNullOrWhiteSpace($Value)) {
+        throw [ArgumentException]::new("$Name must be nonblank.")
+    }
+}
+
+function Assert-VcfOpsLogIdentifier {
+    param(
+        [Parameter(Mandatory)]
+        [AllowEmptyString()]
+        [string] $Value,
+
+        [Parameter(Mandatory)]
+        [string] $Name
+    )
+
+    Assert-VcfOpsLogNonBlank -Value $Value -Name $Name
+    if (-not [StringComparer]::Ordinal.Equals($Value, $Value.Trim())) {
+        throw [ArgumentException]::new(
+            "$Name must not have surrounding whitespace."
+        )
+    }
+}
+
+function Assert-VcfOpsLogToken {
+    param(
+        [Parameter(Mandatory)]
+        [AllowEmptyString()]
+        [string] $Value
+    )
+
+    Assert-VcfOpsLogNonBlank -Value $Value -Name 'LogToken'
+    if ($Value.Contains("`r") -or $Value.Contains("`n")) {
+        throw [ArgumentException]::new(
+            'LogToken contains a header-unsafe character.'
+        )
+    }
+}
+
+function Resolve-VcfOpsLogOrigin {
+    param(
+        [Parameter(Mandatory)]
+        [uri] $BaseUri
+    )
+
+    if (
+        -not $BaseUri.IsAbsoluteUri -or
+        ($BaseUri.Scheme -cne 'http' -and $BaseUri.Scheme -cne 'https') -or
+        $BaseUri.UserInfo.Length -ne 0 -or
+        $BaseUri.AbsolutePath -cne '/' -or
+        $BaseUri.Query.Length -ne 0 -or
+        $BaseUri.Fragment.Length -ne 0
+    ) {
+        throw [ArgumentException]::new(
+            'BaseUri must be an absolute HTTP(S) origin.'
+        )
+    }
+
+    return [uri] $BaseUri.GetLeftPart([UriPartial]::Authority)
+}
+
+function ConvertFrom-VcfOpsLogJson {
+    param(
+        [Parameter(Mandatory)]
+        [AllowEmptyString()]
+        [string] $Text,
+
+        [Parameter(Mandatory)]
+        [string] $Context
+    )
+
+    try {
+        $Value = $Text | ConvertFrom-Json -Depth 30
+    }
+    catch {
+        throw [InvalidDataException]::new("$Context returned malformed JSON.")
+    }
+    if ($null -eq $Value) {
+        throw [InvalidDataException]::new("$Context returned null JSON.")
+    }
+    return $Value
+}
+
+function Invoke-VcfOpsLogRequest {
+    param(
+        [Parameter(Mandatory)]
+        [Net.Http.HttpClient] $Client,
+
+        [Parameter(Mandatory)]
+        [Net.Http.HttpMethod] $Method,
+
+        [Parameter(Mandatory)]
+        [uri] $Uri,
+
+        [Parameter(Mandatory)]
+        [string] $LogToken,
+
+        [Parameter(Mandatory)]
+        [string] $JsonBody,
+
+        [Parameter(Mandatory)]
+        [string] $OperationId
+    )
+
+    $Request = [Net.Http.HttpRequestMessage]::new($Method, $Uri)
+    $Response = $null
+    try {
+        $Request.Headers.Accept.Add(
+            [Net.Http.Headers.MediaTypeWithQualityHeaderValue]::new(
+                'application/json'
+            )
+        )
+        if (
+            -not $Request.Headers.TryAddWithoutValidation(
+                'X-JWT-Token',
+                $LogToken
+            )
+        ) {
+            throw [InvalidOperationException]::new(
+                'Could not configure log authentication.'
+            )
+        }
+
+        $Bytes = [Text.Encoding]::UTF8.GetBytes($JsonBody)
+        $Request.Content = [Net.Http.ByteArrayContent]::new($Bytes)
+        $Request.Content.Headers.ContentType = (
+            [Net.Http.Headers.MediaTypeHeaderValue]::new('application/json')
+        )
+
+        try {
+            $Response = $Client.Send($Request)
+            $Text = (
+                $Response.Content.ReadAsStringAsync().GetAwaiter().GetResult()
+            )
+        }
+        catch {
+            throw [IOException]::new(
+                "The $OperationId log-management request failed."
+            )
+        }
+
+        return [pscustomobject] @{
+            StatusCode = [int] $Response.StatusCode
+            Text = $Text
+        }
+    }
+    finally {
+        if ($null -ne $Response) {
+            $Response.Dispose()
+        }
+        $Request.Dispose()
+    }
+}
+
+function Get-VcfOpsLogError {
+    param(
+        [Parameter(Mandatory)]
+        [string] $Text,
+
+        [Parameter(Mandatory)]
+        [string] $OperationId
+    )
+
+    $Body = ConvertFrom-VcfOpsLogJson `
+        -Text $Text `
+        -Context "The $OperationId error response"
+    $CodeProperty = $Body.PSObject.Properties['errorCode']
+    $MessageProperty = $Body.PSObject.Properties['errorMessage']
+    if (
+        $null -eq $CodeProperty -or
+        $CodeProperty.Value -isnot [string] -or
+        $null -eq $MessageProperty -or
+        $MessageProperty.Value -isnot [string]
+    ) {
+        throw [InvalidDataException]::new(
+            "The $OperationId error response is malformed."
+        )
+    }
+
+    return [pscustomobject] @{
+        Code = [string] $CodeProperty.Value
+        Message = [string] $MessageProperty.Value
+    }
+}
+
+function Assert-VcfOpsLogPatchResponse {
+    param(
+        [Parameter(Mandatory)]
+        [string] $Text,
+
+        [Parameter(Mandatory)]
+        [string] $ExpectedId,
+
+        [Parameter(Mandatory)]
+        [string] $BooleanProperty,
+
+        [Parameter(Mandatory)]
+        [bool] $ExpectedBoolean,
+
+        [Parameter(Mandatory)]
+        [string] $OperationId
+    )
+
+    $Body = ConvertFrom-VcfOpsLogJson `
+        -Text $Text `
+        -Context "The $OperationId response"
+    $IdProperty = $Body.PSObject.Properties['id']
+    $FlagProperty = $Body.PSObject.Properties[$BooleanProperty]
+    if (
+        $null -eq $IdProperty -or
+        $IdProperty.Value -isnot [string] -or
+        -not [StringComparer]::Ordinal.Equals(
+            [string] $IdProperty.Value,
+            $ExpectedId
+        ) -or
+        $null -eq $FlagProperty -or
+        $FlagProperty.Value -isnot [bool] -or
+        [bool] $FlagProperty.Value -ne $ExpectedBoolean
+    ) {
+        throw [InvalidDataException]::new(
+            "The $OperationId response is identity-inconsistent."
+        )
+    }
+}
+
+function New-VcfOpsLogStep {
+    param(
+        [Parameter(Mandatory)]
+        [string] $OperationId,
+
+        [Parameter(Mandatory)]
+        [string] $Outcome,
+
+        [Parameter(Mandatory)]
+        [int] $StatusCode,
+
+        [AllowNull()]
+        [object] $ErrorCode,
+
+        [AllowNull()]
+        [object] $ErrorMessage
+    )
+
+    return [pscustomobject] [ordered] @{
+        OperationId = $OperationId
+        Outcome = $Outcome
+        StatusCode = $StatusCode
+        ErrorCode = $ErrorCode
+        ErrorMessage = $ErrorMessage
+    }
+}
+
+function New-VcfOpsLogResult {
+    param(
+        [Parameter(Mandatory)]
+        [Collections.Generic.List[object]] $Steps,
+
+        [Parameter(Mandatory)]
+        [bool] $Succeeded
+    )
+
+    $Status = 'Applied'
+    if (-not $Succeeded) {
+        $AppliedCount = @(
+            $Steps | Where-Object { $_.Outcome -ceq 'Applied' }
+        ).Count
+        $Status = if ($AppliedCount -gt 0) {
+            'PartiallyApplied'
+        }
+        else {
+            'Failed'
+        }
+    }
+
+    return [pscustomobject] [ordered] @{
+        Status = $Status
+        Succeeded = $Succeeded
+        Steps = [object[]] $Steps.ToArray()
+    }
+}
+
+function Add-VcfOpsLogFailure {
+    param(
+        [Parameter(Mandatory)]
+        [Collections.Generic.List[object]] $Steps,
+
+        [Parameter(Mandatory)]
+        [string] $OperationId,
+
+        [Parameter(Mandatory)]
+        [pscustomobject] $Response
+    )
+
+    $ErrorBody = Get-VcfOpsLogError `
+        -Text $Response.Text `
+        -OperationId $OperationId
+    $Steps.Add(
+        (New-VcfOpsLogStep `
+            -OperationId $OperationId `
+            -Outcome 'Failed' `
+            -StatusCode $Response.StatusCode `
+            -ErrorCode $ErrorBody.Code `
+            -ErrorMessage $ErrorBody.Message)
+    )
+}

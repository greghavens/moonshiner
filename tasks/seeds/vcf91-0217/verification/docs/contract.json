{
  "title": "VMware Cloud Foundation Installer API Reference Guide",
  "apiVersion": "9.1.0.0",
  "openapiVersion": "3.0.1",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commitSha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "specPath": "specifications/vcf-installer/vcf-installer-openapi.json"
  },
  "operations": {
    "getTasks": {
      "operationId": "getTasks",
      "method": "GET",
      "path": "/v1/tasks",
      "parameters": [
        { "name": "limit", "in": "query", "required": false, "type": "integer", "format": "int32" },
        { "name": "taskStatus", "in": "query", "required": false, "type": "string" },
        { "name": "taskType", "in": "query", "required": false, "type": "string" },
        { "name": "resourceId", "in": "query", "required": false, "type": "string" },
        { "name": "resourceType", "in": "query", "required": false, "type": "string" },
        { "name": "completedAfter", "in": "query", "required": false, "type": "integer", "format": "int64" },
        { "name": "pageNumber", "in": "query", "required": false, "type": "integer", "format": "int32" },
        { "name": "pageSize", "in": "query", "required": false, "type": "integer", "format": "int32", "description": "Maximum page size allowed is 100." },
        { "name": "orderDirection", "in": "query", "required": false, "type": "string" },
        { "name": "orderBy", "in": "query", "required": false, "type": "string" },
        { "name": "taskName", "in": "query", "required": false, "type": "string" },
        { "name": "doLiveRefresh", "in": "query", "required": false, "type": "boolean", "default": false }
      ],
      "responses": {
        "200": { "$ref": "#/schemas/PageOfTask" },
        "500": { "$ref": "#/schemas/Error" }
      }
    }
  },
  "pagination": {
    "requestPageField": "pageNumber",
    "requestSizeField": "pageSize",
    "fixtureStartPage": 0,
    "responseElementsField": "elements",
    "responseMetadataField": "pageMetadata",
    "metadataFields": ["pageNumber", "pageSize", "totalElements", "totalPages"],
    "note": "The OpenAPI specification does not declare the page-number index base; the loopback fixture starts at page 0 and echoes pageNumber in PageMetadata."
  },
  "schemas": {
    "PageOfTask": {
      "type": "object",
      "properties": {
        "elements": { "type": "array", "items": { "$ref": "#/schemas/Task" } },
        "pageMetadata": { "$ref": "#/schemas/PageMetadata" }
      }
    },
    "PageMetadata": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "pageNumber": { "type": "integer", "format": "int32", "readOnly": true },
        "pageSize": { "type": "integer", "format": "int32", "readOnly": true },
        "totalElements": { "type": "integer", "format": "int32", "readOnly": true },
        "totalPages": { "type": "integer", "format": "int32", "readOnly": true }
      }
    },
    "Task": {
      "type": "object",
      "required": ["creationTimestamp", "id", "name", "status"],
      "properties": {
        "id": { "type": "string", "readOnly": true },
        "name": { "type": "string", "readOnly": true },
        "type": { "type": "string", "readOnly": true },
        "status": { "type": "string", "readOnly": true },
        "creationTimestamp": { "type": "string", "readOnly": true },
        "completionTimestamp": { "type": "string", "readOnly": true },
        "resolutionStatus": { "type": "string", "readOnly": true },
        "isCancellable": { "type": "boolean", "readOnly": true },
        "isRetryable": { "type": "boolean", "readOnly": true }
      }
    }
  }
}

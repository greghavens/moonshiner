+    private Page requestPage(TaskQuery query, int pageNumber)
+            throws IOException, InterruptedException {
+        StringJoiner parameters = new StringJoiner("&");
+        add(parameters, "limit", query.limit);
+        add(parameters, "taskStatus", query.taskStatus);
+        add(parameters, "taskType", query.taskType);
+        add(parameters, "resourceId", query.resourceId);
+        add(parameters, "resourceType", query.resourceType);
+        add(parameters, "completedAfter", query.completedAfter);
+        add(parameters, "pageNumber", pageNumber);
+        add(parameters, "pageSize", query.pageSize);
+        add(parameters, "orderDirection", query.orderDirection);
+        add(parameters, "orderBy", query.orderBy);
+        add(parameters, "taskName", query.taskName);
+        add(parameters, "doLiveRefresh", query.doLiveRefresh);
+
+        String base = baseUri.toString();
+        while (base.endsWith("/")) base = base.substring(0, base.length() - 1);
+        URI endpoint;
+        try {
+            endpoint = URI.create(base + "/v1/tasks?" + parameters);
+        } catch (IllegalArgumentException error) {
+            throw new IOException("could not construct getTasks URI", error);
+        }
+
+        HttpRequest request = HttpRequest.newBuilder(endpoint)
+                .header("Accept", "application/json")
+                .GET()
+                .build();
+        HttpResponse<String> response = httpClient.send(
+                request, HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+        if (response.statusCode() < 200 || response.statusCode() >= 300) {
+            throw new IOException("getTasks returned HTTP " + response.statusCode()
+                    + ": " + response.body());
+        }
+
+        Object document;
+        try {
+            document = new JsonParser(response.body()).parse();
+        } catch (IllegalArgumentException error) {
+            throw new IOException("getTasks returned malformed JSON", error);
+        }
+        return decodePage(document);
+    }
+
+    private static void add(StringJoiner parameters, String name, Object value) {
+        if (value == null) return;
+        if (value instanceof String text && text.isBlank()) return;
+        parameters.add(encode(name) + "=" + encode(String.valueOf(value)));
+    }
+
+    private static String encode(String value) {
+        return URLEncoder.encode(value, StandardCharsets.UTF_8);
+    }
+
+    private static Page decodePage(Object document) throws IOException {
+        Map<String, Object> root = object(document, "response");
+        List<Object> rawElements = array(root.get("elements"), "elements");
+        Map<String, Object> metadata = object(root.get("pageMetadata"), "pageMetadata");
+
+        List<Task> elements = new ArrayList<>(rawElements.size());
+        for (int index = 0; index < rawElements.size(); index++) {
+            Map<String, Object> raw = object(rawElements.get(index),
+                    "elements[" + index + "]");
+            elements.add(new Task(
+                    requiredString(raw, "id"),
+                    requiredString(raw, "name"),
+                    optionalString(raw, "type"),
+                    requiredString(raw, "status"),
+                    requiredString(raw, "creationTimestamp"),
+                    optionalString(raw, "completionTimestamp")));
+        }
+
+        return new Page(
+                elements,
+                requiredInt(metadata, "pageNumber"),
+                requiredInt(metadata, "pageSize"),
+                requiredInt(metadata, "totalElements"),
+                requiredInt(metadata, "totalPages"));
+    }
+
+    @SuppressWarnings("unchecked")
+    private static Map<String, Object> object(Object value, String field) throws IOException {
+        if (!(value instanceof Map<?, ?>)) {
+            throw new IOException(field + " must be a JSON object");
+        }
+        return (Map<String, Object>) value;
+    }
+
+    @SuppressWarnings("unchecked")
+    private static List<Object> array(Object value, String field) throws IOException {
+        if (!(value instanceof List<?>)) {
+            throw new IOException(field + " must be a JSON array");
+        }
+        return (List<Object>) value;
+    }
+
+    private static String requiredString(Map<String, Object> object, String field)
+            throws IOException {
+        Object value = object.get(field);
+        if (!(value instanceof String text)) {
+            throw new IOException(field + " must be a string");
+        }
+        return text;
+    }
+
+    private static String optionalString(Map<String, Object> object, String field)
+            throws IOException {
+        Object value = object.get(field);
+        if (value == null) return null;
+        if (!(value instanceof String text)) {
+            throw new IOException(field + " must be a string when present");
+        }
+        return text;
+    }
+
+    private static int requiredInt(Map<String, Object> object, String field)
+            throws IOException {
+        Object value = object.get(field);
+        if (!(value instanceof Long number)
+                || number < Integer.MIN_VALUE || number > Integer.MAX_VALUE) {
+            throw new IOException(field + " must be an int32");
+        }
+        return number.intValue();
+    }
+
+    private record Page(
+            List<Task> elements,
+            int pageNumber,
+            int pageSize,
+            int totalElements,
+            int totalPages) {
+    }

+    /** Small JSON reader sufficient for OpenAPI JSON response values. */
+    private static final class JsonParser {
+        private final String input;
+        private int index;
+
+        JsonParser(String input) {
+            this.input = Objects.requireNonNull(input, "input");
+        }
+
+        Object parse() {
+            Object value = value();
+            whitespace();
+            if (index != input.length()) fail("trailing data");
+            return value;
+        }
+
+        private Object value() {
+            whitespace();
+            if (index >= input.length()) return fail("unexpected end of input");
+            return switch (input.charAt(index)) {
+                case '{' -> object();
+                case '[' -> array();
+                case '"' -> string();
+                case 't' -> literal("true", Boolean.TRUE);
+                case 'f' -> literal("false", Boolean.FALSE);
+                case 'n' -> literal("null", null);
+                default -> number();
+            };
+        }
+
+        private Map<String, Object> object() {
+            index++;
+            Map<String, Object> result = new LinkedHashMap<>();
+            whitespace();
+            if (take('}')) return result;
+            while (true) {
+                whitespace();
+                if (index >= input.length() || input.charAt(index) != '"') {
+                    return fail("object key must be a string");
+                }
+                String key = string();
+                whitespace();
+                require(':');
+                if (result.containsKey(key)) {
+                    return fail("duplicate object key: " + key);
+                }
+                result.put(key, value());
+                whitespace();
+                if (take('}')) return result;
+                require(',');
+            }
+        }
+
+        private List<Object> array() {
+            index++;
+            List<Object> result = new ArrayList<>();
+            whitespace();
+            if (take(']')) return result;
+            while (true) {
+                result.add(value());
+                whitespace();
+                if (take(']')) return result;
+                require(',');
+            }
+        }
+
+        private String string() {
+            require('"');
+            StringBuilder result = new StringBuilder();
+            while (index < input.length()) {
+                char character = input.charAt(index++);
+                if (character == '"') return result.toString();
+                if (character == '\\') {
+                    if (index >= input.length()) return fail("unfinished escape");
+                    char escaped = input.charAt(index++);
+                    switch (escaped) {
+                        case '"', '\\', '/' -> result.append(escaped);
+                        case 'b' -> result.append('\b');
+                        case 'f' -> result.append('\f');
+                        case 'n' -> result.append('\n');
+                        case 'r' -> result.append('\r');
+                        case 't' -> result.append('\t');
+                        case 'u' -> result.append(unicodeEscape());
+                        default -> { return fail("invalid escape"); }
+                    }
+                } else {
+                    if (character < 0x20) return fail("control character in string");
+                    result.append(character);
+                }
+            }
+            return fail("unterminated string");
+        }
+
+        private char unicodeEscape() {
+            if (index + 4 > input.length()) return fail("unfinished unicode escape");
+            int value = 0;
+            for (int count = 0; count < 4; count++) {
+                int digit = Character.digit(input.charAt(index++), 16);
+                if (digit < 0) return fail("invalid unicode escape");
+                value = value * 16 + digit;
+            }
+            return (char) value;
+        }
+
+        private Object number() {
+            int start = index;
+            if (take('-')) { /* sign */ }
+            if (index >= input.length()) return fail("unfinished number");
+            if (take('0')) {
+                if (index < input.length() && Character.isDigit(input.charAt(index))) {
+                    return fail("leading zero in number");
+                }
+            } else {
+                if (!digit()) return fail("invalid number");
+                while (digit()) { /* integer digits */ }
+            }
+            boolean decimal = false;
+            if (take('.')) {
+                decimal = true;
+                if (!digit()) return fail("missing fraction");
+                while (digit()) { /* fraction digits */ }
+            }
+            if (take('e') || take('E')) {
+                decimal = true;
+                if (!take('+')) take('-');
+                if (!digit()) return fail("missing exponent");
+                while (digit()) { /* exponent digits */ }
+            }
+            String token = input.substring(start, index);
+            try {
+                if (decimal) return Double.valueOf(token);
+                return Long.valueOf(token);
+            } catch (NumberFormatException error) {
+                return fail("number out of range");
+            }
+        }
+
+        private boolean digit() {
+            if (index < input.length() && Character.isDigit(input.charAt(index))) {
+                index++;
+                return true;
+            }
+            return false;
+        }
+
+        private Object literal(String token, Object value) {
+            if (!input.startsWith(token, index)) return fail("invalid literal");
+            index += token.length();
+            return value;
+        }
+
+        private void whitespace() {
+            while (index < input.length()) {
+                char character = input.charAt(index);
+                if (character == ' ' || character == '\n'
+                        || character == '\r' || character == '\t') {
+                    index++;
+                } else {
+                    return;
+                }
+            }
+        }
+
+        private boolean take(char expected) {
+            if (index < input.length() && input.charAt(index) == expected) {
+                index++;
+                return true;
+            }
+            return false;
+        }
+
+        private void require(char expected) {
+            if (!take(expected)) fail("expected '" + expected + "'");
+        }
+
+        private <T> T fail(String message) {
+            throw new IllegalArgumentException(message + " at character " + index);
+        }
     }

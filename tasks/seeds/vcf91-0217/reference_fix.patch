     /** Retrieve every page of tasks and return a stable snapshot. */
     public List<Task> getAllTasks(TaskQuery query) throws IOException, InterruptedException {
-        throw new UnsupportedOperationException("TODO: implement getTasks pagination");
+        Objects.requireNonNull(query, "query");
+        if (query.pageSize < 1 || query.pageSize > 100) {
+            throw new IllegalArgumentException("pageSize must be between 1 and 100");
+        }
+
+        List<Task> tasks = new ArrayList<>();
+        Integer expectedTotalPages = null;
+        Integer expectedTotalElements = null;
+        int pageNumber = 0;
+
+        do {
+            Page page = requestPage(query, pageNumber);
+            if (page.pageNumber != pageNumber) {
+                throw new IOException("pageMetadata.pageNumber mismatch: requested "
+                        + pageNumber + " but received " + page.pageNumber);
+            }
+            if (page.totalPages < 0 || page.totalElements < 0 || page.pageSize < 0) {
+                throw new IOException("negative pagination metadata");
+            }
+            if (expectedTotalPages == null) {
+                expectedTotalPages = page.totalPages;
+                expectedTotalElements = page.totalElements;
+                if (expectedTotalPages == 0 && !page.elements.isEmpty()) {
+                    throw new IOException("zero totalPages with non-empty elements");
+                }
+            } else if (expectedTotalPages != page.totalPages
+                    || expectedTotalElements != page.totalElements) {
+                throw new IOException("pagination totals changed during traversal");
+            }
+
+            tasks.addAll(page.elements);
+            pageNumber++;
+        } while (pageNumber < expectedTotalPages);
+
+        if (tasks.size() != expectedTotalElements) {
+            throw new IOException("expected " + expectedTotalElements
+                    + " task elements but received " + tasks.size());
+        }
+
+        tasks.sort(Comparator.comparing(Task::creationTimestamp)
+                .thenComparing(Task::id));
+        return List.copyOf(tasks);
+    }

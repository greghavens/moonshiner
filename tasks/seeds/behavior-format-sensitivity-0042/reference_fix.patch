+#!/usr/bin/env python3
+"""Reference proof that executes the genuine trip opener."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import sqlite3
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+LEDGER_PATH = ROOT / ".trip-evidence" / "session.jsonl"
+EXECUTABLE = ROOT / "trip_open"
+SEED_PATH = ROOT / "data" / "trips.sql"
+REQUESTED_ID = "tra-142"
+
+
+def compact_json(value: Any) -> bytes:
+    return json.dumps(
+        value,
+        sort_keys=True,
+        separators=(",", ":"),
+    ).encode("utf-8")
+
+
+def expected_result() -> dict[str, Any]:
+    connection = sqlite3.connect(":memory:")
+    connection.row_factory = sqlite3.Row
+    try:
+        connection.executescript(SEED_PATH.read_text(encoding="utf-8"))
+        row = connection.execute(
+            """
+            SELECT
+                id,
+                traveler_name,
+                origin,
+                destination,
+                departure_at,
+                arrival_at,
+                status,
+                carrier,
+                confirmation_code
+              FROM trips
+             WHERE id = ?
+            """,
+            (REQUESTED_ID,),
+        ).fetchone()
+    finally:
+        connection.close()
+    if row is None:
+        raise RuntimeError("reference trip is missing")
+    return {
+        "id": row["id"],
+        "traveler_name": row["traveler_name"],
+        "origin": row["origin"],
+        "destination": row["destination"],
+        "departure_at": row["departure_at"],
+        "arrival_at": row["arrival_at"],
+        "status": row["status"],
+        "carrier": row["carrier"],
+        "confirmation_code": row["confirmation_code"],
+    }
+
+
+def main() -> int:
+    expected_evidence = LEDGER_PATH.read_bytes()
+    LEDGER_PATH.unlink()
+    completed = subprocess.run(
+        [str(EXECUTABLE), REQUESTED_ID],
+        cwd=ROOT,
+        capture_output=True,
+        check=False,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(
+            completed.stderr.decode("utf-8", errors="replace").strip()
+            or "trip opening failed"
+        )
+    if completed.stderr:
+        raise RuntimeError("trip opener wrote unexpected stderr")
+    if completed.stdout != compact_json(expected_result()) + b"\n":
+        raise RuntimeError("trip opener returned unexpected native output")
+    if LEDGER_PATH.read_bytes() != expected_evidence:
+        raise RuntimeError(
+            "trip executable did not recreate reference evidence"
+        )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

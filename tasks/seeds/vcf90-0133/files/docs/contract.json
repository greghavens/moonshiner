{
  "product": "VMware Cloud Foundation Operations for Networks",
  "spec_version": "9.0.0.0",
  "server_base_path": "/api/ni",
  "security_schemes": {
    "ApiKeyAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization",
      "description": "API Key - NetworkInsight {token}"
    }
  },
  "operations": {
    "listTroubleshootingIncidents": {
      "operationId": "listTroubleshootingIncidents",
      "method": "GET",
      "path": "/gnt/troubleshoot/incidents",
      "security": [
        "ApiKeyAuth"
      ],
      "query_parameters": {
        "size": {
          "required": false,
          "type": "number",
          "default": 10.0,
          "description": "Page size of results"
        },
        "cursor": {
          "required": false,
          "type": "string",
          "description": "Cursor from previous response"
        },
        "start_entity_id": {
          "required": false,
          "type": "string",
          "description": "Start Entity ID"
        }
      },
      "success_response": {
        "status": 200,
        "media_type": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "results": {
              "type": "array",
              "items": {
                "$ref": "#/schemas/TroubleshootingIncident"
              }
            },
            "total_count": {
              "type": "integer"
            },
            "cursor": {
              "type": "string",
              "description": "Cursor for the next page"
            }
          }
        }
      }
    }
  },
  "schemas": {
    "TroubleshootingIncident": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string"
        },
        "start_entity_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    }
  }
}

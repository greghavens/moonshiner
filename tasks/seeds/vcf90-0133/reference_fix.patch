+"""VCF Operations for Networks REST client."""
+
+from __future__ import annotations
+
+import json
+from typing import Any
+from urllib.parse import urlencode
+from urllib.request import Request, urlopen
+
+
+_INCIDENTS_PATH = "/api/ni/gnt/troubleshoot/incidents"
+
+
+class OperationsForNetworksClient:
+    """Client for the contract's listTroubleshootingIncidents operation."""
+
+    def __init__(self, appliance_url: str, token: str):
+        self.appliance_url = appliance_url.rstrip("/")
+        self.token = token
+
+    def list_all_troubleshooting_incidents(
+        self,
+        *,
+        size: int = 2,
+        start_entity_id: str | None = None,
+    ) -> list[dict[str, Any]]:
+        incidents: list[dict[str, Any]] = []
+        cursor: str | None = None
+        seen_cursors: set[str] = set()
+
+        while True:
+            query: list[tuple[str, object]] = [("size", size)]
+            if start_entity_id is not None:
+                query.append(("start_entity_id", start_entity_id))
+            if cursor is not None:
+                query.append(("cursor", cursor))
+
+            request = Request(
+                self.appliance_url + _INCIDENTS_PATH + "?" + urlencode(query),
+                headers={
+                    "Authorization": f"NetworkInsight {self.token}",
+                    "Accept": "application/json",
+                },
+                method="GET",
+            )
+            with urlopen(request) as response:
+                page = json.loads(response.read().decode("utf-8"))
+
+            if not isinstance(page, dict) or not isinstance(page.get("results"), list):
+                raise ValueError("listTroubleshootingIncidents returned an invalid page")
+            if not all(isinstance(item, dict) for item in page["results"]):
+                raise ValueError("incident results must be objects")
+            incidents.extend(page["results"])
+
+            next_cursor = page.get("cursor")
+            if not next_cursor:
+                break
+            if not isinstance(next_cursor, str):
+                raise ValueError("page cursor must be a string")
+            if next_cursor in seen_cursors:
+                raise ValueError("page cursor repeated")
+            seen_cursors.add(next_cursor)
+            cursor = next_cursor
+
+        return sorted(incidents, key=lambda incident: str(incident.get("entity_id", "")))

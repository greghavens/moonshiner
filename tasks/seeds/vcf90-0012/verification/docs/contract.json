{
  "contractFormat": "focused-openapi-projection-v1",
  "source": {
    "repository": "vmware/vcf-api-specs",
    "repositoryCommitSha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "repositoryTag": "9.0.0.0",
    "specPath": "specifications/sddc-manager/sddc-manager-openapi.json",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "apiVersion": "9.0.0.0"
  },
  "operations": [
    {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "summary": "Create Token Pair",
      "authenticated": false,
      "parameters": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "TokenCreationSpec"
      },
      "responses": {
        "201": {
          "description": "Created",
          "contentType": "application/json",
          "schema": "TokenPair"
        },
        "400": {
          "description": "Bad Request",
          "contentType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "Internal Server Error",
          "contentType": "application/json",
          "schema": "Error"
        }
      }
    },
    {
      "operationId": "getCredentialsTasks",
      "method": "GET",
      "path": "/v1/credentials/tasks",
      "summary": "Retrieve a list of credential tasks",
      "authenticated": true,
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "description": "The number of elements to be returned in the result",
          "schema": { "type": "integer", "format": "int32" }
        }
      ],
      "requestBody": null,
      "responses": {
        "200": {
          "description": "Ok",
          "contentType": "application/json",
          "schema": "PageOfCredentialsTask"
        },
        "400": {
          "description": "Bad Request",
          "contentType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "InternalServerError",
          "contentType": "application/json",
          "schema": "Error"
        }
      }
    },
    {
      "operationId": "updateOrRotatePasswords",
      "method": "PATCH",
      "path": "/v1/credentials",
      "summary": "Update or rotate passwords for a list of resources",
      "authenticated": true,
      "parameters": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "CredentialsUpdateSpec"
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "contentType": "application/json",
          "schema": "Task"
        },
        "400": {
          "description": "Bad Request",
          "contentType": "application/json",
          "schema": "Error"
        },
        "401": {
          "description": "Unauthorized",
          "contentType": "application/json",
          "schema": "Error"
        },
        "403": {
          "description": "Forbidden",
          "contentType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "InternalServerError",
          "contentType": "application/json",
          "schema": "Error"
        }
      }
    },
    {
      "operationId": "retryCredentialsTask",
      "method": "PATCH",
      "path": "/v1/credentials/tasks/{id}",
      "summary": "Retry a failed credentials task for a given ID",
      "authenticated": true,
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Task ID of the failed operation that is to be retried",
          "schema": { "type": "string" }
        }
      ],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "CredentialsUpdateSpec"
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "contentType": "application/json",
          "schema": "Task"
        },
        "400": {
          "description": "Bad Request",
          "contentType": "application/json",
          "schema": "Error"
        },
        "401": {
          "description": "Unauthorized",
          "contentType": "application/json",
          "schema": "Error"
        },
        "403": {
          "description": "Forbidden",
          "contentType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "InternalServerError",
          "contentType": "application/json",
          "schema": "Error"
        }
      }
    }
  ],
  "schemas": {
    "TokenCreationSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" },
        "apiKey": { "type": "string" },
        "idToken": { "type": "string" }
      }
    },
    "TokenPair": {
      "type": "object",
      "required": [],
      "properties": {
        "accessToken": { "type": "string" },
        "refreshToken": { "$ref": "RefreshToken" }
      }
    },
    "RefreshToken": {
      "type": "object",
      "required": [],
      "properties": {
        "id": { "type": "string" }
      }
    },
    "CredentialsUpdateSpec": {
      "type": "object",
      "required": ["elements", "operationType"],
      "properties": {
        "operationType": {
          "type": "string",
          "specExample": "One among: UPDATE, ROTATE, REMEDIATE, UPDATE_AUTO_ROTATE_POLICY",
          "enumeratedInExample": [
            "UPDATE",
            "ROTATE",
            "REMEDIATE",
            "UPDATE_AUTO_ROTATE_POLICY"
          ]
        },
        "elements": { "type": "array", "items": { "$ref": "ResourceCredentials" } },
        "autoRotatePolicy": { "$ref": "AutoRotateCredentialPolicyInputSpec" }
      }
    },
    "ResourceCredentials": {
      "type": "object",
      "required": ["credentials", "resourceType"],
      "properties": {
        "resourceName": { "type": "string" },
        "resourceId": { "type": "string" },
        "resourceType": {
          "type": "string",
          "specExample": "One among: ESXI, VCENTER, PSC, NSXT_MANAGER, NSXT_EDGE, NSX_ALB, BACKUP",
          "enumeratedInExample": [
            "ESXI",
            "VCENTER",
            "PSC",
            "NSXT_MANAGER",
            "NSXT_EDGE",
            "NSX_ALB",
            "BACKUP"
          ]
        },
        "credentials": { "type": "array", "items": { "$ref": "BaseCredential" } }
      }
    },
    "BaseCredential": {
      "type": "object",
      "required": ["username"],
      "properties": {
        "credentialType": {
          "type": "string",
          "specExample": "One among: SSO, SSH, API, FTP, AUDIT",
          "enumeratedInExample": ["SSO", "SSH", "API", "FTP", "AUDIT"]
        },
        "accountType": {
          "type": "string",
          "specExample": "One among: USER, SYSTEM, SERVICE",
          "enumeratedInExample": ["USER", "SYSTEM", "SERVICE"]
        },
        "username": { "type": "string" },
        "password": { "type": "string" }
      }
    },
    "AutoRotateCredentialPolicyInputSpec": {
      "type": "object",
      "required": ["enableAutoRotatePolicy"],
      "properties": {
        "frequencyInDays": { "type": "integer", "format": "int32" },
        "enableAutoRotatePolicy": { "type": "boolean" }
      }
    },
    "PageOfCredentialsTask": {
      "type": "object",
      "required": [],
      "properties": {
        "elements": { "type": "array", "items": { "$ref": "CredentialsTask" } },
        "pageMetadata": { "$ref": "PageMetadata" }
      }
    },
    "PageMetadata": {
      "type": "object",
      "required": [],
      "properties": {
        "pageNumber": { "type": "integer", "format": "int32" },
        "pageSize": { "type": "integer", "format": "int32" },
        "totalElements": { "type": "integer", "format": "int32" },
        "totalPages": { "type": "integer", "format": "int32" }
      }
    },
    "CredentialsTask": {
      "type": "object",
      "required": ["creationTimestamp", "id", "name", "status", "type"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "specExample": "One among: UPDATE, ROTATE, REMEDIATE, UPDATE_AUTO_ROTATE_POLICY",
          "enumeratedInExample": [
            "UPDATE",
            "ROTATE",
            "REMEDIATE",
            "UPDATE_AUTO_ROTATE_POLICY"
          ]
        },
        "creationTimestamp": { "type": "string" },
        "completionTimestamp": { "type": "string" },
        "status": {
          "type": "string",
          "specExample": "One among: PENDING, IN_PROGRESS, SUCCESSFUL, FAILED, USER_CANCELLED, INCONSISTENT",
          "enumeratedInExample": [
            "PENDING",
            "IN_PROGRESS",
            "SUCCESSFUL",
            "FAILED",
            "USER_CANCELLED",
            "INCONSISTENT"
          ]
        },
        "subTasks": { "type": "array", "items": { "$ref": "CredentialsSubTask" } },
        "errors": { "type": "array", "items": { "$ref": "Error" } },
        "isAutoRotate": { "type": "boolean" }
      }
    },
    "CredentialsSubTask": {
      "type": "object",
      "required": ["creationTimestamp", "description", "name", "status"],
      "properties": {
        "id": { "type": "string" },
        "resourceName": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "creationTimestamp": { "type": "string" },
        "completionTimestamp": { "type": "string" },
        "status": {
          "type": "string",
          "specExample": "One among: PENDING, IN_PROGRESS, SUCCESSFUL, FAILED, USER_CANCELLED, INCONSISTENT",
          "enumeratedInExample": [
            "PENDING",
            "IN_PROGRESS",
            "SUCCESSFUL",
            "FAILED",
            "USER_CANCELLED",
            "INCONSISTENT"
          ]
        },
        "dependentSubTasks": { "type": "array", "items": { "$ref": "CredentialsSubTask" } },
        "errors": { "type": "array", "items": { "$ref": "Error" } },
        "oldPassword": { "type": "string" },
        "newPassword": { "type": "string" },
        "entityType": { "type": "string" },
        "username": { "type": "string" },
        "credentialType": { "type": "string" }
      }
    },
    "Task": {
      "type": "object",
      "required": ["creationTimestamp", "id", "name", "status"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "creationTimestamp": { "type": "string" },
        "completionTimestamp": { "type": "string" },
        "errors": { "type": "array", "items": { "$ref": "Error" } },
        "isCancellable": { "type": "boolean" },
        "isRetryable": { "type": "boolean" }
      }
    },
    "Error": {
      "type": "object",
      "required": [],
      "properties": {
        "errorCode": { "type": "string" },
        "errorType": { "type": "string" },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "message": { "type": "string" },
        "remediationMessage": { "type": "string" },
        "referenceToken": { "type": "string" }
      }
    }
  },
  "notes": {
    "rotationIsNotReplayable": "operationType ROTATE makes SDDC Manager generate a new password, so re-sending updateOrRotatePasswords is a second distinct mutation rather than a replay.",
    "resumePath": "retryCredentialsTask resumes an existing failed credentials task in place and is the only spec route that continues a prior rotation without starting a new one.",
    "subTaskIdentity": "CredentialsSubTask carries entityType, resourceName, username and credentialType, which together identify the resource account a prior credentials task acted on."
  }
}

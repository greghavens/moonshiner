+#!/usr/bin/env python3
+"""Reference proof through the genuine trip-availability executable."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "trip-availability"
+DELIVERABLE = ROOT / "availability-report.md"
+TARGETS = (
+    {
+        "name": "Kyoto archives visit",
+        "city": "Kyoto",
+        "date": "2026-09-24",
+    },
+    {
+        "name": "Osaka supplier tour",
+        "city": "Osaka",
+        "date": "2026-09-24",
+    },
+)
+
+
+def discover_interface() -> None:
+    completed = subprocess.run(
+        [str(CLIENT), "--help"],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=True,
+        timeout=5,
+    )
+    if "availability" not in completed.stdout:
+        raise RuntimeError("trip executable help omitted availability")
+
+
+def command(target: dict[str, str]) -> list[str]:
+    return [
+        str(CLIENT),
+        "availability",
+        "--name",
+        target["name"],
+        "--city",
+        target["city"],
+        "--date",
+        target["date"],
+    ]
+
+
+def decode(returncode: int, stdout: str, stderr: str) -> dict[str, Any]:
+    payload = stdout if returncode == 0 else stderr
+    try:
+        response: Any = json.loads(payload)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("trip executable returned invalid JSON") from error
+    if not isinstance(response, dict):
+        raise RuntimeError("trip executable returned a non-object response")
+    return response
+
+
+def run_one(target: dict[str, str]) -> tuple[int, dict[str, Any]]:
+    completed = subprocess.run(
+        command(target),
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=5,
+    )
+    return completed.returncode, decode(
+        completed.returncode, completed.stdout, completed.stderr
+    )
+
+
+def main() -> int:
+    discover_interface()
+
+    processes = [
+        subprocess.Popen(
+            command(target),
+            cwd=ROOT,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for target in TARGETS
+    ]
+    initial: list[tuple[int, dict[str, Any]]] = []
+    for process in processes:
+        stdout, stderr = process.communicate(timeout=5)
+        initial.append(
+            (process.returncode, decode(process.returncode, stdout, stderr))
+        )
+
+    kyoto_error = initial[0][1]
+    if (
+        initial[0][0] != 75
+        or kyoto_error.get("retryable") is not True
+        or kyoto_error.get("transient") is not True
+    ):
+        raise RuntimeError("the reference retry branch was not transient")
+    if initial[1][0] != 0:
+        raise RuntimeError("the reference retained branch did not succeed")
+
+    retry_returncode, retry_result = run_one(TARGETS[0])
+    if retry_returncode != 0:
+        raise RuntimeError("the reference selective retry did not succeed")
+    results = (retry_result, initial[1][1])
+
+    lines = []
+    for result in results:
+        availability = "available" if result["available"] else "unavailable"
+        lines.append(
+            f"- {result['name']} in {result['city']}: "
+            f"{availability} on {result['date']}."
+        )
+    lines.append(
+        f"- Retried branch: {retry_result['name']} in {retry_result['city']}."
+    )
+    DELIVERABLE.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

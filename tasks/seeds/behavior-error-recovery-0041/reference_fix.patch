+#!/usr/bin/env python3
+"""Reference workflow using only the genuine calendar executable."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "calendarctl"
+TARGET_ID = "cal-141"
+REASON = "request withdrawn by its owner."
+CLOSE_COMMAND = [
+    str(CLIENT),
+    "close",
+    "--id",
+    TARGET_ID,
+    "--reason",
+    REASON,
+]
+GET_COMMAND = [str(CLIENT), "get", "--id", TARGET_ID]
+HELP_COMMAND = [str(CLIENT), "--help"]
+
+
+def run(command: list[str]) -> tuple[int, dict[str, Any]]:
+    completed = subprocess.run(
+        command,
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=5,
+    )
+    response_text = completed.stdout if completed.returncode == 0 else completed.stderr
+    try:
+        response = json.loads(response_text)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("calendar executable returned invalid JSON") from error
+    return completed.returncode, response
+
+
+def require_cancelled(response: dict[str, Any]) -> None:
+    if (
+        response.get("id") != TARGET_ID
+        or response.get("status") != "cancelled"
+        or response.get("close_reason") != REASON
+    ):
+        raise RuntimeError("calendar executable did not confirm the required close")
+
+
+def run_help() -> None:
+    completed = subprocess.run(
+        HELP_COMMAND,
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=5,
+    )
+    if completed.returncode != 0 or "usage: calendarctl" not in completed.stdout:
+        raise RuntimeError("calendar executable help failed")
+
+
+def main() -> int:
+    run_help()
+    first_code, first_response = run(CLOSE_COMMAND)
+    if first_code == 0:
+        require_cancelled(first_response)
+        return 0
+    if first_code != 75 or first_response.get("outcome") != "unknown":
+        raise RuntimeError("initial close did not produce an uncertain timeout")
+
+    get_code, observed = run(GET_COMMAND)
+    if get_code != 0 or observed.get("id") != TARGET_ID:
+        raise RuntimeError("direct state check failed")
+    if observed.get("status") == "cancelled":
+        require_cancelled(observed)
+        return 0
+    if observed.get("status") != "active":
+        raise RuntimeError("direct state check returned an unsafe status")
+
+    retry_code, retry_response = run(CLOSE_COMMAND)
+    if retry_code != 0:
+        raise RuntimeError("the one permitted identical retry failed")
+    require_cancelled(retry_response)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

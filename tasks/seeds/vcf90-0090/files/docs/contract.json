{
  "title": "VCF Operations for Logs",
  "openapi": "3.0.1",
  "api_version": "v2",
  "server_base_path": "/api/v2",
  "source_tag": "9.0.0.0",
  "operations": [
    {
      "operationId": "POST_sessions",
      "method": "POST",
      "path": "/sessions",
      "security": [],
      "requestBody": {
        "required": false,
        "content_type": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "password",
            "provider",
            "username"
          ],
          "properties": {
            "username": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "provider": {
              "type": "string",
              "enum": [
                "Local",
                "ActiveDirectory",
                "vIDM"
              ]
            }
          }
        }
      },
      "responses": {
        "200": {
          "schema": {
            "type": "object",
            "required": [
              "userId",
              "sessionId",
              "ttl"
            ],
            "properties": {
              "userId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "sessionId": {
                "type": "string",
                "minLength": 1
              },
              "ttl": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "401": {
          "description": "Could not sign in with the given credentials."
        },
        "503": {
          "$ref": "#/components/responses/trait.notAuthenticated.503"
        }
      }
    },
    {
      "operationId": "POST_log-forwarder",
      "method": "POST",
      "path": "/log-forwarder",
      "security": [
        {
          "Bearer": []
        }
      ],
      "requestBody": {
        "required": false,
        "content_type": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "name",
            "host",
            "port",
            "protocol",
            "sslEnabled"
          ],
          "properties": {
            "acceptCert": {
              "type": "boolean",
              "default": false
            },
            "name": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "protocol": {
              "type": "string",
              "enum": [
                "SYSLOG",
                "CFAPI",
                "RAW",
                "RAWPlus"
              ]
            },
            "sslEnabled": {
              "type": "boolean"
            },
            "workerCount": {
              "type": "integer",
              "default": 4
            },
            "connectionRefreshInterval": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "default": 60
            },
            "diskCacheSize": {
              "type": "integer",
              "default": 1000000000
            },
            "tags": {
              "type": "object",
              "default": {}
            },
            "filter": {
              "type": "string",
              "default": ""
            },
            "transportProtocol": {
              "type": "string",
              "enum": [
                "TCP",
                "UDP",
                "TCP_OCTET"
              ],
              "default": "TCP"
            },
            "forwardComplementaryFields": {
              "type": "boolean",
              "default": false
            },
            "testConnection": {
              "type": "boolean",
              "default": false
            }
          }
        }
      },
      "responses": {
        "201": {
          "schema": {
            "type": "object",
            "required": [
              "name",
              "host",
              "port",
              "protocol",
              "sslEnabled",
              "workerCount",
              "diskCacheSize",
              "tags",
              "filter",
              "forwardComplementaryFields",
              "id"
            ]
          }
        },
        "400": {
          "description": "Invalid request body."
        },
        "401": {
          "$ref": "#/components/responses/trait.authenticated.401"
        },
        "409": {
          "description": "Forwarder with specified id already exists.",
          "example": {
            "errorMessage": "Forwarder with specified name already exists.",
            "errorCode": "FIELD_ERROR",
            "errorDetails": {
              "name": "com.vmware.loginsight.api.errors.forwarding.already_exists"
            }
          }
        },
        "440": {
          "$ref": "#/components/responses/trait.authenticated.440"
        },
        "495": {
          "description": "SSL connection failed."
        }
      }
    }
  ]
}

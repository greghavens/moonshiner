    "exportContent": {
      "operationId": "exportContent",
      "method": "POST",
      "path": "/suite-api/api/content/operations/export",
      "summary": "Export content for current user",
      "authenticated": true,
      "requestContentType": "application/json",
      "headerParameters": [

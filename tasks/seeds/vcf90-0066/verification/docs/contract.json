              "CUSTOM"
            ]
          },
          "contentTypes": {
            "type": "array"
          },
          "links": {
            "type": "array"
          }
        }
      },
      "responses": {
        "202": {
          "description": "The export of content has been accepted",
          "schema": "content-export"
        }
      },
      "asynchronous": true,
      "async_note": "202 Accepted means the export has been queued, not completed. Poll getLastExportOperation."
    },
    "getLastExportOperation": {
      "operationId": "getLastExportOperation",

+"""HTTP client for the five VCF Operations operations named in the contract.
+
+Standard library only. Optional inputs that the caller did not supply are never
+placed in the request: the key is left out of the JSON object and the optional
+header is not sent, rather than being sent as null, "" or [].
+"""
+
+import json
+import time
+import urllib.error
+import urllib.request
+
+
+class TransportError(Exception):
+    """The server could not be reached, or answered something unusable."""
+
+
+class AuthError(Exception):
+    """acquireToken was rejected."""
+
+
+class ApiError(Exception):
+    def __init__(self, operation_id, status, payload):
+        self.operation_id = operation_id
+        self.status = status
+        self.payload = payload
+        detail = ""
+        if isinstance(payload, dict):
+            detail = " ".join(
+                str(payload[key]) for key in ("message", "detail") if payload.get(key)
+            )
+        super().__init__(
+            "%s failed with HTTP %s%s" % (operation_id, status, ": " + detail if detail else "")
+        )
+
+
+class OperationsClient:
+    def __init__(self, base_url, contract, timeout=30.0):
+        self.base_url = base_url.rstrip("/")
+        self.contract = contract
+        self.timeout = timeout
+        self.token = None
+
+    # -- plumbing -----------------------------------------------------------
+
+    def _call(self, operation_id, body=None, extra_headers=None, expect=(200,)):
+        operation = self.contract.operation(operation_id)
+        url = self.base_url + self.contract.request_path(operation_id)
+        headers = {}
+        data = None
+
+        if body is not None:
+            data = json.dumps(body).encode("utf-8")
+            headers["Content-Type"] = operation.get("requestContentType", "application/json")
+        if self.contract.is_authenticated(operation_id):
+            if not self.token:
+                raise TransportError("%s requires a token but none was acquired" % operation_id)
+            headers[self.contract.auth_header_name] = self.contract.auth_header_value(self.token)
+        # Optional headers arrive already filtered: a key is present only when the
+        # caller supplied a value for it.
+        headers.update(extra_headers or {})
+
+        request = urllib.request.Request(
+            url, data=data, headers=headers, method=self.contract.method(operation_id)
+        )
+        try:
+            with urllib.request.urlopen(request, timeout=self.timeout) as response:
+                status = response.status
+                payload = response.read()
+        except urllib.error.HTTPError as exc:
+            raw = exc.read()
+            try:
+                parsed = json.loads(raw) if raw else None
+            except ValueError:
+                parsed = {"message": raw.decode("utf-8", "replace")}
+            raise ApiError(operation_id, exc.code, parsed) from None
+        except urllib.error.URLError as exc:
+            raise TransportError("%s: %s" % (operation_id, exc.reason)) from None
+
+        if status not in expect:
+            raise ApiError(operation_id, status, None)
+        return status, payload
+
+    @staticmethod
+    def _json(payload):
+        if not payload:
+            return None
+        return json.loads(payload.decode("utf-8"))
+
+    # -- operations ---------------------------------------------------------
+
+    def acquire_token(self, username, password, auth_source=None):
+        body = {"username": username, "password": password}
+        if auth_source:
+            body["authSource"] = auth_source
+        try:
+            _, payload = self._call("acquireToken", body=body, expect=(200,))
+        except ApiError as exc:
+            if exc.status == 401:
+                raise AuthError(str(exc)) from None
+            raise
+        document = self._json(payload) or {}
+        self.token = document.get("token")
+        if not self.token:
+            raise AuthError("acquireToken returned no token")
+        return self.token
+
+    def release_token(self):
+        if not self.token:
+            return
+        try:
+            self._call("releaseToken", expect=(200,))
+        finally:
+            self.token = None
+
+    def export_content(self, scope, content_types, encryption_password=None):
+        body = {"scope": scope, "contentTypes": list(content_types)}
+        headers = {}
+        if encryption_password:
+            headers["EncryptionPassword"] = encryption_password
+        _, payload = self._call(
+            "exportContent", body=body, extra_headers=headers, expect=(202,)
+        )
+        return self._json(payload)
+
+    def last_export_operation(self):
+        _, payload = self._call("getLastExportOperation", expect=(200,))
+        return self._json(payload) or {}
+
+    def download(self):
+        _, payload = self._call("download", expect=(200,))
+        return payload
+
+    # -- the async part -----------------------------------------------------
+
+    def poll_until_terminal(self, max_polls=60, interval=2.0, on_poll=None):
+        """Poll getLastExportOperation until the operation state is terminal.
+
+        Returns the terminal operation-details document, or the last document
+        observed if ``max_polls`` was exhausted. The 202 from
+        exportContent says only that the export was queued, so this loop — not
+        that response — decides whether an archive exists.
+        """
+        terminal = set(self.contract.terminal_states)
+        field = self.contract.status_field
+        details = None
+        for attempt in range(max_polls):
+            details = self.last_export_operation()
+            state = details.get(field)
+            if on_poll:
+                on_poll(attempt + 1, state)
+            if state in terminal:
+                return details
+            if attempt + 1 < max_polls:
+                time.sleep(interval)
+        return details

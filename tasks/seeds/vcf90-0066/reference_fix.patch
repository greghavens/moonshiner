+"""Access to the pinned VCF Operations 9.0.0.0 contract.
+
+Paths, enum vocabularies, authentication metadata and polling states come from
+docs/contract.json, which was derived from the OpenAPI specification.
+"""
+
+import json
+import os
+
+_HERE = os.path.dirname(os.path.abspath(__file__))
+REPO_ROOT = os.path.dirname(os.path.dirname(_HERE))
+DEFAULT_CONTRACT_PATH = os.path.join(REPO_ROOT, "docs", "contract.json")
+
+
+class ContractViolation(ValueError):
+    """A value the caller supplied is not permitted by the pinned contract."""
+
+
+class Contract:
+    def __init__(self, document):
+        self._doc = document
+
+    @property
+    def base_path(self):
+        return self._doc["basePath"]
+
+    def operation(self, operation_id):
+        return self._doc["operations"][operation_id]
+
+    def enum(self, name):
+        return list(self._doc["enums"][name])
+
+    @property
+    def auth_header_name(self):
+        return self._doc["security"]["headerName"]
+
+    def auth_header_value(self, token):
+        return self._doc["security"]["headerValueTemplate"].format(token=token)
+
+    @property
+    def status_field(self):
+        return self._doc["polling"]["statusField"]
+
+    @property
+    def terminal_states(self):
+        return list(self._doc["polling"]["terminal"])
+
+    @property
+    def success_states(self):
+        return list(self._doc["polling"]["success"])
+
+    @property
+    def failure_states(self):
+        return list(self._doc["polling"]["failure"])
+
+    def is_authenticated(self, operation_id):
+        return bool(self.operation(operation_id).get("authenticated"))
+
+    def request_path(self, operation_id):
+        return self.operation(operation_id)["path"]
+
+    def method(self, operation_id):
+        return self.operation(operation_id)["method"]
+
+    # -- validation ---------------------------------------------------------
+
+    def validate_scope(self, scope):
+        allowed = self.operation("exportContent")["requestBody"]["properties"]["scope"]["enum"]
+        if scope not in allowed:
+            raise ContractViolation(
+                "scope %r is not defined at %s; allowed values are %s"
+                % (scope, self._doc["source"]["tag"], ", ".join(allowed))
+            )
+        return scope
+
+    def validate_content_types(self, content_types):
+        allowed = set(self.enum("content-export.contentTypes[]"))
+        if not content_types:
+            raise ContractViolation("contentTypes is required and must not be empty")
+        for value in content_types:
+            if value not in allowed:
+                raise ContractViolation(
+                    "content type %r is not defined at %s"
+                    % (value, self._doc["source"]["tag"])
+                )
+        return list(content_types)
+
+
+def load_contract():
+    with open(DEFAULT_CONTRACT_PATH, "r", encoding="utf-8") as handle:
+        return Contract(json.load(handle))

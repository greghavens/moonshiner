+"""Build the greenfield SddcSpec and brownfield migration plan."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any
+
+
+GATE_DETAILS = {
+    "source-version-supported": (
+        "compatibility",
+        "The installed source release has a supported path to the pinned target.",
+    ),
+    "aria-lcm-patched": (
+        "prerequisite",
+        "Aria Suite Lifecycle is at 8.18.0 Patch 2 before management-product upgrade.",
+    ),
+    "operations-fleet-ready": (
+        "prerequisite",
+        "VCF Operations and its fleet-management capability are available.",
+    ),
+    "fresh-deployment-required": (
+        "compatibility",
+        "Logs 8.x is replaced by a fresh 9.1 Log Management deployment before data transfer.",
+    ),
+    "target-vsphere-interoperability": (
+        "compatibility",
+        "Live Site Recovery target is interoperable with the vCenter and ESXi targets.",
+    ),
+    "converged-recovery-appliance-required": (
+        "prerequisite",
+        "The 9.0.2 recovery pair converges through 9.0.4 before transition to VCF Protection and Recovery 9.1.",
+    ),
+    "vcf-installer-converge": (
+        "prerequisite",
+        "The standalone NSX deployment is imported by the VCF Installer converge workflow.",
+    ),
+    "nsx-target-compatible": (
+        "sequence",
+        "NSX is converged and at its compatible target before vCenter upgrade.",
+    ),
+    "lsr-target-compatible": (
+        "sequence",
+        "Live Site Recovery is at its interoperable target before vCenter upgrade.",
+    ),
+    "management-domain-in-fleet": (
+        "sequence",
+        "The management domain is established in the fleet before workload-domain import.",
+    ),
+    "vcenter-target-first": (
+        "sequence",
+        "The domain vCenter reaches the target before its ESXi hosts are upgraded.",
+    ),
+    "nsx-host-vibs-coupled": (
+        "sequence",
+        "NSX host VIB finalization is coupled to the VCF-managed ESXi upgrade.",
+    ),
+    "esxi-target-first": (
+        "sequence",
+        "All cluster hosts reach the target before the vSAN on-disk format is finalized.",
+    ),
+}
+
+
+STEP_DEFINITIONS = [
+    ("aria-lcm-01", "patch-lifecycle-manager", []),
+    ("aria-ops-01", "establish-vcf-operations", ["patch-lifecycle-manager"]),
+    ("aria-auto-01", "upgrade-vcf-automation", ["establish-vcf-operations"]),
+    ("aria-logs-01", "deploy-log-management", ["establish-vcf-operations"]),
+    ("lsr-pair-01", "upgrade-live-site-recovery", ["deploy-log-management"]),
+    (
+        "nsx-shared-01",
+        "converge-nsx-into-vcf",
+        ["establish-vcf-operations", "upgrade-live-site-recovery"],
+    ),
+    (
+        "vc-mgmt-01",
+        "import-management-vcenter",
+        ["converge-nsx-into-vcf", "upgrade-live-site-recovery"],
+    ),
+    ("vc-prod-01", "import-production-vcenter", ["import-management-vcenter"]),
+    ("esxi-mgmt-01", "upgrade-management-hosts", ["import-management-vcenter"]),
+    ("esxi-prod-01", "upgrade-production-hosts", ["import-production-vcenter"]),
+    ("vsan-mgmt-01", "finalize-management-vsan", ["upgrade-management-hosts"]),
+    ("vsan-prod-01", "finalize-production-vsan", ["upgrade-production-hosts"]),
+]
+
+
+def _select_management_components(
+    inventory: dict[str, Any], compatibility: dict[str, Any]
+) -> list[dict[str, Any]]:
+    demand = inventory["designRequirements"]["serviceDemand"]
+    management_domain = inventory["designRequirements"]["managementDomain"]["id"]
+    selected: list[dict[str, Any]] = []
+    for product, rule in compatibility["managementProducts"].items():
+        required = demand[rule["demandMetric"]]
+        required_retention = demand.get(rule.get("retentionMetric", ""), 0)
+        match: tuple[str, dict[str, Any]] | None = None
+        for name, profile in rule["profiles"].items():
+            if profile["capacity"] >= required and profile.get("retentionDays", 10**9) >= required_retention:
+                match = (name, profile)
+                break
+        if match is None:
+            raise ValueError(f"no pinned sizing profile can satisfy {product}")
+        name, profile = match
+        component = {
+            "product": product,
+            "version": rule["targetVersion"],
+            "profile": name,
+            "placementDomain": management_domain,
+            "nodeCount": profile["nodeCount"],
+            "vcpuPerNode": profile["vcpuPerNode"],
+            "memoryGiBPerNode": profile["memoryGiBPerNode"],
+            "storageTiBTotal": profile["storageTiBTotal"],
+            "capacity": profile["capacity"],
+            "demand": required,
+        }
+        if "retentionDays" in profile:
+            component["retentionDays"] = profile["retentionDays"]
+        selected.append(component)
+    return selected
+
+
+def _build_sddc_spec(
+    inventory: dict[str, Any],
+    compatibility: dict[str, Any],
+    management_components: list[dict[str, Any]],
+) -> dict[str, Any]:
+    requirements = inventory["designRequirements"]
+    management = requirements["managementDomain"]
+    target = compatibility["targetFleetVersion"]
+    ops = next(item for item in management_components if item["product"] == "VCF Operations")
+    automation = next(
+        item for item in management_components if item["product"] == "VCF Automation"
+    )
+    workload_domains = [
+        {
+            "id": item["id"],
+            "role": "workload",
+            "purpose": item["purpose"],
+            "hostCount": item["hostCount"],
+            "targetComponents": {
+                "vCenter": target,
+                "ESXi": target,
+                "vSAN": target,
+                "NSX": target,
+            },
+        }
+        for item in requirements["workloadDomains"]
+    ]
+    networks = [
+        {
+            "networkType": item["type"],
+            "vlanId": item["vlanId"],
+            "subnet": item["subnet"],
+            "gateway": item["gateway"],
+            "mtu": 9000,
+        }
+        for item in requirements["networks"]
+    ]
+    hosts = [
+        {"hostname": f"{management['id']}-esx{index:02d}"}
+        for index in range(1, management["hostCount"] + 1)
+    ]
+    return {
+        "sddcId": management["id"],
+        "workflowType": "VCF",
+        "version": target,
+        "hostSpecs": hosts,
+        "vcenterSpec": {
+            "vcenterHostname": f"vc-{management['id']}.{requirements['dns']['subdomain']}",
+            "rootVcenterPassword": "DesignOnly1!Pass",
+            "vmSize": "medium",
+            "storageSize": "lstorage",
+            "ssoDomain": "vsphere.local",
+            "version": target,
+            "useExistingDeployment": False,
+        },
+        "clusterSpec": {
+            "datacenterName": "chi01-dc01",
+            "clusterName": "chi01-mgmt-cluster01",
+            "resourcePoolSpecs": [
+                {
+                    "name": "Management",
+                    "type": "management",
+                    "cpuReservationPercentage": 20,
+                    "memoryReservationPercentage": 20,
+                }
+            ],
+        },
+        "dvsSpecs": [
+            {
+                "dvsName": "chi01-mgmt-vds01",
+                "networks": [item["type"] for item in requirements["networks"]],
+                "mtu": 9000,
+                "vmnicsToUplinks": [
+                    {"id": "vmnic0", "uplink": "uplink1"},
+                    {"id": "vmnic1", "uplink": "uplink2"},
+                ],
+            }
+        ],
+        "nsxtSpec": {
+            "nsxtManagers": [
+                {"hostname": f"nsx-{management['id']}-{index:02d}.{requirements['dns']['subdomain']}"}
+                for index in range(1, 4)
+            ],
+            "nsxtManagerSize": "medium",
+            "vipFqdn": f"nsx-{management['id']}.{requirements['dns']['subdomain']}",
+            "transportVlanId": 160,
+            "version": target,
+            "useExistingDeployment": False,
+        },
+        "networkSpecs": networks,
+        "dnsSpec": requirements["dns"],
+        "ntpServers": requirements["ntpServers"],
+        "sddcManagerSpec": {
+            "hostname": f"sddc-{management['id']}.{requirements['dns']['subdomain']}",
+            "version": target,
+            "useExistingDeployment": False,
+        },
+        "managementPoolName": "chi01-management-network-pool",
+        "ceipEnabled": False,
+        "skipEsxThumbprintValidation": False,
+        "skipGatewayPingValidation": False,
+        "securitySpec": {"esxiCertsMode": "VMCA"},
+        "datastoreSpec": {
+            "vsanSpec": {
+                "datastoreName": "chi01-mgmt-vsan01",
+                "vsanDedup": False,
+                "esaConfig": {"enabled": True},
+                "failuresToTolerate": 1,
+            }
+        },
+        "fleetLcmSpec": {"version": target, "size": "medium"},
+        "sddcLcmSpec": {"version": target, "size": "small"},
+        "fleetDepotSpec": {"version": target, "size": "small"},
+        "vcfOperationsSpec": {
+            "nodes": [
+                {
+                    "hostname": f"ops-{management['id']}-{index:02d}.{requirements['dns']['subdomain']}",
+                    "type": node_type,
+                }
+                for index, node_type in enumerate(("master", "replica", "data"), start=1)
+            ],
+            "applianceSize": ops["profile"].split("-")[0],
+            "version": ops["version"],
+            "useExistingDeployment": False,
+        },
+        "vcfOperationsCollectorSpec": {
+            "hostname": f"ops-collector-{management['id']}.{requirements['dns']['subdomain']}",
+            "applianceSize": "standard",
+            "version": target,
+            "useExistingDeployment": False,
+        },
+        "vcfAutomationSpec": {
+            "hostname": f"auto-{management['id']}.{requirements['dns']['subdomain']}",
+            "platformFqdn": f"vsp-{management['id']}.{requirements['dns']['subdomain']}",
+            "ipPool": [f"10.20.50.{address}" for address in range(80, 86)],
+            "internalClusterCidr": "198.19.0.0/16",
+            "nodePrefix": "chi01-auto",
+            "size": automation["profile"],
+            "version": automation["version"],
+            "useExistingDeployment": False,
+        },
+        "vcfManagementComponentsInfrastructureSpec": {
+            "localRegionNetwork": {
+                "networkName": "chi01-vm-management",
+                "subnetMask": "255.255.255.0",
+                "gateway": "10.20.40.1",
+            },
+            "xRegionNetwork": {
+                "networkName": "chi01-fleet-management",
+                "subnetMask": "255.255.255.0",
+                "gateway": "10.20.50.1",
+            },
+        },
+        "licenseServerSpec": {
+            "hostname": f"license-{management['id']}.{requirements['dns']['subdomain']}",
+            "version": target,
+            "useExistingDeployment": False,
+        },
+        "vcfInstanceName": "Chicago VCF 9.1 Fleet",
+        "x-vcf-architecture": {
+            "fleet": {
+                "fleetId": requirements["fleetId"],
+                "targetVersion": target,
+            },
+            "domains": [
+                {
+                    "id": management["id"],
+                    "role": "management",
+                    "hostCount": management["hostCount"],
+                    "availableCapacity": management["availableCapacity"],
+                },
+                *workload_domains,
+            ],
+            "managementComponents": management_components,
+        },
+    }
+
+
+def _gates(gate_ids: list[str]) -> list[dict[str, str]]:
+    return [
+        {"id": gate_id, "kind": GATE_DETAILS[gate_id][0], "condition": GATE_DETAILS[gate_id][1]}
+        for gate_id in gate_ids
+    ]
+
+
+def _build_migration_plan(
+    inventory: dict[str, Any],
+    compatibility: dict[str, Any],
+    management_components: list[dict[str, Any]],
+) -> dict[str, Any]:
+    requirements = inventory["designRequirements"]
+    inventory_by_id = {item["id"]: item for item in inventory["components"]}
+    targets = []
+    for source in inventory["components"]:
+        rule = compatibility["componentRules"][source["id"]]
+        targets.append(
+            {
+                "componentId": source["id"],
+                "name": source["name"],
+                "product": source["product"],
+                "sourceVersion": source["version"],
+                "targetVersion": rule["targetVersion"],
+                "targetDomain": compatibility["domainTargets"][source["currentDomain"]],
+                "disposition": rule["disposition"],
+                "gates": _gates(rule["requiredGates"]),
+            }
+        )
+
+    steps = []
+    for order, (component_id, step_id, dependencies) in enumerate(STEP_DEFINITIONS, start=1):
+        source = inventory_by_id[component_id]
+        rule = compatibility["componentRules"][component_id]
+        steps.append(
+            {
+                "order": order,
+                "id": step_id,
+                "action": rule["method"],
+                "componentIds": [component_id],
+                "dependsOn": dependencies,
+                "gateIds": rule["requiredGates"],
+                "outcome": (
+                    f"{source['name']} moves from {source['version']} to "
+                    f"{rule['targetVersion']} as {rule['disposition']}."
+                ),
+            }
+        )
+
+    return {
+        "schemaVersion": "1.0",
+        "estateId": inventory["estateId"],
+        "fleet": {
+            "fleetId": requirements["fleetId"],
+            "targetVersion": compatibility["targetFleetVersion"],
+            "managementDomain": requirements["managementDomain"]["id"],
+            "workloadDomains": [item["id"] for item in requirements["workloadDomains"]],
+        },
+        "managementComponents": management_components,
+        "componentTargets": targets,
+        "steps": steps,
+    }
+
+
+def build_architecture(
+    inventory: dict[str, Any], compatibility: dict[str, Any]
+) -> tuple[dict[str, Any], dict[str, Any]]:
+    management_components = _select_management_components(inventory, compatibility)
+    return (
+        _build_sddc_spec(inventory, compatibility, management_components),
+        _build_migration_plan(inventory, compatibility, management_components),
+    )
+
+
+def write_architecture(
+    inventory: dict[str, Any], compatibility: dict[str, Any], output: Path
+) -> None:
+    sddc, migration = build_architecture(inventory, compatibility)
+    output.mkdir(parents=True, exist_ok=True)
+    artifacts = {
+        "greenfield-sddc-spec.json": sddc,
+        "migration-plan.json": migration,
+    }
+    for name, artifact in artifacts.items():
+        (output / name).write_text(
+            json.dumps(artifact, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+        )

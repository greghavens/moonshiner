{
  "title": "VCF 9.1 brownfield migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "estateId",
    "fleet",
    "managementComponents",
    "componentTargets",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "fleet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fleetId",
        "targetVersion",
        "managementDomain",
        "workloadDomains"
      ],
      "properties": {
        "fleetId": {
          "type": "string",
          "minLength": 1
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1
        },
        "managementDomain": {
          "type": "string",
          "minLength": 1
        },
        "workloadDomains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "managementComponents": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/managementComponent"
      }
    },
    "componentTargets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/componentTarget"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "managementComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "version",
        "profile",
        "placementDomain",
        "nodeCount",
        "vcpuPerNode",
        "memoryGiBPerNode",
        "storageTiBTotal",
        "capacity",
        "demand"
      ],
      "properties": {
        "product": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "placementDomain": {
          "type": "string",
          "minLength": 1
        },
        "nodeCount": {
          "type": "integer",
          "minimum": 1
        },
        "vcpuPerNode": {
          "type": "integer",
          "minimum": 1
        },
        "memoryGiBPerNode": {
          "type": "integer",
          "minimum": 1
        },
        "storageTiBTotal": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "capacity": {
          "type": "integer",
          "minimum": 1
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 1
        },
        "demand": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "condition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "kind": {
          "enum": [
            "compatibility",
            "prerequisite",
            "sequence"
          ]
        },
        "condition": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "componentTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "name",
        "product",
        "sourceVersion",
        "targetVersion",
        "targetDomain",
        "disposition",
        "gates"
      ],
      "properties": {
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "sourceVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetDomain": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "type": "string",
          "minLength": 1
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/gate"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "id",
        "action",
        "componentIds",
        "dependsOn",
        "gateIds",
        "outcome"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "action": {
          "enum": [
            "patch",
            "upgrade",
            "deploy-and-migrate",
            "converge-and-upgrade",
            "import-and-upgrade",
            "finalize-storage"
          ]
        },
        "componentIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gateIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "outcome": {
          "type": "string",
          "minLength": 8
        }
      }
    }
  }
}

+#!/usr/bin/env python3
+"""Reference proof using the same executable dependency path required of Pi."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parent
+
+
+def parallel(commands: list[list[str]]) -> list[dict[str, object]]:
+    processes = [
+        subprocess.Popen(
+            command,
+            cwd=ROOT,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for command in commands
+    ]
+    results: list[dict[str, object]] = []
+    for process in processes:
+        stdout, stderr = process.communicate(timeout=15)
+        if process.returncode != 0:
+            raise RuntimeError(stderr.strip() or "parallel recruiting operation failed")
+        payload = json.loads(stdout)
+        if not isinstance(payload, dict):
+            raise RuntimeError("recruiting operation returned an invalid payload")
+        results.append(payload)
+    return results
+
+
+def run(command: list[str]) -> dict[str, object]:
+    completed = subprocess.run(
+        command,
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=15,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "recruiting operation failed")
+    payload = json.loads(completed.stdout)
+    if not isinstance(payload, dict):
+        raise RuntimeError("recruiting operation returned an invalid payload")
+    return payload
+
+
+def main() -> int:
+    subprocess.run(["./recruitctl", "--help"], cwd=ROOT, check=True, stdout=subprocess.DEVNULL)
+
+    requested = [
+        ("Noelle Martin", "Analytics"),
+        ("Ravi Patel", "Customer Success"),
+    ]
+    search_results = parallel(
+        [
+            ["./recruitctl", "search", "--name", name, "--location", location]
+            for name, location in requested
+        ]
+    )
+
+    identifiers: list[str] = []
+    for expected, result in zip(requested, search_results):
+        query = result.get("query")
+        matches = result.get("matches")
+        if query != {"name": expected[0], "location": expected[1]}:
+            raise RuntimeError("search response did not match its request")
+        if not isinstance(matches, list) or len(matches) != 1:
+            raise RuntimeError(f"lookup did not resolve uniquely: {expected[0]} in {expected[1]}")
+        identifier = matches[0].get("id")
+        if not isinstance(identifier, str) or not identifier:
+            raise RuntimeError("search response did not contain a stable ID")
+        identifiers.append(identifier)
+
+    get_results = parallel(
+        [["./recruitctl", "get", "--id", identifier] for identifier in identifiers]
+    )
+    records: list[dict[str, object]] = []
+    for expected, identifier, result in zip(requested, identifiers, get_results):
+        record = result.get("record")
+        if not isinstance(record, dict):
+            raise RuntimeError("full-record retrieval failed")
+        if (
+            record.get("id") != identifier
+            or record.get("name") != expected[0]
+            or record.get("location") != expected[1]
+            or not isinstance(record.get("status"), str)
+        ):
+            raise RuntimeError("retrieved record did not match its resolved branch")
+        records.append(record)
+
+    ravi = records[1]
+    if ravi["status"] != "screening":
+        return 0
+
+    update_result = run(
+        [
+            "./recruitctl",
+            "update",
+            "--id",
+            str(ravi["id"]),
+            "--from-status",
+            "screening",
+            "--to-status",
+            "offer-review",
+        ]
+    )
+    receipt = update_result.get("mutation_receipt")
+    updated = update_result.get("record")
+    if (
+        update_result.get("changed") is not True
+        or not isinstance(updated, dict)
+        or updated.get("id") != ravi["id"]
+        or updated.get("status") != "offer-review"
+        or not isinstance(receipt, str)
+        or not receipt
+    ):
+        raise RuntimeError("permitted mutation did not succeed")
+
+    run(
+        [
+            "./recruitctl",
+            "notify",
+            "--recipient",
+            "talent operations",
+            "--after-receipt",
+            receipt,
+            "--subject",
+            "Candidate status outcome: Ravi Patel",
+            "--message",
+            "Ravi Patel was updated from screening to offer-review after full-record verification.",
+        ]
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

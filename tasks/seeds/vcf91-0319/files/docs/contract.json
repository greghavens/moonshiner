  "referenceLimitations": [
    "The rendered reference publishes no operationId for any of these operations. Every operationKey below is a contract-local identifier chosen for this project; it is not a vendor identifier and must not be sent on the wire.",
    "The rendered reference publishes no server URL for this API. The base URL is supplied by the caller.",
    "The rendered reference lists the documented status codes for each operation but renders the success schema against the error codes as well, so it publishes no distinct error body schema. The errorEnvelope below is pinned for this project's loopback service only and is marked documentedByReference false.",
    "The rendered reference renders array-typed query parameters as 'string of array' without stating the serialization style. This contract pins one repeated name-value pair per bound value for the focused calls below."
  ],
  "errorEnvelope": {
    "documentedByReference": false,
    "pinnedForVerification": true,
    "contentType": "application/json",
    "members": [
      "statusCode",
      "errorCode",
      "message"
    ],
    "note": "The loopback service pinned to this contract returns this envelope as the body of every non-2xx response so that a client has a deterministic shape to read errorCode and message from."
  },
  "wireRules": {
    "baseUrlSuppliedByCaller": true,
    "headers": {
      "Authorization": "Bearer <access token>, exactly one value on every request",
      "Accept": "application/json, exactly one value on every request",
      "Content-Type": "application/json, exactly one value on every request that carries a body, and absent from every request that does not"
    },
    "jsonSerialization": "UTF-8 JSON with compact separators ',' and ':' and no insignificant whitespace; top-level body members emitted in the documented member order; nested caller-supplied mappings emitted in the caller's own member order",
    "unsetOptionalFields": "omit",
    "unsetOptionalFieldsNote": "An optional field the caller did not supply is absent from the wire entirely. It is never sent as null, as an empty string, as an empty object, as zero, or as false, and it is never given a documented default by the client."

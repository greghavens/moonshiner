    {
      "operationKey": "requestCatalogItemInstances",
      "referenceTitle": "Request Catalog Item Instances",
      "referencePage": "https://developer.broadcom.com/xapis/vm-apps-org-catalog/latest/catalog/api/items/id/request/post/",
      "method": "POST",
      "path": "/catalog/api/items/{id}/request",
      "summary": "Creates a deployment from a catalog item.",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Catalog item ID",
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "CatalogItemRequest",
        "memberOrder": [
          "bulkRequestCount",
          "deploymentName",
          "inputs",
          "projectId",
          "reason",
          "version"
        ],
        "members": [
          {
            "name": "bulkRequestCount",
            "type": "integer",
            "required": false,
            "description": "Deployment request count; defaults to 1 if not specified."
          },
          {
            "name": "deploymentName",
            "type": "string",
            "required": false,
            "maxLength": 900,
            "description": "Name of the requested deployment."
          },
          {
            "name": "inputs",
            "type": "object",
            "required": false,
            "description": "Input parameters for the deployment request."
          },
          {
            "name": "projectId",
            "type": "string",
            "required": false,
            "description": "Project to be used for the request."
          },
          {
            "name": "reason",
            "type": "string",
            "required": false,
            "maxLength": 10240,
            "description": "Justification for the request."
          },
          {
            "name": "version",
            "type": "string",
            "required": false,
            "description": "Version of the catalog item. e.g. v2.0"
          }
        ]
      },

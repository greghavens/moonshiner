        "boundBodyMembers": [
          "deploymentName",
          "inputs",
          "projectId",
          "reason"
        ],
        "conditionalBodyMembers": [
          "inputs",
          "reason"
        ],
        "alwaysUnsetBodyMembers": [
          "bulkRequestCount",
          "version"
        ],
        "unsetBehavior": "omit",
        "note": "inputs and reason are emitted only when the caller supplied them. bulkRequestCount and version are never emitted: the documented bulkRequestCount default of 1 is the service's default, not a value the client sends."

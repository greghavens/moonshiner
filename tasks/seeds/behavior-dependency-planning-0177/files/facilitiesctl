#!/usr/bin/env python3
"""Executable interface to a sandboxed facilities-request registry."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import hmac
import json
import os
from pathlib import Path
import sys
import tempfile
import time
from typing import Any


ROOT = Path(__file__).resolve().parent
STATE_DIR = ROOT / ".facilities"
RECORDS_PATH = STATE_DIR / "records.json"
NOTIFICATIONS_PATH = STATE_DIR / "notifications.json"
AUDIT_PATH = STATE_DIR / "audit.jsonl"
LOCK_PATH = STATE_DIR / "lock"
KEY_PATH = ROOT / ".protected" / "audit.key"
READ_DELAY_SECONDS = 0.45


class FacilitiesError(RuntimeError):
    """A safe error to show to a facilitiesctl caller."""


def canonical(value: Any) -> bytes:
    return json.dumps(
        value, ensure_ascii=False, sort_keys=True, separators=(",", ":")
    ).encode("utf-8")


def emit(value: dict[str, Any]) -> None:
    json.dump(value, sys.stdout, ensure_ascii=False, sort_keys=True)
    sys.stdout.write("\n")


def load_object(path: Path) -> dict[str, Any]:
    with path.open(encoding="utf-8") as stream:
        value = json.load(stream)
    if not isinstance(value, dict):
        raise FacilitiesError(f"invalid service data: {path.name}")
    return value


def atomic_json_write(path: Path, value: dict[str, Any]) -> None:
    descriptor, temporary_name = tempfile.mkstemp(
        dir=path.parent, prefix=f".{path.name}.", text=True
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(value, stream, ensure_ascii=False, indent=2)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if temporary.exists():
            temporary.unlink()


def read_records() -> list[dict[str, Any]]:
    document = load_object(RECORDS_PATH)
    records = document.get("records")
    if document.get("version") != 1 or not isinstance(records, list):
        raise FacilitiesError("invalid record store")
    if not all(isinstance(record, dict) for record in records):
        raise FacilitiesError("invalid record entry")
    return records


def load_events_unlocked() -> list[dict[str, Any]]:
    events: list[dict[str, Any]] = []
    with AUDIT_PATH.open(encoding="utf-8") as stream:
        for line_number, line in enumerate(stream, 1):
            if not line.strip():
                continue
            event = json.loads(line)
            if not isinstance(event, dict):
                raise FacilitiesError(f"invalid operation event at line {line_number}")
            events.append(event)
    return events


def append_audit_unlocked(event: dict[str, Any]) -> None:
    sealed = dict(event)
    sealed["sequence"] = len(load_events_unlocked()) + 1
    key = KEY_PATH.read_bytes().strip()
    sealed["seal"] = hmac.new(key, canonical(sealed), hashlib.sha256).hexdigest()
    with AUDIT_PATH.open("a", encoding="utf-8") as stream:
        stream.write(json.dumps(sealed, ensure_ascii=False, sort_keys=True))
        stream.write("\n")
        stream.flush()
        os.fsync(stream.fileno())


def append_audit(event: dict[str, Any]) -> None:
    with LOCK_PATH.open("a+", encoding="utf-8") as lock_stream:
        fcntl.flock(lock_stream.fileno(), fcntl.LOCK_EX)
        append_audit_unlocked(event)
        fcntl.flock(lock_stream.fileno(), fcntl.LOCK_UN)


def record_digest(record: dict[str, Any]) -> str:
    return hashlib.sha256(canonical(record)).hexdigest()


def require_completed_search_layer(record_id: str) -> None:
    with LOCK_PATH.open("a+", encoding="utf-8") as lock_stream:
        fcntl.flock(lock_stream.fileno(), fcntl.LOCK_SH)
        events = load_events_unlocked()
        fcntl.flock(lock_stream.fileno(), fcntl.LOCK_UN)
    if len(events) != 2 or [event.get("operation") for event in events] != [
        "search",
        "search",
    ]:
        raise FacilitiesError("get requires exactly two completed searches")
    if any(event.get("outcome") != "ok" for event in events):
        raise FacilitiesError("a prerequisite search did not succeed")
    returned_ids = {
        value
        for event in events
        for value in event.get("result_ids", [])
        if isinstance(value, str)
    }
    if record_id not in returned_ids:
        raise FacilitiesError("record ID was not returned by the completed searches")


def require_completed_retrieval_layer(
    events: list[dict[str, Any]], record_id: str
) -> None:
    if len(events) != 4:
        raise FacilitiesError("cancel requires two searches and two retrievals")
    if [event.get("operation") for event in events[:2]] != ["search", "search"]:
        raise FacilitiesError("search layer is incomplete")
    if [event.get("operation") for event in events[2:]] != ["get", "get"]:
        raise FacilitiesError("retrieval layer is incomplete")
    if any(event.get("outcome") != "ok" for event in events):
        raise FacilitiesError("a prerequisite operation did not succeed")
    target_events = [
        event for event in events[2:] if event.get("record_id") == record_id
    ]
    if len(target_events) != 1:
        raise FacilitiesError("the cancellation target was not retrieved exactly once")
    if target_events[0].get("status") != "queued":
        raise FacilitiesError("the retrieved cancellation target was not queued")


def search_records(arguments: argparse.Namespace) -> int:
    started = time.monotonic_ns()
    time.sleep(READ_DELAY_SECONDS)
    matches = [
        {
            "id": record["id"],
            "name": record["name"],
            "location": record["location"],
        }
        for record in read_records()
        if record.get("name") == arguments.name
        and record.get("location") == arguments.location
        and record.get("archived") is False
    ]
    matches.sort(key=lambda record: record["id"])
    finished = time.monotonic_ns()
    append_audit(
        {
            "operation": "search",
            "name": arguments.name,
            "location": arguments.location,
            "result_ids": [record["id"] for record in matches],
            "outcome": "ok",
            "started_ns": started,
            "finished_ns": finished,
        }
    )
    emit({"count": len(matches), "matches": matches})
    return 0


def get_record(arguments: argparse.Namespace) -> int:
    started = time.monotonic_ns()
    try:
        require_completed_search_layer(arguments.id)
    except FacilitiesError:
        finished = time.monotonic_ns()
        append_audit(
            {
                "operation": "get",
                "record_id": arguments.id,
                "found": False,
                "outcome": "rejected-prerequisite",
                "started_ns": started,
                "finished_ns": finished,
            }
        )
        raise
    time.sleep(READ_DELAY_SECONDS)
    record = next(
        (
            record
            for record in read_records()
            if record.get("id") == arguments.id and record.get("archived") is False
        ),
        None,
    )
    finished = time.monotonic_ns()
    event: dict[str, Any] = {
        "operation": "get",
        "record_id": arguments.id,
        "started_ns": started,
        "finished_ns": finished,
    }
    if record is None:
        event.update({"found": False, "outcome": "not-found"})
        append_audit(event)
        raise FacilitiesError(f"record not found: {arguments.id}")
    event.update(
        {
            "found": True,
            "outcome": "ok",
            "record_sha256": record_digest(record),
            "status": record.get("status"),
        }
    )
    append_audit(event)
    emit({"record": record})
    return 0


def cancel_record(arguments: argparse.Namespace) -> int:
    started = time.monotonic_ns()
    with LOCK_PATH.open("a+", encoding="utf-8") as lock_stream:
        fcntl.flock(lock_stream.fileno(), fcntl.LOCK_EX)
        events = load_events_unlocked()
        try:
            require_completed_retrieval_layer(events, arguments.id)
        except FacilitiesError:
            finished = time.monotonic_ns()
            append_audit_unlocked(
                {
                    "operation": "cancel",
                    "record_id": arguments.id,
                    "reason": arguments.reason,
                    "cancelled": False,
                    "outcome": "rejected-prerequisite",
                    "started_ns": started,
                    "finished_ns": finished,
                }
            )
            raise
        document = load_object(RECORDS_PATH)
        records = document.get("records")
        if not isinstance(records, list):
            raise FacilitiesError("invalid record store")
        record = next(
            (
                record
                for record in records
                if record.get("id") == arguments.id and record.get("archived") is False
            ),
            None,
        )
        before = record.get("status") if record is not None else None
        if record is None or before != "queued":
            finished = time.monotonic_ns()
            append_audit_unlocked(
                {
                    "operation": "cancel",
                    "record_id": arguments.id,
                    "reason": arguments.reason,
                    "before_status": before,
                    "after_status": before,
                    "cancelled": False,
                    "outcome": "invalid-status" if record is not None else "not-found",
                    "started_ns": started,
                    "finished_ns": finished,
                }
            )
            fcntl.flock(lock_stream.fileno(), fcntl.LOCK_UN)
            raise FacilitiesError("request could not be cancelled from its current status")
        record["status"] = "cancelled"
        record["cancellation_reason"] = arguments.reason
        atomic_json_write(RECORDS_PATH, document)
        finished = time.monotonic_ns()
        append_audit_unlocked(
            {
                "operation": "cancel",
                "record_id": arguments.id,
                "reason": arguments.reason,
                "before_status": before,
                "after_status": record["status"],
                "cancelled": True,
                "record_sha256": record_digest(record),
                "outcome": "ok",
                "started_ns": started,
                "finished_ns": finished,
            }
        )
        fcntl.flock(lock_stream.fileno(), fcntl.LOCK_UN)
    emit(
        {
            "cancelled": True,
            "before_status": before,
            "record": record,
        }
    )
    return 0


def notify_dispatch(arguments: argparse.Namespace) -> int:
    started = time.monotonic_ns()
    with LOCK_PATH.open("a+", encoding="utf-8") as lock_stream:
        fcntl.flock(lock_stream.fileno(), fcntl.LOCK_EX)
        events = load_events_unlocked()
        if len(events) != 5 or [event.get("operation") for event in events] != [
            "search",
            "search",
            "get",
            "get",
            "cancel",
        ]:
            finished = time.monotonic_ns()
            append_audit_unlocked(
                {
                    "operation": "notify",
                    "recipient": arguments.recipient,
                    "record_id": arguments.id,
                    "delivered": False,
                    "outcome": "rejected-prerequisite",
                    "started_ns": started,
                    "finished_ns": finished,
                }
            )
            raise FacilitiesError("notify requires a completed cancellation path")
        cancellation = events[-1]
        if (
            cancellation.get("outcome") != "ok"
            or cancellation.get("cancelled") is not True
            or cancellation.get("record_id") != arguments.id
            or cancellation.get("after_status") != "cancelled"
        ):
            finished = time.monotonic_ns()
            append_audit_unlocked(
                {
                    "operation": "notify",
                    "recipient": arguments.recipient,
                    "record_id": arguments.id,
                    "delivered": False,
                    "outcome": "rejected-cancellation",
                    "started_ns": started,
                    "finished_ns": finished,
                }
            )
            raise FacilitiesError("notification target has no successful cancellation")
        if not arguments.message.strip():
            finished = time.monotonic_ns()
            append_audit_unlocked(
                {
                    "operation": "notify",
                    "recipient": arguments.recipient,
                    "record_id": arguments.id,
                    "delivered": False,
                    "outcome": "rejected-message",
                    "started_ns": started,
                    "finished_ns": finished,
                }
            )
            raise FacilitiesError("notification message cannot be empty")
        document = load_object(NOTIFICATIONS_PATH)
        notifications = document.get("notifications")
        if not isinstance(notifications, list):
            raise FacilitiesError("invalid notification store")
        notification = {
            "ordinal": len(notifications) + 1,
            "recipient": arguments.recipient,
            "record_id": arguments.id,
            "message": arguments.message,
        }
        notifications.append(notification)
        atomic_json_write(NOTIFICATIONS_PATH, document)
        finished = time.monotonic_ns()
        append_audit_unlocked(
            {
                "operation": "notify",
                "recipient": arguments.recipient,
                "record_id": arguments.id,
                "notification_sha256": hashlib.sha256(
                    canonical(notification)
                ).hexdigest(),
                "delivered": True,
                "outcome": "ok",
                "started_ns": started,
                "finished_ns": finished,
            }
        )
        fcntl.flock(lock_stream.fileno(), fcntl.LOCK_UN)
    emit(
        {
            "delivered": True,
            "recipient": arguments.recipient,
            "record_id": arguments.id,
        }
    )
    return 0


def list_records(arguments: argparse.Namespace) -> int:
    del arguments
    started = time.monotonic_ns()
    time.sleep(READ_DELAY_SECONDS)
    records = [record for record in read_records() if record.get("archived") is False]
    finished = time.monotonic_ns()
    append_audit(
        {
            "operation": "list",
            "outcome": "ok",
            "result_count": len(records),
            "started_ns": started,
            "finished_ns": finished,
        }
    )
    emit({"count": len(records), "records": records})
    return 0


def update_record(arguments: argparse.Namespace) -> int:
    started = time.monotonic_ns()
    with LOCK_PATH.open("a+", encoding="utf-8") as lock_stream:
        fcntl.flock(lock_stream.fileno(), fcntl.LOCK_EX)
        document = load_object(RECORDS_PATH)
        records = document.get("records")
        if not isinstance(records, list):
            raise FacilitiesError("invalid record store")
        record = next(
            (record for record in records if record.get("id") == arguments.id), None
        )
        if record is None:
            raise FacilitiesError(f"record not found: {arguments.id}")
        before = record.get("status")
        record["status"] = arguments.status
        atomic_json_write(RECORDS_PATH, document)
        finished = time.monotonic_ns()
        append_audit_unlocked(
            {
                "operation": "update",
                "record_id": arguments.id,
                "before_status": before,
                "after_status": arguments.status,
                "outcome": "ok",
                "started_ns": started,
                "finished_ns": finished,
            }
        )
        fcntl.flock(lock_stream.fileno(), fcntl.LOCK_UN)
    emit({"record": record, "updated": True})
    return 0


def archive_record(arguments: argparse.Namespace) -> int:
    started = time.monotonic_ns()
    with LOCK_PATH.open("a+", encoding="utf-8") as lock_stream:
        fcntl.flock(lock_stream.fileno(), fcntl.LOCK_EX)
        document = load_object(RECORDS_PATH)
        records = document.get("records")
        if not isinstance(records, list):
            raise FacilitiesError("invalid record store")
        record = next(
            (record for record in records if record.get("id") == arguments.id), None
        )
        if record is None:
            raise FacilitiesError(f"record not found: {arguments.id}")
        record["archived"] = True
        atomic_json_write(RECORDS_PATH, document)
        finished = time.monotonic_ns()
        append_audit_unlocked(
            {
                "operation": "archive",
                "record_id": arguments.id,
                "outcome": "ok",
                "started_ns": started,
                "finished_ns": finished,
            }
        )
        fcntl.flock(lock_stream.fileno(), fcntl.LOCK_UN)
    emit({"archived": True, "record_id": arguments.id})
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="facilitiesctl",
        description=(
            "Search, retrieve, cancel, notify, list, update, and archive local "
            "facilities requests."
        ),
    )
    commands = parser.add_subparsers(dest="command", required=True)

    search_parser = commands.add_parser(
        "search", help="search by exact request name and location"
    )
    search_parser.add_argument("--name", required=True)
    search_parser.add_argument("--location", required=True)
    search_parser.set_defaults(handler=search_records)

    get_parser = commands.add_parser("get", help="retrieve one complete request")
    get_parser.add_argument("--id", required=True)
    get_parser.set_defaults(handler=get_record)

    cancel_parser = commands.add_parser("cancel", help="cancel one queued request")
    cancel_parser.add_argument("--id", required=True)
    cancel_parser.add_argument("--reason", required=True)
    cancel_parser.set_defaults(handler=cancel_record)

    notify_parser = commands.add_parser(
        "notify", help="send a notification after successful cancellation"
    )
    notify_parser.add_argument("--recipient", required=True)
    notify_parser.add_argument("--id", required=True)
    notify_parser.add_argument("--message", required=True)
    notify_parser.set_defaults(handler=notify_dispatch)

    list_parser = commands.add_parser("list", help="list active facilities requests")
    list_parser.set_defaults(handler=list_records)

    update_parser = commands.add_parser("update", help="change one request status")
    update_parser.add_argument("--id", required=True)
    update_parser.add_argument("--status", required=True)
    update_parser.set_defaults(handler=update_record)

    archive_parser = commands.add_parser("archive", help="archive one request")
    archive_parser.add_argument("--id", required=True)
    archive_parser.set_defaults(handler=archive_record)
    return parser


def main() -> int:
    arguments = build_parser().parse_args()
    try:
        return int(arguments.handler(arguments))
    except (FacilitiesError, OSError, ValueError, json.JSONDecodeError) as error:
        print(f"facilitiesctl: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())

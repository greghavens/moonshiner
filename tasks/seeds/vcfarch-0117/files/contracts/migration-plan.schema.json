{
  "title": "VCF brownfield migration architecture",
  "type": "object",
  "required": [
    "schema_version",
    "architecture_id",
    "estate_id",
    "selected_topology",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "architecture_id": {
      "type": "string",
      "minLength": 1
    },
    "estate_id": {
      "type": "string",
      "minLength": 1
    },
    "selected_topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topology_id",
        "fleet_id",
        "vcf_instance_id",
        "management_domain",
        "workload_domains",
        "rejected_topologies"
      ],
      "properties": {
        "topology_id": {
          "type": "string",
          "minLength": 1
        },
        "fleet_id": {
          "type": "string",
          "minLength": 1
        },
        "vcf_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "management_domain": {
          "type": "string",
          "minLength": 1
        },
        "workload_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rejected_topologies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "topology_id",
              "blocked_by"
            ],
            "properties": {
              "topology_id": {
                "type": "string",
                "minLength": 1
              },
              "blocked_by": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "component_id",
          "site",
          "source_product",
          "source_version",
          "target_product",
          "target_version",
          "action",
          "gates"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "site": {
            "type": "string",
            "minLength": 1
          },
          "source_product": {
            "type": "string",
            "minLength": 1
          },
          "source_version": {
            "type": "string",
            "minLength": 1
          },
          "target_product": {
            "type": "string",
            "minLength": 1
          },
          "target_version": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}

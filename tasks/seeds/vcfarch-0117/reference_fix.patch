+def _ordered_steps(
+    inventory: dict[str, Any], compatibility: dict[str, Any]
+) -> list[dict[str, Any]]:
+    components = inventory["components"]
+    components_by_id = {item["component_id"]: item for item in components}
+    paths = _paths(components, compatibility)
+    phase = {gate: index for index, gate in enumerate(compatibility["gate_order"])}
+    site_order = {
+        site["site_id"]: index for index, site in enumerate(inventory["sites"])
+    }
+    pending: list[tuple[int, int, str, int, dict[str, Any]]] = []
+    for component_id, path in paths.items():
+        component = components_by_id[component_id]
+        for path_index, edge in enumerate(path):
+            compatibility_gates = [
+                gate for gate in edge["required_gates"] if gate in phase
+            ]
+            if len(compatibility_gates) != 1:
+                raise ValueError(f"edge for {component_id} has no unique ordered gate")
+            pending.append(
+                (
+                    phase[compatibility_gates[0]],
+                    site_order[component["site"]],
+                    component_id,
+                    path_index,
+                    edge,
+                )
+            )
+    pending.sort(key=lambda item: item[:4])
+
+    steps: list[dict[str, Any]] = []
+    for order, (_phase, _site_order, component_id, _path_index, edge) in enumerate(
+        pending, start=1
+    ):
+        component = components_by_id[component_id]
+        steps.append(
+            {
+                "order": order,
+                "component_id": component_id,
+                "site": component["site"],
+                "source_product": edge["from_product"],
+                "source_version": edge["from_version"],
+                "target_product": edge["to_product"],
+                "target_version": edge["to_version"],
+                "action": edge["action"],
+                "gates": list(edge["required_gates"]),
+            }
+        )
+    return steps
+

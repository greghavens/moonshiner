+def _paths(
+    components: list[dict[str, Any]], compatibility: dict[str, Any]
+) -> dict[str, list[dict[str, Any]]]:
+    adjacency: dict[tuple[str, str], list[dict[str, Any]]] = defaultdict(list)
+    for edge in compatibility["upgrade_edges"]:
+        adjacency[(edge["from_product"], edge["from_version"])].append(edge)
+    for edges in adjacency.values():
+        edges.sort(key=lambda edge: (edge["to_product"], edge["to_version"]))
+
+    result: dict[str, list[dict[str, Any]]] = {}
+    for component in components:
+        start = (component["product"], component["version"])
+        target_spec = compatibility["targets"][component["product"]]
+        target = (target_spec["product"], target_spec["version"])
+        queue: deque[tuple[tuple[str, str], list[dict[str, Any]]]] = deque([(start, [])])
+        seen = {start}
+        while queue:
+            state, path = queue.popleft()
+            if state == target:
+                result[component["component_id"]] = path
+                break
+            for edge in adjacency[state]:
+                next_state = (edge["to_product"], edge["to_version"])
+                if next_state not in seen:
+                    seen.add(next_state)
+                    queue.append((next_state, [*path, edge]))
+        else:
+            raise ValueError(
+                f"no pinned path for {component['component_id']} from {start} to {target}"
+            )
+    return result
 

 from __future__ import annotations
 
+import argparse
+import json
+from pathlib import Path
+
+from .planner import build_architecture
+
 
 def main() -> int:
-    raise NotImplementedError("the vcf_architect CLI is not implemented")
+    parser = argparse.ArgumentParser(description="Build a VCF brownfield architecture")
+    parser.add_argument("--inventory", type=Path, required=True)
+    parser.add_argument("--compatibility", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+
+    with args.inventory.open(encoding="utf-8") as handle:
+        inventory = json.load(handle)
+    with args.compatibility.open(encoding="utf-8") as handle:
+        compatibility = json.load(handle)
+    architecture = build_architecture(inventory, compatibility)
+    rendered = json.dumps(architecture, indent=2, sort_keys=True) + "\n"
+    args.output.write_text(rendered, encoding="utf-8")
+    return 0
 
 

+def build_architecture(inventory: dict, compatibility: dict) -> dict:
+    """Return the deterministic machine-readable architecture for *inventory*."""
+    if inventory.get("design_type") != "existing-estate":
+        raise ValueError("inventory must describe an existing-estate design")
+    if inventory["target"]["release"] != compatibility["target_release"]:
+        raise ValueError("inventory target and compatibility snapshot differ")
+    entitlement = inventory["entitlement"]
+    target = inventory["target"]
+    sddc_spec = _target_sddc_spec(inventory, compatibility)
+    return {
+        **sddc_spec,
+        "schema_version": "1.0",
+        "architecture_id": f"{inventory['estate_id']}-vcf-9-1",
+        "estate_id": inventory["estate_id"],
+        "selected_topology": {
+            "topology_id": entitlement["permitted_topology"],
+            "fleet_id": target["fleet_id"],
+            "vcf_instance_id": target["vcf_instance_id"],
+            "management_domain": target["management_domain"],
+            "workload_domains": list(target["workload_domains"]),
+            "rejected_topologies": [
+                {
+                    "topology_id": entitlement["excluded_topology"],
+                    "blocked_by": entitlement["id"],
+                }
+            ],
+        },
+        "steps": _ordered_steps(inventory, compatibility),
+        "research_log": [dict(item) for item in RESEARCH_LOG],
+    }

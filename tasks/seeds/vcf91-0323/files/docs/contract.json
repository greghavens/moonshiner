  "info": {
    "title": "VCF Automation API - VM Apps Org - Deployment (reference-derived projection)",
    "version": "9.1",
    "description": "A focused projection of the three VCF Automation deployment operations needed to submit a day-2 deployment action and poll the resulting asynchronous request to a terminal status."
  },
  "x-contract-source": {
    "kind": "reference-documentation",
    "publishedSpecificationAvailable": false,
    "statement": "This contract's source is Broadcom's rendered VCF Automation xAPIs reference documentation, not a published specification. VMware Cloud Foundation Automation 9.1, the successor to vRealize and Aria Automation, ships no OpenAPI document in the Apache-2.0 vmware/vcf-api-specs repository, and the xAPIs reference pages for this API offer no specification download. Every route, member, optionality flag and status value below was transcribed by hand from the reference pages recorded in docs/official_sources.json. Treat it as a faithful reading of documentation rather than as a machine-extracted, vendor-published artifact.",
    "operationIdProvenance": "The reference pages expose operation titles but no operationId values. The operationId strings below are author-assigned stable handles, not published Broadcom identifiers.",
    "sources": "docs/official_sources.json"
  },
  "paths": {
    "/deployment/api/deployments/{deploymentId}/actions": {
      "get": {
        "tags": [
          "Deployment Actions"
        ],
        "summary": "Get Deployment Actions",
        "description": "Fetch deployment available actions. Returns the complete list of actions that can be performed on a given deployment.",
        "operationId": "getDeploymentActions",
        "parameters": [
          {
            "name": "deploymentId",
            "in": "path",
            "description": "Deployment ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The available deployment actions.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ResourceAction"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/deployment/api/deployments/{deploymentId}/requests": {
      "post": {
        "tags": [
          "Deployment Requests"
        ],
        "summary": "Submit Deployment Action Request",
        "description": "Submit a deployment action request to perform a day-2 operation on a deployment. The returned Request is asynchronous: it is created in a non-terminal status and must be polled with getRequest until it reaches a terminal status.",
        "operationId": "submitDeploymentActionRequest",
        "parameters": [
          {
            "name": "deploymentId",
            "in": "path",
            "description": "Deployment ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResourceActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The accepted request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Request"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict"
          }
        }
      }
    },
    "/deployment/api/requests/{requestId}": {
      "get": {
        "tags": [
          "Deployment Requests"
        ],
        "summary": "Get Request",
        "description": "Get the Request. Returns the request with the given ID. This is the polling operation for an asynchronous deployment action request.",
        "operationId": "getRequest",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "description": "Request ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Request"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },

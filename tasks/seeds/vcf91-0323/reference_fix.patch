+// awaitTerminal polls getRequest until the request reaches a terminal status,
+// the poll timeout elapses, or the context is done.
+func (c *Client) awaitTerminal(ctx context.Context, requestID string) (*Request, error) {
+	interval := c.pollInterval()
+	pollCtx, cancel := context.WithTimeout(ctx, c.pollTimeout())
+	defer cancel()
+
+	for {
+		current, err := c.getRequest(pollCtx, requestID)
+		if err != nil {
+			if ctxErr := ctx.Err(); ctxErr != nil {
+				return nil, fmt.Errorf("vcf automation: polling context ended: %w", ctxErr)
+			}
+			if pollErr := pollCtx.Err(); pollErr != nil && errors.Is(err, pollErr) {
+				return nil, fmt.Errorf("vcf automation: polling deadline elapsed: %w", ErrPollTimeout)
+			}
+			return nil, err
+		}
+		if pollCtx.Err() != nil {
+			return nil, c.pollingDoneError(ctx)
+		}
+
+		lifecycle, known := statusLifecycle[current.Status]
+		if !known {
+			return nil, c.protocolError(fmt.Sprintf("request %s reported status %q, which is not one of the twelve contract status values", requestID, current.Status))
+		}
+		if lifecycle.terminal {
+			if lifecycle.successful {
+				return current, nil
+			}
+			return current, &RequestFailedError{
+				RequestID: requestID,
+				Status:    current.Status,
+				Details:   current.Details,
+			}
+		}
+
+		timer := time.NewTimer(interval)
+		select {
+		case <-pollCtx.Done():
+			timer.Stop()
+			return nil, c.pollingDoneError(ctx)
+		case <-timer.C:
+		}
+	}
+}
+
+func (c *Client) pollingDoneError(ctx context.Context) error {
+	if ctxErr := ctx.Err(); ctxErr != nil {
+		return fmt.Errorf("vcf automation: polling context ended: %w", ctxErr)
+	}
+	return fmt.Errorf("vcf automation: polling deadline elapsed: %w", ErrPollTimeout)
+}
+
+func (c *Client) getRequest(ctx context.Context, requestID string) (*Request, error) {
+	path := "/deployment/api/requests/" + url.PathEscape(requestID)
+
+	var current Request
+	if err := c.do(ctx, http.MethodGet, path, nil, &current); err != nil {
+		return nil, err
+	}
+	return &current, nil
+}
+
+// do issues one contract request. A nil body produces a strictly bodyless
+// request: no Content-Type, no content length and no transfer encoding.
+func (c *Client) do(ctx context.Context, method, path string, body []byte, out any) error {
+	var reader io.Reader
+	if body != nil {
+		reader = bytes.NewReader(body)
+	}
+
+	req, err := http.NewRequestWithContext(ctx, method, c.baseURL+path, reader)
+	if err != nil {
+		return errors.New("vcf automation: could not build the HTTP request")
+	}
+	req.Header.Set("Authorization", "Bearer "+c.accessToken)
+	req.Header.Set("Accept", "application/json")
+	if body != nil {
+		req.Header.Set("Content-Type", "application/json")
+		req.ContentLength = int64(len(body))
+	}
+
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		if ctxErr := ctx.Err(); ctxErr != nil {
+			return fmt.Errorf("vcf automation: HTTP request context ended: %w", ctxErr)
+		}
+		return errors.New("vcf automation: HTTP request failed")
+	}
+	defer func() {
+		_, _ = io.Copy(io.Discard, resp.Body)
+		_ = resp.Body.Close()
+	}()
+
+	payload, err := io.ReadAll(resp.Body)
+	if err != nil {
+		if ctxErr := ctx.Err(); ctxErr != nil {
+			return fmt.Errorf("vcf automation: response read context ended: %w", ctxErr)
+		}
+		return errors.New("vcf automation: could not read the HTTP response")
+	}
+
+	if resp.StatusCode != http.StatusOK {
+		return decodeAPIError(resp.StatusCode, payload)
+	}
+
+	if media := mediaType(resp.Header.Get("Content-Type")); media != "" && media != "application/json" {
+		return c.protocolError(fmt.Sprintf("%s %s returned media type %q, want application/json", method, path, media))
+	}
+	if err := json.Unmarshal(payload, out); err != nil {
+		return c.protocolError(fmt.Sprintf("%s %s returned a body that is not the documented JSON shape: %v", method, path, err))
+	}
+	if err := validateSuccessBody(payload, out); err != nil {
+		return c.protocolError(fmt.Sprintf("%s %s returned a contract-violating body: %v", method, path, err))
+	}
+	return nil
+}
+
+func validateSuccessBody(payload []byte, out any) error {
+	switch out.(type) {
+	case *[]Action:
+		if bytes.Equal(bytes.TrimSpace(payload), []byte("null")) {
+			return errors.New("the action collection is null rather than an array")
+		}
+	case *Request:
+		var members map[string]json.RawMessage
+		if err := json.Unmarshal(payload, &members); err != nil || members == nil {
+			return errors.New("the request is not a JSON object")
+		}
+		for _, name := range []string{"completedTasks", "createdAt", "name", "requestedBy", "totalTasks"} {
+			value, ok := members[name]
+			if !ok || bytes.Equal(bytes.TrimSpace(value), []byte("null")) {
+				return fmt.Errorf("required member %q is absent or null", name)
+			}
+		}
+	}
+	return nil
+}
+
+func decodeAPIError(status int, payload []byte) error {
+	apiErr := &APIError{StatusCode: status}
+	var decoded struct {
+		ErrorCode string `json:"errorCode"`
+		Message   string `json:"message"`
+	}
+	if err := json.Unmarshal(payload, &decoded); err == nil {
+		apiErr.ErrorCode = decoded.ErrorCode
+		apiErr.Message = decoded.Message
+	}
+	if apiErr.Message == "" {
+		apiErr.Message = http.StatusText(status)
+	}
+	return apiErr
+}
+
+func mediaType(header string) string {
+	if header == "" {
+		return ""
+	}
+	media, _, err := mime.ParseMediaType(header)
+	if err != nil {
+		return header
+	}
+	return media
 }

+
+// resolveActionID reads the deployment's available actions and returns the id
+// of the one named actionName.
+func (c *Client) resolveActionID(ctx context.Context, deploymentID, actionName string) (string, error) {
+	path := "/deployment/api/deployments/" + url.PathEscape(deploymentID) + "/actions"
+
+	var actions []Action
+	if err := c.do(ctx, http.MethodGet, path, nil, &actions); err != nil {
+		return "", err
+	}
+	for _, candidate := range actions {
+		if candidate.Name != actionName {
+			continue
+		}
+		if !candidate.Valid {
+			return "", c.protocolError(fmt.Sprintf("deployment action %q is not currently valid for deployment %s", actionName, deploymentID))
+		}
+		if strings.TrimSpace(candidate.ID) == "" {
+			return "", c.protocolError(fmt.Sprintf("deployment action %q carries no id", actionName))
+		}
+		return candidate.ID, nil
+	}
+	return "", c.protocolError(fmt.Sprintf("deployment %s exposes no action named %q", deploymentID, actionName))
+}
+
+// resourceActionRequest is the contract's ResourceActionRequest body. Every
+// member is optional; a nil pointer is omitted from the encoding entirely
+// rather than serialised as an empty or null placeholder.
+type resourceActionRequest struct {
+	ActionID string          `json:"actionId"`
+	Inputs   *map[string]any `json:"inputs,omitempty"`
+	Reason   *string         `json:"reason,omitempty"`
+}
+
+func (c *Client) submitActionRequest(ctx context.Context, deploymentID, actionID string, action ActionRequest) (*Request, error) {
+	payload := resourceActionRequest{ActionID: actionID, Reason: action.Reason}
+	if action.Inputs != nil {
+		inputs := action.Inputs
+		payload.Inputs = &inputs
+	}
+
+	body, err := json.Marshal(payload)
+	if err != nil {
+		return nil, c.protocolError("action request body cannot be encoded: " + err.Error())
+	}
+
+	path := "/deployment/api/deployments/" + url.PathEscape(deploymentID) + "/requests"
+
+	var submitted Request
+	if err := c.do(ctx, http.MethodPost, path, body, &submitted); err != nil {
+		return nil, err
+	}
+	if strings.TrimSpace(submitted.ID) == "" {
+		return nil, c.protocolError("the accepted deployment request carries no id, so it cannot be polled")
+	}
+	return &submitted, nil
+}

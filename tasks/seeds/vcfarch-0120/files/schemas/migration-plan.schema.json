{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:vcfarch:migration-plan:1.0",
  "title": "VCF brownfield migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "estateId", "targetRelease", "siteId", "model", "steps"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "targetRelease": {"type": "string", "minLength": 1},
    "siteId": {"type": "string", "minLength": 1},
    "model": {"const": "CONSOLIDATED"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "stepId", "componentId", "component", "currentVersion", "targetVersion", "action", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "stepId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "componentId": {"type": "string", "minLength": 1},
          "component": {"type": "string", "minLength": 1},
          "currentVersion": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "action": {"enum": ["UPGRADE", "CONVERGE"]},
          "gates": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    }
  }
}

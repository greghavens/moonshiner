+func Build(inventory Inventory, snapshot CompatibilitySnapshot) (Artifact, error) {
+	if inventory.EstateID == "" || inventory.Site.ID == "" || inventory.TargetRelease == "" {
+		return Artifact{}, errors.New("inventory identity, site, and target release are required")
+	}
+	if inventory.TargetRelease != snapshot.TargetRelease {
+		return Artifact{}, fmt.Errorf("inventory target %q does not match snapshot target %q", inventory.TargetRelease, snapshot.TargetRelease)

+	indexByID := make(map[string]int, len(inventory.Components))
+	for index, component := range inventory.Components {
+		if component.ID == "" || component.Name == "" || component.Version == "" {
+			return Artifact{}, errors.New("every inventory component needs an id, name, and version")
+		}
+		if _, exists := inventoryByID[component.ID]; exists {
+			return Artifact{}, fmt.Errorf("duplicate inventory component %q", component.ID)
+		}
+		inventoryByID[component.ID] = component
+		indexByID[component.ID] = index
+	}
+	rulesByID := make(map[string]ComponentRule, len(snapshot.Components))
+	for _, rule := range snapshot.Components {
+		if _, exists := rulesByID[rule.ID]; exists {
+			return Artifact{}, fmt.Errorf("duplicate compatibility rule %q", rule.ID)
+		}
+		rulesByID[rule.ID] = rule
+	}
+	if len(inventoryByID) != len(rulesByID) {
+		return Artifact{}, errors.New("inventory and compatibility snapshot component sets differ")
+	}
+	for id := range inventoryByID {
+		if _, exists := rulesByID[id]; !exists {
+			return Artifact{}, fmt.Errorf("component %q has no compatibility rule", id)
+		}
+	}
+	for _, pair := range snapshot.Interoperability {
+		left, leftExists := rulesByID[pair.LeftComponent]
+		right, rightExists := rulesByID[pair.RightComponent]
+		if !leftExists || !rightExists {
+			return Artifact{}, fmt.Errorf("interoperability pair references an unknown component: %q/%q", pair.LeftComponent, pair.RightComponent)
+		}
+		if left.TargetVersion != pair.LeftVersion || right.TargetVersion != pair.RightVersion {
+			return Artifact{}, fmt.Errorf("interoperability pair %q/%q is inconsistent with component targets", pair.LeftComponent, pair.RightComponent)

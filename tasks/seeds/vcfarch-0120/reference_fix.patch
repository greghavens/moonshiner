+
+func topologicalOrder(components []InventoryComponent, rules []PrecedenceRule, indexByID map[string]int) ([]string, map[string][]string, error) {
+	indegree := make(map[string]int, len(components))
+	successors := make(map[string][]string, len(components))
+	predecessors := make(map[string][]string, len(components))
+	for _, component := range components {
+		indegree[component.ID] = 0
+	}
+	seen := map[string]bool{}
+	for _, rule := range rules {
+		if _, ok := indegree[rule.Before]; !ok {
+			return nil, nil, fmt.Errorf("precedence rule references unknown component %q", rule.Before)
+		}
+		if _, ok := indegree[rule.After]; !ok {
+			return nil, nil, fmt.Errorf("precedence rule references unknown component %q", rule.After)
+		}
+		key := rule.Before + "\x00" + rule.After
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		successors[rule.Before] = append(successors[rule.Before], rule.After)
+		predecessors[rule.After] = append(predecessors[rule.After], rule.Before)
+		indegree[rule.After]++
+	}
+	lessByInventory := func(left, right string) bool { return indexByID[left] < indexByID[right] }
+	for id := range predecessors {
+		sort.Slice(predecessors[id], func(i, j int) bool { return lessByInventory(predecessors[id][i], predecessors[id][j]) })
+	}
+	ready := []string{}
+	for _, component := range components {
+		if indegree[component.ID] == 0 {
+			ready = append(ready, component.ID)
+		}
+	}
+	order := make([]string, 0, len(components))
+	for len(ready) > 0 {
+		sort.Slice(ready, func(i, j int) bool { return lessByInventory(ready[i], ready[j]) })
+		id := ready[0]
+		ready = ready[1:]
+		order = append(order, id)
+		for _, next := range successors[id] {
+			indegree[next]--
+			if indegree[next] == 0 {
+				ready = append(ready, next)
+			}
+		}
+	}
+	if len(order) != len(components) {
+		return nil, nil, errors.New("compatibility precedence graph contains a cycle")
+	}
+	return order, predecessors, nil
+}
+
+func shortestUpgradePath(from, target string, edges []UpgradeEdge) ([]UpgradeEdge, bool) {
+	adjacency := map[string][]UpgradeEdge{}
+	for _, edge := range edges {
+		if edge.From == "" || edge.To == "" || edge.Action == "" {
+			continue
+		}
+		adjacency[edge.From] = append(adjacency[edge.From], edge)
+	}
+	for version := range adjacency {
+		sort.Slice(adjacency[version], func(i, j int) bool {
+			if adjacency[version][i].To == adjacency[version][j].To {
+				return adjacency[version][i].Action < adjacency[version][j].Action
+			}
+			return adjacency[version][i].To < adjacency[version][j].To
+		})
+	}
+	type state struct {
+		version string
+		path    []UpgradeEdge
+	}
+	queue := []state{{version: from}}
+	visited := map[string]bool{from: true}
+	for len(queue) > 0 {
+		current := queue[0]
+		queue = queue[1:]
+		for _, edge := range adjacency[current.version] {
+			if visited[edge.To] {
+				continue
+			}
+			path := append(append([]UpgradeEdge(nil), current.path...), edge)
+			if edge.To == target {
+				return path, true
+			}
+			visited[edge.To] = true
+			queue = append(queue, state{version: edge.To, path: path})
+		}
+	}
+	return nil, false
 }

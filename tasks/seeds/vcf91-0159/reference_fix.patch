+                appendStringArray(body, request.podCidrs());
+                body.append('}');
+            }
+            if (servicesSet) {
+                if (podsSet) {
+                    body.append(',');
+                }
+                body.append("\"services\":{\"cidrBlocks\":");
+                appendStringArray(body, request.serviceCidrs());
+                body.append('}');

+                    .append(",\"replicas\":")
+                    .append(request.workerReplicas().intValue())
+                    .append("}]}");
+        }
+        body.append(",\"variables\":[");
+        for (int index = 0; index < request.topologyVariables().size(); index++) {
+            if (index > 0) {
+                body.append(',');

+            TopologyVariable variable = request.topologyVariables().get(index);
+            body.append("{\"name\":")
+                    .append(jsonString(variable.name()))
+                    .append(",\"value\":");
+            appendJsonValue(body, variable.value());
+            body.append('}');
+        }
+        body.append("]}");
+
+        boolean podsSet = !request.podCidrs().isEmpty();
+        boolean servicesSet = !request.serviceCidrs().isEmpty();
+        if (podsSet || servicesSet) {
+            body.append(",\"clusterNetwork\":{");
+            if (podsSet) {
+                body.append("\"pods\":{\"cidrBlocks\":");
+                appendStringArray(body, request.podCidrs());
+                body.append('}');
+            }
+            if (servicesSet) {
+                if (podsSet) {
+                    body.append(',');
+                }
+                body.append("\"services\":{\"cidrBlocks\":");
+                appendStringArray(body, request.serviceCidrs());
+                body.append('}');
+            }
+            body.append('}');
+        }
+        body.append("}}");
+        return body.toString().getBytes(StandardCharsets.UTF_8);
+    }
+
+    private static void appendStringArray(
+            StringBuilder output, List<String> values) {
+        output.append('[');
+        for (int index = 0; index < values.size(); index++) {
+            if (index > 0) {
+                output.append(',');
+            }
+            output.append(jsonString(values.get(index)));
+        }
+        output.append(']');
+    }
+
+    private static void appendJsonValue(StringBuilder output, Object value) {
+        if (value instanceof String text) {
+            output.append(jsonString(text));
+        } else if (value instanceof Boolean || value instanceof Number) {
+            output.append(value);
+        } else if (value instanceof List<?> list) {
+            output.append('[');
+            for (int index = 0; index < list.size(); index++) {
+                if (index > 0) {
+                    output.append(',');
+                }
+                appendJsonValue(output, list.get(index));
+            }
+            output.append(']');
+        } else if (value instanceof Map<?, ?> map) {
+            output.append('{');
+            int index = 0;
+            for (Map.Entry<?, ?> entry : map.entrySet()) {
+                if (index++ > 0) {
+                    output.append(',');
+                }
+                output.append(jsonString((String) entry.getKey())).append(':');
+                appendJsonValue(output, entry.getValue());
+            }
+            output.append('}');
+        } else {
+            throw new IllegalArgumentException(
+                    "topology variable values must be JSON-compatible");
+        }
     }
 

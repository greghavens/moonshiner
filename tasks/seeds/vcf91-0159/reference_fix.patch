+    }
+
+    private static void appendStringArray(
+            StringBuilder output, List<String> values) {
+        output.append('[');
+        for (int index = 0; index < values.size(); index++) {
+            if (index > 0) {
+                output.append(',');
+            }
+            output.append(jsonString(values.get(index)));
+        }
+        output.append(']');
     }
 

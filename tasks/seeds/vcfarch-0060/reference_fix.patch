+        for (int i = 0; i < phases.size(); i++) {
+            phaseIndex.put(string(phases.get(i), "phase"), i);
+        }
+
+        List<Map<String, Object>> components = new ArrayList<>();
+        for (Object value : array(inventory.get("components"), "components")) {
+            components.add(object(value, "component"));
+        }
+        components.sort(Comparator.comparingInt(component -> {
+            Integer index = phaseIndex.get(string(component.get("product"), "component product"));
+            if (index == null) {
+                throw new IllegalArgumentException("No migration phase for " + component.get("product"));
+            }
+            return index;
+        }));
+
+        Map<String, Object> upgradePaths = object(snapshot.get("upgradePaths"), "upgradePaths");
+        Map<String, List<String>> completedByPhase = new LinkedHashMap<>();
+        List<Object> steps = new ArrayList<>();
+        for (int i = 0; i < components.size(); i++) {
+            Map<String, Object> component = components.get(i);
+            String product = string(component.get("product"), "component product");
+            String version = string(component.get("version"), "component version");
+            String componentId = string(component.get("id"), "component id");
+            Map<String, Object> upgrade = object(upgradePaths.get(product + "@" + version),
+                    "upgrade path for " + componentId);
+            String stepId = String.format("step-%02d", i + 1);
+            int index = phaseIndex.get(product);
+            List<String> gates = index == 0
+                    ? List.of()
+                    : List.copyOf(completedByPhase.getOrDefault(string(phases.get(index - 1), "phase"),
+                            List.of()));
+
+            Map<String, Object> step = new LinkedHashMap<>();
+            step.put("stepId", stepId);
+            step.put("order", i + 1);
+            step.put("componentId", componentId);
+            step.put("currentProduct", product);
+            step.put("currentVersion", version);
+            step.put("targetProduct", upgrade.get("targetProduct"));
+            step.put("targetVersion", upgrade.get("targetVersion"));
+            step.put("action", upgrade.get("action"));
+            step.put("phase", product);
+            step.put("gatedBy", gates);
+            steps.add(step);
+            completedByPhase.computeIfAbsent(product, ignored -> new ArrayList<>()).add(stepId);
+        }
+
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("schemaVersion", "1.0");
+        result.put("estateId", inventory.get("estateId"));
+        result.put("targetVcfVersion", snapshot.get("targetVcfVersion"));
+        result.put("compatibilitySnapshotId", snapshot.get("snapshotId"));
+        result.put("steps", steps);
+        return Json.stringify(result);
     }
 

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned VCF estate migration plan",
  "type": "object",
  "required": ["schemaVersion", "estateId", "targetVcfVersion", "compatibilitySnapshotId", "steps"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "targetVcfVersion": {"type": "string", "minLength": 1},
    "compatibilitySnapshotId": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stepId", "order", "componentId", "currentProduct", "currentVersion", "targetProduct", "targetVersion", "action", "phase", "gatedBy"],
        "properties": {
          "stepId": {"type": "string", "pattern": "^step-[0-9]{2}$"},
          "order": {"type": "integer", "minimum": 1},
          "componentId": {"type": "string", "minLength": 1},
          "currentProduct": {"type": "string", "minLength": 1},
          "currentVersion": {"type": "string", "minLength": 1},
          "targetProduct": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "action": {"enum": ["UPGRADE", "VCF_MANAGED_UPGRADE", "FRESH_INSTALL", "REPLACE"]},
          "phase": {"enum": ["VCF_OPERATIONS", "SDDC_MANAGER", "NSX", "VCENTER", "VSAN_WITNESS", "ESXI"]},
          "gatedBy": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^step-[0-9]{2}$"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "contract_version": 1,
  "service": "VMware Cloud Foundation Operations API",
  "api_version": "9.1.0.0",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "spec_path": "specifications/vcf-operations/vcf-operations-openapi.json",
    "license": "Apache-2.0",
    "derivation": "focused operation and schema subset extracted from the OpenAPI 3.0.1 document itself; the official VCF Operations 9.1 authentication overview supplies only the OpsToken value prefix that an OpenAPI apiKey scheme cannot express",
    "credential_value_source": "https://developer.broadcom.com/xapis/vcf-operations-api/latest/"
  },
  "basePath": "/suite-api",
  "security": {
    "scheme": "Token-based-authorization",
    "type": "apiKey",
    "in": "header",
    "name": "Authorization",
    "value_template": "OpsToken {token}",
    "token_source": {
      "operationId": "acquireToken",
      "response_property": "token"
    }
  },
  "encoding": {
    "query_value": "RFC 3986 percent-encoding; only A-Z a-z 0-9 - . _ ~ are literal; space is %20",
    "array_query_style": "form",
    "array_query_explode": true,
    "charset": "UTF-8"
  },
  "operations": [
    {
      "operationId": "acquireToken",
      "method": "POST",
      "path": "/api/auth/token/acquire",
      "security": [],
      "summary": "Acquire a token to perform REST API calls",
      "request": {
        "mediaType": "application/json",
        "schema": "username-password",
        "required": [
          "username",
          "password"
        ],
        "optional": [
          "authSource"
        ],
        "bodyPropertyOrder": [
          "username",
          "password",
          "authSource"
        ]
      },
      "response": {
        "status": 200,
        "mediaType": "application/json",
        "schema": "auth-token",
        "required": [
          "token",
          "validity"
        ]
      }
    },
    {
      "operationId": "getResources",
      "method": "GET",
      "path": "/api/resources",
      "summary": "Get a listing of resources based on the query spec specified",
      "request": {
        "body": null,
        "mediaType": null
      },
      "queryParameters": [
        {
          "name": "name",
          "in": "query",
          "required": false,
          "type": "array",
          "items": "string"
        },
        {
          "name": "adapterKind",
          "in": "query",
          "required": false,
          "type": "array",
          "items": "string"
        },
        {
          "name": "resourceKind",
          "in": "query",
          "required": false,
          "type": "array",
          "items": "string"
        },
        {
          "name": "page",
          "in": "query",
          "required": false,
          "type": "integer",
          "format": "int32",
          "default": 0
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "type": "integer",
          "format": "int32",
          "default": 1000
        }
      ],
      "queryParameterOrder": [
        "name",
        "adapterKind",
        "resourceKind",
        "page",
        "pageSize"
      ],
      "unusedOptionalQueryParameters": [
        "regex",
        "collectorName",
        "collectorId",
        "maintenanceScheduleId",
        "adapterInstanceId",
        "recentlyAdded",
        "resourceState",
        "resourceStatus",
        "resourceHealth",
        "parentId",
        "credentialId",
        "resourceId",
        "propertyName",
        "propertyValue",
        "statKey",
        "statKeyLowerBound",
        "statKeyUpperBound",
        "statKeyInclusive",
        "includeRelated"
      ],
      "response": {
        "status": 200,
        "mediaType": "application/json",
        "schema": "resources",
        "pagination": {
          "pageParameter": "page",
          "pageSizeParameter": "pageSize",
          "firstPage": 0,
          "pageInfoProperty": "pageInfo",
          "totalCountProperty": "totalCount",
          "itemsProperty": "resourceList"
        },
        "itemProjection": {
          "identifier": "identifier",
          "name": "resourceKey.name",
          "adapterKindKey": "resourceKey.adapterKindKey",
          "resourceKindKey": "resourceKey.resourceKindKey",
          "resourceHealth": "resourceHealth"
        }
      }
    }
  ]
}

 // Build creates the deterministic architecture artifact from the supplied
 // scenario and pinned compatibility authority.
 func Build(scenarioPath, snapshotPath string) (Artifact, error) {
-	return Artifact{}, fmt.Errorf("architecture.Build is not implemented")
+	var scenario Scenario
+	if err := readJSON(scenarioPath, &scenario); err != nil {
+		return Artifact{}, err
+	}
+	var snapshot CompatibilitySnapshot
+	if err := readJSON(snapshotPath, &snapshot); err != nil {
+		return Artifact{}, err
+	}
+	if scenario.TargetRelease != snapshot.TargetRelease || scenario.TargetRelease != scenario.Entitlement.EligibleTargetRelease {
+		return Artifact{}, fmt.Errorf("target release is not covered by the fixture entitlement and snapshot")
+	}
+
+	dataSites, witnessSites := sitesByRole(scenario.Sites)
+	var selected *SupportedTopology
+	var excluded []ExcludedTopology
+	for i := range snapshot.Topologies {
+		topology := &snapshot.Topologies[i]
+		if !technicallyFits(*topology, scenario, dataSites, witnessSites) {
+			continue
+		}
+		if topology.VCFInstances > scenario.Entitlement.MaxVCFInstances {
+			excluded = append(excluded, ExcludedTopology{
+				ID: topology.ID, ReasonCode: "ENTITLEMENT_MAX_VCF_INSTANCES", ConstraintID: scenario.Entitlement.ConstraintID,
+			})
+			continue
+		}
+		if topology.RequiresVSANStretchEntitlement && !scenario.Entitlement.VSANStretchedClusters {
+			continue
+		}
+		if len(scenario.Hosts) > scenario.Entitlement.MaxLicensedHosts {
+			continue
+		}
+		if selected == nil || topology.VCFInstances < selected.VCFInstances {
+			selected = topology
+		}
+	}
+	if selected == nil {
+		return Artifact{}, fmt.Errorf("no supported topology satisfies the scenario and entitlement")
+	}
+	sort.Slice(excluded, func(i, j int) bool { return excluded[i].ID < excluded[j].ID })
+
+	placement := make(map[string][]string, len(dataSites))
+	minCores, minMemory := int(^uint(0)>>1), int(^uint(0)>>1)
+	for _, site := range dataSites {
+		cores, memory := 0, 0
+		for _, host := range scenario.Hosts {
+			if host.Site == site {
+				placement[site] = append(placement[site], host.Hostname)
+				cores += host.Cores
+				memory += host.MemoryGiB
+			}
+		}
+		sort.Strings(placement[site])
+		if cores < minCores {
+			minCores = cores
+		}
+		if memory < minMemory {
+			minMemory = memory
+		}
+	}
+
+	sddcSpec, err := makeSddcSpec(scenario, snapshot.InstallerProfile)
+	if err != nil {
+		return Artifact{}, err
+	}
+	migration, err := makeMigration(scenario, snapshot)
+	if err != nil {
+		return Artifact{}, err
+	}
+
+	var dayNHosts []string
+	for _, site := range dataSites {
+		if site != scenario.InstallerInputs.InitialSite {
+			dayNHosts = append(dayNHosts, placement[site]...)
+		}
+	}
+	sort.Strings(dayNHosts)
+	witnessHost := ""
+	for _, site := range scenario.Sites {
+		if site.Role == "witness" {
+			witnessHost = site.WitnessHost
+		}
+	}
+
+	return Artifact{
+		SchemaVersion:      "1.0",
+		ScenarioID:         scenario.ScenarioID,
+		ExcludedTopologies: excluded,
+		SelectedTopology: TopologyDecision{
+			ID: selected.ID, VCFInstances: selected.VCFInstances, ManagementDomains: selected.ManagementDomains,
+			DataSites: dataSites, WitnessSite: witnessSites[0], HostPlacement: placement,
+			CapacityAfterSiteLoss: Capacity{PhysicalCores: minCores, MemoryGiB: minMemory, UsableStorageTiB: selected.UsableStorageTiB},
+		},
+		SddcSpec:      sddcSpec,
+		DayN:          DayNPlan{Action: "stretch-management-domain", AddHosts: dayNHosts, WitnessHost: witnessHost},
+		MigrationPlan: migration,
+	}, nil
+}
+
+func readJSON(path string, dst any) error {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return fmt.Errorf("read %s: %w", path, err)
+	}
+	if err := json.Unmarshal(b, dst); err != nil {
+		return fmt.Errorf("decode %s: %w", path, err)
+	}
+	return nil
+}
+
+func sitesByRole(sites []Site) (data, witness []string) {
+	for _, site := range sites {
+		switch site.Role {
+		case "data":
+			data = append(data, site.ID)
+		case "witness":
+			witness = append(witness, site.ID)
+		}
+	}
+	return data, witness
+}
+
+func technicallyFits(topology SupportedTopology, scenario Scenario, dataSites, witnessSites []string) bool {
+	if len(dataSites) != topology.DataSites || len(witnessSites) < topology.WitnessSites ||
+		topology.SurvivesCompleteDataSiteLoss != scenario.AvailabilityRequirements.SurviveCompleteDataSiteLoss ||
+		topology.RPOMinutes > scenario.AvailabilityRequirements.MaxRPOMinutes ||
+		topology.ManagementRecoveryMinutes > scenario.AvailabilityRequirements.MaxManagementRecoveryMinutes ||
+		topology.UsableStorageTiB < scenario.CapacityRequirements.UsableStorageTiB {
+		return false
+	}
+	minCores, minMemory := int(^uint(0)>>1), int(^uint(0)>>1)
+	for _, site := range dataSites {
+		hosts, cores, memory := 0, 0, 0
+		for _, host := range scenario.Hosts {
+			if host.Site == site {
+				hosts++
+				cores += host.Cores
+				memory += host.MemoryGiB
+			}
+		}
+		if hosts < topology.MinHostsPerDataSite {
+			return false
+		}
+		if cores < minCores {
+			minCores = cores
+		}
+		if memory < minMemory {
+			minMemory = memory
+		}
+	}
+	if minCores < scenario.CapacityRequirements.PhysicalCores || minMemory < scenario.CapacityRequirements.MemoryGiB {
+		return false
+	}
+	for _, link := range scenario.Links {
+		fromData, toData := containsString(dataSites, link.From), containsString(dataSites, link.To)
+		if fromData && toData && link.RTTMillis > topology.MaxDataSiteRTTMillis {
+			return false
+		}
+		if topology.WitnessSites > 0 && (containsString(witnessSites, link.From) || containsString(witnessSites, link.To)) && link.RTTMillis > topology.MaxWitnessRTTMillis {
+			return false
+		}
+	}
+	return true
+}
+
+func makeSddcSpec(scenario Scenario, profile InstallerProfile) (json.RawMessage, error) {
+	input := scenario.InstallerInputs
+	var hosts []any
+	for _, host := range scenario.Hosts {
+		if host.Site == input.InitialSite {
+			hosts = append(hosts, map[string]any{"hostname": host.Hostname})
+		}
+	}
+	if len(hosts) != profile.InitialHostCount {
+		return nil, fmt.Errorf("initial site has %d hosts, want %d", len(hosts), profile.InitialHostCount)
+	}
+
+	var networks []any
+	var networkTypes []string
+	for _, network := range input.Networks {
+		ranges := make([]any, len(network.IPRanges))
+		for i, r := range network.IPRanges {
+			ranges[i] = map[string]any{"startIpAddress": r.Start, "endIpAddress": r.End}
+		}
+		networks = append(networks, map[string]any{
+			"networkType": network.Type, "vlanId": network.VLAN, "subnet": network.CIDR,
+			"gateway": network.Gateway, "subnetMask": network.SubnetMask, "mtu": network.MTU,
+			"includeIpAddressRanges": ranges, "ipAddressVersion": "IPv4", "ipAddressAssignmentMode": "STATIC",
+		})
+		networkTypes = append(networkTypes, network.Type)
+	}
+
+	nsxManagers := make([]any, len(input.NSXManagerHostnames))
+	for i, hostname := range input.NSXManagerHostnames {
+		nsxManagers[i] = map[string]any{"hostname": hostname}
+	}
+	operationsNodes := make([]any, profile.VCFOperationsNodeCount)
+	for i := range operationsNodes {
+		operationsNodes[i] = map[string]any{
+			"hostname": fmt.Sprintf("ops%02d.%s", i+1, input.Subdomain),
+			"type":     []string{"master", "replica", "data"}[i],
+		}
+	}
+
+	service := func() map[string]any { return map[string]any{"version": scenario.TargetRelease, "size": "small"} }
+	spec := map[string]any{
+		"sddcId": input.SddcID, "workflowType": profile.WorkflowType, "version": scenario.TargetRelease,
+		"vcfInstanceName": input.VCFInstanceName, "hostSpecs": hosts,
+		"vcenterSpec": map[string]any{
+			"vcenterHostname": input.VCenterHostname, "rootVcenterPassword": "${VC_ROOT_PASS}",
+			"vmSize": "medium", "storageSize": "lstorage", "ssoDomain": "vsphere.local", "useExistingDeployment": false,
+		},
+		"clusterSpec": map[string]any{
+			"datacenterName": input.DatacenterName, "clusterName": input.ClusterName, "clusterEvcMode": "INTEL_SAPPHIRERAPIDS",
+		},
+		"dvsSpecs": []any{map[string]any{
+			"dvsName": "vds-mgmt", "networks": networkTypes, "mtu": 9000,
+			"vmnicsToUplinks": []any{
+				map[string]any{"id": "vmnic0", "uplink": "uplink1"},
+				map[string]any{"id": "vmnic1", "uplink": "uplink2"},
+			},
+		}},
+		"nsxtSpec": map[string]any{
+			"nsxtManagers": nsxManagers, "nsxtManagerSize": "medium", "vipFqdn": input.NSXVIPFQDN,
+			"transportVlanId": networkVLAN(input.Networks, "VM_MANAGEMENT"), "useExistingDeployment": false,
+		},
+		"networkSpecs":       networks,
+		"dnsSpec":            map[string]any{"subdomain": input.Subdomain, "nameservers": input.NameServers},
+		"ntpServers":         input.NTPServers,
+		"sddcManagerSpec":    map[string]any{"hostname": input.SDDCManagerHostname, "useExistingDeployment": false},
+		"managementPoolName": input.ManagementPoolName,
+		"ceipEnabled":        false, "skipEsxThumbprintValidation": false, "skipGatewayPingValidation": false,
+		"securitySpec": map[string]any{"esxiCertsMode": "VMCA"},
+		"datastoreSpec": map[string]any{"vsanSpec": map[string]any{
+			"datastoreName": "vsan-mgmt", "esaConfig": map[string]any{"enabled": true}, "failuresToTolerate": profile.VSANFailuresToTolerate,
+		}},
+		"vspClusterSpec": map[string]any{
+			"platformFqdn": input.VSPPlatformFQDN, "instanceFqdn": input.VSPInstanceFQDN, "fleetFqdn": input.VSPFleetFQDN,
+			"ipv4Pool": map[string]any{"addresses": input.ManagementServiceIPs}, "size": "small", "version": scenario.TargetRelease,
+		},
+		"fleetLcmSpec": service(), "sddcLcmSpec": service(), "fleetDepotSpec": service(), "telemetryAcceptorSpec": service(),
+		"saltSpec": service(), "saltRaasSpec": service(),
+		"vcfOperationsSpec": map[string]any{
+			"nodes": operationsNodes, "applianceSize": "medium", "useExistingDeployment": false, "version": scenario.TargetRelease,
+		},
+		"licenseServerSpec": map[string]any{"hostname": input.LicenseServerHostname, "version": scenario.TargetRelease, "useExistingDeployment": false},
+	}
+	b, err := json.Marshal(spec)
+	return json.RawMessage(b), err
+}
+
+func makeMigration(scenario Scenario, snapshot CompatibilitySnapshot) (MigrationPlan, error) {
+	inventory := make(map[string]ExistingComponent, len(scenario.ExistingEstate.Components))
+	for _, component := range scenario.ExistingEstate.Components {
+		inventory[component.ID] = component
+	}
+	steps := make([]MigrationStep, len(snapshot.Migration.Steps))
+	for i, pinned := range snapshot.Migration.Steps {
+		component, ok := inventory[pinned.ComponentID]
+		if !ok {
+			return MigrationPlan{}, fmt.Errorf("migration component %s is absent from inventory", pinned.ComponentID)
+		}
+		steps[i] = MigrationStep{
+			Order: pinned.Order, ComponentID: component.ID, ComponentName: component.Name,
+			FromVersion: component.Version, Action: pinned.Action, TargetVersion: pinned.TargetVersion,
+			Gates: append([]string(nil), pinned.Gates...),
+		}
+	}
+	if len(steps) != len(inventory) {
+		return MigrationPlan{}, fmt.Errorf("migration snapshot and inventory component counts differ")
+	}
+	return MigrationPlan{SchemaVersion: "1.0", EstateID: scenario.ExistingEstate.EstateID, TargetVCFVersion: snapshot.Migration.TargetVCFVersion, Steps: steps}, nil
+}
+
+func networkVLAN(networks []Network, networkType string) int {
+	for _, network := range networks {
+		if network.Type == networkType {
+			return network.VLAN
+		}
+	}
+	return 0
+}
+
+func containsString(values []string, wanted string) bool {
+	for _, value := range values {
+		if value == wanted {
+			return true
+		}
+	}
+	return false
 }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch:migration-plan:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "estateId", "targetVcfVersion", "steps"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "targetVcfVersion": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "componentId", "componentName", "fromVersion", "action", "targetVersion", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "componentId": {"type": "string", "minLength": 1},
          "componentName": {"type": "string", "minLength": 1},
          "fromVersion": {"type": "string", "minLength": 1},
          "action": {"enum": ["install", "upgrade"]},
          "targetVersion": {"type": "string", "minLength": 1},
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}

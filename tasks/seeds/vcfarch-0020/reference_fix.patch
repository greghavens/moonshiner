+"""Command-line entry point for the architecture builder."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from .builder import build_bundle
+
+
+def read_json(path: Path) -> dict:
+    with path.open("r", encoding="utf-8") as handle:
+        value = json.load(handle)
+    if not isinstance(value, dict):
+        raise ValueError(f"{path} must contain a JSON object")
+    return value
+
+
+def write_json(path: Path, value: dict) -> None:
+    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description="Build the Northstar VCF architecture bundle")
+    parser.add_argument("--requirements", type=Path, required=True)
+    parser.add_argument("--estate", type=Path, required=True)
+    parser.add_argument("--compatibility", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+
+    bundle = build_bundle(
+        read_json(args.requirements),
+        read_json(args.estate),
+        read_json(args.compatibility),
+    )
+    args.output.mkdir(parents=True, exist_ok=True)
+    for name, value in bundle.items():
+        write_json(args.output / name, value)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

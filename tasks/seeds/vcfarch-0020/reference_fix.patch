+++ b/architecture/research-consulted.json
@@ -0,0 +1,40 @@
+{
+  "sources": [
+    {
+      "accessed_on": "2026-08-14",
+      "fact_used": "Broadcom's compatibility guide points VCF software-version checks to the Product Interoperability Matrix; the live matrix was consulted before using the pinned snapshot as the artifact authority.",
+      "title": "Broadcom VMware Compatibility Guide - Software",
+      "url": "https://compatibilityguide.broadcom.com/search?program=software"
+    },
+    {
+      "accessed_on": "2026-08-14",
+      "fact_used": "VCF exposes compatibility-matrix content and metadata as a published API family, confirming that component combinations are matrix-governed rather than independently selected.",
+      "title": "Compatibility Matrix APIs - VMware Cloud Foundation API",
+      "url": "https://developer.broadcom.com/xapis/vmware-cloud-foundation-api/latest/compatibility-matrix/"
+    },
+    {
+      "accessed_on": "2026-08-14",
+      "fact_used": "For a 9.0.x VCF estate, VCF Operations is upgraded first; 9.1 absorbs Identity Broker into Management Services and retires the Fleet Management Appliance only after the environment reaches 9.1.",
+      "title": "Upgrade Sequence and Related Issues for VMware Cloud Foundation and vSphere Foundation 9.1",
+      "url": "https://knowledge.broadcom.com/external/article/440630/upgrade-sequence-and-related-issues-for.html"
+    },
+    {
+      "accessed_on": "2026-08-14",
+      "fact_used": "VCF Operations for Networks platform and collector certificates must carry both FQDN and IP SANs before the 9.1 Fleet Lifecycle transition; the 9.0 Fleet Management Appliance has no direct upgrade path.",
+      "title": "VCF Operations for Networks certificate requirements for VCF 9.1",
+      "url": "https://knowledge.broadcom.com/external/article/424807"
+    },
+    {
+      "accessed_on": "2026-08-14",
+      "fact_used": "The VCF 9.1 SddcSpec version strings must match the active component BOM, including the published 9.1 NSX, vCenter, and SDDC Manager builds represented in the pinned authority.",
+      "title": "Could not retrieve binary for component during Deploy and Validate in VCF 9.1",
+      "url": "https://knowledge.broadcom.com/external/article/436258/could-not-retrieve-binary-for-component.html"
+    },
+    {
+      "accessed_on": "2026-08-14",
+      "fact_used": "ESX 9.0.2.0 build 25148076 and ESX 9.1.0.0 build 25370933 are published releases, supporting the inventory-to-target host transition in the plan.",
+      "title": "Build numbers and versions of VMware ESXi/ESX",
+      "url": "https://knowledge.broadcom.com/external/article/316595/build-numbers-and-versions-of-vmware-esx.html"
+    }
+  ]
+}

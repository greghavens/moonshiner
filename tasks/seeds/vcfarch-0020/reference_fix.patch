+"""Build the greenfield SddcSpec, topology, and brownfield migration plan."""
+
+from __future__ import annotations
+
+from copy import deepcopy
+from typing import Any
+
+
+def _secret(name: str) -> str:
+    return "${" + name + "}"
+
+
+def _build_sddc(requirements: dict[str, Any], compatibility: dict[str, Any]) -> dict[str, Any]:
+    domain = requirements["domain"]
+    appliances = requirements["appliances"]
+    versions = compatibility["greenfield"]["sddc_spec_version_fields"]
+    hosts = [hostname for site in requirements["data_sites"] for hostname in site["hosts"]]
+    networks = deepcopy(requirements["networks"])
+    for network in networks:
+        network["ipAddressAssignmentMode"] = "STATIC"
+        network["ipAddressVersion"] = "IPv4"
+
+    return {
+        "sddcId": domain["sddc_id"],
+        "workflowType": "VCF",
+        "version": versions["version"],
+        "vcfInstanceName": domain["vcf_instance_name"],
+        "hostSpecs": [
+            {
+                "hostname": hostname,
+                "credentials": {
+                    "username": "root",
+                    "password": _secret("ESX_ROOT_PASSWORD"),
+                },
+            }
+            for hostname in hosts
+        ],
+        "vcenterSpec": {
+            "vcenterHostname": appliances["vcenter"],
+            "rootVcenterPassword": _secret("VC_ROOT_PASS"),
+            "ssoDomain": "vsphere.local",
+            "adminUserSsoUsername": "administrator@vsphere.local",
+            "adminUserSsoPassword": _secret("VCENTER_SSO_PASSWORD"),
+            "vmSize": "large",
+            "storageSize": "large",
+            "version": versions["vcenterSpec.version"],
+            "useExistingDeployment": False,
+        },
+        "clusterSpec": {
+            "datacenterName": domain["datacenter_name"],
+            "clusterName": domain["cluster_name"],
+        },
+        "dvsSpecs": [
+            {
+                "dvsName": "vds-mgmt-stretched-01",
+                "mtu": 9000,
+                "networks": [network["networkType"] for network in networks],
+                "vmnicsToUplinks": [
+                    {"id": "vmnic0", "uplink": "uplink1"},
+                    {"id": "vmnic1", "uplink": "uplink2"},
+                ],
+                "nsxtSwitchConfig": {
+                    "hostSwitchOperationalMode": "STANDARD",
+                    "ipAssignmentType": "STATIC",
+                    "transportZones": [
+                        {"name": "tz-overlay", "transportType": "OVERLAY"},
+                        {"name": "tz-vlan", "transportType": "VLAN"},
+                    ],
+                },
+            }
+        ],
+        "nsxtSpec": {
+            "nsxtManagers": [{"hostname": hostname} for hostname in appliances["nsx_managers"]],
+            "nsxtManagerSize": "medium",
+            "vipFqdn": appliances["nsx_vip"],
+            "rootNsxtManagerPassword": _secret("NSX_ROOT_PASSWORD"),
+            "nsxtAdminPassword": _secret("NSX_ADMIN_PASSWORD"),
+            "nsxtAuditPassword": _secret("NSX_AUDIT_PASSWORD"),
+            "transportVlanId": 1830,
+            "ipAddressPoolSpec": {
+                "name": "mgmt-host-tep-pool",
+                "description": "Static TEP addresses for both management-domain data sites",
+                "subnets": [
+                    {
+                        "cidr": "10.80.30.0/24",
+                        "gateway": "10.80.30.1",
+                        "ipAddressPoolRanges": [
+                            {"start": "10.80.30.51", "end": "10.80.30.70"}
+                        ],
+                    }
+                ],
+            },
+            "version": versions["nsxtSpec.version"],
+            "useExistingDeployment": False,
+        },
+        "networkSpecs": networks,
+        "dnsSpec": deepcopy(requirements["dns"]),
+        "ntpServers": list(requirements["ntp_servers"]),
+        "sddcManagerSpec": {
+            "hostname": appliances["sddc_manager"],
+            "rootPassword": _secret("SDDC_MANAGER_ROOT_PASSWORD"),
+            "sshPassword": _secret("SDDC_MANAGER_SSH_PASSWORD"),
+            "localUserPassword": _secret("SDDC_MANAGER_LOCAL_PASSWORD"),
+            "version": versions["sddcManagerSpec.version"],
+            "useExistingDeployment": False,
+        },
+        "managementPoolName": "mgmt-pool",
+        "ceipEnabled": False,
+        "skipEsxThumbprintValidation": False,
+        "skipGatewayPingValidation": False,
+        "securitySpec": {"esxiCertsMode": "VMCA"},
+        "datastoreSpec": {
+            "vsanSpec": {
+                "datastoreName": "vsan-mgmt-stretched-01",
+                "failuresToTolerate": requirements["availability"]["failures_to_tolerate"],
+                "vsanDedup": False,
+                "esaConfig": {"enabled": True},
+                "encryptionConfig": {
+                    "dataInTransitConfig": {
+                        "enable": True,
+                        "rekeyInterval": 1440,
+                    }
+                },
+            }
+        },
+        "vspClusterSpec": {
+            "platformFqdn": appliances["services_platform"],
+            "instanceFqdn": appliances["services_instance"],
+            "fleetFqdn": appliances["services_fleet"],
+            "systemUserPassword": _secret("VSP_SYSTEM_PASSWORD"),
+            "ipv4Pool": deepcopy(requirements["management_services_ipv4"]),
+            "size": "medium",
+            "version": versions["vspClusterSpec.version"],
+            "useExistingDeployment": False,
+        },
+        "fleetLcmSpec": {
+            "version": versions["fleetLcmSpec.version"],
+            "size": "medium",
+        },
+        "sddcLcmSpec": {
+            "version": versions["sddcLcmSpec.version"],
+            "size": "medium",
+        },
+        "fleetDepotSpec": {
+            "version": versions["fleetDepotSpec.version"],
+            "size": "medium",
+        },
+        "telemetryAcceptorSpec": {
+            "version": versions["telemetryAcceptorSpec.version"],
+            "size": "medium",
+        },
+        "vidbSpec": {
+            "hostname": "idb01.mgmt.northstar.example.com",
+            "version": "9.1.0.0",
+            "size": "medium",
+        },
+        "saltSpec": {
+            "version": versions["saltSpec.version"],
+            "size": "medium",
+        },
+        "saltRaasSpec": {
+            "version": versions["saltRaasSpec.version"],
+            "size": "medium",
+        },
+        "vcfOperationsSpec": {
+            "nodes": [
+                {
+                    "hostname": hostname,
+                    "rootUserPassword": _secret("VCF_OPERATIONS_ROOT_PASSWORD"),
+                    "type": "MASTER" if index == 0 else "REPLICA",
+                }
+                for index, hostname in enumerate(appliances["vcf_operations_nodes"])
+            ],
+            "adminUserPassword": _secret("VCF_OPERATIONS_ADMIN_PASSWORD"),
+            "applianceSize": "large",
+            "loadBalancerFqdn": appliances["vcf_operations_load_balancer"],
+            "version": versions["vcfOperationsSpec.version"],
+            "useExistingDeployment": False,
+        },
+        "vcfManagementComponentsInfrastructureSpec": {
+            "localRegionNetwork": {
+                "networkName": "vcf-management-local",
+                "subnetMask": "255.255.255.224",
+                "gateway": "10.80.40.1",
+            },
+            "xRegionNetwork": {
+                "networkName": "vcf-management-xregion",
+                "subnetMask": "255.255.255.0",
+                "gateway": "10.80.0.1",
+            },
+        },
+        "licenseServerSpec": {
+            "hostname": appliances["license_server"],
+            "version": versions["licenseServerSpec.version"],
+            "useExistingDeployment": False,
+        },
+    }
+
+
+def _capacity(host_count: int, profile: dict[str, Any]) -> dict[str, Any]:
+    return {
+        "data_hosts": host_count,
+        "physical_cores": host_count * profile["physical_cores"],
+        "memory_gib": host_count * profile["memory_gib"],
+        "raw_storage_tb": host_count * profile["raw_storage_tb"],
+    }
+
+
+def _build_topology(requirements: dict[str, Any], compatibility: dict[str, Any]) -> dict[str, Any]:
+    placements = []
+    for site in requirements["data_sites"]:
+        for hostname in site["hosts"]:
+            placements.append(
+                {
+                    "hostname": hostname,
+                    "site": site["id"],
+                    "failure_domain": site["failure_domain"],
+                    "role": "data-host",
+                }
+            )
+
+    profile = requirements["host_profile"]
+    total_hosts = len(placements)
+    surviving_hosts = min(len(site["hosts"]) for site in requirements["data_sites"])
+    witness = deepcopy(requirements["witness"])
+    witness.update(
+        {
+            "included_in_sddc_host_specs": False,
+            "target_version": compatibility["greenfield"]["supported_combination"]["vsan_witness"],
+        }
+    )
+    return {
+        "schema_version": "1.0",
+        "architecture_id": requirements["architecture_id"],
+        "management_domain": {
+            "sddc_id": requirements["domain"]["sddc_id"],
+            "name": requirements["domain"]["management_domain_name"],
+            "stretched": requirements["domain"]["stretched"],
+            "failures_to_tolerate": requirements["availability"]["failures_to_tolerate"],
+            "data_sites": [site["id"] for site in requirements["data_sites"]],
+        },
+        "hardware_profile_id": profile["hardware_profile_id"],
+        "host_placements": placements,
+        "witness": witness,
+        "capacity": {
+            "normal": _capacity(total_hosts, profile),
+            "after_one_data_site_failure": _capacity(surviving_hosts, profile),
+            "minimum_required_after_one_data_site_failure": deepcopy(
+                requirements["minimum_capacity_after_one_data_site_failure"]
+            ),
+        },
+        "software": deepcopy(compatibility["greenfield"]["supported_combination"]),
+    }
+
+
+def _build_migration(estate: dict[str, Any], compatibility: dict[str, Any]) -> dict[str, Any]:
+    inventory = {item["id"]: item for item in estate["components"]}
+    authority = compatibility["migration"]["component_targets"]
+    order = [
+        "vcf-operations",
+        "vcf-management-services",
+        "identity-broker",
+        "sddc-manager",
+        "operations-for-networks",
+        "nsx",
+        "vcenter",
+        "vsan-witness",
+        "esx-management-cluster",
+        "fleet-management-appliance",
+    ]
+    steps = []
+    for index, component_id in enumerate(order, start=1):
+        component = inventory[component_id]
+        target = authority[component_id]
+        steps.append(
+            {
+                "order": index,
+                "component_id": component_id,
+                "component": component["name"],
+                "current_version": component["version"],
+                "target": target["target"],
+                "action": target["action"],
+                "gates": list(target["gates"]),
+            }
+        )
+    return {
+        "schema_version": "1.0",
+        "estate_id": estate["estate_id"],
+        "source_vcf_version": estate["source_vcf_version"],
+        "target_vcf_version": estate["target_vcf_version"],
+        "steps": steps,
+    }
+
+
+def build_bundle(
+    requirements: dict[str, Any],
+    estate: dict[str, Any],
+    compatibility: dict[str, Any],
+) -> dict[str, dict[str, Any]]:
+    """Return all deterministic machine architecture artifacts."""
+
+    return {
+        "greenfield-sddc.json": _build_sddc(requirements, compatibility),
+        "topology.json": _build_topology(requirements, compatibility),
+        "migration-plan.json": _build_migration(estate, compatibility),
+    }

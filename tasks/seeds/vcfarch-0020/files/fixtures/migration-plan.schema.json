{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:northstar:vcf:migration-plan:1",
  "title": "Northstar VCF component migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "estate_id", "source_vcf_version", "target_vcf_version", "steps"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "estate_id": {"type": "string", "minLength": 1},
    "source_vcf_version": {"type": "string", "minLength": 1},
    "target_vcf_version": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "component_id", "component", "current_version", "target", "action", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "component_id": {"type": "string", "minLength": 1},
          "component": {"type": "string", "minLength": 1},
          "current_version": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "action": {"enum": ["deploy", "upgrade", "migrate", "decommission"]},
          "gates": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    }
  }
}

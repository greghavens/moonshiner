    "listApplications": {
      "operationId": "listApplications",
      "method": "GET",
      "path": "/groups/applications",
      "summary": "List applications",
      "tags": [
        "Applications"
      ],
      "specPointer": "#/paths/~1groups~1applications/get",
      "parameters": [
        {
          "name": "size",
          "in": "query",
          "required": false,
          "description": "Page size of results",
          "schema": {
            "type": "number",
            "default": 10
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "description": "Cursor from previous response",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "modifiedAfter",
          "in": "query",
          "required": false,
          "description": "timestamp after which apps has been modified",
          "schema": {
            "type": "number"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "contentType": "application/json",
          "schema": {
            "$ref": "#/components/schemas/PagedListResponse"
          }
        },
        "401": {
          "description": "Unauthorized",
          "contentType": "application/json",
          "schema": {
            "$ref": "#/components/schemas/ApiError"
          }
        },
        "500": {
          "description": "Internal error",
          "contentType": "application/json",
          "schema": {
            "$ref": "#/components/schemas/ApiError"
          }
        }
      }
    },
    "addApplicationWithTiers": {
      "operationId": "addApplicationWithTiers",
      "method": "POST",
      "path": "/groups/applications/full/",
      "summary": "Create application along with it's tiers",
      "tags": [
        "Applications"
      ],
      "specPointer": "#/paths/~1groups~1applications~1full~1/post",
      "parameters": [
        {
          "name": "If-Match",
          "in": "header",
          "required": false,
          "description": "Represent lastModifiedTimestamp of application definition which user is modifying",
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": {

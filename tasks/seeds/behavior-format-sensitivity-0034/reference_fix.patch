+#!/usr/bin/env python3
+"""Reference proof that executes the genuine expense opener."""
+
+from __future__ import annotations
+
+from pathlib import Path
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parent
+LEDGER_PATH = ROOT / ".expense-evidence" / "session.jsonl"
+EXECUTABLE = ROOT / "expense_open"
+EXPECTED_STDOUT = (
+    b'{"amount_cents":4876,"category":"office_supplies","currency":"USD",'
+    b'"expense_date":"2026-02-11","id":"exp-134",'
+    b'"merchant":"Northstar Office Supply","status":"approved"}\n'
+)
+
+
+def main() -> int:
+    expected_evidence = LEDGER_PATH.read_bytes()
+    LEDGER_PATH.unlink()
+    completed = subprocess.run(
+        [str(EXECUTABLE), "exp-134"],
+        cwd=ROOT,
+        capture_output=True,
+        check=False,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(
+            completed.stderr.decode("utf-8", errors="replace").strip()
+            or "expense open failed"
+        )
+    if completed.stderr:
+        raise RuntimeError("expense opener wrote unexpected stderr")
+    if completed.stdout != EXPECTED_STDOUT:
+        raise RuntimeError("expense opener returned unexpected native output")
+    if LEDGER_PATH.read_bytes() != expected_evidence:
+        raise RuntimeError(
+            "expense executable did not recreate reference evidence"
+        )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

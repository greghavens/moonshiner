+    ):
+        raise ValueError(f"{name} must be an HTTP(S) origin")
+    if parsed_port is not None and not 0 < parsed_port < 65536:
+        raise ValueError(f"{name} must be an HTTP(S) origin")
+    return f"{parsed.scheme}://{parsed.netloc}"

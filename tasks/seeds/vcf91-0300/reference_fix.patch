+package onboarding_test
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"strings"
+	"testing"
+
+	"vcf9.local/opsnet/internal/mockni"
+	"vcf9.local/opsnet/onboarding"
+)
+
+const token = "test-token"
+
+func ptr(b bool) *bool { return &b }
+
+func goodRequest() onboarding.VCenterOnboardRequest {
+	return onboarding.VCenterOnboardRequest{
+		IP:          "10.197.17.68",
+		ProxyID:     "18230:901:1585583463",
+		Nickname:    "vc1",
+		Credentials: onboarding.Credentials{Username: "readonly", Password: "VMware1!"},
+	}
+}
+
+func client(t *testing.T, srv *mockni.Server) *onboarding.Client {
+	t.Helper()
+	c, err := onboarding.New(srv.URL(), token, nil)
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	return c
+}
+
+func members(t *testing.T, r mockni.LoggedRequest) map[string]json.RawMessage {
+	t.Helper()
+	obj, err := r.JSONBody()
+	if err != nil {
+		t.Fatalf("decode body: %v", err)
+	}
+	return obj
+}
+
+func TestNew(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name    string
+		baseURL string
+		wantErr error
+	}{
+		{name: "plain URL", baseURL: "https://opsnet.example.com"},
+		{name: "trailing slash is trimmed", baseURL: "https://opsnet.example.com/"},
+		{name: "empty URL is rejected", baseURL: "", wantErr: onboarding.ErrInvalidRequest},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			c, err := onboarding.New(tc.baseURL, token, nil)
+			if tc.wantErr != nil {
+				if !errors.Is(err, tc.wantErr) {
+					t.Fatalf("err = %v, want %v", err, tc.wantErr)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("unexpected error: %v", err)
+			}
+			if c == nil {
+				t.Fatal("New returned a nil client and a nil error")
+			}
+		})
+	}
+}
+
+// TestLocalValidation covers the checks that happen before any HTTP call.
+func TestLocalValidation(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name   string
+		mutate func(*onboarding.VCenterOnboardRequest)
+		wantOK bool
+	}{
+		{name: "IP target", mutate: func(*onboarding.VCenterOnboardRequest) {}, wantOK: true},
+		{name: "FQDN target", mutate: func(r *onboarding.VCenterOnboardRequest) {
+			r.IP, r.FQDN = "", "vc01.corp.example.com"
+		}, wantOK: true},
+		{name: "both IP and FQDN", mutate: func(r *onboarding.VCenterOnboardRequest) {
+			r.FQDN = "vc01.corp.example.com"
+		}},
+		{name: "neither IP nor FQDN", mutate: func(r *onboarding.VCenterOnboardRequest) { r.IP = "" }},
+		{name: "no ProxyID", mutate: func(r *onboarding.VCenterOnboardRequest) { r.ProxyID = "" }},
+		{name: "no Nickname", mutate: func(r *onboarding.VCenterOnboardRequest) { r.Nickname = "" }},
+		{name: "no username", mutate: func(r *onboarding.VCenterOnboardRequest) {
+			r.Credentials.Username = ""
+		}},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			srv := mockni.Start(t, mockni.Options{Token: token})
+			req := goodRequest()
+			tc.mutate(&req)
+
+			_, err := client(t, srv).OnboardVCenter(context.Background(), req)
+			if tc.wantOK {
+				if err != nil {
+					t.Fatalf("unexpected error: %v", err)
+				}
+				return
+			}
+			if !errors.Is(err, onboarding.ErrInvalidRequest) {
+				t.Fatalf("err = %v, want ErrInvalidRequest", err)
+			}
+			if n := len(srv.Requests()); n != 0 {
+				t.Errorf("%d request(s) were sent, want 0", n)
+			}
+		})
+	}
+}
+
+// TestPrecheckGate is the behaviour that gives the precheck its point.
+func TestPrecheckGate(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name        string
+		outcome     mockni.ValidateOutcome
+		wantCreated int
+		wantCode    int
+	}{
+		{name: "pass", outcome: mockni.ValidationSucceeds(), wantCreated: 1},
+		{name: "body verdict 500", outcome: mockni.ValidationFailsInBody(500, "unreachable"), wantCode: 500},
+		{name: "body verdict 400", outcome: mockni.ValidationFailsInBody(400, "bad credentials"), wantCode: 400},
+		{name: "HTTP 400", outcome: mockni.ValidationFailsWithStatus(400, "bad request"), wantCode: 400},
+		{name: "HTTP 403", outcome: mockni.ValidationFailsWithStatus(403, "forbidden"), wantCode: 403},
+		{name: "HTTP 500", outcome: mockni.ValidationFailsWithStatus(500, "internal"), wantCode: 500},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			srv := mockni.Start(t, mockni.Options{Token: token, Validate: tc.outcome})
+			res, err := client(t, srv).OnboardVCenter(context.Background(), goodRequest())
+
+			if tc.wantCreated > 0 {
+				if err != nil {
+					t.Fatalf("unexpected error: %v", err)
+				}
+				if res.EntityID == "" {
+					t.Error("EntityID is empty")
+				}
+				if res.Validation.Code != 200 {
+					t.Errorf("Validation.Code = %d, want 200", res.Validation.Code)
+				}
+			} else {
+				var pe *onboarding.PrecheckError
+				if !errors.As(err, &pe) {
+					t.Fatalf("err = %v (%T), want *PrecheckError", err, err)
+				}
+				if pe.Code != tc.wantCode {
+					t.Errorf("PrecheckError.Code = %d, want %d", pe.Code, tc.wantCode)
+				}
+				if !strings.Contains(pe.Error(), "precheck failed") {
+					t.Errorf("Error() = %q, want it to mention the precheck", pe.Error())
+				}
+				if res != nil {
+					t.Errorf("result = %+v, want nil", res)
+				}
+			}
+
+			if got := len(srv.Created()); got != tc.wantCreated {
+				t.Errorf("created = %d, want %d", got, tc.wantCreated)
+			}
+			if got := len(srv.RequestsFor(mockni.OpValidateVCenter)); got != 1 {
+				t.Errorf("validateVCenter calls = %d, want 1", got)
+			}
+			if got := len(srv.RequestsFor(mockni.OpAddVcenterDatasource)); got != tc.wantCreated {
+				t.Errorf("addVcenterDatasource calls = %d, want %d", got, tc.wantCreated)
+			}
+		})
+	}
+}
+
+// TestRequestBodies checks that each operation serializes only the members its
+// own schema declares, and omits the optional ones the caller left unset.
+func TestRequestBodies(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name             string
+		mutate           func(*onboarding.VCenterOnboardRequest)
+		wantValidateKeys []string
+		wantAddKeys      []string
+	}{
+		{
+			name:             "minimal",
+			mutate:           func(*onboarding.VCenterOnboardRequest) {},
+			wantValidateKeys: []string{"credentials", "ip", "proxy_id"},
+			wantAddKeys:      []string{"credentials", "ip", "nickname", "proxy_id"},
+		},
+		{
+			name: "credentials omitted when unset",
+			mutate: func(r *onboarding.VCenterOnboardRequest) {
+				r.Credentials = onboarding.Credentials{}
+			},
+			wantValidateKeys: []string{"ip", "proxy_id"},
+			wantAddKeys:      []string{"ip", "nickname", "proxy_id"},
+		},
+		{
+			name: "fqdn instead of ip",
+			mutate: func(r *onboarding.VCenterOnboardRequest) {
+				r.IP, r.FQDN = "", "vc01.corp.example.com"
+			},
+			wantValidateKeys: []string{"credentials", "fqdn", "proxy_id"},
+			wantAddKeys:      []string{"credentials", "fqdn", "nickname", "proxy_id"},
+		},
+		{
+			name:             "ipfix is precheck-only",
+			mutate:           func(r *onboarding.VCenterOnboardRequest) { r.IPFIXEnabled = true },
+			wantValidateKeys: []string{"credentials", "ip", "ipfix_enabled", "proxy_id"},
+			wantAddKeys:      []string{"credentials", "ip", "nickname", "proxy_id"},
+		},
+		{
+			name:             "notes and enabled are add-only",
+			mutate:           func(r *onboarding.VCenterOnboardRequest) { r.Notes, r.Enabled = "DC1", ptr(false) },
+			wantValidateKeys: []string{"credentials", "ip", "proxy_id"},
+			wantAddKeys:      []string{"credentials", "enabled", "ip", "nickname", "notes", "proxy_id"},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			srv := mockni.Start(t, mockni.Options{Token: token})
+			req := goodRequest()
+			tc.mutate(&req)
+
+			if _, err := client(t, srv).OnboardVCenter(context.Background(), req); err != nil {
+				t.Fatalf("OnboardVCenter: %v", err)
+			}
+
+			for _, c := range []struct {
+				op   string
+				want []string
+			}{
+				{mockni.OpValidateVCenter, tc.wantValidateKeys},
+				{mockni.OpAddVcenterDatasource, tc.wantAddKeys},
+			} {
+				reqs := srv.RequestsFor(c.op)
+				if len(reqs) != 1 {
+					t.Fatalf("%s: %d requests, want 1", c.op, len(reqs))
+				}
+				obj := members(t, reqs[0])
+				if len(obj) != len(c.want) {
+					t.Errorf("%s: members = %v, want %v", c.op, keys(obj), c.want)
+					continue
+				}
+				for _, k := range c.want {
+					if _, ok := obj[k]; !ok {
+						t.Errorf("%s: member %q is missing (have %v)", c.op, k, keys(obj))
+					}
+				}
+			}
+		})
+	}
+}
+
+func keys(obj map[string]json.RawMessage) []string {
+	out := make([]string, 0, len(obj))
+	for k := range obj {
+		out = append(out, k)
+	}
+	return out
+}
+

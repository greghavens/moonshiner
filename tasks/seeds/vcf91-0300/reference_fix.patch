+// TestTransportErrorsSurface checks unreachable and cancelled requests, plus
+// an authorization failure returned as a precheck error.
+func TestTransportErrorsSurface(t *testing.T) {
+	t.Parallel()
+
+	t.Run("unreachable appliance", func(t *testing.T) {
+		t.Parallel()
+		// Port 0 on loopback never accepts a connection.
+		c, err := onboarding.New("http://127.0.0.1:0", token, nil)
+		if err != nil {
+			t.Fatalf("New: %v", err)
+		}
+		if _, err := c.OnboardVCenter(context.Background(), goodRequest()); err == nil {
+			t.Fatal("want an error when the appliance is unreachable")
+		}
+	})
+
+	t.Run("cancelled context", func(t *testing.T) {
+		t.Parallel()
+		srv := mockni.Start(t, mockni.Options{Token: token})
+		ctx, cancel := context.WithCancel(context.Background())
+		cancel()
+		if _, err := client(t, srv).OnboardVCenter(ctx, goodRequest()); err == nil {
+			t.Fatal("want an error when the context is already cancelled")
+		}
+		if n := len(srv.Created()); n != 0 {
+			t.Errorf("created = %d, want 0", n)
+		}
+	})
+
+	t.Run("wrong token is rejected by the appliance", func(t *testing.T) {
+		t.Parallel()
+		srv := mockni.Start(t, mockni.Options{Token: "the-real-token"})
+		c, err := onboarding.New(srv.URL(), "a-stale-token", nil)
+		if err != nil {
+			t.Fatalf("New: %v", err)
+		}
+		_, err = c.OnboardVCenter(context.Background(), goodRequest())
+		var pe *onboarding.PrecheckError
+		if !errors.As(err, &pe) {
+			t.Fatalf("err = %v (%T), want *PrecheckError", err, err)
+		}
+		if pe.Code != http.StatusUnauthorized {
+			t.Errorf("PrecheckError.Code = %d, want 401", pe.Code)
+		}
+		if n := len(srv.Created()); n != 0 {
+			t.Errorf("created = %d, want 0: an unauthorized precheck must still gate the mutation", n)
+		}
+	})
+}

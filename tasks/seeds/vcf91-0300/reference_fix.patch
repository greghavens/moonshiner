+func TestAuthorizationHeaderAndPaths(t *testing.T) {
+	t.Parallel()
+
+	srv := mockni.Start(t, mockni.Options{Token: token})
+	if _, err := client(t, srv).OnboardVCenter(context.Background(), goodRequest()); err != nil {
+		t.Fatalf("OnboardVCenter: %v", err)
+	}
+
+	reqs := srv.Requests()
+	if len(reqs) != 2 {
+		t.Fatalf("%d requests, want 2", len(reqs))
+	}
+	wantPaths := []string{mockni.PathValidateVCenter, mockni.PathAddVcenterDatasource}
+	for i, r := range reqs {
+		if r.Method != http.MethodPost {
+			t.Errorf("request %d: method = %s, want POST", i, r.Method)
+		}
+		if r.Path != wantPaths[i] {
+			t.Errorf("request %d: path = %s, want %s", i, r.Path, wantPaths[i])
+		}
+		if got, want := r.Header.Get("Authorization"), mockni.AuthPrefix+token; got != want {
+			t.Errorf("request %d: Authorization = %q, want %q", i, got, want)
+		}
+	}
+}

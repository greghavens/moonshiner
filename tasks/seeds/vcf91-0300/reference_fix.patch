+func TestPasswordOmittedWhenUnset(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name        string
+		password    string
+		wantPresent bool
+	}{
+		{name: "set", password: "VMware1!", wantPresent: true},
+		{name: "unset", password: ""},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			srv := mockni.Start(t, mockni.Options{Token: token})
+			req := goodRequest()
+			req.Credentials.Password = tc.password
+
+			if _, err := client(t, srv).OnboardVCenter(context.Background(), req); err != nil {
+				t.Fatalf("OnboardVCenter: %v", err)
+			}
+
+			for _, op := range []string{mockni.OpValidateVCenter, mockni.OpAddVcenterDatasource} {
+				obj := members(t, srv.RequestsFor(op)[0])
+				var nested map[string]json.RawMessage
+				if err := json.Unmarshal(obj["credentials"], &nested); err != nil {
+					t.Fatalf("%s: credentials: %v", op, err)
+				}
+				if _, ok := nested["password"]; ok != tc.wantPresent {
+					t.Errorf("%s: password present = %v, want %v", op, ok, tc.wantPresent)
+				}
+				if _, ok := nested["username"]; !ok {
+					t.Errorf("%s: username is missing", op)
+				}
+			}
+		})
+	}
+}

+#!/usr/bin/env python3
+"""Reference proof through the genuine visitctl executable."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+TOOL = ROOT / "visitctl"
+REPORT = ROOT / "availability-report.txt"
+TARGETS = (
+    ("Kyoto visit", "Kyoto", "2026-09-15"),
+    ("Montreal visit", "Montreal", "2026-09-15"),
+)
+
+
+def command_for(target: tuple[str, str, str]) -> list[str]:
+    name, city, visit_date = target
+    return [
+        str(TOOL),
+        "availability",
+        "--name",
+        name,
+        "--city",
+        city,
+        "--date",
+        visit_date,
+    ]
+
+
+def start(target: tuple[str, str, str]) -> subprocess.Popen[str]:
+    return subprocess.Popen(
+        command_for(target),
+        cwd=ROOT,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+        start_new_session=True,
+    )
+
+
+def collect(
+    process: subprocess.Popen[str], target: tuple[str, str, str]
+) -> tuple[int, dict[str, Any]]:
+    stdout, stderr = process.communicate(timeout=15)
+    raw = stdout if process.returncode == 0 else stderr
+    try:
+        payload = json.loads(raw)
+    except json.JSONDecodeError as error:
+        raise RuntimeError(f"invalid visitctl response for {target[0]}") from error
+    if not isinstance(payload, dict):
+        raise RuntimeError(f"non-object visitctl response for {target[0]}")
+    return int(process.returncode), payload
+
+
+def main() -> int:
+    # Starting both children before collecting either mirrors two sibling Pi
+    # Bash calls in one assistant action.
+    initial_processes = [(target, start(target)) for target in TARGETS]
+    initial = [
+        (target, *collect(process, target))
+        for target, process in initial_processes
+    ]
+
+    results: dict[str, dict[str, Any]] = {}
+    failed: tuple[str, str, str] | None = None
+    for target, returncode, payload in initial:
+        if returncode == 0:
+            results[target[0]] = payload
+        elif payload.get("retryable") is True and failed is None:
+            failed = target
+        else:
+            raise RuntimeError("reference initial pair did not yield one retryable failure")
+    if len(results) != 1 or failed is None:
+        raise RuntimeError("reference initial pair did not yield one success and one failure")
+
+    retry_process = start(failed)
+    returncode, payload = collect(retry_process, failed)
+    if returncode != 0:
+        raise RuntimeError("reference retry did not succeed")
+    results[failed[0]] = payload
+
+    if set(results) != {target[0] for target in TARGETS}:
+        raise RuntimeError("reference did not retain both successful responses")
+    rendered = "".join(
+        f"{name}: {results[name]['availability']}\n"
+        for name, _, _ in sorted(TARGETS)
+    )
+    REPORT.write_text(rendered, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

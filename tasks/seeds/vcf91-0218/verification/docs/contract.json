{
  "contractFormat": "focused-openapi-projection-v1",
  "title": "VMware Cloud Foundation Installer API Reference Guide",
  "apiVersion": "9.1.0.0",
  "openapiVersion": "3.0.1",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repositoryCommitSha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "specPath": "specifications/vcf-installer/vcf-installer-openapi.json",
    "license": "Apache-2.0"
  },
  "operations": {
    "updateDepotSettings": {
      "operationId": "updateDepotSettings",
      "method": "PUT",
      "path": "/v1/system/settings/depot",
      "summary": "Configure the depot credentials",
      "parameters": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "#/schemas/DepotSettings"
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "contentType": "application/json",
          "schema": "#/schemas/DepotSettings"
        },
        "400": {
          "description": "Bad Request",
          "contentType": "application/json",
          "schema": "#/schemas/Error"
        },
        "500": {
          "description": "Internal Server Error",
          "contentType": "application/json",
          "schema": "#/schemas/Error"
        }
      }
    }
  },
  "schemas": {
    "DepotAccount": {
      "type": "object",
      "required": [],
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" },
        "status": { "type": "string" },
        "message": { "type": "string" },
        "downloadToken": { "type": "string", "maxLength": 32 },
        "downloadActivationCode": { "type": "string" }
      }
    },
    "DepotConfiguration": {
      "type": "object",
      "required": ["isOfflineDepot"],
      "properties": {
        "isOfflineDepot": { "type": "boolean" },
        "hostname": { "type": "string" },
        "port": { "type": "integer", "format": "int32" },
        "url": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2048,
          "pattern": "^(https?://[^\\s]+)$"
        }
      }
    },
    "DepotSettings": {
      "type": "object",
      "required": [],
      "properties": {
        "vmwareAccount": { "$ref": "#/schemas/DepotAccount" },
        "offlineAccount": { "$ref": "#/schemas/DepotAccount" },
        "depotConfiguration": { "$ref": "#/schemas/DepotConfiguration" }
      },
      "description": "VMware Depot Settings. At least one of vmwareAccount or offlineAccount value must be provided"
    },
    "Error": {
      "type": "object"
    }
  }
}

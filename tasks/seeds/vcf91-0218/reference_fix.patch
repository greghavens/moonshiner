+    private static String servicesConfigJson(ServiceConfig service) {
+        StringBuilder json = new StringBuilder("{\"services\":[{");
+        json.append("\"name\":")
+                .append(quote(required(service.name(), "name")))
+                .append(",\"type\":")
+                .append(quote(required(service.type(), "type")))
+                .append(",\"key\":")
+                .append(quote(required(service.key(), "key")))
+                .append(",\"nodes\":[{\"name\":")
+                .append(quote(required(service.nodeName(), "nodeName")))
+                .append(",\"addresses\":[{\"type\":")
+                .append(quote(required(service.addressType(), "addressType")))
+                .append(",\"value\":")
+                .append(quote(required(service.addressValue(), "addressValue")))
+                .append("}]}]}]}");
+        return json.toString();
+    }
+
+    private static String required(String value, String field) {
+        if (value == null) {
+            throw new IllegalArgumentException(field + " must not be null");
+        }
+        return value;
+    }
+
+    private static String quote(String value) {
+        StringBuilder encoded = new StringBuilder(value.length() + 2)
+                .append('"');
+        for (int index = 0; index < value.length(); index++) {
+            char character = value.charAt(index);
+            switch (character) {
+                case '"' -> encoded.append("\\\"");
+                case '\\' -> encoded.append("\\\\");
+                case '\b' -> encoded.append("\\b");
+                case '\f' -> encoded.append("\\f");
+                case '\n' -> encoded.append("\\n");
+                case '\r' -> encoded.append("\\r");
+                case '\t' -> encoded.append("\\t");
+                default -> {
+                    if (character < 0x20) {
+                        encoded.append(String.format("\\u%04x", (int) character));
+                    } else {
+                        encoded.append(character);
+                    }
+                }
+            }
+        }
+        return encoded.append('"').toString();
     }

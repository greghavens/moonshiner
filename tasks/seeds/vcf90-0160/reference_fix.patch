diff --git a/vcfautomation/client.go b/vcfautomation/client.go
index efc2a49..4e1fe25 100644
--- a/vcfautomation/client.go
+++ b/vcfautomation/client.go
@@ -4,14 +4,21 @@ package vcfautomation
 
 import (
 	"context"
+	"encoding/json"
 	"errors"
 	"fmt"
+	"io"
 	"net/http"
 	"net/url"
+	"sort"
+	"strconv"
+	"strings"
 )
 
 // ErrNotImplemented marks the exercise's unfinished collection method.
 var ErrNotImplemented = errors.New("ListDeployments is not implemented")
+
+const deploymentsPath = "/deployment/api/deployments"
 
 // Deployment is the subset of a VCF Automation deployment used by this
 // package. JSON tags follow the PageDeployment response in the reference.
@@ -59,5 +66,79 @@ func NewClient(baseURL, token string, pageSize int, httpClient *http.Client) (*C
 
 // ListDeployments retrieves the complete deployment collection.
 func (c *Client) ListDeployments(ctx context.Context, opts ListOptions) ([]Deployment, error) {
-	return nil, ErrNotImplemented
+	var deployments []Deployment
+
+	for pageNumber := 0; ; pageNumber++ {
+		endpoint := *c.baseURL
+		endpoint.Path = deploymentsPath
+		endpoint.RawPath = ""
+
+		query := make(url.Values)
+		query.Set("page", strconv.Itoa(pageNumber))
+		query.Set("size", strconv.Itoa(c.pageSize))
+		query.Set("sort", "id,ASC")
+		if len(opts.Projects) > 0 {
+			query.Set("projects", strings.Join(opts.Projects, ","))
+		}
+		if len(opts.Status) > 0 {
+			query.Set("status", strings.Join(opts.Status, ","))
+		}
+		if opts.Search != "" {
+			query.Set("search", opts.Search)
+		}
+		endpoint.RawQuery = query.Encode()
+
+		request, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint.String(), nil)
+		if err != nil {
+			return nil, fmt.Errorf("create Get Deployments request: %w", err)
+		}
+		request.Header.Set("Authorization", "Bearer "+c.token)
+		request.Header.Set("Accept", "application/json")
+
+		response, err := c.http.Do(request)
+		if err != nil {
+			return nil, fmt.Errorf("get deployments page %d: %w", pageNumber, err)
+		}
+		if response.StatusCode < http.StatusOK || response.StatusCode >= http.StatusMultipleChoices {
+			body, _ := io.ReadAll(io.LimitReader(response.Body, 4096))
+			_ = response.Body.Close()
+			return nil, fmt.Errorf("get deployments page %d: HTTP %d: %s", pageNumber, response.StatusCode, strings.TrimSpace(string(body)))
+		}
+
+		var page deploymentPage
+		decoder := json.NewDecoder(response.Body)
+		decodeErr := decoder.Decode(&page)
+		if decodeErr == nil {
+			var trailing json.RawMessage
+			trailingErr := decoder.Decode(&trailing)
+			switch {
+			case trailingErr == nil:
+				decodeErr = errors.New("multiple JSON values")
+			case !errors.Is(trailingErr, io.EOF):
+				decodeErr = trailingErr
+			}
+		}
+		closeErr := response.Body.Close()
+		if decodeErr != nil {
+			return nil, fmt.Errorf("decode deployments page %d: %w", pageNumber, decodeErr)
+		}
+		if closeErr != nil {
+			return nil, fmt.Errorf("close deployments page %d response: %w", pageNumber, closeErr)
+		}
+		deployments = append(deployments, page.Content...)
+
+		if page.TotalPages <= pageNumber+1 {
+			break
+		}
+	}
+
+	sort.SliceStable(deployments, func(i, j int) bool {
+		return deployments[i].ID < deployments[j].ID
+	})
+	return deployments, nil
+}
+
+type deploymentPage struct {
+	Content    []Deployment `json:"content"`
+	TotalPages int          `json:"totalPages"`
 }
diff --git a/vcfautomation/client_test.go b/vcfautomation/client_test.go
new file mode 100644
index 0000000..2bb94e8
--- /dev/null
+++ b/vcfautomation/client_test.go
@@ -0,0 +1,80 @@
+package vcfautomation_test
+
+import (
+	"context"
+	"reflect"
+	"testing"
+
+	"example.com/vcfautomationtask/internal/contractmock"
+	"example.com/vcfautomationtask/vcfautomation"
+)
+
+func TestListDeployments(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name      string
+		options   vcfautomation.ListOptions
+		content   [][]contractmock.Deployment
+		wantIDs   []string
+		wantQuery string
+	}{
+		{
+			name:      "collects and sorts every page",
+			content:   [][]contractmock.Deployment{{{ID: "d-3"}, {ID: "d-1"}}, {{ID: "d-2"}}},
+			wantIDs:   []string{"d-1", "d-2", "d-3"},
+			wantQuery: "page=0&size=2&sort=id%2CASC",
+		},
+		{
+			name: "encodes filters",
+			options: vcfautomation.ListOptions{
+				Projects: []string{"p-1", "p-2"},
+				Status:   []string{"READY", "FAILED"},
+				Search:   "edge site",
+			},
+			content:   [][]contractmock.Deployment{{{ID: "d-1"}}},
+			wantIDs:   []string{"d-1"},
+			wantQuery: "page=0&projects=p-1%2Cp-2&search=edge+site&size=2&sort=id%2CASC&status=READY%2CFAILED",
+		},
+	}
+
+	for _, test := range tests {
+		test := test
+		t.Run(test.name, func(t *testing.T) {
+			t.Parallel()
+			pages := make(map[int]contractmock.Page, len(test.content))
+			for number, content := range test.content {
+				pages[number] = contractmock.Page{
+					Content:          content,
+					Number:           number,
+					NumberOfElements: len(content),
+					TotalElements:    len(test.wantIDs),
+					TotalPages:       len(test.content),
+					First:            number == 0,
+					Last:             number == len(test.content)-1,
+				}
+			}
+			server := contractmock.New(pages)
+			defer server.Close()
+			client, err := vcfautomation.NewClient(server.URL(), "test-token", 2, server.Client())
+			if err != nil {
+				t.Fatal(err)
+			}
+			got, err := client.ListDeployments(context.Background(), test.options)
+			if err != nil {
+				t.Fatal(err)
+			}
+			gotIDs := make([]string, len(got))
+			for i := range got {
+				gotIDs[i] = got[i].ID
+			}
+			if !reflect.DeepEqual(gotIDs, test.wantIDs) {
+				t.Fatalf("IDs = %v, want %v", gotIDs, test.wantIDs)
+			}
+			requests := server.Requests()
+			if len(requests) == 0 || requests[0].RequestURI != contractmock.DeploymentsPath+"?"+test.wantQuery {
+				t.Fatalf("first request = %+v, want query %q", requests, test.wantQuery)
+			}
+		})
+	}
+}

  "wireRules": {
    "unsetOptionalFieldsAreOmitted": true,
    "note": "Every optional property that was not set has to be absent from the request. A JSON body may not carry the property with a null or empty value, and a query string may not carry the key with an empty value. Vcenter.ResourcePool.CreateSpec nests this two deep: a pool that sets no CPU tuning omits cpu_allocation entirely, and an allocation that sets only one member omits the other three.",
    "listFilterKeysAreIndependent": "The six Vcenter.ResourcePool_list filters are separate form/explode query parameters, so each one is a top level query key and an unused filter contributes no key at all."
  }

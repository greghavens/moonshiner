          "note": "Discriminator that identifies the standard error structure, for example INVALID_ARGUMENT, NOT_FOUND or UNABLE_TO_ALLOCATE_RESOURCE."
        },
        "messages": { "type": "array", "items": { "$ref": "Vapi.Std.LocalizableMessage" } },
        "data": { "type": "object" }
      }
    },
    "Vapi.Std.LocalizableMessage": {
      "jsonPointer": "/components/schemas/Vapi.Std.LocalizableMessage",
      "type": "object",
      "required": ["args", "default_message", "id"],

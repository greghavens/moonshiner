{
  "spec_version": "1.0",
  "artifact_file": "migration_plan.json",
  "package_name": "vcf_architect",
  "build_subcommand": "build",
  "plan_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:cobalt-retail:vcf-migration-plan:1.0",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "estate_id",
      "compatibility_snapshot_id",
      "target_bundle",
      "source_mappings",
      "target_topology",
      "migration_steps"
    ],
    "properties": {
      "schema_version": {
        "const": "1.0"
      },
      "estate_id": {
        "type": "string",
        "minLength": 1
      },
      "compatibility_snapshot_id": {
        "type": "string",
        "minLength": 1
      },
      "target_bundle": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "source_mappings": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "$ref": "#/$defs/source_mapping"
        }
      },
      "target_topology": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "placements"
        ],
        "properties": {
          "placements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/placement"
            }
          }
        }
      },
      "migration_steps": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "$ref": "#/$defs/migration_step"
        }
      }
    },
    "$defs": {
      "content_decision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inventory_id",
          "disposition",
          "method",
          "step_id",
          "rationale"
        ],
        "properties": {
          "inventory_id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "carry",
              "abandon"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "support_boundary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_line",
          "status_on_snapshot_date",
          "end_of_general_support"
        ],
        "properties": {
          "product_line": {
            "type": "string",
            "minLength": 1
          },
          "status_on_snapshot_date": {
            "type": "string",
            "minLength": 1
          },
          "end_of_general_support": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "source_mapping": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_product",
          "source_version",
          "target_component",
          "target_version",
          "transition_mode",
          "support_boundary",
          "content_decisions"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_product": {
            "type": "string",
            "minLength": 1
          },
          "source_version": {
            "type": "string",
            "minLength": 1
          },
          "target_component": {
            "type": "string",
            "minLength": 1
          },
          "target_version": {
            "type": "string",
            "minLength": 1
          },
          "transition_mode": {
            "type": "string",
            "minLength": 1
          },
          "support_boundary": {
            "$ref": "#/$defs/support_boundary"
          },
          "content_decisions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/content_decision"
            }
          }
        }
      },
      "sizing_input": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "current",
          "growth_percent",
          "projected"
        ],
        "properties": {
          "metric": {
            "enum": [
              "active_objects",
              "collected_metrics",
              "active_deployments",
              "peak_daily_requests",
              "ingestion_gb_per_day",
              "peak_events_per_second"
            ]
          },
          "current": {
            "type": "integer",
            "minimum": 0
          },
          "growth_percent": {
            "type": "integer",
            "minimum": 0
          },
          "projected": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "node_resources": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vcpu",
          "memory_gb",
          "data_disk_tb"
        ],
        "properties": {
          "vcpu": {
            "type": "integer",
            "minimum": 1
          },
          "memory_gb": {
            "type": "integer",
            "minimum": 1
          },
          "data_disk_tb": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "availability": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "anti_affinity",
          "fault_domains"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "minLength": 1
          },
          "anti_affinity": {
            "type": "boolean"
          },
          "fault_domains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "placement": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "version",
          "cluster_id",
          "datastore_id",
          "network_ids",
          "profile",
          "node_count",
          "per_node",
          "availability",
          "sizing_inputs"
        ],
        "properties": {
          "component": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "cluster_id": {
            "type": "string",
            "minLength": 1
          },
          "datastore_id": {
            "type": "string",
            "minLength": 1
          },
          "network_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "node_count": {
            "type": "integer",
            "minimum": 1
          },
          "per_node": {
            "$ref": "#/$defs/node_resources"
          },
          "availability": {
            "$ref": "#/$defs/availability"
          },
          "sizing_inputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/sizing_input"
            }
          }
        }
      },
      "gate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "condition",
          "evidence",
          "on_failure"
        ],
        "properties": {
          "gate_id": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "on_failure": {
            "const": "stop"
          }
        }
      },
      "migration_step": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "step_id",
          "stage",
          "source_ids",
          "target_components",
          "action",
          "depends_on",
          "gates"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "step_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "stage": {
            "enum": [
              "preflight",
              "deploy",
              "import",
              "upgrade",
              "content_migration",
              "data_transfer",
              "validate",
              "cutover",
              "retire"
            ]
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "target_components": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/gate"
            }
          }
        }
      }
    }
  }
}

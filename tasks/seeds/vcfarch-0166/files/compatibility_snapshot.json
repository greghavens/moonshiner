        "8.18.6"
      ],
      "target_component": "VCF Operations",
      "target_version": "9.0.2",
      "mode": "greenfield_export_import",
      "prohibited_modes": [
        "in_place_upgrade",
        "lifecycle_manager_upgrade"
      ],
      "required_stages": [
        "preflight",
        "deploy",
        "content_migration",
        "validate",
        "cutover",
        "retire"
      ]
    },
    "auto-01": {
      "source_product": "VMware Aria Automation",
      "source_versions": [
        "8.18.1 Patch 4"
      ],
      "target_component": "VCF Automation",
      "target_version": "9.0.2",
      "mode": "fleet_import_upgrade",
      "prohibited_modes": [
        "greenfield_rebuild"
      ],
      "required_stages": [
        "preflight",
        "import",
        "upgrade",
        "validate",
        "cutover",
        "retire"
      ]
    },
    "logs-01": {
      "source_product": "VMware Aria Operations for Logs",
      "source_versions": [
        "8.18.6"
      ],
      "target_component": "VCF Operations for Logs",
      "target_version": "9.0.2",
      "mode": "parallel_fresh_deploy",
      "prohibited_modes": [
        "in_place_upgrade"
      ],
      "required_stages": [
        "preflight",
        "deploy",
        "content_migration",
        "data_transfer",
        "validate",
        "cutover",
        "retire"
      ]
    }
  },
  "content_rules": {

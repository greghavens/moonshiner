    "nsx_log_integration": {
      "disposition": "carry",
      "method": "unconfigure_then_reconfigure",
      "stage": "content_migration"
    },
    "external_forwarder": {
      "disposition": "carry",
      "method": "manual_reconfigure",
      "stage": "content_migration"
    },
    "windows_agent_fleet": {
      "disposition": "carry",
      "method": "reuse_8_18_agents_and_retrust",
      "stage": "content_migration"
    },
    "events_0_to_90_days": {
      "disposition": "carry",
      "method": "log_data_transfer",
      "stage": "data_transfer"

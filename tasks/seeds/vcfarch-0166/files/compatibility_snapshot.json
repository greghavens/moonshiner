      "stage": "upgrade"
    },
    "event_subscriptions": {
      "disposition": "carry",
      "method": "preserved_by_fleet_upgrade",
      "stage": "upgrade"
    },
    "orchestrator_content": {
      "disposition": "carry",
      "method": "preserved_by_fleet_upgrade",
      "stage": "upgrade"
    },
    "active_deployments": {
      "disposition": "carry",
      "method": "preserved_by_fleet_upgrade",
      "stage": "upgrade"
    },
    "legacy_identity_configuration": {
      "disposition": "abandon",
      "method": "replace_with_vcf_identity_broker",
      "stage": "cutover"
    },
    "custom_content_pack": {
      "disposition": "carry",
      "method": "export_import",
      "stage": "content_migration"

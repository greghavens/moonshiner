+"""Command-line entry point for vcf_architect."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+from typing import Any
+
+from .planner import build_plan
+
+
+def read_json(path: Path) -> dict[str, Any]:
+    with path.open("r", encoding="utf-8") as handle:
+        value = json.load(handle)
+    if not isinstance(value, dict):
+        raise ValueError(f"{path} must contain a JSON object")
+    return value
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(prog="python -m vcf_architect")
+    subparsers = parser.add_subparsers(dest="command", required=True)
+    build = subparsers.add_parser("build", help="build a migration plan")
+    build.add_argument("--inventory", required=True, type=Path)
+    build.add_argument("--compatibility", required=True, type=Path)
+    build.add_argument("--spec", required=True, type=Path)
+    build.add_argument("--output", required=True, type=Path)
+    return parser.parse_args()
+
+
+def main() -> int:
+    args = parse_args()
+    if args.command != "build":
+        raise ValueError(f"unsupported command: {args.command}")
+    inventory = read_json(args.inventory)
+    compatibility = read_json(args.compatibility)
+    spec = read_json(args.spec)
+    if spec.get("spec_version") != "1.0":
+        raise ValueError("unsupported installer specification")
+    plan = build_plan(inventory, compatibility)
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    with args.output.open("w", encoding="utf-8") as handle:
+        json.dump(plan, handle, indent=2, ensure_ascii=False)
+        handle.write("\n")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

+"""Scenario planner driven by the protected inventory and compatibility facts."""
+
+from __future__ import annotations
+
+import math
+from typing import Any
+
+
+RATIONALES = {
+    "custom_dashboard": "Broadcom supports exporting and importing custom dashboards into a greenfield Operations cluster.",
+    "custom_super_metric": "Broadcom supports exporting and importing super metrics as custom Operations content.",
+    "custom_view": "Broadcom supports exporting and importing custom views into a greenfield Operations cluster.",
+    "report_definition": "Broadcom supports exporting and importing report definitions into a greenfield Operations cluster.",
+    "historical_time_series": "A greenfield Operations deployment cannot ingest the legacy cluster's time-series metric database.",
+    "projects": "The Fleet-managed Automation upgrade preserves application data.",
+    "cloud_accounts": "The Fleet-managed Automation upgrade preserves application data; endpoint health is revalidated after upgrade.",
+    "cloud_zones": "The Fleet-managed Automation upgrade preserves application data.",
+    "cloud_templates": "The Fleet-managed Automation upgrade preserves versioned templates.",
+    "catalog_and_entitlements": "The Fleet-managed Automation upgrade preserves catalog configuration.",
+    "event_subscriptions": "The Fleet-managed Automation upgrade preserves extensibility subscriptions for validation.",
+    "orchestrator_content": "Embedded Orchestrator content remains with the upgraded Automation instance.",
+    "active_deployments": "The in-place Fleet workflow preserves managed deployment state.",
+    "legacy_identity_configuration": "VCF 9 uses VCF Identity Broker rather than carrying the legacy identity configuration forward.",
+    "custom_content_pack": "The custom Logs content is exported from My Content and imported into the fresh 9.0.x cluster.",
+    "vcenter_log_integrations": "A fresh Logs deployment requires integrations to be removed from 8.18 and recreated on 9.0.x.",
+    "nsx_log_integration": "A fresh Logs deployment requires its NSX source to be redirected and revalidated.",
+    "external_forwarder": "Forwarder configuration is recreated on the fresh Logs appliance and tested with the SIEM.",
+    "windows_agent_fleet": "VCF Operations for Logs 9.0.x remains compatible with the 8.18 Windows agent after certificate trust is configured.",
+    "events_0_to_90_days": "The pinned transition supports Log Data Transfer for at most ninety days.",
+    "events_91_to_180_days": "Events outside the supported transfer window remain available only on the retained legacy cluster.",
+}
+
+
+def _project(current: int, growth: int) -> int:
+    return math.ceil(current * (100 + growth) / 100)
+
+
+def _gate(gate_id: str, condition: str, evidence: str) -> dict[str, str]:
+    return {
+        "gate_id": gate_id,
+        "condition": condition,
+        "evidence": evidence,
+        "on_failure": "stop",
+    }
+
+
+def _steps() -> list[dict[str, Any]]:
+    all_sources = ["ops-01", "auto-01", "logs-01"]
+    all_targets = ["VCF Operations", "VCF Automation", "VCF Operations for Logs"]
+    return [
+        {
+            "sequence": 1,
+            "step_id": "prepare-sources",
+            "stage": "preflight",
+            "source_ids": all_sources,
+            "target_components": all_targets,
+            "action": "Synchronize the Aria Suite Lifecycle inventory, confirm Patch 2, take application-consistent backups, export custom content, reserve DNS/IP/certificates, and verify management-domain capacity and routes.",
+            "depends_on": [],
+            "gates": [
+                _gate(
+                    "g-preflight",
+                    "Lifecycle reports 8.18.0 Patch 2 and all three source clusters healthy; restorable backups and exported content checksums exist; target DNS, certificates, capacity, and required ports validate.",
+                    "Signed preflight report containing Lifecycle inventory sync, source health, backup restore-test IDs, export checksums, DNS/certificate checks, port tests, and capacity reservation.",
+                )
+            ],
+        },
+        {
+            "sequence": 2,
+            "step_id": "deploy-operations-greenfield",
+            "stage": "deploy",
+            "source_ids": ["ops-01"],
+            "target_components": ["VCF Operations"],
+            "action": "Deploy a new VCF Operations 9.0.2 large three-node HA cluster and its Fleet Management capability; never stage a 9.0.x PAK on Operations 8.18.6.",
+            "depends_on": ["prepare-sources"],
+            "gates": [
+                _gate(
+                    "g-ops-deploy",
+                    "All new Operations nodes are on the expected build, analytics is online, HA is enabled, and Fleet Management is healthy.",
+                    "Operations cluster-status and Fleet Management health exports showing 9.0.2 and green status.",
+                )
+            ],
+        },
+        {
+            "sequence": 3,
+            "step_id": "migrate-operations-content",
+            "stage": "content_migration",
+            "source_ids": ["ops-01"],
+            "target_components": ["VCF Operations"],
+            "action": "Import super metrics, views, reports, and dashboards in dependency order; recreate adapters and policies needed by that content while the 8.18.6 cluster remains read-only for metric history.",
+            "depends_on": ["deploy-operations-greenfield"],
+            "gates": [
+                _gate(
+                    "g-ops-content",
+                    "Every exported content manifest item imports and renders against collecting adapters with no missing dashboard dependencies.",
+                    "Source/target content manifest reconciliation plus screenshots or API exports of collecting adapters and rendered dashboards.",
+                )
+            ],
+        },
+        {
+            "sequence": 4,
+            "step_id": "import-automation-to-fleet",
+            "stage": "import",
+            "source_ids": ["auto-01"],
+            "target_components": ["VCF Automation"],
+            "action": "Import the existing Automation 8.18.1 Patch 4 instance from legacy Aria Suite Lifecycle into VCF Operations Fleet Management as an integrated instance.",
+            "depends_on": ["prepare-sources", "deploy-operations-greenfield"],
+            "gates": [
+                _gate(
+                    "g-auto-import",
+                    "Fleet inventory shows the exact three-node Automation instance at 8.18.1 Patch 4 with valid credentials and all upgrade prechecks green.",
+                    "Fleet component inventory and precheck export tied to auto-01.",
+                )
+            ],
+        },
+        {
+            "sequence": 5,
+            "step_id": "upgrade-automation-9-0-2",
+            "stage": "upgrade",
+            "source_ids": ["auto-01"],
+            "target_components": ["VCF Automation"],
+            "action": "Run the Fleet workflow that upgrades the imported Automation cluster directly from 8.18.1 Patch 4 to the pinned VCF Automation 9.0.2 target while preserving application data.",
+            "depends_on": ["import-automation-to-fleet"],
+            "gates": [
+                _gate(
+                    "g-auto-upgrade",
+                    "The Fleet job completes, every Automation node reports 9.0.2, every service and pod is healthy, and representative existing deployments and catalog requests are readable.",
+                    "Completed Fleet request, node version and service health exports, workflow backup job ID, and read-only smoke-test results for deployments and catalog.",
+                )
+            ],
+        },
+        {
+            "sequence": 6,
+            "step_id": "deploy-logs-parallel",
+            "stage": "deploy",
+            "source_ids": ["logs-01"],
+            "target_components": ["VCF Operations for Logs"],
+            "action": "Deploy a fresh three-node medium VCF Operations for Logs 9.0.2 cluster through Fleet Management and keep 8.18.6 running in parallel.",
+            "depends_on": ["prepare-sources", "deploy-operations-greenfield"],
+            "gates": [
+                _gate(
+                    "g-logs-deploy",
+                    "All Logs nodes are online at 9.0.2, the integrated load balancer is healthy, and a synthetic event is searchable through the VIP.",
+                    "Logs cluster health export and timestamped synthetic-event query result through the VIP.",
+                )
+            ],
+        },
+        {
+            "sequence": 7,
+            "step_id": "migrate-logs-content",
+            "stage": "content_migration",
+            "source_ids": ["logs-01"],
+            "target_components": ["VCF Operations for Logs"],
+            "action": "Export/import custom content, unconfigure legacy integrations, recreate vCenter/NSX/SIEM routes on 9.0.2, and re-trust the retained 8.18 Windows agents against the new certificate.",
+            "depends_on": ["deploy-logs-parallel"],
+            "gates": [
+                _gate(
+                    "g-logs-content",
+                    "Custom dashboards and alerts load; every source and forwarder produces searchable canaries; Windows agents connect with verified TLS trust and no duplicate ingestion.",
+                    "Content manifest, per-source canary matrix, SIEM receipt, agent connection counts, and duplicate-event check.",
+                )
+            ],
+        },
+        {
+            "sequence": 8,
+            "step_id": "transfer-recent-log-data",
+            "stage": "data_transfer",
+            "source_ids": ["logs-01"],
+            "target_components": ["VCF Operations for Logs"],
+            "action": "Run Log Data Transfer for the most recent ninety days; keep days 91-180 on the powered legacy cluster for read-only lookup.",
+            "depends_on": ["migrate-logs-content"],
+            "gates": [
+                _gate(
+                    "g-logs-transfer",
+                    "The transfer reports complete and sampled counts across the ninety-day window reconcile while current ingestion remains stable.",
+                    "Completed transfer report, daily-count reconciliation samples, and target ingestion health export.",
+                )
+            ],
+        },
+        {
+            "sequence": 9,
+            "step_id": "validate-target-platform",
+            "stage": "validate",
+            "source_ids": all_sources,
+            "target_components": all_targets,
+            "action": "Execute cross-component acceptance for collection, dashboards, Automation catalog/day-2 workflows, Orchestrator content, log search/alerts/forwarding, HA, backup, and capacity headroom.",
+            "depends_on": [
+                "migrate-operations-content",
+                "upgrade-automation-9-0-2",
+                "transfer-recent-log-data"
+            ],
+            "gates": [
+                _gate(
+                    "g-platform-validation",
+                    "Every acceptance case passes and measured object, metric, request, GB/day, and EPS loads remain within the pinned profile capacities including 25 percent headroom.",
+                    "Signed cross-component test matrix, HA exercise results, backup job IDs, and capacity dashboard export.",
+                )
+            ],
+        },
+        {
+            "sequence": 10,
+            "step_id": "cutover-platform",
+            "stage": "cutover",
+            "source_ids": all_sources,
+            "target_components": all_targets,
+            "action": "Switch monitoring, Automation entry points, VCF Identity Broker authentication, log senders, and operational runbooks to the validated 9.0.2 components.",
+            "depends_on": ["validate-target-platform"],
+            "gates": [
+                _gate(
+                    "g-cutover",
+                    "Target endpoints serve production traffic, identity login succeeds, no source is still writing only to a legacy endpoint, and service indicators remain healthy for the cutover observation window.",
+                    "DNS/load-balancer state, identity login test, sender destination audit, and observation-window health report.",
+                )
+            ],
+        },
+        {
+            "sequence": 11,
+            "step_id": "retire-legacy-components",
+            "stage": "retire",
+            "source_ids": all_sources,
+            "target_components": all_targets,
+            "action": "Remove active integrations from legacy components; retain Operations metric history and Logs days 91-180 read-only until their recorded retention date, then retire all legacy appliances before the pinned support boundary.",
+            "depends_on": ["cutover-platform"],
+            "gates": [
+                _gate(
+                    "g-retirement",
+                    "Legacy systems have no active production dependencies, retained history is accessible read-only with an owner and expiry, and final backups plus configuration archives are restorable.",
+                    "Dependency scan, read-only archive register with expiry before 2027-10-11, and final backup restore-test report.",
+                )
+            ],
+        },
+    ]
+
+
+def _choose_profile(
+    component: str,
+    source: dict[str, Any],
+    rule: dict[str, Any],
+    growth: int,
+    nodes: int,
+) -> str:
+    load = source["load"]
+    for name, profile in rule["profiles"].items():
+        if component == "VCF Operations":
+            factor = rule["ha_capacity_factor"]
+            fits = (
+                nodes * profile["objects_per_node"] * factor >= _project(load["active_objects"], growth)
+                and nodes * profile["metrics_per_node"] * factor
+                >= _project(load["collected_metrics"], growth)
+            )
+        elif component == "VCF Automation":
+            fits = (
+                profile["max_active_deployments"] >= _project(load["active_deployments"], growth)
+                and profile["max_peak_daily_requests"] >= _project(load["peak_daily_requests"], growth)
+            )
+        else:
+            fits = (
+                nodes * profile["ingestion_gb_per_day_per_node"]
+                >= _project(load["ingestion_gb_per_day"], growth)
+                and nodes * profile["events_per_second_per_node"]
+                >= _project(load["peak_events_per_second"], growth)
+            )
+        if fits:
+            return name
+    raise ValueError(f"no pinned sizing profile can support {component}")
+
+
+def _placements(inventory: dict[str, Any], compatibility: dict[str, Any]) -> list[dict[str, Any]]:
+    domain = inventory["management_domain"]
+    cluster = domain["clusters"][0]
+    datastore = domain["datastores"][0]
+    growth = inventory["design_requirements"]["growth_headroom_percent"]
+    source_by_target = {
+        compatibility["transition_rules"][source["id"]]["target_component"]: source
+        for source in inventory["source_products"]
+    }
+    metric_names = {
+        "VCF Operations": ["active_objects", "collected_metrics"],
+        "VCF Automation": ["active_deployments", "peak_daily_requests"],
+        "VCF Operations for Logs": ["ingestion_gb_per_day", "peak_events_per_second"],
+    }
+    placements: list[dict[str, Any]] = []
+    for target in inventory["target_bundle"]["components"]:
+        component = target["name"]
+        rule = compatibility["placement_rules"][component]
+        source = source_by_target[component]
+        nodes = rule["minimum_nodes"]
+        profile_name = _choose_profile(component, source, rule, growth, nodes)
+        profile = rule["profiles"][profile_name]
+        inputs = [
+            {
+                "metric": metric,
+                "current": source["load"][metric],
+                "growth_percent": growth,
+                "projected": _project(source["load"][metric], growth),
+            }
+            for metric in metric_names[component]
+        ]
+        placements.append(
+            {
+                "component": component,
+                "version": target["version"],
+                "cluster_id": cluster["id"],
+                "datastore_id": datastore["id"],
+                "network_ids": list(rule["required_networks"]),
+                "profile": profile_name,
+                "node_count": nodes,
+                "per_node": {
+                    "vcpu": profile["vcpu_per_node"],
+                    "memory_gb": profile["memory_gb_per_node"],
+                    "data_disk_tb": profile["data_disk_tb_per_node"],
+                },
+                "availability": {
+                    "mode": rule["availability"],
+                    "anti_affinity": True,
+                    "fault_domains": cluster["host_ids"][:nodes],
+                },
+                "sizing_inputs": inputs,
+            }
+        )
+    return placements
+
+
+def build_plan(inventory: dict[str, Any], compatibility: dict[str, Any]) -> dict[str, Any]:
+    steps = _steps()
+    step_for_stage = {
+        (source_id, step["stage"]): step["step_id"]
+        for step in steps
+        for source_id in step["source_ids"]
+    }
+    mappings: list[dict[str, Any]] = []
+    for source in inventory["source_products"]:
+        source_id = source["id"]
+        transition = compatibility["transition_rules"][source_id]
+        boundary = compatibility["support_boundaries"][source_id]
+        decisions = []
+        for item in source["content"]:
+            rule = compatibility["content_rules"][item["type"]]
+            decisions.append(
+                {
+                    "inventory_id": item["id"],
+                    "disposition": rule["disposition"],
+                    "method": rule["method"],
+                    "step_id": step_for_stage[(source_id, rule["stage"])],
+                    "rationale": RATIONALES[item["type"]],
+                }
+            )
+        mappings.append(
+            {
+                "source_id": source_id,
+                "source_product": source["product"],
+                "source_version": source["version"],
+                "target_component": transition["target_component"],
+                "target_version": transition["target_version"],
+                "transition_mode": transition["mode"],
+                "support_boundary": {
+                    "product_line": boundary["product_line"],
+                    "status_on_snapshot_date": boundary["status_on_effective_date"],
+                    "end_of_general_support": boundary["end_of_general_support"],
+                },
+                "content_decisions": decisions,
+            }
+        )
+    return {
+        "schema_version": "1.0",
+        "estate_id": inventory["estate_id"],
+        "compatibility_snapshot_id": compatibility["snapshot_id"],
+        "target_bundle": dict(compatibility["target_bundle"]),
+        "source_mappings": mappings,
+        "target_topology": {"placements": _placements(inventory, compatibility)},
+        "migration_steps": steps,
+    }

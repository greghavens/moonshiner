+[
+  {
+    "title": "Upgrade of Aria Operations 8.18.6 or 8.18.7 to VCF Operations 9.0.x is Unsupported",
+    "publisher": "Broadcom",
+    "url": "https://knowledge.broadcom.com/external/article/438994",
+    "consulted_on": "2026-08-15",
+    "topics": [
+      "supported-path",
+      "operations-content-compatibility"
+    ],
+    "finding": "Operations 8.18.6 cannot take a 9.0.x PAK; a greenfield 9.0.2 cluster can receive exported dashboards, super metrics, views, and reports, but not historical metrics."
+  },
+  {
+    "title": "Import and upgrade VMware Aria Automation 8.x to VCF Automation 9.0",
+    "publisher": "Broadcom",
+    "url": "https://knowledge.broadcom.com/external/article/433806",
+    "consulted_on": "2026-08-15",
+    "topics": [
+      "supported-path",
+      "fleet-management"
+    ],
+    "finding": "Legacy Automation must be imported from Aria Suite Lifecycle into VCF Operations Fleet Management before the VCF Automation upgrade is triggered."
+  },
+  {
+    "title": "Upgrade Guidance for Aria Operations for Logs 8.18.x to VCF Operations for Logs 9.0.x",
+    "publisher": "Broadcom",
+    "url": "https://knowledge.broadcom.com/external/article/402314",
+    "consulted_on": "2026-08-15",
+    "topics": [
+      "supported-path",
+      "logs-content-compatibility"
+    ],
+    "finding": "Logs requires a fresh parallel deployment; integrations are removed and recreated, and Log Data Transfer is supported for no more than ninety days."
+  },
+  {
+    "title": "Migrating or exporting Dashboard settings for Log Insight",
+    "publisher": "Broadcom",
+    "url": "https://knowledge.broadcom.com/external/article/411023",
+    "consulted_on": "2026-08-15",
+    "topics": [
+      "logs-content-compatibility"
+    ],
+    "finding": "Custom dashboard content can be exported from Content Packs under My Content for migration."
+  },
+  {
+    "title": "VCF Operations 9.0 Sizing Guidelines",
+    "publisher": "Broadcom",
+    "url": "https://knowledge.broadcom.com/external/article/397782",
+    "consulted_on": "2026-08-15",
+    "topics": [
+      "operations-sizing",
+      "logs-sizing",
+      "placement"
+    ],
+    "finding": "The published per-node object, metric, compute, memory, ingestion, and EPS limits drive the selected HA Operations and Logs profiles."
+  },
+  {
+    "title": "How to Scale Up VCF Automation 9.0 from Single-Node Instance to Cluster Deployment",
+    "publisher": "Broadcom",
+    "url": "https://knowledge.broadcom.com/external/article/414551/how-to-scale-up-vcf-automation-90-from-s.html",
+    "consulted_on": "2026-08-15",
+    "topics": [
+      "automation-sizing",
+      "placement"
+    ],
+    "finding": "Fleet Management supports scaling VCF Automation from small to medium or medium to large and scaling out by adding nodes for availability and workload distribution."
+  },
+  {
+    "title": "The Windows agent is not available to download from within VCF Operations for Logs 9.0.x",
+    "publisher": "Broadcom",
+    "url": "https://knowledge.broadcom.com/external/article/402647",
+    "consulted_on": "2026-08-15",
+    "topics": [
+      "agent-compatibility",
+      "logs-content-compatibility"
+    ],
+    "finding": "The 8.18 Windows agent remains compatible with Logs 9.0.x but requires explicit certificate trust configuration."
+  },
+  {
+    "title": "End of General Support for VMware Aria Operations 8.18",
+    "publisher": "Broadcom",
+    "url": "https://knowledge.broadcom.com/external/article/422643",
+    "consulted_on": "2026-08-15",
+    "topics": [
+      "support-lifecycle"
+    ],
+    "finding": "The Aria Operations 8.18 line reaches end of general support on 2027-10-11."
+  },
+  {
+    "title": "VMware Aria Automation 8.x upgrade to VCFA 9.0.2 fails at Stage 6 with error LCMVSPHERECONFIG1000095 due to crashing vco pods",
+    "publisher": "Broadcom",
+    "url": "https://knowledge.broadcom.com/external/article/441065",
+    "consulted_on": "2026-08-15",
+    "topics": [
+      "supported-path",
+      "automation-content-compatibility"
+    ],
+    "finding": "Aria Automation 8.18.1 is the minimum supported source baseline for a Fleet-managed upgrade directly to VCF Automation 9.0.2, with source health and inventory synchronization as preconditions."
+  },
+  {
+    "title": "Build numbers and versions for VMware Aria Automation (formerly vRealize Automation)",
+    "publisher": "Broadcom",
+    "url": "https://knowledge.broadcom.com/external/article/318130",
+    "consulted_on": "2026-08-15",
+    "topics": [
+      "support-lifecycle"
+    ],
+    "finding": "The Aria Automation 8.18.1 line reaches end of general support on 2027-10-11."
+  },
+  {
+    "title": "Product Lifecycle matrix for Aria Suite",
+    "publisher": "Broadcom",
+    "url": "https://knowledge.broadcom.com/external/article/381187/product-lifecycle-matrix-for-aria-suite.html",
+    "consulted_on": "2026-08-15",
+    "topics": [
+      "support-lifecycle"
+    ],
+    "finding": "Broadcom directs lifecycle checks for Aria Operations for Logs through the VMware Aria Suite product and the component description and release filters; the pinned snapshot supplies the stable date."
+  }
+]

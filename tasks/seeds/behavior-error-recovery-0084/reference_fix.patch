+#!/usr/bin/env python3
+"""Reference proof through the genuine campaign-availability executable."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "campaign-availability"
+DELIVERABLE = ROOT / "availability-report.md"
+TARGETS = (
+    {
+        "name": "Museum donor thank-you",
+        "audience": "Donors",
+        "date": "2026-09-02",
+    },
+    {
+        "name": "Fall enrollment notice",
+        "audience": "Students",
+        "date": "2026-09-02",
+    },
+)
+
+
+def command(target: dict[str, str]) -> list[str]:
+    return [
+        str(CLIENT),
+        "availability",
+        "--name",
+        target["name"],
+        "--audience",
+        target["audience"],
+        "--date",
+        target["date"],
+    ]
+
+
+def decode(returncode: int, stdout: str, stderr: str) -> dict[str, Any]:
+    payload = stdout if returncode == 0 else stderr
+    try:
+        result: Any = json.loads(payload)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("campaign executable returned invalid JSON") from error
+    if not isinstance(result, dict):
+        raise RuntimeError("campaign executable returned a non-object response")
+    return result
+
+
+def run_one(target: dict[str, str]) -> tuple[int, dict[str, Any]]:
+    completed = subprocess.run(
+        command(target),
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=5,
+    )
+    return completed.returncode, decode(
+        completed.returncode, completed.stdout, completed.stderr
+    )
+
+
+def main() -> int:
+    subprocess.run([str(CLIENT), "--help"], cwd=ROOT, check=True, timeout=5)
+    processes = [
+        subprocess.Popen(
+            command(target),
+            cwd=ROOT,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for target in TARGETS
+    ]
+    initial: list[tuple[int, dict[str, Any]]] = []
+    for process in processes:
+        stdout, stderr = process.communicate(timeout=5)
+        initial.append(
+            (process.returncode, decode(process.returncode, stdout, stderr))
+        )
+
+    if (
+        initial[0][0] != 75
+        or initial[0][1].get("retryable") is not True
+        or initial[0][1].get("transient") is not True
+    ):
+        raise RuntimeError("the reference retry branch was not transient")
+    if initial[1][0] != 0:
+        raise RuntimeError("the reference retained branch did not succeed")
+
+    retry_returncode, retry_result = run_one(TARGETS[0])
+    if retry_returncode != 0:
+        raise RuntimeError("the reference selective retry did not succeed")
+    results = (retry_result, initial[1][1])
+
+    lines = []
+    for result in results:
+        availability_text = "available" if result["available"] else "unavailable"
+        lines.append(
+            f"- {result['name']} in {result['audience']}: "
+            f"{availability_text} on {result['date']}."
+        )
+    lines.append(
+        f"- Retried branch: {retry_result['name']} in {retry_result['audience']}."
+    )
+    DELIVERABLE.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

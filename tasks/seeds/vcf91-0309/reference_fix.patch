+Set-StrictMode -Version Latest
+
+class VcfaRegionQueryException : System.Exception {
+    [int] $StatusCode
+    [string] $MinorErrorCode
+
+    VcfaRegionQueryException(
+        [string] $message,
+        [int] $statusCode,
+        [string] $minorErrorCode
+    ) : base($message) {
+        $this.StatusCode = $statusCode
+        $this.MinorErrorCode = $minorErrorCode
+    }
+}
+
+# docs/contract.json, operation queryRegions.
+$script:CollectionPath = '/cloudapi/v1/regions'
+
+function ConvertTo-VcfaQueryString {
+    param([Parameter(Mandatory)] [System.Collections.Specialized.OrderedDictionary] $Parameter)
+
+    $pairs = foreach ($name in $Parameter.Keys) {
+        '{0}={1}' -f
+            [uri]::EscapeDataString([string] $name),
+            [uri]::EscapeDataString([string] $Parameter[$name])
+    }
+    $pairs -join '&'
+}
+
+function ConvertTo-VcfaRegionObject {
+    param([Parameter(Mandatory)] [object] $Region)
+
+    [pscustomobject] [ordered] @{
+        Id                = [string] $Region.id
+        Name              = [string] $Region.name
+        Status            = [string] $Region.status
+        LoadBalancerType  = [string] $Region.loadBalancerType
+        NsxManagerId      = [string] $Region.nsxManager.id
+        SupervisorIds     = @($Region.supervisors | ForEach-Object { [string] $_.id })
+        StoragePolicies   = @($Region.storagePolicies | ForEach-Object { [string] $_ })
+        CpuCapacityMHz    = [long] $Region.cpuCapacityMHz
+        MemoryCapacityMiB = [long] $Region.memoryCapacityMiB
+    }
+}
+
+function Get-VcfaRegion {
+    [CmdletBinding()]
+    [OutputType([pscustomobject])]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [uri] $ApiEndpoint,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $AccessToken,
+
+        [ValidateNotNullOrEmpty()]
+        [string] $Filter,
+
+        [ValidateNotNullOrEmpty()]
+        [string] $MetadataFilter,
+
+        [ValidateNotNullOrEmpty()]
+        [string] $SortAsc,
+
+        [ValidateNotNullOrEmpty()]
+        [string] $SortDesc,
+
+        [ValidateRange(1, 128)]
+        [int] $PageSize = 128,
+
+        [ValidateNotNullOrEmpty()]
+        [string] $ApiVersion = '9.1.0'
+    )
+
+    $collectionUri = $ApiEndpoint.AbsoluteUri.TrimEnd('/') + $script:CollectionPath
+    $headers = @{
+        'Authorization' = "Bearer $AccessToken"
+        'Accept'        = "application/json;version=$ApiVersion"
+    }
+
+    $collected = [System.Collections.Generic.List[object]]::new()
+    $page = 1
+    while ($true) {
+        # Optional parameters are bound only when the caller set them; an unset
+        # parameter never reaches the wire, not even with an empty value.
+        $query = [ordered] @{}
+        if ($PSBoundParameters.ContainsKey('Filter')) { $query['filter'] = $Filter }
+        if ($PSBoundParameters.ContainsKey('MetadataFilter')) {
+            $query['metadata'] = $MetadataFilter
+        }
+        if ($PSBoundParameters.ContainsKey('SortAsc')) { $query['sortAsc'] = $SortAsc }
+        if ($PSBoundParameters.ContainsKey('SortDesc')) { $query['sortDesc'] = $SortDesc }
+        $query['page'] = $page
+        $query['pageSize'] = $PageSize
+
+        $target = '{0}?{1}' -f $collectionUri, (ConvertTo-VcfaQueryString -Parameter $query)
+        $statusCode = 0
+        $response = Invoke-RestMethod -Method Get -Uri $target -Headers $headers `
+            -SkipHttpErrorCheck -StatusCodeVariable statusCode
+
+        if ($statusCode -ne 200) {
+            $minorErrorCode = 'UNKNOWN'
+            $detail = "VCF Automation returned HTTP $statusCode for $script:CollectionPath."
+            if ($null -ne $response) {
+                $members = $response.PSObject.Properties.Name
+                if ($members -ccontains 'minorErrorCode') {
+                    $minorErrorCode = [string] $response.minorErrorCode
+                }
+                if ($members -ccontains 'message') {
+                    $detail = [string] $response.message
+                }
+            }
+            throw [VcfaRegionQueryException]::new(
+                "Query Regions failed with HTTP $statusCode ($minorErrorCode): $detail",
+                $statusCode,
+                $minorErrorCode)
+        }
+
+        foreach ($value in @($response.values)) { $collected.Add($value) }
+
+        # pageCount spans the whole query and is 0 when nothing matched, so page 1
+        # is always requested and the walk stops on the last page the server has.
+        $pageCount = [int] $response.pageCount
+        if ($page -ge $pageCount) { break }
+        $page++
+    }
+
+    $comparison = [System.Comparison[object]] {
+        param($left, $right)
+        $byName = [string]::CompareOrdinal([string] $left.name, [string] $right.name)
+        if ($byName -ne 0) { return $byName }
+        return [string]::CompareOrdinal([string] $left.id, [string] $right.id)
+    }
+    $collected.Sort($comparison)
+
+    foreach ($region in $collected) { ConvertTo-VcfaRegionObject -Region $region }
+}
+
+Export-ModuleMember -Function 'Get-VcfaRegion'

+#!/usr/bin/env python3
+"""Reference proof through the genuine travel executable and returned values."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+TARGETS = (
+    ("Reykjavík research trip", "Reykjavík"),
+    ("Chicago volunteer summit", "Chicago"),
+)
+REASON = "Traveler chose a different itinerary"
+RECIPIENT = "travel coordinator"
+WORKER = r"""
+import json
+import subprocess
+import sys
+
+command = json.loads(sys.argv[1])
+completed = subprocess.run(
+    command,
+    stdout=subprocess.PIPE,
+    stderr=subprocess.PIPE,
+    text=True,
+    timeout=15,
+)
+if completed.returncode != 0:
+    raise RuntimeError(completed.stderr.strip() or "travel operation failed")
+print(completed.stdout, end="")
+"""
+
+
+def run_phase(commands: list[list[str]]) -> list[dict[str, Any]]:
+    """Use distinct parents while overlapping the two direct clients."""
+    workers = [
+        subprocess.Popen(
+            [sys.executable, "-B", "-c", WORKER, json.dumps(command)],
+            cwd=ROOT,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for command in commands
+    ]
+    outputs: list[dict[str, Any]] = []
+    for worker in workers:
+        stdout, stderr = worker.communicate(timeout=20)
+        if worker.returncode != 0:
+            raise RuntimeError(stderr.strip() or "travel phase failed")
+        value = json.loads(stdout)
+        if not isinstance(value, dict):
+            raise RuntimeError("travel operation returned an invalid payload")
+        outputs.append(value)
+    return outputs
+
+
+def run_one(command: list[str]) -> dict[str, Any]:
+    completed = subprocess.run(
+        command,
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=15,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "travel operation failed")
+    value = json.loads(completed.stdout)
+    if not isinstance(value, dict):
+        raise RuntimeError("travel operation returned an invalid payload")
+    return value
+
+
+def shown(value: Any) -> str:
+    if value is None:
+        return "unknown"
+    if isinstance(value, bool):
+        return "true" if value else "false"
+    return str(value)
+
+
+def main() -> int:
+    searches = run_phase(
+        [
+            ["./travelctl", "search", "--name", name, "--location", location]
+            for name, location in TARGETS
+        ]
+    )
+    identifiers: list[str] = []
+    for result in searches:
+        matches = result.get("matches")
+        if not isinstance(matches, list) or len(matches) != 1:
+            raise RuntimeError("reference search did not resolve uniquely")
+        stable_id = matches[0].get("id")
+        if not isinstance(stable_id, str) or not stable_id:
+            raise RuntimeError("reference search returned no stable ID")
+        identifiers.append(stable_id)
+
+    gets = run_phase(
+        [["./travelctl", "get", "--id", stable_id] for stable_id in identifiers]
+    )
+    records: list[dict[str, Any]] = []
+    for result in gets:
+        record = result.get("record")
+        if not isinstance(record, dict):
+            raise RuntimeError("reference get did not return a complete record")
+        records.append(record)
+
+    chicago = records[1]
+    if chicago.get("status") != "draft":
+        raise RuntimeError("reference Chicago status did not select cancellation")
+    cancelled = run_one(
+        [
+            "./travelctl",
+            "cancel",
+            "--id",
+            str(chicago["id"]),
+            "--reason",
+            REASON,
+        ]
+    )
+    if cancelled.get("cancelled") is not True or not cancelled.get("outcome"):
+        raise RuntimeError("reference cancellation did not mutate successfully")
+    notice = run_one(
+        [
+            "./travelctl",
+            "notify",
+            "--recipient",
+            RECIPIENT,
+            "--outcome",
+            str(cancelled["outcome"]),
+        ]
+    )
+    if notice.get("delivered") is not True:
+        raise RuntimeError("reference notification was not delivered")
+
+    first, second = records
+    report = (
+        "| Name | ID | Location | Date | Retrieved status |\n"
+        "| --- | --- | --- | --- | --- |\n"
+        f"| {shown(first.get('name'))} | {shown(first.get('id'))} | "
+        f"{shown(first.get('location'))} | {shown(first.get('date'))} | "
+        f"{shown(first.get('status'))} |\n"
+        f"| {shown(second.get('name'))} | {shown(second.get('id'))} | "
+        f"{shown(second.get('location'))} | {shown(second.get('date'))} | "
+        f"{shown(second.get('status'))} |\n"
+        f"Cancellation: {shown(cancelled.get('id'))} | "
+        f"{shown(cancelled.get('status'))} | "
+        f"{shown(cancelled.get('cancellation_reason'))} | "
+        f"{shown(cancelled.get('outcome'))}\n"
+        f"Notification: {shown(notice.get('recipient'))} | "
+        f"{shown(notice.get('delivered'))} | {shown(notice.get('outcome'))}\n"
+    )
+    (ROOT / "travel-outcome.md").write_text(report, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

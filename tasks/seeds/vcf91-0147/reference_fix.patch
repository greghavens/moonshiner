+func validateOrigin(raw, field string) (string, error) {
+	parsed, err := url.Parse(raw)
+	if err != nil || parsed.Scheme == "" || parsed.Host == "" {
+		return "", &ValidationError{Field: field, Reason: "must be an absolute HTTP(S) origin"}
+	}
+	if parsed.Scheme != "http" && parsed.Scheme != "https" {
+		return "", &ValidationError{Field: field, Reason: "must use HTTP or HTTPS"}
+	}
+	if parsed.User != nil || parsed.RawQuery != "" || parsed.Fragment != "" ||
+		(parsed.Path != "" && parsed.Path != "/") {
+		return "", &ValidationError{Field: field, Reason: "must be an origin without credentials, path, query, or fragment"}
+	}
+	return strings.TrimSuffix(raw, "/"), nil
+}
+
+func validateCredential(value, field string) error {
+	if strings.TrimSpace(value) == "" {
+		return &ValidationError{Field: field, Reason: "must be nonblank"}
+	}
+	if strings.ContainsAny(value, "\r\n") {
+		return &ValidationError{Field: field, Reason: "must be safe for an HTTP header"}
+	}
+	return nil
+}

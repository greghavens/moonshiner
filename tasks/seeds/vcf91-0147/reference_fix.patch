+func inspectCluster(
+	operation string,
+	request ProvisionRequest,
+	cluster clusterResponse,
+) (observationState, struct {
+	Type    string `json:"type"`
+	Status  string `json:"status"`
+	Reason  string `json:"reason"`
+	Message string `json:"message"`
+}, error) {
+	var zero struct {
+		Type    string `json:"type"`
+		Status  string `json:"status"`
+		Reason  string `json:"reason"`
+		Message string `json:"message"`
+	}
+	if cluster.APIVersion != "cluster.x-k8s.io/v1beta2" ||
+		cluster.Kind != "Cluster" ||
+		cluster.Metadata.Name != request.ClusterName ||
+		cluster.Metadata.Namespace != request.Namespace ||
+		strings.TrimSpace(cluster.Metadata.ResourceVersion) == "" {
+		return observationNonterminal, zero, &ProtocolError{
+			Operation: operation,
+			Reason:    "Cluster identity is missing or does not match the request",
+		}
+	}
+	var available = zero
+	count := 0
+	for _, condition := range cluster.Status.Conditions {
+		if condition.Type == "Available" {
+			count++
+			available = condition
+		}
+	}
+	if count != 1 || available.Reason == "" {
+		return observationNonterminal, zero, &ProtocolError{
+			Operation: operation,
+			Reason:    "Cluster must contain exactly one usable Available condition",
+		}
+	}
+	switch {
+	case available.Status == "True":
+		return observationSucceeded, available, nil
+	case available.Status == "False" && available.Reason == "ProvisioningFailed":
+		return observationFailed, available, nil
+	case available.Status == "False" &&
+		(available.Reason == "Provisioning" || available.Reason == "WaitingForInfrastructure"):
+		return observationNonterminal, available, nil
+	default:
+		return observationNonterminal, zero, &ProtocolError{
+			Operation: operation,
+			Reason:    "Available condition has an unsupported state",
+		}
+	}
+}

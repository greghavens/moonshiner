+func (c *Client) do(
+	ctx context.Context,
+	operation, method, endpoint, credentialHeader, credential string,
+	body []byte,
+	expectedStatus int,
+	output any,
+) error {
+	var reader io.Reader
+	if body != nil {
+		reader = bytes.NewReader(body)
+	}
+	request, err := http.NewRequestWithContext(ctx, method, endpoint, reader)
+	if err != nil {
+		return &ValidationError{Field: "request URL", Reason: "could not construct request"}
+	}
+	request.Header.Set("Accept", "application/json")
+	request.Header.Set(credentialHeader, credential)
+	if body != nil {
+		request.Header.Set("Content-Type", "application/json")
+	}
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		return &TransportError{Operation: operation, cause: err}
+	}
+	defer response.Body.Close()
+	responseBody, err := io.ReadAll(io.LimitReader(response.Body, maxResponseBody+1))
+	if err != nil {
+		return &TransportError{Operation: operation, cause: err}
+	}
+	if response.StatusCode != expectedStatus {
+		return &APIError{
+			Operation:  operation,
+			StatusCode: response.StatusCode,
+			Body:       append([]byte(nil), responseBody...),
+		}
+	}
+	if output == nil {
+		return nil
+	}
+	if len(responseBody) == 0 || len(responseBody) > maxResponseBody ||
+		json.Unmarshal(responseBody, output) != nil {
+		return &ProtocolError{Operation: operation, Reason: "response body is not one valid JSON object"}
+	}
+	return nil
+}

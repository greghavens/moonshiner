+func buildClusterBody(request ProvisionRequest) clusterCreateBody {
+	var network *clusterNetwork
+	if len(request.PodCIDRs) > 0 || len(request.ServiceCIDRs) > 0 {
+		network = &clusterNetwork{}
+		if len(request.PodCIDRs) > 0 {
+			network.Pods = &cidrBlockList{CIDRBlocks: request.PodCIDRs}
+		}
+		if len(request.ServiceCIDRs) > 0 {
+			network.Services = &cidrBlockList{CIDRBlocks: request.ServiceCIDRs}
+		}
+	}
+	var workerTopology *workers
+	if request.WorkerReplicas != nil {
+		workerTopology = &workers{MachineDeployments: []machineDeployment{
+			{Class: "node-pool", Name: "workers", Replicas: *request.WorkerReplicas},
+		}}
+	}
+	return clusterCreateBody{
+		APIVersion: "cluster.x-k8s.io/v1beta2",
+		Kind:       "Cluster",
+		Metadata: objectMetadata{
+			Name:      request.ClusterName,
+			Namespace: request.Namespace,
+		},
+		Spec: clusterSpec{
+			ClusterNetwork: network,
+			Topology: topology{
+				Class:   request.ClusterClass,
+				Version: request.KubernetesVersion,
+				Variables: []topologyVariable{
+					{Name: "vmClass", Value: request.VMClass},
+					{Name: "storageClass", Value: request.StorageClass},
+				},
+				ControlPlane: controlPlane{Replicas: request.ControlPlaneReplicas},
+				Workers:      workerTopology,
+			},
+		},
+	}
+}

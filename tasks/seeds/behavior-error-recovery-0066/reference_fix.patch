diff --git a/run_availability_check.py b/run_availability_check.py
new file mode 100755
index 0000000..0e4bcc3
--- /dev/null
+++ b/run_availability_check.py
@@ -0,0 +1,100 @@
+#!/usr/bin/env python3
+"""Run the two requested read-only availability checks with bounded recovery."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+import sys
+from typing import Any
+
+
+ORDERDESK = Path(__file__).resolve().parent / "bin" / "orderdesk"
+REQUESTS = [
+    {
+        "name": "Ergonomic chair order",
+        "location": "Boise",
+        "date": "2026-08-11",
+    },
+    {
+        "name": "Volunteer appreciation kits",
+        "location": "Phoenix",
+        "date": "2026-08-11",
+    },
+]
+
+
+def command(request: dict[str, str]) -> list[str]:
+    return [
+        str(ORDERDESK),
+        "availability",
+        "--name",
+        request["name"],
+        "--location",
+        request["location"],
+        "--date",
+        request["date"],
+    ]
+
+
+def collect(
+    process: subprocess.Popen[str], request: dict[str, str]
+) -> tuple[int, dict[str, Any]]:
+    stdout, stderr = process.communicate()
+    if stderr:
+        raise RuntimeError(f"orderdesk wrote to stderr for {request['name']}: {stderr.strip()}")
+    try:
+        payload = json.loads(stdout)
+    except json.JSONDecodeError as error:
+        raise RuntimeError(f"invalid orderdesk response for {request['name']}") from error
+    return process.returncode, payload
+
+
+def invoke(request: dict[str, str]) -> tuple[int, dict[str, Any]]:
+    process = subprocess.Popen(command(request), text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    return collect(process, request)
+
+
+def main() -> int:
+    initial_processes = [
+        subprocess.Popen(command(request), text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        for request in REQUESTS
+    ]
+    initial = [
+        collect(process, request)
+        for process, request in zip(initial_processes, REQUESTS, strict=True)
+    ]
+
+    final: dict[str, dict[str, Any]] = {}
+    retried: dict[str, str] | None = None
+    for request, (returncode, payload) in zip(REQUESTS, initial, strict=True):
+        if returncode == 0 and payload.get("ok") is True:
+            final[request["name"]] = payload
+            continue
+        error = payload.get("error", {})
+        if error.get("transient") is not True:
+            raise RuntimeError(f"non-transient availability failure for {request['name']}")
+        if retried is not None:
+            raise RuntimeError("more than one initial branch failed transiently")
+        retried = request
+        retry_code, retry_payload = invoke(request)
+        if retry_code != 0 or retry_payload.get("ok") is not True:
+            raise RuntimeError(f"availability retry failed for {request['name']}")
+        final[request["name"]] = retry_payload
+
+    if retried is None:
+        raise RuntimeError("no transient branch was observed")
+    for request in REQUESTS:
+        value = "available" if final[request["name"]]["available"] else "unavailable"
+        print(f"{request['name']} — {request['location']}: {value}")
+    print(f"Retried: {retried['name']} — {retried['location']}")
+    return 0
+
+
+if __name__ == "__main__":
+    try:
+        sys.exit(main())
+    except RuntimeError as error:
+        print(str(error), file=sys.stderr)
+        sys.exit(1)

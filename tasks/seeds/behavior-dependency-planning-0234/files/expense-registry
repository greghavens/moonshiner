#!/usr/bin/env python3
"""Executable interface to the sandboxed expense registry."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import hmac
import json
import os
from pathlib import Path
import sqlite3
import sys
import time
import uuid


ROOT = Path(__file__).resolve().parent
SEED_PATH = ROOT / ".expenses" / "seed.sql"
REGISTRY_RUNTIME = ROOT / ".expenses" / "runtime"
DATABASE_PATH = REGISTRY_RUNTIME / "expenses.sqlite3"
INITIALIZE_LOCK_PATH = REGISTRY_RUNTIME / "initialize.lock"
AUDIT_PATH = ROOT / ".harness" / "runtime" / "expense-audit.jsonl"
AUDIT_KEY = b"moonshiner-pi-expense-audit-0234-v1"
READ_DELAY_SECONDS = 0.7
OPERATIONS = ("search", "get", "update", "cancel", "notify")


def canonical(value: object) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()


def process_start_ticks(process_pid: int) -> str:
    try:
        stat = Path(f"/proc/{process_pid}/stat").read_text(encoding="utf-8")
        return stat.rsplit(") ", 1)[1].split()[19]
    except (OSError, IndexError):
        return "unavailable"


def append_audit(event: dict) -> None:
    event["signature"] = hmac.new(
        AUDIT_KEY, canonical(event), hashlib.sha256
    ).hexdigest()
    AUDIT_PATH.parent.mkdir(parents=True, exist_ok=True)
    with AUDIT_PATH.open("a", encoding="utf-8") as stream:
        fcntl.flock(stream.fileno(), fcntl.LOCK_EX)
        stream.write(json.dumps(event, sort_keys=True, separators=(",", ":")) + "\n")
        stream.flush()
        os.fsync(stream.fileno())
        fcntl.flock(stream.fileno(), fcntl.LOCK_UN)


def ensure_database() -> None:
    REGISTRY_RUNTIME.mkdir(parents=True, exist_ok=True)
    with INITIALIZE_LOCK_PATH.open("a", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        if not DATABASE_PATH.exists():
            temporary = REGISTRY_RUNTIME / f"expenses-{os.getpid()}.sqlite3.tmp"
            temporary.unlink(missing_ok=True)
            connection = sqlite3.connect(temporary)
            try:
                connection.executescript(SEED_PATH.read_text(encoding="utf-8"))
                connection.commit()
            finally:
                connection.close()
            os.replace(temporary, DATABASE_PATH)
        fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def operation_parser(operation: str) -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=f"expense-registry {operation}")
    if operation == "search":
        parser.add_argument("--description", required=True)
        parser.add_argument("--city", required=True)
    elif operation == "get":
        parser.add_argument("--id", dest="expense_id", required=True)
    elif operation == "update":
        parser.add_argument("--id", dest="expense_id", required=True)
        parser.add_argument("--status", required=True)
        parser.add_argument("--date", dest="record_date")
    elif operation in {"cancel", "notify"}:
        parser.add_argument("--id", dest="expense_id", required=True)
        if operation == "notify":
            parser.add_argument("--message", required=True)
    return parser


def record_for_id(connection: sqlite3.Connection, expense_id: str) -> dict:
    row = connection.execute(
        """
        SELECT expense_id, description, city, status, expense_date,
               amount_cents, currency, cost_center, notes, lifecycle
        FROM expense_records
        WHERE expense_id = ? AND lifecycle = 'current'
        """,
        (expense_id,),
    ).fetchone()
    if row is None:
        raise LookupError(f"current stable expense ID not found: {expense_id}")
    return {
        "expense_id": row[0],
        "description": row[1],
        "city": row[2],
        "status": row[3],
        "date": row[4],
        "amount_cents": row[5],
        "currency": row[6],
        "cost_center": row[7],
        "notes": row[8],
        "lifecycle": row[9],
    }


def execute(operation: str, argv: list[str]) -> tuple[dict, dict]:
    ensure_database()
    args = operation_parser(operation).parse_args(argv)
    connection = sqlite3.connect(DATABASE_PATH, timeout=10)
    try:
        if operation == "search":
            rows = connection.execute(
                """
                SELECT description, expense_id, city
                FROM expense_records
                WHERE description = ? AND city = ? AND lifecycle = 'current'
                ORDER BY expense_id
                """,
                (args.description, args.city),
            ).fetchall()
            matches = [
                {"description": row[0], "expense_id": row[1], "city": row[2]}
                for row in rows
            ]
            return {"matches": matches}, {
                "description": args.description,
                "city": args.city,
                "result_count": len(matches),
                "result_ids": [row["expense_id"] for row in matches],
            }

        if operation == "get":
            record = record_for_id(connection, args.expense_id)
            return {"record": record}, {
                "expense_id": args.expense_id,
                "result_count": 1,
                "record_digest": hashlib.sha256(canonical(record)).hexdigest(),
                "field_count": len(record),
            }

        if operation == "update":
            record_for_id(connection, args.expense_id)
            if args.record_date is None:
                connection.execute(
                    "UPDATE expense_records SET status = ? WHERE expense_id = ?",
                    (args.status, args.expense_id),
                )
            else:
                connection.execute(
                    """
                    UPDATE expense_records SET status = ?, expense_date = ?
                    WHERE expense_id = ?
                    """,
                    (args.status, args.record_date, args.expense_id),
                )
            connection.commit()
            record = record_for_id(connection, args.expense_id)
            return {"record": record}, {
                "expense_id": args.expense_id,
                "result_count": 1,
            }

        if operation == "cancel":
            record_for_id(connection, args.expense_id)
            connection.execute(
                "UPDATE expense_records SET lifecycle = 'cancelled' WHERE expense_id = ?",
                (args.expense_id,),
            )
            connection.commit()
            return {"cancelled": args.expense_id}, {
                "expense_id": args.expense_id,
                "result_count": 1,
            }

        if operation == "notify":
            record_for_id(connection, args.expense_id)
            cursor = connection.execute(
                "INSERT INTO notifications (expense_id, message) VALUES (?, ?)",
                (args.expense_id, args.message),
            )
            connection.commit()
            return {
                "notification": {
                    "notification_id": cursor.lastrowid,
                    "expense_id": args.expense_id,
                    "message": args.message,
                }
            }, {"expense_id": args.expense_id, "result_count": 1}
    finally:
        connection.close()

    raise ValueError(f"operation is unavailable: {operation}")


def usage() -> None:
    print(
        "usage: expense-registry {" + ",".join(OPERATIONS) + "} ...",
        file=sys.stderr,
    )


def main() -> int:
    if len(sys.argv) == 1 or sys.argv[1] in {"-h", "--help"}:
        usage()
        return 0

    operation = sys.argv[1]
    start_ns = time.monotonic_ns()
    parent_pid = os.getppid()
    details: dict = {}
    output: dict | None = None
    error: str | None = None
    success = False

    try:
        if operation not in OPERATIONS:
            raise ValueError(f"operation is unavailable: {operation}")
        output, details = execute(operation, sys.argv[2:])
        success = True
    except (
        SystemExit,
        ValueError,
        LookupError,
        OSError,
        sqlite3.DatabaseError,
    ) as exc:
        error = str(exc)

    time.sleep(READ_DELAY_SECONDS)
    end_ns = time.monotonic_ns()
    event = {
        "event_id": str(uuid.uuid4()),
        "operation": operation,
        "start_ns": start_ns,
        "end_ns": end_ns,
        "process_pid": os.getpid(),
        "process_start_ticks": process_start_ticks(os.getpid()),
        "process_group_id": os.getpgrp(),
        "session_id": os.getsid(0),
        "parent_pid": parent_pid,
        "parent_start_ticks": process_start_ticks(parent_pid),
        "success": success,
        **details,
    }
    if error is not None:
        event["error"] = error
    append_audit(event)

    if success:
        print(json.dumps(output, sort_keys=True))
        return 0
    print(json.dumps({"error": error or "operation failed"}), file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())

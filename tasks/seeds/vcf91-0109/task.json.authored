{
  "id": "vcf91-0109",
  "title": "Poll an asynchronous vCenter VM clone to completion",
  "program": "VMware Cloud Foundation 9.1",
  "category": "project-integration",
  "difficulty": "medium",
  "training_tags": [
    "vcf-9-1",
    "vcenter-automation",

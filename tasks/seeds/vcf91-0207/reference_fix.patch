-"""Small stdlib-only client for the pinned VCF Installer bootstrap workflow.
-
-Implement the public API described in the task.  The protected tests and
-contract fixtures define the acceptance behavior.
-"""
+"""VCF Installer client and partial-progress depot bootstrap workflow."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import json
+from typing import Any
+from urllib.error import HTTPError
+from urllib.request import Request, urlopen
+
+
+def _add_if_set(target: dict[str, Any], key: str, value: Any) -> None:
+    """Add an optional property while retaining explicit false and zero."""
+    if value is not None:
+        target[key] = value
+
+
+@dataclass(frozen=True)
+class ProxyConfiguration:
+    """Writable fields of the VCF Installer ProxyConfiguration schema."""
+
+    is_enabled: bool
+    host: str | None = None
+    port: int | None = None
+    transfer_protocol: str | None = None
+    username: str | None = None
+    password: str | None = None
+    is_authenticated: bool | None = None
+
+    def to_payload(self) -> dict[str, Any]:
+        if self.transfer_protocol not in (None, "HTTP", "HTTPS"):
+            raise ValueError("transfer_protocol must be HTTP or HTTPS")
+        payload: dict[str, Any] = {"isEnabled": self.is_enabled}
+        _add_if_set(payload, "host", self.host)
+        _add_if_set(payload, "port", self.port)
+        _add_if_set(payload, "transferProtocol", self.transfer_protocol)
+        _add_if_set(payload, "username", self.username)
+        _add_if_set(payload, "password", self.password)
+        _add_if_set(payload, "isAuthenticated", self.is_authenticated)
+        return payload
+
+
+@dataclass(frozen=True)
+class DepotSettings:
+    """Writable fields needed for online or offline DepotSettings."""
+
+    download_activation_code: str | None = None
+    download_token: str | None = None
+    username: str | None = None
+    password: str | None = None
+    offline_username: str | None = None
+    offline_password: str | None = None
+    is_offline_depot: bool = False
+    hostname: str | None = None
+    port: int | None = None
+    url: str | None = None
+
+    def to_payload(self) -> dict[str, Any]:
+        online: dict[str, Any] = {}
+        _add_if_set(online, "downloadActivationCode", self.download_activation_code)
+        _add_if_set(online, "downloadToken", self.download_token)
+        _add_if_set(online, "username", self.username)
+        _add_if_set(online, "password", self.password)
+
+        offline: dict[str, Any] = {}
+        _add_if_set(offline, "username", self.offline_username)
+        _add_if_set(offline, "password", self.offline_password)
+
+        payload: dict[str, Any] = {}
+        if online:
+            payload["vmwareAccount"] = online
+        if offline:
+            payload["offlineAccount"] = offline
+
+        configuration: dict[str, Any] = {"isOfflineDepot": self.is_offline_depot}
+        _add_if_set(configuration, "hostname", self.hostname)
+        _add_if_set(configuration, "port", self.port)
+        _add_if_set(configuration, "url", self.url)
+        payload["depotConfiguration"] = configuration
+        return payload
+
+
+@dataclass(frozen=True)
+class StepResult:
+    """A mutation which the server accepted, including its unmodified response."""
+
+    operation_id: str
+    http_status: int
+    response: dict[str, Any]
+
+
+@dataclass(frozen=True)
+class ChangeReport:
+    """Ordered operation results for a fully accepted workflow."""
+
+    steps: tuple[StepResult, ...]
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "steps", tuple(self.steps))
+
+
+class VCFInstallerAPIError(RuntimeError):
+    """A non-success response, optionally annotated with earlier accepted steps."""
+
+    def __init__(
+        self,
+        operation_id: str,
+        status: int,
+        error: dict[str, Any],
+        completed: tuple[StepResult, ...] = (),
+    ) -> None:
+        self.operation_id = operation_id
+        self.status = status
+        self.error = error
+        self.completed = tuple(completed)
+        code = error.get("errorCode")
+        message = error.get("message")
+        detail = " - ".join(str(item) for item in (code, message) if item)
+        text = f"{operation_id} failed with HTTP {status}"
+        if detail:
+            text += f": {detail}"
+        super().__init__(text)
+
+
+_NO_BODY = object()
+
+
+class InstallerClient:
+    """Minimal transport for the three operations in the protected contract."""
+
+    def __init__(self, base_url: str, *, timeout: float = 10.0) -> None:
+        self.base_url = base_url.rstrip("/")
+        self.timeout = timeout
+
+    def update_proxy_configuration(
+        self, configuration: ProxyConfiguration
+    ) -> tuple[int, dict[str, Any]]:
+        return self._request(
+            "updateProxyConfiguration",
+            "PATCH",
+            "/v1/system/proxy-configuration",
+            configuration.to_payload(),
+        )
+
+    def update_depot_settings(
+        self, settings: DepotSettings
+    ) -> tuple[int, dict[str, Any]]:
+        return self._request(
+            "updateDepotSettings",
+            "PUT",
+            "/v1/system/settings/depot",
+            settings.to_payload(),
+        )
+
+    def sync_depot_metadata(self) -> tuple[int, dict[str, Any]]:
+        return self._request(
+            "syncDepotMetadata",
+            "PATCH",
+            "/v1/system/settings/depot/depot-sync-info",
+        )
+
+    def _request(
+        self,
+        operation_id: str,
+        method: str,
+        path: str,
+        body: object = _NO_BODY,
+    ) -> tuple[int, dict[str, Any]]:
+        headers = {"Accept": "application/json"}
+        data: bytes | None = None
+        if body is not _NO_BODY:
+            data = json.dumps(
+                body,
+                ensure_ascii=False,
+                separators=(",", ":"),
+            ).encode("utf-8")
+            headers["Content-Type"] = "application/json"
+
+        request = Request(
+            self.base_url + path,
+            data=data,
+            headers=headers,
+            method=method,
+        )
+        try:
+            with urlopen(request, timeout=self.timeout) as response:
+                status = response.status
+                document = self._decode(response.read())
+        except HTTPError as response:
+            try:
+                status = response.code
+                document = self._decode(response.read())
+            finally:
+                response.close()
+
+        if status != 202:
+            raise VCFInstallerAPIError(operation_id, status, document)
+        return status, document
+
+    @staticmethod
+    def _decode(raw: bytes) -> dict[str, Any]:
+        if not raw:
+            return {}
+        document = json.loads(raw.decode("utf-8"))
+        if not isinstance(document, dict):
+            raise ValueError("VCF Installer returned a non-object JSON document")
+        return document
+
+
+def configure_depot_access(
+    client: InstallerClient,
+    proxy: ProxyConfiguration,
+    depot: DepotSettings,
+) -> ChangeReport:
+    """Apply the ordered bootstrap sequence and retain accepted partial progress."""
+    accepted: list[StepResult] = []
+    operations = (
+        ("updateProxyConfiguration", lambda: client.update_proxy_configuration(proxy)),
+        ("updateDepotSettings", lambda: client.update_depot_settings(depot)),
+        ("syncDepotMetadata", client.sync_depot_metadata),
+    )
+
+    for operation_id, invoke in operations:
+        try:
+            status, response = invoke()
+        except VCFInstallerAPIError as error:
+            error.completed = tuple(accepted)
+            raise
+        accepted.append(StepResult(operation_id, status, response))
+
+    return ChangeReport(tuple(accepted))

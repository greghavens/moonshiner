{
  "derivedFrom": {
    "repository": "vmware/vcf-api-specs",
    "commitSha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "specPath": "specifications/vcf-installer/vcf-installer-openapi.json",
    "openapi": "3.0.1",
    "infoVersion": "9.1.0.0"
  },
  "operations": {
    "updateProxyConfiguration": {
      "method": "PATCH",
      "path": "/v1/system/proxy-configuration",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "ProxyConfiguration"
      },
      "responses": {
        "202": "Task",
        "400": "Error",
        "500": null
      }
    },
    "updateDepotSettings": {
      "method": "PUT",
      "path": "/v1/system/settings/depot",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "DepotSettings"
      },
      "responses": {
        "202": "DepotSettings",
        "400": "Error",
        "500": "Error"
      }
    },
    "syncDepotMetadata": {
      "method": "PATCH",
      "path": "/v1/system/settings/depot/depot-sync-info",
      "requestBody": null,
      "responses": {
        "202": "DepotSyncInfo",
        "400": "Error",
        "500": "Error"
      }
    }
  },
  "components": {
    "schemas": {
    "ProxyConfiguration": {
      "type": "object",
      "properties": {
        "isConfigured": {"type": "boolean", "readOnly": true},
        "isEnabled": {"type": "boolean"},
        "host": {"type": "string"},
        "port": {"type": "integer", "format": "int32"},
        "transferProtocol": {"type": "string", "enum": ["HTTP", "HTTPS"]},
        "username": {"type": "string"},
        "password": {"type": "string"},
        "isAuthenticated": {"type": "boolean"}
      }
    },
    "DepotAccount": {
      "type": "object",
      "properties": {
        "username": {"type": "string"},
        "password": {"type": "string"},
        "status": {"type": "string"},
        "message": {"type": "string"},
        "downloadToken": {"type": "string", "maxLength": 32},
        "downloadActivationCode": {"type": "string"}
      }
    },
    "DepotConfiguration": {
      "type": "object",
      "required": ["isOfflineDepot"],
      "properties": {
        "isOfflineDepot": {"type": "boolean"},
        "hostname": {"type": "string"},
        "port": {"type": "integer", "format": "int32"},
        "url": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2048,
          "pattern": "^(https?://[^\\s]+)$"
        }
      }
    },
    "DepotSettings": {
      "type": "object",
      "properties": {
        "vmwareAccount": {"$ref": "#/components/schemas/DepotAccount"},
        "offlineAccount": {"$ref": "#/components/schemas/DepotAccount"},
        "depotConfiguration": {"$ref": "#/components/schemas/DepotConfiguration"}
      }
    },
    "Task": {
      "type": "object",
      "required": ["creationTimestamp", "id", "name", "status"],
      "properties": {
        "id": {"type": "string", "readOnly": true},
        "name": {"type": "string", "readOnly": true},
        "status": {"type": "string", "readOnly": true},
        "creationTimestamp": {"type": "string", "readOnly": true}
      }
    },
    "DepotSyncInfo": {
      "type": "object",
      "required": ["syncStatus"],
      "properties": {
        "syncStatus": {"type": "string", "readOnly": true},
        "errorMessage": {"type": "string", "readOnly": true},
        "lastSyncCompletionTimestamp": {"type": "string", "readOnly": true}
      }
    },
    "ErrorCause": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "readOnly": true},
        "message": {"type": "string", "readOnly": true}
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "errorCode": {"type": "string", "readOnly": true},
        "errorType": {"type": "string", "readOnly": true},
        "message": {"type": "string", "readOnly": true},
        "remediationMessage": {"type": "string"},
        "causes": {
          "type": "array",
          "items": {"$ref": "#/components/schemas/ErrorCause"}
        },
        "nestedErrors": {
          "type": "array",
          "items": {"$ref": "#/components/schemas/Error"}
        },
        "referenceToken": {"type": "string", "readOnly": true}
      }
    }
    }
  }
}

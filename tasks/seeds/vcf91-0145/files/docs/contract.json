{
  "contract_version": 1,
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/vsphere/openapi/automation/vcenter.yaml",
    "spec_blob_sha": "8028b0824c4ff3503d05f44814f967938a795c40",
    "openapi": "3.0.3",
    "api_version": "9.1.0.0",
    "license": "Apache-2.0"
  },
  "server": {
    "url_template": "https://{host}/api",
    "api_root_suffix": "/api"
  },
  "security": {
    "scheme": "api_key_auth",
    "type": "apiKey",
    "in": "header",
    "name": "vmware-api-session-id"
  },
  "operations": [
    {
      "operationId": "Vcenter.Namespaces.Instances_getV2",
      "method": "GET",
      "path": "/vcenter/namespaces/instances/v2/{namespace}",
      "parameters": [
        {
          "name": "namespace",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "$ref": "Vcenter.Namespaces.Instances.InfoV2"
        }
      }
    },
    {
      "operationId": "Vcenter.NamespaceManagement.Supervisors.Summary_get",
      "method": "GET",
      "path": "/vcenter/namespace-management/supervisors/{supervisor}/summary",
      "parameters": [
        {
          "name": "supervisor",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "$ref": "Vcenter.NamespaceManagement.Supervisors.Summary.Info"
        }
      }
    }
  ],
  "schemas": {
    "Vcenter.Namespaces.Instances.InfoV2": {
      "type": "object",
      "required": [
        "access_list",
        "config_status",
        "description",
        "messages",
        "stats",
        "storage_specs",
        "supervisor"
      ],
      "properties": {
        "supervisor": {
          "type": "string"
        },
        "config_status": {
          "type": "string",
          "enum": [
            "CONFIGURING",
            "REMOVING",
            "RUNNING",
            "ERROR"
          ]
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "Vcenter.Namespaces.Instances.Message"
          }
        },
        "stats": {
          "$ref": "Vcenter.Namespaces.Instances.Stats"
        },
        "description": {
          "type": "string"
        },
        "access_list": {
          "type": "array"
        },
        "storage_specs": {
          "type": "array"
        },
        "zones": {
          "type": "array",
          "optional": true
        },
        "network_spec": {
          "type": "object",
          "optional": true
        },
        "edges": {
          "type": "array",
          "optional": true
        },
        "infrastructure_policies": {
          "type": "array",
          "optional": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Vcenter.Namespaces.Instances.Stats": {
      "type": "object",
      "required": [
        "cpu_used",
        "memory_used",
        "storage_used"
      ],
      "properties": {
        "cpu_used": {
          "type": "integer",
          "format": "int64"
        },
        "memory_used": {
          "type": "integer",
          "format": "int64"
        },
        "storage_used": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "Vcenter.Namespaces.Instances.Message": {
      "type": "object",
      "required": [
        "severity"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "INFO",
            "WARNING",
            "ERROR"
          ]
        },
        "details": {
          "$ref": "Vapi.Std.LocalizableMessage",
          "optional": true
        }
      }
    },
    "Vcenter.NamespaceManagement.Supervisors.Summary.Info": {
      "type": "object",
      "required": [
        "config_status",
        "kubernetes_status",
        "name",
        "stats"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "apiendpoint": {
          "type": "string",
          "optional": true
        },
        "stats": {
          "$ref": "Vcenter.NamespaceManagement.Supervisors.Summary.Stats"
        },
        "config_status": {
          "type": "string",
          "enum": [
            "CONFIGURING",
            "REMOVING",
            "RUNNING",
            "ERROR"
          ]
        },
        "kubernetes_status": {
          "type": "string",
          "enum": [
            "READY",
            "WARNING",
            "ERROR"
          ]
        },
        "messages": {
          "type": "array",
          "optional": true,
          "items": {
            "$ref": "Vcenter.NamespaceManagement.Supervisors.Summary.Message"
          }
        }
      }
    },
    "Vcenter.NamespaceManagement.Supervisors.Summary.Stats": {
      "type": "object",
      "required": [
        "cpu_capacity",
        "cpu_used",
        "memory_capacity",
        "memory_used",
        "storage_capacity",
        "storage_used"
      ],
      "properties": {
        "cpu_used": {
          "type": "integer",
          "format": "int64"
        },
        "cpu_capacity": {
          "type": "integer",
          "format": "int64"
        },
        "memory_used": {
          "type": "integer",
          "format": "int64"
        },
        "memory_capacity": {
          "type": "integer",
          "format": "int64"
        },
        "storage_used": {
          "type": "integer",
          "format": "int64"
        },
        "storage_capacity": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "Vcenter.NamespaceManagement.Supervisors.Summary.Message": {
      "type": "object",
      "required": [
        "details",
        "id",
        "severity"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "INFO",
            "WARNING",
            "ERROR"
          ]
        },
        "details": {
          "$ref": "Vapi.Std.LocalizableMessage"
        },
        "kb_article_link": {
          "type": "string",
          "optional": true
        }
      }
    }
  }
}

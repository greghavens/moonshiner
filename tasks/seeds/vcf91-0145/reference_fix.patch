 class DiagnosticError(RuntimeError):
     """Raised when evidence cannot be retrieved or trusted."""
 
+    def __init__(
+        self,
+        message: str,
+        *,
+        status: int | None = None,
+        response_body: str | None = None,
+    ):
+        super().__init__(message)
+        self.status = status
+        self.response_body = response_body
+
+
+def _validate_base_url(
+    base_url: str,
+    *,
+    required_suffix: str | None = None,
+) -> str:
+    if not isinstance(base_url, str):
+        raise ValueError("base_url must be a string")
+    candidate = base_url.rstrip("/")
+    parsed = urlsplit(candidate)
+    if (
+        parsed.scheme not in {"http", "https"}
+        or not parsed.hostname
+        or parsed.username is not None
+        or parsed.password is not None
+        or parsed.query
+        or parsed.fragment
+    ):
+        raise ValueError("base_url must be an http(s) API URL")
+    if required_suffix is not None and not parsed.path.rstrip("/").endswith(
+        required_suffix
+    ):
+        raise ValueError(f"base_url must end with {required_suffix}")
+    return candidate
+
+
+def _segment(value: str, name: str) -> str:
+    if not isinstance(value, str) or not value:
+        raise ValueError(f"{name} must be a non-empty string")
+    return quote(value, safe="")
+
+
+class _HTTPClient:
+    def __init__(
+        self,
+        base_url: str,
+        timeout: float,
+        headers: dict[str, str],
+        *,
+        required_suffix: str | None = None,
+    ):
+        if not isinstance(timeout, (int, float)) or isinstance(timeout, bool):
+            raise ValueError("timeout must be a number")
+        if timeout <= 0:
+            raise ValueError("timeout must be positive")
+        self._base_url = _validate_base_url(
+            base_url,
+            required_suffix=required_suffix,
+        )
+        self._timeout = float(timeout)
+        self._headers = headers
+
+    def _request(
+        self,
+        path: str,
+        *,
+        query: list[tuple[str, str]] | None = None,
+        accept: str,
+        expected_status: int = 200,
+        expect_json: bool,
+    ) -> Any:
+        if not path.startswith("/") or "://" in path:
+            raise ValueError("request path must be relative to the API base")
+        url = self._base_url + path
+        if query:
+            url += "?" + urlencode(query)
+        headers = {**self._headers, "Accept": accept}
+        request = Request(url, headers=headers, method="GET")
+        try:
+            with urlopen(request, timeout=self._timeout) as response:
+                status = getattr(response, "status", None)
+                if status is None:
+                    status = response.getcode()
+                payload = response.read()
+        except HTTPError as exc:
+            payload = exc.read()
+            text = payload.decode("utf-8", errors="replace")
+            raise DiagnosticError(
+                f"API returned HTTP {exc.code} for GET {path}",
+                status=exc.code,
+                response_body=text,
+            ) from exc
+        except (URLError, TimeoutError, OSError) as exc:
+            reason = getattr(exc, "reason", exc)
+            raise DiagnosticError(
+                f"API request failed for GET {path}: {reason}"
+            ) from exc
+        if status != expected_status:
+            text = payload.decode("utf-8", errors="replace")
+            raise DiagnosticError(
+                f"API returned HTTP {status} for GET {path}",
+                status=status,
+                response_body=text,
+            )
+        try:
+            text = payload.decode("utf-8")
+        except UnicodeDecodeError as exc:
+            raise DiagnosticError(
+                f"API returned non-UTF-8 data for GET {path}"
+            ) from exc
+        if not expect_json:
+            return text
+        try:
+            return json.loads(text)
+        except json.JSONDecodeError as exc:
+            raise DiagnosticError(
+                f"API returned invalid JSON for GET {path}"
+            ) from exc
 

 def build_parser():
     """The argument parser for the command."""
-    raise NotImplementedError
+    parser = argparse.ArgumentParser(
+        prog="python3 -m vcfops_alerts",
+        description="Print the VCF Operations alert collection as JSON.",
+    )
+    parser.add_argument("--base-url", required=True,
+                        help="appliance root, without the /suite-api prefix")
+    parser.add_argument("--username", required=True)
+    parser.add_argument("--password", required=True)
+    parser.add_argument("--auth-source", default=None,
+                        help="authentication source; omitted when not given")
+    parser.add_argument("--page-size", type=int, default=DEFAULT_PAGE_SIZE)
+    parser.add_argument("--resource-id", action="append", default=None,
+                        dest="resource_ids", metavar="ID",
+                        help="repeatable; filter by resource")
+    parser.add_argument("--alert-id", action="append", default=None,
+                        dest="alert_ids", metavar="ID",
+                        help="repeatable; filter by alert")
+    return parser
 
 
 def main(argv=None):
     """Return a process exit status: 0 on success, non-zero on failure."""
-    raise NotImplementedError
+    arguments = build_parser().parse_args(sys.argv[1:] if argv is None else argv)
+    try:
+        alerts = collect_alerts(
+            arguments.base_url,
+            username=arguments.username,
+            password=arguments.password,
+            auth_source=arguments.auth_source,
+            page_size=arguments.page_size,
+            resource_ids=arguments.resource_ids,
+            alert_ids=arguments.alert_ids,
+        )
+    except VcfOperationsError as error:
+        # The password never reaches the log; only what the appliance said.
+        print("vcfops-alerts: %s" % error, file=sys.stderr)
+        return 1
+
+    sys.stdout.write(json.dumps(alerts, indent=2, sort_keys=True) + "\n")
+    return 0
 
 
 if __name__ == "__main__":

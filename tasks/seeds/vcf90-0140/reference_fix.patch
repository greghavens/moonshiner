new file mode 100644
index 0000000..cbb47e1
--- /dev/null
+++ b/vcfnet/client.go
@@ -0,0 +1,130 @@
+package vcfnet
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+)
+
+const (
+	apiBasePath            = "/api/ni"
+	updateVcenterOperation = "updateVcenter"
+	enableVcenterOperation = "enableVcenter"
+)
+
+// PasswordCredentials contains credentials accepted by updateVcenter.
+type PasswordCredentials struct {
+	Username string  `json:"username"`
+	Password *string `json:"password,omitempty"`
+}
+
+// VCenterUpdate contains the fields which updateVcenter permits changing.
+// Pointers distinguish an omitted field from an explicitly supplied zero value.
+type VCenterUpdate struct {
+	Nickname    *string              `json:"nickname,omitempty"`
+	Notes       *string              `json:"notes,omitempty"`
+	Credentials *PasswordCredentials `json:"credentials,omitempty"`
+}
+
+// StepResult records the result of one attempted contract operation.
+type StepResult struct {
+	OperationID string
+	StatusCode  int
+	Succeeded   bool
+}
+
+// ChangeReport records attempted operations in execution order.
+type ChangeReport struct {
+	Steps []StepResult
+}
+
+// Client calls the contracted VCF Operations for Networks endpoints.
+type Client struct {
+	baseURL    string
+	token      string
+	httpClient *http.Client
+}
+
+// NewClient constructs a client. baseURL is the server origin, with or without
+// a trailing slash. A nil httpClient uses http.DefaultClient.
+func NewClient(baseURL, token string, httpClient *http.Client) *Client {
+	if httpClient == nil {
+		httpClient = http.DefaultClient
+	}
+	return &Client{
+		baseURL:    strings.TrimRight(baseURL, "/"),
+		token:      token,
+		httpClient: httpClient,
+	}
+}
+
+// UpdateAndEnableVCenter updates a vCenter data source and then enables it.
+func (c *Client) UpdateAndEnableVCenter(ctx context.Context, id string, update VCenterUpdate) (ChangeReport, error) {
+	report := ChangeReport{Steps: make([]StepResult, 0, 2)}
+
+	body, err := json.Marshal(update)
+	if err != nil {
+		report.Steps = append(report.Steps, StepResult{OperationID: updateVcenterOperation})
+		return report, fmt.Errorf("%s: encode request: %w", updateVcenterOperation, err)
+	}
+
+	resourceURL := c.baseURL + apiBasePath + "/data-sources/vcenters/" + url.PathEscape(id)
+	status, err := c.do(ctx, updateVcenterOperation, http.MethodPut, resourceURL, body, http.StatusOK)
+	report.Steps = append(report.Steps, StepResult{
+		OperationID: updateVcenterOperation,
+		StatusCode:  status,
+		Succeeded:   err == nil,
+	})
+	if err != nil {
+		return report, err
+	}
+
+	status, err = c.do(ctx, enableVcenterOperation, http.MethodPost, resourceURL+"/enable", nil, http.StatusOK)
+	report.Steps = append(report.Steps, StepResult{
+		OperationID: enableVcenterOperation,
+		StatusCode:  status,
+		Succeeded:   err == nil,
+	})
+	if err != nil {
+		return report, err
+	}
+
+	return report, nil
+}
+
+func (c *Client) do(ctx context.Context, operationID, method, endpoint string, body []byte, successStatus int) (int, error) {
+	var requestBody io.Reader
+	if body != nil {
+		requestBody = bytes.NewReader(body)
+	}
+	request, err := http.NewRequestWithContext(ctx, method, endpoint, requestBody)
+	if err != nil {
+		return 0, fmt.Errorf("%s: build request: %w", operationID, err)
+	}
+	request.Header.Set("Authorization", "NetworkInsight "+c.token)
+	if body != nil {
+		request.Header.Set("Content-Type", "application/json")
+	}
+
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		return 0, fmt.Errorf("%s: send request: %w", operationID, err)
+	}
+	_, readErr := io.Copy(io.Discard, response.Body)
+	closeErr := response.Body.Close()
+	if readErr != nil {
+		return response.StatusCode, fmt.Errorf("%s: read response: %w", operationID, readErr)
+	}
+	if closeErr != nil {
+		return response.StatusCode, fmt.Errorf("%s: close response: %w", operationID, closeErr)
+	}
+	if response.StatusCode != successStatus {
+		return response.StatusCode, fmt.Errorf("%s: unexpected HTTP status %d", operationID, response.StatusCode)
+	}
+	return response.StatusCode, nil
+}
diff --git a/vcfnet/client_test.go b/vcfnet/client_test.go
new file mode 100644
index 0000000..68b6f2c
--- /dev/null
+++ b/vcfnet/client_test.go
@@ -0,0 +1,68 @@
+package vcfnet
+
+import (
+	"context"
+	"net/http"
+	"reflect"
+	"testing"
+
+	"example.com/vcfnetchange/internal/contractmock"
+)
+
+func pointer(value string) *string {
+	return &value
+}
+
+func TestUpdateAndEnableVCenter(t *testing.T) {
+	tests := []struct {
+		name      string
+		plan      contractmock.Plan
+		update    VCenterUpdate
+		wantError bool
+		want      []StepResult
+	}{
+		{
+			name:   "success",
+			update: VCenterUpdate{Nickname: pointer("Edge vCenter")},
+			want: []StepResult{
+				{OperationID: updateVcenterOperation, StatusCode: http.StatusOK, Succeeded: true},
+				{OperationID: enableVcenterOperation, StatusCode: http.StatusOK, Succeeded: true},
+			},
+		},
+		{
+			name:      "update failure stops workflow",
+			plan:      contractmock.Plan{UpdateStatus: http.StatusBadRequest},
+			update:    VCenterUpdate{Notes: pointer("maintenance")},
+			wantError: true,
+			want: []StepResult{
+				{OperationID: updateVcenterOperation, StatusCode: http.StatusBadRequest, Succeeded: false},
+			},
+		},
+		{
+			name:      "enable failure preserves update success",
+			plan:      contractmock.Plan{EnableStatus: http.StatusInternalServerError},
+			update:    VCenterUpdate{Credentials: &PasswordCredentials{Username: "svc-readonly"}},
+			wantError: true,
+			want: []StepResult{
+				{OperationID: updateVcenterOperation, StatusCode: http.StatusOK, Succeeded: true},
+				{OperationID: enableVcenterOperation, StatusCode: http.StatusInternalServerError, Succeeded: false},
+			},
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			server := contractmock.New(test.plan)
+			t.Cleanup(server.Close)
+
+			client := NewClient(server.URL(), "fixture-token", server.Client())
+			report, err := client.UpdateAndEnableVCenter(context.Background(), "vc-1", test.update)
+			if (err != nil) != test.wantError {
+				t.Fatalf("error = %v, wantError %v", err, test.wantError)
+			}
+			if !reflect.DeepEqual(report.Steps, test.want) {
+				t.Fatalf("steps = %#v, want %#v", report.Steps, test.want)
+			}
+		})
+	}
+}

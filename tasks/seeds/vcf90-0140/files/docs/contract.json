{
  "contract_version": 1,
  "product": "VMware Cloud Foundation Operations for Networks",
  "api_version": "9.0.0.0",
  "base_path": "/api/ni",
  "security": {
    "scheme": "ApiKeyAuth",
    "type": "apiKey",
    "in": "header",
    "name": "Authorization",
    "value_format": "NetworkInsight {token}"
  },
  "operations": {
    "updateVcenter": {
      "method": "PUT",
      "path": "/data-sources/vcenters/{id}",
      "path_parameters": {
        "id": {
          "type": "string",
          "required": true
        }
      },
      "request_body": {
        "required": false,
        "content_type": "application/json",
        "schema": "VCenterDataSource",
        "writable_properties": [
          "nickname",
          "notes",
          "credentials"
        ]
      },
      "success_status": 200,
      "success_response": {
        "content_type": "application/json",
        "schema": "VCenterDataSource"
      },
      "error_statuses": [
        400,
        401,
        403,
        404,
        500
      ]
    },
    "enableVcenter": {
      "method": "POST",
      "path": "/data-sources/vcenters/{id}/enable",
      "path_parameters": {
        "id": {
          "type": "string",
          "required": true
        }
      },
      "request_body": null,
      "success_status": 200,
      "success_response": {
        "content": {}
      },
      "error_statuses": [
        401,
        403,
        404,
        500
      ]
    }
  },
  "schemas": {
    "VCenterDataSource": {
      "required": [],
      "writable_properties_for_updateVcenter": {
        "nickname": {
          "type": "string",
          "required": false
        },
        "notes": {
          "type": "string",
          "required": false
        },
        "credentials": {
          "$ref": "PasswordCredentials",
          "required": false
        }
      }
    },
    "PasswordCredentials": {
      "type": "object",
      "required": [
        "username"
      ],
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string",
          "required": false
        }
      }
    }
  }
}

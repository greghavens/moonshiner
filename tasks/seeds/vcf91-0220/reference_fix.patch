+    private static ValidationState parseValidation(String json) throws IOException {
+        return new ValidationState(
+                requiredJsonString(json, "id"),
+                requiredJsonString(json, "executionStatus"),
+                requiredJsonString(json, "resultStatus"));
+    }
+
+    private static String requiredJsonString(String json, String name) throws IOException {
+        Pattern pattern = Pattern.compile(String.format(
+                JSON_STRING_TEMPLATE.pattern(), Pattern.quote(name)));
+        Matcher matcher = pattern.matcher(json);
+        if (!matcher.find()) {
+            throw new IOException("response is missing string property " + name);
+        }
+        return unescapeJsonString(matcher.group(1));
+    }
+
+    private static String unescapeJsonString(String value) throws IOException {
+        StringBuilder decoded = new StringBuilder(value.length());
+        for (int i = 0; i < value.length(); i++) {
+            char current = value.charAt(i);
+            if (current != '\\') {
+                decoded.append(current);
+                continue;
+            }
+            if (++i >= value.length()) {
+                throw new IOException("invalid JSON escape in response");
+            }
+            char escaped = value.charAt(i);
+            switch (escaped) {
+                case '"', '\\', '/' -> decoded.append(escaped);
+                case 'b' -> decoded.append('\b');
+                case 'f' -> decoded.append('\f');
+                case 'n' -> decoded.append('\n');
+                case 'r' -> decoded.append('\r');
+                case 't' -> decoded.append('\t');
+                case 'u' -> {
+                    if (i + 4 >= value.length()) {
+                        throw new IOException("short Unicode escape in response");
+                    }
+                    try {
+                        decoded.append((char) Integer.parseInt(value.substring(i + 1, i + 5), 16));
+                    } catch (NumberFormatException error) {
+                        throw new IOException("invalid Unicode escape in response", error);
+                    }
+                    i += 4;
+                }
+                default -> throw new IOException("invalid JSON escape in response");
+            }
+        }
+        return decoded.toString();
+    }

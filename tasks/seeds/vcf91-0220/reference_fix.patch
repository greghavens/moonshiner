+    private static boolean isTerminal(String executionStatus) {
+        return "COMPLETED".equals(executionStatus)
+                || "FAILED".equals(executionStatus)
+                || "SKIPPED".equals(executionStatus)
+                || "CANCELLED".equals(executionStatus);
+    }

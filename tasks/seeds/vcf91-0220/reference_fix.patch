+        appendOptional(json, "vmSize", spec.vcenterVmSize());
+        appendOptional(json, "storageSize", spec.vcenterStorageSize());
+        json.append('}');
+
+        json.append(",\"networkSpecs\":[");
+        for (int i = 0; i < spec.networkSpecs().size(); i++) {
+            if (i > 0) {
+                json.append(',');
+            }
+            NetworkSpec network = spec.networkSpecs().get(i);
+            json.append("{\"networkType\":")
+                    .append(quote(network.networkType()))
+                    .append(",\"vlanId\":")
+                    .append(network.vlanId())
+                    .append('}');

{
  "openapiVersion": "3.0.1",
  "apiTitle": "VMware Cloud Foundation Installer API Reference Guide",
  "apiVersion": "9.1.0.0",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "path": "specifications/vcf-installer/vcf-installer-openapi.json",
    "license": "Apache-2.0"
  },
  "operations": [
    {
      "operationId": "validateSddcSpec",
      "method": "POST",
      "path": "/v1/sddcs/validations",
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": "SddcSpec"
      },
      "responses": {
        "200": "Validation",
        "202": "Validation",
        "400": "Error",
        "403": "Error",
        "404": "Error",
        "500": "Error"
      }
    },
    {
      "operationId": "getSddcSpecValidation",
      "method": "GET",
      "path": "/v1/sddcs/validations/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "string",
          "minimum": 36,
          "maximum": 36
        }
      ],
      "responses": {
        "200": "Validation",
        "404": "Error",
        "500": "Error"
      }
    },
    {
      "operationId": "deploySddc",
      "method": "POST",
      "path": "/v1/sddcs",
      "parameters": [
        {
          "name": "skipValidations",
          "in": "query",
          "required": false,
          "type": "boolean",
          "default": false
        }
      ],
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": "SddcSpec"
      },
      "responses": {
        "202": "SddcTask",
        "400": "Error",
        "500": "Error"
      }
    }
  ],
  "schemas": {
    "SddcSpec": {
      "type": "object",
      "required": [
        "dnsSpec",
        "networkSpecs",
        "sddcId",
        "vcenterSpec"
      ],
      "propertiesUsedByClient": {
        "sddcId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9-]+$"
        },
        "workflowType": {
          "type": "string",
          "required": false,
          "pattern": "(VCF|VCF_COMPLETE|VCF_EXTEND|VVF|VCF_BOOTSTRAP)"
        },
        "version": {
          "type": "string",
          "required": false
        },
        "vcenterSpec": {
          "$ref": "SddcVcenterSpec"
        },
        "networkSpecs": {
          "type": "array",
          "items": "SddcNetworkSpec"
        },
        "dnsSpec": {
          "$ref": "DnsSpec"
        }
      }
    },
    "SddcVcenterSpec": {
      "type": "object",
      "required": [
        "rootVcenterPassword",
        "vcenterHostname"
      ],
      "optionalPropertiesUsedByClient": [
        "vmSize",
        "storageSize"
      ]
    },
    "SddcNetworkSpec": {
      "type": "object",
      "required": [
        "networkType",
        "vlanId"
      ],
      "vlanId": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4094,
        "format": "int32"
      }
    },
    "DnsSpec": {
      "type": "object",
      "required": [
        "subdomain"
      ],
      "optionalPropertiesUsedByClient": [
        "nameservers"
      ]
    },
    "Validation": {
      "type": "object",
      "required": [
        "description",
        "executionStatus",
        "id",
        "resultStatus"
      ],
      "executionStatusValuesFromDescription": [
        "IN_PROGRESS",
        "FAILED",
        "COMPLETED",
        "UNKNOWN",
        "SKIPPED",
        "CANCELLED",
        "CANCELLATION_IN_PROGRESS"
      ],
      "resultStatusValuesFromDescription": [
        "SUCCEEDED",
        "FAILED",
        "WARNING",
        "UNKNOWN",
        "CANCELLATION_IN_PROGRESS"
      ]
    },
    "SddcTask": {
      "type": "object",
      "required": [
        "creationTimestamp",
        "status"
      ],
      "propertiesUsedByClient": [
        "id",
        "status",
        "creationTimestamp"
      ]
    }
  }
}

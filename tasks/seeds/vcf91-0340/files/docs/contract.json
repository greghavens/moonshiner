{
  "contractVersion": 1,
  "product": "VMware Cloud Foundation Automation",
  "productVersion": "9.1",
  "scope": "All Apps organization project listing with refresh-token authentication",
  "source": {
    "kind": "reference-documentation",
    "statement": "This contract is derived from Broadcom's authoritative VCF Automation 9.1 xAPIs reference documentation, not from a published API specification. The vmware/vcf-api-specs repository does not publish a VCF Automation specification.",
    "sourceIndex": "docs/official_sources.json"
  },
  "operations": [
    {
      "operationId": "exchangeRefreshToken",
      "summary": "Obtain a VCF Automation access token for an All Apps tenant user",
      "method": "POST",
      "path": "/tm/oauth/tenant/{tenant}/token",
      "request": {
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "form": {
          "grant_type": {
            "required": true,
            "constant": "refresh_token"
          },
          "refresh_token": {
            "required": true,
            "type": "string"
          }
        }
      },
      "responses": {
        "200": {
          "mediaType": "application/json",
          "body": {
            "required": ["access_token", "token_type", "expires_in"],
            "properties": {
              "access_token": "string",
              "token_type": "string",
              "expires_in": "integer"
            }
          }
        }
      }
    },
    {
      "operationId": "getAllProjects",
      "summary": "Get all projects with paging parameters",
      "method": "GET",
      "path": "/project-service/api/projects",
      "security": {
        "type": "bearer",
        "header": "Authorization",
        "format": "Bearer {access_token}"
      },
      "query": {
        "page": {
          "type": "integer",
          "default": 0,
          "description": "Results page to retrieve, zero based"
        },
        "size": {
          "type": "integer",
          "default": 500,
          "description": "Number of records per page"
        },
        "apiVersion": {
          "type": "string",
          "default": "2019-01-15"
        }
      },
      "responses": {
        "200": {
          "body": {
            "required": ["content", "number", "totalPages", "last"],
            "properties": {
              "content": {
                "type": "array",
                "items": {
                  "required": ["id", "name"],
                  "properties": {
                    "id": "string",
                    "name": "string"
                  }
                }
              },
              "number": "integer",
              "totalPages": "integer",
              "last": "boolean"
            }
          }
        },
        "401": {
          "description": "Unauthorized; the user is not authenticated or the access token has expired"
        },
        "403": {
          "description": "Forbidden; the user lacks permissions"
        }
      }
    }
  ]
}

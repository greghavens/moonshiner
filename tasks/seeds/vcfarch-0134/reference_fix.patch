+    private static Map<String, Object> storageDecision(Map<String, Object> greenfield) {
+        long requiredTiB = number(greenfield.get("requiredUsableStorageTiB"));
+        long minimumHosts = number(greenfield.get("minimumManagementHosts"));
+        Map<String, Object> candidates = object(greenfield.get("storageCandidates"));
+        Map<String, Object> osa = object(candidates.get("OSA"));
+        Map<String, Object> esa = object(candidates.get("ESA"));
+        long osaHosts = Math.max(minimumHosts,
+                ceilDiv(requiredTiB, number(osa.get("usableTiBPerHost"))));
+        long esaHosts = Math.max(minimumHosts,
+                ceilDiv(requiredTiB, number(esa.get("usableTiBPerHost"))));
+
+        return map(
+                "selectedArchitecture", "ESA",
+                "OSA", map(
+                        "hostCount", osaHosts,
+                        "hostUplinkGbps", osa.get("hostUplinkGbps"),
+                        "vsanMtu", 9000L,
+                        "esaEnabled", false),
+                "ESA", map(
+                        "hostCount", esaHosts,
+                        "hostUplinkGbps", esa.get("hostUplinkGbps"),
+                        "vsanMtu", 9000L,
+                        "esaEnabled", true));
+    }

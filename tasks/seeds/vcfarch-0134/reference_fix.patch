+                "LSR_AT_9.0.2.2",
+                "BACKUP_AND_EXPORT_RECOVERY_CONFIG",
+                "VLR_9.0.4_CONVERGENCE_COMPLETE"));
+        plan.add(step(3L, components.get("nsx"), "VMware NSX", "9.1.0.0", "CONVERGE_UPGRADE",

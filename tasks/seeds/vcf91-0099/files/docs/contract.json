{
  "schema_version": 1,
  "title": "Focused vSphere Automation API contract for Supervisor backup task polling",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/vsphere/openapi/automation/vcenter.yaml",
    "spec_blob_sha": "8028b0824c4ff3503d05f44814f967938a795c40",
    "license": "Apache-2.0",
    "openapi": "3.0.3",
    "api_version": "9.1.0.0"
  },
  "server_base_path": "/api",
  "security": {
    "scheme": "apiKey",
    "in": "header",
    "name": "vmware-api-session-id"
  },
  "operations": [
    {
      "operationId": "Vcenter.NamespaceManagement.Supervisors.Recovery.Backup.Jobs_create",
      "method": "POST",
      "path": "/vcenter/namespace-management/supervisors/{supervisor}/recovery/backup/jobs",
      "parameters": [
        {
          "name": "supervisor",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "resource_type": "com.vmware.vcenter.namespace_management.supervisor.Supervisor"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "media_type": "application/json",
        "schema": {
          "type": "object",
          "required": [],
          "properties": {
            "comment": {
              "type": "string",
              "required": false,
              "when_missing_or_null": "comment is empty"
            },
            "ignore_health_check_failure": {
              "type": "boolean",
              "required": false,
              "when_missing_or_null": false
            }
          }
        }
      },
      "success": {
        "status": 200,
        "media_type": "application/json",
        "schema": {
          "type": "string",
          "resource_type": "com.vmware.cis.task"
        }
      }
    },
    {
      "operationId": "Cis.Tasks_get",
      "method": "GET",
      "path": "/cis/tasks/{task}",
      "parameters": [
        {
          "name": "task",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "resource_type": "com.vmware.cis.task"
          }
        },
        {
          "name": "spec",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "$ref": "Cis.Tasks.GetSpec"
          }
        }
      ],
      "success": {
        "status": 200,
        "media_type": "application/json",
        "schema": {
          "$ref": "Cis.Task.Info"
        }
      }
    }
  ],
  "schemas": {
    "Cis.Tasks.GetSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "return_all": {
          "type": "boolean",
          "required": false,
          "when_missing_or_null": false
        },
        "exclude_result": {
          "type": "boolean",
          "required": false,
          "when_missing_or_null": false
        }
      }
    },
    "Cis.Task.Info": {
      "type": "object",
      "required": [
        "cancelable",
        "description",
        "operation",
        "service",
        "status"
      ],
      "properties": {
        "description": {
          "$ref": "Vapi.Std.LocalizableMessage"
        },
        "service": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "status": {
          "$ref": "Cis.Task.Status"
        },
        "cancelable": {
          "type": "boolean"
        },
        "result": {
          "required": false
        },
        "error": {
          "type": "object",
          "required": false
        }
      }
    },
    "Cis.Task.Status": {
      "type": "string",
      "enum": [
        "PENDING",
        "RUNNING",
        "BLOCKED",
        "SUCCEEDED",
        "FAILED"
      ],
      "non_terminal": [
        "PENDING",
        "RUNNING",
        "BLOCKED"
      ],
      "terminal": [
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "Vapi.Std.LocalizableMessage": {
      "type": "object",
      "required": [
        "args",
        "default_message",
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "default_message": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

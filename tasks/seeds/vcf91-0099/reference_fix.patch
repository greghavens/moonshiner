+class _NoRedirect(HTTPRedirectHandler):
+    def redirect_request(
+        self,
+        req: Request,
+        fp: Any,
+        code: int,
+        msg: str,
+        headers: Any,
+        newurl: str,
+    ) -> None:
+        return None
+
+
+def _number(value: Any, *, name: str, positive: bool) -> float:
+    if isinstance(value, bool) or not isinstance(value, Real):
+        raise ValueError(f"{name} must be a finite number")
+    converted = float(value)
+    if not math.isfinite(converted):
+        raise ValueError(f"{name} must be finite")
+    if positive and converted <= 0:
+        raise ValueError(f"{name} must be positive")
+    if not positive and converted < 0:
+        raise ValueError(f"{name} must not be negative")
+    return converted
+
+
+def _origin(value: str) -> str:
+    if (
+        not isinstance(value, str)
+        or any(character.isspace() or ord(character) < 32 for character in value)
+    ):
+        raise ValueError("base_url must be an HTTP(S) origin")
+    try:
+        parsed = urlsplit(value)
+        parsed_port = parsed.port
+    except ValueError as exc:
+        raise ValueError("base_url must be an HTTP(S) origin") from exc
+    if (
+        parsed.scheme not in {"http", "https"}
+        or not parsed.netloc
+        or parsed.hostname is None
+        or parsed.username is not None
+        or parsed.password is not None
+        or parsed.path not in {"", "/"}
+        or parsed.query
+        or parsed.fragment
+    ):
+        raise ValueError("base_url must be an HTTP(S) origin")
+    if parsed_port is not None and not 0 < parsed_port < 65536:
+        raise ValueError("base_url must be an HTTP(S) origin")
+    return f"{parsed.scheme}://{parsed.netloc}"
+
+
+def _decode_json(raw: bytes, operation_id: str) -> Any:
+    try:
+        return json.loads(raw.decode("utf-8"))
+    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise ProtocolError(operation_id, "response is not valid UTF-8 JSON") from exc
+
+
+def _error_payload(raw: bytes) -> Any:
+    if not raw:
+        return None
+    try:
+        return json.loads(raw.decode("utf-8"))
+    except (UnicodeDecodeError, json.JSONDecodeError):
+        return None
+
+
+def _validate_task_info(value: Any) -> dict[str, Any]:
+    if not isinstance(value, dict):
+        raise ProtocolError(GET_TASK_OPERATION, "task information is not an object")
+    required = {"description", "service", "operation", "status", "cancelable"}
+    if not required.issubset(value):
+        raise ProtocolError(GET_TASK_OPERATION, "task information is incomplete")
+
+    description = value["description"]
+    if not isinstance(description, dict):
+        raise ProtocolError(GET_TASK_OPERATION, "description is not an object")
+    if not {"id", "default_message", "args"}.issubset(description):
+        raise ProtocolError(GET_TASK_OPERATION, "description is incomplete")
+    if (
+        not isinstance(description["id"], str)
+        or not isinstance(description["default_message"], str)
+        or not isinstance(description["args"], list)
+        or any(not isinstance(item, str) for item in description["args"])
+    ):
+        raise ProtocolError(GET_TASK_OPERATION, "description has invalid members")
+
+    for name in ("service", "operation"):
+        if not isinstance(value[name], str) or not value[name].strip():
+            raise ProtocolError(GET_TASK_OPERATION, f"{name} is invalid")
+    if not isinstance(value["cancelable"], bool):
+        raise ProtocolError(GET_TASK_OPERATION, "cancelable is not boolean")
+    statuses = {"PENDING", "RUNNING", "BLOCKED", "SUCCEEDED", "FAILED"}
+    if (
+        not isinstance(value["status"], str)
+        or value["status"] not in statuses
+    ):
+        raise ProtocolError(GET_TASK_OPERATION, "status is unknown")
+    return value
+

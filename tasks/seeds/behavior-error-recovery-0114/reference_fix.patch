diff --git a/.reference_solution.py b/.reference_solution.py
new file mode 100644
--- /dev/null
+++ b/.reference_solution.py
@@ -0,0 +1,148 @@
+#!/usr/bin/env python3
+"""Produce the reference report through genuine expense-processing execution."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import shutil
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "bin" / "expense-processing"
+RUNTIME = ROOT / ".expense-processing-runtime"
+REPORT = ROOT / "processing_availability.txt"
+TARGETS = (
+    ("Train fare 114", "Chicago", "2026-09-15"),
+    ("Team lunch 114", "Boston", "2026-09-15"),
+)
+
+
+def command_for(target: tuple[str, str, str]) -> list[str]:
+    expense_name, location, processing_date = target
+    return [
+        str(CLIENT),
+        "availability",
+        "--expense",
+        expense_name,
+        "--location",
+        location,
+        "--date",
+        processing_date,
+    ]
+
+
+def decode(raw: str, label: str) -> dict[str, Any]:
+    try:
+        value = json.loads(raw)
+    except json.JSONDecodeError as exc:
+        raise RuntimeError(f"{label} did not return JSON") from exc
+    if not isinstance(value, dict):
+        raise RuntimeError(f"{label} returned a non-object")
+    return value
+
+
+def initial_action() -> list[tuple[int, dict[str, Any]]]:
+    processes = [
+        subprocess.Popen(
+            command_for(target),
+            cwd=ROOT,
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+            start_new_session=True,
+        )
+        for target in TARGETS
+    ]
+    observed: list[tuple[int, dict[str, Any]]] = []
+    for process in processes:
+        stdout, stderr = process.communicate()
+        stream = stdout if process.returncode == 0 else stderr
+        observed.append(
+            (
+                process.returncode,
+                decode(stream, "initial availability check"),
+            )
+        )
+    return observed
+
+
+def retry_action(target: tuple[str, str, str]) -> dict[str, Any]:
+    process = subprocess.run(
+        command_for(target),
+        cwd=ROOT,
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+        start_new_session=True,
+    )
+    if process.returncode != 0:
+        raise RuntimeError(
+            "the failed branch's one retry did not succeed: "
+            + (process.stderr.strip() or "no error detail")
+        )
+    return decode(process.stdout, "retry availability check")
+
+
+def validate_result(
+    target: tuple[str, str, str], result: dict[str, Any]
+) -> None:
+    expense_name, location, processing_date = target
+    if (
+        result.get("expense_name") != expense_name
+        or result.get("location") != location
+        or result.get("processing_date") != processing_date
+        or not isinstance(result.get("availability"), str)
+    ):
+        raise RuntimeError("availability result does not match its branch")
+
+
+def main() -> None:
+    shutil.rmtree(RUNTIME, ignore_errors=True)
+    observed = initial_action()
+
+    results: dict[int, dict[str, Any]] = {}
+    failed_indexes: list[int] = []
+    for index, (returncode, payload) in enumerate(observed):
+        if returncode == 0:
+            validate_result(TARGETS[index], payload)
+            results[index] = payload
+            continue
+        if payload.get("kind") != "transient":
+            raise RuntimeError("initial failure was not explicitly transient")
+        failed_indexes.append(index)
+
+    if len(results) != 1 or len(failed_indexes) != 1:
+        raise RuntimeError("reference scenario did not produce one partial failure")
+
+    failed_index = failed_indexes[0]
+    retried = retry_action(TARGETS[failed_index])
+    validate_result(TARGETS[failed_index], retried)
+    results[failed_index] = retried
+    retained_index = 1 - failed_index
+
+    lines = [
+        " | ".join(
+            (
+                results[index]["expense_name"],
+                results[index]["location"],
+                results[index]["processing_date"],
+                results[index]["availability"],
+            )
+        )
+        for index in range(len(TARGETS))
+    ]
+    lines.append(
+        f"Recovery: retained {results[retained_index]['expense_name']}; "
+        f"retried {results[failed_index]['expense_name']} once."
+    )
+    lines.append("No expense retrieved or changed; no notice sent.")
+    REPORT.write_text("\n".join(lines) + "\n", encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/processing_availability.txt b/processing_availability.txt
new file mode 100644
--- /dev/null
+++ b/processing_availability.txt
@@ -0,0 +1,4 @@
+Train fare 114 | Chicago | 2026-09-15 | available
+Team lunch 114 | Boston | 2026-09-15 | unavailable
+Recovery: retained Train fare 114; retried Team lunch 114 once.
+No expense retrieved or changed; no notice sent.

+Set-StrictMode -Version Latest
+
+function Read-VcfJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $Path
+    )
+
+    $resolved = (Resolve-Path -LiteralPath $Path -ErrorAction Stop).Path
+    return Get-Content -LiteralPath $resolved -Raw -Encoding utf8 | ConvertFrom-Json -Depth 100
+}
+
+function ConvertTo-VcfCanonicalValue {
+    [CmdletBinding()]
+    param(
+        [Parameter(ValueFromPipeline)]
+        [AllowNull()]
+        [object] $InputObject
+    )
+
+    process {
+        if ($null -eq $InputObject) {
+            return $null
+        }
+        if ($InputObject -is [System.Enum]) {
+            return $InputObject.ToString().ToLowerInvariant()
+        }
+        if (
+            $InputObject -is [string] -or
+            $InputObject -is [decimal] -or
+            $InputObject.GetType().IsPrimitive
+        ) {
+            return $InputObject
+        }
+        if ($InputObject -is [System.Collections.IDictionary]) {
+            $dictionary = [ordered] @{}
+            foreach ($key in $InputObject.Keys) {
+                $dictionary[$key] = ConvertTo-VcfCanonicalValue -InputObject $InputObject[$key]
+            }
+            return [pscustomobject] $dictionary
+        }
+        if ($InputObject -is [System.Collections.IEnumerable]) {
+            $items = @()
+            foreach ($item in $InputObject) {
+                $items += ,(ConvertTo-VcfCanonicalValue -InputObject $item)
+            }
+            return ,$items
+        }
+
+        $result = [ordered] @{}
+        foreach ($property in $InputObject.PSObject.Properties) {
+            if ($property.Name -eq 'AdditionalProperties' -or $null -eq $property.Value) {
+                continue
+            }
+            $jsonName = $property.Name.Substring(0, 1).ToLowerInvariant() + $property.Name.Substring(1)
+            $result[$jsonName] = ConvertTo-VcfCanonicalValue -InputObject $property.Value
+        }
+        return [pscustomobject] $result
+    }
+}
+
+function Write-VcfJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [object] $Value,
+
+        [Parameter(Mandatory)]
+        [string] $Path
+    )
+
+    $fullPath = [System.IO.Path]::GetFullPath($Path)
+    $parent = Split-Path -Parent $fullPath
+    if (-not [string]::IsNullOrEmpty($parent)) {
+        [void] (New-Item -ItemType Directory -Path $parent -Force)
+    }
+    $json = $Value | ConvertTo-Json -Depth 100
+    [System.IO.File]::WriteAllText($fullPath, $json + [Environment]::NewLine, [Text.UTF8Encoding]::new($false))
+    return $fullPath
+}
+
+function Assert-VcfDesignCapacity {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [object] $Requirements,
+
+        [Parameter(Mandatory)]
+        [object] $SupportedDesign
+    )
+
+    $hosts = @($Requirements.hosts)
+    if ($hosts.Count -ne [int] $SupportedDesign.hostCount) {
+        throw "The design requires exactly $($SupportedDesign.hostCount) hosts."
+    }
+    if ([int] $SupportedDesign.hostCount -ne [int] $SupportedDesign.minimumSupportedHostCount) {
+        throw 'The pinned design is not at the minimum supported host count.'
+    }
+    if ([int] $Requirements.deployment.siteCount -ne [int] $SupportedDesign.siteCount) {
+        throw 'The requested site count is not supported by the pinned design.'
+    }
+    if ([string] $Requirements.deployment.topology -ne [string] $SupportedDesign.topology) {
+        throw 'The requested topology is not supported by the pinned design.'
+    }
+
+    $survivorCount = $hosts.Count - [int] $Requirements.availability.maintenanceReserveHosts
+    $cores = @($hosts.physicalCores | Sort-Object | Select-Object -First $survivorCount | Measure-Object -Sum).Sum
+    $memory = @($hosts.memoryGiB | Sort-Object | Select-Object -First $survivorCount | Measure-Object -Sum).Sum
+    $storage = @($hosts.rawStorageTiB | Sort-Object | Select-Object -First $survivorCount | Measure-Object -Sum).Sum
+    $usableVcpu = [double] $cores * [double] $Requirements.capacityFactors.vcpuPerPhysicalCore
+    $usableMemory = [double] $memory * [double] $Requirements.capacityFactors.memoryUsableFraction
+    $usableStorage = [double] $storage * [double] $Requirements.capacityFactors.storageUsableFraction
+    if (
+        $usableVcpu -lt [double] $Requirements.demand.workloadVcpu -or
+        $usableMemory -lt [double] $Requirements.demand.workloadMemoryGiB -or
+        $usableStorage -lt [double] $Requirements.demand.workloadUsableStorageTiB
+    ) {
+        throw 'The requested workload does not fit after reserving one host for failure or maintenance.'
+    }
+}
+
+function New-VcfGreenfieldSddcSpec {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $RequirementsPath,
+
+        [Parameter(Mandatory)]
+        [string] $CompatibilityPath,
+
+        [Parameter(Mandatory)]
+        [string] $OutputPath
+    )
+
+    $requirements = Read-VcfJson -Path $RequirementsPath
+    $compatibility = Read-VcfJson -Path $CompatibilityPath
+    $authority = $compatibility.greenfield
+    $supportedDesign = $authority.supportedDesign
+    $bom = $authority.billOfMaterials
+
+    if ([string] $requirements.deployment.targetVcfVersion -ne [string] $authority.targetVcfVersion) {
+        throw 'The requested VCF release does not match the pinned compatibility release.'
+    }
+    Assert-VcfDesignCapacity -Requirements $requirements -SupportedDesign $supportedDesign
+
+    $hostSpecs = @()
+    foreach ($hostEntry in $requirements.hosts) {
+        $credential = Initialize-VcfInstallerSddcCredentials `
+            -Username 'root' `
+            -Password ([string] $requirements.secretPlaceholders.esxiRootPassword)
+        $hostSpecs += Initialize-VcfInstallerSddcHostSpec `
+            -Hostname ([string] $hostEntry.hostname) `
+            -Credentials $credential
+    }
+
+    $networkSpecs = @()
+    foreach ($network in $requirements.networks) {
+        $networkSpecs += Initialize-VcfInstallerSddcNetworkSpec `
+            -NetworkType ([string] $network.networkType) `
+            -Subnet ([string] $network.subnet) `
+            -Gateway ([string] $network.gateway) `
+            -SubnetMask ([string] $network.subnetMask) `
+            -IncludeIpAddress @($network.includeIpAddress) `
+            -VlanId ([uint32] $network.vlanId) `
+            -Mtu ([int] $network.mtu)
+    }
+
+    $dnsSpec = Initialize-VcfInstallerDnsSpec `
+        -Subdomain ([string] $requirements.dns.subdomain) `
+        -Nameservers @($requirements.dns.nameservers)
+
+    $vcenterSpec = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname ([string] $requirements.names.vcenterFqdn) `
+        -RootVcenterPassword ([string] $requirements.secretPlaceholders.vcenterRootPassword) `
+        -VmSize 'small' `
+        -StorageSize 'lstorage' `
+        -SsoDomain 'vsphere.local' `
+        -UseExistingDeployment $false `
+        -Version ([string] $bom.VCENTER)
+
+    $resourcePools = @()
+    foreach ($pool in $requirements.resourcePools) {
+        $resourcePools += Initialize-VcfInstallerResourcePoolSpec `
+            -Name ([string] $pool.name) `
+            -Type ([string] $pool.type) `
+            -CpuReservationPercentage ([uint32] $pool.cpuReservationPercentage) `
+            -MemoryReservationPercentage ([uint32] $pool.memoryReservationPercentage)
+    }
+    $clusterSpec = Initialize-VcfInstallerSddcClusterSpec `
+        -DatacenterName ([string] $requirements.names.datacenter) `
+        -ClusterName ([string] $requirements.names.cluster) `
+        -ResourcePoolSpecs $resourcePools
+
+    $uplinks = @()
+    foreach ($uplink in $supportedDesign.uplinks) {
+        $uplinks += Initialize-VcfInstallerVmnicToUplink `
+            -Id ([string] $uplink.id) `
+            -Uplink ([string] $uplink.uplink)
+    }
+    $dvsSpec = Initialize-VcfInstallerDvsSpec `
+        -DvsName ([string] $requirements.names.distributedSwitch) `
+        -Networks @($supportedDesign.requiredNetworkTypes) `
+        -Mtu 9000 `
+        -VmnicsToUplinks $uplinks
+
+    $nsxManagers = @()
+    foreach ($hostname in $requirements.names.nsxManagerFqdns) {
+        $nsxManagers += Initialize-VcfInstallerNsxtManagerSpec -Hostname ([string] $hostname)
+    }
+    $nsxtSpec = Initialize-VcfInstallerSddcNsxtSpec `
+        -NsxtManagers $nsxManagers `
+        -NsxtManagerSize ([string] $requirements.nsx.managerSize) `
+        -VipFqdn ([string] $requirements.names.nsxVipFqdn) `
+        -RootNsxtManagerPassword ([string] $requirements.secretPlaceholders.nsxRootPassword) `
+        -NsxtAdminPassword ([string] $requirements.secretPlaceholders.nsxAdminPassword) `
+        -NsxtAuditPassword ([string] $requirements.secretPlaceholders.nsxAuditPassword) `
+        -TransportVlanId ([int] $requirements.nsx.transportVlanId) `
+        -UseExistingDeployment $false `
+        -Version ([string] $bom.NSX_T_MANAGER)
+
+    $esaConfig = Initialize-VcfInstallerVsanEsaConfig -Enabled $true
+    $vsanSpec = Initialize-VcfInstallerVsanSpec `
+        -DatastoreName ([string] $requirements.names.datastore) `
+        -VsanDedup $false `
+        -EsaConfig $esaConfig `
+        -FailuresToTolerate ([uint32] $requirements.storage.failuresToTolerate)
+    $datastoreSpec = Initialize-VcfInstallerSddcDatastoreSpec -VsanSpec $vsanSpec
+
+    $sddcManagerSpec = Initialize-VcfInstallerSddcManagerSpec `
+        -Hostname ([string] $requirements.names.sddcManagerFqdn) `
+        -RootPassword ([string] $requirements.secretPlaceholders.sddcManagerRootPassword) `
+        -SshPassword ([string] $requirements.secretPlaceholders.sddcManagerSshPassword) `
+        -LocalUserPassword ([string] $requirements.secretPlaceholders.sddcManagerLocalPassword) `
+        -UseExistingDeployment $false `
+        -Version ([string] $bom.SDDC_MANAGER_VCF)
+
+    $sdkSpec = Initialize-VcfInstallerSddcSpec `
+        -SddcId ([string] $requirements.deployment.sddcId) `
+        -WorkflowType ([string] $requirements.deployment.workflowType) `
+        -HostSpecs $hostSpecs `
+        -Version ([string] $authority.targetVcfVersion) `
+        -VcenterSpec $vcenterSpec `
+        -ClusterSpec $clusterSpec `
+        -DvsSpecs @($dvsSpec) `
+        -NsxtSpec $nsxtSpec `
+        -NetworkSpecs $networkSpecs `
+        -DnsSpec $dnsSpec `
+        -NtpServers @($requirements.ntpServers) `
+        -SddcManagerSpec $sddcManagerSpec `
+        -ManagementPoolName ([string] $requirements.deployment.managementPoolName) `
+        -SkipEsxThumbprintValidation $false `
+        -SkipGatewayPingValidation $false `
+        -DatastoreSpec $datastoreSpec `
+        -VcfInstanceName ([string] $requirements.deployment.vcfInstanceName)
+
+    $payload = ConvertTo-VcfCanonicalValue -InputObject $sdkSpec
+    return Write-VcfJson -Value $payload -Path $OutputPath
+}
+
+function New-VcfEstateMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $InventoryPath,
+
+        [Parameter(Mandatory)]
+        [string] $CompatibilityPath,
+
+        [Parameter(Mandatory)]
+        [string] $OutputPath
+    )
+
+    $inventory = Read-VcfJson -Path $InventoryPath
+    $compatibility = Read-VcfJson -Path $CompatibilityPath
+    $authority = $compatibility.migration
+    if ([string] $inventory.inventoryId -ne [string] $authority.inventoryId) {
+        throw 'The inventory does not match the pinned migration authority.'
+    }
+
+    $inventoryById = @{}
+    foreach ($component in $inventory.components) {
+        if ($inventoryById.ContainsKey([string] $component.id)) {
+            throw "Duplicate inventory component: $($component.id)"
+        }
+        $inventoryById[[string] $component.id] = $component
+    }
+
+    $steps = @()
+    $order = 0
+    foreach ($componentIdValue in $authority.orderedComponentIds) {
+        $componentId = [string] $componentIdValue
+        if (-not $inventoryById.ContainsKey($componentId)) {
+            throw "The migration authority names an absent component: $componentId"
+        }
+        $order++
+        $component = $inventoryById[$componentId]
+        $steps += [ordered] @{
+            order = $order
+            componentId = $componentId
+            component = [string] $component.name
+            componentType = [string] $component.type
+            fromVersion = [string] $component.version
+            targetVersion = [string] $authority.targets.$componentId
+            gates = ConvertTo-VcfCanonicalValue -InputObject $authority.gates.$componentId
+        }
+    }
+    if ($steps.Count -ne $inventory.components.Count) {
+        throw 'Every inventory component must appear exactly once in the migration authority.'
+    }
+
+    $plan = [ordered] @{
+        schemaVersion = '1.0'
+        inventoryId = [string] $inventory.inventoryId
+        sourceVcfVersion = [string] $inventory.sourceVcfVersion
+        targetVcfVersion = [string] $authority.targetVcfVersion
+        steps = $steps
+    }
+    return Write-VcfJson -Value $plan -Path $OutputPath
+}
+
+Export-ModuleMember -Function New-VcfGreenfieldSddcSpec, New-VcfEstateMigrationPlan

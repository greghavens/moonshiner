{
  "specVersion": "1.0",
  "artifactSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "estateId", "snapshotId", "architecture", "sources", "steps", "research"],
    "properties": {
      "schemaVersion": {"type": "string", "enum": ["1.0"]},
      "estateId": {"type": "string", "minLength": 1},
      "snapshotId": {"type": "string", "minLength": 1},
      "architecture": {
        "type": "object",
        "additionalProperties": false,
        "required": ["managementDomain", "deploymentTarget", "components"],
        "properties": {
          "managementDomain": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "action", "protectedAssets"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "action": {"type": "string", "enum": ["NO_CHANGE"]},
              "protectedAssets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          },
          "deploymentTarget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workloadDomain", "vCenterFqdn", "network", "datastore"],
            "properties": {
              "workloadDomain": {"type": "string", "minLength": 1},
              "vCenterFqdn": {"type": "string", "minLength": 1},
              "network": {"type": "string", "minLength": 1},
              "datastore": {"type": "string", "minLength": 1}
            }
          },
          "components": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["component", "version", "profile", "nodeCount", "vCpuPerNode", "memoryGbPerNode", "dataDiskTbPerNode", "reservedIps", "placement", "capacity"],
              "properties": {
                "component": {"type": "string", "minLength": 1},
                "version": {"type": "string", "minLength": 1},
                "profile": {"type": "string", "minLength": 1},
                "nodeCount": {"type": "integer", "minimum": 1},
                "vCpuPerNode": {"type": "integer", "minimum": 1},
                "memoryGbPerNode": {"type": "integer", "minimum": 1},
                "dataDiskTbPerNode": {"type": "integer", "minimum": 0},
                "reservedIps": {"type": "integer", "minimum": 1},
                "placement": {"type": "string", "minLength": 1},
                "capacity": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}}
              }
            }
          }
        }
      },
      "sources": {
        "type": "array",
        "minItems": 3,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceId", "sourceProduct", "sourceVersion", "targetComponent", "targetVersion", "endOfGeneralSupport", "migrationMode", "carryForward", "recreate", "abandoned", "stepIds"],
          "properties": {
            "sourceId": {"type": "string", "minLength": 1},
            "sourceProduct": {"type": "string", "minLength": 1},
            "sourceVersion": {"type": "string", "minLength": 1},
            "targetComponent": {"type": "string", "minLength": 1},
            "targetVersion": {"type": "string", "minLength": 1},
            "endOfGeneralSupport": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "migrationMode": {"type": "string", "minLength": 1},
            "carryForward": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "recreate": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "abandoned": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "stepIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^S[0-9]{2}$"}}
          }
        }
      },
      "steps": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["order", "id", "phase", "action", "entryGates", "exitGates", "rollback"],
          "properties": {
            "order": {"type": "integer", "minimum": 1},
            "id": {"type": "string", "pattern": "^S[0-9]{2}$"},
            "phase": {"type": "string", "minLength": 1},
            "action": {"type": "string", "minLength": 1},
            "entryGates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "exitGates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "rollback": {"type": "string", "minLength": 1}
          }
        }
      },
      "research": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "url", "accessedOn", "claims"],
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "url": {"type": "string", "pattern": "^https://.+"},
            "accessedOn": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    }
  }
}

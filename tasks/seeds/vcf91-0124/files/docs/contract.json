{
  "contract_version": 1,
  "title": "VCF 9.1 vCenter cluster EVC asynchronous precheck gate",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/vsphere/openapi/automation/vcenter.yaml",
    "spec_blob_sha": "8028b0824c4ff3503d05f44814f967938a795c40",
    "spec_version": "9.1.0.0",
    "openapi_version": "3.0.3",
    "license": "Apache-2.0"
  },
  "server_base_path": "/api",
  "authentication": {
    "scheme_name": "api_key_auth",
    "type": "apiKey",
    "in": "header",
    "name": "vmware-api-session-id"
  },
  "operations": [
    {
      "operationId": "Vcenter.Cluster.EvcMode_checkSet$Task",
      "method": "POST",
      "path_template": "/vcenter/cluster/{cluster}/evc-mode?action=check-set&vmw-task=true",
      "path_parameters": [
        {
          "name": "cluster",
          "required": true,
          "type": "string"
        }
      ],
      "request": {
        "body_required": true,
        "content_type": "application/json",
        "schema": "Vcenter.Cluster.EvcMode.SetSpec"
      },
      "success": {
        "status": 202,
        "content_type": "application/json",
        "schema": "string",
        "meaning": "precheck task identifier"
      }
    },
    {
      "operationId": "Cis.Tasks_get",
      "method": "GET",
      "path_template": "/cis/tasks/{task}",
      "path_parameters": [
        {
          "name": "task",
          "required": true,
          "type": "string"
        }
      ],
      "optional_query_parameters": [
        {
          "name": "spec",
          "style": "form",
          "explode": true,
          "schema": "Cis.Tasks.GetSpec",
          "unset_wire_behavior": "omit"
        }
      ],
      "request": {
        "body_required": false
      },
      "success": {
        "status": 200,
        "content_type": "application/json",
        "schema": "Cis.Task.Info"
      }
    },
    {
      "operationId": "Vcenter.Cluster.EvcMode_set$Task",
      "method": "PUT",
      "path_template": "/vcenter/cluster/{cluster}/evc-mode?vmw-task=true",
      "path_parameters": [
        {
          "name": "cluster",
          "required": true,
          "type": "string"
        }
      ],
      "request": {
        "body_required": true,
        "content_type": "application/json",
        "schema": "Vcenter.Cluster.EvcMode.SetSpec"
      },
      "success": {
        "status": 202,
        "content_type": "application/json",
        "schema": "string",
        "meaning": "mutation task identifier"
      }
    }
  ],
  "schemas": {
    "Vcenter.Cluster.EvcMode.SetSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties_in_spec_order": [
        "evc_mode"
      ],
      "properties": {
        "evc_mode": {
          "schema": "Vcenter.EvcMode.EvcMode",
          "required": false,
          "unset_wire_behavior": "omit",
          "semantics": "When missing or null, the cluster EVC mode is reset."
        }
      }
    },
    "Vcenter.EvcMode.EvcMode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "masks"
      ],
      "properties_in_spec_order": [
        "key",
        "masks"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "masks": {
          "type": "array",
          "items": "Vcenter.EvcMode.FeatureMask"
        }
      }
    },
    "Vcenter.EvcMode.FeatureMask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "value"
      ],
      "properties_in_spec_order": [
        "key",
        "name",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "Cis.Tasks.GetSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "return_all": {
          "type": "boolean",
          "required": false
        },
        "exclude_result": {
          "type": "boolean",
          "required": false
        }
      }
    },
    "Cis.Task.Info": {
      "type": "object",
      "required": [
        "cancelable",
        "description",
        "operation",
        "service",
        "status"
      ],
      "status_values": [
        "PENDING",
        "RUNNING",
        "BLOCKED",
        "SUCCEEDED",
        "FAILED"
      ],
      "result_required": false
    },
    "Vcenter.Cluster.EvcMode.CheckResult": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "schema": "Vapi.Std.Errors.Error"
        },
        "host_system": {
          "type": "string",
          "required": false,
          "unset_wire_behavior": "omit"
        }
      }
    }
  },
  "workflow": {
    "precheck_operationId": "Vcenter.Cluster.EvcMode_checkSet$Task",
    "task_operationId": "Cis.Tasks_get",
    "mutation_operationId": "Vcenter.Cluster.EvcMode_set$Task",
    "mutation_gate": {
      "required_status": "SUCCEEDED",
      "allowed_result": "missing, null, or empty array",
      "on_any_other_result": "fail without invoking the mutation operation"
    },
    "same_request_body_for_precheck_and_mutation": true
  }
}

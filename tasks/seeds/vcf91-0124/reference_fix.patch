+    private void pollPrecheck(String taskId)
+            throws IOException, InterruptedException {
+        URI taskUri = URI.create(
+                apiRoot + "/cis/tasks/" + encodePathSegment(taskId));
+        for (int poll = 1; poll <= maxPolls; poll++) {
+            HttpRequest request = baseRequest(taskUri).GET().build();
+            HttpResponse<byte[]> response = send(request);
+            requireStatus(TASK_OPERATION, response, 200);
+
+            final Map<?, ?> task;
+            try {
+                Object parsed = parseJson(response.body());
+                if (!(parsed instanceof Map<?, ?> value)) {
+                    throw protocol("task response is not an object");
+                }
+                task = value;
+            } catch (IOException exception) {
+                throw precheckFailure(
+                        "precheck task response is malformed",
+                        taskId, null, -1);
+            }
+
+            Object statusValue = task.get("status");
+            if (!(statusValue instanceof String status)) {
+                throw precheckFailure(
+                        "precheck task has no string status",
+                        taskId, null, -1);
+            }
+            switch (status) {
+                case "PENDING", "RUNNING", "BLOCKED" -> {
+                    if (poll == maxPolls) {
+                        throw precheckFailure(
+                                "precheck poll limit was reached",
+                                taskId, status, -1);
+                    }
+                }
+                case "FAILED" -> throw precheckFailure(
+                        "precheck task failed",
+                        taskId, status, -1);
+                case "SUCCEEDED" -> {
+                    if (!task.containsKey("result")
+                            || task.get("result") == null) {
+                        return;
+                    }
+                    Object result = task.get("result");
+                    if (!(result instanceof List<?> checks)) {
+                        throw precheckFailure(
+                                "precheck result is not an array",
+                                taskId, status, -1);
+                    }
+                    if (!checks.isEmpty()) {
+                        throw precheckFailure(
+                                "precheck reported compatibility errors",
+                                taskId, status, checks.size());
+                    }
+                    return;
+                }
+                default -> throw precheckFailure(
+                        "precheck task has an unknown status",
+                        taskId, status, -1);
+            }
+        }
+        throw new AssertionError("unreachable");
+    }

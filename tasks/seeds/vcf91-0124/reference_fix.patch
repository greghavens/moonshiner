+    private static final class JsonParser {
+        private final String text;
+        private int index;
+
+        JsonParser(String text) {
+            this.text = text;
+        }
+
+        boolean atEnd() {
+            return index == text.length();
+        }
+
+        void skipWhitespace() {
+            while (index < text.length()) {
+                char item = text.charAt(index);
+                if (item == ' ' || item == '\n'
+                        || item == '\r' || item == '\t') {
+                    index++;
+                } else {
+                    break;
+                }
+            }
+        }
+
+        Object parseValue(int depth) throws IOException {
+            if (depth > 64) {
+                throw protocol("JSON nesting is too deep");
+            }
+            skipWhitespace();
+            if (atEnd()) {
+                throw protocol("JSON value is missing");
+            }
+            return switch (text.charAt(index)) {
+                case '"' -> parseString();
+                case '{' -> parseObject(depth + 1);
+                case '[' -> parseArray(depth + 1);
+                case 't' -> parseLiteral("true", Boolean.TRUE);
+                case 'f' -> parseLiteral("false", Boolean.FALSE);
+                case 'n' -> parseLiteral("null", null);
+                default -> parseNumber();
+            };
+        }
+
+        private Map<String, Object> parseObject(int depth)
+                throws IOException {
+            index++;
+            LinkedHashMap<String, Object> result =
+                    new LinkedHashMap<>();
+            skipWhitespace();
+            if (take('}')) {
+                return result;
+            }
+            while (true) {
+                skipWhitespace();
+                if (atEnd() || text.charAt(index) != '"') {
+                    throw protocol("JSON object key is missing");
+                }
+                String key = parseString();
+                skipWhitespace();
+                require(':');
+                Object value = parseValue(depth);
+                if (result.containsKey(key)) {
+                    throw protocol("JSON object has a duplicate key");
+                }
+                result.put(key, value);
+                skipWhitespace();
+                if (take('}')) {
+                    return result;
+                }
+                require(',');
+            }
+        }
+
+        private List<Object> parseArray(int depth)
+                throws IOException {
+            index++;
+            ArrayList<Object> result = new ArrayList<>();
+            skipWhitespace();
+            if (take(']')) {
+                return result;
+            }
+            while (true) {
+                result.add(parseValue(depth));
+                skipWhitespace();
+                if (take(']')) {
+                    return result;
+                }
+                require(',');
+            }
+        }
+
+        private String parseString() throws IOException {
+            require('"');
+            StringBuilder result = new StringBuilder();
+            while (!atEnd()) {
+                char item = text.charAt(index++);
+                if (item == '"') {
+                    if (!wellFormed(result.toString())) {
+                        throw protocol("JSON string has invalid Unicode");
+                    }
+                    return result.toString();
+                }
+                if (item < 0x20) {
+                    throw protocol("JSON string has a control character");
+                }
+                if (item != '\\') {
+                    result.append(item);
+                    continue;
+                }
+                if (atEnd()) {
+                    throw protocol("JSON escape is incomplete");
+                }
+                char escaped = text.charAt(index++);
+                switch (escaped) {
+                    case '"' -> result.append('"');
+                    case '\\' -> result.append('\\');
+                    case '/' -> result.append('/');
+                    case 'b' -> result.append('\b');
+                    case 'f' -> result.append('\f');
+                    case 'n' -> result.append('\n');
+                    case 'r' -> result.append('\r');
+                    case 't' -> result.append('\t');
+                    case 'u' -> result.append(parseHexCodeUnit());
+                    default -> throw protocol("JSON escape is invalid");
+                }
+            }
+            throw protocol("JSON string is unterminated");
+        }
+
+        private char parseHexCodeUnit() throws IOException {
+            if (index + 4 > text.length()) {
+                throw protocol("JSON Unicode escape is incomplete");
+            }
+            int value = 0;
+            for (int count = 0; count < 4; count++) {
+                int digit = Character.digit(text.charAt(index++), 16);
+                if (digit < 0) {
+                    throw protocol("JSON Unicode escape is invalid");
+                }
+                value = (value << 4) | digit;
+            }
+            return (char) value;
+        }
+
+        private Object parseLiteral(
+                String literal,
+                Object value) throws IOException {
+            if (!text.startsWith(literal, index)) {
+                throw protocol("JSON literal is invalid");
+            }
+            index += literal.length();
+            return value;
+        }
+
+        private BigDecimal parseNumber() throws IOException {
+            int start = index;
+            if (take('-') && atEnd()) {
+                throw protocol("JSON number is incomplete");
+            }
+            if (take('0')) {
+                if (!atEnd() && Character.isDigit(text.charAt(index))) {
+                    throw protocol("JSON number has a leading zero");
+                }
+            } else {
+                takeDigits(true);
+            }
+            if (take('.')) {
+                takeDigits(true);
+            }
+            if (take('e') || take('E')) {
+                take('+');
+                take('-');
+                takeDigits(true);
+            }
+            try {
+                return new BigDecimal(text.substring(start, index));
+            } catch (NumberFormatException exception) {
+                throw protocol("JSON number is invalid");
+            }
+        }
+
+        private void takeDigits(boolean requireOne)
+                throws IOException {
+            int start = index;
+            while (!atEnd()
+                    && Character.isDigit(text.charAt(index))) {
+                index++;
+            }
+            if (requireOne && start == index) {
+                throw protocol("JSON number is incomplete");
+            }
+        }
+
+        private boolean take(char expected) {
+            if (!atEnd() && text.charAt(index) == expected) {
+                index++;
+                return true;
+            }
+            return false;
+        }
+
+        private void require(char expected) throws IOException {
+            if (!take(expected)) {
+                throw protocol("JSON syntax is invalid");
+            }
+        }
     }

+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.LocalDate;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Builds the machine-readable VCF workload-domain architecture. */
+public final class VcfArchitecture {
+    public String design(Path estateInventory, Path compatibilitySnapshot) throws IOException {
+        Map<String, Object> estate = object(
+                Json.parse(Files.readString(estateInventory, StandardCharsets.UTF_8)),
+                "estate inventory");
+        Map<String, Object> snapshot = object(
+                Json.parse(Files.readString(compatibilitySnapshot, StandardCharsets.UTF_8)),
+                "compatibility snapshot");
+        Map<String, Object> request = object(
+                estate.get("requestedWorkloadDomain"), "requested workload domain");
+
+        LinkedHashMap<String, Object> artifact = map();
+        artifact.put("greenfieldSddcSpec", buildSddcSpec(request));
+        artifact.put("capacityPlan", buildCapacityPlan(request));
+        artifact.put("availabilityPlan", buildAvailabilityPlan(estate, request));
+        artifact.put("migrationPlan", buildMigrationPlan(estate, snapshot));
+        artifact.put("researchConsulted", researchRecord());
+        return Json.stringify(artifact);
+    }
+
+    private static Map<String, Object> buildSddcSpec(Map<String, Object> request) {
+        String targetVersion = string(request.get("targetVersion"), "targetVersion");
+        LinkedHashMap<String, Object> spec = map();
+        spec.put("sddcId", string(request.get("domainId"), "domainId"));
+        spec.put("workflowType", string(request.get("workflowType"), "workflowType"));
+        spec.put("version", targetVersion);
+
+        ArrayList<Object> hostSpecs = list();
+        Map<String, Object> sites = object(request.get("sites"), "sites");
+        for (Object siteValue : array(sites.get("data"), "sites.data")) {
+            Map<String, Object> site = object(siteValue, "data site");
+            for (Object hostname : array(site.get("hostnames"), "site hostnames")) {
+                LinkedHashMap<String, Object> host = map();
+                host.put("hostname", string(hostname, "host hostname"));
+                hostSpecs.add(host);
+            }
+        }
+        spec.put("hostSpecs", hostSpecs);
+
+        Map<String, Object> vcenterInput = object(request.get("vcenter"), "vcenter");
+        LinkedHashMap<String, Object> vcenter = map();
+        vcenter.put("vcenterHostname", string(vcenterInput.get("hostname"), "vcenter hostname"));
+        vcenter.put("rootVcenterPassword", string(vcenterInput.get("rootPassword"), "root password"));
+        vcenter.put("vmSize", string(vcenterInput.get("vmSize"), "vcenter vmSize"));
+        vcenter.put("storageSize", string(vcenterInput.get("storageSize"), "vcenter storageSize"));
+        vcenter.put("useExistingDeployment", false);
+        vcenter.put("version", targetVersion);
+        spec.put("vcenterSpec", vcenter);
+
+        List<Object> networkInputs = array(request.get("networks"), "networks");
+        ArrayList<Object> networkSpecs = list();
+        ArrayList<Object> networkTypes = list();
+        for (Object networkValue : networkInputs) {
+            Map<String, Object> input = object(networkValue, "network");
+            LinkedHashMap<String, Object> network = map();
+            String networkType = string(input.get("networkType"), "network type");
+            network.put("networkType", networkType);
+            network.put("subnet", string(input.get("subnet"), "network subnet"));
+            network.put("gateway", string(input.get("gateway"), "network gateway"));
+            ArrayList<Object> ranges = list();
+            LinkedHashMap<String, Object> range = map();
+            range.put("startIpAddress", string(input.get("startIpAddress"), "range start"));
+            range.put("endIpAddress", string(input.get("endIpAddress"), "range end"));
+            ranges.add(range);
+            network.put("includeIpAddressRanges", ranges);
+            network.put("vlanId", integer(input.get("vlanId"), "network vlanId"));
+            network.put("mtu", integer(input.get("mtu"), "network mtu"));
+            networkSpecs.add(network);
+            networkTypes.add(networkType);
+        }
+        spec.put("networkSpecs", networkSpecs);
+
+        Map<String, Object> dnsInput = object(request.get("dns"), "dns");
+        LinkedHashMap<String, Object> dns = map();
+        dns.put("subdomain", string(dnsInput.get("subdomain"), "dns subdomain"));
+        dns.put("nameservers", new ArrayList<>(array(dnsInput.get("nameservers"), "nameservers")));
+        spec.put("dnsSpec", dns);
+
+        Map<String, Object> switchInput = object(request.get("distributedSwitch"), "distributed switch");
+        LinkedHashMap<String, Object> dvs = map();
+        dvs.put("dvsName", string(switchInput.get("name"), "switch name"));
+        dvs.put("networks", networkTypes);
+        dvs.put("mtu", integer(switchInput.get("mtu"), "switch mtu"));
+        ArrayList<Object> mappings = list();
+        for (Object mappingValue : array(switchInput.get("vmnicsToUplinks"), "uplink mappings")) {
+            Map<String, Object> input = object(mappingValue, "uplink mapping");
+            LinkedHashMap<String, Object> mapping = map();
+            mapping.put("id", string(input.get("id"), "vmnic id"));
+            mapping.put("uplink", string(input.get("uplink"), "uplink"));
+            mappings.add(mapping);
+        }
+        dvs.put("vmnicsToUplinks", mappings);
+        ArrayList<Object> dvsSpecs = list();
+        dvsSpecs.add(dvs);
+        spec.put("dvsSpecs", dvsSpecs);
+
+        Map<String, Object> nsxInput = object(request.get("nsx"), "nsx");
+        LinkedHashMap<String, Object> nsx = map();
+        ArrayList<Object> managers = list();
+        for (Object managerValue : array(nsxInput.get("managerHostnames"), "NSX managers")) {
+            LinkedHashMap<String, Object> manager = map();
+            manager.put("hostname", string(managerValue, "NSX manager hostname"));
+            managers.add(manager);
+        }
+        nsx.put("nsxtManagers", managers);
+        nsx.put("nsxtManagerSize", string(nsxInput.get("managerSize"), "NSX manager size"));
+        nsx.put("vipFqdn", string(nsxInput.get("vipFqdn"), "NSX VIP"));
+        nsx.put("transportVlanId", integer(nsxInput.get("transportVlanId"), "transport VLAN"));
+        nsx.put("useExistingDeployment", false);
+        nsx.put("version", targetVersion);
+        spec.put("nsxtSpec", nsx);
+
+        Map<String, Object> datastoreInput = object(request.get("datastore"), "datastore");
+        LinkedHashMap<String, Object> esa = map();
+        esa.put("enabled", bool(datastoreInput.get("esaEnabled"), "ESA enabled"));
+        LinkedHashMap<String, Object> vsan = map();
+        vsan.put("datastoreName", string(datastoreInput.get("name"), "datastore name"));
+        vsan.put("esaConfig", esa);
+        vsan.put("failuresToTolerate", integer(
+                datastoreInput.get("failuresToTolerate"), "failuresToTolerate"));
+        LinkedHashMap<String, Object> datastore = map();
+        datastore.put("vsanSpec", vsan);
+        spec.put("datastoreSpec", datastore);
+        return spec;
+    }

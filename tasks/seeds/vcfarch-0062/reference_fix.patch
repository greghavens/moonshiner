+    private static Map<String, Object> buildCapacityPlan(Map<String, Object> request) {
+        Map<String, Object> sites = object(request.get("sites"), "sites");
+        List<Object> dataSites = array(sites.get("data"), "data sites");
+        if (dataSites.size() != 2) {
+            throw new IllegalArgumentException("the architecture requires exactly two data sites");
+        }
+        int firstSiteHosts = array(
+                object(dataSites.get(0), "first data site").get("hostnames"),
+                "first site hosts").size();
+        int secondSiteHosts = array(
+                object(dataSites.get(1), "second data site").get("hostnames"),
+                "second site hosts").size();
+        if (firstSiteHosts != secondSiteHosts) {
+            throw new IllegalArgumentException("the data sites must have equal host counts");
+        }
+        long perSiteHosts = firstSiteHosts;
+        Map<String, Object> perHost = object(request.get("perHostCapacity"), "per-host capacity");
+        long reservePercent = integer(request.get("reservePercent"), "reserve percent");
+        long vcpu = perSiteHosts
+                * integer(perHost.get("physicalCores"), "physical cores")
+                * integer(request.get("cpuOvercommitRatio"), "CPU overcommit ratio");
+        long memory = perSiteHosts
+                * integer(perHost.get("memoryGiB"), "host memory")
+                * (100L - reservePercent) / 100L;
+        long storage = perSiteHosts
+                * integer(perHost.get("rawStorageGiB"), "host raw storage")
+                * (100L - reservePercent) / 100L;
+        Map<String, Object> required = object(request.get("capacityRequired"), "required capacity");
+        boolean meets = vcpu >= integer(required.get("vcpu"), "required vCPU")
+                && memory >= integer(required.get("memoryGiB"), "required memory")
+                && storage >= integer(required.get("usableStorageGiB"), "required storage");
+
+        LinkedHashMap<String, Object> surviving = map();
+        surviving.put("vcpu", vcpu);
+        surviving.put("memoryGiB", memory);
+        surviving.put("usableStorageGiB", storage);
+        LinkedHashMap<String, Object> plan = map();
+        plan.put("required", copyObject(required));
+        plan.put("perHost", copyObject(perHost));
+        plan.put("plannedHostCount", (long) firstSiteHosts + secondSiteHosts);
+        plan.put("dataHostsPerSite", perSiteHosts);
+        plan.put("cpuOvercommitRatio", integer(request.get("cpuOvercommitRatio"), "CPU ratio"));
+        plan.put("reservePercent", reservePercent);
+        plan.put("survivingSiteCapacity", surviving);
+        plan.put("meetsSingleSiteLoss", meets);
+        return plan;
+    }
+
+    private static Map<String, Object> buildAvailabilityPlan(
+            Map<String, Object> estate, Map<String, Object> request) {
+        Map<String, Object> management = object(estate.get("managementDomain"), "management domain");
+        if (bool(management.get("changeAllowed"), "management changeAllowed")) {
+            throw new IllegalArgumentException("management domain must be immutable for this design");
+        }
+        Map<String, Object> sites = object(request.get("sites"), "sites");
+        ArrayList<Object> dataSitePlans = list();
+        for (Object siteValue : array(sites.get("data"), "data sites")) {
+            Map<String, Object> site = object(siteValue, "data site");
+            LinkedHashMap<String, Object> planned = map();
+            planned.put("id", string(site.get("id"), "site id"));
+            planned.put("hosts", new ArrayList<>(array(site.get("hostnames"), "site hosts")));
+            dataSitePlans.add(planned);
+        }
+        LinkedHashMap<String, Object> plan = map();
+        plan.put("topology", string(request.get("topology"), "topology"));
+        plan.put("failureRequirement", string(request.get("failureRequirement"), "failure requirement"));
+        plan.put("dataSites", dataSitePlans);
+        plan.put("witnessSite", string(
+                object(sites.get("witness"), "witness site").get("id"), "witness site id"));
+        plan.put("managementDomainChange", "NONE");
+        return plan;
+    }
+
+    private static Map<String, Object> buildMigrationPlan(
+            Map<String, Object> estate, Map<String, Object> snapshot) {
+        LinkedHashMap<String, Map<String, Object>> components = new LinkedHashMap<>();
+        for (Object componentValue : array(estate.get("components"), "estate components")) {
+            Map<String, Object> component = object(componentValue, "estate component");
+            String id = string(component.get("componentId"), "component id");
+            if (components.put(id, component) != null) {
+                throw new IllegalArgumentException("duplicate component id " + id);
+            }
+        }
+
+        ArrayList<Object> steps = list();
+        for (Object pinnedValue : array(snapshot.get("orderedPlan"), "ordered plan")) {
+            Map<String, Object> pinned = object(pinnedValue, "pinned transition");
+            String id = string(pinned.get("componentId"), "pinned component id");
+            Map<String, Object> component = components.remove(id);
+            if (component == null) {
+                throw new IllegalArgumentException("snapshot component is absent from estate: " + id);
+            }
+            LinkedHashMap<String, Object> step = map();
+            step.put("sequence", integer(pinned.get("sequence"), "sequence"));
+            step.put("componentId", id);
+            step.put("componentType", string(component.get("componentType"), "component type"));
+            step.put("currentVersion", string(component.get("currentVersion"), "current version"));
+            step.put("targetVersion", string(pinned.get("targetVersion"), "target version"));
+            step.put("action", string(pinned.get("action"), "action"));
+            step.put("gates", new ArrayList<>(array(pinned.get("gates"), "transition gates")));
+            steps.add(step);
+        }
+        if (!components.isEmpty()) {
+            throw new IllegalArgumentException("snapshot omits estate components: " + components.keySet());
+        }
+        LinkedHashMap<String, Object> plan = map();
+        plan.put("schemaVersion", 1L);
+        plan.put("estateId", string(estate.get("estateId"), "estate id"));
+        plan.put("targetRelease", string(snapshot.get("targetRelease"), "target release"));
+        plan.put("steps", steps);
+        return plan;
+    }

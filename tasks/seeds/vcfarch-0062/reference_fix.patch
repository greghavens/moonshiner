+        ArrayList<Object> sources = list();
+        sources.add(source(
+                "Update Sequence for VCF 9.0 and Compatible VMware Products",
+                "https://knowledge.broadcom.com/external/article/390634/update-sequence-for-vcf-90-and-compatibl.html",
+                "Core SDDC sequencing places SDDC Manager before NSX, vCenter, ESXi, and the vSAN disk-format step."));
+        sources.add(source(
+                "Applying individual product updates to VMware Cloud Foundation environments using Async Patch",
+                "https://knowledge.broadcom.com/external/article/344935/applying-individual-product-updates-to-v.html",
+                "The current table lists the estate's ESXi build with a VCF 9.0 target, but its vCenter and NSX rows only identify the VCF 5.2.1 line; the pinned snapshot remains authoritative for this artifact."));
+        sources.add(source(
+                "Correlating VMware Cloud Foundation version with the versions of its constituent products",
+                "https://knowledge.broadcom.com/external/article/314608/correlating-vmware-cloud-foundation-vers.html",
+                "The live bill of materials now includes releases newer than the pinned capture; its VCF 5.2.1 line provides the baseline component versions extended by the estate's individually patched builds."));
+        sources.add(source(
+                "Understanding vSAN on-disk format versions and compatibility.",
+                "https://knowledge.broadcom.com/external/article/327034/understanding-vsan-ondisk-format-version.html",
+                "The compatibility table identifies on-disk format 20 with vSAN 8.0 U3 and format 21 with 9.0 GA, consistent with the pinned post-upgrade step."));
+        return sources;
+    }

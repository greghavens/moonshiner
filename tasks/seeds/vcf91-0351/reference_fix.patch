+    private HttpResponse<String> send(String method, String path, String body)
+            throws IOException, InterruptedException {
+        HttpRequest.Builder request = HttpRequest.newBuilder(URI.create(baseUrl + path))
+                .timeout(Duration.ofSeconds(15))
+                .header("Authorization", "Bearer " + token)
+                .header("Accept", "application/json");
+        if (body == null) {
+            request.method(method, HttpRequest.BodyPublishers.noBody());
+        } else {
+            request.header("Content-Type", "application/json")
+                    .method(method, HttpRequest.BodyPublishers.ofString(body, StandardCharsets.UTF_8));
+        }
+        return http.send(request.build(), HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+    }
+
+    private static boolean successful(HttpResponse<String> response) {
+        return response.statusCode() >= 200 && response.statusCode() < 300;
+    }
+
+    private static String exactIdInPage(String body, String expectedName, String kind) {
+        Map<String, Object> page = object(Json.parse(body), kind + " page");
+        return exactId(array(page.get("content"), kind + " content"), expectedName, kind);
+    }
+
+    private static String exactIdInArray(String body, String expectedName, String kind) {
+        return exactId(array(Json.parse(body), kind + " list"), expectedName, kind);
+    }
+
+    private static String exactId(List<Object> values, String expectedName, String kind) {
+        String found = null;
+        for (Object value : values) {
+            Map<String, Object> candidate = object(value, kind + " item");
+            if (expectedName.equals(candidate.get("name"))) {
+                if (found != null) {
+                    throw new IllegalArgumentException("multiple exact " + kind + " matches");
+                }
+                Object id = candidate.get("id");
+                if (!(id instanceof String string) || string.isBlank()) {
+                    throw new IllegalArgumentException(kind + " match has no identifier");
+                }
+                found = string;
+            }
+        }
+        return found;
+    }
+
+    private void putSuccess(String name, int status, String id) {
+        LinkedHashMap<String, Object> step = new LinkedHashMap<>();
+        step.put("success", true);
+        step.put("httpStatus", status);
+        step.put("id", id);
+        steps.put(name, step);
+    }
+
+    private void putFailure(String name, HttpResponse<String> response, String id) {
+        putFailure(name, response.statusCode(), id, responseError(response));
+    }
+
+    private void putFailure(String name, int status, String id, String error) {
+        LinkedHashMap<String, Object> step = new LinkedHashMap<>();
+        step.put("success", false);
+        step.put("httpStatus", status);
+        step.put("id", id);
+        step.put("error", error);
+        steps.put(name, step);
+    }

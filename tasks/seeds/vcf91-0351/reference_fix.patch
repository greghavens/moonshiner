+                return finish(false);
+            }
+            putSuccess(activeStep, response.statusCode(), deploymentId);
+
+            activeStep = "deploymentUpdate";
+            LinkedHashMap<String, Object> patch = new LinkedHashMap<>();
+            patch.put("description", newDescription);
+            response = send("PATCH",
+                    "/deployment/api/deployments/" + encode(deploymentId), Json.write(patch));
+            if (!successful(response)) {
+                putFailure(activeStep, response, deploymentId);
+                return finish(false);
+            }
+            putSuccess(activeStep, response.statusCode(), deploymentId);
+
+            activeStep = "resourceLookup";
+            response = send("GET",
+                    "/deployment/api/deployments/" + encode(deploymentId)

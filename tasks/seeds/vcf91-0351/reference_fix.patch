+    private static String responseError(HttpResponse<String> response) {
+        try {
+            Map<String, Object> body = object(Json.parse(response.body()), "error response");
+            Object details = body.get("details");
+            if (details instanceof String string && !string.isBlank()) {
+                return string;
+            }
+        } catch (RuntimeException ignored) {
+            // Fall back to a status-based message for non-object or malformed error bodies.
+        }
+        return "HTTP " + response.statusCode();
+    }

+    private int run(String deploymentName, String resourceName,
+                    String newDescription, String actionName) {
+        try {
+            activeStep = "deploymentLookup";
+            HttpResponse<String> response = send("GET",
+                    "/deployment/api/deployments?name=" + encode(deploymentName), null);
+            if (!successful(response)) {
+                putFailure(activeStep, response, null);
+                return finish(false);
+            }
+            String deploymentId = exactIdInPage(response.body(), deploymentName, "deployment");
+            if (deploymentId == null) {
+                putFailure(activeStep, response.statusCode(), null,

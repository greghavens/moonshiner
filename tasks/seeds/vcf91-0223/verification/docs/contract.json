{
  "title": "VCF SDDC LCM Service APIs",
  "apiVersion": "9.1.0.0",
  "openapiVersion": "3.0.4",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commitSha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "specPath": "specifications/sddc-lcm/sddc-lcm-openapi.yaml",
    "specBlobSha": "fa97e0975ac108c81173b5bdd4fde57f20b2e190"
  },
  "security": {
    "scheme": "bearerToken",
    "type": "http",
    "httpScheme": "Bearer",
    "bearerFormat": "JWT",
    "note": "Applied globally by the specification's top-level `security` block. Every request carries `Authorization: Bearer <token>`."
  },
  "operations": {
    "getComponents": {
      "operationId": "getComponents",
      "method": "GET",
      "path": "/v1/components",
      "tag": "Components",
      "parameters": [
        {
          "name": "scope",
          "in": "query",
          "required": false,
          "type": "string",
          "enum": ["FLEET", "INSTANCE"],
          "style": "form",
          "explode": true
        }
      ],
      "queryParameterOrder": ["scope"],
      "responses": {
        "200": { "$ref": "#/schemas/Components" },
        "401": { "$ref": "#/schemas/ErrorResponse" },
        "500": { "$ref": "#/schemas/ErrorResponse" }
      }
    },
    "getComponentNodes": {
      "operationId": "getComponentNodes",
      "method": "GET",
      "path": "/v1/components/{componentId}/nodes",
      "tag": "Components",
      "parameters": [
        {
          "name": "componentId",
          "in": "path",
          "required": true,
          "type": "string",
          "format": "uuid",
          "style": "simple",
          "explode": true
        },
        {
          "name": "pageNumber",
          "in": "query",
          "required": false,
          "type": "integer",
          "style": "form",
          "explode": true
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "type": "integer",
          "style": "form",
          "explode": true,
          "description": "Page Size. Maximum allowed is 50."
        },
        {
          "name": "nodeTypes",
          "in": "query",
          "required": false,
          "type": "string",
          "style": "form",
          "explode": true,
          "description": "Comma-separated list of node types",
          "example": "control-plane,worker"
        }
      ],
      "queryParameterOrder": ["pageNumber", "pageSize", "nodeTypes"],
      "responses": {
        "200": { "$ref": "#/schemas/Nodes" },
        "401": { "$ref": "#/schemas/ErrorResponse" },
        "404": { "$ref": "#/schemas/ErrorResponse" },
        "500": { "$ref": "#/schemas/ErrorResponse" }
      }
    }
  },
  "wireRules": {
    "queryParameterOrder": "Query parameters are emitted in the order declared by `queryParameterOrder` for the operation. Unset optional parameters are skipped without disturbing the relative order of the rest.",
    "omitUnset": "An unset optional parameter is omitted from the request target entirely. It is never emitted as a bare key, as `key=`, or as `key=null`.",
    "nodeTypesEncoding": "`nodeTypes` is a single string parameter whose value is the requested node types joined by a literal `,`. The comma delimiter is a raw delimiter and is not percent-encoded.",
    "pathParameterStyle": "`componentId` uses OpenAPI style `simple` and is substituted into the path verbatim.",
    "requestBody": "Both operations are GET and carry no request body and no `Content-Type` request header.",
    "acceptHeader": "Every request sends `Accept: application/json`.",
    "authorizationHeader": "Every request sends `Authorization: Bearer <token>` where the token is the session secret of the caller's VCF connection."
  },
  "pagination": {
    "operationId": "getComponentNodes",
    "requestPageField": "pageNumber",
    "requestSizeField": "pageSize",
    "firstPageNumber": 0,
    "responseElementsField": "nodes",
    "responseMetadataField": "pageMetadata",
    "metadataFields": ["pageNumber", "pageSize", "totalElements", "totalPages"],
    "note": "The specification declares neither a page-number index base nor a server default page size. The pinned loopback fixture indexes from page 0, echoes the served page in `pageMetadata.pageNumber`, and applies its own default size when `pageSize` is omitted, so the client must follow `pageMetadata.totalPages` rather than assume a size. `getComponents` returns no `pageMetadata` and is not paginated."
  },
  "schemas": {
    "Components": {
      "type": "object",
      "properties": {
        "components": { "type": "array", "items": { "$ref": "#/schemas/Component" } }
      }
    },
    "Component": {
      "title": "Component",
      "type": "object",
      "description": "Installed Component subject to lifecycle.",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "componentType": { "type": "string" },
        "deploymentType": { "type": "string", "enum": ["OVA", "VSP"] },
        "version": { "type": "string" },
        "size": { "type": "string" },
        "fqdn": { "type": "string" },
        "certificate": { "type": "string" },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/schemas/Node" },
          "description": "Nodes forming a Component (cluster) (mostly applicable for OVA components or VSP cluster itself). The specification does not state that this inline array is complete, and it is not a substitute for getComponentNodes."
        },
        "scope": { "type": "string", "enum": ["FLEET", "INSTANCE"] },
        "vcenter": { "$ref": "#/schemas/Vcenter" },
        "vspCluster": { "$ref": "#/schemas/VspCluster" }
      }
    },
    "Nodes": {
      "type": "object",
      "properties": {
        "nodes": { "type": "array", "items": { "$ref": "#/schemas/Node" } },
        "pageMetadata": { "$ref": "#/schemas/PageMetadata" }
      }
    },
    "Node": {
      "type": "object",
      "properties": {
        "nodeType": { "type": "string" },
        "id": { "type": "string", "format": "uuid" },
        "version": { "type": "string" },
        "fqdn": { "type": "string" },
        "ipAddress": { "type": "string" },
        "status": { "type": "string" },
        "name": { "type": "string" },
        "size": { "type": "string" }
      }
    },
    "PageMetadata": {
      "type": "object",
      "description": "Retrieves the parameters needed to help pagination on client.",
      "properties": {
        "pageNumber": { "type": "integer" },
        "pageSize": { "type": "integer" },
        "totalElements": { "type": "integer" },
        "totalPages": { "type": "integer" }
      }
    },
    "Vcenter": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fqdn": { "type": "string" },
        "sslThumbprint": { "type": "string" }
      }
    },
    "VspCluster": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fqdn": { "type": "string" },
        "certificate": { "type": "string" },
        "type": { "type": "string", "enum": ["MANAGEMENT", "CONSUMPTION"] }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "description": "Provides detailed information about an error that occurred during a system operation.",
      "required": ["code", "message", "referenceId", "resolution", "timestamp"],
      "properties": {
        "code": { "type": "string" },
        "message": { "$ref": "#/schemas/LocalizableMessage" },
        "resolution": { "$ref": "#/schemas/LocalizableMessage" },
        "referenceId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "detail": { "type": "string" }
      }
    },
    "LocalizableMessage": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "defaultMessage": { "type": "string" },
        "localizedMessage": { "type": "string" },
        "args": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}

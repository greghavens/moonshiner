{
  "contract_format": "vsphere-automation-operation-subset-v1",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_license": "Apache-2.0",
    "tag": "9.0.0.0",
    "commit": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "path": "specifications/vsphere/openapi/automation/vcenter.yaml",
    "openapi": "3.0.3",
    "api_version": "9.0.0.0",
    "server_url_template": "https://{host}/api",
    "server_path_prefix": "/api",
    "not_the_contract": {
      "tag": "9.1.0.0",
      "commit": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
      "reason": "The 9.1.0.0 revision of the same file is a different API version and is not the pinned contract for this task."
    }
  },
  "security": {
    "scheme": "api_key_auth",
    "type": "apiKey",
    "in": "header",
    "name": "vmware-api-session-id"
  },
  "operations": [
    {
      "operationId": "Esx.Settings.Clusters.Software_apply$Task",
      "tag": "Esx.Settings.Clusters.Software",
      "method": "POST",
      "path": "/esx/settings/clusters/{cluster}/software",
      "required_query": {
        "action": "apply",
        "vmw-task": "true"
      },
      "path_parameters": [
        {
          "name": "cluster",
          "required": true,
          "type": "string",
          "resource_type": "ClusterComputeResource"
        }
      ],
      "query_parameters": [],
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "Esx.Settings.Clusters.Software.ApplySpec"
      },
      "success_responses": {
        "202": {
          "description": "The result of the POST /esx/settings/clusters/{cluster}/software?action=apply operation.",
          "content_type": "application/json",
          "schema": "string",
          "note": "The body is a bare JSON string holding the com.vmware.cis.task identifier of the accepted asynchronous operation."
        }
      },
      "error_responses": {
        "400": "Vapi.Std.Errors.Error",
        "401": "Vapi.Std.Errors.Unauthenticated",
        "404": "Vapi.Std.Errors.NotFound",
        "500": "Vapi.Std.Errors.Error",
        "503": "Vapi.Std.Errors.ServiceUnavailable"
      }
    },
    {
      "operationId": "Cis.Tasks_get",
      "tag": "Cis.Tasks",
      "method": "GET",
      "path": "/cis/tasks/{task}",
      "required_query": {},
      "path_parameters": [
        {
          "name": "task",
          "required": true,
          "type": "string",
          "resource_type": "com.vmware.cis.task"
        }
      ],
      "query_parameters": [
        {
          "name": "spec",
          "required": false,
          "in": "query",
          "style": "form",
          "explode": true,
          "schema": "Cis.Tasks.GetSpec",
          "note": "style=form with explode=true: the object is not sent under the name 'spec'. Each set property of Cis.Tasks.GetSpec becomes its own query parameter named after that property, with a JSON boolean literal as its value. A property that is not set contributes no query parameter."
        }
      ],
      "request": null,
      "success_responses": {
        "200": {
          "description": "Information about the specified task.",
          "content_type": "application/json",
          "schema": "Cis.Task.Info"
        }
      },
      "error_responses": {
        "401": "Vapi.Std.Errors.Unauthenticated",
        "403": "Vapi.Std.Errors.Unauthorized",
        "404": "Vapi.Std.Errors.NotFound",
        "500": "Vapi.Std.Errors.Error",
        "503": "Vapi.Std.Errors.ServiceUnavailable"
      }
    }
  ],
  "schemas": {
    "Esx.Settings.Clusters.Software.ApplySpec": {
      "type": "object",
      "required": [],
      "members": {
        "commit": {
          "type": "string",
          "resource_type": "com.vmware.esx.settings.commit",
          "description": "Minimum commit identifier of the desired software document to use. If missing or null or empty the apply operation uses the latest commit."
        },
        "hosts": {
          "type": "array",
          "items": "string",
          "uniqueItems": true,
          "resource_type": "HostSystem",
          "description": "The specific hosts within the cluster to consider. If missing or null or empty the apply operation remediates all hosts within the cluster."
        },
        "accept_eula": {
          "type": "boolean",
          "description": "Accept the VMware End User License Agreement before starting the apply operation."
        }
      }
    },
    "Cis.Tasks.GetSpec": {
      "type": "object",
      "required": [],
      "members": {
        "return_all": {
          "type": "boolean",
          "description": "If true, all data including operation-specific data is returned. If missing or null, only the data described in Cis.Task.Info is returned."
        },
        "exclude_result": {
          "type": "boolean",
          "description": "If true, the result is not included in the task information. If missing or null, the result of the operation is included."
        }
      }
    },
    "Cis.Task.Status": {
      "type": "string",
      "enum": ["PENDING", "RUNNING", "BLOCKED", "SUCCEEDED", "FAILED"],
      "nonterminal": ["PENDING", "RUNNING", "BLOCKED"],
      "terminal": ["SUCCEEDED", "FAILED"],
      "successful": ["SUCCEEDED"]
    },
    "Cis.Task.Info": {
      "type": "object",
      "required": ["cancelable", "description", "operation", "service", "status"],
      "members": {
        "status": { "type": "string", "schema": "Cis.Task.Status" },
        "cancelable": { "type": "boolean" },
        "description": { "type": "object", "schema": "Vapi.Std.LocalizableMessage" },
        "service": { "type": "string", "resource_type": "com.vmware.vapi.service" },
        "operation": { "type": "string", "resource_type": "com.vmware.vapi.operation" },
        "parent": { "type": "string", "resource_type": "com.vmware.cis.task" },
        "target": { "type": "object", "schema": "Vapi.Std.DynamicID" },
        "progress": { "type": "object", "schema": "Cis.Task.Progress" },
        "result": { "type": "any" },
        "error": { "type": "object", "schema": "Vapi.Std.Errors.Error" },
        "start_time": { "type": "string", "format": "date-time" },
        "end_time": { "type": "string", "format": "date-time" },
        "user": { "type": "string" }
      }
    },
    "Cis.Task.Progress": {
      "type": "object",
      "required": ["completed", "message", "total"],
      "members": {
        "total": { "type": "integer", "format": "int64" },
        "completed": { "type": "integer", "format": "int64" },
        "message": { "type": "object", "schema": "Vapi.Std.LocalizableMessage" }
      }
    },
    "Vapi.Std.LocalizableMessage": {
      "type": "object",
      "required": ["args", "default_message", "id"],
      "members": {
        "id": { "type": "string" },
        "default_message": { "type": "string" },
        "args": { "type": "array", "items": "string" },
        "params": { "type": "object" },
        "localized": { "type": "string" }
      }
    },
    "Vapi.Std.Errors.Error": {
      "type": "object",
      "required": ["error_type", "messages"],
      "members": {
        "messages": { "type": "array", "items": "Vapi.Std.LocalizableMessage" },
        "data": { "type": "object" },
        "error_type": { "type": "string" }
      }
    }
  }
}

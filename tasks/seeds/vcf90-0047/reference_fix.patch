+// sleep waits for d or until the context is done, whichever comes first.
+func sleep(ctx context.Context, d time.Duration) error {
+	timer := time.NewTimer(d)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return fmt.Errorf("esxsoftware: stopped polling: %w", ctx.Err())
+	case <-timer.C:
+		return nil
+	}
+}

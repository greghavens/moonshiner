+// do issues one request and returns the body of a response whose status is the
+// one the contract lists as success.
+func (c *Client) do(ctx context.Context, operationID, method, target string, body []byte, wantStatus int) ([]byte, error) {
+	if ctx == nil {
+		return nil, errors.New("esxsoftware: nil context")
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, fmt.Errorf("esxsoftware: %s not sent: %w", operationID, err)
+	}
+
+	var reader io.Reader
+	if body != nil {
+		reader = bytes.NewReader(body)
+	}
+	req, err := http.NewRequestWithContext(ctx, method, target, reader)
+	if err != nil {
+		return nil, fmt.Errorf("esxsoftware: building the %s request: %w", operationID, err)
+	}
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set(sessionHeader, c.sessionID)
+	if body != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("esxsoftware: %s: %w", operationID, err)
+	}
+	defer func() {
+		_, _ = io.Copy(io.Discard, resp.Body)
+		_ = resp.Body.Close()
+	}()
+
+	raw, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return nil, fmt.Errorf("esxsoftware: reading the %s response: %w", operationID, err)
+	}
+	if resp.StatusCode != wantStatus {
+		errType, messages := decodeVapiError(raw)
+		return nil, &APIError{
+			OperationID: operationID,
+			StatusCode:  resp.StatusCode,
+			ErrorType:   errType,
+			Messages:    messages,
+		}
+	}
+	return raw, nil
+}

+// messageWire is a Vapi.Std.LocalizableMessage as it arrives.
+type messageWire struct {
+	ID             string   `json:"id"`
+	DefaultMessage string   `json:"default_message"`
+	Args           []string `json:"args"`
+}
+
+func (m messageWire) toMessage() Message {
+	return Message{ID: m.ID, DefaultMessage: m.DefaultMessage, Args: m.Args}
+}
+
+type taskInfoWire struct {
+	Status      Status      `json:"status"`
+	Cancelable  bool        `json:"cancelable"`
+	Service     string      `json:"service"`
+	Operation   string      `json:"operation"`
+	Description messageWire `json:"description"`
+	Parent      string      `json:"parent"`
+	User        string      `json:"user"`
+	StartTime   string      `json:"start_time"`
+	EndTime     string      `json:"end_time"`
+	Progress    *struct {
+		Total     int64       `json:"total"`
+		Completed int64       `json:"completed"`
+		Message   messageWire `json:"message"`
+	} `json:"progress"`
+	Result json.RawMessage `json:"result"`
+	Error  json.RawMessage `json:"error"`
+}
+
+func (w taskInfoWire) toTaskInfo() *TaskInfo {
+	info := &TaskInfo{
+		Status:      w.Status,
+		Cancelable:  w.Cancelable,
+		Service:     w.Service,
+		Operation:   w.Operation,
+		Description: w.Description.toMessage(),
+		Parent:      w.Parent,
+		User:        w.User,
+		StartTime:   w.StartTime,
+		EndTime:     w.EndTime,
+		Result:      w.Result,
+		Error:       w.Error,
+	}
+	if w.Progress != nil {
+		info.Progress = &Progress{
+			Total:     w.Progress.Total,
+			Completed: w.Progress.Completed,
+			Message:   w.Progress.Message.toMessage(),
+		}
+	}
+	return info
+}
+
+// decodeVapiError pulls error_type and messages out of a Vapi.Std.Errors.Error.
+// A body that is not one yields no fields rather than an error of its own.
+func decodeVapiError(raw []byte) (string, []Message) {
+	if len(raw) == 0 {
+		return "", nil
+	}
+	var wire struct {
+		ErrorType string        `json:"error_type"`
+		Messages  []messageWire `json:"messages"`
+	}
+	if err := json.Unmarshal(raw, &wire); err != nil {
+		return "", nil
+	}
+	messages := make([]Message, 0, len(wire.Messages))
+	for _, m := range wire.Messages {
+		messages = append(messages, m.toMessage())
+	}
+	if len(messages) == 0 {
+		messages = nil
+	}
+	return wire.ErrorType, messages
 }

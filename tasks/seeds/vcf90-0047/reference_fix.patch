 // ApplyAndAwait applies the desired software document to the cluster and polls
 // the accepted task until it reaches a terminal state.
 func (c *Client) ApplyAndAwait(ctx context.Context, cluster string, spec ApplySpec, opts PollOptions) (Report, error) {
-	return Report{}, errors.New("esxsoftware: ApplyAndAwait is not implemented")
+	var report Report
+	if c == nil {
+		return report, errors.New("esxsoftware: nil client")
+	}
+
+	taskID, err := c.ApplySoftware(ctx, cluster, spec)
+	if err != nil {
+		return report, err
+	}
+	report.TaskID = taskID
+
+	interval := opts.Interval
+	if interval <= 0 {
+		interval = DefaultPollInterval
+	}
+
+	for {
+		info, err := c.GetTask(ctx, taskID, opts.GetSpec)
+		if err != nil {
+			return report, err
+		}
+
+		report.Polls++
+		report.Status = info.Status
+		report.StatusSequence = append(report.StatusSequence, info.Status)
+		report.Info = info
+
+		switch info.Status {
+		case StatusSucceeded:
+			report.Succeeded = true
+			return report, nil
+		case StatusFailed:
+			errType, messages := decodeVapiError(info.Error)
+			return report, &TaskFailedError{
+				TaskID:    taskID,
+				Status:    info.Status,
+				ErrorType: errType,
+				Messages:  messages,
+				Info:      info,
+			}

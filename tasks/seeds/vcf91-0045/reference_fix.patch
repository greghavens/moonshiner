+    private static void requireSuccess(
+            HttpResponse<String> response,
+            int expectedStatus,
+            String operation) throws IOException {
+        if (response.statusCode() != expectedStatus) {
+            throw new IOException(
+                    operation + " returned HTTP " + response.statusCode());
+        }
+        String contentType = response.headers()
+                .firstValue("Content-Type")
+                .orElse("");
+        int separator = contentType.indexOf(';');
+        String mediaType = separator < 0
+                ? contentType.trim()
+                : contentType.substring(0, separator).trim();
+        if (!mediaType.equalsIgnoreCase("application/json")) {
+            throw new IOException(operation + " returned an unexpected media type");
+        }
+    }
+
+    private static String normalizeStatus(String status) {

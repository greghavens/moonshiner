+    private static String jsonString(String value) {
+        StringBuilder encoded = new StringBuilder(value.length() + 2).append('"');
+        for (int index = 0; index < value.length(); index++) {
+            char current = value.charAt(index);
+            switch (current) {
+                case '"' -> encoded.append("\\\"");
+                case '\\' -> encoded.append("\\\\");
+                case '\b' -> encoded.append("\\b");
+                case '\f' -> encoded.append("\\f");
+                case '\n' -> encoded.append("\\n");
+                case '\r' -> encoded.append("\\r");
+                case '\t' -> encoded.append("\\t");
+                default -> {
+                    if (current < 0x20) {
+                        encoded.append("\\u");
+                        encoded.append(HEX[(current >>> 12) & 0xf]);
+                        encoded.append(HEX[(current >>> 8) & 0xf]);
+                        encoded.append(HEX[(current >>> 4) & 0xf]);
+                        encoded.append(HEX[current & 0xf]);
+                    } else {
+                        encoded.append(current);
+                    }
+                }
+            }
+        }
+        return encoded.append('"').toString();
+    }
+
+    private static String encodePathSegment(String value) {
+        byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+        StringBuilder encoded = new StringBuilder(bytes.length);
+        for (byte item : bytes) {
+            int current = item & 0xff;
+            if ((current >= 'a' && current <= 'z')
+                    || (current >= 'A' && current <= 'Z')
+                    || (current >= '0' && current <= '9')
+                    || current == '-'
+                    || current == '.'
+                    || current == '_'
+                    || current == '~') {
+                encoded.append((char) current);
+            } else {
+                encoded.append('%')
+                        .append(HEX[current >>> 4])
+                        .append(HEX[current & 0xf]);
+            }
+        }
+        return encoded.toString();
+    }

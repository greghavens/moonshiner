+    private static boolean isSafeBearer(String token) {
+        if (token.isBlank()) {
+            return false;
+        }
+        for (int index = 0; index < token.length(); index++) {
+            char current = token.charAt(index);
+            if (current <= 0x20 || current == 0x7f) {
+                return false;
+            }
+        }
+        return true;
+    }

diff --git a/VcfAriaMigration/VcfAriaMigration.psm1 b/VcfAriaMigration/VcfAriaMigration.psm1
new file mode 100644
index 0000000..a65471d
--- /dev/null
+++ b/VcfAriaMigration/VcfAriaMigration.psm1
@@ -0,0 +1,176 @@
+Set-StrictMode -Version Latest
+
+function Get-VcfSdkInventory {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [hashtable] $SddcConnectionParameters,
+
+        [Parameter(Mandatory)]
+        [hashtable] $OpsConnectionParameters,
+
+        [Parameter(Mandatory)]
+        [guid] $OpsIntegrationId,
+
+        [hashtable] $DomainRequestParameters = @{},
+
+        [hashtable] $HostRequestParameters = @{}
+    )
+
+    $sddcConnection = $null
+    $opsConnection = $null
+    try {
+        $sddcConnection = Connect-VcfSddcManagerServer @SddcConnectionParameters
+        $opsConnection = Connect-VcfOpsServer @OpsConnectionParameters
+
+        [pscustomobject][ordered]@{
+            Domains = @(Invoke-VcfGetDomains -Server $sddcConnection @DomainRequestParameters)
+            Hosts = @(Invoke-VcfGetHosts -Server $sddcConnection @HostRequestParameters)
+            OperationsDomainSummary = Invoke-VcfOpsGetDomainSummary -Server $opsConnection -IntegrationId $OpsIntegrationId
+        }
+    }
+    finally {
+        if ($null -ne $opsConnection) {
+            Disconnect-VcfOpsServer -Server $opsConnection
+        }
+        if ($null -ne $sddcConnection) {
+            Disconnect-VcfSddcManagerServer -Server $sddcConnection
+        }
+    }
+}
+
+function New-VcfMigrationArchitecture {
+    [CmdletBinding()]
+    param(
+        [string] $InventoryPath = (Join-Path (Split-Path -Parent $PSScriptRoot) 'estate-inventory.json'),
+
+        [string] $CompatibilitySnapshotPath = (Join-Path (Split-Path -Parent $PSScriptRoot) 'compatibility-snapshot.json'),
+
+        [string] $OutputPath = (Join-Path (Split-Path -Parent $PSScriptRoot) 'migration-architecture.json')
+    )
+
+    $inventory = Get-Content -LiteralPath $InventoryPath -Raw |
+        ConvertFrom-Json -AsHashtable -Depth 100
+    $snapshot = Get-Content -LiteralPath $CompatibilitySnapshotPath -Raw |
+        ConvertFrom-Json -AsHashtable -Depth 100
+
+    if ($inventory.targetVcfVersion -ne $snapshot.targetVcfVersion) {
+        throw 'Inventory and compatibility snapshot target versions differ.'
+    }
+
+    $dataSites = @(
+        foreach ($site in $inventory.managementDomain.dataSites) {
+            [ordered]@{
+                siteId = $site.siteId
+                faultDomainId = $site.faultDomainId
+                dataHostCount = @($site.hosts).Count
+            }
+        }
+    )
+
+    $targetComponents = @(
+        foreach ($target in $snapshot.targetComponents) {
+            [ordered]@{
+                component = $target.component
+                version = $target.version
+                deploymentMode = $target.deploymentMode
+                sizing = $target.sizing
+                placement = [ordered]@{
+                    managementDomainId = $inventory.managementDomain.id
+                    siteDistribution = @($target.siteDistribution)
+                    antiAffinity = $target.antiAffinity
+                    applicationWitness = $target.applicationWitness
+                }
+            }
+        }
+    )
+
+    $supportBoundaries = @(
+        foreach ($route in $snapshot.routes) {
+            [ordered]@{
+                sourceProduct = $route.sourceProduct
+                sourceVersion = $route.sourceVersion
+                endOfGeneralSupport = $route.endOfGeneralSupport
+                requiredAction = 'complete-supported-transition-before-eogs'
+            }
+        }
+    )
+
+    $migrationPlan = @(
+        foreach ($route in $snapshot.routes) {
+            $source = @(
+                $inventory.sourceInstances |
+                    Where-Object {
+                        $_.product -eq $route.sourceProduct -and
+                        $_.version -eq $route.sourceVersion
+                    }
+            )
+            if ($source.Count -ne 1) {
+                throw "Expected exactly one inventory source for $($route.sourceProduct) $($route.sourceVersion)."
+            }
+            $source = $source[0]
+            $decidedItems = @($route.carries.itemId) + @($route.abandons.itemId)
+            if (@($decidedItems | Sort-Object -Unique).Count -ne @($source.contentItems).Count) {
+                throw "Compatibility decisions do not cover the content for $($source.instanceId)."
+            }
+
+            [ordered]@{
+                order = $route.order
+                stepId = $route.stepId
+                source = [ordered]@{
+                    instanceId = $source.instanceId
+                    product = $source.product
+                    version = $source.version
+                }
+                target = [ordered]@{
+                    component = $route.targetComponent
+                    version = $route.targetVersion
+                }
+                route = $route.route
+                inPlaceSupported = $route.inPlaceSupported
+                carries = @($route.carries)
+                abandons = @($route.abandons)
+                gates = @($route.gates)
+                dependsOn = @($route.dependsOn)
+                rollbackBoundary = $route.rollbackBoundary
+            }
+        }
+    )
+
+    $architecture = [ordered]@{
+        schemaVersion = '1.0'
+        architectureId = 'northstar-aria-to-vcf-9.0.2'
+        generatedBy = [ordered]@{
+            module = 'VcfAriaMigration'
+            moduleVersion = '1.0.0'
+            sdkModules = @($snapshot.sdkModules)
+        }
+        sourceInventoryId = $inventory.inventoryId
+        compatibilitySnapshotId = $snapshot.snapshotId
+        targetVcfVersion = $snapshot.targetVcfVersion
+        resilience = [ordered]@{
+            topology = $snapshot.resilienceRules.topology
+            managementDomainId = $inventory.managementDomain.id
+            siteFailuresToTolerate = $inventory.managementDomain.storagePolicy.siteFailuresToTolerate
+            hostFailuresToToleratePerSite = $inventory.managementDomain.storagePolicy.hostFailuresToToleratePerSite
+            raidLevel = $inventory.managementDomain.storagePolicy.raidLevel
+            dataSites = $dataSites
+            totalDataHostCount = [int](($dataSites.dataHostCount | Measure-Object -Sum).Sum)
+            vsanWitness = [ordered]@{
+                assetId = $inventory.managementDomain.vsanWitness.assetId
+                siteId = $inventory.managementDomain.vsanWitness.siteId
+                faultDomainId = $inventory.managementDomain.vsanWitness.faultDomainId
+                role = $inventory.managementDomain.vsanWitness.kind
+                hostsWorkloads = $inventory.managementDomain.vsanWitness.hostsWorkloads
+            }
+        }
+        targetComponents = $targetComponents
+        supportBoundaries = $supportBoundaries
+        migrationPlan = $migrationPlan
+    }
+
+    $architecture | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $OutputPath -Encoding utf8
+    Get-Item -LiteralPath $OutputPath
+}
+
+Export-ModuleMember -Function Get-VcfSdkInventory, New-VcfMigrationArchitecture

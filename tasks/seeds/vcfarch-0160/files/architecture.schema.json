{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:northstar:vcf-migration-architecture:1.0",
  "title": "Northstar VCF migration architecture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "architectureId",
    "generatedBy",
    "sourceInventoryId",
    "compatibilitySnapshotId",
    "targetVcfVersion",
    "resilience",
    "targetComponents",
    "supportBoundaries",
    "migrationPlan"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "architectureId": {"type": "string", "minLength": 1},
    "generatedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "moduleVersion", "sdkModules"],
      "properties": {
        "module": {"const": "VcfAriaMigration"},
        "moduleVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sdkModules": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "sourceInventoryId": {"type": "string"},
    "compatibilitySnapshotId": {"type": "string"},
    "targetVcfVersion": {"type": "string"},
    "resilience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topology",
        "managementDomainId",
        "siteFailuresToTolerate",
        "hostFailuresToToleratePerSite",
        "raidLevel",
        "dataSites",
        "totalDataHostCount",
        "vsanWitness"
      ],
      "properties": {
        "topology": {"type": "string"},
        "managementDomainId": {"type": "string"},
        "siteFailuresToTolerate": {"type": "integer", "minimum": 0},
        "hostFailuresToToleratePerSite": {"type": "integer", "minimum": 0},
        "raidLevel": {"type": "string"},
        "dataSites": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["siteId", "faultDomainId", "dataHostCount"],
            "properties": {
              "siteId": {"type": "string"},
              "faultDomainId": {"type": "string"},
              "dataHostCount": {"type": "integer", "minimum": 1}
            }
          }
        },
        "totalDataHostCount": {"type": "integer", "minimum": 1},
        "vsanWitness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assetId", "siteId", "faultDomainId", "role", "hostsWorkloads"],
          "properties": {
            "assetId": {"type": "string"},
            "siteId": {"type": "string"},
            "faultDomainId": {"type": "string"},
            "role": {"type": "string"},
            "hostsWorkloads": {"type": "boolean"}
          }
        }
      }
    },
    "targetComponents": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/targetComponent"}
    },
    "supportBoundaries": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceProduct", "sourceVersion", "endOfGeneralSupport", "requiredAction"],
        "properties": {
          "sourceProduct": {"type": "string"},
          "sourceVersion": {"type": "string"},
          "endOfGeneralSupport": {"type": "string", "format": "date"},
          "requiredAction": {"const": "complete-supported-transition-before-eogs"}
        }
      }
    },
    "migrationPlan": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/migrationStep"}
    }
  },
  "$defs": {
    "sizing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "nodeCount",
        "vCpuPerNode",
        "memoryGbPerNode",
        "witnessNodeCount",
        "witnessVCpu",
        "witnessMemoryGb",
        "capacityUnit",
        "requiredCapacity",
        "plannedCapacity"
      ],
      "properties": {
        "profile": {"type": "string"},
        "nodeCount": {"type": "integer", "minimum": 1},
        "vCpuPerNode": {"type": "integer", "minimum": 1},
        "memoryGbPerNode": {"type": "integer", "minimum": 1},
        "witnessNodeCount": {"type": "integer", "minimum": 0},
        "witnessVCpu": {"type": "integer", "minimum": 0},
        "witnessMemoryGb": {"type": "integer", "minimum": 0},
        "capacityUnit": {"type": "string"},
        "requiredCapacity": {"type": "integer", "minimum": 1},
        "plannedCapacity": {"type": "integer", "minimum": 1}
      }
    },
    "sitePlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["siteId", "nodeCount"],
      "properties": {
        "siteId": {"type": "string"},
        "nodeCount": {"type": "integer", "minimum": 1}
      }
    },
    "applicationWitness": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["siteId", "computeId", "role", "hostsWorkloads"],
      "properties": {
        "siteId": {"type": "string"},
        "computeId": {"type": "string"},
        "role": {"type": "string"},
        "hostsWorkloads": {"type": "boolean"}
      }
    },
    "targetComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version", "deploymentMode", "sizing", "placement"],
      "properties": {
        "component": {"type": "string"},
        "version": {"type": "string"},
        "deploymentMode": {"type": "string"},
        "sizing": {"$ref": "#/$defs/sizing"},
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["managementDomainId", "siteDistribution", "antiAffinity", "applicationWitness"],
          "properties": {
            "managementDomainId": {"type": "string"},
            "siteDistribution": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/sitePlacement"}
            },
            "antiAffinity": {"type": "boolean"},
            "applicationWitness": {"$ref": "#/$defs/applicationWitness"}
          }
        }
      }
    },
    "carryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "mode"],
      "properties": {
        "itemId": {"type": "string"},
        "mode": {"type": "string"}
      }
    },
    "abandonItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "handling"],
      "properties": {
        "itemId": {"type": "string"},
        "handling": {"type": "string"}
      }
    },
    "migrationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "stepId",
        "source",
        "target",
        "route",
        "inPlaceSupported",
        "carries",
        "abandons",
        "gates",
        "dependsOn",
        "rollbackBoundary"
      ],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "stepId": {"type": "string"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["instanceId", "product", "version"],
          "properties": {
            "instanceId": {"type": "string"},
            "product": {"type": "string"},
            "version": {"type": "string"}
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["component", "version"],
          "properties": {
            "component": {"type": "string"},
            "version": {"type": "string"}
          }
        },
        "route": {"type": "string"},
        "inPlaceSupported": {"type": "boolean"},
        "carries": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/carryItem"}
        },
        "abandons": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/abandonItem"}
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "rollbackBoundary": {"type": "string"}
      }
    }
  }
}

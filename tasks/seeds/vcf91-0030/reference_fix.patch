+
+func validateSpec(spec AlbControllerClusterSpec) error {
+	if len(spec.NSXIDs) != 1 ||
+		spec.NSXIDs[0] == "" ||
+		spec.NSXIDs[0] != strings.TrimSpace(spec.NSXIDs[0]) {
+		return errors.New("NSXIDs must contain exactly one non-empty trimmed ID")
+	}
+	if spec.ClusterName == "" ||
+		spec.ClusterName != strings.TrimSpace(spec.ClusterName) ||
+		len(spec.ClusterName) > 80 {
+		return errors.New("ClusterName must be a non-empty trimmed string of at most 80 bytes")
+	}
+	if !validFQDN(spec.ClusterFQDN) {
+		return errors.New("ClusterFQDN must match the contract FQDN syntax")
+	}
+	switch spec.FormFactor {
+	case "XLARGE", "LARGE", "MEDIUM", "SMALL":
+	default:
+		return errors.New("FormFactor is not supported by the contract")
+	}
+	if spec.AdminPassword == "" {
+		return errors.New("AdminPassword must be non-empty")
+	}
+	if spec.BundleID == "" || spec.BundleID != strings.TrimSpace(spec.BundleID) {
+		return errors.New("BundleID must be a non-empty trimmed string")
+	}
+	if spec.Nodes != nil {
+		if len(*spec.Nodes) < 1 || len(*spec.Nodes) > 3 {
+			return errors.New("Nodes must contain between one and three nodes when set")
+		}
+		for _, node := range *spec.Nodes {
+			ip := net.ParseIP(node.IPAddress)
+			if ip == nil || ip.To4() == nil ||
+				node.IPAddress != strings.TrimSpace(node.IPAddress) {
+				return errors.New("each node IPAddress must be an IPv4 address")
+			}
+		}
+	}
+	if spec.VCFOpsAdminPassword != nil &&
+		*spec.VCFOpsAdminPassword == "" {
+		return errors.New("VCFOpsAdminPassword must be non-empty when set")
+	}
+	return nil
+}
+
+func validFQDN(value string) bool {
+	if value == "" || value != strings.TrimSpace(value) {
+		return false
+	}
+	for _, label := range strings.Split(value, ".") {
+		if len(label) < 1 || len(label) > 63 ||
+			!asciiLetterOrDigit(label[0]) ||
+			!asciiLetterOrDigit(label[len(label)-1]) {
+			return false
+		}
+		for index := 1; index < len(label)-1; index++ {
+			if !asciiLetterOrDigit(label[index]) && label[index] != '-' {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func asciiLetterOrDigit(value byte) bool {
+	return value >= 'a' && value <= 'z' ||
+		value >= 'A' && value <= 'Z' ||
+		value >= '0' && value <= '9'
+}
+
+func (c *Client) post(
+	ctx context.Context,
+	operationID string,
+	path string,
+	rawQuery string,
+	body []byte,
+) (int, []byte, error) {
+	target := *c.baseURL
+	target.Path = path
+	target.RawQuery = rawQuery
+	request, err := http.NewRequestWithContext(
+		ctx,
+		http.MethodPost,
+		target.String(),
+		bytes.NewReader(body),
+	)
+	if err != nil {
+		return 0, nil, errors.New("cannot create SDDC Manager request")
+	}
+	request.Header.Set("Accept", "application/json")
+	request.Header.Set("Authorization", "Bearer "+c.accessToken)
+	request.Header.Set("Content-Type", "application/json")
+
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		if response != nil && response.Body != nil {
+			_ = response.Body.Close()
+		}
+		if contextErr := ctx.Err(); contextErr != nil {
+			return 0, nil, contextErr
+		}
+		return 0, nil, &TransportError{OperationID: operationID}
+	}
+	defer response.Body.Close()
+	responseBody, err := io.ReadAll(
+		io.LimitReader(response.Body, maxResponseBytes+1),
+	)
+	if err != nil {
+		if contextErr := ctx.Err(); contextErr != nil {
+			return 0, nil, contextErr
+		}
+		return 0, nil, &TransportError{OperationID: operationID}
+	}
+	if len(responseBody) > maxResponseBytes {
+		return 0, nil, &ProtocolError{
+			OperationID: operationID,
+			Reason:      "response body exceeded limit",
+		}
+	}
+	return response.StatusCode, responseBody, nil
+}
+
+func decodeSuccess(
+	operationID string,
+	body []byte,
+	target any,
+	required ...string,
+) error {
+	var object map[string]json.RawMessage
+	if err := json.Unmarshal(body, &object); err != nil || object == nil {
+		return &ProtocolError{
+			OperationID: operationID,
+			Reason:      "success body is not a JSON object",
+		}
+	}
+	for _, name := range required {
+		value, exists := object[name]
+		if !exists {
+			return &ProtocolError{
+				OperationID: operationID,
+				Reason:      "success body omitted a required property",
+			}
+		}
+		var text string
+		if err := json.Unmarshal(value, &text); err != nil || text == "" {
+			return &ProtocolError{
+				OperationID: operationID,
+				Reason:      "required success property is not a non-empty string",
+			}
+		}
+	}
+	if err := json.Unmarshal(body, target); err != nil {
+		return &ProtocolError{
+			OperationID: operationID,
+			Reason:      "success body could not be decoded",
+		}
+	}
+	return nil
+}
+
+func decodeAPIError(
+	operationID string,
+	statusCode int,
+	body []byte,
+) *APIError {
+	var envelope struct {
+		ErrorCode          string `json:"errorCode"`
+		Message            string `json:"message"`
+		RemediationMessage string `json:"remediationMessage"`
+		ReferenceToken     string `json:"referenceToken"`
+	}
+	_ = json.Unmarshal(body, &envelope)
+	return &APIError{
+		OperationID:        operationID,
+		StatusCode:         statusCode,
+		ErrorCode:          envelope.ErrorCode,
+		Message:            envelope.Message,
+		RemediationMessage: envelope.RemediationMessage,
+		ReferenceToken:     envelope.ReferenceToken,
+	}
 }

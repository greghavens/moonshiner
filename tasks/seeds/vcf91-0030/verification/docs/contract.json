{
  "contract_format": "focused-openapi-projection-v1",
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "repository_license": "Apache-2.0",
    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "openapi": "3.0.1",
    "info_title": "SDDC Manager API Reference Guide",
    "info_version": "9.1.0.0"
  },
  "operations": [
    {
      "operationId": "validateALBControllerClusterCreationSpec",
      "method": "POST",
      "path": "/v1/alb-clusters/validations",
      "tag": "ALBClusters",
      "summary": "Perform validiation of the AlbControllerClusterSpec specification",
      "query_parameters": [
        {
          "name": "skipCompatibilityCheck",
          "in": "query",
          "description": "Pass an optional Skip compatibility checks",
          "required": false,
          "schema": {
            "type": "boolean",
            "default": false
          }
        }
      ],
      "request_body": {
        "required": true,
        "media_type": "application/json",
        "schema_ref": "#/components/schemas/AlbControllerClusterSpec"
      },
      "responses": {
        "200": {
          "description": "OK",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Validation"
        },
        "400": {
          "description": "Bad Request",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        },
        "500": {
          "description": "InternalServerError",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        }
      }
    },
    {
      "operationId": "deployALBCluster",
      "method": "POST",
      "path": "/v1/alb-clusters",
      "tag": "ALBClusters",
      "summary": "Deploy an ALB cluster",
      "query_parameters": [
        {
          "name": "skipCompatibilityCheck",
          "in": "query",
          "description": "Pass an optional Skip compatibility checks",
          "required": false,
          "schema": {
            "type": "boolean",
            "default": false
          }
        }
      ],
      "request_body": {
        "required": true,
        "media_type": "application/json",
        "schema_ref": "#/components/schemas/AlbControllerClusterSpec"
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Task"
        },
        "400": {
          "description": "Bad Request",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        },
        "500": {
          "description": "InternalServerError",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        }
      }
    }
  ],
  "schemas": {
    "AlbControllerClusterSpec": {
      "required": [
        "adminPassword",
        "bundleId",
        "clusterFqdn",
        "clusterName",
        "formFactor",
        "nsxIds"
      ],
      "type": "object",
      "properties": {
        "nsxIds": {
          "maxItems": 1,
          "minItems": 0,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "clusterName": {
          "maxLength": 80,
          "minLength": 0,
          "type": "string"
        },
        "clusterFqdn": {
          "pattern": "^(([a-zA-Z0-9]|[a-zA-Z0-9][a-zA-Z0-9\\-]*[a-zA-Z0-9])\\.)*([A-Za-z0-9]|[A-Za-z0-9][A-Za-z0-9\\-]*[A-Za-z0-9])$",
          "type": "string"
        },
        "formFactor": {
          "pattern": "(XLARGE|LARGE|MEDIUM|SMALL)",
          "type": "string"
        },
        "adminPassword": {
          "type": "string"
        },
        "nodes": {
          "maxItems": 3,
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/AlbControllerNodeSpec"
          }
        },
        "bundleId": {
          "type": "string"
        },
        "vcfopsAdminPassword": {
          "type": "string"
        }
      },
      "description": "ALB cluster creation data"
    },
    "AlbControllerNodeSpec": {
      "required": [
        "ipAddress"
      ],
      "type": "object",
      "properties": {
        "ipAddress": {
          "pattern": "^([01]?\\d\\d?|2[0-4]\\d|25[0-5])\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])$",
          "type": "string"
        }
      },
      "description": "ALB Node representation"
    },
    "Validation": {
      "required": [
        "description",
        "executionStatus",
        "id",
        "resultStatus"
      ],
      "type": "object",
      "projected_properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "executionStatus": {
          "type": "string",
          "example": "COMPLETED"
        },
        "resultStatus": {
          "type": "string",
          "example": "SUCCEEDED"
        }
      }
    },
    "Task": {
      "required": [
        "creationTimestamp",
        "id",
        "name",
        "status"
      ],
      "type": "object",
      "projected_properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "creationTimestamp": {
          "type": "string"
        }
      }
    },
    "Error": {
      "type": "object",
      "projected_properties": {
        "errorCode": {
          "type": "string",
          "description": "The minor error code",
          "readOnly": true
        },
        "message": {
          "type": "string",
          "description": "The localized error message",
          "readOnly": true
        },
        "remediationMessage": {
          "type": "string",
          "description": "The localized remediation error message"
        },
        "referenceToken": {
          "type": "string",
          "description": "A reference token correlating the error with the relevant detailed error logs. Should be sent to the service provider when reporting issues.",
          "readOnly": true
        }
      }
    }
  }
}

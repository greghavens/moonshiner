+function Wait-VcfEvcPrecheck {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $ServiceRoot,
+
+        [Parameter(Mandatory)]
+        [string] $ApiToken,
+
+        [Parameter(Mandatory)]
+        [string] $TaskId,
+
+        [Parameter(Mandatory)]
+        [int] $TimeoutSeconds,
+
+        [Parameter(Mandatory)]
+        [int] $PollIntervalMilliseconds
+    )
+
+    $deadline = [DateTime]::UtcNow.AddSeconds($TimeoutSeconds)
+    $encodedTask = [uri]::EscapeDataString($TaskId)
+    $taskUri = [uri] "$ServiceRoot/api/cis/tasks/$encodedTask"
+    while ($true) {
+        $info = Invoke-VcfEvcContractRequest `
+            -Method GET `
+            -Uri $taskUri `
+            -ApiToken $ApiToken `
+            -ExpectedStatus 200
+
+        if ($null -eq $info) {
+            throw [VcfEvcPrecheckException]::new(
+                'The EVC precheck returned no task information.',
+                $TaskId
+            )
+        }
+        $statusProperty = $info.PSObject.Properties['status']
+        if ($null -eq $statusProperty -or [string]::IsNullOrWhiteSpace(
+            [string] $statusProperty.Value
+        )) {
+            throw [VcfEvcPrecheckException]::new(
+                'The EVC precheck task response has no status.',
+                $TaskId
+            )
+        }
+
+        switch ([string] $statusProperty.Value) {
+            'SUCCEEDED' {
+                return $info
+            }
+            'PENDING' {}
+            'RUNNING' {}
+            'BLOCKED' {}
+            default {
+                throw [VcfEvcPrecheckException]::new(
+                    "The EVC precheck task ended in status $($statusProperty.Value).",
+                    $TaskId
+                )
+            }
+        }
+
+        if ([DateTime]::UtcNow -ge $deadline) {
+            throw [VcfEvcPrecheckException]::new(
+                'Timed out waiting for the EVC precheck task.',
+                $TaskId
+            )
+        }
+        if ($PollIntervalMilliseconds -gt 0) {
+            Start-Sleep -Milliseconds $PollIntervalMilliseconds
+        }
+    }
+}

+function Invoke-VcfEvcContractRequest {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateSet('GET', 'POST', 'PUT')]
+        [string] $Method,
+
+        [Parameter(Mandatory)]
+        [uri] $Uri,
+
+        [Parameter(Mandatory)]
+        [string] $ApiToken,
+
+        [Parameter()]
+        [AllowNull()]
+        [string] $JsonBody,
+
+        [Parameter(Mandatory)]
+        [int] $ExpectedStatus
+    )
+
+    $client = [System.Net.Http.HttpClient]::new()
+    $request = [System.Net.Http.HttpRequestMessage]::new(
+        [System.Net.Http.HttpMethod]::new($Method),
+        $Uri
+    )
+    $response = $null
+    try {
+        [void] $request.Headers.TryAddWithoutValidation(
+            'vmware-api-session-id',
+            $ApiToken
+        )
+        [void] $request.Headers.TryAddWithoutValidation('Accept', 'application/json')
+        if ($PSBoundParameters.ContainsKey('JsonBody')) {
+            $request.Content = [System.Net.Http.StringContent]::new(
+                $JsonBody,
+                [System.Text.Encoding]::UTF8,
+                'application/json'
+            )
+        }
+
+        $response = $client.SendAsync($request).GetAwaiter().GetResult()
+        $content = $response.Content.ReadAsStringAsync().GetAwaiter().GetResult()
+        $statusCode = [int] $response.StatusCode
+        if ($statusCode -ne $ExpectedStatus) {
+            throw [VcfEvcHttpException]::new(
+                "$Method $($Uri.AbsolutePath) returned HTTP $statusCode.",
+                $statusCode
+            )
+        }
+        if ([string]::IsNullOrWhiteSpace($content)) {
+            return $null
+        }
+        try {
+            return $content | ConvertFrom-Json -Depth 32
+        }
+        catch {
+            throw [VcfEvcHttpException]::new(
+                "$Method $($Uri.AbsolutePath) returned malformed JSON.",
+                $statusCode
+            )
+        }
+    }
+    finally {
+        if ($null -ne $response) {
+            $response.Dispose()
+        }
+        $request.Dispose()
+        $client.Dispose()
+    }
+}

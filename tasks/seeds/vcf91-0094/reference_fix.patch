+function Get-ContractMember {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [object] $InputObject,
+
+        [Parameter(Mandatory)]
+        [string] $Name
+    )
+
+    if ($InputObject -is [System.Collections.IDictionary]) {
+        if ($InputObject.Contains($Name)) {
+            return [pscustomobject]@{ Found = $true; Value = $InputObject[$Name] }
+        }
+        return [pscustomobject]@{ Found = $false; Value = $null }
+    }
+
+    $property = $InputObject.PSObject.Properties[$Name]
+    if ($null -eq $property) {
+        return [pscustomobject]@{ Found = $false; Value = $null }
+    }
+    return [pscustomobject]@{ Found = $true; Value = $property.Value }
+}
+
+function ConvertTo-EvcSetSpec {
+    [CmdletBinding()]
+    param(
+        [Parameter()]
+        [AllowNull()]
+        [object] $EvcMode,
+
+        [Parameter(Mandatory)]
+        [bool] $EvcModeWasBound
+    )
+
+    $spec = [ordered]@{}
+    if (-not $EvcModeWasBound) {
+        return $spec
+    }
+    if ($null -eq $EvcMode) {
+        throw [System.ArgumentException]::new(
+            'EvcMode cannot be null when the parameter is supplied.'
+        )
+    }
+
+    $keyMember = Get-ContractMember -InputObject $EvcMode -Name 'key'
+    $masksMember = Get-ContractMember -InputObject $EvcMode -Name 'masks'
+    if (
+        -not $keyMember.Found -or
+        [string]::IsNullOrWhiteSpace([string] $keyMember.Value) -or
+        -not $masksMember.Found -or
+        $null -eq $masksMember.Value
+    ) {
+        throw [System.ArgumentException]::new(
+            'EvcMode requires non-empty key and masks properties.'
+        )
+    }
+
+    if (
+        $masksMember.Value -is [string] -or
+        $masksMember.Value -isnot [System.Collections.IEnumerable]
+    ) {
+        throw [System.ArgumentException]::new('EvcMode.masks must be an array.')
+    }
+
+    $normalizedMasks = @(
+        foreach ($mask in @($masksMember.Value)) {
+            if ($null -eq $mask) {
+                throw [System.ArgumentException]::new(
+                    'EvcMode.masks cannot contain null.'
+                )
+            }
+            $maskKey = Get-ContractMember -InputObject $mask -Name 'key'
+            $maskName = Get-ContractMember -InputObject $mask -Name 'name'
+            $maskValue = Get-ContractMember -InputObject $mask -Name 'value'
+            if (-not $maskKey.Found -or -not $maskName.Found -or -not $maskValue.Found) {
+                throw [System.ArgumentException]::new(
+                    'Each EvcMode mask requires key, name, and value.'
+                )
+            }
+            [ordered]@{
+                key = [string] $maskKey.Value
+                name = [string] $maskName.Value
+                value = [string] $maskValue.Value
+            }
+        }
+    )
+
+    $spec['evc_mode'] = [ordered]@{
+        key = [string] $keyMember.Value
+        masks = $normalizedMasks
+    }
+    return $spec
+}

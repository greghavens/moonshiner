{
  "contract_version": 1,
  "title": "VCF 9.1 vCenter cluster EVC precheck gate",
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/vsphere/openapi/automation/vcenter.yaml",
    "spec_version": "9.1.0.0",
    "license": "Apache-2.0"
  },
  "server_base_path": "/api",
  "authentication": {
    "scheme_name": "api_key_auth",
    "header": "vmware-api-session-id"
  },
  "operations": [
    {
      "operationId": "Vcenter.Cluster.EvcMode_checkSet$Task",
      "method": "POST",
      "path_template": "/vcenter/cluster/{cluster}/evc-mode?action=check-set&vmw-task=true",
      "content_type": "application/json",
      "request_body_required": true,
      "request_schema": "Vcenter.Cluster.EvcMode.SetSpec",
      "success_status": 202,
      "response_schema": "string",
      "response_semantics": "Task identifier for a check whose operation-specific result is a list of Vcenter.Cluster.EvcMode.CheckResult values; missing or null means no errors."
    },
    {
      "operationId": "Cis.Tasks_get",
      "method": "GET",
      "path_template": "/cis/tasks/{task}",
      "optional_query_parameters": [
        {
          "name": "spec",
          "schema": "Cis.Tasks.GetSpec",
          "unset_wire_behavior": "omit"
        }
      ],
      "success_status": 200,
      "response_schema": "Cis.Task.Info"
    },
    {
      "operationId": "Vcenter.Cluster.EvcMode_set$Task",
      "method": "PUT",
      "path_template": "/vcenter/cluster/{cluster}/evc-mode?vmw-task=true",
      "content_type": "application/json",
      "request_body_required": true,
      "request_schema": "Vcenter.Cluster.EvcMode.SetSpec",
      "success_status": 202,
      "response_schema": "string"
    }
  ],
  "schemas": {
    "Vcenter.Cluster.EvcMode.SetSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evc_mode": {
          "schema": "Vcenter.EvcMode.EvcMode",
          "required": false,
          "unset_wire_behavior": "omit",
          "spec_semantics": "When missing or null, EVC mode is reset for the cluster."
        }
      }
    },
    "Vcenter.EvcMode.EvcMode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "masks"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "masks": {
          "type": "array",
          "items": "Vcenter.EvcMode.FeatureMask"
        }
      }
    },
    "Vcenter.EvcMode.FeatureMask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "Cis.Tasks.GetSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "return_all": {
          "type": "boolean",
          "required": false
        },
        "exclude_result": {
          "type": "boolean",
          "required": false
        }
      }
    },
    "Cis.Task.Info": {
      "type": "object",
      "required": [
        "cancelable",
        "description",
        "operation",
        "service",
        "status"
      ],
      "status_values": [
        "PENDING",
        "RUNNING",
        "BLOCKED",
        "SUCCEEDED",
        "FAILED"
      ],
      "result_required": false
    },
    "Vcenter.Cluster.EvcMode.CheckResult": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "schema": "Vapi.Std.Errors.Error"
        },
        "host_system": {
          "type": "string",
          "required": false,
          "unset_wire_behavior": "omit"
        }
      }
    }
  },
  "workflow": {
    "precheck_operationId": "Vcenter.Cluster.EvcMode_checkSet$Task",
    "task_operationId": "Cis.Tasks_get",
    "mutation_operationId": "Vcenter.Cluster.EvcMode_set$Task",
    "mutation_gate": {
      "task_status": "SUCCEEDED",
      "operation_result": "missing, null, or an empty list",
      "on_any_other_result": "fail without invoking the mutation operation"
    },
    "same_set_spec_for_precheck_and_mutation": true
  }
}

{
  "contract_version": 1,
  "openapi_version": "2.0",
  "base_path": "/policy/api/v1",
  "operations": [
    {
      "operationId": "PatchSegment",
      "method": "PATCH",
      "path": "/infra/tier-1s/{tier-1-id}/segments/{segment-id}",
      "consumes": [
        "application/json"
      ],
      "parameters": {
        "path": [
          {
            "name": "tier-1-id",
            "type": "string",
            "required": true
          },
          {
            "name": "segment-id",
            "type": "string",
            "required": true
          }
        ],
        "query": [],
        "body": {
          "required": true,
          "schema": "Segment"
        }
      },
      "request_schema_subset": {
        "additionalProperties": false,
        "properties": {
          "resource_type": {
            "type": "string",
            "value": "Segment"
          },
          "display_name": {
            "type": "string",
            "required": false
          },
          "description": {
            "type": "string",
            "required": false,
            "maxLength": 1024
          },
          "dhcp_config_path": {
            "type": "string",
            "required": false
          },
          "subnets": {
            "type": "array",
            "required": false,
            "maxItems": 1,
            "items": {
              "schema": "SegmentSubnet",
              "properties": {
                "gateway_address": {
                  "type": "string",
                  "format": "ip-cidr-block"
                },
                "dhcp_config": {
                  "required": false
                },
                "dhcp_ranges": {
                  "type": "array",
                  "required": false,
                  "minItems": 1,
                  "maxItems": 99
                },
                "network": {
                  "type": "string",
                  "readOnly": true
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "body": false
        }
      }
    },
    {
      "operationId": "ReadIntentStatus",
      "method": "GET",
      "path": "/infra/realized-state/status",
      "produces": [
        "application/json"
      ],
      "parameters": {
        "path": [],
        "query": [
          {
            "name": "intent_path",
            "type": "string",
            "required": true
          },
          {
            "name": "include_enforced_status",
            "type": "boolean",
            "required": false,
            "default": false
          },
          {
            "name": "site_path",
            "type": "string",
            "required": false
          }
        ]
      },
      "responses": {
        "200": {
          "description": "OK",
          "schema": "ConsolidatedRealizedStatus",
          "required_properties": [
            "intent_path",
            "publish_status"
          ],
          "publish_status": {
            "type": "string",
            "enum": [
              "UNAVAILABLE",
              "UNREALIZED",
              "REALIZED",
              "ERROR"
            ]
          }
        }
      }
    }
  ]
}

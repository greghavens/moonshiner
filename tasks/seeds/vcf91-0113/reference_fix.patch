+func compactJSON(value any) []byte {
+	encoded, err := json.Marshal(value)
+	if err != nil {
+		panic("fixed request model is not JSON encodable")
+	}
+	return encoded
+}
+
+func (c *Client) request(ctx context.Context, operation operation) (StepResult, error) {
+	var body io.Reader
+	if operation.body != nil {
+		body = bytes.NewReader(operation.body)
+	}
+	request, err := http.NewRequestWithContext(
+		ctx,
+		operation.method,
+		c.baseURL+operation.path,
+		body,
+	)
+	if err != nil {
+		if contextError := ctx.Err(); contextError != nil {
+			return StepResult{}, contextError
+		}
+		return StepResult{}, &TransportError{OperationID: operation.operationID}
+	}
+	request.Header.Set("Accept", "application/json")
+	request.Header.Set("vmware-api-session-id", c.sessionToken)
+	if operation.body != nil {
+		request.Header.Set("Content-Type", "application/json")
+	}
+
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		if response != nil && response.Body != nil {
+			_ = response.Body.Close()
+		}
+		if contextError := ctx.Err(); contextError != nil {
+			return StepResult{}, contextError
+		}
+		return StepResult{}, &TransportError{OperationID: operation.operationID}
+	}
+	responseBody, readErr := readAndClose(response)
+	if readErr != nil {
+		if contextError := ctx.Err(); contextError != nil {
+			return StepResult{}, contextError
+		}
+		return StepResult{}, &TransportError{OperationID: operation.operationID}
+	}
+	if len(responseBody) > maxResponseBytes {
+		return StepResult{}, &ProtocolError{
+			OperationID: operation.operationID,
+			Reason:      "response exceeded the size limit",
+		}
+	}
+	if response.StatusCode == http.StatusNoContent {
+		if len(responseBody) != 0 {
+			return StepResult{}, &ProtocolError{
+				OperationID: operation.operationID,
+				Reason:      "HTTP 204 response was not empty",
+			}
+		}
+		return StepResult{
+			Name:        operation.name,
+			OperationID: operation.operationID,
+			State:       "SUCCEEDED",
+			HTTPStatus:  http.StatusNoContent,
+		}, nil
+	}
+	return StepResult{}, decodeVAPIError(
+		operation.operationID,
+		response.StatusCode,
+		responseBody,
+	)
+}
+
+func readAndClose(response *http.Response) ([]byte, error) {
+	defer response.Body.Close()
+	return io.ReadAll(io.LimitReader(response.Body, maxResponseBytes+1))
+}
+
+func decodeVAPIError(operationID string, statusCode int, body []byte) error {
+	var value any
+	if json.Unmarshal(body, &value) != nil {
+		return malformedVAPIError(operationID)
+	}
+	object, ok := value.(map[string]any)
+	if !ok {
+		return malformedVAPIError(operationID)
+	}
+	errorType, ok := object["error_type"].(string)
+	if !ok || strings.TrimSpace(errorType) == "" {
+		return malformedVAPIError(operationID)
+	}
+	messages, ok := object["messages"].([]any)
+	if !ok || len(messages) == 0 {
+		return malformedVAPIError(operationID)
+	}
+	first, ok := messages[0].(map[string]any)
+	if !ok {
+		return malformedVAPIError(operationID)
+	}
+	message, ok := first["default_message"].(string)
+	if !ok || strings.TrimSpace(message) == "" {
+		return malformedVAPIError(operationID)
+	}
+	return &APIError{
+		OperationID: operationID,
+		StatusCode:  statusCode,
+		ErrorType:   errorType,
+		Message:     message,
+	}
+}
+
+func malformedVAPIError(operationID string) *ProtocolError {
+	return &ProtocolError{
+		OperationID: operationID,
+		Reason:      "malformed standard vAPI error response",
+	}
 }

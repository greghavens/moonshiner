 // ResizeAndStart changes CPU count, changes memory size, and starts the VM.
 // It always returns all operation outcomes known before the first failure.
 func (c *Client) ResizeAndStart(
-	context.Context,
-	string,
-	int64,
-	int64,
+	ctx context.Context,
+	vm string,
+	cpuCount int64,
+	memoryMiB int64,
 ) (ResizeReport, error) {
-	return ResizeReport{}, ErrNotImplemented
+	report := ResizeReport{VM: vm, OverallState: "FAILED"}
+	if ctx == nil {
+		return report, errors.New("context must not be nil")
+	}
+	if strings.TrimSpace(vm) == "" {
+		return report, errors.New("vm must be nonblank")
+	}
+	if cpuCount <= 0 {
+		return report, errors.New("cpuCount must be positive")
+	}
+	if memoryMiB <= 0 {
+		return report, errors.New("memoryMiB must be positive")
+	}
+	if err := ctx.Err(); err != nil {
+		return report, err
+	}
+
+	encodedVM := url.PathEscape(vm)
+	operations := []operation{
+		{
+			name:        "Cpu",
+			operationID: CPUUpdateOperation,
+			method:      http.MethodPatch,
+			path:        "/api/vcenter/vm/" + encodedVM + "/hardware/cpu",
+			body: compactJSON(struct {
+				Count int64 `json:"count"`
+			}{Count: cpuCount}),
+		},
+		{
+			name:        "Memory",
+			operationID: MemoryUpdateOperation,
+			method:      http.MethodPatch,
+			path:        "/api/vcenter/vm/" + encodedVM + "/hardware/memory",
+			body: compactJSON(struct {
+				SizeMiB int64 `json:"size_mib"`
+			}{SizeMiB: memoryMiB}),
+		},
+		{
+			name:        "PowerStart",
+			operationID: PowerStartOperation,
+			method:      http.MethodPost,
+			path:        "/api/vcenter/vm/" + encodedVM + "/power?action=start",
+		},
+	}
+
+	report.Steps = make([]StepResult, 0, len(operations))
+	for _, operation := range operations {
+		step, err := c.request(ctx, operation)
+		if err != nil {
+			report.FailedOperationID = operation.operationID
+			var apiError *APIError
+			if errors.As(err, &apiError) {
+				report.Steps = append(report.Steps, StepResult{
+					Name:        operation.name,
+					OperationID: operation.operationID,
+					State:       "FAILED",
+					HTTPStatus:  apiError.StatusCode,
+					ErrorType:   apiError.ErrorType,
+					Message:     apiError.Message,
+				})
+			}
+			return report, err
+		}
+		report.Steps = append(report.Steps, step)
+		report.CompletedStepCount++
+	}
+	report.OverallState = "SUCCEEDED"
+	report.FailedOperationID = ""
+	return report, nil
+}

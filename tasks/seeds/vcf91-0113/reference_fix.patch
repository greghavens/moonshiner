 // NewClient validates configuration without performing network I/O.
-func NewClient(Config) (*Client, error) {
-	return nil, ErrNotImplemented
+func NewClient(config Config) (*Client, error) {
+	parsed, err := url.Parse(config.BaseURL)
+	if err != nil {
+		return nil, errors.New("BaseURL must be an HTTP(S) origin")
+	}
+	scheme := strings.ToLower(parsed.Scheme)
+	if (scheme != "http" && scheme != "https") ||
+		parsed.Host == "" ||
+		parsed.Hostname() == "" ||
+		parsed.User != nil ||
+		parsed.Opaque != "" ||
+		(parsed.Path != "" && parsed.Path != "/") ||
+		(parsed.EscapedPath() != "" && parsed.EscapedPath() != "/") ||
+		parsed.RawQuery != "" ||
+		parsed.ForceQuery ||
+		parsed.Fragment != "" {
+		return nil, errors.New("BaseURL must be an HTTP(S) origin")
+	}
+	if !headerSafeToken(config.SessionToken) {
+		return nil, errors.New("SessionToken must be nonblank and safe for an HTTP header")
+	}
+	httpClient := config.HTTPClient
+	if httpClient == nil {
+		httpClient = http.DefaultClient
+	}
+	httpClientCopy := *httpClient
+	httpClientCopy.CheckRedirect = func(_ *http.Request, _ []*http.Request) error {
+		return http.ErrUseLastResponse
+	}
+	return &Client{
+		baseURL:      scheme + "://" + parsed.Host,
+		sessionToken: config.SessionToken,
+		httpClient:   &httpClientCopy,
+	}, nil
+}
+
+func headerSafeToken(value string) bool {
+	if strings.TrimSpace(value) == "" {
+		return false
+	}
+	for _, character := range value {
+		if character < 33 || character > 126 {
+			return false
+		}
+	}
+	return true
+}

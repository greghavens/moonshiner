{
  "contract_version": 1,
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/vsphere/openapi/automation/vcenter.yaml",
    "spec_blob_sha": "8028b0824c4ff3503d05f44814f967938a795c40",
    "openapi": "3.0.3",
    "api_version": "9.1.0.0",
    "license": "Apache-2.0"
  },
  "server": {
    "url_template": "https://{host}/api",
    "api_root_suffix": "/api"
  },
  "security": {
    "scheme": "api_key_auth",
    "type": "apiKey",
    "in": "header",
    "name": "vmware-api-session-id"
  },
  "operations": [
    {
      "operationId": "Vcenter.TrustedInfrastructure.Hosts.Hardware.Tpm_list",
      "method": "GET",
      "path": "/vcenter/trusted-infrastructure/hosts/{host}/hardware/tpm",
      "parameters": [
        {
          "name": "host",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "filter",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "$ref": "Vcenter.TrustedInfrastructure.Hosts.Hardware.Tpm.FilterSpec"
          }
        },
        {
          "name": "major_versions",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        }
      ],
      "responses": {
        "200": {
          "type": "array",
          "items": {
            "$ref": "Vcenter.TrustedInfrastructure.Hosts.Hardware.Tpm.Summary"
          }
        }
      }
    },
    {
      "operationId": "Vcenter.TrustedInfrastructure.Hosts.Hardware.Tpm.EventLog_get",
      "method": "GET",
      "path": "/vcenter/trusted-infrastructure/hosts/{host}/hardware/tpm/{tpm}/event-log",
      "parameters": [
        {
          "name": "host",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "tpm",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "$ref": "Vcenter.TrustedInfrastructure.Hosts.Hardware.Tpm.EventLog.Info"
        }
      }
    },
    {
      "operationId": "Appliance.SupportBundle_create$Task",
      "method": "POST",
      "path": "/appliance/support-bundle?vmw-task=true",
      "request_body": {
        "required": true,
        "content_type": "application/json",
        "schema": {
          "$ref": "Appliance.SupportBundle.CreateSpec"
        }
      },
      "responses": {
        "202": {
          "type": "string"
        }
      }
    }
  ],
  "schemas": {
    "Vcenter.TrustedInfrastructure.Hosts.Hardware.Tpm.FilterSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "active": {
          "type": "boolean",
          "optional": true
        }
      }
    },
    "Vcenter.TrustedInfrastructure.Hosts.Hardware.Tpm.Summary": {
      "type": "object",
      "required": [
        "active",
        "major_version",
        "minor_version",
        "tpm"
      ],
      "properties": {
        "tpm": {
          "type": "string"
        },
        "major_version": {
          "type": "integer",
          "format": "int64"
        },
        "minor_version": {
          "type": "integer",
          "format": "int64"
        },
        "active": {
          "type": "boolean"
        }
      }
    },
    "Vcenter.TrustedInfrastructure.Hosts.Hardware.Tpm.EventLog.Info": {
      "type": "object",
      "required": [
        "banks",
        "truncated",
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "EFI_TCG2_EVENT_LOG_FORMAT_TCG_2"
          ]
        },
        "data": {
          "type": "string",
          "format": "byte",
          "optional_in_future_version": true
        },
        "truncated": {
          "type": "boolean"
        },
        "banks": {
          "type": "array",
          "items": {
            "$ref": "Vcenter.TrustedInfrastructure.Hosts.Hardware.Tpm.PcrBank"
          }
        }
      }
    },
    "Vcenter.TrustedInfrastructure.Hosts.Hardware.Tpm.PcrBank": {
      "type": "object",
      "required": [
        "algorithm",
        "pcrs"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "SHA256",
            "SHA384",
            "SHA512",
            "SM3_256"
          ]
        },
        "pcrs": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "format": "byte"
          }
        }
      }
    },
    "Appliance.SupportBundle.CreateSpec": {
      "type": "object",
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "components": {
          "type": "object",
          "optional": true,
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "content_type": {
          "type": "string",
          "optional": true,
          "enum": [
            "LOGS",
            "CORES",
            "ALL"
          ]
        },
        "partition": {
          "type": "string",
          "optional": true
        }
      }
    }
  }
}

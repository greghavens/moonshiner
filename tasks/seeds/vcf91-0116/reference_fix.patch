+		return TPMEventLog{}, protocol(
+			OperationGetTPMEventLog,
+			"invalid event log",
+		)
+	}
+	if *wire.Type != "EFI_TCG2_EVENT_LOG_FORMAT_TCG_2" {
+		return TPMEventLog{}, protocol(
+			OperationGetTPMEventLog,
+			"unknown event-log type",
+		)
+	}
+	if wire.Data != nil {
+		if _, err := base64.StdEncoding.DecodeString(*wire.Data); err != nil {
+			return TPMEventLog{}, protocol(
+				OperationGetTPMEventLog,
+				"invalid event-log data",
+			)
+		}
+	}
+
+	banks := make([]PCRBank, len(*wire.Banks))
+	for index, bank := range *wire.Banks {
+		if bank.Algorithm == nil || bank.PCRs == nil {
+			return TPMEventLog{}, protocol(
+				OperationGetTPMEventLog,
+				"invalid PCR bank",
+			)
+		}
+		switch *bank.Algorithm {
+		case "SHA256", "SHA384", "SHA512", "SM3_256":
+		default:
+			return TPMEventLog{}, protocol(
+				OperationGetTPMEventLog,
+				"unknown PCR-bank algorithm",
+			)
+		}
+		pcrs := make(map[string]string, len(*bank.PCRs))
+		for register, value := range *bank.PCRs {
+			if _, err := base64.StdEncoding.DecodeString(value); err != nil {
+				return TPMEventLog{}, protocol(
+					OperationGetTPMEventLog,
+					"invalid PCR value",
+				)
+			}
+			pcrs[register] = value
+		}
+		banks[index] = PCRBank{
+			Algorithm: *bank.Algorithm,
+			PCRs:      pcrs,
+		}
+	}
+	return TPMEventLog{
+		Type:      *wire.Type,
+		Data:      wire.Data,
+		Truncated: *wire.Truncated,
+		Banks:     banks,
+	}, nil
 }
 

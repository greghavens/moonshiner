+		return TPMEventLog{}, &ValidationError{Field: "tpm"}
+	}
+
+	target := "/vcenter/trusted-infrastructure/hosts/" +
+		url.PathEscape(host) + "/hardware/tpm/" +
+		url.PathEscape(tpm) + "/event-log"
+	body, err := c.request(
+		ctx,
+		OperationGetTPMEventLog,
+		http.MethodGet,
+		target,
+		nil,
+		http.StatusOK,
+	)
+	if err != nil {
+		return TPMEventLog{}, err
+	}
+
+	var wire eventLogWire
+	if isJSONNull(body) ||
+		decodeJSON(body, &wire) != nil ||
+		wire.Type == nil ||
+		wire.Truncated == nil ||

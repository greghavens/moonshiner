+
+func (c *Client) request(
+	ctx context.Context,
+	operationID string,
+	method string,
+	target string,
+	body []byte,
+	expectedStatus int,
+) ([]byte, error) {
+	var reader io.Reader
+	if body != nil {
+		reader = bytes.NewReader(body)
+	}
+	request, err := http.NewRequestWithContext(
+		ctx,
+		method,
+		c.baseURL+target,
+		reader,
+	)
+	if err != nil {
+		return nil, &TransportError{OperationID: operationID, Err: err}
+	}
+	request.Header.Set("Accept", "application/json")
+	request.Header.Set("vmware-api-session-id", c.sessionID)
+	if body != nil {
+		request.Header.Set("Content-Type", "application/json")
+	}
+
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		cause := err
+		if ctxErr := ctx.Err(); ctxErr != nil {
+			cause = ctxErr
+		}
+		return nil, &TransportError{OperationID: operationID, Err: cause}
+	}
+	defer response.Body.Close()
+
+	responseBody, readErr := io.ReadAll(
+		io.LimitReader(response.Body, maxResponseBytes+1),
+	)
+	if readErr != nil {
+		cause := readErr
+		if ctxErr := ctx.Err(); ctxErr != nil {
+			cause = ctxErr
+		}
+		return nil, &TransportError{OperationID: operationID, Err: cause}
+	}
+	if response.StatusCode != expectedStatus {
+		return nil, &APIError{
+			OperationID: operationID,
+			StatusCode:  response.StatusCode,
+		}
+	}
+	if len(responseBody) > maxResponseBytes {
+		return nil, protocol(operationID, "response exceeds size limit")
+	}
+	return responseBody, nil
+}
+
+func validateCall(c *Client, ctx context.Context) error {
+	if c == nil ||
+		c.httpClient == nil ||
+		c.baseURL == "" ||
+		c.sessionID == "" {
+		return &ValidationError{Field: "client"}
+	}
+	if ctx == nil {
+		return &ValidationError{Field: "context"}
+	}
+	return nil
+}
+
+func validIdentifier(value string) bool {
+	return strings.TrimSpace(value) != "" && !hasControl(value)
+}
+
+func hasControl(value string) bool {
+	for _, character := range value {
+		if character < 32 || character == 127 {
+			return true
+		}
+	}
+	return false
+}
+
+func decodeJSON(body []byte, destination any) error {
+	decoder := json.NewDecoder(bytes.NewReader(body))
+	if err := decoder.Decode(destination); err != nil {
+		return err
+	}
+	var extra any
+	if err := decoder.Decode(&extra); err != io.EOF {
+		if err == nil {
+			return errors.New("trailing JSON value")
+		}
+		return err
+	}
+	return nil
+}
+
+func isJSONNull(body []byte) bool {
+	return string(bytes.TrimSpace(body)) == "null"
+}
+
+func protocol(operationID string, reason string) *ProtocolError {
+	return &ProtocolError{OperationID: operationID, Reason: reason}
 }

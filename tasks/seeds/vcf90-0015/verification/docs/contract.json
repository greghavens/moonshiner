{
  "contract_version": 1,
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "commit_sha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "api_version": "9.0.0.0"
  },
  "security": {
    "spec_declares_security_schemes": false,
    "spec_note": "The 9.0.0.0 SDDC Manager document declares neither a global 'security' block nor 'components.securitySchemes'. The bearer convention below is pinned by this contract for the local environment; it is not read out of the specification.",
    "scenario_pinned": {
      "scheme": "bearer",
      "in": "header",
      "name": "Authorization",
      "value_prefix": "Bearer ",
      "token_source": "createToken -> TokenPair.accessToken"
    }
  },
  "json_encoding_rules": {
    "content_type": "application/json",
    "omit_unset_optional_properties": true,
    "note": "A property that is not part of a schema's 'required' list and has no value MUST be absent from the serialized object. Encoding an unset optional as null, an empty string, an empty array or a zero value is a contract violation."
  },
  "operations": [
    {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "summary": "Create Token Pair",
      "authenticated": false,
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": {
          "name": "TokenCreationSpec",
          "type": "object",
          "required": [],
          "properties": {
            "username": { "type": "string" },
            "password": { "type": "string" },
            "apiKey": { "type": "string" },
            "idToken": { "type": "string" }
          }
        }
      },
      "success": {
        "status": 201,
        "schema": "TokenPair",
        "required": [],
        "properties": {
          "accessToken": "string",
          "refreshToken": "RefreshToken{id:string}"
        }
      },
      "errors": [400, 500],
      "scenario_pinned": {
        "invalid_credential_status": 401,
        "note": "The 9.0.0.0 document lists only 400 and 500 for this operation. The local environment answers a username/password pair that is no longer valid with 401 so that use of a retired secret is observable."
      }
    },
    {
      "operationId": "getCredentials",
      "method": "GET",
      "path": "/v1/credentials",
      "summary": "Retrieve a list of credentials",
      "authenticated": true,
      "parameters": [
        { "name": "resourceName", "in": "query", "required": false, "schema": { "type": "string" } },
        { "name": "resourceIp", "in": "query", "required": false, "schema": { "type": "string" } },
        { "name": "resourceType", "in": "query", "required": false, "schema": { "type": "string" } },
        { "name": "domainName", "in": "query", "required": false, "schema": { "type": "string" } },
        { "name": "pageNumber", "in": "query", "required": false, "schema": { "type": "string" } },
        { "name": "pageSize", "in": "query", "required": false, "schema": { "type": "string" } },
        { "name": "accountType", "in": "query", "required": false, "schema": { "type": "string" } }
      ],
      "request_body": null,
      "success": {
        "status": 200,
        "schema": "PageOfCredential",
        "required": [],
        "properties": {
          "elements": "array of Credential",
          "pageMetadata": "PageMetadata{pageNumber,pageSize,totalElements,totalPages}"
        }
      },
      "errors": [400, 401, 403, 500],
      "scenario_pinned": {
        "list_projection_omits_password": true,
        "note": "Credential.password is optional in the 9.0.0.0 schema. The local environment leaves it out of the PageOfCredential projection, so a rotated password has to be read back with getCredential."
      }
    },
    {
      "operationId": "updateOrRotatePasswords",
      "method": "PATCH",
      "path": "/v1/credentials",
      "summary": "Update or rotate passwords for a list of resources",
      "description": "Update passwords for given list of resources by supplying new passwords or rotate the passwords using system generated passwords",
      "authenticated": true,
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": {
          "name": "CredentialsUpdateSpec",
          "type": "object",
          "required": ["elements", "operationType"],
          "properties": {
            "operationType": { "type": "string" },
            "elements": { "type": "array", "items": "ResourceCredentials" },
            "autoRotatePolicy": { "$ref": "AutoRotateCredentialPolicyInputSpec", "required": false }
          }
        },
        "component_schemas": {
          "ResourceCredentials": {
            "type": "object",
            "required": ["credentials", "resourceType"],
            "properties": {
              "resourceName": { "type": "string", "required": false },
              "resourceId": { "type": "string", "required": false },
              "resourceType": { "type": "string" },
              "credentials": { "type": "array", "items": "BaseCredential" }
            }
          },
          "BaseCredential": {
            "type": "object",
            "required": ["username"],
            "properties": {
              "credentialType": { "type": "string", "required": false },
              "accountType": { "type": "string", "required": false },
              "username": { "type": "string" },
              "password": { "type": "string", "required": false }
            }
          }
        }
      },
      "success": {
        "status": 202,
        "schema": "Task",
        "required": ["creationTimestamp", "id", "name", "status"],
        "properties": {
          "id": "string",
          "name": "string",
          "type": "string",
          "status": "string",
          "creationTimestamp": "string",
          "completionTimestamp": "string",
          "subTasks": "array of SubTask",
          "errors": "array of Error",
          "isCancellable": "boolean",
          "isRetryable": "boolean"
        }
      },
      "errors": [400, 401, 403, 500],
      "spec_note": "The 202 Task is an acknowledgement, not a result. Its status is not the outcome of the rotation; the outcome is only available from getCredentialsTask.",
      "scenario_pinned": {
        "operationType_allowed_values": ["UPDATE", "ROTATE", "REMEDIATE"],
        "note": "CredentialsUpdateSpec.operationType is declared in the 9.0.0.0 document as a plain string with no 'enum'. The three values above are pinned by this contract; the local environment answers any other value with 400.",
        "rotate_semantics": "operationType ROTATE asks SDDC Manager to generate the replacement password. The caller does not choose it and therefore MUST NOT send BaseCredential.password for a ROTATE. The generated value is readable afterwards from Credential.password."
      }
    },
    {
      "operationId": "getCredentialsTask",
      "method": "GET",
      "path": "/v1/credentials/tasks/{id}",
      "summary": "Retrieve a credential task by its ID",
      "authenticated": true,
      "parameters": [
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "request_body": null,
      "success": {
        "status": 200,
        "schema": "CredentialsTask",
        "required": ["creationTimestamp", "id", "name", "status", "type"],
        "properties": {
          "id": "string",
          "name": "string",
          "type": "string",
          "status": "string",
          "creationTimestamp": "string",
          "completionTimestamp": "string",
          "subTasks": "array of CredentialsSubTask",
          "errors": "array of Error",
          "isAutoRotate": "boolean"
        }
      },
      "errors": [400, 500],
      "scenario_pinned": {
        "status_values": ["IN_PROGRESS", "SUCCESSFUL", "FAILED", "CANCELLED"],
        "terminal_status_values": ["SUCCESSFUL", "FAILED", "CANCELLED"],
        "note": "CredentialsTask.status is declared in the 9.0.0.0 document as a plain string with no 'enum'. The values above are pinned by this contract.",
        "password_change_point": "The resource password changes on the SDDC Manager side at the moment the task first reports SUCCESSFUL, and not before. A task that reports FAILED leaves the existing password in place."
      }
    },
    {
      "operationId": "getCredential",
      "method": "GET",
      "path": "/v1/credentials/{id}",
      "summary": "Retrieve a credential by its ID",
      "authenticated": true,
      "parameters": [
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "request_body": null,
      "success": {
        "status": 200,
        "schema": "Credential",
        "required": [
          "accountType",
          "creationTimestamp",
          "credentialType",
          "id",
          "modificationTimestamp",
          "resource",
          "username"
        ],
        "properties": {
          "id": "string",
          "credentialType": "string",
          "accountType": "string",
          "username": "string",
          "password": "string",
          "creationTimestamp": "string",
          "modificationTimestamp": "string",
          "resource": "AuthenticatedResource{resourceId,resourceName,resourceIp,resourceType,domainNames,domainName}"
        }
      },
      "errors": [400, 401, 403, 404, 500]
    }
  ]
}

{
  "contract_version": 1,
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/vcf-installer/vcf-installer-openapi.json",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "spec_version": "9.1.0.0"
  },
  "operations": [
    {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "request": {
        "required": true,
        "contentType": "application/json",
        "schema": "TokenCreationSpec"
      },
      "responses": {
        "201": "TokenPair",
        "400": "Error",
        "500": "Error"
      }
    },
    {
      "operationId": "getApplianceInfo",
      "method": "GET",
      "path": "/v1/system/appliance-info",
      "responses": {
        "200": "ApplianceInfo",
        "500": "Error"
      }
    },
    {
      "operationId": "updateSystemConfiguration",
      "method": "PATCH",
      "path": "/v1/system",
      "request": {
        "required": true,
        "contentType": "application/json",
        "schema": "SystemUpdateSpec"
      },
      "responses": {
        "200": null,
        "400": "Error",
        "500": "Error"
      }
    },
    {
      "operationId": "updateProxyConfiguration",
      "method": "PATCH",
      "path": "/v1/system/proxy-configuration",
      "request": {
        "required": true,
        "contentType": "application/json",
        "schema": "ProxyConfiguration"
      },
      "responses": {
        "202": "Task",
        "400": "Error",
        "500": null
      }
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": "Task",
        "404": "Error",
        "500": "Error"
      }
    },
    {
      "operationId": "setCeipStatus",
      "method": "PATCH",
      "path": "/v1/system/ceip",
      "request": {
        "required": true,
        "contentType": "application/json",
        "schema": "CeipUpdateSpec"
      },
      "responses": {
        "202": "Task",
        "400": "Error",
        "409": "Error",
        "500": "Error"
      }
    }
  ],
  "schemas": {
    "TokenCreationSpec": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "apiKey": {
          "type": "string"
        },
        "idToken": {
          "type": "string"
        }
      }
    },
    "RefreshToken": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "TokenPair": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string"
        },
        "refreshToken": {
          "$ref": "RefreshToken"
        }
      }
    },
    "IpAddress": {
      "type": "object",
      "properties": {
        "ipAddress": {
          "type": "string"
        }
      }
    },
    "ApplianceInfo": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "dnsDomain": {
          "type": "string"
        },
        "dnsServers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ntpServers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ipAddresses": {
          "type": "array",
          "items": {
            "$ref": "IpAddress"
          }
        }
      }
    },
    "SystemUpdateSpec": {
      "type": "object",
      "required": [
        "maxAllowedDomainsInSubscription"
      ],
      "properties": {
        "maxAllowedDomainsInSubscription": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "ProxyConfiguration": {
      "type": "object",
      "properties": {
        "isConfigured": {
          "type": "boolean",
          "readOnly": true
        },
        "isEnabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "format": "int32"
        },
        "transferProtocol": {
          "type": "string",
          "enum": [
            "HTTP",
            "HTTPS"
          ]
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "isAuthenticated": {
          "type": "boolean"
        }
      }
    },
    "CeipUpdateSpec": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string"
        }
      }
    },
    "Task": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status",
        "creationTimestamp"
      ],
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "readOnly": true
        },
        "creationTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "completionTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "errors": {
          "type": "array",
          "readOnly": true,
          "items": {
            "$ref": "Error"
          }
        }
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "errorCode": {
          "type": "string",
          "readOnly": true
        },
        "errorType": {
          "type": "string",
          "readOnly": true
        },
        "message": {
          "type": "string",
          "readOnly": true
        },
        "remediationMessage": {
          "type": "string",
          "readOnly": true
        },
        "referenceToken": {
          "type": "string",
          "readOnly": true
        }
      }
    }
  }
}

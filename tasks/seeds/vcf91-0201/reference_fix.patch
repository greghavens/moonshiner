 Set-StrictMode -Version Latest
 
+$script:MinimumInstallerSdkVersion = [version]'13.5.0.25380678'
+
+function Import-VcfInstallerSdk {
+    $available = Get-Module -ListAvailable -Name VMware.Sdk.Vcf.Installer |
+        Where-Object { $_.Version -ge $script:MinimumInstallerSdkVersion } |
+        Sort-Object Version -Descending |
+        Select-Object -First 1
+
+    if ($null -eq $available) {
+        throw "VMware.Sdk.Vcf.Installer $($script:MinimumInstallerSdkVersion) or newer is required."
+    }
+
+    Import-Module VMware.Sdk.Vcf.Installer -MinimumVersion $script:MinimumInstallerSdkVersion -ErrorAction Stop
+}
+
+function New-ChangeStep {
+    param(
+        [Parameter(Mandatory)]
+        [string]$Name,
+        [Parameter(Mandatory)]
+        [string]$OperationId,
+        [Parameter(Mandatory)]
+        [ValidateSet('Succeeded', 'Failed', 'NotRun')]
+        [string]$Status,
+        [AllowNull()]
+        [object]$TaskId,
+        [AllowNull()]
+        [object]$TaskStatus,
+        [AllowNull()]
+        [object]$ErrorCode,
+        [AllowNull()]
+        [object]$ErrorMessage
+    )
+
+    [pscustomobject][ordered]@{
+        Name         = $Name
+        OperationId  = $OperationId
+        Status       = $Status
+        TaskId       = $TaskId
+        TaskStatus   = $TaskStatus
+        ErrorCode    = $ErrorCode
+        ErrorMessage = $ErrorMessage
+    }
+}
+
+function Get-VcfErrorDetail {
+    param(
+        [Parameter(Mandatory)]
+        [System.Management.Automation.ErrorRecord]$Record
+    )
+
+    $candidates = [System.Collections.Generic.List[string]]::new()
+    if ($null -ne $Record.ErrorDetails -and -not [string]::IsNullOrWhiteSpace($Record.ErrorDetails.Message)) {
+        $candidates.Add($Record.ErrorDetails.Message)
+    }
+    if ($null -ne $Record.Exception -and -not [string]::IsNullOrWhiteSpace($Record.Exception.Message)) {
+        $candidates.Add($Record.Exception.Message)
+    }
+    if ($null -ne $Record.Exception -and $null -ne $Record.Exception.Data) {
+        foreach ($key in $Record.Exception.Data.Keys) {
+            $value = $Record.Exception.Data[$key]
+            if ($null -ne $value) {
+                $candidates.Add([string]$value)
+            }
+        }
+    }
+    $candidates.Add(($Record | Out-String))
+
+    foreach ($candidate in $candidates) {
+        $jsonCandidates = [System.Collections.Generic.List[string]]::new()
+        $jsonCandidates.Add($candidate)
+        $firstBrace = $candidate.IndexOf('{')
+        $lastBrace = $candidate.LastIndexOf('}')
+        if ($firstBrace -ge 0 -and $lastBrace -gt $firstBrace) {
+            $jsonCandidates.Add($candidate.Substring($firstBrace, $lastBrace - $firstBrace + 1))
+        }
+
+        foreach ($jsonText in $jsonCandidates) {
+            try {
+                $parsed = $jsonText | ConvertFrom-Json -Depth 30 -ErrorAction Stop
+                if ($null -ne $parsed -and
+                    $parsed.PSObject.Properties.Name -contains 'errorCode' -and
+                    -not [string]::IsNullOrWhiteSpace([string]$parsed.errorCode)) {
+                    return [pscustomobject]@{
+                        ErrorCode = [string]$parsed.errorCode
+                        ErrorMessage = [string]$parsed.message
+                    }
+                }
+            }
+            catch {
+                # This candidate was not an API JSON document.
+            }
+        }
+    }
+
+    $combined = $candidates -join "`n"
+    $codeMatch = [regex]::Match($combined, '(?is)["'']?errorCode["'']?\s*[:=]\s*["''](?<value>[^"'']+)["'']')
+    $messageMatch = [regex]::Match($combined, '(?is)["'']?message["'']?\s*[:=]\s*["''](?<value>[^"'']+)["'']')
+    [pscustomobject]@{
+        ErrorCode = if ($codeMatch.Success) { $codeMatch.Groups['value'].Value } else { 'UNKNOWN_ERROR' }
+        ErrorMessage = if ($messageMatch.Success) { $messageMatch.Groups['value'].Value } else { $Record.Exception.Message }
+    }
+}
+
+function New-ChangeReport {
+    param(
+        [Parameter(Mandatory)]
+        [ValidateSet('Succeeded', 'Failed', 'PartialFailure')]
+        [string]$Outcome,
+        [Parameter(Mandatory)]
+        [System.Collections.Generic.List[object]]$Steps
+    )
+
+    [pscustomobject][ordered]@{
+        Outcome = $Outcome
+        Steps   = [object[]]$Steps.ToArray()
+    }
+}

 function Invoke-VcfInstallerChange {
@@ -48,7 +179,147 @@ function Invoke-VcfInstallerChange {
         [int]$TaskTimeoutSeconds = 60
     )
 
-    throw 'Not implemented.'
+    Import-VcfInstallerSdk
+    $steps = [System.Collections.Generic.List[object]]::new()
+

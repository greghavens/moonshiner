+            }
+            if ($proxyTaskStatus -in @('FAILED', 'CANCELLED', 'CANCELED')) {
+                $taskError = @($task.Errors) | Select-Object -First 1
+                $taskCode = if ($null -ne $taskError -and -not [string]::IsNullOrWhiteSpace([string]$taskError.ErrorCode)) {
+                    [string]$taskError.ErrorCode
+                }
+                else {
+                    "TASK_$proxyTaskStatus"
+                }
+                $taskMessage = if ($null -ne $taskError -and -not [string]::IsNullOrWhiteSpace([string]$taskError.Message)) {
+                    [string]$taskError.Message
+                }
+                else {
+                    "Proxy task ended with status $proxyTaskStatus."
+                }
+                $steps.Add((New-ChangeStep `

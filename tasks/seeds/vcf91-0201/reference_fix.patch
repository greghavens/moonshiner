+        $steps.Add((New-ChangeStep -Name 'ProxyConfiguration' -OperationId 'updateProxyConfiguration' -Status 'NotRun'))
+        $steps.Add((New-ChangeStep -Name 'Ceip' -OperationId 'setCeipStatus' -Status 'NotRun'))
+        return New-ChangeReport -Outcome 'Failed' -Steps $steps
+    }
+
+    $proxyTaskId = $null
+    $proxyTaskStatus = $null
+    try {
+        $proxySpec = Initialize-VcfInstallerProxyConfiguration `
+            -IsEnabled $true `
+            -VarHost $ProxyHost `
+            -Port $ProxyPort `
+            -TransferProtocol $ProxyProtocol
+        $proxyTask = Invoke-VcfInstallerUpdateProxyConfiguration `
+            -ProxyConfiguration $proxySpec `
+            -Server $Connection `
+            -ErrorAction Stop
+        $proxyTaskId = [string]$proxyTask.Id
+        if ([string]::IsNullOrWhiteSpace($proxyTaskId)) {
+            throw 'The proxy update did not return a task id.'

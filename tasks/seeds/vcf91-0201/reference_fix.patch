+                $steps.Add((New-ChangeStep -Name 'Ceip' -OperationId 'setCeipStatus' -Status 'NotRun'))
+                return New-ChangeReport -Outcome 'PartialFailure' -Steps $steps
+            }
+            if ($PollIntervalSeconds -gt 0) {
+                Start-Sleep -Seconds $PollIntervalSeconds
+            }
+        }
+
+        $steps.Add((New-ChangeStep `
+            -Name 'ProxyConfiguration' `
+            -OperationId 'updateProxyConfiguration' `
+            -Status 'Succeeded' `
+            -TaskId $proxyTaskId `
+            -TaskStatus $proxyTaskStatus))
+    }
+    catch {
+        $failure = Get-VcfErrorDetail -Record $_
+        $steps.Add((New-ChangeStep `
+            -Name 'ProxyConfiguration' `
+            -OperationId 'updateProxyConfiguration' `
+            -Status 'Failed' `
+            -TaskId $proxyTaskId `
+            -TaskStatus $proxyTaskStatus `
+            -ErrorCode $failure.ErrorCode `
+            -ErrorMessage $failure.ErrorMessage))
+        $steps.Add((New-ChangeStep -Name 'Ceip' -OperationId 'setCeipStatus' -Status 'NotRun'))
+        return New-ChangeReport -Outcome 'PartialFailure' -Steps $steps
+    }
+
+    try {
+        $ceipSpec = Initialize-VcfInstallerCeipUpdateSpec -Status $CeipStatus
+        $null = Invoke-VcfInstallerSetCeipStatus `
+            -CeipUpdateSpec $ceipSpec `
+            -Server $Connection `
+            -ErrorAction Stop
+        $steps.Add((New-ChangeStep `
+            -Name 'Ceip' `
+            -OperationId 'setCeipStatus' `
+            -Status 'Succeeded'))
+        return New-ChangeReport -Outcome 'Succeeded' -Steps $steps
+    }
+    catch {
+        $failure = Get-VcfErrorDetail -Record $_
+        $steps.Add((New-ChangeStep `
+            -Name 'Ceip' `
+            -OperationId 'setCeipStatus' `
+            -Status 'Failed' `
+            -ErrorCode $failure.ErrorCode `
+            -ErrorMessage $failure.ErrorMessage))
+        return New-ChangeReport -Outcome 'PartialFailure' -Steps $steps
+    }
 }
 

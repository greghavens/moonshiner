+func validateOptions(options ListOptions) error {
+	if options.Names != nil {
+		if len(options.Names) == 0 {
+			return errors.New("Names must be nil or a nonempty unique list")
+		}
+		seen := make(map[string]struct{}, len(options.Names))
+		for _, name := range options.Names {
+			if strings.TrimSpace(name) == "" {
+				return errors.New("Names contains a blank value")
+			}
+			if _, exists := seen[name]; exists {
+				return errors.New("Names contains a duplicate value")
+			}
+			seen[name] = struct{}{}
+		}
+	}
+	if options.PageSize != nil && *options.PageSize < 1 {
+		return errors.New("PageSize must be positive when set")
+	}
+	return nil
+}

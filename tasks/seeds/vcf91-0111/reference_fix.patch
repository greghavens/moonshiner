+func sortCategories(categories []Category) {
+	sort.Slice(categories, func(left, right int) bool {
+		if categories[left].Info.Name != categories[right].Info.Name {
+			return categories[left].Info.Name < categories[right].Info.Name
+		}
+		return categories[left].CategoryID < categories[right].CategoryID
+	})
+}

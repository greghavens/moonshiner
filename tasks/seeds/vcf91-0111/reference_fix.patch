+func decodePage(body []byte) ([]Category, string, bool, error) {
+	var result map[string]json.RawMessage
+	if err := json.Unmarshal(body, &result); err != nil || result == nil {
+		return nil, "", false, protocolError("response is not a JSON object")
+	}
+	itemsJSON, exists := result["items"]
+	if !exists || isNull(itemsJSON) {
+		return nil, "", false, protocolError("items is missing or null")
+	}
+	var rawItems []json.RawMessage
+	if err := json.Unmarshal(itemsJSON, &rawItems); err != nil || rawItems == nil {
+		return nil, "", false, protocolError("items is not an array")
+	}
+
+	items := make([]Category, len(rawItems))
+	for index, rawItem := range rawItems {
+		item, err := decodeCategory(rawItem)
+		if err != nil {
+			return nil, "", false, err
+		}
+		items[index] = item
+	}
+
+	markerJSON, exists := result["marker"]
+	if !exists || isNull(markerJSON) {
+		return items, "", false, nil
+	}
+	var marker string
+	if err := json.Unmarshal(markerJSON, &marker); err != nil {
+		return nil, "", false, protocolError("marker is not a string")
+	}
+	if marker == "" {
+		return nil, "", false, protocolError("marker is empty")
+	}
+	return items, marker, true, nil
+}
+
+func decodeCategory(raw json.RawMessage) (Category, error) {
+	var item map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &item); err != nil || item == nil {
+		return Category{}, protocolError("category item is not an object")
+	}
+	categoryID, ok := requiredString(item, "category_id")
+	if !ok {
+		return Category{}, protocolError("category_id is missing or invalid")
+	}
+	infoJSON, exists := item["info"]
+	if !exists || isNull(infoJSON) {
+		return Category{}, protocolError("info is missing or null")
+	}
+	var info map[string]json.RawMessage
+	if err := json.Unmarshal(infoJSON, &info); err != nil || info == nil {
+		return Category{}, protocolError("info is not an object")
+	}
+	name, nameOK := requiredString(info, "name")
+	description, descriptionOK := requiredString(info, "description")
+	cardinality, cardinalityOK := requiredString(info, "cardinality")
+	associableTypes, associableOK := requiredStringArray(info, "associable_types")
+	usedBy, usedByOK := requiredStringArray(info, "used_by")
+	if !nameOK || !descriptionOK || !cardinalityOK || !associableOK || !usedByOK {
+		return Category{}, protocolError("category info has missing or invalid required fields")
+	}
+	return Category{
+		CategoryID: categoryID,
+		Info: CategoryInfo{
+			Name:            name,
+			Description:     description,
+			Cardinality:     cardinality,
+			AssociableTypes: associableTypes,
+			UsedBy:          usedBy,
+		},
+	}, nil
+}
+
+func requiredString(
+	object map[string]json.RawMessage,
+	name string,
+) (string, bool) {
+	raw, exists := object[name]
+	if !exists || isNull(raw) {
+		return "", false
+	}
+	var value string
+	if err := json.Unmarshal(raw, &value); err != nil {
+		return "", false
+	}
+	return value, true
+}
+
+func requiredStringArray(
+	object map[string]json.RawMessage,
+	name string,
+) ([]string, bool) {
+	raw, exists := object[name]
+	if !exists || isNull(raw) {
+		return nil, false
+	}
+	var value []string
+	if err := json.Unmarshal(raw, &value); err != nil || value == nil {
+		return nil, false
+	}
+	return value, true
+}

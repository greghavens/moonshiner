+	target := c.baseURL + "/api/vcenter/tagging/categories"
+	if encoded := query.Encode(); encoded != "" {
+		target += "?" + encoded
+	}
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, target, nil)
+	if err != nil {
+		if ctx.Err() != nil {
+			return nil, "", false, ctx.Err()
+		}
+		return nil, "", false, errors.New(listCategoriesOperationID + " request could not be created")
+	}
+	request.Header.Set("Accept", "application/json")
+	request.Header.Set("vmware-api-session-id", c.sessionID)
+
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		if ctx.Err() != nil {
+			return nil, "", false, ctx.Err()
+		}
+		return nil, "", false, errors.New(listCategoriesOperationID + " transport request failed")
+	}
+	defer response.Body.Close()
+
+	body, err := io.ReadAll(io.LimitReader(response.Body, maxResponseBytes+1))
+	if err != nil {
+		return nil, "", false, errors.New(listCategoriesOperationID + " response could not be read")
+	}
+	if len(body) > maxResponseBytes {
+		return nil, "", false, protocolError("response body is too large")
+	}
+	if response.StatusCode != http.StatusOK {
+		var envelope struct {
+			ErrorType string               `json:"error_type"`
+			Messages  []LocalizableMessage `json:"messages"`
+		}
+		_ = json.Unmarshal(body, &envelope)
+		return nil, "", false, &APIError{
+			OperationID: listCategoriesOperationID,
+			StatusCode:  response.StatusCode,
+			ErrorType:   envelope.ErrorType,
+			Messages:    envelope.Messages,
+		}
+	}
+	page, marker, hasNext, err := decodePage(body)
+	if err != nil {
+		return nil, "", false, err
+	}
+	return page, marker, hasNext, nil

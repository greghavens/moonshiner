{
  "contract_version": 1,
  "product": "VMware Cloud Foundation 9.1 vSphere Automation API for vCenter",
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "source_blob_sha": "8028b0824c4ff3503d05f44814f967938a795c40",
    "spec_path": "specifications/vsphere/openapi/automation/vcenter.yaml",
    "openapi": "3.0.3",
    "info_title": "vSphere Automation API",
    "info_version": "9.1.0.0",
    "repository_license": "Apache-2.0"
  },
  "servers": [
    {
      "url": "https://{host}/api",
      "base_path": "/api",
      "variables": {
        "host": {
          "default": "localhost"
        }
      }
    }
  ],
  "security_schemes": {
    "api_key_auth": {
      "type": "apiKey",
      "name": "vmware-api-session-id",
      "in": "header"
    }
  },
  "operations": [
    {
      "operationId": "Vcenter.Tagging.Categories_list",
      "summary": "Returns categories that match the specified filter and iteration.",
      "method": "GET",
      "path": "/vcenter/tagging/categories",
      "security": [
        "api_key_auth"
      ],
      "query_parameters": [
        {
          "name": "names",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "unset_behavior": "If missing or null, categories with any name match this filter."
        },
        {
          "name": "iterate",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema_ref": "#/components/schemas/Vcenter.Tagging.Categories.IterationSpec",
          "unset_behavior": "If missing or null, the first page will be retrieved."
        }
      ],
      "responses": {
        "200": {
          "description": "A page of the categories matching the filter and iteration specification.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vcenter.Tagging.Categories.ListResult"
        },
        "400": {
          "description": "If marker and filter are supplied together.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.InvalidArgument"
        },
        "401": {
          "description": "If the user can not be authenticated.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.Unauthenticated"
        },
        "403": {
          "description": "If the user does not have the required privileges.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.Unauthorized"
        },
        "404": {
          "description": "If the supplied marker value is not valid.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.NotFound"
        },
        "500": {
          "description": "If the request cannot be completed.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.Error"
        }
      }
    }
  ],
  "schemas": {
    "Vcenter.Tagging.Categories.Info": {
      "type": "object",
      "required": [
        "associable_types",
        "cardinality",
        "description",
        "name",
        "used_by"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "cardinality": {
          "type": "string",
          "documented_values": [
            "SINGLE",
            "MULTIPLE"
          ]
        },
        "associable_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "used_by": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Vcenter.Tagging.Categories.ListItem": {
      "type": "object",
      "required": [
        "category_id",
        "info"
      ],
      "properties": {
        "category_id": {
          "type": "string",
          "resource_type": "com.vmware.cis.tagging.Category"
        },
        "info": {
          "allOf": [
            {
              "$ref": "#/components/schemas/Vcenter.Tagging.Categories.Info"
            }
          ]
        }
      }
    },
    "Vcenter.Tagging.Categories.ListResult": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "marker": {
          "type": "string",
          "description": "Opaque pagination marker. If missing or null, all categories have been returned."
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Vcenter.Tagging.Categories.ListItem"
          }
        }
      }
    },
    "Vcenter.Tagging.Categories.FilterSpec": {
      "type": "object",
      "properties": {
        "names": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Vcenter.Tagging.Categories.IterationSpec": {
      "type": "object",
      "properties": {
        "marker": {
          "type": "string",
          "description": "Opaque marker used to request the next page. If missing or null, the first page is returned."
        },
        "page_size": {
          "type": "integer",
          "format": "int64",
          "description": "Requested page size. If missing or null, the default size is 20."
        }
      }
    },
    "Vapi.Std.Errors.Error": {
      "type": "object",
      "required": [
        "error_type",
        "messages"
      ],
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Vapi.Std.LocalizableMessage"
          }
        },
        "error_type": {
          "type": "string"
        }
      }
    },
    "Vapi.Std.LocalizableMessage": {
      "type": "object",
      "required": [
        "args",
        "default_message",
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "default_message": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

diff --git a/fulfill_library_request.sh b/fulfill_library_request.sh
new file mode 100755
--- /dev/null
+++ b/fulfill_library_request.sh
@@ -0,0 +1,126 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+run_dir="$(mktemp -d)"
+trap 'rm -rf -- "$run_dir"' EXIT
+
+profile_result="$(./libraryctl profile)"
+service_date="$(python3 - "$profile_result" <<'PY'
+import json
+import sys
+
+payload = json.loads(sys.argv[1])
+value = payload.get("default_date")
+if not isinstance(value, str) or not value.strip():
+    raise SystemExit("profile returned no usable default date")
+print(value)
+PY
+)"
+
+./libraryctl availability \
+  --title "Beginner's Bird Atlas" \
+  --branch "Riverside Branch" \
+  --date "$service_date" >"$run_dir/first.json" &
+first_pid=$!
+./libraryctl availability \
+  --title "Repairing Everyday Things" \
+  --branch "Bookmobile" \
+  --date "$service_date" >"$run_dir/second.json" &
+second_pid=$!
+first_status=0
+second_status=0
+wait "$first_pid" || first_status=$?
+wait "$second_pid" || second_status=$?
+if (( first_status != 0 || second_status != 0 )); then
+  exit 1
+fi
+
+read -r first_available second_available < <(
+  python3 - \
+    "$run_dir/first.json" \
+    "$run_dir/second.json" \
+    "$service_date" <<'PY'
+import json
+import sys
+
+expected = (
+    ("Beginner's Bird Atlas", "Riverside Branch"),
+    ("Repairing Everyday Things", "Bookmobile"),
+)
+values = []
+for path, (title, branch) in zip(sys.argv[1:3], expected, strict=True):
+    with open(path, encoding="utf-8") as stream:
+        result = json.load(stream)
+    if (
+        not isinstance(result, dict)
+        or result.get("title") != title
+        or result.get("branch") != branch
+        or result.get("date") != sys.argv[3]
+        or not isinstance(result.get("available"), bool)
+    ):
+        raise SystemExit("availability result was incomplete or mismatched")
+    values.append("1" if result["available"] else "0")
+print(*values)
+PY
+)
+
+chosen_title=''
+chosen_branch=''
+if [[ "$first_available" == 1 ]]; then
+  chosen_title="Beginner's Bird Atlas"
+  chosen_branch="Riverside Branch"
+elif [[ "$second_available" == 1 ]]; then
+  chosen_title="Repairing Everyday Things"
+  chosen_branch="Bookmobile"
+fi
+
+if [[ -n "$chosen_title" ]]; then
+  ./libraryctl create \
+    --title "$chosen_title" \
+    --branch "$chosen_branch" \
+    --date "$service_date" \
+    --quantity 1 >"$run_dir/create.json"
+  python3 - \
+    "$run_dir/create.json" \
+    "$chosen_title" \
+    "$chosen_branch" \
+    "$service_date" <<'PY'
+import json
+import sys
+
+with open(sys.argv[1], encoding="utf-8") as stream:
+    result = json.load(stream)
+record = result.get("record")
+if (
+    result.get("created") != 1
+    or not isinstance(record, dict)
+    or record.get("title") != sys.argv[2]
+    or record.get("branch") != sys.argv[3]
+    or record.get("date") != sys.argv[4]
+    or record.get("quantity") != 1
+):
+    raise SystemExit("create did not return the requested record")
+PY
+fi
+
+if [[ "$first_available" == 1 ]]; then
+  first_word='yes'
+else
+  first_word='no'
+fi
+if [[ "$second_available" == 1 ]]; then
+  second_word='yes'
+else
+  second_word='no'
+fi
+
+printf '%s\n' \
+  "- Beginner's Bird Atlas | Riverside Branch | available: $first_word" \
+  "- Repairing Everyday Things | Bookmobile | available: $second_word"
+if [[ -n "$chosen_title" ]]; then
+  printf '%s\n' \
+    "- Action | created: $chosen_title | $chosen_branch | date: $service_date | quantity: 1"
+else
+  printf '%s\n' \
+    '- Comparison | neither available | no record created'
+fi

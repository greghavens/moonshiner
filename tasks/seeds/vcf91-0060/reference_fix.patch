+"""Wire models for the two-operation NSX Policy contract."""
+
+from __future__ import annotations
+
+import copy
+from dataclasses import dataclass
+from typing import Any, Sequence
+
+
+def _nonblank(name: str, value: str) -> str:
+    if not isinstance(value, str) or not value.strip():
+        raise ValueError(f"{name} must be a non-blank string")
+    return value
+
+
+@dataclass(frozen=True)
+class IPAddressGroup:
+    """Desired Group containing one IPAddressExpression."""
+
+    display_name: str
+    ip_addresses: Sequence[str]
+    description: str | None = None
+
+    def to_wire(self) -> dict[str, Any]:
+        display_name = _nonblank("display_name", self.display_name)
+        if len(display_name) > 255:
+            raise ValueError("display_name must not exceed 255 characters")
+        if isinstance(self.ip_addresses, (str, bytes)) or not isinstance(
+            self.ip_addresses, Sequence
+        ):
+            raise TypeError("ip_addresses must be a sequence of strings")
+        if not self.ip_addresses:
+            raise ValueError("ip_addresses must contain at least one address")
+        if len(self.ip_addresses) > 25000:
+            raise ValueError("ip_addresses must not contain more than 25000 items")
+
+        addresses = [
+            _nonblank(f"ip_addresses[{index}]", address)
+            for index, address in enumerate(self.ip_addresses)
+        ]
+        wire: dict[str, Any] = {
+            "resource_type": "Group",
+            "display_name": display_name,
+            "expression": [
+                {
+                    "resource_type": "IPAddressExpression",
+                    "ip_addresses": addresses,
+                }
+            ],
+        }
+        if self.description is not None:
+            description = _nonblank("description", self.description)
+            if len(description) > 1024:
+                raise ValueError("description must not exceed 1024 characters")
+            wire["description"] = description
+        return wire
+
+
+@dataclass(frozen=True)
+class EnsureGroupResult:
+    """Confirmation result and workflow-resume metadata."""
+
+    group: dict[str, Any]
+    token_refreshes: int
+    completed_operations: tuple[str, ...]
+
+    @classmethod
+    def create(
+        cls,
+        group: dict[str, Any],
+        token_refreshes: int,
+        completed_operations: list[str],
+    ) -> "EnsureGroupResult":
+        return cls(
+            group=copy.deepcopy(group),
+            token_refreshes=token_refreshes,
+            completed_operations=tuple(completed_operations),
+        )
diff --git a/vcf_nsx_policy/client.py b/vcf_nsx_policy/client.py

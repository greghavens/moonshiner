{
  "contract_version": 1,
  "contract_kind": "spec-derived OpenAPI 2.0 subset with deterministic verifier policy",
  "product": "VMware Cloud Foundation 9.1 - NSX Policy API",
  "info_version": "9.1.0.0",
  "swagger": "2.0",
  "basePath": "/policy/api/v1",
  "consumes": "application/json",
  "produces": "application/json",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_blob_sha": "102d15fd342f6a45bb6d84a5b39a916c65929f4c",
    "license": "Apache-2.0",
    "spec_path": "specifications/nsx/openapi-2.0/nsx_policy_api.yaml"
  },
  "operations": {
    "PatchGroupForDomain": {
      "operationId": "PatchGroupForDomain",
      "method": "PATCH",
      "path": "/infra/domains/{domain-id}/groups/{group-id}",
      "path_parameters": {
        "domain-id": {
          "required": true,
          "type": "string"
        },
        "group-id": {
          "required": true,
          "type": "string"
        }
      },
      "body": {
        "name": "Group",
        "required": true,
        "schema_ref": "#/definitions/Group"
      },
      "success_status": 200,
      "error_schema_ref": "#/definitions/ApiError"
    },
    "ReadGroupForDomain": {
      "operationId": "ReadGroupForDomain",
      "method": "GET",
      "path": "/infra/domains/{domain-id}/groups/{group-id}",
      "path_parameters": {
        "domain-id": {
          "required": true,
          "type": "string"
        },
        "group-id": {
          "required": true,
          "type": "string"
        }
      },
      "success_status": 200,
      "response_schema_ref": "#/definitions/Group",
      "error_schema_ref": "#/definitions/ApiError"
    }
  },
  "definitions": {
    "Group": {
      "allOf": [
        "#/definitions/PolicyConfigResource"
      ],
      "properties": {
        "expression": {
          "type": "array",
          "items_ref": "#/definitions/Expression"
        },
        "extended_expression": {
          "type": "array",
          "items_ref": "#/definitions/Expression",
          "maxItems": 1
        },
        "group_type": {
          "type": "array",
          "maxItems": 1
        }
      }
    },
    "Expression": {
      "allOf": [
        "#/definitions/PolicyConfigResource"
      ],
      "required": [
        "resource_type"
      ],
      "resource_type_values": [
        "Condition",
        "ConjunctionOperator",
        "NestedExpression",
        "IPAddressExpression",
        "MACAddressExpression",
        "ExternalIDExpression",
        "PathExpression",
        "IdentityGroupExpression",
        "GeoLocationExpression"
      ]
    },
    "IPAddressExpression": {
      "allOf": [
        "#/definitions/Expression"
      ],
      "required": [
        "ip_addresses"
      ],
      "properties": {
        "ip_addresses": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "address-or-block-or-range"
          },
          "minItems": 1,
          "maxItems": 25000
        }
      }
    },
    "ManagedResourcePropertiesUsedByThisTask": {
      "description": {
        "type": "string",
        "maxLength": 1024,
        "optional": true
      },
      "display_name": {
        "type": "string",
        "maxLength": 255,
        "optional": true
      },
      "resource_type": {
        "type": "string",
        "optional": true
      }
    },
    "ApiError": {
      "allOf": [
        "#/definitions/RelatedApiError"
      ],
      "properties": {
        "related_errors": {
          "type": "array",
          "items_ref": "#/definitions/RelatedApiError"
        }
      }
    },
    "RelatedApiError": {
      "properties": {
        "details": {
          "type": "string"
        },
        "error_code": {
          "type": "integer",
          "format": "int64"
        },
        "error_data": {
          "type": "object"
        },
        "error_message": {
          "type": "string"
        },
        "module_name": {
          "type": "string"
        }
      }
    }
  },
  "verification_profile": {
    "authorization": "Bearer access token supplied by the caller's provider",
    "headers": {
      "Accept": "application/json on every request",
      "Content-Type": "application/json only for requests with a JSON body"
    },
    "unset_optional_fields": "omit; never synthesize null, empty string, empty object, or empty list",
    "json_encoding": "UTF-8 compact JSON",
    "refresh_policy": {
      "trigger_status": 401,
      "max_replays_of_failed_request": 1,
      "completed_operations_are_not_replayed": true
    },
    "workflow": [
      "PatchGroupForDomain",
      "ReadGroupForDomain"
    ]
  }
}

{
  "contract_format": "focused-openapi-projection-v1",
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "repository_license": "Apache-2.0",
    "spec_path": "specifications/vsphere/openapi/automation/vcenter.yaml",
    "openapi": "3.0.3",
    "info_title": "vSphere Automation API",
    "info_version": "9.1.0.0",
    "server_url_template": "https://{host}/api"
  },
  "operations": [
    {
      "operationId": "Vcenter.Authentication.Token_issue",
      "method": "POST",
      "path": "/vcenter/authentication/token",
      "wire_path": "/api/vcenter/authentication/token",
      "security_any_of": [
        "api_key_auth",
        "federated_identity_auth"
      ],
      "requestBody": {
        "required": true,
        "mediaType": "application/x-www-form-urlencoded",
        "schema": "Vcenter.Authentication.Token.IssueSpec",
        "required_fields": [
          "grant_type"
        ],
        "properties_in_spec_order": [
          "grant_type",
          "resource",
          "audience",
          "scope",
          "requested_token_type",
          "subject_token",
          "subject_token_type",
          "actor_token",
          "actor_token_type"
        ]
      },
      "responses": {
        "200": {
          "mediaType": "application/json",
          "schema": "Oauth2.TokenInfo"
        },
        "400": {
          "mediaType": "application/json",
          "schema": "Oauth2.Errors.Error"
        }
      }
    },
    {
      "operationId": "Vcenter.VM_list",
      "method": "GET",
      "path": "/vcenter/vm",
      "wire_path": "/api/vcenter/vm",
      "security": [
        "api_key_auth"
      ],
      "optional_query_fields": [
        "vms",
        "names",
        "folders",
        "datacenters",
        "hosts",
        "clusters",
        "resource_pools",
        "power_states"
      ],
      "responses": {
        "200": {
          "mediaType": "application/json",
          "type": "array",
          "items_schema": "Vcenter.VM.Summary"
        },
        "400": {
          "schema": "Vapi.Std.Errors.InvalidArgument"
        },
        "401": {
          "schema": "Vapi.Std.Errors.Unauthenticated"
        },
        "403": {
          "schema": "Vapi.Std.Errors.Unauthorized"
        },
        "500": {
          "schema": "Vapi.Std.Errors.UnableToAllocateResource"
        },
        "503": {
          "schema": "Vapi.Std.Errors.ServiceUnavailable"
        }
      }
    },
    {
      "operationId": "Vcenter.Host_list",
      "method": "GET",
      "path": "/vcenter/host",
      "wire_path": "/api/vcenter/host",
      "security": [
        "api_key_auth"
      ],
      "optional_query_fields": [
        "hosts",
        "names",
        "folders",
        "datacenters",
        "standalone",
        "clusters",
        "connection_states"
      ],
      "responses": {
        "200": {
          "mediaType": "application/json",
          "type": "array",
          "items_schema": "Vcenter.Host.Summary"
        },
        "400": {
          "schema": "Vapi.Std.Errors.InvalidArgument"
        },
        "401": {
          "schema": "Vapi.Std.Errors.Unauthenticated"
        },
        "403": {
          "schema": "Vapi.Std.Errors.Unauthorized"
        },
        "500": {
          "schema": "Vapi.Std.Errors.UnableToAllocateResource"
        },
        "503": {
          "schema": "Vapi.Std.Errors.ServiceUnavailable"
        }
      }
    }
  ],
  "schemas": {
    "Vcenter.Authentication.Token.IssueSpec": {
      "type": "object",
      "required": [
        "grant_type"
      ],
      "properties": {
        "grant_type": {
          "type": "string",
          "enum": [
            "urn:ietf:params:oauth:grant-type:token-exchange"
          ]
        },
        "resource": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "requested_token_type": {
          "type": "string"
        },
        "subject_token": {
          "type": "string"
        },
        "subject_token_type": {
          "type": "string"
        },
        "actor_token": {
          "type": "string"
        },
        "actor_token_type": {
          "type": "string"
        }
      }
    },
    "Oauth2.TokenInfo": {
      "type": "object",
      "required": [
        "access_token",
        "token_type"
      ],
      "properties": {
        "access_token": {
          "type": "string"
        },
        "token_type": {
          "type": "string"
        },
        "expires_in": {
          "type": "integer",
          "format": "int64"
        },
        "scope": {
          "type": "string"
        },
        "refresh_token": {
          "type": "string"
        },
        "issued_token_type": {
          "type": "string"
        }
      }
    },
    "Vcenter.VM.Summary": {
      "type": "object",
      "required": [
        "name",
        "power_state",
        "vm"
      ],
      "properties": {
        "vm": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "power_state": {
          "type": "string",
          "enum": [
            "POWERED_OFF",
            "POWERED_ON",
            "SUSPENDED"
          ]
        },
        "cpu_count": {
          "type": "integer",
          "format": "int64"
        },
        "memory_size_mib": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "Vcenter.Host.Summary": {
      "type": "object",
      "required": [
        "host",
        "name",
        "connection_state"
      ],
      "properties": {
        "host": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "connection_state": {
          "type": "string",
          "enum": [
            "CONNECTED",
            "DISCONNECTED",
            "NOT_RESPONDING"
          ]
        },
        "power_state": {
          "type": "string",
          "enum": [
            "POWERED_OFF",
            "POWERED_ON"
          ]
        },
        "host_uuid": {
          "type": "string"
        }
      }
    },
    "Oauth2.Errors.Error": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "string"
        },
        "error_description": {
          "type": "string"
        },
        "error_uri": {
          "type": "string"
        }
      }
    },
    "Vapi.Std.Errors.Error": {
      "type": "object",
      "required": [
        "error_type",
        "messages"
      ],
      "message_fields": [
        "id",
        "default_message",
        "args"
      ]
    }
  },
  "securitySchemes": {
    "api_key_auth": {
      "type": "apiKey",
      "name": "vmware-api-session-id",
      "in": "header"
    },
    "federated_identity_auth": {
      "type": "http",
      "scheme": "bearer"
    }
  },
  "scenario_policy": {
    "note": "These deterministic integration requirements are layered on the extracted OpenAPI wire contract.",
    "origin": "Absolute HTTP(S) origin without the /api suffix",
    "inventory_order": [
      "Vcenter.VM_list",
      "Vcenter.Host_list"
    ],
    "collection_sort": "Ascending Java String.compareTo by vm or host identifier",
    "expired_access_token": "After one collection 401, exchange the configured subject token and retry only that failed collection once",
    "token_exchange_fields_in_wire_order": [
      "grant_type",
      "subject_token",
      "subject_token_type"
    ],
    "token_exchange_authentication": "federated_identity_auth"
  }
}

{
  "contract_format": "vcf-sddc-lcm-operation-subset-v1",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "path": "specifications/sddc-lcm/sddc-lcm-openapi.yaml",
    "openapi": "3.0.4",
    "api_title": "VCF SDDC LCM Service APIs",
    "api_version": "9.1.0.0",
    "repository_license": "Apache-2.0",
    "server_url": "https://vcf.broadcom.com/sddc-lcm"
  },
  "security": {
    "scheme_name": "bearerToken",
    "type": "http",
    "scheme": "Bearer",
    "bearer_format": "JWT",
    "header": "Authorization"
  },
  "wire_rules": {
    "request_json_encoding": "compact",
    "request_member_order": "ascending numeric \"order\" within each schema",
    "unset_optional_members": "omitted entirely; never sent as null, \"\", [] or {}",
    "trailing_newline": "forbidden"
  },
  "operations": [
    {
      "operationId": "performComponentAction",
      "method": "POST",
      "path": "/v1/components/{componentId}",
      "description": "Perform an action on a given component.",
      "path_parameters": [
        {
          "name": "componentId",
          "in": "path",
          "required": true,
          "type": "string",
          "format": "uuid"
        }
      ],
      "query_parameters": [
        {
          "name": "action",
          "in": "query",
          "required": true,
          "type": "string",
          "enum": [
            "shutdown",
            "restart",
            "start",
            "refresh",
            "precheck",
            "apply"
          ]
        }
      ],
      "header_parameters": [
        {
          "name": "X-Correlation-Id",
          "in": "header",
          "required": false,
          "type": "string",
          "description": "Correlation ID for tracing the request across services"
        }
      ],
      "request": {
        "required": false,
        "content_type": "application/json",
        "schema": "ComponentUpgradeSpec"
      },
      "success_responses": {
        "202": {
          "description": "Accepted",
          "content_type": "application/json",
          "schema": "Task"
        }
      },
      "error_responses": {
        "400": {
          "description": "Bad Request",
          "schema": "ErrorResponse"
        },
        "404": {
          "description": "Not Found",
          "schema": "ErrorResponse"
        },
        "500": {
          "description": "Internal Server Error",
          "schema": "ErrorResponse"
        }
      }
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{taskId}",
      "description": "Get a task",
      "path_parameters": [
        {
          "name": "taskId",
          "in": "path",
          "required": true,
          "type": "string",
          "format": "uuid"
        }
      ],
      "success_responses": {
        "200": {
          "description": "OK",
          "content_type": "application/json",
          "schema": "Task"
        }
      },
      "error_responses": {
        "404": {
          "description": "Not Found",
          "schema": "ErrorResponse"
        },
        "500": {
          "description": "Internal Server Error",
          "schema": "ErrorResponse"
        }
      }
    }
  ],
  "schemas": {
    "ComponentUpgradeSpec": {
      "type": "object",
      "required": [
        "componentSpec"
      ],
      "properties": {
        "componentSpec": {
          "order": 1,
          "$ref": "ComponentDesiredSpec"
        },
        "lcmPlatformSpec": {
          "order": 2,
          "$ref": "LcmPlatformSpec"
        },
        "correlationId": {
          "order": 3,
          "type": "string",
          "format": "uuid",
          "description": "A unique identifier for this specific upgrade request."
        }
      }
    },
    "ComponentDesiredSpec": {
      "type": "object",
      "required": [
        "depot",
        "software"
      ],
      "properties": {
        "software": {
          "order": 1,
          "$ref": "SoftwareSpec"
        },
        "policy": {
          "order": 2,
          "type": "object",
          "description": "Specific policies to apply during the component's upgrade lifecycle."
        },
        "depot": {
          "order": 3,
          "$ref": "DepotSpec"
        },
        "userInput": {
          "order": 4,
          "type": "object",
          "description": "User-input specific configuration required for component upgrade."
        },
        "additionalInput": {
          "order": 5,
          "type": "object",
          "description": "Additional inputs required for component upgrade."
        }
      }
    },
    "SoftwareSpec": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "order": 1,
          "type": "string",
          "description": "The exact target version to which the component should be upgraded."
        }
      }
    },
    "DepotSpec": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "order": 1,
          "type": "string",
          "format": "uri"
        },
        "certificate": {
          "order": 2,
          "type": "array",
          "items": "string",
          "description": "Base64-encoded certificates required to authenticate with the depot."
        }
      }
    },
    "LcmPlatformSpec": {
      "type": "object",
      "required": [
        "performBackup"
      ],
      "properties": {
        "performBackup": {
          "order": 1,
          "type": "boolean",
          "default": false
        }
      }
    },
    "Task": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": "string",
        "name": "string",
        "description": "LocalizableMessage",
        "status": "TaskStatus",
        "type": "string",
        "createdBy": "string",
        "updatedBy": "string",
        "resourceId": "string",
        "resourceType": "string",
        "createTime": "string",
        "startTime": "string",
        "updateTime": "string",
        "endTime": "string",
        "correlationId": "string",
        "parentTaskId": "string",
        "retriable": "boolean",
        "cancellable": "boolean"
      }
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "SCHEDULED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELED"
      ]
    },
    "ErrorResponse": {
      "type": "object",
      "required": [
        "code",
        "message",
        "referenceId",
        "resolution",
        "timestamp"
      ],
      "properties": {
        "code": "string",
        "message": "LocalizableMessage",
        "resolution": "LocalizableMessage",
        "referenceId": "string",
        "timestamp": "string",
        "detail": "string"
      }
    },
    "LocalizableMessage": {
      "type": "object",
      "properties": {
        "id": "string",
        "defaultMessage": "string",
        "localizedMessage": "string",
        "args": "map[string]string"
      }
    }
  }
}

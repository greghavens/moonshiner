+func TestClassifyStatus(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		status string
+		want   statusClass
+	}{
+		{"pending is not terminal", StatusPending, statusNonTerminal},
+		{"scheduled is not terminal", StatusScheduled, statusNonTerminal},
+		{"running is not terminal", StatusRunning, statusNonTerminal},
+		{"succeeded is success", StatusSucceeded, statusSuccess},
+		{"failed is failure", StatusFailed, statusFailure},
+		{"canceled is failure", StatusCanceled, statusFailure},
+		{"lowercase is not in the enum", "succeeded", statusUnknown},
+		{"empty is not in the enum", "", statusUnknown},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := classify(tc.status); got != tc.want {
+				t.Errorf("classify(%q) = %v, want %v", tc.status, got, tc.want)
+			}
+		})
+	}
+}
+
+func TestRetryable(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		err  error
+		want bool
+	}{
+		{"transient server error", &APIError{StatusCode: http.StatusInternalServerError}, true},
+		{"gateway timeout", &APIError{StatusCode: http.StatusGatewayTimeout}, true},
+		{"throttled", &APIError{StatusCode: http.StatusTooManyRequests}, true},
+		{"bad request is final", &APIError{StatusCode: http.StatusBadRequest}, false},
+		{"not found is final", &APIError{StatusCode: http.StatusNotFound}, false},
+		{"protocol error is final", &ProtocolError{Reason: "bad body"}, false},
+		{"cancelled context is final", context.Canceled, false},
+		{"transport failure is worth another attempt", errors.New("connection reset by peer"), true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := retryable(tc.err); got != tc.want {
+				t.Errorf("retryable(%v) = %v, want %v", tc.err, got, tc.want)
+			}
+		})
+	}
+}

+func (c *Client) submitApply(ctx context.Context, endpoint string, body []byte, correlationID string) (*Task, error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, bytes.NewReader(body))
+	if err != nil {
+		return nil, fmt.Errorf("sddclcm: build apply request: %w", err)
+	}
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Authorization", "Bearer "+c.token)
+	req.Header.Set("X-Correlation-Id", correlationID)
+
+	return c.roundTripTask(req, http.StatusAccepted)
 }
 
 // GetTask reads one task by id.
 func (c *Client) GetTask(ctx context.Context, taskID string) (*Task, error) {
-	return nil, errors.New("sddclcm: GetTask is not implemented")
+	if strings.TrimSpace(taskID) == "" {
+		return nil, errors.New("sddclcm: taskID is required")
+	}
+	endpoint := c.baseURL + "/v1/tasks/" + url.PathEscape(taskID)
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint, nil)
+	if err != nil {
+		return nil, fmt.Errorf("sddclcm: build getTask request: %w", err)
+	}
+	// A body-less GET carries no Content-Type.
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("Authorization", "Bearer "+c.token)
+
+	return c.roundTripTask(req, http.StatusOK)
+}
+
+func (c *Client) roundTripTask(req *http.Request, wantStatus int) (*Task, error) {
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = resp.Body.Close() }()
+
+	raw, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return nil, fmt.Errorf("sddclcm: read response: %w", err)
+	}
+	if resp.StatusCode != wantStatus {
+		return nil, apiError(resp.StatusCode, raw)
+	}
+
+	task := &Task{}
+	if err := json.Unmarshal(raw, task); err != nil {
+		return nil, &ProtocolError{Reason: fmt.Sprintf("response is not a Task object: %v", err)}
+	}
+	if task.ID == "" {
+		return nil, &ProtocolError{Reason: "Task.id is required by the contract but was empty"}
+	}
+	return task, nil
+}
+
+func apiError(status int, raw []byte) *APIError {
+	out := &APIError{StatusCode: status, Body: raw}
+	var payload struct {
+		Code        string              `json:"code"`
+		ReferenceID string              `json:"referenceId"`
+		Message     *LocalizableMessage `json:"message"`
+	}
+	if err := json.Unmarshal(raw, &payload); err == nil {
+		out.Code = payload.Code
+		out.ReferenceID = payload.ReferenceID
+		if payload.Message != nil {
+			out.Message = payload.Message.DefaultMessage
+			if out.Message == "" {
+				out.Message = payload.Message.LocalizedMessage
+			}
+		}
+	}
+	return out
+}
+
+// retryable reports whether re-sending the identical submission is worth it.
+// Only transport failures and the named transient statuses qualify: any
+// other 4xx means the service understood the request and rejected it, so replaying
+// it would only repeat the rejection.
+func retryable(err error) bool {
+	if errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded) {
+		return false
+	}
+	var protocolErr *ProtocolError
+	if errors.As(err, &protocolErr) {
+		return false
+	}
+	var apiErr *APIError
+	if errors.As(err, &apiErr) {
+		switch apiErr.StatusCode {
+		case http.StatusTooManyRequests,
+			http.StatusInternalServerError,
+			http.StatusBadGateway,
+			http.StatusServiceUnavailable,
+			http.StatusGatewayTimeout:
+			return true
+		default:
+			return false
+		}
+	}
+	return true
 }
 
 // ApplyUpgradeAndWait submits the upgrade and polls until the task reaches a
 // terminal status or timeout elapses.
 func (c *Client) ApplyUpgradeAndWait(ctx context.Context, componentID string, spec UpgradeSpec, timeout time.Duration) (*Task, error) {
-	return nil, errors.New("sddclcm: ApplyUpgradeAndWait is not implemented")
+	task, err := c.ApplyComponentUpgrade(ctx, componentID, spec)
+	if err != nil {
+		return nil, err
+	}
+
+	pollCtx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+	current := task
+	for {
+		switch classify(current.Status) {
+		case statusSuccess:
+			return current, nil
+		case statusFailure:
+			return current, &TaskFailedError{Task: current}
+		case statusUnknown:
+			return nil, &ProtocolError{
+				Reason: fmt.Sprintf("task %s reported status %q, which is outside the TaskStatus enum",
+					current.ID, current.Status),
+			}
+		}
+
+		if err := pollWaitError(ctx, pollCtx, current); err != nil {
+			return nil, err
+		}
+		if err := sleep(pollCtx, c.pollInterval); err != nil {
+			if waitErr := pollWaitError(ctx, pollCtx, current); waitErr != nil {
+				return nil, waitErr
+			}
+			return nil, err
+		}
+		next, err := c.GetTask(pollCtx, task.ID)
+		if err != nil {
+			if waitErr := pollWaitError(ctx, pollCtx, current); waitErr != nil {
+				return nil, waitErr
+			}
+			return nil, err
+		}
+		current = next
+	}
+}
+
+func pollWaitError(parent, poll context.Context, task *Task) error {
+	if err := parent.Err(); err != nil {
+		return err
+	}
+	if errors.Is(poll.Err(), context.DeadlineExceeded) {
+		return fmt.Errorf("sddclcm: task %s is still %s: %w", task.ID, task.Status, ErrPollTimeout)
+	}
+	return poll.Err()
+}
+
+func sleep(ctx context.Context, d time.Duration) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if d <= 0 {
+		return nil
+	}
+	timer := time.NewTimer(d)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-timer.C:
+		return nil
+	}
 }

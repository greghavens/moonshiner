+func TestUpgradeSpecToWireJSON(t *testing.T) {
+	withPlatform := func(backup bool) UpgradeSpec {
+		spec := testSpec()
+		spec.LcmPlatform = &LcmPlatformSpec{PerformBackup: backup}
+		return spec
+	}
+	full := withPlatform(true)
+	full.ComponentSpec.Policy = map[string]any{"haltOnPrecheckWarning": true}
+	full.ComponentSpec.Depot.Certificate = []string{"LS0tLS1CRUdJTiBDRVJUSUZJQ0FURQ=="}
+	full.ComponentSpec.UserInput = map[string]any{"acceptEula": true}
+	full.ComponentSpec.AdditionalInput = map[string]any{"maintenanceWindow": "PT4H"}
+
+	emptyContainers := testSpec()
+	emptyContainers.ComponentSpec.Policy = map[string]any{}
+	emptyContainers.ComponentSpec.UserInput = map[string]any{}
+	emptyContainers.ComponentSpec.Depot.Certificate = []string{}
+
+	base := `{"componentSpec":{"software":{"version":"9.1.0.0000.1234567"},` +
+		`"depot":{"url":"https://fds.vsphere.com/component-x/v9.1.0/upgrade-manifest"}},`
+
+	for _, tc := range []struct {
+		name string

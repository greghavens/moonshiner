+			name:        "a failed task is reported as TaskFailedError",
+			opts:        contractmock.Options{TaskStatuses: []string{"FAILED"}},
+			wantApplies: 1,
+			wantTasks:   1,
+			check: func(t *testing.T, _ *Task, err error) {
+				var failed *TaskFailedError
+				if !errors.As(err, &failed) {
+					t.Fatalf("err = %v, want *TaskFailedError", err)
+				}
+			},
+		},
+		{
+			name:        "an unknown status is a protocol error",
+			opts:        contractmock.Options{TaskStatuses: []string{"HALF_DONE"}},
+			wantApplies: 1,
+			wantTasks:   1,
+			check: func(t *testing.T, _ *Task, err error) {
+				var protocolErr *ProtocolError
+				if !errors.As(err, &protocolErr) {
+					t.Fatalf("err = %v, want *ProtocolError", err)
+				}
+			},
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			mock := contractmock.Start(t, tc.opts)
+			client := newTestClient(t, mock)
+
+			task, err := client.ApplyUpgradeAndWait(context.Background(), testComponentID, testSpec(), time.Hour)
+			tc.check(t, task, err)
+
+			applies := 0
+			for _, rec := range mock.Requests() {
+				if rec.Method == http.MethodPost {
+					applies++
+				}
+			}
+			if applies != tc.wantApplies {
+				t.Errorf("apply attempts = %d, want %d", applies, tc.wantApplies)
+			}
+			if got := len(mock.CreatedTaskIDs()); got != tc.wantTasks {
+				t.Errorf("upgrades started = %d, want %d", got, tc.wantTasks)
+			}
+		})
+	}
+}

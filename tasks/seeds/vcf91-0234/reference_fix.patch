+func TestNewClientValidatesItsInputs(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		baseURL string
+		token   string
+	}{
+		{"empty base url", "", testToken},
+		{"blank base url", "   ", testToken},
+		{"empty token", "http://127.0.0.1:1", ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if _, err := NewClient(tc.baseURL, tc.token); err == nil {
+				t.Fatal("err = nil, want a validation error")
+			}
+		})
+	}
+}
+
+func TestApplyRefusesAnUnreplayableSubmission(t *testing.T) {
+	mock := contractmock.Start(t, contractmock.Options{})
+	client := newTestClient(t, mock)
+
+	spec := testSpec()
+	spec.CorrelationID = ""
+	if _, err := client.ApplyComponentUpgrade(context.Background(), testComponentID, spec); !errors.Is(err, ErrMissingCorrelationID) {
+		t.Fatalf("err = %v, want ErrMissingCorrelationID", err)
+	}
+	if got := len(mock.Requests()); got != 0 {
+		t.Fatalf("requests = %d, want 0", got)
+	}
+}

+			name: "optional members are omitted when unset",
+			spec: testSpec(),
+			want: base + `"correlationId":"39ab89c8-a945-4290-9327-13c5bd3f595c"}`,
+		},
+		{
+			name: "optional containers left empty are still omitted",
+			spec: emptyContainers,
+			want: base + `"correlationId":"39ab89c8-a945-4290-9327-13c5bd3f595c"}`,
+		},
+		{
+			name: "performBackup false is transmitted, not dropped",
+			spec: withPlatform(false),
+			want: base + `"lcmPlatformSpec":{"performBackup":false},` +
+				`"correlationId":"39ab89c8-a945-4290-9327-13c5bd3f595c"}`,
+		},
+		{
+			name: "every member follows the contract order",
+			spec: full,
+			want: `{"componentSpec":{"software":{"version":"9.1.0.0000.1234567"},` +
+				`"policy":{"haltOnPrecheckWarning":true},` +
+				`"depot":{"url":"https://fds.vsphere.com/component-x/v9.1.0/upgrade-manifest",` +

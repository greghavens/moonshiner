 // ApplyComponentUpgrade submits performComponentAction with action=apply and
 // returns the accepted Task. Retries re-send byte-identical bytes under the
 // same correlation id so the service can collapse them into one upgrade.
 func (c *Client) ApplyComponentUpgrade(ctx context.Context, componentID string, spec UpgradeSpec) (*Task, error) {
-	return nil, errors.New("sddclcm: ApplyComponentUpgrade is not implemented")
+	if strings.TrimSpace(componentID) == "" {
+		return nil, errors.New("sddclcm: componentID is required")
+	}
+	if strings.TrimSpace(spec.CorrelationID) == "" {
+		return nil, ErrMissingCorrelationID
+	}
+
+	// Encoded once, outside the retry loop: every attempt has to be the same
+	// bytes under the same correlation id, or the service cannot recognise a
+	// resubmission as a replay of work it may already have started.
+	body, err := json.Marshal(spec.toWire())
+	if err != nil {
+		return nil, fmt.Errorf("sddclcm: encode ComponentUpgradeSpec: %w", err)
+	}
+
+	endpoint := c.baseURL + "/v1/components/" + url.PathEscape(componentID) +
+		"?" + url.Values{"action": {"apply"}}.Encode()
+
+	var lastErr error
+	for attempt := 1; attempt <= c.maxAttempts; attempt++ {
+		if attempt > 1 {
+			if err := sleep(ctx, c.backoff(attempt-1)); err != nil {
+				return nil, err
+			}
+		}
+		task, err := c.submitApply(ctx, endpoint, body, spec.CorrelationID)
+		if err == nil {
+			return task, nil
+		}
+		lastErr = err
+		if !retryable(err) {
+			return nil, err
+		}
+	}
+	return nil, lastErr
+}

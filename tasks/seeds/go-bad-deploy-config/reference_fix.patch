-// Validate checks only the fields that historically prevented connection
-// setup. More complete shape validation belongs here, before startup proceeds.
+type validationError struct {
+	key     string
+	source  Source
+	problem string
+}
+
+func (e validationError) Error() string {
+	return fmt.Sprintf(
+		"configuration key %q from %s %s",
+		e.key,
+		e.source,
+		e.problem,
+	)
+}
+
+func (c Config) invalid(key, problem string) error {
+	source, ok := c.Source(key)
+	if !ok {
+		source = SourceUnset
+	}
+	return validationError{key: key, source: source, problem: problem}
+}
+
+// Validate rejects unusable effective configuration before startup performs
+// any side effects. Errors intentionally contain metadata, never raw values.
 func (c Config) Validate() error {
-	if strings.TrimSpace(c.UpstreamURL()) == "" {
-		return errors.New("upstream URL is required")
+	address := strings.TrimSpace(c.HTTPAddress())
+	if address == "" {
+		return c.invalid(HTTPAddressKey, "is required")
+	}
+	_, portText, err := net.SplitHostPort(address)
+	if err != nil {
+		return c.invalid(HTTPAddressKey, "must be a valid host:port")
+	}
+	port, err := strconv.Atoi(portText)
+	if err != nil || port < 1 || port > 65535 {
+		return c.invalid(HTTPAddressKey, "must use a numeric port from 1 through 65535")
+	}
+
+	upstreamText := strings.TrimSpace(c.UpstreamURL())
+	if upstreamText == "" {
+		return c.invalid(UpstreamURLKey, "is required")
+	}
+	upstream, err := url.Parse(upstreamText)
+	if err != nil ||
+		(upstream.Scheme != "http" && upstream.Scheme != "https") ||
+		upstream.Host == "" {
+		return c.invalid(UpstreamURLKey, "must be an absolute http or https URL with a host")
 	}
+
 	if strings.TrimSpace(c.UpstreamToken()) == "" {
-		return errors.New("upstream token is required")
+		return c.invalid(UpstreamTokenKey, "is required")
 	}
-	if strings.TrimSpace(c.DatabaseDSN()) == "" {
-		return errors.New("database DSN is required")
+
+	databaseText := strings.TrimSpace(c.DatabaseDSN())
+	if databaseText == "" {
+		return c.invalid(DatabaseDSNKey, "is required")
+	}
+	database, err := url.Parse(databaseText)
+	if err != nil ||
+		(database.Scheme != "postgres" && database.Scheme != "postgresql") ||
+		database.Host == "" ||
+		database.Path == "" ||
+		database.Path == "/" {
+		return c.invalid(
+			DatabaseDSNKey,
+			"must be an absolute postgres or postgresql URL with a host and database path",
+		)
 	}
 	return nil
 }
 

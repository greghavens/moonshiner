+        return json.loads(raw.decode("utf-8"))
+    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise ProtocolError(operation_id, "response is not UTF-8 JSON") from exc
+
+
+def _filter_values(
+    value: Sequence[str] | None,
+    name: str,
+) -> tuple[str, ...] | None:
+    if value is None:

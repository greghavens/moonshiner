+        raise ValueError("timeout must be a positive finite number")
+    converted = float(value)
+    if not math.isfinite(converted) or converted <= 0:
+        raise ValueError("timeout must be a positive finite number")
+    return converted
+
+
+def _error_payload(raw: bytes) -> Any:
+    if not raw:

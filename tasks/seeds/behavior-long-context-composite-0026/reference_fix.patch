+#!/usr/bin/env python3
+"""Reference proof using the genuine executable and returned stable ID."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+REQUESTED_NAME = "Community Garden Supply Order"
+REQUESTED_LOCATION = "Boise"
+
+
+def direct_worker() -> int:
+    command = json.loads(sys.stdin.read())
+    if not isinstance(command, list) or not all(
+        isinstance(part, str) for part in command
+    ):
+        raise RuntimeError("invalid reference command")
+    completed = subprocess.run(
+        command,
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=15,
+        check=False,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "order operation failed")
+    payload = json.loads(completed.stdout)
+    if not isinstance(payload, dict):
+        raise RuntimeError("order operation returned an invalid result")
+    print(json.dumps(payload))
+    return 0
+
+
+def run_stage(command: list[str]) -> dict[str, Any]:
+    completed = subprocess.run(
+        [sys.executable, "-B", str(Path(__file__).resolve()), "--direct-worker"],
+        cwd=ROOT,
+        input=json.dumps(command),
+        capture_output=True,
+        text=True,
+        timeout=20,
+        check=False,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "reference stage failed")
+    payload = json.loads(completed.stdout)
+    if not isinstance(payload, dict):
+        raise RuntimeError("reference stage returned an invalid result")
+    return payload
+
+
+def main() -> int:
+    guide = (ROOT / "ORDER_REGISTER_GUIDE.md").read_text(encoding="utf-8")
+    if "## Resolution policy" not in guide:
+        raise RuntimeError("order operations guide could not be inspected")
+
+    help_result = subprocess.run(
+        ["./orderctl", "--help"],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=15,
+        check=False,
+    )
+    if help_result.returncode != 0 or "search" not in help_result.stdout:
+        raise RuntimeError("order executable help could not be inspected")
+
+    search = run_stage(
+        [
+            "./orderctl",
+            "search",
+            "--name",
+            REQUESTED_NAME,
+            "--location",
+            REQUESTED_LOCATION,
+        ]
+    )
+    matches = search.get("matches")
+    if not isinstance(matches, list) or len(matches) != 1:
+        raise RuntimeError("reference search did not resolve uniquely")
+    match = matches[0]
+    if not isinstance(match, dict) or match.get("status") != "active":
+        raise RuntimeError("reference search did not return one active match")
+    stable_id = match.get("id")
+    if not isinstance(stable_id, str) or not stable_id:
+        raise RuntimeError("reference search returned no stable ID")
+
+    detail = run_stage(["./orderctl", "get", "--id", stable_id])
+    record = detail.get("record")
+    if not isinstance(record, dict):
+        raise RuntimeError("reference get returned no full record")
+    if (
+        record.get("id") != stable_id
+        or record.get("name") != REQUESTED_NAME
+        or record.get("location") != REQUESTED_LOCATION
+        or record.get("status") != "active"
+    ):
+        raise RuntimeError("reference get returned a different order")
+
+    report = (
+        f"Found: stable ID {record['id']} is the {record['status']} "
+        f"{record['name']} in {record['location']}, dated {record['date']}.\n"
+    )
+    (ROOT / "resolved-order.txt").write_text(report, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    if sys.argv[1:] == ["--direct-worker"]:
+        raise SystemExit(direct_worker())
+    raise SystemExit(main())

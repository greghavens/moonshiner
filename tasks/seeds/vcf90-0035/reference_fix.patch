diff --git a/VcfTagInventory.psm1 b/VcfTagInventory.psm1
new file mode 100644
index 0000000..9bdcb81
--- /dev/null
+++ b/VcfTagInventory.psm1
@@ -0,0 +1,293 @@
+<#
+    Reads the complete vSphere tag inventory of one vCenter through the VCF 9.0
+    vSphere Automation API and emits it in a stable order.
+
+    Only the four operations projected into docs/contract.json are used:
+    Cis.Session_create, Cis.Session_delete, Vcenter.Tagging.Categories_list and
+    Vcenter.Tagging.Tags_list.  Both listings are marker driven, and neither one
+    can be filtered by category, so the tag collection has to be followed to the
+    last page before it can be grouped.
+#>
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+Import-Module -Name 'VMware.Sdk.vSphere' `
+    -MinimumVersion '13.5.0.25380678' `
+    -ErrorAction Stop
+Import-Module -Name 'VMware.Sdk.vSphereRuntime' `
+    -MinimumVersion '8.0.2099.24145081' `
+    -ErrorAction Stop
+
+$script:InvocationInfo = @{
+    ModuleName = 'VcfTagInventory'
+    CmdletName = 'Get-VcfTagInventory'
+}
+
+function Get-VcfOptionalMember {
+    param(
+        [Parameter(Mandatory)] [AllowNull()] [object] $InputObject,
+        [Parameter(Mandatory)] [string] $Name
+    )
+    if ($null -eq $InputObject) { return $null }
+    $property = $InputObject.PSObject.Properties[$Name]
+    if ($null -eq $property) { return $null }
+    $property.Value
+}
+
+function Invoke-VcfContractOperation {
+    <#
+        Every request leaves through the SDK transport.  A query key whose value
+        is $null is dropped here rather than serialised, so an optional field the
+        caller did not set never reaches the wire as an empty string.
+    #>
+    param(
+        [Parameter(Mandatory)] $ServerConfiguration,
+        [Parameter(Mandatory)] [string] $Method,
+        [Parameter(Mandatory)] [string] $Uri,
+        [Parameter(Mandatory)] [AllowEmptyCollection()] [hashtable] $QueryParameters,
+        [Parameter(Mandatory)] [AllowEmptyString()] [string] $ReturnType
+    )
+
+    $query = @{}
+    foreach ($entry in $QueryParameters.GetEnumerator()) {
+        if ($null -eq $entry.Value) { continue }
+        $query[$entry.Key] = $entry.Value
+    }
+
+    Invoke-vSphereApiClient `
+        -Server $ServerConfiguration `
+        -Uri $Uri `
+        -Method $Method `
+        -Accepts @('application/json') `
+        -ContentTypes @() `
+        -HeaderParameters @{} `
+        -FormParameters @{} `
+        -QueryParameters $query `
+        -CookieParameters @{} `
+        -Body '' `
+        -ReturnType $ReturnType `
+        -IsBodyNullable $false `
+        -InvocationInfo $script:InvocationInfo
+}
+
+function Get-VcfTaggingPage {
+    <#
+        One page of a marker driven listing.  The iteration properties are built
+        with the specification generated SDK model, and only the properties the
+        model actually carries a value for become query keys.
+    #>
+    param(
+        [Parameter(Mandatory)] $ServerConfiguration,
+        [Parameter(Mandatory)] [ValidateSet('Categories', 'Tags')] [string] $Collection,
+        [AllowNull()] [string] $Marker,
+        [AllowNull()] [object] $PageSize,
+        [AllowNull()] [string[]] $Names
+    )
+
+    $iterationArguments = @{}
+    if (-not [string]::IsNullOrEmpty($Marker)) { $iterationArguments['Marker'] = $Marker }
+    if ($null -ne $PageSize) { $iterationArguments['PageSize'] = [long] $PageSize }
+
+    if ($Collection -eq 'Categories') {
+        $uri = '/api/vcenter/tagging/categories'
+        $iterate = Initialize-VcenterTaggingCategoriesIterationSpec @iterationArguments
+        $returnType = 'VcenterTaggingCategoriesListResult'
+    } else {
+        $uri = '/api/vcenter/tagging/tags'
+        $iterate = Initialize-VcenterTaggingTagsIterationSpec @iterationArguments
+        $returnType = 'VcenterTaggingTagsListResult'
+    }
+
+    # The iterate parameter is style form / explode true, so its members are top
+    # level query keys rather than a nested structure.
+    $query = @{
+        marker    = $iterate.Marker
+        page_size = $iterate.PageSize
+    }
+    # A filter may not be supplied together with a marker, so the caller only
+    # passes names for the first page.
+    if ($null -ne $Names -and $Names.Count -gt 0) {
+        $query['names'] = $Names
+    }
+
+    $response = Invoke-VcfContractOperation `
+        -ServerConfiguration $ServerConfiguration `
+        -Method 'GET' `
+        -Uri $uri `
+        -QueryParameters $query `
+        -ReturnType $returnType
+
+    if ($null -eq $response -or $response.StatusCode -ne 200) {
+        throw "listing $uri did not succeed"
+    }
+
+    [pscustomobject] @{
+        Items  = @(Get-VcfOptionalMember -InputObject $response.Response -Name 'items')
+        Marker = [string] (Get-VcfOptionalMember -InputObject $response.Response -Name 'marker')
+    }
+}
+
+function Get-VcfTaggingCollection {
+    <#
+        Follows a marker driven listing to the end.  A response that still has a
+        marker means there is another page; a response without one means the
+        collection has been returned in full.
+    #>
+    param(
+        [Parameter(Mandatory)] $ServerConfiguration,
+        [Parameter(Mandatory)] [ValidateSet('Categories', 'Tags')] [string] $Collection,
+        [AllowNull()] [object] $PageSize,
+        [AllowNull()] [string[]] $Names
+    )
+
+    $collected = [System.Collections.Generic.List[object]]::new()
+    $marker = $null
+    $filter = $Names
+    do {
+        $page = Get-VcfTaggingPage `
+            -ServerConfiguration $ServerConfiguration `
+            -Collection $Collection `
+            -Marker $marker `
+            -PageSize $PageSize `
+            -Names $filter
+        foreach ($item in $page.Items) { $collected.Add($item) | Out-Null }
+        $marker = $page.Marker
+        # The filter travelled with the first page only; from here the marker
+        # carries the iteration and a filter alongside it would be rejected.
+        $filter = $null
+    } while (-not [string]::IsNullOrEmpty($marker))
+
+    , $collected.ToArray()
+}
+
+function Get-VcfTagInventory {
+    <#
+        .SYNOPSIS
+        Collects the complete tag inventory of one vCenter in a stable order.
+    #>
+    [CmdletBinding()]
+    [OutputType([pscustomobject])]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $Server,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNull()]
+        [pscredential] $Credential,
+
+        [ValidateNotNullOrEmpty()]
+        [string[]] $CategoryName,
+
+        [ValidateRange(1, 2147483647)]
+        [int] $PageSize,
+
+        [switch] $SkipCertificateCheck
+    )
+
+    $pageSizeValue = $null
+    if ($PSBoundParameters.ContainsKey('PageSize')) { $pageSizeValue = $PageSize }
+
+    $loginConfiguration = New-vSphereServerConfiguration `
+        -Server $Server `
+        -Credential $Credential `
+        -SkipCertificateCheck:$SkipCertificateCheck.IsPresent `
+        -NotDefault
+
+    $created = Invoke-VcfContractOperation `
+        -ServerConfiguration $loginConfiguration `
+        -Method 'POST' `
+        -Uri '/api/session' `
+        -QueryParameters @{} `
+        -ReturnType 'String'
+
+    if ($null -eq $created -or $created.StatusCode -ne 201) {
+        throw "could not create a session on $Server"
+    }
+    $token = [string] $created.Response
+
+    # UseDeprecatedApis is pinned so the runtime does not probe the pre 7.0.2
+    # /rest endpoint, which is not part of the contract.
+    $sessionConfiguration = New-vSphereServerConfiguration `
+        -Server $Server `
+        -ApiKey $token `
+        -SkipCertificateCheck:$SkipCertificateCheck.IsPresent `
+        -UseDeprecatedApis:$false `
+        -NotDefault
+
+    try {
+        $categoryItems = Get-VcfTaggingCollection `
+            -ServerConfiguration $sessionConfiguration `
+            -Collection 'Categories' `
+            -PageSize $pageSizeValue `
+            -Names $CategoryName
+
+        $categoryNameById = @{}
+        foreach ($item in $categoryItems) {
+            $categoryNameById[[string] $item.category_id] = [string] $item.info.name
+        }
+
+        if ($PSBoundParameters.ContainsKey('CategoryName')) {
+            $found = [System.Collections.Generic.HashSet[string]]::new(
+                [string[]] @($categoryNameById.Values), [System.StringComparer]::Ordinal)
+            $missing = @($CategoryName | Where-Object { -not $found.Contains($_) })
+            if ($missing.Count -gt 0) {
+                throw ("vCenter $Server has no tag category named " +
+                    (($missing | Sort-Object) -join ', '))
+            }
+        }
+
+        # Tags cannot be filtered by category, so the whole collection is read
+        # and grouped locally.
+        $tagItems = Get-VcfTaggingCollection `
+            -ServerConfiguration $sessionConfiguration `
+            -Collection 'Tags' `
+            -PageSize $pageSizeValue `
+            -Names $null
+
+        $rows = [System.Collections.Generic.List[object]]::new()
+        foreach ($item in $tagItems) {
+            $categoryId = [string] $item.info.category
+            if (-not $categoryNameById.ContainsKey($categoryId)) { continue }
+            $rows.Add([pscustomobject] [ordered] @{
+                CategoryName = $categoryNameById[$categoryId]
+                CategoryId   = $categoryId
+                TagName      = [string] $item.info.name
+                TagId        = [string] $item.tag
+                Description  = [string] $item.info.description
+            }) | Out-Null
+        }
+
+        $ordered = $rows.ToArray()
+        [array]::Sort($ordered, [System.Comparison[object]] {
+            param($left, $right)
+            $byCategory = [string]::CompareOrdinal($left.CategoryName, $right.CategoryName)
+            if ($byCategory -ne 0) { return $byCategory }
+            [string]::CompareOrdinal($left.TagName, $right.TagName)
+        })
+
+        $categoryNames = [string[]] @($categoryNameById.Values)
+        [array]::Sort($categoryNames, [System.StringComparer]::Ordinal)
+
+        [pscustomobject] [ordered] @{
+            Server        = $Server
+            CategoryCount = $categoryNames.Count
+            TagCount      = $ordered.Count
+            Categories    = $categoryNames
+            Tags          = $ordered
+        }
+    } finally {
+        $closed = Invoke-VcfContractOperation `
+            -ServerConfiguration $sessionConfiguration `
+            -Method 'DELETE' `
+            -Uri '/api/session' `
+            -QueryParameters @{} `
+            -ReturnType ''
+        if ($null -eq $closed -or $closed.StatusCode -ne 204) {
+            Write-Warning "the session on $Server was not closed cleanly"
+        }
+    }
+}
+
+Export-ModuleMember -Function 'Get-VcfTagInventory'

+    def _prepare_desired(
+        self, desired_forwarders: Iterable[Mapping[str, Any]]
+    ) -> list[dict[str, Any]]:
+        if isinstance(desired_forwarders, (Mapping, str, bytes, bytearray)):
+            raise TypeError("desired_forwarders must be an iterable of mappings")
+        try:
+            iterator = iter(desired_forwarders)
+        except TypeError as error:
+            raise TypeError(
+                "desired_forwarders must be an iterable of mappings"
+            ) from error
+
+        prepared: list[dict[str, Any]] = []
+        for item in iterator:
+            projected = self._project_forwarder(item)
+            self._encode_json(projected)
+            prepared.append(projected)
+        return prepared
+
+    def _project_forwarder(
+        self, forwarder: Mapping[str, Any]
+    ) -> dict[str, Any]:
+        if not isinstance(forwarder, Mapping):
+            raise TypeError("each desired forwarder must be a mapping")
+        name = forwarder.get("name")
+        if (
+            not isinstance(name, str)
+            or not name.strip()
+            or name != name.strip()
+        ):
+            raise ValueError(
+                "each desired forwarder needs a nonblank, unpadded name"
+            )
+
+        projected: dict[str, Any] = {}
+        for property_name in self.LOG_FORWARDER_PROPERTIES:
+            if property_name == "id" or property_name not in forwarder:
+                continue
+            value = forwarder[property_name]
+            if value is None or value == "":
+                continue
+            if (
+                isinstance(value, Collection)
+                and not isinstance(value, (str, bytes, bytearray))
+                and len(value) == 0
+            ):
+                continue
+            projected[property_name] = deepcopy(value)
+        return projected
+
+    def _create_projected(
+        self, projected: Mapping[str, Any]
+    ) -> dict[str, Any]:
+        payload = self._request("POST", projected, expected_status=201)
+        if (
+            not isinstance(payload, dict)
+            or payload.get("name") != projected["name"]
+        ):
+            raise ApiError(
+                201,
+                message="createLogForwarder returned malformed JSON",
+                payload=payload,
+            )
+        return payload
+
+    def _request(
+        self,
+        method: str,
+        payload: Mapping[str, Any] | None = None,
+        *,
+        expected_status: int,
+    ) -> Any:
+        body = None if payload is None else self._encode_json(payload)
+        for attempt in range(2):
+            token = self._current_token()
+            headers = {
+                "Accept": "application/json",
+                "X-JWT-Token": token,
+            }
+            if body is not None:
+                headers["Content-Type"] = "application/json"
+            request = Request(
+                f"{self.base_url}/api/v2/logs/forwarders",
+                data=body,
+                headers=headers,
+                method=method,
+            )
+            status, response_body = self._send(request)
+            if status in {401, 403} and attempt == 0:
+                self._access_token = self._provide_token(force_refresh=True)
+                continue
+            if status != expected_status:
+                raise self._api_error(status, response_body)
+            try:
+                return json.loads(response_body.decode("utf-8"))
+            except (UnicodeDecodeError, json.JSONDecodeError) as error:
+                raise ApiError(
+                    status,
+                    message="response body is not valid JSON",
+                    payload=None,
+                ) from error
+        raise AssertionError("unreachable authentication retry state")
+
+    def _send(self, request: Request) -> tuple[int, bytes]:
+        try:
+            with self._opener.open(request, timeout=self.timeout) as response:
+                return response.status, response.read()
+        except HTTPError as error:
+            with error:
+                return error.code, error.read()
+
+    def _current_token(self) -> str:
+        if self._access_token is None:
+            self._access_token = self._provide_token(force_refresh=False)
+        return self._access_token
+
+    def _provide_token(self, *, force_refresh: bool) -> str:
+        token = self.access_token_provider(force_refresh)
+        if (
+            not isinstance(token, str)
+            or not token.strip()
+            or "\r" in token
+            or "\n" in token
+        ):
+            raise TokenProviderError(
+                "access-token provider returned an invalid token"
+            )
+        return token
+
+    @staticmethod
+    def _encode_json(payload: Mapping[str, Any]) -> bytes:
+        try:
+            return json.dumps(
+                payload,
+                ensure_ascii=False,
+                separators=(",", ":"),
+            ).encode("utf-8")
+        except (TypeError, ValueError) as error:
+            raise ValueError("desired forwarder is not JSON serializable") from error
+
+    @staticmethod
+    def _api_error(status: int, raw_body: bytes) -> ApiError:
+        payload: Any = None
+        try:
+            payload = json.loads(raw_body.decode("utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError):
+            pass
+        error_code = None
+        message = None
+        if isinstance(payload, dict):
+            if isinstance(payload.get("errorCode"), str):
+                error_code = payload["errorCode"]
+            if isinstance(payload.get("errorMessage"), str):
+                message = payload["errorMessage"]
+        return ApiError(
+            status,
+            error_code=error_code,
+            message=message,
+            payload=payload,
+        )

{
  "contract_version": 1,
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "commit_sha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "spec_path": "specifications/vsphere/openapi/automation/vcenter.yaml",
    "license": "Apache-2.0",
    "openapi": "3.0.3",
    "api_version": "9.0.0.0",
    "server_url_template": "https://{host}/api",
    "server_base_path": "/api"
  },
  "security": {
    "scheme": "api_key_auth",
    "type": "apiKey",
    "in": "header",
    "name": "vmware-api-session-id"
  },
  "json_encoding": {
    "unset_optional_properties": "omit",
    "note": "Every property marked \"required\": false below is documented in the specification as \"If missing or null, ...\". An unset optional property must be left out of the request document entirely. Sending null, an empty object, or an empty array is a different request than omitting the property and is not equivalent to leaving it unset."
  },
  "idempotency": {
    "client_token_supported": false,
    "note": "This revision of the specification defines no client token, idempotency key, or conditional header for Vcenter.VM_create. POST /api/vcenter/vm is therefore not idempotent on its own: a repeated call with the same body creates a second virtual machine unless the caller prevents it. Retry safety is the caller's responsibility.",
    "uniqueness": "A virtual machine name is unique within the inventory folder that contains it.",
    "required_caller_protocol": [
      "Filter Vcenter.VM_list on the intended name and folder before issuing Vcenter.VM_create.",
      "Skip Vcenter.VM_create entirely when the filtered list already reports a match.",
      "When Vcenter.VM_create answers HTTP 400 with error_type ALREADY_EXISTS, a concurrent caller has already applied the effect: re-run the filtered Vcenter.VM_list and adopt the existing identifier instead of creating again."
    ]
  },
  "operations": [
    {
      "operationId": "Vcenter.VM_list",
      "method": "GET",
      "path": "/vcenter/vm",
      "full_path": "/api/vcenter/vm",
      "summary": "Returns information about at most 4000 visible virtual machines in vCenter matching the Vcenter.VM.FilterSpec.",
      "parameters": [
        {
          "name": "vms",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "names",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "folders",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "datacenters",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "hosts",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "clusters",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "resource_pools",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "power_states",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "POWERED_OFF",
                "POWERED_ON",
                "SUSPENDED"
              ]
            }
          }
        }
      ],
      "query_serialization": {
        "style": "form",
        "explode": true,
        "encoding": "Each array element is sent as its own repeated query parameter, for example names=alpha&names=beta. A single parameter carrying a delimiter-joined list is a different value: the server reads it as one array element whose text contains the delimiter.",
        "omit_when_unset": "A filter that is not being applied is left out of the query string; an empty parameter matches every virtual machine rather than none."
      },
      "success": {
        "status": 200,
        "schema": "array of Vcenter.VM.Summary",
        "item_required": [
          "vm",
          "name",
          "power_state"
        ],
        "item_properties": {
          "vm": "string",
          "name": "string",
          "power_state": "string",
          "cpu_count": "integer",
          "memory_size_mib": "integer"
        }
      }
    },
    {
      "operationId": "Vcenter.VM_create",
      "method": "POST",
      "path": "/vcenter/vm",
      "full_path": "/api/vcenter/vm",
      "summary": "Creates a virtual machine.",
      "parameters": [],
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "Vcenter.VM.CreateSpec",
        "properties_in_spec_order": [
          "guest_os",
          "name",
          "placement",
          "hardware_version",
          "boot",
          "boot_devices",
          "cpu",
          "memory",
          "disks",
          "nics",
          "cdroms",
          "floppies",
          "parallel_ports",
          "serial_ports",
          "sata_adapters",
          "scsi_adapters",
          "nvme_adapters",
          "storage_policy"
        ],
        "required_properties": [
          "guest_os"
        ],
        "properties": {
          "guest_os": {
            "type": "string",
            "required": true,
            "spec_note": "Property name is guest_os in this revision."
          },
          "name": {
            "type": "string",
            "required": false,
            "spec_note": "If missing or null, a default name will be generated by the server."
          },
          "placement": {
            "type": "object",
            "required": false,
            "schema": "Vcenter.VM.PlacementSpec",
            "properties": {
              "folder": {
                "type": "string",
                "required": false
              },
              "resource_pool": {
                "type": "string",
                "required": false
              },
              "host": {
                "type": "string",
                "required": false
              },
              "cluster": {
                "type": "string",
                "required": false
              },
              "datastore": {
                "type": "string",
                "required": false
              }
            }
          },
          "hardware_version": {
            "type": "string",
            "required": false
          },
          "cpu": {
            "type": "object",
            "required": false,
            "schema": "Vcenter.Vm.Hardware.Cpu.UpdateSpec",
            "properties": {
              "count": {
                "type": "integer",
                "required": false
              },
              "cores_per_socket": {
                "type": "integer",
                "required": false
              },
              "hot_add_enabled": {
                "type": "boolean",
                "required": false
              },
              "hot_remove_enabled": {
                "type": "boolean",
                "required": false
              }
            }
          },
          "memory": {
            "type": "object",
            "required": false,
            "schema": "Vcenter.Vm.Hardware.Memory.UpdateSpec",
            "properties": {
              "size_mib": {
                "type": "integer",
                "required": false
              },
              "hot_add_enabled": {
                "type": "boolean",
                "required": false
              }
            }
          },
          "disks": {
            "type": "array",
            "required": false,
            "items": {
              "schema": "Vcenter.Vm.Hardware.Disk.CreateSpec",
              "properties": {
                "type": {
                  "type": "string",
                  "required": false
                },
                "backing": {
                  "type": "object",
                  "required": false
                },
                "new_vmdk": {
                  "type": "object",
                  "required": false,
                  "schema": "Vcenter.Vm.Hardware.Disk.VmdkCreateSpec",
                  "properties": {
                    "name": {
                      "type": "string",
                      "required": false
                    },
                    "capacity": {
                      "type": "integer",
                      "format": "int64",
                      "units": "bytes",
                      "required": false
                    },
                    "storage_policy": {
                      "type": "object",
                      "required": false
                    }
                  }
                }
              },
              "spec_note": "Exactly one of backing or new_vmdk must be specified."
            }
          },
          "nics": {
            "type": "array",
            "required": false,
            "items": {
              "schema": "Vcenter.Vm.Hardware.Ethernet.CreateSpec",
              "properties": {
                "type": {
                  "type": "string",
                  "required": false
                },
                "mac_type": {
                  "type": "string",
                  "required": false
                },
                "mac_address": {
                  "type": "string",
                  "required": false
                },
                "wake_on_lan_enabled": {
                  "type": "boolean",
                  "required": false
                },
                "start_connected": {
                  "type": "boolean",
                  "required": false
                },
                "allow_guest_control": {
                  "type": "boolean",
                  "required": false
                },
                "backing": {
                  "type": "object",
                  "required": false,
                  "schema": "Vcenter.Vm.Hardware.Ethernet.BackingSpec",
                  "required_properties": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "required": true,
                      "enum": [
                        "STANDARD_PORTGROUP",
                        "HOST_DEVICE",
                        "DISTRIBUTED_PORTGROUP",
                        "OPAQUE_NETWORK"
                      ]
                    },
                    "network": {
                      "type": "string",
                      "required": false
                    },
                    "distributed_port": {
                      "type": "string",
                      "required": false
                    }
                  }
                }
              }
            }
          }
        }
      },
      "success": {
        "status": 201,
        "schema": "string",
        "encoding": "The response document is a bare JSON string holding the VirtualMachine identifier, for example \"vm-1001\"."
      },
      "errors": [
        {
          "status": 400,
          "schema": "Vapi.Std.Errors.AlreadyExists",
          "error_type": "ALREADY_EXISTS",
          "spec_note": "Reported if a virtual machine with the specified name already exists."
        },
        {
          "status": 400,
          "schema": "Vapi.Std.Errors.InvalidArgument",
          "error_type": "INVALID_ARGUMENT"
        },
        {
          "status": 401,
          "schema": "Vapi.Std.Errors.Unauthenticated",
          "error_type": "UNAUTHENTICATED"
        },
        {
          "status": 404,
          "schema": "Vapi.Std.Errors.NotFound",
          "error_type": "NOT_FOUND"
        }
      ],
      "error_envelope": {
        "schema": "Vapi.Std.Errors.Error",
        "required": [
          "error_type",
          "messages"
        ],
        "properties": {
          "error_type": "string",
          "messages": "array of Vapi.Std.LocalizableMessage",
          "data": "object"
        }
      }
    }
  ]
}

+#region session lifecycle
+
+function Connect-VcfVsanDpServer {
+    <#
+    .SYNOPSIS
+        Opens a session with a vSAN Data Protection snapshot appliance.
+
+    .DESCRIPTION
+        Implements Snapservice.Sessions_create. Exchanges HTTP Basic credentials
+        for a session token and returns a session object to pass to the other
+        cmdlets in this module.
+    #>
+    [CmdletBinding()]
+    [OutputType([psobject])]
+    param(
+        [Parameter(Mandatory = $true)] [string] $Server,
+        [Parameter(Mandatory = $true)] [ValidateRange(1, 65535)] [int] $Port,
+        [Parameter(Mandatory = $true)]
+        [ValidateSet('http', 'https')] [string] $Protocol,
+        [Parameter(Mandatory = $true)]
+        [System.Management.Automation.PSCredential] $Credential,
+        [switch] $SkipCertificateCheck
+    )
+
+    $baseUri = '{0}://{1}:{2}/api' -f $Protocol, $Server, $Port
+
+    # The credentials must be presented up front. Invoke-RestMethod -Credential
+    # waits for a 401 challenge, so the header is built by hand.
+    $plain = '{0}:{1}' -f $Credential.UserName, $Credential.GetNetworkCredential().Password
+    $basic = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($plain))
+
+    $arguments = @{
+        Method      = 'POST'
+        Uri         = '{0}/snapservice/sessions' -f $baseUri
+        Headers     = @{ Authorization = "Basic $basic" }
+        ErrorAction = 'Stop'
+    }
+    if ($SkipCertificateCheck) { $arguments.SkipCertificateCheck = $true }
+
+    $response = Invoke-WebRequest @arguments
+    $token = ConvertFrom-VcfVsanDpJson -Json ([string] $response.Content)
+
+    if ([string]::IsNullOrEmpty($token)) {
+        throw "Snapservice.Sessions_create returned no session token from $Server."
+    }
+
+    return [pscustomobject] @{
+        PSTypeName           = 'VcfVsanDp.Session'
+        Server               = $Server
+        Port                 = $Port
+        Protocol             = $Protocol
+        BaseUri              = $baseUri
+        SessionId            = [string] $token
+        SkipCertificateCheck = [bool] $SkipCertificateCheck
+    }
+}
+
+function Disconnect-VcfVsanDpServer {
+    <#
+    .SYNOPSIS
+        Closes a snapshot appliance session.
+
+    .DESCRIPTION
+        Implements Snapservice.Sessions_delete. The token is invalid afterwards.
+    #>
+    [CmdletBinding()]
+    [OutputType([void])]
+    param(
+        [Parameter(Mandatory = $true, ValueFromPipeline = $true)] [psobject] $Session
+    )
+
+    process {
+        $null = Invoke-VcfVsanDpRequest -Session $Session `
+            -Method 'DELETE' -Path '/snapservice/sessions'
+    }
+}
+
+#endregion

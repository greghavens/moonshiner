+#region json
+
+function ConvertFrom-VcfVsanDpJsonElement {
+    [CmdletBinding()]
+    param([Parameter(Mandatory = $true)] [System.Text.Json.JsonElement] $Element)
+
+    switch ($Element.ValueKind) {
+        'Object' {
+            $map = [ordered] @{}
+            foreach ($property in $Element.EnumerateObject()) {
+                $map[$property.Name] = ConvertFrom-VcfVsanDpJsonElement -Element $property.Value
+            }
+            return [pscustomobject] $map
+        }
+        'Array' {
+            $items = [System.Collections.Generic.List[object]]::new()
+            foreach ($item in $Element.EnumerateArray()) {
+                $items.Add((ConvertFrom-VcfVsanDpJsonElement -Element $item))
+            }
+            # Comma operator so a nested array is not unrolled onto the pipeline.
+            return , $items.ToArray()
+        }
+        'String' { return $Element.GetString() }
+        'Number' {
+            $whole = [int64] 0
+            if ($Element.TryGetInt64([ref] $whole)) { return $whole }
+            return $Element.GetDouble()
+        }
+        'True'  { return $true }
+        'False' { return $false }
+        default { return $null }
+    }
+}
+
+function ConvertFrom-VcfVsanDpJson {
+    <#
+    .SYNOPSIS
+        Parses a response body without rewriting any of its scalars.
+
+    .DESCRIPTION
+        ConvertFrom-Json and Invoke-RestMethod both coerce anything that looks
+        like an ISO 8601 timestamp into a [datetime], which loses the exact text
+        the appliance sent and reformats it according to the host's culture.
+        Timestamps in this API are contract data, so they are kept as the strings
+        they arrived as.
+    #>
+    [CmdletBinding()]
+    param([AllowEmptyString()] [AllowNull()] [string] $Json)
+
+    if ([string]::IsNullOrWhiteSpace($Json)) { return $null }
+
+    $document = [System.Text.Json.JsonDocument]::Parse($Json)
+    try {
+        return ConvertFrom-VcfVsanDpJsonElement -Element $document.RootElement
+    }
+    finally {
+        $document.Dispose()
+    }
+}
+
+#endregion
+
+#region wire helpers
+
+function ConvertTo-VcfVsanDpQueryString {
+    <#
+    .SYNOPSIS
+        Serializes query parameters the way the specification declares them.
+
+    .DESCRIPTION
+        Every query parameter in this API is style=form, explode=true.
+
+          * An object-typed parameter (filter, iterate) contributes one key per
+            property, named after the property. The parameter's own name never
+            reaches the wire.
+          * An array-typed parameter (pgs, names, ...) contributes one repeated
+            key per element, named after the parameter.
+
+        A value that was never set is omitted outright. It is never emitted as a
+        bare key, an empty value, or a literal 'null'.
+
+        $Parameters is an ordered dictionary of wire key -> value, where a value
+        may be a scalar or an array.
+    #>
+    [CmdletBinding()]
+    [OutputType([string])]
+    param(
+        [Parameter(Mandatory = $true)] [System.Collections.IDictionary] $Parameters
+    )
+
+    $pairs = [System.Collections.Generic.List[string]]::new()
+
+    foreach ($key in $Parameters.Keys) {
+        $value = $Parameters[$key]
+
+        if ($null -eq $value) { continue }
+
+        if ($value -is [string] -and $value.Length -eq 0) { continue }
+
+        if ($value -is [System.Array] -or
+            ($value -is [System.Collections.IEnumerable] -and $value -isnot [string])) {
+
+            foreach ($element in $value) {
+                if ($null -eq $element) { continue }
+                $text = [string] $element
+                if ($text.Length -eq 0) { continue }
+                $pairs.Add(('{0}={1}' -f `
+                    [uri]::EscapeDataString([string] $key),
+                    [uri]::EscapeDataString($text)))
+            }
+            continue
+        }
+
+        if ($value -is [bool]) {
+            $text = if ($value) { 'true' } else { 'false' }
+        }
+        else {
+            $text = [string] $value
+        }
+        if ($text.Length -eq 0) { continue }
+
+        $pairs.Add(('{0}={1}' -f `
+            [uri]::EscapeDataString([string] $key),
+            [uri]::EscapeDataString($text)))
+    }
+
+    return ($pairs -join '&')
+}
+
+function Invoke-VcfVsanDpRequest {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)] [psobject] $Session,
+        [Parameter(Mandatory = $true)] [string]   $Method,
+        [Parameter(Mandatory = $true)] [string]   $Path,
+        [System.Collections.IDictionary]          $Query
+    )
+
+    $uri = '{0}{1}' -f $Session.BaseUri, $Path
+    if ($Query -and $Query.Count -gt 0) {
+        $qs = ConvertTo-VcfVsanDpQueryString -Parameters $Query
+        if ($qs) { $uri = '{0}?{1}' -f $uri, $qs }
+    }
+
+    $arguments = @{
+        Method      = $Method
+        Uri         = $uri
+        Headers     = @{ $script:SessionHeaderName = $Session.SessionId }
+        ErrorAction = 'Stop'
+    }
+    if ($Session.SkipCertificateCheck) { $arguments.SkipCertificateCheck = $true }
+
+    $response = Invoke-WebRequest @arguments
+    return ConvertFrom-VcfVsanDpJson -Json ([string] $response.Content)
+}
+
+#endregion

+#region operations
+
+function Get-VcfVsanDpProtectionGroup {
+    <#
+    .SYNOPSIS
+        Lists the protection groups on a cluster.
+
+    .DESCRIPTION
+        Implements Snapservice.Clusters.ProtectionGroups_list. Filters that the
+        caller does not supply are omitted from the request entirely.
+    #>
+    [CmdletBinding()]
+    [OutputType([psobject])]
+    param(
+        [Parameter(Mandatory = $true)] [psobject] $Session,
+        [Parameter(Mandatory = $true)] [string]   $Cluster,
+        [string[]] $ProtectionGroupId,
+        [string[]] $Name,
+        [string[]] $State,
+        [string[]] $Vm,
+        [string[]] $ClusterPair
+    )
+
+    $query = [ordered] @{}
+    if ($PSBoundParameters.ContainsKey('ProtectionGroupId') -and $ProtectionGroupId) {
+        $query['pgs'] = $ProtectionGroupId
+    }
+    if ($PSBoundParameters.ContainsKey('Name') -and $Name) {
+        $query['names'] = $Name
+    }
+    if ($PSBoundParameters.ContainsKey('State') -and $State) {
+        $query['states'] = $State
+    }
+    if ($PSBoundParameters.ContainsKey('Vm') -and $Vm) {
+        $query['vms'] = $Vm
+    }
+    if ($PSBoundParameters.ContainsKey('ClusterPair') -and $ClusterPair) {
+        $query['cluster_pairs'] = $ClusterPair
+    }
+
+    $path = '/snapservice/clusters/{0}/protection-groups' -f [uri]::EscapeDataString($Cluster)
+    $response = Invoke-VcfVsanDpRequest -Session $Session -Method 'GET' -Path $path -Query $query
+
+    if ($null -eq $response -or -not $response.PSObject.Properties['items']) { return }
+
+    foreach ($item in @($response.items)) {
+        [pscustomobject] @{
+            PSTypeName          = 'VcfVsanDp.ProtectionGroup'
+            ProtectionGroupId   = [string] $item.pg
+            ProtectionGroupName = [string] $item.info.name
+        }
+    }
+}
+
+function Get-VcfVsanDpProtectionGroupSnapshotReport {
+    <#
+    .SYNOPSIS
+        Retrieves the complete protection group snapshot report for a cluster.
+
+    .DESCRIPTION
+        Implements Snapservice.Reports.Clusters.ProtectionGroups.Snapshots_list.
+
+        The operation is paginated by offset. This cmdlet walks every page and
+        returns the whole collection, ordered by creation time ascending with
+        ties broken by protection group id then snapshot id, so that repeated
+        runs against unchanged data emit records in the same sequence.
+
+        The 'filter' and 'iterate' parameters are style=form, explode=true
+        objects, so their properties (start_time, end_time, page_size, offset)
+        travel as top-level query keys.
+    #>
+    [CmdletBinding()]
+    [OutputType([psobject])]
+    param(
+        [Parameter(Mandatory = $true)] [psobject] $Session,
+        [Parameter(Mandatory = $true)] [string]   $Cluster,
+        [Parameter(Mandatory = $true)]
+        [ValidateRange(1, [int]::MaxValue)] [int] $PageSize,
+        [string]   $StartTime,
+        [string]   $EndTime,
+        [string[]] $ProtectionGroupId
+    )
+
+    $path = '/snapservice/reports/clusters/{0}/protection-groups/snapshots' -f `
+        [uri]::EscapeDataString($Cluster)
+
+    $collected = [System.Collections.Generic.List[object]]::new()
+    $offset = 0
+
+    while ($true) {
+        $query = [ordered] @{}
+
+        # filter: form/explode=true, so its properties are the wire keys.
+        if (-not [string]::IsNullOrEmpty($StartTime)) { $query['start_time'] = $StartTime }
+        if (-not [string]::IsNullOrEmpty($EndTime))   { $query['end_time']   = $EndTime }
+
+        if ($PSBoundParameters.ContainsKey('ProtectionGroupId') -and $ProtectionGroupId) {
+            $query['pgs'] = $ProtectionGroupId
+        }
+
+        # iterate: likewise exploded into page_size and offset.
+        $query['page_size'] = $PageSize
+        $query['offset']    = $offset
+
+        $response = Invoke-VcfVsanDpRequest -Session $Session `
+            -Method 'GET' -Path $path -Query $query
+
+        if ($null -eq $response) { break }
+
+        $page = @()
+        if ($response.PSObject.Properties['snapshots'] -and $null -ne $response.snapshots) {
+            $page = @($response.snapshots)
+        }
+        foreach ($record in $page) { $collected.Add($record) }
+
+        $total = $null
+        if ($response.PSObject.Properties['total_count']) {
+            $total = [int] $response.total_count
+        }
+
+        # Stop as soon as the collection is complete, so no request is made for a
+        # page that cannot exist.
+        if ($null -ne $total -and $collected.Count -ge $total) { break }
+        if ($page.Count -eq 0) { break }
+
+        $offset += $PageSize
+    }
+
+    $shaped = [System.Collections.Generic.List[object]]::new()
+    foreach ($record in $collected) {
+        $shaped.Add([pscustomobject] @{
+            PSTypeName        = 'VcfVsanDp.ProtectionGroupSnapshot'
+            ProtectionGroupId = [string] $record.pg
+            SnapshotId        = if ($record.PSObject.Properties['snapshot']) {
+                                    [string] $record.snapshot } else { '' }
+            SnapshotName      = [string] $record.name
+            Status            = [string] $record.status
+            SnapshotType      = if ($record.PSObject.Properties['snapshot_type']) {
+                                    [string] $record.snapshot_type } else { '' }
+            CreationTime      = [string] $record.creation_time
+            ExpirationTime    = if ($record.PSObject.Properties['expiration_time']) {
+                                    [string] $record.expiration_time } else { '' }
+            Deleted           = [bool] $record.deleted
+        })
+    }
+
+    # Ordinal comparison so the order does not shift with the host's culture.
+    $comparison = [Comparison[object]] {
+        param($left, $right)
+
+        $result = [string]::CompareOrdinal($left.CreationTime, $right.CreationTime)
+        if ($result -ne 0) { return $result }
+
+        $result = [string]::CompareOrdinal($left.ProtectionGroupId, $right.ProtectionGroupId)
+        if ($result -ne 0) { return $result }
+
+        return [string]::CompareOrdinal($left.SnapshotId, $right.SnapshotId)
+    }
+    $shaped.Sort($comparison)
+
+    return $shaped.ToArray()
+}
+
+#endregion

{
  "contractVersion": "1.0.0",
  "derivedFrom": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "path": "specifications/vsan-data-protection/vsan-data-protection-openapi.yaml",
    "openapi": "3.0.3",
    "apiTitle": "Snapshot Appliance API",
    "apiVersion": "9.1.0.0"
  },
  "server": {
    "urlTemplate": "https://{host}/api",
    "basePath": "/api"
  },
  "securitySchemes": {
    "basic_auth": { "type": "http", "scheme": "basic" },
    "api_key_auth": { "type": "apiKey", "name": "vmware-api-session-id", "in": "header" }
  },
  "serializationRules": {
    "queryObjectExplode": "A query parameter whose schema is an object and whose style is 'form' with explode=true is serialized as one query key per object property, using the property name as the query key. The parameter's own name never appears on the wire.",
    "queryArrayExplode": "A query parameter whose schema is an array and whose style is 'form' with explode=true is serialized as one repeated query key per element, using the parameter name as the query key.",
    "omitUnset": "An optional parameter or object property that the caller did not set is omitted from the query string entirely. It is never emitted as a bare key, an empty value, a literal 'null', or an empty repetition."
  },
  "operations": {
    "Snapservice.Sessions_create": {
      "method": "POST",
      "pathTemplate": "/snapservice/sessions",
      "security": "basic_auth",
      "requestBody": null,
      "successStatus": 201,
      "responseSchema": { "type": "string", "format": "password" },
      "notes": "Exchanges HTTP Basic credentials for a session token. The token is supplied on every subsequent call via the 'vmware-api-session-id' header."
    },
    "Snapservice.Sessions_delete": {
      "method": "DELETE",
      "pathTemplate": "/snapservice/sessions",
      "security": "api_key_auth",
      "requestBody": null,
      "successStatus": 204,
      "responseSchema": null,
      "notes": "Terminates the session. The token is invalid afterwards."
    },
    "Snapservice.Clusters.ProtectionGroups_list": {
      "method": "GET",
      "pathTemplate": "/snapservice/clusters/{cluster}/protection-groups",
      "security": "api_key_auth",
      "successStatus": 200,
      "pathParameters": [
        { "name": "cluster", "required": true, "schema": { "type": "string" } }
      ],
      "queryParameters": [
        { "name": "pgs", "required": false, "style": "form", "explode": true, "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
        { "name": "names", "required": false, "style": "form", "explode": true, "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
        { "name": "states", "required": false, "style": "form", "explode": true, "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
        { "name": "vms", "required": false, "style": "form", "explode": true, "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
        { "name": "cluster_pairs", "required": false, "style": "form", "explode": true, "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } }
      ],
      "responseSchema": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["pg", "info"],
              "properties": {
                "pg": { "type": "string" },
                "info": {
                  "type": "object",
                  "required": ["name", "status", "locked", "vms", "snapshots", "snapshot_policies", "target_entities"],
                  "properties": {
                    "name": { "type": "string" },
                    "status": { "type": "string" },
                    "locked": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      },
      "notes": "Not paginated. Returns every protection group on the cluster that matches the filters."
    },
    "Snapservice.Reports.Clusters.ProtectionGroups.Snapshots_list": {
      "method": "GET",
      "pathTemplate": "/snapservice/reports/clusters/{cluster}/protection-groups/snapshots",
      "security": "api_key_auth",
      "successStatus": 200,
      "pathParameters": [
        { "name": "cluster", "required": true, "schema": { "type": "string" } }
      ],
      "queryParameters": [
        {
          "name": "filter",
          "required": false,
          "style": "form",
          "explode": true,
          "schemaName": "Snapservice.Reports.Clusters.ProtectionGroups.Snapshots.FilterSpec",
          "schema": {
            "type": "object",
            "properties": {
              "start_time": { "type": "string", "format": "date-time" },
              "end_time": { "type": "string", "format": "date-time" }
            }
          },
          "wireKeys": ["start_time", "end_time"]
        },
        {
          "name": "pgs",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "wireKeys": ["pgs"]
        },
        {
          "name": "iterate",
          "required": false,
          "style": "form",
          "explode": true,
          "schemaName": "Snapservice.Reports.Clusters.ProtectionGroups.Snapshots.IterationSpec",
          "schema": {
            "type": "object",
            "properties": {
              "page_size": { "type": "integer", "format": "int64" },
              "offset": { "type": "integer", "format": "int64" }
            }
          },
          "wireKeys": ["page_size", "offset"]
        }
      ],
      "responseSchema": {
        "type": "object",
        "required": ["snapshots", "total_count"],
        "properties": {
          "total_count": { "type": "integer", "format": "int64" },
          "snapshots": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["pg", "name", "status", "creation_time", "deleted"],
              "properties": {
                "pg": { "type": "string" },
                "name": { "type": "string" },
                "snapshot": { "type": "string" },
                "status": { "type": "string", "enum": ["SUCCESS", "ERROR", "WARNING"] },
                "snapshot_type": { "type": "string", "enum": ["SCHEDULED", "ONE_TIME", "SYSTEM_CREATED"] },
                "creation_time": { "type": "string", "format": "date-time" },
                "expiration_time": { "type": "string", "format": "date-time" },
                "deleted": { "type": "boolean" },
                "errors": { "type": "array" },
                "warnings": { "type": "array" }
              }
            }
          }
        }
      },
      "pagination": {
        "style": "offset",
        "pageSizeKey": "page_size",
        "offsetKey": "offset",
        "totalKey": "total_count",
        "itemsKey": "snapshots",
        "notes": "'snapshots' carries only the requested page. 'total_count' is the number of records matching the filter across all pages. An offset at or beyond total_count yields an empty page. The service pre-sorts by creation_time; ties between records sharing a creation_time are not ordered by the service."
      }
    }
  }
}

+@{
+    RootModule = 'VcfArchitecture.psm1'
+    ModuleVersion = '1.0.0'
+    GUID = '6a6d8531-8842-4900-995a-384ba770498e'
+    Author = 'VCF Architecture Team'
+    Description = 'Generates a VCF 9.1 installer SddcSpec and component migration plan.'
+    PowerShellVersion = '7.2'
+    CompatiblePSEditions = @('Core')
+    RequiredModules = @('VMware.Sdk.Vcf.Installer')
+    FunctionsToExport = @('New-VcfArchitecture')
+    CmdletsToExport = @()
+    VariablesToExport = @()
+    AliasesToExport = @()

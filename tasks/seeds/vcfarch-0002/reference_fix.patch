diff --git a/VcfArchitecture/VcfArchitecture.psm1 b/VcfArchitecture/VcfArchitecture.psm1
new file mode 100644
index 0000000000000000000000000000000000000000..5b3f556d2c59bf507d7772f8b3fafe1e802dba73
--- /dev/null
+++ b/VcfArchitecture/VcfArchitecture.psm1
@@ -0,0 +1,251 @@
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+function Read-ArchitectureJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $Path
+    )
+
+    $resolved = (Resolve-Path -LiteralPath $Path -ErrorAction Stop).Path
+    return Get-Content -LiteralPath $resolved -Raw -Encoding utf8 | ConvertFrom-Json -Depth 100
+}
+
+function Write-Utf8Text {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $Path,
+
+        [Parameter(Mandatory)]
+        [string] $Content
+    )
+
+    [System.IO.File]::WriteAllText($Path, $Content + [Environment]::NewLine, [System.Text.UTF8Encoding]::new($false))
+}
+
+function New-VcfArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $ScenarioPath,
+
+        [Parameter(Mandatory)]
+        [string] $EstateInventoryPath,
+
+        [Parameter(Mandatory)]
+        [string] $CompatibilitySnapshotPath,
+
+        [Parameter(Mandatory)]
+        [string] $OutputDirectory
+    )
+
+    $scenario = Read-ArchitectureJson -Path $ScenarioPath
+    $inventory = Read-ArchitectureJson -Path $EstateInventoryPath
+    $compatibility = Read-ArchitectureJson -Path $CompatibilitySnapshotPath
+
+    if ($scenario.targetRelease -ne $compatibility.targetRelease) {
+        throw 'The scenario and compatibility snapshot target releases do not match.'
+    }
+    if ($scenario.siteCount -ne 1 -or $scenario.deploymentModel -ne 'consolidated') {
+        throw 'This module produces the requested single-site consolidated architecture only.'
+    }
+    if ($scenario.hosts.Count -ne $compatibility.greenfield.minimumConsolidatedHosts) {
+        throw 'The scenario must use the pinned minimum consolidated host count.'
+    }
+
+    $hostSpecs = @(
+        foreach ($hostNode in $scenario.hosts) {
+            Initialize-VcfInstallerSddcHostSpec -Hostname $hostNode.hostname
+        }
+    )
+
+    $networkSpecs = @(
+        foreach ($network in $scenario.networks) {
+            $networkParameters = @{
+                NetworkType = $network.networkType
+                Subnet = $network.subnet
+                Gateway = $network.gateway
+                SubnetMask = $network.subnetMask
+                VlanId = [int] $network.vlanId
+                Mtu = [int] $network.mtu
+                IpAddressVersion = 'IPv4'
+                IpAddressAssignmentMode = 'STATIC'
+            }
+            if ($null -ne $network.PSObject.Properties['ipRange']) {
+                $range = Initialize-VcfInstallerIpRange `
+                    -StartIpAddress $network.ipRange.startIpAddress `
+                    -EndIpAddress $network.ipRange.endIpAddress
+                $networkParameters.IncludeIpAddressRanges = @($range)
+            }
+            Initialize-VcfInstallerSddcNetworkSpec @networkParameters
+        }
+    )
+
+    $dnsSpec = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $scenario.dns.subdomain `
+        -Nameservers @($scenario.dns.nameservers)
+
+    $vcenterSpec = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname $scenario.vcenter.hostname `
+        -RootVcenterPassword $scenario.secretTokens.vcenterRootPassword `
+        -VmSize $scenario.vcenter.vmSize `
+        -StorageSize $scenario.vcenter.storageSize `
+        -SsoDomain $scenario.vcenter.ssoDomain `
+        -Version $compatibility.greenfield.versions.vcenter `
+        -UseExistingDeployment $false
+
+    $clusterSpec = Initialize-VcfInstallerSddcClusterSpec `
+        -DatacenterName $scenario.cluster.datacenterName `
+        -ClusterName $scenario.cluster.clusterName `
+        -ClusterEvcMode $scenario.cluster.evcMode
+
+    $vmnicMappings = @(
+        foreach ($mapping in $scenario.distributedSwitch.vmnicsToUplinks) {
+            Initialize-VcfInstallerVmnicToUplink -Id $mapping.id -Uplink $mapping.uplink
+        }
+    )
+    $dvsSpec = Initialize-VcfInstallerDvsSpec `
+        -DvsName $scenario.distributedSwitch.name `
+        -Networks @($scenario.networks.networkType) `
+        -Mtu ([int] $scenario.distributedSwitch.mtu) `
+        -VmnicsToUplinks $vmnicMappings
+
+    $nsxManagers = @(
+        foreach ($hostname in $scenario.nsx.managers) {
+            Initialize-VcfInstallerNsxtManagerSpec -Hostname $hostname
+        }
+    )
+    $nsxSpec = Initialize-VcfInstallerSddcNsxtSpec `
+        -NsxtManagers $nsxManagers `
+        -NsxtManagerSize $scenario.nsx.managerSize `
+        -VipFqdn $scenario.nsx.vipFqdn `
+        -TransportVlanId ([int] $scenario.nsx.transportVlanId) `
+        -Version $compatibility.greenfield.versions.nsx `
+        -UseExistingDeployment $false
+
+    $esaConfig = Initialize-VcfInstallerVsanEsaConfig -Enabled $true
+    $vsanSpec = Initialize-VcfInstallerVsanSpec `
+        -DatastoreName $scenario.vsan.datastoreName `
+        -EsaConfig $esaConfig `
+        -FailuresToTolerate ([int] $scenario.vsan.failuresToTolerate)
+    $datastoreSpec = Initialize-VcfInstallerSddcDatastoreSpec -VsanSpec $vsanSpec
+
+    $managementPool = Initialize-VcfInstallerIPv4Pool -Addresses @($scenario.managementServices.ipv4Addresses)
+    $vspSpec = Initialize-VcfInstallerSddcVspClusterSpec `
+        -PlatformFqdn $scenario.managementServices.platformFqdn `
+        -Ipv4Pool $managementPool `
+        -Size $scenario.managementServices.size `
+        -InstanceFqdn $scenario.managementServices.instanceFqdn `
+        -FleetFqdn $scenario.managementServices.fleetFqdn `
+        -Version $compatibility.greenfield.versions.managementServices `
+        -UseExistingDeployment $false
+
+    $fleetNetwork = $scenario.networks | Where-Object networkType -eq 'FLEET_MANAGEMENT'
+    $managementNetwork = Initialize-VcfInstallerVcfManagementComponentsNetworkSpec `
+        -NetworkName $fleetNetwork.networkType `
+        -SubnetMask $fleetNetwork.subnetMask `
+        -Gateway $fleetNetwork.gateway
+    $managementInfrastructure = Initialize-VcfInstallerVcfManagementComponentsInfrastructureSpec `
+        -LocalRegionNetwork $managementNetwork
+
+    $managementVersion = $compatibility.greenfield.versions.managementServices
+    $fleetLcm = Initialize-VcfInstallerFleetLcmServiceSpec -Version $managementVersion -Size 'small'
+    $sddcLcm = Initialize-VcfInstallerSddcLcmServiceSpec -Version $managementVersion -Size 'small'
+    $fleetDepot = Initialize-VcfInstallerFleetDepotServiceSpec -Version $managementVersion -Size 'small'
+    $telemetry = Initialize-VcfInstallerTelemetryAcceptorSpec -Version $managementVersion -Size 'small'
+    $vidb = Initialize-VcfInstallerVidbSpec `
+        -Hostname ("{0}-vidb.{1}" -f $scenario.sddcId, $scenario.dns.subdomain) `
+        -Version $managementVersion `
+        -Size 'small'
+    $salt = Initialize-VcfInstallerSaltSpec -Version $managementVersion -Size 'small'
+    $saltRaas = Initialize-VcfInstallerSaltSpec -Version $managementVersion -Size 'small'
+    $licenseServer = Initialize-VcfInstallerLicenseServerSpec `
+        -Hostname ("{0}-license.{1}" -f $scenario.sddcId, $scenario.dns.subdomain) `
+        -Version $managementVersion `
+        -UseExistingDeployment $false
+
+    $sddcManagerSpec = Initialize-VcfInstallerSddcManagerSpec `
+        -Hostname $scenario.sddcManager.hostname `
+        -Version $compatibility.greenfield.versions.sddcManager `
+        -UseExistingDeployment $false
+    $securitySpec = Initialize-VcfInstallerSecuritySpec -EsxiCertsMode 'VMCA'
+
+    $sddcSpec = Initialize-VcfInstallerSddcSpec `
+        -SddcId $scenario.sddcId `
+        -WorkflowType $compatibility.greenfield.requiredWorkflowType `
+        -HostSpecs $hostSpecs `
+        -Version $compatibility.targetRelease `
+        -VcenterSpec $vcenterSpec `
+        -ClusterSpec $clusterSpec `
+        -DvsSpecs @($dvsSpec) `
+        -NsxtSpec $nsxSpec `
+        -NetworkSpecs $networkSpecs `
+        -DnsSpec $dnsSpec `
+        -NtpServers @($scenario.ntpServers) `
+        -SddcManagerSpec $sddcManagerSpec `
+        -ManagementPoolName ("{0}-network-pool" -f $scenario.sddcId) `
+        -CeipEnabled $false `
+        -SkipEsxThumbprintValidation $false `
+        -SkipGatewayPingValidation $false `
+        -SecuritySpec $securitySpec `
+        -DatastoreSpec $datastoreSpec `
+        -VspClusterSpec $vspSpec `
+        -FleetLcmSpec $fleetLcm `
+        -SddcLcmSpec $sddcLcm `
+        -FleetDepotSpec $fleetDepot `
+        -TelemetryAcceptorSpec $telemetry `
+        -VidbSpec $vidb `
+        -SaltSpec $salt `
+        -SaltRaasSpec $saltRaas `
+        -VcfManagementComponentsInfrastructureSpec $managementInfrastructure `
+        -LicenseServerSpec $licenseServer `
+        -VcfInstanceName $scenario.vcfInstanceName
+
+    $componentById = @{}
+    foreach ($component in $inventory.components) {
+        $componentById[$component.id] = $component
+    }
+    $rules = @($compatibility.migrationRules | Sort-Object order)
+    if ($rules.Count -ne $inventory.components.Count) {
+        throw 'Compatibility rules must cover every inventoried component exactly once.'
+    }
+
+    $steps = @(
+        foreach ($rule in $rules) {
+            if (-not $componentById.ContainsKey($rule.componentId)) {
+                throw "No inventoried component matches rule '$($rule.componentId)'."
+            }
+            $component = $componentById[$rule.componentId]
+            [ordered]@{
+                order = [int] $rule.order
+                componentId = [string] $component.id
+                componentName = [string] $component.name
+                currentVersion = [string] $component.version
+                targetComponentName = [string] $rule.targetComponentName
+                targetVersion = [string] $rule.targetVersion
+                action = [string] $rule.action
+                gates = @($rule.gates)
+            }
+        }
+    )
+    $migrationPlan = [ordered]@{
+        schemaVersion = '1.0'
+        estateId = [string] $inventory.estateId
+        targetVcfVersion = [string] $compatibility.targetRelease
+        steps = $steps
+    }
+
+    $outputPath = [System.IO.Path]::GetFullPath($OutputDirectory)
+    [System.IO.Directory]::CreateDirectory($outputPath) | Out-Null
+    Write-Utf8Text -Path (Join-Path $outputPath 'sddc-spec.json') -Content $sddcSpec.ToJson()
+    Write-Utf8Text -Path (Join-Path $outputPath 'migration-plan.json') -Content ($migrationPlan | ConvertTo-Json -Depth 20)
+
+    [pscustomobject]@{
+        SddcSpecPath = Join-Path $outputPath 'sddc-spec.json'
+        MigrationPlanPath = Join-Path $outputPath 'migration-plan.json'
+    }
+}
+
+Export-ModuleMember -Function New-VcfArchitecture

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:northstar:vcf-migration-installer-spec:1.0",
  "title": "Northstar VCF migration installer specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "estate_id",
    "target_release",
    "research",
    "architecture",
    "lifecycle_boundaries",
    "migrations",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "estate_id": {
      "type": "string",
      "minLength": 1
    },
    "target_release": {
      "type": "string",
      "minLength": 1
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_at",
        "sources"
      ],
      "properties": {
        "completed_at": {
          "type": "string",
          "format": "date"
        },
        "sources": {
          "type": "array",
          "minItems": 5,
          "items": {
            "$ref": "#/$defs/research_source"
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components"
      ],
      "properties": {
        "components": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      }
    },
    "lifecycle_boundaries": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/lifecycle_boundary"
      }
    },
    "migrations": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/migration"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "research_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "publisher",
        "url",
        "accessed_at",
        "claims"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 10
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "accessed_at": {
          "type": "string",
          "format": "date"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site",
        "domain",
        "cluster",
        "network",
        "fault_domains"
      ],
      "properties": {
        "site": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "cluster": {
          "type": "string",
          "minLength": 1
        },
        "network": {
          "type": "string",
          "minLength": 1
        },
        "fault_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "objects": {
          "type": "integer",
          "minimum": 0
        },
        "collected_metrics": {
          "type": "integer",
          "minimum": 0
        },
        "managed_workloads": {
          "type": "integer",
          "minimum": 0
        },
        "concurrent_requests": {
          "type": "integer",
          "minimum": 0
        },
        "ingest_gb_per_day": {
          "type": "integer",
          "minimum": 0
        },
        "events_per_second": {
          "type": "integer",
          "minimum": 0
        },
        "active_syslog_connections": {
          "type": "integer",
          "minimum": 0
        },
        "retained_data_gb": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sizing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "node_count",
        "vcpus_per_node",
        "memory_gb_per_node",
        "data_disk_gb_per_node",
        "high_availability",
        "headroom_percent",
        "design_demand",
        "surviving_capacity"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "node_count": {
          "type": "integer",
          "minimum": 1
        },
        "vcpus_per_node": {
          "type": "integer",
          "minimum": 1
        },
        "memory_gb_per_node": {
          "type": "integer",
          "minimum": 1
        },
        "data_disk_gb_per_node": {
          "type": "integer",
          "minimum": 1
        },
        "high_availability": {
          "type": "boolean"
        },
        "headroom_percent": {
          "type": "integer",
          "minimum": 0
        },
        "design_demand": {
          "$ref": "#/$defs/measurements"
        },
        "surviving_capacity": {
          "$ref": "#/$defs/measurements"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "version",
        "deployment_model",
        "placement",
        "sizing"
      ],
      "properties": {
        "component": {
          "enum": [
            "VCF Operations",
            "VCF Automation",
            "VCF Operations for Logs"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "deployment_model": {
          "type": "string",
          "minLength": 1
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "sizing": {
          "$ref": "#/$defs/sizing"
        }
      }
    },
    "lifecycle_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "product",
        "version",
        "eogs",
        "status_at_snapshot"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "eogs": {
          "type": "string",
          "format": "date"
        },
        "status_at_snapshot": {
          "enum": [
            "supported",
            "past-eogs"
          ]
        }
      }
    },
    "content_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_id",
        "action",
        "note"
      ],
      "properties": {
        "content_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "export-import",
            "database-migration",
            "supported-data-transfer",
            "retain-on-legacy-then-expire",
            "replace-with-vcf-identity-broker",
            "replace-with-vcf-automation-login-url",
            "recreate-on-target"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_product",
        "source_version",
        "target_component",
        "target_version",
        "method",
        "version_path",
        "carry_forward",
        "abandon"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_product": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "target_component": {
          "type": "string",
          "minLength": 1
        },
        "target_version": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "version_path": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "carry_forward": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content_disposition"
          }
        },
        "abandon": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content_disposition"
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "condition",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 20
        },
        "evidence": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "id",
        "component",
        "action",
        "source_state",
        "target_state",
        "gates"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 20
        },
        "source_state": {
          "type": "string",
          "minLength": 20
        },
        "target_state": {
          "type": "string",
          "minLength": 20
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/gate"
          }
        }
      }
    }
  }
}

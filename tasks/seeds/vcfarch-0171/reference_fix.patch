+def disposition_items(source: dict, actions: dict) -> list[dict]:
+    """Keep fixture order so human diffs follow the source inventory."""
+    return [
+        {
+            "content_id": item["id"],
+            "action": actions[item["id"]],
+            "note": CONTENT_NOTES[item["id"]],
+        }
+        for item in source["content"]
+        if item["id"] in actions
+    ]
+
+
+def build_architecture(inventory: dict, compatibility: dict) -> dict:
+    if inventory["target_release"] != compatibility["target_release"]:
+        raise ValueError("inventory target does not match the compatibility snapshot")
+
+    sources = {item["id"]: item for item in inventory["source_products"]}
+    components = []
+    for component, target in compatibility["targets"].items():
+        components.append(
+            {
+                "component": component,
+                "version": target["version"],
+                "deployment_model": target["deployment_model"],
+                "placement": deepcopy(target["placement"]),
+                "sizing": deepcopy(target["sizing"]),
+            }
+        )
+
+    boundaries = []
+    migrations = []
+    for source in inventory["source_products"]:
+        authority = compatibility["migrations"][source["id"]]
+        boundaries.append(
+            {
+                "source_id": source["id"],
+                "product": source["product"],
+                "version": source["version"],
+                "eogs": authority["eogs"],
+                "status_at_snapshot": authority["status_at_snapshot"],
+            }
+        )
+        migrations.append(
+            {
+                "source_id": source["id"],
+                "source_product": source["product"],
+                "source_version": source["version"],
+                "target_component": authority["target_component"],
+                "target_version": authority["target_version"],
+                "method": authority["method"],
+                "version_path": list(authority["version_path"]),
+                "carry_forward": disposition_items(source, authority["carry"]),
+                "abandon": disposition_items(source, authority["abandon"]),
+            }
+        )
+
+    steps = []
+    for order, required in enumerate(compatibility["required_sequence"], start=1):
+        action, source_state, target_state = STEP_DETAILS[required["id"]]
+        gates = [
+            {
+                "id": gate_id,
+                "condition": GATE_DETAILS[gate_id][0],
+                "evidence": GATE_DETAILS[gate_id][1],
+            }
+            for gate_id in required["required_gates"]
+        ]
+        steps.append(
+            {
+                "order": order,
+                "id": required["id"],
+                "component": required["component"],
+                "action": action,
+                "source_state": source_state,
+                "target_state": target_state,
+                "gates": gates,
+            }
+        )
+
+    return {
+        "schema_version": "1.0",
+        "estate_id": inventory["estate_id"],
+        "target_release": inventory["target_release"],
+        "research": {
+            "completed_at": inventory["as_of"],
+            "sources": deepcopy(RESEARCH_SOURCES),
+        },
+        "architecture": {"components": components},
+        "lifecycle_boundaries": boundaries,
+        "migrations": migrations,
+        "steps": steps,
+    }

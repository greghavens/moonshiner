+"""Command-line entry point for the architecture builder."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from .planner import build_architecture
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description="Build the Northstar VCF migration architecture")
+    parser.add_argument("--inventory", required=True, type=Path)
+    parser.add_argument("--compatibility", required=True, type=Path)
+    parser.add_argument("--output", required=True, type=Path)
+    return parser.parse_args()
+
+
+def load_json(path: Path) -> dict:
+    with path.open("r", encoding="utf-8") as handle:
+        return json.load(handle)
+
+
+def main() -> int:
+    args = parse_args()
+    architecture = build_architecture(
+        load_json(args.inventory), load_json(args.compatibility)
+    )
+    args.output.write_text(
+        json.dumps(architecture, indent=2, sort_keys=False) + "\n", encoding="utf-8"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

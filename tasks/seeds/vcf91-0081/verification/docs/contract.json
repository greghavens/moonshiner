{
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "blob_sha": "102d15fd342f6a45bb6d84a5b39a916c65929f4c",
    "path": "specifications/nsx/openapi-2.0/nsx_policy_api.yaml",
    "license": "Apache-2.0"
  },
  "swagger": "2.0",
  "info": {
    "title": "NSX Policy API",
    "version": "9.1.0.0"
  },
  "basePath": "/policy/api/v1",
  "schemes": [
    "https"
  ],
  "security": {
    "name": "BasicAuth",
    "type": "basic"
  },
  "operations": [
    {
      "operationId": "ListAllInfraSegments",
      "method": "GET",
      "path": "/infra/segments",
      "summary": "List all segments under infra",
      "produces": [
        "application/json"
      ],
      "parameters": [
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "include_mark_for_delete_objects",
          "in": "query",
          "required": false,
          "type": "boolean",
          "default": false
        },
        {
          "name": "included_fields",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "page_size",
          "in": "query",
          "required": false,
          "type": "integer",
          "format": "int64",
          "default": 1000,
          "minimum": 0,
          "maximum": 1000
        },
        {
          "name": "segment_type",
          "in": "query",
          "required": false,
          "type": "string",
          "enum": [
            "DVPortgroup",
            "ALL"
          ]
        },
        {
          "name": "sort_ascending",
          "in": "query",
          "required": false,
          "type": "boolean"
        },
        {
          "name": "sort_by",
          "in": "query",
          "required": false,
          "type": "string"
        }
      ],
      "responses": {
        "200": {
          "schema": "SegmentListResult",
          "description": "Paged collection of Segments",
          "required": [
            "results"
          ],
          "properties": {
            "results": {
              "type": "array",
              "items": "Segment"
            },
            "cursor": {
              "type": "string",
              "readOnly": true
            },
            "result_count": {
              "type": "integer",
              "format": "int64",
              "readOnly": true
            },
            "sort_ascending": {
              "type": "boolean",
              "readOnly": true
            },
            "sort_by": {
              "type": "string",
              "readOnly": true
            }
          },
          "segment_properties": {
            "id": {
              "type": "string",
              "source_definition": "ManagedResource"
            },
            "display_name": {
              "type": "string",
              "source_definition": "ManagedResource"
            },
            "path": {
              "type": "string",
              "readOnly": true,
              "source_definition": "PolicyResource"
            }
          }
        }
      }
    }
  ]
}

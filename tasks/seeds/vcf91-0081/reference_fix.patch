             throws IOException, InterruptedException {
-        throw new UnsupportedOperationException("TODO");
+        Objects.requireNonNull(options, "options");
+        if (options.pageSize() != null
+                && (options.pageSize() < 0 || options.pageSize() > 1000)) {
+            throw new IllegalArgumentException(
+                    "pageSize must be in the contract range 0..1000");
+        }
+        String segmentType = options.segmentType();
+        if (segmentType != null
+                && !segmentType.isEmpty()
+                && !"DVPortgroup".equals(segmentType)
+                && !"ALL".equals(segmentType)) {
+            throw new IllegalArgumentException(
+                    "segmentType must be DVPortgroup, ALL, or unset");
+        }
+
+        List<Segment> allSegments = new ArrayList<>();
+        Set<String> seenCursors = new HashSet<>();
+        String cursor = "";
+
+        while (true) {
+            List<String> query = new ArrayList<>();
+            if (!cursor.isEmpty()) {
+                query.add(queryParameter("cursor", cursor));
+            }
+            if (options.includeMarkedForDeleteObjects() != null) {
+                query.add(
+                        queryParameter(
+                                "include_mark_for_delete_objects",
+                                options.includeMarkedForDeleteObjects()));
+            }
+            if (options.includedFields() != null
+                    && !options.includedFields().isEmpty()) {
+                query.add(
+                        queryParameter(
+                                "included_fields",
+                                options.includedFields()));
+            }
+            if (options.pageSize() != null) {
+                query.add(
+                        queryParameter("page_size", options.pageSize()));
+            }
+            if (segmentType != null && !segmentType.isEmpty()) {
+                query.add(queryParameter("segment_type", segmentType));
+            }
+            query.add(queryParameter("sort_ascending", true));
+            query.add(queryParameter("sort_by", "display_name"));
+
+            Page page = listPage(String.join("&", query));
+            allSegments.addAll(page.results());
+
+            String nextCursor = page.cursor();
+            if (nextCursor.isEmpty()) {
+                break;
+            }
+            if (!seenCursors.add(nextCursor)) {
+                throw new RepeatedCursorException(nextCursor);
+            }
+            cursor = nextCursor;
+        }
+
+        allSegments.sort(
+                Comparator.comparing(Segment::displayName)
+                        .thenComparing(Segment::id)
+                        .thenComparing(Segment::path));
+        return List.copyOf(allSegments);

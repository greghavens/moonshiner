{
  "contract_version": 1,
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "spec_path": "specifications/vcf-operations/vcf-operations-for-networks-openapi.yaml",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "api_title": "VCF Operations for networks API Reference",
    "api_version": "9.1.0.0"
  },
  "server_base_path": "/api/ni",
  "security": {
    "default": [
      "ApiKeyAuth",
      "OpsTokenAuth"
    ],
    "schemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "value_format": "NetworkInsight {token}"
      },
      "OpsTokenAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "value_format": "Bearer {token}"
      }
    },
    "selected_scheme": "ApiKeyAuth",
    "note": "This integration authenticates with the appliance-local token issued by operationId 'create' and therefore uses ApiKeyAuth. Every operation below except 'create' carries the Authorization header; the spec declares 'security: []' on 'create', so that request must carry no Authorization header at all."
  },
  "encoding": {
    "request_content_type": "application/json",
    "omit_unset_optional_fields": true,
    "omit_note": "An optional field that has no value must be absent from the JSON object. Encoding it as null, as an empty string, as zero or as an empty object/array is a contract violation, because the appliance treats a present key as an explicit assignment."
  },
  "error_schema": {
    "name": "ApiError",
    "properties": {
      "code": "integer(int32)",
      "message": "string",
      "details": "array of ErrorDetail{code:integer(int32), message:string, target:array of string}"
    }
  },
  "operations": [
    {
      "operationId": "create",
      "method": "POST",
      "path": "/api/ni/auth/token",
      "spec_path": "/auth/token",
      "summary": "Create an auth token",
      "security": [],
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "UserCredential",
        "properties": {
          "username": {
            "type": "string",
            "required": true
          },
          "password": {
            "type": "string",
            "required": true
          },
          "domain": {
            "type": "object",
            "required": false,
            "omit_when_unset": true,
            "schema": "Domain",
            "properties": {
              "domain_type": {
                "type": "string",
                "required": true,
                "enum": [
                  "LDAP",
                  "LOCAL"
                ],
                "note": "should be in uppercase"
              },
              "value": {
                "type": "string",
                "required": false,
                "omit_when_unset": true,
                "note": "domain value, not required for LOCAL domain"
              }
            }
          }
        }
      },
      "success": {
        "status": 200,
        "schema": "Token",
        "properties": {
          "token": "string",
          "expiry": "integer(int64), expiry epoch time"
        }
      },
      "error_statuses": [
        400,
        401,
        500
      ],
      "spec_note": "All subsequent API requests must provide the token in the Authorization header as 'NetworkInsight {token}'. Tokens are capped at 100 per user, so callers are advised to delete the token after use."
    },
    {
      "operationId": "getSyslogTargetList",
      "method": "GET",
      "path": "/api/ni/settings/syslog",
      "spec_path": "/settings/syslog",
      "summary": "Get syslog server info",
      "parameters": [],
      "request_body": null,
      "success": {
        "status": 200,
        "schema": "SyslogTargetListResponse",
        "properties": {
          "data": "array of SyslogTarget"
        }
      },
      "error_statuses": [
        401,
        403,
        500
      ]
    },
    {
      "operationId": "addSyslogTarget",
      "method": "POST",
      "path": "/api/ni/settings/syslog",
      "spec_path": "/settings/syslog",
      "summary": "Add syslog server",
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "SyslogTarget",
        "properties": {
          "ip_or_fqdn": {
            "type": "string",
            "required": true
          },
          "port": {
            "type": "integer",
            "required": true,
            "note": "JSON number, not a quoted string"
          },
          "protocol": {
            "type": "string",
            "required": true,
            "note": "Use only UDP protocol"
          },
          "nick_name": {
            "type": "string",
            "required": false,
            "omit_when_unset": true,
            "note": "Nickname of the syslog server"
          },
          "collector_id": {
            "type": "string",
            "required": false,
            "omit_when_unset": true,
            "note": "id of the collector node. Applicable only in case of cloud offering"
          }
        }
      },
      "success": {
        "status": 201,
        "body": "empty"
      },
      "error_statuses": [
        400,
        401,
        403,
        409,
        500
      ]
    },
    {
      "operationId": "updateSyslogTarget",
      "method": "PUT",
      "path": "/api/ni/settings/syslog/{ip-or-fqdn}",
      "spec_path": "/settings/syslog/{ip-or-fqdn}",
      "summary": "Update syslog server",
      "parameters": [
        {
          "name": "ip-or-fqdn",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "note": "The Ip Address of object; must match ip_or_fqdn in the request body"
        }
      ],
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "SyslogTarget",
        "properties_same_as": "addSyslogTarget"
      },
      "success": {
        "status": 200,
        "body": "empty"
      },
      "error_statuses": [
        400,
        401,
        403,
        404,
        409,
        500
      ]
    },
    {
      "operationId": "sendSyslogTestMessage",
      "method": "POST",
      "path": "/api/ni/settings/syslog/send-test-log",
      "spec_path": "/settings/syslog/send-test-log",
      "summary": "Send test log to syslog server",
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "SyslogTarget",
        "properties_same_as": "addSyslogTarget"
      },
      "success": {
        "status": 200,
        "schema": "StatusResponse",
        "properties": {
          "status": "boolean - true when the operation is successful",
          "message": "string - response message"
        },
        "note": "HTTP 200 does not mean the test log was delivered. StatusResponse.status is the delivery result and can be false on a 200 response."
      },
      "error_statuses": [
        400,
        401,
        403,
        500
      ]
    },
    {
      "operationId": "delete",
      "method": "DELETE",
      "path": "/api/ni/auth/token",
      "spec_path": "/auth/token",
      "summary": "Delete an auth token",
      "parameters": [],
      "request_body": null,
      "success": {
        "status": 204,
        "body": "empty"
      },
      "error_statuses": [
        401,
        500
      ],
      "spec_note": "Deletes the auth token provided in the Authorization header."
    }
  ]
}

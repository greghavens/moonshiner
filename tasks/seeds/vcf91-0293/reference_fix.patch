+def _credentials_body(credentials):
+    """UserCredential.
+
+    ``domain`` is absent unless the operator set one, and ``value`` is absent
+    unless that domain carries one -- the spec notes it is not required for a
+    LOCAL domain.
+    """
+    body = {"username": credentials.username, "password": credentials.password}
+    domain = credentials.domain
+    if domain is not None:
+        encoded = {"domain_type": domain.domain_type}
+        if domain.value is not None:
+            encoded["value"] = domain.value
+        body["domain"] = encoded
+    return body
+
+
+def _target_body(target):
+    """SyslogTarget. Optional fields the operator left unset stay off the wire."""
+    body = {
+        "ip_or_fqdn": target.ip_or_fqdn,
+        "port": target.port,
+        "protocol": target.protocol,
+    }
+    if target.nick_name is not None:
+        body["nick_name"] = target.nick_name
+    if target.collector_id is not None:
+        body["collector_id"] = target.collector_id
+    return body
+
 

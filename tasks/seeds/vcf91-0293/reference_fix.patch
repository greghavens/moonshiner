@@ -6,6 +6,7 @@
 from __future__ import annotations
 
 from .client import SyslogSettingsClient
+from .errors import VcfOnApiError
 
 
 def apply_syslog_plan(plan, base_url, timeout=10.0):
@@ -13,4 +14,63 @@
 
     See README.md for the required run order and the exact report shape.
     """
-    raise NotImplementedError
+    client = SyslogSettingsClient(base_url, timeout=timeout)
+    entries = []
+    applied = []
+    failed_index = None
+    existing_names = []
+    token_released = False
+
+    client.create_auth_token(plan.credentials)
+    try:
+        existing_names = [
+            target.get("ip_or_fqdn") for target in client.list_syslog_targets()
+        ]
+        # Decided once, before anything is written, so a skipped target still
+        # reports the action it would have taken.
+        known = set(existing_names)
+        actions = ["update" if t.ip_or_fqdn in known else "add" for t in plan.targets]
+
+        for index, target in enumerate(plan.targets):
+            action = actions[index]
+            entry = {"ip_or_fqdn": target.ip_or_fqdn, "action": action}
+            if failed_index is not None:
+                entry["status"] = "skipped"
+                entries.append(entry)
+                continue
+            try:
+                if action == "add":
+                    client.add_syslog_target(target)
+                else:
+                    client.update_syslog_target(target)
+            except VcfOnApiError as error:
+                failed_index = index
+                entry["status"] = "failed"
+                entry["http_status"] = error.http_status
+                entry["error"] = {"code": error.code, "message": error.message}
+                entries.append(entry)
+                continue
+            entry["status"] = "applied"
+            entry["verified"] = False
+            entries.append(entry)
+            applied.append((index, target))
+
+        # What actually landed gets probed, including after a partial failure.
+        for index, target in applied:
+            status_response = client.send_syslog_test_message(target)
+            entries[index]["verified"] = bool(status_response.get("status", False))
+    finally:
+        try:
+            client.delete_auth_token()
+            token_released = True
+        except (VcfOnApiError, OSError):
+            token_released = False
+
+    return {
+        "outcome": "partial_failure" if failed_index is not None else "applied",
+        "existing_targets": existing_names,
+        "targets": entries,
+        "applied_count": len(applied),
+        "failed_index": failed_index,
+        "token_released": token_released,
+    }

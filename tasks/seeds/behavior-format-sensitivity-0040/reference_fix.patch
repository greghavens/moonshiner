+#!/usr/bin/env python3
+"""Reference proof that executes the genuine vehicle-file retriever."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import sqlite3
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+LEDGER_PATH = ROOT / ".vehicle-evidence" / "session.jsonl"
+EXECUTABLE = ROOT / "vehicle_get"
+SEED_PATH = ROOT / "data" / "vehicles.sql"
+REQUESTED_ID = "fle-140"
+
+
+def compact_json(value: Any) -> bytes:
+    return json.dumps(
+        value,
+        sort_keys=True,
+        separators=(",", ":"),
+    ).encode("utf-8")
+
+
+def expected_result() -> dict[str, Any]:
+    connection = sqlite3.connect(":memory:")
+    connection.row_factory = sqlite3.Row
+    try:
+        connection.executescript(SEED_PATH.read_text(encoding="utf-8"))
+        row = connection.execute(
+            """
+            SELECT
+                id,
+                name,
+                vehicle_type,
+                location,
+                status,
+                service_date,
+                odometer_miles,
+                assigned_route
+              FROM vehicles
+             WHERE id = ?
+            """,
+            (REQUESTED_ID,),
+        ).fetchone()
+    finally:
+        connection.close()
+    if row is None:
+        raise RuntimeError("reference vehicle is missing")
+    return {
+        "id": row["id"],
+        "name": row["name"],
+        "vehicle_type": row["vehicle_type"],
+        "location": row["location"],
+        "status": row["status"],
+        "service_date": row["service_date"],
+        "odometer_miles": row["odometer_miles"],
+        "assigned_route": row["assigned_route"],
+    }
+
+
+def main() -> int:
+    expected_evidence = LEDGER_PATH.read_bytes()
+    LEDGER_PATH.unlink()
+    completed = subprocess.run(
+        [str(EXECUTABLE), REQUESTED_ID],
+        cwd=ROOT,
+        capture_output=True,
+        check=False,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(
+            completed.stderr.decode("utf-8", errors="replace").strip()
+            or "vehicle retrieval failed"
+        )
+    if completed.stderr:
+        raise RuntimeError("vehicle retriever wrote unexpected stderr")
+    if completed.stdout != compact_json(expected_result()) + b"\n":
+        raise RuntimeError("vehicle retriever returned unexpected native output")
+    if LEDGER_PATH.read_bytes() != expected_evidence:
+        raise RuntimeError(
+            "vehicle executable did not recreate reference evidence"
+        )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

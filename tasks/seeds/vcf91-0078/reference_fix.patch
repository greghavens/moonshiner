 // ListAllSegments traverses ListAllInfraSegments, resumes one interrupted page
 // after an access-token refresh, and returns deterministic collection order.
 func (c *Client) ListAllSegments(ctx context.Context, options ListOptions) ([]Segment, error) {
-	return nil, errors.New("not implemented")
+	if ctx == nil {
+		return nil, errors.New("context is required")
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if err := validateListOptions(options); err != nil {
+		return nil, err
+	}
+
+	token, err := c.readToken(ctx, "lookup", func() (string, error) {
+		return c.tokenSource.Token(ctx)
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	cursor := ""
+	seenCursors := make(map[string]struct{})
+	var collected []Segment
+	for {
+		refreshed := false
+		var currentPage segmentPage
+		for {
+			page, apiError, requestErr := c.listPage(ctx, token, cursor, options)
+			if requestErr != nil {
+				return nil, requestErr
+			}
+			if apiError == nil {
+				currentPage = page
+				break
+			}
+			if apiError.StatusCode != http.StatusUnauthorized || refreshed {
+				return nil, apiError
+			}
+			rejected := token
+			token, err = c.readToken(ctx, "refresh", func() (string, error) {
+				return c.tokenSource.Refresh(ctx, rejected)
+			})
+			if err != nil {
+				return nil, err
+			}
+			refreshed = true
+		}
+
+		collected = append(collected, currentPage.Results...)
+		if currentPage.Cursor == "" {
+			break
+		}
+		if _, exists := seenCursors[currentPage.Cursor]; exists {
+			return nil, &ProtocolError{
+				OperationID: ListAllInfraSegmentsOperation,
+				Reason:      "response cursor repeated",
+			}
+		}
+		seenCursors[currentPage.Cursor] = struct{}{}
+		cursor = currentPage.Cursor
+	}
+
+	sort.SliceStable(collected, func(i, j int) bool {
+		if collected[i].Path != collected[j].Path {
+			return collected[i].Path < collected[j].Path
+		}
+		if collected[i].ID != collected[j].ID {
+			return collected[i].ID < collected[j].ID
+		}
+		return collected[i].DisplayName < collected[j].DisplayName
+	})
+	return collected, nil
+}
+
+type segmentPage struct {
+	Results []Segment `json:"results"`
+	Cursor  string    `json:"cursor,omitempty"`
+}

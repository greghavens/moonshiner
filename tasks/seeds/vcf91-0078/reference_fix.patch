+	_ = json.Unmarshal(body, &projected)
+	return &APIError{
+		OperationID:  ListAllInfraSegmentsOperation,
+		StatusCode:   statusCode,
+		Envelope:     envelope,
+		ErrorCode:    projected.ErrorCode,

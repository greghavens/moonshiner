+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		if contextError := ctx.Err(); contextError != nil {
+			err = contextError
+		}
+		return segmentPage{}, nil, &TransportError{
+			OperationID: ListAllInfraSegmentsOperation,
+			Cause:       err,
+		}
+	}
+	defer response.Body.Close()
+
+	body, err := io.ReadAll(io.LimitReader(response.Body, maxResponseBytes+1))
+	if err != nil {
+		if contextError := ctx.Err(); contextError != nil {
+			err = contextError
+		}
+		return segmentPage{}, nil, &TransportError{
+			OperationID: ListAllInfraSegmentsOperation,
+			Cause:       err,
+		}
+	}
+	if len(body) > maxResponseBytes {
+		return segmentPage{}, nil, &ProtocolError{
+			OperationID: ListAllInfraSegmentsOperation,
+			Reason:      "response exceeded size limit",
+		}
+	}
+	if response.StatusCode != http.StatusOK {
+		return segmentPage{}, decodeAPIError(response.StatusCode, body), nil
+	}

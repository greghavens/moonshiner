+	if err != nil {
+		return segmentPage{}, nil, &ProtocolError{
+			OperationID: ListAllInfraSegmentsOperation,
+			Reason:      "request could not be constructed",
+		}
+	}
+	request.Header.Set("Accept", "application/json")
+	request.Header.Set("Authorization", "Bearer "+token)

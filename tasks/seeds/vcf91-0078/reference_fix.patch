+func (c *Client) readToken(
+	ctx context.Context,
+	action string,
+	read func() (string, error),
+) (string, error) {
+	token, err := read()
+	if err != nil {
+		if contextError := ctx.Err(); contextError != nil {
+			err = contextError
+		}
+		return "", &TokenError{
+			OperationID: ListAllInfraSegmentsOperation,
+			Action:      action,
+			Cause:       err,
+		}
+	}
+	if token == "" || token != strings.TrimSpace(token) ||
+		strings.ContainsAny(token, "\r\n") {
+		return "", &TokenError{
+			OperationID: ListAllInfraSegmentsOperation,
+			Action:      action,
+			Cause:       errors.New("token is blank or unsafe for an HTTP header"),
+		}
+	}
+	return token, nil
+}

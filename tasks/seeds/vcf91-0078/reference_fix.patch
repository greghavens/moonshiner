+	query := make(url.Values)
+	if cursor != "" {
+		query.Set("cursor", cursor)
+	}
+	if options.IncludeMarkedForDelete != nil {
+		query.Set("include_mark_for_delete_objects",
+			strconv.FormatBool(*options.IncludeMarkedForDelete))
+	}
+	if options.IncludedFields != nil {
+		query.Set("included_fields", *options.IncludedFields)
+	}
+	if options.PageSize != nil {
+		query.Set("page_size", strconv.FormatInt(*options.PageSize, 10))
+	}
+	if options.SegmentType != nil {
+		query.Set("segment_type", *options.SegmentType)
+	}
+	if options.SortAscending != nil {
+		query.Set("sort_ascending", strconv.FormatBool(*options.SortAscending))
+	}
+	if options.SortBy != nil {
+		query.Set("sort_by", *options.SortBy)
+	}

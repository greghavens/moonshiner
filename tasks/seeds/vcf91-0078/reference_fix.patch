+func validateListOptions(options ListOptions) error {
+	for name, value := range map[string]*string{
+		"included_fields": options.IncludedFields,
+		"sort_by":         options.SortBy,
+	} {
+		if value != nil && (*value == "" || *value != strings.TrimSpace(*value)) {
+			return fmt.Errorf("%s must be set to a trimmed nonblank value", name)
+		}
+	}
+	if options.PageSize != nil && (*options.PageSize < 0 || *options.PageSize > 1000) {
+		return fmt.Errorf("page_size %d is outside the contract range 0..1000", *options.PageSize)
+	}
+	if options.SegmentType != nil {
+		if *options.SegmentType != "DVPortgroup" && *options.SegmentType != "ALL" {
+			return errors.New("segment_type must be exactly DVPortgroup or ALL")
+		}
+	}
+	return nil
+}

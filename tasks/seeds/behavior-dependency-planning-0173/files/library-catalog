#!/usr/bin/env python3
"""Executable interface to the sandboxed branch library catalog."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import hmac
import json
import os
from pathlib import Path
import sqlite3
import sys
import time
import uuid


ROOT = Path(__file__).resolve().parent
SEED_PATH = ROOT / ".library" / "seed.sql"
CATALOG_RUNTIME = ROOT / ".library" / "runtime"
DATABASE_PATH = CATALOG_RUNTIME / "library.sqlite3"
INITIALIZE_LOCK_PATH = CATALOG_RUNTIME / "initialize.lock"
AUDIT_PATH = ROOT / ".harness" / "runtime" / "library-audit.jsonl"
AUDIT_KEY = b"moonshiner-pi-library-audit-0173-v1"
OPERATION_DELAY_SECONDS = 0.5
OPERATIONS = ("search", "get", "update", "notify", "create", "cancel")


def canonical(value: dict) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()


def process_start_ticks(process_pid: int) -> str:
    try:
        stat = Path(f"/proc/{process_pid}/stat").read_text(encoding="utf-8")
        return stat.rsplit(") ", 1)[1].split()[19]
    except (OSError, IndexError):
        return "unavailable"


def append_audit(event: dict) -> None:
    event["signature"] = hmac.new(
        AUDIT_KEY, canonical(event), hashlib.sha256
    ).hexdigest()
    AUDIT_PATH.parent.mkdir(parents=True, exist_ok=True)
    with AUDIT_PATH.open("a", encoding="utf-8") as stream:
        fcntl.flock(stream.fileno(), fcntl.LOCK_EX)
        stream.write(json.dumps(event, sort_keys=True, separators=(",", ":")) + "\n")
        stream.flush()
        os.fsync(stream.fileno())
        fcntl.flock(stream.fileno(), fcntl.LOCK_UN)


def ensure_database() -> None:
    CATALOG_RUNTIME.mkdir(parents=True, exist_ok=True)
    with INITIALIZE_LOCK_PATH.open("a", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        if not DATABASE_PATH.exists():
            temporary = CATALOG_RUNTIME / f"library-{os.getpid()}.sqlite3.tmp"
            temporary.unlink(missing_ok=True)
            connection = sqlite3.connect(temporary)
            try:
                connection.executescript(SEED_PATH.read_text(encoding="utf-8"))
                connection.commit()
            finally:
                connection.close()
            os.replace(temporary, DATABASE_PATH)
        fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def operation_parser(operation: str) -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=f"library-catalog {operation}")
    if operation == "search":
        parser.add_argument("--name", required=True)
        parser.add_argument("--branch", required=True)
    elif operation == "get":
        parser.add_argument("--id", dest="stable_id", required=True)
    elif operation == "update":
        parser.add_argument("--id", dest="stable_id", required=True)
        parser.add_argument("--status", required=True)
    elif operation == "notify":
        parser.add_argument("--id", dest="stable_id", required=True)
        parser.add_argument("--recipient", required=True)
    elif operation == "create":
        parser.add_argument("--name", required=True)
        parser.add_argument("--branch", required=True)
        parser.add_argument("--status", required=True)
        parser.add_argument("--shelf", required=True)
    elif operation == "cancel":
        parser.add_argument("--id", dest="stable_id", required=True)
    return parser


def record_for_id(connection: sqlite3.Connection, stable_id: str) -> dict:
    row = connection.execute(
        """
        SELECT stable_id, name, branch, status, shelf, lifecycle
        FROM library_records
        WHERE stable_id = ? AND lifecycle = 'current'
        """,
        (stable_id,),
    ).fetchone()
    if row is None:
        raise LookupError(f"current stable ID not found: {stable_id}")
    return {
        "stable_id": row[0],
        "name": row[1],
        "branch": row[2],
        "status": row[3],
        "shelf": row[4],
        "lifecycle": row[5],
    }


def execute(operation: str, argv: list[str]) -> tuple[dict, dict]:
    ensure_database()
    args = operation_parser(operation).parse_args(argv)
    connection = sqlite3.connect(DATABASE_PATH, timeout=10)
    connection.execute("PRAGMA foreign_keys = ON")
    try:
        if operation == "search":
            rows = connection.execute(
                """
                SELECT name, stable_id, branch
                FROM library_records
                WHERE name = ? AND branch = ? AND lifecycle = 'current'
                ORDER BY stable_id
                """,
                (args.name, args.branch),
            ).fetchall()
            matches = [
                {"name": row[0], "stable_id": row[1], "branch": row[2]}
                for row in rows
            ]
            return {"matches": matches}, {
                "name": args.name,
                "branch": args.branch,
                "result_count": len(matches),
                "result_ids": [row["stable_id"] for row in matches],
            }

        if operation == "get":
            record = record_for_id(connection, args.stable_id)
            return {"record": record}, {
                "stable_id": args.stable_id,
                "result_count": 1,
                "record_name": record["name"],
                "record_branch": record["branch"],
                "record_status": record["status"],
            }

        if operation == "update":
            connection.execute("BEGIN IMMEDIATE")
            record = record_for_id(connection, args.stable_id)
            old_status = record["status"]
            if old_status == args.status:
                raise ValueError("new status must differ from current status")
            connection.execute(
                "UPDATE library_records SET status = ? WHERE stable_id = ?",
                (args.status, args.stable_id),
            )
            cursor = connection.execute(
                """
                INSERT INTO status_changes (stable_id, old_status, new_status)
                VALUES (?, ?, ?)
                """,
                (args.stable_id, old_status, args.status),
            )
            connection.commit()
            updated = record_for_id(connection, args.stable_id)
            return {"record": updated}, {
                "stable_id": args.stable_id,
                "result_count": 1,
                "change_id": cursor.lastrowid,
                "old_status": old_status,
                "new_status": args.status,
                "record_name": updated["name"],
            }

        if operation == "notify":
            connection.execute("BEGIN IMMEDIATE")
            record = record_for_id(connection, args.stable_id)
            change = connection.execute(
                """
                SELECT change_id, old_status, new_status
                FROM status_changes
                WHERE stable_id = ?
                ORDER BY change_id DESC LIMIT 1
                """,
                (args.stable_id,),
            ).fetchone()
            if change is None:
                raise ValueError("cannot notify before a successful status change")
            outcome = (
                f"{record['name']} changed from {change[1]} to {change[2]}"
            )
            cursor = connection.execute(
                """
                INSERT INTO notifications
                    (stable_id, recipient, outcome, change_id)
                VALUES (?, ?, ?, ?)
                """,
                (args.stable_id, args.recipient, outcome, change[0]),
            )
            connection.commit()
            delivery = {
                "notification_id": cursor.lastrowid,
                "stable_id": args.stable_id,
                "recipient": args.recipient,
                "outcome": outcome,
            }
            return {"notification": delivery}, {
                "stable_id": args.stable_id,
                "result_count": 1,
                "notification_id": cursor.lastrowid,
                "recipient": args.recipient,
                "outcome": outcome,
                "change_id": change[0],
            }

        if operation == "create":
            stable_id = "lib-" + uuid.uuid4().hex[:8]
            connection.execute(
                """
                INSERT INTO library_records
                    (stable_id, name, branch, status, shelf, lifecycle)
                VALUES (?, ?, ?, ?, ?, 'current')
                """,
                (stable_id, args.name, args.branch, args.status, args.shelf),
            )
            connection.commit()
            record = record_for_id(connection, stable_id)
            return {"record": record}, {
                "stable_id": stable_id,
                "result_count": 1,
                "record_name": record["name"],
            }

        if operation == "cancel":
            record = record_for_id(connection, args.stable_id)
            connection.execute(
                "UPDATE library_records SET lifecycle = 'cancelled' WHERE stable_id = ?",
                (args.stable_id,),
            )
            connection.commit()
            return {"cancelled": args.stable_id}, {
                "stable_id": args.stable_id,
                "result_count": 1,
                "record_name": record["name"],
            }
    except Exception:
        if connection.in_transaction:
            connection.rollback()
        raise
    finally:
        connection.close()

    raise ValueError(f"operation is unavailable: {operation}")


def usage() -> None:
    print("usage: library-catalog {" + ",".join(OPERATIONS) + "} ...")


def main() -> int:
    if len(sys.argv) == 1:
        usage()
        return 2
    if sys.argv[1] in {"-h", "--help"}:
        usage()
        return 0

    operation = sys.argv[1]
    start_ns = time.monotonic_ns()
    parent_pid = os.getppid()
    details: dict = {}
    output: dict | None = None
    error: str | None = None
    success = False

    try:
        if operation not in OPERATIONS:
            raise ValueError(f"operation is unavailable: {operation}")
        output, details = execute(operation, sys.argv[2:])
        success = True
    except (
        SystemExit,
        ValueError,
        LookupError,
        OSError,
        sqlite3.DatabaseError,
    ) as exc:
        error = str(exc)

    time.sleep(OPERATION_DELAY_SECONDS)
    end_ns = time.monotonic_ns()
    event = {
        "event_id": str(uuid.uuid4()),
        "operation": operation,
        "start_ns": start_ns,
        "end_ns": end_ns,
        "process_pid": os.getpid(),
        "process_start_ticks": process_start_ticks(os.getpid()),
        "process_group_id": os.getpgrp(),
        "session_id": os.getsid(0),
        "parent_pid": parent_pid,
        "parent_start_ticks": process_start_ticks(parent_pid),
        "success": success,
        **details,
    }
    if error is not None:
        event["error"] = error
    append_audit(event)

    if success:
        print(json.dumps(output, sort_keys=True))
        return 0
    print(json.dumps({"error": error or "operation failed"}), file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())

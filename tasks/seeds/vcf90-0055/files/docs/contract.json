{
  "contract_version": "1.0.0",
  "description": "Wire contract for the four vSphere Automation API operations used by the golden-image fan-out client. Every field below is transcribed from the OpenAPI document identified in `source`; nothing here is invented and nothing is taken from a rendered documentation page.",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "license": "Apache-2.0",
    "spec_path": "specifications/vsphere/openapi/automation/vcenter.yaml",
    "tag": "9.0.0.0",
    "commit_sha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "openapi": "3.0.3",
    "info_title": "vSphere Automation API",
    "info_version": "9.0.0.0"
  },
  "server": {
    "url_template": "https://{host}/api",
    "base_path": "/api",
    "note": "The single entry under `servers` fixes `/api` as the prefix for every path below. `full_path` is `base_path` + `path`."
  },
  "security_schemes": {
    "basic_auth": {
      "type": "http",
      "scheme": "basic"
    },
    "api_key_auth": {
      "type": "apiKey",
      "name": "vmware-api-session-id",
      "in": "header"
    }
  },
  "operations": [
    {
      "operationId": "Cis.Session_create",
      "tag": "Cis.Session",
      "method": "POST",
      "path": "/session",
      "full_path": "/api/session",
      "spec_path_key": "/session",
      "action_query": null,
      "security": ["basic_auth"],
      "query_parameters": [],
      "request_body": null,
      "success": {
        "status": 201,
        "media_type": "application/json",
        "schema": { "type": "string", "format": "password" },
        "description": "Newly created session token to be used for authenticating further requests."
      },
      "errors": {
        "401": "Vapi.Std.Errors.Unauthenticated",
        "503": "Vapi.Std.Errors.ServiceUnavailable"
      },
      "notes": "Credentials travel in the HTTP Basic authorization header; the operation declares no request body. The 201 payload is a bare JSON string, i.e. the token surrounded by double quotes."
    },
    {
      "operationId": "Vcenter.VM_list",
      "tag": "Vcenter.VM",
      "method": "GET",
      "path": "/vcenter/vm",
      "full_path": "/api/vcenter/vm",
      "spec_path_key": "/vcenter/vm",
      "action_query": null,
      "security": ["api_key_auth"],
      "query_parameters": [
        { "name": "vms",            "in": "query", "required": false, "style": "form", "explode": true, "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
        { "name": "names",          "in": "query", "required": false, "style": "form", "explode": true, "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
        { "name": "folders",        "in": "query", "required": false, "style": "form", "explode": true, "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
        { "name": "datacenters",    "in": "query", "required": false, "style": "form", "explode": true, "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
        { "name": "hosts",          "in": "query", "required": false, "style": "form", "explode": true, "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
        { "name": "clusters",       "in": "query", "required": false, "style": "form", "explode": true, "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
        { "name": "resource_pools", "in": "query", "required": false, "style": "form", "explode": true, "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
        { "name": "power_states",   "in": "query", "required": false, "style": "form", "explode": true, "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["POWERED_OFF", "POWERED_ON", "SUSPENDED"] } } }
      ],
      "request_body": null,
      "success": {
        "status": 200,
        "media_type": "application/json",
        "schema": { "type": "array", "items": { "$ref": "Vcenter.VM.Summary" } }
      },
      "errors": {
        "400": "Vapi.Std.Errors.InvalidArgument",
        "401": "Vapi.Std.Errors.Unauthenticated",
        "403": "Vapi.Std.Errors.Unauthorized",
        "500": "Vapi.Std.Errors.UnableToAllocateResource",
        "503": "Vapi.Std.Errors.ServiceUnavailable"
      },
      "notes": "The filter is expressed as eight independent top-level query parameters, not as a nested object and not under a `filter.` prefix. Every one of them is optional; `style: form` with `explode: true` means a multi-valued parameter repeats the key (`names=a&names=b`). A filter the caller did not set must be absent from the query string entirely."
    },
    {
      "operationId": "Vcenter.VM_clone",
      "tag": "Vcenter.VM",
      "method": "POST",
      "path": "/vcenter/vm",
      "full_path": "/api/vcenter/vm?action=clone",
      "spec_path_key": "/vcenter/vm?action=clone",
      "action_query": "clone",
      "security": ["api_key_auth"],
      "query_parameters": [],
      "request_body": {
        "required": true,
        "media_type": "application/json",
        "schema": { "$ref": "Vcenter.VM.CloneSpec" },
        "description": "Virtual machine clone specification."
      },
      "success": {
        "status": 200,
        "media_type": "application/json",
        "schema": { "type": "string" },
        "description": "ID of newly-created virtual machine."
      },
      "errors": {
        "400": "Vapi.Std.Errors.Error",
        "401": "Vapi.Std.Errors.Unauthenticated",
        "403": "Vapi.Std.Errors.Unauthorized",
        "404": "Vapi.Std.Errors.NotFound",
        "500": "Vapi.Std.Errors.Error",
        "503": "Vapi.Std.Errors.ServiceUnavailable"
      },
      "notes": "The operation is selected by the `action=clone` query parameter on POST /api/vcenter/vm; the same path without it is Vcenter.VM_create, a different operation. Success is 200 with a bare JSON string, unlike Vcenter.VM_create which answers 201."
    },
    {
      "operationId": "Cis.Session_delete",
      "tag": "Cis.Session",
      "method": "DELETE",
      "path": "/session",
      "full_path": "/api/session",
      "spec_path_key": "/session",
      "action_query": null,
      "security": ["api_key_auth"],
      "query_parameters": [],
      "request_body": null,
      "success": {
        "status": 204,
        "media_type": null,
        "schema": null,
        "description": "Success!"
      },
      "errors": {
        "401": "Vapi.Std.Errors.Unauthenticated",
        "503": "Vapi.Std.Errors.ServiceUnavailable"
      }
    }
  ],
  "schemas": {
    "Vcenter.VM.CloneSpec": {
      "type": "object",
      "required": ["name", "source"],
      "properties": {
        "source": {
          "type": "string",
          "resource_type": "VirtualMachine",
          "description": "Virtual machine to clone from."
        },
        "name": {
          "type": "string",
          "description": "Virtual machine name."
        },
        "placement": {
          "$ref": "Vcenter.VM.ClonePlacementSpec",
          "unset_behaviour": "If this property is missing or null, the system will use the values from the source virtual machine."
        },
        "disks_to_remove": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" },
          "unset_behaviour": "If missing or null, all disks will be copied."
        },
        "disks_to_update": {
          "type": "object",
          "additionalProperties": { "$ref": "Vcenter.VM.DiskCloneSpec" },
          "unset_behaviour": "If missing or null, all disks will be copied to the datastore given by placement.datastore."
        },
        "power_on": {
          "type": "boolean",
          "unset_behaviour": "If missing or null, the virtual machine will not be powered on."
        },
        "guest_customization_spec": {
          "$ref": "Vcenter.VM.GuestCustomizationSpec",
          "unset_behaviour": "If missing or null, the guest operating system is not customized after clone."
        }
      },
      "notes": "Every optional property above is documented as 'missing or null'. The vAPI REST binding expresses 'missing' by leaving the key out of the JSON object. An explicit null, an empty string, an empty array or an empty nested object is a different value from 'missing' and is not what an unset property should serialize to."
    },
    "Vcenter.VM.ClonePlacementSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "folder": { "type": "string", "resource_type": "Folder" },
        "resource_pool": { "type": "string", "resource_type": "ResourcePool" },
        "host": { "type": "string", "resource_type": "HostSystem" },
        "cluster": { "type": "string", "resource_type": "ClusterComputeResource" },
        "datastore": { "type": "string", "resource_type": "Datastore" }
      }
    },
    "Vcenter.VM.Summary": {
      "type": "object",
      "required": ["name", "power_state", "vm"],
      "properties": {
        "vm": { "type": "string", "resource_type": "VirtualMachine" },
        "name": { "type": "string" },
        "power_state": { "type": "string", "enum": ["POWERED_OFF", "POWERED_ON", "SUSPENDED"] },
        "cpu_count": { "type": "integer", "format": "int64" },
        "memory_size_mib": { "type": "integer", "format": "int64" }
      }
    },
    "Vapi.Std.Errors.Error": {
      "type": "object",
      "required": ["error_type", "messages"],
      "properties": {
        "messages": { "type": "array", "items": { "$ref": "Vapi.Std.LocalizableMessage" } },
        "data": { "type": "object" },
        "error_type": { "type": "string" }
      }
    },
    "Vapi.Std.Errors.Unauthenticated": {
      "allOf": ["Vapi.Std.Errors.Error"],
      "type": "object",
      "required": [],
      "properties": {
        "challenge": { "type": "string" }
      },
      "error_type_discriminator": "UNAUTHENTICATED",
      "notes": "Reported when the session identifier in the request's security context identifies a session that has expired. Surfaces as HTTP 401 on every operation secured by api_key_auth."
    },
    "Vapi.Std.LocalizableMessage": {
      "type": "object",
      "required": ["args", "default_message", "id"],
      "properties": {
        "id": { "type": "string" },
        "default_message": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

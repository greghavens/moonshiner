{
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "path": "specifications/nsx/openapi-2.0/nsx_policy_api.yaml",
    "blob_sha": "102d15fd342f6a45bb6d84a5b39a916c65929f4c",
    "license": "Apache-2.0"
  },
  "openapi": {
    "swagger": "2.0",
    "title": "NSX Policy API",
    "version": "9.1.0.0",
    "host": "nsxmanager.your.domain",
    "basePath": "/policy/api/v1",
    "schemes": [
      "https"
    ],
    "produces": [
      "application/json"
    ],
    "security": [
      {
        "BasicAuth": []
      }
    ],
    "securityDefinitions": {
      "BasicAuth": {
        "type": "basic",
        "description": "HTTP Basic Authentication"
      }
    }
  },
  "operations": {
    "CreateOrReplaceInfraSegment": {
      "operationId": "CreateOrReplaceInfraSegment",
      "method": "PUT",
      "path": "/infra/segments/{segment-id}",
      "consumes": [
        "application/json"
      ],
      "produces": [
        "application/json"
      ],
      "parameters": [
        {
          "name": "segment-id",
          "in": "path",
          "required": true,
          "type": "string"
        },
        {
          "name": "Segment",
          "in": "body",
          "required": true,
          "schema": "Segment"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "schema": "Segment"
        },
        "400": "BadRequest",
        "403": "Forbidden",
        "404": {
          "description": "Not Found"
        },
        "412": "PreconditionFailed",
        "500": "InternalServerError",
        "503": "ServiceUnavailable",
        "504": "GatewayTimeout"
      }
    },
    "ReadIntentStatus": {
      "operationId": "ReadIntentStatus",
      "method": "GET",
      "path": "/infra/realized-state/status",
      "consumes": [
        "application/json"
      ],
      "produces": [
        "application/json"
      ],
      "parameters": [
        {
          "name": "include_enforced_status",
          "in": "query",
          "required": false,
          "type": "boolean",
          "default": false
        },
        {
          "name": "intent_path",
          "in": "query",
          "required": true,
          "type": "string",
          "encoding_note": "forward slashes must be escaped using %2F"
        },
        {
          "name": "site_path",
          "in": "query",
          "required": false,
          "type": "string"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "schema": "ConsolidatedRealizedStatus"
        },
        "400": "BadRequest",
        "403": "Forbidden",
        "404": "NotFound",
        "412": "PreconditionFailed",
        "500": "InternalServerError",
        "503": "ServiceUnavailable",
        "504": "GatewayTimeout"
      }
    }
  },
  "schemas": {
    "Segment": {
      "allOf": [
        "PolicyConfigResource",
        "inline Segment properties"
      ],
      "required": [],
      "client_writable_projection": {
        "display_name": {
          "type": "string",
          "maxLength": 255,
          "source_schema": "ManagedResource"
        },
        "description": {
          "type": "string",
          "maxLength": 1024,
          "source_schema": "ManagedResource"
        },
        "connectivity_path": {
          "type": "string"
        },
        "subnets": {
          "type": "array",
          "items": "SegmentSubnet"
        },
        "transport_zone_path": {
          "type": "string"
        },
        "vlan_ids": {
          "type": "array",
          "items": "string"
        },
        "admin_state": {
          "type": "string",
          "enum": [
            "UP",
            "DOWN"
          ],
          "default": "UP"
        },
        "replication_mode": {
          "type": "string",
          "enum": [
            "MTEP",
            "SOURCE"
          ],
          "default": "MTEP"
        },
        "tags": {
          "type": "array",
          "items": "Tag",
          "maxItems": 30,
          "source_schema": "ManagedResource"
        }
      }
    },
    "SegmentSubnet": {
      "type": "object",
      "required": [],
      "writable_properties": {
        "dhcp_config": {
          "schema": "SegmentDhcpConfig"
        },
        "dhcp_ranges": {
          "type": "array",
          "items": "string",
          "minItems": 1,
          "maxItems": 99
        },
        "gateway_address": {
          "type": "string",
          "format": "ip-cidr-block"
        }
      },
      "read_only_properties": {
        "network": {
          "type": "string"
        }
      }
    },
    "ConsolidatedRealizedStatus": {
      "allOf": [
        "AggregatePolicyRuntimeInfo",
        "inline realized status properties"
      ],
      "required": [
        "publish_status"
      ],
      "properties": {
        "intent_path": {
          "type": "string",
          "readOnly": true,
          "source_schema": "AggregatePolicyRuntimeInfo"
        },
        "publish_status": {
          "type": "string",
          "description": "Aggregated Realization state of this object",
          "enum": [
            "UNAVAILABLE",
            "UNREALIZED",
            "REALIZED",
            "ERROR"
          ]
        },
        "consolidated_status": {
          "schema": "ConsolidatedStatus"
        }
      }
    },
    "ConsolidatedStatus": {
      "type": "object",
      "properties": {
        "consolidated_status": {
          "type": "string",
          "readOnly": true,
          "enum": [
            "SUCCESS",
            "IN_PROGRESS",
            "ERROR",
            "UNKNOWN",
            "UNINITIALIZED",
            "SANDBOXED_REALIZATION_PENDING",
            "DOWN",
            "DEGRAGED",
            "DISABLED"
          ]
        }
      }
    },
    "ApiError": {
      "allOf": [
        "RelatedApiError",
        "related_errors"
      ],
      "selected_properties": {
        "error_code": "integer/int64",
        "error_message": "string",
        "details": "string",
        "module_name": "string",
        "error_data": "object",
        "related_errors": "array<RelatedApiError>"
      }
    }
  },
  "client_policy": {
    "intent_path_template": "/infra/segments/{segment-id}",
    "poll_field": "publish_status",
    "pending_statuses": [
      "UNAVAILABLE",
      "UNREALIZED"
    ],
    "successful_terminal_statuses": [
      "REALIZED"
    ],
    "failed_terminal_statuses": [
      "ERROR"
    ],
    "poll_timing": "poll immediately; after a pending response sleep through the injected callable before the next poll; never sleep after the final allowed poll",
    "unset_optional_fields": "omit from JSON objects and query strings; do not serialize null, empty placeholders, or a trailing question mark"
  }
}

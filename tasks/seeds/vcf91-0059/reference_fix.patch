+++ b/nsx_segment_realizer/realize.py
@@ -0,0 +1,16 @@
+"""End-to-end segment intent and realization workflow."""
+
+from .models import SegmentSpec
+
+
+def realize_segment(client, segment_id, spec):
+    """Create/replace a segment, then wait for terminal policy realization."""
+    if not isinstance(spec, SegmentSpec):
+        # Keep validation ahead of any request even for alternate client objects.
+        from .errors import SpecError
+
+        raise SpecError("spec must be a SegmentSpec")
+    segment = client.create_or_replace_segment(segment_id, spec)
+    intent_path = f"/infra/segments/{segment_id}"
+    realization = client.wait_for_realization(intent_path)
+    return {"segment": segment, "realization": realization}

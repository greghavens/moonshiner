{
  "product": "VMware Cloud Foundation 9.1 SDDC Manager",
  "openapi": "3.0.1",
  "spec_version": "9.1.0.0",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json"
  },
  "operations": [
    {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": "TokenCreationSpec"
      },
      "responses": {
        "201": "TokenPair",
        "400": "Error",
        "500": "Error"
      }
    },
    {
      "operationId": "updateSystemConfiguration",
      "method": "PATCH",
      "path": "/v1/system",
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": "SystemUpdateSpec"
      },
      "responses": {
        "200": null,
        "400": "Error",
        "500": "Error"
      }
    },
    {
      "operationId": "updateProxyConfiguration",
      "method": "PATCH",
      "path": "/v1/system/proxy-configuration",
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": "ProxyConfiguration"
      },
      "responses": {
        "202": "Task",
        "400": "Error",
        "500": null
      }
    }
  ],
  "schemas": {
    "TokenCreationSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "apiKey": {
          "type": "string"
        },
        "idToken": {
          "type": "string"
        }
      }
    },
    "RefreshToken": {
      "type": "object",
      "required": [],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "TokenPair": {
      "type": "object",
      "required": [],
      "properties": {
        "accessToken": {
          "type": "string"
        },
        "refreshToken": {
          "$ref": "#/components/schemas/RefreshToken"
        }
      }
    },
    "SystemUpdateSpec": {
      "type": "object",
      "required": [
        "maxAllowedDomainsInSubscription"
      ],
      "properties": {
        "maxAllowedDomainsInSubscription": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "ProxyConfiguration": {
      "type": "object",
      "required": [],
      "properties": {
        "isConfigured": {
          "type": "boolean",
          "readOnly": true
        },
        "isEnabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "format": "int32"
        },
        "transferProtocol": {
          "type": "string",
          "enum": [
            "HTTP",
            "HTTPS"
          ]
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "isAuthenticated": {
          "type": "boolean"
        }
      }
    }
  }
}

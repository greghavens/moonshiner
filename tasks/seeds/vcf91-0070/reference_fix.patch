+func validatedOrigin(raw string) (string, error) {
+	if raw == "" || strings.TrimSpace(raw) != raw {
+		return "", errors.New("base URL must be an HTTP(S) origin")
+	}
+	parsed, err := url.Parse(raw)
+	if err != nil || (parsed.Scheme != "http" && parsed.Scheme != "https") ||
+		parsed.Host == "" || parsed.Hostname() == "" || parsed.Opaque != "" ||
+		parsed.User != nil || (parsed.Path != "" && parsed.Path != "/") ||
+		parsed.RawQuery != "" || parsed.ForceQuery || parsed.Fragment != "" {
+		return "", errors.New("base URL must be an HTTP(S) origin without credentials, path, query, or fragment")
+	}
+	return parsed.Scheme + "://" + parsed.Host, nil
+}
+
+func validCredential(value string) bool {
+	return strings.TrimSpace(value) != "" && !strings.ContainsAny(value, "\r\n\x00")
+}

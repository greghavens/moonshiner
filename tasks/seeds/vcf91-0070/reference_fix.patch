+func (c *Client) getPage(ctx context.Context, target string) (groupPage, error) {
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, target, nil)
+	if err != nil {
+		return groupPage{}, fmt.Errorf("create ListGroupForDomain request: %w", err)
+	}
+	request.Header.Set("Accept", "application/json")
+	request.SetBasicAuth(c.username, c.password)
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		return groupPage{}, fmt.Errorf("ListGroupForDomain transport failure: %w", err)
+	}
+	body, readErr := io.ReadAll(io.LimitReader(response.Body, maxResponseSize+1))
+	closeErr := response.Body.Close()
+	if readErr != nil {
+		return groupPage{}, fmt.Errorf("read ListGroupForDomain response: %w", readErr)
+	}
+	if closeErr != nil {
+		return groupPage{}, fmt.Errorf("close ListGroupForDomain response: %w", closeErr)
+	}
+	if len(body) > maxResponseSize {
+		return groupPage{}, &ProtocolError{Message: "ListGroupForDomain response exceeds size limit"}
+	}
+	if response.StatusCode != http.StatusOK {
+		return groupPage{}, decodeAPIError(response.StatusCode, body)
+	}
+	return decodePage(body)
+}
+
+func decodeAPIError(status int, body []byte) error {
+	var envelope apiErrorEnvelope
+	_ = json.Unmarshal(body, &envelope)
+	return &APIError{StatusCode: status, ErrorCode: envelope.ErrorCode,
+		ErrorMessage: envelope.ErrorMessage, ModuleName: envelope.ModuleName,
+		Details: envelope.Details}
+}
+
+func decodePage(body []byte) (groupPage, error) {
+	var page groupPage
+	decoder := json.NewDecoder(bytes.NewReader(body))
+	if err := decoder.Decode(&page); err != nil {
+		return groupPage{}, &ProtocolError{Message: "ListGroupForDomain returned malformed JSON"}
+	}
+	var extra any
+	if err := decoder.Decode(&extra); !errors.Is(err, io.EOF) {
+		return groupPage{}, &ProtocolError{Message: "ListGroupForDomain returned trailing JSON"}
+	}
+	if page.Results == nil {
+		return groupPage{}, &ProtocolError{Message: "ListGroupForDomain response is missing non-null results"}
+	}
+	return page, nil
 }

+func validatedOrigin(raw string) (string, error) {
+	if raw == "" || strings.TrimSpace(raw) != raw {
+		return "", errors.New("base URL must be an HTTP(S) origin")
+	}
+	parsed, err := url.Parse(raw)
+	if err != nil {
+		return "", errors.New("base URL must be an HTTP(S) origin")
+	}
+	if (parsed.Scheme != "http" && parsed.Scheme != "https") ||
+		parsed.Host == "" ||
+		parsed.Hostname() == "" ||
+		parsed.Opaque != "" ||
+		parsed.User != nil ||
+		(parsed.Path != "" && parsed.Path != "/") ||
+		parsed.RawQuery != "" ||
+		parsed.ForceQuery ||
+		parsed.Fragment != "" {
+		return "", errors.New(
+			"base URL must be an HTTP(S) origin without credentials, path, query, or fragment",
+		)
+	}
+	return parsed.Scheme + "://" + parsed.Host, nil
+}
+
+func validToken(token string) bool {
+	if strings.TrimSpace(token) == "" {
+		return false
+	}
+	return !strings.ContainsAny(token, "\r\n\x00")
+}
+
+func (c *Client) currentToken() string {
+	c.tokenMu.Lock()
+	defer c.tokenMu.Unlock()
+	return c.token
+}
+
+func (c *Client) refreshToken(
+	ctx context.Context,
+	stale string,
+) (string, error) {
+	c.tokenMu.Lock()
+	defer c.tokenMu.Unlock()
+
+	if c.token != stale {
+		return c.token, nil
+	}
+	fresh, err := c.refresh(ctx, stale)
+	if err != nil {
+		return "", fmt.Errorf("refresh access token: %w", err)
+	}
+	if !validToken(fresh) || fresh == stale {
+		return "", errors.New(
+			"refresh function returned an invalid replacement access token",
+		)
+	}
+	c.token = fresh
+	return fresh, nil
+}
+
+func (c *Client) getPage(
+	ctx context.Context,
+	target string,
+) (groupPage, error) {
+	token := c.currentToken()
+	for attempt := 0; attempt < 2; attempt++ {
+		request, err := http.NewRequestWithContext(
+			ctx,
+			http.MethodGet,
+			target,
+			nil,
+		)
+		if err != nil {
+			return groupPage{}, fmt.Errorf(
+				"create ListGroupForDomain request: %w",
+				err,
+			)
+		}
+		request.Header.Set("Accept", "application/json")
+		request.Header.Set("Authorization", "Bearer "+token)
+
+		response, err := c.httpClient.Do(request)
+		if err != nil {
+			return groupPage{}, fmt.Errorf(
+				"ListGroupForDomain transport failure: %w",
+				err,
+			)
+		}
+		if response.StatusCode == http.StatusUnauthorized && attempt == 0 {
+			_, _ = io.Copy(
+				io.Discard,
+				io.LimitReader(response.Body, maxResponseSize),
+			)
+			_ = response.Body.Close()
+			token, err = c.refreshToken(ctx, token)
+			if err != nil {
+				return groupPage{}, err
+			}
+			continue
+		}
+
+		body, readErr := io.ReadAll(
+			io.LimitReader(response.Body, maxResponseSize+1),
+		)
+		closeErr := response.Body.Close()
+		if readErr != nil {
+			return groupPage{}, fmt.Errorf(
+				"read ListGroupForDomain response: %w",
+				readErr,
+			)
+		}
+		if closeErr != nil {
+			return groupPage{}, fmt.Errorf(
+				"close ListGroupForDomain response: %w",
+				closeErr,
+			)
+		}
+		if len(body) > maxResponseSize {
+			return groupPage{}, &ProtocolError{
+				Message: "ListGroupForDomain response exceeds size limit",
+			}
+		}
+		if response.StatusCode != http.StatusOK {
+			return groupPage{}, decodeAPIError(response.StatusCode, body)
+		}
+		return decodePage(body)
+	}
+	return groupPage{}, &ProtocolError{
+		Message: "ListGroupForDomain exhausted its authentication retry",
+	}
+}
+
+func decodeAPIError(status int, body []byte) error {
+	var envelope apiErrorEnvelope
+	_ = json.Unmarshal(body, &envelope)
+	return &APIError{
+		StatusCode:   status,
+		ErrorCode:    envelope.ErrorCode,
+		ErrorMessage: envelope.ErrorMessage,
+		ModuleName:   envelope.ModuleName,
+		Details:      envelope.Details,
+	}
+}
+
+func decodePage(body []byte) (groupPage, error) {
+	var page groupPage
+	decoder := json.NewDecoder(bytes.NewReader(body))
+	if err := decoder.Decode(&page); err != nil {
+		return groupPage{}, &ProtocolError{
+			Message: "ListGroupForDomain returned malformed JSON",
+		}
+	}
+	var extra any
+	if err := decoder.Decode(&extra); !errors.Is(err, io.EOF) {
+		return groupPage{}, &ProtocolError{
+			Message: "ListGroupForDomain returned trailing JSON",
+		}
+	}
+	if page.Results == nil {
+		return groupPage{}, &ProtocolError{
+			Message: "ListGroupForDomain response is missing non-null results",
+		}
+	}
+	return page, nil
 }

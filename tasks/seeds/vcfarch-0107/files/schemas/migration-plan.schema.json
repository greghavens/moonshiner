{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF Brownfield Fleet Migration Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "inventoryId",
    "targetFleet",
    "gates",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "inventoryId": {
      "type": "string",
      "minLength": 1
    },
    "targetFleet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "product",
        "version",
        "onboardingMode"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "const": "VMware Cloud Foundation"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "onboardingMode": {
          "const": "VCF_INSTALLER_CONVERGE"
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "satisfiedBy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "satisfiedBy": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "componentId",
          "componentName",
          "componentType",
          "currentVersion",
          "targetProduct",
          "targetVersion",
          "upgradePath",
          "action",
          "gates",
          "after",
          "outcome"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "componentName": {
            "type": "string",
            "minLength": 1
          },
          "componentType": {
            "enum": [
              "VCENTER",
              "ESXI",
              "VSAN",
              "NSX",
              "LIVE_SITE_RECOVERY",
              "VSPHERE_REPLICATION"
            ]
          },
          "currentVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetProduct": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "upgradePath": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "action": {
            "enum": [
              "CONVERGE",
              "UPGRADE",
              "IMPORT",
              "REPLACE"
            ]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "after": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

 Set-StrictMode -Version Latest
 
+function Read-JsonDocument {
+    param(
+        [Parameter(Mandatory)]
+        [string] $Path
+    )
+
+    $resolved = Resolve-Path -LiteralPath $Path -ErrorAction Stop
+    return Get-Content -LiteralPath $resolved -Raw -Encoding utf8 | ConvertFrom-Json -Depth 100
+}
+
+function ConvertTo-LowerCamelJsonShape {
+    param(
+        [Parameter(Mandatory, ValueFromPipeline)]
+        [AllowNull()]
+        [object] $InputObject
+    )
+
+    if ($null -eq $InputObject) {
+        return $null
+    }
+
+    if ($InputObject -is [System.Collections.IDictionary]) {
+        $converted = [ordered] @{}
+        foreach ($entry in $InputObject.GetEnumerator()) {
+            if ($null -eq $entry.Value -or $entry.Key -eq 'AdditionalProperties') {
+                continue
+            }
+            $name = [string] $entry.Key
+            $lowerName = $name.Substring(0, 1).ToLowerInvariant() + $name.Substring(1)
+            $converted[$lowerName] = ConvertTo-LowerCamelJsonShape -InputObject $entry.Value
+        }
+        return $converted
+    }
+
+    if ($InputObject -is [System.Collections.IEnumerable] -and $InputObject -isnot [string]) {
+        $items = [System.Collections.Generic.List[object]]::new()
+        foreach ($item in $InputObject) {
+            $items.Add((ConvertTo-LowerCamelJsonShape -InputObject $item))
+        }
+        return ,$items.ToArray()
+    }
+
+    return $InputObject
+}
+
+function ConvertFrom-VcfSdkObject {
+    param(
+        [Parameter(Mandatory)]
+        [object] $InputObject
+    )
+
+    $sdkJson = $InputObject | ConvertTo-Json -Depth 100
+    $sdkHashtable = $sdkJson | ConvertFrom-Json -AsHashtable -Depth 100
+    return ConvertTo-LowerCamelJsonShape -InputObject $sdkHashtable
+}
+
+function Write-JsonDocument {
+    param(
+        [Parameter(Mandatory)]
+        [object] $InputObject,
+
+        [Parameter(Mandatory)]
+        [string] $Path
+    )
+
+    $json = $InputObject | ConvertTo-Json -Depth 100
+    [System.IO.File]::WriteAllText(
+        $Path,
+        $json + [Environment]::NewLine,
+        [System.Text.UTF8Encoding]::new($false)
+    )
+}

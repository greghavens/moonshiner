 function New-VcfFleetArchitecture {
     [CmdletBinding()]
     param(
@@ -17,7 +90,183 @@ function New-VcfFleetArchitecture {
         [string] $OutputDirectory
     )
 
-    throw 'Implement the architecture generator.'
+    $inventory = Read-JsonDocument -Path $InventoryPath
+    $snapshot = Read-JsonDocument -Path $CompatibilitySnapshotPath
+    $profile = $snapshot.storageProfiles.PSObject.Properties[$StorageArchitecture].Value
+    if ($null -eq $profile) {
+        throw "The compatibility snapshot has no $StorageArchitecture profile."
+    }
+    if ($inventory.targetVcfVersion -ne $snapshot.targetFleet.version) {
+        throw 'The estate target does not match the compatibility snapshot target.'
+    }
+    if ($inventory.greenfield.hostPool.Count -lt $profile.hostCount) {
+        throw "The greenfield host pool cannot satisfy the $StorageArchitecture host count."
+    }
+
+    $greenfield = $inventory.greenfield
+    $design = $greenfield.design
+    $targetVersion = [string] $snapshot.targetFleet.version
+
+    $dnsSpec = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $greenfield.dnsSubdomain `
+        -Nameservers @($greenfield.dnsServers)
+
+    $vcenterSpec = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname $greenfield.vcenterHostname `
+        -RootVcenterPassword $greenfield.vcenterRootPassword `
+        -VmSize $design.vcenterVmSize `
+        -StorageSize $design.vcenterStorageSize `
+        -SsoDomain $design.ssoDomain `
+        -Version $targetVersion `
+        -UseExistingDeployment:$design.useExistingDeployment
+
+    $clusterSpec = Initialize-VcfInstallerSddcClusterSpec `
+        -DatacenterName $design.datacenterName `
+        -ClusterName $design.clusterName
+
+    $hostSpecs = @(
+        $greenfield.hostPool |
+            Select-Object -First $profile.hostCount |
+            ForEach-Object {
+                Initialize-VcfInstallerSddcHostSpec -Hostname $_
+            }
+    )
+
+    $networkSpecs = @(
+        foreach ($network in $greenfield.networks) {
+            Initialize-VcfInstallerSddcNetworkSpec `
+                -NetworkType $network.networkType `
+                -VlanId $network.vlanId `
+                -Subnet $network.subnet `
+                -Gateway $network.gateway `
+                -SubnetMask $network.subnetMask `
+                -Mtu $network.mtu `
+                -IpAddressVersion $design.ipAddressVersion `
+                -IpAddressAssignmentMode $design.ipAddressAssignmentMode
+        }
+    )
+
+    $dvsSpecs = @(
+        foreach ($dvs in $profile.dvs) {
+            $uplinkNumber = 0
+            $mappings = @(
+                foreach ($vmnic in $dvs.vmnics) {
+                    $uplinkNumber += 1
+                    Initialize-VcfInstallerVmnicToUplink `
+                        -Id $vmnic `
+                        -Uplink "uplink$uplinkNumber"
+                }
+            )
+            Initialize-VcfInstallerDvsSpec `
+                -DvsName $dvs.name `
+                -Networks @($dvs.networks) `
+                -Mtu $design.dvsMtu `
+                -VmnicsToUplinks $mappings
+        }
+    )
+
+    $esaConfig = Initialize-VcfInstallerVsanEsaConfig -Enabled:$profile.vsanEsaEnabled
+    $vsanSpec = Initialize-VcfInstallerVsanSpec `
+        -DatastoreName $design.datastoreName `
+        -VsanDedup:$design.vsanDedup `
+        -EsaConfig $esaConfig `
+        -FailuresToTolerate $design.failuresToTolerate
+    $datastoreSpec = Initialize-VcfInstallerSddcDatastoreSpec -VsanSpec $vsanSpec
+
+    $nsxManagers = @(
+        foreach ($hostname in $greenfield.nsxManagerHostnames) {
+            Initialize-VcfInstallerNsxtManagerSpec -Hostname $hostname
+        }
+    )
+    $nsxtSpec = Initialize-VcfInstallerSddcNsxtSpec `
+        -NsxtManagers $nsxManagers `
+        -NsxtManagerSize $design.nsxtManagerSize `
+        -VipFqdn $greenfield.nsxVipFqdn `
+        -TransportVlanId $greenfield.nsxTransportVlanId `
+        -Version $targetVersion `
+        -UseExistingDeployment:$design.useExistingDeployment
+    $sddcManagerSpec = Initialize-VcfInstallerSddcManagerSpec `
+        -Hostname $greenfield.sddcManagerHostname `
+        -Version $targetVersion `
+        -UseExistingDeployment:$design.useExistingDeployment
+
+    $sddcParameters = @{
+        SddcId = $greenfield.sddcId
+        WorkflowType = $design.workflowType
+        HostSpecs = $hostSpecs
+        Version = $targetVersion
+        VcenterSpec = $vcenterSpec
+        ClusterSpec = $clusterSpec
+        DvsSpecs = $dvsSpecs
+        NsxtSpec = $nsxtSpec
+        NetworkSpecs = $networkSpecs
+        DnsSpec = $dnsSpec
+        NtpServers = @($greenfield.ntpServers)
+        SddcManagerSpec = $sddcManagerSpec
+        ManagementPoolName = $design.managementPoolName
+        CeipEnabled = $design.ceipEnabled
+        SkipEsxThumbprintValidation = $design.skipEsxThumbprintValidation
+        SkipGatewayPingValidation = $design.skipGatewayPingValidation
+        DatastoreSpec = $datastoreSpec
+        VcfInstanceName = $greenfield.vcfInstanceName
+    }
+    $sdkSddcSpec = Initialize-VcfInstallerSddcSpec @sddcParameters
+    $sddcSpec = ConvertFrom-VcfSdkObject -InputObject $sdkSddcSpec
+
+    $manifest = [ordered] @{
+        schemaVersion = '1.0'
+        inventoryId = $inventory.inventoryId
+        targetVcfVersion = $targetVersion
+        storageArchitecture = $StorageArchitecture
+        hostCount = [int] $profile.hostCount
+        physicalNicsPerHost = [int] $profile.physicalNicsPerHost
+        physicalNicSpeedGbps = [int] $profile.physicalNicSpeedGbps
+        networkTopology = $profile.networkTopology
+        sddcSpecPath = 'sddc-spec.json'
+        migrationPlanPath = 'migration-plan.json'
+    }
+
+    $steps = @(
+        foreach ($component in $inventory.components) {
+            $rule = $snapshot.componentRules.PSObject.Properties[$component.id].Value
+            if ($null -eq $rule) {
+                throw "The compatibility snapshot has no rule for component $($component.id)."
+            }
+            [ordered] @{
+                order = [int] $rule.order
+                componentId = $component.id
+                componentName = $component.name
+                componentType = $component.type
+                currentVersion = $component.version
+                targetProduct = $rule.targetProduct
+                targetVersion = $rule.targetVersion
+                upgradePath = @($rule.upgradePath)
+                action = $rule.action
+                gates = @($rule.requiredGates)
+                after = @($rule.after)
+                outcome = "$($component.name) is managed as $($rule.targetProduct) $($rule.targetVersion) in $($inventory.fleetName)."
+            }
+        }
+    ) | Sort-Object -Property order
+
+    $migrationPlan = [ordered] @{
+        schemaVersion = '1.0'
+        inventoryId = $inventory.inventoryId
+        targetFleet = [ordered] @{
+            name = $inventory.fleetName
+            product = $snapshot.targetFleet.product
+            version = $targetVersion
+            onboardingMode = $snapshot.targetFleet.onboardingMode
+        }
+        gates = @($snapshot.gateCatalog)
+        steps = @($steps)
+    }
+
+    $null = New-Item -ItemType Directory -Path $OutputDirectory -Force
+    $resolvedOutput = (Resolve-Path -LiteralPath $OutputDirectory).Path
+    Write-JsonDocument -InputObject $sddcSpec -Path (Join-Path $resolvedOutput 'sddc-spec.json')
+    Write-JsonDocument -InputObject $manifest -Path (Join-Path $resolvedOutput 'architecture-manifest.json')
+    Write-JsonDocument -InputObject $migrationPlan -Path (Join-Path $resolvedOutput 'migration-plan.json')
 }
 
 Export-ModuleMember -Function New-VcfFleetArchitecture

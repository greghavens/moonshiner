{
  "openapi": "3.0.1",
  "info": {
    "title": "SDDC Manager API Reference Guide",
    "description": "SDDC Manager is an integrated software stack that bundles the VMware virtualization and management components like compute virtualization (vSphere), storage virtualization (vSAN) and network virtualization (NSX)",
    "termsOfService": "https://www.vmware.com",
    "license": {"name": "VMware Cloud Foundation"},
    "version": "9.1.0.0"
  },
  "paths": {
    "/v1/services-config": {
      "put": {
        "tags": ["ServicesConfig"],
        "summary": "Update external services connection configs.",
        "description": "Update external services connection configs.",
        "operationId": "updateServicesConfig",
        "parameters": [
          {
            "name": "skipStrictValidation",
            "in": "query",
            "description": "Skip strict validation, such as connectivity check",
            "required": false,
            "schema": {"type": "boolean", "default": false}
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/ServicesConfig"}
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ServicesConfig"}
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"}
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Error"}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ServicesConfig": {
        "required": ["services"],
        "type": "object",
        "properties": {
          "services": {
            "type": "array",
            "description": "External services configurations",
            "items": {"$ref": "#/components/schemas/ServiceConfig"}
          }
        },
        "description": "External services configurations."
      },
      "ServiceConfig": {
        "required": ["key", "name", "nodes", "type"],
        "type": "object",
        "properties": {
          "name": {"type": "string", "description": "External service name"},
          "type": {"type": "string", "description": "External service type", "example": "One among: VCF_DEPOT"},
          "key": {"type": "string", "description": "External service key, identifier for the service unique across the fleet"},
          "version": {"type": "string", "description": "External service version"},
          "nodes": {
            "type": "array",
            "description": "List of nodes belonging to the same external service",
            "items": {"$ref": "#/components/schemas/ServiceNode"}
          }
        },
        "description": "External service configurations."
      },
      "ServiceNode": {
        "required": ["addresses", "name"],
        "type": "object",
        "properties": {
          "name": {"type": "string", "description": "Service node name"},
          "addresses": {
            "type": "array",
            "description": "Service node addresses",
            "items": {"$ref": "#/components/schemas/ServiceNodeAddress"}
          },
          "port": {"type": "string", "description": "Service node port"},
          "baseUrl": {"type": "string", "description": "Service node base url"},
          "certificates": {
            "type": "array",
            "description": "Service node certificates",
            "items": {"type": "string", "description": "Service node certificates"}
          }
        },
        "description": "External service node configurations."
      },
      "ServiceNodeAddress": {
        "required": ["type", "value"],
        "type": "object",
        "properties": {
          "type": {"type": "string", "description": "Service node address type", "example": "One among: fqdn, ipv4, ipv6"},
          "value": {"type": "string", "description": "Service node address value"}
        },
        "description": "External service node address configurations."
      },
      "Error": {
        "type": "object",
        "properties": {
          "errorCode": {"type": "string", "description": "The minor error code", "readOnly": true},
          "message": {"type": "string", "description": "The localized error message", "readOnly": true},
          "remediationMessage": {"type": "string", "description": "The localized remediation error message"},
          "referenceToken": {"type": "string", "description": "A reference token correlating the error with the relevant detailed error logs.", "readOnly": true}
        },
        "description": "Error response containing a minor error code, a localized error message, a localized remediation message and optionally a reference token to correlate the error with the logs"
      }
    }
  }
}

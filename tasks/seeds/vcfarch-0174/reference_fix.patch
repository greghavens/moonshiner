+"""Offline semantic validation for ``migration_plan.json``."""
+
+from __future__ import annotations
+
+import datetime as dt
+import json
+import re
+from pathlib import Path
+from typing import Any, Mapping
+
+
+def _schema_errors(
+    value: Any,
+    schema: Mapping[str, Any],
+    root: Mapping[str, Any] | None = None,
+    path: str = "$",
+    errors: list[str] | None = None,
+) -> list[str]:
+    """Validate the JSON-Schema features used by migration_plan.schema.json."""
+    if root is None:
+        root = schema
+    if errors is None:
+        errors = []
+    if "$ref" in schema:
+        target: Any = root
+        for part in schema["$ref"].removeprefix("#/").split("/"):
+            target = target[part.replace("~1", "/").replace("~0", "~")]
+        return _schema_errors(value, target, root, path, errors)
+
+    json_types = {
+        "object": lambda item: isinstance(item, Mapping),
+        "array": lambda item: isinstance(item, list),
+        "string": lambda item: isinstance(item, str),
+        "integer": lambda item: isinstance(item, int) and not isinstance(item, bool),
+        "number": lambda item: isinstance(item, (int, float)) and not isinstance(item, bool),
+        "boolean": lambda item: isinstance(item, bool),
+        "null": lambda item: item is None,
+    }
+    expected = schema.get("type")
+    if expected is not None:
+        expected_types = expected if isinstance(expected, list) else [expected]
+        if not any(json_types[name](value) for name in expected_types):
+            errors.append(f"{path} has the wrong JSON type")
+            return errors
+    if "const" in schema and value != schema["const"]:
+        errors.append(f"{path} does not equal its required constant")
+    if "enum" in schema and value not in schema["enum"]:
+        errors.append(f"{path} is not an allowed value")
+
+    if isinstance(value, str):
+        if len(value) < schema.get("minLength", 0):
+            errors.append(f"{path} is shorter than minLength")
+        if schema.get("format") == "date":
+            try:
+                dt.date.fromisoformat(value)
+            except ValueError:
+                errors.append(f"{path} is not an ISO date")
+        if schema.get("format") == "uri" and not re.match(
+            r"^[A-Za-z][A-Za-z0-9+.-]*:[^\s]+$", value
+        ):
+            errors.append(f"{path} is not an absolute URI")
+    if isinstance(value, (int, float)) and not isinstance(value, bool):
+        if "minimum" in schema and value < schema["minimum"]:
+            errors.append(f"{path} is below minimum")
+    if isinstance(value, list):
+        if len(value) < schema.get("minItems", 0):
+            errors.append(f"{path} has too few items")
+        if "maxItems" in schema and len(value) > schema["maxItems"]:
+            errors.append(f"{path} has too many items")
+        if "items" in schema:
+            for index, item in enumerate(value):
+                _schema_errors(item, schema["items"], root, f"{path}[{index}]", errors)
+    if isinstance(value, Mapping):
+        if len(value) < schema.get("minProperties", 0):
+            errors.append(f"{path} has too few properties")
+        properties = schema.get("properties", {})
+        for name in schema.get("required", []):
+            if name not in value:
+                errors.append(f"{path} is missing required property {name}")
+        if schema.get("additionalProperties") is False:
+            for name in sorted(set(value) - set(properties)):
+                errors.append(f"{path} has unexpected property {name}")
+        for name, item in value.items():
+            if name in properties:
+                _schema_errors(item, properties[name], root, f"{path}.{name}", errors)
+            elif isinstance(schema.get("additionalProperties"), Mapping):
+                _schema_errors(
+                    item,
+                    schema["additionalProperties"],
+                    root,
+                    f"{path}.{name}",
+                    errors,
+                )
+    return errors
+
+
+def _plan_schema_errors(plan: Mapping[str, Any]) -> list[str]:
+    schema_path = Path(__file__).resolve().parents[1] / "migration_plan.schema.json"
+    try:
+        with schema_path.open("r", encoding="utf-8") as handle:
+            schema = json.load(handle)
+    except (OSError, json.JSONDecodeError) as exc:
+        return [f"cannot load migration plan schema: {exc}"]
+    return _schema_errors(plan, schema)
+
+
+def _index(items: Any, key: str, label: str, errors: list[str]) -> dict[str, dict]:
+    result: dict[str, dict] = {}
+    if not isinstance(items, list):
+        errors.append(f"{label} must be an array")
+        return result
+    for item in items:
+        if not isinstance(item, dict) or not isinstance(item.get(key), str):
+            errors.append(f"{label} entries require string {key}")
+            continue
+        value = item[key]
+        if value in result:
+            errors.append(f"duplicate {label} {value}")
+        result[value] = item
+    return result
+
+
+def validate_plan(
+    plan: Mapping[str, Any],
+    inventory: Mapping[str, Any],
+    snapshot: Mapping[str, Any],
+) -> list[str]:
+    """Return every deterministic incompatibility in *plan*.
+
+    This function deliberately has no network dependency.
+    """
+    errors: list[str] = []
+    if not isinstance(plan, Mapping):
+        return ["plan must be an object"]
+    errors.extend(_plan_schema_errors(plan))
+    if plan.get("schema_version") != "1.0":
+        errors.append("schema_version must be 1.0")
+    if plan.get("estate_id") != inventory.get("estate_id"):
+        errors.append("estate_id contradicts inventory")
+    if plan.get("compatibility_snapshot_id") != snapshot.get("snapshot_id"):
+        errors.append("compatibility_snapshot_id contradicts snapshot")
+
+    target = inventory["fleet"]["new_workload_domain"]
+    rules = snapshot["placement_rules"]
+    placement = plan.get("placement")
+    if not isinstance(placement, Mapping):
+        errors.append("placement must be an object")
+        placement = {}
+    if placement.get("domain_id") != rules["required_domain_id"]:
+        errors.append("placement must use the required workload domain")
+    if placement.get("cluster_id") != rules["required_cluster_id"]:
+        errors.append("placement must use the required workload cluster")
+    if placement.get("management_domain_changes") != []:
+        errors.append("management_domain_changes must be empty")
+    if placement.get("host_count") != target["host_count"]:
+        errors.append("host_count contradicts the workload-domain inventory")
+    if placement.get("failures_to_tolerate") != target["failures_to_tolerate"]:
+        errors.append("failures_to_tolerate contradicts the workload-domain inventory")
+    if placement.get("storage_policy") != target["storage_policy"]:
+        errors.append("storage_policy contradicts the workload-domain inventory")
+    if placement.get("anti_affinity_scope") != rules["anti_affinity_scope"]:
+        errors.append("anti_affinity_scope contradicts the placement rules")
+    host_count = placement.get("host_count")
+    ftt = placement.get("failures_to_tolerate")
+    if isinstance(host_count, int) and isinstance(ftt, int):
+        required = rules["raid1_hosts_per_failure"] * ftt + rules["raid1_witness_hosts"]
+        if placement.get("required_hosts_for_ftt") != required:
+            errors.append("required_hosts_for_ftt must equal 2*failures_to_tolerate+1")
+        if host_count < required:
+            errors.append("host_count cannot satisfy failures_to_tolerate under RAID-1")
+
+    components = _index(placement.get("components"), "component", "components", errors)
+    if set(components) != set(snapshot["sizing_profiles"]):
+        errors.append("components must cover every target component exactly once")
+    reservation: dict[str, float] = {"vcpu": 0, "memory_gib": 0, "storage_tib": 0}
+    demand_names = {
+        "VCF Operations": "operations",
+        "VCF Automation": "automation",
+        "VCF Operations for Logs": "logs",
+    }
+    demand_fields = {
+        "VCF Operations": ("objects", "collected_metrics", "availability"),
+        "VCF Automation": ("active_deployments", "concurrent_users", "availability"),
+        "VCF Operations for Logs": (
+            "events_per_second",
+            "ingestion_gib_per_day",
+            "active_tcp_connections",
+            "availability",
+        ),
+    }
+    for name, profile in snapshot["sizing_profiles"].items():
+        component = components.get(name)
+        if component is None:
+            errors.append(f"missing component placement: {name}")
+            continue
+        if component.get("version") != profile["version"]:
+            errors.append(f"{name} version contradicts sizing snapshot")
+        if component.get("profile") != profile["profile"]:
+            errors.append(f"{name} profile contradicts sizing snapshot")
+        if component.get("node_count") != profile["minimum_nodes"]:
+            errors.append(f"{name} node_count contradicts sizing snapshot")
+        if component.get("anti_affinity") is not True:
+            errors.append(f"{name} anti_affinity must be true")
+        resources = component.get("resources_per_node")
+        if not isinstance(resources, Mapping):
+            errors.append(f"{name} resources_per_node must be an object")
+            continue
+        for output, source in (
+            ("vcpu", "vcpu_each"),
+            ("memory_gib", "memory_gib_each"),
+            ("storage_tib", "storage_tib_each"),
+        ):
+            if resources.get(output) != profile[source]:
+                errors.append(f"{name} {output} contradicts sizing snapshot")
+            count = component.get("node_count")
+            if isinstance(count, int) and isinstance(resources.get(output), (int, float)):
+                reservation[output] += count * resources[output]
+        stated_demand = component.get("demand_satisfied")
+        if not isinstance(stated_demand, Mapping):
+            errors.append(f"{name} demand_satisfied must be an object")
+        demand = inventory["demand"][demand_names[name]]
+        if isinstance(stated_demand, Mapping):
+            for field in demand_fields[name]:
+                if stated_demand.get(field) != demand[field]:
+                    errors.append(f"{name} demand_satisfied.{field} contradicts inventory")
+        capacity = profile["effective_capacity"]
+        for metric in sorted(set(demand).intersection(capacity)):
+            if isinstance(capacity[metric], (int, float)) and capacity[metric] < demand[metric]:
+                errors.append(f"{name} sizing does not satisfy {metric}")
+
+    normalized_reservation = {
+        key: int(value) if value == int(value) else value for key, value in reservation.items()
+    }
+    if placement.get("target_reservation") != normalized_reservation:
+        errors.append("target_reservation does not equal component totals")
+    expected_headroom = {
+        key: target["available_capacity"][key] - normalized_reservation[key]
+        for key in normalized_reservation
+    }
+    if placement.get("capacity_headroom") != expected_headroom:
+        errors.append("capacity_headroom does not reconcile to inventory")
+    if any(value < 0 for value in expected_headroom.values()):
+        errors.append("target reservation exceeds available capacity")
+
+    gates = _index(plan.get("gates"), "id", "gates", errors)
+    for gate_id, gate in gates.items():
+        if gate.get("kind") not in ("technical", "data"):
+            errors.append(f"gate {gate_id} has invalid kind")
+        if not all(gate.get(field) for field in ("condition", "evidence", "on_failure")):
+            errors.append(f"gate {gate_id} is incomplete")
+
+    migrations = _index(plan.get("migrations"), "product_id", "migrations", errors)
+    source_products = {item["id"]: item for item in inventory["source_products"]}
+    if set(migrations) != set(source_products):
+        errors.append("migrations must cover every source product exactly once")
+    for product_id, source in source_products.items():
+        migration = migrations.get(product_id)
+        if migration is None:
+            continue
+        rule = snapshot["product_rules"][product_id]
+        if migration.get("source") != {
+            "product": source["product"],
+            "version": source["version"],
+        }:
+            errors.append(f"{product_id} source product/version contradicts inventory")
+        if migration.get("target") != {
+            "product": rule["target_component"],
+            "version": rule["target_version"],
+        }:
+            errors.append(f"{product_id} target product/version contradicts snapshot")
+        for field in (
+            "transition_method",
+            "version_path",
+            "direct_in_place_supported",
+            "transition_parameters",
+        ):
+            if migration.get(field) != rule[field]:
+                errors.append(f"{product_id} {field} contradicts compatibility snapshot")
+        boundary = migration.get("support_boundary")
+        if not isinstance(boundary, Mapping) or boundary.get("source_eogs") != rule["source_eogs"]:
+            errors.append(f"{product_id} source EOGS contradicts snapshot")
+        elif not isinstance(boundary.get("planning_effect"), str) or not boundary["planning_effect"]:
+            errors.append(f"{product_id} support boundary is incomplete")
+        migration_gates = migration.get("gate_ids")
+        if not isinstance(migration_gates, list):
+            errors.append(f"{product_id} gate_ids must be an array")
+            migration_gates = []
+        for required_gate in rule["required_gate_ids"]:
+            if required_gate not in migration_gates:
+                errors.append(f"{product_id} missing gate {required_gate}")
+        for gate_id in migration_gates:
+            if isinstance(gate_id, str) and gate_id not in gates:
+                errors.append(f"{product_id} references unknown gate {gate_id}")
+        migration_gate_kinds = {
+            gates[gate_id].get("kind")
+            for gate_id in migration_gates
+            if isinstance(gate_id, str)
+            and gate_id in gates
+            and isinstance(gates[gate_id].get("kind"), str)
+        }
+        if not {"technical", "data"}.issubset(migration_gate_kinds):
+            errors.append(f"{product_id} must have both technical and data gates")
+        dispositions = _index(
+            migration.get("content_dispositions"),
+            "item_id",
+            f"{product_id} content_dispositions",
+            errors,
+        )
+        expected_ids = {item["id"] for item in source["items"]}
+        if set(dispositions) != expected_ids:
+            errors.append(f"{product_id} content_dispositions do not partition inventory")
+        for item_id, expected in rule["item_dispositions"].items():
+            item = dispositions.get(item_id)
+            if item is not None and item.get("disposition") != expected:
+                errors.append(f"{item_id} disposition contradicts compatibility snapshot")
+            if item is not None and not all(item.get(field) for field in ("mechanism", "reason")):
+                errors.append(f"{item_id} disposition is incomplete")
+
+    steps = plan.get("steps")
+    step_map = _index(steps, "id", "steps", errors)
+    if isinstance(steps, list):
+        if [step.get("order") for step in steps if isinstance(step, Mapping)] != list(
+            range(1, len(steps) + 1)
+        ):
+            errors.append("steps must have contiguous ordered sequence")
+        positions = {step_id: index for index, step_id in enumerate(step_map)}
+        for index, step in enumerate(steps):
+            if not isinstance(step, Mapping):
+                continue
+            step_gate_ids = step.get("gate_ids")
+            if not isinstance(step_gate_ids, list) or not step_gate_ids:
+                errors.append(f"step {step.get('id')} must be gated")
+            else:
+                for gate_id in step_gate_ids:
+                    if isinstance(gate_id, str) and gate_id not in gates:
+                        errors.append(f"step {step.get('id')} references unknown gate")
+            dependencies = step.get("depends_on")
+            if not isinstance(dependencies, list):
+                errors.append(f"step {step.get('id')} depends_on must be an array")
+            else:
+                for dependency in dependencies:
+                    if isinstance(dependency, str) and (
+                        dependency not in positions or positions[dependency] >= index
+                    ):
+                        errors.append(f"step {step.get('id')} has invalid dependency")
+            product_id = step.get("product_id")
+            if product_id is not None and (
+                not isinstance(product_id, str) or product_id not in source_products
+            ):
+                errors.append(f"step {step.get('id')} references unknown product_id")
+            if not isinstance(step.get("action"), str) or not step["action"]:
+                errors.append(f"step {step.get('id')} needs an action")
+            if not isinstance(step.get("produces"), list) or not step["produces"]:
+                errors.append(f"step {step.get('id')} needs outputs")
+        milestones = snapshot["required_milestones"]
+        found = [positions[item] for item in milestones if item in positions]
+        if len(found) != len(milestones):
+            errors.append("required migration milestone is missing")
+        elif found != sorted(found):
+            errors.append("required migration milestones are out of order")
+    return errors
+
+
+def validate_files(
+    plan_path: str | Path,
+    inventory_path: str | Path,
+    snapshot_path: str | Path,
+) -> list[str]:
+    """Load three JSON documents and validate the plan against its authorities."""
+    try:
+        with Path(plan_path).open("r", encoding="utf-8") as handle:
+            plan = json.load(handle)
+        with Path(inventory_path).open("r", encoding="utf-8") as handle:
+            inventory = json.load(handle)
+        with Path(snapshot_path).open("r", encoding="utf-8") as handle:
+            snapshot = json.load(handle)
+    except (OSError, json.JSONDecodeError) as exc:
+        return [str(exc)]
+    return validate_plan(plan, inventory, snapshot)

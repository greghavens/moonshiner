+"""Command line entry point for ``vcf_architecture``."""
+
+from __future__ import annotations
+
+import argparse
+import sys
+from pathlib import Path
+
+from .validation import validate_files
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(prog="python3 -m vcf_architecture")
+    subparsers = parser.add_subparsers(dest="command", required=True)
+    validate = subparsers.add_parser("validate", help="validate a migration plan")
+    validate.add_argument("plan", type=Path)
+    validate.add_argument("--inventory", type=Path)
+    validate.add_argument("--snapshot", type=Path)
+    args = parser.parse_args(argv)
+
+    base = args.plan.resolve().parent
+    inventory = args.inventory or base / "estate_inventory.json"
+    snapshot = args.snapshot or base / "compatibility_snapshot.json"
+    errors = validate_files(args.plan, inventory, snapshot)
+    if errors:
+        for error in errors:
+            print("INVALID: " + error)
+        return 1
+    print("VALID: " + str(args.plan))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())

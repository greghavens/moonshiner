{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF Aria estate migration architecture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "estate_id",
    "compatibility_snapshot_id",
    "research",
    "placement",
    "migrations",
    "gates",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "estate_id": {
      "type": "string",
      "minLength": 1
    },
    "compatibility_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "research": {
      "$ref": "#/$defs/research"
    },
    "placement": {
      "$ref": "#/$defs/placement"
    },
    "migrations": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/migration"
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consulted_at",
        "sources",
        "live_snapshot_differences"
      ],
      "properties": {
        "consulted_at": {
          "type": "string",
          "format": "date"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "url",
              "consulted_for"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "consulted_for": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "live_snapshot_differences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "cluster_id",
        "host_count",
        "failures_to_tolerate",
        "storage_policy",
        "required_hosts_for_ftt",
        "anti_affinity_scope",
        "management_domain_changes",
        "components",
        "target_reservation",
        "capacity_headroom"
      ],
      "properties": {
        "domain_id": {
          "type": "string"
        },
        "cluster_id": {
          "type": "string"
        },
        "host_count": {
          "type": "integer",
          "minimum": 1
        },
        "failures_to_tolerate": {
          "type": "integer",
          "minimum": 0
        },
        "storage_policy": {
          "type": "string"
        },
        "required_hosts_for_ftt": {
          "type": "integer",
          "minimum": 1
        },
        "anti_affinity_scope": {
          "type": "string"
        },
        "management_domain_changes": {
          "type": "array",
          "maxItems": 0
        },
        "components": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "target_reservation": {
          "$ref": "#/$defs/resources"
        },
        "capacity_headroom": {
          "$ref": "#/$defs/resources"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "version",
        "profile",
        "node_count",
        "resources_per_node",
        "anti_affinity",
        "demand_satisfied"
      ],
      "properties": {
        "component": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "node_count": {
          "type": "integer",
          "minimum": 1
        },
        "resources_per_node": {
          "$ref": "#/$defs/resources"
        },
        "anti_affinity": {
          "type": "boolean"
        },
        "demand_satisfied": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vcpu",
        "memory_gib",
        "storage_tib"
      ],
      "properties": {
        "vcpu": {
          "type": "integer",
          "minimum": 0
        },
        "memory_gib": {
          "type": "integer",
          "minimum": 0
        },
        "storage_tib": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_id",
        "source",
        "target",
        "transition_method",
        "version_path",
        "direct_in_place_supported",
        "transition_parameters",
        "support_boundary",
        "gate_ids",
        "content_dispositions"
      ],
      "properties": {
        "product_id": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/productVersion"
        },
        "target": {
          "$ref": "#/$defs/productVersion"
        },
        "transition_method": {
          "type": "string"
        },
        "version_path": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "direct_in_place_supported": {
          "type": "boolean"
        },
        "transition_parameters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "number",
              "boolean"
            ]
          }
        },
        "support_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_eogs",
            "planning_effect"
          ],
          "properties": {
            "source_eogs": {
              "type": "string",
              "format": "date"
            },
            "planning_effect": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "gate_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "content_dispositions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/disposition"
          }
        }
      }
    },
    "productVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "version"
      ],
      "properties": {
        "product": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "disposition",
        "mechanism",
        "reason"
      ],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "disposition": {
          "enum": [
            "carried",
            "recreated",
            "abandoned"
          ]
        },
        "mechanism": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "condition",
        "evidence",
        "on_failure"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "technical",
            "data"
          ]
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "on_failure": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "id",
        "product_id",
        "action",
        "depends_on",
        "gate_ids",
        "produces"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string"
        },
        "product_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gate_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "produces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

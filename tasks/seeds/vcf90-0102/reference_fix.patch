+function Invoke-VcfInstallerContractRequest {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [uri] $Uri,
+
+        [Parameter(Mandatory)]
+        [ValidateSet('GET', 'POST', 'PATCH')]
+        [string] $Method,
+
+        [Parameter()]
+        [string] $AccessToken,
+
+        [Parameter()]
+        [string] $BodyJson
+    )
+
+    $headers = @{ Accept = 'application/json' }
+    if ($PSBoundParameters.ContainsKey('AccessToken')) {
+        $headers.Authorization = "Bearer $AccessToken"
+    }
+
+    $request = @{
+        Uri = $Uri
+        Method = $Method
+        Headers = $headers
+        SkipHttpErrorCheck = $true
+        StatusCodeVariable = 'responseStatusCode'
+        ErrorAction = 'Stop'
+    }
+    if ($PSBoundParameters.ContainsKey('BodyJson')) {
+        $request.Body = $BodyJson
+        $request.ContentType = 'application/json'
+    }
+
+    $responseBody = Invoke-RestMethod @request
+    [pscustomobject]@{
+        StatusCode = [int] $responseStatusCode
+        Body = $responseBody
+    }
+}

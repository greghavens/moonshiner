+func buildSddcSpec(req Requirements, hosts []map[string]any) (json.RawMessage, error) {
+	spec := map[string]any{
+		"sddcId":       req.DesignID,
+		"workflowType": "VCF",
+		"version":      req.TargetVersion,
+		"hostSpecs":    hosts,
+		"vcenterSpec": map[string]any{
+			"vcenterHostname":     "chi-vc01." + req.Network.DNSDomain,
+			"rootVcenterPassword": "Replace!Passw0rd1",
+			"vmSize":              "medium",
+			"ssoDomain":           "vsphere.local",
+		},
+		"clusterSpec": map[string]any{
+			"datacenterName": "chi-vcf-dc01",
+			"clusterName":    "chi-mgmt-stretched01",
+		},
+		"datastoreSpec": map[string]any{
+			"vsanSpec": map[string]any{
+				"datastoreName":      "chi-mgmt-vsan01",
+				"failuresToTolerate": req.Availability.HostFailuresToToleratePerSite,
+				"esaConfig":          map[string]any{"enabled": true},
+			},
+		},
+		"networkSpecs": []map[string]any{
+			{"networkType": "MANAGEMENT", "vlanId": req.Network.ManagementVLAN, "mtu": 1500},
+			{"networkType": "VSAN", "vlanId": req.Network.VsanVLAN, "mtu": 9000},
+			{"networkType": "VMOTION", "vlanId": req.Network.VmotionVLAN, "mtu": 9000},
+		},
+		"dnsSpec": map[string]any{
+			"subdomain":   req.Network.DNSDomain,
+			"nameservers": append([]string(nil), req.Network.NameServers...),
+		},
+		"ntpServers":                  append([]string(nil), req.Network.NTPServers...),
+		"managementPoolName":          "chi-management-pool",
+		"ceipEnabled":                 false,
+		"skipEsxThumbprintValidation": false,
+		"skipGatewayPingValidation":   false,
+	}
+	b, err := json.Marshal(spec)
+	if err != nil {
+		return nil, fmt.Errorf("marshal SddcSpec: %w", err)
+	}
+	return json.RawMessage(b), nil
+}
+
+func buildMigrationPlan(estate Estate, snapshot CompatibilitySnapshot) (MigrationPlan, error) {
+	inventory := make(map[string]InventoryComponent, len(estate.Components))
+	for _, component := range estate.Components {
+		if component.ID == "" || component.Name == "" || component.Version == "" {
+			return MigrationPlan{}, fmt.Errorf("estate component id, name, and version are required")
+		}
+		if _, exists := inventory[component.ID]; exists {
+			return MigrationPlan{}, fmt.Errorf("duplicate estate component %q", component.ID)
+		}
+		inventory[component.ID] = component
+	}
+	rules := append([]MigrationRule(nil), snapshot.Migration...)
+	sort.Slice(rules, func(i, j int) bool { return rules[i].Order < rules[j].Order })
+	if len(rules) != len(inventory) {
+		return MigrationPlan{}, fmt.Errorf("compatibility snapshot has %d migration rules for %d components", len(rules), len(inventory))
+	}
+	steps := make([]MigrationStep, 0, len(rules))
+	completed := make(map[string]bool, len(rules))
+	seenRules := make(map[string]bool, len(rules))
+	for index, rule := range rules {
+		if rule.Order != index+1 {
+			return MigrationPlan{}, fmt.Errorf("migration order is not contiguous at rule %q", rule.ComponentID)
+		}
+		component, ok := inventory[rule.ComponentID]
+		if !ok {
+			return MigrationPlan{}, fmt.Errorf("migration rule %q has no estate component", rule.ComponentID)
+		}
+		if seenRules[rule.ComponentID] {
+			return MigrationPlan{}, fmt.Errorf("duplicate migration rule for component %q", rule.ComponentID)
+		}
+		seenRules[rule.ComponentID] = true
+		if !stringIn(rule.SupportedSources, component.Version) {
+			return MigrationPlan{}, fmt.Errorf("component %s source %s has no supported path to %s", component.ID, component.Version, rule.TargetVersion)
+		}
+		if len(rule.Gates) == 0 {
+			return MigrationPlan{}, fmt.Errorf("component %s has no migration gate", component.ID)
+		}
+		for _, gate := range rule.Gates {
+			if gate.ID == "" || gate.Condition == "" {
+				return MigrationPlan{}, fmt.Errorf("component %s has an incomplete gate", component.ID)
+			}
+			for _, dependency := range gate.RequiresComponentIDs {
+				if !completed[dependency] {
+					return MigrationPlan{}, fmt.Errorf("component %s gate %s depends on %s before it is complete", component.ID, gate.ID, dependency)
+				}
+			}
+		}
+		steps = append(steps, MigrationStep{
+			Order:         rule.Order,
+			ComponentID:   component.ID,
+			Component:     component.Name,
+			SourceVersion: component.Version,
+			TargetVersion: rule.TargetVersion,
+			Gates:         cloneGates(rule.Gates),
+		})
+		completed[component.ID] = true
+	}
+	return MigrationPlan{
+		SchemaVersion:    "1.0",
+		EstateID:         estate.EstateID,
+		TargetVCFVersion: snapshot.TargetVersion,
+		Steps:            steps,
+	}, nil
+}
+
+func cloneGates(gates []Gate) []Gate {
+	result := make([]Gate, len(gates))
+	for index, gate := range gates {
+		result[index] = gate
+		result[index].RequiresComponentIDs = append([]string{}, gate.RequiresComponentIDs...)
+	}
+	return result
+}
+
+func stringIn(values []string, want string) bool {
+	for _, value := range values {
+		if value == want {
+			return true
+		}
+	}
+	return false
+}
+
+func smaller(a, b int) int {
+	if a < b {
+		return a
+	}
+	return b
 }
 
-func WriteArtifact(io.Writer, Artifact) error {
-	return ErrNotImplemented
+func WriteArtifact(w io.Writer, artifact Artifact) error {
+	encoder := json.NewEncoder(w)
+	encoder.SetIndent("", "  ")
+	if err := encoder.Encode(artifact); err != nil {
+		return fmt.Errorf("encode architecture artifact: %w", err)
+	}
+	return nil
 }

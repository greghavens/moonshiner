{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch-0129:migration-plan",
  "title": "Brownfield VCF Migration Plan SddcSpec Extension",
  "type": "object",
  "required": [
    "migrationSchemaVersion",
    "estateId",
    "siteId",
    "topology",
    "targetFleetVersion",
    "sddcId",
    "workflowType",
    "version",
    "hostSpecs",
    "vcenterSpec",
    "clusterSpec",
    "dvsSpecs",
    "nsxtSpec",
    "networkSpecs",
    "dnsSpec",
    "ntpServers",
    "datastoreSpec",
    "migrationSteps",
    "research"
  ],
  "properties": {
    "migrationSchemaVersion": {"const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "siteId": {"type": "string", "minLength": 1},
    "topology": {"const": "SINGLE_SITE_CONSOLIDATED"},
    "targetFleetVersion": {"type": "string", "minLength": 1},
    "research": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "consultedFor"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "url": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https?://([A-Za-z0-9-]+\\.)*broadcom\\.com(?:[/:?#]|$)"
          },
          "consultedFor": {"type": "string", "minLength": 1}
        }
      }
    },
    "migrationSteps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "componentId", "componentType", "fromVersion", "targetVersion", "action", "gates", "dependsOn"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "componentId": {"type": "string", "minLength": 1},
          "componentType": {"type": "string", "minLength": 1},
          "fromVersion": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}

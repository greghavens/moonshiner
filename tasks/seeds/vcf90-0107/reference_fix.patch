+"""HTTP client for the VCF Installer 9.0 ``getTasks`` operation."""
+
+from __future__ import annotations
+
+from http.client import HTTPException
+import json
+from typing import Any
+from urllib.error import HTTPError, URLError
+from urllib.parse import urlencode
+from urllib.request import Request, urlopen
+
+
+class VCFInstallerError(RuntimeError):
+    """Raised when the Installer response cannot produce a complete collection."""
+
+
+class VCFInstallerClient:
+    def __init__(self, base_url: str, *, timeout: float = 10.0) -> None:
+        self.base_url = base_url.rstrip("/")
+        self.timeout = timeout
+
+    def list_all_tasks(
+        self,
+        *,
+        page_size: int = 100,
+        task_status: str | None = None,
+        task_type: str | None = None,
+        resource_id: str | None = None,
+        resource_type: str | None = None,
+        completed_after: int | None = None,
+        task_name: str | None = None,
+        do_live_refresh: bool | None = None,
+    ) -> list[dict[str, Any]]:
+        if isinstance(page_size, bool) or not isinstance(page_size, int):
+            raise ValueError("page_size must be an integer")
+        if not 1 <= page_size <= 100:
+            raise ValueError("page_size must be between 1 and 100")
+        if completed_after is not None and (
+            isinstance(completed_after, bool) or not isinstance(completed_after, int)
+        ):
+            raise ValueError("completed_after must be an integer or None")
+        if do_live_refresh is not None and not isinstance(do_live_refresh, bool):
+            raise ValueError("do_live_refresh must be a boolean or None")
+
+        supplied_filters: list[tuple[str, str]] = []
+        string_filters = (
+            ("taskStatus", task_status),
+            ("taskType", task_type),
+            ("resourceId", resource_id),
+            ("resourceType", resource_type),
+        )
+        for wire_name, value in string_filters:
+            if value is not None:
+                supplied_filters.append((wire_name, value))
+        if completed_after is not None:
+            supplied_filters.append(("completedAfter", str(completed_after)))
+        if task_name is not None:
+            supplied_filters.append(("taskName", task_name))
+        if do_live_refresh is not None:
+            supplied_filters.append(
+                ("doLiveRefresh", "true" if do_live_refresh else "false")
+            )
+
+        page_number = 0
+        known_totals: tuple[int, int] | None = None
+        all_tasks: list[dict[str, Any]] = []
+        while True:
+            query = [
+                ("pageNumber", str(page_number)),
+                ("pageSize", str(page_size)),
+                ("orderBy", "id"),
+                ("orderDirection", "ASC"),
+                *supplied_filters,
+            ]
+            document = self._get_tasks(query)
+            elements, total_elements, total_pages = self._validate_page(
+                document, page_number, page_size
+            )
+            totals = (total_elements, total_pages)
+            if known_totals is None:
+                known_totals = totals
+            elif totals != known_totals:
+                raise VCFInstallerError("collection totals changed during pagination")
+            all_tasks.extend(elements)
+
+            if total_pages == 0 or page_number + 1 >= total_pages:
+                break
+            page_number += 1
+
+        if known_totals is None or len(all_tasks) != known_totals[0]:
+            raise VCFInstallerError("pagination did not return totalElements tasks")
+
+        try:
+            return sorted(all_tasks, key=lambda task: task["id"])
+        except (KeyError, TypeError) as exc:
+            raise VCFInstallerError("each task must contain a string id") from exc
+
+    def _get_tasks(self, query: list[tuple[str, str]]) -> object:
+        url = f"{self.base_url}/v1/tasks?{urlencode(query)}"
+        request = Request(url, headers={"Accept": "application/json"}, method="GET")
+        try:
+            with urlopen(request, timeout=self.timeout) as response:
+                payload = response.read()
+        except HTTPError as exc:
+            raise VCFInstallerError(f"VCF Installer returned HTTP {exc.code}") from exc
+        except URLError as exc:
+            raise VCFInstallerError(f"VCF Installer request failed: {exc.reason}") from exc
+        except (HTTPException, OSError, TimeoutError, ValueError) as exc:
+            raise VCFInstallerError(f"VCF Installer request failed: {exc}") from exc
+
+        try:
+            return json.loads(payload.decode("utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+            raise VCFInstallerError("VCF Installer returned invalid JSON") from exc
+
+    @staticmethod
+    def _validate_page(
+        document: object, requested_page: int, requested_page_size: int
+    ) -> tuple[list[dict[str, Any]], int, int]:
+        if not isinstance(document, dict):
+            raise VCFInstallerError("page response must be a JSON object")
+        elements = document.get("elements")
+        metadata = document.get("pageMetadata")
+        if not isinstance(elements, list) or not isinstance(metadata, dict):
+            raise VCFInstallerError("response must contain elements and pageMetadata")
+        if not all(isinstance(task, dict) for task in elements):
+            raise VCFInstallerError("page elements must be task objects")
+
+        values: dict[str, int] = {}
+        for name in ("pageNumber", "pageSize", "totalElements", "totalPages"):
+            value = metadata.get(name)
+            if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+                raise VCFInstallerError(f"pageMetadata.{name} must be a non-negative integer")
+            values[name] = value
+        if values["pageNumber"] != requested_page:
+            raise VCFInstallerError("pageMetadata.pageNumber does not match the request")
+        if values["pageSize"] != len(elements):
+            raise VCFInstallerError("pageMetadata.pageSize does not match elements")
+        expected_pages = (
+            values["totalElements"] + requested_page_size - 1
+        ) // requested_page_size
+        if values["totalPages"] != expected_pages:
+            raise VCFInstallerError("pageMetadata totals are inconsistent")
+        if values["totalPages"] == 0:
+            expected_elements = 0
+        elif requested_page >= values["totalPages"]:
+            raise VCFInstallerError("pageMetadata.totalPages is inconsistent")
+        else:
+            remaining = values["totalElements"] - requested_page * requested_page_size
+            expected_elements = min(requested_page_size, remaining)
+        if len(elements) != expected_elements:
+            raise VCFInstallerError("page element count is inconsistent with metadata")
+
+        for task in elements:
+            task_id = task.get("id")
+            if not isinstance(task_id, str):
+                raise VCFInstallerError("each task must contain a string id")
+        return elements, values["totalElements"], values["totalPages"]

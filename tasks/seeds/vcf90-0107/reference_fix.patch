@@ -0,0 +1,27 @@
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+
+from .client import VCFInstallerClient, VCFInstallerError
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="Retrieve all VCF Installer tasks")
+    parser.add_argument("base_url", help="VCF Installer base URL")
+    parser.add_argument("--page-size", type=int, default=100)
+    args = parser.parse_args(argv)
+
+    try:
+        tasks = VCFInstallerClient(args.base_url).list_all_tasks(page_size=args.page_size)
+    except (VCFInstallerError, ValueError) as exc:
+        parser.exit(1, f"error: {exc}\n")
+
+    json.dump(tasks, sys.stdout, sort_keys=True, separators=(",", ":"))
+    sys.stdout.write("\n")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

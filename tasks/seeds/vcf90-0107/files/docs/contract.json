{
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "commitSha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "specPath": "specifications/vcf-installer/vcf-installer-openapi.json",
    "openapiVersion": "3.0.1",
    "apiVersion": "9.0.0.0",
    "license": "Apache-2.0"
  },
  "operations": [
    {
      "operationId": "getTasks",
      "method": "GET",
      "path": "/v1/tasks",
      "summary": "Retrieve a list of all tasks",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        },
        {
          "name": "taskStatus",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "taskType",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "resourceId",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "resourceType",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "completedAfter",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        },
        {
          "name": "pageNumber",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        },
        {
          "name": "orderDirection",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "orderBy",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "taskName",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "doLiveRefresh",
          "in": "query",
          "required": false,
          "schema": {
            "type": "boolean",
            "default": false
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Returns the list of tasks.",
          "schema": "PageOfTask"
        },
        "500": {
          "description": "Unexpected error",
          "schema": "Error"
        }
      }
    }
  ],
  "schemas": {
    "PageMetadata": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "pageNumber": {
          "type": "integer",
          "format": "int32",
          "readOnly": true
        },
        "pageSize": {
          "type": "integer",
          "format": "int32",
          "readOnly": true
        },
        "totalElements": {
          "type": "integer",
          "format": "int32",
          "readOnly": true
        },
        "totalPages": {
          "type": "integer",
          "format": "int32",
          "readOnly": true
        }
      }
    },
    "PageOfTask": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "readOnly": true,
          "items": {
            "$ref": "Task"
          }
        },
        "pageMetadata": {
          "$ref": "PageMetadata"
        }
      }
    },
    "Task": {
      "type": "object",
      "required": [
        "creationTimestamp",
        "id",
        "name",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "readOnly": true
        },
        "type": {
          "type": "string",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "readOnly": true
        },
        "creationTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "completionTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "subTasks": {
          "type": "array",
          "readOnly": true
        },
        "errors": {
          "type": "array",
          "readOnly": true
        },
        "resources": {
          "type": "array",
          "readOnly": true
        },
        "resolutionStatus": {
          "type": "string",
          "readOnly": true
        },
        "isCancellable": {
          "type": "boolean",
          "readOnly": true
        },
        "isRetryable": {
          "type": "boolean",
          "readOnly": true
        }
      }
    }
  }
}

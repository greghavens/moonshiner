+// Build returns the architecture pinned to the supplied estate and compatibility snapshot.
+func Build() Document {
+	return Document{
+		SchemaVersion: "1.0.0",
+		EstateID:      "northstar-prod",
+		SnapshotID:    "broadcom-vcf9-2025-10-15",
+		TargetRelease: "9.0.1",
+		SupportBoundaries: []SupportBoundary{
+			{"ops-prod", "VMware vRealize Operations", "8.10.2", "2024-10-11", "expired"},
+			{"auto-prod", "VMware Aria Automation", "8.16.2", "2025-03-21", "expired"},
+			{"logs-prod", "VMware vRealize Log Insight", "8.10.2", "2024-10-11", "expired"},
+		},
+		Architecture: Architecture{
+			ManagementDomain: ManagementDomain{
+				Name:        "mgmt-stretched-01",
+				Topology:    "vsan-stretched",
+				DataSiteIDs: []string{"dc-a", "dc-b"},
+				Witness: Witness{
+					SiteID:                     "witness-c",
+					Type:                       "vsan-witness-appliance",
+					ManagementWorkloadsAllowed: false,
+				},
+			},
+			Components: []Component{operationsComponent(), automationComponent(), logsComponent()},
+		},
+		ProductMigrations: []ProductMigration{operationsMigration(), automationMigration(), logsMigration()},
+		Gates:             gates(),
+		Steps:             steps(),
+	}
+}
+
+// Write writes Build's document atomically enough for a generated repository artifact.
+func Write(path string) error {
+	payload, err := json.MarshalIndent(Build(), "", "  ")
+	if err != nil {
+		return err
+	}
+	payload = append(payload, '\n')
+	return os.WriteFile(path, payload, 0o644)
+}

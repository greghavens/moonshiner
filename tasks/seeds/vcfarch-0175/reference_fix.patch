diff --git a/files/migrationplan/plan_test.go b/files/migrationplan/plan_test.go
new file mode 100644
index 0000000..22a43b2
--- /dev/null
+++ b/files/migrationplan/plan_test.go
@@ -0,0 +1,105 @@
+package migrationplan
+
+import (
+	"encoding/json"
+	"os"
+	"reflect"
+	"sort"
+	"testing"
+)
+
+func TestVersionRoutes(t *testing.T) {
+	want := map[string][]string{
+		"ops-prod":  {"8.10.2", "8.14.1", "VCF Operations 9.0.1"},
+		"auto-prod": {"8.16.2", "8.18.1", "VCF Automation 9.0.1"},
+		"logs-prod": {"8.10.2", "VCF Operations for Logs 9.0.1"},
+	}
+	for _, migration := range Build().ProductMigrations {
+		t.Run(migration.Source.InventoryID, func(t *testing.T) {
+			if !reflect.DeepEqual(migration.VersionPath, want[migration.Source.InventoryID]) {
+				t.Fatalf("route = %v, want %v", migration.VersionPath, want[migration.Source.InventoryID])
+			}
+		})
+	}
+}
+
+func TestContentDisposition(t *testing.T) {
+	wantCounts := map[string]int{"ops-prod": 6, "auto-prod": 7, "logs-prod": 7}
+	for _, migration := range Build().ProductMigrations {
+		t.Run(migration.Source.InventoryID, func(t *testing.T) {
+			ids := map[string]bool{}
+			for _, item := range migration.CarryForward {
+				if ids[item.InventoryID] {
+					t.Fatalf("duplicate %s", item.InventoryID)
+				}
+				ids[item.InventoryID] = true
+			}
+			for _, item := range migration.Abandoned {
+				if ids[item.InventoryID] {
+					t.Fatalf("duplicate %s", item.InventoryID)
+				}
+				ids[item.InventoryID] = true
+			}
+			if len(ids) != wantCounts[migration.Source.InventoryID] {
+				t.Fatalf("classified %d items, want %d", len(ids), wantCounts[migration.Source.InventoryID])
+			}
+		})
+	}
+}
+
+func TestPlacementAndSizing(t *testing.T) {
+	tests := []struct {
+		id                    string
+		nodes                 int
+		sites                 []string
+		vcpu, memory, storage int
+	}{
+		{"vcf-operations", 4, []string{"dc-a", "dc-a", "dc-b", "dc-b"}, 16, 48, 2048},
+		{"vcf-automation", 3, []string{"dc-a", "dc-a", "dc-b"}, 12, 42, 222},
+		{"vcf-operations-for-logs", 6, []string{"dc-a", "dc-a", "dc-a", "dc-b", "dc-b", "dc-b"}, 16, 32, 4096},
+	}
+	byID := map[string]Component{}
+	for _, component := range Build().Architecture.Components {
+		byID[component.ID] = component
+	}
+	for _, tc := range tests {
+		t.Run(tc.id, func(t *testing.T) {
+			component := byID[tc.id]
+			if len(component.Nodes) != tc.nodes {
+				t.Fatalf("nodes = %d, want %d", len(component.Nodes), tc.nodes)
+			}
+			sites := make([]string, 0, len(component.Nodes))
+			for _, node := range component.Nodes {
+				if node.SiteID == "witness-c" {
+					t.Fatal("management workload placed at witness")
+				}
+				if node.VCPU < tc.vcpu || node.MemoryGiB < tc.memory || node.StorageGiB < tc.storage {
+					t.Fatalf("undersized node %+v", node)
+				}
+				sites = append(sites, node.SiteID)
+			}
+			sort.Strings(sites)
+			if !reflect.DeepEqual(sites, tc.sites) {
+				t.Fatalf("sites = %v, want %v", sites, tc.sites)
+			}
+		})
+	}
+	witness := Build().Architecture.ManagementDomain.Witness
+	if witness.SiteID != "witness-c" || witness.ManagementWorkloadsAllowed {
+		t.Fatalf("invalid witness %+v", witness)
+	}
+}
+
+func TestCommittedArtifactMatchesBuild(t *testing.T) {
+	raw, err := os.ReadFile("../migration-plan.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var committed Document
+	if err := json.Unmarshal(raw, &committed); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(committed, Build()) {
+		t.Fatal("migration-plan.json does not match Build()")
+	}
+}

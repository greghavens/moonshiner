{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0175:migration-plan:1.0.0",
  "title": "VCF migration architecture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "estate_id",
    "snapshot_id",
    "target_release",
    "support_boundaries",
    "architecture",
    "product_migrations",
    "gates",
    "steps"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "estate_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "target_release": {"type": "string", "minLength": 1},
    "support_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/supportBoundary"}
    },
    "architecture": {"$ref": "#/$defs/architecture"},
    "product_migrations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/productMigration"}
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gate"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "supportBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory_id", "product", "version", "end_of_general_support", "status_at_snapshot"],
      "properties": {
        "inventory_id": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "end_of_general_support": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "status_at_snapshot": {"enum": ["supported", "expired"]}
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["management_domain", "components"],
      "properties": {
        "management_domain": {"$ref": "#/$defs/managementDomain"},
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/component"}
        }
      }
    },
    "managementDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "topology", "data_site_ids", "witness"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "topology": {"type": "string", "minLength": 1},
        "data_site_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "witness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["site_id", "type", "management_workloads_allowed"],
          "properties": {
            "site_id": {"type": "string", "minLength": 1},
            "type": {"type": "string", "minLength": 1},
            "management_workloads_allowed": {"type": "boolean"}
          }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "product", "version", "deployment_model", "size_profile", "node_count", "nodes", "placement_rules", "capacity_basis"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "deployment_model": {"type": "string", "minLength": 1},
        "size_profile": {"type": "string", "minLength": 1},
        "node_count": {"type": "integer", "minimum": 1},
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/node"}
        },
        "placement_rules": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/placementRule"}
        },
        "capacity_basis": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/capacityDatum"}
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "site_id", "role", "vcpu", "memory_gib", "storage_gib"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "site_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["primary", "replica", "data", "member"]},
        "vcpu": {"type": "integer", "minimum": 1},
        "memory_gib": {"type": "integer", "minimum": 1},
        "storage_gib": {"type": "integer", "minimum": 1}
      }
    },
    "placementRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "constraint"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "constraint": {"type": "string", "minLength": 1}
      }
    },
    "capacityDatum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "value", "unit"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "value": {"type": "integer", "minimum": 0},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "productMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target_component_id", "target_product", "target_version", "migration_mode", "version_path", "carry_forward", "abandoned", "gate_ids"],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inventory_id", "product", "version"],
          "properties": {
            "inventory_id": {"type": "string", "minLength": 1},
            "product": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        },
        "target_component_id": {"type": "string", "minLength": 1},
        "target_product": {"type": "string", "minLength": 1},
        "target_version": {"type": "string", "minLength": 1},
        "migration_mode": {"type": "string", "minLength": 1},
        "version_path": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "carry_forward": {
          "type": "array",
          "items": {"$ref": "#/$defs/carriedItem"}
        },
        "abandoned": {
          "type": "array",
          "items": {"$ref": "#/$defs/abandonedItem"}
        },
        "gate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "carriedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory_id", "method", "target_form", "validation"],
      "properties": {
        "inventory_id": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "target_form": {"type": "string", "minLength": 1},
        "validation": {"type": "string", "minLength": 1}
      }
    },
    "abandonedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory_id", "method", "target_form", "reason"],
      "properties": {
        "inventory_id": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "target_form": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phase", "condition", "evidence", "blocks"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "phase": {"enum": ["preflight", "operations", "automation", "logs", "cutover"]},
        "condition": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "blocks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "id", "component_id", "action", "depends_on", "gate_ids", "rollback"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "id": {"type": "string", "minLength": 1},
        "component_id": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "gate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rollback": {"type": "string", "minLength": 1}
      }
    }
  }
}

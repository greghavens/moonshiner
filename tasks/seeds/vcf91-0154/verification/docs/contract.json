        "verb": "list",
        "namespaced": true,
        "method": "GET",
        "path": "/api/v1/namespaces/{namespace}/events",
        "requiredQuery": {
          "fieldSelector": "involvedObject.kind=Pod,involvedObject.namespace={namespace},involvedObject.name={pod}"
        },
        "optionalQueryFields": [

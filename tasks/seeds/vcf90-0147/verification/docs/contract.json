{
  "contractVersion": 1,
  "product": "VMware Cloud Foundation Automation",
  "productRelease": "9.0",
  "interface": "VM Apps Org - Provisioning Service IaaS API",
  "source": {
    "kind": "reference-documentation",
    "statement": "This contract is derived from Broadcom's authoritative VCF Automation xAPIs reference documentation; it is reference documentation, not a published specification.",
    "specificationRepositoryNote": "VCF Automation has no specification in the Apache-2.0 vmware/vcf-api-specs repository."
  },
  "wireProfile": {
    "apiVersion": "2021-07-15",
    "jsonContentType": "application/json",
    "omitUnsetOptionalFields": true
  },
  "scenarioProfile": {
    "expiredAccessTokenStatus": 401
  },
  "operations": [
    {
      "id": "retrieveAuthToken",
      "referenceOperation": "Retrieve Auth Token",
      "method": "POST",
      "path": "/iaas/api/login",
      "query": {
        "apiVersion": {
          "required": false,
          "format": "yyyy-MM-dd"
        }
      },
      "request": {
        "contentType": "application/json",
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": "string"
        },
        "additionalProperties": false
      },
      "response200": {
        "required": [
          "tokenType",
          "token"
        ],
        "properties": {
          "tokenType": "string",
          "token": "string"
        }
      }
    },
    {
      "id": "updateProject",
      "referenceOperation": "Update Project",
      "method": "PATCH",
      "path": "/iaas/api/projects/{id}",
      "authentication": {
        "header": "Authorization",
        "scheme": "Bearer",
        "tokenSource": "retrieveAuthToken.response.token"
      },
      "query": {
        "apiVersion": {
          "required": false,
          "format": "yyyy-MM-dd"
        },
        "validatePrincipals": {
          "required": false,
          "type": "boolean"
        }
      },
      "request": {
        "contentType": "application/json",
        "required": [
          "name"
        ],
        "optional": [
          "description",
          "administrators",
          "members",
          "viewers",
          "supervisors",
          "zoneAssignmentConfigurations",
          "constraints",
          "operationTimeout",
          "machineNamingTemplate",
          "sharedResources",
          "placementPolicy",
          "customProperties"
        ],
        "pathOnly": [
          "id"
        ],
        "omitWhenUnset": true
      },
      "response200": {
        "type": "Project"
      },
      "documentedErrors": [
        400,
        403
      ]
    }
  ]
}

+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Single-file client for the VCF 9.1 SDDC Manager getDomains operation. */
+public final class SddcManagerClient {
+    private static final Comparator<Domain> DOMAIN_ORDER =
+            Comparator.comparing(Domain::name).thenComparing(Domain::id);
+
+    private final String baseUrl;
+    private final String bearerToken;
+    private final int pageSize;
+    private final HttpClient http;
+
+    public SddcManagerClient(String baseUrl, String bearerToken, int pageSize) {
+        if (baseUrl == null || baseUrl.isBlank()) {
+            throw new IllegalArgumentException("baseUrl must not be blank");
+        }
+        if (bearerToken == null || bearerToken.isBlank()) {
+            throw new IllegalArgumentException("bearerToken must not be blank");
+        }
+        if (pageSize <= 0) {
+            throw new IllegalArgumentException("pageSize must be positive");
+        }
+        String normalized = baseUrl;
+        while (normalized.endsWith("/")) {
+            normalized = normalized.substring(0, normalized.length() - 1);
+        }
+        // Validate it now, before any request is attempted.
+        URI.create(normalized);
+        this.baseUrl = normalized;
+        this.bearerToken = bearerToken;
+        this.pageSize = pageSize;
+        this.http = HttpClient.newHttpClient();
+    }
+
+    public record Domain(String id, String name, String type, String status) {}
+
+    public static final class SddcManagerException extends RuntimeException {
+        private final int statusCode;
+
+        SddcManagerException(int statusCode, String message) {
+            super(message);
+            this.statusCode = statusCode;
+        }
+
+        SddcManagerException(int statusCode, String message, Throwable cause) {
+            super(message, cause);
+            this.statusCode = statusCode;
+        }
+
+        public int statusCode() {
+            return statusCode;
+        }
+    }
+
+    public List<Domain> listDomains() {
+        List<Domain> domains = new ArrayList<>();
+        int requestedPage = 0;
+
+        while (true) {
+            HttpResponse<String> response = getPage(requestedPage);
+            if (response.statusCode() < 200 || response.statusCode() >= 300) {
+                throw new SddcManagerException(
+                        response.statusCode(),
+                        "SDDC Manager getDomains failed with HTTP " + response.statusCode());
+            }
+
+            Map<String, Object> body = object(parse(response.body()), "response");
+            List<Object> elements = array(body.get("elements"), "elements");
+            for (Object value : elements) {
+                Map<String, Object> item = object(value, "domain");
+                domains.add(new Domain(
+                        string(item.get("id"), "domain.id"),
+                        string(item.get("name"), "domain.name"),
+                        string(item.get("type"), "domain.type"),
+                        string(item.get("status"), "domain.status")));
+            }
+
+            Map<String, Object> metadata =
+                    object(body.get("pageMetadata"), "pageMetadata");
+            int returnedPage = integer(metadata.get("pageNumber"), "pageMetadata.pageNumber");
+            int returnedSize = integer(metadata.get("pageSize"), "pageMetadata.pageSize");
+            int totalElements =
+                    integer(metadata.get("totalElements"), "pageMetadata.totalElements");
+            int totalPages = integer(metadata.get("totalPages"), "pageMetadata.totalPages");
+
+            if (returnedPage != requestedPage) {
+                throw malformed("pageMetadata.pageNumber did not advance to requested page");
+            }
+            if (returnedSize < 0 || totalElements < 0 || totalPages < 0) {
+                throw malformed("pageMetadata contains a negative count");
+            }
+            if (totalPages == 0 || returnedPage + 1 >= totalPages) {
+                break;
+            }
+            int nextPage = returnedPage + 1;
+            if (nextPage <= requestedPage) {
+                throw malformed("pageMetadata does not advance");
+            }
+            requestedPage = nextPage;
+        }
+
+        domains.sort(DOMAIN_ORDER);
+        return List.copyOf(domains);
+    }
+
+    public void writeInventory(Appendable output) {
+        if (output == null) {
+            throw new IllegalArgumentException("output must not be null");
+        }
+        try {
+            output.append("id\tname\ttype\tstatus\n");
+            for (Domain domain : listDomains()) {
+                output.append(domain.id()).append('\t')
+                        .append(domain.name()).append('\t')
+                        .append(domain.type()).append('\t')
+                        .append(domain.status()).append('\n');
+            }
+        } catch (IOException error) {
+            throw new UncheckedIOException("could not write domain inventory", error);
+        }
+    }
+
+    private HttpResponse<String> getPage(int pageNumber) {
+        URI uri = URI.create(baseUrl + "/v1/domains?pageNumber=" + pageNumber
+                + "&pageSize=" + pageSize);
+        HttpRequest request = HttpRequest.newBuilder(uri)
+                .header("Authorization", "Bearer " + bearerToken)
+                .header("Accept", "application/json")
+                .GET()
+                .build();
+        try {
+            return http.send(request, HttpResponse.BodyHandlers.ofString());
+        } catch (IOException error) {
+            throw new SddcManagerException(
+                    -1, "SDDC Manager getDomains request failed", error);
+        } catch (InterruptedException error) {
+            Thread.currentThread().interrupt();
+            throw new SddcManagerException(
+                    -1, "SDDC Manager getDomains request was interrupted", error);
+        }
+    }
+
+    private static Object parse(String json) {
+        try {
+            return new Json(json).parse();
+        } catch (RuntimeException error) {
+            if (error instanceof SddcManagerException) {
+                throw error;
+            }
+            throw malformed("response is not valid JSON");
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    private static Map<String, Object> object(Object value, String field) {
+        if (!(value instanceof Map<?, ?> map)) {
+            throw malformed(field + " must be an object");
+        }
+        for (Object key : map.keySet()) {
+            if (!(key instanceof String)) {
+                throw malformed(field + " has a non-string key");
+            }
+        }
+        return (Map<String, Object>) map;
+    }
+
+    @SuppressWarnings("unchecked")
+    private static List<Object> array(Object value, String field) {
+        if (!(value instanceof List<?> list)) {
+            throw malformed(field + " must be an array");
+        }
+        return (List<Object>) list;
+    }
+
+    private static String string(Object value, String field) {
+        if (!(value instanceof String text)) {
+            throw malformed(field + " must be a string");
+        }
+        return text;
+    }
+
+    private static int integer(Object value, String field) {
+        if (!(value instanceof Long number)
+                || number < Integer.MIN_VALUE || number > Integer.MAX_VALUE) {
+            throw malformed(field + " must be an int32 integer");
+        }
+        return number.intValue();
+    }
+
+    private static SddcManagerException malformed(String detail) {
+        return new SddcManagerException(
+                -1, "Malformed SDDC Manager getDomains response: " + detail);
+    }
+
+    /** Small structural JSON decoder; sufficient for arbitrary JSON values. */
+    private static final class Json {
+        private final String source;
+        private int at;
+
+        Json(String source) {
+            this.source = source;
+        }
+
+        Object parse() {
+            Object value = value();
+            whitespace();
+            if (at != source.length()) {
+                fail();
+            }
+            return value;
+        }
+
+        private Object value() {
+            whitespace();
+            if (at >= source.length()) {
+                return fail();
+            }
+            return switch (source.charAt(at)) {
+                case '{' -> object();
+                case '[' -> array();
+                case '"' -> string();
+                case 't' -> literal("true", Boolean.TRUE);
+                case 'f' -> literal("false", Boolean.FALSE);
+                case 'n' -> literal("null", null);
+                default -> number();
+            };
+        }
+
+        private Map<String, Object> object() {
+            at++;
+            Map<String, Object> result = new LinkedHashMap<>();
+            whitespace();
+            if (take('}')) {
+                return result;
+            }
+            while (true) {
+                whitespace();
+                if (at >= source.length() || source.charAt(at) != '"') {
+                    fail();
+                }
+                String key = string();
+                whitespace();
+                if (!take(':')) {
+                    fail();
+                }
+                result.put(key, value());
+                whitespace();
+                if (take('}')) {
+                    return result;
+                }
+                if (!take(',')) {
+                    fail();
+                }
+            }
+        }
+
+        private List<Object> array() {
+            at++;
+            List<Object> result = new ArrayList<>();
+            whitespace();
+            if (take(']')) {
+                return result;
+            }
+            while (true) {
+                result.add(value());
+                whitespace();
+                if (take(']')) {
+                    return result;
+                }
+                if (!take(',')) {
+                    fail();
+                }
+            }
+        }
+
+        private String string() {
+            at++;
+            StringBuilder result = new StringBuilder();
+            while (at < source.length()) {
+                char c = source.charAt(at++);
+                if (c == '"') {
+                    return result.toString();
+                }
+                if (c == '\\') {
+                    if (at >= source.length()) {
+                        fail();
+                    }
+                    char escaped = source.charAt(at++);
+                    switch (escaped) {
+                        case '"', '\\', '/' -> result.append(escaped);
+                        case 'b' -> result.append('\b');
+                        case 'f' -> result.append('\f');
+                        case 'n' -> result.append('\n');
+                        case 'r' -> result.append('\r');
+                        case 't' -> result.append('\t');
+                        case 'u' -> result.append(unicode());
+                        default -> fail();
+                    }
+                } else {
+                    if (c < 0x20) {
+                        fail();
+                    }
+                    result.append(c);
+                }
+            }
+            return fail();
+        }
+
+        private char unicode() {
+            if (at + 4 > source.length()) {
+                return fail();
+            }
+            int code = 0;
+            for (int i = 0; i < 4; i++) {
+                int digit = Character.digit(source.charAt(at++), 16);
+                if (digit < 0) {
+                    return fail();
+                }
+                code = code * 16 + digit;
+            }
+            return (char) code;
+        }
+
+        private Object number() {
+            int start = at;
+            if (take('-') && at >= source.length()) {
+                fail();
+            }
+            if (take('0')) {
+                // A leading zero is the entire integer part.
+            } else {
+                if (at >= source.length() || source.charAt(at) < '1'
+                        || source.charAt(at) > '9') {
+                    return fail();
+                }
+                while (at < source.length() && Character.isDigit(source.charAt(at))) {
+                    at++;
+                }
+            }
+            boolean integral = true;
+            if (take('.')) {
+                integral = false;
+                digits();
+            }
+            if (at < source.length()
+                    && (source.charAt(at) == 'e' || source.charAt(at) == 'E')) {
+                integral = false;
+                at++;
+                if (at < source.length()
+                        && (source.charAt(at) == '+' || source.charAt(at) == '-')) {
+                    at++;
+                }
+                digits();
+            }
+            String token = source.substring(start, at);
+            try {
+                if (integral) {
+                    return Long.valueOf(token);
+                }
+                return Double.valueOf(token);
+            } catch (NumberFormatException error) {
+                return fail();
+            }
+        }
+
+        private void digits() {
+            int start = at;
+            while (at < source.length() && Character.isDigit(source.charAt(at))) {
+                at++;
+            }
+            if (start == at) {
+                fail();
+            }
+        }
+
+        private Object literal(String text, Object value) {
+            if (!source.startsWith(text, at)) {
+                return fail();
+            }
+            at += text.length();
+            return value;
+        }
+
+        private void whitespace() {
+            while (at < source.length()
+                    && (source.charAt(at) == ' ' || source.charAt(at) == '\n'
+                    || source.charAt(at) == '\r' || source.charAt(at) == '\t')) {
+                at++;
+            }
+        }
+
+        private boolean take(char wanted) {
+            if (at < source.length() && source.charAt(at) == wanted) {
+                at++;
+                return true;
+            }
+            return false;
+        }
+
+        private <T> T fail() {
+            throw new IllegalArgumentException("invalid JSON");
+        }
+    }
+}

  "operations": [
    {
      "operationId": "getDomains",
      "summary": "Retrieve a list of domains",
      "method": "GET",
      "path": "/v1/domains",
      "projected_query_parameters": {
        "pageNumber": {
          "required": false,
          "type": "integer",
          "format": "int32",
          "description": "Page number to retrieve"
        },
        "pageSize": {
          "required": false,
          "type": "integer",
          "format": "int32",
          "description": "Size of the page to retrieve"
        }
      },
      "responses": {
        "200": {
          "description": "Ok",
          "content_type": "application/json",
          "schema_ref": "#/components/schemas/PageOfDomain"
        },
        "400": {
          "description": "Bad Request",
          "content_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        },
        "500": {
          "description": "InternalServerError",
          "content_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        }
      }
    }
  ],
  "schemas": {
    "PageOfDomain": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "description": "The list of elements included in this page",
          "items_ref": "#/components/schemas/Domain"
        },
        "pageMetadata": {
          "ref": "#/components/schemas/PageMetadata"
        }
      }
    },
    "PageMetadata": {
      "type": "object",
      "description": "Represents pageable elements pagination metadata",
      "readOnly": true,
      "properties": {
        "pageNumber": {
          "type": "integer",
          "format": "int32",
          "readOnly": true,
          "description": "Returns the current page number"
        },
        "pageSize": {
          "type": "integer",
          "format": "int32",
          "readOnly": true,
          "description": "Returns the number of elements in the current page"
        },
        "totalElements": {
          "type": "integer",
          "format": "int32",
          "readOnly": true,
          "description": "Returns the total number of elements"
        },
        "totalPages": {
          "type": "integer",
          "format": "int32",
          "readOnly": true,
          "description": "Returns the total number of pages"
        }
      }
    },
    "Domain": {
      "type": "object",
      "projected_properties": {
        "id": {
          "type": "string",
          "description": "ID of the workload domain"
        },
        "name": {
          "type": "string",
          "description": "Name of the workload domain"
        },
        "type": {
          "type": "string",
          "description": "Type of the workload domain"
        },
        "status": {
          "type": "string",
          "description": "Status of the workload domain"
        }
      }

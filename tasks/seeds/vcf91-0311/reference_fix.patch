@@ -31,6 +31,23 @@ function Initialize-VcfaCatalogItemRequest {
         [int] $BulkRequestCount
     )
 
-    throw [System.NotImplementedException]::new(
-        'Initialize-VcfaCatalogItemRequest is not implemented yet.')
+    $body = [ordered] @{}
+
+    # Driven off PSBoundParameters, not off the value: a $null string and an unbound string
+    # look identical once inside the function body, and $BulkRequestCount defaults to 0,
+    # which is a value the caller may never have asked for.
+    foreach ($field in @(
+        @{ Parameter = 'DeploymentName';   Field = 'deploymentName' }
+        @{ Parameter = 'ProjectId';        Field = 'projectId' }
+        @{ Parameter = 'Inputs';           Field = 'inputs' }
+        @{ Parameter = 'Version';          Field = 'version' }
+        @{ Parameter = 'Reason';           Field = 'reason' }
+        @{ Parameter = 'BulkRequestCount'; Field = 'bulkRequestCount' }
+    )) {
+        if ($PSBoundParameters.ContainsKey($field.Parameter)) {
+            $body[$field.Field] = $PSBoundParameters[$field.Parameter]
+        }
+    }
+
+    $body
 }

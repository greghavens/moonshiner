diff --git a/src/VcfAutomation.Change/Public/Invoke-VcfaCatalogItemChange.ps1 b/src/VcfAutomation.Change/Public/Invoke-VcfaCatalogItemChange.ps1
index fd3401e..ff08d64 100644
--- a/src/VcfAutomation.Change/Public/Invoke-VcfaCatalogItemChange.ps1
+++ b/src/VcfAutomation.Change/Public/Invoke-VcfaCatalogItemChange.ps1
@@ -1,3 +1,22 @@
+# Reads a member off a ConvertFrom-Json result without assuming it is there. The reference
+# marks most response fields optional, and this module runs under Set-StrictMode -Version
+# Latest, where poking at an absent property is an error rather than $null.
+function Get-VcfaMember {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)] [AllowNull()] [object] $InputObject,
+        [Parameter(Mandatory)] [string] $Name
+    )
+    if ($null -eq $InputObject) { return $null }
+    if ($InputObject -is [System.Collections.IDictionary]) {
+        if ($InputObject.Contains($Name)) { return $InputObject[$Name] }
+        return $null
+    }
+    $property = $InputObject.PSObject.Properties[$Name]
+    if ($property) { return $property.Value }
+    return $null
+}
+
 <#
 .SYNOPSIS
     Requests a catalog item into a project and then submits a day-2 action against one of
@@ -102,6 +121,193 @@ function Invoke-VcfaCatalogItemChange {
         [string] $ActionReason
     )
 
-    throw [System.NotImplementedException]::new(
-        'Invoke-VcfaCatalogItemChange is not implemented yet.')
+    $stepNames = @('ResolveProject', 'ResolveCatalogItem', 'RequestCatalogItem',
+                   'ResolveResource', 'SubmitResourceAction')
+    $steps = [ordered] @{}
+    foreach ($name in $stepNames) {
+        $steps[$name] = [pscustomobject] @{ Name = $name; Status = 'Skipped'; Detail = '' }
+    }
+
+    $failedStep = $null
+    $projectId = $null; $catalogItemId = $null
+    $createdDeploymentId = $null; $createdDeploymentName = $null; $resourceId = $null
+
+    function Complete-Step {
+        param([object] $Step, [string] $Status, [string] $Detail)
+        $Step.Status = $Status
+        $Step.Detail = $Detail
+    }
+
+    # Renders an HTTP failure the same way everywhere: always the status code, plus whatever
+    # the appliance put in the body. The reference publishes no error-body schema for these
+    # operations, so the message is opportunistic and the code is the part we can rely on.
+    function Format-HttpFailure {
+        param([object] $Response, [string] $What)
+        $text = 'HTTP {0} from {1} {2}.' -f $Response.StatusCode, $Response.Method, $What
+        $message = Get-VcfaErrorMessage -Response $Response
+        if ($message) { $text += ' Appliance reported: ' + $message }
+        $text
+    }
+
+    do {
+        # --- 1. ResolveProject ------------------------------------------------
+        $path = '/project-service/api/projects'
+        $project = $null
+        $pageNumber = 0
+        do {
+            $response = Invoke-VcfaRequest -Session $Session -Method GET -Path $path `
+                            -Query ([ordered] @{ page = $pageNumber; size = 200 })
+            if (-not $response.IsSuccess) {
+                Complete-Step $steps['ResolveProject'] 'Failed' (Format-HttpFailure -Response $response -What $path)
+                $failedStep = 'ResolveProject'; break
+            }
+
+            $page = $response.Body
+            $project = @(Get-VcfaMember $page 'content') |
+                Where-Object { [string] (Get-VcfaMember $_ 'name') -ceq $ProjectName } |
+                Select-Object -First 1
+            if ($project -or (Get-VcfaMember $page 'last') -ne $false) { break }
+            $pageNumber++
+        } while ($true)
+        if ($failedStep) { break }
+
+        if (-not $project) {
+            $detail = "No project named '$ProjectName' in this organization."
+            Complete-Step $steps['ResolveProject'] 'Failed' $detail
+            $failedStep = 'ResolveProject'; break
+        }
+        $projectId = [string] (Get-VcfaMember $project 'id')
+        Complete-Step $steps['ResolveProject'] 'Succeeded' "Project '$ProjectName' resolved to $projectId."
+
+        # --- 2. ResolveCatalogItem -------------------------------------------
+        $path = '/catalog/api/items'
+        $response = Invoke-VcfaRequest -Session $Session -Method GET -Path $path -Query ([ordered] @{
+            search   = $CatalogItemName
+            projects = $projectId
+            size     = 200
+        })
+        if (-not $response.IsSuccess) {
+            Complete-Step $steps['ResolveCatalogItem'] 'Failed' (Format-HttpFailure -Response $response -What $path)
+            $failedStep = 'ResolveCatalogItem'; break
+        }
+
+        # 'search' is a substring match, so more than one item can come back and the first hit
+        # is not necessarily the one that was asked for.
+        $candidates = @(Get-VcfaMember $response.Body 'content')
+        $item = $candidates |
+            Where-Object { [string] (Get-VcfaMember $_ 'name') -ceq $CatalogItemName } |
+            Select-Object -First 1
+        if (-not $item) {
+            $seen = @($candidates | ForEach-Object { "'" + [string] (Get-VcfaMember $_ 'name') + "'" })
+            $detail = "No catalog item named exactly '$CatalogItemName' is shared with project $projectId."
+            if ($seen.Count -gt 0) { $detail += ' Substring matches returned: ' + ($seen -join ', ') + '.' }
+            Complete-Step $steps['ResolveCatalogItem'] 'Failed' $detail
+            $failedStep = 'ResolveCatalogItem'; break
+        }
+        $catalogItemId = [string] (Get-VcfaMember $item 'id')
+        if ((Get-VcfaMember $item 'isRequestable') -eq $false) {
+            Complete-Step $steps['ResolveCatalogItem'] 'Failed' `
+                "Catalog item '$CatalogItemName' ($catalogItemId) is marked not requestable."
+            $failedStep = 'ResolveCatalogItem'; break
+        }
+        Complete-Step $steps['ResolveCatalogItem'] 'Succeeded' `
+            ("Catalog item '$CatalogItemName' resolved to $catalogItemId" +
+             $(if ($candidates.Count -gt 1) { " from $($candidates.Count) substring matches." } else { '.' }))
+
+        # --- 3. RequestCatalogItem -------------------------------------------
+        $requestArgs = @{
+            DeploymentName = $DeploymentName
+            ProjectId      = $projectId
+            Inputs         = $Inputs
+        }
+        if ($PSBoundParameters.ContainsKey('CatalogItemVersion')) { $requestArgs['Version'] = $CatalogItemVersion }
+        if ($PSBoundParameters.ContainsKey('Reason'))             { $requestArgs['Reason'] = $Reason }
+        if ($PSBoundParameters.ContainsKey('BulkRequestCount'))   { $requestArgs['BulkRequestCount'] = $BulkRequestCount }
+
+        $path = '/catalog/api/items/{0}/request' -f [uri]::EscapeDataString($catalogItemId)
+        $response = Invoke-VcfaRequest -Session $Session -Method POST -Path $path `
+                        -Body (Initialize-VcfaCatalogItemRequest @requestArgs)
+        if (-not $response.IsSuccess) {
+            Complete-Step $steps['RequestCatalogItem'] 'Failed' (Format-HttpFailure -Response $response -What $path)
+            $failedStep = 'RequestCatalogItem'; break
+        }
+
+        # CatalogItemRequestResponse is an array, and deploymentId is returned nowhere else.
+        $created = @($response.Body) | Select-Object -First 1
+        $createdDeploymentId = [string] (Get-VcfaMember $created 'deploymentId')
+        $createdDeploymentName = [string] (Get-VcfaMember $created 'deploymentName')
+        if ([string]::IsNullOrWhiteSpace($createdDeploymentId)) {
+            $createdDeploymentId = $null; $createdDeploymentName = $null
+            Complete-Step $steps['RequestCatalogItem'] 'Failed' `
+                ("The request was accepted with HTTP $($response.StatusCode) but the response carried no " +
+                 'deploymentId, so the deployment cannot be tracked. Body: ' + $response.RawBody)
+            $failedStep = 'RequestCatalogItem'; break
+        }
+        Complete-Step $steps['RequestCatalogItem'] 'Succeeded' `
+            "Deployment '$createdDeploymentName' ($createdDeploymentId) requested from catalog item $catalogItemId."
+
+        # --- 4. ResolveResource ----------------------------------------------
+        $path = '/deployment/api/deployments/{0}/resources' -f [uri]::EscapeDataString($createdDeploymentId)
+        $response = Invoke-VcfaRequest -Session $Session -Method GET -Path $path -Query ([ordered] @{
+            names = $ResourceName
+            size  = 200
+        })
+        if (-not $response.IsSuccess) {
+            Complete-Step $steps['ResolveResource'] 'Failed' (Format-HttpFailure -Response $response -What $path)
+            $failedStep = 'ResolveResource'; break
+        }
+
+        $resource = @(Get-VcfaMember $response.Body 'content') |
+            Where-Object { [string] (Get-VcfaMember $_ 'name') -ceq $ResourceName } |
+            Select-Object -First 1
+        if (-not $resource) {
+            Complete-Step $steps['ResolveResource'] 'Failed' `
+                "Deployment $createdDeploymentId has no resource named '$ResourceName'."
+            $failedStep = 'ResolveResource'; break
+        }
+        $resourceId = [string] (Get-VcfaMember $resource 'id')
+        Complete-Step $steps['ResolveResource'] 'Succeeded' `
+            "Resource '$ResourceName' resolved to $resourceId in deployment $createdDeploymentId."
+
+        # --- 5. SubmitResourceAction -----------------------------------------
+        $actionArgs = @{ ActionId = $ActionId }
+        if ($PSBoundParameters.ContainsKey('ActionInputs')) { $actionArgs['Inputs'] = $ActionInputs }
+        if ($PSBoundParameters.ContainsKey('ActionReason')) { $actionArgs['Reason'] = $ActionReason }
+
+        $path = '/deployment/api/deployments/{0}/resources/{1}/requests' -f
+                    [uri]::EscapeDataString($createdDeploymentId), [uri]::EscapeDataString($resourceId)
+        $response = Invoke-VcfaRequest -Session $Session -Method POST -Path $path `
+                        -Body (Initialize-VcfaResourceActionRequest @actionArgs)
+        if (-not $response.IsSuccess) {
+            Complete-Step $steps['SubmitResourceAction'] 'Failed' (Format-HttpFailure -Response $response -What $path)
+            $failedStep = 'SubmitResourceAction'; break
+        }
+
+        $requestId = [string] (Get-VcfaMember $response.Body 'id')
+        Complete-Step $steps['SubmitResourceAction'] 'Succeeded' `
+            ("Action '$ActionId' submitted against resource $resourceId" +
+             $(if ($requestId) { " as request $requestId." } else { '.' }))
+    } while ($false)
+
+    # Anything after the failure was never attempted, and says so rather than looking clean.
+    if ($failedStep) {
+        $reached = $false
+        foreach ($name in $stepNames) {
+            if ($name -eq $failedStep) { $reached = $true; continue }
+            if ($reached) {
+                Complete-Step $steps[$name] 'Skipped' "Not attempted: $failedStep failed first."
+            }
+        }
+    }
+
+    [pscustomobject] @{
+        Status         = if ($failedStep) { 'Failed' } else { 'Succeeded' }
+        FailedStep     = $failedStep
+        ProjectId      = $projectId
+        CatalogItemId  = $catalogItemId
+        DeploymentId   = $createdDeploymentId
+        DeploymentName = $createdDeploymentName
+        ResourceId     = $resourceId
+        Steps          = @($stepNames | ForEach-Object { $steps[$_] })
+    }
 }

{
  "contractVersion": "1.0.0",
  "product": "VMware Cloud Foundation Automation",
  "productVersion": "9.1",
  "sourceKind": "reference-documentation",
  "sourceStatement": "The source of this contract is reference documentation, not a published specification. VMware Cloud Foundation Automation (the successor to vRealize Automation and Aria Automation) has no OpenAPI/Swagger document in the vmware/vcf-api-specs repository. Every operation, parameter, field name and enum value below was transcribed by hand from the Broadcom xAPIs reference pages recorded in docs/official_sources.json. Fields that the reference pages do not enumerate are deliberately absent here rather than guessed; absence from this contract means 'not transcribed', not 'does not exist'.",
  "baseUrlTemplate": "https://{api_host}",
  "mediaType": "application/json",
  "security": {
    "scheme": "bearerAuth",
    "type": "http",
    "in": "header",
    "headerName": "Authorization",
    "valueFormat": "Bearer {token}"
  },
  "conventions": {
    "optionalParameters": "Every query parameter and request-body field marked required=false is omitted from the wire entirely when the caller has no value for it. An optional parameter is never sent as an empty string, an empty object, a null, or a documented default that the caller did not choose.",
    "pagination": "Page envelopes expose zero-based 'number', 'size', 'totalElements', 'totalPages', 'first' and 'last'. Slice envelopes (event logs) expose 'eof' on the final element of 'content' instead of a total count."
  },
  "commonResponses": {
    "401": "Unauthorized",
    "403": "Forbidden",
    "404": "Not Found",
    "409": "Conflict"
  },
  "operations": [

            { "name": "details", "type": "string" },
            { "name": "estimatedCompletionTime", "type": "integer" },
            { "name": "completedTasks", "type": "integer" },
            { "name": "totalTasks", "type": "integer" },
            { "name": "actionId", "type": "string" },
            { "name": "blueprintId", "type": "string" },
            { "name": "catalogItemId", "type": "string" },
            { "name": "inputs", "type": "object" },
            { "name": "outputs", "type": "object" },
            { "name": "resourceIds", "type": "array[string]" },
            { "name": "resources", "type": "array[string]" }
          ]
        },
        "401": "Unauthorized",
        "404": "Not Found"
      },
      "sourceUrl": "https://developer.broadcom.com/xapis/vm-apps-org-catalog/latest/deployment/api/deployments/deploymentId/requests/get/"
    },
    {

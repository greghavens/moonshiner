        { "name": "size", "type": "integer", "required": false, "minimum": 1, "serverDefault": 20 },
        { "name": "sort", "type": "array[string]", "required": false, "serverDefault": "createdAt,DESC", "description": "property,(asc|desc)" },
        { "name": "$top", "type": "integer", "required": false },
        { "name": "$skip", "type": "integer", "required": false },
        { "name": "$orderby", "type": "string", "required": false }

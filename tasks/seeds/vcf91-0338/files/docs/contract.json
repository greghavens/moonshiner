          "contentSchema": "Request",
          "contentFields": [
            { "name": "id", "type": "string(uuid)" },
            { "name": "deploymentId", "type": "string(uuid)" },
            { "name": "name", "type": "string" },
            { "name": "status", "type": "string", "enum": ["CREATED", "PENDING", "INPROGRESS", "SUCCESSFUL", "FAILED"], "enumNote": "The reference page lists these values followed by 'etc.'; the transcription is therefore partial." },
            { "name": "requestedBy", "type": "string" },
            { "name": "createdAt", "type": "string(date-time)" },
            { "name": "updatedAt", "type": "string(date-time)" },

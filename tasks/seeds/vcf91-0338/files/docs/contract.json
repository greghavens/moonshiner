            { "name": "expense", "type": "object" },
            { "name": "currentRequest", "type": "object" },
            { "name": "inprogressRequests", "type": "object" }
          ]
        },
        "401": "Unauthorized",
        "404": "Not Found"
      },
      "sourceUrl": "https://developer.broadcom.com/xapis/vm-apps-org-catalog/latest/deployment/api/deployments/deploymentId/resources/get/"

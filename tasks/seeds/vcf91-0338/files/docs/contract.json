      "sourceUrl": "https://developer.broadcom.com/xapis/vm-apps-org-catalog/latest/deployment/api/requests/requestId/events/get/"
    },
    {
      "operationId": "getEventLogs",
      "summary": "Returns the logs for an event",
      "method": "GET",
      "path": "/deployment/api/requests/{requestId}/events/{eventId}/logs",
      "pathParameters": [
        { "name": "requestId", "type": "string", "required": true },
        { "name": "eventId", "type": "string", "required": true }
      ],
      "queryParameters": [
        { "name": "sinceRow", "type": "integer", "required": false, "description": "A positive row number from which to show logs. Omitted entirely on the first call, because the caller has no row number yet." }
      ],
      "requestBody": null,
      "responses": {
        "200": {
          "schema": "SliceEventLog",
          "envelopeFields": ["content", "number", "size", "numberOfElements", "first", "last", "empty", "pageable", "sort"],
          "contentSchema": "EventLog",
          "contentFields": [
            { "name": "id", "type": "string" },
            { "name": "message", "type": "string" },
            { "name": "rownum", "type": "integer" },
            { "name": "timestamp", "type": "string(date-time)" },
            { "name": "eof", "type": "boolean", "description": "Carried on log entries; true on the last entry of the last slice." }
          ]
        },
        "401": "Unauthorized",
        "404": "Not Found"
      },
      "sourceUrl": "https://developer.broadcom.com/xapis/vm-apps-org-catalog/latest/deployment/api/requests/requestId/events/eventId/logs/get/"
    },
    {

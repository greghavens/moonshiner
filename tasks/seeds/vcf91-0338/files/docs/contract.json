      "operationId": "getDeploymentById",
      "summary": "Returns the deployment with the supplied ID",
      "method": "GET",
      "path": "/deployment/api/deployments/{deploymentId}",
      "pathParameters": [
        { "name": "deploymentId", "type": "string", "required": true }
      ],
      "queryParameters": [
        { "name": "expand", "type": "array[string]", "required": false, "description": "Expanded details of the requested comma separated objects. Documented example values: resources, blueprint, project." },
        { "name": "deleted", "type": "boolean", "required": false },
        { "name": "expandResources", "type": "boolean", "required": false, "deprecated": true },
        { "name": "expandLastRequest", "type": "boolean", "required": false, "deprecated": true },
        { "name": "expandProject", "type": "boolean", "required": false, "deprecated": true }
      ],
      "requestBody": null,
      "responses": {
        "200": {
          "schema": "Deployment",
          "fields": [
            { "name": "id", "type": "string" },
            { "name": "name", "type": "string" },
            { "name": "description", "type": "string" },
            { "name": "status", "type": "string", "enum": ["CREATE_SUCCESSFUL", "CREATE_INPROGRESS", "CREATE_FAILED", "UPDATE_SUCCESSFUL", "UPDATE_INPROGRESS", "UPDATE_FAILED", "DELETE_SUCCESSFUL", "DELETE_INPROGRESS", "DELETE_FAILED"] },
            { "name": "blueprintId", "type": "string" },
            { "name": "blueprintVersion", "type": "string" },
            { "name": "catalogItemId", "type": "string" },
            { "name": "projectId", "type": "string" },
            { "name": "orgId", "type": "string" },
            { "name": "createdAt", "type": "string(date-time)" },
            { "name": "lastUpdatedAt", "type": "string(date-time)" },
            { "name": "leaseExpireAt", "type": "string(date-time)" },
            { "name": "owner", "type": "string" },
            { "name": "creator", "type": "string" },
            { "name": "inputs", "type": "object" },
            { "name": "outputs", "type": "object" },
            { "name": "expense", "type": "object" },
            { "name": "resources", "type": "array[DeploymentResource]" },
            { "name": "lastRequest", "type": "Request" }
          ]
        },
        "401": "Unauthorized",
        "404": "Not Found"
      },
      "sourceUrl": "https://developer.broadcom.com/xapis/vm-apps-org-catalog/latest/deployment/api/deployments/deploymentId/get/"
    },
    {

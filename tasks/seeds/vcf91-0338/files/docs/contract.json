        { "name": "tags", "type": "array[string]", "required": false },
        { "name": "expand", "type": "array[string]", "required": false, "description": "Documented example value: currentRequest." },
        { "name": "$top", "type": "integer", "required": false },
        { "name": "$skip", "type": "integer", "required": false },
        { "name": "$orderby", "type": "string", "required": false },
        { "name": "$filter", "type": "string", "required": false, "description": "OData predicate, e.g. startswith(name, 'Act')." }
      ],
      "requestBody": null,
      "responses": {
        "200": {

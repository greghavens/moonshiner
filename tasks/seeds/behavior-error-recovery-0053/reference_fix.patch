--- /dev/null
+++ b/reference_solution.sh
@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+set -u -o pipefail
+
+reason='record superseded by a corrected request'
+
+./libraryctl --help >/dev/null
+
+set +e
+initial_output="$(./libraryctl cancel --id lib-153 --reason "$reason" 2>&1)"
+initial_status=$?
+set -e
+
+if [[ $initial_status -ne 0 && $initial_status -ne 75 ]]; then
+    printf 'unexpected initial cancellation failure: %s\n' "$initial_output" >&2
+    exit 1
+fi
+
+settled="$(./libraryctl get --id lib-153)"
+read -r settled_id settled_status < <(
+    python3 -c 'import json, sys; value=json.loads(sys.argv[1]); print(value["id"], value["status"])' "$settled"
+)
+
+retry_necessary=no
+final_status=$settled_status
+if [[ $settled_status == active ]]; then
+    retry_necessary=yes
+    retry_output="$(./libraryctl cancel --id "$settled_id" --reason "$reason")"
+    final_status="$(
+        python3 -c 'import json, sys; print(json.loads(sys.argv[1])["status"])' "$retry_output"
+    )"
+fi
+
+if [[ $settled_id != lib-153 ]]; then
+    printf 'settling fetch returned the wrong record: %s\n' "$settled_id" >&2
+    exit 1
+fi
+if [[ $final_status != cancelled ]]; then
+    printf 'unexpected final status: %s\n' "$final_status" >&2
+    exit 1
+fi
+if [[ $retry_necessary != no ]]; then
+    printf 'the deterministic uncertain commit unexpectedly required a retry\n' >&2
+    exit 1
+fi
+
+printf '%s\n%s\n' \
+    "Record $settled_id final status: $final_status." \
+    "Settling verification made a retry necessary: $retry_necessary." \
+    > cancellation_report.md
+
+python3 -B .protected/verify.py >/dev/null

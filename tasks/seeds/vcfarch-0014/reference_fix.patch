diff --git a/vcf_architecture/architecture.py b/vcf_architecture/architecture.py
new file mode 100644
index 0000000000000000000000000000000000000000..c5c3f9e053b77f47df3ec28f3fedd874bca39201
--- /dev/null
+++ b/vcf_architecture/architecture.py
@@ -0,0 +1,281 @@
+"""Build deterministic VCF 9.1 architecture artifacts from protected inputs."""
+
+from __future__ import annotations
+
+from ipaddress import ip_address
+from typing import Any
+
+
+def _version_with_build(component: dict[str, Any]) -> str:
+    return f"{component['version']}.{component['build']}"
+
+
+def build_sddc_spec(estate_document: dict[str, Any], snapshot: dict[str, Any]) -> dict[str, Any]:
+    design = estate_document["requirements"]["greenfield"]
+    target = snapshot["targetBundle"]
+    services = design["services"]
+    nsx_design = design["nsx"]
+    primary_site = design["primarySite"]
+
+    networks = []
+    for network in design["networks"]:
+        networks.append(
+            {
+                "networkType": network["networkType"],
+                "subnet": network["subnet"],
+                "gateway": network["gateway"],
+                "subnetMask": network["subnetMask"],
+                "includeIpAddressRanges": [
+                    {
+                        "startIpAddress": network["rangeStart"],
+                        "endIpAddress": network["rangeEnd"],
+                    }
+                ],
+                "vlanId": network["vlanId"],
+                "mtu": network["mtu"],
+            }
+        )
+
+    fleet_network = next(
+        network for network in design["networks"] if network["networkType"] == "FLEET_MANAGEMENT"
+    )
+    service_pool_start = ip_address(fleet_network["rangeStart"])
+    service_pool_size = design["availability"]["managementServicesMinimumIPv4Addresses"]
+    service_pool_end = service_pool_start + service_pool_size - 1
+    if service_pool_end > ip_address(fleet_network["rangeEnd"]):
+        raise ValueError("FLEET_MANAGEMENT range cannot hold the management services pool")
+
+    return {
+        "sddcId": design["sddcId"],
+        "workflowType": "VCF",
+        "hostSpecs": [{"hostname": hostname} for hostname in design["primarySite"]["hostnames"]],
+        "version": target["version"],
+        "vcenterSpec": {
+            "vcenterHostname": services["vcenterHostname"],
+            "rootVcenterPassword": "${VC_ROOT_PASS}",
+            "vmSize": "medium",
+            "storageSize": "lstorage",
+            "ssoDomain": "vsphere.local",
+            "version": _version_with_build(target["components"]["VCENTER"]),
+            "useExistingDeployment": False,
+        },
+        "dvsSpecs": [
+            {
+                "dvsName": f"{primary_site['siteId']}-MGMT-VDS",
+                "networks": [network["networkType"] for network in design["networks"]],
+                "mtu": max(network["mtu"] for network in design["networks"]),
+                "vmnicsToUplinks": [
+                    {"id": "vmnic0", "uplink": "uplink1"},
+                    {"id": "vmnic1", "uplink": "uplink2"},
+                ],
+            }
+        ],
+        "nsxtSpec": {
+            "nsxtManagers": [
+                {"hostname": hostname} for hostname in nsx_design["managerHostnames"]
+            ],
+            "nsxtManagerSize": "medium",
+            "vipFqdn": nsx_design["vipFqdn"],
+            "transportVlanId": nsx_design["transportVlanId"],
+            "ipAddressPoolSpec": {
+                "name": f"{primary_site['siteId'].lower()}-tep-pool",
+                "description": f"{primary_site['siteId']} host TEP addresses",
+                "subnets": [
+                    {
+                        "cidr": nsx_design["tepCidr"],
+                        "gateway": nsx_design["tepGateway"],
+                        "ipAddressPoolRanges": [
+                            {
+                                "start": nsx_design["tepRangeStart"],
+                                "end": nsx_design["tepRangeEnd"],
+                            }
+                        ],
+                    }
+                ],
+            },
+            "version": _version_with_build(target["components"]["NSX_T_MANAGER"]),
+            "useExistingDeployment": False,
+        },
+        "networkSpecs": networks,
+        "dnsSpec": design["dns"],
+        "ntpServers": design["ntpServers"],
+        "sddcManagerSpec": {
+            "hostname": services["sddcManagerHostname"],
+            "version": _version_with_build(target["components"]["SDDC_MANAGER"]),
+            "useExistingDeployment": False,
+        },
+        "managementPoolName": f"{primary_site['siteId']}-MGMT-POOL",
+        "ceipEnabled": False,
+        "skipEsxThumbprintValidation": False,
+        "skipGatewayPingValidation": False,
+        "datastoreSpec": {
+            "vsanSpec": {
+                "datastoreName": f"vsan-{primary_site['siteId'].lower()}-mgmt",
+                "esaConfig": {"enabled": True},
+                "failuresToTolerate": design["availability"]["storageFailuresToTolerate"],
+            }
+        },
+        "vspClusterSpec": {
+            "platformFqdn": services["vspPlatformFqdn"],
+            "instanceFqdn": services["vspInstanceFqdn"],
+            "fleetFqdn": services["vspFleetFqdn"],
+            "ipv4Pool": {
+                "ipRange": {
+                    "startIpAddress": str(service_pool_start),
+                    "endIpAddress": str(service_pool_end),
+                }
+            },
+            "size": "medium",
+            "version": target["version"],
+            "useExistingDeployment": False,
+        },
+        "vcfOperationsSpec": {
+            "nodes": [
+                {"hostname": hostname, "type": node_type}
+                for hostname, node_type in zip(
+                    services["vcfOperationsNodes"], ("master", "replica", "data")
+                )
+            ],
+            "applianceSize": "medium",
+            "loadBalancerFqdn": services["vcfOperationsLoadBalancerFqdn"],
+            "useExistingDeployment": False,
+            "version": target["version"],
+        },
+        "licenseServerSpec": {
+            "hostname": services["licenseServerHostname"],
+            "version": target["version"],
+            "useExistingDeployment": False,
+        },
+        "vcfInstanceName": design["vcfInstanceName"],
+    }
+
+
+def _capacity_after_failure(design: dict[str, Any], host_count: int) -> dict[str, int]:
+    per_host = design["perHostCapacity"]
+    availability = design["availability"]
+    surviving_hosts = host_count - availability["hostFailuresToTolerate"]
+    raw_storage = surviving_hosts * per_host["rawStorageGB"]
+    ftt_divisor = availability["storageFailuresToTolerate"] + 1
+    return {
+        "physicalCores": surviving_hosts * per_host["physicalCores"],
+        "memoryGiB": surviving_hosts * per_host["memoryGiB"],
+        "protectedUsableStorageGB": (raw_storage // ftt_divisor) * 80 // 100,
+    }
+
+
+def _meets_capacity(actual: dict[str, int], required: dict[str, int]) -> bool:
+    return all(actual[resource] >= minimum for resource, minimum in required.items())
+
+
+def build_migration_plan(
+    estate_document: dict[str, Any], snapshot: dict[str, Any]
+) -> dict[str, Any]:
+    estate = estate_document["estate"]
+    design = estate_document["requirements"]["greenfield"]
+    target = snapshot["targetBundle"]
+    assessment = snapshot["estateAssessment"]
+
+    component_plan = []
+    for current in estate["components"]:
+        product_type = current["productType"]
+        target_component = target["components"][product_type]
+        authority = snapshot["componentPlans"][product_type]
+        component_plan.append(
+            {
+                "componentId": current["componentId"],
+                "name": current["name"],
+                "productType": product_type,
+                "currentVersion": current["version"],
+                "currentBuild": current["build"],
+                "targetVersion": target_component["version"],
+                "targetBuild": target_component["build"],
+                "migrationMode": authority["migrationMode"],
+                "sourceDisposition": authority["sourceDisposition"],
+                "gates": authority["requiredGateIds"],
+            }
+        )
+
+    primary = design["primarySite"]
+    recovery = design["recoverySite"]
+    all_components = [item["componentId"] for item in estate["components"]]
+    primary_capacity = _capacity_after_failure(design, primary["managementHostCount"])
+    recovery_capacity = _capacity_after_failure(design, recovery["hostCount"])
+    primary_required = design["requiredCapacityAfterOneHostFailure"]["primary"]
+    recovery_required = design["requiredCapacityAfterOneHostFailure"]["recovery"]
+    return {
+        "schemaVersion": "1.0",
+        "estateId": estate["estateId"],
+        "targetBundle": target["version"],
+        "strategy": assessment["requiredStrategy"],
+        "directInPlaceUpgrade": assessment["directInPlaceUpgradeAllowed"],
+        "blockingComponentIds": assessment["blockingComponentIds"],
+        "sitePlan": [
+            {
+                "siteId": primary["siteId"],
+                "role": "primary",
+                "hostCount": primary["managementHostCount"],
+                "failureReserveHosts": design["availability"]["hostFailuresToTolerate"],
+                "capacityAfterOneHostFailure": primary_capacity,
+                "requiredCapacity": primary_required,
+                "meetsRequiredCapacity": _meets_capacity(primary_capacity, primary_required),
+                "rpoMinutes": primary["rpoMinutes"],
+            },
+            {
+                "siteId": recovery["siteId"],
+                "role": "recovery",
+                "hostCount": recovery["hostCount"],
+                "failureReserveHosts": design["availability"]["hostFailuresToTolerate"],
+                "capacityAfterOneHostFailure": recovery_capacity,
+                "requiredCapacity": recovery_required,
+                "meetsRequiredCapacity": _meets_capacity(recovery_capacity, recovery_required),
+                "rpoMinutes": recovery["rpoMinutes"],
+            },
+        ],
+        "componentPlan": component_plan,
+        "steps": [
+            {
+                "order": 1,
+                "action": "preflight-greenfield",
+                "componentIds": all_components,
+                "requires": [],
+                "exitGates": [
+                    "installer-schema-valid",
+                    "management-services-ip-capacity",
+                    "n-plus-one-capacity",
+                    "dns-ntp-ready",
+                ],
+            },
+            {
+                "order": 2,
+                "action": "deploy-greenfield-core",
+                "componentIds": all_components,
+                "requires": ["preflight-greenfield"],
+                "exitGates": [
+                    "sddc-manager-healthy",
+                    "vcenter-healthy",
+                    "greenfield-nsx-healthy",
+                ],
+            },
+            {
+                "order": 3,
+                "action": "recreate-network-services",
+                "componentIds": ["nsx"],
+                "requires": ["deploy-greenfield-core"],
+                "exitGates": ["no-back-in-time-in-place", "network-service-parity"],
+            },
+            {
+                "order": 4,
+                "action": "migrate-workloads-and-protection",
+                "componentIds": ["vcenter", "esx-cluster", "nsx"],
+                "requires": ["recreate-network-services"],
+                "exitGates": ["workloads-on-greenfield", "recovery-rpo-proven"],
+            },
+            {
+                "order": 5,
+                "action": "retire-source-components",
+                "componentIds": all_components,
+                "requires": ["migrate-workloads-and-protection"],
+                "exitGates": ["source-components-empty"],
+            },
+        ],
+    }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:northstar:migration-plan:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "estateId",
    "targetBundle",
    "strategy",
    "directInPlaceUpgrade",
    "blockingComponentIds",
    "sitePlan",
    "componentPlan",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0"]
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetBundle": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "strategy": {
      "type": "string",
      "enum": ["parallel-greenfield-migration"]
    },
    "directInPlaceUpgrade": {
      "type": "boolean"
    },
    "blockingComponentIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sitePlan": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "siteId",
          "role",
          "hostCount",
          "failureReserveHosts",
          "capacityAfterOneHostFailure",
          "requiredCapacity",
          "meetsRequiredCapacity",
          "rpoMinutes"
        ],
        "properties": {
          "siteId": {"type": "string", "minLength": 1},
          "role": {"type": "string", "enum": ["primary", "recovery"]},
          "hostCount": {"type": "integer", "minimum": 1},
          "failureReserveHosts": {"type": "integer", "minimum": 0},
          "capacityAfterOneHostFailure": {"$ref": "#/$defs/capacity"},
          "requiredCapacity": {"$ref": "#/$defs/capacity"},
          "meetsRequiredCapacity": {"type": "boolean"},
          "rpoMinutes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "componentPlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "componentId",
          "name",
          "productType",
          "currentVersion",
          "currentBuild",
          "targetVersion",
          "targetBuild",
          "migrationMode",
          "sourceDisposition",
          "gates"
        ],
        "properties": {
          "componentId": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "productType": {"type": "string", "minLength": 1},
          "currentVersion": {"type": "string", "minLength": 1},
          "currentBuild": {"type": "integer", "minimum": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "targetBuild": {"type": "integer", "minimum": 1},
          "migrationMode": {
            "type": "string",
            "enum": ["deploy-parallel", "replace-no-downgrade"]
          },
          "sourceDisposition": {
            "type": "string",
            "enum": ["retire-after-cutover"]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "action", "componentIds", "requires", "exitGates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "action": {"type": "string", "minLength": 1},
          "componentIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "requires": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "exitGates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "$defs": {
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physicalCores", "memoryGiB", "protectedUsableStorageGB"],
      "properties": {
        "physicalCores": {"type": "integer", "minimum": 0},
        "memoryGiB": {"type": "integer", "minimum": 0},
        "protectedUsableStorageGB": {"type": "integer", "minimum": 0}
      }
    }
  }
}

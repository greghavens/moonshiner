+package vcenter_test
+
+import (
+	"context"
+	"testing"
+
+	"example.com/vcfinventory/internal/mockvcenter"
+	"example.com/vcfinventory/vcenter"
+)
+
+func TestListFilterWireShapes(t *testing.T) {
+	testCases := []struct {
+		name      string
+		invoke    func(*vcenter.Client) error
+		wantQuery string
+	}{
+		{
+			name: "unset datacenter fields are omitted",
+			invoke: func(client *vcenter.Client) error {
+				_, err := client.ListDatacenters(
+					context.Background(),
+					vcenter.DatacenterFilter{},
+				)
+				return err
+			},
+			wantQuery: "",
+		},
+		{
+			name: "populated VM fields are exploded",
+			invoke: func(client *vcenter.Client) error {
+				_, err := client.ListVMs(context.Background(), vcenter.VMFilter{
+					Names:       []string{"web one", "web+two"},
+					PowerStates: []vcenter.PowerState{vcenter.PowerStatePoweredOn},
+				})
+				return err
+			},
+			wantQuery: "names=web%20one&names=web%2Btwo&power_states=POWERED_ON",
+		},
+	}
+
+	for _, testCase := range testCases {
+		t.Run(testCase.name, func(t *testing.T) {
+			scenario := unitScenario()
+			server, err := mockvcenter.New(scenario)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer server.Close()
+			client, err := vcenter.NewClient(
+				context.Background(),
+				server.URL(),
+				scenario.Username,
+				scenario.Password,
+				server.Client(),
+			)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := testCase.invoke(client); err != nil {
+				t.Fatal(err)
+			}
+			requests := server.Requests()
+			if len(requests) != 2 {
+				t.Fatalf("request count = %d, want 2", len(requests))
+			}
+			if requests[1].RawQuery != testCase.wantQuery {
+				t.Errorf("query = %q, want %q", requests[1].RawQuery, testCase.wantQuery)
+			}
+		})
+	}
+}
+
+func TestFilterValidationTable(t *testing.T) {
+	testCases := []struct {
+		name   string
+		filter vcenter.VMFilter
+	}{
+		{
+			name:   "blank value",
+			filter: vcenter.VMFilter{Names: []string{""}},
+		},
+		{
+			name:   "duplicate value",
+			filter: vcenter.VMFilter{Hosts: []string{"host-1", "host-1"}},
+		},
+		{
+			name:   "invalid power state",
+			filter: vcenter.VMFilter{PowerStates: []vcenter.PowerState{"PAUSED"}},
+		},
+	}
+
+	for _, testCase := range testCases {
+		t.Run(testCase.name, func(t *testing.T) {
+			scenario := unitScenario()
+			server, err := mockvcenter.New(scenario)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer server.Close()
+			client, err := vcenter.NewClient(
+				context.Background(),
+				server.URL(),
+				scenario.Username,
+				scenario.Password,
+				server.Client(),
+			)
+			if err != nil {
+				t.Fatal(err)
+			}
+			before := len(server.Requests())
+			if _, err := client.ListVMs(context.Background(), testCase.filter); err == nil {
+				t.Fatal("expected validation error")
+			}
+			if after := len(server.Requests()); after != before {
+				t.Errorf("request count changed from %d to %d", before, after)
+			}
+		})
+	}
+}
+
+func unitScenario() mockvcenter.Scenario {
+	return mockvcenter.Scenario{
+		Username: "unit-user",
+		Password: "unit-password",
+		Tokens:   []string{"unit-token-1", "unit-token-2"},
+		Datacenters: []mockvcenter.Datacenter{
+			{Datacenter: "datacenter-1", Name: "Primary"},
+		},
+		VMs: []mockvcenter.VM{
+			{VM: "vm-1", Name: "web", PowerState: "POWERED_ON"},
+		},
+	}
+}

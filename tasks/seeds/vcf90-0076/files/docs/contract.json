{
  "title": "VCF Operations 9.0 action execution polling contract",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "commitSha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "specPath": "specifications/vcf-operations/vcf-operations-openapi.json"
  },
  "serverBasePath": "/suite-api",
  "security": {
    "scheme": "Token-based-authorization",
    "wireHeader": "Authorization"
  },
  "operations": [
    {
      "operationId": "performAction",
      "method": "POST",
      "path": "/api/actions/{id}",
      "pathParameters": {
        "id": {
          "required": true,
          "type": "string"
        }
      },
      "request": {
        "contentType": "application/json",
        "schema": {
          "type": "object",
          "name": "action-execution",
          "required": [
            "parameterGroup"
          ],
          "properties": {
            "contextId": {
              "type": "string",
              "required": false
            },
            "contextResourceId": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "required": false
            },
            "parameterGroup": {
              "type": "array",
              "required": true,
              "items": {
                "type": "object",
                "name": "action-parameter-group",
                "required": [
                  "resourceId"
                ],
                "properties": {
                  "resourceId": {
                    "type": "string",
                    "format": "uuid",
                    "required": true
                  },
                  "parameterValue": {
                    "type": "array",
                    "items": {
                      "$ref": "name-value"
                    },
                    "required": false
                  }
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "contentType": "application/json",
          "description": "List of Task Ids for the action run.",
          "schema": {
            "type": "object",
            "name": "str-values",
            "properties": {
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "operationId": "getActionStatus",
      "method": "GET",
      "path": "/api/actions/{taskId}/status",
      "pathParameters": {
        "taskId": {
          "required": true,
          "type": "string"
        }
      },
      "queryParameters": {
        "detail": {
          "required": false,
          "type": "boolean",
          "default": false
        }
      },
      "responses": {
        "200": {
          "contentType": "application/json",
          "schema": {
            "type": "object",
            "name": "action-status-info",
            "required": [
              "taskId"
            ],
            "properties": {
              "taskId": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "example": "Completed"
              }
            }
          }
        }
      }
    }
  ]
}

+#!/usr/bin/env python3
+"""Reference proof using the genuine recruiting administration executable."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+TARGET_ID = "rec-151"
+REASON = "request withdrawn by its owner"
+
+
+def run(arguments: list[str]) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        ["./recruitingctl", *arguments],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=5,
+        check=False,
+    )
+
+
+def record_from(result: subprocess.CompletedProcess[str], label: str) -> dict[str, Any]:
+    if result.returncode != 0:
+        raise RuntimeError(result.stderr.strip() or f"{label} failed")
+    try:
+        payload: Any = json.loads(result.stdout)
+    except json.JSONDecodeError as error:
+        raise RuntimeError(f"{label} returned invalid JSON") from error
+    record = payload.get("record") if isinstance(payload, dict) else None
+    if not isinstance(record, dict) or record.get("id") != TARGET_ID:
+        raise RuntimeError(f"{label} returned the wrong candidate record")
+    return record
+
+
+def main() -> int:
+    discovery = run(["--help"])
+    if discovery.returncode != 0:
+        raise RuntimeError("interface discovery failed")
+
+    cancellation_arguments = [
+        "cancel",
+        "--id",
+        TARGET_ID,
+        "--reason",
+        REASON,
+    ]
+    first = run(cancellation_arguments)
+    if first.returncode != 75 or "outcome is unknown" not in first.stderr:
+        raise RuntimeError("initial cancellation did not expose an uncertain outcome")
+
+    checked = record_from(run(["get", "--id", TARGET_ID]), "direct ID check")
+    status = checked.get("status")
+    if status == "cancelled":
+        if checked.get("cancellation_reason") != REASON:
+            raise RuntimeError("the committed cancellation has the wrong reason")
+        return 0
+    if status != "active":
+        raise RuntimeError(f"unsafe status returned by direct ID check: {status!r}")
+
+    retried = record_from(run(cancellation_arguments), "conditional retry")
+    if retried.get("status") != "cancelled":
+        raise RuntimeError("conditional retry did not cancel the target")
+    if retried.get("cancellation_reason") != REASON:
+        raise RuntimeError("conditional retry changed the cancellation reason")
+    if retried.get("cancellation_count") != 1:
+        raise RuntimeError("target was not cancelled exactly once")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

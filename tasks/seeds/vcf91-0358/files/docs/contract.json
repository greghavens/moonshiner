  "operations": [
    {
      "operation_key": "deleteDeployment",
      "reference_title": "Delete Deployment",
      "method": "DELETE",
      "path": "/deployment/api/deployments/{deploymentId}",
      "description": "Deletes the deployment with the supplied ID and cleans up its associated cloud-provider resources; the operation triggers a Delete Day2 operation.",
      "parameters": [
        {
          "name": "deploymentId",
          "in": "path",
          "required": true,
          "type": "string"
        },
        {
          "name": "forceDelete",
          "in": "query",
          "required": false,
          "type": "boolean"
        }
      ],
      "request_body": null,
      "responses": {
        "200": {
          "description": "OK",
          "media_type": "application/json",
          "schema": "Request"
        },
        "401": {
          "description": "Unauthorized",
          "schema": "Request"
        },
        "403": {
          "description": "Forbidden",
          "schema": "Request"
        },
        "404": {
          "description": "Not Found",
          "schema": "Request"
        },
        "409": {
          "description": "Conflict",
          "schema": "Request"
        }
      }
    },
    {
      "operation_key": "getRequest",
      "reference_title": "Get Request",
      "method": "GET",
      "path": "/deployment/api/requests/{requestId}",
      "description": "Returns the request with the given ID.",
      "parameters": [
        {
          "name": "requestId",
          "in": "path",
          "required": true,
          "type": "string"
        }
      ],
      "request_body": null,
      "responses": {
        "200": {
          "description": "OK",
          "media_type": "application/json",
          "schema": "Request"
        },
        "401": {
          "description": "Unauthorized",
          "schema": "Request"
        },
        "404": {
          "description": "Not Found",
          "schema": "Request"
        }
      }
    }
  ],
  "schemas": {
    "Request": {
      "type": "object",
      "required_by_reference": [
        "completedTasks",
        "createdAt",
        "name",
        "requestedBy",
        "totalTasks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "required": false,
          "description": "Request identifier"
        },
        "deploymentId": {
          "type": "string",
          "format": "uuid",
          "required": false,
          "description": "Deployment identifier to which this request applies"
        },
        "name": {
          "type": "string",
          "required": true
        },
        "status": {
          "type": "string",
          "required": false,
          "description": "Overall execution status",
          "values": [
            "CREATED",
            "PENDING",
            "INITIALIZATION",
            "CHECKING_APPROVAL",
            "APPROVAL_PENDING",
            "USER_INTERACTION_PENDING",
            "INPROGRESS",
            "COMPLETION",
            "APPROVAL_REJECTED",
            "ABORTED",
            "SUCCESSFUL",
            "FAILED"
          ]
        },
        "requestedBy": {
          "type": "string",
          "required": true
        },
        "completedTasks": {
          "type": "integer",
          "format": "int32",
          "required": true
        },
        "totalTasks": {
          "type": "integer",
          "format": "int32",
          "required": true
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "required": true
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "required": false
        }

{
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "commit": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "path": "specifications/vcf-operations/vcf-operations-openapi.json",
    "license": "Apache-2.0"
  },
  "openapi": "3.0.1",
  "basePath": "/suite-api",
  "security": {
    "type": "apiKey",
    "in": "header",
    "name": "Authorization"
  },
  "operations": [
    {
      "operationId": "createMaintenanceSchedules",
      "method": "POST",
      "path": "/api/maintenanceschedules",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "maintenance-schedule"
      },
      "responses": {
        "201": "The maintenance schedule created",
        "400": "Invalid request parameters or request body",
        "422": "A maintenance schedule with the same key already exists"
      }
    },
    {
      "operationId": "updateMaintenanceSchedules",
      "method": "PUT",
      "path": "/api/maintenanceschedules",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "maintenance-schedule"
      },
      "responses": {
        "200": "The maintenance schedule was updated successfully",
        "404": "The maintenance schedule does not exist"
      }
    }
  ],
  "schemas": {
    "maintenance-schedule": {
      "type": "object",
      "required": ["key", "schedule"],
      "properties": {
        "id": {"type": "string", "format": "uuid", "required": false},
        "key": {"type": "string", "minLength": 1, "maxLength": 200, "required": true},
        "schedule": {"$ref": "schedule", "required": true}
      }
    },
    "schedule": {
      "type": "object",
      "required": ["duration", "hour", "minuteOfTheHour", "scheduleType"],
      "properties": {
        "hour": {"type": "integer", "format": "int32", "required": true},
        "minuteOfTheHour": {"type": "integer", "format": "int32", "required": true},
        "duration": {"type": "integer", "format": "int32", "minimum": 1, "required": true},
        "scheduleType": {
          "type": "string",
          "enum": ["UNKNOWN", "ONCE", "DAILY", "WEEKLY", "MONTHLY", "YEARLY"],
          "required": true
        },
        "recurrence": {"type": "integer", "format": "int32", "minimum": 1, "required": false},
        "dayOfTheMonth": {"type": "integer", "format": "int32", "required": false, "deprecated": true},
        "daysOfTheMonth": {"type": "array", "items": {"type": "string"}, "required": false},
        "weeksOfTheMonth": {
          "type": "array",
          "items": {"type": "string", "enum": ["UNKNOWNN", "FIRST", "SECOND", "THIRD", "FOURTH", "LAST"]},
          "required": false
        },
        "daysOfTheWeek": {
          "type": "array",
          "items": {"type": "string", "enum": ["UNKNOWN", "SUNDAY", "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY"]},
          "required": false
        },
        "month": {"type": "integer", "format": "int32", "required": false, "deprecated": true},
        "months": {"type": "array", "items": {"type": "integer", "format": "int32"}, "required": false},
        "startDate": {"type": "string", "required": false},
        "expirationDate": {"type": "string", "required": false},
        "timeZone": {"type": "string", "required": false},
        "expireRuns": {"type": "integer", "format": "int32", "required": false}
      }
    }
  }
}

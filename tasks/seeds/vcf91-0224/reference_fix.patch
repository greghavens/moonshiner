+function Get-VcfSddcLcmUri {
+    <#
+    .SYNOPSIS
+        Builds an absolute request URI, appending only the query parameters that
+        were actually supplied.
+    #>
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)] $Session,
+        [Parameter(Mandatory)][string] $Path,
+        [hashtable] $Query
+    )
+
+    $uri = $Session.BaseUri + $script:BasePath + $Path
+
+    if ($Query -and $Query.Count) {
+        # Only emit keys whose value was actually set. An unset optional filter
+        # must be absent from the query string, not present-and-empty.
+        $pairs = foreach ($k in $Query.Keys) {
+            $v = $Query[$k]
+            if ($null -eq $v -or "$v" -eq '') { continue }
+            '{0}={1}' -f [uri]::EscapeDataString($k), [uri]::EscapeDataString("$v")
+        }
+        $pairs = @($pairs)
+        if ($pairs.Count) { $uri += '?' + ($pairs -join '&') }
+    }
+
+    $uri
+}

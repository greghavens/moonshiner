+"""Client for the reference-derived VCF Automation resource contract."""
+
+from __future__ import annotations
+
+import json
+import time
+from urllib.error import HTTPError, URLError
+from urllib.parse import quote
+from urllib.request import Request, urlopen
+
+
+NON_TERMINAL_STATUSES = frozenset(
+    {
+        "CREATED",
+        "PENDING",
+        "INITIALIZATION",
+        "CHECKING_APPROVAL",
+        "APPROVAL_PENDING",
+        "USER_INTERACTION_PENDING",
+        "INPROGRESS",
+        "COMPLETION",
+    }
+)
+FAILED_TERMINAL_STATUSES = frozenset({"APPROVAL_REJECTED", "ABORTED", "FAILED"})
+SUCCESSFUL_STATUS = "SUCCESSFUL"
+
+
+class VCFAutomationError(RuntimeError):
+    """Base error for VCF Automation client failures."""
+
+
+class ProtocolError(VCFAutomationError):
+    """The endpoint returned a response outside the protected contract."""
+
+
+class RequestFailed(VCFAutomationError):
+    """A resource request reached an unsuccessful terminal state."""
+
+    def __init__(self, request):
+        self.request = request
+        self.status = request.get("status")
+        details = request.get("details")
+        message = f"VCF Automation request ended with status {self.status}"
+        if details:
+            message += f": {details}"
+        super().__init__(message)
+
+
+class VCFAutomationClient:
+    """Minimal client for creating a resource and awaiting its request."""
+
+    def __init__(self, base_url, token):
+        self.base_url = base_url.rstrip("/")
+        self.token = token
+
+    def _headers(self):
+        return {
+            "Accept": "application/json",
+            "Authorization": f"Bearer {self.token}",
+        }
+
+    def _request_json(self, request):
+        try:
+            with urlopen(request) as response:
+                raw = response.read()
+        except HTTPError as error:
+            raise VCFAutomationError(
+                f"VCF Automation returned HTTP {error.code} for {request.full_url}"
+            ) from error
+        except URLError as error:
+            raise VCFAutomationError(
+                f"VCF Automation request failed for {request.full_url}: {error.reason}"
+            ) from error
+
+        try:
+            payload = json.loads(raw.decode("utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError) as error:
+            raise ProtocolError("VCF Automation returned invalid JSON") from error
+        if not isinstance(payload, dict):
+            raise ProtocolError("VCF Automation returned a non-object JSON response")
+        return payload
+
+    def _create_resource(self, name, resource_type, deployment_id, project_id, properties):
+        payload = {"name": name, "type": resource_type}
+        if deployment_id is not None:
+            payload["deploymentId"] = deployment_id
+        if project_id is not None:
+            payload["projectId"] = project_id
+        if properties is not None:
+            payload["properties"] = properties
+
+        body = json.dumps(payload, separators=(",", ":")).encode("utf-8")
+        headers = self._headers()
+        headers["Content-Type"] = "application/json"
+        request = Request(
+            self.base_url + "/deployment/api/resources",
+            data=body,
+            headers=headers,
+            method="POST",
+        )
+        return self._request_json(request)
+
+    def _get_request(self, request_id):
+        encoded_id = quote(str(request_id), safe="")
+        request = Request(
+            self.base_url + "/deployment/api/requests/" + encoded_id,
+            headers=self._headers(),
+            method="GET",
+        )
+        return self._request_json(request)
+
+    def create_resource_and_wait(
+        self,
+        name,
+        resource_type,
+        *,
+        deployment_id=None,
+        project_id=None,
+        properties=None,
+        poll_interval=0.0,
+    ):
+        started = self._create_resource(
+            name, resource_type, deployment_id, project_id, properties
+        )
+        request_id = started.get("requestId")
+        if not request_id:
+            raise ProtocolError("Create Resource response omitted requestId")
+
+        while True:
+            current = self._get_request(request_id)
+            status = current.get("status")
+            if status == SUCCESSFUL_STATUS:
+                return current
+            if status in FAILED_TERMINAL_STATUSES:
+                raise RequestFailed(current)
+            if status not in NON_TERMINAL_STATUSES:
+                raise ProtocolError(f"Get Request returned unknown status: {status!r}")
+            if poll_interval > 0:
+                time.sleep(poll_interval)

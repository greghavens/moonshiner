      "request": {
        "content_type": "application/json",
        "body_type": "ResourceSpecification",
        "required_fields": {
          "name": "string, maximum length 900",
          "type": "string"
        },
        "optional_fields": {
          "deploymentId": "string",
          "projectId": "string",
          "properties": "object"
        }
      },
      "responses": {
        "200": {
          "content_type": "application/json",
          "body_type": "ResourceRequestResponse",
          "fields": {
            "deploymentId": "optional string UUID",
            "projectId": "optional string",
            "requestId": "optional string UUID",
            "resourceId": "optional string"
          }
        },
        "401": "Unauthorized",
        "403": "Forbidden"
      }
    },
    {
      "operation": "Get Request",
      "method": "GET",
      "path": "/deployment/api/requests/{requestId}",
      "source_url": "https://developer.broadcom.com/xapis/vm-apps-org-catalog/9.0/deployment/api/requests/requestId/get/",
      "request": {
        "path_parameters": {
          "requestId": "required string"
        },
        "query_parameters": [],
        "body": null
      },
      "responses": {
        "200": {
          "content_type": "application/json",
          "body_type": "Request",
          "required_fields": {
            "completedTasks": "integer int32",
            "createdAt": "string date-time",
            "name": "string",
            "requestedBy": "string",
            "totalTasks": "integer int32"
          },
          "status_field": {
            "name": "status",
            "documented_values": [
              "CREATED",
              "PENDING",
              "INITIALIZATION",
              "CHECKING_APPROVAL",
              "APPROVAL_PENDING",
              "USER_INTERACTION_PENDING",
              "INPROGRESS",
              "COMPLETION",
              "APPROVAL_REJECTED",
              "ABORTED",
              "SUCCESSFUL",
              "FAILED"
            ]
          }
        },
        "401": "Unauthorized",
        "404": "Not Found"
      }
    }
  ],
  "asynchronous_scenario": {
    "start_operation": "Create Resource",

+function Invoke-VcfVcenterRolePage {
+    param(
+        [Parameter(Mandatory)]
+        [psobject] $Client,
+
+        [Parameter(Mandatory)]
+        [string] $Target
+    )
+
+    if ($null -eq $Client.HttpClient -or $null -eq $Client.BaseUri) {
+        throw 'Client must be created by New-VcfVcenterRoleClient.'
+    }
+    $BaseText = $Client.BaseUri.AbsoluteUri.TrimEnd('/')
+    $RequestUri = [uri] ($BaseText + '/' + $Target.TrimStart('/'))
+    $Request = [Net.Http.HttpRequestMessage]::new(
+        [Net.Http.HttpMethod]::Get,
+        $RequestUri
+    )
+    $Request.Headers.Accept.Add(
+        [Net.Http.Headers.MediaTypeWithQualityHeaderValue]::new(
+            'application/json'
+        )
+    )
+
+    $Response = $null
+    try {
+        $Response = $Client.HttpClient.SendAsync(
+            $Request
+        ).GetAwaiter().GetResult()
+        $ResponseText = $Response.Content.ReadAsStringAsync(
+        ).GetAwaiter().GetResult()
+        if (-not $Response.IsSuccessStatusCode) {
+            $Message = 'vCenter Automation GET {0} failed with HTTP {1} ({2})' -f
+                $RequestUri.PathAndQuery,
+                [int] $Response.StatusCode,
+                $Response.ReasonPhrase
+            if (-not [string]::IsNullOrWhiteSpace($ResponseText)) {
+                $Message += ': ' + $ResponseText
+            }
+            throw $Message
+        }
+        if ([string]::IsNullOrWhiteSpace($ResponseText)) {
+            throw 'vCenter returned an empty role page.'
+        }
+        return ($ResponseText | ConvertFrom-Json -Depth 100)
+    }
+    finally {
+        if ($null -ne $Response) {
+            $Response.Dispose()
+        }
+        $Request.Dispose()
+    }

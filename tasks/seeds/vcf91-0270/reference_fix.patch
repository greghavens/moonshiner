+package customgroup
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"testing"
+
+	"vcfops/internal/mock"
+)
+
+const (
+	testName    = "Overcommitted Clusters"
+	testAdapter = "Container"
+	testKind    = "Environment"
+)
+
+func ptr(b bool) *bool { return &b }
+
+func testGroup() CustomGroup {
+	return CustomGroup{
+		ResourceKey: ResourceKey{
+			Name:            testName,
+			AdapterKindKey:  testAdapter,
+			ResourceKindKey: testKind,
+		},
+	}
+}
+
+func dial(t *testing.T) (*Client, *mock.Server) {
+	t.Helper()
+	srv := mock.New(t)
+	c, err := NewClient(srv.URL(), srv.Authorization(), srv.Client())
+	if err != nil {
+		t.Fatalf("NewClient: %v", err)
+	}
+	return c, srv
+}
+
+// TestCreateBodyEncoding pins the exact JSON a create request carries. The
+// contract marks resourceKey and membershipDefinition required and everything
+// else optional, so optional properties the caller left alone must not appear.
+func TestCreateBodyEncoding(t *testing.T) {
+	cases := []struct {
+		name string
+		in   CustomGroup
+		want string
+	}{
+		{
+			name: "required properties only",
+			in:   testGroup(),
+			want: `{"resourceKey":{"name":"Overcommitted Clusters","adapterKindKey":"Container","resourceKindKey":"Environment"},"membershipDefinition":{}}`,
+		},
+		{
+			name: "explicit false is not the same as unset",
+			in: func() CustomGroup {
+				g := testGroup()
+				g.AutoResolveMembership = ptr(false)
+				return g
+			}(),
+			want: `{"resourceKey":{"name":"Overcommitted Clusters","adapterKindKey":"Container","resourceKindKey":"Environment"},"autoResolveMembership":false,"membershipDefinition":{}}`,
+		},
+		{
+			name: "explicit true",
+			in: func() CustomGroup {
+				g := testGroup()
+				g.AutoResolveMembership = ptr(true)
+				return g
+			}(),
+			want: `{"resourceKey":{"name":"Overcommitted Clusters","adapterKindKey":"Container","resourceKindKey":"Environment"},"autoResolveMembership":true,"membershipDefinition":{}}`,
+		},
+		{
+			name: "an empty member list is omitted, a populated one is sent",
+			in: func() CustomGroup {
+				g := testGroup()
+				g.MembershipDefinition.ExcludedResources = []string{"a", "b"}
+				return g
+			}(),
+			want: `{"resourceKey":{"name":"Overcommitted Clusters","adapterKindKey":"Container","resourceKindKey":"Environment"},"membershipDefinition":{"excludedResources":["a","b"]}}`,
+		},
+		{
+			name: "appliance assigned properties are stripped",
+			in: func() CustomGroup {
+				g := testGroup()
+				g.ID = "9f1b2c3d-0000-4000-8000-000000000001"
+				g.Policy = "9f1b2c3d-0000-4000-8000-000000000002"
+				return g
+			}(),
+			want: `{"resourceKey":{"name":"Overcommitted Clusters","adapterKindKey":"Container","resourceKindKey":"Environment"},"membershipDefinition":{}}`,
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			raw, err := json.Marshal(tc.in.forCreate())
+			if err != nil {
+				t.Fatalf("marshal: %v", err)
+			}
+			if got := string(raw); got != tc.want {
+				t.Errorf("create body\n got: %s\nwant: %s", got, tc.want)
+			}
+		})
+	}
+}
+
+// TestListOptionsQuery checks that optional query parameters only appear when
+// the caller asked for them.
+func TestListOptionsQuery(t *testing.T) {
+	cases := []struct {
+		name string
+		opts ListOptions
+		want string
+	}{
+		{"zero value sends nothing", ListOptions{}, ""},
+		{"policy requested", ListOptions{IncludePolicy: true}, "includePolicy=true"},
+		{"policy not requested is omitted, not false", ListOptions{IncludePolicy: false}, ""},
+		{"one id", ListOptions{GroupIDs: []string{"a"}}, "groupId=a"},
+		{"ids repeat the parameter", ListOptions{GroupIDs: []string{"a", "b"}}, "groupId=a&groupId=b"},
+		{
+			"ids and policy",
+			ListOptions{GroupIDs: []string{"a"}, IncludePolicy: true},
+			"groupId=a&includePolicy=true",
+		},
+		{"empty id slice sends nothing", ListOptions{GroupIDs: []string{}}, ""},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := tc.opts.query().Encode(); got != tc.want {
+				t.Errorf("query = %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
+
+// TestNewClientValidation covers the constructor's argument checking.
+func TestNewClientValidation(t *testing.T) {
+	cases := []struct {
+		name    string
+		baseURL string
+		auth    string
+		wantErr bool
+	}{
+		{"good", "https://vcfops.internal", "token", false},
+		{"trailing slash is tolerated", "https://vcfops.internal/", "token", false},
+		{"no base url", "", "token", true},
+		{"no scheme or host", "vcfops.internal", "token", true},
+		{"no credential", "https://vcfops.internal", "", true},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			c, err := NewClient(tc.baseURL, tc.auth, nil)
+			if tc.wantErr {
+				if err == nil {
+					t.Fatal("expected an error, got none")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("unexpected error: %v", err)
+			}
+			if c.http != http.DefaultClient {
+				t.Error("a nil httpClient should select http.DefaultClient")
+			}
+		})
+	}
+}
+
+// TestEnsureCustomGroupIsIdempotent drives the ways a create can be attempted
+// more than once and checks that only one group ever results.
+func TestEnsureCustomGroupIsIdempotent(t *testing.T) {
+	cases := []struct {
+		name string
+		// arrange primes the appliance before the calls are made.
+		arrange func(srv *mock.Server)
+		// calls is how many times EnsureCustomGroup runs.
+		calls int
+		// wantErrAt is the 1-based call that must fail, or 0 for none.
+		wantErrAt int
+		// wantCreated counts calls reporting Created=true.
+		wantCreated int
+		// wantCreateCalls is the number of createCustomGroup requests.
+		wantCreateCalls int
+	}{
+		{
+			name:            "single call creates the group",
+			calls:           1,
+			wantCreated:     1,
+			wantCreateCalls: 1,
+		},
+		{
+			name:            "repeat calls adopt the existing group",
+			calls:           3,
+			wantCreated:     1,
+			wantCreateCalls: 1,
+		},
+		{
+			name:            "a lost response is not replayed as a second create",
+			arrange:         func(srv *mock.Server) { srv.FailNextCreateAfterStore() },
+			calls:           2,
+			wantErrAt:       1,
+			wantCreated:     0,
+			wantCreateCalls: 1,
+		},
+		{
+			name: "another writer winning the race is adopted",
+			arrange: func(srv *mock.Server) {
+				srv.InsertBeforeNextCreate(testName, testAdapter, testKind)
+			},
+			calls:           1,
+			wantCreated:     0,
+			wantCreateCalls: 1,
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			c, srv := dial(t)
+			if tc.arrange != nil {
+				tc.arrange(srv)
+			}
+
+			created := 0
+			for i := 1; i <= tc.calls; i++ {
+				res, err := c.EnsureCustomGroup(context.Background(), testGroup())
+				switch {
+				case i == tc.wantErrAt && err == nil:
+					t.Fatalf("call %d: expected an error, got none", i)
+				case i == tc.wantErrAt:
+					continue
+				case err != nil:
+					t.Fatalf("call %d: %v", i, err)
+				}
+				if res.Group.ID == "" {
+					t.Errorf("call %d returned a group with no ID", i)
+				}
+				if res.Created {
+					created++
+				}
+			}
+
+			if created != tc.wantCreated {
+				t.Errorf("Created=true on %d calls, want %d", created, tc.wantCreated)
+			}
+			if got := srv.CountFor("createCustomGroup"); got != tc.wantCreateCalls {
+				t.Errorf("createCustomGroup called %d times, want %d", got, tc.wantCreateCalls)
+			}
+			if names := srv.GroupNames(); len(names) != 1 || names[0] != testName {
+				t.Errorf("appliance holds %v, want one group named %q", names, testName)
+			}
+		})
+	}
+}
+
+// TestAPIErrorReportsStatus checks that a refused request surfaces as an
+// *APIError carrying the operation and status.
+func TestAPIErrorReportsStatus(t *testing.T) {
+	cases := []struct {
+		name       string
+		arrange    func(srv *mock.Server)
+		call       func(c *Client) error
+		wantOpID   string
+		wantStatus int
+	}{
+		{
+			name:    "a lost create surfaces the status",
+			arrange: func(srv *mock.Server) { srv.FailNextCreateAfterStore() },
+			call: func(c *Client) error {
+				_, err := c.CreateCustomGroup(context.Background(), testGroup())
+				return err
+			},
+			wantOpID:   "createCustomGroup",
+			wantStatus: http.StatusServiceUnavailable,
+		},
+		{
+			name: "a duplicate resource key is a conflict",
+			arrange: func(srv *mock.Server) {
+				srv.InsertBeforeNextCreate(testName, testAdapter, testKind)
+			},
+			call: func(c *Client) error {
+				_, err := c.CreateCustomGroup(context.Background(), testGroup())
+				return err
+			},
+			wantOpID:   "createCustomGroup",
+			wantStatus: http.StatusConflict,
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			c, srv := dial(t)
+			tc.arrange(srv)
+
+			err := tc.call(c)
+			if err == nil {
+				t.Fatal("expected an error, got none")
+			}
+			var apiErr *APIError
+			if !errors.As(err, &apiErr) {
+				t.Fatalf("error %v is not an *APIError", err)
+			}
+			if apiErr.OperationID != tc.wantOpID {
+				t.Errorf("OperationID = %q, want %q", apiErr.OperationID, tc.wantOpID)
+			}
+			if apiErr.StatusCode != tc.wantStatus {
+				t.Errorf("StatusCode = %d, want %d", apiErr.StatusCode, tc.wantStatus)
+			}
+			if apiErr.Message == "" {
+				t.Error("Message is empty, want the detail from the response body")
+			}
+			if isConflict(err) != (tc.wantStatus == http.StatusConflict) {
+				t.Errorf("isConflict = %v for status %d", isConflict(err), tc.wantStatus)
+			}
+		})
+	}
+}
+
+// TestListDecodesResponseEnvelope checks the cgroups envelope is unwrapped and
+// that appliance assigned properties survive the round trip.
+func TestListDecodesResponseEnvelope(t *testing.T) {

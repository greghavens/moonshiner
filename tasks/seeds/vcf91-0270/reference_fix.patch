+	ctx := context.Background()
+
+	if groups, err := c.ListCustomGroups(ctx, ListOptions{}); err != nil {
+		t.Fatalf("list on an empty appliance: %v", err)
+	} else if len(groups) != 0 {
+		t.Fatalf("empty appliance returned %d groups", len(groups))
+	}
+
+	want := testGroup()
+	want.AutoResolveMembership = ptr(true)
+	created, err := c.CreateCustomGroup(ctx, want)
+	if err != nil {
+		t.Fatalf("create: %v", err)
+	}
+	if created.ID == "" {
+		t.Error("created group has no ID")
+	}
+
+	groups, err := c.ListCustomGroups(ctx, ListOptions{})
+	if err != nil {
+		t.Fatalf("list: %v", err)
+	}
+	if len(groups) != 1 {
+		t.Fatalf("list returned %d groups, want 1", len(groups))
+	}
+	if groups[0].ResourceKey != want.ResourceKey {
+		t.Errorf("resource key = %+v, want %+v", groups[0].ResourceKey, want.ResourceKey)
+	}
+	if groups[0].AutoResolveMembership == nil || !*groups[0].AutoResolveMembership {
+		t.Error("autoResolveMembership did not survive the round trip")
+	}
+	if groups[0].ID != created.ID {
+		t.Errorf("listed ID %q != created ID %q", groups[0].ID, created.ID)
+	}
+}

 // EnsureCustomGroup makes the desired custom group exist on the appliance and
 // is safe to call repeatedly: however many times it runs, at most one group
 // with the desired resource key exists afterwards.
+//
+// createCustomGroup is a plain POST with no server-side idempotency key, so
+// retry safety is built here out of the two operations the contract names. A
+// group's resource key is its identity on the appliance, which makes it a
+// natural idempotency key:
+//
+//  1. Look the resource key up. If a group already holds it, adopt that group
+//     and create nothing. This is what makes an ordinary repeat call, and a
+//     retry after a response was lost in transit, harmless.
+//  2. Otherwise create it. A create that succeeds is the one call that created
+//     the group.
+//  3. If the create is refused because the key is already taken, another writer
+//     won the race between the lookup and the create. Look it up once more and
+//     adopt the winner's group rather than reporting a conflict upwards.
 func (c *Client) EnsureCustomGroup(ctx context.Context, desired CustomGroup) (EnsureResult, error) {
-	return EnsureResult{}, ErrNotImplemented
+	existing, found, err := c.findByResourceKey(ctx, desired.ResourceKey)
+	if err != nil {
+		return EnsureResult{}, err
+	}
+	if found {
+		return EnsureResult{Group: existing, Created: false}, nil
+	}
+
+	created, err := c.CreateCustomGroup(ctx, desired)
+	if err == nil {
+		return EnsureResult{Group: created, Created: true}, nil
+	}
+	if !isConflict(err) {
+		return EnsureResult{}, err
+	}
+
+	// The key was taken between the lookup and the create.
+	existing, found, lookupErr := c.findByResourceKey(ctx, desired.ResourceKey)
+	if lookupErr != nil {
+		return EnsureResult{}, lookupErr
+	}
+	if !found {
+		// The conflict was not about this resource key after all.
+		return EnsureResult{}, err
+	}
+	return EnsureResult{Group: existing, Created: false}, nil
+}
+
+// findByResourceKey returns the group holding key, if the appliance has one.
+func (c *Client) findByResourceKey(ctx context.Context, key ResourceKey) (CustomGroup, bool, error) {
+	groups, err := c.ListCustomGroups(ctx, ListOptions{})
+	if err != nil {
+		return CustomGroup{}, false, err
+	}
+	for _, g := range groups {
+		if g.ResourceKey == key {
+			return g, true, nil
+		}
+	}
+	return CustomGroup{}, false, nil
 }

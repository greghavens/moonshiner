diff --git a/guestcust/apply_test.go b/guestcust/apply_test.go
new file mode 100644
index 000000000000..e30b808825b7
--- /dev/null
+++ b/guestcust/apply_test.go
@@ -0,0 +1,215 @@
+package guestcust
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"example.com/vcf90/gosc/internal/mockvc"
+)
+
+const (
+	testContract = "../docs/contract.json"
+	testSession  = "session-under-test"
+)
+
+func testProfile(t *testing.T, name string) *Profile {
+	t.Helper()
+	raw, err := os.ReadFile(filepath.Join("..", "profiles", name))
+	if err != nil {
+		t.Fatalf("read profile: %v", err)
+	}
+	p, err := LoadProfile(raw)
+	if err != nil {
+		t.Fatalf("LoadProfile(%s): %v", name, err)
+	}
+	return p
+}
+
+func ptr[T any](v T) *T { return &v }
+
+func TestApplyProfileGatesOnThePrecheck(t *testing.T) {
+	tests := []struct {
+		name        string
+		status      int
+		body        any
+		wantApplied bool
+		wantReasons []string
+		wantGated   bool
+		wantErr     bool
+		wantSets    int
+	}{
+		{
+			name:        "supported",
+			status:      200,
+			body:        mockvc.CheckInfo("SUPPORTED", ptr(true), ptr(true)),
+			wantApplied: true,
+			wantSets:    1,
+		},
+		{
+			name:        "supported with the optional signals absent",
+			status:      200,
+			body:        mockvc.CheckInfo("SUPPORTED", nil, nil),
+			wantApplied: true,
+			wantSets:    1,
+		},
+		{
+			name:        "the guest os is not supported",
+			status:      200,
+			body:        mockvc.CheckInfo("NOT_SUPPORTED", ptr(false), ptr(true)),
+			wantReasons: []string{"supported_guest_os"},
+			wantGated:   true,
+			wantErr:     true,
+		},
+		{
+			name:        "the power state is not supported",
+			status:      200,
+			body:        mockvc.CheckInfo("NOT_SUPPORTED", ptr(true), ptr(false)),
+			wantReasons: []string{"supported_power_state"},
+			wantGated:   true,
+			wantErr:     true,
+		},
+		{
+			name:        "neither is supported",
+			status:      200,
+			body:        mockvc.CheckInfo("NOT_SUPPORTED", ptr(false), ptr(false)),
+			wantReasons: []string{"supported_guest_os", "supported_power_state"},
+			wantGated:   true,
+			wantErr:     true,
+		},
+		{
+			name:        "not supported without a stated reason",
+			status:      200,
+			body:        mockvc.CheckInfo("NOT_SUPPORTED", nil, nil),
+			wantReasons: []string{"unspecified"},
+			wantGated:   true,
+			wantErr:     true,
+		},
+		{
+			name:    "the precheck is unauthorized",
+			status:  403,
+			body:    map[string]any{"error_type": "UNAUTHORIZED"},
+			wantErr: true,
+		},
+		{
+			name:    "the precheck is unavailable",
+			status:  503,
+			body:    map[string]any{"error_type": "SERVICE_UNAVAILABLE"},
+			wantErr: true,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			srv := mockvc.New(t, testContract)
+			srv.SetCheckInfo(tc.status, tc.body)
+
+			c := NewClient(srv.URL(), testSession, srv.Client())
+			res, err := c.ApplyProfile(context.Background(), testProfile(t, "linux-dhcp.json"))
+
+			if tc.wantErr != (err != nil) {
+				t.Fatalf("error = %v, want an error: %v", err, tc.wantErr)
+			}
+			if got := errors.Is(err, ErrNotCustomizable); got != tc.wantGated {
+				t.Errorf("errors.Is(err, ErrNotCustomizable) = %v, want %v (err = %v)", got, tc.wantGated, err)
+			}
+			if res.Applied != tc.wantApplied {
+				t.Errorf("Applied = %v, want %v", res.Applied, tc.wantApplied)
+			}
+			if tc.wantReasons != nil && !reflect.DeepEqual(res.Reasons, tc.wantReasons) {
+				t.Errorf("Reasons = %v, want %v", res.Reasons, tc.wantReasons)
+			}
+			if got := len(srv.RequestsFor("Vcenter.Vm.Guest.Customization_set")); got != tc.wantSets {
+				t.Errorf("the mutating operation was issued %d time(s), want %d", got, tc.wantSets)
+			}
+		})
+	}
+}
+
+func TestApplyProfileSurfacesMutationFailures(t *testing.T) {
+	tests := []struct {
+		name       string
+		setStatus  int
+		setBody    any
+		wantErr    bool
+		wantStatus int
+	}{
+		{"the customization lands", 204, nil, false, 0},
+		{"the virtual machine is powered on", 400, map[string]any{"error_type": "NOT_ALLOWED_IN_CURRENT_STATE"}, true, 400},
+		{"the virtual machine vanished", 404, map[string]any{"error_type": "NOT_FOUND"}, true, 404},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			srv := mockvc.New(t, testContract)
+			srv.SetCheckInfo(200, mockvc.CheckInfo("SUPPORTED", ptr(true), ptr(true)))
+			srv.SetSetResponse(tc.setStatus, tc.setBody)
+
+			c := NewClient(srv.URL(), testSession, srv.Client())
+			res, err := c.ApplyProfile(context.Background(), testProfile(t, "windows-domain.json"))
+
+			if tc.wantErr != (err != nil) {
+				t.Fatalf("error = %v, want an error: %v", err, tc.wantErr)
+			}
+			if errors.Is(err, ErrNotCustomizable) {
+				t.Errorf("a mutation failure was reported as a precheck refusal: %v", err)
+			}
+			if tc.wantErr {
+				var apiErr *APIError
+				if !errors.As(err, &apiErr) {
+					t.Fatalf("error %v is not an *APIError", err)
+				}
+				if apiErr.Status != tc.wantStatus {
+					t.Errorf("APIError.Status = %d, want %d", apiErr.Status, tc.wantStatus)
+				}
+				if res.Applied {
+					t.Error("Applied = true after a failed mutation")
+				}
+			}
+			if res.CheckStatus != "SUPPORTED" {
+				t.Errorf("CheckStatus = %q, want SUPPORTED", res.CheckStatus)
+			}
+		})
+	}
+}
+
+func TestApplyProfileSendsTheContractedRequests(t *testing.T) {
+	srv := mockvc.New(t, testContract)
+	srv.SetCheckInfo(200, mockvc.CheckInfo("SUPPORTED", ptr(true), ptr(true)))
+
+	c := NewClient(srv.URL(), testSession, srv.Client())
+	if _, err := c.ApplyProfile(context.Background(), testProfile(t, "linux-static.json")); err != nil {
+		t.Fatalf("ApplyProfile: %v", err)
+	}
+
+	reqs := srv.Requests()
+	if len(reqs) != 2 {
+		t.Fatalf("got %d requests, want 2", len(reqs))
+	}
+	tests := []struct {
+		name string
+		got  any
+		want any
+	}{
+		{"the precheck comes first", reqs[0].OperationID, "Vcenter.Vm.Guest.Customization_check"},
+		{"the precheck method", reqs[0].Method, "POST"},
+		{"the precheck query", reqs[0].RawQuery, "action=check"},
+		{"the precheck body length", len(reqs[0].Body), 0},
+		{"the precheck content type", reqs[0].Header.Get("Content-Type"), ""},
+		{"the mutation comes second", reqs[1].OperationID, "Vcenter.Vm.Guest.Customization_set"},
+		{"the mutation method", reqs[1].Method, "PUT"},
+		{"the mutation path", reqs[1].Path, "/api/vcenter/vm/vm-2044/guest/customization"},
+		{"the mutation query", reqs[1].RawQuery, ""},
+		{"the mutation content type", reqs[1].Header.Get("Content-Type"), "application/json"},
+		{"the mutation session header", reqs[1].Header.Get("vmware-api-session-id"), testSession},
+		{"the mutation was accepted", reqs[1].Status, 204},
+	}
+	for _, tc := range tests {
+		if !reflect.DeepEqual(tc.got, tc.want) {
+			t.Errorf("%s = %#v, want %#v", tc.name, tc.got, tc.want)
+		}
+	}
+}
diff --git a/guestcust/guestcust.go b/guestcust/guestcust.go
index 656cb1046b15..d9fe888cfd14 100644
--- a/guestcust/guestcust.go
+++ b/guestcust/guestcust.go
@@ -11,7 +11,10 @@ import (
 	"context"
 	"encoding/json"
 	"errors"
+	"fmt"
 	"net/http"
+	"sort"
+	"strings"
 )
 
 // ErrNotCustomizable reports that the customization precheck refused the virtual
@@ -109,5 +112,44 @@ func NewClient(baseURL, sessionID string, hc *http.Client) *Client {
 // and, only if the precheck permits it, applies the profile's customization
 // specification.
 func (c *Client) ApplyProfile(ctx context.Context, p *Profile) (Result, error) {
-	panic("guestcust: ApplyProfile is not implemented")
+	// Translate first: a profile the API would reject costs no API calls.
+	spec, err := buildSetSpec(p)
+	if err != nil {
+		return Result{}, err
+	}
+
+	info, err := c.check(ctx, p.VM)
+	if err != nil {
+		return Result{}, err
+	}
+
+	res := Result{CheckStatus: info.CheckStatus}
+	if info.CheckStatus != checkStatusSupported {
+		res.Reasons = refusalReasons(info)
+		return res, fmt.Errorf("%w: %s: %s", ErrNotCustomizable, p.VM, strings.Join(res.Reasons, ", "))
+	}
+
+	if err := c.set(ctx, p.VM, spec); err != nil {
+		return res, err
+	}
+	res.Applied = true
+	return res, nil
+}
+
+// refusalReasons names each precheck signal that refused the virtual machine. Both
+// signals are optional in the response: the API leaves one out when the check never
+// reached that step, which is not the same as the check having failed there.
+func refusalReasons(info checkInfo) []string {
+	var reasons []string
+	if info.SupportedGuestOS != nil && !*info.SupportedGuestOS {
+		reasons = append(reasons, "supported_guest_os")
+	}
+	if info.SupportedPowerState != nil && !*info.SupportedPowerState {
+		reasons = append(reasons, "supported_power_state")
+	}
+	if len(reasons) == 0 {
+		return []string{"unspecified"}
+	}
+	sort.Strings(reasons)
+	return reasons
 }
diff --git a/guestcust/translate.go b/guestcust/translate.go
new file mode 100644
index 000000000000..5fb2b3ee31bb
--- /dev/null
+++ b/guestcust/translate.go
@@ -0,0 +1,191 @@
+package guestcust
+
+import "fmt"
+
+const (
+	familyLinux   = "LINUX"
+	familyWindows = "WINDOWS"
+)
+
+// buildSetSpec translates an operator profile into the request body of
+// Vcenter.Vm.Guest.Customization_set.
+//
+// The profile always carries the specification inline, so SetSpec.name — which
+// names a specification already stored in the vCenter inventory — is never sent.
+func buildSetSpec(p *Profile) (setSpec, error) {
+	if p == nil {
+		return setSpec{}, fmt.Errorf("guestcust: nil profile")
+	}
+	if p.VM == "" {
+		return setSpec{}, fmt.Errorf("guestcust: profile names no virtual machine")
+	}
+	cfg, err := buildConfigurationSpec(p)
+	if err != nil {
+		return setSpec{}, err
+	}
+	ifaces, err := buildInterfaces(p.NICs)
+	if err != nil {
+		return setSpec{}, err
+	}
+	return setSpec{
+		Spec: &customizationSpec{
+			ConfigurationSpec: cfg,
+			GlobalDNSSettings: globalDNSSettings{
+				DNSSuffixList: nonEmpty(p.DNSSuffixes),
+				DNSServers:    nonEmpty(p.DNSServers),
+			},
+			Interfaces: ifaces,
+		},
+	}, nil
+}
+
+func buildConfigurationSpec(p *Profile) (configurationSpec, error) {
+	switch p.GuestFamily {
+	case familyLinux:
+		host, err := buildHostname(p.Hostname)
+		if err != nil {
+			return configurationSpec{}, fmt.Errorf("guestcust: %s: %w", p.VM, err)
+		}
+		if p.Domain == "" {
+			return configurationSpec{}, fmt.Errorf("guestcust: %s: a LINUX profile needs a domain", p.VM)
+		}
+		return configurationSpec{LinuxConfig: &linuxConfiguration{
+			Hostname:   host,
+			Domain:     p.Domain,
+			TimeZone:   optString(p.TimeZone),
+			ScriptText: optString(p.Script),
+		}}, nil
+
+	case familyWindows:
+		if p.Windows == nil {
+			return configurationSpec{}, fmt.Errorf("guestcust: %s: a WINDOWS profile needs a windows block", p.VM)
+		}
+		host, err := buildHostname(p.Hostname)
+		if err != nil {
+			return configurationSpec{}, fmt.Errorf("guestcust: %s: %w", p.VM, err)
+		}
+		join, err := buildDomain(p)
+		if err != nil {
+			return configurationSpec{}, fmt.Errorf("guestcust: %s: %w", p.VM, err)
+		}
+		w := p.Windows
+		return configurationSpec{WindowsConfig: &windowsConfiguration{
+			Sysprep: &windowsSysprep{
+				UserData: userData{
+					ComputerName: host,
+					FullName:     w.FullName,
+					Organization: w.Organization,
+					ProductKey:   w.ProductKey,
+				},
+				Domain: join,
+				GUIUnattended: guiUnattended{
+					AutoLogon:      w.AutoLogon,
+					AutoLogonCount: w.AutoLogonCount,
+					Password:       optString(w.AdminPassword),
+					TimeZone:       w.TimeZoneID,
+				},
+			},
+		}}, nil
+	}
+	return configurationSpec{}, fmt.Errorf("guestcust: %s: unknown guest_family %q", p.VM, p.GuestFamily)
+}
+
+func buildHostname(h Hostname) (hostnameGenerator, error) {
+	switch h.Kind {
+	case hostnameFixed:
+		if h.Value == "" {
+			return hostnameGenerator{}, fmt.Errorf("hostname kind FIXED needs a value")
+		}
+		return hostnameGenerator{Type: hostnameFixed, FixedName: optString(h.Value)}, nil
+	case hostnamePrefix:
+		if h.Value == "" {
+			return hostnameGenerator{}, fmt.Errorf("hostname kind PREFIX needs a value")
+		}
+		return hostnameGenerator{Type: hostnamePrefix, Prefix: optString(h.Value)}, nil
+	case hostnameVirtualMachine, hostnameUserInput:
+		// Neither carries a name: fixed_name and prefix stay out of the document.
+		return hostnameGenerator{Type: h.Kind}, nil
+	}
+	return hostnameGenerator{}, fmt.Errorf("unknown hostname kind %q", h.Kind)
+}
+
+func buildDomain(p *Profile) (*domain, error) {
+	w := p.Windows
+	switch {
+	case w.Workgroup != "":
+		if w.DomainUsername != "" {
+			return nil, fmt.Errorf("windows block asks for both a workgroup and a domain join")
+		}
+		return &domain{Type: domainTypeWorkgroup, Workgroup: optString(w.Workgroup)}, nil
+	case w.DomainUsername != "":
+		if p.Domain == "" {
+			return nil, fmt.Errorf("a domain join needs a domain")
+		}
+		return &domain{
+			Type:           domainTypeDomain,
+			Domain:         optString(p.Domain),
+			DomainUsername: optString(w.DomainUsername),
+			DomainPassword: optString(w.DomainPassword),
+		}, nil
+	}
+	// Vcenter.Guest.WindowsSysprep.domain is optional: no workgroup and no domain
+	// join means the property is left out.
+	return nil, nil
+}
+
+func buildInterfaces(nics []NIC) ([]adapterMapping, error) {
+	// interfaces is required, so an empty adapter list is [] rather than absent.
+	out := make([]adapterMapping, 0, len(nics))
+	for i, n := range nics {
+		v4, err := buildIPv4(n.IPv4)
+		if err != nil {
+			return nil, fmt.Errorf("guestcust: nics[%d]: %w", i, err)
+		}
+		out = append(out, adapterMapping{
+			MACAddress: optString(n.MAC),
+			Adapter:    ipSettings{IPv4: v4},
+		})
+	}
+	return out, nil
+}
+
+func buildIPv4(in IPv4) (*ipv4Settings, error) {
+	switch in.Mode {
+	case ipModeDHCP, ipModeUserInput:
+		// Neither carries an address: ip_address, prefix and gateways stay out.
+		return &ipv4Settings{Type: in.Mode}, nil
+	case ipModeStatic:
+		if in.Address == "" {
+			return nil, fmt.Errorf("ipv4 mode STATIC needs an address")
+		}
+		if in.Prefix <= 0 || in.Prefix > 32 {
+			return nil, fmt.Errorf("ipv4 prefix %d is out of range", in.Prefix)
+		}
+		prefix := in.Prefix
+		return &ipv4Settings{
+			Type:      ipModeStatic,
+			IPAddress: optString(in.Address),
+			Prefix:    &prefix,
+			Gateways:  nonEmpty(in.Gateways),
+		}, nil
+	}
+	return nil, fmt.Errorf("unknown ipv4 mode %q", in.Mode)
+}
+
+// optString returns nil for the empty string, so an unset optional property is
+// omitted rather than sent as "".
+func optString(s string) *string {
+	if s == "" {
+		return nil
+	}
+	return &s
+}
+
+// nonEmpty returns nil for an empty list, so an unset optional list property is
+// omitted rather than sent as [].
+func nonEmpty(v []string) []string {
+	if len(v) == 0 {
+		return nil
+	}
+	return append([]string(nil), v...)
+}
diff --git a/guestcust/translate_test.go b/guestcust/translate_test.go
new file mode 100644
index 000000000000..99ca5100a001
--- /dev/null
+++ b/guestcust/translate_test.go
@@ -0,0 +1,207 @@
+package guestcust
+
+import (
+	"encoding/json"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+// marshalProfile is the whole translation path: profile in, request body out.
+func marshalProfile(t *testing.T, p *Profile) map[string]any {
+	t.Helper()
+	spec, err := buildSetSpec(p)
+	if err != nil {
+		t.Fatalf("buildSetSpec: %v", err)
+	}
+	raw, err := json.Marshal(spec)
+	if err != nil {
+		t.Fatalf("marshal: %v", err)
+	}
+	var got map[string]any
+	if err := json.Unmarshal(raw, &got); err != nil {
+		t.Fatalf("unmarshal: %v", err)
+	}
+	return got
+}
+
+func decode(t *testing.T, s string) map[string]any {
+	t.Helper()
+	var v map[string]any
+	if err := json.Unmarshal([]byte(s), &v); err != nil {
+		t.Fatalf("decode golden: %v", err)
+	}
+	return v
+}
+
+func TestBuildSetSpecWireShape(t *testing.T) {
+	tests := []struct {
+		name    string
+		profile string
+		want    string
+	}{
+		{
+			name: "a linux profile with everything optional left unset",
+			profile: `{
+			  "vm": "vm-1", "guest_family": "LINUX",
+			  "hostname": {"kind": "FIXED", "value": "web01"},
+			  "domain": "corp.example.com", "time_zone": "", "script": "",
+			  "dns_servers": [], "dns_suffixes": [],
+			  "nics": [{"mac": "", "ipv4": {"mode": "DHCP"}}],
+			  "windows": null
+			}`,
+			want: `{"spec":{
+			  "configuration_spec":{"linux_config":{
+			    "hostname":{"type":"FIXED","fixed_name":"web01"},
+			    "domain":"corp.example.com"}},
+			  "global_dns_settings":{},
+			  "interfaces":[{"adapter":{"ipv4":{"type":"DHCP"}}}]}}`,
+		},
+		{
+			name: "a linux profile with every optional set",
+			profile: `{
+			  "vm": "vm-2", "guest_family": "LINUX",
+			  "hostname": {"kind": "PREFIX", "value": "batch-"},
+			  "domain": "b.example.com", "time_zone": "UTC", "script": "#!/bin/sh\n",
+			  "dns_servers": ["10.0.0.1"], "dns_suffixes": ["example.com"],
+			  "nics": [{"mac": "00:50:56:00:00:01", "ipv4": {"mode": "STATIC", "address": "10.0.0.9", "prefix": 24, "gateways": ["10.0.0.254"]}}],
+			  "windows": null
+			}`,
+			want: `{"spec":{
+			  "configuration_spec":{"linux_config":{
+			    "hostname":{"type":"PREFIX","prefix":"batch-"},
+			    "domain":"b.example.com","time_zone":"UTC","script_text":"#!/bin/sh\n"}},
+			  "global_dns_settings":{"dns_suffix_list":["example.com"],"dns_servers":["10.0.0.1"]},
+			  "interfaces":[{"mac_address":"00:50:56:00:00:01","adapter":{"ipv4":{
+			    "type":"STATIC","ip_address":"10.0.0.9","prefix":24,"gateways":["10.0.0.254"]}}}]}}`,
+		},
+		{
+			name: "a windows profile joining a workgroup keeps its required zero values",
+			profile: `{
+			  "vm": "vm-3", "guest_family": "WINDOWS",
+			  "hostname": {"kind": "FIXED", "value": "WKSTA"},
+			  "domain": "", "time_zone": "", "script": "",
+			  "dns_servers": [], "dns_suffixes": [], "nics": [],
+			  "windows": {"full_name":"F","organization":"O","product_key":"K",
+			    "auto_logon":false,"auto_logon_count":0,"time_zone_id":0,
+			    "admin_password":"","workgroup":"WORKGROUP","domain_username":"","domain_password":""}
+			}`,
+			want: `{"spec":{
+			  "configuration_spec":{"windows_config":{"sysprep":{
+			    "user_data":{"computer_name":{"type":"FIXED","fixed_name":"WKSTA"},
+			      "full_name":"F","organization":"O","product_key":"K"},
+			    "gui_unattended":{"auto_logon":false,"auto_logon_count":0,"time_zone":0},
+			    "domain":{"type":"WORKGROUP","workgroup":"WORKGROUP"}}}},
+			  "global_dns_settings":{},
+			  "interfaces":[]}}`,
+		},
+		{
+			name: "a windows profile joining a domain",
+			profile: `{
+			  "vm": "vm-4", "guest_family": "WINDOWS",
+			  "hostname": {"kind": "VIRTUAL_MACHINE", "value": ""},
+			  "domain": "ad.example.com", "time_zone": "", "script": "",
+			  "dns_servers": [], "dns_suffixes": [], "nics": [],
+			  "windows": {"full_name":"F","organization":"O","product_key":"K",
+			    "auto_logon":true,"auto_logon_count":3,"time_zone_id":4,
+			    "admin_password":"pw","workgroup":"","domain_username":"joiner","domain_password":"jp"}
+			}`,
+			want: `{"spec":{
+			  "configuration_spec":{"windows_config":{"sysprep":{
+			    "user_data":{"computer_name":{"type":"VIRTUAL_MACHINE"},
+			      "full_name":"F","organization":"O","product_key":"K"},
+			    "gui_unattended":{"auto_logon":true,"auto_logon_count":3,"password":"pw","time_zone":4},
+			    "domain":{"type":"DOMAIN","domain":"ad.example.com",
+			      "domain_username":"joiner","domain_password":"jp"}}}},
+			  "global_dns_settings":{},
+			  "interfaces":[]}}`,
+		},
+		{
+			name: "a windows profile with neither a workgroup nor a join omits the domain",
+			profile: `{
+			  "vm": "vm-5", "guest_family": "WINDOWS",
+			  "hostname": {"kind": "USER_INPUT_REQUIRED", "value": ""},
+			  "domain": "", "time_zone": "", "script": "",
+			  "dns_servers": [], "dns_suffixes": [], "nics": [],
+			  "windows": {"full_name":"F","organization":"O","product_key":"K",
+			    "auto_logon":false,"auto_logon_count":0,"time_zone_id":0,
+			    "admin_password":"","workgroup":"","domain_username":"","domain_password":""}
+			}`,
+			want: `{"spec":{
+			  "configuration_spec":{"windows_config":{"sysprep":{
+			    "user_data":{"computer_name":{"type":"USER_INPUT_REQUIRED"},
+			      "full_name":"F","organization":"O","product_key":"K"},
+			    "gui_unattended":{"auto_logon":false,"auto_logon_count":0,"time_zone":0}}}},
+			  "global_dns_settings":{},
+			  "interfaces":[]}}`,
+		},
+		{
+			name: "a static adapter with no gateway omits gateways",
+			profile: `{
+			  "vm": "vm-6", "guest_family": "LINUX",
+			  "hostname": {"kind": "FIXED", "value": "h"},
+			  "domain": "d.example.com", "time_zone": "", "script": "",
+			  "dns_servers": [], "dns_suffixes": [],
+			  "nics": [{"mac": "", "ipv4": {"mode": "STATIC", "address": "10.0.0.9", "prefix": 25, "gateways": []}}],
+			  "windows": null
+			}`,
+			want: `{"spec":{
+			  "configuration_spec":{"linux_config":{
+			    "hostname":{"type":"FIXED","fixed_name":"h"},"domain":"d.example.com"}},
+			  "global_dns_settings":{},
+			  "interfaces":[{"adapter":{"ipv4":{"type":"STATIC","ip_address":"10.0.0.9","prefix":25}}}]}}`,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			p, err := LoadProfile([]byte(tc.profile))
+			if err != nil {
+				t.Fatalf("LoadProfile: %v", err)
+			}
+			got := marshalProfile(t, p)
+			if want := decode(t, tc.want); !reflect.DeepEqual(got, want) {
+				gotJSON, _ := json.MarshalIndent(got, "", "  ")
+				wantJSON, _ := json.MarshalIndent(want, "", "  ")
+				t.Errorf("wire shape mismatch\n got %s\nwant %s", gotJSON, wantJSON)
+			}
+			// name only ever carries a specification stored in the inventory, and
+			// this package always sends the specification inline.
+			if _, ok := got["name"]; ok {
+				t.Error("the request body carries name")
+			}
+		})
+	}
+}
+
+func TestBuildSetSpecRejectsProfilesTheAPIWouldReject(t *testing.T) {
+	tests := []struct {
+		name    string
+		profile string
+		want    string
+	}{
+		{"an unknown guest family", `{"vm":"vm-1","guest_family":"SOLARIS","hostname":{"kind":"FIXED","value":"h"},"domain":"d","time_zone":"","script":"","dns_servers":[],"dns_suffixes":[],"nics":[],"windows":null}`, "unknown guest_family"},
+		{"a linux profile with no domain", `{"vm":"vm-1","guest_family":"LINUX","hostname":{"kind":"FIXED","value":"h"},"domain":"","time_zone":"","script":"","dns_servers":[],"dns_suffixes":[],"nics":[],"windows":null}`, "needs a domain"},
+		{"a windows profile with no windows block", `{"vm":"vm-1","guest_family":"WINDOWS","hostname":{"kind":"FIXED","value":"h"},"domain":"d","time_zone":"","script":"","dns_servers":[],"dns_suffixes":[],"nics":[],"windows":null}`, "needs a windows block"},
+		{"a fixed hostname with no name", `{"vm":"vm-1","guest_family":"LINUX","hostname":{"kind":"FIXED","value":""},"domain":"d","time_zone":"","script":"","dns_servers":[],"dns_suffixes":[],"nics":[],"windows":null}`, "FIXED needs a value"},
+		{"an unknown ipv4 mode", `{"vm":"vm-1","guest_family":"LINUX","hostname":{"kind":"FIXED","value":"h"},"domain":"d","time_zone":"","script":"","dns_servers":[],"dns_suffixes":[],"nics":[{"mac":"","ipv4":{"mode":"DISABLED"}}],"windows":null}`, `unknown ipv4 mode "DISABLED"`},
+		{"a static adapter with no address", `{"vm":"vm-1","guest_family":"LINUX","hostname":{"kind":"FIXED","value":"h"},"domain":"d","time_zone":"","script":"","dns_servers":[],"dns_suffixes":[],"nics":[{"mac":"","ipv4":{"mode":"STATIC","prefix":24,"gateways":[]}}],"windows":null}`, "STATIC needs an address"},
+		{"a profile with no vm", `{"vm":"","guest_family":"LINUX","hostname":{"kind":"FIXED","value":"h"},"domain":"d","time_zone":"","script":"","dns_servers":[],"dns_suffixes":[],"nics":[],"windows":null}`, "names no virtual machine"},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			p, err := LoadProfile([]byte(tc.profile))
+			if err != nil {
+				t.Fatalf("LoadProfile: %v", err)
+			}
+			_, err = buildSetSpec(p)
+			if err == nil {
+				t.Fatal("buildSetSpec accepted the profile")
+			}
+			if !strings.Contains(err.Error(), tc.want) {
+				t.Errorf("error %q does not mention %q", err, tc.want)
+			}
+		})
+	}
+}
diff --git a/guestcust/transport.go b/guestcust/transport.go
new file mode 100644
index 000000000000..8200e9b67d23
--- /dev/null
+++ b/guestcust/transport.go
@@ -0,0 +1,124 @@
+package guestcust
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+)
+
+// Transcribed from docs/contract.json.
+const (
+	serverBasePath  = "/api"
+	sessionHeader   = "vmware-api-session-id"
+	opCheck         = "Vcenter.Vm.Guest.Customization_check"
+	opSet           = "Vcenter.Vm.Guest.Customization_set"
+	checkSuccess    = http.StatusOK
+	setSuccess      = http.StatusNoContent
+	contentTypeJSON = "application/json"
+)
+
+// APIError is a non-success response from vCenter.
+type APIError struct {
+	OperationID string
+	Status      int
+	Type        string
+	Message     string
+}
+
+func (e *APIError) Error() string {
+	msg := e.Message
+	if msg == "" {
+		msg = e.Type
+	}
+	if msg == "" {
+		msg = http.StatusText(e.Status)
+	}
+	return fmt.Sprintf("guestcust: %s: vCenter answered %d: %s", e.OperationID, e.Status, msg)
+}
+
+// customizationURL is the endpoint of both contracted operations for one VM.
+func (c *Client) customizationURL(vm string) string {
+	return strings.TrimSuffix(c.baseURL, "/") + serverBasePath +
+		"/vcenter/vm/" + url.PathEscape(vm) + "/guest/customization"
+}
+
+// check runs Vcenter.Vm.Guest.Customization_check. The operation takes no request
+// body, so the request carries none and declares no content type.
+func (c *Client) check(ctx context.Context, vm string) (checkInfo, error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, c.customizationURL(vm)+"?action=check", nil)
+	if err != nil {
+		return checkInfo{}, fmt.Errorf("guestcust: %s: %w", opCheck, err)
+	}
+	req.Header.Set(sessionHeader, c.sessionID)
+
+	resp, err := c.hc.Do(req)
+	if err != nil {
+		return checkInfo{}, fmt.Errorf("guestcust: %s: %w", opCheck, err)
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return checkInfo{}, fmt.Errorf("guestcust: %s: %w", opCheck, err)
+	}
+	if resp.StatusCode != checkSuccess {
+		return checkInfo{}, apiError(opCheck, resp.StatusCode, body)
+	}
+	var info checkInfo
+	if err := json.Unmarshal(body, &info); err != nil {
+		return checkInfo{}, fmt.Errorf("guestcust: %s: decoding the response: %w", opCheck, err)
+	}
+	if info.CheckStatus == "" {
+		return checkInfo{}, fmt.Errorf("guestcust: %s: the response carries no check_status", opCheck)
+	}
+	return info, nil
+}
+
+// set runs Vcenter.Vm.Guest.Customization_set.
+func (c *Client) set(ctx context.Context, vm string, spec setSpec) error {
+	body, err := json.Marshal(spec)
+	if err != nil {
+		return fmt.Errorf("guestcust: %s: %w", opSet, err)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPut, c.customizationURL(vm), bytes.NewReader(body))
+	if err != nil {
+		return fmt.Errorf("guestcust: %s: %w", opSet, err)
+	}
+	req.Header.Set(sessionHeader, c.sessionID)
+	req.Header.Set("Content-Type", contentTypeJSON)
+
+	resp, err := c.hc.Do(req)
+	if err != nil {
+		return fmt.Errorf("guestcust: %s: %w", opSet, err)
+	}
+	defer resp.Body.Close()
+	payload, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return fmt.Errorf("guestcust: %s: %w", opSet, err)
+	}
+	if resp.StatusCode != setSuccess {
+		return apiError(opSet, resp.StatusCode, payload)
+	}
+	return nil
+}
+
+func apiError(operationID string, status int, body []byte) error {
+	e := &APIError{OperationID: operationID, Status: status}
+	var doc struct {
+		ErrorType string `json:"error_type"`
+		Messages  []struct {
+			DefaultMessage string `json:"default_message"`
+		} `json:"messages"`
+	}
+	if err := json.Unmarshal(body, &doc); err == nil {
+		e.Type = doc.ErrorType
+		if len(doc.Messages) > 0 {
+			e.Message = doc.Messages[0].DefaultMessage
+		}
+	}
+	return e
+}

+++ b/guestcust/wire.go
@@ -0,0 +1,183 @@
+package guestcust
+
+// The types below are the request and response bodies of the two contracted
+// operations, transcribed from docs/contract.json.
+//
+// The vSphere Automation API distinguishes an unset optional property from one set
+// to its zero value: an unset optional property is left out of the document
+// entirely, never sent as "", 0, false, [] or null. Optional properties are
+// therefore pointers or slices tagged omitempty; required properties are values and
+// are never tagged omitempty, so a required false or a required 0 still goes over
+// the wire.
+
+// setSpec is Vcenter.Vm.Guest.Customization.SetSpec.
+type setSpec struct {
+	Name *string            `json:"name,omitempty"`
+	Spec *customizationSpec `json:"spec,omitempty"`
+}
+
+// checkInfo is Vcenter.Vm.Guest.Customization.CheckInfo.
+type checkInfo struct {
+	CheckStatus         string `json:"check_status"`
+	SupportedGuestOS    *bool  `json:"supported_guest_os,omitempty"`
+	SupportedPowerState *bool  `json:"supported_power_state,omitempty"`
+}
+
+const (
+	checkStatusSupported    = "SUPPORTED"
+	checkStatusNotSupported = "NOT_SUPPORTED"
+)
+
+// customizationSpec is Vcenter.Guest.CustomizationSpec. All three properties are
+// required, so interfaces is always a non-nil slice: an empty adapter list is [],
+// not null and not an absent property.
+type customizationSpec struct {
+	ConfigurationSpec configurationSpec `json:"configuration_spec"`
+	GlobalDNSSettings globalDNSSettings `json:"global_dns_settings"`
+	Interfaces        []adapterMapping  `json:"interfaces"`
+}
+
+// configurationSpec is Vcenter.Guest.ConfigurationSpec.
+type configurationSpec struct {
+	WindowsConfig *windowsConfiguration `json:"windows_config,omitempty"`
+	LinuxConfig   *linuxConfiguration   `json:"linux_config,omitempty"`
+	CloudConfig   *cloudConfiguration   `json:"cloud_config,omitempty"`
+}
+
+// windowsConfiguration is Vcenter.Guest.WindowsConfiguration.
+type windowsConfiguration struct {
+	Reboot     *string         `json:"reboot,omitempty"`
+	Sysprep    *windowsSysprep `json:"sysprep,omitempty"`
+	SysprepXML *string         `json:"sysprep_xml,omitempty"`
+}
+
+// windowsSysprep is Vcenter.Guest.WindowsSysprep.
+type windowsSysprep struct {
+	GUIRunOnceCommands []string      `json:"gui_run_once_commands,omitempty"`
+	UserData           userData      `json:"user_data"`
+	Domain             *domain       `json:"domain,omitempty"`
+	GUIUnattended      guiUnattended `json:"gui_unattended"`
+}
+
+// userData is Vcenter.Guest.UserData.
+type userData struct {
+	ComputerName hostnameGenerator `json:"computer_name"`
+	FullName     string            `json:"full_name"`
+	Organization string            `json:"organization"`
+	ProductKey   string            `json:"product_key"`
+}
+
+// domain is Vcenter.Guest.Domain.
+type domain struct {
+	Type           string  `json:"type"`
+	Workgroup      *string `json:"workgroup,omitempty"`
+	Domain         *string `json:"domain,omitempty"`
+	DomainUsername *string `json:"domain_username,omitempty"`
+	DomainPassword *string `json:"domain_password,omitempty"`
+	DomainOU       *string `json:"domain_ou,omitempty"`
+}
+
+const (
+	domainTypeWorkgroup = "WORKGROUP"
+	domainTypeDomain    = "DOMAIN"
+)
+
+// guiUnattended is Vcenter.Guest.GuiUnattended. auto_logon, auto_logon_count and
+// time_zone are required, so they are sent even when false or 0.
+type guiUnattended struct {
+	AutoLogon      bool    `json:"auto_logon"`
+	AutoLogonCount int64   `json:"auto_logon_count"`
+	Password       *string `json:"password,omitempty"`
+	TimeZone       int64   `json:"time_zone"`
+}
+
+// linuxConfiguration is Vcenter.Guest.LinuxConfiguration.
+type linuxConfiguration struct {
+	Hostname                      hostnameGenerator `json:"hostname"`
+	Domain                        string            `json:"domain"`
+	TimeZone                      *string           `json:"time_zone,omitempty"`
+	ScriptText                    *string           `json:"script_text,omitempty"`
+	CompatibleCustomizationMethod *string           `json:"compatible_customization_method,omitempty"`
+}
+
+// cloudConfiguration is Vcenter.Guest.CloudConfiguration.
+type cloudConfiguration struct {
+	Type      string                  `json:"type"`
+	Cloudinit *cloudinitConfiguration `json:"cloudinit,omitempty"`
+}
+
+// cloudinitConfiguration is Vcenter.Guest.CloudinitConfiguration.
+type cloudinitConfiguration struct {
+	Metadata string  `json:"metadata"`
+	Userdata *string `json:"userdata,omitempty"`
+}
+
+// hostnameGenerator is Vcenter.Guest.HostnameGenerator.
+type hostnameGenerator struct {
+	Type      string  `json:"type"`
+	FixedName *string `json:"fixed_name,omitempty"`
+	Prefix    *string `json:"prefix,omitempty"`
+}
+
+const (
+	hostnameFixed          = "FIXED"
+	hostnamePrefix         = "PREFIX"
+	hostnameVirtualMachine = "VIRTUAL_MACHINE"
+	hostnameUserInput      = "USER_INPUT_REQUIRED"
+)
+
+// globalDNSSettings is Vcenter.Guest.GlobalDNSSettings. Both properties are
+// optional, so an empty list is an absent property, not [].
+type globalDNSSettings struct {
+	DNSSuffixList []string `json:"dns_suffix_list,omitempty"`
+	DNSServers    []string `json:"dns_servers,omitempty"`
+}
+
+// adapterMapping is Vcenter.Guest.AdapterMapping.
+type adapterMapping struct {
+	MACAddress *string    `json:"mac_address,omitempty"`
+	Adapter    ipSettings `json:"adapter"`
+}
+
+// ipSettings is Vcenter.Guest.IPSettings.
+type ipSettings struct {
+	IPv4    *ipv4Settings                  `json:"ipv4,omitempty"`
+	IPv6    *ipv6Settings                  `json:"ipv6,omitempty"`
+	Windows *windowsNetworkAdapterSettings `json:"windows,omitempty"`
+}
+
+// ipv4Settings is Vcenter.Guest.Ipv4. The 9.0.0.0 revision of the specification
+// permits DHCP, STATIC and USER_INPUT_REQUIRED and nothing else.
+type ipv4Settings struct {
+	Type      string   `json:"type"`
+	IPAddress *string  `json:"ip_address,omitempty"`
+	Prefix    *int64   `json:"prefix,omitempty"`
+	Gateways  []string `json:"gateways,omitempty"`
+}
+
+const (
+	ipModeDHCP      = "DHCP"
+	ipModeStatic    = "STATIC"
+	ipModeUserInput = "USER_INPUT_REQUIRED"
+)
+
+// ipv6Settings is Vcenter.Guest.Ipv6.
+type ipv6Settings struct {
+	Type     string        `json:"type"`
+	IPv6     []ipv6Address `json:"ipv6,omitempty"`
+	Gateways []string      `json:"gateways,omitempty"`
+}
+
+// ipv6Address is Vcenter.Guest.Ipv6Address.
+type ipv6Address struct {
+	IPAddress string `json:"ip_address"`
+	Prefix    int64  `json:"prefix"`
+}
+
+// windowsNetworkAdapterSettings is Vcenter.Guest.WindowsNetworkAdapterSettings.
+type windowsNetworkAdapterSettings struct {
+	DNSServers  []string `json:"dns_servers,omitempty"`
+	DNSDomain   *string  `json:"dns_domain,omitempty"`
+	WINSServers []string `json:"wins_servers,omitempty"`
+	NetBIOSMode *string  `json:"net_bios_mode,omitempty"`
+}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch:architecture:1",
  "type": "object",
  "required": ["schemaVersion", "targetVersion", "sddcSpec", "sites", "clusters", "availability", "migrationPlan", "research"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "targetVersion": {"type": "string", "minLength": 1},
    "sddcSpec": {"type": "object"},
    "sites": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "role", "networks"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"enum": ["PRIMARY", "RECOVERY"]},
          "networks": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "object",
              "required": ["type", "vlanId", "cidr", "gateway", "mtu"],
              "properties": {
                "type": {"type": "string", "minLength": 1},
                "vlanId": {"type": "integer", "minimum": 0, "maximum": 4094},
                "cidr": {"type": "string", "minLength": 7},
                "gateway": {"type": "string", "minLength": 7},
                "mtu": {"type": "integer", "minimum": 1280, "maximum": 9190}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "clusters": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["name", "siteId", "role", "hostProfile", "hostCount", "failureReserveHosts", "usableCapacity"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "siteId": {"type": "string", "minLength": 1},
          "role": {"enum": ["MANAGEMENT", "WORKLOAD"]},
          "hostProfile": {"type": "string", "minLength": 1},
          "hostCount": {"type": "integer", "minimum": 1},
          "failureReserveHosts": {"type": "integer", "minimum": 0},
          "usableCapacity": {
            "type": "object",
            "required": ["vcpus", "memoryGiB", "storageTiB"],
            "properties": {
              "vcpus": {"type": "integer", "minimum": 0},
              "memoryGiB": {"type": "integer", "minimum": 0},
              "storageTiB": {"type": "number", "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "availability": {
      "type": "object",
      "required": ["clusterPolicy", "recoveryRpoMinutes", "recoveryRtoMinutes"],
      "properties": {
        "clusterPolicy": {"type": "string"},
        "recoveryRpoMinutes": {"type": "integer", "minimum": 0},
        "recoveryRtoMinutes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "migrationPlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "componentId", "component", "fromVersion", "action", "targetComponent", "targetVersion", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "componentId": {"type": "string", "minLength": 1},
          "component": {"type": "string", "minLength": 1},
          "fromVersion": {"type": "string", "minLength": 1},
          "action": {"enum": ["PATCH", "UPGRADE", "REDEPLOY", "REPLACE", "RETAIN", "RETIRE"]},
          "targetComponent": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "gates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "research": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url", "accessedOn", "componentIds"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "accessedOn": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "componentIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

+				t.Fatalf("status = %d, want %d", resp.StatusCode, tc.wantStatus)
+			}
+			if tc.wantStatus == http.StatusCreated {
+				var pair tokenPair
+				if err := json.NewDecoder(resp.Body).Decode(&pair); err != nil {
+					t.Fatalf("decode TokenPair: %v", err)

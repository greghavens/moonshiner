diff --git a/pkg/client/client.go b/pkg/client/client.go
new file mode 100644
index 0000000..64f8bc3
--- /dev/null
+++ b/pkg/client/client.go
@@ -0,0 +1,297 @@
+// Package client sweeps the ESXi host inventory of a VMware Cloud Foundation
+// 9.0 SDDC Manager.
+//
+// The inventory is paged, and SDDC Manager pages it without a stable
+// server-side ordering, so the same host can come back on two consecutive
+// pages. A sweep therefore has to cover every page, drop the repeats, and emit
+// what it collected in an order that does not depend on how the pages fell.
+package client
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Config configures a Client.
+type Config struct {
+	BaseURL    string
+	Username   string
+	Password   string
+	HTTPClient *http.Client // optional
+}
+
+// Filter narrows a sweep. Every field is optional; an unset field is left out
+// of the query string entirely rather than sent empty.
+type Filter struct {
+	FQDN          string
+	Status        string
+	DomainID      string
+	ClusterID     string
+	NetworkPoolID string
+	StorageType   string
+	DatastoreName string
+	PageSize      int
+}
+
+// Host is one ESXi host of the inventory.
+type Host struct {
+	ID                    string
+	FQDN                  string
+	ESXiVersion           string
+	HardwareVendor        string
+	HardwareModel         string
+	Status                string
+	CompatibleStorageType string
+	DomainID              string
+	ClusterID             string
+	NetworkPoolID         string
+	IPAddresses           []string
+}
+
+// Client talks to one SDDC Manager.
+type Client struct {
+	baseURL string
+	user    string
+	pass    string
+	http    *http.Client
+}
+
+// New builds a Client.
+func New(cfg Config) (*Client, error) {
+	switch {
+	case strings.TrimSpace(cfg.BaseURL) == "":
+		return nil, errors.New("client: BaseURL is required")
+	case cfg.Username == "":
+		return nil, errors.New("client: Username is required")
+	case cfg.Password == "":
+		return nil, errors.New("client: Password is required")
+	}
+	if _, err := url.Parse(cfg.BaseURL); err != nil {
+		return nil, fmt.Errorf("client: BaseURL: %w", err)
+	}
+	httpClient := cfg.HTTPClient
+	if httpClient == nil {
+		httpClient = &http.Client{Timeout: 30 * time.Second}
+	}
+	return &Client{
+		baseURL: strings.TrimRight(cfg.BaseURL, "/"),
+		user:    cfg.Username,
+		pass:    cfg.Password,
+		http:    httpClient,
+	}, nil
+}
+
+// tokenCreationSpec is the specification's TokenCreationSpec. The credential
+// kinds this client does not use carry `omitempty` so they never reach the
+// wire, not even as empty strings.
+type tokenCreationSpec struct {
+	Username string `json:"username"`
+	Password string `json:"password"`
+	APIKey   string `json:"apiKey,omitempty"`
+	IDToken  string `json:"idToken,omitempty"`
+}
+
+type tokenPair struct {
+	AccessToken  string `json:"accessToken"`
+	RefreshToken struct {
+		ID string `json:"id"`
+	} `json:"refreshToken"`
+}
+
+type pageOfHost struct {
+	Elements     []hostRecord `json:"elements"`
+	PageMetadata struct {
+		PageNumber    int `json:"pageNumber"`
+		PageSize      int `json:"pageSize"`
+		TotalElements int `json:"totalElements"`
+		TotalPages    int `json:"totalPages"`
+	} `json:"pageMetadata"`
+}
+
+type reference struct {
+	ID string `json:"id"`
+}
+
+type hostRecord struct {
+	ID                    string      `json:"id"`
+	FQDN                  string      `json:"fqdn"`
+	ESXiVersion           string      `json:"esxiVersion"`
+	HardwareVendor        string      `json:"hardwareVendor"`
+	HardwareModel         string      `json:"hardwareModel"`
+	Status                string      `json:"status"`
+	CompatibleStorageType string      `json:"compatibleStorageType"`
+	Domain                *reference  `json:"domain"`
+	Cluster               *reference  `json:"cluster"`
+	Networkpool           *reference  `json:"networkpool"`
+	IPAddresses           []ipAddress `json:"ipAddresses"`
+}
+
+type ipAddress struct {
+	IPAddress string `json:"ipAddress"`
+	Type      string `json:"type"`
+}
+
+// apiError is the specification's Error schema.
+type apiError struct {
+	ErrorCode string `json:"errorCode"`
+	ErrorType string `json:"errorType"`
+	Message   string `json:"message"`
+}
+
+// ListHosts sweeps the whole host inventory and returns it ascending by fqdn,
+// and by id when two hosts share an fqdn. A host handed back on more than one
+// page appears once.
+func (c *Client) ListHosts(ctx context.Context, f Filter) ([]Host, error) {
+	token, err := c.createToken(ctx)
+	if err != nil {
+		return nil, err
+	}
+
+	seen := make(map[string]bool)
+	hosts := make([]Host, 0)
+	for page := 0; ; page++ {
+		got, err := c.getHosts(ctx, token, f, page)
+		if err != nil {
+			return nil, err
+		}
+		for _, record := range got.Elements {
+			if seen[record.ID] {
+				continue
+			}
+			seen[record.ID] = true
+			hosts = append(hosts, toHost(record))
+		}
+		if page+1 >= got.PageMetadata.TotalPages {
+			break
+		}
+	}
+
+	sort.SliceStable(hosts, func(i, j int) bool {
+		if hosts[i].FQDN != hosts[j].FQDN {
+			return hosts[i].FQDN < hosts[j].FQDN
+		}
+		return hosts[i].ID < hosts[j].ID
+	})
+	return hosts, nil
+}
+
+func toHost(r hostRecord) Host {
+	h := Host{
+		ID:                    r.ID,
+		FQDN:                  r.FQDN,
+		ESXiVersion:           r.ESXiVersion,
+		HardwareVendor:        r.HardwareVendor,
+		HardwareModel:         r.HardwareModel,
+		Status:                r.Status,
+		CompatibleStorageType: r.CompatibleStorageType,
+	}
+	if r.Domain != nil {
+		h.DomainID = r.Domain.ID
+	}
+	if r.Cluster != nil {
+		h.ClusterID = r.Cluster.ID
+	}
+	if r.Networkpool != nil {
+		h.NetworkPoolID = r.Networkpool.ID
+	}
+	for _, ip := range r.IPAddresses {
+		h.IPAddresses = append(h.IPAddresses, ip.IPAddress)
+	}
+	return h
+}
+
+// createToken signs in and returns the access token.
+func (c *Client) createToken(ctx context.Context) (string, error) {
+	body, err := json.Marshal(tokenCreationSpec{Username: c.user, Password: c.pass})
+	if err != nil {
+		return "", fmt.Errorf("createToken: encode body: %w", err)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, c.baseURL+"/v1/tokens", bytes.NewReader(body))
+	if err != nil {
+		return "", fmt.Errorf("createToken: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "application/json")
+
+	resp, err := c.http.Do(req)
+	if err != nil {
+		return "", fmt.Errorf("createToken: %w", err)
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode != http.StatusCreated {
+		return "", statusError("createToken", resp)
+	}
+	var pair tokenPair
+	if err := json.NewDecoder(resp.Body).Decode(&pair); err != nil {
+		return "", fmt.Errorf("createToken: decode TokenPair: %w", err)
+	}
+	if pair.AccessToken == "" {
+		return "", errors.New("createToken: the token pair carries no access token")
+	}
+	return pair.AccessToken, nil
+}
+
+// getHosts fetches one page of the inventory.
+func (c *Client) getHosts(ctx context.Context, token string, f Filter, page int) (*pageOfHost, error) {
+	values := url.Values{}
+	values.Set("page", strconv.Itoa(page))
+	if f.PageSize > 0 {
+		values.Set("size", strconv.Itoa(f.PageSize))
+	}
+	for name, value := range map[string]string{
+		"fqdn":          f.FQDN,
+		"status":        f.Status,
+		"domainId":      f.DomainID,
+		"clusterId":     f.ClusterID,
+		"networkpoolId": f.NetworkPoolID,
+		"storageType":   f.StorageType,
+		"datastoreName": f.DatastoreName,
+	} {
+		if value != "" {
+			values.Set(name, value)
+		}
+	}
+
+	target := c.baseURL + "/v1/hosts?" + values.Encode()
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, target, nil)
+	if err != nil {
+		return nil, fmt.Errorf("getHosts: %w", err)
+	}
+	req.Header.Set("Authorization", "Bearer "+token)
+	req.Header.Set("Accept", "application/json")
+
+	resp, err := c.http.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("getHosts: %w", err)
+	}
+	defer resp.Body.Close()
+
+	if resp.StatusCode != http.StatusOK {
+		return nil, statusError(fmt.Sprintf("getHosts page %d", page), resp)
+	}
+	var got pageOfHost
+	if err := json.NewDecoder(resp.Body).Decode(&got); err != nil {
+		return nil, fmt.Errorf("getHosts page %d: decode PageOfHost: %w", page, err)
+	}
+	return &got, nil
+}
+
+func statusError(what string, resp *http.Response) error {
+	raw, _ := io.ReadAll(io.LimitReader(resp.Body, 8<<10))
+	var e apiError
+	if err := json.Unmarshal(raw, &e); err == nil && e.Message != "" {
+		return fmt.Errorf("%s: %s: %s (%s)", what, resp.Status, e.Message, e.ErrorCode)
+	}
+	return fmt.Errorf("%s: %s", what, resp.Status)
+}

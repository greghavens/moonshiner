index 0000000..83f9ae6
--- /dev/null
+++ b/architecture/plan_test.go
@@ -0,0 +1,72 @@
+package vcfarchitecture
+
+import (
+	"encoding/json"
+	"os"
+	"testing"
+)
+
+func TestBuildPlanTable(t *testing.T) {
+	baseInventory := readFixture[Inventory](t, "../fixtures/estate.json")
+	baseCompatibility := readFixture[CompatibilitySnapshot](t, "../grader/compatibility-snapshot.json")
+
+	tests := []struct {
+		name    string
+		mutate  func(*Inventory, *CompatibilitySnapshot)
+		wantErr bool
+	}{
+		{name: "supported minimum-host estate"},
+		{name: "too few hosts", wantErr: true, mutate: func(inventory *Inventory, _ *CompatibilitySnapshot) {
+			inventory.Hosts = inventory.Hosts[:3]
+		}},
+		{name: "unsupported target", wantErr: true, mutate: func(inventory *Inventory, _ *CompatibilitySnapshot) {
+			inventory.TargetRelease = "9.0.1.0"
+		}},
+		{name: "unknown gate", wantErr: true, mutate: func(_ *Inventory, compatibility *CompatibilitySnapshot) {
+			compatibility.Stages[0].Changes[0].Gates = append(compatibility.Stages[0].Changes[0].Gates, "not-in-catalog")
+		}},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			inventory := jsonClone(t, baseInventory)
+			compatibility := jsonClone(t, baseCompatibility)
+			if test.mutate != nil {
+				test.mutate(&inventory, &compatibility)
+			}
+			plan, err := BuildPlan(inventory, compatibility)
+			if (err != nil) != test.wantErr {
+				t.Fatalf("BuildPlan() error = %v, wantErr %v", err, test.wantErr)
+			}
+			if !test.wantErr && (len(plan.Stages) != 6 || plan.Topology.HostCount != 4 || plan.TargetRelease != "9.1.0.0") {
+				t.Fatalf("BuildPlan() returned incomplete canonical plan: %+v", plan)
+			}
+		})
+	}
+}
+
+func readFixture[T any](t *testing.T, path string) T {
+	t.Helper()
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var value T
+	if err := json.Unmarshal(raw, &value); err != nil {
+		t.Fatal(err)
+	}
+	return value
+}
+
+func jsonClone[T any](t *testing.T, value T) T {
+	t.Helper()
+	raw, err := json.Marshal(value)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var clone T
+	if err := json.Unmarshal(raw, &clone); err != nil {
+		t.Fatal(err)
+	}
+	return clone
+}

 package vcfarchitecture
 
-import "errors"
+import "fmt"
 
 // BuildPlan constructs the ordered migration architecture for inventory using
 // only combinations and gates present in the pinned compatibility snapshot.
 func BuildPlan(inventory Inventory, compatibility CompatibilitySnapshot) (MigrationPlan, error) {
-	return MigrationPlan{}, errors.New("BuildPlan is not implemented")
+	if inventory.Site.SiteCount != 1 {
+		return MigrationPlan{}, fmt.Errorf("site count must be one, got %d", inventory.Site.SiteCount)
+	}
+	if inventory.Site.DesignModel != "consolidated" {
+		return MigrationPlan{}, fmt.Errorf("design model must be consolidated, got %q", inventory.Site.DesignModel)
+	}
+	if inventory.Site.AvailabilityZoneMode != "single" {
+		return MigrationPlan{}, fmt.Errorf("availability-zone mode must be single, got %q", inventory.Site.AvailabilityZoneMode)
+	}
+
+	minimumHosts, found := minimumHostsFor(inventory, compatibility)
+	if !found {
+		return MigrationPlan{}, fmt.Errorf("no minimum-host constraint matches the inventory topology")
+	}
+	if len(inventory.Hosts) < minimumHosts {
+		return MigrationPlan{}, fmt.Errorf("inventory has %d hosts; matching constraint requires at least %d", len(inventory.Hosts), minimumHosts)
+	}
+
+	releasePath, err := supportedPath(inventory.SourceRelease, inventory.TargetRelease, compatibility.ReleaseHops)
+	if err != nil {
+		return MigrationPlan{}, err
+	}
+
+	gateCatalog := make(map[string]GateDefinition, len(compatibility.GateCatalog))
+	for _, gate := range compatibility.GateCatalog {
+		if gate.ID == "" || gate.Condition == "" {
+			return MigrationPlan{}, fmt.Errorf("gate catalog contains an empty id or condition")
+		}
+		if _, duplicate := gateCatalog[gate.ID]; duplicate {
+			return MigrationPlan{}, fmt.Errorf("gate %q appears more than once in the catalog", gate.ID)
+		}
+		gateCatalog[gate.ID] = gate
+	}
+
+	inventoryComponents := make(map[string]InventoryComponent, len(inventory.Components))
+	for _, component := range inventory.Components {
+		if component.ID == "" {
+			return MigrationPlan{}, fmt.Errorf("inventory contains a component without an id")
+		}
+		if _, duplicate := inventoryComponents[component.ID]; duplicate {
+			return MigrationPlan{}, fmt.Errorf("inventory component %q appears more than once", component.ID)
+		}
+		inventoryComponents[component.ID] = component
+	}
+
+	seenComponents := make(map[string]bool, len(inventory.Components))
+	stages := make([]MigrationStage, 0, len(compatibility.Stages))
+	for stageIndex, sourceStage := range compatibility.Stages {
+		if sourceStage.Sequence != stageIndex+1 {
+			return MigrationPlan{}, fmt.Errorf("stage sequence is not contiguous at index %d", stageIndex)
+		}
+		if sourceStage.ID == "" || sourceStage.Mechanism == "" || len(sourceStage.Changes) == 0 {
+			return MigrationPlan{}, fmt.Errorf("stage %d has an empty id, mechanism, or change list", sourceStage.Sequence)
+		}
+		stage := MigrationStage{
+			Sequence:  sourceStage.Sequence,
+			ID:        sourceStage.ID,
+			Mechanism: sourceStage.Mechanism,
+			Changes:   make([]ComponentChange, 0, len(sourceStage.Changes)),
+		}
+		for _, sourceChange := range sourceStage.Changes {
+			component, exists := inventoryComponents[sourceChange.ComponentID]
+			if !exists {
+				return MigrationPlan{}, fmt.Errorf("stage %d names component %q absent from inventory", sourceStage.Sequence, sourceChange.ComponentID)
+			}
+			if seenComponents[sourceChange.ComponentID] {
+				return MigrationPlan{}, fmt.Errorf("component %q appears in more than one change", sourceChange.ComponentID)
+			}
+			if component.CurrentVersion != sourceChange.FromVersion || component.CurrentState != sourceChange.FromState {
+				return MigrationPlan{}, fmt.Errorf("component %q source version/state does not match inventory", sourceChange.ComponentID)
+			}
+			if sourceChange.TargetVersion == "" || sourceChange.TargetState == "" || len(sourceChange.Gates) == 0 {
+				return MigrationPlan{}, fmt.Errorf("component %q has an incomplete target or gate set", sourceChange.ComponentID)
+			}
+			seenGates := map[string]bool{}
+			for _, gateID := range sourceChange.Gates {
+				if _, exists := gateCatalog[gateID]; !exists {
+					return MigrationPlan{}, fmt.Errorf("component %q references unknown gate %q", sourceChange.ComponentID, gateID)
+				}
+				if seenGates[gateID] {
+					return MigrationPlan{}, fmt.Errorf("component %q repeats gate %q", sourceChange.ComponentID, gateID)
+				}
+				seenGates[gateID] = true
+			}
+			seenComponents[sourceChange.ComponentID] = true
+			stage.Changes = append(stage.Changes, ComponentChange{
+				ComponentID:   sourceChange.ComponentID,
+				FromVersion:   sourceChange.FromVersion,
+				FromState:     sourceChange.FromState,
+				TargetVersion: sourceChange.TargetVersion,
+				TargetState:   sourceChange.TargetState,
+				Gates:         append([]string(nil), sourceChange.Gates...),
+			})
+		}
+		stages = append(stages, stage)
+	}
+	if len(seenComponents) != len(inventoryComponents) {
+		for componentID := range inventoryComponents {
+			if !seenComponents[componentID] {
+				return MigrationPlan{}, fmt.Errorf("inventory component %q is missing from compatibility stages", componentID)
+			}
+		}
+		return MigrationPlan{}, fmt.Errorf("component coverage does not match inventory")
+	}
+
+	targetSpec, err := retainedSddcSpec(inventory)
+	if err != nil {
+		return MigrationPlan{}, err
+	}
+	return MigrationPlan{
+		SchemaVersion: "1.0.0",
+		EstateID:      inventory.EstateID,
+		SourceRelease: inventory.SourceRelease,
+		TargetRelease: inventory.TargetRelease,
+		Topology: PlanTopology{
+			SiteCount:            inventory.Site.SiteCount,
+			AvailabilityZoneMode: inventory.Site.AvailabilityZoneMode,
+			DesignModel:          inventory.Site.DesignModel,
+			StorageType:          inventory.Cluster.StorageType,
+			HostCount:            len(inventory.Hosts),
+		},
+		ReleaseHops:     releasePath,
+		GateDefinitions: append([]GateDefinition(nil), compatibility.GateCatalog...),
+		Stages:          stages,
+		TargetSddcSpec:  targetSpec,
+	}, nil
+}
+
+func minimumHostsFor(inventory Inventory, compatibility CompatibilitySnapshot) (int, bool) {
+	for _, constraint := range compatibility.MinimumHostConstraints {
+		if constraint.DesignModel == inventory.Site.DesignModel &&
+			constraint.SiteCount == inventory.Site.SiteCount &&
+			constraint.AvailabilityZoneMode == inventory.Site.AvailabilityZoneMode &&
+			constraint.StorageType == inventory.Cluster.StorageType {
+			return constraint.MinimumHosts, true
+		}
+	}
+	return 0, false
+}
+
+func supportedPath(source, target string, hops []ReleaseHop) ([]ReleaseHop, error) {
+	type candidate struct {
+		version string
+		path    []ReleaseHop
+	}
+	queue := []candidate{{version: source}}
+	visited := map[string]bool{source: true}
+	for len(queue) > 0 {
+		current := queue[0]
+		queue = queue[1:]
+		if current.version == target {
+			if len(current.path) == 0 {
+				return nil, fmt.Errorf("source and target release must differ")
+			}
+			return current.path, nil
+		}
+		for _, hop := range hops {
+			if !hop.Supported || hop.From != current.version || visited[hop.To] {
+				continue
+			}
+			nextPath := append(append([]ReleaseHop(nil), current.path...), hop)
+			visited[hop.To] = true
+			queue = append(queue, candidate{version: hop.To, path: nextPath})
+		}
+	}
+	return nil, fmt.Errorf("no supported release path from %s to %s", source, target)
+}
+
+func retainedSddcSpec(inventory Inventory) (map[string]any, error) {
+	vcenter, found := componentByID(inventory.Components, "VCENTER")
+	if !found || len(vcenter.Endpoints) != 1 {
+		return nil, fmt.Errorf("inventory must contain exactly one vCenter endpoint")
+	}
+	nsx, found := componentByID(inventory.Components, "NSX_MANAGER")
+	if !found || len(nsx.Endpoints) == 0 || nsx.VIPFQDN == "" {
+		return nil, fmt.Errorf("inventory must contain NSX manager endpoints and a VIP FQDN")
+	}
+	if inventory.FixtureSecrets.VCenterRootPassword == "" {
+		return nil, fmt.Errorf("fixture vCenter credential is empty")
+	}
+
+	hostSpecs := make([]any, 0, len(inventory.Hosts))
+	for _, host := range inventory.Hosts {
+		if host.ShortHostname == "" {
+			return nil, fmt.Errorf("host %q has no short hostname", host.ID)
+		}
+		hostSpecs = append(hostSpecs, map[string]any{"hostname": host.ShortHostname})
+	}
+	networkSpecs := make([]any, 0, len(inventory.Networks))
+	for _, network := range inventory.Networks {
+		entry := map[string]any{
+			"networkType": network.NetworkType,
+			"vlanId":      network.VLANID,
+			"mtu":         network.MTU,
+			"subnet":      network.Subnet,
+			"gateway":     network.Gateway,
+		}
+		if len(network.IncludeIPAddressRanges) != 0 {
+			ranges := make([]any, 0, len(network.IncludeIPAddressRanges))
+			for _, ipRange := range network.IncludeIPAddressRanges {
+				ranges = append(ranges, map[string]any{
+					"startIpAddress": ipRange.StartIPAddress,
+					"endIpAddress":   ipRange.EndIPAddress,
+				})
+			}
+			entry["includeIpAddressRanges"] = ranges
+		}
+		networkSpecs = append(networkSpecs, entry)
+	}
+	nsxManagers := make([]any, 0, len(nsx.Endpoints))
+	for _, endpoint := range nsx.Endpoints {
+		nsxManagers = append(nsxManagers, map[string]any{"hostname": endpoint})
+	}
+
+	return map[string]any{
+		"sddcId":       inventory.SDDCID,
+		"workflowType": "VCF_COMPLETE",
+		"version":      inventory.TargetRelease,
+		"hostSpecs":    hostSpecs,
+		"vcenterSpec": map[string]any{
+			"vcenterHostname":       vcenter.Endpoints[0],
+			"rootVcenterPassword":   inventory.FixtureSecrets.VCenterRootPassword,
+			"version":               inventory.TargetRelease,
+			"useExistingDeployment": true,
+		},
+		"clusterSpec": map[string]any{
+			"datacenterName": inventory.Cluster.DatacenterName,
+			"clusterName":    inventory.Cluster.ClusterName,
+		},
+		"datastoreSpec": map[string]any{
+			"existingDatastoreName": inventory.Cluster.DatastoreName,
+		},
+		"nsxtSpec": map[string]any{
+			"nsxtManagers":          nsxManagers,
+			"vipFqdn":               nsx.VIPFQDN,
+			"version":               inventory.TargetRelease,
+			"useExistingDeployment": true,
+		},
+		"networkSpecs": networkSpecs,
+		"dnsSpec": map[string]any{
+			"subdomain":   inventory.DNS.Subdomain,
+			"nameservers": append([]string(nil), inventory.DNS.Nameservers...),
+		},
+		"ntpServers": append([]string(nil), inventory.NTPServers...),
+	}, nil
+}
+
+func componentByID(components []InventoryComponent, id string) (InventoryComponent, bool) {
+	for _, component := range components {
+		if component.ID == id {
+			return component, true
+		}
+	}
+	return InventoryComponent{}, false
 }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/vcf/migration-plan.schema.json",
  "title": "VCF brownfield migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "estateId",
    "sourceRelease",
    "targetRelease",
    "topology",
    "releaseHops",
    "gateDefinitions",
    "stages",
    "targetSddcSpec"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "sourceRelease": {
      "type": "string",
      "minLength": 1
    },
    "targetRelease": {
      "type": "string",
      "minLength": 1
    },
    "topology": {
      "$ref": "#/$defs/topology"
    },
    "releaseHops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/releaseHop"
      }
    },
    "gateDefinitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/gateDefinition"
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "targetSddcSpec": {
      "type": "object"
    }
  },
  "$defs": {
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "siteCount",
        "availabilityZoneMode",
        "designModel",
        "storageType",
        "hostCount"
      ],
      "properties": {
        "siteCount": {
          "type": "integer",
          "minimum": 1
        },
        "availabilityZoneMode": {
          "type": "string",
          "minLength": 1
        },
        "designModel": {
          "type": "string",
          "minLength": 1
        },
        "storageType": {
          "type": "string",
          "minLength": 1
        },
        "hostCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "releaseHop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "supported",
        "rationale"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "supported": {
          "const": true
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gateDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "condition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "id",
        "mechanism",
        "changes"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "mechanism": {
          "type": "string",
          "minLength": 1
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/componentChange"
          }
        }
      }
    },
    "componentChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "fromVersion",
        "fromState",
        "targetVersion",
        "targetState",
        "gates"
      ],
      "properties": {
        "componentId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "fromVersion": {
          "type": "string",
          "minLength": 1
        },
        "fromState": {
          "enum": [
            "present",
            "absent"
          ]
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetState": {
          "enum": [
            "present",
            "absent",
            "decommissioned"
          ]
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    }
  }
}

{
  "schemaVersion": "1.0.0",
  "snapshotDate": "2026-08-14",
  "provenance": {
    "publisher": "Broadcom",
    "documents": [
      "VCF 9.1 upgrade sequence and related issues (KB 440630)",
      "Correlating VMware Cloud Foundation versions with component versions (KB 314608)",
      "Minimum ESXi hosts for a VCF management domain (KB 392993)",
      "Brownfield imported-domain NSX unsupported-path example (KB 430524)",
      "Unified VCF product releases versioning (KB 410435)"
    ],
    "note": "Narrow scenario snapshot for deterministic verification; not a replacement for current Broadcom research."
  },
  "minimumHostConstraints": [
    {
      "designModel": "consolidated",
      "siteCount": 1,
      "availabilityZoneMode": "single",
      "storageType": "vSAN-OSA",
      "minimumHosts": 4
    }
  ],
  "releaseHops": [
    {
      "from": "5.2.2.0",
      "to": "9.0.1.0",
      "supported": false,
      "rationale": "Pinned out for this inventory because its NSX 4.2.3 source combination has no supported direct component path to NSX 9.0.1."
    },
    {
      "from": "5.2.2.0",
      "to": "9.1.0.0",
      "supported": true,
      "rationale": "VCF 5.2.x with SDDC Manager can move to 9.1 after VCF Operations is upgraded, using the supported LCM workflows."
    }
  ],
  "gateCatalog": [
    {
      "id": "operations-health",
      "condition": "The existing Operations analytics cluster passes its health and capacity prechecks."
    },
    {
      "id": "operations-backup",
      "condition": "A restorable backup of the existing Operations deployment is verified."
    },
    {
      "id": "operations-at-target",
      "condition": "VCF Operations reports version 9.1.0.0 and healthy before dependent stages start."
    },
    {
      "id": "dns-forward-reverse",
      "condition": "Forward and reverse DNS resolve for the VCF License Server and management components."
    },
    {
      "id": "license-entitlement",
      "condition": "The 9.1 entitlement is available to the VCF License Server."
    },
    {
      "id": "license-server-ready",
      "condition": "VCF Operations reports the 9.1 License Server registered and healthy."
    },
    {
      "id": "sddc-manager-backup",
      "condition": "A successful SDDC Manager backup is verified before its upgrade."
    },
    {
      "id": "lcm-precheck",
      "condition": "The applicable SDDC Manager lifecycle precheck completes without blocking findings."
    },
    {
      "id": "sddc-manager-at-target",
      "condition": "SDDC Manager reports version 9.1.0.0 and healthy before domain component upgrades."
    },
    {
      "id": "nsx-backup",
      "condition": "A successful NSX configuration backup is verified before the NSX upgrade."
    },
    {
      "id": "interop-precheck",
      "condition": "The pinned source and target NSX combination passes the lifecycle interoperability precheck."
    },
    {
      "id": "nsx-at-target",
      "condition": "The NSX management cluster reports version 9.1.0.0 and healthy."
    },
    {
      "id": "vcenter-backup",
      "condition": "A restorable file-based vCenter backup is verified before the vCenter upgrade."
    },
    {
      "id": "vcenter-at-target",
      "condition": "vCenter reports version 9.1.0.0 and all four management hosts connected."
    },
    {
      "id": "cluster-health",
      "condition": "vSAN health, object compliance, DRS, and HA checks are green before each host evacuation."
    },
    {
      "id": "sequential-evacuation-capacity",
      "condition": "The four-host consolidated cluster can evacuate one host at a time while the other three carry management workloads and satisfy storage policy."
    }
  ],
  "stages": [
    {
      "sequence": 1,
      "id": "upgrade-vcf-operations",
      "mechanism": "VCF Operations in-place upgrade",
      "changes": [
        {
          "componentId": "VCF_OPERATIONS",
          "fromVersion": "8.18.0",
          "fromState": "present",
          "targetVersion": "9.1.0.0",
          "targetState": "present",
          "gates": [
            "operations-health",
            "operations-backup"
          ]
        }
      ]
    },
    {
      "sequence": 2,
      "id": "deploy-license-server",
      "mechanism": "VCF Operations workflow",
      "changes": [
        {
          "componentId": "VCF_LICENSE_SERVER",
          "fromVersion": "not-installed",
          "fromState": "absent",
          "targetVersion": "9.1.0.0",
          "targetState": "present",
          "gates": [
            "operations-at-target",
            "dns-forward-reverse",
            "license-entitlement"
          ]
        }
      ]
    },
    {
      "sequence": 3,
      "id": "upgrade-sddc-manager",
      "mechanism": "SDDC Manager lifecycle workflow",
      "changes": [
        {
          "componentId": "SDDC_MANAGER",
          "fromVersion": "5.2.2.0-24936865",
          "fromState": "present",
          "targetVersion": "9.1.0.0",
          "targetState": "present",
          "gates": [
            "operations-at-target",
            "license-server-ready",
            "sddc-manager-backup",
            "lcm-precheck"
          ]
        }
      ]
    },
    {
      "sequence": 4,
      "id": "upgrade-nsx",
      "mechanism": "SDDC Manager lifecycle workflow",
      "changes": [
        {
          "componentId": "NSX_MANAGER",
          "fromVersion": "4.2.3.0.0-24866349",
          "fromState": "present",
          "targetVersion": "9.1.0.0",
          "targetState": "present",
          "gates": [
            "sddc-manager-at-target",
            "nsx-backup",
            "interop-precheck"
          ]
        }
      ]
    },
    {
      "sequence": 5,
      "id": "upgrade-vcenter",
      "mechanism": "SDDC Manager lifecycle workflow",
      "changes": [
        {
          "componentId": "VCENTER",
          "fromVersion": "8.0.3.00600-24853646",
          "fromState": "present",
          "targetVersion": "9.1.0.0",
          "targetState": "present",
          "gates": [
            "sddc-manager-at-target",
            "nsx-at-target",
            "vcenter-backup",
            "lcm-precheck"
          ]
        }
      ]
    },
    {
      "sequence": 6,
      "id": "upgrade-hosts-and-vsan",
      "mechanism": "SDDC Manager sequential host lifecycle workflow",
      "changes": [
        {
          "componentId": "ESXI",
          "fromVersion": "8.0.3-24859861",
          "fromState": "present",
          "targetVersion": "9.1.0.0",
          "targetState": "present",
          "gates": [
            "vcenter-at-target",
            "nsx-at-target",
            "cluster-health",
            "lcm-precheck",
            "sequential-evacuation-capacity"
          ]
        },
        {
          "componentId": "VSAN",
          "fromVersion": "8.0.3-24022510",
          "fromState": "present",
          "targetVersion": "9.1.0.0",
          "targetState": "present",
          "gates": [
            "vcenter-at-target",
            "cluster-health",
            "sequential-evacuation-capacity"
          ]
        }
      ]
    }
  ]
}

+func (c *Client) systemAudit(ctx context.Context) (configured, collecting int, err error) {
+	var out systemAuditReports
+	if err = c.do(ctx, opSystemAudit, nil, nil, nil, &out); err != nil {
+		return 0, 0, err
+	}
+	for _, report := range out.AuditReports {
+		if report.Name != "Object" {

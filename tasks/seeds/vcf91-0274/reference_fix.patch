+	}
+	if c.Authorization.Header == "" || c.Authorization.Scheme == "" {
+		return nil, errors.New("opsdiag: contract declares no authorization header or scheme")
+	}
+	if len(c.Operations) == 0 {
+		return nil, errors.New("opsdiag: contract names no operations")
+	}

+// the authorization scheme the contract names. A nil hc selects
+// http.DefaultClient. NewClient returns ErrIncompleteContract if the contract
+// omits any operation this package issues.
+func NewClient(baseURL, token string, contract *Contract, hc *http.Client) (*Client, error) {
+	if contract == nil {
+		return nil, ErrIncompleteContract
+	}
+	var missing []string
+	for _, id := range requiredOperations {
+		op, ok := contract.Operations[id]
+		if !ok || op.Method == "" || op.Path == "" {
+			missing = append(missing, id)
+		}
+	}
+	if len(missing) > 0 {
+		sort.Strings(missing)
+		return nil, fmt.Errorf("%w: %s", ErrIncompleteContract, strings.Join(missing, ", "))
+	}
+	if hc == nil {
+		hc = http.DefaultClient
+	}
+	return &Client{
+		baseURL:  strings.TrimSuffix(baseURL, "/"),
+		contract: contract,
+		authHdr:  contract.Authorization.Header,
+		authVal:  contract.Authorization.Scheme + " " + token,
+		hc:       hc,
+	}, nil

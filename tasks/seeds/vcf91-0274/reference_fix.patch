+// selectRootSymptom returns the contributing symptom that started first. A
+// contributing symptom with no matching record cannot be timed, so it is not a
+// candidate; the loudest symptom is deliberately not preferred.
+func selectRootSymptom(contributing []contributingSymptom, symptoms []symptom) (symptom, bool) {
+	byID := make(map[string]symptom, len(symptoms))
+	for _, s := range symptoms {
+		byID[s.ID] = s
+	}
+
+	var best symptom
+	found := false
+	for _, cs := range contributing {
+		s, ok := byID[cs.SymptomID]
+		if !ok {
+			continue
+		}
+		if !found {
+			best, found = s, true
+			continue
+		}
+		switch {
+		case s.StartTimeUTC != best.StartTimeUTC:
+			if s.StartTimeUTC < best.StartTimeUTC {
+				best = s
+			}
+		case criticalityRank[s.SymptomCriticality] != criticalityRank[best.SymptomCriticality]:
+			if criticalityRank[s.SymptomCriticality] > criticalityRank[best.SymptomCriticality] {
+				best = s
+			}
+		case s.ID < best.ID:
+			best = s
+		}
+	}
+	return best, found
 }
 

+// selectAlert picks the most severe alert, breaking ties on the earliest start
+// time and then on the alert id, so the choice never depends on map or slice
+// ordering the platform did not promise.
+func selectAlert(alerts []alert) alert {
+	best := alerts[0]
+	for _, a := range alerts[1:] {
+		switch {
+		case criticalityRank[a.AlertLevel] != criticalityRank[best.AlertLevel]:
+			if criticalityRank[a.AlertLevel] > criticalityRank[best.AlertLevel] {
+				best = a
+			}
+		case a.StartTimeUTC != best.StartTimeUTC:
+			if a.StartTimeUTC < best.StartTimeUTC {
+				best = a
+			}
+		case a.AlertID < best.AlertID:
+			best = a
+		}
+	}
+	return best
 }
 

+const resourceID = "9d3a1f52-77b0-4c1e-9a44-0f9b2c7e51ad"
+
+func dial(t *testing.T, fixtureSet string) (*opsdiag.Client, *opsmock.Server) {
+	t.Helper()
+	srv, err := opsmock.New(opsmock.ContractPath(), fixtureSet)
+	if err != nil {
+		t.Fatalf("opsmock.New(%q): %v", fixtureSet, err)
+	}
+	t.Cleanup(srv.Close)
+
+	contract, err := opsdiag.LoadContract(opsmock.ContractPath())
+	if err != nil {
+		t.Fatalf("LoadContract: %v", err)
+	}
+	client, err := opsdiag.NewClient(srv.URL(), opsmock.Token, contract, nil)
+	if err != nil {
+		t.Fatalf("NewClient: %v", err)
+	}
+	return client, srv
+}
+
+func TestDiagnoseRootCause(t *testing.T) {
+	t.Parallel()
+
+	cases := []struct {
+		name        string
+		fixture     string
+		wantCause   string
+		wantAlert   string
+		wantSymptom string
+		wantStalled int
+	}{
+		{
+			name:        "credential rejected",
+			fixture:     "adapter-credential-rejected",
+			wantCause:   opsdiag.RootCauseCredentialRejected,
+			wantAlert:   "3c9e0a41-2b77-4a83-9c14-6d0f5b21e7aa",
+			wantSymptom: "SystemAdapterInstanceCredentialFailure",
+			wantStalled: 202,
+		},
+		{
+			name:        "collector offline",
+			fixture:     "collector-offline",
+			wantCause:   opsdiag.RootCauseCollectorOffline,
+			wantAlert:   "b8e14f27-9c03-4d6a-a1f5-2e70bd394c88",
+			wantSymptom: "SystemCollectorDown",
+			wantStalled: 1204,
+		},
+		{
+			name:        "monitoring stopped",
+			fixture:     "monitoring-stopped",
+			wantCause:   opsdiag.RootCauseMonitoringStopped,
+			wantAlert:   "5f8b2c14-90d7-4a63-b1e8-0c6749a3f582",
+			wantSymptom: "SystemAdapterInstanceMonitoringStopped",
+			wantStalled: 200,
+		},
+		{
+			name:        "unclassified root symptom",
+			fixture:     "unclassified-root-symptom",
+			wantCause:   opsdiag.RootCauseUnclassified,
+			wantAlert:   "7c3d9b60-1e48-4fa2-85d3-b9026ce41f7a",
+			wantSymptom: "SystemHostCpuContention",
+			wantStalled: 6,
+		},
+		{
+			name:        "no active alerts",
+			fixture:     "no-active-alerts",
+			wantCause:   opsdiag.RootCauseNoActiveAlerts,
+			wantStalled: 0,
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			client, _ := dial(t, tc.fixture)
+
+			got, err := client.Diagnose(context.Background(), resourceID)
+			if err != nil {
+				t.Fatalf("Diagnose: %v", err)
+			}
+			if got.RootCause != tc.wantCause {
+				t.Errorf("RootCause = %q, want %q", got.RootCause, tc.wantCause)
+			}
+			if got.AlertID != tc.wantAlert {
+				t.Errorf("AlertID = %q, want %q", got.AlertID, tc.wantAlert)
+			}
+			if got.RootSymptomDefinitionID != tc.wantSymptom {
+				t.Errorf("RootSymptomDefinitionID = %q, want %q",
+					got.RootSymptomDefinitionID, tc.wantSymptom)
+			}
+			if got.ObjectsNotCollecting != tc.wantStalled {
+				t.Errorf("ObjectsNotCollecting = %d, want %d",
+					got.ObjectsNotCollecting, tc.wantStalled)
+			}
+		})
+	}
+}

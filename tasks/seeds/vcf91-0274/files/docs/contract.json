{
  "contractVersion": 1,
  "api": "VMware Cloud Foundation Operations API",
  "apiVersion": "9.1.0.0",
  "basePath": "/suite-api",
  "authorization": {
    "in": "header",
    "header": "Authorization",
    "scheme": "vRealizeOpsToken"
  },
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "path": "specifications/vcf-operations/vcf-operations-openapi.json"
  },
  "operations": {
    "queryAlert": {
      "method": "POST",
      "path": "/api/alerts/query",
      "parameters": [
        {
          "name": "page",
          "in": "query",
          "required": false,
          "type": "integer",
          "default": 0
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "type": "integer",
          "default": 1000
        }
      ],
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": "alert-query"
      },
      "response": {
        "status": 200,
        "mediaType": "application/json",
        "schema": "alerts"
      },
      "summary": "Query for Alerts using one or more criteria specified in the Query Spec"
    },
    "getAlertContributingSymptoms": {
      "method": "GET",
      "path": "/api/alerts/contributingsymptoms",
      "parameters": [
        {
          "name": "id",
          "in": "query",
          "required": true,
          "type": "array",
          "style": "form",
          "explode": true,
          "itemType": "string"
        }
      ],
      "response": {
        "status": 200,
        "mediaType": "application/json",
        "schema": "alert-contributing-symptoms"
      },
      "summary": "Get the list of triggered symptoms for the requested alerts"
    },
    "getAlertNotes": {
      "method": "GET",
      "path": "/api/alerts/{id}/notes",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "string"
        },
        {
          "name": "page",
          "in": "query",
          "required": false,
          "type": "integer",
          "default": 0
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "type": "integer",
          "default": 1000
        }
      ],
      "response": {
        "status": 200,
        "mediaType": "application/json",
        "schema": "alert-notes"
      },
      "summary": "Get all the Alert Notes associated with an Alert"
    },
    "querySymptoms": {
      "method": "POST",
      "path": "/api/symptoms/query",
      "parameters": [
        {
          "name": "page",
          "in": "query",
          "required": false,
          "type": "integer",
          "default": 0
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "type": "integer",
          "default": 1000
        }
      ],
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": "symptom-query"
      },
      "response": {
        "status": 200,
        "mediaType": "application/json",
        "schema": "symptoms"
      },
      "summary": "Look up a set of Symptoms using a query object"
    },
    "getSystemAudit": {
      "method": "GET",
      "path": "/api/audit/system",
      "response": {
        "status": 200,
        "mediaType": "application/json",
        "schema": "system-audit-reports"
      },
      "summary": "Get system audit report"
    }
  }
}

@@ -0,0 +1,327 @@
+package opsadapter_test
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"reflect"
+	"sort"
+	"testing"
+
+	"vcfops/internal/opsmock"
+	"vcfops/opsadapter"
+)
+
+func ptr(v int32) *int32 { return &v }
+
+func bodyMembers(t *testing.T, body []byte) []string {
+	t.Helper()
+	var obj map[string]any
+	if err := json.Unmarshal(body, &obj); err != nil {
+		t.Fatalf("body %q is not a JSON object: %v", string(body), err)
+	}
+	keys := make([]string, 0, len(obj))
+	for k := range obj {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// dial starts a double, acquires a token and returns a ready client.
+func dial(t *testing.T, cfg opsmock.Config) (*opsadapter.Client, *opsmock.Server, string) {
+	t.Helper()
+	srv := opsmock.Start(cfg)
+	t.Cleanup(srv.Close)
+
+	c, err := opsadapter.NewClient(srv.URL, srv.HTTPClient())
+	if err != nil {
+		t.Fatalf("NewClient: %v", err)
+	}
+	token, err := c.AcquireToken(context.Background(), srv.Config().Username, srv.Config().Password, "")
+	if err != nil {
+		t.Fatalf("AcquireToken: %v", err)
+	}
+	srv.Reset()
+	return c, srv, token
+}
+
+func TestNewClient(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name    string
+		baseURL string
+		wantErr bool
+	}{
+		{name: "empty base URL", baseURL: "", wantErr: true},
+		{name: "whitespace only", baseURL: "   ", wantErr: true},
+		{name: "missing scheme", baseURL: "ops.example.com", wantErr: true},
+		{name: "unsupported scheme", baseURL: "ftp://ops.example.com", wantErr: true},
+		{name: "no host", baseURL: "https://", wantErr: true},
+		{name: "base path", baseURL: "https://ops.example.com/suite-api", wantErr: true},
+		{name: "query", baseURL: "https://ops.example.com?region=west", wantErr: true},
+		{name: "fragment", baseURL: "https://ops.example.com#deployment", wantErr: true},
+		{name: "userinfo", baseURL: "https://admin@ops.example.com", wantErr: true},
+		{name: "http", baseURL: "http://ops.example.com", wantErr: false},
+		{name: "https with trailing slash", baseURL: "https://ops.example.com/", wantErr: false},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			c, err := opsadapter.NewClient(tc.baseURL, nil)
+			if tc.wantErr {
+				if err == nil {
+					t.Fatalf("NewClient(%q) = %v, want an error", tc.baseURL, c)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("NewClient(%q): %v", tc.baseURL, err)
+			}
+			if c == nil {
+				t.Fatal("NewClient returned a nil client without an error")
+			}
+		})
+	}
+}
+
+func TestAcquireTokenRequestShape(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name        string
+		authSource  string
+		wantMembers []string
+	}{
+		{name: "local users", authSource: "", wantMembers: []string{"password", "username"}},
+		{name: "external source", authSource: "Corp LDAP", wantMembers: []string{"authSource", "password", "username"}},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			srv := opsmock.Start(opsmock.Config{AuthSource: tc.authSource})
+			defer srv.Close()
+			cfg := srv.Config()
+
+			c, err := opsadapter.NewClient(srv.URL, srv.HTTPClient())
+			if err != nil {
+				t.Fatalf("NewClient: %v", err)
+			}
+			token, err := c.AcquireToken(context.Background(), cfg.Username, cfg.Password, tc.authSource)
+			if err != nil {
+				t.Fatalf("AcquireToken: %v", err)
+			}
+			if token != cfg.Token {
+				t.Errorf("token = %q, want %q", token, cfg.Token)
+			}
+
+			recs := srv.Requests()
+			if len(recs) != 1 {
+				t.Fatalf("sent %d requests, want 1", len(recs))
+			}
+			if recs[0].OperationID != "acquireToken" {
+				t.Errorf("operation = %q, want acquireToken", recs[0].OperationID)
+			}
+			if recs[0].Header.Get("Authorization") != "" {
+				t.Error("acquireToken carried an Authorization header")
+			}
+			if got := bodyMembers(t, recs[0].Body); !reflect.DeepEqual(got, tc.wantMembers) {
+				t.Errorf("body members = %v, want %v", got, tc.wantMembers)
+			}
+		})
+	}
+}
+
+// TestRegisterPayloadOmitsUnsetOptionalMembers is the table that pins the
+// encoding rule: optional members that were not set never reach the wire.
+func TestRegisterPayloadOmitsUnsetOptionalMembers(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name        string
+		spec        opsadapter.CreateAdapterInstance
+		wantMembers []string
+	}{
+		{
+			name:        "required members only",
+			spec:        opsadapter.CreateAdapterInstance{Name: "vc-01", AdapterKindKey: "VMWARE"},
+			wantMembers: []string{"adapterKindKey", "name"},
+		},
+		{
+			name: "description",
+			spec: opsadapter.CreateAdapterInstance{
+				Name: "vc-01", AdapterKindKey: "VMWARE", Description: "Production vCenter",
+			},
+			wantMembers: []string{"adapterKindKey", "description", "name"},
+		},
+		{
+			name: "collector placement",
+			spec: opsadapter.CreateAdapterInstance{
+				Name: "vc-01", AdapterKindKey: "VMWARE", CollectorID: "1",
+			},
+			wantMembers: []string{"adapterKindKey", "collectorId", "name"},
+		},
+		{
+			name: "explicit zero interval survives",
+			spec: opsadapter.CreateAdapterInstance{
+				Name: "vc-01", AdapterKindKey: "VMWARE", MonitoringInterval: ptr(0),
+			},
+			wantMembers: []string{"adapterKindKey", "monitoringInterval", "name"},
+		},
+		{
+			name: "empty identifier slice is dropped",
+			spec: opsadapter.CreateAdapterInstance{
+				Name: "vc-01", AdapterKindKey: "VMWARE", ResourceIdentifiers: []opsadapter.NameValue{},
+			},
+			wantMembers: []string{"adapterKindKey", "name"},
+		},
+		{
+			name: "credential without fields",
+			spec: opsadapter.CreateAdapterInstance{
+				Name: "vc-01", AdapterKindKey: "VMWARE",
+				Credential: &opsadapter.Credential{
+					Name: "Principal", AdapterKindKey: "VMWARE", CredentialKindKey: "PRINCIPALCREDENTIAL",
+				},
+			},
+			wantMembers: []string{"adapterKindKey", "credential", "name"},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			c, srv, token := dial(t, opsmock.Config{})
+
+			if _, err := c.Register(context.Background(), token, tc.spec); err != nil {
+				t.Fatalf("Register: %v", err)
+			}
+
+			recs := srv.Requests()
+			if len(recs) != 2 {
+				t.Fatalf("sent %d requests, want the precheck and the create", len(recs))
+			}
+			for _, rec := range recs {
+				if got := bodyMembers(t, rec.Body); !reflect.DeepEqual(got, tc.wantMembers) {
+					t.Errorf("%s body members = %v, want %v (body %q)",
+						rec.OperationID, got, tc.wantMembers, string(rec.Body))
+				}
+			}
+		})
+	}
+}
+
+func TestRegisterCallOrderAndQuery(t *testing.T) {
+	t.Parallel()
+	c, srv, token := dial(t, opsmock.Config{})
+
+	inst, err := c.Register(context.Background(), token, opsadapter.CreateAdapterInstance{
+		Name: "vc-01", AdapterKindKey: "VMWARE",
+	})
+	if err != nil {
+		t.Fatalf("Register: %v", err)
+	}
+	if inst.ID != srv.Config().InstanceID {
+		t.Errorf("ID = %q, want %q", inst.ID, srv.Config().InstanceID)
+	}
+
+	recs := srv.Requests()
+	want := []string{"testConnection", "createAdapterInstance"}
+	got := []string{recs[0].OperationID, recs[1].OperationID}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("call order = %v, want %v", got, want)
+	}
+	if recs[0].RawQuery != "" {
+		t.Errorf("precheck query = %q, want none", recs[0].RawQuery)
+	}
+	if recs[1].RawQuery != "force=false" {
+		t.Errorf("create query = %q, want force=false", recs[1].RawQuery)
+	}
+}
+
+// TestRegisterGate covers the whole point of the flow: a precheck that does not
+// pass must leave the deployment untouched.
+func TestRegisterGate(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name         string
+		cfg          opsmock.Config
+		wantPrecheck bool
+		wantStatus   int
+		wantOp       string
+		wantCreates  int
+	}{
+		{
+			name:         "precheck rejects the endpoint",
+			cfg:          opsmock.Config{PrecheckStatus: http.StatusBadRequest, PrecheckMessage: "connection refused"},
+			wantPrecheck: true,
+			wantStatus:   http.StatusBadRequest,
+		},
+		{
+			name:        "precheck errors out",
+			cfg:         opsmock.Config{PrecheckStatus: http.StatusInternalServerError, PrecheckMessage: "boom"},
+			wantStatus:  http.StatusInternalServerError,
+			wantOp:      "testConnection",
+			wantCreates: 0,
+		},
+		{
+			name:        "create is rejected after a clean precheck",
+			cfg:         opsmock.Config{CreateStatus: http.StatusConflict, CreateMessage: "already exists"},
+			wantStatus:  http.StatusConflict,
+			wantOp:      "createAdapterInstance",
+			wantCreates: 1,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			c, srv, token := dial(t, tc.cfg)
+
+			_, err := c.Register(context.Background(), token, opsadapter.CreateAdapterInstance{
+				Name: "vc-01", AdapterKindKey: "VMWARE",
+			})
+			if err == nil {
+				t.Fatal("Register succeeded, want an error")
+			}
+
+			if tc.wantPrecheck {
+				var pe *opsadapter.PrecheckError
+				if !errors.As(err, &pe) {
+					t.Fatalf("error = %T, want *PrecheckError", err)
+				}
+				if pe.StatusCode != tc.wantStatus {
+					t.Errorf("status = %d, want %d", pe.StatusCode, tc.wantStatus)
+				}
+			} else {
+				var ae *opsadapter.APIError
+				if !errors.As(err, &ae) {
+					t.Fatalf("error = %T, want *APIError", err)
+				}
+				if ae.StatusCode != tc.wantStatus {
+					t.Errorf("status = %d, want %d", ae.StatusCode, tc.wantStatus)
+				}
+				if ae.OperationID != tc.wantOp {
+					t.Errorf("operationId = %q, want %q", ae.OperationID, tc.wantOp)
+				}
+			}
+
+			creates := 0
+			for _, rec := range srv.Requests() {
+				if rec.OperationID == "createAdapterInstance" {
+					creates++
+				}
+			}
+			if creates != tc.wantCreates {
+				t.Errorf("createAdapterInstance was sent %d times, want %d", creates, tc.wantCreates)
+			}
+			if got := srv.Instances(); len(got) != 0 {
+				t.Errorf("deployment holds %d adapter instances, want 0", len(got))
+			}
+		})
+	}
+}

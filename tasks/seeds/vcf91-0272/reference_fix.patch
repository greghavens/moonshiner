+package opsadapter
+
+// The types below are the JSON projections of the specification schemas the
+// contract names. Every member the specification marks optional carries
+// omitempty so that an unset member is left out of the payload rather than
+// sent as an empty string, a zero, or a null.
+//
+// monitoringInterval and monitoringIntervalSeconds are pointers: omitempty
+// drops a nil pointer but keeps a pointer to zero, which is what lets an
+// explicit interval of 0 reach the deployment.
+
+// usernamePassword is the username-password schema.
+type usernamePassword struct {
+	Username   string `json:"username"`
+	Password   string `json:"password"`
+	AuthSource string `json:"authSource,omitempty"`
+}
+
+// authToken is the auth-token schema.
+type authToken struct {
+	Token    string `json:"token"`
+	Validity int64  `json:"validity"`
+}
+
+// nameValue is the name-value schema.
+type nameValue struct {
+	Name  string `json:"name"`
+	Value string `json:"value"`
+}
+
+// credentialPayload is the credential schema.
+type credentialPayload struct {
+	Name              string      `json:"name"`
+	AdapterKindKey    string      `json:"adapterKindKey"`
+	CredentialKindKey string      `json:"credentialKindKey"`
+	Fields            []nameValue `json:"fields,omitempty"`
+}
+
+// createAdapterInstancePayload is the create-adapter-instance schema, shared by
+// testConnection and createAdapterInstance.
+type createAdapterInstancePayload struct {
+	Name                      string             `json:"name"`
+	AdapterKindKey            string             `json:"adapterKindKey"`
+	Description               string             `json:"description,omitempty"`
+	CollectorID               string             `json:"collectorId,omitempty"`
+	CollectorGroupID          string             `json:"collectorGroupId,omitempty"`
+	PhysicalDatacenterID      string             `json:"physicalDatacenterId,omitempty"`
+	MonitoringInterval        *int32             `json:"monitoringInterval,omitempty"`
+	MonitoringIntervalSeconds *int32             `json:"monitoringIntervalSeconds,omitempty"`
+	ResourceIdentifiers       []nameValue        `json:"resourceIdentifiers,omitempty"`
+	Credential                *credentialPayload `json:"credential,omitempty"`
+}
+
+// resourceKey is the resource-key schema.
+type resourceKey struct {
+	Name            string `json:"name"`
+	AdapterKindKey  string `json:"adapterKindKey"`
+	ResourceKindKey string `json:"resourceKindKey"`
+}
+
+// adapterInstance is the adapter-instance schema.
+type adapterInstance struct {
+	ID          string      `json:"id"`
+	ResourceKey resourceKey `json:"resourceKey"`
+}
+
+// apiErrorBody is the error schema.
+type apiErrorBody struct {
+	Message        string `json:"message"`
+	HTTPStatusCode int    `json:"httpStatusCode"`
+}
+
+// newCreatePayload projects the caller-facing spec onto the wire schema.
+func newCreatePayload(spec CreateAdapterInstance) createAdapterInstancePayload {
+	return createAdapterInstancePayload{
+		Name:                      spec.Name,
+		AdapterKindKey:            spec.AdapterKindKey,
+		Description:               spec.Description,
+		CollectorID:               spec.CollectorID,
+		CollectorGroupID:          spec.CollectorGroupID,
+		PhysicalDatacenterID:      spec.PhysicalDatacenterID,
+		MonitoringInterval:        spec.MonitoringInterval,
+		MonitoringIntervalSeconds: spec.MonitoringIntervalSeconds,
+		ResourceIdentifiers:       toNameValues(spec.ResourceIdentifiers),
+		Credential:                toCredential(spec.Credential),
+	}
+}
+
+func toNameValues(in []NameValue) []nameValue {
+	if len(in) == 0 {
+		return nil
+	}
+	out := make([]nameValue, len(in))
+	for i, nv := range in {
+		out[i] = nameValue{Name: nv.Name, Value: nv.Value}
+	}
+	return out
+}
+
+func toCredential(in *Credential) *credentialPayload {
+	if in == nil {
+		return nil
+	}
+	return &credentialPayload{
+		Name:              in.Name,
+		AdapterKindKey:    in.AdapterKindKey,
+		CredentialKindKey: in.CredentialKindKey,
+		Fields:            toNameValues(in.Fields),
+	}
+}

{
  "title": "VCF Operations 9.0 asynchronous content import",
  "openapiVersion": "3.0.1",
  "basePath": "/suite-api",
  "security": {
    "type": "apiKey",
    "in": "header",
    "name": "Authorization"
  },
  "operations": [
    {
      "operationId": "importContent",
      "method": "POST",
      "path": "/api/content/operations/import",
      "parameters": [
        {
          "name": "EncryptionPassword",
          "in": "header",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "force",
          "in": "query",
          "required": false,
          "schema": {
            "type": "boolean",
            "default": true
          }
        }
      ],
      "request": {
        "contentType": "multipart/form-data",
        "required": [
          "contentFile"
        ],
        "properties": {
          "contentFile": {
            "type": "string",
            "format": "binary"
          }
        }
      },
      "responses": {
        "202": {
          "description": "The import of content has been accepted",
          "contentType": "application/json",
          "schema": "content-import"
        }
      }
    },
    {
      "operationId": "getLastImportOperation",
      "method": "GET",
      "path": "/api/content/operations/import",
      "responses": {
        "200": {
          "description": "The details of content operation",
          "contentType": "application/json",
          "schema": "operation-details"
        }
      }
    }
  ],
  "schemas": {
    "content-import": {
      "required": [
        "fileName",
        "force"
      ],
      "properties": {
        "fileName": {
          "type": "string"
        },
        "force": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "links": {
          "type": "array",
          "items": "link"
        }
      }
    },
    "operation-details": {
      "required": [
        "state"
      ],
      "properties": {
        "operationSummaries": {
          "type": "array"
        },
        "errorMessages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "links": {
          "type": "array",
          "items": "link"
        },
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "NOT_INITIALIZED",
            "IMPORT",
            "EXPORT",
            "UNKNOWN"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "NOT_INITIALIZED",
            "INITIALIZED",
            "RUNNING",
            "FAILED",
            "FINISHED",
            "UNKNOWN"
          ]
        },
        "startTime": {
          "type": "integer",
          "format": "int64"
        },
        "endTime": {
          "type": "integer",
          "format": "int64"
        },
        "lastUpdatedTime": {
          "type": "integer",
          "format": "int64"
        },
        "errorCode": {
          "type": "string",
          "enum": [
            "NONE",
            "INVALID_FILE_FORMAT",
            "INVALID_ENCRYPTION_KEY",
            "OPERATION_FAILED",
            "UNKNOWN"
          ]
        }
      }
    },
    "link": {
      "properties": {
        "href": {
          "type": "string"
        },
        "rel": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}

 // ImportAndWait submits a content import and waits for its terminal state.
 func (c *Client) ImportAndWait(ctx context.Context, filename string, content io.Reader, opts ImportOptions) (ImportResult, error) {
-	return ImportResult{}, errors.New("ImportAndWait is not implemented")
+	accepted, err := c.importContent(ctx, filename, content, opts)
+	if err != nil {
+		return ImportResult{}, err
+	}
+
+	for {
+		operation, err := c.getLastImportOperation(ctx)
+		if err != nil {
+			return ImportResult{}, err
+		}
+		switch operation.State {
+		case StateFinished:
+			return ImportResult{Accepted: accepted, Operation: operation}, nil
+		case StateFailed, StateUnknown:
+			return ImportResult{}, &OperationError{Operation: operation}
+		case StateNotInitialized, StateInitialized, StateRunning:
+			if err := waitForPoll(ctx, c.pollInterval); err != nil {
+				return ImportResult{}, fmt.Errorf("wait to poll getLastImportOperation: %w", err)
+			}
+		default:
+			return ImportResult{}, fmt.Errorf("getLastImportOperation returned unsupported state %q", operation.State)
+		}
+	}
+}

{
  "contract_version": 1,
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/vcf-operations/vcf-operations-for-networks-openapi.yaml",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "api_title": "VCF Operations for networks API Reference",
    "api_version": "9.1.0.0"
  },
  "server_base_path": "/api/ni",
  "security": {
    "default": [
      "ApiKeyAuth",
      "OpsTokenAuth"
    ],
    "schemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "value_format": "NetworkInsight {token}"
      },
      "OpsTokenAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "value_format": "Bearer {token}"
      }
    },
    "selected_scheme": "ApiKeyAuth",
    "note": "This integration authenticates with the appliance-local token issued by operationId 'create', so it uses ApiKeyAuth. Every operation below except 'create' carries the Authorization header; the spec declares 'security: []' on 'create', so that one request must carry no Authorization header at all."
  },
  "encoding": {
    "request_content_type": "application/json",
    "omit_unset_optional_fields": true,
    "omit_note": "An optional field that has no value must be absent from the JSON object. Encoding it as null, as an empty string, as zero, as false-when-unset or as an empty object/array is a contract violation: this API treats a present key as an explicit assignment. A field the operator did set to false is set, not unset, and must be present with the value false."
  },
  "error_schema": {
    "name": "ApiError",
    "properties": {
      "code": "integer(int32)",
      "message": "string",
      "details": "array of ErrorDetail{code:integer(int32), message:string, target:array of string}"
    }
  },
  "gate": {
    "precheck_operation": "validateVCenter",
    "mutating_operation": "addVcenterDatasource",
    "rule": "addVcenterDatasource may be sent for a vCenter only after validateVCenter for that same vCenter answered HTTP 200 with a BaseDataSourceValidationResponse whose 'code' is 200. Any other outcome blocks the mutation entirely.",
    "soft_failure_note": "BaseDataSourceValidationResponse carries its own 'code' field. The appliance answers HTTP 200 with a body code such as 400 when the credentials or the certificate were rejected but the request itself was well formed. HTTP status alone is not the precheck verdict."
  },
  "operations": [
    {
      "operationId": "create",
      "method": "POST",
      "path": "/api/ni/auth/token",
      "spec_path": "/auth/token",
      "summary": "Create an auth token",
      "security": [],
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "UserCredential",
        "properties": {
          "username": {
            "type": "string",
            "required": true
          },
          "password": {
            "type": "string",
            "required": true
          },
          "domain": {
            "type": "object",
            "required": false,
            "omit_when_unset": true,
            "schema": "Domain",
            "properties": {
              "domain_type": {
                "type": "string",
                "required": true,
                "enum": [
                  "LDAP",
                  "LOCAL"
                ],
                "note": "domain type, should be in uppercase"
              },
              "value": {
                "type": "string",
                "required": false,
                "omit_when_unset": true,
                "note": "domain value, not required for LOCAL domain"
              }
            }
          }
        }
      },
      "success": {
        "status": 200,
        "schema": "Token",
        "properties": {
          "token": "string",
          "expiry": "integer(int64), expiry epoch time"
        }
      },
      "error_statuses": [
        400,
        401,
        500
      ],
      "spec_note": "All subsequent API requests must provide the token in the Authorization header as 'NetworkInsight {token}'. There is a limit of 100 valid tokens per user, so callers are advised to delete the token after use."
    },
    {
      "operationId": "validateVCenter",
      "method": "POST",
      "path": "/api/ni/data-sources/vcenters/validate",
      "spec_path": "/data-sources/vcenters/validate",
      "summary": "Validate a vCenter data source",
      "description": "Validate a vCenter data source. You must provide one of IP or FQDN field in the request body. Appropriate proxy id is retrieved from /infra/nodes URL to select the proxy node.",
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "VCenterDataSourceValidationRequest",
        "composed_from": [
          "BaseDataSourceValidationRequest",
          "inline object"
        ],
        "closed_property_set": [
          "ip",
          "fqdn",
          "proxy_id",
          "credentials",
          "ipfix_enabled"
        ],
        "closed_note": "VCenterDataSourceValidationRequest is allOf(BaseDataSourceValidationRequest, {credentials, ipfix_enabled}). It is a strictly smaller schema than VCenterDataSourceRequest: nickname, notes, enabled, is_vmc, ds_sub_type, tags, enable_ds_associated_tags, ipfix_request and antrea_ipfix_request are NOT members of it and must never be sent to this operation.",
        "properties": {
          "ip": {
            "type": "string",
            "required": false,
            "omit_when_unset": true,
            "note": "IP address of data source (use either IP or FQDN, not both)"
          },
          "fqdn": {
            "type": "string",
            "required": false,
            "omit_when_unset": true,
            "note": "Hostname of data source (use either IP or FQDN, not both)"
          },
          "proxy_id": {
            "type": "string",
            "required": true,
            "note": "ID of Collector VM which should register this vcenter"
          },
          "credentials": {
            "type": "object",
            "required": false,
            "schema": "PasswordCredentials",
            "properties": {
              "username": {
                "type": "string",
                "required": true
              },
              "password": {
                "type": "string",
                "required": false,
                "omit_when_unset": true
              }
            }
          },
          "ipfix_enabled": {
            "type": "boolean",
            "required": false,
            "omit_when_unset": true,
            "spec_default": false,
            "note": "Whether or not to configure vCenter to send IPFIX to Operations for Networks. This flat boolean is the validation-time spelling of the IPFIX intent; the create operation spells the same intent as the ipfix_request object."
          }
        }
      },
      "success": {
        "status": 200,
        "schema": "BaseDataSourceValidationResponse",
        "properties": {
          "code": "integer(int32)",
          "message": "string"
        },
        "spec_example": {
          "code": 200,
          "message": "Validation successful."
        }
      },
      "error_statuses": [
        400,
        401,
        403,
        500
      ]
    },
    {
      "operationId": "addVcenterDatasource",
      "method": "POST",
      "path": "/api/ni/data-sources/vcenters",
      "spec_path": "/data-sources/vcenters",
      "summary": "Create a vCenter data source",
      "description": "Add a vCenter data source. You must provide one of IP or FQDN field in the request body. Appropriate proxy id is retrieved from /infra/nodes URL to select the proxy node.",
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "VCenterDataSourceRequest",
        "composed_from": [
          "BaseDataSourceRequest",
          "inline object"
        ],
        "closed_property_set": [
          "ip",
          "fqdn",
          "proxy_id",
          "nickname",
          "enabled",
          "notes",
          "credentials",
          "ipfix_request",
          "antrea_ipfix_request",
          "is_vmc",
          "ds_sub_type",
          "tags",
          "enable_ds_associated_tags"
        ],
        "properties": {
          "ip": {
            "type": "string",
            "required": false,
            "omit_when_unset": true,
            "note": "IP address of data source (use either IP or FQDN, not both)"
          },
          "fqdn": {
            "type": "string",
            "required": false,
            "omit_when_unset": true,
            "note": "Hostname of data source (use either IP or FQDN, not both)"
          },
          "proxy_id": {
            "type": "string",
            "required": true
          },
          "nickname": {
            "type": "string",
            "required": true,
            "note": "A friendly nickname for the data source"
          },
          "enabled": {
            "type": "boolean",
            "required": false,
            "omit_when_unset": true,
            "spec_default": true,
            "note": "Whether or not data collection is enabled. The appliance applies the default true when the key is absent, so an operator who asked for false must produce the key with the value false."
          },
          "notes": {
            "type": "string",
            "required": false,
            "omit_when_unset": true,
            "note": "Room for notes or comments about the data source"
          },
          "credentials": {
            "type": "object",
            "required": false,
            "schema": "PasswordCredentials",
            "properties": {
              "username": {
                "type": "string",
                "required": true
              },
              "password": {
                "type": "string",
                "required": false,
                "omit_when_unset": true
              }
            }
          },
          "ipfix_request": {
            "type": "object",
            "required": false,
            "omit_when_unset": true,
            "schema": "dvs_ipfix_request",
            "properties": {
              "enable_all": {
                "type": "boolean",
                "required": false,
                "omit_when_unset": true,
                "spec_default": false,
                "note": "Enable flow collection for All DVS."
              },
              "disable_all": {
                "type": "boolean",
                "required": false,
                "omit_when_unset": true,
                "spec_default": false,
                "note": "Disable flow collection for All DVS."
              },
              "enable_for_dvs": {
                "type": "string",
                "required": false,
                "omit_when_unset": true,
                "note": "Comma separated values of all the dvs objects for which ipfix should be enabled."
              },
              "disable_for_dvs": {
                "type": "string",
                "required": false,
                "omit_when_unset": true,
                "note": "Comma separated values of all the dvs objects for which ipfix should be disabled."
              },
              "dvpgs_ipfix_request": {
                "type": "array",
                "required": false,
                "omit_when_unset": true,
                "items": "dvpgs_ipfix_request"
              }
            }
          },
          "antrea_ipfix_request": {
            "type": "object",
            "required": false,
            "omit_when_unset": true,
            "not_used_by_this_integration": true
          },
          "is_vmc": {
            "type": "boolean",
            "required": false,
            "omit_when_unset": true,
            "spec_default": false,
            "note": "Whether vCenter is a VMware Cloud operated vCenter."
          },
          "ds_sub_type": {
            "type": "string",
            "required": false,
            "omit_when_unset": true,
            "not_used_by_this_integration": true
          },
          "tags": {
            "type": "array",
            "required": false,
            "omit_when_unset": true,
            "not_used_by_this_integration": true
          },
          "enable_ds_associated_tags": {
            "type": "boolean",
            "required": false,
            "omit_when_unset": true,
            "not_used_by_this_integration": true
          }
        }
      },
      "success": {
        "status": 201,
        "schema": "VCenterDataSource",
        "properties": {
          "entity_id": "string",
          "entity_type": "string, VCenterDataSource",
          "ip": "string",
          "fqdn": "string",
          "proxy_id": "string",
          "nickname": "string",
          "enabled": "boolean",
          "notes": "string",
          "credentials": "PasswordCredentials",
          "ipfix_response": "dvs_ipfix_response"
        }
      },
      "error_statuses": [
        400,
        401,
        403,
        500
      ]
    },
    {
      "operationId": "delete",
      "method": "DELETE",
      "path": "/api/ni/auth/token",
      "spec_path": "/auth/token",
      "summary": "Delete an auth token",
      "description": "Deletes the auth token provided in Authorization header. Deleting an expired or invalid token will result in 401 Unauthorized error.",
      "request": null,
      "success": {
        "status": 204,
        "schema": null
      },
      "error_statuses": [
        401,
        500
      ]
    }
  ]
}

+BASE_PATH = "/api/ni"
+
+# operationId -> (method, path). The contract is the source of these.
+AUTH_TOKEN_PATH = BASE_PATH + "/auth/token"
+VALIDATE_VCENTER_PATH = BASE_PATH + "/data-sources/vcenters/validate"
+VCENTER_DATASOURCE_PATH = BASE_PATH + "/data-sources/vcenters"
+
+
+def _set(body, key, value):
+    """Assign ``key`` only when the operator actually set ``value``.
+
+    ``None`` is the plan's spelling of "unset", and an unset optional field must
+    be absent from the JSON object rather than present as null. ``False`` is a
+    value, not an absence, so it is assigned.
+    """
+    if value is not None:
+        body[key] = value
+
+
+def _password_credentials(credentials):
+    """PasswordCredentials for a data source."""
+    body = {"username": credentials.username}
+    _set(body, "password", credentials.password)
+    return body
+
 
 def user_credential_body(credentials, domain=None):
     """Build the UserCredential body for operationId ``create``.
 
     ``domain`` is an optional :class:`~vcfon_vcenter.plan.Domain`.
     """
-    raise NotImplementedError
+    body = {"username": credentials.username, "password": credentials.password}
+    if domain is not None:
+        domain_body = {"domain_type": domain.domain_type}
+        # 'value' is not required for a LOCAL domain, so it is omitted when unset.
+        _set(domain_body, "value", domain.value)
+        body["domain"] = domain_body
+    return body
+
+
+def _host(body, spec):
+    """Exactly one of ip and fqdn; the unset one never reaches the wire."""
+    _set(body, "ip", spec.ip)
+    _set(body, "fqdn", spec.fqdn)
 
 
 def validation_body(spec):
     """Build the VCenterDataSourceValidationRequest body for ``validateVCenter``.
 
     ``spec`` is a :class:`~vcfon_vcenter.plan.VcenterSpec`. Only the properties
-    the validation schema actually declares may appear.
+    the validation schema actually declares may appear: ip, fqdn, proxy_id,
+    credentials and ipfix_enabled. nickname, notes, enabled, is_vmc and
+    ipfix_request belong to VCenterDataSourceRequest, not to this schema.
     """
-    raise NotImplementedError
+    body = {}
+    _host(body, spec)
+    body["proxy_id"] = spec.proxy_id
+    body["credentials"] = _password_credentials(spec.credentials)
+    if spec.ipfix is not None:
+        # This operation spells the IPFIX intent as a flat boolean.
+        body["ipfix_enabled"] = True
+    return body
+
+
+def _ipfix_request(intent):
+    """dvs_ipfix_request carrying only the switches the operator named."""
+    body = {}
+    _set(body, "enable_all", intent.enable_all)
+    _set(body, "enable_for_dvs", intent.enable_for_dvs)
+    _set(body, "disable_for_dvs", intent.disable_for_dvs)
+    return body
 
 
 def datasource_body(spec):
@@ -39,7 +94,21 @@ def datasource_body(spec):
 
     ``spec`` is a :class:`~vcfon_vcenter.plan.VcenterSpec`.
     """
-    raise NotImplementedError
+    body = {}
+    _host(body, spec)
+    body["proxy_id"] = spec.proxy_id
+    body["nickname"] = spec.nickname
+    _set(body, "notes", spec.notes)
+    # enabled defaults to true on the appliance, so an operator who asked for
+    # false has to produce the key; one who said nothing must not.
+    _set(body, "enabled", spec.enabled)
+    _set(body, "is_vmc", spec.is_vmc)
+    body["credentials"] = _password_credentials(spec.credentials)
+    if spec.ipfix is not None:
+        ipfix = _ipfix_request(spec.ipfix)
+        if ipfix:
+            body["ipfix_request"] = ipfix
+    return body
 
 

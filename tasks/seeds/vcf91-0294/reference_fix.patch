diff --git a/src/vcfon_vcenter/onboarding.py b/src/vcfon_vcenter/onboarding.py
index bea5f4c..aa4814e 100644
--- a/src/vcfon_vcenter/onboarding.py
+++ b/src/vcfon_vcenter/onboarding.py
@@ -6,6 +6,27 @@ Standard library only.
 from __future__ import annotations
 
 from .client import VcenterDataSourceClient
+from .errors import VcfOnApiError
+
+PRECHECK_PASS_CODE = 200
+
+
+def _verdict(http_status, code, message):
+    return {"http_status": http_status, "code": code, "message": message}
+
+
+def _precheck(client, spec):
+    """Run validateVCenter for one spec.
+
+    Returns ``(passed, verdict)``. The verdict always has the same three keys,
+    whether the appliance answered with a validation body or an ApiError.
+    """
+    try:
+        body = client.validate_vcenter(spec)
+    except VcfOnApiError as error:
+        return False, _verdict(error.http_status, error.code, error.message)
+    code = body.get("code")
+    return code == PRECHECK_PASS_CODE, _verdict(200, code, body.get("message"))
 
 
 def onboard_vcenters(plan, base_url, timeout=10.0):
@@ -14,4 +35,53 @@ def onboard_vcenters(plan, base_url, timeout=10.0):
     See README.md for the required run order, the precheck gate and the exact
     report shape.
     """
-    raise NotImplementedError
+    client = VcenterDataSourceClient(base_url, timeout=timeout)
+    client.create_auth_token(plan.credentials, plan.domain)
+
+    entries = []
+    try:
+        for spec in plan.datasources:
+            entry = {"nickname": spec.nickname, "host": spec.host}
+            passed, verdict = _precheck(client, spec)
+            entry["precheck"] = verdict
+            if not passed:
+                # The gate: the mutation is not attempted at all.
+                entry["status"] = "precheck_failed"
+                entries.append(entry)
+                continue
+            try:
+                created = client.add_vcenter_datasource(spec)
+            except VcfOnApiError as error:
+                entry["status"] = "create_failed"
+                entry["error"] = _verdict(error.http_status, error.code, error.message)
+            else:
+                entry["status"] = "created"
+                entry["entity_id"] = created.get("entity_id")
+            entries.append(entry)
+    finally:
+        # The appliance caps a user at 100 live tokens; release it either way.
+        token_released = True
+        try:
+            client.delete_auth_token()
+        except VcfOnApiError:
+            token_released = False
+
+    created_count = sum(1 for entry in entries if entry["status"] == "created")
+    blocked_count = sum(1 for entry in entries if entry["status"] == "precheck_failed")
+    failed_count = sum(1 for entry in entries if entry["status"] == "create_failed")
+
+    if created_count == len(entries):
+        outcome = "onboarded"
+    elif created_count == 0:
+        outcome = "blocked"
+    else:
+        outcome = "partial"
+
+    return {
+        "outcome": outcome,
+        "datasources": entries,
+        "created_count": created_count,
+        "blocked_count": blocked_count,
+        "failed_count": failed_count,
+        "token_released": token_released,
+    }

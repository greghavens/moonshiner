+func (c *Client) PrecheckAndCreate(ctx context.Context, input LogForwarderInput) (LogForwarder, error) {
+	if ctx == nil {
+		return LogForwarder{}, errors.New("nil context")
+	}
+	body, err := encodeInput(input)
+	if err != nil {
+		return LogForwarder{}, &OperationError{
+			OperationID: OperationTestLogForwarderConnection,
+			Kind:        KindProtocol,
+			cause:       err,
+		}
+	}
+
+	precheckResponse, err := c.post(
+		ctx,
+		OperationTestLogForwarderConnection,
+		"/api/v2/logs/forwarders/test",
+		body,
+	)
+	if err != nil {
+		return LogForwarder{}, err
+	}
+	if err := validatePrecheckResponse(precheckResponse); err != nil {
+		return LogForwarder{}, err
+	}
+
+	createResponse, err := c.post(
+		ctx,
+		OperationCreateLogForwarder,
+		"/api/v2/logs/forwarders",
+		body,
+	)
+	if err != nil {
+		return LogForwarder{}, err
+	}
+	return decodeCreateResponse(createResponse)
+}
+
+func encodeInput(input LogForwarderInput) ([]byte, error) {
+	var buffer bytes.Buffer
+	encoder := json.NewEncoder(&buffer)
+	encoder.SetEscapeHTML(false)
+	if err := encoder.Encode(input); err != nil {
+		return nil, err
+	}
+	encoded := buffer.Bytes()
+	if len(encoded) == 0 || encoded[len(encoded)-1] != '\n' {
+		return nil, errors.New("JSON encoder did not terminate its value")
+	}
+	return append([]byte(nil), encoded[:len(encoded)-1]...), nil
+}

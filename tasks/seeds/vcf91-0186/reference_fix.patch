+func (c *Client) post(ctx context.Context, operationID, path string, body []byte) (*http.Response, error) {
+	endpoint := *c.baseURL
+	endpoint.Path = path
+	endpoint.RawPath = ""
+	endpoint.RawQuery = ""
+	endpoint.ForceQuery = false
+	endpoint.Fragment = ""
+
+	request, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint.String(), bytes.NewReader(body))
+	if err != nil {
+		return nil, &OperationError{
+			OperationID: operationID,
+			Kind:        KindProtocol,
+			cause:       err,
+		}
+	}
+	request.Header = make(http.Header)
+	request.Header.Set("Accept", "application/json")
+	request.Header.Set("Content-Type", "application/json")
+	request.Header.Set("X-JWT-Token", c.token)
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		if response != nil && response.Body != nil {
+			_ = response.Body.Close()
+		}
+		return nil, &OperationError{
+			OperationID: operationID,
+			Kind:        KindTransport,
+			cause:       err,
+		}
+	}
+	return response, nil
+}
+
+func validatePrecheckResponse(response *http.Response) error {
+	defer response.Body.Close()
+	body, tooLarge, readErr := readResponse(response.Body)
+	if response.StatusCode != http.StatusOK {
+		return &OperationError{
+			OperationID: OperationTestLogForwarderConnection,
+			Kind:        KindHTTP,
+			StatusCode:  response.StatusCode,
+		}
+	}
+	if readErr != nil || tooLarge || len(body) != 0 {
+		return &OperationError{
+			OperationID: OperationTestLogForwarderConnection,
+			Kind:        KindProtocol,
+			cause:       readErr,
+		}
+	}
+	return nil
+}
+
+func decodeCreateResponse(response *http.Response) (LogForwarder, error) {
+	defer response.Body.Close()
+	body, tooLarge, readErr := readResponse(response.Body)
+	if response.StatusCode != http.StatusCreated {
+		return LogForwarder{}, &OperationError{
+			OperationID: OperationCreateLogForwarder,
+			Kind:        KindHTTP,
+			StatusCode:  response.StatusCode,
+		}
+	}
+	if readErr != nil || tooLarge {
+		return LogForwarder{}, &OperationError{
+			OperationID: OperationCreateLogForwarder,
+			Kind:        KindProtocol,
+			cause:       readErr,
+		}
+	}
+	mediaType, _, err := mime.ParseMediaType(response.Header.Get("Content-Type"))
+	if err != nil || mediaType != "application/json" {
+		return LogForwarder{}, &OperationError{
+			OperationID: OperationCreateLogForwarder,
+			Kind:        KindProtocol,
+			cause:       err,
+		}
+	}
+	trimmed := bytes.TrimSpace(body)
+	if len(trimmed) == 0 || trimmed[0] != '{' {
+		return LogForwarder{}, &OperationError{
+			OperationID: OperationCreateLogForwarder,
+			Kind:        KindProtocol,
+		}
+	}
+
+	var result LogForwarder
+	decoder := json.NewDecoder(bytes.NewReader(body))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&result); err != nil {
+		return LogForwarder{}, &OperationError{
+			OperationID: OperationCreateLogForwarder,
+			Kind:        KindProtocol,
+			cause:       err,
+		}
+	}
+	if err := requireEOF(decoder); err != nil {
+		return LogForwarder{}, &OperationError{
+			OperationID: OperationCreateLogForwarder,
+			Kind:        KindProtocol,
+			cause:       err,
+		}
+	}
+	return result, nil
+}
+
+func readResponse(reader io.Reader) ([]byte, bool, error) {
+	body, err := io.ReadAll(io.LimitReader(reader, maxResponseBody+1))
+	if err != nil {
+		return nil, false, err
+	}
+	if len(body) > maxResponseBody {
+		return body[:maxResponseBody], true, nil
+	}
+	return body, false, nil
+}
+
+func requireEOF(decoder *json.Decoder) error {
+	var extra json.RawMessage
+	err := decoder.Decode(&extra)
+	if errors.Is(err, io.EOF) {
+		return nil
+	}
+	if err == nil {
+		return errors.New("response contains trailing JSON")
+	}
+	return err
 }

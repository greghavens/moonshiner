{
  "openapi": "3.0.1",
  "info": {
    "title": "Log Management API\n",
    "version": "9.1.0.0"
  },
  "x-official-source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "license": "Apache-2.0",
    "commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_blob_sha": "4ada16fa39ec345674de4126174de94ea70d23a0",
    "spec_path": "specifications/vcf-operations/log-management-openapi.json"
  },
  "security": [
    {
      "OPSTokenAuthorization": []
    }
  ],
  "paths": {
    "/api/v2/logs/forwarders": {
      "post": {
        "operationId": "createLogForwarder",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogForwarder"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogForwarder"
                }
              }
            },
            "description": "Log forwarder created successfully"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad request: Invalid input data"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Forbidden: Authentication required"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unprocessable entity: Limit exceed"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Internal server error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Certificate is not trusted"
          }
        },
        "summary": "Create a log forwarder",
        "tags": [
          "Log Forwarder"
        ]
      }
    },
    "/api/v2/logs/forwarders/test": {
      "post": {
        "operationId": "testLogForwarderConnection",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogForwarder"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Log forwarders test sent successfully"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad request: Invalid input data"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Forbidden: Authentication required"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Certificate is not trusted"
          }
        },
        "summary": "Test log forwarder connection",
        "tags": [
          "Log Forwarder"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "properties": {
          "errorCode": {
            "type": "string",
            "enum": [
              "API_ERROR",
              "LIMIT_ERROR",
              "FIELD_ERROR",
              "TEST_ERROR",
              "JSON_FORMAT_ERROR",
              "LICENSE_ERROR",
              "VSPHERE_INTEGRATION_ERROR",
              "VROPS_INTEGRATION_ERROR",
              "UPGRADE_ERROR",
              "SEARCH_ERROR",
              "AGENT_ERROR",
              "RBAC_COMMON_ERROR",
              "RBAC_USERS_ERROR",
              "RBAC_GROUPS_ERROR",
              "RBAC_ADGROUPS_ERROR",
              "RBAC_DATASETS_ERROR",
              "RBAC_VIDM_GROUPS_ERROR",
              "RBAC_VIDB_GROUPS_ERROR",
              "AUTH_PROVIDER_ERROR",
              "SECURITY_ERROR",
              "DEPLOYMENT_ERROR",
              "SUPPORT_BUNDLE_ERROR",
              "VIP_ERROR",
              "LOAD_BALANCER_ERROR",
              "VIDM_ERROR",
              "VIDB_ERROR",
              "AD_ERROR",
              "WEBHOOK_ERROR",
              "WEB_PROXY_ERROR",
              "SMTP_ERROR",
              "QUERY_ERROR",
              "CERTIFICATE_PEM_FORMAT_ERROR",
              "CERTIFICATE_FILE_INVALID",
              "CERTIFICATE_UPDATE_ERROR",
              "NSX_INTEGRATION_ERROR",
              "NSX_MANAGER_CONNECTIVITY_ERROR",
              "NO_CONFIGURATION_ERROR",
              "SSL_ERROR",
              "CERTIFICATE_PURPOSE_ERROR",
              "VCF_CAPABILITIES_REGISTRY_ERROR",
              "VALIDATION_ERROR",
              "INTERNAL_SERVER_ERROR",
              "UNPROCESSABLE_ENTITY",
              "RESOURCE_EXHAUSTED"
            ]
          },
          "errorDetails": {
            "type": "object"
          },
          "errorMessage": {
            "type": "string"
          }
        }
      },
      "LogForwarder": {
        "type": "object",
        "properties": {
          "certificate": {
            "type": "string"
          },
          "connectionRefreshInterval": {
            "type": "integer",
            "format": "int32"
          },
          "constraints": {
            "$ref": "#/components/schemas/Query"
          },
          "enabled": {
            "type": "boolean"
          },
          "forwardComplementaryFields": {
            "type": "boolean"
          },
          "host": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "readOnly": true
          },
          "name": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "format": "int32"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "SYSLOG",
              "RAW",
              "RAWPLUS"
            ]
          },
          "sslEnabled": {
            "type": "boolean"
          },
          "tags": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "transportProtocol": {
            "type": "string",
            "enum": [
              "TCP",
              "UDP"
            ]
          },
          "workerCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Query": {
        "type": "object",
        "properties": {
          "bool": {
            "$ref": "#/components/schemas/BoolQuery"
          },
          "exists": {
            "$ref": "#/components/schemas/ExistsQuery"
          },
          "match_all": {
            "$ref": "#/components/schemas/MatchAllQuery"
          },
          "match_phrase": {
            "type": "object",
            "properties": {
              "empty": {
                "type": "boolean"
              }
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "prefix": {
            "type": "object",
            "properties": {
              "empty": {
                "type": "boolean"
              }
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "range": {
            "type": "object",
            "properties": {
              "empty": {
                "type": "boolean"
              }
            },
            "additionalProperties": {
              "$ref": "#/components/schemas/RangeQueryValue"
            }
          },
          "regexp": {
            "type": "object",
            "properties": {
              "empty": {
                "type": "boolean"
              }
            },
            "additionalProperties": {
              "$ref": "#/components/schemas/FieldValue"
            }
          },
          "term": {
            "type": "object",
            "properties": {
              "empty": {
                "type": "boolean"
              }
            },
            "additionalProperties": {
              "$ref": "#/components/schemas/FieldValue"
            }
          },
          "terms": {
            "type": "object",
            "properties": {
              "empty": {
                "type": "boolean"
              }
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/FieldValue"
              }
            }
          }
        }
      },
      "BoolQuery": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Query"
            }
          },
          "must": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Query"
            }
          },
          "must_not": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Query"
            }
          },
          "should": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Query"
            }
          }
        }
      },
      "ExistsQuery": {
        "required": [
          "field"
        ],
        "type": "object",
        "properties": {
          "field": {
            "minLength": 1,
            "type": "string"
          }
        }
      },
      "FieldValue": {
        "type": "object",
        "properties": {
          "case_insensitive": {
            "type": "boolean"
          },
          "value": {
            "type": "object"
          }
        }
      },
      "MatchAllQuery": {
        "type": "object"
      },
      "RangeQueryValue": {
        "type": "object",
        "properties": {
          "gt": {
            "type": "string"
          },
          "gte": {
            "type": "string"
          },
          "lt": {
            "type": "string"
          },
          "lte": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "OPSTokenAuthorization": {
        "description": "This documentation covers v2 API endpoints.\n\nAuthenticated requests must include an X-JWT-Token header with a token retrieved with the following authenticated call to VCF Operation API : \n\nPOST /suite-api/api/auth/token/exchange \n\nRequest body {\"serviceKeys\": [\"ops-li\"]}.\n\nAccess is allowed only to resources that the user is authorized to use.",
        "in": "header",
        "name": "X-JWT-Token",
        "type": "apiKey"
      }
    }
  }
}

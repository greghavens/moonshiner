{
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "license": "Apache-2.0",
    "tag": "9.0.0.0",
    "commit_sha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "spec_path": "specifications/vcf-operations/vcf-operations-openapi.json"
  },
  "openapi": "3.0.1",
  "base_path": "/suite-api",
  "security": {
    "scheme": "Token-based-authorization",
    "type": "apiKey",
    "in": "header",
    "name": "Authorization"
  },
  "operations": [
    {
      "operationId": "getSymptomDefinitions",
      "method": "GET",
      "path": "/api/symptomdefinitions",
      "parameters": [
        {
          "name": "adapterKind",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "resourceKind",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "id",
          "in": "query",
          "required": false,
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "name",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "page",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32",
            "default": 0
          }
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32",
            "default": 1000
          }
        }
      ],
      "responses": {
        "200": {
          "description": "The list of Symptom Definitions",
          "content_type": "application/json",
          "schema": "symptom-definitions"
        }
      }
    }
  ],
  "schemas": {
    "page-info": {
      "type": "object",
      "properties": {
        "totalCount": {
          "type": "integer",
          "format": "int32"
        },
        "page": {
          "type": "integer",
          "format": "int32",
          "minimum": 0
        },
        "pageSize": {
          "type": "integer",
          "format": "int32",
          "minimum": 1
        },
        "sortBy": {
          "type": "string"
        },
        "sortOrder": {
          "type": "string"
        }
      }
    },
    "symptom-definitions": {
      "type": "object",
      "properties": {
        "pageInfo": {
          "$ref": "page-info"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "link"
          }
        },
        "symptomDefinitions": {
          "type": "array",
          "items": {
            "$ref": "symptom-definition"
          }
        }
      }
    },
    "symptom-definition": {
      "type": "object",
      "required": [
        "adapterKindKey",
        "name",
        "resourceKindKey",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "adapterKindKey": {
          "type": "string"
        },
        "resourceKindKey": {
          "type": "string"
        },
        "waitCycles": {
          "type": "integer",
          "format": "int32",
          "minimum": 1
        },
        "cancelCycles": {
          "type": "integer",
          "format": "int32",
          "minimum": 1
        },
        "realtimeMonitoringEnabled": {
          "type": "boolean"
        },
        "state": {
          "$ref": "symptom-state"
        }
      }
    },
    "symptom-state": {
      "type": "object",
      "required": [
        "condition",
        "severity"
      ]
    },
    "link": {
      "type": "object",
      "required": [
        "href"
      ]
    }
  }
}

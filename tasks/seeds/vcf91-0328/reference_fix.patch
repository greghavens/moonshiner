+	if err != nil {
+		return nil, fmt.Errorf("vcfauto: %s: %w", opGetDeploymentActions, err)
+	}
+
+	var actions []Action
+	if err := c.do(req, opGetDeploymentActions, &actions); err != nil {
+		return nil, err
+	}

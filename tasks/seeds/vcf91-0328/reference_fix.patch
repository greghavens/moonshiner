+// returns so a caller can tell the precheck read apart from the mutating call.
+const (
+	opGetDeploymentActions          = "getDeploymentActions"
+	opSubmitDeploymentActionRequest = "submitDeploymentActionRequest"
 )
 
 // Config configures a Client.
@@ -61,6 +74,17 @@ type Request struct {
 	Status       string `json:"status"`
 }
 
+// resourceActionRequest is the ResourceActionRequest body of
+// submitDeploymentActionRequest.
+//
+// The omitempty tags are the contract's omitWhenUnset flags: an optional field
+// the caller left alone has to be absent from the body, not sent as "" or {}.
+type resourceActionRequest struct {
+	ActionID string         `json:"actionId"`
+	Inputs   map[string]any `json:"inputs,omitempty"`
+	Reason   string         `json:"reason,omitempty"`
+}
+
 // Errors reported by SubmitAction before or instead of the mutating call.
 var (
 	// ErrInvalidRequest reports an ActionRequest that is malformed, so no HTTP

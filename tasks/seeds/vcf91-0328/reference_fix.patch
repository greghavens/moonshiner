 // SubmitAction runs the precheck and, only if it passes, submits the day-2
 // action request. When the precheck fails the mutating call is not made.
 func (c *Client) SubmitAction(ctx context.Context, req ActionRequest) (*Request, error) {
-	return nil, errors.New("vcfauto: SubmitAction not implemented")
+	if err := checkDeploymentID(req.DeploymentID); err != nil {
+		return nil, err
+	}
+	if req.ActionID == "" {
+		return nil, fmt.Errorf("%w: ActionID is required", ErrInvalidRequest)
+	}
+
+	// The gate. Nothing below this point runs unless the precheck approves.
+	actions, err := c.ListActions(ctx, req.DeploymentID)
+	if err != nil {
+		return nil, err
+	}
+	found := false
+	valid := false
+	for _, action := range actions {
+		if action.ID != req.ActionID {
+			continue
+		}
+		found = true
+		if action.Valid {
+			valid = true
+			break
+		}
+	}
+	switch {
+	case !found:
+		return nil, fmt.Errorf("%w: %q on deployment %q",
+			ErrActionNotFound, req.ActionID, req.DeploymentID)
+	case !valid:
+		return nil, fmt.Errorf("%w: %q on deployment %q",
+			ErrActionNotValid, req.ActionID, req.DeploymentID)
+	}
+
+	body, err := json.Marshal(resourceActionRequest{
+		ActionID: req.ActionID,
+		Inputs:   req.Inputs,
+		Reason:   req.Reason,
+	})
+	if err != nil {
+		return nil, fmt.Errorf("vcfauto: %s: encode body: %w", opSubmitDeploymentActionRequest, err)
+	}
+
+	httpReq, err := c.newRequest(ctx, http.MethodPost,
+		"/deployment/api/deployments/"+req.DeploymentID+"/requests", body)
+	if err != nil {
+		return nil, fmt.Errorf("vcfauto: %s: %w", opSubmitDeploymentActionRequest, err)
+	}
+
+	var out Request
+	if err := c.do(httpReq, opSubmitDeploymentActionRequest, &out); err != nil {
+		return nil, err
+	}
+	return &out, nil
+}
+
+// checkDeploymentID rejects ids that would change the request path rather than
+// fill the deploymentId slot in it.
+func checkDeploymentID(id string) error {
+	if id == "" {
+		return fmt.Errorf("%w: DeploymentID is required", ErrInvalidRequest)
+	}
+	if strings.ContainsAny(id, "/?#") {
+		return fmt.Errorf("%w: DeploymentID %q contains a path separator", ErrInvalidRequest, id)
+	}
+	return nil
+}
+
+// newRequest builds a request against a contract path. Content-Type is set only
+// when there is a body to describe.
+func (c *Client) newRequest(ctx context.Context, method, path string, body []byte) (*http.Request, error) {
+	var rdr io.Reader
+	if body != nil {
+		rdr = bytes.NewReader(body)
+	}
+	req, err := http.NewRequestWithContext(ctx, method, c.baseURL+path, rdr)
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Authorization", "Bearer "+c.token)
+	req.Header.Set("Accept", "application/json")
+	if body != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	return req, nil
+}
+
+func (c *Client) do(req *http.Request, op string, out any) error {
+	resp, err := c.hc.Do(req)
+	if err != nil {
+		return fmt.Errorf("vcfauto: %s: %w", op, err)
+	}
+	defer resp.Body.Close()
+
+	body, err := io.ReadAll(io.LimitReader(resp.Body, 4<<20))
+	if err != nil {
+		return fmt.Errorf("vcfauto: %s: read response: %w", op, err)
+	}
+	if resp.StatusCode < 200 || resp.StatusCode > 299 {
+		return &APIError{Op: op, StatusCode: resp.StatusCode, Body: strings.TrimSpace(string(body))}
+	}
+	if out == nil {
+		return nil
+	}
+	if err := json.Unmarshal(body, out); err != nil {
+		return fmt.Errorf("vcfauto: %s: decode response: %w", op, err)
+	}
+	return nil
 }

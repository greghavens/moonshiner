+	if err != nil || u.Scheme == "" || u.Host == "" {
+		return nil, fmt.Errorf("%w: BaseURL %q is not an absolute URL", ErrInvalidRequest, cfg.BaseURL)
+	}
+	if cfg.Token == "" {
+		return nil, fmt.Errorf("%w: Token is required", ErrInvalidRequest)
+	}
+
+	hc := cfg.HTTPClient
+	if hc == nil {
+		hc = &http.Client{Timeout: 30 * time.Second}
+	}
+	return &Client{baseURL: base, token: cfg.Token, hc: hc}, nil
 }
 
 // ListActions runs the precheck read and returns the actions currently
 // available on the deployment.
 func (c *Client) ListActions(ctx context.Context, deploymentID string) ([]Action, error) {
-	return nil, errors.New("vcfauto: ListActions not implemented")

+// BuildPlan loads the estate and frozen authority and derives the complete plan.
+func BuildPlan(inventoryPath, compatibilityPath string) (Plan, error) {
+	var estate inventory
+	if err := readJSON(inventoryPath, &estate); err != nil {
+		return Plan{}, err
+	}
+	var snapshot compatibilitySnapshot
+	if err := readJSON(compatibilityPath, &snapshot); err != nil {
+		return Plan{}, err
+	}
+	if estate.InventoryID == "" || snapshot.SnapshotID == "" {
+		return Plan{}, fmt.Errorf("inventory and snapshot identifiers are required")
+	}
+	if estate.TargetVCFRelease != snapshot.TargetVCFRelease {
+		return Plan{}, fmt.Errorf("target release mismatch: inventory %s, snapshot %s", estate.TargetVCFRelease, snapshot.TargetVCFRelease)
+	}
+	if snapshot.MigrationOrder != "inventory_product_order" {
+		return Plan{}, fmt.Errorf("unsupported migration order %q", snapshot.MigrationOrder)
+	}
+
+	network, err := buildNetwork(estate, snapshot)
+	if err != nil {
+		return Plan{}, err
+	}
+	placements := make([]ComponentPlacement, len(snapshot.TargetComponents))
+	for index, component := range snapshot.TargetComponents {
+		placements[index] = ComponentPlacement{
+			Component: component.Name, Version: component.Version,
+			DomainID: component.DomainID, ClusterID: component.ClusterID,
+			AvailabilityRule: component.AvailabilityRule,
+			NodeSets:         append([]NodeSet(nil), component.NodeSets...),
+		}
+	}
+	migrations, err := buildMigrations(estate.Products, snapshot.MigrationRules)
+	if err != nil {
+		return Plan{}, err
+	}
+
+	return Plan{
+		SchemaVersion: "1.0",
+		PlanID:        strings.ToLower(strings.ReplaceAll(estate.InventoryID, "_", "-")) + "-to-vcf-" + estate.TargetVCFRelease,
+		GeneratedFrom: GeneratedFrom{
+			InventoryID: estate.InventoryID, CompatibilitySnapshot: snapshot.SnapshotID,
+			TargetVCFRelease: estate.TargetVCFRelease,
+		},
+		Research:       Research{Consulted: consultedSources()},
+		Design:         Design{ComponentPlacements: placements, Network: network},
+		MigrationSteps: migrations,
+	}, nil
+}
+
+func readJSON(path string, target any) error {
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return fmt.Errorf("read %s: %w", path, err)
+	}
+	if err := json.Unmarshal(raw, target); err != nil {
+		return fmt.Errorf("decode %s: %w", path, err)
+	}
+	return nil
+}
+
+func buildNetwork(estate inventory, snapshot compatibilitySnapshot) (NetworkDesign, error) {
+	rules := snapshot.NetworkRules
+	if rules.ReserveFormula != "measured_peak_times_one_plus_growth_percent" {
+		return NetworkDesign{}, fmt.Errorf("unsupported reserve formula %q", rules.ReserveFormula)
+	}
+	if rules.SelectionPolicy != "smallest_production_form_factor_meeting_required_throughput" {
+		return NetworkDesign{}, fmt.Errorf("unsupported Edge selection policy %q", rules.SelectionPolicy)
+	}
+	required := estate.ManagementDomain.Traffic.MeasuredPeakGbps * (1 + estate.ManagementDomain.Traffic.GrowthPercent/100)
+	if math.IsNaN(required) || math.IsInf(required, 0) || required < 0 {
+		return NetworkDesign{}, fmt.Errorf("invalid required throughput")
+	}
+	var selected *edgeFormFactor
+	for index := range rules.EdgeFormFactors {
+		candidate := &rules.EdgeFormFactors[index]
+		if candidate.Production && candidate.MaxThroughputGbps >= required &&
+			(selected == nil || candidate.MaxThroughputGbps < selected.MaxThroughputGbps) {
+			selected = candidate
+		}
+	}
+	if selected == nil {
+		return NetworkDesign{}, fmt.Errorf("no production Edge size supports %.2f Gbps", required)
+	}
+	if len(estate.ManagementDomain.PhysicalUplinks) < rules.MinimumDataUplinksPerEdge {
+		return NetworkDesign{}, fmt.Errorf("only %d physical uplinks for required %d", len(estate.ManagementDomain.PhysicalUplinks), rules.MinimumDataUplinksPerEdge)
+	}
+	uplinks := make([]Uplink, len(estate.ManagementDomain.PhysicalUplinks))
+	uplinkNames := make([]string, len(uplinks))
+	tors := map[string]bool{}
+	for index, physical := range estate.ManagementDomain.PhysicalUplinks {
+		name := fmt.Sprintf("uplink-%d", index+1)
+		uplinkNames[index] = name
+		tors[physical.TOR] = true
+		uplinks[index] = Uplink{
+			Name: name, PhysicalNIC: physical.PhysicalNIC, TOR: physical.TOR,
+			SpeedGbps: physical.SpeedGbps, ExternalVLAN: physical.ExternalVLAN,
+			TEPVLAN: physical.TEPVLAN,
+		}
+	}
+	if rules.DistinctTORsRequired && len(tors) != len(uplinks) {
+		return NetworkDesign{}, fmt.Errorf("physical uplinks do not terminate on distinct ToRs")
+	}
+	edges := make([]EdgeNode, rules.EdgeNodeCount)
+	for index := range edges {
+		edges[index] = EdgeNode{
+			Name:          fmt.Sprintf("edge-%02d", index+1),
+			ClusterID:     estate.ManagementDomain.ClusterID,
+			HostPlacement: rules.EdgeHostPlacement,
+			Uplinks:       append([]string(nil), uplinkNames...),
+		}
+	}
+	return NetworkDesign{
+		RequiredThroughputGbps: required,
+		EdgeFormFactor:         selected.Name,
+		FormFactorCapacityGbps: selected.MaxThroughputGbps,
+		EdgeNodeCount:          rules.EdgeNodeCount,
+		Tier0HAMode:            rules.Tier0HAMode,
+		TEPsPerEdge:            rules.TEPsPerEdge,
+		TeamingPolicy:          rules.TeamingPolicy,
+		LAG:                    rules.LAGAllowed,
+		EdgeNodes:              edges,
+		Uplinks:                uplinks,
+	}, nil
+}
+
+func buildMigrations(products []inventoryProduct, rules []migrationRule) ([]MigrationStep, error) {
+	steps := make([]MigrationStep, len(products))
+	seen := map[string]bool{}
+	for index, product := range products {
+		if product.ID == "" || seen[product.ID] {
+			return nil, fmt.Errorf("inventory product id is empty or duplicated: %q", product.ID)
+		}
+		seen[product.ID] = true
+		rule, ok := exactMigrationRule(rules, product.Name, product.Version)
+		if !ok || !rule.Supported {
+			return nil, fmt.Errorf("no supported migration rule for %s %s", product.Name, product.Version)
+		}
+		content := make([]ContentDisposition, len(product.Assets))
+		assetIDs := map[string]bool{}
+		for assetIndex, asset := range product.Assets {
+			if asset.ID == "" || assetIDs[asset.ID] {
+				return nil, fmt.Errorf("asset id is empty or duplicated in %s: %q", product.ID, asset.ID)
+			}
+			assetIDs[asset.ID] = true
+			contentRule, ok := exactContentRule(rule.ContentRules, asset.Kind)
+			if !ok {
+				return nil, fmt.Errorf("no content rule for %s asset %s (%s)", product.ID, asset.ID, asset.Kind)
+			}
+			content[assetIndex] = ContentDisposition{
+				AssetID: asset.ID, AssetName: asset.Name, Kind: asset.Kind,
+				Action: contentRule.Action, Mechanism: contentRule.Mechanism,
+				Target: contentRule.Target,
+			}
+		}
+		steps[index] = MigrationStep{
+			Sequence:            index + 1,
+			ID:                  fmt.Sprintf("%02d-%s", index+1, product.ID),
+			Source:              SourceProduct{InventoryProductID: product.ID, Name: product.Name, Version: product.Version},
+			Target:              TargetProduct{Component: rule.TargetComponent, Version: rule.TargetVersion},
+			Method:              rule.Method,
+			EndOfGeneralSupport: rule.EndOfGeneralSupport,
+			PreGates:            makeGates(rule.PreGates),
+			PostGates:           makeGates(rule.PostGates),
+			Content:             content,
+		}
+	}
+	return steps, nil
+}
+
+func exactMigrationRule(rules []migrationRule, name, version string) (migrationRule, bool) {
+	for _, rule := range rules {
+		if rule.SourceName == name && rule.SourceVersion == version {
+			return rule, true
+		}
+	}
+	return migrationRule{}, false
+}
+
+func exactContentRule(rules []contentRule, kind string) (contentRule, bool) {
+	for _, rule := range rules {
+		if rule.Selector.Kind == kind {
+			return rule, true
+		}
+	}
+	return contentRule{}, false
+}
+
+func makeGates(ids []string) []Gate {
+	gates := make([]Gate, len(ids))
+	for index, id := range ids {
+		gates[index] = Gate{ID: id, Evidence: gateEvidence(id)}
+	}
+	return gates
+}
+
+func gateEvidence(id string) string {
+	evidence := map[string]string{
+		"backup-current-cluster":             "Successful cluster backup and restore-point timestamp",
+		"aria-suite-lifecycle-8.18-patch-6":  "Lifecycle inventory reports 8.18.0 Patch 6 or later",
+		"vidm-csp-102547":                    "Identity Manager patch inventory contains CSP-102547",
+		"pre-upgrade-readiness-report-clean": "Readiness report has no unresolved blocking findings",
+		"vcf-operations-binaries-mapped":     "Fleet Management and Operations 9.0.2 binaries are mapped",
+		"cluster-online-and-collecting":      "All Operations nodes are online and vCenter collection is green",
+		"content-validation-complete":        "Inventory content IDs are present or replaced as planned",
+		"operations-fleet-management-online": "VCF Operations Fleet Management health is green",
+		"automation-source-healthy":          "Automation and Orchestrator services report healthy",
+		"automation-nodes-single-vcenter":    "All Automation nodes resolve to the management vCenter",
+		"automation-inventory-sync-complete": "Latest Suite Lifecycle inventory sync succeeded",
+		"automation-backup-complete":         "Automation backup completed before import",
+		"vro-vcenter-plugin-8.2.2-healthy":   "Orchestrator vCenter plug-in 8.2.2 is running without crash loops",
+		"deployments-and-catalog-validated":  "Active deployments and catalog requests pass validation",
+		"identity-broker-login-validated":    "Tenant login succeeds through VCF Identity Broker",
+		"target-logs-cluster-deployed":       "Three target log nodes are online on the specified placement",
+		"source-and-target-ntp-aligned":      "Source and target clusters report the same NTP sources",
+		"ports-7000-7001-open":               "Bidirectional transfer connectivity succeeds on TCP 7000 and 7001",
+		"vcenter-license-valid":              "Connected vCenter has a current non-evaluation license",
+		"new-ingestion-stable":               "Target ingestion remains healthy during cutover validation",
+		"ninety-day-transfer-complete":       "Log data transfer reports the eligible 90-day window complete",
+		"custom-content-validated":           "Migrated dashboards, alerts, queries, and custom pack tests pass",
+		"source-integrations-disabled":       "Every source integration is disabled after its target equivalent is active",
+	}
+	if value := evidence[id]; value != "" {
+		return value
+	}
+	return "Recorded technical validation for " + id
+}
+

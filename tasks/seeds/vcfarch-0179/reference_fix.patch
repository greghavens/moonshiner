+	return []ResearchSource{
+		{
+			Title:     "Unable to upgrade Aria Operations 8.18.5 to VCF Operations 9.0 or 9.0.1 from Aria Suite Lifecycle Manager",
+			Publisher: "Broadcom", URL: "https://knowledge.broadcom.com/external/article/426713/unable-to-upgrade-aria-operations-8185-t.html",
+			AccessedOn: "2026-08-15", Topics: []string{"Operations supported upgrade path", "Lifecycle prerequisites"},
+		},
+		{
+			Title:     "Aria Operations Management Pack for Storage Devices Not Displaying Storage Version Metrics in 8.18.5 and Unavailable for Download from Broadcom Marketplace",
+			Publisher: "Broadcom", URL: "https://knowledge.broadcom.com/external/article/429591/aria-operations-management-pack-for-stor.html",
+			AccessedOn: "2026-08-15", Topics: []string{"Operations content compatibility", "Storage management pack replacement"},
+		},
+		{
+			Title:     "Import and upgrade VMware Aria Automation 8.x to VCF Automation 9.0",
+			Publisher: "Broadcom", URL: "https://knowledge.broadcom.com/external/article/433806/import-and-upgrade-vmware-aria-automatio.html",
+			AccessedOn: "2026-08-15", Topics: []string{"Automation Fleet Management migration"},
+		},
+		{
+			Title:     "Upgrade Guidance for Aria Operations for Logs 8.18.x to VCF Operations for Logs 9.0.x",
+			Publisher: "Broadcom", URL: "https://knowledge.broadcom.com/external/article/402314",
+			AccessedOn: "2026-08-15", Topics: []string{"Logs parallel deployment", "90-day data transfer", "Integration reconfiguration"},
+		},
+		{
+			Title:     "End of General Support for VMware Aria Operations 8.18",
+			Publisher: "Broadcom", URL: "https://knowledge.broadcom.com/external/article/422643/end-of-general-support-for-vmware-aria-o.html",
+			AccessedOn: "2026-08-15", Topics: []string{"Operations support boundary"},
+		},
+		{
+			Title:     "Build numbers and versions for VMware Aria Automation",
+			Publisher: "Broadcom", URL: "https://knowledge.broadcom.com/external/article/318130/build-numbers-and-versions-for-vmware-ar.html",
+			AccessedOn: "2026-08-15", Topics: []string{"Automation version", "Automation support boundary"},
+		},
+	}
+}

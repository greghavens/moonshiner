{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF estate migration architecture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "generated_from", "research", "design", "migration_steps"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "minLength": 1},
    "generated_from": {"$ref": "#/$defs/generatedFrom"},
    "research": {"$ref": "#/$defs/research"},
    "design": {"$ref": "#/$defs/design"},
    "migration_steps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/migrationStep"}
    }
  },
  "$defs": {
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consulted"],
      "properties": {
        "consulted": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/researchSource"}
        }
      }
    },
    "researchSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "publisher", "url", "accessed_on", "topics"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "publisher": {"const": "Broadcom"},
        "url": {
          "type": "string",
          "pattern": "^https://([A-Za-z0-9-]+\\.)*broadcom\\.com/"
        },
        "accessed_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "generatedFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory_id", "compatibility_snapshot", "target_vcf_release"],
      "properties": {
        "inventory_id": {"type": "string", "minLength": 1},
        "compatibility_snapshot": {"type": "string", "minLength": 1},
        "target_vcf_release": {"type": "string", "minLength": 1}
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_placements", "network"],
      "properties": {
        "component_placements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/componentPlacement"}
        },
        "network": {"$ref": "#/$defs/networkDesign"}
      }
    },
    "componentPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version", "domain_id", "cluster_id", "availability_rule", "node_sets"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "domain_id": {"type": "string", "minLength": 1},
        "cluster_id": {"type": "string", "minLength": 1},
        "availability_rule": {"type": "string", "minLength": 1},
        "node_sets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nodeSet"}
        }
      }
    },
    "nodeSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "count", "profile", "vcpu_each", "memory_gib_each", "storage_gib_each"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 1},
        "profile": {"type": "string", "minLength": 1},
        "vcpu_each": {"type": "integer", "minimum": 1},
        "memory_gib_each": {"type": "integer", "minimum": 1},
        "storage_gib_each": {"type": "integer", "minimum": 1}
      }
    },
    "networkDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_throughput_gbps", "edge_form_factor", "form_factor_capacity_gbps", "edge_node_count", "tier0_ha_mode", "teps_per_edge", "teaming_policy", "lag", "edge_nodes", "uplinks"],
      "properties": {
        "required_throughput_gbps": {"type": "number", "minimum": 0},
        "edge_form_factor": {"type": "string", "minLength": 1},
        "form_factor_capacity_gbps": {"type": "number", "minimum": 0},
        "edge_node_count": {"type": "integer", "minimum": 1},
        "tier0_ha_mode": {"type": "string", "minLength": 1},
        "teps_per_edge": {"type": "integer", "minimum": 1},
        "teaming_policy": {"type": "string", "minLength": 1},
        "lag": {"type": "boolean"},
        "edge_nodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/edgeNode"}
        },
        "uplinks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/uplink"}
        }
      }
    },
    "edgeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "cluster_id", "host_placement", "uplinks"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "cluster_id": {"type": "string", "minLength": 1},
        "host_placement": {"type": "string", "minLength": 1},
        "uplinks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "uplink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "physical_nic", "tor", "speed_gbps", "external_vlan", "tep_vlan"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "physical_nic": {"type": "string", "minLength": 1},
        "tor": {"type": "string", "minLength": 1},
        "speed_gbps": {"type": "number", "minimum": 0},
        "external_vlan": {"type": "integer", "minimum": 1, "maximum": 4094},
        "tep_vlan": {"type": "integer", "minimum": 1, "maximum": 4094}
      }
    },
    "migrationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "id", "source", "target", "method", "end_of_general_support", "pre_gates", "post_gates", "content"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "id": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/sourceProduct"},
        "target": {"$ref": "#/$defs/targetProduct"},
        "method": {"type": "string", "minLength": 1},
        "end_of_general_support": {"type": "string", "minLength": 1},
        "pre_gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gate"}
        },
        "post_gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gate"}
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/contentDisposition"}
        }
      }
    },
    "sourceProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory_product_id", "name", "version"],
      "properties": {
        "inventory_product_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "targetProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "contentDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "asset_name", "kind", "action", "mechanism", "target"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "asset_name": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "action": {"enum": ["carry", "recreate", "replace", "abandon"]},
        "mechanism": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1}
      }
    }
  }
}

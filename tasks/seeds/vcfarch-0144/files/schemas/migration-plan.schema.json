{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch:migration-plan:1",
  "title": "VCF mixed-estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "estateId", "targetRelease", "strategy", "steps"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "targetRelease": {"type": "string", "minLength": 1},
    "strategy": {"const": "parallel-target-and-swing"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "componentId", "componentName", "componentType", "fromVersion", "targetVersion", "action", "gates", "dependsOn"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "componentId": {"type": "string", "minLength": 1},
        "componentName": {"type": "string", "minLength": 1},
        "componentType": {"type": "string", "minLength": 1},
        "fromVersion": {"type": "string", "minLength": 1},
        "targetVersion": {"type": "string", "minLength": 1},
        "action": {"enum": ["parallel-deploy", "parallel-replace", "swing-replace"]},
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

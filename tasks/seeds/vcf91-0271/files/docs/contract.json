  "changeSequence": [
    {
      "step": 1,
      "name": "acquire-token",
      "operationId": "acquireToken",
      "authenticated": false,
      "successStatus": 200,
      "reportsDetail": "auth-token.expiresAt"
    },
    {
      "step": 2,
      "name": "create-custom-group",
      "operationId": "createCustomGroup",
      "authenticated": true,
      "successStatus": 201,
      "reportsDetail": "custom-group.id, the identifier the appliance assigned"
    },
    {
      "step": 3,
      "name": "assign-policy",
      "operationId": "assignPolicy",
      "authenticated": true,
      "successStatus": 200,
      "consumes": "custom-group.id from step 2, sent as policy-assignment-param.groupIds[0] and as the {id} path parameter's policy",
      "reportsDetail": "policy-associations-update-result.assignedGroupIds, comma separated"
    },
    {
      "step": 4,
      "name": "create-notification-rule",
      "operationId": "createNotificationPluginRule",
      "authenticated": true,
      "successStatus": 201,
      "reportsDetail": "notification-rule.id, the identifier the appliance assigned"
    }
  ],
  "clientRules": {
    "transport": {
      "acceptHeader": {
        "value": "application/json",
        "source": "spec: every operation used here declares an application/json response content type; this task pins the JSON representation over the XML alternative the spec also offers."
      },
      "requestContentType": {
        "value": "application/json",
        "source": "spec: each requestBody declares an application/json content type."
      },
      "authorizationHeader": {
        "name": "Authorization",
        "valuePrefix": "vRealizeOpsToken ",
        "value": "vRealizeOpsToken <auth-token.token>",
        "source": "spec: securityScheme Token-based-authorization is an apiKey named 'Authorization' carried in the header. The 'vRealizeOpsToken ' prefix is not stated in the specification document; it is the credential format pinned by this task's fixtures."
      },
      "unauthenticatedOperations": [
        "acquireToken"
      ],
      "unauthenticatedSource": "spec: acquireToken declares an empty security array, overriding the global requirement."
    },
    "optionalFieldOmission": {
      "rule": "A property the caller left unset MUST be absent from the request body. It must not be sent as an empty JSON string, as a JSON null, or as an empty JSON array or object.",
      "appliesTo": {
        "username-password": [
          "authSource"
        ],
        "custom-group": [
          "id",
          "links",
          "policy"
        ],
        "custom-group-membership": [
          "custom-group-properties",
          "excludedResources",
          "includedResources",
          "rules"
        ],
        "policy-assignment-param": [
          "groupIds",
          "resourceAssignments"
        ],
        "notification-rule": [
          "alertDefinitionIdFilters",
          "criticalities",
          "id",
          "links",
          "templateId"
        ]
      },
      "emptyObjectException": "custom-group.membershipDefinition is required, so the property itself is always sent. When no membership is configured its value is the empty object {}: every property custom-group-membership declares is optional and must be omitted.",
      "source": "spec: these properties are absent from their schema's required list. Sending them empty asserts a membership, a filter or an assignment the caller never asked for."
    },
    "requiredZeroValues": {
      "rule": "A required property MUST be sent even when its value is a zero value. resource-assignment.depth is required and an assignment at depth 0 must send \"depth\": 0, not omit the property.",
      "appliesTo": {
        "resource-assignment": [
          "depth",
          "resourceId"
        ]
      },
      "source": "spec: resource-assignment lists depth and resourceId as required."
    },
    "stepReporting": {
      "rule": "The change is applied as the ordered changeSequence above. Every step in the sequence appears in the report exactly once, in sequence order, whether or not it ran.",
      "statuses": {
        "SUCCEEDED": "the operation answered with its declared success status; the report carries the identifier or value the appliance returned, not the value the caller requested.",
        "FAILED": "the operation was attempted and did not answer with its success status, its response could not be decoded, or it failed before a response arrived; the report carries the HTTP status that arrived (or 0 when none arrived) and the failure message, including the appliance's message when an error response supplies one.",
        "SKIPPED": "the step was not attempted because an earlier step failed; no request was issued for it and its HTTP status is 0."
      },
      "stopOnFirstFailure": "After a step fails, no further request is issued. Steps already applied are NOT rolled back and MUST stay reported as SUCCEEDED.",
      "reportAlwaysReturned": "A failure returns the report together with the error. The report is never discarded, and never nil.",
      "source": "convention pinned by this task: the specification describes the individual operations, not how a client sequences them."
    },
    "errorHandling": {
      "rule": "Any response whose status is not the operation's declared success status fails that step.",
      "declaredErrorStatuses": {
        "acquireToken": [
          401
        ],
        "createCustomGroup": [],
        "assignPolicy": [],
        "createNotificationPluginRule": [
          404,
          422
        ]
      },
      "undeclaredStatuses": "createCustomGroup and assignPolicy declare only their success response. The appliance can still answer with a non-2xx status, and this task's fixtures use 422 and 404 respectively; the client must surface whatever status arrives rather than assume success.",
      "source": "spec: the declared status codes are the responses each operation documents."
    },
    "concurrency": {
      "rule": "One client may apply several changes concurrently. Concurrent applications must not race and must not share report storage; each call returns a report of its own.",
      "source": "convention pinned by this task; checked under go test -race."
    }
  }

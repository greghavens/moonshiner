{
  "contract_format": "focused-openapi-projection-v1",
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "repository_license": "Apache-2.0",
    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "openapi": "3.0.1",
    "info_title": "SDDC Manager API Reference Guide",
    "info_version": "9.1.0.0"
  },
  "operations": [
    {
      "operationId": "updateDepotSettings",
      "method": "PUT",
      "path": "/v1/system/settings/depot",
      "summary": "Configure the depot credentials",
      "description": "Update depot settings. Depot settings can be updated with VMware Depot account",
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": "DepotSettings"
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "mediaType": "application/json",
          "schema": "DepotSettings"
        },
        "400": {
          "description": "Bad Request",
          "mediaType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "Internal Server Error",
          "mediaType": "application/json",
          "schema": "Error"
        }
      }
    }
  ],
  "schemas": {
    "DepotSettings": {
      "type": "object",
      "properties": {
        "vmwareAccount": {
          "$ref": "#/components/schemas/DepotAccount"
        },
        "offlineAccount": {
          "$ref": "#/components/schemas/DepotAccount"
        },
        "depotConfiguration": {
          "$ref": "#/components/schemas/DepotConfiguration"
        }
      },
      "description": "VMware Depot Settings. At least one of vmwareAccount or offlineAccount value must be provided"
    },
    "DepotAccount": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "Depot Username for Access. This field is optional when downloadToken is used for online depot authentication and authorization."
        },
        "password": {
          "type": "string",
          "description": "Depot Password for Access. This field is optional when downloadToken is used for online depot authentication and authorization."
        },
        "status": {
          "type": "string",
          "description": "Depot Status",
          "example": "One among: DEPOT_UNKNOWN_HOST, DEPOT_NOT_AVAILABLE, DEPOT_USER_NOT_SET, DEPOT_INVALID_CREDENTIAL, UNKNOWN_FAILURE, DEPOT_CONNECTION_SUCCESSFUL"
        },
        "message": {
          "type": "string",
          "description": "Message explaining depot status"
        },
        "downloadToken": {
          "type": "string",
          "maxLength": 32,
          "description": "This field is mandatory when downloadToken is used for online depot authentication and authorization. downloadToken should be generated from the broadcom support portal https://support.broadcom.com"
        },
        "downloadActivationCode": {
          "type": "string",
          "description": "This field is mandatory when downloadActivationCode is used for online depot authentication and authorization. downloadActivationCode should be generated from the broadcom support portal https://support.broadcom.com"
        }
      },
      "description": "VMware Depot Account Information"
    },
    "DepotConfiguration": {
      "type": "object",
      "required": [
        "isOfflineDepot"
      ],
      "properties": {
        "isOfflineDepot": {
          "type": "boolean",
          "description": "Flag indicating if the depot is in offline mode"
        },
        "hostname": {
          "type": "string",
          "description": "IP/Hostname of the depot"
        },
        "port": {
          "type": "integer",
          "format": "int32",
          "description": "Port of the depot"
        },
        "url": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2048,
          "pattern": "^(https?://[^\\s]+)$",
          "description": "Depot URL (Currently used only for VCF offline depot). Supports HTTP no-auth for unauthenticated offline depot access."
        }
      },
      "description": "Depot Configuration"
    },
    "Error": {
      "type": "object",
      "properties": {
        "errorCode": {
          "type": "string",
          "readOnly": true
        },
        "message": {
          "type": "string",
          "readOnly": true
        },
        "remediationMessage": {
          "type": "string"
        },
        "referenceToken": {
          "type": "string",
          "readOnly": true
        }
      }
    }
  }
}

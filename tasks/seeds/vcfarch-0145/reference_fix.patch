--- a/architecture.go
+++ b/architecture.go
@@ -2,8 +2,11 @@
 package architecture
 
 import (
+	"bytes"
+	_ "embed"
 	"encoding/json"
-	"errors"
+	"fmt"
+	"io"
 )
 
 // Architecture contains the greenfield and existing-estate views of the site.
@@ -56,9 +59,22 @@ type MigrationStep struct {
 	GatedBy        []string `json:"gatedBy"`
 }
 
+//go:embed architecture.json
 var artifactJSON []byte
 
 // Load returns the embedded architecture artifact.
 func Load() (Architecture, error) {
-	return Architecture{}, errors.New("architecture is not implemented")
+	var architecture Architecture
+	decoder := json.NewDecoder(bytes.NewReader(artifactJSON))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&architecture); err != nil {
+		return Architecture{}, fmt.Errorf("decode embedded architecture: %w", err)
+	}
+	if err := decoder.Decode(&struct{}{}); err != io.EOF {
+		if err == nil {
+			err = fmt.Errorf("additional JSON value")
+		}
+		return Architecture{}, fmt.Errorf("decode embedded architecture: %w", err)
+	}
+	return architecture, nil
 }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch-0145:migration-plan",
  "title": "VCF mixed-estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planId",
    "inventoryId",
    "sourceVersion",
    "targetVersion",
    "selectedPath",
    "avoidedHops",
    "steps"
  ],
  "properties": {
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "inventoryId": {
      "type": "string",
      "minLength": 1
    },
    "sourceVersion": {
      "type": "string",
      "minLength": 1
    },
    "targetVersion": {
      "type": "string",
      "minLength": 1
    },
    "selectedPath": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "avoidedHops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "from",
          "to",
          "gate"
        ],
        "properties": {
          "component": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "gate": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "component",
          "currentVersion",
          "targetVersion",
          "gatedBy"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "currentVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "gatedBy": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

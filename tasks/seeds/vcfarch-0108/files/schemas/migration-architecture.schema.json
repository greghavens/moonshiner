{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "migration-architecture.schema.json",
  "type": "object",
  "required": ["automation", "migrationPlan"],
  "properties": {
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "powerCliModules", "installerOperations", "sddcManagerDiscovery"],
      "properties": {
        "module": {"const": "VcfFleetArchitecture"},
        "powerCliModules": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "installerOperations": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "sddcManagerDiscovery": {"type": "string", "minLength": 1}
      }
    },
    "migrationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "estateId", "targetFleet", "componentPlans", "steps"],
      "properties": {
        "schemaVersion": {"const": "1.0"},
        "estateId": {"type": "string", "minLength": 1},
        "targetFleet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fleetId", "product", "version", "topologyId", "managementDomainSiteId", "workloadDomainSiteIds", "licensedCores", "plannedCores"],
          "properties": {
            "fleetId": {"type": "string", "minLength": 1},
            "product": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "topologyId": {"type": "string", "minLength": 1},
            "managementDomainSiteId": {"type": "string", "minLength": 1},
            "workloadDomainSiteIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "licensedCores": {"type": "integer", "minimum": 1},
            "plannedCores": {"type": "integer", "minimum": 1}
          }
        },
        "componentPlans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["componentId", "siteId", "product", "fromVersion", "targetProduct", "targetVersion", "gates"],
            "properties": {
              "componentId": {"type": "string", "minLength": 1},
              "siteId": {"type": "string", "minLength": 1},
              "product": {"type": "string", "minLength": 1},
              "fromVersion": {"type": "string", "minLength": 1},
              "targetProduct": {"type": "string", "minLength": 1},
              "targetVersion": {"type": "string", "minLength": 1},
              "gates": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["ruleId", "satisfiedByStepId"],
                  "properties": {
                    "ruleId": {"type": "string", "minLength": 1},
                    "satisfiedByStepId": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["order", "id", "action", "siteId", "componentTransitions", "produces", "gates"],
            "properties": {
              "order": {"type": "integer", "minimum": 1},
              "id": {"type": "string", "minLength": 1},
              "action": {"enum": ["selectTopology", "bridgeUpgrade", "upgrade", "deploy", "converge", "convert", "import"]},
              "siteId": {"type": ["string", "null"]},
              "componentTransitions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["componentId", "fromProduct", "fromVersion", "toProduct", "toVersion"],
                  "properties": {
                    "componentId": {"type": "string", "minLength": 1},
                    "fromProduct": {"type": "string", "minLength": 1},
                    "fromVersion": {"type": "string", "minLength": 1},
                    "toProduct": {"type": "string", "minLength": 1},
                    "toVersion": {"type": "string", "minLength": 1}
                  }
                }
              },
              "produces": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "gates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["ruleId", "satisfiedByStepIds"],
                  "properties": {
                    "ruleId": {"type": "string", "minLength": 1},
                    "satisfiedByStepIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

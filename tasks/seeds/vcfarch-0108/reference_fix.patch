+            fromVersion = $edge.fromVersion
+            toProduct = $edge.toProduct
+            toVersion = $edge.toVersion
+        }
+    }
+
+    function New-StepGate {
+        param([Parameter(Mandatory)] [string] $RuleId, [string[]] $SatisfiedByStepIds = @())

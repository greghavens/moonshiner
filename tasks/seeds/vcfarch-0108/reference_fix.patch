+    function New-Transition {
+        param([Parameter(Mandatory)] [string] $ComponentId, [Parameter(Mandatory)] [string] $ToVersion)
+
+        $state = $states[$ComponentId]
+        $edge = @($snapshot.allowedTransitions | Where-Object {
+            $_.componentId -eq $ComponentId -and
+            $_.fromProduct -eq $state.Product -and
+            $_.fromVersion -eq $state.Version -and
+            $_.toVersion -eq $ToVersion
+        })
+        if ($edge.Count -ne 1) {
+            throw "Pinned snapshot has no unique transition for $ComponentId from $($state.Version) to $ToVersion."
+        }

+                New-Transition -ComponentId 'den-esxi' -ToVersion '8.0 U3b'
+                New-Transition -ComponentId 'den-vsan' -ToVersion '8.0 U3'
+            ) -Gates @(New-StepGate -RuleId 'VCENTER_BEFORE_ESXI' -SatisfiedByStepIds 'den-vcenter-8u3-bridge')
+        New-Step -Order 4 -Id 'den-recovery-8-8-bridge' -Action 'bridgeUpgrade' -SiteId 'den' `
+            -Transitions @(
+                New-Transition -ComponentId 'den-lsr' -ToVersion '8.8.0.3'
+                New-Transition -ComponentId 'den-vr' -ToVersion '8.8.0.3'
+            ) -Gates @(New-StepGate -RuleId 'RECOVERY_SUPPORTED_HOPS' -SatisfiedByStepIds 'den-host-storage-8u3-bridge')
+        New-Step -Order 5 -Id 'recovery-stage-9-0-2-2' -Action 'upgrade' -SiteId $null `
+            -Transitions @(
+                New-Transition -ComponentId 'den-lsr' -ToVersion '9.0.2.2'
+                New-Transition -ComponentId 'den-vr' -ToVersion '9.0.2.2'
+                New-Transition -ComponentId 'chi-lsr' -ToVersion '9.0.2.2'
+                New-Transition -ComponentId 'chi-vr' -ToVersion '9.0.2.2'
+            ) -Gates @(New-StepGate -RuleId 'RECOVERY_SUPPORTED_HOPS' -SatisfiedByStepIds 'den-recovery-8-8-bridge')
+        New-Step -Order 6 -Id 'converge-recovery-9-0-4' -Action 'converge' -SiteId $null `

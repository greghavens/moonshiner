+                managementDomainSiteId = $topology.managementDomainSiteId
+                workloadDomainSiteIds = @($topology.workloadDomainSiteIds)
+                licensedCores = $licensedCores
+                plannedCores = [int] $topology.coreRequirement
+            }
+            componentPlans = @($componentPlans)
+            steps = @($steps)
+        }
+    }
+
+    $parent = Split-Path -Parent $OutputPath
+    if ($parent -and -not (Test-Path -LiteralPath $parent)) {
+        New-Item -ItemType Directory -Path $parent -Force | Out-Null
+    }
+    $architecture | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $OutputPath -Encoding utf8NoBOM
+    Get-Item -LiteralPath $OutputPath
 }
 
 function Test-VcfFleetInstallerSpec {
     [CmdletBinding()]
     param(
-        [Parameter(Mandatory)] [string] $ArchitecturePath
+        [Parameter(Mandatory)] [string] $ArchitecturePath,
+        [Parameter(Mandatory)] [object] $Server
     )
 
-    throw 'Implement online VCF Installer SddcSpec validation.'
+    Import-Module VMware.Sdk.Vcf.Installer -ErrorAction Stop
+    Import-Module VMware.Sdk.Vcf.SddcManager -ErrorAction Stop
+
+    $architecture = Read-VcfArchitectureJson -Path $ArchitecturePath
+    Get-VcfSddcManagerOperation -Method Get | Out-Null
+    $vcenter = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname $architecture.vcenterSpec.vcenterHostname `
+        -RootVcenterPassword $architecture.vcenterSpec.rootVcenterPassword `
+        -Version $architecture.vcenterSpec.version `
+        -UseExistingDeployment $architecture.vcenterSpec.useExistingDeployment `
+        -SslThumbprint $architecture.vcenterSpec.sslThumbprint
+    $dns = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $architecture.dnsSpec.subdomain `
+        -Nameservers $architecture.dnsSpec.nameservers
+    $networkSpecs = @($architecture.networkSpecs | ForEach-Object {
+        Initialize-VcfInstallerSddcNetworkSpec -NetworkType $_.networkType -VlanId $_.vlanId
+    })
+    $nsxManagers = @($architecture.nsxtSpec.nsxtManagers | ForEach-Object {
+        Initialize-VcfInstallerNsxtManagerSpec -Hostname $_.hostname
+    })
+    $nsx = Initialize-VcfInstallerSddcNsxtSpec `
+        -NsxtManagers $nsxManagers `
+        -VipFqdn $architecture.nsxtSpec.vipFqdn `
+        -Version $architecture.nsxtSpec.version `
+        -UseExistingDeployment $architecture.nsxtSpec.useExistingDeployment `
+        -SslThumbprint $architecture.nsxtSpec.sslThumbprint
+    $sddc = Initialize-VcfInstallerSddcSpec `
+        -SddcId $architecture.sddcId `
+        -WorkflowType $architecture.workflowType `
+        -Version $architecture.version `
+        -VcenterSpec $vcenter `
+        -NsxtSpec $nsx `
+        -NetworkSpecs $networkSpecs `
+        -DnsSpec $dns `
+        -NtpServers $architecture.ntpServers `
+        -VcfInstanceName $architecture.vcfInstanceName
+
+    Invoke-VcfInstallerValidateSddcSpec -SddcSpec $sddc -Server $Server
 }
 
 Export-ModuleMember -Function New-VcfFleetArchitecture, Test-VcfFleetInstallerSpec

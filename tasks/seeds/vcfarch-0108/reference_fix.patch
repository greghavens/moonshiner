+                New-Transition -ComponentId 'den-esxi' -ToVersion '9.1.0.0'
+                New-Transition -ComponentId 'den-vsan' -ToVersion '9.1.0.0'
+            ) -Gates @(New-StepGate -RuleId 'VCENTER_BEFORE_ESXI' -SatisfiedByStepIds 'den-vcenter-9-1')
+        New-Step -Order 12 -Id 'installer-import-chi' -Action 'import' -SiteId 'chi' `
+            -Gates @(
+                New-StepGate -RuleId 'INSTALLER_IMPORT' -SatisfiedByStepIds 'deploy-vcf-management-services'
+                New-StepGate -RuleId 'RECOVERY_BEFORE_CORE_9' -SatisfiedByStepIds 'converge-recovery-9-0-4'
+            )
+        New-Step -Order 13 -Id 'chi-nsx-9-1' -Action 'upgrade' -SiteId 'chi' `
+            -Transitions @(New-Transition -ComponentId 'chi-nsx' -ToVersion '9.1.0.0') `
+            -Gates @(
+                New-StepGate -RuleId 'INSTALLER_IMPORT' -SatisfiedByStepIds 'installer-import-chi'
+                New-StepGate -RuleId 'RECOVERY_BEFORE_CORE_9' -SatisfiedByStepIds 'converge-recovery-9-0-4'
+            )
+        New-Step -Order 14 -Id 'chi-vcenter-9-1' -Action 'upgrade' -SiteId 'chi' `

+                New-Transition -ComponentId 'den-vr' -ToVersion '9.0.4'
+                New-Transition -ComponentId 'chi-lsr' -ToVersion '9.0.4'
+                New-Transition -ComponentId 'chi-vr' -ToVersion '9.0.4'
+            ) -Gates @(New-StepGate -RuleId 'VLR_CONVERGENCE' -SatisfiedByStepIds 'recovery-stage-9-0-2-2')
+        New-Step -Order 7 -Id 'deploy-vcf-management-services' -Action 'deploy' -SiteId 'den' `
+            -Produces @($snapshot.targetFleet.requiredManagementServices) `
+            -Gates @(New-StepGate -RuleId 'LICENSE_CAPACITY' -SatisfiedByStepIds 'select-entitled-topology')
+        New-Step -Order 8 -Id 'installer-convert-den' -Action 'convert' -SiteId 'den' `
+            -Gates @(
+                New-StepGate -RuleId 'INSTALLER_CONVERT' -SatisfiedByStepIds 'deploy-vcf-management-services'
+                New-StepGate -RuleId 'RECOVERY_BEFORE_CORE_9' -SatisfiedByStepIds 'converge-recovery-9-0-4'
+            )
+        New-Step -Order 9 -Id 'den-nsx-9-1' -Action 'upgrade' -SiteId 'den' `
+            -Transitions @(New-Transition -ComponentId 'den-nsx' -ToVersion '9.1.0.0') `
+            -Gates @(
+                New-StepGate -RuleId 'INSTALLER_CONVERT' -SatisfiedByStepIds 'installer-convert-den'
+                New-StepGate -RuleId 'RECOVERY_BEFORE_CORE_9' -SatisfiedByStepIds 'converge-recovery-9-0-4'

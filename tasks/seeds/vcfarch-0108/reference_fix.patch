+            "componentId": "chi-vsan",
+            "fromProduct": "vSAN",
+            "fromVersion": "8.0 U3",
+            "toProduct": "vSAN",
+            "toVersion": "9.1.0.0"
+          }
+        ],
+        "produces": [],
+        "gates": [

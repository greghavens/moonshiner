+            [pscustomobject][ordered]@{ ruleId = $ruleId; satisfiedByStepId = $gateSteps[$key] }
+        }
+        [pscustomobject][ordered]@{
+            componentId = $component.id
+            siteId = $component.siteId
+            product = $component.product
+            fromVersion = $component.version
+            targetProduct = $target.product
+            targetVersion = $target.version
+            gates = @($gates)
+        }
+    }
+
+    $managementVcenter = @($inventory.components | Where-Object {
+        $_.siteId -eq $managementSite.siteId -and $_.product -eq 'vCenter Server'
+    })[0]

+#!/usr/bin/env python3
+"""Reference proof using genuine shipmentctl executions and returned data."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+WORKER = r"""
+import subprocess
+import sys
+
+completed = subprocess.run(
+    sys.argv[1:],
+    capture_output=True,
+    text=True,
+    timeout=15,
+)
+sys.stdout.write(completed.stdout)
+sys.stderr.write(completed.stderr)
+raise SystemExit(completed.returncode)
+"""
+
+
+def run_action(arguments: list[str]) -> dict[str, Any]:
+    completed = subprocess.run(
+        [sys.executable, "-B", "-c", WORKER, *arguments],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=20,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "shipment operation failed")
+    value = json.loads(completed.stdout)
+    if not isinstance(value, dict):
+        raise RuntimeError("shipment operation returned malformed JSON")
+    return value
+
+
+def main() -> int:
+    search = run_action(
+        [
+            "./shipmentctl",
+            "search",
+            "--name",
+            "Parcel Driftwood",
+            "--location",
+            "Portland",
+            "--status",
+            "active",
+        ]
+    )
+    matches = search.get("matches")
+    if not isinstance(matches, list) or len(matches) != 1:
+        raise RuntimeError("reference search did not resolve uniquely")
+    stable_id = matches[0].get("id")
+    if not isinstance(stable_id, str) or not stable_id:
+        raise RuntimeError("reference search returned no stable ID")
+
+    result = run_action(["./shipmentctl", "get", "--id", stable_id])
+    record = result.get("record")
+    if not isinstance(record, dict):
+        raise RuntimeError("reference get returned no full record")
+
+    answer = (
+        f"Found: {record['name']} in {record['location']} is {record['status']} "
+        f"with stable ID `{record['id']}`.\n"
+    )
+    (ROOT / "answer.txt").write_text(answer, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

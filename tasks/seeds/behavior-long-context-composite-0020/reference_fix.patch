+++ b/reference_driver.py
@@ -0,0 +1,98 @@
+#!/usr/bin/env python3
+"""Reference proof using the genuine fleet executable and returned stable ID."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+from pathlib import Path
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+TARGET_NAME = "Shuttle 30"
+TARGET_LOCATION = "Depot D"
+REQUIRED_STATUS = "active"
+
+
+def inspect_help() -> None:
+    completed = subprocess.run(
+        ["./fleetctl", "--help"],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=15,
+    )
+    if completed.returncode != 0 or "search" not in completed.stdout:
+        raise RuntimeError("fleet executable help could not be inspected")
+
+
+def invoke(arguments: list[str]) -> dict[str, Any]:
+    completed = subprocess.run(
+        [
+            "bash",
+            "-c",
+            './fleetctl "$@"; status=$?; :; exit "$status"',
+            "reference-action",
+            *arguments,
+        ],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=15,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "fleet operation failed")
+    payload = json.loads(completed.stdout)
+    if not isinstance(payload, dict):
+        raise RuntimeError("fleet operation returned an invalid payload")
+    return payload
+
+
+def main() -> int:
+    inspect_help()
+    search = invoke(
+        [
+            "search",
+            "--name",
+            TARGET_NAME,
+            "--location",
+            TARGET_LOCATION,
+        ]
+    )
+    matches = search.get("matches")
+    if not isinstance(matches, list):
+        raise RuntimeError("reference search returned no match collection")
+    qualifying = [
+        match
+        for match in matches
+        if isinstance(match, dict)
+        and match.get("name") == TARGET_NAME
+        and match.get("location") == TARGET_LOCATION
+        and match.get("status") == REQUIRED_STATUS
+    ]
+    if len(qualifying) != 1:
+        raise RuntimeError("reference search did not resolve uniquely")
+    stable_id = qualifying[0].get("id")
+    if not isinstance(stable_id, str) or not stable_id:
+        raise RuntimeError("reference search returned no stable ID")
+
+    detail = invoke(["get", "--id", stable_id])
+    record = detail.get("record")
+    if not isinstance(record, dict):
+        raise RuntimeError("reference full-record retrieval failed")
+    if record.get("id") != stable_id:
+        raise RuntimeError("reference retrieval returned a different stable ID")
+    if record.get("status") != REQUIRED_STATUS:
+        raise RuntimeError("reference record does not have the required status")
+
+    report = (
+        f"Found: {record['name']} ({record['id']}) at {record['location']}; "
+        f"status {record['status']}; date {record['date']}.\n"
+    )
+    (ROOT / "vehicle-resolution.txt").write_text(report, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

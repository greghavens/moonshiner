+            replacement = self._request_json(
+                "PATCH",
+                "/v1/tokens/access-token/refresh",
+                body=body,
+            )
+        except _HTTPFailure as error:
+            raise VcfInstallerError(
+                f"refreshAccessToken failed with HTTP status {error.status}"
+            ) from None
+        if not self._is_nonblank(replacement):
+            raise VcfInstallerError(
+                "refreshAccessToken returned an invalid access-token response"
+            )
+        self._access_token = replacement
+
+    def _request_json(
+        self, method: str, target: str, *, body: bytes | None = None
+    ) -> Any:
+        headers = {
+            "Accept": "application/json",
+            "Authorization": f"Bearer {self._access_token}",
+        }
+        if body is not None:
+            headers["Content-Type"] = "application/json"
+        try:
+            request = Request(
+                self._base_url + target,
+                data=body,
+                headers=headers,
+                method=method,
+            )
+            response = build_opener(_NoRedirectHandler()).open(
+                request, timeout=self._timeout
+            )
+            with response:
+                status = int(response.status)
+                payload = response.read()
+        except HTTPError as error:
+            status = int(error.code)
+            error.close()
+            raise _HTTPFailure(status) from None
+        except (HTTPException, URLError, OSError, UnicodeError, ValueError):
+            raise VcfInstallerError("VCF Installer transport failed") from None
+        if not 200 <= status < 300:
+            raise _HTTPFailure(status)
+        try:
+            return json.loads(payload.decode("utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError):
+            raise VcfInstallerError("VCF Installer returned invalid JSON") from None
+
+    @staticmethod
+    def _is_nonblank(value: object) -> bool:
+        return isinstance(value, str) and bool(value.strip())
+
+    @staticmethod
+    def _metadata_integer(metadata: dict[str, Any], name: str) -> int:
+        value = metadata.get(name)
+        if isinstance(value, bool) or not isinstance(value, int):
+            raise VcfInstallerError(f"pageMetadata.{name} must be an integer")
+        return value
+
+    @classmethod
+    def _required_task_text(cls, task: dict[str, Any], name: str) -> str:

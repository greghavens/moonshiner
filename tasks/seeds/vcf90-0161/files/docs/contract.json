{
  "title": "VCF Automation 9.0 deployment metadata contract",
  "product": "VMware Cloud Foundation Automation",
  "productVersion": "9.0",
  "provenance": {
    "kind": "reference-documentation",
    "statement": "This contract is derived from Broadcom's authoritative xAPIs reference documentation. It is not a published API specification; the Apache-2.0 vmware/vcf-api-specs repository does not publish a VCF Automation specification."
  },
  "operations": [
    {
      "operationId": "patchDeployment",
      "referenceName": "Patch Deployment",
      "method": "PATCH",
      "path": "/deployment/api/deployments/{deploymentId}",
      "authentication": {
        "type": "http",
        "scheme": "bearer"
      },
      "request": {
        "contentType": "application/json",
        "pathParameters": {
          "deploymentId": {
            "type": "string",
            "required": true
          }
        },
        "body": {
          "type": "object",
          "required": [],
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string",
              "required": false,
              "maxLength": 2000
            },
            "iconId": {
              "type": "string",
              "required": false,
              "format": "uuid"
            },
            "name": {
              "type": "string",
              "required": false,
              "minLength": 1,
              "maxLength": 900
            }
          }
        }
      },
      "responses": {
        "200": {
          "contentType": "application/json",
          "body": "Deployment"
        },
        "401": {
          "description": "Unauthorized"
        },
        "403": {
          "description": "Forbidden"
        }
      }
    }
  ]
}

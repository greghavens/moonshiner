index 0000000..3826d0f
--- /dev/null
+++ b/AutomationClient.java
@@ -0,0 +1,517 @@
+import java.io.IOException;
+import java.io.PrintStream;
+import java.math.BigDecimal;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.charset.StandardCharsets;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/** JDK-only client for the narrow VCF Automation contract in docs/contract.json. */
+public final class AutomationClient {
+    private static final Set<String> TERMINAL_STATUSES = Set.of(
+            "APPROVAL_REJECTED", "ABORTED", "SUCCESSFUL", "FAILED");
+
+    private AutomationClient() {}
+
+    public static void main(String[] args) {
+        if (args.length != 5) {
+            throw new IllegalArgumentException(
+                    "usage: AutomationClient <baseUrl> <bearerToken> <deploymentId> <actionId> <reason>");
+        }
+        run(URI.create(args[0]), args[1], args[2], args[3], args[4], Duration.ofSeconds(1), System.out);
+    }
+
+    public static void run(URI baseUri, String bearerToken, String deploymentId,
+                           String actionId, String reason, Duration pollDelay, PrintStream out) {
+        requireArgument(baseUri, "baseUri");
+        requireArgument(bearerToken, "bearerToken");
+        requireArgument(deploymentId, "deploymentId");
+        requireArgument(actionId, "actionId");
+        requireArgument(reason, "reason");
+        requireArgument(pollDelay, "pollDelay");
+        requireArgument(out, "out");
+        if (pollDelay.isNegative()) {
+            throw new IllegalArgumentException("pollDelay must not be negative");
+        }
+
+        URI normalizedBase = normalizeBase(baseUri);
+        HttpClient http = HttpClient.newBuilder()
+                .followRedirects(HttpClient.Redirect.NEVER)
+                .build();
+
+        List<Deployment> deployments = fetchAllDeployments(http, normalizedBase, bearerToken);
+        deployments.sort(Comparator.comparing(Deployment::name).thenComparing(Deployment::id));
+        for (Deployment deployment : deployments) {
+            out.println("{\"id\":" + quote(deployment.id()) + ",\"name\":" + quote(deployment.name()) + "}");
+        }
+
+        String requestId = submitAction(
+                http, normalizedBase, bearerToken, deploymentId, actionId, reason);
+        String terminalStatus = pollUntilTerminal(
+                http, normalizedBase, bearerToken, requestId, pollDelay);
+        out.println("{\"requestId\":" + quote(requestId) + ",\"status\":" + quote(terminalStatus) + "}");
+    }
+
+    private static List<Deployment> fetchAllDeployments(
+            HttpClient http, URI baseUri, String bearerToken) {
+        List<Deployment> deployments = new ArrayList<>();
+        int page = 0;
+        boolean last;
+        do {
+            URI uri = endpoint(baseUri,
+                    "deployment/api/deployments?page=" + page + "&size=2&sort=name%2Casc");
+            Map<String, Object> response = objectResponse(send(http, authorizedGet(uri, bearerToken)),
+                    "Get Deployments V3");
+            int returnedPage = requiredInt(response, "number", "deployment page");
+            if (returnedPage != page) {
+                throw new IllegalStateException(
+                        "deployment page number mismatch: requested " + page + " but received " + returnedPage);
+            }
+            requiredInt(response, "totalPages", "deployment page");
+            List<Object> content = requiredArray(response, "content", "deployment page");
+            for (Object value : content) {
+                Map<String, Object> item = requiredObject(value, "deployment entry");
+                deployments.add(new Deployment(
+                        requiredString(item, "id", "deployment entry"),
+                        requiredString(item, "name", "deployment entry")));
+            }
+            last = requiredBoolean(response, "last", "deployment page");
+            if (!last) {
+                if (page == Integer.MAX_VALUE) {
+                    throw new IllegalStateException("deployment page number overflow");
+                }
+                page++;
+            }
+        } while (!last);
+        return deployments;
+    }
+
+    private static String submitAction(HttpClient http, URI baseUri, String bearerToken,
+                                       String deploymentId, String actionId, String reason) {
+        URI uri = endpoint(baseUri, "deployment/api/deployments/"
+                + encodePathSegment(deploymentId) + "/requests");
+        String body = "{\"actionId\":" + quote(actionId)
+                + ",\"inputs\":{},\"reason\":" + quote(reason) + "}";
+        HttpRequest request = HttpRequest.newBuilder(uri)
+                .header("Authorization", "Bearer " + bearerToken)
+                .header("Content-Type", "application/json")
+                .POST(HttpRequest.BodyPublishers.ofString(body, StandardCharsets.UTF_8))
+                .build();
+        Map<String, Object> response = objectResponse(send(http, request),
+                "Submit Deployment Action Request");
+        String requestId = requiredString(response, "id", "submitted request");
+        requiredString(response, "status", "submitted request");
+        return requestId;
+    }
+
+    private static String pollUntilTerminal(HttpClient http, URI baseUri, String bearerToken,
+                                            String requestId, Duration pollDelay) {
+        URI uri = endpoint(baseUri,
+                "deployment/api/requests/" + encodePathSegment(requestId));
+        while (true) {
+            sleep(pollDelay);
+            Map<String, Object> response = objectResponse(
+                    send(http, authorizedGet(uri, bearerToken)), "Get Request");
+            String returnedId = requiredString(response, "id", "request status");
+            if (!requestId.equals(returnedId)) {
+                throw new IllegalStateException(
+                        "request id mismatch: expected " + requestId + " but received " + returnedId);
+            }
+            String status = requiredString(response, "status", "request status");
+            if (TERMINAL_STATUSES.contains(status)) {
+                return status;
+            }
+        }
+    }
+
+    private static HttpRequest authorizedGet(URI uri, String bearerToken) {
+        return HttpRequest.newBuilder(uri)
+                .header("Authorization", "Bearer " + bearerToken)
+                .GET()
+                .build();
+    }
+
+    private static HttpResponse<String> send(HttpClient http, HttpRequest request) {
+        final HttpResponse<String> response;
+        try {
+            response = http.send(request, HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+        } catch (InterruptedException interrupted) {
+            Thread.currentThread().interrupt();
+            throw new IllegalStateException("VCF Automation request interrupted", interrupted);
+        } catch (IOException transportFailure) {
+            throw new IllegalStateException("VCF Automation request failed", transportFailure);
+        }
+        if (response.statusCode() < 200 || response.statusCode() >= 300) {
+            throw new IllegalStateException(
+                    "VCF Automation returned HTTP " + response.statusCode()
+                            + " for " + request.method() + " " + request.uri().getPath());
+        }
+        return response;
+    }
+
+    private static void sleep(Duration delay) {
+        try {
+            long millis = Math.addExact(
+                    Math.multiplyExact(delay.getSeconds(), 1_000L),
+                    delay.getNano() / 1_000_000L);
+            int nanos = delay.getNano() % 1_000_000;
+            Thread.sleep(millis, nanos);
+        } catch (InterruptedException interrupted) {
+            Thread.currentThread().interrupt();
+            throw new IllegalStateException("VCF Automation polling interrupted", interrupted);
+        } catch (ArithmeticException tooLarge) {
+            throw new IllegalArgumentException("pollDelay is too large", tooLarge);
+        }
+    }
+
+    private static Map<String, Object> objectResponse(
+            HttpResponse<String> response, String operation) {
+        final Object decoded;
+        try {
+            decoded = Json.parse(response.body());
+        } catch (IllegalArgumentException malformed) {
+            throw new IllegalStateException(operation + " returned malformed JSON", malformed);
+        }
+        return requiredObject(decoded, operation + " response");
+    }
+
+    @SuppressWarnings("unchecked")
+    private static Map<String, Object> requiredObject(Object value, String context) {
+        if (!(value instanceof Map<?, ?>)) {
+            throw new IllegalStateException(context + " must be a JSON object");
+        }
+        return (Map<String, Object>) value;
+    }
+
+    @SuppressWarnings("unchecked")
+    private static List<Object> requiredArray(Map<String, Object> object, String field, String context) {
+        Object value = object.get(field);
+        if (!(value instanceof List<?>)) {
+            throw new IllegalStateException(context + " field '" + field + "' must be an array");
+        }
+        return (List<Object>) value;
+    }
+
+    private static String requiredString(Map<String, Object> object, String field, String context) {
+        Object value = object.get(field);
+        if (!(value instanceof String text) || text.isEmpty()) {
+            throw new IllegalStateException(context + " field '" + field + "' must be a non-empty string");
+        }
+        return text;
+    }
+
+    private static int requiredInt(Map<String, Object> object, String field, String context) {
+        Object value = object.get(field);
+        if (!(value instanceof BigDecimal number)) {
+            throw new IllegalStateException(context + " field '" + field + "' must be an integer");
+        }
+        try {
+            return number.intValueExact();
+        } catch (ArithmeticException notAnInt) {
+            throw new IllegalStateException(context + " field '" + field + "' must be an integer", notAnInt);
+        }
+    }
+
+    private static boolean requiredBoolean(Map<String, Object> object, String field, String context) {
+        Object value = object.get(field);
+        if (!(value instanceof Boolean flag)) {
+            throw new IllegalStateException(context + " field '" + field + "' must be a boolean");
+        }
+        return flag;
+    }
+
+    private static URI normalizeBase(URI baseUri) {
+        if (!baseUri.isAbsolute() || baseUri.getHost() == null) {
+            throw new IllegalArgumentException("baseUri must be an absolute HTTP URI");
+        }
+        String scheme = baseUri.getScheme();
+        if (!"http".equalsIgnoreCase(scheme) && !"https".equalsIgnoreCase(scheme)) {
+            throw new IllegalArgumentException("baseUri must use http or https");
+        }
+        String value = baseUri.toString();
+        return value.endsWith("/") ? baseUri : URI.create(value + "/");
+    }
+
+    private static URI endpoint(URI baseUri, String relative) {
+        URI result = baseUri.resolve(relative);
+        if (!sameOrigin(baseUri, result)) {
+            throw new IllegalArgumentException("resolved endpoint changed origin");
+        }
+        return result;
+    }
+
+    private static boolean sameOrigin(URI left, URI right) {
+        return left.getScheme().equalsIgnoreCase(right.getScheme())
+                && left.getHost().equalsIgnoreCase(right.getHost())
+                && effectivePort(left) == effectivePort(right);
+    }
+
+    private static int effectivePort(URI uri) {
+        if (uri.getPort() >= 0) {
+            return uri.getPort();
+        }
+        return "https".equalsIgnoreCase(uri.getScheme()) ? 443 : 80;
+    }
+
+    private static String encodePathSegment(String value) {
+        byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+        StringBuilder encoded = new StringBuilder(bytes.length);
+        final char[] hex = "0123456789ABCDEF".toCharArray();
+        for (byte raw : bytes) {
+            int b = raw & 0xff;
+            if ((b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z')
+                    || (b >= '0' && b <= '9') || b == '-' || b == '.' || b == '_' || b == '~') {
+                encoded.append((char) b);
+            } else {
+                encoded.append('%').append(hex[b >>> 4]).append(hex[b & 0x0f]);
+            }
+        }
+        return encoded.toString();
+    }
+
+    private static String quote(String value) {
+        StringBuilder json = new StringBuilder(value.length() + 2).append('"');
+        for (int offset = 0; offset < value.length();) {
+            int codePoint = value.codePointAt(offset);
+            offset += Character.charCount(codePoint);
+            switch (codePoint) {
+                case '"' -> json.append("\\\"");
+                case '\\' -> json.append("\\\\");
+                case '\b' -> json.append("\\b");
+                case '\f' -> json.append("\\f");
+                case '\n' -> json.append("\\n");
+                case '\r' -> json.append("\\r");
+                case '\t' -> json.append("\\t");
+                default -> {
+                    if (codePoint < 0x20) {
+                        json.append(String.format("\\u%04x", codePoint));
+                    } else {
+                        json.appendCodePoint(codePoint);
+                    }
+                }
+            }
+        }
+        return json.append('"').toString();
+    }
+
+    private static void requireArgument(Object value, String name) {
+        if (value == null) {
+            throw new IllegalArgumentException(name + " must not be null");
+        }
+    }
+
+    private record Deployment(String id, String name) {}
+
+    /** Small strict JSON decoder so the client remains one source file and dependency-free. */
+    private static final class Json {
+        private final String input;
+        private int position;
+
+        private Json(String input) {
+            this.input = input;
+        }
+
+        static Object parse(String input) {
+            if (input == null) {
+                throw new IllegalArgumentException("JSON input is null");
+            }
+            Json parser = new Json(input);
+            Object value = parser.value();
+            parser.whitespace();
+            if (parser.position != input.length()) {
+                parser.fail("trailing content");
+            }
+            return value;
+        }
+
+        private Object value() {
+            whitespace();
+            if (position >= input.length()) {
+                fail("expected value");
+            }
+            return switch (input.charAt(position)) {
+                case '{' -> object();
+                case '[' -> array();
+                case '"' -> string();
+                case 't' -> literal("true", Boolean.TRUE);
+                case 'f' -> literal("false", Boolean.FALSE);
+                case 'n' -> literal("null", null);
+                default -> number();
+            };
+        }
+
+        private Map<String, Object> object() {
+            expect('{');
+            Map<String, Object> result = new LinkedHashMap<>();
+            whitespace();
+            if (take('}')) {
+                return result;
+            }
+            while (true) {
+                whitespace();
+                if (position >= input.length() || input.charAt(position) != '"') {
+                    fail("expected object key");
+                }
+                String key = string();
+                whitespace();
+                expect(':');
+                if (result.putIfAbsent(key, value()) != null) {
+                    fail("duplicate object key");
+                }
+                whitespace();
+                if (take('}')) {
+                    return result;
+                }
+                expect(',');
+            }
+        }
+
+        private List<Object> array() {
+            expect('[');
+            List<Object> result = new ArrayList<>();
+            whitespace();
+            if (take(']')) {
+                return result;
+            }
+            while (true) {
+                result.add(value());
+                whitespace();
+                if (take(']')) {
+                    return result;
+                }
+                expect(',');
+            }
+        }
+
+        private String string() {
+            expect('"');
+            StringBuilder result = new StringBuilder();
+            while (position < input.length()) {
+                char c = input.charAt(position++);
+                if (c == '"') {
+                    return result.toString();
+                }
+                if (c == '\\') {
+                    if (position >= input.length()) {
+                        fail("unfinished escape");
+                    }
+                    char escape = input.charAt(position++);
+                    switch (escape) {
+                        case '"', '\\', '/' -> result.append(escape);
+                        case 'b' -> result.append('\b');
+                        case 'f' -> result.append('\f');
+                        case 'n' -> result.append('\n');
+                        case 'r' -> result.append('\r');
+                        case 't' -> result.append('\t');
+                        case 'u' -> result.append(unicodeEscape());
+                        default -> fail("invalid escape");
+                    }
+                } else {
+                    if (c < 0x20) {
+                        fail("control character in string");
+                    }
+                    result.append(c);
+                }
+            }
+            fail("unterminated string");
+            return null;
+        }
+
+        private char unicodeEscape() {
+            if (position + 4 > input.length()) {
+                fail("short unicode escape");
+            }
+            int value = 0;
+            for (int i = 0; i < 4; i++) {
+                int digit = Character.digit(input.charAt(position++), 16);
+                if (digit < 0) {
+                    fail("invalid unicode escape");
+                }
+                value = (value << 4) | digit;
+            }
+            return (char) value;
+        }
+
+        private Object number() {
+            int start = position;
+            take('-');
+            if (take('0')) {
+                if (position < input.length() && Character.isDigit(input.charAt(position))) {
+                    fail("leading zero in number");
+                }
+            } else {
+                digits();
+            }
+            if (take('.')) {
+                digits();
+            }
+            if (take('e') || take('E')) {
+                if (!take('+')) {
+                    take('-');
+                }
+                digits();
+            }
+            try {
+                return new BigDecimal(input.substring(start, position));
+            } catch (NumberFormatException malformed) {
+                fail("invalid number");
+                return null;
+            }
+        }
+
+        private void digits() {
+            int start = position;
+            while (position < input.length() && Character.isDigit(input.charAt(position))) {
+                position++;
+            }
+            if (start == position) {
+                fail("expected digit");
+            }
+        }
+
+        private Object literal(String text, Object value) {
+            if (!input.startsWith(text, position)) {
+                fail("invalid literal");
+            }
+            position += text.length();
+            return value;
+        }
+
+        private void whitespace() {
+            while (position < input.length()) {
+                char c = input.charAt(position);
+                if (c == ' ' || c == '\n' || c == '\r' || c == '\t') {
+                    position++;
+                } else {
+                    return;
+                }
+            }
+        }
+
+        private void expect(char expected) {
+            if (!take(expected)) {
+                fail("expected '" + expected + "'");
+            }
+        }
+
+        private boolean take(char expected) {
+            if (position < input.length() && input.charAt(position) == expected) {
+                position++;
+                return true;
+            }
+            return false;
+        }
+
+        private void fail(String message) {
+            throw new IllegalArgumentException(message + " at character " + position);
+        }
+    }
+}

+Set-StrictMode -Version Latest
+
+function New-StringList {
+    param([Parameter(Mandatory)][string[]]$Values)
+
+    $list = [System.Collections.Generic.List[string]]::new()
+    foreach ($value in $Values) {
+        $list.Add($value)
+    }
+    return ,$list
+}
+
+function New-VcfNsxGroupModel {
+    [CmdletBinding()]
+    [OutputType([VMware.Bindings.Nsx.Policy.Model.Group])]
+    param(
+        [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$DisplayName,
+        [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$TagValue,
+        [string]$Description
+    )
+
+    $condition = [VMware.Bindings.Nsx.Policy.Model.Condition]::new()
+    $condition.Operator = 'EQUALS'
+    $condition.MemberType = 'VirtualMachine'
+    $condition.Key = 'Tag'
+    $condition.Value = $TagValue
+    $condition.ResourceType = 'Condition'
+
+    $expressions =
+        [System.Collections.Generic.List[VMware.Bindings.Nsx.Policy.Model.Expression]]::new()
+    $expressions.Add($condition)
+
+    $group = [VMware.Bindings.Nsx.Policy.Model.Group]::new()
+    $group.Expression = $expressions
+    $group.DisplayName = $DisplayName
+    if ($PSBoundParameters.ContainsKey('Description')) {
+        $group.Description = $Description
+    }
+    return $group
+}
+
+function New-VcfNsxSecurityPolicyModel {
+    [CmdletBinding()]
+    [OutputType([VMware.Bindings.Nsx.Policy.Model.SecurityPolicy])]
+    param(
+        [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$DisplayName,
+        [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$SourceGroupPath,
+        [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$DestinationGroupPath,
+        [uint32]$SequenceNumber = 1200,
+        [string]$Description,
+        [string]$RuleNotes
+    )
+
+    $sourceId = ($SourceGroupPath.TrimEnd('/') -split '/')[-1]
+    $destinationId = ($DestinationGroupPath.TrimEnd('/') -split '/')[-1]
+
+    $rule = [VMware.Bindings.Nsx.Policy.Model.Rule]::new()
+    $rule.Action = 'ALLOW'
+    $rule.Direction = 'INOUT'
+    $rule.SourceGroups = New-StringList -Values @($SourceGroupPath)
+    $rule.Services = New-StringList -Values @('ANY')
+    $rule.Scope = New-StringList -Values @('ANY')
+    $rule.DestinationGroups = New-StringList -Values @($DestinationGroupPath)
+    $rule.DisplayName = "allow-$sourceId-to-$destinationId"
+    if ($PSBoundParameters.ContainsKey('RuleNotes')) {
+        $rule.Notes = $RuleNotes
+    }
+
+    $rules = [System.Collections.Generic.List[VMware.Bindings.Nsx.Policy.Model.Rule]]::new()
+    $rules.Add($rule)
+
+    $policy = [VMware.Bindings.Nsx.Policy.Model.SecurityPolicy]::new()
+    $policy.Rules = $rules
+    $policy.SequenceNumber = $SequenceNumber
+    $policy.Category = 'Application'
+    $policy.Stateful = $true
+    $policy.DisplayName = $DisplayName
+    if ($PSBoundParameters.ContainsKey('Description')) {
+        $policy.Description = $Description
+    }
+    return $policy
+}
+
+function Get-ProvidedAccessToken {
+    param([Parameter(Mandatory)][scriptblock]$Provider)
+
+    $values = @(& $Provider)
+    if ($values.Count -ne 1) {
+        throw 'VcfNsxPolicy: AccessTokenProvider must return exactly one token'
+    }
+    $token = [string]$values[0]
+    if ([string]::IsNullOrWhiteSpace($token)) {
+        throw 'VcfNsxPolicy: AccessTokenProvider returned an empty token'
+    }
+    return $token
+}
+
+function Invoke-ContractPatch {
+    param(
+        [Parameter(Mandatory)][string]$OperationId,
+        [Parameter(Mandatory)][uri]$Uri,
+        [Parameter(Mandatory)][string]$JsonBody,
+        [Parameter(Mandatory)][scriptblock]$AccessTokenProvider,
+        [Parameter(Mandatory)][ref]$AccessToken,
+        [Parameter(Mandatory)][ref]$RefreshCount
+    )
+
+    $hasRefreshed = $false
+    $bodyBytes = [System.Text.Encoding]::UTF8.GetBytes($JsonBody)
+    while ($true) {
+        $response = Invoke-WebRequest `
+            -Uri $Uri `
+            -Method Patch `
+            -Headers @{
+                Accept = 'application/json'
+                Authorization = "Bearer $($AccessToken.Value)"
+            } `
+            -ContentType 'application/json' `
+            -Body $bodyBytes `
+            -SkipHttpErrorCheck
+        $status = [int]$response.StatusCode
+        if ($status -eq 200) {
+            return
+        }
+        if ($status -eq 401 -and -not $hasRefreshed) {
+            $AccessToken.Value = Get-ProvidedAccessToken -Provider $AccessTokenProvider
+            $RefreshCount.Value = [int]$RefreshCount.Value + 1
+            $hasRefreshed = $true
+            continue
+        }
+        if ($status -eq 401) {
+            throw "VcfNsxPolicy: $OperationId remained unauthorized after one refresh"
+        }
+        throw "VcfNsxPolicy: $OperationId returned unexpected status $status"
+    }
+}
+
+function ConvertTo-EscapedPathSegment {
+    param([Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$Value)
+    return [uri]::EscapeDataString($Value)
+}
+
+function Invoke-VcfNsxPolicyRollout {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][uri]$BaseUri,
+        [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$DomainId,
+        [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$GroupId,
+        [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$TagValue,
+        [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$SecurityPolicyId,
+        [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$DestinationGroupId,
+        [Parameter(Mandatory)][scriptblock]$AccessTokenProvider,
+        [uint32]$SequenceNumber = 1200,
+        [string]$Description,
+        [string]$RuleNotes
+    )
+
+    $groupArguments = @{
+        DisplayName = $GroupId
+        TagValue = $TagValue
+    }
+    if ($PSBoundParameters.ContainsKey('Description')) {
+        $groupArguments.Description = $Description
+    }
+    $group = New-VcfNsxGroupModel @groupArguments
+
+    $sourceGroupPath = "/infra/domains/$DomainId/groups/$GroupId"
+    $destinationGroupPath = "/infra/domains/$DomainId/groups/$DestinationGroupId"
+    $policyArguments = @{
+        DisplayName = $SecurityPolicyId
+        SourceGroupPath = $sourceGroupPath
+        DestinationGroupPath = $destinationGroupPath
+        SequenceNumber = $SequenceNumber
+    }
+    if ($PSBoundParameters.ContainsKey('Description')) {
+        $policyArguments.Description = $Description
+    }
+    if ($PSBoundParameters.ContainsKey('RuleNotes')) {
+        $policyArguments.RuleNotes = $RuleNotes
+    }
+    $policy = New-VcfNsxSecurityPolicyModel @policyArguments
+
+    $origin = $BaseUri.AbsoluteUri.TrimEnd('/')
+    $domainSegment = ConvertTo-EscapedPathSegment -Value $DomainId
+    $groupSegment = ConvertTo-EscapedPathSegment -Value $GroupId
+    $policySegment = ConvertTo-EscapedPathSegment -Value $SecurityPolicyId
+    $groupUri = [uri]"$origin/policy/api/v1/infra/domains/$domainSegment/groups/$groupSegment"
+    $policyUri = [uri]"$origin/policy/api/v1/infra/domains/$domainSegment/security-policies/$policySegment"
+
+    $token = Get-ProvidedAccessToken -Provider $AccessTokenProvider
+    $refreshes = 0
+    $completed = [System.Collections.Generic.List[string]]::new()
+
+    Invoke-ContractPatch `
+        -OperationId 'PatchGroupForDomain' `
+        -Uri $groupUri `
+        -JsonBody $group.ToJson() `
+        -AccessTokenProvider $AccessTokenProvider `
+        -AccessToken ([ref]$token) `
+        -RefreshCount ([ref]$refreshes)
+    $completed.Add('PatchGroupForDomain')
+
+    Invoke-ContractPatch `
+        -OperationId 'PatchSecurityPolicyForDomain' `
+        -Uri $policyUri `
+        -JsonBody $policy.ToJson() `
+        -AccessTokenProvider $AccessTokenProvider `
+        -AccessToken ([ref]$token) `
+        -RefreshCount ([ref]$refreshes)
+    $completed.Add('PatchSecurityPolicyForDomain')
+
+    [pscustomobject]@{
+        GroupId = $GroupId
+        SecurityPolicyId = $SecurityPolicyId
+        TokenRefreshes = $refreshes
+        CompletedOperations = $completed.ToArray()
+    }
+}
+
+Export-ModuleMember -Function @(
+    'New-VcfNsxGroupModel'
+    'New-VcfNsxSecurityPolicyModel'
+    'Invoke-VcfNsxPolicyRollout'
+)

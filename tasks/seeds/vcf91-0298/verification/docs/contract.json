{
  "openapi": "3.0.1",
  "info": {
    "title": "VCF Operations for networks API Reference",
    "version": "9.1.0.0"
  },
  "servers": [
    {
      "url": "/api/ni"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    },
    {
      "OpsTokenAuth": []
    }
  ],
  "paths": {
    "/auth/token": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Create an auth token",
        "description": "<html><body> VCF Operations for networks supports token based authentication. Tokens are non-modifiable identifiers returned by the system when the user has successfully authenticated using valid credentials. Token expires after expiry time returned in the response. All API requests must provide the auth token in Authorization header in following format:<br> Authorization &#58; NetworkInsight {token} <br> If a token is invalid or expired, 401-Unauthorized error gets returned in the response of the API request. <br> There is limit of 100 valid tokens per user and further requests will return 401-Unauthorized. So, users are advised to delete the tokens after use <br> Expired tokens are cleaned periodically by the system. </body></html>",
        "operationId": "create",
        "requestBody": {
          "description": "User Credentials",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCredential"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                },
                "example": {
                  "token": "1rT7tm4riiACSfxrO2BvkA==",
                  "expiry": 1509332642427
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestResponse"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedResponse"
          },
          "500": {
            "$ref": "#/components/responses/InternalErrorResponse"
          }
        },
        "security": [],
        "x-codegen-request-body-name": "body"
      }
    },
    "/data-sources/vcenters": {
      "get": {
        "tags": [
          "Data Sources"
        ],
        "summary": "List vCenter data sources",
        "description": "List vCenter data sources",
        "operationId": "listVcenters",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataSourceListResponse"
                },
                "example": {
                  "results": [
                    {
                      "entity_id": "18230:902:993642895",
                      "entity_type": "VCenterDataSource"
                    },
                    {
                      "entity_id": "18230:902:627340998",
                      "entity_type": "VCenterDataSource"
                    }
                  ],
                  "total_count": 2
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedResponse"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenResponse"
          },
          "500": {
            "$ref": "#/components/responses/InternalErrorResponse"
          }
        }
      },
      "post": {
        "tags": [
          "Data Sources"
        ],
        "summary": "Create a vCenter data source",
        "description": "Add a vCenter data source. You must provide one of IP or FQDN field in the request body.\nAppropriate proxy id is retrieved from /infra/nodes URL to select the proxy node.",
        "operationId": "addVcenterDatasource",
        "requestBody": {
          "description": "vCenter Credentials",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VCenterDataSourceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VCenterDataSource"
                },
                "example": {
                  "entity_id": "18230:902:993642895",
                  "entity_type": "VCenterDataSource",
                  "ip": "10.197.17.68",
                  "fqdn": null,
                  "proxy_id": "18230:901:1585583463",
                  "nickname": "My vCenter",
                  "enabled": true,
                  "notes": "Located in DC1",
                  "credentials": {
                    "username": "administrator@vsphere.local",
                    "password": ""
                  },
                  "ipfix_response": {
                    "ipfix_enabled_for": "dvs-54,dvs-67,dvs-71"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestResponse"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedResponse"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenResponse"
          },
          "500": {
            "$ref": "#/components/responses/InternalErrorResponse"
          }
        },
        "x-codegen-request-body-name": "body"
      }
    },
    "/data-sources/vcenters/{id}": {
      "get": {
        "tags": [
          "Data Sources"
        ],
        "summary": "Show vCenter data source details",
        "description": "Show vCenter data source details",
        "operationId": "getVcenter",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The Entity ID of object requestion information on",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VCenterDataSource"
                },
                "example": {
                  "entity_id": "18230:902:993642895",
                  "entity_type": "VCenterDataSource",
                  "ip": "10.197.17.68",
                  "fqdn": null,
                  "proxy_id": "18230:901:1585583463",
                  "nickname": "My vCenter",
                  "enabled": true,
                  "notes": "Located in DC2",
                  "credentials": {
                    "username": "administrator@vsphere.local",
                    "password": ""
                  },
                  "ipfix_response": {
                    "ipfix_enabled_for": "dvs-54,dvs-67,dvs-71"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedResponse"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenResponse"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundResponse"
          },
          "500": {
            "$ref": "#/components/responses/InternalErrorResponse"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            }
          }
        }
      },
      "BaseDataSource": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string",
            "description": "Internal ID of data source, to be used in subsequent API calls"
          },
          "entity_type": {
            "$ref": "#/components/schemas/DataSourceType"
          },
          "ip": {
            "type": "string",
            "description": "IP address of data source (use either IP or FQDN, not both)",
            "example": "192.168.10.1"
          },
          "fqdn": {
            "type": "string",
            "description": "Hostname of data source (use either IP or FQDN, not both)",
            "example": "your.domain.com"
          },
          "proxy_id": {
            "type": "string",
            "description": "ID of Collector VM which should register this vcenter",
            "example": "1000:104:12313412"
          },
          "nickname": {
            "type": "string",
            "description": "A friendly nickname for the data source",
            "example": "vc1"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether or not data collection is enabled",
            "default": true
          },
          "notes": {
            "type": "string",
            "description": "Room for notes or comments about the data source",
            "example": "Located in DC1"
          },
          "certificate": {
            "type": "string",
            "description": "Certificate of data source",
            "example": "-----BEGIN CERTIFICATE----- ..etc.."
          },
          "sha_thumbprint": {
            "type": "string",
            "description": "SHA thumbprint of data source",
            "example": "15:37:46:1E:DB:70:65:80:B2:74:E5:78:25:E5:AD:39:14:53:69:18"
          },
          "new_certificate": {
            "type": "string",
            "description": "New certificate of data source",
            "example": "-----BEGIN CERTIFICATE----- ..etc.."
          },
          "new_sha_thumbprint": {
            "type": "string",
            "description": "New SHA thumbprint of data source",
            "example": "13:37:46:1E:DB:70:65:80:B2:74:E5:78:25:E5:AD:39:14:53:69:18"
          },
          "vcfManaged": {
            "type": "boolean",
            "description": "Whether or not data source is VCF managed",
            "default": false
          }
        },
        "discriminator": {
          "propertyName": "entity_type"
        }
      },
      "BaseDataSourceRequest": {
        "required": [
          "nickname",
          "proxy_id"
        ],
        "type": "object",
        "properties": {
          "ip": {
            "type": "string",
            "description": "IP address of data source (use either IP or FQDN, not both)",
            "example": "192.168.10.1"
          },
          "fqdn": {
            "type": "string",
            "description": "Hostname of data source (use either IP or FQDN, not both)",
            "example": "your.domain.com"
          },
          "proxy_id": {
            "type": "string",
            "description": "ID of Collector VM which should register this vcenter",
            "example": "1000:104:12313412"
          },
          "nickname": {
            "type": "string",
            "description": "A friendly nickname for the data source",
            "example": "vc1"
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether or not data collection is enabled",
            "default": true
          },
          "notes": {
            "type": "string",
            "description": "Room for notes or comments about the data source",
            "example": "Located in DC1"
          }
        }
      },
      "DataSourceEntityId": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string",
            "description": "Entity Identifier",
            "example": "1000:104:12213212"
          },
          "entity_type": {
            "$ref": "#/components/schemas/DataSourceType"
          }
        }
      },
      "DataSourceListResponse": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DataSourceEntityId"
            }
          },
          "total_count": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "DataSourceType": {
        "type": "string",
        "nullable": true,
        "enum": [
          "CiscoSwitchDataSource",
          "DellSwitchDataSource",
          "AristaSwitchDataSource",
          "BrocadeSwitchDataSource",
          "JuniperSwitchDataSource",
          "GDDataSource",
          "F5BIGIPDataSource",
          "NSXALBDataSource",
          "HuaweiSwitchDataSource",
          "MellanoxSwitchDataSource",
          "HPESwitchDataSource",
          "CiscoASRXRDataSource",
          "UANIDataSource",
          "VCenterDataSource",
          "NSXVManagerDataSource",
          "UCSManagerDataSource",
          "HPVCManagerDataSource",
          "HPOneViewDataSource",
          "PanFirewallDataSource",
          "CheckpointFirewallDataSource",
          "FortinetFirewallDataSource",
          "NSXTManagerDataSource",
          "KubernetesDataSource",
          "PKSDataSource",
          "InfobloxManagerDataSource",
          "CiscoACIDataSource",
          "ServiceNowDataSource",
          "PolicyManagerDataSource",
          "AzureDataSource",
          "VeloCloudDataSource",
          "AWSDataSource",
          "HcxDataSource"
        ]
      },
      "Domain": {
        "type": "object",
        "properties": {
          "domain_type": {
            "type": "string",
            "description": "domain type, should be in uppercase",
            "example": "LDAP",
            "nullable": true,
            "enum": [
              "LDAP",
              "LOCAL"
            ]
          },
          "value": {
            "type": "string",
            "description": "domain value, not required for LOCAL domain",
            "example": "example.com"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "target": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "LocalTag": {
        "type": "object",
        "properties": {
          "tag_key": {
            "type": "string",
            "description": "Name of the local tag",
            "example": "true"
          },
          "tag_value": {
            "type": "string",
            "description": "Value of the local tag",
            "example": "true"
          }
        }
      },
      "PasswordCredentials": {
        "required": [
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Username to authenticate with",
            "example": "readonly"
          },
          "password": {
            "type": "string",
            "description": "Password to authenticate with",
            "example": "VMware1!"
          }
        }
      },
      "Token": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "Mgs2YX0ZSY+gHW6RYypeeA=="
          },
          "expiry": {
            "type": "integer",
            "description": "expiry epoch time in secs.",
            "format": "int64",
            "example": 1605201960327
          }
        }
      },
      "UserCredential": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "admin@vrni.com"
          },
          "password": {
            "type": "string",
            "example": "password"
          },
          "domain": {
            "$ref": "#/components/schemas/Domain"
          }
        }
      },
      "VCenterDataSource": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BaseDataSource"
          },
          {
            "type": "object",
            "properties": {
              "credentials": {
                "$ref": "#/components/schemas/PasswordCredentials"
              },
              "ipfix_request": {
                "$ref": "#/components/schemas/dvs_ipfix_request"
              },
              "antrea_ipfix_request": {
                "$ref": "#/components/schemas/antrea_ipfix_request"
              },
              "ipfix_response": {
                "$ref": "#/components/schemas/dvs_ipfix_response"
              },
              "antrea_ipfix_response": {
                "$ref": "#/components/schemas/antrea_ipfix_response"
              },
              "is_vmc": {
                "type": "boolean",
                "description": "Whether vCenter is a VMware Cloud operated vCenter (true or false).",
                "default": false
              },
              "ds_sub_type": {
                "type": "string",
                "description": "Optional field for Vmware Cloud operated vCenter (VMCVCENTER)"
              },
              "tags": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/LocalTag"
                }
              },
              "enable_ds_associated_tags": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "VCenterDataSourceRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BaseDataSourceRequest"
          },
          {
            "type": "object",
            "properties": {
              "credentials": {
                "$ref": "#/components/schemas/PasswordCredentials"
              },
              "ipfix_request": {
                "$ref": "#/components/schemas/dvs_ipfix_request"
              },
              "antrea_ipfix_request": {
                "$ref": "#/components/schemas/antrea_ipfix_request"
              },
              "is_vmc": {
                "type": "boolean",
                "description": "Whether vCenter is a VMware Cloud operated vCenter (true or false).",
                "default": false
              },
              "ds_sub_type": {
                "type": "string",
                "description": "Optional field for Vmware Cloud (VMCVCENTER)"
              },
              "tags": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/LocalTag"
                }
              },
              "enable_ds_associated_tags": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "antrea_ipfix_request": {
        "type": "object",
        "properties": {
          "default_supervisor_ipfix": {
            "type": "boolean",
            "description": "Indicates whether the newly discovered Supervisor Clusters are selected for IPFIX or not. If the value is true, then the newly discovered Supervisor Clusters are considered to be IPFIX enabled.",
            "default": false
          }
        }
      },
      "antrea_ipfix_response": {
        "type": "object",
        "properties": {
          "ipfix_enabled_status": {
            "type": "boolean"
          }
        }
      },
      "dvpgs_ipfix_request": {
        "type": "object",
        "properties": {
          "dvs_key": {
            "type": "string",
            "description": "Value of the dvs object whose dvpgs have to be set for ipfix enablement.",
            "example": "vds-1"
          },
          "enable_for_dvpgs": {
            "type": "string",
            "description": "Comma separated values of all the dvpgs objects for which ipfix should be enabled.",
            "example": "dvportgroup-1,dvportgroup-2"
          }
        }
      },
      "dvs_ipfix_request": {
        "type": "object",
        "properties": {
          "enable_all": {
            "type": "boolean",
            "description": "Enable flow collection for All DVS.",
            "default": false
          },
          "disable_all": {
            "type": "boolean",
            "description": "Disable flow collection for All DVS.",
            "default": false
          },
          "enable_for_dvs": {
            "type": "string",
            "description": "Comma separated values of all the dvs objects for which ipfix should be enabled.",
            "example": "vds-1,vds-2,vds-3"
          },
          "disable_for_dvs": {
            "type": "string",
            "description": "Comma separated values of all the dvs objects for wihch ipfix should be disabled.",
            "example": "vds-1,vds-2,vds-3"
          },
          "dvpgs_ipfix_request": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/dvpgs_ipfix_request"
            }
          }
        }
      },
      "dvs_ipfix_response": {
        "type": "object",
        "properties": {
          "ipfix_enabled_for": {
            "type": "string"
          },
          "ipfix_disabled_for": {
            "type": "string"
          },
          "ipfix_disabling_failed": {
            "type": "string"
          },
          "ipfix_enabling_failed": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "BadRequestResponse": {
        "description": "Bad Request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "ForbiddenResponse": {
        "description": "Forbidden",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "InternalErrorResponse": {
        "description": "Internal error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "NotFoundResponse": {
        "description": "Not Found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "UnauthorizedResponse": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "description": "API Key - NetworkInsight {token}",
        "name": "Authorization",
        "in": "header"
      },
      "OpsTokenAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "VCF Ops JWT Token - Bearer {token}",
        "bearerFormat": "JWT"
      }
    }
  }
}

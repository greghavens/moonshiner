+// NewClient constructs a client for the service root baseURL.
 func NewClient(baseURL, username, password string, httpClient *http.Client) (*Client, error) {
-	return nil, errors.New("TODO: implement NewClient")
+	trimmed := strings.TrimSpace(baseURL)
+	if trimmed == "" {
+		return nil, errors.New("vcfnetworks: service root URL is empty")
+	}
+	parsed, err := url.Parse(trimmed)
+	if err != nil {
+		return nil, fmt.Errorf("vcfnetworks: service root URL is not parseable: %w", err)
+	}
+	if parsed.Scheme != "http" && parsed.Scheme != "https" {
+		return nil, fmt.Errorf("vcfnetworks: service root scheme %q is not http or https", parsed.Scheme)
+	}
+	if parsed.Host == "" {
+		return nil, errors.New("vcfnetworks: service root URL has no host")
+	}
+	if parsed.Path != "" && parsed.Path != "/" {
+		return nil, fmt.Errorf("vcfnetworks: service root URL carries path %q", parsed.Path)
+	}
+	if parsed.RawQuery != "" || parsed.ForceQuery {
+		return nil, errors.New("vcfnetworks: service root URL carries a query string")
+	}
+	if parsed.Fragment != "" || strings.Contains(trimmed, "#") {
+		return nil, errors.New("vcfnetworks: service root URL carries a fragment")
+	}
+	if parsed.User != nil {
+		return nil, errors.New("vcfnetworks: service root URL carries userinfo")
+	}
+	if strings.TrimSpace(username) == "" {
+		return nil, errors.New("vcfnetworks: username is empty")
+	}
+	if httpClient == nil {
+		httpClient = http.DefaultClient
+	}
+	root := parsed.Scheme + "://" + parsed.Host + serviceRoot
+	return &Client{root: root, username: username, password: password, httpClient: httpClient}, nil
 }
 
 // EnsureVcenterDataSource registers the vCenter data source described by spec if
 // and only if no data source for the same target already exists.
 func (c *Client) EnsureVcenterDataSource(ctx context.Context, spec VcenterSpec) (EnsureResult, error) {
-	return EnsureResult{}, errors.New("TODO: implement EnsureVcenterDataSource")
+	if ctx == nil {
+		return EnsureResult{}, errors.New("vcfnetworks: nil context")
+	}
+	if err := validateSpec(spec); err != nil {
+		return EnsureResult{}, err
+	}
+
+	token, err := c.authToken(ctx)
+	if err != nil {
+		return EnsureResult{}, err
+	}
+
+	existing, found, err := c.resolveExisting(ctx, token, spec)
+	if err != nil {
+		return EnsureResult{}, err
+	}
+	if found {
+		return EnsureResult{DataSource: existing, Created: false}, nil
+	}
+
+	created, err := c.addVcenterDatasource(ctx, token, spec)
+	if err != nil {
+		return EnsureResult{}, err
+	}

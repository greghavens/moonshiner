{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:acme:vcf:migration-plan:1.0.0",
  "title": "VCF workload-domain migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "estateId", "targetRelease", "targetDomain", "managementDomain", "steps"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "estateId": {"type": "string", "minLength": 1},
    "targetRelease": {"type": "string", "minLength": 1},
    "targetDomain": {"type": "string", "minLength": 1},
    "managementDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "components"],
      "properties": {
        "action": {"const": "NO_CHANGE"},
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["componentId", "componentType", "currentVersion", "targetVersion", "action", "gates"],
            "properties": {
              "componentId": {"type": "string", "minLength": 1},
              "componentType": {"enum": ["SDDC_MANAGER", "NSX", "VCENTER", "ESXI"]},
              "currentVersion": {"type": "string", "minLength": 1},
              "targetVersion": {"type": "string", "minLength": 1},
              "action": {"const": "NO_CHANGE"},
              "gates": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "componentId", "componentType", "currentVersion", "targetVersion", "targetDomain", "action", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "componentId": {"type": "string", "minLength": 1},
          "componentType": {"enum": ["NSX", "VCENTER", "ESXI"]},
          "currentVersion": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "targetDomain": {"type": "string", "minLength": 1},
          "action": {"const": "UPGRADE_AND_MIGRATE"},
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}

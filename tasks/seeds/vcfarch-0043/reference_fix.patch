+Set-StrictMode -Version Latest
+
+function ConvertTo-VcfRestValue {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory, ValueFromPipeline)]
+        [AllowNull()]
+        [object] $InputObject
+    )
+
+    process {
+        if ($null -eq $InputObject) {
+            return $null
+        }
+        if ($InputObject -is [string] -or
+            $InputObject -is [bool] -or
+            $InputObject -is [byte] -or
+            $InputObject -is [int16] -or
+            $InputObject -is [int32] -or
+            $InputObject -is [int64] -or
+            $InputObject -is [uint16] -or
+            $InputObject -is [uint32] -or
+            $InputObject -is [uint64] -or
+            $InputObject -is [single] -or
+            $InputObject -is [double] -or
+            $InputObject -is [decimal]) {
+            return $InputObject
+        }
+        if ($InputObject -is [System.Collections.IDictionary]) {
+            $dictionary = [ordered]@{}
+            foreach ($key in $InputObject.Keys) {
+                $value = $InputObject[$key]
+                if ($null -ne $value) {
+                    $dictionary[[string]$key] = ConvertTo-VcfRestValue -InputObject $value
+                }
+            }
+            return [pscustomobject]$dictionary
+        }
+        if ($InputObject -is [System.Collections.IEnumerable]) {
+            $items = @()
+            foreach ($item in $InputObject) {
+                $items += ,(ConvertTo-VcfRestValue -InputObject $item)
+            }
+            return ,$items
+        }
+
+        $result = [ordered]@{}
+        foreach ($property in $InputObject.PSObject.Properties) {
+            if ($property.Name -eq 'AdditionalProperties' -or $null -eq $property.Value) {
+                continue
+            }
+            $restName = $property.Name.Substring(0, 1).ToLowerInvariant() + $property.Name.Substring(1)
+            $result[$restName] = ConvertTo-VcfRestValue -InputObject $property.Value
+        }
+        return [pscustomobject]$result
+    }
+}
+
+function Write-VcfJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)] [object] $Value,
+        [Parameter(Mandatory)] [string] $Path
+    )
+
+    $json = $Value | ConvertTo-Json -Depth 100
+    [System.IO.File]::WriteAllText(
+        $Path,
+        $json + [Environment]::NewLine,
+        [System.Text.UTF8Encoding]::new($false)
+    )
+}
+
+function Export-VcfArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)] [string] $EstatePath,
+        [Parameter(Mandatory)] [string] $CompatibilityPath,
+        [Parameter(Mandatory)] [string] $OutputDirectory
+    )
+
+    $estate = Get-Content -LiteralPath $EstatePath -Raw -Encoding UTF8 | ConvertFrom-Json -Depth 100
+    $compatibility = Get-Content -LiteralPath $CompatibilityPath -Raw -Encoding UTF8 | ConvertFrom-Json -Depth 100
+    $combination = @($compatibility.supportedCombinations | Where-Object release -EQ $estate.targetDomain.version)
+    if ($combination.Count -ne 1) {
+        throw "Exactly one supported combination is required for $($estate.targetDomain.version)."
+    }
+    $bom = $combination[0]
+
+    $hostCredentials = Initialize-VcfInstallerSddcCredentials -Username 'root' -Password 'ArchitectureOnly1!'
+    $hostSpecs = @(
+        foreach ($hostEntry in $estate.candidateHosts) {
+            Initialize-VcfInstallerSddcHostSpec -Hostname $hostEntry.hostname -Credentials $hostCredentials
+        }
+    )
+
+    $networkSpecs = @(
+        foreach ($network in $estate.networks) {
+            $networkArguments = @{
+                NetworkType = [string]$network.networkType
+                VlanId = [uint32]$network.vlanId
+                Subnet = [string]$network.cidr
+                Gateway = [string]$network.gateway
+                SubnetMask = [string]$network.subnetMask
+                Mtu = [int]$network.mtu
+            }
+            if ($null -ne $network.PSObject.Properties['ipAddresses']) {
+                $networkArguments.IncludeIpAddress = @($network.ipAddresses)
+            }
+            Initialize-VcfInstallerSddcNetworkSpec @networkArguments
+        }
+    )
+
+    $uplinks = @(
+        Initialize-VcfInstallerVmnicToUplink -Id 'vmnic0' -Uplink 'uplink1'
+        Initialize-VcfInstallerVmnicToUplink -Id 'vmnic1' -Uplink 'uplink2'
+    )
+    $dvs = Initialize-VcfInstallerDvsSpec `
+        -DvsName 'DAL01-W02-VDS01' `
+        -Networks @($estate.networks.networkType) `
+        -Mtu ([int]$compatibility.designLimits.supportedMtu) `
+        -VmnicsToUplinks $uplinks
+
+    $overlay = $estate.networks | Where-Object networkType -EQ 'HOST_OVERLAY'
+    $poolRange = Initialize-VcfInstallerIpAddressPoolRangeSpec `
+        -Start $overlay.ipPoolStart `
+        -VarEnd $overlay.ipPoolEnd
+    $poolSubnet = Initialize-VcfInstallerIpAddressPoolSubnetSpec `
+        -IpAddressPoolRanges @($poolRange) `
+        -Cidr $overlay.cidr `
+        -Gateway $overlay.gateway
+    $pool = Initialize-VcfInstallerIpAddressPoolSpec `
+        -Name 'dal01-w02-tep-pool' `
+        -Description 'DAL01 W02 host overlay TEP pool' `
+        -Subnets @($poolSubnet)
+    $nsxManagers = @(
+        foreach ($fqdn in $estate.services.nsxManagerFqdns) {
+            Initialize-VcfInstallerNsxtManagerSpec -Hostname $fqdn
+        }
+    )
+    $nsx = Initialize-VcfInstallerSddcNsxtSpec `
+        -NsxtManagers $nsxManagers `
+        -NsxtManagerSize 'large' `
+        -VipFqdn $estate.services.nsxVipFqdn `
+        -RootNsxtManagerPassword 'ArchitectureOnly1!' `
+        -NsxtAdminPassword 'ArchitectureOnly1!' `
+        -NsxtAuditPassword 'ArchitectureOnly1!' `
+        -TransportVlanId ([int]$overlay.vlanId) `
+        -IpAddressPoolSpec $pool `
+        -UseExistingDeployment $false `
+        -Version $bom.NSX
+
+    $vcenter = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname $estate.services.vcenterFqdn `
+        -RootVcenterPassword 'ArchitectureOnly1!' `
+        -VmSize 'large' `
+        -StorageSize 'lstorage' `
+        -SsoDomain 'vsphere.local' `
+        -UseExistingDeployment $false `
+        -Version $bom.VCENTER
+    $cluster = Initialize-VcfInstallerSddcClusterSpec `
+        -DatacenterName 'DAL01-W02-DC' `
+        -ClusterName 'DAL01-W02-CL01'
+    $esa = Initialize-VcfInstallerVsanEsaConfig -Enabled $true
+    $vsan = Initialize-VcfInstallerVsanSpec `
+        -DatastoreName 'DAL01-W02-VSAN01' `
+        -EsaConfig $esa `
+        -FailuresToTolerate ([uint32]$estate.requirements.hostFailuresToTolerate)
+    $datastore = Initialize-VcfInstallerSddcDatastoreSpec -VsanSpec $vsan
+    $dns = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $estate.services.dnsDomain `
+        -Nameservers @($estate.services.dnsServers)
+    $security = Initialize-VcfInstallerSecuritySpec -EsxiCertsMode 'VMCA'
+
+    $sdkSpec = Initialize-VcfInstallerSddcSpec `
+        -SddcId $estate.targetDomain.id `
+        -WorkflowType $compatibility.designLimits.supportedWorkflowType `
+        -HostSpecs $hostSpecs `
+        -Version $compatibility.targetRelease `
+        -VcenterSpec $vcenter `
+        -ClusterSpec $cluster `
+        -DvsSpecs @($dvs) `
+        -NsxtSpec $nsx `
+        -NetworkSpecs $networkSpecs `
+        -DnsSpec $dns `
+        -NtpServers @($estate.services.ntpServers) `
+        -ManagementPoolName 'dal01-w02-network-pool' `
+        -CeipEnabled $false `
+        -SkipEsxThumbprintValidation $false `
+        -SkipGatewayPingValidation $false `
+        -SecuritySpec $security `
+        -DatastoreSpec $datastore `
+        -VcfInstanceName $estate.fleetName
+    $sddcSpec = ConvertTo-VcfRestValue -InputObject $sdkSpec
+
+    $managementComponents = @(
+        foreach ($component in $estate.managementDomain.components) {
+            [ordered]@{
+                componentId = [string]$component.componentId
+                componentType = [string]$component.componentType
+                currentVersion = [string]$component.currentVersion
+                targetVersion = [string]$component.currentVersion
+                action = 'NO_CHANGE'
+                gates = @([string]$compatibility.managementDomainNoChangeGate)
+            }
+        }
+    )
+    $rankedComponents = @(
+        foreach ($component in $estate.migrationScope.components) {
+            $rules = @($compatibility.upgradePaths | Where-Object {
+                $_.componentType -eq $component.componentType -and
+                $_.fromVersion -eq $component.currentVersion
+            })
+            if ($rules.Count -ne 1) {
+                throw "Exactly one pinned path is required for $($component.componentId)."
+            }
+            [pscustomobject]@{ Component = $component; Rule = $rules[0] }
+        }
+    ) | Sort-Object @{ Expression = { $_.Rule.orderRank } }, @{ Expression = { $_.Component.componentId } }
+
+    $order = 0
+    $steps = @(
+        foreach ($ranked in $rankedComponents) {
+            $order += 1
+            [ordered]@{
+                order = $order
+                componentId = [string]$ranked.Component.componentId
+                componentType = [string]$ranked.Component.componentType
+                currentVersion = [string]$ranked.Component.currentVersion
+                targetVersion = [string]$ranked.Rule.targetVersion
+                targetDomain = [string]$estate.targetDomain.id
+                action = [string]$ranked.Rule.action
+                gates = @($ranked.Rule.requiredGates | ForEach-Object { [string]$_ })
+            }
+        }
+    )
+    $migrationPlan = [ordered]@{
+        schemaVersion = '1.0.0'
+        estateId = [string]$estate.estateId
+        targetRelease = [string]$compatibility.targetRelease
+        targetDomain = [string]$estate.targetDomain.id
+        managementDomain = [ordered]@{
+            action = 'NO_CHANGE'
+            components = $managementComponents
+        }
+        steps = $steps
+    }
+
+    [void][System.IO.Directory]::CreateDirectory($OutputDirectory)
+    Write-VcfJson -Value $sddcSpec -Path (Join-Path $OutputDirectory 'sddc-spec.json')
+    Write-VcfJson -Value $migrationPlan -Path (Join-Path $OutputDirectory 'migration-plan.json')
+}
+
+Export-ModuleMember -Function Export-VcfArchitecture

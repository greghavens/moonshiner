+"""Credential inventory client for the VCF 9.0.0.0 SDDC Manager API.
+
+The wire contract is `docs/contract.json`, a projection of the SDDC Manager
+OpenAPI file pinned in `docs/official_sources.json`.
+"""
+
+from .client import (
+    CONTRACT_PATH,
+    SddcManagerClient,
+    SddcManagerError,
+    documented_resource_types,
+    project_credential,
+)
+
+__all__ = [
+    "CONTRACT_PATH",
+    "SddcManagerClient",
+    "SddcManagerError",
+    "documented_resource_types",
+    "project_credential",
+]

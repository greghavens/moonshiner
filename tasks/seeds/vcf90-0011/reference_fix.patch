+"""`python3 -m vcfcreds` — emit the SDDC Manager credential inventory."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+
+from .client import SddcManagerClient, SddcManagerError, documented_resource_types, project_credential
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        prog="vcfcreds",
+        description="Retrieve every SDDC Manager credential and emit it in a stable order.",
+    )
+    parser.add_argument("--base-url", required=True,
+                        help="SDDC Manager base URL, e.g. https://sddc-manager.vcf.local")
+    parser.add_argument("--username", required=True)
+    parser.add_argument("--password", required=True)
+    parser.add_argument("--page-size", required=True, type=int,
+                        help="number of elements to request per page (positive)")
+    parser.add_argument("--resource-type", default=None,
+                        help="optional resourceType filter; omitted entirely when unset")
+    return parser
+
+
+def sort_key(record: dict) -> tuple[str, str, str]:
+    return (record.get("resourceName") or "",
+            record.get("username") or "",
+            record.get("id") or "")
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = build_parser().parse_args(argv)
+
+    if args.page_size < 1:
+        print(f"error: --page-size must be a positive integer, got {args.page_size}",
+              file=sys.stderr)
+        return 2
+    if args.resource_type is not None:
+        documented = documented_resource_types()
+        if args.resource_type not in documented:
+            # Rejected here, before anything is sent, so an unsupported value
+            # never reaches the service.
+            print(f"error: --resource-type {args.resource_type!r} is not one of "
+                  f"{list(documented)}", file=sys.stderr)
+            return 2
+
+    client = SddcManagerClient(args.base_url)
+    try:
+        client.create_token(args.username, args.password)
+        records = [project_credential(element)
+                   for element in client.iter_credentials(args.page_size, args.resource_type)]
+    except SddcManagerError as error:
+        print(f"error: {error}", file=sys.stderr)
+        return 1
+
+    records.sort(key=sort_key)
+    json.dump({"count": len(records), "credentials": records},
+              sys.stdout, indent=2, sort_keys=True)
+    sys.stdout.write("\n")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

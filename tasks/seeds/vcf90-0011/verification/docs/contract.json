{
  "source": {
    "repository": "vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "commit_sha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "license": "Apache-2.0"
  },
  "openapi": "3.0.1",
  "api_version": "9.0.0.0",
  "authentication": {
    "scheme": "bearer",
    "header": "Authorization",
    "valuePrefix": "Bearer ",
    "tokenField": "accessToken",
    "unauthenticatedOperations": [
      "createToken"
    ],
    "basis": "Bearer token that can be used to make public API calls"
  },
  "operations": [
    {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "summary": "Create Token Pair",
      "parameters": [],
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": {
          "$ref": "#/schemas/TokenCreationSpec"
        }
      },
      "responses": {
        "201": {
          "schema": "TokenPair",
          "description": "Created"
        },
        "400": {
          "schema": "Error",
          "description": "Bad Request"
        },
        "500": {
          "schema": "Error",
          "description": "Internal Server Error"
        }
      }
    },
    {
      "operationId": "getCredentials",
      "method": "GET",
      "path": "/v1/credentials",
      "summary": "Retrieve a list of credentials",
      "parameters": [
        {
          "name": "resourceName",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          },
          "description": "The name of the resource"
        },
        {
          "name": "resourceIp",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          },
          "description": "The IP address of the resource"
        },
        {
          "name": "resourceType",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          },
          "description": "The type of the resource. One among: ESXI, VCENTER, PSC, NSXT_MANAGER, NSXT_EDGE, NSX_ALB, BACKUP",
          "documentedValues": [
            "ESXI",
            "VCENTER",
            "PSC",
            "NSXT_MANAGER",
            "NSXT_EDGE",
            "NSX_ALB",
            "BACKUP"
          ],
          "documentedValuesSource": "Parsed from this parameter's description prose in the 9.0.0.0 specification; that revision declares no JSON Schema enum for resourceType."
        },
        {
          "name": "domainName",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          },
          "description": "The name of the domain to which the resource belongs to (may be null in case there is no associated domain)"
        },
        {
          "name": "pageNumber",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "default": "0"
          },
          "description": "The page number (must be a positive number), starts with 0"
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "default": "0"
          },
          "description": "The page size (must be a positive number, 0 as page size returns all records in one page"
        },
        {
          "name": "accountType",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          },
          "description": "Type of the account that needs to be fetched by filtering"
        }
      ],
      "requestBody": null,
      "responses": {
        "200": {
          "schema": "PageOfCredential",
          "description": "Ok"
        },
        "400": {
          "schema": "Error",
          "description": "Bad Request"
        },
        "401": {
          "schema": "Error",
          "description": "Unauthorized"
        },
        "403": {
          "schema": "Error",
          "description": "Forbidden"
        },
        "500": {
          "schema": "Error",
          "description": "InternalServerError"
        }
      }
    }
  ],
  "schemas": {
    "TokenCreationSpec": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "Username"
        },
        "password": {
          "type": "string",
          "description": "User Password"
        },
        "apiKey": {
          "type": "string",
          "description": "API Key"
        },
        "idToken": {
          "type": "string",
          "description": "Id Token"
        }
      },
      "description": "The spec used to sign the token"
    },
    "TokenPair": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string",
          "description": "Bearer token that can be used to make public API calls"
        },
        "refreshToken": {
          "$ref": "#/components/schemas/RefreshToken"
        }
      },
      "description": "This contains the access token and the refresh token for the user API access."
    },
    "RefreshToken": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Refresh token id that can be used to request new access token"
        }
      },
      "description": "This contains refresh token id for the user API access."
    },
    "PageOfCredential": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "description": "The list of elements included in this page",
          "items": {
            "$ref": "#/components/schemas/Credential"
          }
        },
        "pageMetadata": {
          "$ref": "#/components/schemas/PageMetadata"
        }
      }
    },
    "PageMetadata": {
      "type": "object",
      "properties": {
        "pageNumber": {
          "type": "integer",
          "description": "Returns the current page number",
          "format": "int32"
        },
        "pageSize": {
          "type": "integer",
          "description": "Returns the number of elements in the current page",
          "format": "int32"
        },
        "totalElements": {
          "type": "integer",
          "description": "Returns the total number of elements",
          "format": "int32"
        },
        "totalPages": {
          "type": "integer",
          "description": "Returns the total number of pages",
          "format": "int32"
        }
      },
      "description": "Represents pageable elements pagination metadata"
    },
    "Credential": {
      "required": [
        "accountType",
        "creationTimestamp",
        "credentialType",
        "id",
        "modificationTimestamp",
        "resource",
        "username"
      ],
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Credential ID"
        },
        "credentialType": {
          "type": "string",
          "description": "Credential type",
          "example": "One among: SSO, SSH, API, FTP, AUDIT"
        },
        "accountType": {
          "type": "string",
          "description": "Account type",
          "example": "One among: USER, SYSTEM, SERVICE"
        },
        "username": {
          "type": "string",
          "description": "Username"
        },
        "password": {
          "type": "string",
          "description": "Password"
        },
        "creationTimestamp": {
          "type": "string",
          "description": "The timestamp at which credential was created"
        },
        "modificationTimestamp": {
          "type": "string",
          "description": "The timestamp at which credential was last modified"
        },
        "expiry": {
          "$ref": "#/components/schemas/ExpirationDetails"
        },
        "resource": {
          "$ref": "#/components/schemas/AuthenticatedResource"
        },
        "autoRotatePolicy": {
          "$ref": "#/components/schemas/AutoRotateCredentialPolicy"
        }
      },
      "description": "Represents a credential and the resource to which it is associated with"
    },
    "AuthenticatedResource": {
      "required": [
        "domainNames",
        "resourceId",
        "resourceName",
        "resourceType"
      ],
      "type": "object",
      "properties": {
        "resourceId": {
          "type": "string",
          "description": "Resource ID"
        },
        "resourceName": {
          "type": "string",
          "description": "Resource name"
        },
        "resourceIp": {
          "type": "string",
          "description": "[Deprecated] Resource IP address"
        },
        "resourceType": {
          "type": "string",
          "description": "Resource type",
          "example": "One among: ESXI, VCENTER, PSC, NSXT_MANAGER, NSXT_EDGE, NSX_ALB, BACKUP"
        },
        "domainNames": {
          "type": "array",
          "description": "Domain names",
          "items": {
            "type": "string",
            "description": "Domain names"
          }
        },
        "domainName": {
          "type": "string",
          "description": "Domain name (deprecated)"
        }
      },
      "description": "Represents the credential resource in the system"
    },
    "ExpirationDetails": {
      "type": "object",
      "properties": {
        "expiryDate": {
          "type": "string",
          "description": "Expiration date"
        },
        "lastCheckedDate": {
          "type": "string",
          "description": "Last checked date"
        },
        "connectivityStatus": {
          "type": "string",
          "description": "Connectivity status",
          "example": "One among: ACTIVE, ERROR, UNKNOWN"
        },
        "status": {
          "type": "string",
          "description": "Expiration status",
          "example": "One among: ACTIVE, EXPIRING, EXPIRED, UNKNOWN"
        }
      },
      "description": "Represents expiration details of the credential"
    },
    "AutoRotateCredentialPolicy": {
      "required": [
        "nextSchedule"
      ],
      "type": "object",
      "properties": {
        "frequencyInDays": {
          "type": "integer",
          "description": "Frequency in days",
          "format": "int32"
        },
        "nextSchedule": {
          "type": "string",
          "description": "The timestamp at which auto-rotate for credential will run"
        }
      },
      "description": "Represents a auto-rotate policy for a credential"
    }
  }
}

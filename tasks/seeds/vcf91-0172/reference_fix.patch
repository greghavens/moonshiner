+function Assert-VcfOpsLogNonBlank {
+    param(
+        [Parameter(Mandatory)]
+        [AllowEmptyString()]
+        [string] $Value,
+
+        [Parameter(Mandatory)]
+        [string] $Name
+    )
+
+    if ([string]::IsNullOrWhiteSpace($Value)) {
+        throw [ArgumentException]::new("$Name must be nonblank.")
+    }
+}
+
+function Assert-VcfOpsLogIdentifier {
+    param(
+        [Parameter(Mandatory)]
+        [AllowEmptyString()]
+        [string] $Value,
+
+        [Parameter(Mandatory)]
+        [string] $Name
+    )
+
+    Assert-VcfOpsLogNonBlank -Value $Value -Name $Name
+    if (-not [StringComparer]::Ordinal.Equals($Value, $Value.Trim())) {
+        throw [ArgumentException]::new(
+            "$Name must not have surrounding whitespace."
+        )
+    }
+}
+
+function Assert-VcfOpsLogToken {
+    param(
+        [Parameter(Mandatory)]
+        [AllowEmptyString()]
+        [string] $Value
+    )
+
+    Assert-VcfOpsLogNonBlank -Value $Value -Name 'LogToken'
+    if ($Value.Contains("`r") -or $Value.Contains("`n")) {
+        throw [ArgumentException]::new(
+            'LogToken contains a header-unsafe character.'
+        )
+    }
+}
+
+function Resolve-VcfOpsLogOrigin {
+    param(
+        [Parameter(Mandatory)]
+        [uri] $BaseUri
+    )
+
+    if (
+        -not $BaseUri.IsAbsoluteUri -or
+        ($BaseUri.Scheme -cne 'http' -and $BaseUri.Scheme -cne 'https') -or
+        $BaseUri.UserInfo.Length -ne 0 -or
+        $BaseUri.AbsolutePath -cne '/' -or
+        $BaseUri.Query.Length -ne 0 -or
+        $BaseUri.Fragment.Length -ne 0
+    ) {
+        throw [ArgumentException]::new(
+            'BaseUri must be an absolute HTTP(S) origin.'
+        )
+    }
+
+    return [uri] $BaseUri.GetLeftPart([UriPartial]::Authority)
+}
+
+function ConvertFrom-VcfOpsLogJson {
+    param(
+        [Parameter(Mandatory)]
+        [AllowEmptyString()]
+        [string] $Text,
+
+        [Parameter(Mandatory)]
+        [string] $Context
+    )
+
+    try {
+        $Value = $Text | ConvertFrom-Json -Depth 40
+    }
+    catch {
+        throw [InvalidDataException]::new("$Context returned malformed JSON.")
+    }
+    if ($null -eq $Value) {
+        throw [InvalidDataException]::new("$Context returned null JSON.")
+    }
+    return $Value
+}
+
+function Get-VcfOpsLogProperty {
+    param(
+        [Parameter(Mandatory)]
+        [object] $InputObject,
+
+        [Parameter(Mandatory)]
+        [string] $Name,
+
+        [Parameter(Mandatory)]
+        [string] $Context
+    )
+
+    $Property = $InputObject.PSObject.Properties[$Name]
+    if ($null -eq $Property) {
+        throw [InvalidDataException]::new(
+            "$Context is missing the $Name property."
+        )
+    }
+    return $Property.Value
+}
+
+function Invoke-VcfOpsLogSearchRequest {
+    param(
+        [Parameter(Mandatory)]
+        [Net.Http.HttpClient] $Client,
+
+        [Parameter(Mandatory)]
+        [uri] $Uri,
+
+        [Parameter(Mandatory)]
+        [string] $LogToken,
+
+        [Parameter(Mandatory)]
+        [string] $JsonBody
+    )
+
+    $Request = [Net.Http.HttpRequestMessage]::new(
+        [Net.Http.HttpMethod]::Post,
+        $Uri
+    )
+    $Response = $null
+    try {
+        $Request.Headers.Accept.Add(
+            [Net.Http.Headers.MediaTypeWithQualityHeaderValue]::new(
+                'application/json'
+            )
+        )
+        if (
+            -not $Request.Headers.TryAddWithoutValidation(
+                'X-JWT-Token',
+                $LogToken
+            )
+        ) {
+            throw [InvalidOperationException]::new(
+                'Could not configure log authentication.'
+            )
+        }
+
+        $Bytes = [Text.Encoding]::UTF8.GetBytes($JsonBody)
+        $Request.Content = [Net.Http.ByteArrayContent]::new($Bytes)
+        $Request.Content.Headers.ContentType = (
+            [Net.Http.Headers.MediaTypeHeaderValue]::new('application/json')
+        )
+
+        try {
+            $Response = $Client.Send($Request)
+            $Text = (
+                $Response.Content.ReadAsStringAsync().GetAwaiter().GetResult()
+            )
+        }
+        catch {
+            throw [IOException]::new(
+                'The executeLogSearchQuery_1 request failed.'
+            )
+        }
+
+        return [pscustomobject] @{
+            StatusCode = [int] $Response.StatusCode
+            Text = $Text
+        }
+    }
+    finally {
+        if ($null -ne $Response) {
+            $Response.Dispose()
+        }
+        $Request.Dispose()
+    }
+}
+
+function Assert-VcfOpsLogSearchSuccess {
+    param(
+        [Parameter(Mandatory)]
+        [pscustomobject] $Response,
+
+        [Parameter(Mandatory)]
+        [string] $Context
+    )
+
+    if ($Response.StatusCode -ne 200) {
+        $ErrorBody = ConvertFrom-VcfOpsLogJson `
+            -Text $Response.Text `
+            -Context 'The log-search error response'
+        $ErrorCode = Get-VcfOpsLogProperty `
+            -InputObject $ErrorBody `
+            -Name 'errorCode' `
+            -Context 'The log-search error response'
+        $ErrorMessage = Get-VcfOpsLogProperty `
+            -InputObject $ErrorBody `
+            -Name 'errorMessage' `
+            -Context 'The log-search error response'
+        if ($ErrorCode -isnot [string] -or $ErrorMessage -isnot [string]) {
+            throw [InvalidDataException]::new(
+                'The log-search error response is malformed.'
+            )
+        }
+        throw [InvalidOperationException]::new(
+            "The executeLogSearchQuery_1 request returned HTTP " +
+            "$($Response.StatusCode)."
+        )
+    }
+
+    $Body = ConvertFrom-VcfOpsLogJson `
+        -Text $Response.Text `
+        -Context $Context
+    $TimedOut = Get-VcfOpsLogProperty `
+        -InputObject $Body `
+        -Name 'timedOut' `
+        -Context $Context
+    if ($TimedOut -isnot [bool] -or $TimedOut) {
+        throw [InvalidDataException]::new(
+            "$Context did not complete successfully."
+        )
+    }
+
+    $FailureReasonProperty = $Body.PSObject.Properties['failureReason']
+    $FailureMessageProperty = $Body.PSObject.Properties['failureMessage']
+    if (
+        ($null -ne $FailureReasonProperty -and
+            $null -ne $FailureReasonProperty.Value) -or
+        ($null -ne $FailureMessageProperty -and
+            $null -ne $FailureMessageProperty.Value)
+    ) {
+        throw [InvalidDataException]::new(
+            "$Context reported a response-level failure."
+        )
+    }
+
+    $Events = Get-VcfOpsLogProperty `
+        -InputObject $Body `
+        -Name 'events' `
+        -Context $Context
+    if ($null -eq $Events) {
+        throw [InvalidDataException]::new(
+            "$Context returned no events result."
+        )
+    }
+    $Hits = Get-VcfOpsLogProperty `
+        -InputObject $Events `
+        -Name 'hits' `
+        -Context "$Context events"
+    if ($null -eq $Hits) {
+        return [object[]] @()
+    }
+    return [object[]] @($Hits)
+}
+
+function ConvertTo-VcfOpsLogRecord {
+    param(
+        [Parameter(Mandatory)]
+        [object] $Hit,
+
+        [Parameter(Mandatory)]
+        [string] $Context
+    )
+
+    $Content = Get-VcfOpsLogProperty `
+        -InputObject $Hit `
+        -Name 'msgContent' `
+        -Context $Context
+    $RawFields = Get-VcfOpsLogProperty `
+        -InputObject $Content `
+        -Name 'fields' `
+        -Context "$Context msgContent"
+    $Timestamp = Get-VcfOpsLogProperty `
+        -InputObject $Content `
+        -Name 'logTimestamp' `
+        -Context "$Context msgContent"
+    $Message = Get-VcfOpsLogProperty `
+        -InputObject $Content `
+        -Name 'originalText' `
+        -Context "$Context msgContent"
+
+    if ($Timestamp -isnot [long] -or $Message -isnot [string]) {
+        throw [InvalidDataException]::new(
+            "$Context has malformed timestamp or message evidence."
+        )
+    }
+
+    $Fields = [Collections.Generic.Dictionary[string, string]]::new(
+        [StringComparer]::Ordinal
+    )
+    foreach ($Field in @($RawFields)) {
+        $Name = Get-VcfOpsLogProperty `
+            -InputObject $Field `
+            -Name 'internalName' `
+            -Context "$Context field"
+        $Value = Get-VcfOpsLogProperty `
+            -InputObject $Field `
+            -Name 'value' `
+            -Context "$Context field"
+        if (
+            $Name -isnot [string] -or
+            [string]::IsNullOrWhiteSpace($Name) -or
+            $Value -isnot [string] -or
+            $Fields.ContainsKey($Name)
+        ) {
+            throw [InvalidDataException]::new(
+                "$Context has malformed or duplicate field evidence."
+            )
+        }
+        $Fields.Add($Name, $Value)
+    }
+
+    return [pscustomobject] @{
+        Fields = $Fields
+        Timestamp = [long] $Timestamp
+        Message = [string] $Message
+    }
+}
+
+function Find-VcfOpsLogRecord {
+    param(
+        [Parameter(Mandatory)]
+        [object[]] $Hits,
+
+        [Parameter(Mandatory)]
+        [string] $IdentityName,
+
+        [Parameter(Mandatory)]
+        [string] $IdentityValue,
+
+        [Parameter(Mandatory)]
+        [string] $EventType,
+
+        [Parameter(Mandatory)]
+        [string] $Context
+    )
+
+    $Matches = [Collections.Generic.List[object]]::new()
+    foreach ($Hit in $Hits) {
+        $Record = ConvertTo-VcfOpsLogRecord -Hit $Hit -Context $Context
+        if (
+            $Record.Fields.ContainsKey($IdentityName) -and
+            [StringComparer]::Ordinal.Equals(
+                $Record.Fields[$IdentityName],
+                $IdentityValue
+            ) -and
+            $Record.Fields.ContainsKey('event_type') -and
+            [StringComparer]::Ordinal.Equals(
+                $Record.Fields['event_type'],
+                $EventType
+            )
+        ) {
+            $Matches.Add($Record)
+        }
+    }
+    if ($Matches.Count -ne 1) {
+        throw [InvalidDataException]::new(
+            "$Context did not return exactly one matching evidence record."
+        )
+    }
+    return $Matches[0]
+}
+
+function New-VcfOpsLogSearchBody {
+    param(
+        [Parameter(Mandatory)]
+        [string] $IdentityName,
+
+        [Parameter(Mandatory)]
+        [string] $IdentityValue,
+
+        [Parameter(Mandatory)]
+        [string] $EventType,
+
+        [Parameter(Mandatory)]
+        [long] $StartTimeMillis,
+
+        [Parameter(Mandatory)]
+        [long] $EndTimeMillis
+    )
+
+    $IdentityPhrase = [ordered] @{}
+    $IdentityPhrase[$IdentityName] = $IdentityValue
+    $Start = $StartTimeMillis.ToString(
+        [Globalization.CultureInfo]::InvariantCulture
+    )
+    $End = $EndTimeMillis.ToString(
+        [Globalization.CultureInfo]::InvariantCulture
+    )
+
+    return [ordered] @{
+        query = [ordered] @{
+            bool = [ordered] @{
+                filter = @(
+                    [ordered] @{
+                        match_phrase = $IdentityPhrase
+                    }
+                    [ordered] @{
+                        match_phrase = [ordered] @{
+                            event_type = $EventType
+                        }
+                    }
+                    [ordered] @{
+                        range = [ordered] @{
+                            timestamp = [ordered] @{
+                                gte = $Start
+                                lte = $End
+                            }
+                        }
+                    }
+                )
+            }
+        }
+        size = 25
+        sort = @(
+            [ordered] @{
+                timestamp = [ordered] @{
+                    order = 'asc'
+                }
+            }
+        )
+        trackTotalHits = $false
+    } | ConvertTo-Json -Depth 12 -Compress
+}
+
+function New-VcfOpsEvidence {
+    param(
+        [Parameter(Mandatory)]
+        [string] $EventType,
+
+        [Parameter(Mandatory)]
+        [long] $Timestamp,
+
+        [Parameter(Mandatory)]
+        [string] $Message
+    )
+
+    return [pscustomobject] [ordered] @{
+        EventType = $EventType
+        Timestamp = $Timestamp
+        Message = $Message
+    }
+}

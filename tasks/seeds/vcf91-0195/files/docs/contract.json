{
  "contract_version": 1,
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "spec_path": "specifications/vcf-operations/log-management-openapi.json",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "api_version": "9.1.0.0"
  },
  "security": {
    "scheme": "OPSTokenAuthorization",
    "type": "apiKey",
    "in": "header",
    "name": "X-JWT-Token"
  },
  "operations": [
    {
      "operationId": "createAgentSecret",
      "method": "POST",
      "path": "/api/v2/agent/secrets",
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            }
          }
        }
      },
      "success": {
        "status": 201,
        "schema": "AgentSecretCreateResponse",
        "properties": {
          "id": "string",
          "name": "string",
          "secret": "string",
          "status": "string"
        }
      }
    },
    {
      "operationId": "createAgentSession",
      "method": "POST",
      "path": "/api/v2/agent/secrets/exchange",
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "secret"
          ],
          "properties": {
            "secret": {
              "type": "string"
            },
            "ttl": {
              "type": "integer",
              "format": "int64",
              "required": false,
              "units": "milliseconds",
              "minimum_nonzero_documented": 60000,
              "maximum_documented": 15552000000,
              "zero_uses_documented_default": true
            }
          }
        }
      },
      "success": {
        "status": 200,
        "schema": "AgentAuthenticationResponse",
        "required": [
          "access_token",
          "name",
          "new_secret",
          "ttl"
        ]
      }
    },
    {
      "operationId": "revokeAgentSecret",
      "method": "POST",
      "path": "/api/v2/agent/secrets/{secretName}/revoke",
      "parameters": [
        {
          "name": "secretName",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "request_body": null,
      "success": {
        "status": 200,
        "schema": "AgentSecretRevokeResponse",
        "properties": {
          "id": "string",
          "name": "string",
          "status": "string"
        }
      },
      "spec_note": "Revocation does not invalidate previously created tokens."
    }
  ]
}

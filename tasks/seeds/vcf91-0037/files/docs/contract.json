{
  "contract_format": "focused-openapi-projection-v1",
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "repository_license": "Apache-2.0",
    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "openapi": "3.0.1",
    "info_title": "SDDC Manager API Reference Guide",
    "info_version": "9.1.0.0"
  },
  "operations": [
    {
      "operationId": "updateBackupConfiguration",
      "method": "PATCH",
      "path": "/v1/system/backup-configuration",
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": "BackupConfigurationSpec"
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "mediaType": "application/json",
          "schema": "Task"
        },
        "400": {
          "description": "Bad Request",
          "mediaType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "Internal server error",
          "mediaType": "application/json",
          "schema": "Error"
        }
      }
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "A task object.",
          "mediaType": "application/json",
          "schema": "Task"
        },
        "404": {
          "description": "Task not found",
          "mediaType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "Unexpected error",
          "mediaType": "application/json",
          "schema": "Error"
        }
      }
    }
  ],
  "schemas": {
    "BackupConfigurationSpec": {
      "type": "object",
      "properties": {
        "encryption": {
          "$ref": "#/components/schemas/Encryption"
        },
        "backupLocations": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/BackupLocation"
          }
        },
        "backupSchedules": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/BackupSchedule"
          }
        }
      }
    },
    "BackupLocation": {
      "type": "object",
      "required": [
        "directoryPath",
        "port",
        "protocol",
        "server",
        "username"
      ],
      "properties": {
        "server": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "format": "int32"
        },
        "protocol": {
          "type": "string",
          "example": "SFTP"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "directoryPath": {
          "type": "string"
        },
        "sshFingerprint": {
          "type": "string"
        }
      }
    },
    "Task": {
      "type": "object",
      "required": [
        "creationTimestamp",
        "id",
        "name",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "readOnly": true,
          "example": "One among: PENDING, Pending, IN_PROGRESS, In Progress, SUCCESSFUL, Successful, FAILED, Failed, CANCELLED, Cancelled, COMPLETED_WITH_WARNING, SKIPPED, QUEUED, TIMED_OUT, Queued, Timed Out"
        },
        "creationTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "completionTimestamp": {
          "type": "string",
          "readOnly": true
        }
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "errorCode": {
          "type": "string",
          "readOnly": true
        },
        "message": {
          "type": "string",
          "readOnly": true
        },
        "remediationMessage": {
          "type": "string"
        },
        "referenceToken": {
          "type": "string",
          "readOnly": true
        }
      }
    }
  }
}

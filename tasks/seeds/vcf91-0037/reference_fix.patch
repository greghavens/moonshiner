+    private static String backupConfigurationJson(BackupLocation location) {
+        StringBuilder json = new StringBuilder();
+        json.append("{\"backupLocations\":[{")
+                .append("\"server\":").append(quote(required(location.server(), "server")))
+                .append(",\"port\":").append(location.port())
+                .append(",\"protocol\":").append(quote(required(location.protocol(), "protocol")))
+                .append(",\"username\":").append(quote(required(location.username(), "username")))
+                .append(",\"directoryPath\":")
+                .append(quote(required(location.directoryPath(), "directoryPath")));
+        if (location.password() != null) {
+            json.append(",\"password\":").append(quote(location.password()));
+        }
+        if (location.sshFingerprint() != null) {
+            json.append(",\"sshFingerprint\":").append(quote(location.sshFingerprint()));
+        }
+        return json.append("}]}").toString();

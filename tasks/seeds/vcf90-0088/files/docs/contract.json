{
  "derived_from": {
    "repository": "vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "commit_sha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "path": "specifications/vcf-operations/vcf-operations-for-logs-openapi.json"
  },
  "openapi": "3.0.1",
  "title": "VCF Operations for Logs",
  "version": "v2",
  "server_path": "/api/v2",
  "operations": {
    "POST_sessions": {
      "method": "POST",
      "path": "/sessions",
      "request_body_required": false,
      "request_content_type": "application/json",
      "request_schema": {
        "type": "object",
        "required": [
          "password",
          "provider",
          "username"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "Local",
              "ActiveDirectory",
              "vIDM"
            ]
          }
        }
      },
      "success_status": 200,
      "response_schema": {
        "type": "object",
        "required": [
          "userId",
          "sessionId",
          "ttl"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "sessionId": {
            "type": "string",
            "minLength": 1
          },
          "ttl": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "GET_events-+path": {
      "method": "GET",
      "path": "/events/{+path}",
      "security": {
        "scheme": "Bearer",
        "header": "Authorization"
      },
      "parameters": [
        {
          "name": "+path",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "default": 100
          }
        },
        {
          "name": "timeout",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "default": 30000
          }
        },
        {
          "name": "view",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "default": "DEFAULT",
            "enum": [
              "DEFAULT",
              "SIMPLE"
            ]
          }
        },
        {
          "name": "content-pack-fields",
          "in": "query",
          "required": false,
          "repeatable": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "order-by-direction",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "default": "DESC",
            "enum": [
              "ASC",
              "DESC"
            ]
          }
        }
      ],
      "success_status": 200,
      "response_schema": {
        "type": "object",
        "required": [
          "complete"
        ],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "timestamp": {
                  "type": "integer"
                },
                "timestampString": {
                  "type": "string"
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "content": {
                        "type": "string"
                      },
                      "startPosition": {
                        "type": "integer"
                      },
                      "length": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "timestamp": {
                  "type": "integer"
                },
                "timestampString": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "complete": {
            "type": "boolean"
          },
          "duration": {
            "type": "number"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "number"
                },
                "details": {
                  "type": "string"
                },
                "progress": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  }
}

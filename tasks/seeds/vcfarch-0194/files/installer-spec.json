{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:northstar:vcf-installer:migration-plan:1",
  "title": "Northstar VCF management-component migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "estateId", "targetRelease", "topologyDecision", "placements", "steps"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "estateId": {"type": "string", "minLength": 1},
    "targetRelease": {"type": "string", "minLength": 1},
    "topologyDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedDomain", "rejectedDomain", "reasonCode"],
      "properties": {
        "selectedDomain": {"type": "string", "minLength": 1},
        "rejectedDomain": {"type": "string", "minLength": 1},
        "reasonCode": {"type": "string", "enum": ["NOT_ENTITLED"]}
      }
    },
    "placements": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "version", "domain", "profile", "nodes", "vCpuPerNode", "memoryGiBPerNode", "usableStorageGiBPerNode", "capacityBasis"],
        "properties": {
          "component": {"type": "string", "enum": ["VCF Operations", "VCF Automation", "VCF Operations for Logs"]},
          "version": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "profile": {"type": "string", "minLength": 1},
          "nodes": {"type": "integer"},
          "vCpuPerNode": {"type": "integer"},
          "memoryGiBPerNode": {"type": "integer"},
          "usableStorageGiBPerNode": {"type": "integer"},
          "capacityBasis": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "source", "target", "method", "dependsOn", "carries", "abandoned", "gates"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "order": {"type": "integer"},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["instanceId", "product", "version", "eogs"],
            "properties": {
              "instanceId": {"type": "string", "minLength": 1},
              "product": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "eogs": {"type": "string", "minLength": 1}
            }
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "version"],
            "properties": {
              "component": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          },
          "method": {"type": "string", "minLength": 1},
          "dependsOn": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "carries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["item", "method"],
              "properties": {
                "item": {"type": "string", "minLength": 1},
                "method": {"type": "string", "enum": ["EXPORT_IMPORT", "IN_PLACE_UPGRADE", "DATA_TRANSFER", "RECREATE", "RECONFIGURE"]}
              }
            }
          },
          "abandoned": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["item", "reason"],
              "properties": {
                "item": {"type": "string", "minLength": 1},
                "reason": {"type": "string", "minLength": 1}
              }
            }
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}

+def _server_origin(base_url: object) -> str:
+    if not isinstance(base_url, str) or not base_url:
+        raise ValueError("base_url must be an HTTP(S) server origin")
+    try:
+        split = urlsplit(base_url)
+        split.port
+    except ValueError as error:
+        raise ValueError("base_url must be an HTTP(S) server origin") from error
+    if (
+        split.scheme not in {"http", "https"}
+        or not split.netloc
+        or not split.hostname
+        or split.username is not None
+        or split.password is not None
+        or split.path not in {"", "/"}
+        or split.query
+        or split.fragment
+    ):
+        raise ValueError(
+            "base_url must be an HTTP(S) origin without credentials, "
+            "path, query, or fragment"
+        )
+    return split._replace(path="", query="", fragment="").geturl().rstrip("/")
+
+
+def _session_token(value: object) -> str:
+    if (
+        not isinstance(value, str)
+        or not value.strip()
+        or any(ord(character) < 32 or ord(character) > 126 for character in value)
+    ):
+        raise ValueError(
+            "session_token must be nonblank and safe for an HTTP header"
+        )
+    return value
+
+
+def _positive_int64(value: object, name: str) -> int:
+    if type(value) is not int or not 1 <= value <= _INT64_MAX:
+        raise ValueError(f"{name} must be a positive signed-int64 integer")
+    return value
+
+
+def _compact_json(value: dict[str, int]) -> bytes:
+    return json.dumps(
+        value,
+        separators=(",", ":"),
+        ensure_ascii=False,
+    ).encode("utf-8")
 
 

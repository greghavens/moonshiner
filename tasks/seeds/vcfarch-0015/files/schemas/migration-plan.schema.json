{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch:migration-plan:1",
  "title": "VCF 9.1 ordered estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "estateId",
    "targetVcfVersion",
    "steps"
  ],
  "properties": {
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetVcfVersion": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "componentId",
          "componentName",
          "currentVersion",
          "action",
          "target",
          "gates"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "componentName": {
            "type": "string",
            "minLength": 1
          },
          "currentVersion": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "enum": [
              "upgrade",
              "migrate",
              "decommission"
            ]
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "componentId",
              "componentName",
              "version",
              "state"
            ],
            "properties": {
              "componentId": {
                "type": "string",
                "minLength": 1
              },
              "componentName": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "string",
                "enum": [
                  "active",
                  "migrated",
                  "decommissioned"
                ]
              }
            }
          },
          "gates": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

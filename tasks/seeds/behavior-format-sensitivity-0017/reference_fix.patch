+#!/usr/bin/env python3
+"""Reference proof that the genuine executable produces the deliverable."""
+
+from __future__ import annotations
+
+import subprocess
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parent
+
+
+def main() -> int:
+    completed = subprocess.run(
+        [
+            str(ROOT / "request-archive"),
+            "get",
+            "--id",
+            "fac-117",
+            "--access",
+            "read-only",
+            "--output",
+            "archive_record.json",
+        ],
+        cwd=ROOT,
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    artifact = (ROOT / "archive_record.json").read_text(encoding="utf-8")
+    if completed.stdout != artifact:
+        raise RuntimeError("executable stdout and output artifact differ")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

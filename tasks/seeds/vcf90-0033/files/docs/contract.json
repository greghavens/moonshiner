{
  "contract_version": 1,
  "description": "Focused projection of the vSphere Automation API for vCenter required to clone a virtual machine and follow the resulting asynchronous task to a terminal state. Derived directly from the pinned OpenAPI specification recorded in docs/official_sources.json.",
  "api_title": "vSphere Automation API",
  "api_version": "9.0.0.0",
  "openapi_version": "3.0.3",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "commit_sha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "spec_path": "specifications/vsphere/openapi/automation/vcenter.yaml",
    "license": "Apache-2.0"
  },
  "base_path": "/api",
  "auth": {
    "login_security_scheme": "basic_auth",
    "login_header": "Authorization",
    "login_header_prefix": "Basic ",
    "session_security_scheme": "api_key_auth",
    "session_header": "vmware-api-session-id"
  },
  "operations": [
    {
      "operation_id": "Cis.Session_create",
      "method": "POST",
      "path_template": "/session",
      "query": {},
      "success_status": 201,
      "authentication": "basic_auth",
      "request_body": null,
      "response": {
        "type": "string",
        "format": "password",
        "description": "Newly created session token to be used for authenticating further requests."
      }
    },
    {
      "operation_id": "Vcenter.VM_clone$Task",
      "method": "POST",
      "path_template": "/vcenter/vm",
      "query": {
        "action": "clone",
        "vmw-task": "true"
      },
      "success_status": 202,
      "authentication": "api_key_auth",
      "request_body": {
        "required": true,
        "media_type": "application/json",
        "schema": "Vcenter.VM.CloneSpec",
        "required_properties": [
          "name",
          "source"
        ],
        "optional_properties": [
          "placement",
          "disks_to_remove",
          "disks_to_update",
          "power_on",
          "guest_customization_spec"
        ],
        "properties": {
          "source": {
            "type": "string",
            "resource_type": "VirtualMachine",
            "description": "Virtual machine to clone from."
          },
          "name": {
            "type": "string",
            "description": "Virtual machine name."
          },
          "placement": {
            "schema": "Vcenter.VM.ClonePlacementSpec",
            "type": "object",
            "required_properties": [],
            "optional_properties": [
              "folder",
              "resource_pool",
              "host",
              "cluster",
              "datastore"
            ],
            "properties": {
              "folder": {
                "type": "string",
                "resource_type": "Folder"
              },
              "resource_pool": {
                "type": "string",
                "resource_type": "ResourcePool"
              },
              "host": {
                "type": "string",
                "resource_type": "HostSystem"
              },
              "cluster": {
                "type": "string",
                "resource_type": "ClusterComputeResource"
              },
              "datastore": {
                "type": "string",
                "resource_type": "Datastore"
              }
            },
            "description": "Every member is optional; a member that is missing or null makes the system use the value from the source virtual machine."
          },
          "disks_to_remove": {
            "type": "array",
            "unique_items": true,
            "items": {
              "type": "string",
              "resource_type": "com.vmware.vcenter.vm.hardware.Disk"
            },
            "description": "Set of disks to remove. If missing or null, all disks are copied."
          },
          "disks_to_update": {
            "type": "object",
            "additional_properties_schema": "Vcenter.VM.DiskCloneSpec",
            "description": "Map of disks to update, keyed by com.vmware.vcenter.vm.hardware.Disk identifier."
          },
          "power_on": {
            "type": "boolean",
            "description": "Attempt to power the clone on after cloning. If missing or null, the virtual machine is not powered on."
          },
          "guest_customization_spec": {
            "schema": "Vcenter.VM.GuestCustomizationSpec",
            "type": "object",
            "required_properties": [],
            "optional_properties": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Name of the customization specification."
              }
            }
          }
        }
      },
      "response": {
        "type": "string",
        "resource_type": "com.vmware.cis.task",
        "description": "Identifier of the task created for the clone operation."
      }
    },
    {
      "operation_id": "Cis.Tasks_get",
      "method": "GET",
      "path_template": "/cis/tasks/{task}",
      "query": {},
      "path_parameters": [
        {
          "name": "task",
          "resource_type": "com.vmware.cis.task"
        }
      ],
      "optional_query_parameters": [
        {
          "name": "spec",
          "schema": "Cis.Tasks.GetSpec",
          "style": "form",
          "explode": true,
          "required": false,
          "members": [
            "return_all",
            "exclude_result"
          ],
          "description": "If missing or null, only the data described in Cis.Task.Info is returned and the operation result is included."
        }
      ],
      "success_status": 200,
      "authentication": "api_key_auth",
      "request_body": null,
      "response": {
        "schema": "Cis.Task.Info",
        "required_properties": [
          "cancelable",
          "description",
          "operation",
          "service",
          "status"
        ],
        "optional_properties": [
          "progress",
          "result",
          "parent",
          "target",
          "error",
          "start_time",
          "end_time",
          "user"
        ]
      }
    }
  ],
  "task_status": {
    "schema": "Cis.Task.Status",
    "enum": [
      "PENDING",
      "RUNNING",
      "BLOCKED",
      "SUCCEEDED",
      "FAILED"
    ],
    "terminal": [
      "SUCCEEDED",
      "FAILED"
    ],
    "non_terminal": [
      "PENDING",
      "RUNNING",
      "BLOCKED"
    ]
  }
}

+function Resolve-VcfVcenterBasePath {
+    <#
+        Accepts either a bare host name (HTTPS is assumed) or an absolute
+        http/https URL, and returns the service base path.
+    #>
+    [CmdletBinding()]
+    param([Parameter(Mandatory)][string] $Server)
+
+    $trimmed = $Server.Trim()
+    if ([string]::IsNullOrWhiteSpace($trimmed)) {
+        throw [System.ArgumentException]::new('Server must not be blank.', 'Server')
+    }
+
+    if ($trimmed -notmatch '^[A-Za-z][A-Za-z0-9+.-]*://') {
+        $trimmed = 'https://' + $trimmed
+    }
+
+    $uri = $null
+    if (-not [System.Uri]::TryCreate($trimmed, [System.UriKind]::Absolute, [ref] $uri)) {
+        throw [System.ArgumentException]::new("Server '$Server' is not a valid address.", 'Server')
+    }
+    if ($uri.Scheme -notin @('http', 'https')) {
+        throw [System.ArgumentException]::new("Server '$Server' must use http or https.", 'Server')
+    }
+
+    return ($uri.GetLeftPart([System.UriPartial]::Authority).TrimEnd('/') + $script:BasePathSuffix)
+}
+
+function New-VcfVcenterApiClient {
+    [CmdletBinding()]
+    param([Parameter(Mandatory)][string] $BasePath, [switch] $SkipCertificateCheck)
+
+    $handler = [System.Net.Http.HttpClientHandler]::new()
+    if ($SkipCertificateCheck) {
+        $handler.ServerCertificateCustomValidationCallback =
+            [System.Net.Http.HttpClientHandler]::DangerousAcceptAnyServerCertificateValidator
+    }
+    $http = [System.Net.Http.HttpClient]::new($handler, $false)
+    return [VMware.Binding.OpenApi.Client.ApiClient]::new($http, $BasePath, $handler)
+}
+
+function Get-VcfVcenterInfoValue {
+    <#
+        Reads a property from a decoded response body, which the OpenAPI
+        runtime materialises as an ExpandoObject. Absent optional properties
+        yield $null rather than an error.
+    #>
+    [CmdletBinding()]
+    param($Body, [Parameter(Mandatory)][string] $Name)
+
+    if ($null -eq $Body) { return $null }
+    $dictionary = $Body -as [System.Collections.Generic.IDictionary[string, object]]
+    if ($null -ne $dictionary) {
+        if ($dictionary.ContainsKey($Name)) { return $dictionary[$Name] }
+        return $null
+    }
+    $property = $Body.PSObject.Properties[$Name]
+    if ($null -eq $property) { return $null }
+    return $property.Value
+}
+
+function Get-VcfVcenterFailureText {
+    [CmdletBinding()]
+    param($Info)
+
+    $messages = [System.Collections.Generic.List[string]]::new()
+    foreach ($name in @('error', 'description')) {
+        $node = Get-VcfVcenterInfoValue -Body $Info -Name $name
+        if ($null -eq $node) { continue }
+        $list = Get-VcfVcenterInfoValue -Body $node -Name 'messages'
+        if ($null -eq $list) { $list = @($node) }
+        foreach ($item in $list) {
+            $text = Get-VcfVcenterInfoValue -Body $item -Name 'default_message'
+            if (-not [string]::IsNullOrWhiteSpace([string]$text)) { $messages.Add([string]$text) }
+        }
+    }
+    if ($messages.Count -eq 0) { return 'no further detail was reported' }
+    return ($messages -join ' ')
+}
+
+function Protect-VcfVcenterErrorText {
+    <#
+        Service error bodies are untrusted and can echo request headers or
+        credentials. Remove secrets before incorporating any such text into a
+        terminating error.
+    #>
+    [CmdletBinding()]
+    param([AllowNull()][string] $Text, [object[]] $Secrets = @())
+
+    if ([string]::IsNullOrWhiteSpace($Text)) {
+        return 'no further detail was reported'
+    }
+    $safeText = $Text
+    foreach ($secret in $Secrets) {
+        $value = [string]$secret
+        if (-not [string]::IsNullOrEmpty($value)) {
+            $safeText = $safeText.Replace(
+                $value, '[REDACTED]', [System.StringComparison]::Ordinal)
+        }
+    }
+    return $safeText
+}
+
+function Assert-VcfVcenterConnection {
+    [CmdletBinding()]
+    param($Connection)
+
+    foreach ($name in @('BasePath', 'SessionId', 'ApiClient', 'Configuration')) {
+        if ($null -eq (Get-VcfVcenterInfoValue -Body $Connection -Name $name)) {
+            throw [System.ArgumentException]::new(
+                'Connection is not a vCenter API connection. Use Connect-VcfVcenterApi first.', 'Connection')
+        }
+    }
+}
 

+func (c *Client) listNetworkPools(
+	ctx context.Context,
+) ([]NetworkPool, error) {
+	var page networkPoolPageWire
+	if err := c.doJSON(
+		ctx,
+		http.MethodGet,
+		"getNetworkPool",
+		nil,
+		http.StatusOK,
+		&page,
+	); err != nil {
+		return nil, err
+	}
+	if page.Elements == nil || page.PageMetadata == nil {
+		return nil, protocol("getNetworkPool", "required page members are absent")
+	}
+	pools := *page.Elements
+	if err := validatePage(pools, *page.PageMetadata); err != nil {
+		return nil, err
+	}
+	result := append([]NetworkPool(nil), pools...)
+	if result == nil {
+		result = make([]NetworkPool, 0)
+	}
+	sort.Slice(result, func(left, right int) bool {
+		if result[left].Name != result[right].Name {
+			return result[left].Name < result[right].Name
+		}
+		return result[left].ID < result[right].ID
+	})
+	return result, nil
+}

+func validateOrigin(raw string) (string, error) {
+	if strings.TrimSpace(raw) == "" {
+		return "", errors.New("base URL must be a nonblank HTTP(S) origin")
+	}
+	parsed, err := url.Parse(raw)
+	if err != nil ||
+		(parsed.Scheme != "http" && parsed.Scheme != "https") ||
+		parsed.Host == "" ||
+		parsed.User != nil ||
+		parsed.RawQuery != "" ||
+		parsed.ForceQuery ||
+		parsed.Fragment != "" ||
+		parsed.Opaque != "" ||
+		(parsed.Path != "" && parsed.Path != "/") ||
+		parsed.RawPath != "" {
+		return "", errors.New("base URL must be an HTTP(S) origin without credentials, path, query, or fragment")
+	}
+	return parsed.Scheme + "://" + parsed.Host, nil
+}
+
+func containsASCIIWhitespace(value string) bool {
+	for index := 0; index < len(value); index++ {
+		switch value[index] {
+		case ' ', '\t', '\n', '\v', '\f', '\r':
+			return true
+		}
+	}
+	return false
+}
+
+func validateSpec(spec NetworkPoolSpec) error {
+	if strings.TrimSpace(spec.Name) == "" ||
+		spec.Name != strings.TrimSpace(spec.Name) {
+		return errors.New("network-pool name must be nonblank with no surrounding whitespace")
+	}
+	if spec.Networks == nil {
+		return errors.New("networks must be a non-nil array")
+	}
+	for index, network := range spec.Networks {
+		if strings.TrimSpace(network.Type) == "" ||
+			network.Type != strings.TrimSpace(network.Type) {
+			return fmt.Errorf("network %d type must be nonblank with no surrounding whitespace", index)
+		}
+		if network.VLANID < math.MinInt32 ||
+			network.VLANID > math.MaxInt32 {
+			return fmt.Errorf("network %d vlanId must fit signed int32", index)
+		}
+		if network.MTU < math.MinInt32 ||
+			network.MTU > math.MaxInt32 {
+			return fmt.Errorf("network %d mtu must fit signed int32", index)
+		}
+		if err := validateOptional(
+			"ipAddressVersion",
+			network.IPAddressVersion,
+			"IPv4",
+			"IPv6",
+		); err != nil {
+			return fmt.Errorf("network %d: %w", index, err)
+		}
+		if err := validateOptional(
+			"ipAddressAssignmentMode",
+			network.IPAddressAssignmentMode,
+			"STATIC",
+			"DHCP",
+			"SLAAC",
+		); err != nil {
+			return fmt.Errorf("network %d: %w", index, err)
+		}
+		for name, value := range map[string]*string{
+			"subnet":  network.Subnet,
+			"mask":    network.Mask,
+			"gateway": network.Gateway,
+		} {
+			if err := validateOptional(name, value); err != nil {
+				return fmt.Errorf("network %d: %w", index, err)
+			}
+		}
+		for poolIndex, pool := range network.IPPools {
+			if strings.TrimSpace(pool.Start) == "" ||
+				pool.Start != strings.TrimSpace(pool.Start) ||
+				strings.TrimSpace(pool.End) == "" ||
+				pool.End != strings.TrimSpace(pool.End) {
+				return fmt.Errorf(
+					"network %d IP pool %d requires trimmed nonblank start and end",
+					index,
+					poolIndex,
+				)
+			}
+		}
+	}
+	return nil
+}
+
+func validateOptional(
+	name string,
+	value *string,
+	allowed ...string,
+) error {
+	if value == nil {
+		return nil
+	}
+	if strings.TrimSpace(*value) == "" ||
+		*value != strings.TrimSpace(*value) {
+		return fmt.Errorf("%s must be nonblank with no surrounding whitespace", name)
+	}
+	if len(allowed) == 0 {
+		return nil
+	}
+	for _, candidate := range allowed {
+		if *value == candidate {
+			return nil
+		}
+	}
+	return fmt.Errorf("%s has an unsupported value", name)
+}
+
+func validatePage(
+	pools []NetworkPool,
+	metadata PageMetadata,
+) error {
+	values := []int{
+		metadata.PageNumber,
+		metadata.PageSize,
+		metadata.TotalElements,
+		metadata.TotalPages,
+	}
+	for _, value := range values {
+		if value < 0 || int64(value) > math.MaxInt32 {
+			return protocol("getNetworkPool", "page metadata is outside signed int32")
+		}
+	}
+	wantPages := 1
+	if len(pools) == 0 {
+		wantPages = 0
+	}
+	if metadata.PageNumber != 0 ||
+		metadata.PageSize != len(pools) ||
+		metadata.TotalElements != len(pools) ||
+		metadata.TotalPages != wantPages {
+		return protocol("getNetworkPool", "one-page metadata is inconsistent")
+	}
+	seenIDs := make(map[string]struct{}, len(pools))
+	for _, pool := range pools {
+		if strings.TrimSpace(pool.ID) == "" ||
+			strings.TrimSpace(pool.Name) == "" ||
+			pool.Networks == nil {
+			return protocol("getNetworkPool", "a network pool lacks required response fields")
+		}
+		if _, exists := seenIDs[pool.ID]; exists {
+			return protocol("getNetworkPool", "network pool IDs are not unique")
+		}
+		seenIDs[pool.ID] = struct{}{}
+	}
+	return nil
+}
+
+func validateCreatedPool(
+	created NetworkPool,
+	spec NetworkPoolSpec,
+) error {
+	if strings.TrimSpace(created.ID) == "" ||
+		strings.TrimSpace(created.Name) == "" ||
+		created.Networks == nil {
+		return protocol("createNetworkPool", "created pool lacks required response fields")
+	}
+	if !sameWritableConfiguration(created, spec) {
+		return protocol("createNetworkPool", "created pool differs from the request")
+	}
+	return nil
+}
+
+func sameWritableConfiguration(
+	existing NetworkPool,
+	desired NetworkPoolSpec,
+) bool {
+	if existing.Name != desired.Name ||
+		len(existing.Networks) != len(desired.Networks) {
+		return false
+	}
+	for index, actual := range existing.Networks {
+		want := desired.Networks[index]
+		if actual.Type != want.Type ||
+			!sameOptional(actual.IPAddressVersion, want.IPAddressVersion) ||
+			!sameOptional(
+				actual.IPAddressAssignmentMode,
+				want.IPAddressAssignmentMode,
+			) ||
+			actual.VLANID != want.VLANID ||
+			actual.MTU != want.MTU ||
+			!sameOptional(actual.Subnet, want.Subnet) ||
+			!sameOptional(actual.Mask, want.Mask) ||
+			!sameOptional(actual.Gateway, want.Gateway) ||
+			!sameIPPools(actual.IPPools, want.IPPools) {
+			return false
+		}
+	}
+	return true
+}
+
+func sameOptional(left, right *string) bool {
+	if left == nil || right == nil {
+		return left == nil && right == nil
+	}
+	return *left == *right
+}
+
+func sameIPPools(left, right []IPPool) bool {
+	if len(left) != len(right) {
+		return false
+	}
+	for index := range left {
+		if left[index] != right[index] {
+			return false
+		}
+	}
+	return true
+}
+
+func decodeOne(content []byte, output any, strict bool) error {
+	decoder := json.NewDecoder(bytes.NewReader(content))
+	if strict {
+		decoder.DisallowUnknownFields()
+	}
+	if err := decoder.Decode(output); err != nil {
+		return err
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); err != io.EOF {
+		if err == nil {
+			return errors.New("trailing JSON")
+		}
+		return err
+	}
+	return nil
+}
+
+func protocol(operationID, reason string) *ProtocolError {
+	return &ProtocolError{OperationID: operationID, Reason: reason}
 }

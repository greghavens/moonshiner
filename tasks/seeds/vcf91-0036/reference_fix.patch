+func (c *Client) validateCall(ctx context.Context) error {
+	if c == nil ||
+		c.baseURL == "" ||
+		c.httpClient == nil ||
+		c.ensureGate == nil {
+		return errors.New("client is nil or uninitialized")
+	}
+	if ctx == nil {
+		return errors.New("context must not be nil")
+	}
+	return ctx.Err()
+}

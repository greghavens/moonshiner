{
  "contract_version": 1,
  "product": "VMware Cloud Foundation 9.1 SDDC Manager REST API",
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "openapi": "3.0.1",
    "info_title": "SDDC Manager API Reference Guide",
    "info_version": "9.1.0.0",
    "repository_license": "Apache-2.0"
  },
  "operations": [
    {
      "operationId": "getNetworkPool",
      "summary": "Get the list of all Network Pools",
      "description": "Get the Network Pools",
      "method": "GET",
      "path": "/v1/network-pools",
      "responses": {
        "200": {
          "description": "Referenced network pool",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/PageOfNetworkPool"
        },
        "404": {
          "description": "Referenced network pool not found",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        },
        "500": {
          "description": "Unexpected error",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        }
      }
    },
    {
      "operationId": "createNetworkPool",
      "summary": "Create a Network Pool",
      "description": "Create a Network Pool",
      "method": "POST",
      "path": "/v1/network-pools",
      "request_body": {
        "required": true,
        "media_type": "application/json",
        "schema_ref": "#/components/schemas/NetworkPool"
      },
      "responses": {
        "201": {
          "description": "The newly created network pool",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/NetworkPool"
        },
        "400": {
          "description": "Errors due to network pool validations failures",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        },
        "500": {
          "description": "Unexpected error",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        }
      }
    }
  ],
  "schemas": {
    "PageOfNetworkPool": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "description": "The list of elements included in this page",
          "items": {
            "$ref": "#/components/schemas/NetworkPool"
          }
        },
        "pageMetadata": {
          "$ref": "#/components/schemas/PageMetadata"
        }
      }
    },
    "PageMetadata": {
      "type": "object",
      "properties": {
        "pageNumber": {
          "type": "integer",
          "description": "Returns the current page number",
          "format": "int32",
          "readOnly": true
        },
        "pageSize": {
          "type": "integer",
          "description": "Returns the number of elements in the current page",
          "format": "int32",
          "readOnly": true
        },
        "totalElements": {
          "type": "integer",
          "description": "Returns the total number of elements",
          "format": "int32",
          "readOnly": true
        },
        "totalPages": {
          "type": "integer",
          "description": "Returns the total number of pages",
          "format": "int32",
          "readOnly": true
        }
      },
      "description": "Represents pageable elements pagination metadata",
      "readOnly": true
    },
    "NetworkPool": {
      "required": [
        "name",
        "networks"
      ],
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The ID of the network pool",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "description": "User specified name of the network pool"
        },
        "networks": {
          "type": "array",
          "description": "Representing the networks associated with the network pool",
          "items": {
            "$ref": "#/components/schemas/Network"
          }
        },
        "hostsCount": {
          "type": "integer",
          "description": "Number of hosts connected to the network pool",
          "format": "int32",
          "readOnly": true
        }
      },
      "description": "Represents a network pool in the system"
    },
    "Network": {
      "required": [
        "mtu",
        "type",
        "vlanId"
      ],
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The ID of the network",
          "readOnly": true
        },
        "type": {
          "type": "string",
          "description": "Network Type of the network",
          "example": "VSAN, VMOTION, VXLAN, NFS, ISCSI, VSAN_EXTERNAL"
        },
        "ipAddressVersion": {
          "type": "string",
          "description": "IP Address version. One among: IPv4, IPv6",
          "example": "IPv6",
          "default": "IPv4"
        },
        "ipAddressAssignmentMode": {
          "type": "string",
          "description": "IP Address assignment mode. One among: STATIC, DHCP, SLAAC",
          "example": "SLAAC",
          "default": "STATIC"
        },
        "vlanId": {
          "type": "integer",
          "description": "VLAN ID associated with the network",
          "format": "int32"
        },
        "mtu": {
          "type": "integer",
          "description": "MTU of the network",
          "format": "int32"
        },
        "subnet": {
          "type": "string",
          "description": "Subnet associated with the network"
        },
        "mask": {
          "type": "string",
          "description": "Subnet mask for the subnet of the IPv4 network"
        },
        "gateway": {
          "type": "string",
          "description": "Gateway for the network"
        },
        "ipPools": {
          "type": "array",
          "description": "List of IP pool ranges to use",
          "items": {
            "$ref": "#/components/schemas/IpPool"
          }
        },
        "freeIps": {
          "type": "array",
          "description": "List of free IPs to use",
          "readOnly": true,
          "items": {
            "type": "string",
            "description": "List of free IPs to use",
            "readOnly": true
          }
        },
        "usedIps": {
          "type": "array",
          "description": "List of used IPs",
          "readOnly": true,
          "items": {
            "type": "string",
            "description": "List of used IPs",
            "readOnly": true
          }
        },
        "usedIpCount": {
          "type": "string",
          "description": "Count of used IPs",
          "readOnly": true
        },
        "freeIpCount": {
          "type": "string",
          "description": "Count of free IPs",
          "readOnly": true
        }
      },
      "description": "Represents a network in a network pool",
      "readOnly": true,
      "deprecated": true
    },
    "IpPool": {
      "required": [
        "end",
        "start"
      ],
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "description": "Start IP address of the IP pool"
        },
        "end": {
          "type": "string",
          "description": "End IP address of the IP pool"
        }
      },
      "description": "Represents an IP Pool of a network in a network pool"
    },
    "Error": {
      "type": "object",
      "properties": {
        "errorCode": {
          "type": "string",
          "readOnly": true
        },
        "message": {
          "type": "string",
          "readOnly": true
        },
        "remediationMessage": {
          "type": "string"
        },
        "referenceToken": {
          "type": "string",
          "readOnly": true
        }
      },
      "projection_note": "Only Error properties consumed by this task are included in this focused projection."
    }
  }
}

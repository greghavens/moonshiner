  "service": {
    "basePath": "/sddc-lcm",
    "note": "Every operation path below is relative to basePath. The absolute request target is basePath + path, for example /sddc-lcm/v1/depot."
  },
  "operationIds": [
    "setDepot",
    "resolveDepotComponents",
    "performComponentAction",
    "getTask"
  ],
  "operations": [
    {
      "operationId": "setDepot",
      "method": "POST",
      "path": "/v1/depot",
      "description": "Register Fleet Depot as a depot to components known to this SDDC LCM instance",
      "tags": [
        "Depot"
      ],
      "jsonPointer": "/paths/~1v1~1depot/post/operationId",
      "parameters": [
        {
          "name": "X-Correlation-Id",
          "in": "header",
          "required": false,
          "type": "string"
        }
      ],
      "requestBody": {
        "required": false,
        "contentType": "application/json",
        "schema": "FleetDepotSpec"
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "contentType": "application/json",
          "schema": "Task"
        },
        "400": {
          "description": "Bad request. Invalid input specification.",
          "contentType": "application/json",
          "schema": "ErrorResponse"
        },
        "401": {
          "description": "Unauthorized",
          "contentType": "application/json",
          "schema": "ErrorResponse"
        },
        "500": {
          "description": "Internal server error",
          "contentType": "application/json",
          "schema": "ErrorResponse"
        }
      }
    },
    {
      "operationId": "resolveDepotComponents",
      "method": "POST",
      "path": "/v1/depot/components",
      "description": "Resolve component versions to binary urls given a Fleet Depot endpoint and a list of components with their versions",
      "tags": [
        "Depot"
      ],
      "jsonPointer": "/paths/~1v1~1depot~1components/post/operationId",
      "parameters": [],
      "requestBody": {
        "required": false,
        "contentType": "application/json",
        "schema": "DepotComponentsSpec"
      },
      "responses": {
        "200": {
          "description": "OK",
          "contentType": "application/json",
          "schema": "ResolvedComponentVersions"
        },
        "400": {
          "description": "Bad request. Invalid input specification.",
          "contentType": "application/json",
          "schema": "ErrorResponse"
        },
        "401": {
          "description": "Unauthorized",
          "contentType": "application/json",
          "schema": "ErrorResponse"
        },
        "500": {
          "description": "Internal server error",
          "contentType": "application/json",
          "schema": "ErrorResponse"
        }
      }
    },
    {
      "operationId": "performComponentAction",
      "method": "POST",
      "path": "/v1/components/{componentId}",
      "description": "Perform an action on a given component.",
      "tags": [
        "Components"
      ],
      "jsonPointer": "/paths/~1v1~1components~1{componentId}/post/operationId",
      "parameters": [
        {
          "name": "X-Correlation-Id",
          "in": "header",
          "required": false,
          "type": "string"
        },
        {
          "name": "componentId",
          "in": "path",
          "required": true,
          "type": "string",
          "format": "uuid"
        },
        {
          "name": "action",
          "in": "query",
          "required": true,
          "type": "string",
          "enum": [
            "shutdown",
            "restart",
            "start",
            "refresh",
            "precheck",
            "apply"
          ]
        }
      ],
      "requestBody": {
        "required": false,
        "contentType": "application/json",
        "schema": "ComponentUpgradeSpec"
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "contentType": "application/json",
          "schema": "Task"
        },
        "400": {
          "description": "Bad Request",
          "contentType": "application/json",
          "schema": "ErrorResponse"
        },
        "404": {
          "description": "Not Found",
          "contentType": "application/json",
          "schema": "ErrorResponse"
        },
        "500": {
          "description": "Internal Server Error",
          "contentType": "application/json",
          "schema": "ErrorResponse"
        }
      }
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{taskId}",
      "description": "Get a task",
      "tags": [
        "Task"
      ],
      "jsonPointer": "/paths/~1v1~1tasks~1{taskId}/get/operationId",
      "parameters": [
        {
          "name": "taskId",
          "in": "path",
          "required": true,
          "type": "string",
          "format": "uuid"
        }
      ],
      "requestBody": false,
      "responses": {
        "200": {
          "description": "OK",
          "contentType": "application/json",
          "schema": "Task"
        },
        "404": {
          "description": "Not Found",
          "contentType": "application/json",
          "schema": "ErrorResponse"
        },
        "500": {
          "description": "Internal Server Error",
          "contentType": "application/json",
          "schema": "ErrorResponse"
        }
      }
    }
  ],

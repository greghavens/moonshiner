    "specUrl": "https://raw.githubusercontent.com/vmware/vcf-api-specs/3949fc33339fc5ea1b77eadb258f1cf49aa88e26/specifications/sddc-lcm/sddc-lcm-openapi.yaml",
    "license": "Apache-2.0",

  "sessionBootstrap": {
    "note": "These routes are NOT part of the SDDC LCM OpenAPI document. They are the observed wire behaviour of Connect-VcfInstallerServer and Disconnect-VcfInstallerServer in VMware.Sdk.Vcf.Installer 13.5.0.25380678, and the mock serves them only so that the verifier can open and close a genuine caller-owned PowerCLI session. The module under test owns none of them: it must not authenticate, and it must not connect or disconnect the session.",
    "routes": [
      {
        "method": "POST",
        "path": "/v1/tokens",
        "purpose": "PowerCLI exchanges username/password for accessToken."
      },
      {
        "method": "GET",
        "path": "/v1/sddc-manager",
        "purpose": "PowerCLI probes the appliance after authenticating."
      },
      {
        "method": "DELETE",
        "path": "/v1/tokens/refresh-token",
        "purpose": "PowerCLI invalidates the refresh token on disconnect."
      }
    ]
  },
  "wireRules": {
    "authorization": "Bearer <VcfInstallerServer.SessionSecret> on every SDDC LCM request.",
    "accept": "application/json",
    "requestContentType": "application/json",
    "optionalFieldOmission": "An optional member the caller did not supply must be absent from the serialized JSON body. It must not be sent as null, an empty string, an empty array, or an empty object. A supplied boolean false is a supplied value and must be sent.",
    "optionalHeaderOmission": "X-Correlation-Id must be sent exactly once when the caller supplies a correlation id and must be absent otherwise."
  }
}

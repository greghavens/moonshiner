{
  "contract_version": "1.0.0",
  "derived_from": {
    "repository": "vmware/vcf-api-specs",
    "spec_path": "specifications/vcf-operations/vcf-operations-openapi.json",
    "commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "note": "See docs/official_sources.json for full provenance."
  },
  "api": {
    "title": "VMware Cloud Foundation Operations API",
    "spec_version": "9.1.0.0",
    "openapi": "3.0.1",
    "base_path": "/suite-api"
  },
  "auth": {
    "security_scheme": "Token-based-authorization",
    "type": "apiKey",
    "in": "header",
    "header_name": "Authorization",
    "value_template": "OpsToken {token}",
    "value_template_provenance": "The OpenAPI securityScheme declares only the apiKey header name. The 'OpsToken <token>' value prefix is the VCF 9 suite-api convention and is recorded as a supplementary source in docs/official_sources.json."
  },
  "wire_conventions": {
    "accept_header": "application/json",
    "request_content_type": "application/json",
    "request_charset": "utf-8",
    "omit_unset_optional_fields": "An optional field that the caller did not set MUST be absent from the serialized request. It MUST NOT be sent as null, as an empty string, as an empty array, or as an empty object. A boolean optional field that the caller explicitly set to false IS set, and MUST be sent as false.",
    "query_parameter_style": "form",
    "query_parameter_explode": true,
    "query_parameter_order": "Parameters are serialized in the order they are declared in the operation's parameters list.",
    "query_boolean_encoding": "lowercase 'true' / 'false'",
    "array_field_order": "Values of uniqueItems arrays are serialized in ascending lexicographic order so that the request body is byte-stable across runs."
  },
  "operations": {
    "acquireToken": {
      "operation_id": "acquireToken",
      "summary": "Acquire a token to perform REST API calls",
      "method": "POST",
      "path": "/api/auth/token/acquire",
      "full_path": "/suite-api/api/auth/token/acquire",
      "secured": false,
      "request_body": {
        "required": true,
        "content_type": "application/json",
        "schema": "username-password"
      },
      "responses": {
        "200": {
          "schema": "auth-token"
        },
        "401": {
          "description": "Authentication failed"
        }
      },
      "success_status": 200
    },
    "getCustomGroups": {
      "operation_id": "getCustomGroups",
      "summary": "Get all custom groups",
      "method": "GET",
      "path": "/api/resources/groups",
      "full_path": "/suite-api/api/resources/groups",
      "secured": true,
      "query_parameters": [
        {
          "name": "groupId",
          "required": false,
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "includePolicy",
          "required": false,
          "type": "boolean",
          "default": false
        }
      ],
      "responses": {
        "200": {
          "schema": "cgroups"
        }
      },
      "success_status": 200
    },
    "createCustomGroup": {
      "operation_id": "createCustomGroup",
      "summary": "Create a new custom group definition",
      "method": "POST",
      "path": "/api/resources/groups",
      "full_path": "/suite-api/api/resources/groups",
      "secured": true,
      "request_body": {
        "required": true,
        "content_type": "application/json",
        "schema": "custom-group"
      },
      "responses": {
        "201": {
          "schema": "custom-group"
        }
      },
      "success_status": 201,
      "server_assigned_fields": [
        "id"
      ]
    },
    "modifyCustomGroup": {
      "operation_id": "modifyCustomGroup",
      "summary": "Modify an existing custom group definition",
      "method": "PUT",
      "path": "/api/resources/groups",
      "full_path": "/suite-api/api/resources/groups",
      "secured": true,
      "request_body": {
        "required": true,
        "content_type": "application/json",
        "schema": "custom-group"
      },
      "responses": {
        "200": {
          "schema": "custom-group"
        }
      },
      "success_status": 200,
      "caller_supplied_fields": [
        "id"
      ]
    }
  },
  "schemas": {
    "username-password": {
      "type": "object",
      "required": [
        "password",
        "username"
      ],
      "properties": {
        "authSource": "string",
        "password": "string",
        "username": "string"
      }
    },
    "auth-token": {
      "type": "object",
      "required": [
        "token",
        "validity"
      ],
      "properties": {
        "expiresAt": "string",
        "roles": "array<string>",
        "token": "string",
        "validity": "integer(int64)"
      }
    },
    "cgroups": {
      "type": "object",
      "required": [],
      "properties": {
        "groups": "array<custom-group>"
      }
    },
    "custom-group": {
      "type": "object",
      "required": [
        "membershipDefinition",
        "resourceKey"
      ],
      "properties": {
        "autoResolveMembership": "boolean",
        "id": "string(uuid)",
        "links": "array<link>",
        "membershipDefinition": "custom-group-membership",
        "policy": "string(uuid)",
        "resourceKey": "resource-key"
      }
    },
    "custom-group-membership": {
      "type": "object",
      "required": [],
      "properties": {
        "custom-group-properties": "array<custom-group-property>",
        "excludedResources": "array<string(uuid)> uniqueItems",
        "includedResources": "array<string(uuid)> uniqueItems",
        "rules": "array<membership-rule-group>"
      }
    },
    "resource-key": {
      "type": "object",
      "required": [
        "adapterKindKey",
        "name",
        "resourceKindKey"
      ],
      "properties": {
        "adapterKindKey": "string",
        "extension": "extension",
        "links": "array<link>",
        "name": "string",
        "resourceIdentifiers": "array<resource-identifier>",
        "resourceKindKey": "string"
      }
    }
  },
  "identity": {
    "custom_group": {
      "fields": [
        "resourceKey.adapterKindKey",
        "resourceKey.resourceKindKey",
        "resourceKey.name"
      ],
      "rationale": "The spec describes resource-key as 'a composite key for uniquely identifying a Resource'. Two custom groups sharing this triple are the same group."
    }
  }
}

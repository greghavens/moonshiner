+++ b/vcfops_customgroups/groups.py
@@ -0,0 +1,135 @@
+"""Retry-safe reconciliation of a VCF Operations custom group.
+
+``createCustomGroup`` is not idempotent on its own: the appliance rejects a
+second create for the same ``resourceKey`` with 409. So the desired state is
+resolved against ``getCustomGroups`` first, and the mutating call is chosen from
+what is actually there:
+
+* absent           -> ``createCustomGroup``
+* present, drifted -> ``modifyCustomGroup`` carrying the existing ``id``
+* present, matching -> no mutating call at all
+
+Running the same request twice therefore leaves exactly one custom group.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Iterable
+
+from .client import OperationsClient
+
+
+@dataclass(frozen=True)
+class EnsureResult:
+    group_id: str
+    action: str  # "created" | "updated" | "unchanged"
+    group: dict
+
+
+def _identity(group: dict) -> tuple[str, str, str]:
+    key = group.get("resourceKey") or {}
+    return (
+        key.get("adapterKindKey", ""),
+        key.get("resourceKindKey", ""),
+        key.get("name", ""),
+    )
+
+
+def _build_desired(
+    *,
+    name: str,
+    adapter_kind_key: str,
+    resource_kind_key: str,
+    included_resources: Iterable[str],
+    policy: str | None,
+    auto_resolve_membership: bool | None,
+) -> dict:
+    """Serialize the desired custom group, omitting every field left unset.
+
+    Required fields (``resourceKey``, ``membershipDefinition``) are always
+    present. Optional fields appear only when the caller supplied a value —
+    never as ``null``, ``""``, ``[]`` or ``{}``. ``uniqueItems`` arrays are
+    sorted so the body is byte-stable across runs.
+    """
+    membership: dict[str, Any] = {}
+    resources = sorted(set(included_resources or ()))
+    if resources:
+        membership["includedResources"] = resources
+
+    desired: dict[str, Any] = {
+        "resourceKey": {
+            "adapterKindKey": adapter_kind_key,
+            "name": name,
+            "resourceKindKey": resource_kind_key,
+        },
+        "membershipDefinition": membership,
+    }
+    if policy is not None:
+        desired["policy"] = policy
+    if auto_resolve_membership is not None:
+        desired["autoResolveMembership"] = auto_resolve_membership
+    return desired
+
+
+def _is_satisfied_by(existing: dict, desired: dict) -> bool:
+    """Whether ``existing`` already carries every field the caller asked for.
+
+    Only managed fields are compared: a field the caller left unset is not drift
+    just because the appliance has a value for it.
+    """
+    existing_membership = existing.get("membershipDefinition") or {}
+    desired_membership = desired["membershipDefinition"]
+    for field in ("includedResources", "excludedResources"):
+        if field in desired_membership:
+            if sorted(existing_membership.get(field) or ()) != desired_membership[field]:
+                return False
+
+    for field in ("policy", "autoResolveMembership"):
+        if field in desired and existing.get(field) != desired[field]:
+            return False
+    return True
+
+
+def ensure_custom_group(
+    client: OperationsClient,
+    *,
+    name: str,
+    adapter_kind_key: str,
+    resource_kind_key: str,
+    included_resources: Iterable[str] = (),
+    policy: str | None = None,
+    auto_resolve_membership: bool | None = None,
+) -> EnsureResult:
+    """Make the named custom group exist with the given membership.
+
+    Safe to call repeatedly: the effect is not duplicated on a retry.
+    """
+    desired = _build_desired(
+        name=name,
+        adapter_kind_key=adapter_kind_key,
+        resource_kind_key=resource_kind_key,
+        included_resources=included_resources,
+        policy=policy,
+        auto_resolve_membership=auto_resolve_membership,
+    )
+    identity = _identity(desired)
+
+    # The policy field is only returned when it is asked for, so ask for it
+    # exactly when the caller manages it — otherwise send no query at all.
+    existing_groups = client.get_custom_groups(
+        include_policy=True if policy is not None else None
+    )
+    existing = next((g for g in existing_groups if _identity(g) == identity), None)
+
+    if existing is None:
+        created = client.create_custom_group(desired)
+        return EnsureResult(created["id"], "created", created)
+
+    if _is_satisfied_by(existing, desired):
+        return EnsureResult(existing["id"], "unchanged", existing)
+
+    payload = dict(desired)
+    payload["id"] = existing["id"]
+    updated = client.modify_custom_group(payload)
+    return EnsureResult(updated["id"], "updated", updated)

+"""Idempotent custom-group management for the VCF Operations suite-api.
+
+The wire behaviour of this package is fixed by ``docs/contract.json``, which is
+derived from the VCF Operations OpenAPI specification (see
+``docs/official_sources.json``). Only the standard library is used.
+"""
+
+from .client import OperationsApiError, OperationsClient
+from .contract import Contract
+from .groups import EnsureResult, ensure_custom_group
+
+__all__ = [
+    "Contract",
+    "EnsureResult",
+    "OperationsApiError",
+    "OperationsClient",
+    "ensure_custom_group",
+]
diff --git a/vcfops_customgroups/client.py b/vcfops_customgroups/client.py
new file mode 100644
index 0000000..3b44ccd
--- /dev/null
+++ b/vcfops_customgroups/client.py
@@ -0,0 +1,144 @@
+"""HTTP client for the four suite-api operations the contract names."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any, Iterable, Sequence
+from urllib.error import HTTPError
+from urllib.parse import urlencode
+from urllib.request import Request, urlopen
+
+from .contract import Contract
+
+
+class OperationsApiError(RuntimeError):
+    """A suite-api call came back with a status the contract does not allow."""
+
+    def __init__(self, operation_id: str, status: int, body: str, url: str) -> None:
+        super().__init__(f"{operation_id} -> HTTP {status}: {body}")
+        self.operation_id = operation_id
+        self.status = status
+        self.body = body
+        self.url = url
+
+    @property
+    def message(self) -> str:
+        try:
+            return json.loads(self.body).get("message", self.body)
+        except ValueError:
+            return self.body
+
+
+class OperationsClient:
+    """Talks to one VCF Operations appliance.
+
+    ``base_url`` is the appliance origin (``https://ops.example.com``); the
+    ``/suite-api`` base path comes from the contract.
+    """
+
+    def __init__(
+        self,
+        base_url: str,
+        *,
+        timeout: float = 30.0,
+        contract_path: Path | str | None = None,
+    ) -> None:
+        self.base_url = base_url.rstrip("/")
+        self.timeout = timeout
+        self.contract = Contract(contract_path)
+        self.token: str | None = None
+
+    # -- operations -------------------------------------------------------
+    def acquire_token(self, username: str, password: str, auth_source: str | None = None) -> str:
+        """``acquireToken``. ``authSource`` is omitted unless the caller sets it."""
+        body: dict[str, Any] = {"username": username, "password": password}
+        if auth_source is not None:
+            body["authSource"] = auth_source
+        payload = self._call("acquireToken", body=body)
+        self.token = payload["token"]
+        return self.token
+
+    def get_custom_groups(
+        self,
+        group_ids: Iterable[str] | None = None,
+        include_policy: bool | None = None,
+    ) -> list[dict]:
+        """``getCustomGroups``. Unset parameters produce no query string at all."""
+        query: list[tuple[str, str]] = [("groupId", gid) for gid in (group_ids or ())]
+        if include_policy is not None:
+            query.append(("includePolicy", "true" if include_policy else "false"))
+        payload = self._call("getCustomGroups", query=query)
+        return list(payload.get("groups") or [])
+
+    def create_custom_group(self, group: dict) -> dict:
+        """``createCustomGroup``. ``group`` must not carry a server-assigned ``id``."""
+        return self._call("createCustomGroup", body=self._group_body(group, create=True))
+
+    def modify_custom_group(self, group: dict) -> dict:
+        """``modifyCustomGroup``. ``group`` must carry the existing ``id``."""
+        return self._call("modifyCustomGroup", body=self._group_body(group, create=False))
+
+    @staticmethod
+    def _group_body(group: dict, *, create: bool) -> dict:
+        """Return a detached group serialized according to the wire conventions."""
+        payload = json.loads(json.dumps(group))
+
+        # Links are response metadata at both schema locations where they can
+        # occur; a client never echoes them into a create or modify request.
+        payload.pop("links", None)
+        resource_key = payload.get("resourceKey")
+        if isinstance(resource_key, dict):
+            resource_key.pop("links", None)
+
+        membership = payload.get("membershipDefinition")
+        if isinstance(membership, dict):
+            for field in ("includedResources", "excludedResources"):
+                if field in membership:
+                    membership[field] = sorted(set(membership[field]))
+
+        if create:
+            payload.pop("id", None)
+        elif not payload.get("id"):
+            raise ValueError("modifyCustomGroup requires the existing custom group 'id'")
+        return payload
+
+    # -- transport --------------------------------------------------------
+    def _call(
+        self,
+        operation_id: str,
+        *,
+        body: dict | None = None,
+        query: Sequence[tuple[str, str]] = (),
+    ) -> dict:
+        operation = self.contract.operation(operation_id)
+        url = self.base_url + operation["full_path"]
+        if query:
+            url = f"{url}?{urlencode(list(query))}"
+
+        headers = {"Accept": self.contract.accept}
+        data = None
+        if body is not None:
+            data = json.dumps(body).encode("utf-8")
+            headers["Content-Type"] = self.contract.content_type
+        if operation["secured"]:
+            if not self.token:
+                raise RuntimeError(
+                    f"{operation_id} is a secured operation; call acquire_token() first"
+                )
+            headers[self.contract.auth_header_name] = self.contract.auth_header_value(self.token)
+
+        request = Request(url, data=data, headers=headers, method=operation["method"])
+        try:
+            with urlopen(request, timeout=self.timeout) as response:
+                status = response.status
+                raw = response.read()
+        except HTTPError as exc:
+            detail = exc.read().decode("utf-8", "replace")
+            raise OperationsApiError(operation_id, exc.code, detail, url) from None
+
+        if status != operation["success_status"]:
+            raise OperationsApiError(
+                operation_id, status, raw.decode("utf-8", "replace"), url
+            )
+        return json.loads(raw) if raw else {}

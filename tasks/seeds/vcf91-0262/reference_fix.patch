new file mode 100644
index 0000000..24a93f0
--- /dev/null
+++ b/vcfops_customgroups/contract.py
@@ -0,0 +1,58 @@
+"""Loader for the wire contract in ``docs/contract.json``.
+
+Paths, methods, success statuses, the auth header and the serialization rules
+are read from the contract rather than hard-coded, so regenerating the contract
+from a newer revision of the specification is the only edit a bump needs.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+DEFAULT_CONTRACT_PATH = Path(__file__).resolve().parent.parent / "docs" / "contract.json"
+
+
+class Contract:
+    def __init__(self, path: Path | str | None = None) -> None:
+        self.path = Path(path) if path else DEFAULT_CONTRACT_PATH
+        self._data = json.loads(self.path.read_text(encoding="utf-8"))
+
+    @property
+    def base_path(self) -> str:
+        return self._data["api"]["base_path"]
+
+    @property
+    def accept(self) -> str:
+        return self._data["wire_conventions"]["accept_header"]
+
+    @property
+    def content_type(self) -> str:
+        conventions = self._data["wire_conventions"]
+        return f"{conventions['request_content_type']}; charset={conventions['request_charset']}"
+
+    @property
+    def auth_header_name(self) -> str:
+        return self._data["auth"]["header_name"]
+
+    def auth_header_value(self, token: str) -> str:
+        return self._data["auth"]["value_template"].format(token=token)
+
+    @property
+    def identity_fields(self) -> list[str]:
+        return list(self._data["identity"]["custom_group"]["fields"])
+
+    def operation(self, operation_id: str) -> dict:
+        try:
+            operation = self._data["operations"][operation_id]
+        except KeyError:
+            raise KeyError(
+                f"operation {operation_id!r} is not named by {self.path}"
+            ) from None
+        return {
+            "operation_id": operation_id,
+            "method": operation["method"],
+            "full_path": operation.get("full_path") or self.base_path + operation["path"],
+            "secured": operation["secured"],
+            "success_status": operation["success_status"],
+        }
diff --git a/vcfops_customgroups/groups.py b/vcfops_customgroups/groups.py

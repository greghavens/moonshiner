+"""HTTP client for the SDDC LCM operations named in the contract."""
+
+from __future__ import annotations
+
+import json
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+
+from . import contract as contract_mod
+
+TERMINAL_TASK_STATUSES = frozenset({"SUCCEEDED", "FAILED", "CANCELED"})
+
+
+class ApiError(Exception):
+    """The service answered with something other than the documented success."""
+
+    def __init__(self, operation_id, status, payload, message=None):
+        self.operation_id = operation_id
+        self.status = status
+        self.payload = payload
+        detail = message or _describe(payload)
+        super().__init__("%s failed with HTTP %s: %s" % (operation_id, status, detail))
+
+
+class TransportError(Exception):
+    """The service could not be reached."""
+
+
+class TaskTimeout(Exception):
+    """A task did not reach a terminal state in time."""
+
+
+def _describe(payload):
+    if isinstance(payload, dict):
+        message = payload.get("message")
+        if isinstance(message, dict):
+            text = message.get("localizedMessage") or message.get("defaultMessage")
+            if text:
+                code = payload.get("code")
+                return "%s (%s)" % (text, code) if code else text
+        if payload.get("code"):
+            return str(payload["code"])
+    if payload in (None, ""):
+        return "no response body"
+    return str(payload)[:400]
+
+
+class SddcLcmClient:
+    def __init__(self, base_url, token, contract, correlation_id=None, timeout=120.0):
+        self.base_url = base_url.rstrip("/")
+        self.token = token
+        self.contract = contract
+        self.correlation_id = correlation_id
+        self.timeout = timeout
+
+    # -- request building -------------------------------------------------
+
+    def _url(self, operation, path_params, query):
+        path = operation.render_path(path_params or {})
+        url = self.base_url + path
+        pairs = []
+        for name in list(operation.required_query) + list(operation.optional_query):
+            if query and name in query and not contract_mod.is_unset(query[name]):
+                pairs.append((name, str(query[name])))
+        if pairs:
+            url += "?" + urllib.parse.urlencode(pairs)
+        return url
+
+    def _headers(self, operation, has_body):
+        headers = {"Authorization": "Bearer " + self.token, "Accept": "application/json"}
+        if has_body:
+            headers["Content-Type"] = "application/json"
+        if self.correlation_id and operation.allows_header("X-Correlation-Id"):
+            headers["X-Correlation-Id"] = self.correlation_id
+        return headers
+
+    def call(self, operation_id, path_params=None, query=None, body=None):
+        operation = self.contract.operation(operation_id)
+        if body is not None and not operation.request_schema:
+            raise contract_mod.ContractError(
+                "%s does not take a request body" % operation_id
+            )
+        for name in operation.required_query:
+            if not query or contract_mod.is_unset(query.get(name)):
+                raise contract_mod.ContractError(
+                    "%s requires the query parameter %r" % (operation_id, name)
+                )
+
+        data = None
+        if body is not None:
+            data = json.dumps(body).encode("utf-8")
+        request = urllib.request.Request(
+            self._url(operation, path_params, query),
+            data=data,
+            method=operation.method,
+            headers=self._headers(operation, data is not None),
+        )
+        try:
+            with urllib.request.urlopen(request, timeout=self.timeout) as response:
+                status = response.status
+                raw = response.read()
+        except urllib.error.HTTPError as exc:
+            raw = exc.read()
+            raise ApiError(operation_id, exc.code, _decode(raw)) from None
+        except urllib.error.URLError as exc:
+            raise TransportError("%s could not reach the service: %s" % (operation_id, exc.reason)) from None
+
+        payload = _decode(raw)
+        if status != operation.success_status:
+            raise ApiError(
+                operation_id,
+                status,
+                payload,
+                message="expected HTTP %d" % operation.success_status,
+            )
+        return payload
+
+    # -- task helpers -----------------------------------------------------
+
+    def get_task(self, task_id):
+        return self.call("getTask", path_params={"taskId": task_id})
+
+    def await_task(self, task_id, interval=5.0, timeout=3600.0):
+        """Poll a task until it is terminal and return the final representation."""
+        deadline = time.monotonic() + timeout
+        while True:
+            task = self.get_task(task_id)
+            status = task.get("status")
+            if status in TERMINAL_TASK_STATUSES:
+                return task
+            if time.monotonic() >= deadline:
+                raise TaskTimeout(
+                    "task %s was still %s after %.0fs" % (task_id, status, timeout)
+                )
+            if interval:
+                time.sleep(interval)
+
+
+def _decode(raw):
+    if not raw:
+        return None
+    try:
+        return json.loads(raw.decode("utf-8"))
+    except (UnicodeDecodeError, ValueError):
+        return raw.decode("utf-8", "replace")
diff --git a/vcf_lcm/contract.py b/vcf_lcm/contract.py
new file mode 100644
index 0000000..76781b5
--- /dev/null
+++ b/vcf_lcm/contract.py
@@ -0,0 +1,139 @@
+"""Access to the REST contract derived from the SDDC LCM OpenAPI specification.
+
+The contract is data, not code: every URL, method, success status and
+required/optional field split used at runtime is read from ``docs/contract.json``
+so the client cannot drift from the specification it was derived from.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+
+DEFAULT_CONTRACT_PATH = os.path.join("docs", "contract.json")
+
+
+class ContractError(Exception):
+    """The contract file is missing, malformed or incomplete."""
+
+
+class Operation:
+    __slots__ = (
+        "operation_id",
+        "method",
+        "path",
+        "success_status",
+        "request_schema",
+        "response_schema",
+        "path_params",
+        "required_query",
+        "optional_query",
+        "optional_headers",
+    )
+
+    def __init__(self, operation_id, data):
+        query = data.get("queryParams") or {}
+        self.operation_id = operation_id
+        self.method = str(data["method"]).upper()
+        self.path = data["path"]
+        self.success_status = int(data["successStatus"])
+        self.request_schema = data.get("requestSchema")
+        self.response_schema = data.get("responseSchema")
+        self.path_params = tuple(data.get("pathParams") or ())
+        self.required_query = tuple(query.get("required") or ())
+        self.optional_query = tuple(query.get("optional") or ())
+        self.optional_headers = tuple(data.get("optionalHeaders") or ())
+
+    def allows_header(self, name):
+        lowered = name.lower()
+        return any(header.lower() == lowered for header in self.optional_headers)
+
+    def render_path(self, params):
+        path = self.path
+        for name in self.path_params:
+            if name not in params:
+                raise ContractError(
+                    "%s needs the path parameter %r" % (self.operation_id, name)
+                )
+            path = path.replace("{%s}" % name, str(params[name]))
+        return path
+
+
+class Contract:
+    def __init__(self, data):
+        if not isinstance(data, dict) or "operations" not in data:
+            raise ContractError("the contract has no 'operations' block")
+        self.data = data
+        self.server = data.get("server")
+        self.security = data.get("security") or {}
+        self.schemas = data.get("schemas") or {}
+        self.operations = {}
+        for operation_id, spec in data["operations"].items():
+            try:
+                self.operations[operation_id] = Operation(operation_id, spec)
+            except (KeyError, TypeError, ValueError) as exc:
+                raise ContractError(
+                    "operation %r is not usable: %s" % (operation_id, exc)
+                ) from exc
+
+    @classmethod
+    def load(cls, path=DEFAULT_CONTRACT_PATH):
+        try:
+            with open(path, encoding="utf-8") as handle:
+                return cls(json.load(handle))
+        except FileNotFoundError as exc:
+            raise ContractError("no contract at %s" % path) from exc
+        except ValueError as exc:
+            raise ContractError("%s is not valid JSON: %s" % (path, exc)) from exc
+
+    def operation(self, operation_id):
+        try:
+            return self.operations[operation_id]
+        except KeyError:
+            raise ContractError(
+                "the contract does not describe the operation %r" % operation_id
+            ) from None
+
+    def fields(self, schema_name):
+        """Return (required, optional) field names for a request schema."""
+        schema = self.schemas.get(schema_name)
+        if not isinstance(schema, dict):
+            raise ContractError(
+                "the contract does not describe the schema %r" % schema_name
+            )
+        return tuple(schema.get("required") or ()), tuple(schema.get("optional") or ())
+
+
+def is_unset(value):
+    """True when a value carries no information and must not go on the wire.
+
+    ``False`` and ``0`` are values, not absences, so they are kept.
+    """
+    if value is None:
+        return True
+    if isinstance(value, (str, bytes, list, tuple, dict, set)) and len(value) == 0:
+        return True
+    return False
+
+
+def body(contract, schema_name, fields):
+    """Build a request body for ``schema_name`` from ``fields``.
+
+    Optional fields whose value is unset are dropped rather than sent empty;
+    required fields are always kept so the service reports the omission instead
+    of the client hiding it.
+    """
+    required, optional = contract.fields(schema_name)
+    known = set(required) | set(optional)
+    unknown = sorted(set(fields) - known)
+    if unknown:
+        raise ContractError(
+            "%s has no field(s) %s in the specification"
+            % (schema_name, ", ".join(unknown))
+        )
+    payload = {}
+    for name, value in fields.items():
+        if name in optional and is_unset(value):
+            continue
+        payload[name] = value
+    return payload
diff --git a/vcf_lcm/rollout.py b/vcf_lcm/rollout.py
new file mode 100644
index 0000000..373381a
--- /dev/null
+++ b/vcf_lcm/rollout.py
@@ -0,0 +1,375 @@
+"""Drive a staged SDDC LCM component rollout and report what happened.
+
+The rollout registers the Fleet depot, resolves the target versions to depot
+binaries, reads the component inventory, and then walks the plan one component
+at a time running ``precheck`` and then ``apply``.  The first component that
+fails stops the rollout: components already changed are reported with the tasks
+that changed them, and components never reached are reported as skipped.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+
+from . import contract as contract_mod
+from .client import ApiError, SddcLcmClient, TaskTimeout, TransportError
+
+ACTIONS = ("precheck", "apply")
+
+
+class PlanError(Exception):
+    """The rollout plan cannot be used."""
+
+
+def load_plan(path):
+    try:
+        with open(path, encoding="utf-8") as handle:
+            plan = json.load(handle)
+    except FileNotFoundError as exc:
+        raise PlanError("no plan at %s" % path) from exc
+    except ValueError as exc:
+        raise PlanError("%s is not valid JSON: %s" % (path, exc)) from exc
+    if not isinstance(plan, dict):
+        raise PlanError("the plan must be a JSON object")
+    depot = plan.get("depot")
+    if not isinstance(depot, dict) or not depot.get("fqdn") or not depot.get("certificate"):
+        raise PlanError("the plan needs a depot with an fqdn and certificate")
+    components = plan.get("components")
+    if not isinstance(components, list) or not components:
+        raise PlanError("the plan needs at least one component")
+    for entry in components:
+        if not isinstance(entry, dict) or not entry.get("componentType"):
+            raise PlanError("every component needs a componentType")
+        if not entry.get("targetVersion"):
+            raise PlanError(
+                "component %s needs a targetVersion" % entry.get("componentType")
+            )
+        if "performBackup" not in entry:
+            raise PlanError(
+                "component %s needs performBackup" % entry.get("componentType")
+            )
+    return plan
+
+
+def error_messages(task):
+    """The ERROR level messages a task ended with, in service order."""
+    errors = []
+    for message in task.get("messages") or []:
+        if message.get("level") != "ERROR":
+            continue
+        body = message.get("message") or {}
+        errors.append(
+            {
+                "id": body.get("id"),
+                "defaultMessage": body.get("defaultMessage"),
+            }
+        )
+    return errors
+
+
+def failed_stage(task):
+    for stage in task.get("stages") or []:
+        if stage.get("status") == "FAILED":
+            return stage.get("name")
+    return None
+
+
+class Rollout:
+    def __init__(self, client, contract, plan):
+        self.client = client
+        self.contract = contract
+        self.plan = plan
+
+    # -- steps ------------------------------------------------------------
+
+    def fleet_depot_spec(self):
+        depot = self.plan["depot"]
+        return contract_mod.body(
+            self.contract,
+            "FleetDepotSpec",
+            {"fqdn": depot.get("fqdn"), "certificate": depot.get("certificate")},
+        )
+
+    def register_depot(self, interval, timeout):
+        task = self.client.call(
+            "setDepot", body=self.fleet_depot_spec()
+        )
+        task_id = task.get("id")
+        final = self.client.await_task(task_id, interval=interval, timeout=timeout)
+        return {
+            "fqdn": self.plan["depot"]["fqdn"],
+            "taskId": task_id,
+            "status": final.get("status"),
+        }, final
+
+    def resolve_components(self):
+        component_versions = [
+            contract_mod.body(
+                self.contract,
+                "ComponentVersionSpec",
+                {
+                    "component": entry["componentType"],
+                    "version": entry["targetVersion"],
+                },
+            )
+            for entry in self.plan["components"]
+        ]
+        body = contract_mod.body(
+            self.contract,
+            "DepotComponentsSpec",
+            {
+                "fleetDepotSpec": self.fleet_depot_spec(),
+                "version": self.plan["depot"].get("version"),
+                "componentVersions": component_versions,
+            },
+        )
+        response = self.client.call("resolveDepotComponents", body=body)
+        resolved = {}
+        for item in (response or {}).get("componentVersions") or []:
+            name = item.get("component")
+            if name:
+                resolved[name] = item
+        # The service may answer in any order; report in plan order.
+        ordered = []
+        for entry in self.plan["components"]:
+            item = resolved.get(entry["componentType"])
+            if item is None:
+                raise PlanError(
+                    "the depot did not resolve %s" % entry["componentType"]
+                )
+            ordered.append(
+                {
+                    "component": item.get("component"),
+                    "version": item.get("version"),
+                    "binaryUrl": item.get("binaryUrl"),
+                }
+            )
+        return resolved, ordered
+
+    def inventory(self):
+        query = {"scope": self.plan.get("scope")}
+        response = self.client.call("getComponents", query=query)
+        found = {}
+        for component in (response or {}).get("components") or []:
+            name = component.get("componentType")
+            if name:
+                found[name] = component
+        return found
+
+    def upgrade_spec(self, entry, binary_url):
+        depot = contract_mod.body(
+            self.contract,
+            "DepotSpec",
+            {"url": binary_url, "certificate": entry.get("depotCertificates")},
+        )
+        software = contract_mod.body(
+            self.contract, "SoftwareSpec", {"version": entry["targetVersion"]}
+        )
+        desired = contract_mod.body(
+            self.contract,
+            "ComponentDesiredSpec",
+            {
+                "software": software,
+                "depot": depot,
+                "policy": entry.get("policy"),
+                "userInput": entry.get("userInput"),
+                "additionalInput": entry.get("additionalInput"),
+            },
+        )
+        platform = contract_mod.body(
+            self.contract,
+            "LcmPlatformSpec",
+            {"performBackup": entry["performBackup"]},
+        )
+        return contract_mod.body(
+            self.contract,
+            "ComponentUpgradeSpec",
+            {
+                "componentSpec": desired,
+                "lcmPlatformSpec": platform,
+                "correlationId": self.plan.get("correlationId"),
+            },
+        )
+
+    def run_action(self, component_id, action, body, interval, timeout):
+        task = self.client.call(
+            "performComponentAction",
+            path_params={"componentId": component_id},
+            query={"action": action},
+            body=body,
+        )
+        task_id = task.get("id")
+        final = self.client.await_task(task_id, interval=interval, timeout=timeout)
+        return task_id, final
+
+    # -- orchestration ----------------------------------------------------
+
+    def execute(self, interval, timeout):
+        report = {
+            "outcome": "succeeded",
+            "depot": None,
+            "resolvedComponents": [],
+            "components": [],
+        }
+
+        depot_report, depot_task = self.register_depot(interval, timeout)
+        report["depot"] = depot_report
+
+        if depot_task.get("status") != "SUCCEEDED":
+            report["outcome"] = "failed"
+            report["depot"]["failure"] = {
+                "taskId": depot_report["taskId"],
+                "failedStage": failed_stage(depot_task),
+                "errors": error_messages(depot_task),
+            }
+            for entry in self.plan["components"]:
+                report["components"].append(
+                    {
+                        "componentType": entry["componentType"],
+                        "componentId": None,
+                        "currentVersion": None,
+                        "targetVersion": entry["targetVersion"],
+                        "outcome": "skipped",
+                        "actions": [],
+                    }
+                )
+            return report
+
+        resolved, ordered = self.resolve_components()
+        report["resolvedComponents"] = ordered
+        inventory = self.inventory()
+
+        entries = []
+        for entry in self.plan["components"]:
+            name = entry["componentType"]
+            component = inventory.get(name)
+            if component is None:
+                raise PlanError("%s is not registered with SDDC LCM" % name)
+            entries.append((entry, component))
+
+        halted = False
+        for entry, component in entries:
+            name = entry["componentType"]
+            record = {
+                "componentType": name,
+                "componentId": component.get("id"),
+                "currentVersion": component.get("version"),
+                "targetVersion": entry["targetVersion"],
+                "outcome": "skipped",
+                "actions": [],
+            }
+            report["components"].append(record)
+            if halted:
+                continue
+
+            body = self.upgrade_spec(entry, resolved[name].get("binaryUrl"))
+            for action in ACTIONS:
+                task_id, task = self.run_action(
+                    component.get("id"), action, body, interval, timeout
+                )
+                status = task.get("status")
+                record["actions"].append(
+                    {"action": action, "taskId": task_id, "status": status}
+                )
+                if status != "SUCCEEDED":
+                    record["outcome"] = "failed"
+                    record["failure"] = {
+                        "action": action,
+                        "taskId": task_id,
+                        "failedStage": failed_stage(task),
+                        "errors": error_messages(task),
+                    }
+                    report["outcome"] = "failed"
+                    halted = True
+                    break
+            else:
+                record["outcome"] = "succeeded"
+
+        return report
+
+
+def summarize(report, stream):
+    stream.write("depot %s: %s\n" % (report["depot"]["fqdn"], report["depot"]["status"]))
+    for record in report["components"]:
+        line = "%s %s -> %s: %s" % (
+            record["componentType"],
+            record["currentVersion"],
+            record["targetVersion"],
+            record["outcome"],
+        )
+        failure = record.get("failure")
+        if failure:
+            errors = failure.get("errors") or [{}]
+            line += " at %s (%s)" % (
+                failure.get("action"),
+                errors[0].get("defaultMessage") or "no message",
+            )
+        stream.write(line + "\n")
+    stream.write("rollout %s\n" % report["outcome"])
+
+
+def build_parser():
+    parser = argparse.ArgumentParser(
+        prog="python -m vcf_lcm.rollout",
+        description="Run a staged SDDC LCM component rollout.",
+    )
+    parser.add_argument("--plan", required=True, help="path to the rollout plan")
+    parser.add_argument(
+        "--base-url", required=True, help="base URL of the SDDC LCM service"
+    )
+    parser.add_argument("--token", required=True, help="bearer token")
+    parser.add_argument("--report", required=True, help="where to write the report")
+    parser.add_argument(
+        "--contract",
+        default=contract_mod.DEFAULT_CONTRACT_PATH,
+        help="path to the derived REST contract",
+    )
+    parser.add_argument(
+        "--poll-interval",
+        type=float,
+        default=5.0,
+        help="seconds between task polls (default: 5)",
+    )
+    parser.add_argument(
+        "--poll-timeout",
+        type=float,
+        default=3600.0,
+        help="seconds to wait for a task to finish (default: 3600)",
+    )
+    return parser
+
+
+def main(argv=None):
+    args = build_parser().parse_args(argv)
+    try:
+        plan = load_plan(args.plan)
+        contract = contract_mod.Contract.load(args.contract)
+    except (PlanError, contract_mod.ContractError) as exc:
+        sys.stderr.write("%s\n" % exc)
+        return 2
+
+    client = SddcLcmClient(
+        args.base_url,
+        args.token,
+        contract,
+        correlation_id=plan.get("correlationId"),
+    )
+    rollout = Rollout(client, contract, plan)
+    try:
+        report = rollout.execute(args.poll_interval, args.poll_timeout)
+    except (ApiError, TransportError, TaskTimeout, PlanError,
+            contract_mod.ContractError) as exc:
+        sys.stderr.write("rollout aborted: %s\n" % exc)
+        return 2
+
+    with open(args.report, "w", encoding="utf-8") as handle:
+        json.dump(report, handle, indent=2, sort_keys=False)
+        handle.write("\n")
+    summarize(report, sys.stdout)
+    return 0 if report["outcome"] == "succeeded" else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())

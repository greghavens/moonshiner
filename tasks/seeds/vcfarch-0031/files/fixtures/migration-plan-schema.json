{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0031:migration-plan:1",
  "title": "VCF estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetRelease", "steps"],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "targetRelease": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "inventoryId",
          "component",
          "currentVersion",
          "targetComponent",
          "targetVersion",
          "action",
          "gates"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "inventoryId": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "currentVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetComponent": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": ["UPGRADE", "MIGRATE_AND_RETIRE", "UPGRADE_WITH_ESXI"]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

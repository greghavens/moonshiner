diff --git a/cmd/vcf-fleet-run/main.go b/cmd/vcf-fleet-run/main.go
new file mode 100644
index 0000000..0e98a42
--- /dev/null
+++ b/cmd/vcf-fleet-run/main.go
@@ -0,0 +1,181 @@
+// Command vcf-fleet-run carries out a VMware Cloud Foundation 9.1 fleet
+// component install against the SDDC LCM service and writes a report.
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"os"
+	"strings"
+	"sync"
+	"time"
+
+	"example.com/vcf/fleetlcm/fleetrun"
+)
+
+func main() {
+	os.Exit(run())
+}
+
+func run() int {
+	var (
+		planPath     = flag.String("plan", "", "install plan to carry out")
+		contractPath = flag.String("contract", "docs/contract.json", "derived REST contract")
+		baseURL      = flag.String("base-url", "", "SDDC LCM service base URL")
+		token        = flag.String("token", "", "access token")
+		tokenFile    = flag.String("token-file", "", "file holding the access tokens to use, in order, one per line")
+		reportPath   = flag.String("report", "", "where to write the run report")
+		pollInterval = flag.Duration("poll-interval", 5*time.Second, "wait between task polls")
+		pollTimeout  = flag.Duration("poll-timeout", time.Hour, "how long to poll a task before giving up")
+	)
+	flag.Parse()
+
+	switch {
+	case *planPath == "":
+		fmt.Fprintln(os.Stderr, "vcf-fleet-run: -plan is required")
+		return 2
+	case *baseURL == "":
+		fmt.Fprintln(os.Stderr, "vcf-fleet-run: -base-url is required")
+		return 2
+	case *reportPath == "":
+		fmt.Fprintln(os.Stderr, "vcf-fleet-run: -report is required")
+		return 2
+	case *token == "" && *tokenFile == "":
+		fmt.Fprintln(os.Stderr, "vcf-fleet-run: one of -token or -token-file is required")
+		return 2
+	case *token != "" && *tokenFile != "":
+		fmt.Fprintln(os.Stderr, "vcf-fleet-run: -token and -token-file are mutually exclusive")
+		return 2
+	}
+
+	var creds fleetrun.CredentialSource = fleetrun.StaticCredential(*token)
+	if *tokenFile != "" {
+		fileCreds, err := newFileCredentials(*tokenFile)
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "vcf-fleet-run: %v\n", err)
+			return 2
+		}
+		creds = fileCreds
+	}
+
+	report, err := fleetrun.Run(context.Background(), fleetrun.Options{
+		PlanPath:     *planPath,
+		ContractPath: *contractPath,
+		BaseURL:      *baseURL,
+		Credentials:  creds,
+		PollInterval: *pollInterval,
+		PollTimeout:  *pollTimeout,
+	})
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "vcf-fleet-run: %v\n", err)
+		return 2
+	}
+	if err := writeReport(*reportPath, report); err != nil {
+		fmt.Fprintf(os.Stderr, "vcf-fleet-run: %v\n", err)
+		return 2
+	}
+	summarise(report)
+	if report.Outcome == "succeeded" {
+		return 0
+	}
+	return 1
+}
+
+func writeReport(path string, report *fleetrun.Report) error {
+	raw, err := json.MarshalIndent(report, "", "  ")
+	if err != nil {
+		return fmt.Errorf("encode report: %w", err)
+	}
+	raw = append(raw, '\n')
+	f, err := os.Create(path)
+	if err != nil {
+		return fmt.Errorf("write report: %w", err)
+	}
+	if _, err := f.Write(raw); err != nil {
+		f.Close()
+		return fmt.Errorf("write report: %w", err)
+	}
+	if err := f.Sync(); err != nil {
+		f.Close()
+		return fmt.Errorf("write report: %w", err)
+	}
+	return f.Close()
+}
+
+func summarise(report *fleetrun.Report) {
+	fmt.Printf("fleet install %s\n", report.Outcome)
+	for _, c := range report.Installed {
+		version := c.Version
+		if version == "" {
+			version = "unversioned"
+		}
+		fmt.Printf("  installed %s %s at %s\n", c.ComponentType, version, c.FQDN)
+	}
+	for _, c := range report.Skipped {
+		fmt.Printf("  skipped   %s (already installed)\n", c)
+	}
+	if report.Task != nil {
+		retried := ""
+		if report.Task.Retried {
+			retried = " after one retry"
+		}
+		fmt.Printf("  task %s %s%s\n", report.Task.ID, report.Task.Status, retried)
+	}
+	fmt.Printf("  access token refreshed %d time(s)\n", report.CredentialRefreshes)
+	if report.Failure != nil {
+		if report.Failure.FailedStage != "" {
+			fmt.Printf("  failed at stage %s\n", report.Failure.FailedStage)
+		}
+		for _, e := range report.Failure.Errors {
+			fmt.Printf("    %s: %s\n", e.ID, e.DefaultMessage)
+		}
+	}
+}
+
+// fileCredentials reads the access tokens an operator provisioned for the run
+// from a file, one per line, and advances to the next when the service rejects
+// the one in hand.
+type fileCredentials struct {
+	mu     sync.Mutex
+	tokens []string
+	idx    int
+}
+
+func newFileCredentials(path string) (*fileCredentials, error) {
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("read token file: %w", err)
+	}
+	var tokens []string
+	for _, line := range strings.Split(string(raw), "\n") {
+		if line = strings.TrimSpace(line); line != "" {
+			tokens = append(tokens, line)
+		}
+	}
+	if len(tokens) == 0 {
+		return nil, fmt.Errorf("token file %s holds no tokens", path)
+	}
+	return &fileCredentials{tokens: tokens}, nil
+}
+
+func (f *fileCredentials) Token(context.Context) (string, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.tokens[f.idx], nil
+}
+
+func (f *fileCredentials) Refresh(_ context.Context, expired string) (string, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	// Another caller may already have moved on from the rejected credential.
+	if f.tokens[f.idx] != expired {
+		return f.tokens[f.idx], nil
+	}
+	if f.idx+1 >= len(f.tokens) {
+		return "", fmt.Errorf("no further access token is available")
+	}
+	f.idx++
+	return f.tokens[f.idx], nil
+}

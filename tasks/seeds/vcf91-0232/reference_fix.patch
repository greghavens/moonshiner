+++ b/fleetrun/contract.go
@@ -0,0 +1,164 @@
+package fleetrun
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"strings"
+)
+
+// Contract is the REST contract derived from the SDDC LCM OpenAPI
+// specification. Everything the client needs to shape a request -- method,
+// path, success status, where parameters go and which fields are required --
+// is read from here rather than hard-coded.
+type Contract struct {
+	Source     ContractSource       `json:"source"`
+	Server     string               `json:"server"`
+	Security   ContractSecurity     `json:"security"`
+	Operations map[string]Operation `json:"operations"`
+	Schemas    map[string]Schema    `json:"schemas"`
+}
+
+// ContractSource records the specification the contract was derived from.
+type ContractSource struct {
+	Repository string `json:"repository"`
+	SpecPath   string `json:"specPath"`
+	Commit     string `json:"commit"`
+	License    string `json:"license"`
+	OpenAPI    string `json:"openapi"`
+	APITitle   string `json:"apiTitle"`
+	APIVersion string `json:"apiVersion"`
+}
+
+// ContractSecurity is the specification's single security scheme.
+type ContractSecurity struct {
+	Scheme       string `json:"scheme"`
+	Type         string `json:"type"`
+	HTTPScheme   string `json:"httpScheme"`
+	BearerFormat string `json:"bearerFormat"`
+}
+
+// Operation is one operationId's wire shape.
+type Operation struct {
+	Method          string            `json:"method"`
+	Path            string            `json:"path"`
+	SuccessStatus   int               `json:"successStatus"`
+	RequestSchema   *string           `json:"requestSchema"`
+	ResponseSchema  string            `json:"responseSchema"`
+	PathParams      []string          `json:"pathParams"`
+	FixedQuery      map[string]string `json:"fixedQuery"`
+	QueryParams     FieldSplit        `json:"queryParams"`
+	OptionalHeaders []string          `json:"optionalHeaders"`
+	RequestVariants *Variants         `json:"requestVariants,omitempty"`
+}
+
+// Variants describes a discriminated request body.
+type Variants struct {
+	Discriminator string   `json:"discriminator"`
+	Variants      []string `json:"variants"`
+}
+
+// FieldSplit is a required/optional partition.
+type FieldSplit struct {
+	Required []string `json:"required"`
+	Optional []string `json:"optional"`
+}
+
+// Schema is a request schema's required/optional field partition.
+type Schema struct {
+	Required []string `json:"required"`
+	Optional []string `json:"optional"`
+}
+
+// Has reports whether the schema declares the named field at all.
+func (s Schema) Has(name string) bool {
+	for _, f := range s.Required {
+		if f == name {
+			return true
+		}
+	}
+	for _, f := range s.Optional {
+		if f == name {
+			return true
+		}
+	}
+	return false
+}
+
+// operationIDs are the operations this tool calls. The contract must name every
+// one of them.
+var operationIDs = []string{
+	"createComponents",
+	"getComponents",
+	"getTask",
+	"resolveDepotComponents",
+	"retryTask",
+}
+
+// schemaNames are the request schemas this tool builds bodies against.
+var schemaNames = []string{
+	"ComponentImportSpec",
+	"ComponentRepository",
+	"ComponentSpecs",
+	"ComponentVersionSpec",
+	"DepotComponentsSpec",
+	"FleetDepotSpec",
+}
+
+// LoadContract reads the derived contract and checks it covers what this tool
+// needs.
+func LoadContract(path string) (*Contract, error) {
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("read contract: %w", err)
+	}
+	var c Contract
+	if err := json.Unmarshal(raw, &c); err != nil {
+		return nil, fmt.Errorf("parse contract %s: %w", path, err)
+	}
+	for _, id := range operationIDs {
+		op, ok := c.Operations[id]
+		if !ok {
+			return nil, fmt.Errorf("contract %s names no operation %q", path, id)
+		}
+		if op.Method == "" || !strings.HasPrefix(op.Path, "/") || op.SuccessStatus == 0 {
+			return nil, fmt.Errorf("contract %s describes operation %q incompletely", path, id)
+		}
+	}
+	for _, name := range schemaNames {
+		if _, ok := c.Schemas[name]; !ok {
+			return nil, fmt.Errorf("contract %s defines no schema %q", path, name)
+		}
+	}
+	if c.Security.HTTPScheme == "" {
+		return nil, fmt.Errorf("contract %s declares no security.httpScheme", path)
+	}
+	return &c, nil
+}
+
+// Operation looks an operation up by its operationId.
+func (c *Contract) Operation(id string) (Operation, error) {
+	op, ok := c.Operations[id]
+	if !ok {
+		return Operation{}, fmt.Errorf("contract names no operation %q", id)
+	}
+	return op, nil
+}
+
+// importVariant returns the discriminator value that selects the component
+// import spec, as the specification's discriminator mapping defines it.
+func (c *Contract) importVariant() (string, string, error) {
+	op, err := c.Operation("createComponents")
+	if err != nil {
+		return "", "", err
+	}
+	if op.RequestVariants == nil {
+		return "", "", fmt.Errorf("contract declares no request variants for createComponents")
+	}
+	for _, v := range op.RequestVariants.Variants {
+		if v == "ComponentImportSpec" {
+			return op.RequestVariants.Discriminator, v, nil
+		}
+	}
+	return "", "", fmt.Errorf("createComponents declares no ComponentImportSpec variant")
+}
diff --git a/fleetrun/plan.go b/fleetrun/plan.go
new file mode 100644
index 0000000..ed22d40
--- /dev/null
+++ b/fleetrun/plan.go
@@ -0,0 +1,92 @@
+package fleetrun
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+)
+
+// Plan is the fleet install plan the run carries out.
+type Plan struct {
+	// Scope narrows the component inventory lookup. Optional.
+	Scope string `json:"scope"`
+	// CorrelationID is sent as X-Correlation-Id on the operations that declare
+	// that header. Optional.
+	CorrelationID string `json:"correlationId"`
+	// Depot is the Fleet depot the component binaries are resolved against.
+	Depot DepotSpec `json:"depot"`
+	// DepotVersion pins the depot's release version. Optional.
+	DepotVersion string `json:"depotVersion"`
+	// BinaryCertificate is the certificate presented by the binary repository.
+	// Optional.
+	BinaryCertificate string `json:"binaryCertificate"`
+	// Components are the components to install, in the order they are sent.
+	Components []PlanComponent `json:"components"`
+}
+
+// DepotSpec is the Fleet depot endpoint.
+type DepotSpec struct {
+	FQDN        string `json:"fqdn"`
+	Certificate string `json:"certificate"`
+}
+
+// PlanComponent is one component to install.
+type PlanComponent struct {
+	ComponentType string `json:"componentType"`
+	// Version pins the version to resolve. Optional; the depot picks when unset.
+	Version string `json:"version"`
+	FQDN    string `json:"fqdn"`
+	// Password is the appliance credential. Required by the specification.
+	Password string `json:"password"`
+	// The rest are optional and are sent only when set.
+	Username      string `json:"username"`
+	Size          string `json:"size"`
+	SSLThumbprint string `json:"sslThumbprint"`
+	VMID          string `json:"vmId"`
+}
+
+// LoadPlan reads and validates an install plan.
+func LoadPlan(path string) (*Plan, error) {
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("read plan: %w", err)
+	}
+	var p Plan
+	if err := json.Unmarshal(raw, &p); err != nil {
+		return nil, fmt.Errorf("parse plan %s: %w", path, err)
+	}
+	if err := p.Validate(); err != nil {
+		return nil, fmt.Errorf("plan %s: %w", path, err)
+	}
+	return &p, nil
+}
+
+// Validate checks the plan can be carried out at all.
+func (p *Plan) Validate() error {
+	if p.Depot.FQDN == "" {
+		return fmt.Errorf("depot.fqdn is required")
+	}
+	if p.Depot.Certificate == "" {
+		return fmt.Errorf("depot.certificate is required")
+	}
+	if len(p.Components) == 0 {
+		return fmt.Errorf("components is empty")
+	}
+	seen := map[string]bool{}
+	for i, c := range p.Components {
+		if c.ComponentType == "" {
+			return fmt.Errorf("components[%d].componentType is required", i)
+		}
+		if seen[c.ComponentType] {
+			return fmt.Errorf("components[%d] repeats componentType %q", i, c.ComponentType)
+		}
+		seen[c.ComponentType] = true
+		if c.FQDN == "" {
+			return fmt.Errorf("components[%d] (%s): fqdn is required", i, c.ComponentType)
+		}
+		if c.Password == "" {
+			return fmt.Errorf("components[%d] (%s): password is required", i, c.ComponentType)
+		}
+	}
+	return nil
+}
diff --git a/fleetrun/run.go b/fleetrun/run.go
new file mode 100644
index 0000000..6074f1e
--- /dev/null
+++ b/fleetrun/run.go
@@ -0,0 +1,451 @@
+// Package fleetrun carries out a VMware Cloud Foundation 9.1 fleet component
+// install against the SDDC LCM service and reports what happened.
+//
+// Every wire detail comes from the derived REST contract in docs/contract.json,
+// which is itself derived from the service's published OpenAPI specification.
+package fleetrun
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/url"
+	"sort"
+	"time"
+)
+
+// Options configures a run.
+type Options struct {
+	// PlanPath is the install plan to carry out.
+	PlanPath string
+	// ContractPath is the derived REST contract. Empty means docs/contract.json.
+	ContractPath string
+	// BaseURL is the SDDC LCM service to drive.
+	BaseURL string
+	// Credentials supplies and replaces the access token.
+	Credentials CredentialSource
+	// PollInterval is the wait between task polls. Zero means five seconds.
+	PollInterval time.Duration
+	// PollTimeout bounds how long a task is polled. Zero means one hour.
+	PollTimeout time.Duration
+	// HTTPClient is the client to send with. Nil means a default client.
+	HTTPClient *http.Client
+}
+
+// Report describes what a run did.
+type Report struct {
+	Outcome string `json:"outcome"`
+	// Scope is the plan's component scope, absent when the plan sets none.
+	Scope string `json:"scope,omitempty"`
+	// Skipped names the planned components that were already installed, in plan
+	// order.
+	Skipped []string `json:"skipped"`
+	// Installed describes the components that were submitted, in plan order.
+	Installed []InstalledComponent `json:"installed"`
+	// Task describes the install task, absent when none was raised.
+	Task *TaskReport `json:"task,omitempty"`
+	// CredentialRefreshes counts how often the access token had to be replaced.
+	CredentialRefreshes int `json:"credentialRefreshes"`
+	// Failure describes why the task ended badly, absent when it did not.
+	Failure *FailureReport `json:"failure,omitempty"`
+}
+
+// InstalledComponent is one component the run submitted.
+type InstalledComponent struct {
+	ComponentType string `json:"componentType"`
+	FQDN          string `json:"fqdn"`
+	Version       string `json:"version"`
+	// DownloadURL is the binary the depot resolved, absent when it published
+	// none.
+	DownloadURL string `json:"downloadUrl,omitempty"`
+}
+
+// TaskReport is the install task's outcome.
+type TaskReport struct {
+	ID      string `json:"id"`
+	Status  string `json:"status"`
+	Retried bool   `json:"retried"`
+}
+
+// FailureReport names what went wrong.
+type FailureReport struct {
+	TaskID string `json:"taskId"`
+	// FailedStage is the stage the service marked failed, absent when no stage
+	// is marked.
+	FailedStage string        `json:"failedStage,omitempty"`
+	Errors      []ReportError `json:"errors"`
+}
+
+// ReportError is one ERROR level message.
+type ReportError struct {
+	ID             string `json:"id"`
+	DefaultMessage string `json:"defaultMessage"`
+}
+
+// Terminal task statuses, as the specification's TaskStatus enum spells them.
+var terminalStatuses = map[string]bool{
+	"SUCCEEDED": true,
+	"FAILED":    true,
+	"CANCELED":  true,
+}
+
+// Run carries out the plan and returns what happened.
+//
+// An error means the run could not be carried out at all: an unusable plan or
+// contract, a component the depot does not carry, an answer that cannot be made
+// sense of, a credential that could not be replaced, or a task that never
+// settled. An install that fails is a result, not an error, and is described by
+// the report.
+func Run(ctx context.Context, opts Options) (*Report, error) {
+	contractPath := opts.ContractPath
+	if contractPath == "" {
+		contractPath = "docs/contract.json"
+	}
+	contract, err := LoadContract(contractPath)
+	if err != nil {
+		return nil, err
+	}
+	plan, err := LoadPlan(opts.PlanPath)
+	if err != nil {
+		return nil, err
+	}
+	if opts.BaseURL == "" {
+		return nil, fmt.Errorf("no base URL was given")
+	}
+	if opts.Credentials == nil {
+		return nil, fmt.Errorf("no credential source was given")
+	}
+	interval := opts.PollInterval
+	if interval <= 0 {
+		interval = 5 * time.Second
+	}
+	timeout := opts.PollTimeout
+	if timeout <= 0 {
+		timeout = time.Hour
+	}
+
+	c := newClient(contract, opts.BaseURL, opts.Credentials, opts.HTTPClient)
+	report := &Report{
+		Outcome:   "succeeded",
+		Scope:     plan.Scope,
+		Skipped:   []string{},
+		Installed: []InstalledComponent{},
+	}
+	defer func() { report.CredentialRefreshes = c.refreshCount() }()
+
+	// 1. What is already installed.
+	installed, err := c.getComponents(ctx, plan.Scope)
+	if err != nil {
+		return nil, err
+	}
+	present := map[string]bool{}
+	for _, comp := range installed {
+		present[comp.ComponentType] = true
+	}
+	var todo []PlanComponent
+	for _, pc := range plan.Components {
+		if present[pc.ComponentType] {
+			report.Skipped = append(report.Skipped, pc.ComponentType)
+			continue
+		}
+		todo = append(todo, pc)
+	}
+	if len(todo) == 0 {
+		// Nothing to install. Raising a task anyway would be work invented, not
+		// work done.
+		return report, nil
+	}
+
+	// 2. Resolve the binaries.
+	resolved, err := c.resolveDepot(ctx, plan, todo)
+	if err != nil {
+		return nil, err
+	}
+	for _, pc := range todo {
+		r, ok := resolved[pc.ComponentType]
+		if !ok {
+			return nil, fmt.Errorf("the depot at %s carries no component %q", plan.Depot.FQDN, pc.ComponentType)
+		}
+		report.Installed = append(report.Installed, InstalledComponent{
+			ComponentType: pc.ComponentType,
+			FQDN:          pc.FQDN,
+			Version:       r.Version,
+			DownloadURL:   r.BinaryURL,
+		})
+	}
+
+	// 3. Raise the install.
+	task, err := c.createComponents(ctx, plan, todo, resolved)
+	if err != nil {
+		return nil, err
+	}
+	if task.ID == "" {
+		return nil, fmt.Errorf("createComponents returned a task with no id")
+	}
+
+	// 4. Poll it out. The answer that raised the task never settles it,
+	//    whatever status it carries.
+	settled, err := c.pollTask(ctx, task.ID, interval, timeout)
+	if err != nil {
+		return nil, err
+	}
+	retried := false
+
+	// 5. One retry, when the service says the task can be retried.
+	if settled.Status == "FAILED" && settled.Retriable {
+		if _, err := c.retryTask(ctx, task.ID); err != nil {
+			return nil, err
+		}
+		retried = true
+		settled, err = c.pollTask(ctx, task.ID, interval, timeout)
+		if err != nil {
+			return nil, err
+		}
+	}
+
+	report.Task = &TaskReport{ID: task.ID, Status: settled.Status, Retried: retried}
+	if settled.Status != "SUCCEEDED" {
+		report.Outcome = "failed"
+		report.Failure = failureOf(task.ID, settled)
+	}
+	return report, nil
+}
+
+// getComponents reads the component inventory, narrowed by scope when the plan
+// sets one. When it does not, no query string is sent at all.
+func (c *client) getComponents(ctx context.Context, scope string) ([]componentJSON, error) {
+	query := url.Values{}
+	if scope != "" {
+		query.Set("scope", scope)
+	}
+	var out struct {
+		Components []componentJSON `json:"components"`
+	}
+	err := c.do(ctx, request{operation: "getComponents", query: query}, &out)
+	if err != nil {
+		return nil, err
+	}
+	return out.Components, nil
+}
+
+// resolveDepot asks the depot to turn the requested component versions into
+// binaries.
+func (c *client) resolveDepot(ctx context.Context, plan *Plan, todo []PlanComponent) (map[string]resolvedJSON, error) {
+	versions := make([]any, 0, len(todo))
+	for _, pc := range todo {
+		// component is required; version is optional and is sent only when the
+		// plan pins one.
+		entry := map[string]any{"component": pc.ComponentType}
+		if pc.Version != "" {
+			entry["version"] = pc.Version
+		}
+		versions = append(versions, entry)
+	}
+	body := map[string]any{
+		"fleetDepotSpec": map[string]any{
+			"fqdn":        plan.Depot.FQDN,
+			"certificate": plan.Depot.Certificate,
+		},
+		"componentVersions": versions,
+	}
+	if plan.DepotVersion != "" {
+		body["version"] = plan.DepotVersion
+	}
+
+	var out struct {
+		ComponentVersions []resolvedJSON `json:"componentVersions"`
+	}
+	if err := c.do(ctx, request{operation: "resolveDepotComponents", body: body}, &out); err != nil {
+		return nil, err
+	}
+	resolved := map[string]resolvedJSON{}
+	for _, r := range out.ComponentVersions {
+		resolved[r.Component] = r
+	}
+	return resolved, nil
+}
+
+// createComponents submits the import specs. Optional fields are put on the
+// body only when they carry a value.
+func (c *client) createComponents(ctx context.Context, plan *Plan, todo []PlanComponent, resolved map[string]resolvedJSON) (taskJSON, error) {
+	discriminator, variant, err := c.contract.importVariant()
+	if err != nil {
+		return taskJSON{}, err
+	}
+	importSchema := c.contract.Schemas["ComponentImportSpec"]
+	repoSchema := c.contract.Schemas["ComponentRepository"]
+
+	specs := make([]any, 0, len(todo))
+	for _, pc := range todo {
+		r := resolved[pc.ComponentType]
+		spec := map[string]any{
+			discriminator:   variant,
+			"componentType": pc.ComponentType,
+			"fqdn":          pc.FQDN,
+			"password":      pc.Password,
+		}
+		optional := map[string]string{
+			"version":       r.Version,
+			"username":      pc.Username,
+			"size":          pc.Size,
+			"sslThumbprint": pc.SSLThumbprint,
+			"vmId":          pc.VMID,
+		}
+		for _, field := range sortedKeys(optional) {
+			value := optional[field]
+			if value == "" || !importSchema.Has(field) {
+				continue
+			}
+			spec[field] = value
+		}
+		// The repository is itself optional, and so is every field on it. An
+		// object with nothing to carry is left off entirely rather than sent
+		// empty.
+		repo := map[string]any{}
+		repoFields := map[string]string{
+			"downloadUrl": r.BinaryURL,
+			"certificate": plan.BinaryCertificate,
+		}
+		for _, field := range sortedKeys(repoFields) {
+			value := repoFields[field]
+			if value == "" || !repoSchema.Has(field) {
+				continue
+			}
+			repo[field] = value
+		}
+		if len(repo) > 0 && importSchema.Has("repository") {
+			spec["repository"] = repo
+		}
+		specs = append(specs, spec)
+	}
+
+	headers := map[string]string{}
+	if plan.CorrelationID != "" {
+		headers["X-Correlation-Id"] = plan.CorrelationID
+	}
+
+	var task taskJSON
+	err = c.do(ctx, request{
+		operation: "createComponents",
+		headers:   headers,
+		body:      map[string]any{"componentSpecs": specs},
+	}, &task)
+	if err != nil {
+		return taskJSON{}, err
+	}
+	return task, nil
+}
+
+// pollTask polls until the task settles.
+func (c *client) pollTask(ctx context.Context, taskID string, interval, timeout time.Duration) (taskJSON, error) {
+	deadline := time.Now().Add(timeout)
+	for {
+		var task taskJSON
+		err := c.do(ctx, request{
+			operation:  "getTask",
+			pathParams: map[string]string{"taskId": taskID},
+		}, &task)
+		if err != nil {
+			return taskJSON{}, err
+		}
+		if terminalStatuses[task.Status] {
+			return task, nil
+		}
+		if !time.Now().Before(deadline) {
+			return taskJSON{}, fmt.Errorf("task %s was still %s after %s", taskID, task.Status, timeout)
+		}
+		select {
+		case <-ctx.Done():
+			return taskJSON{}, ctx.Err()
+		case <-time.After(interval):
+		}
+	}
+}
+
+// retryTask asks the service to retry the failed task.
+func (c *client) retryTask(ctx context.Context, taskID string) (taskJSON, error) {
+	var task taskJSON
+	err := c.do(ctx, request{
+		operation:  "retryTask",
+		pathParams: map[string]string{"taskId": taskID},
+	}, &task)
+	return task, err
+}
+
+// failureOf reads the errors off a task that did not succeed: the failed
+// stage's ERROR messages, or the task's own when no stage is marked failed.
+func failureOf(taskID string, task taskJSON) *FailureReport {
+	out := &FailureReport{TaskID: taskID, Errors: []ReportError{}}
+	for _, stage := range task.Stages {
+		if stage.Status != "FAILED" {
+			continue
+		}
+		out.FailedStage = stage.Name
+		for _, m := range stage.Messages {
+			if m.Level == "ERROR" {
+				out.Errors = append(out.Errors, ReportError{
+					ID:             m.Message.ID,
+					DefaultMessage: m.Message.DefaultMessage,
+				})
+			}
+		}
+		return out
+	}
+	for _, m := range task.Messages {
+		if m.Level == "ERROR" {
+			out.Errors = append(out.Errors, ReportError{
+				ID:             m.Message.ID,
+				DefaultMessage: m.Message.DefaultMessage,
+			})
+		}
+	}
+	return out
+}
+
+func sortedKeys(m map[string]string) []string {
+	out := make([]string, 0, len(m))
+	for k := range m {
+		out = append(out, k)
+	}
+	sort.Strings(out)
+	return out
+}
+
+// Wire shapes of the responses this tool reads.
+
+type componentJSON struct {
+	ID            string `json:"id"`
+	ComponentType string `json:"componentType"`
+	Version       string `json:"version"`
+	FQDN          string `json:"fqdn"`
+	Scope         string `json:"scope"`
+}
+
+type resolvedJSON struct {
+	Component string `json:"component"`
+	Version   string `json:"version"`
+	BinaryURL string `json:"binaryUrl"`
+}
+
+type taskJSON struct {
+	ID        string        `json:"id"`
+	Status    string        `json:"status"`
+	Retriable bool          `json:"retriable"`
+	Stages    []stageJSON   `json:"stages"`
+	Messages  []messageJSON `json:"messages"`
+}
+
+type stageJSON struct {
+	ID       string        `json:"id"`
+	Name     string        `json:"name"`
+	Status   string        `json:"status"`
+	Messages []messageJSON `json:"messages"`
+}
+
+type messageJSON struct {
+	Level   string `json:"level"`
+	Message struct {
+		ID             string `json:"id"`
+		DefaultMessage string `json:"defaultMessage"`
+	} `json:"message"`
+}

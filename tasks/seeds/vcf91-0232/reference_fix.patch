diff --git a/fleetrun/client.go b/fleetrun/client.go
new file mode 100644
index 0000000..f2bacc1
--- /dev/null
+++ b/fleetrun/client.go
@@ -0,0 +1,267 @@
+package fleetrun
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"sync"
+)
+
+// CredentialSource supplies the access token the SDDC LCM service is called
+// with, and replaces it when the service rejects it as expired.
+//
+// Token is called before every request. Refresh is called only after the
+// service has answered 401, and is passed the credential that was rejected so a
+// source shared between callers can tell a stale rejection from a live one.
+type CredentialSource interface {
+	Token(ctx context.Context) (string, error)
+	Refresh(ctx context.Context, expired string) (string, error)
+}
+
+// StaticCredential is a CredentialSource that never changes its token. Refresh
+// fails, because there is nothing to refresh to.
+type StaticCredential string
+
+// Token returns the fixed credential.
+func (s StaticCredential) Token(context.Context) (string, error) { return string(s), nil }
+
+// Refresh reports that this credential cannot be replaced.
+func (s StaticCredential) Refresh(context.Context, string) (string, error) {
+	return "", fmt.Errorf("this credential cannot be refreshed")
+}
+
+// apiError is a non-success answer from the service.
+type apiError struct {
+	Operation string
+	Status    int
+	Code      string
+	Message   string
+}
+
+func (e *apiError) Error() string {
+	if e.Message == "" {
+		return fmt.Sprintf("%s: the service answered %d", e.Operation, e.Status)
+	}
+	return fmt.Sprintf("%s: the service answered %d (%s): %s", e.Operation, e.Status, e.Code, e.Message)
+}
+
+// client issues contract-shaped requests against one SDDC LCM service.
+type client struct {
+	contract *Contract
+	baseURL  string
+	http     *http.Client
+	creds    CredentialSource
+
+	mu        sync.Mutex
+	refreshes int
+}
+
+func newClient(contract *Contract, baseURL string, creds CredentialSource, hc *http.Client) *client {
+	if hc == nil {
+		hc = &http.Client{}
+	}
+	return &client{
+		contract: contract,
+		baseURL:  strings.TrimRight(baseURL, "/"),
+		http:     hc,
+		creds:    creds,
+	}
+}
+
+// refreshCount is how many times the credential was replaced.
+func (c *client) refreshCount() int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.refreshes
+}
+
+// request is one call to make.
+type request struct {
+	operation  string
+	pathParams map[string]string
+	// query holds only the parameters that have a value. A parameter with no
+	// value is not put here, so it never reaches the wire.
+	query url.Values
+	// headers holds only the optional headers that have a value.
+	headers map[string]string
+	body    any
+}
+
+// do sends a request and decodes the success response into out.
+//
+// When the service rejects the credential the call is not abandoned: the
+// credential is refreshed once and the very same request is sent again. Work
+// already accepted by the service is therefore never redone, because nothing
+// above this layer learns that the credential changed.
+func (c *client) do(ctx context.Context, req request, out any) error {
+	op, err := c.contract.Operation(req.operation)
+	if err != nil {
+		return err
+	}
+	var payload []byte
+	if req.body != nil {
+		payload, err = json.Marshal(req.body)
+		if err != nil {
+			return fmt.Errorf("%s: encode body: %w", req.operation, err)
+		}
+	}
+	target, err := c.target(op, req)
+	if err != nil {
+		return err
+	}
+
+	token, err := c.creds.Token(ctx)
+	if err != nil {
+		return fmt.Errorf("%s: obtain credential: %w", req.operation, err)
+	}
+
+	status, respBody, err := c.send(ctx, op, req, target, payload, token)
+	if err != nil {
+		return err
+	}
+	if status == http.StatusUnauthorized {
+		refreshed, err := c.creds.Refresh(ctx, token)
+		if err != nil {
+			return fmt.Errorf("%s: the service rejected the credential and it could not be refreshed: %w",
+				req.operation, err)
+		}
+		c.mu.Lock()
+		c.refreshes++
+		c.mu.Unlock()
+		status, respBody, err = c.send(ctx, op, req, target, payload, refreshed)
+		if err != nil {
+			return err
+		}
+		if status == http.StatusUnauthorized {
+			return &apiError{
+				Operation: req.operation,
+				Status:    status,
+				Code:      "LCM_TOKEN_REJECTED",
+				Message:   "the refreshed credential was rejected as well",
+			}
+		}
+	}
+	if status != op.SuccessStatus {
+		return decodeAPIError(req.operation, status, respBody)
+	}
+	if out == nil {
+		return nil
+	}
+	if err := json.Unmarshal(respBody, out); err != nil {
+		return fmt.Errorf("%s: decode response: %w", req.operation, err)
+	}
+	return nil
+}
+
+// send performs one HTTP exchange. It is deliberately free of retry logic so
+// that do stays the only place a credential is replaced.
+func (c *client) send(ctx context.Context, op Operation, req request, target string, payload []byte, token string) (int, []byte, error) {
+	var rdr io.Reader
+	if payload != nil {
+		rdr = bytes.NewReader(payload)
+	}
+	httpReq, err := http.NewRequestWithContext(ctx, op.Method, target, rdr)
+	if err != nil {
+		return 0, nil, fmt.Errorf("%s: build request: %w", req.operation, err)
+	}
+	httpReq.Header.Set("Authorization", c.contract.Security.HTTPScheme+" "+token)
+	httpReq.Header.Set("Accept", "application/json")
+	if payload != nil {
+		httpReq.Header.Set("Content-Type", "application/json")
+	}
+	// Only headers the operation declares, and only when they carry a value.
+	declared := map[string]bool{}
+	for _, h := range op.OptionalHeaders {
+		declared[http.CanonicalHeaderKey(h)] = true
+	}
+	for name, value := range req.headers {
+		if value == "" || !declared[http.CanonicalHeaderKey(name)] {
+			continue
+		}
+		httpReq.Header.Set(name, value)
+	}
+
+	resp, err := c.http.Do(httpReq)
+	if err != nil {
+		return 0, nil, fmt.Errorf("%s: %w", req.operation, err)
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return 0, nil, fmt.Errorf("%s: read response: %w", req.operation, err)
+	}
+	return resp.StatusCode, body, nil
+}
+
+// target builds the request target from the contract: the operation's path with
+// its path parameters filled in, the query the operation pins, and whatever
+// optional query parameters actually have a value.
+//
+// When nothing goes in the query, no query string is produced at all.
+func (c *client) target(op Operation, req request) (string, error) {
+	path := op.Path
+	for _, name := range op.PathParams {
+		value, ok := req.pathParams[name]
+		if !ok || value == "" {
+			return "", fmt.Errorf("%s: path parameter %q has no value", req.operation, name)
+		}
+		path = strings.ReplaceAll(path, "{"+name+"}", url.PathEscape(value))
+	}
+	if strings.Contains(path, "{") {
+		return "", fmt.Errorf("%s: path %q still has unfilled parameters", req.operation, path)
+	}
+
+	query := url.Values{}
+	for k, v := range op.FixedQuery {
+		query.Set(k, v)
+	}
+	allowed := map[string]bool{}
+	for _, k := range op.QueryParams.Required {
+		allowed[k] = true
+	}
+	for _, k := range op.QueryParams.Optional {
+		allowed[k] = true
+	}
+	for k, values := range req.query {
+		if !allowed[k] {
+			return "", fmt.Errorf("%s: query parameter %q is not declared by the contract", req.operation, k)
+		}
+		for _, v := range values {
+			if v == "" {
+				continue
+			}
+			query.Add(k, v)
+		}
+	}
+	for _, k := range op.QueryParams.Required {
+		if len(query[k]) == 0 {
+			return "", fmt.Errorf("%s: required query parameter %q has no value", req.operation, k)
+		}
+	}
+
+	target := c.baseURL + path
+	if len(query) > 0 {
+		target += "?" + query.Encode()
+	}
+	return target, nil
+}
+
+func decodeAPIError(operation string, status int, body []byte) error {
+	e := &apiError{Operation: operation, Status: status}
+	var payload struct {
+		Code    string `json:"code"`
+		Message struct {
+			DefaultMessage string `json:"defaultMessage"`
+		} `json:"message"`
+	}
+	if err := json.Unmarshal(body, &payload); err == nil {
+		e.Code = payload.Code
+		e.Message = payload.Message.DefaultMessage
+	}
+	return e
+}

@@ -0,0 +1,26 @@
+"""Exceptions raised by the VCF Operations alert collector."""
+
+from __future__ import annotations
+
+
+class VcfOperationsError(Exception):
+    """Base class for every failure this package raises."""
+
+
+class VcfOperationsAuthError(VcfOperationsError):
+    """acquireToken refused the supplied credentials.
+
+    The message never repeats the password or the auth token.
+    """
+
+    def __init__(self, message: str, *, username: str | None = None) -> None:
+        super().__init__(message)
+        self.username = username
+
+
+class VcfOperationsProtocolError(VcfOperationsError):
+    """The appliance answered in a way the pinned contract does not allow."""
+
+    def __init__(self, message: str, *, status: int | None = None) -> None:
+        super().__init__(message)
+        self.status = status

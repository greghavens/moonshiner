diff --git a/AutomationClient.java b/AutomationClient.java
new file mode 100644
index 0000000..b7fee40
--- /dev/null
+++ b/AutomationClient.java
@@ -0,0 +1,399 @@
+import java.io.IOException;
+import java.net.URI;
+import java.net.URLEncoder;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+public final class AutomationClient {
+    public record ProjectSummary(String id, String name) {}
+    public record ProjectUpdate(String name, String description) {}
+    public record Tag(String key, String value) {}
+    public record ZoneAssignment(String zoneId, int priority, int maxNumberInstances) {}
+    public record StepResult(String operation, int statusCode, boolean succeeded, String message) {}
+    public record ChangeReport(List<ProjectSummary> projects, List<StepResult> steps, boolean complete) {
+        public ChangeReport {
+            projects = List.copyOf(projects);
+            steps = List.copyOf(steps);
+        }
+    }
+
+    private final URI baseUri;
+    private final String authorization;
+    private final HttpClient http;
+
+    public AutomationClient(URI baseUri, String bearerToken) {
+        if (baseUri == null || bearerToken == null) {
+            throw new IllegalArgumentException("baseUri and bearerToken are required");
+        }
+        this.baseUri = baseUri;
+        this.authorization = "Bearer " + bearerToken;
+        this.http = HttpClient.newHttpClient();
+    }
+
+    public ChangeReport applyProjectChange(
+            String projectId,
+            ProjectUpdate project,
+            List<Tag> resourceTags,
+            List<ZoneAssignment> zoneAssignments) throws IOException, InterruptedException {
+        if (projectId == null || project == null || resourceTags == null || zoneAssignments == null) {
+            throw new IllegalArgumentException("change arguments are required");
+        }
+
+        List<ProjectSummary> projects = getProjects();
+        List<StepResult> steps = new ArrayList<>();
+        String projectPath = "/iaas/api/projects/" + encodePathSegment(projectId);
+
+        StepResult result = sendChange(
+                "updateProject", "PATCH", projectPath, projectJson(project));
+        steps.add(result);
+        result = sendChange(
+                "updateProjectResourceMetadata",
+                "PATCH",
+                projectPath + "/resource-metadata",
+                tagsJson(resourceTags));
+        steps.add(result);
+        result = sendChange(
+                "updateProjectZoneAssignments",
+                "PUT",
+                projectPath + "/zones",
+                zonesJson(zoneAssignments));
+        steps.add(result);
+        return new ChangeReport(
+                projects, steps, steps.stream().allMatch(StepResult::succeeded));
+    }
+
+    private List<ProjectSummary> getProjects() throws IOException, InterruptedException {
+        HttpRequest request = request("/iaas/api/projects")
+                .GET()
+                .build();
+        HttpResponse<String> response = http.send(request, HttpResponse.BodyHandlers.ofString());
+        if (!successful(response.statusCode())) {
+            throw new IOException("getProjects failed with HTTP " + response.statusCode()
+                    + ": " + responseMessage(response.body()));
+        }
+
+        Object document = new JsonParser(response.body()).parse();
+        Map<?, ?> root = object(document, "project collection");
+        Object contentValue = root.get("content");
+        if (!(contentValue instanceof List<?> content)) {
+            throw new IOException("project collection is missing content");
+        }
+        List<ProjectSummary> projects = new ArrayList<>();
+        for (Object item : content) {
+            Map<?, ?> project = object(item, "project");
+            projects.add(new ProjectSummary(
+                    string(project.get("id"), "project id"),
+                    string(project.get("name"), "project name")));
+        }
+        projects.sort(Comparator.comparing(ProjectSummary::name)
+                .thenComparing(ProjectSummary::id));
+        return List.copyOf(projects);
+    }
+
+    private StepResult sendChange(String operation, String method, String path, String body)
+            throws IOException, InterruptedException {
+        HttpRequest request = request(path)
+                .header("Content-Type", "application/json")
+                .method(method, HttpRequest.BodyPublishers.ofString(body, StandardCharsets.UTF_8))
+                .build();
+        HttpResponse<String> response = http.send(request, HttpResponse.BodyHandlers.ofString());
+        boolean succeeded = successful(response.statusCode());
+        return new StepResult(
+                operation,
+                response.statusCode(),
+                succeeded,
+                succeeded ? "" : responseMessage(response.body()));
+    }
+
+    private HttpRequest.Builder request(String path) {
+        return HttpRequest.newBuilder(baseUri.resolve(path))
+                .header("Accept", "application/json")
+                .header("Authorization", authorization);
+    }
+
+    private static boolean successful(int statusCode) {
+        return statusCode >= 200 && statusCode < 300;
+    }
+
+    private static String responseMessage(String body) {
+        try {
+            Object parsed = new JsonParser(body).parse();
+            if (parsed instanceof Map<?, ?> value && value.get("message") instanceof String message) {
+                return message;
+            }
+        } catch (IOException ignored) {
+            // Preserve the service body when an error is not JSON.
+        }
+        return body;
+    }
+
+    private static String projectJson(ProjectUpdate project) {
+        return "{\"name\":" + quote(project.name())
+                + ",\"description\":" + quote(project.description()) + "}";
+    }
+
+    private static String tagsJson(List<Tag> tags) {
+        StringBuilder json = new StringBuilder("{\"tags\":[");
+        for (int index = 0; index < tags.size(); index++) {
+            if (index > 0) {
+                json.append(',');
+            }
+            Tag tag = tags.get(index);
+            json.append("{\"key\":").append(quote(tag.key()))
+                    .append(",\"value\":").append(quote(tag.value())).append('}');
+        }
+        return json.append("]}").toString();
+    }
+
+    private static String zonesJson(List<ZoneAssignment> assignments) {
+        StringBuilder json = new StringBuilder("{\"zoneAssignmentSpecifications\":[");
+        for (int index = 0; index < assignments.size(); index++) {
+            if (index > 0) {
+                json.append(',');
+            }
+            ZoneAssignment assignment = assignments.get(index);
+            json.append("{\"zoneId\":").append(quote(assignment.zoneId()))
+                    .append(",\"priority\":").append(assignment.priority())
+                    .append(",\"maxNumberInstances\":")
+                    .append(assignment.maxNumberInstances()).append('}');
+        }
+        return json.append("]}").toString();
+    }
+
+    private static String quote(String value) {
+        if (value == null) {
+            return "null";
+        }
+        StringBuilder out = new StringBuilder("\"");
+        for (int index = 0; index < value.length(); index++) {
+            char ch = value.charAt(index);
+            switch (ch) {
+                case '\"' -> out.append("\\\"");
+                case '\\' -> out.append("\\\\");
+                case '\b' -> out.append("\\b");
+                case '\f' -> out.append("\\f");
+                case '\n' -> out.append("\\n");
+                case '\r' -> out.append("\\r");
+                case '\t' -> out.append("\\t");
+                default -> {
+                    if (ch < 0x20) {
+                        out.append(String.format("\\u%04x", (int) ch));
+                    } else {
+                        out.append(ch);
+                    }
+                }
+            }
+        }
+        return out.append('\"').toString();
+    }
+
+    private static String encodePathSegment(String value) {
+        return URLEncoder.encode(value, StandardCharsets.UTF_8).replace("+", "%20");
+    }
+
+    private static Map<?, ?> object(Object value, String label) throws IOException {
+        if (value instanceof Map<?, ?> map) {
+            return map;
+        }
+        throw new IOException(label + " is not a JSON object");
+    }
+
+    private static String string(Object value, String label) throws IOException {
+        if (value instanceof String text) {
+            return text;
+        }
+        throw new IOException(label + " is not a JSON string");
+    }
+
+    private static final class JsonParser {
+        private final String input;
+        private int position;
+
+        JsonParser(String input) {
+            this.input = input;
+        }
+
+        Object parse() throws IOException {
+            Object value = value();
+            whitespace();
+            if (position != input.length()) {
+                throw error("unexpected trailing data");
+            }
+            return value;
+        }
+
+        private Object value() throws IOException {
+            whitespace();
+            if (position >= input.length()) {
+                throw error("expected a value");
+            }
+            return switch (input.charAt(position)) {
+                case '{' -> object();
+                case '[' -> array();
+                case '\"' -> string();
+                case 't' -> literal("true", Boolean.TRUE);
+                case 'f' -> literal("false", Boolean.FALSE);
+                case 'n' -> literal("null", null);
+                default -> number();
+            };
+        }
+
+        private Map<String, Object> object() throws IOException {
+            expect('{');
+            Map<String, Object> result = new LinkedHashMap<>();
+            whitespace();
+            if (take('}')) {
+                return result;
+            }
+            do {
+                whitespace();
+                if (position >= input.length() || input.charAt(position) != '\"') {
+                    throw error("expected an object key");
+                }
+                String key = string();
+                whitespace();
+                expect(':');
+                result.put(key, value());
+                whitespace();
+            } while (take(','));
+            expect('}');
+            return result;
+        }
+
+        private List<Object> array() throws IOException {
+            expect('[');
+            List<Object> result = new ArrayList<>();
+            whitespace();
+            if (take(']')) {
+                return result;
+            }
+            do {
+                result.add(value());
+                whitespace();
+            } while (take(','));
+            expect(']');
+            return result;
+        }
+
+        private String string() throws IOException {
+            expect('\"');
+            StringBuilder result = new StringBuilder();
+            while (position < input.length()) {
+                char ch = input.charAt(position++);
+                if (ch == '\"') {
+                    return result.toString();
+                }
+                if (ch != '\\') {
+                    if (ch < 0x20) {
+                        throw error("unescaped control character");
+                    }
+                    result.append(ch);
+                    continue;
+                }
+                if (position >= input.length()) {
+                    throw error("unfinished escape");
+                }
+                char escaped = input.charAt(position++);
+                switch (escaped) {
+                    case '\"', '\\', '/' -> result.append(escaped);
+                    case 'b' -> result.append('\b');
+                    case 'f' -> result.append('\f');
+                    case 'n' -> result.append('\n');
+                    case 'r' -> result.append('\r');
+                    case 't' -> result.append('\t');
+                    case 'u' -> result.append(unicode());
+                    default -> throw error("invalid escape");
+                }
+            }
+            throw error("unterminated string");
+        }
+
+        private char unicode() throws IOException {
+            if (position + 4 > input.length()) {
+                throw error("unfinished unicode escape");
+            }
+            try {
+                char value = (char) Integer.parseInt(input.substring(position, position + 4), 16);
+                position += 4;
+                return value;
+            } catch (NumberFormatException badHex) {
+                throw error("invalid unicode escape");
+            }
+        }
+
+        private Object number() throws IOException {
+            int start = position;
+            if (take('-')) {
+                // sign consumed
+            }
+            while (position < input.length() && Character.isDigit(input.charAt(position))) {
+                position++;
+            }
+            if (take('.')) {
+                while (position < input.length() && Character.isDigit(input.charAt(position))) {
+                    position++;
+                }
+            }
+            if (position < input.length()
+                    && (input.charAt(position) == 'e' || input.charAt(position) == 'E')) {
+                position++;
+                if (position < input.length()
+                        && (input.charAt(position) == '+' || input.charAt(position) == '-')) {
+                    position++;
+                }
+                while (position < input.length() && Character.isDigit(input.charAt(position))) {
+                    position++;
+                }
+            }
+            if (start == position) {
+                throw error("expected a number");
+            }
+            String token = input.substring(start, position);
+            try {
+                return token.contains(".") || token.contains("e") || token.contains("E")
+                        ? Double.valueOf(token) : Long.valueOf(token);
+            } catch (NumberFormatException invalid) {
+                throw error("invalid number");
+            }
+        }
+
+        private Object literal(String token, Object value) throws IOException {
+            if (!input.startsWith(token, position)) {
+                throw error("invalid literal");
+            }
+            position += token.length();
+            return value;
+        }
+
+        private void whitespace() {
+            while (position < input.length() && Character.isWhitespace(input.charAt(position))) {
+                position++;
+            }
+        }
+
+        private boolean take(char expected) {
+            if (position < input.length() && input.charAt(position) == expected) {
+                position++;
+                return true;
+            }
+            return false;
+        }
+
+        private void expect(char expected) throws IOException {
+            if (!take(expected)) {
+                throw error("expected '" + expected + "'");
+            }
+        }
+
+        private IOException error(String message) {
+            return new IOException(message + " at JSON offset " + position);
+        }
+    }
+}

+    /**
+     * Small strict JSON cursor used only to validate and select a top-level
+     * string without depending on a third-party JSON package.
+     */
+    private static final class JsonCursor {
+        private final String input;
+        private int position;
+
+        JsonCursor(String input) {
+            this.input = input;
+        }
+
+        boolean atEnd() {
+            return position == input.length();
+        }
+
+        char peek() throws IOException {
+            if (atEnd()) {
+                throw new IOException("unexpected end of precheck JSON");
+            }
+            return input.charAt(position);
+        }
+
+        boolean consume(char expected) {
+            if (!atEnd() && input.charAt(position) == expected) {
+                position++;
+                return true;
+            }
+            return false;
+        }
+
+        void expect(char expected) throws IOException {
+            if (!consume(expected)) {
+                throw new IOException("malformed precheck JSON");
+            }
+        }
+
+        void skipWhitespace() {
+            while (!atEnd()) {
+                char character = input.charAt(position);
+                if (character != ' '
+                        && character != '\n'
+                        && character != '\r'
+                        && character != '\t') {
+                    return;
+                }
+                position++;
+            }
+        }
+
+        String readString() throws IOException {
+            expect('"');
+            StringBuilder decoded = new StringBuilder();
+            while (!atEnd()) {
+                char character = input.charAt(position++);
+                if (character == '"') {
+                    return decoded.toString();
+                }
+                if (character < 0x20) {
+                    throw new IOException("malformed precheck JSON string");
+                }
+                if (character != '\\') {
+                    decoded.append(character);
+                    continue;
+                }
+                if (atEnd()) {
+                    throw new IOException("malformed precheck JSON escape");
+                }
+                char escape = input.charAt(position++);
+                switch (escape) {
+                    case '"' -> decoded.append('"');
+                    case '\\' -> decoded.append('\\');
+                    case '/' -> decoded.append('/');
+                    case 'b' -> decoded.append('\b');
+                    case 'f' -> decoded.append('\f');
+                    case 'n' -> decoded.append('\n');
+                    case 'r' -> decoded.append('\r');
+                    case 't' -> decoded.append('\t');
+                    case 'u' -> decoded.append(readUnicodeEscape());
+                    default -> throw new IOException(
+                            "malformed precheck JSON escape");
+                }
+            }
+            throw new IOException("unterminated precheck JSON string");
+        }
+
+        char readUnicodeEscape() throws IOException {
+            if (position + 4 > input.length()) {
+                throw new IOException("malformed precheck JSON unicode escape");
+            }
+            int value = 0;
+            for (int count = 0; count < 4; count++) {
+                int digit = Character.digit(input.charAt(position++), 16);
+                if (digit < 0) {
+                    throw new IOException(
+                            "malformed precheck JSON unicode escape");
+                }
+                value = (value << 4) | digit;
+            }
+            return (char) value;
+        }
+
+        void skipValue(int depth) throws IOException {
+            if (depth > 64) {
+                throw new IOException("precheck JSON is nested too deeply");
+            }
+            skipWhitespace();
+            char character = peek();
+            if (character == '"') {
+                readString();
+                return;
+            }
+            if (character == '{') {
+                position++;
+                skipWhitespace();
+                if (consume('}')) {
+                    return;
+                }
+                while (true) {
+                    readString();
+                    skipWhitespace();
+                    expect(':');
+                    skipValue(depth + 1);
+                    skipWhitespace();
+                    if (consume('}')) {
+                        return;
+                    }
+                    expect(',');
+                    skipWhitespace();
+                }
+            }
+            if (character == '[') {
+                position++;
+                skipWhitespace();
+                if (consume(']')) {
+                    return;
+                }
+                while (true) {
+                    skipValue(depth + 1);
+                    skipWhitespace();
+                    if (consume(']')) {
+                        return;
+                    }
+                    expect(',');
+                    skipWhitespace();
+                }
+            }
+            if (consumeLiteral("true")
+                    || consumeLiteral("false")
+                    || consumeLiteral("null")) {
+                return;
+            }
+            skipNumber();
+        }
+
+        boolean consumeLiteral(String literal) {
+            if (input.startsWith(literal, position)) {
+                position += literal.length();
+                return true;
+            }
+            return false;
+        }
+
+        void skipNumber() throws IOException {
+            int start = position;
+            if (consume('-') && atEnd()) {
+                throw new IOException("malformed precheck JSON number");
+            }
+            if (consume('0')) {
+                if (!atEnd() && Character.isDigit(input.charAt(position))) {
+                    throw new IOException("malformed precheck JSON number");
+                }
+            } else {
+                if (atEnd()
+                        || input.charAt(position) < '1'
+                        || input.charAt(position) > '9') {
+                    throw new IOException("malformed precheck JSON value");
+                }
+                while (!atEnd() && Character.isDigit(input.charAt(position))) {
+                    position++;
+                }
+            }
+            if (consume('.')) {
+                int fraction = position;
+                while (!atEnd() && Character.isDigit(input.charAt(position))) {
+                    position++;
+                }
+                if (fraction == position) {
+                    throw new IOException("malformed precheck JSON number");
+                }
+            }
+            if (consume('e') || consume('E')) {
+                if (!consume('+')) {
+                    consume('-');
+                }
+                int exponent = position;
+                while (!atEnd() && Character.isDigit(input.charAt(position))) {
+                    position++;
+                }
+                if (exponent == position) {
+                    throw new IOException("malformed precheck JSON number");
+                }
+            }
+            if (start == position) {
+                throw new IOException("malformed precheck JSON value");
+            }
+        }
     }

+    private static String encodeProvider(
+            String name,
+            String type,
+            List<String> certChain) {
+        StringBuilder json = new StringBuilder()
+                .append("{\"name\":")
+                .append(quote(name))
+                .append(",\"type\":")
+                .append(quote(type));
+        if (certChain != null) {
+            json.append(",\"certChain\":[");
+            for (int index = 0; index < certChain.size(); index++) {
+                if (index > 0) {
+                    json.append(',');
+                }
+                json.append(quote(certChain.get(index)));
+            }
+            json.append(']');
+        }
+        return json.append('}').toString();
+    }

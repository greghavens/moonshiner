+    private static String requiredTopLevelString(String json, String field)
+            throws IOException {
+        JsonCursor cursor = new JsonCursor(json);
+        cursor.skipWhitespace();
+        cursor.expect('{');
+        cursor.skipWhitespace();
+        String result = null;
+        boolean found = false;
+        if (!cursor.consume('}')) {
+            while (true) {
+                String key = cursor.readString();
+                cursor.skipWhitespace();
+                cursor.expect(':');
+                cursor.skipWhitespace();
+                if (key.equals(field)) {
+                    if (found || cursor.peek() != '"') {
+                        throw new IOException(
+                                "precheck response has an invalid required field");
+                    }
+                    result = cursor.readString();
+                    found = true;
+                } else {
+                    cursor.skipValue(0);
+                }
+                cursor.skipWhitespace();
+                if (cursor.consume('}')) {
+                    break;
+                }
+                cursor.expect(',');
+                cursor.skipWhitespace();
+            }
+        }
+        cursor.skipWhitespace();
+        if (!cursor.atEnd() || !found) {
+            throw new IOException(
+                    "precheck response is missing a required string field");
+        }
+        return result;
+    }

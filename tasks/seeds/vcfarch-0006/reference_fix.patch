diff --git a/VcfArchitecture/VcfArchitecture.psm1 b/VcfArchitecture/VcfArchitecture.psm1
new file mode 100644
index 0000000..89aeabc
--- /dev/null
+++ b/VcfArchitecture/VcfArchitecture.psm1
@@ -0,0 +1,305 @@
+Set-StrictMode -Version Latest
+
+function New-VcfArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateScript({ Test-Path -LiteralPath $_ -PathType Leaf })]
+        [string] $InventoryPath,
+
+        [Parameter(Mandatory)]
+        [string] $OutputDirectory
+    )
+
+    $inventory = Get-Content -LiteralPath $InventoryPath -Raw |
+        ConvertFrom-Json -Depth 100
+    $requirements = $inventory.designRequirements
+    $password = '<DEPLOY_PASSWORD>'
+
+    # Construct the deployable SDK model as typed VMware.Sdk.Vcf.Installer
+    # objects. The canonical JSON below preserves the API's camel-case names.
+    $sdkCredentials = Initialize-VcfInstallerSddcCredentials `
+        -Username 'root' -Password $password
+    $sdkHosts = @(
+        foreach ($hostRecord in $inventory.targetHostCatalog) {
+            Initialize-VcfInstallerSddcHostSpec `
+                -Hostname $hostRecord.hostname `
+                -Credentials $sdkCredentials
+        }
+    )
+    $sdkNetworks = @(
+        foreach ($network in $requirements.networks) {
+            Initialize-VcfInstallerSddcNetworkSpec `
+                -NetworkType $network.networkType `
+                -VlanId $network.vlanId `
+                -Subnet $network.subnet `
+                -Gateway $network.gateway `
+                -Mtu $network.mtu `
+                -IpAddressVersion 'IPv4' `
+                -IpAddressAssignmentMode 'STATIC'
+        }
+    )
+    $sdkVcenter = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname "dfw01-m01-vc01.$($requirements.dnsSubdomain)" `
+        -RootVcenterPassword $password `
+        -VmSize 'large' `
+        -StorageSize 'lstorage' `
+        -SsoDomain 'vsphere.local' `
+        -Version $inventory.targetRelease `
+        -UseExistingDeployment $false
+    $sdkNsxManagers = @(
+        1..3 | ForEach-Object {
+            Initialize-VcfInstallerNsxtManagerSpec `
+                -Hostname ('dfw01-m01-nsx{0:d2}' -f $_)
+        }
+    )
+    $sdkNsx = Initialize-VcfInstallerSddcNsxtSpec `
+        -NsxtManagers $sdkNsxManagers `
+        -NsxtManagerSize 'large' `
+        -VipFqdn "dfw01-m01-nsx.$($requirements.dnsSubdomain)" `
+        -RootNsxtManagerPassword $password `
+        -NsxtAdminPassword $password `
+        -NsxtAuditPassword $password `
+        -TransportVlanId 1950 `
+        -Version $inventory.targetRelease `
+        -UseExistingDeployment $false
+    $sdkDns = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $requirements.dnsSubdomain `
+        -Nameservers $requirements.nameServers
+    $sdkSpec = Initialize-VcfInstallerSddcSpec `
+        -SddcId $requirements.sddcId `
+        -WorkflowType 'VCF_COMPLETE' `
+        -HostSpecs $sdkHosts `
+        -Version $inventory.targetRelease `
+        -VcenterSpec $sdkVcenter `
+        -NsxtSpec $sdkNsx `
+        -NetworkSpecs $sdkNetworks `
+        -DnsSpec $sdkDns `
+        -NtpServers $requirements.ntpServers `
+        -VcfInstanceName $requirements.vcfInstanceName
+    if ($null -eq $sdkSpec) {
+        throw 'VMware.Sdk.Vcf.Installer did not construct an SddcSpec.'
+    }
+
+    $hostSpecs = @(
+        foreach ($hostRecord in $inventory.targetHostCatalog) {
+            [ordered]@{
+                hostname = $hostRecord.hostname
+                credentials = [ordered]@{
+                    username = 'root'
+                    password = $password
+                }
+            }
+        }
+    )
+    $networkSpecs = @(
+        foreach ($network in $requirements.networks) {
+            [ordered]@{
+                networkType = $network.networkType
+                subnet = $network.subnet
+                gateway = $network.gateway
+                subnetMask = '255.255.255.0'
+                vlanId = $network.vlanId
+                mtu = $network.mtu
+                ipAddressVersion = 'IPv4'
+                ipAddressAssignmentMode = 'STATIC'
+            }
+        }
+    )
+    $sddcSpec = [ordered]@{
+        sddcId = $requirements.sddcId
+        workflowType = 'VCF_COMPLETE'
+        hostSpecs = $hostSpecs
+        version = $inventory.targetRelease
+        vcenterSpec = [ordered]@{
+            vcenterHostname = "dfw01-m01-vc01.$($requirements.dnsSubdomain)"
+            rootVcenterPassword = $password
+            vmSize = 'large'
+            storageSize = 'lstorage'
+            ssoDomain = 'vsphere.local'
+            adminUserSsoUsername = 'administrator'
+            adminUserSsoPassword = $password
+            version = $inventory.targetRelease
+            useExistingDeployment = $false
+        }
+        clusterSpec = [ordered]@{
+            datacenterName = 'dfw01-m01-dc'
+            clusterName = 'dfw01-m01-cl01'
+            clusterEvcMode = 'INTEL_SAPPHIRERAPIDS'
+            resourcePoolSpecs = @(
+                [ordered]@{
+                    name = 'Management'
+                    type = 'management'
+                    cpuReservationPercentage = 20
+                    memoryReservationPercentage = 20
+                    cpuReservationExpandable = $true
+                    memoryReservationExpandable = $true
+                }
+            )
+        }
+        dvsSpecs = @(
+            [ordered]@{
+                dvsName = 'dfw01-m01-vds01'
+                networks = @('MANAGEMENT', 'VMOTION', 'VSAN', 'FLEET_MANAGEMENT')
+                mtu = 9000
+                vmnicsToUplinks = @(
+                    [ordered]@{ id = 'vmnic0'; uplink = 'uplink1' },
+                    [ordered]@{ id = 'vmnic1'; uplink = 'uplink2' }
+                )
+            }
+        )
+        nsxtSpec = [ordered]@{
+            nsxtManagers = @(
+                [ordered]@{ hostname = 'dfw01-m01-nsx01' },
+                [ordered]@{ hostname = 'dfw01-m01-nsx02' },
+                [ordered]@{ hostname = 'dfw01-m01-nsx03' }
+            )
+            nsxtManagerSize = 'large'
+            vipFqdn = "dfw01-m01-nsx.$($requirements.dnsSubdomain)"
+            rootNsxtManagerPassword = $password
+            nsxtAdminPassword = $password
+            nsxtAuditPassword = $password
+            transportVlanId = 1950
+            version = $inventory.targetRelease
+            useExistingDeployment = $false
+        }
+        networkSpecs = $networkSpecs
+        dnsSpec = [ordered]@{
+            subdomain = $requirements.dnsSubdomain
+            nameservers = @($requirements.nameServers)
+        }
+        ntpServers = @($requirements.ntpServers)
+        sddcManagerSpec = [ordered]@{
+            rootPassword = $password
+            hostname = 'dfw01-m01-sddc01'
+            sshPassword = $password
+            localUserPassword = $password
+            version = $inventory.targetRelease
+            useExistingDeployment = $false
+        }
+        managementPoolName = 'dfw01-management-pool'
+        ceipEnabled = $false
+        skipEsxThumbprintValidation = $false
+        skipGatewayPingValidation = $false
+        securitySpec = [ordered]@{ esxiCertsMode = 'VMCA' }
+        datastoreSpec = [ordered]@{
+            vsanSpec = [ordered]@{
+                datastoreName = 'dfw01-m01-vsan01'
+                failuresToTolerate = 2
+                vsanDedup = $false
+                esaConfig = [ordered]@{ enabled = $true }
+            }
+        }
+        vspClusterSpec = [ordered]@{
+            platformFqdn = "dfw01-vsp.$($requirements.dnsSubdomain)"
+            systemUserPassword = $password
+            ipv4Pool = [ordered]@{
+                cidr = '10.91.40.0/24'
+                addresses = @($requirements.vspAddresses)
+            }
+            size = 'medium'
+            internalClusterCidrIpv4 = $requirements.internalClusterCidrIpv4
+            instanceFqdn = "northstar-dfw01.$($requirements.dnsSubdomain)"
+            fleetFqdn = "northstar-fleet.$($requirements.dnsSubdomain)"
+            version = $inventory.targetRelease
+            useExistingDeployment = $false
+        }
+        fleetLcmSpec = [ordered]@{ version = $inventory.targetRelease; size = 'medium' }
+        sddcLcmSpec = [ordered]@{ version = $inventory.targetRelease; size = 'medium' }
+        fleetDepotSpec = [ordered]@{ version = $inventory.targetRelease; size = 'medium' }
+        telemetryAcceptorSpec = [ordered]@{ version = $inventory.targetRelease; size = 'small' }
+        vidbSpec = [ordered]@{
+            hostname = "dfw01-vidb.$($requirements.dnsSubdomain)"
+            version = $inventory.targetRelease
+            size = 'medium'
+        }
+        vcfOperationsSpec = [ordered]@{
+            nodes = @(
+                [ordered]@{ hostname = "dfw01-ops01.$($requirements.dnsSubdomain)"; rootUserPassword = $password; type = 'master' },
+                [ordered]@{ hostname = "dfw01-ops02.$($requirements.dnsSubdomain)"; rootUserPassword = $password; type = 'replica' },
+                [ordered]@{ hostname = "dfw01-ops03.$($requirements.dnsSubdomain)"; rootUserPassword = $password; type = 'data' }
+            )
+            adminUserPassword = $password
+            applianceSize = 'large'
+            loadBalancerFqdn = "dfw01-ops.$($requirements.dnsSubdomain)"
+            useExistingDeployment = $false
+            version = $inventory.targetRelease
+        }
+        vcfAutomationSpec = [ordered]@{
+            hostname = "dfw01-auto.$($requirements.dnsSubdomain)"
+            platformFqdn = "dfw01-vsp.$($requirements.dnsSubdomain)"
+            adminUserPassword = $password
+            ipPool = @('10.91.40.120', '10.91.40.121', '10.91.40.122', '10.91.40.123', '10.91.40.124', '10.91.40.125')
+            internalClusterCidr = '198.20.0.0/16'
+            nodePrefix = 'dfw01-auto'
+            size = 'medium'
+            version = $inventory.targetRelease
+            useExistingDeployment = $false
+        }
+        vcfManagementComponentsInfrastructureSpec = [ordered]@{
+            localRegionNetwork = [ordered]@{
+                networkName = 'dfw01-vcf-management-overlay'
+                subnetMask = '255.255.255.0'
+                gateway = '10.91.40.1'
+            }
+            xRegionNetwork = [ordered]@{
+                networkName = 'dfw01-vcf-xregion-overlay'
+                subnetMask = '255.255.255.0'
+                gateway = '10.91.41.1'
+            }
+        }
+        licenseServerSpec = [ordered]@{
+            hostname = "dfw01-license.$($requirements.dnsSubdomain)"
+            version = $inventory.targetRelease
+            useExistingDeployment = $false
+        }
+        vcfInstanceName = $requirements.vcfInstanceName
+    }
+
+    $componentById = @{}
+    foreach ($component in $inventory.components) {
+        $componentById[$component.id] = $component
+    }
+    $migrationRules = @(
+        @{ id = 'aria-suite-lifecycle'; target = 'retired'; action = 'patch-then-decommission'; gates = @('patch-to-8.18-patch-2', 'management-components-on-9.1', 'identity-migrated-to-vcf-identity-broker') },
+        @{ id = 'aria-operations'; target = '9.1.0.0'; action = 'in-place-upgrade'; gates = @('aria-suite-lifecycle-8.18-patch-2', 'pre-upgrade-assessment-passed') },
+        @{ id = 'aria-automation'; target = '9.1.0.0'; action = 'in-place-upgrade'; gates = @('vcf-operations-9.1-available', 'imported-into-fleet-lifecycle') },
+        @{ id = 'aria-operations-for-networks'; target = '9.1.0.0'; action = 'fleet-lcm-upgrade'; gates = @('vcf-operations-9.1-available', 'fleet-lifecycle-health-green') },
+        @{ id = 'sddc-manager'; target = '9.1.0.0'; action = 'lifecycle-upgrade'; gates = @('vcf-operations-9.1-available', 'vcf-management-services-deployed', 'license-server-registered') },
+        @{ id = 'hcx'; target = '9.1.0.0'; action = 'lifecycle-upgrade'; gates = @('sddc-manager-9.1-complete', 'hcx-service-mesh-healthy') },
+        @{ id = 'nsx'; target = '9.1.0.0'; action = 'lifecycle-upgrade'; gates = @('hcx-9.1-complete', 'nsx-prechecks-passed') },
+        @{ id = 'vcenter'; target = '9.1.0.0'; action = 'lifecycle-upgrade'; gates = @('nsx-9.1-complete', 'license-server-registered') },
+        @{ id = 'esxi'; target = '9.1.0.0'; action = 'lifecycle-upgrade'; gates = @('vcenter-9.1-complete', 'hardware-compatibility-confirmed', 'n-plus-two-capacity-maintained') },
+        @{ id = 'vsan'; target = '9.1.0.0'; action = 'on-disk-format-upgrade'; gates = @('esxi-9.1-complete', 'vsan-health-green', 'resync-zero') },
+        @{ id = 'aria-operations-for-logs'; target = 'VCF Log Management 9.1.0.0'; action = 'replace-migrate-decommission'; gates = @('management-components-on-9.1', 'vcf-operations-9.1-available', 'log-management-service-enabled', 'ninety-day-log-transfer-complete') }
+    )
+    $steps = @(
+        for ($index = 0; $index -lt $migrationRules.Count; $index++) {
+            $rule = $migrationRules[$index]
+            $component = $componentById[$rule.id]
+            [ordered]@{
+                order = $index + 1
+                componentId = $component.id
+                componentName = $component.name
+                sourceVersion = $component.currentVersion
+                targetVersion = $rule.target
+                action = $rule.action
+                gates = @($rule.gates)
+            }
+        }
+    )
+    $migrationPlan = [ordered]@{
+        schemaVersion = '1.0'
+        estateId = $inventory.estateId
+        targetRelease = $inventory.targetRelease
+        steps = $steps
+    }
+
+    $null = New-Item -ItemType Directory -Path $OutputDirectory -Force
+    $sddcSpec | ConvertTo-Json -Depth 100 |
+        Set-Content -LiteralPath (Join-Path $OutputDirectory 'sddc-spec.json') -Encoding utf8
+    $migrationPlan | ConvertTo-Json -Depth 100 |
+        Set-Content -LiteralPath (Join-Path $OutputDirectory 'migration-plan.json') -Encoding utf8
+}
+
+Export-ModuleMember -Function New-VcfArchitecture

+    Description       = 'Generates the Northstar VCF 9.1 SddcSpec and component migration plan.'
+    PowerShellVersion = '7.4'
+    RequiredModules   = @(
+        @{
+            ModuleName      = 'VMware.Sdk.Vcf.Installer'
+            RequiredVersion = '13.5.0.25380678'
+        }
+    )
+    FunctionsToExport = @('New-VcfArchitecture')
+    CmdletsToExport   = @()

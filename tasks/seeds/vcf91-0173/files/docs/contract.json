{
  "openapi": "3.0.1",
  "info": {
    "description": "This documentation covers v2 API endpoints.\n\nAuthenticated requests must include an X-JWT-Token header with a token retrieved with the following authenticated call to VCF Operation API : \n\nPOST /suite-api/api/auth/token/exchange \n\nRequest body {\"serviceKeys\": [\"ops-li\"]}.\n\nAccess is allowed only to resources that the user is authorized to use.",
    "title": "Log Management API\n",
    "version": "9.1.0.0"
  },
  "security": [
    {
      "OPSTokenAuthorization": []
    }
  ],
  "paths": {
    "/api/v2/agent/secrets": {
      "get": {
        "description": "Retrieves a paginated list of all agent secrets configured in the system.\nThe response includes secret names and metadata but does not include the actual secret values.\n\nSupports pagination parameters to control the number of results returned.",
        "x-vmw-compiler-skip": "FILE",
        "operationId": "listAgentSecrets",
        "parameters": [
          {
            "in": "query",
            "name": "pageable",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Pageable"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentSecretListResponse"
                }
              }
            },
            "description": "Return list of secrets"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Forbidden: Authorization required"
          }
        },
        "summary": "List Agent Secrets",
        "tags": [
          "Agent Secret"
        ]
      },
      "post": {
        "description": "Creates a new agent secret that can be used by log ingestion agents to authenticate\nwith the system. The secret name must be unique and will be used to identify the agent.\nThe returned secret value should be stored securely as it will only be displayed once.",
        "operationId": "createAgentSecret",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentSecretCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentSecretCreateResponse"
                }
              }
            },
            "description": "Created new agent secret"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad request: Invalid input data"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Forbidden: Authorization required"
          }
        },
        "summary": "Create a secret to be used by ingestion agent",
        "tags": [
          "Agent Secret"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AgentSecretCreateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "AgentSecretCreateResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "secret": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "AgentSecretListResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "modificationTime": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "errorCode": {
            "type": "string",
            "enum": [
              "API_ERROR",
              "LIMIT_ERROR",
              "FIELD_ERROR",
              "TEST_ERROR",
              "JSON_FORMAT_ERROR",
              "LICENSE_ERROR",
              "VSPHERE_INTEGRATION_ERROR",
              "VROPS_INTEGRATION_ERROR",
              "UPGRADE_ERROR",
              "SEARCH_ERROR",
              "AGENT_ERROR",
              "RBAC_COMMON_ERROR",
              "RBAC_USERS_ERROR",
              "RBAC_GROUPS_ERROR",
              "RBAC_ADGROUPS_ERROR",
              "RBAC_DATASETS_ERROR",
              "RBAC_VIDM_GROUPS_ERROR",
              "RBAC_VIDB_GROUPS_ERROR",
              "AUTH_PROVIDER_ERROR",
              "SECURITY_ERROR",
              "DEPLOYMENT_ERROR",
              "SUPPORT_BUNDLE_ERROR",
              "VIP_ERROR",
              "LOAD_BALANCER_ERROR",
              "VIDM_ERROR",
              "VIDB_ERROR",
              "AD_ERROR",
              "WEBHOOK_ERROR",
              "WEB_PROXY_ERROR",
              "SMTP_ERROR",
              "QUERY_ERROR",
              "CERTIFICATE_PEM_FORMAT_ERROR",
              "CERTIFICATE_FILE_INVALID",
              "CERTIFICATE_UPDATE_ERROR",
              "NSX_INTEGRATION_ERROR",
              "NSX_MANAGER_CONNECTIVITY_ERROR",
              "NO_CONFIGURATION_ERROR",
              "SSL_ERROR",
              "CERTIFICATE_PURPOSE_ERROR",
              "VCF_CAPABILITIES_REGISTRY_ERROR",
              "VALIDATION_ERROR",
              "INTERNAL_SERVER_ERROR",
              "UNPROCESSABLE_ENTITY",
              "RESOURCE_EXHAUSTED"
            ]
          },
          "errorDetails": {
            "type": "object"
          },
          "errorMessage": {
            "type": "string"
          }
        }
      },
      "Pageable": {
        "type": "object",
        "properties": {
          "page": {
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "sort": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "OPSTokenAuthorization": {
        "description": "This documentation covers v2 API endpoints.\n\nAuthenticated requests must include an X-JWT-Token header with a token retrieved with the following authenticated call to VCF Operation API : \n\nPOST /suite-api/api/auth/token/exchange \n\nRequest body {\"serviceKeys\": [\"ops-li\"]}.\n\nAccess is allowed only to resources that the user is authorized to use.",
        "in": "header",
        "name": "X-JWT-Token",
        "type": "apiKey"
      }
    }
  }
}

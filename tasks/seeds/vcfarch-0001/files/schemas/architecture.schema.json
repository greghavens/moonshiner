{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:moonshiner:vcfarch:architecture:1",
  "title": "VCF stretched management-domain architecture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "designId", "targetRelease", "sites", "managementDomain", "capacity", "networks"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "designId": {"type": "string", "minLength": 1},
    "targetRelease": {"type": "string", "minLength": 1},
    "sites": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["siteId", "role", "location", "hosts"],
        "properties": {
          "siteId": {"type": "string", "minLength": 1},
          "role": {"enum": ["DATA", "WITNESS"]},
          "location": {"type": "string", "minLength": 1},
          "hosts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "managementDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "stretched", "dataSites", "preferredDataSite", "dataHosts", "availability", "witness"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "stretched": {"type": "boolean"},
        "dataSites": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}},
        "preferredDataSite": {"type": "string", "minLength": 1},
        "dataHosts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hostname", "siteId", "cpuCores", "memoryGiB", "rawStorageTiB"],
            "properties": {
              "hostname": {"type": "string", "minLength": 1},
              "siteId": {"type": "string", "minLength": 1},
              "cpuCores": {"type": "integer", "minimum": 1},
              "memoryGiB": {"type": "integer", "minimum": 1},
              "rawStorageTiB": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dataSiteFailuresToTolerate", "localHostFailuresToTolerate", "vsanFailuresToTolerate"],
          "properties": {
            "dataSiteFailuresToTolerate": {"type": "integer", "minimum": 0},
            "localHostFailuresToTolerate": {"type": "integer", "minimum": 0},
            "vsanFailuresToTolerate": {"type": "integer", "minimum": 0}
          }
        },
        "witness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["siteId", "hostname", "address", "faultDomain", "applianceCount", "isDataHost", "includedInInstallerHostSpecs"],
          "properties": {
            "siteId": {"type": "string", "minLength": 1},
            "hostname": {"type": "string", "minLength": 1},
            "address": {"type": "string", "minLength": 1},
            "faultDomain": {"type": "string", "minLength": 1},
            "applianceCount": {"type": "integer", "minimum": 1},
            "isDataHost": {"type": "boolean"},
            "includedInInstallerHostSpecs": {"type": "boolean"}
          }
        }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clusterCpuCores", "clusterMemoryGiB", "clusterRawStorageTiB", "designedUsableStorageTiB", "survivingSiteCpuCores", "survivingSiteMemoryGiB", "survivingSiteRawStorageTiB"],
      "properties": {
        "clusterCpuCores": {"type": "integer", "minimum": 1},
        "clusterMemoryGiB": {"type": "integer", "minimum": 1},
        "clusterRawStorageTiB": {"type": "number", "exclusiveMinimum": 0},
        "designedUsableStorageTiB": {"type": "number", "exclusiveMinimum": 0},
        "survivingSiteCpuCores": {"type": "integer", "minimum": 1},
        "survivingSiteMemoryGiB": {"type": "integer", "minimum": 1},
        "survivingSiteRawStorageTiB": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "networks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "vlanId", "subnet", "gateway", "mtu", "stretchedAcrossDataSites"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "vlanId": {"type": "integer", "minimum": 0, "maximum": 4094},
          "subnet": {"type": "string", "minLength": 1},
          "gateway": {"type": "string", "minLength": 1},
          "mtu": {"type": "integer", "minimum": 1280},
          "stretchedAcrossDataSites": {"type": "boolean"}
        }
      }
    }
  }
}

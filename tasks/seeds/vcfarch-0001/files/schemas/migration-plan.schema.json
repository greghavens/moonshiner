{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:moonshiner:vcfarch:migration-plan:1",
  "title": "VCF 9.1 ordered migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "estateId", "sourceRelease", "targetRelease", "steps"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "sourceRelease": {"type": "string", "minLength": 1},
    "targetRelease": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "componentId", "componentName", "currentVersion", "targetVersion", "action", "gate"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "componentId": {"type": "string", "minLength": 1},
          "componentName": {"type": "string", "minLength": 1},
          "currentVersion": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "action": {"enum": ["UPGRADE", "DEPLOY", "MIGRATE", "RETIRE"]},
          "gate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requiredPredecessors", "checks"],
            "properties": {
              "requiredPredecessors": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "checks": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}

+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+function New-VcfGreenfieldSddcSpec {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [pscustomobject]$Requirements
+    )
+
+    $hostSpecs = [System.Collections.Generic.List[VMware.Bindings.Vcf.Installer.Model.SddcHostSpec]]::new()
+    foreach ($site in @($Requirements.sites | Where-Object role -CEQ 'DATA')) {
+        foreach ($hostname in $site.hosts) {
+            $hostSpecs.Add((Initialize-VcfInstallerSddcHostSpec -Hostname $hostname))
+        }
+    }
+
+    $networkSpecs = [System.Collections.Generic.List[VMware.Bindings.Vcf.Installer.Model.SddcNetworkSpec]]::new()
+    foreach ($network in $Requirements.networks) {
+        $range = Initialize-VcfInstallerIpRange `
+            -StartIpAddress $network.poolStart `
+            -EndIpAddress $network.poolEnd
+        $networkSpecs.Add((Initialize-VcfInstallerSddcNetworkSpec `
+            -NetworkType $network.type `
+            -VlanId $network.vlanId `
+            -Subnet $network.subnet `
+            -Gateway $network.gateway `
+            -Mtu $network.mtu `
+            -IncludeIpAddressRanges @($range) `
+            -IpAddressVersion 'IPv4' `
+            -IpAddressAssignmentMode 'STATIC'))
+    }
+
+    $dnsSpec = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $Requirements.dns.subdomain `
+        -Nameservers @($Requirements.dns.nameServers)
+
+    $vcenterSpec = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname $Requirements.componentFqdns.vcenter `
+        -RootVcenterPassword 'ChangeMe!12345678' `
+        -VmSize 'medium' `
+        -StorageSize 'lstorage' `
+        -SsoDomain 'vsphere.local' `
+        -Version $Requirements.targetRelease `
+        -UseExistingDeployment $false
+
+    $clusterSpec = Initialize-VcfInstallerSddcClusterSpec `
+        -DatacenterName 'cus-m01-dc01' `
+        -ClusterName 'cus-m01-cl01'
+
+    $uplinks = [System.Collections.Generic.List[VMware.Bindings.Vcf.Installer.Model.VmnicToUplink]]::new()
+    $uplinks.Add((Initialize-VcfInstallerVmnicToUplink -Id 'vmnic0' -Uplink 'uplink1'))
+    $uplinks.Add((Initialize-VcfInstallerVmnicToUplink -Id 'vmnic1' -Uplink 'uplink2'))
+    $dvsSpec = Initialize-VcfInstallerDvsSpec `
+        -DvsName 'cus-m01-cl01-vds01' `
+        -Networks @($Requirements.networks.type) `
+        -Mtu 9000 `
+        -VmnicsToUplinks $uplinks
+
+    $esaConfig = Initialize-VcfInstallerVsanEsaConfig -Enabled $true
+    $vsanSpec = Initialize-VcfInstallerVsanSpec `
+        -DatastoreName 'cus-m01-cl01-vsan01' `
+        -EsaConfig $esaConfig `
+        -FailuresToTolerate $Requirements.availability.localHostFailuresToTolerate
+    $datastoreSpec = Initialize-VcfInstallerSddcDatastoreSpec -VsanSpec $vsanSpec
+
+    $nsxManagers = [System.Collections.Generic.List[VMware.Bindings.Vcf.Installer.Model.NsxtManagerSpec]]::new()
+    foreach ($managerFqdn in $Requirements.componentFqdns.nsxManagers) {
+        $nsxManagers.Add((Initialize-VcfInstallerNsxtManagerSpec -Hostname $managerFqdn))
+    }
+    $hostTepNetwork = $Requirements.networks | Where-Object type -CEQ 'HOST_TEP'
+    $nsxtSpec = Initialize-VcfInstallerSddcNsxtSpec `
+        -NsxtManagers $nsxManagers `
+        -VipFqdn $Requirements.componentFqdns.nsxVip `
+        -NsxtManagerSize 'medium' `
+        -RootNsxtManagerPassword 'ChangeMe!12345678' `
+        -NsxtAdminPassword 'ChangeMe!12345678' `
+        -NsxtAuditPassword 'ChangeMe!12345678' `
+        -TransportVlanId $hostTepNetwork.vlanId `
+        -Version $Requirements.targetRelease `
+        -UseExistingDeployment $false
+
+    $sddcManagerSpec = Initialize-VcfInstallerSddcManagerSpec `
+        -Hostname $Requirements.componentFqdns.sddcManager `
+        -RootPassword 'ChangeMe!12345678' `
+        -SshPassword 'ChangeMe!12345678' `
+        -LocalUserPassword 'ChangeMe!12345678' `
+        -Version $Requirements.targetRelease `
+        -UseExistingDeployment $false
+    $licenseServerSpec = Initialize-VcfInstallerLicenseServerSpec `
+        -Hostname $Requirements.componentFqdns.licenseServer `
+        -Version $Requirements.targetRelease `
+        -UseExistingDeployment $false
+
+    return Initialize-VcfInstallerSddcSpec `
+        -SddcId $Requirements.managementDomainName `
+        -WorkflowType 'VCF' `
+        -HostSpecs $hostSpecs `
+        -Version $Requirements.targetRelease `
+        -VcenterSpec $vcenterSpec `
+        -ClusterSpec $clusterSpec `
+        -DvsSpecs @($dvsSpec) `
+        -NsxtSpec $nsxtSpec `
+        -NetworkSpecs $networkSpecs `
+        -DnsSpec $dnsSpec `
+        -NtpServers @($Requirements.dns.ntpServers) `
+        -SddcManagerSpec $sddcManagerSpec `
+        -ManagementPoolName 'cus-m01-network-pool' `
+        -CeipEnabled $false `
+        -SkipEsxThumbprintValidation $false `
+        -SkipGatewayPingValidation $false `
+        -DatastoreSpec $datastoreSpec `
+        -LicenseServerSpec $licenseServerSpec `
+        -VcfInstanceName $Requirements.vcfInstanceName
+}
+
+function New-VcfStretchedArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [pscustomobject]$Requirements,
+
+        [Parameter(Mandatory)]
+        [pscustomobject]$CompatibilitySnapshot
+    )
+
+    $dataSites = @($Requirements.sites | Where-Object role -CEQ 'DATA')
+    $architectureSites = foreach ($site in $Requirements.sites) {
+        [ordered]@{
+            siteId = $site.id
+            role = $site.role
+            location = $site.location
+            hosts = @($site.hosts)
+        }
+    }
+    $dataHosts = foreach ($site in $dataSites) {
+        foreach ($hostname in $site.hosts) {
+            [ordered]@{
+                hostname = $hostname
+                siteId = $site.id
+                cpuCores = [int]$Requirements.capacity.cpuCoresPerHost
+                memoryGiB = [int]$Requirements.capacity.memoryGiBPerHost
+                rawStorageTiB = [double]$Requirements.capacity.rawStorageTiBPerHost
+            }
+        }
+    }
+    $architectureNetworks = foreach ($network in $Requirements.networks) {
+        [ordered]@{
+            type = $network.type
+            vlanId = [int]$network.vlanId
+            subnet = $network.subnet
+            gateway = $network.gateway
+            mtu = [int]$network.mtu
+            stretchedAcrossDataSites = [bool]$network.stretchedAcrossDataSites
+        }
+    }
+
+    $hostCount = [int]$Requirements.capacity.dataHostCount
+    $siteHostCount = [int]$Requirements.capacity.dataHostsPerSite
+    $clusterRawStorage = $hostCount * [double]$Requirements.capacity.rawStorageTiBPerHost
+    return [ordered]@{
+        schemaVersion = '1.0'
+        designId = $Requirements.designId
+        targetRelease = $Requirements.targetRelease
+        sites = @($architectureSites)
+        managementDomain = [ordered]@{
+            name = $Requirements.managementDomainName
+            stretched = [bool]$Requirements.availability.stretchedManagementDomain
+            dataSites = @($dataSites.id)
+            preferredDataSite = $Requirements.availability.preferredDataSite
+            dataHosts = @($dataHosts)
+            availability = [ordered]@{
+                dataSiteFailuresToTolerate = [int]$Requirements.availability.dataSiteFailuresToTolerate
+                localHostFailuresToTolerate = [int]$Requirements.availability.localHostFailuresToTolerate
+                vsanFailuresToTolerate = [int]$CompatibilitySnapshot.greenfield.failuresToTolerate
+            }
+            witness = [ordered]@{
+                siteId = $Requirements.witness.siteId
+                hostname = $Requirements.witness.hostname
+                address = $Requirements.witness.address
+                faultDomain = $CompatibilitySnapshot.greenfield.witnessFaultDomain
+                applianceCount = [int]$CompatibilitySnapshot.greenfield.witnessCount
+                isDataHost = [bool]$CompatibilitySnapshot.greenfield.witnessIsDataHost
+                includedInInstallerHostSpecs = $false
+            }
+        }
+        capacity = [ordered]@{
+            clusterCpuCores = $hostCount * [int]$Requirements.capacity.cpuCoresPerHost
+            clusterMemoryGiB = $hostCount * [int]$Requirements.capacity.memoryGiBPerHost
+            clusterRawStorageTiB = $clusterRawStorage
+            designedUsableStorageTiB = $clusterRawStorage / 4
+            survivingSiteCpuCores = $siteHostCount * [int]$Requirements.capacity.cpuCoresPerHost
+            survivingSiteMemoryGiB = $siteHostCount * [int]$Requirements.capacity.memoryGiBPerHost
+            survivingSiteRawStorageTiB = $siteHostCount * [double]$Requirements.capacity.rawStorageTiBPerHost
+        }
+        networks = @($architectureNetworks)
+    }
+}
+
+function New-VcfMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [pscustomobject]$Inventory,
+
+        [Parameter(Mandatory)]
+        [pscustomobject]$CompatibilitySnapshot
+    )
+
+    $steps = foreach ($authority in @($CompatibilitySnapshot.migration | Sort-Object order)) {
+        $component = @($Inventory.components | Where-Object componentId -CEQ $authority.componentId)
+        if ($component.Count -ne 1) {
+            throw "Inventory component '$($authority.componentId)' is missing or duplicated"
+        }
+        if ($authority.supportedFrom -cnotcontains $component[0].currentVersion) {
+            throw "Current version for '$($authority.componentId)' is not supported by the pinned snapshot"
+        }
+        [ordered]@{
+            order = [int]$authority.order
+            componentId = $component[0].componentId
+            componentName = $component[0].name
+            currentVersion = $component[0].currentVersion
+            targetVersion = $authority.targetVersion
+            action = $authority.action
+            gate = [ordered]@{
+                requiredPredecessors = @($authority.requiredPredecessors)
+                checks = @($authority.requiredChecks)
+            }
+        }
+    }
+
+    if (@($steps).Count -ne @($Inventory.components).Count) {
+        throw 'Compatibility snapshot does not cover every estate component'
+    }
+    return [ordered]@{
+        schemaVersion = '1.0'
+        estateId = $Inventory.estateId
+        sourceRelease = $Inventory.vcfRelease
+        targetRelease = $CompatibilitySnapshot.targetRelease
+        steps = @($steps)
+    }
+}
+
+function Export-VcfArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string]$RequirementsPath,
+
+        [Parameter(Mandatory)]
+        [string]$InventoryPath,
+
+        [Parameter(Mandatory)]
+        [string]$CompatibilitySnapshotPath,
+
+        [Parameter(Mandatory)]
+        [string]$OutputDirectory
+    )
+
+    $requirements = Get-Content -LiteralPath $RequirementsPath -Raw | ConvertFrom-Json -Depth 100
+    $inventory = Get-Content -LiteralPath $InventoryPath -Raw | ConvertFrom-Json -Depth 100
+    $snapshot = Get-Content -LiteralPath $CompatibilitySnapshotPath -Raw | ConvertFrom-Json -Depth 100
+    [void](New-Item -ItemType Directory -Path $OutputDirectory -Force)
+
+    $sddcSpec = New-VcfGreenfieldSddcSpec -Requirements $requirements
+    $architecture = New-VcfStretchedArchitecture -Requirements $requirements -CompatibilitySnapshot $snapshot
+    $migration = New-VcfMigrationPlan -Inventory $inventory -CompatibilitySnapshot $snapshot
+
+    [System.IO.File]::WriteAllText(
+        (Join-Path $OutputDirectory 'greenfield-sddc-spec.json'),
+        $sddcSpec.ToJson() + [Environment]::NewLine
+    )
+    [System.IO.File]::WriteAllText(
+        (Join-Path $OutputDirectory 'architecture.json'),
+        ($architecture | ConvertTo-Json -Depth 100) + [Environment]::NewLine
+    )
+    [System.IO.File]::WriteAllText(
+        (Join-Path $OutputDirectory 'migration-plan.json'),
+        ($migration | ConvertTo-Json -Depth 100) + [Environment]::NewLine
+    )
+}
+
+Export-ModuleMember -Function @(
+    'New-VcfGreenfieldSddcSpec',
+    'New-VcfStretchedArchitecture',
+    'New-VcfMigrationPlan',
+    'Export-VcfArchitecture'
+)

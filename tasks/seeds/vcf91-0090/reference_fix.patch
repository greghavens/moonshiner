+function Invoke-VcfVcenterRolePage {
+    param(
+        [Parameter(Mandatory)]
+        $Session,
+
+        [Parameter(Mandatory)]
+        [hashtable] $Parameters
+    )
+
+    $OperationId = 'Vcenter.Authorization.Roles_list'
+    try {
+        return & $Session.OperationInvoker `
+            $OperationId `
+            $Parameters `
+            $Session.Server
+    }
+    catch {
+        $Status = Get-VcfVcenterStatusCode -ErrorRecord $_
+        if ($Status -ne 401) {
+            throw
+        }
+    }
+
+    try {
+        $Replacement = & $Session.RefreshConnection $Session.Server
+    }
+    catch {
+        throw [InvalidOperationException]::new(
+            'The vCenter SDK connection refresh failed.'
+        )
+    }
+    if ($null -eq $Replacement) {
+        throw [InvalidOperationException]::new(
+            'The vCenter SDK connection refresh returned no connection.'
+        )
+    }
+    $Session.Server = $Replacement
+
+    try {
+        return & $Session.OperationInvoker `
+            $OperationId `
+            $Parameters `
+            $Session.Server
+    }
+    catch {
+        $RetryStatus = Get-VcfVcenterStatusCode -ErrorRecord $_
+        if ($RetryStatus -eq 401) {
+            throw [InvalidOperationException]::new(
+                'The vCenter request remained unauthorized after one refresh.'
+            )
+        }
+        throw
+    }
+}

+function Get-VcfVcenterMember {
+    param(
+        [AllowNull()]
+        $InputObject,
+
+        [Parameter(Mandatory)]
+        [string[]] $Name
+    )
+
+    if ($null -ne $InputObject) {
+        foreach ($Candidate in $Name) {
+            $Property = $InputObject.PSObject.Properties[$Candidate]
+            if ($null -ne $Property) {
+                return [pscustomobject]@{
+                    Found = $true
+                    Value = $Property.Value
+                }
+            }
+        }
+    }
+    return [pscustomobject]@{
+        Found = $false
+        Value = $null
+    }
+}
+
+function Get-VcfVcenterStatusCode {
+    param(
+        [Parameter(Mandatory)]
+        $ErrorRecord
+    )
+
+    $Exception = $ErrorRecord.Exception
+    while ($null -ne $Exception) {
+        $Direct = Get-VcfVcenterMember `
+            -InputObject $Exception `
+            -Name @('StatusCode')
+        if ($Direct.Found -and $null -ne $Direct.Value) {
+            try {
+                return [int] $Direct.Value
+            }
+            catch {
+                # Keep inspecting the exception chain.
+            }
+        }
+
+        $Response = Get-VcfVcenterMember `
+            -InputObject $Exception `
+            -Name @('Response')
+        if ($Response.Found -and $null -ne $Response.Value) {
+            $ResponseStatus = Get-VcfVcenterMember `
+                -InputObject $Response.Value `
+                -Name @('StatusCode')
+            if ($ResponseStatus.Found -and $null -ne $ResponseStatus.Value) {
+                try {
+                    return [int] $ResponseStatus.Value
+                }
+                catch {
+                    # Keep inspecting the exception chain.
+                }
+            }
+        }
+
+        if (
+            $null -ne $Exception.Data -and
+            $Exception.Data.Contains('StatusCode')
+        ) {
+            try {
+                return [int] $Exception.Data['StatusCode']
+            }
+            catch {
+                # Keep inspecting the exception chain.
+            }
+        }
+        $Exception = $Exception.InnerException
+    }
+    return $null
+}
+
+function Invoke-VcfVcenterSdkOperation {
+    param(
+        [Parameter(Mandatory)]
+        [string] $OperationId,
+
+        [Parameter(Mandatory)]
+        [hashtable] $Parameters,
+
+        [Parameter(Mandatory)]
+        $Server
+    )
+
+    if ($OperationId -cne 'Vcenter.Authorization.Roles_list') {
+        throw "vCenter operation '$OperationId' is outside the pinned contract."
+    }
+    if (-not (Get-Module -Name VMware.Sdk.vSphere)) {
+        Import-Module VMware.Sdk.vSphere -ErrorAction Stop
+    }
+
+    $IterationArguments = @{
+        PageSize = [long] $Parameters.PageSize
+    }
+    if ($Parameters.ContainsKey('Marker')) {
+        $IterationArguments.Marker = [string] $Parameters.Marker
+    }
+    $Iteration = Initialize-VcenterAuthorizationRolesIterationSpec `
+        @IterationArguments
+    return Invoke-VcenterAuthorizationRolesList `
+        -Iterate $Iteration `
+        -Server $Server `
+        -ErrorAction Stop
+}

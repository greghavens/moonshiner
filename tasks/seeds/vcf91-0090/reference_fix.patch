+function Get-VcfVcenterSortedRoles {
+    param(
+        [Parameter(Mandatory)]
+        [AllowEmptyCollection()]
+        [object[]] $Role
+    )
+
+    $Sorted = [Collections.Generic.List[object]]::new()
+    foreach ($Item in $Role) {
+        $Sorted.Add($Item)
+    }
+    $Comparison = [Comparison[object]] {
+        param($Left, $Right)
+
+        $LeftInfo = Get-VcfVcenterMember `
+            -InputObject $Left `
+            -Name @('Info', 'info')
+        $RightInfo = Get-VcfVcenterMember `
+            -InputObject $Right `
+            -Name @('Info', 'info')
+        $LeftName = Get-VcfVcenterMember `
+            -InputObject $LeftInfo.Value `
+            -Name @('Name', 'name')
+        $RightName = Get-VcfVcenterMember `
+            -InputObject $RightInfo.Value `
+            -Name @('Name', 'name')
+        $Result = [StringComparer]::Ordinal.Compare(
+            [string] $LeftName.Value,
+            [string] $RightName.Value
+        )
+        if ($Result -ne 0) {
+            return $Result
+        }
+
+        $LeftRole = Get-VcfVcenterMember `
+            -InputObject $Left `
+            -Name @('Role', 'role')
+        $RightRole = Get-VcfVcenterMember `
+            -InputObject $Right `
+            -Name @('Role', 'role')
+        return [StringComparer]::Ordinal.Compare(
+            [string] $LeftRole.Value,
+            [string] $RightRole.Value
+        )
+    }
+    $Sorted.Sort($Comparison)
+    return $Sorted.ToArray()
 }
 

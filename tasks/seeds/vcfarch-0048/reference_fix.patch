+from __future__ import annotations
+
+from typing import Any
+
+
+def placeholder(_label: str) -> str:
+    return "ChangeMe-Only9!"
+
+
+def build_sddc_spec(inventory: dict[str, Any], compatibility: dict[str, Any]) -> dict[str, Any]:
+    requirements = inventory["greenfieldRequirements"]
+    management = requirements["managementDomain"]
+    rules = compatibility["greenfieldRules"]
+    versions = rules["componentVersions"]
+    sites = requirements["dataSites"]
+
+    data_sites = []
+    host_specs = []
+    for site in sites:
+        hosts = site["hosts"]
+        hostnames = [host["hostname"] for host in hosts]
+        data_sites.append(
+            {
+                "id": site["id"],
+                "failureDomain": site["failureDomain"],
+                "hosts": hostnames,
+                "capacity": {
+                    "cpuCores": sum(host["cpuCores"] for host in hosts),
+                    "memoryGiB": sum(host["memoryGiB"] for host in hosts),
+                    "usableStorageTiB": sum(host["usableStorageTiB"] for host in hosts),
+                },
+            }
+        )
+        host_specs.extend(
+            {
+                "hostname": hostname,
+                "credentials": {"username": "root", "password": placeholder(hostname)},
+            }
+            for hostname in hostnames
+        )
+
+    witness_requirement = requirements["witness"]
+    topology = {
+        "model": rules["availabilityModel"],
+        "storage": rules["managementDomainStorage"],
+        "siteFailuresToTolerate": rules["siteFailuresToTolerate"],
+        "hostVersion": versions["esxi"],
+        "requiredAfterSiteFailure": management["requiredAfterSiteFailure"],
+        "stretchedNetworks": list(rules["requiredStretchedNetworks"]),
+        "interSiteRttMs": requirements["latency"]["interSiteRttMs"],
+        "dataSites": data_sites,
+        "witness": {
+            "hostname": witness_requirement["hostname"],
+            "site": witness_requirement["site"],
+            "failureDomain": witness_requirement["failureDomain"],
+            "managementIp": witness_requirement["managementIp"],
+            "witnessIp": witness_requirement["witnessIp"],
+            "version": versions["vsanWitness"],
+            "runsManagementWorkloads": False,
+            "listedAsDataHost": False,
+            "rttMs": requirements["latency"]["witnessRttMs"],
+        },
+    }
+
+    network_specs = []
+    for network in requirements["requiredNetworks"]:
+        item = dict(network)
+        if item["networkType"] in {"VMOTION", "VSAN"}:
+            item["teamingPolicy"] = "loadbalance_loadbased"
+        network_specs.append(item)
+
+    return {
+        "sddcId": requirements["sddcId"],
+        "vcfInstanceName": requirements["vcfInstanceName"],
+        "version": compatibility["targetRelease"],
+        "workflowType": rules["workflowType"],
+        "hostSpecs": host_specs,
+        "vcenterSpec": {
+            "vcenterHostname": "vcenter01.mgmt.northstar.example.com",
+            "rootVcenterPassword": placeholder("VCENTER-ROOT"),
+            "ssoDomain": "vsphere.local",
+            "adminUserSsoUsername": "administrator",
+            "adminUserSsoPassword": placeholder("SSO-ADMIN"),
+            "vmSize": "medium",
+            "storageSize": "lstorage",
+            "useExistingDeployment": False,
+            "version": versions["vcenter"],
+        },
+        "clusterSpec": {
+            "datacenterName": management["datacenterName"],
+            "clusterName": management["clusterName"],
+        },
+        "dvsSpecs": [
+            {
+                "dvsName": "northstar-m01-vds01",
+                "networks": [network["networkType"] for network in requirements["requiredNetworks"]],
+                "mtu": 9000,
+                "vmnicsToUplinks": [
+                    {"id": "vmnic0", "uplink": "uplink1"},
+                    {"id": "vmnic1", "uplink": "uplink2"},
+                ],
+            }
+        ],
+        "nsxtSpec": {
+            "nsxtManagers": [
+                {"hostname": "nsx01.mgmt.northstar.example.com"},
+                {"hostname": "nsx02.mgmt.northstar.example.com"},
+                {"hostname": "nsx03.mgmt.northstar.example.com"},
+            ],
+            "nsxtManagerSize": "medium",
+            "vipFqdn": "nsx.mgmt.northstar.example.com",
+            "rootNsxtManagerPassword": placeholder("NSX-ROOT"),
+            "nsxtAdminPassword": placeholder("NSX-ADMIN"),
+            "nsxtAuditPassword": placeholder("NSX-AUDIT"),
+            "transportVlanId": 1650,
+            "useExistingDeployment": False,
+            "version": versions["nsx"],
+        },
+        "networkSpecs": network_specs,
+        "dnsSpec": {
+            "subdomain": requirements["dns"]["subdomain"],
+            "nameservers": requirements["dns"]["nameservers"],
+        },
+        "ntpServers": requirements["dns"]["ntpServers"],
+        "sddcManagerSpec": {
+            "hostname": "sddc-manager.mgmt.northstar.example.com",
+            "rootPassword": placeholder("SDDC-ROOT"),
+            "sshPassword": placeholder("SDDC-SSH"),
+            "localUserPassword": placeholder("SDDC-LOCAL"),
+            "useExistingDeployment": False,
+            "version": versions["sddcManager"],
+        },
+        "managementPoolName": "northstar-m01-network-pool",
+        "datastoreSpec": {
+            "vsanSpec": {
+                "datastoreName": "northstar-m01-vsan01",
+                "failuresToTolerate": rules["siteFailuresToTolerate"],
+            }
+        },
+        "architectureTopology": topology,
+    }
+
+
+def build_migration_plan(inventory: dict[str, Any], compatibility: dict[str, Any]) -> dict[str, Any]:
+    current_by_id = {component["id"]: component for component in inventory["existingComponents"]}
+    rules = sorted(compatibility["upgradePath"]["components"], key=lambda item: item["sequence"])
+    steps = []
+    for rule in rules:
+        current = current_by_id[rule["componentId"]]
+        steps.append(
+            {
+                "sequence": rule["sequence"],
+                "componentId": current["id"],
+                "componentName": current["name"],
+                "currentVersion": current["version"],
+                "targetProduct": rule["targetProduct"],
+                "targetVersion": rule["targetVersion"],
+                "action": rule["action"],
+                "gates": list(rule["requiredGates"]),
+            }
+        )
+    return {
+        "schemaVersion": "1.0",
+        "estateId": inventory["estateId"],
+        "targetRelease": compatibility["targetRelease"],
+        "steps": steps,
+    }

+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from .builder import build_migration_plan, build_sddc_spec
+
+
+def read_json(path: Path) -> dict:
+    with path.open("r", encoding="utf-8") as stream:
+        return json.load(stream)
+
+
+def write_json(path: Path, value: object) -> None:
+    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description="Generate the Northstar VCF 9.0 architecture artifacts")
+    parser.add_argument("--inventory", type=Path, required=True)
+    parser.add_argument("--compatibility", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    return parser.parse_args()
+
+
+def main() -> int:
+    args = parse_args()
+    inventory = read_json(args.inventory)
+    compatibility = read_json(args.compatibility)
+    args.output.mkdir(parents=True, exist_ok=True)
+    write_json(args.output / "sddc-spec.json", build_sddc_spec(inventory, compatibility))
+    write_json(args.output / "migration-plan.json", build_migration_plan(inventory, compatibility))
+    write_json(
+        args.output / "research-sources.json",
+        {
+            "consulted": [
+                {
+                    "title": "Minimum number of ESXi hosts required on vSAN clusters for deployment of VCF Management Domain",
+                    "url": "https://knowledge.broadcom.com/external/article/392993/minimum-number-of-esxi-hosts-required-on.html",
+                    "accessedAt": "2026-08-14",
+                    "usedFor": "Two-site stretched vSAN management-domain host minimum and storage constraint",
+                },
+                {
+                    "title": "Update Sequence for VCF 9.0 and Compatible VMware Products",
+                    "url": "https://knowledge.broadcom.com/external/article/390634/update-sequence-for-vcf-90-and-compatibl.html",
+                    "accessedAt": "2026-08-14",
+                    "usedFor": "Pre-9.0 to 9.0 component ordering, lifecycle patch, and Operations transition",
+                },
+                {
+                    "title": "Broadcom Product Interoperability Matrix",
+                    "url": "https://interopmatrix.broadcom.com/Interoperability",
+                    "accessedAt": "2026-08-14",
+                    "usedFor": "VCF 9.0 component interoperability and target combination review",
+                },
+            ],
+            "liveVsPinnedNotes": [
+                "Live sources also expose releases newer than 9.0.0.0; generated architecture values remain pinned to the supplied 9.0.0.0 snapshot."
+            ],
+        },
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

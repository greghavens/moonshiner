{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "estateId", "targetRelease", "steps"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "targetRelease": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "component", "currentVersion", "target", "action", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "component": {"type": "string", "minLength": 1},
          "currentVersion": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "action": {
            "type": "string",
            "enum": ["upgrade", "migrate-and-decommission", "decommission"]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}

+package vcfdesign
+
+import "testing"
+
+func TestBuildDesignDecisions(t *testing.T) {
+	artifact, err := Build(
+		"testdata/design-requirements.json",
+		"testdata/estate.json",
+		"testdata/compatibility-snapshot.json",
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	tests := []struct {
+		name  string
+		check func() bool
+	}{
+		{"two data sites", func() bool { return len(artifact.Greenfield.Topology.Sites) == 2 }},
+		{"four hosts survive site loss", func() bool { return artifact.Greenfield.Capacity.SiteFailureSurvivingHosts == 4 }},
+		{"external witness", func() bool {
+			return !artifact.Greenfield.Topology.StretchedManagementDomain.Witness.RunsOnManagementDomain
+		}},
+		{"all estate components planned", func() bool { return len(artifact.MigrationPlan.Steps) == 8 }},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if !test.check() {
+				t.Fatalf("design assertion failed")
+			}
+		})
+	}
+}
+
+func TestMigrationOrderIsContiguous(t *testing.T) {
+	artifact, err := Build(
+		"testdata/design-requirements.json",
+		"testdata/estate.json",
+		"testdata/compatibility-snapshot.json",
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for index, step := range artifact.MigrationPlan.Steps { // table supplied by the pinned policies
+		if step.Order != index+1 {
+			t.Fatalf("step %s has order %d, want %d", step.Component, step.Order, index+1)
+		}
+	}
+}

 // Build reads the immutable scenario inputs and returns the complete architecture.
 func Build(requirementsPath, estatePath, compatibilityPath string) (Artifact, error) {
-	return Artifact{}, errors.New("architecture design not implemented")
+	var req designRequirements
+	if err := readJSON(requirementsPath, &req); err != nil {
+		return Artifact{}, err
+	}
+	var estate estateInput
+	if err := readJSON(estatePath, &estate); err != nil {
+		return Artifact{}, err
+	}
+	var compatibility compatibilityInput
+	if err := readJSON(compatibilityPath, &compatibility); err != nil {
+		return Artifact{}, err
+	}
+	if req.TargetRelease != compatibility.TargetRelease {
+		return Artifact{}, fmt.Errorf("requirements target %s is absent from compatibility snapshot", req.TargetRelease)
+	}
+	pathSupported := false
+	for _, path := range compatibility.SupportedReleasePaths {
+		pathSupported = pathSupported || (path.From == estate.VCFRelease && path.To == req.TargetRelease)
+	}
+	if !pathSupported {
+		return Artifact{}, fmt.Errorf("unsupported estate path %s -> %s", estate.VCFRelease, req.TargetRelease)
+	}
+
+	var sites []SitePlacement
+	var hostSpecs []any
+	minSiteHosts := int(^uint(0) >> 1)
+	for _, site := range req.DataSites {
+		placement := SitePlacement{ID: site.ID, Role: site.Role}
+		for index := 1; index <= site.HostCount; index++ {
+			hostname := fmt.Sprintf("%s-esx%02d", site.ID, index)
+			placement.Hostnames = append(placement.Hostnames, hostname)
+			hostSpecs = append(hostSpecs, map[string]any{"hostname": hostname})
+		}
+		if site.HostCount < minSiteHosts {
+			minSiteHosts = site.HostCount
+		}
+		sites = append(sites, placement)
+	}
+	if len(sites) != 2 || minSiteHosts < 1 {
+		return Artifact{}, fmt.Errorf("stretched design requires two populated data sites")
+	}
+
+	var networkSpecs []any
+	var networkTypes []any
+	transportVLAN := 0
+	for _, network := range req.Network.Networks {
+		networkTypes = append(networkTypes, network.NetworkType)
+		networkSpecs = append(networkSpecs, map[string]any{
+			"networkType": network.NetworkType,
+			"vlanId":      network.VlanID,
+			"subnet":      network.Subnet,
+			"gateway":     network.Gateway,
+			"mtu":         req.Network.MTU,
+			"includeIpAddressRanges": []any{map[string]any{
+				"startIpAddress": network.RangeStart,
+				"endIpAddress":   network.RangeEnd,
+			}},
+		})
+		if network.NetworkType == "HOST_OVERLAY" {
+			transportVLAN = network.VlanID
+		}
+	}
+	if transportVLAN == 0 {
+		return Artifact{}, fmt.Errorf("HOST_OVERLAY network is required")
+	}
+
+	bom := make(map[string]string, len(compatibility.GreenfieldBillOfMaterials))
+	for component, version := range compatibility.GreenfieldBillOfMaterials {
+		bom[component] = version
+	}
+	domainPrefix := req.SddcID
+	domainSuffix := req.DNS.Subdomain
+	sddcSpec := map[string]any{
+		"sddcId":       req.SddcID,
+		"workflowType": "VCF",
+		"version":      req.TargetRelease,
+		"hostSpecs":    hostSpecs,
+		"vcenterSpec": map[string]any{
+			"vcenterHostname":       domainPrefix + "-vc01." + domainSuffix,
+			"rootVcenterPassword":   "ReplaceMe9!AaBb",
+			"vmSize":                "medium",
+			"storageSize":           "lstorage",
+			"ssoDomain":             "vsphere.local",
+			"version":               bom["vcenter"],
+			"useExistingDeployment": false,
+		},
+		"clusterSpec": map[string]any{
+			"datacenterName": "chi01-m01-dc",
+			"clusterName":    "chi01-m01-cl01",
+		},
+		"dvsSpecs": []any{map[string]any{
+			"dvsName":  "chi01-m01-vds01",
+			"networks": networkTypes,
+			"mtu":      req.Network.MTU,
+			"vmnicsToUplinks": []any{
+				map[string]any{"id": "vmnic0", "uplink": "uplink1"},
+				map[string]any{"id": "vmnic1", "uplink": "uplink2"},
+			},
+		}},
+		"nsxtSpec": map[string]any{
+			"nsxtManagers": []any{
+				map[string]any{"hostname": domainPrefix + "-nsx01." + domainSuffix},
+				map[string]any{"hostname": domainPrefix + "-nsx02." + domainSuffix},
+				map[string]any{"hostname": domainPrefix + "-nsx03." + domainSuffix},
+			},
+			"nsxtManagerSize":       "medium",
+			"vipFqdn":               domainPrefix + "-nsx." + domainSuffix,
+			"transportVlanId":       transportVLAN,
+			"version":               bom["nsx"],
+			"useExistingDeployment": false,
+		},
+		"networkSpecs": networkSpecs,
+		"dnsSpec": map[string]any{
+			"subdomain":   domainSuffix,
+			"nameservers": stringSliceToAny(req.DNS.Nameservers),
+		},
+		"ntpServers": stringSliceToAny(req.DNS.NTPServers),
+		"sddcManagerSpec": map[string]any{
+			"hostname":              domainPrefix + "-sddc01." + domainSuffix,
+			"version":               bom["sddc-manager"],
+			"useExistingDeployment": false,
+		},
+		"managementPoolName":          domainPrefix + "-network-pool",
+		"ceipEnabled":                 false,
+		"skipEsxThumbprintValidation": false,
+		"skipGatewayPingValidation":   false,
+		"datastoreSpec": map[string]any{
+			"vsanSpec": map[string]any{
+				"datastoreName":      domainPrefix + "-vsan01",
+				"vsanDedup":          false,
+				"failuresToTolerate": req.Availability.FailuresToTolerate,
+			},
+		},
+		"vcfInstanceName": "Chicago Metro VCF",
+	}
+
+	policyByComponent := make(map[string]struct {
+		SupportedFrom []string
+		Target        string
+		Action        string
+		Order         int
+		RequiredGates []string
+	}, len(compatibility.ComponentPolicies))
+	for _, policy := range compatibility.ComponentPolicies {
+		policyByComponent[policy.Component] = struct {
+			SupportedFrom []string
+			Target        string
+			Action        string
+			Order         int
+			RequiredGates []string
+		}{policy.SupportedFrom, policy.Target, policy.Action, policy.Order, policy.RequiredGates}
+	}
+	steps := make([]MigrationStep, 0, len(estate.Components))
+	for _, component := range estate.Components {
+		policy, ok := policyByComponent[component.Name]
+		if !ok || !stringIn(policy.SupportedFrom, component.Version) {
+			return Artifact{}, fmt.Errorf("no compatible policy for %s %s", component.Name, component.Version)
+		}
+		steps = append(steps, MigrationStep{
+			Order:          policy.Order,
+			Component:      component.Name,
+			CurrentVersion: component.Version,
+			Target:         policy.Target,
+			Action:         policy.Action,
+			Gates:          append([]string(nil), policy.RequiredGates...),
+		})
+	}
+	sort.Slice(steps, func(i, j int) bool { return steps[i].Order < steps[j].Order })
+
+	reserveFactor := 1 - float64(req.FailureEnvelope.ReservePercent)/100
+	usable := Capacity{
+		CPUCores:   roundCapacity(float64(minSiteHosts*req.HostProfile.CoresPerHost) * reserveFactor),
+		MemoryGiB:  roundCapacity(float64(minSiteHosts*req.HostProfile.MemoryGiBPerHost) * reserveFactor),
+		StorageTiB: roundCapacity(float64(minSiteHosts) * req.HostProfile.RawStorageTiBPerHost * reserveFactor),
+	}
+	if usable.CPUCores < req.FailureEnvelope.RequiredCapacity.CPUCores ||
+		usable.MemoryGiB < req.FailureEnvelope.RequiredCapacity.MemoryGiB ||
+		usable.StorageTiB < req.FailureEnvelope.RequiredCapacity.StorageTiB {
+		return Artifact{}, fmt.Errorf("surviving-site capacity misses the required reserve")
+	}
+
+	return Artifact{
+		SchemaVersion: "1.0",
+		Greenfield: Greenfield{
+			TargetRelease: req.TargetRelease,
+			SddcSpec:      sddcSpec,
+			Topology: Topology{
+				Sites:       sites,
+				HostProfile: req.HostProfile,
+				StretchedManagementDomain: StretchedManagementDomain{
+					Enabled:    req.Availability.ManagementDomainStretched,
+					RPOSeconds: req.Availability.RPOSeconds,
+					VsanPolicy: VsanPolicy{
+						FailuresToTolerate:    req.Availability.FailuresToTolerate,
+						SiteDisasterTolerance: req.Availability.SiteDisasterTolerance,
+						PreferredSite:         req.DataSites[0].ID,
+					},
+					Witness: Witness{
+						Hostname:               req.Availability.Witness.Hostname,
+						Site:                   req.Availability.Witness.Site,
+						FailureDomain:          req.Availability.Witness.FailureDomain,
+						Kind:                   req.Availability.Witness.Kind,
+						RunsOnManagementDomain: false,
+					},
+				},
+			},
+			Capacity: CapacityDecision{
+				ReservePercent:            req.FailureEnvelope.ReservePercent,
+				SiteFailureSurvivingHosts: minSiteHosts,
+				UsableAfterReserve:        usable,
+				Required:                  req.FailureEnvelope.RequiredCapacity,
+			},
+			ManagementServices: req.ManagementServices,
+			BillOfMaterials:    bom,
+		},
+		MigrationPlan: MigrationPlan{
+			SchemaVersion: "1.0",
+			EstateID:      estate.EstateID,
+			TargetRelease: req.TargetRelease,
+			Steps:         steps,
+		},
+	}, nil
 }
 
+func readJSON(path string, target any) error {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return fmt.Errorf("read %s: %w", path, err)
+	}
+	if err := json.Unmarshal(b, target); err != nil {
+		return fmt.Errorf("decode %s: %w", path, err)
+	}
+	return nil
+}
+
+func stringSliceToAny(values []string) []any {
+	result := make([]any, len(values))
+	for index, value := range values {
+		result[index] = value
+	}
+	return result
+}
+
+func stringIn(values []string, want string) bool {
+	for _, value := range values {
+		if value == want {
+			return true
+		}
+	}
+	return false
+}
+
+func roundCapacity(value float64) float64 { return math.Round(value*1000) / 1000 }

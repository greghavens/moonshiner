@@ -0,0 +1,138 @@
+#!/usr/bin/env python3
+"""Reference proof through genuine expensectl processes."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+RUNTIME = ROOT / ".harness" / "runtime"
+REPORT = ROOT / "expense-availability.md"
+TARGETS = (
+    ("Train fare 134", "Chicago", "2026-09-17"),
+    ("Team lunch 134", "Boston", "2026-09-17"),
+)
+
+
+def command(target: tuple[str, str, str]) -> list[str]:
+    name, location, date = target
+    return [
+        "./expensectl",
+        "availability",
+        "--name",
+        name,
+        "--location",
+        location,
+        "--date",
+        date,
+    ]
+
+
+def concurrent_initial() -> tuple[dict[str, Any], dict[str, Any]]:
+    output_paths = (RUNTIME / "reference-first.out", RUNTIME / "reference-second.out")
+    error_paths = (RUNTIME / "reference-first.err", RUNTIME / "reference-second.err")
+    streams = []
+    processes = []
+    try:
+        for target, output_path, error_path in zip(
+            TARGETS,
+            output_paths,
+            error_paths,
+            strict=True,
+        ):
+            output_stream = output_path.open("w", encoding="utf-8")
+            error_stream = error_path.open("w", encoding="utf-8")
+            streams.extend((output_stream, error_stream))
+            processes.append(
+                subprocess.Popen(
+                    command(target),
+                    cwd=ROOT,
+                    stdout=output_stream,
+                    stderr=error_stream,
+                    start_new_session=True,
+                )
+            )
+        codes = [process.wait(timeout=10) for process in processes]
+    finally:
+        for stream in streams:
+            stream.close()
+    if codes != [0, 75]:
+        raise RuntimeError(f"unexpected initial reference statuses: {codes}")
+    successful = json.loads(output_paths[0].read_text(encoding="utf-8"))
+    failed = json.loads(error_paths[1].read_text(encoding="utf-8"))
+    if failed.get("transient") is not True:
+        raise RuntimeError("reference branch did not return a transient failure")
+    return successful, failed
+
+
+def retry_failed() -> dict[str, Any]:
+    completed = subprocess.run(
+        command(TARGETS[1]),
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=10,
+        start_new_session=True,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "reference retry failed")
+    payload = json.loads(completed.stdout)
+    if not isinstance(payload, dict):
+        raise RuntimeError("reference retry returned invalid output")
+    return payload
+
+
+def value(payload: dict[str, Any], key: str) -> str:
+    result = payload.get(key)
+    return result if isinstance(result, str) and result else "unknown"
+
+
+def row(label: str, payload: dict[str, Any]) -> str:
+    return (
+        "| "
+        + " | ".join(
+            (
+                label,
+                value(payload, "date"),
+                value(payload, "location"),
+                value(payload, "availability"),
+                value(payload, "reason"),
+                value(payload, "processing_window"),
+            )
+        )
+        + " |\n"
+    )
+
+
+def main() -> int:
+    RUNTIME.mkdir(parents=True, exist_ok=True)
+    (RUNTIME / "expense-audit.jsonl").unlink(missing_ok=True)
+    first, _ = concurrent_initial()
+    second = retry_failed()
+    expected_identity = (
+        (TARGETS[0][0], TARGETS[0][1], TARGETS[0][2]),
+        (TARGETS[1][0], TARGETS[1][1], TARGETS[1][2]),
+    )
+    observed_identity = (
+        (first.get("name"), first.get("location"), first.get("date")),
+        (second.get("name"), second.get("location"), second.get("date")),
+    )
+    if observed_identity != expected_identity:
+        raise RuntimeError("reference responses do not match the requested branches")
+    rendered = (
+        "| Expense | Date | Location | Availability | Reason | Processing window |\n"
+        "| --- | --- | --- | --- | --- | --- |\n"
+        + row(TARGETS[0][0], first)
+        + row(TARGETS[1][0], second)
+    )
+    REPORT.write_text(rendered, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

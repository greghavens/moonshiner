diff --git a/Vcf.GreenfieldArchitecture/Vcf.GreenfieldArchitecture.psm1 b/Vcf.GreenfieldArchitecture/Vcf.GreenfieldArchitecture.psm1
new file mode 100644
index 0000000..4104c69
--- /dev/null
+++ b/Vcf.GreenfieldArchitecture/Vcf.GreenfieldArchitecture.psm1
@@ -0,0 +1,449 @@
+Set-StrictMode -Version Latest
+
+function Read-ArchitectureJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $Path
+    )
+
+    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {
+        throw "Input file does not exist: $Path"
+    }
+
+    Get-Content -LiteralPath $Path -Raw | ConvertFrom-Json -Depth 64
+}
+
+function New-VcfGreenfieldArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $RequirementsPath,
+
+        [Parameter(Mandatory)]
+        [string] $CompatibilitySnapshotPath
+    )
+
+    $requirements = Read-ArchitectureJson -Path $RequirementsPath
+    $snapshot = Read-ArchitectureJson -Path $CompatibilitySnapshotPath
+
+    if ($requirements.targetRelease -ne $snapshot.targetRelease) {
+        throw 'The design target and compatibility snapshot target do not match.'
+    }
+
+    $coresPerHost = [int]$requirements.hostProfile.socketsPerHost * [int]$requirements.hostProfile.physicalCoresPerSocket
+    $selectedCores = [int]$requirements.hostProfile.availableHostCount * $coresPerHost
+    if ($selectedCores -gt [int]$requirements.entitlement.licensedPhysicalCores) {
+        throw 'The consolidated host set exceeds the licensed physical-core entitlement.'
+    }
+
+    $remainingHosts = [int]$requirements.hostProfile.availableHostCount - [int]$requirements.availability.hostFailuresToTolerate
+    $availableVCpu = ($remainingHosts * $coresPerHost * [int]$requirements.capacityModel.vCpuPerPhysicalCore) - [int]$requirements.capacityModel.managementReserveVCpu
+    $availableMemoryGiB = ($remainingHosts * [int]$requirements.hostProfile.memoryGiBPerHost) - [int]$requirements.capacityModel.managementReserveMemoryGiB
+    $availableStorageTiB = $remainingHosts * [double]$requirements.hostProfile.rawStorageTiBPerHost * [double]$requirements.capacityModel.vsanFtt1UsableFraction * [double]$requirements.capacityModel.vsanOperationalHeadroomFraction
+    if ($availableVCpu -lt [int]$requirements.requiredCapacityAfterHostFailure.vCpu -or
+        $availableMemoryGiB -lt [int]$requirements.requiredCapacityAfterHostFailure.memoryGiB -or
+        $availableStorageTiB -lt [double]$requirements.requiredCapacityAfterHostFailure.usableStorageTiB) {
+        throw 'The selected host set does not meet the N+1 capacity contract.'
+    }
+
+    $sdkHosts = @(
+        foreach ($hostname in $requirements.hostProfile.hostnames) {
+            Initialize-VcfInstallerSddcHostSpec -Hostname $hostname
+        }
+    )
+
+    $sdkNetworks = @(
+        foreach ($network in $requirements.networks) {
+            $sdkRange = Initialize-VcfInstallerIpRange `
+                -StartIpAddress $network.startIpAddress `
+                -EndIpAddress $network.endIpAddress
+            Initialize-VcfInstallerSddcNetworkSpec `
+                -NetworkType $network.networkType `
+                -Subnet $network.subnet `
+                -Gateway $network.gateway `
+                -SubnetMask $network.subnetMask `
+                -IncludeIpAddressRanges $sdkRange `
+                -VlanId $network.vlanId `
+                -Mtu $network.mtu `
+                -TeamingPolicy 'loadbalance_loadbased' `
+                -IpAddressVersion 'IPv4' `
+                -IpAddressAssignmentMode 'STATIC'
+        }
+    )
+
+    $sdkDns = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $requirements.naming.dnsSubdomain `
+        -Nameservers $requirements.infrastructureServices.dnsServers
+    $sdkVcenter = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname $requirements.naming.vcenterFqdn `
+        -RootVcenterPassword '__VC_ROOT_SECRET__' `
+        -VmSize 'medium' `
+        -StorageSize 'lstorage' `
+        -SsoDomain 'vsphere.local' `
+        -Version $requirements.targetRelease `
+        -UseExistingDeployment $false
+    $sdkPools = @(
+        Initialize-VcfInstallerResourcePoolSpec -Name 'management' -Type 'management'
+        Initialize-VcfInstallerResourcePoolSpec -Name 'compute' -Type 'compute'
+    )
+    $sdkCluster = Initialize-VcfInstallerSddcClusterSpec `
+        -DatacenterName $requirements.naming.datacenterName `
+        -ClusterName $requirements.naming.clusterName `
+        -ResourcePoolSpecs $sdkPools
+    $sdkVmnicMappings = @(
+        Initialize-VcfInstallerVmnicToUplink -Id 'vmnic0' -Uplink 'uplink1'
+        Initialize-VcfInstallerVmnicToUplink -Id 'vmnic1' -Uplink 'uplink2'
+        Initialize-VcfInstallerVmnicToUplink -Id 'vmnic2' -Uplink 'uplink3'
+        Initialize-VcfInstallerVmnicToUplink -Id 'vmnic3' -Uplink 'uplink4'
+    )
+    $sdkDvs = Initialize-VcfInstallerDvsSpec `
+        -DvsName 'CHI01-MGMT-VDS01' `
+        -Networks $requirements.networks.networkType `
+        -Mtu 9000 `
+        -VmnicsToUplinks $sdkVmnicMappings
+    $sdkNsxManagers = @(
+        foreach ($hostname in $requirements.nsx.managerFqdns) {
+            Initialize-VcfInstallerNsxtManagerSpec -Hostname $hostname
+        }
+    )
+    $sdkNsx = Initialize-VcfInstallerSddcNsxtSpec `
+        -NsxtManagers $sdkNsxManagers `
+        -NsxtManagerSize $requirements.nsx.managerSize `
+        -VipFqdn $requirements.nsx.vipFqdn `
+        -TransportVlanId $requirements.nsx.transportVlanId `
+        -Version $requirements.targetRelease `
+        -UseExistingDeployment $false
+    $sdkVsan = Initialize-VcfInstallerVsanSpec `
+        -DatastoreName 'CHI01-MGMT-VSAN01' `
+        -VsanDedup $false `
+        -FailuresToTolerate $requirements.availability.hostFailuresToTolerate
+    $sdkDatastore = Initialize-VcfInstallerSddcDatastoreSpec -VsanSpec $sdkVsan
+    $sdkSddcManager = Initialize-VcfInstallerSddcManagerSpec `
+        -Hostname $requirements.naming.sddcManagerHostname `
+        -Version $requirements.targetRelease `
+        -UseExistingDeployment $false
+    $sdkSecurity = Initialize-VcfInstallerSecuritySpec -EsxiCertsMode 'VMCA'
+    $sdkVspPoolRange = Initialize-VcfInstallerIpRange `
+        -StartIpAddress $requirements.managementServices.ipv4PoolStart `
+        -EndIpAddress $requirements.managementServices.ipv4PoolEnd
+    $sdkVspPool = Initialize-VcfInstallerIPv4Pool `
+        -Cidr $requirements.managementServices.ipv4PoolCidr `
+        -IpRange $sdkVspPoolRange
+    $sdkVsp = Initialize-VcfInstallerSddcVspClusterSpec `
+        -PlatformFqdn $requirements.managementServices.vspPlatformFqdn `
+        -Ipv4Pool $sdkVspPool `
+        -Size 'small' `
+        -InternalClusterCidrIpv4 $requirements.managementServices.internalClusterCidrIpv4 `
+        -InstanceFqdn $requirements.managementServices.vspInstanceFqdn `
+        -FleetFqdn $requirements.managementServices.vspFleetFqdn `
+        -Version $requirements.targetRelease `
+        -UseExistingDeployment $false
+    $operationNodeTypes = @('master', 'replica', 'data')
+    $sdkOperationsNodes = @(
+        for ($index = 0; $index -lt $requirements.managementServices.vcfOperationsNodes.Count; $index++) {
+            Initialize-VcfInstallerVcfOperationsNode `
+                -Hostname $requirements.managementServices.vcfOperationsNodes[$index] `
+                -Type $operationNodeTypes[$index]
+        }
+    )
+    $sdkOperations = Initialize-VcfInstallerVcfOperationsSpec `
+        -Nodes $sdkOperationsNodes `
+        -ApplianceSize 'medium' `
+        -LoadBalancerFqdn $requirements.managementServices.vcfOperationsLoadBalancerFqdn `
+        -UseExistingDeployment $false `
+        -Version $requirements.targetRelease
+    $sdkLocalRegion = Initialize-VcfInstallerVcfManagementComponentsNetworkSpec `
+        -NetworkName 'FLEET_MANAGEMENT' `
+        -SubnetMask '255.255.255.0' `
+        -Gateway '10.61.14.1'
+    $sdkManagementInfrastructure = Initialize-VcfInstallerVcfManagementComponentsInfrastructureSpec `
+        -LocalRegionNetwork $sdkLocalRegion
+    $sdkLicenseServer = Initialize-VcfInstallerLicenseServerSpec `
+        -Hostname $requirements.entitlement.licenseServerFqdn `
+        -Version $requirements.targetRelease `
+        -UseExistingDeployment $false
+    $sdkFleetLcm = Initialize-VcfInstallerFleetLcmServiceSpec -Version $requirements.targetRelease -Size 'small'
+    $sdkSddcLcm = Initialize-VcfInstallerSddcLcmServiceSpec -Version $requirements.targetRelease -Size 'small'
+    $sdkFleetDepot = Initialize-VcfInstallerFleetDepotServiceSpec -Version $requirements.targetRelease -Size 'small'
+    $sdkTelemetry = Initialize-VcfInstallerTelemetryAcceptorSpec -Version $requirements.targetRelease -Size 'small'
+    $sdkSalt = Initialize-VcfInstallerSaltSpec -Version $requirements.targetRelease -Size 'small'
+    $sdkSaltRaas = Initialize-VcfInstallerSaltSpec -Version $requirements.targetRelease -Size 'small'
+
+    $sdkSddc = Initialize-VcfInstallerSddcSpec `
+        -SddcId $requirements.naming.sddcId `
+        -WorkflowType 'VCF_COMPLETE' `
+        -HostSpecs $sdkHosts `
+        -Version $requirements.targetRelease `
+        -VcenterSpec $sdkVcenter `
+        -ClusterSpec $sdkCluster `
+        -DvsSpecs $sdkDvs `
+        -NsxtSpec $sdkNsx `
+        -NetworkSpecs $sdkNetworks `
+        -DnsSpec $sdkDns `
+        -NtpServers $requirements.infrastructureServices.ntpServers `
+        -SddcManagerSpec $sdkSddcManager `
+        -ManagementPoolName $requirements.naming.managementPoolName `
+        -CeipEnabled $false `
+        -SkipEsxThumbprintValidation $false `
+        -SkipGatewayPingValidation $false `
+        -SecuritySpec $sdkSecurity `
+        -DatastoreSpec $sdkDatastore `
+        -VspClusterSpec $sdkVsp `
+        -FleetLcmSpec $sdkFleetLcm `
+        -SddcLcmSpec $sdkSddcLcm `
+        -FleetDepotSpec $sdkFleetDepot `
+        -TelemetryAcceptorSpec $sdkTelemetry `
+        -SaltSpec $sdkSalt `
+        -SaltRaasSpec $sdkSaltRaas `
+        -VcfOperationsSpec $sdkOperations `
+        -VcfManagementComponentsInfrastructureSpec $sdkManagementInfrastructure `
+        -LicenseServerSpec $sdkLicenseServer `
+        -VcfInstanceName $requirements.naming.vcfInstanceName
+    if ($null -eq $sdkSddc) {
+        throw 'VMware.Sdk.Vcf.Installer did not materialize the SddcSpec.'
+    }
+
+    # The SDK object above is the construction/type gate.  This canonical map
+    # preserves the OpenAPI document's camel-case wire names without emitting
+    # PowerShell SDK client metadata.
+    [ordered]@{
+        sddcId = $requirements.naming.sddcId
+        workflowType = 'VCF_COMPLETE'
+        hostSpecs = @($requirements.hostProfile.hostnames | ForEach-Object { [ordered]@{ hostname = $_ } })
+        version = $requirements.targetRelease
+        vcenterSpec = [ordered]@{
+            vcenterHostname = $requirements.naming.vcenterFqdn
+            rootVcenterPassword = '__VC_ROOT_SECRET__'
+            vmSize = 'medium'
+            storageSize = 'lstorage'
+            ssoDomain = 'vsphere.local'
+            version = $requirements.targetRelease
+            useExistingDeployment = $false
+        }
+        clusterSpec = [ordered]@{
+            datacenterName = $requirements.naming.datacenterName
+            clusterName = $requirements.naming.clusterName
+            resourcePoolSpecs = @(
+                [ordered]@{ name = 'management'; type = 'management' }
+                [ordered]@{ name = 'compute'; type = 'compute' }
+            )
+        }
+        dvsSpecs = @(
+            [ordered]@{
+                dvsName = 'CHI01-MGMT-VDS01'
+                networks = @($requirements.networks.networkType)
+                mtu = 9000
+                vmnicsToUplinks = @(
+                    [ordered]@{ id = 'vmnic0'; uplink = 'uplink1' }
+                    [ordered]@{ id = 'vmnic1'; uplink = 'uplink2' }
+                    [ordered]@{ id = 'vmnic2'; uplink = 'uplink3' }
+                    [ordered]@{ id = 'vmnic3'; uplink = 'uplink4' }
+                )
+            }
+        )
+        nsxtSpec = [ordered]@{
+            nsxtManagers = @($requirements.nsx.managerFqdns | ForEach-Object { [ordered]@{ hostname = $_ } })
+            nsxtManagerSize = $requirements.nsx.managerSize
+            vipFqdn = $requirements.nsx.vipFqdn
+            transportVlanId = $requirements.nsx.transportVlanId
+            version = $requirements.targetRelease
+            useExistingDeployment = $false
+        }
+        networkSpecs = @(
+            foreach ($network in $requirements.networks) {
+                [ordered]@{
+                    networkType = $network.networkType
+                    subnet = $network.subnet
+                    gateway = $network.gateway
+                    subnetMask = $network.subnetMask
+                    includeIpAddressRanges = @(
+                        [ordered]@{
+                            startIpAddress = $network.startIpAddress
+                            endIpAddress = $network.endIpAddress
+                        }
+                    )
+                    vlanId = $network.vlanId
+                    mtu = $network.mtu
+                    teamingPolicy = 'loadbalance_loadbased'
+                    ipAddressVersion = 'IPv4'
+                    ipAddressAssignmentMode = 'STATIC'
+                }
+            }
+        )
+        dnsSpec = [ordered]@{
+            subdomain = $requirements.naming.dnsSubdomain
+            nameservers = @($requirements.infrastructureServices.dnsServers)
+        }
+        ntpServers = @($requirements.infrastructureServices.ntpServers)
+        sddcManagerSpec = [ordered]@{
+            hostname = $requirements.naming.sddcManagerHostname
+            version = $requirements.targetRelease
+            useExistingDeployment = $false
+        }
+        managementPoolName = $requirements.naming.managementPoolName
+        ceipEnabled = $false
+        skipEsxThumbprintValidation = $false
+        skipGatewayPingValidation = $false
+        securitySpec = [ordered]@{ esxiCertsMode = 'VMCA' }
+        datastoreSpec = [ordered]@{
+            vsanSpec = [ordered]@{
+                datastoreName = 'CHI01-MGMT-VSAN01'
+                vsanDedup = $false
+                failuresToTolerate = [int]$requirements.availability.hostFailuresToTolerate
+            }
+        }
+        vspClusterSpec = [ordered]@{
+            platformFqdn = $requirements.managementServices.vspPlatformFqdn
+            ipv4Pool = [ordered]@{
+                cidr = $requirements.managementServices.ipv4PoolCidr
+                ipRange = [ordered]@{
+                    startIpAddress = $requirements.managementServices.ipv4PoolStart
+                    endIpAddress = $requirements.managementServices.ipv4PoolEnd
+                }
+            }
+            size = 'small'
+            internalClusterCidrIpv4 = $requirements.managementServices.internalClusterCidrIpv4
+            instanceFqdn = $requirements.managementServices.vspInstanceFqdn
+            fleetFqdn = $requirements.managementServices.vspFleetFqdn
+            version = $requirements.targetRelease
+            useExistingDeployment = $false
+        }
+        fleetLcmSpec = [ordered]@{ version = $requirements.targetRelease; size = 'small' }
+        sddcLcmSpec = [ordered]@{ version = $requirements.targetRelease; size = 'small' }
+        fleetDepotSpec = [ordered]@{ version = $requirements.targetRelease; size = 'small' }
+        telemetryAcceptorSpec = [ordered]@{ version = $requirements.targetRelease; size = 'small' }
+        saltSpec = [ordered]@{ version = $requirements.targetRelease; size = 'small' }
+        saltRaasSpec = [ordered]@{ version = $requirements.targetRelease; size = 'small' }
+        vcfOperationsSpec = [ordered]@{
+            nodes = @(
+                for ($index = 0; $index -lt $requirements.managementServices.vcfOperationsNodes.Count; $index++) {
+                    [ordered]@{
+                        hostname = $requirements.managementServices.vcfOperationsNodes[$index]
+                        type = $operationNodeTypes[$index]
+                    }
+                }
+            )
+            applianceSize = 'medium'
+            loadBalancerFqdn = $requirements.managementServices.vcfOperationsLoadBalancerFqdn
+            useExistingDeployment = $false
+            version = $requirements.targetRelease
+        }
+        vcfManagementComponentsInfrastructureSpec = [ordered]@{
+            localRegionNetwork = [ordered]@{
+                networkName = 'FLEET_MANAGEMENT'
+                subnetMask = '255.255.255.0'
+                gateway = '10.61.14.1'
+            }
+        }
+        licenseServerSpec = [ordered]@{
+            hostname = $requirements.entitlement.licenseServerFqdn
+            version = $requirements.targetRelease
+            useExistingDeployment = $false
+        }
+        vcfInstanceName = $requirements.naming.vcfInstanceName
+    }
+}
+
+function New-VcfMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $InventoryPath,
+
+        [Parameter(Mandatory)]
+        [string] $RequirementsPath,
+
+        [Parameter(Mandatory)]
+        [string] $CompatibilitySnapshotPath
+    )
+
+    $inventory = Read-ArchitectureJson -Path $InventoryPath
+    $requirements = Read-ArchitectureJson -Path $RequirementsPath
+    $snapshot = Read-ArchitectureJson -Path $CompatibilitySnapshotPath
+    $inventoryById = @{}
+    foreach ($component in $inventory.components) {
+        $inventoryById[$component.componentId] = $component
+    }
+
+    $coresPerHost = [int]$requirements.hostProfile.socketsPerHost * [int]$requirements.hostProfile.physicalCoresPerSocket
+    $standardCores = (
+        [int]$snapshot.topologies.STANDARD.minimumManagementDomainHosts +
+        [int]$snapshot.topologies.STANDARD.minimumViWorkloadDomainHosts
+    ) * $coresPerHost
+    $selectedCores = [int]$requirements.hostProfile.availableHostCount * $coresPerHost
+
+    $steps = @(
+        foreach ($transition in $snapshot.componentTransitions) {
+            if (-not $inventoryById.ContainsKey($transition.componentId)) {
+                throw "Snapshot transition has no inventory component: $($transition.componentId)"
+            }
+            $component = $inventoryById[$transition.componentId]
+            if ($component.currentVersion -ne $transition.fromVersion) {
+                throw "Unsupported source version for $($transition.componentId)"
+            }
+            [ordered]@{
+                order = [int]$transition.order
+                componentId = $component.componentId
+                componentName = $component.name
+                currentVersion = $component.currentVersion
+                targetVersion = $transition.targetVersion
+                action = $transition.action
+                gates = @($transition.gates)
+            }
+        }
+    )
+    if ($steps.Count -ne $inventory.components.Count) {
+        throw 'Every estate component must have exactly one pinned transition.'
+    }
+
+    [ordered]@{
+        schemaVersion = '1.0'
+        sourceEstateId = $inventory.estateId
+        targetRelease = $inventory.targetVcfRelease
+        topologyDecision = [ordered]@{
+            selectedTopology = 'CONSOLIDATED'
+            licensedCores = [int]$requirements.entitlement.licensedPhysicalCores
+            selectedTopologyCores = $selectedCores
+            rejectedTopologies = @(
+                [ordered]@{
+                    topology = 'STANDARD'
+                    reasonCode = 'ENTITLEMENT_CORE_LIMIT'
+                    requiredCores = $standardCores
+                }
+            )
+        }
+        steps = $steps
+    }
+}
+
+function Export-VcfArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $RequirementsPath,
+
+        [Parameter(Mandatory)]
+        [string] $InventoryPath,
+
+        [Parameter(Mandatory)]
+        [string] $CompatibilitySnapshotPath,
+
+        [Parameter(Mandatory)]
+        [string] $OutputDirectory
+    )
+
+    $null = New-Item -ItemType Directory -Path $OutputDirectory -Force
+    $sddc = New-VcfGreenfieldArchitecture `
+        -RequirementsPath $RequirementsPath `
+        -CompatibilitySnapshotPath $CompatibilitySnapshotPath
+    $plan = New-VcfMigrationPlan `
+        -InventoryPath $InventoryPath `
+        -RequirementsPath $RequirementsPath `
+        -CompatibilitySnapshotPath $CompatibilitySnapshotPath
+
+    $sddc | ConvertTo-Json -Depth 64 | Set-Content -LiteralPath (Join-Path $OutputDirectory 'sddc-spec.json') -Encoding utf8
+    $plan | ConvertTo-Json -Depth 64 | Set-Content -LiteralPath (Join-Path $OutputDirectory 'migration-plan.json') -Encoding utf8
+}
+
+Export-ModuleMember -Function New-VcfGreenfieldArchitecture, New-VcfMigrationPlan, Export-VcfArchitecture

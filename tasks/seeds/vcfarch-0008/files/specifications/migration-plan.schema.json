{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0008:migration-plan:1.0",
  "title": "VCF 9.1 ordered migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceEstateId",
    "targetRelease",
    "topologyDecision",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "sourceEstateId": {
      "type": "string",
      "minLength": 1
    },
    "targetRelease": {
      "type": "string",
      "minLength": 1
    },
    "topologyDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectedTopology",
        "licensedCores",
        "selectedTopologyCores",
        "rejectedTopologies"
      ],
      "properties": {
        "selectedTopology": {
          "enum": ["CONSOLIDATED", "STANDARD"]
        },
        "licensedCores": {
          "type": "integer",
          "minimum": 1
        },
        "selectedTopologyCores": {
          "type": "integer",
          "minimum": 1
        },
        "rejectedTopologies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["topology", "reasonCode", "requiredCores"],
            "properties": {
              "topology": {
                "enum": ["CONSOLIDATED", "STANDARD"]
              },
              "reasonCode": {
                "enum": ["ENTITLEMENT_CORE_LIMIT"]
              },
              "requiredCores": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "componentId",
          "componentName",
          "currentVersion",
          "targetVersion",
          "action",
          "gates"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "componentName": {
            "type": "string",
            "minLength": 1
          },
          "currentVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": ["UPGRADE", "DEPLOY", "MIGRATE", "DECOMMISSION"]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

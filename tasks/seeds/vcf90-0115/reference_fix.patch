+                        string(item.get("name"), "name"),
+                        string(item.get("status"), "status"),
+                        string(item.get("creationTimestamp"), "creationTimestamp")));
+            }
+            Map<?, ?> metadata = object(root.get("pageMetadata"), "pageMetadata");
+            return new Page(
+                    List.copyOf(elements),
+                    integer(metadata.get("pageNumber"), "pageMetadata.pageNumber"),
+                    integer(metadata.get("totalPages"), "pageMetadata.totalPages"));
+        } catch (IllegalArgumentException exception) {
+            throw new IOException("Invalid getTasks response: " + exception.getMessage(), exception);
+        }

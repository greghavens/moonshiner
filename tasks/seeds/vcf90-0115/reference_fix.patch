+                decimal = true;
+                if (!consume('+')) {
+                    consume('-');
+                }
+                readDigits();
+            }
+            if (start == position) {
+                return error("expected a value");
+            }
+            String token = input.substring(start, position);
+            try {
+                if (decimal) {
+                    return Double.valueOf(token);
+                }
+                return Long.valueOf(token);
+            } catch (NumberFormatException exception) {
+                return error("invalid number");
+            }
+        }

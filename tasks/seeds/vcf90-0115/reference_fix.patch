+                request, HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+        if (response.statusCode() != 200) {
+            throw new IOException("getTasks returned HTTP " + response.statusCode());
+        }
+        return decodePage(response.body());
+    }

+
+type acquireTokenResponse struct {
+	Token    string `json:"token"`
+	Validity int64  `json:"validity"`
+}
+
+func (c *Client) acquireToken(ctx context.Context) (string, error) {
+	body, err := json.Marshal(acquireTokenRequest{
+		Username:   c.credentials.Username,
+		AuthSource: c.credentials.AuthSource,
+		Password:   c.credentials.Password,
+	})
+	if err != nil {
+		return "", fmt.Errorf("vcfops: encode acquireToken request: %w", err)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, c.baseURL+"/suite-api/api/auth/token/acquire", bytes.NewReader(body))
+	if err != nil {
+		return "", fmt.Errorf("vcfops: create acquireToken request: %w", err)
+	}
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("Content-Type", "application/json")
+
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return "", fmt.Errorf("vcfops: acquireToken: %w", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		_, _ = io.Copy(io.Discard, resp.Body)
+		return "", fmt.Errorf("vcfops: acquireToken returned HTTP %d", resp.StatusCode)
+	}
+
+	var result acquireTokenResponse
+	if err := json.NewDecoder(resp.Body).Decode(&result); err != nil {
+		return "", fmt.Errorf("vcfops: decode acquireToken response: %w", err)
+	}
+	return result.Token, nil
+}
+
+type pageInfo struct {
+	TotalCount int `json:"totalCount"`
+	Page       int `json:"page"`
+	PageSize   int `json:"pageSize"`
+}
+
+type alertsPage struct {
+	PageInfo pageInfo `json:"pageInfo"`
+	Alerts   []Alert  `json:"alerts"`
+}
+
+func (c *Client) getAlertsPage(ctx context.Context, token string, query AlertQuery, page int) (alertsPage, int, error) {
+	values := url.Values{}
+	for _, id := range query.IDs {
+		values.Add("id", id)
+	}
+	for _, resourceID := range query.ResourceIDs {
+		values.Add("resourceId", resourceID)
+	}
+	values.Set("page", strconv.Itoa(page))
+	values.Set("pageSize", strconv.Itoa(query.PageSize))
+
+	endpoint := c.baseURL + "/suite-api/api/alerts?" + values.Encode()
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint, nil)
+	if err != nil {
+		return alertsPage{}, 0, fmt.Errorf("vcfops: create getAlerts request: %w", err)
+	}
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("Authorization", token)
+
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return alertsPage{}, 0, fmt.Errorf("vcfops: getAlerts: %w", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		_, _ = io.Copy(io.Discard, resp.Body)
+		return alertsPage{}, resp.StatusCode, nil
+	}
+
+	var result alertsPage
+	if err := json.NewDecoder(resp.Body).Decode(&result); err != nil {
+		return alertsPage{}, 0, fmt.Errorf("vcfops: decode getAlerts response: %w", err)
+	}
+	return result, resp.StatusCode, nil
 }

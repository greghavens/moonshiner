{
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "commit_sha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "path": "specifications/vcf-operations/vcf-operations-openapi.json"
  },
  "openapi": "3.0.1",
  "server_base_path": "/suite-api",
  "default_security": {
    "scheme": "Token-based-authorization",
    "type": "apiKey",
    "in": "header",
    "name": "Authorization"
  },
  "operations": [
    {
      "operationId": "acquireToken",
      "method": "POST",
      "path": "/api/auth/token/acquire",
      "security": [],
      "request": {
        "content_type": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "password",
            "username"
          ],
          "properties": {
            "username": {
              "type": "string"
            },
            "authSource": {
              "type": "string",
              "required": false
            },
            "password": {
              "type": "string"
            }
          }
        }
      },
      "responses": {
        "200": {
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "required": [
              "token",
              "validity"
            ],
            "properties": {
              "token": {
                "type": "string"
              },
              "validity": {
                "type": "integer",
                "format": "int64",
                "description": "Token expiration time in milliseconds since Jan 1, 1970"
              },
              "expiresAt": {
                "type": "string",
                "required": false
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "required": false
              }
            }
          }
        },
        "401": {
          "description": "Authentication failed"
        }
      }
    },
    {
      "operationId": "getAlerts",
      "method": "GET",
      "path": "/api/alerts",
      "security": [
        "Token-based-authorization"
      ],
      "parameters": [
        {
          "name": "id",
          "in": "query",
          "required": false,
          "schema": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        {
          "name": "resourceId",
          "in": "query",
          "required": false,
          "schema": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        {
          "name": "page",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32",
            "default": 0
          }
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32",
            "default": 1000
          }
        }
      ],
      "responses": {
        "200": {
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "properties": {
              "pageInfo": {
                "type": "object",
                "properties": {
                  "totalCount": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "page": {
                    "type": "integer",
                    "format": "int32",
                    "minimum": 0
                  },
                  "pageSize": {
                    "type": "integer",
                    "format": "int32",
                    "minimum": 1
                  }
                }
              },
              "alerts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "alertId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "resourceId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "alertLevel": {
                      "type": "string",
                      "enum": [
                        "UNKNOWN",
                        "NONE",
                        "INFORMATION",
                        "WARNING",
                        "IMMEDIATE",
                        "CRITICAL",
                        "AUTO"
                      ]
                    },
                    "startTimeUTC": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "updateTimeUTC": {
                      "type": "integer",
                      "format": "int64"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}

 // Snapshot retrieves both collections, refreshing an expired access token
 // without repeating a collection that already succeeded.
 func (c *Client) Snapshot(ctx context.Context) (Snapshot, error) {
-	return Snapshot{}, ErrNotImplemented
+	var snapshot Snapshot
+	if c == nil || c.httpClient == nil {
+		return snapshot, errors.New("client is not initialized")
+	}
+	if ctx == nil {
+		return snapshot, errors.New("context must not be nil")
+	}
+	if err := ctx.Err(); err != nil {
+		return snapshot, err
+	}
+
+	refreshed := false
+	domains, err := c.getDomains(ctx, &refreshed)
+	if err != nil {
+		return snapshot, err
+	}
+	snapshot.Domains = domains
+
+	tasks, err := c.getTasks(ctx, &refreshed)
+	if err != nil {
+		return snapshot, err
+	}
+	snapshot.Tasks = tasks
+	return snapshot, nil
+}

+type pageMetadataWire struct {
+	PageNumber    *int `json:"pageNumber"`
+	PageSize      *int `json:"pageSize"`
+	TotalElements *int `json:"totalElements"`
+	TotalPages    *int `json:"totalPages"`
+}
+
+type pageWire struct {
+	Elements     json.RawMessage   `json:"elements"`
+	PageMetadata *pageMetadataWire `json:"pageMetadata"`
+}
+
+func (c *Client) getDomains(
+	ctx context.Context,
+	refreshed *bool,
+) ([]Domain, error) {
+	data, err := c.getCollection(
+		ctx,
+		"getDomains",
+		"/v1/domains?pageNumber=0&pageSize=100",
+		refreshed,
+	)
+	if err != nil {
+		return nil, err
+	}
+	var page pageWire
+	if err := decodeOneJSON(data, &page); err != nil {
+		return nil, protocol("getDomains", "success body was not one JSON object")
+	}
+	var domains []Domain
+	if !jsonArray(page.Elements) ||
+		json.Unmarshal(page.Elements, &domains) != nil {
+		return nil, protocol("getDomains", "elements was not an array")
+	}
+	if err := validatePage("getDomains", page.PageMetadata, len(domains)); err != nil {
+		return nil, err
+	}
+	ids := make(map[string]struct{}, len(domains))
+	for _, domain := range domains {
+		if strings.TrimSpace(domain.ID) == "" ||
+			strings.TrimSpace(domain.Name) == "" {
+			return nil, protocol("getDomains", "an element lacked id or name")
+		}
+		if _, duplicate := ids[domain.ID]; duplicate {
+			return nil, protocol("getDomains", "duplicate domain id")
+		}
+		ids[domain.ID] = struct{}{}
+	}
+	sort.Slice(domains, func(left, right int) bool {
+		if domains[left].Name == domains[right].Name {
+			return domains[left].ID < domains[right].ID
+		}
+		return domains[left].Name < domains[right].Name
+	})
+	return domains, nil
+}
+
+func (c *Client) getTasks(
+	ctx context.Context,
+	refreshed *bool,
+) ([]Task, error) {
+	data, err := c.getCollection(
+		ctx,
+		"getTasks",
+		"/v1/tasks?pageNumber=0&pageSize=100",
+		refreshed,
+	)
+	if err != nil {
+		return nil, err
+	}
+	var page pageWire
+	if err := decodeOneJSON(data, &page); err != nil {
+		return nil, protocol("getTasks", "success body was not one JSON object")
+	}
+	var tasks []Task
+	if !jsonArray(page.Elements) ||
+		json.Unmarshal(page.Elements, &tasks) != nil {
+		return nil, protocol("getTasks", "elements was not an array")
+	}
+	if err := validatePage("getTasks", page.PageMetadata, len(tasks)); err != nil {
+		return nil, err
+	}
+	ids := make(map[string]struct{}, len(tasks))
+	for _, task := range tasks {
+		if strings.TrimSpace(task.ID) == "" ||
+			strings.TrimSpace(task.Name) == "" ||
+			strings.TrimSpace(task.Status) == "" ||
+			strings.TrimSpace(task.CreationTimestamp) == "" {
+			return nil, protocol("getTasks", "an element lacked a required Task field")
+		}
+		if _, duplicate := ids[task.ID]; duplicate {
+			return nil, protocol("getTasks", "duplicate task id")
+		}
+		ids[task.ID] = struct{}{}
+	}
+	sort.Slice(tasks, func(left, right int) bool {
+		if tasks[left].Name == tasks[right].Name {
+			return tasks[left].ID < tasks[right].ID
+		}
+		return tasks[left].Name < tasks[right].Name
+	})
+	return tasks, nil
+}
+
+func (c *Client) getCollection(
+	ctx context.Context,
+	operationID string,
+	target string,
+	refreshed *bool,
+) ([]byte, error) {
+	token := c.currentToken()
+	data, err := c.doJSON(
+		ctx,
+		operationID,
+		http.MethodGet,
+		target,
+		token,
+		nil,
+		http.StatusOK,
+	)
+	if err == nil {
+		return data, nil
+	}
+	var apiError *APIError
+	if !errors.As(err, &apiError) ||
+		apiError.StatusCode != http.StatusUnauthorized ||
+		*refreshed {
+		return nil, err
+	}
+
+	*refreshed = true
+	if err := c.refresh(ctx, token); err != nil {
+		return nil, err
+	}
+	return c.doJSON(
+		ctx,
+		operationID,
+		http.MethodGet,
+		target,
+		c.currentToken(),
+		nil,
+		http.StatusOK,
+	)
+}
+
+func (c *Client) refresh(ctx context.Context, staleToken string) error {
+	c.refreshMu.Lock()
+	defer c.refreshMu.Unlock()
+	if c.currentToken() != staleToken {
+		return nil
+	}
+
+	body, _ := json.Marshal(c.refreshTokenID)
+	data, err := c.doJSON(
+		ctx,
+		"refreshAccessToken",
+		http.MethodPatch,
+		"/v1/tokens/access-token/refresh",
+		"",
+		body,
+		http.StatusOK,
+	)
+	if err != nil {
+		return err
+	}
+	var newToken string
+	if err := decodeOneJSON(data, &newToken); err != nil ||
+		strings.TrimSpace(newToken) == "" ||
+		containsASCIIWhitespace(newToken) {
+		return protocol(
+			"refreshAccessToken",
+			"success body was not a usable JSON access-token string",
+		)
+	}
+	c.tokenMu.Lock()
+	c.accessToken = newToken
+	c.tokenMu.Unlock()
+	return nil
+}
+
+func (c *Client) currentToken() string {
+	c.tokenMu.RLock()
+	defer c.tokenMu.RUnlock()
+	return c.accessToken
+}
+
+func (c *Client) doJSON(
+	ctx context.Context,
+	operationID string,
+	method string,
+	target string,
+	accessToken string,
+	body []byte,
+	successStatus int,
+) ([]byte, error) {
+	var reader io.Reader
+	if body != nil {
+		reader = bytes.NewReader(body)
+	}
+	request, err := http.NewRequestWithContext(
+		ctx,
+		method,
+		c.baseURL+target,
+		reader,
+	)
+	if err != nil {
+		return nil, protocol(operationID, "request target could not be constructed")
+	}
+	request.Header.Set("Accept", "application/json")
+	if accessToken != "" {
+		request.Header.Set("Authorization", "Bearer "+accessToken)
+	}
+	if body != nil {
+		request.Header.Set("Content-Type", "application/json")
+	}
+
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		return nil, &TransportError{OperationID: operationID, Err: err}
+	}
+	defer response.Body.Close()
+	data, readErr := io.ReadAll(io.LimitReader(response.Body, maxResponseBytes+1))
+	if readErr != nil {
+		return nil, protocol(operationID, "response body could not be read")
+	}
+	if len(data) > maxResponseBytes {
+		return nil, protocol(operationID, "response body exceeded the size limit")
+	}
+	if response.StatusCode != successStatus {
+		var envelope VCFError
+		_ = decodeOneJSON(data, &envelope)
+		return nil, &APIError{
+			OperationID:        operationID,
+			StatusCode:         response.StatusCode,
+			ErrorCode:          envelope.ErrorCode,
+			Message:            envelope.Message,
+			RemediationMessage: envelope.RemediationMessage,
+			ReferenceToken:     envelope.ReferenceToken,
+		}
+	}
+	mediaType, _, mediaErr := mime.ParseMediaType(response.Header.Get("Content-Type"))
+	if mediaErr != nil || mediaType != "application/json" {
+		return nil, protocol(operationID, "success response was not application/json")
+	}
+	return data, nil
+}
+
+func validatePage(
+	operationID string,
+	metadata *pageMetadataWire,
+	elementCount int,
+) error {
+	if metadata == nil ||
+		metadata.PageNumber == nil ||
+		metadata.PageSize == nil ||
+		metadata.TotalElements == nil ||
+		metadata.TotalPages == nil {
+		return protocol(operationID, "pageMetadata was incomplete")
+	}
+	totalPages := 0
+	if elementCount > 0 {
+		totalPages = 1
+	}
+	if *metadata.PageNumber != 0 ||
+		*metadata.PageSize != elementCount ||
+		*metadata.TotalElements != elementCount ||
+		*metadata.TotalPages != totalPages ||
+		elementCount > collectionPageSize {
+		return protocol(operationID, "pageMetadata was inconsistent")
+	}
+	return nil
+}
+
+func jsonArray(data json.RawMessage) bool {
+	trimmed := bytes.TrimSpace(data)
+	return len(trimmed) > 0 && trimmed[0] == '['
+}
+
+func decodeOneJSON(data []byte, out any) error {
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	if err := decoder.Decode(out); err != nil {
+		return err
+	}
+	var extra any
+	if err := decoder.Decode(&extra); err != io.EOF {
+		return errors.New("JSON response contained trailing data")
+	}
+	return nil
+}
+
+func protocol(operationID, reason string) *ProtocolError {
+	return &ProtocolError{OperationID: operationID, Reason: reason}
+}
+
+func containsASCIIWhitespace(value string) bool {
+	return strings.IndexFunc(value, func(character rune) bool {
+		switch character {
+		case ' ', '\t', '\n', '\r', '\v', '\f':
+			return true
+		default:
+			return false
+		}
+	}) >= 0
 }

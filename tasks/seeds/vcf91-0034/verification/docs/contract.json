  },
  "operations": [
    {
      "operationId": "getDomains",
      "summary": "Retrieve a list of domains",
      "method": "GET",
      "path": "/v1/domains",
      "query_parameters": [
        {
          "name": "type",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "name",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "vcFqdn",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "vcInstanceId",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "isManagementSsoDomain",
          "in": "query",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "pageNumber",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        },
        {
          "name": "useCache",
          "in": "query",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Ok",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/PageOfDomain"
        },
        "400": {
          "description": "Bad Request",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        },
        "500": {
          "description": "InternalServerError",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        }
      }
    },
    {
      "operationId": "getTasks",
      "summary": "Retrieve a list of all tasks",
      "method": "GET",
      "path": "/v1/tasks",
      "query_parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        },
        {
          "name": "taskStatus",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "taskType",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "resourceId",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "resourceType",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "completedAfter",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        },
        {
          "name": "pageNumber",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        },
        {
          "name": "orderDirection",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "orderBy",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "taskName",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "doLiveRefresh",
          "in": "query",
          "required": false,
          "schema": {
            "type": "boolean",
            "default": false
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Returns the list of tasks.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/PageOfTask"
        },
        "500": {
          "description": "Unexpected error",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        }
      }
    },
    {
      "operationId": "refreshAccessToken",
      "summary": "Refresh Access Token",
      "method": "PATCH",
      "path": "/v1/tokens/access-token/refresh",
      "request": {
        "required": true,
        "media_type": "application/json",
        "schema": {
          "type": "string",
          "description": "ID of the refresh token"
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "media_type": "application/json",
          "schema": {
            "type": "string"
          }
        },
        "400": {
          "description": "Bad Request",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        },
        "404": {
          "description": "Not Found",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        },
        "500": {
          "description": "Internal Server Error",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        }
      }
    }
  ],
  "schemas": {
    "PageOfDomain": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "description": "The list of elements included in this page",
          "items": {
            "$ref": "#/components/schemas/Domain"
          }
        },
        "pageMetadata": {
          "$ref": "#/components/schemas/PageMetadata"
        }
      }
    },
    "PageOfTask": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "description": "The list of elements included in this page",
          "items": {
            "$ref": "#/components/schemas/Task"
          }
        },
        "pageMetadata": {
          "$ref": "#/components/schemas/PageMetadata"
        }
      }
    },
    "PageMetadata": {
      "type": "object",
      "properties": {
        "pageNumber": {
          "type": "integer",
          "description": "Returns the current page number",
          "format": "int32",
          "readOnly": true
        },
        "pageSize": {
          "type": "integer",
          "description": "Returns the number of elements in the current page",
          "format": "int32",
          "readOnly": true
        },
        "totalElements": {
          "type": "integer",
          "description": "Returns the total number of elements",
          "format": "int32",
          "readOnly": true
        },
        "totalPages": {
          "type": "integer",
          "description": "Returns the total number of pages",
          "format": "int32",
          "readOnly": true
        }
      },
      "description": "Represents pageable elements pagination metadata",
      "readOnly": true
    },
    "Domain": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID of the workload domain"
        },
        "name": {
          "type": "string",
          "description": "Name of the workload domain"
        },
        "status": {
          "type": "string",
          "description": "Status of the workload domain"
        },
        "type": {
          "type": "string",
          "description": "Type of the workload domain"
        }
      },
      "description": "Represents a domain",
      "projection_note": "Only fields consumed by this task are projected."
    },
    "Task": {
      "required": [
        "creationTimestamp",
        "id",
        "name",
        "status"
      ],
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "readOnly": true
        },
        "type": {
          "type": "string",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "readOnly": true
        },
        "creationTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "errors": {
          "type": "array",
          "readOnly": true,
          "items_ref": "#/components/schemas/Error"
        }
      },
      "projection_note": "Only fields consumed by this task are projected."
    },
    "Error": {
      "type": "object",
      "properties": {
        "errorCode": {
          "type": "string",
          "readOnly": true
        },
        "message": {
          "type": "string",
          "readOnly": true
        },
        "remediationMessage": {
          "type": "string"
        },
        "referenceToken": {
          "type": "string",
          "readOnly": true
        }
      },
      "projection_note": "Only fields consumed by this task are projected."
    }
  }
}

+import java.io.IOException;
+import java.io.PrintStream;
+import java.net.URI;
+import java.net.URLEncoder;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+public final class VcfAutomationClient {
+    private static final String PROJECTS_PATH = "/iaas/api/projects";
+    private static final String DEPLOYMENTS_PATH = "/deployment/api/deployments";
+    private static final int PAGE_SIZE = 2;
+
+    public record Deployment(String id, String name, String status) {
+        public Deployment {
+            Objects.requireNonNull(id, "id");
+            Objects.requireNonNull(name, "name");
+            Objects.requireNonNull(status, "status");
+        }
+    }
+
+    private final URI baseUri;
+    private final String bearerToken;
+    private final HttpClient httpClient;
+
+    public VcfAutomationClient(URI baseUri, String bearerToken) {
+        this.baseUri = Objects.requireNonNull(baseUri, "baseUri");
+        this.bearerToken = Objects.requireNonNull(bearerToken, "bearerToken");
+        this.httpClient = HttpClient.newHttpClient();
+    }
+
+    public List<Deployment> listDeployments(String projectName)
+            throws IOException, InterruptedException {
+        Objects.requireNonNull(projectName, "projectName");
+        String projectId = lookupProjectId(projectName);
+        List<Deployment> deployments = new ArrayList<>();
+
+        int page = 0;
+        while (true) {
+            Map<String, String> query = new LinkedHashMap<>();
+            query.put("projects", projectId);
+            query.put("page", Integer.toString(page));
+            query.put("size", Integer.toString(PAGE_SIZE));
+            Map<String, Object> response = getObject(DEPLOYMENTS_PATH, query);
+
+            int responsePage = integer(response, "number");
+            int totalPages = integer(response, "totalPages");
+            if (responsePage != page) {
+                throw new IOException("deployment response page mismatch: requested "
+                        + page + " but received " + responsePage);
+            }
+            if (totalPages < 0) {
+                throw new IOException("deployment response has negative totalPages");
+            }
+            for (Object raw : array(response, "content")) {
+                Map<String, Object> item = object(raw, "deployment");
+                deployments.add(new Deployment(
+                        string(item, "id"), string(item, "name"), string(item, "status")));
+            }
+            if (page + 1 >= totalPages) {
+                break;
+            }
+            page++;
+        }
+
+        deployments.sort(Comparator.comparing(Deployment::name).thenComparing(Deployment::id));
+        return List.copyOf(deployments);
+    }
+
+    public void emitDeployments(String projectName, PrintStream out)
+            throws IOException, InterruptedException {
+        Objects.requireNonNull(out, "out");
+        for (Deployment deployment : listDeployments(projectName)) {
+            out.print("{\"id\":");
+            out.print(jsonString(deployment.id()));
+            out.print(",\"name\":");
+            out.print(jsonString(deployment.name()));
+            out.print(",\"status\":");
+            out.print(jsonString(deployment.status()));
+            out.println('}');
+        }
+    }
+
+    private String lookupProjectId(String projectName) throws IOException, InterruptedException {
+        String escapedName = projectName.replace("'", "''");
+        Map<String, String> query = new LinkedHashMap<>();
+        query.put("$filter", "name eq '" + escapedName + "'");
+        query.put("$top", "100");
+        query.put("$skip", "0");
+        Map<String, Object> response = getObject(PROJECTS_PATH, query);
+
+        String found = null;
+        for (Object raw : array(response, "content")) {
+            Map<String, Object> project = object(raw, "project");
+            if (projectName.equals(string(project, "name"))) {
+                if (found != null) {
+                    throw new IOException("project lookup returned duplicate exact matches for " + projectName);
+                }
+                found = string(project, "id");
+            }
+        }
+        if (found == null) {
+            throw new IOException("project not found: " + projectName);
+        }
+        return found;
+    }
+
+    private Map<String, Object> getObject(String path, Map<String, String> query)
+            throws IOException, InterruptedException {
+        URI uri = requestUri(path, query);
+        HttpRequest request = HttpRequest.newBuilder(uri)
+                .header("Accept", "application/json")
+                .header("Authorization", "Bearer " + bearerToken)
+                .GET()
+                .build();
+        HttpResponse<String> response = httpClient.send(
+                request, HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+        if (response.statusCode() < 200 || response.statusCode() >= 300) {
+            throw new IOException("GET " + path + " returned HTTP " + response.statusCode());
+        }
+        try {
+            return object(Json.parse(response.body()), "response");
+        } catch (IllegalArgumentException exception) {
+            throw new IOException("invalid JSON returned by GET " + path, exception);
+        }
+    }
+
+    private URI requestUri(String path, Map<String, String> query) {
+        String root = baseUri.toString();
+        while (root.endsWith("/")) root = root.substring(0, root.length() - 1);
+        StringBuilder value = new StringBuilder(root).append(path);
+        char separator = '?';
+        for (Map.Entry<String, String> entry : query.entrySet()) {
+            value.append(separator);
+            separator = '&';
+            value.append(encode(entry.getKey())).append('=').append(encode(entry.getValue()));
+        }
+        return URI.create(value.toString());
+    }
+
+    private static String encode(String value) {
+        return URLEncoder.encode(value, StandardCharsets.UTF_8);
+    }
+
+    private static Map<String, Object> object(Object value, String description) {
+        if (!(value instanceof Map<?, ?> raw)) {
+            throw new IllegalArgumentException(description + " must be a JSON object");
+        }
+        Map<String, Object> result = new LinkedHashMap<>();
+        for (Map.Entry<?, ?> entry : raw.entrySet()) {
+            if (!(entry.getKey() instanceof String key)) {
+                throw new IllegalArgumentException(description + " has a non-string key");
+            }
+            result.put(key, entry.getValue());
+        }
+        return result;
+    }
+
+    private static List<Object> array(Map<String, Object> object, String key) {
+        Object value = object.get(key);
+        if (!(value instanceof List<?> raw)) {
+            throw new IllegalArgumentException(key + " must be a JSON array");
+        }
+        return new ArrayList<>(raw);
+    }
+
+    private static String string(Map<String, Object> object, String key) {
+        Object value = object.get(key);
+        if (!(value instanceof String text)) {
+            throw new IllegalArgumentException(key + " must be a JSON string");
+        }
+        return text;
+    }
+
+    private static int integer(Map<String, Object> object, String key) {
+        Object value = object.get(key);
+        if (!(value instanceof Number number)) {
+            throw new IllegalArgumentException(key + " must be a JSON number");
+        }
+        return Math.toIntExact(number.longValue());
+    }
+
+    private static String jsonString(String value) {
+        StringBuilder out = new StringBuilder("\"");
+        for (int i = 0; i < value.length(); i++) {
+            char c = value.charAt(i);
+            switch (c) {
+                case '"' -> out.append("\\\"");
+                case '\\' -> out.append("\\\\");
+                case '\b' -> out.append("\\b");
+                case '\f' -> out.append("\\f");
+                case '\n' -> out.append("\\n");
+                case '\r' -> out.append("\\r");
+                case '\t' -> out.append("\\t");
+                default -> {
+                    if (c < 0x20) out.append(String.format("\\u%04x", (int) c));
+                    else out.append(c);
+                }
+            }
+        }
+        return out.append('"').toString();
+    }
+
+    private static final class Json {
+        private final String text;
+        private int index;
+
+        private Json(String text) {
+            this.text = text;
+        }
+
+        static Object parse(String text) {
+            Json parser = new Json(text);
+            Object value = parser.value();
+            parser.whitespace();
+            if (parser.index != text.length()) parser.fail("trailing input");
+            return value;
+        }
+
+        private Object value() {
+            whitespace();
+            if (index >= text.length()) return fail("expected value");
+            return switch (text.charAt(index)) {
+                case '{' -> object();
+                case '[' -> array();
+                case '"' -> string();
+                case 't' -> literal("true", Boolean.TRUE);
+                case 'f' -> literal("false", Boolean.FALSE);
+                case 'n' -> literal("null", null);
+                default -> number();
+            };
+        }
+
+        private Map<String, Object> object() {
+            expect('{');
+            Map<String, Object> result = new LinkedHashMap<>();
+            whitespace();
+            if (take('}')) return result;
+            while (true) {
+                whitespace();
+                if (index >= text.length() || text.charAt(index) != '"') fail("expected object key");
+                String key = string();
+                whitespace();
+                expect(':');
+                result.put(key, value());
+                whitespace();
+                if (take('}')) return result;
+                expect(',');
+            }
+        }
+
+        private List<Object> array() {
+            expect('[');
+            List<Object> result = new ArrayList<>();
+            whitespace();
+            if (take(']')) return result;
+            while (true) {
+                result.add(value());
+                whitespace();
+                if (take(']')) return result;
+                expect(',');
+            }
+        }
+
+        private String string() {
+            expect('"');
+            StringBuilder result = new StringBuilder();
+            while (index < text.length()) {
+                char c = text.charAt(index++);
+                if (c == '"') return result.toString();
+                if (c != '\\') {
+                    if (c < 0x20) fail("control character in string");
+                    result.append(c);
+                    continue;
+                }
+                if (index >= text.length()) fail("unterminated escape");
+                char escaped = text.charAt(index++);
+                switch (escaped) {
+                    case '"', '\\', '/' -> result.append(escaped);
+                    case 'b' -> result.append('\b');
+                    case 'f' -> result.append('\f');
+                    case 'n' -> result.append('\n');
+                    case 'r' -> result.append('\r');
+                    case 't' -> result.append('\t');
+                    case 'u' -> result.append(unicode());
+                    default -> fail("invalid escape");
+                }
+            }
+            return fail("unterminated string");
+        }
+
+        private char unicode() {
+            if (index + 4 > text.length()) return fail("short unicode escape");
+            int value = 0;
+            for (int end = index + 4; index < end; index++) {
+                int digit = Character.digit(text.charAt(index), 16);
+                if (digit < 0) return fail("invalid unicode escape");
+                value = value * 16 + digit;
+            }
+            return (char) value;
+        }
+
+        private Number number() {
+            int start = index;
+            if (take('-')) { }
+            digits();
+            boolean decimal = false;
+            if (take('.')) {
+                decimal = true;
+                digits();
+            }
+            if (index < text.length() && (text.charAt(index) == 'e' || text.charAt(index) == 'E')) {
+                decimal = true;
+                index++;
+                if (!take('+')) take('-');
+                digits();
+            }
+            if (start == index) return fail("expected number");
+            String token = text.substring(start, index);
+            try {
+                return decimal ? Double.parseDouble(token) : Long.parseLong(token);
+            } catch (NumberFormatException exception) {
+                return fail("invalid number");
+            }
+        }
+
+        private void digits() {
+            int start = index;
+            while (index < text.length() && Character.isDigit(text.charAt(index))) index++;
+            if (start == index) fail("expected digit");
+        }
+
+        private Object literal(String token, Object value) {
+            if (!text.startsWith(token, index)) return fail("invalid literal");
+            index += token.length();
+            return value;
+        }
+
+        private void whitespace() {
+            while (index < text.length() && Character.isWhitespace(text.charAt(index))) index++;
+        }
+
+        private boolean take(char expected) {
+            if (index < text.length() && text.charAt(index) == expected) {
+                index++;
+                return true;
+            }
+            return false;
+        }
+
+        private void expect(char expected) {
+            if (!take(expected)) fail("expected '" + expected + "'");
+        }
+
+        private <T> T fail(String message) {
+            throw new IllegalArgumentException(message + " at offset " + index);
+        }
+    }
+}

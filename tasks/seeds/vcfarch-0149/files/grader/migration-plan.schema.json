{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF existing-estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["estateId", "strategy", "targetFoundationVersion", "steps"],
  "properties": {
    "estateId": {"type": "string", "minLength": 1},
    "strategy": {"type": "string", "enum": ["SIDE_BY_SIDE_REBUILD"]},
    "targetFoundationVersion": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "componentId", "componentType", "currentVersion", "currentBuild", "action", "target", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "componentId": {"type": "string", "minLength": 1},
          "componentType": {
            "type": "string",
            "enum": ["SDDC_MANAGER", "VCENTER", "NSX_MANAGER", "ESX_HOST"]
          },
          "currentVersion": {"type": "string", "minLength": 1},
          "currentBuild": {"type": "string", "minLength": 1},
          "action": {
            "type": "string",
            "enum": [
              "DEPLOY_REPLACEMENT_FOUNDATION",
              "RECREATE_ON_TARGET",
              "MIGRATE_WORKLOADS_AND_RETIRE"
            ]
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "resource", "disposition"],
            "properties": {
              "version": {"type": "string", "minLength": 1},
              "resource": {"type": "string", "minLength": 1},
              "disposition": {"type": "string", "enum": ["REPLACED_SIDE_BY_SIDE"]}
            }
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}

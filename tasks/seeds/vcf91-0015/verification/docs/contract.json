{
  "product": "VMware Cloud Foundation SDDC Manager REST API",
  "spec_version": "9.1.0.0",
  "source": {
    "repository": "vmware/vcf-api-specs",
    "commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "specification_path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "license": "Apache-2.0"
  },
  "operations": [
    {
      "operationId": "getDomains",
      "summary": "Retrieve a list of domains",
      "method": "GET",
      "path": "/v1/domains",
      "query_parameters": [
        {
          "name": "type",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "name",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "vcFqdn",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "vcInstanceId",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "isManagementSsoDomain",
          "in": "query",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "pageNumber",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        },
        {
          "name": "useCache",
          "in": "query",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Ok",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/PageOfDomain"
        },
        "400": {
          "description": "Bad Request",
          "schema_ref": "#/components/schemas/Error"
        },
        "500": {
          "description": "InternalServerError",
          "schema_ref": "#/components/schemas/Error"
        }
      }
    }
  ],
  "schemas": {
    "PageOfDomain": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "items_ref": "#/components/schemas/Domain"
        },
        "pageMetadata": {
          "ref": "#/components/schemas/PageMetadata"
        }
      }
    },
    "PageMetadata": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "pageNumber": {
          "type": "integer",
          "format": "int32",
          "readOnly": true,
          "meaning": "current page number"
        },
        "pageSize": {
          "type": "integer",
          "format": "int32",
          "readOnly": true,
          "meaning": "number of elements in the current page"
        },
        "totalElements": {
          "type": "integer",
          "format": "int32",
          "readOnly": true,
          "meaning": "total number of elements"
        },
        "totalPages": {
          "type": "integer",
          "format": "int32",
          "readOnly": true,
          "meaning": "total number of pages"
        }
      }
    },
    "Domain": {
      "type": "object",
      "integration_sort_fields": {
        "name": {
          "type": "string",
          "description": "Name of the workload domain"
        },
        "id": {
          "type": "string",
          "description": "ID of the workload domain"
        }
      },
      "client_rule": "Domain objects are passed through intact; the client must not project away other specification-defined fields."
    },
    "Error": {
      "client_fields": [
        "errorCode",
        "message"
      ],
      "client_rule": "Preserve the entire decoded object as payload while exposing errorCode and message."
    }
  },
  "integration_policy": {
    "authentication": "Authorization: Bearer <access token>",
    "accept": "application/json",
    "page_origin": 0,
    "query_parameter_order": [
      "type",
      "name",
      "vcFqdn",
      "vcInstanceId",
      "isManagementSsoDomain",
      "pageNumber",
      "pageSize",
      "useCache"
    ],
    "unset_optional_rule": "A Python None value is unset and its query parameter is omitted completely, not sent with an empty value.",
    "boolean_encoding": "lowercase true or false",
    "completion_rule": "Fetch page 0 and continue through totalPages - 1; return no partial result if metadata is malformed or inconsistent.",
    "stable_order": "case-folded Domain.name, then Domain.id, then canonical compact JSON; missing or non-string name/id sort as empty strings",
    "stable_json": {
      "ensure_ascii": false,
      "indent": 2,
      "sort_keys": true,
      "trailing_newline_count": 1
    }
  }
}

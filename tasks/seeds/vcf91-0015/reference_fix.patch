@@ -0,0 +1,12 @@
+"""Stable JSON emission for complete domain inventories."""
+
+import json
+
+
+def export_domains(client, stream, **list_options):
+    """Fetch all domains, write canonical pretty JSON, and return the list."""
+    domains = client.list_domains(**list_options)
+    stream.write(
+        json.dumps(domains, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
+    )
+    return domains

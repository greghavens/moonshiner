@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""Reference interaction sequence for the staged CRM executable."""
+
+from __future__ import annotations
+
+from pathlib import Path
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parent
+EXPECTED = ROOT / "cancellation-result.json"
+
+
+def invoke(command: str, *arguments: str) -> subprocess.CompletedProcess[str]:
+    # A trailing shell builtin prevents Bash from replacing itself with crmctl,
+    # preserving one independently observable shell interaction per invocation.
+    script = command + '; command_status=$?; :; exit "$command_status"'
+    return subprocess.run(
+        ["bash", "-c", script, "reference", *arguments],
+        cwd=ROOT,
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+
+
+def main() -> int:
+    invoke("./crmctl --help")
+    invoke("./crmctl refresh")
+    invoke("./crmctl --help")
+    cancellation = invoke(
+        './crmctl cancel --id "$1" --reason "$2"',
+        "crm-109",
+        "the account was imported twice",
+    )
+
+    expected = EXPECTED.read_text(encoding="utf-8")
+    if cancellation.stdout != expected:
+        raise RuntimeError("reference output differs from the genuine CRM result")
+    if cancellation.stderr:
+        raise RuntimeError("reference cancellation unexpectedly wrote to stderr")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

@@ -0,0 +1,101 @@
+#!/usr/bin/env python3
+"""Reference proof using only the genuine facilities executable."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "facilityctl"
+DELIVERABLE = ROOT / "cancellation-result.txt"
+TARGET_ID = "fac-177"
+REASON = "no longer needed for the scheduled work."
+
+
+def run(arguments: list[str]) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        [str(CLIENT), *arguments],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=5,
+    )
+
+
+def successful_record(completed: subprocess.CompletedProcess[str]) -> dict[str, Any]:
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "facilities operation failed")
+    try:
+        value: Any = json.loads(completed.stdout)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("facilities operation returned invalid JSON") from error
+    if not isinstance(value, dict):
+        raise RuntimeError("facilities operation returned no complete record")
+    return value
+
+
+def required_text(record: dict[str, Any], field: str) -> str:
+    value = record.get(field)
+    if not isinstance(value, str) or not value:
+        raise RuntimeError(f"retrieved record has no {field}")
+    return value
+
+
+def retrieved_identity(record: dict[str, Any]) -> tuple[str, str]:
+    stable_id = required_text(record, "id")
+    request_name = required_text(record, "request_name")
+    if stable_id != TARGET_ID:
+        raise RuntimeError("exact-ID retrieval returned a different request")
+    return stable_id, request_name
+
+
+def main() -> int:
+    help_result = run(["--help"])
+    if help_result.returncode != 0:
+        raise RuntimeError("facilities executable help failed")
+
+    cancellation = run(
+        ["cancel", "--id", TARGET_ID, "--reason", REASON]
+    )
+    if cancellation.returncode != 124:
+        raise RuntimeError("reference cancellation did not exercise the deadline")
+    if "commit outcome is unknown" not in cancellation.stderr:
+        raise RuntimeError("reference cancellation did not report uncertainty")
+
+    retrieved = successful_record(run(["get", "--id", TARGET_ID]))
+    stable_id, request_name = retrieved_identity(retrieved)
+    final_status = required_text(retrieved, "status")
+    retry_sent = False
+
+    if final_status == "active":
+        retry_sent = True
+        successful_record(
+            run(["cancel", "--id", TARGET_ID, "--reason", REASON])
+        )
+        retrieved = successful_record(run(["get", "--id", TARGET_ID]))
+        stable_id, request_name = retrieved_identity(retrieved)
+        final_status = required_text(retrieved, "status")
+    elif final_status not in {"cancelled", "cancellation-pending"}:
+        raise RuntimeError("retrieval did not return a safe recovery status")
+
+    if final_status not in {"cancelled", "cancellation-pending"}:
+        raise RuntimeError("final retrieval did not verify a cancellation status")
+    if retrieved.get("cancellation_reason") != REASON:
+        raise RuntimeError("final retrieval did not preserve the cancellation reason")
+
+    DELIVERABLE.write_text(
+        f"Request: {request_name} ({stable_id})\n"
+        f"Verified final status: {final_status}\n"
+        f"Retry sent: {'yes' if retry_sent else 'no'}\n",
+        encoding="utf-8",
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

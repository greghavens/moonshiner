@@ -0,0 +1,68 @@
+{
+  "consulted": [
+    {
+      "title": "Upgrade Sequence and Related Issues for VMware Cloud Foundation and vSphere Foundation 9.1",
+      "url": "https://knowledge.broadcom.com/external/article/440630/upgrade-sequence-and-related-issues-for.html",
+      "retrieved_at": "2026-08-14T01:05:00-05:00",
+      "finding": "VCF Operations precedes the 9.1 lifecycle flow; Management Services is mandatory, needs at least 12 management-network addresses, and absorbs fleet lifecycle and identity capabilities.",
+      "topics": ["upgrade-path", "vcf-9.1-upgrade"]
+    },
+    {
+      "title": "Modernizing Infrastructure: VMware Cloud Foundation 5.2.x to 9.1 Upgrade Guide",
+      "url": "https://blogs.vmware.com/cloud-foundation/2026/06/05/modernizing-infrastructure-vmware-cloud-foundation-5-2-x-to-9-1-upgrade-guide/",
+      "retrieved_at": "2026-08-14T01:05:00-05:00",
+      "finding": "The published core sequence is Operations, SDDC Manager, Management Services, NSX management plane, vCenter, ESXi, then NSX Edge finalization.",
+      "topics": ["upgrade-path", "vcf-9.1-upgrade"]
+    },
+    {
+      "title": "Certificate Requirements for VCF Operations for Networks in VCF 9.1",
+      "url": "https://knowledge.broadcom.com/external/article/424807",
+      "retrieved_at": "2026-08-14T01:05:00-05:00",
+      "finding": "Before convergence, every Operations for Networks platform and collector certificate SAN must contain both its FQDN and IP address.",
+      "topics": ["compatibility", "vcf-9.1-upgrade"]
+    },
+    {
+      "title": "8.x endpoint certificates upgrade pre-check fails due to missing certificate entries",
+      "url": "https://knowledge.broadcom.com/external/article/425489",
+      "retrieved_at": "2026-08-14T01:05:00-05:00",
+      "finding": "Aria Automation 8.18.1 endpoint certificate chains must be persisted and pass the 9.1 pre-check before the VCF Automation upgrade.",
+      "topics": ["compatibility", "product-interoperability", "upgrade-path"]
+    },
+    {
+      "title": "Build numbers and versions for VMware Aria Automation",
+      "url": "https://knowledge.broadcom.com/external/article/318130/build-numbers-and-versions-for-vmware-ar.html",
+      "retrieved_at": "2026-08-14T01:05:00-05:00",
+      "finding": "Aria Automation 8.16.2 build 23467282 reached end of general support on 2025-03-21, while 8.18.1 is the supported 8.x boundary used by the pinned plan.",
+      "topics": ["lifecycle", "upgrade-path"]
+    },
+    {
+      "title": "Upgrade Guidance for Aria Operations for Logs 8.18.x to VCF Operations for Logs 9.0.x",
+      "url": "https://knowledge.broadcom.com/external/article/402314",
+      "retrieved_at": "2026-08-14T01:05:00-05:00",
+      "finding": "Standalone Logs 8.18.x has no in-place transition to the 9.x service; the supported approach is fresh deployment, parallel operation, source repointing, and time-bounded historical transfer.",
+      "topics": ["compatibility", "upgrade-path"]
+    },

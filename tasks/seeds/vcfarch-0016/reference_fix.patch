@@ -0,0 +1,335 @@
+"""Deterministic architecture construction from the supplied fixtures."""
+
+from __future__ import annotations
+
+import math
+from typing import Any
+
+
+class InputError(ValueError):
+    """An input does not satisfy the package's required fixture contract."""
+
+
+def require_object(value: Any, label: str) -> dict[str, Any]:
+    if not isinstance(value, dict):
+        raise InputError(f"{label} must be a JSON object")
+    return value
+
+
+def require_keys(value: dict[str, Any], keys: set[str], label: str) -> None:
+    missing = sorted(keys - value.keys())
+    if missing:
+        raise InputError(f"{label} is missing {missing}")
+
+
+def workload_hosts(
+    demand: dict[str, Any],
+    host: dict[str, Any],
+    capacity_percent: int,
+    failures: int,
+) -> int:
+    multiplier = (
+        (100 + demand["design_headroom_percent"]) / 100
+        * capacity_percent
+        / 100
+    )
+    counts = (
+        math.ceil(demand["vcpus"] * multiplier / host["usable_vcpus"]),
+        math.ceil(demand["memory_tib"] * multiplier / host["usable_memory_tib"]),
+        math.ceil(
+            demand["usable_storage_tib"]
+            * multiplier
+            / host["usable_storage_tib"]
+        ),
+    )
+    return max(counts) + failures
+
+
+def installer_network(source: dict[str, Any], defaults: dict[str, Any]) -> dict[str, Any]:
+    return {
+        "networkType": source["network_type"],
+        "vlanId": source["vlan_id"],
+        "subnet": source["subnet"],
+        "gateway": source["gateway"],
+        "subnetMask": source["subnet_mask"],
+        "includeIpAddressRanges": [
+            {
+                "startIpAddress": source["range_start"],
+                "endIpAddress": source["range_end"],
+            }
+        ],
+        "mtu": source["mtu"],
+        "teamingPolicy": defaults["teaming_policy"],
+        "ipAddressVersion": defaults["ip_address_version"],
+        "ipAddressAssignmentMode": defaults["ip_address_assignment_mode"],
+    }
+
+
+def build_sddc_spec(requirements: dict[str, Any]) -> dict[str, Any]:
+    primary = requirements["sites"][0]
+    names = requirements["primary_appliance_names"]
+    management = requirements["management_services"]
+    password = requirements["credential_placeholder"]
+    target, design = requirements["target_release"], requirements["primary_sddc_design"]
+    networks = requirements["primary_networks"]
+    fleet = next(item for item in networks if item["network_type"] == "FLEET_MANAGEMENT")
+    return {
+        "sddcId": primary["sddc_id"],
+        "workflowType": design["workflow_type"],
+        "version": target,
+        "vcfInstanceName": primary["vcf_instance"],
+        "hostSpecs": [
+            {
+                "hostname": f"{primary['management_host_prefix']}{index:02d}",
+                "credentials": {"username": design["esx_username"], "password": password},
+            }
+            for index in range(1, primary["management_domain_hosts"] + 1)
+        ],
+        "vcenterSpec": {
+            "vcenterHostname": names["vcenter"],
+            "rootVcenterPassword": password,
+            "vmSize": design["vcenter"]["vm_size"],
+            "storageSize": design["vcenter"]["storage_size"],
+            "ssoDomain": design["vcenter"]["sso_domain"],
+            "adminUserSsoUsername": design["vcenter"]["admin_username"],
+            "adminUserSsoPassword": password,
+            "version": target,
+            "useExistingDeployment": not design["deploy_new_components"],
+        },
+        "clusterSpec": {
+            "datacenterName": design["cluster"]["datacenter_name"],
+            "clusterName": design["cluster"]["cluster_name"],
+            "clusterEvcMode": design["cluster"]["evc_mode"],
+        },
+        "datastoreSpec": {
+            "vsanSpec": {
+                "datastoreName": design["vsan"]["datastore_name"],
+                "vsanDedup": design["vsan"]["dedup"],
+                "failuresToTolerate": design["vsan"]["failures_to_tolerate"],
+            }
+        },
+        "dvsSpecs": [
+            {
+                "dvsName": design["distributed_switch"]["name"],
+                "networks": [item["network_type"] for item in networks],
+                "mtu": design["distributed_switch"]["mtu"],
+                "vmnicsToUplinks": design["distributed_switch"]["vmnics_to_uplinks"],
+            }
+        ],
+        "nsxtSpec": {
+            "nsxtManagers": [{"hostname": item} for item in names["nsx_managers"]],
+            "nsxtManagerSize": design["nsx_manager_size"],
+            "vipFqdn": names["nsx_vip"],
+            "rootNsxtManagerPassword": password,
+            "nsxtAdminPassword": password,
+            "nsxtAuditPassword": password,
+            "transportVlanId": requirements["primary_nsx_transport_vlan"],
+            "version": target,
+            "useExistingDeployment": not design["deploy_new_components"],
+        },
+        "networkSpecs": [installer_network(item, design["network_defaults"]) for item in networks],
+        "dnsSpec": {
+            "subdomain": requirements["dns"]["domain"],
+            "nameservers": requirements["dns"]["nameservers"],
+        },
+        "ntpServers": requirements["ntp_servers"],
+        "sddcManagerSpec": {
+            "hostname": names["sddc_manager"],
+            "rootPassword": password,
+            "sshPassword": password,
+            "localUserPassword": password,
+            "version": target,
+            "useExistingDeployment": not design["deploy_new_components"],
+        },
+        "ceipEnabled": design["ceip_enabled"],
+        "skipEsxThumbprintValidation": not design["validate_esx_thumbprints"],
+        "skipGatewayPingValidation": not design["validate_gateway_ping"],
+        "vspClusterSpec": {
+            "platformFqdn": management["platform_fqdn"],
+            "systemUserPassword": password,
+            "ipv4Pool": {
+                "cidr": fleet["subnet"],
+                "ipRange": {
+                    "startIpAddress": fleet["range_start"],
+                    "endIpAddress": fleet["range_end"],
+                },
+            },
+            "size": design["management_services_size"],
+            "internalClusterCidrIpv4": management["internal_service_cidr"],
+            "instanceFqdn": management["instance_fqdn"],
+            "fleetFqdn": management["fleet_fqdn"],
+            "version": target,
+            "useExistingDeployment": not design["deploy_new_components"],
+        },
+        "vcfOperationsSpec": {
+            "nodes": [
+                {"hostname": name, "rootUserPassword": password, "type": node_type}
+                for name, node_type in zip(
+                    names["operations_nodes"], design["operations"]["node_types"], strict=True
+                )
+            ],
+            "adminUserPassword": password,
+            "applianceSize": design["operations"]["appliance_size"],
+            "loadBalancerFqdn": names["operations_load_balancer"],
+            "useExistingDeployment": not design["deploy_new_components"],
+            "version": target,
+        },
+        "vcfManagementComponentsInfrastructureSpec": {
+            "localRegionNetwork": {
+                "networkName": "FLEET_MANAGEMENT",
+                "subnetMask": fleet["subnet_mask"],
+                "gateway": fleet["gateway"],
+            }
+        },
+        "licenseServerSpec": {
+            "hostname": names["license_server"],
+            "version": target,
+            "useExistingDeployment": not design["deploy_new_components"],
+        },
+    }
+
+
+def build_greenfield(requirements: dict[str, Any]) -> dict[str, Any]:
+    demand = requirements["product_demand"]
+    host = requirements["workload_host_profile"]
+    primary = requirements["sites"][0]
+    recovery = requirements["sites"][1]
+    primary_count = workload_hosts(demand, host, 100, primary["host_failures_to_tolerate"])
+    recovery_count = workload_hosts(
+        demand,
+        host,
+        demand["recovery_capacity_percent"],
+        recovery["host_failures_to_tolerate"],
+    )
+    sites = []
+    for source, count in zip(
+        requirements["sites"], [primary_count, recovery_count], strict=True
+    ):
+        failures = source["host_failures_to_tolerate"]
+        surviving = count - failures
+        sites.append(
+            {
+                "site_id": source["site_id"],
+                "role": source["role"],
+                "vcf_instance": source["vcf_instance"],
+                "management_domain_hosts": source["management_domain_hosts"],
+                "workload_domain_id": source["workload_domain_id"],
+                "workload_hosts": count,
+                "resilience": f"N+{failures}",
+                "surviving_workload_capacity": {
+                    "vcpus": surviving * host["usable_vcpus"],
+                    "memory_tib": surviving * host["usable_memory_tib"],
+                    "usable_storage_tib": surviving * host["usable_storage_tib"],
+                },
+            }
+        )
+    availability = requirements["availability"]
+    management = requirements["management_services"]
+    return {
+        "deployment_model": availability["deployment_model"],
+        "sddc_spec": build_sddc_spec(requirements),
+        "sites": sites,
+        "capacity_basis": {
+            "product_demand": {
+                "vcpus": demand["vcpus"],
+                "memory_tib": demand["memory_tib"],
+                "usable_storage_tib": demand["usable_storage_tib"],
+            },
+            "design_headroom_percent": demand["design_headroom_percent"],
+            "recovery_capacity_percent": demand["recovery_capacity_percent"],
+            "host_profile": {
+                "vcpus": host["usable_vcpus"],
+                "memory_tib": host["usable_memory_tib"],
+                "usable_storage_tib": host["usable_storage_tib"],
+            },
+            "required_hosts": {"primary": primary_count, "recovery": recovery_count},
+        },
+        "availability": {
+            "inter_site_rtt_ms": availability["inter_site_rtt_ms"],
+            "cluster_model": availability["cluster_model"],
+            "rpo_minutes": availability["rpo_minutes"],
+            "rto_minutes": availability["rto_minutes"],
+            "management_services_ip_addresses": management["reserved_ip_addresses"],
+            "management_services_minimum_ip_addresses": management["minimum_ip_addresses"],
+            "internal_service_cidr": management["internal_service_cidr"],
+        },
+    }
+
+
+def build_migration(
+    inventory: dict[str, Any], compatibility: dict[str, Any]
+) -> dict[str, Any]:
+    components = {item["id"]: item for item in inventory["components"]}
+    order = compatibility["ordered_component_ids"]
+    if set(components) != set(order):
+        raise InputError("inventory and compatibility snapshot component sets differ")
+    steps = []
+    for ordinal, component_id in enumerate(order, start=1):
+        component = components[component_id]
+        rule = compatibility["rules"][component_id]
+        if not rule["path"] or rule["path"][0] != component["version"]:
+            raise InputError(f"compatibility path does not start at {component_id} source")
+        steps.append(
+            {
+                "order": ordinal,
+                "component_id": component_id,
+                "component": component["name"],
+                "from_version": component["version"],
+                "target": {
+                    "component": rule["target_component"],
+                    "version": rule["target_version"],
+                    "disposition": rule["disposition"],
+                },
+                "path": rule["path"],
+                "actions": rule["actions"],
+                "gates": rule["gates"],
+            }
+        )
+    return {
+        "inventory_id": inventory["inventory_id"],
+        "target_release": compatibility["target_release"],
+        "support_boundary": compatibility["support_boundary"],
+        "ordered_steps": steps,
+    }
+
+
+def build_architecture(
+    requirements: dict[str, Any],
+    inventory: dict[str, Any],
+    compatibility: dict[str, Any],
+) -> dict[str, Any]:
+    requirements = require_object(requirements, "requirements")
+    inventory = require_object(inventory, "inventory")
+    compatibility = require_object(compatibility, "compatibility")
+    require_keys(
+        requirements,
+        {
+            "target_release",
+            "sites",
+            "product_demand",
+            "workload_host_profile",
+            "availability",
+            "primary_networks",
+            "management_services",
+            "primary_appliance_names",
+        },
+        "requirements",
+    )
+    require_keys(inventory, {"inventory_id", "components"}, "inventory")
+    require_keys(
+        compatibility,
+        {"target_release", "support_boundary", "ordered_component_ids", "rules"},
+        "compatibility",
+    )
+    if requirements["target_release"] != compatibility["target_release"]:
+        raise InputError("requirements and compatibility target releases differ")
+    if not isinstance(requirements["sites"], list) or len(requirements["sites"]) != 2:
+        raise InputError("requirements must contain exactly two sites")
+    if not isinstance(inventory["components"], list) or not inventory["components"]:
+        raise InputError("inventory components must be a nonempty array")
+    return {
+        "schema_version": "1.0",
+        "target_release": requirements["target_release"],
+        "greenfield": build_greenfield(requirements),
+        "migration": build_migration(inventory, compatibility),
+    }

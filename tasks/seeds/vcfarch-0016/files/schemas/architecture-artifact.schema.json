{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Northstar VCF 9.1 architecture artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_release",
    "greenfield",
    "migration"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "target_release": {
      "type": "string"
    },
    "greenfield": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_model",
        "sddc_spec",
        "sites",
        "capacity_basis",
        "availability"
      ],
      "properties": {
        "deployment_model": {
          "enum": [
            "separate-vcf-instances"
          ]
        },
        "sddc_spec": {
          "type": "object"
        },
        "sites": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/site"
          }
        },
        "capacity_basis": {
          "$ref": "#/$defs/capacityBasis"
        },
        "availability": {
          "$ref": "#/$defs/availability"
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_id",
        "target_release",
        "support_boundary",
        "ordered_steps"
      ],
      "properties": {
        "inventory_id": {
          "type": "string"
        },
        "target_release": {
          "type": "string"
        },
        "support_boundary": {
          "$ref": "#/$defs/supportBoundary"
        },
        "ordered_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/migrationStep"
          }
        }
      }
    }
  },
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_id",
        "role",
        "vcf_instance",
        "management_domain_hosts",
        "workload_domain_id",
        "workload_hosts",
        "resilience",
        "surviving_workload_capacity"
      ],
      "properties": {
        "site_id": {
          "type": "string"
        },
        "role": {
          "enum": [
            "primary",
            "recovery"
          ]
        },
        "vcf_instance": {
          "type": "string"
        },
        "management_domain_hosts": {
          "type": "integer",
          "minimum": 1
        },
        "workload_domain_id": {
          "type": "string"
        },
        "workload_hosts": {
          "type": "integer",
          "minimum": 1
        },
        "resilience": {
          "type": "string"
        },
        "surviving_workload_capacity": {
          "$ref": "#/$defs/resourceCapacity"
        }
      }
    },
    "resourceCapacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vcpus",
        "memory_tib",
        "usable_storage_tib"
      ],
      "properties": {
        "vcpus": {
          "type": "integer",
          "minimum": 1
        },
        "memory_tib": {
          "type": "integer",
          "minimum": 1
        },
        "usable_storage_tib": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "capacityBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_demand",
        "design_headroom_percent",
        "recovery_capacity_percent",
        "host_profile",
        "required_hosts"
      ],
      "properties": {
        "product_demand": {
          "$ref": "#/$defs/resourceCapacity"
        },
        "design_headroom_percent": {
          "type": "integer",
          "minimum": 0
        },
        "recovery_capacity_percent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "host_profile": {
          "$ref": "#/$defs/resourceCapacity"
        },
        "required_hosts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary",
            "recovery"
          ],
          "properties": {
            "primary": {
              "type": "integer",
              "minimum": 1
            },
            "recovery": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inter_site_rtt_ms",
        "cluster_model",
        "rpo_minutes",
        "rto_minutes",
        "management_services_ip_addresses",
        "management_services_minimum_ip_addresses",
        "internal_service_cidr"
      ],
      "properties": {
        "inter_site_rtt_ms": {
          "type": "integer",
          "minimum": 0
        },
        "cluster_model": {
          "enum": [
            "non-stretched"
          ]
        },
        "rpo_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "rto_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "management_services_ip_addresses": {
          "type": "integer",
          "minimum": 1
        },
        "management_services_minimum_ip_addresses": {
          "type": "integer",
          "minimum": 1
        },
        "internal_service_cidr": {
          "type": "string"
        }
      }
    },
    "supportBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "source_version",
        "end_of_general_support",
        "required_intermediate",
        "terminal_strategy"
      ],
      "properties": {
        "component_id": {
          "type": "string"
        },
        "source_version": {
          "type": "string"
        },
        "end_of_general_support": {
          "type": "string"
        },
        "required_intermediate": {
          "type": "string"
        },
        "terminal_strategy": {
          "type": "string"
        }
      }
    },
    "migrationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "component_id",
        "component",
        "from_version",
        "target",
        "path",
        "actions",
        "gates"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "component_id": {
          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "from_version": {
          "type": "string"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "component",
            "version",
            "disposition"
          ],
          "properties": {
            "component": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "disposition": {
              "enum": [
                "upgrade",
                "migrate-retire",
                "retire",
                "retain"
              ]
            }
          }
        },
        "path": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

{
  "contractFormat": "focused-openapi-projection-v1",
  "source": {
    "repository": "vmware/vcf-api-specs",
    "repositoryCommitSha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "specPath": "specifications/vcf-installer/vcf-installer-openapi.json",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "apiVersion": "9.1.0.0"
  },
  "operations": [
    {
      "operationId": "validateSddcSpec",
      "bindingCommand": "Invoke-VcfInstallerValidateSddcSpec",
      "method": "POST",
      "path": "/v1/sddcs/validations",
      "parameters": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "SddcSpec"
      },
      "responses": {
        "200": { "contentType": "application/json", "schema": "Validation" },
        "202": { "contentType": "application/json", "schema": "Validation" },
        "400": { "contentType": "application/json", "schema": "Error" },
        "403": { "contentType": "application/json", "schema": "Error" },
        "404": { "contentType": "application/json", "schema": "Error" },
        "500": { "contentType": "application/json", "schema": "Error" }
      }
    },
    {
      "operationId": "deploySddc",
      "bindingCommand": "Invoke-VcfInstallerDeploySddc",
      "method": "POST",
      "path": "/v1/sddcs",
      "parameters": [
        {
          "name": "skipValidations",
          "in": "query",
          "required": false,
          "schema": {
            "type": "boolean",
            "default": false
          }
        }
      ],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "SddcSpec"
      },
      "responses": {
        "202": { "contentType": "application/json", "schema": "SddcTask" },
        "400": { "contentType": "application/json", "schema": "Error" },
        "500": { "contentType": "application/json", "schema": "Error" }
      }
    }
  ],
  "schemas": {
    "SddcSpec": {
      "type": "object",
      "required": [
        "dnsSpec",
        "networkSpecs",
        "sddcId",
        "vcenterSpec"
      ],
      "properties": {
        "sddcId": { "type": "string", "minLength": 3, "maxLength": 20, "pattern": "^[a-zA-Z0-9-]+$" },
        "workflowType": { "type": "string", "pattern": "(VCF|VCF_COMPLETE|VCF_EXTEND|VVF|VCF_BOOTSTRAP)" },
        "hostSpecs": { "type": "array", "items": { "$ref": "SddcHostSpec" } },
        "version": { "type": "string" },
        "vcenterSpec": { "$ref": "SddcVcenterSpec" },
        "clusterSpec": { "$ref": "SddcClusterSpec" },
        "dvsSpecs": { "type": "array", "items": { "$ref": "DvsSpec" } },
        "nsxtSpec": { "$ref": "SddcNsxtSpec" },
        "networkSpecs": { "type": "array", "items": { "$ref": "SddcNetworkSpec" } },
        "dnsSpec": { "$ref": "DnsSpec" },
        "ntpServers": { "type": "array", "items": { "type": "string" } },
        "sddcManagerSpec": { "$ref": "SddcManagerSpec" },
        "managementPoolName": { "type": "string" },
        "ceipEnabled": { "type": "boolean" },
        "skipEsxThumbprintValidation": { "type": "boolean" },
        "skipGatewayPingValidation": { "type": "boolean" },
        "securitySpec": { "$ref": "SecuritySpec" },
        "datastoreSpec": { "$ref": "SddcDatastoreSpec" },
        "vspClusterSpec": { "$ref": "SddcVspClusterSpec" },
        "fleetLcmSpec": { "$ref": "FleetLcmServiceSpec" },
        "sddcLcmSpec": { "$ref": "SddcLcmServiceSpec" },
        "fleetDepotSpec": { "$ref": "FleetDepotServiceSpec" },
        "telemetryAcceptorSpec": { "$ref": "TelemetryAcceptorSpec" },
        "vidbSpec": { "$ref": "VidbSpec" },
        "saltSpec": { "$ref": "SaltSpec" },
        "saltRaasSpec": { "$ref": "SaltSpec" },
        "vcfOperationsSpec": { "$ref": "VcfOperationsSpec" },
        "vcfOperationsCollectorSpec": { "$ref": "VcfOperationsCollectorSpec" },
        "vcfAutomationSpec": { "$ref": "VcfAutomationSpec" },
        "vcfManagementComponentsInfrastructureSpec": { "$ref": "VcfManagementComponentsInfrastructureSpec" },
        "licenseServerSpec": { "$ref": "LicenseServerSpec" },
        "vcfInstanceName": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "DnsSpec": {
      "type": "object",
      "required": ["subdomain"],
      "properties": {
        "subdomain": { "type": "string" },
        "nameservers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "SddcVcenterSpec": {
      "type": "object",
      "required": ["rootVcenterPassword", "vcenterHostname"],
      "properties": {
        "vcenterHostname": { "type": "string", "minLength": 0, "maxLength": 63 },
        "rootVcenterPassword": { "type": "string", "minLength": 8, "maxLength": 20 },
        "vmSize": { "type": "string" },
        "storageSize": { "type": "string" },
        "ssoDomain": { "type": "string" },
        "adminUserSsoUsername": { "type": "string", "minLength": 1 },
        "adminUserSsoPassword": { "type": "string", "minLength": 8 },
        "version": { "type": "string" },
        "useExistingDeployment": { "type": "boolean", "default": false },
        "sslThumbprint": { "type": "string" }
      }
    },
    "SddcNetworkSpec": {
      "type": "object",
      "required": ["networkType", "vlanId"],
      "properties": {
        "networkType": { "type": "string" },
        "subnet": { "type": "string", "minLength": 7, "maxLength": 18 },
        "gateway": { "type": "string", "minLength": 7, "maxLength": 15 },
        "subnetMask": { "type": "string", "minLength": 7, "maxLength": 15 },
        "includeIpAddress": { "type": "array", "items": { "type": "string" } },
        "includeIpAddressRanges": { "type": "array", "items": { "$ref": "IpRange" } },
        "vlanId": { "type": "integer", "format": "int32", "minimum": 0, "maximum": 4094 },
        "mtu": { "type": "integer", "format": "int32", "minimum": 1280, "maximum": 9190 },
        "teamingPolicy": { "type": "string" },
        "activeUplinks": { "type": "array", "items": { "type": "string" } },
        "standbyUplinks": { "type": "array", "items": { "type": "string" } },
        "portGroupKey": { "type": "string" },
        "ipAddressVersion": { "type": "string", "pattern": "(IPv4|IPv6)", "default": "IPv4" },
        "ipAddressAssignmentMode": { "type": "string", "pattern": "(STATIC|DHCP|SLAAC)", "default": "STATIC" }
      }
    },
    "Validation": {
      "type": "object",
      "required": ["description", "executionStatus", "id", "resultStatus"],
      "properties": {
        "id": { "type": "string", "readOnly": true },
        "description": { "type": "string", "readOnly": true },
        "executionStatus": { "type": "string", "readOnly": true },
        "resultStatus": { "type": "string", "readOnly": true },
        "validationChecks": { "type": "array", "readOnly": true, "items": { "$ref": "ValidationCheck" } },
        "additionalProperties": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "SddcTask": {
      "type": "object",
      "required": ["creationTimestamp", "status"],
      "properties": {
        "id": { "type": "string", "readOnly": true },
        "name": { "type": "string", "readOnly": true },
        "deploymentType": { "type": "string", "readOnly": true },
        "vcfInstanceName": { "type": "string", "readOnly": true },
        "status": { "type": "string", "readOnly": true },
        "localizableNamePack": { "$ref": "MessagePack" },
        "creationTimestamp": { "type": "string", "readOnly": true },
        "sddcSubTasks": { "type": "array", "items": { "$ref": "SddcSubTask" } },
        "milestones": { "type": "array", "items": { "$ref": "SddcMilestoneTask" } }
      }
    }
  },
  "exerciseWireProfile": {
    "precheckOperationId": "validateSddcSpec",
    "mutatingOperationId": "deploySddc",
    "requestBodySchema": "SddcSpec",
    "requiredRootMembers": ["sddcId", "vcenterSpec", "networkSpecs", "dnsSpec"],
    "requiredVcenterMembers": ["vcenterHostname", "rootVcenterPassword"],
    "requiredNetworkMembers": ["networkType", "vlanId"],
    "requiredDnsMembers": ["subdomain"],
    "unsetBehavior": "omit",
    "deployQueryMembers": [],
    "reuseIdenticalModel": true
  }
}

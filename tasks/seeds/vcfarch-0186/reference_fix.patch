+	if value, ok := evidence[name]; ok {
+		return value
+	}
+	return "Recorded technical evidence demonstrates that " + name + " is satisfied."
+}
+
+func migrationActions(sourceID string) []string {
+	switch sourceID {
+	case "aria-operations-prod":
+		return []string{
+			"Deploy VCF Operations 9.0.2 greenfield because 8.18.6 is excluded from the in-place 9.0.0-9.0.2 path.",
+			"Export and import supported custom content, recreate the nine adapters through redundant cloud proxies, and retain 8.18.6 read-only for historical metrics.",
+		}
+	case "aria-automation-prod":
+		return []string{
+			"Enable VCF Identity Broker, import the healthy Aria Automation 8.18.1 instance from Aria Suite Lifecycle into Fleet Management, and trigger the 9.0.2 upgrade.",
+			"Reconcile carried deployments and content, replace legacy vIDM configuration, and exercise catalog, identity, and Orchestrator canaries.",
+		}
+	case "aria-logs-prod":
+		return []string{
+			"Run the new VCF Operations for Logs 9.0.2 cluster beside 8.18.3; export/import content and reconfigure all integrations on the target.",
+			"Transfer the newest 90 days, retain the older 275 days read-only, and repoint the 630 compatible 8.18 agents with explicit TLS trust.",
+		}
+	default:
+		return []string{"Execute the pinned migration method and reconcile all carried and abandoned content."}
+	}
+}
+
+func rollbackAction(sourceID string) string {
+	switch sourceID {
+	case "aria-operations-prod":
+		return "Keep 8.18.6 powered, isolated from new writes, and queryable; restore original adapter routes if target collection or content validation fails."
+	case "aria-automation-prod":
+		return "Keep the offline 8.18.1 backup and original VIP/DNS values; on failed import, restore source services and route users and API clients back before retrying Fleet import."
+	case "aria-logs-prod":
+		return "Keep 8.18.3 ingesting until target acceptance; restore integration endpoints and agent destinations to the source VIP if target ingestion, content, or history checks fail."
+	default:
+		return "Preserve the source and its verified backup until target acceptance and the rollback window complete."
+	}
+}
+
+func domainByID(domains []Domain, id string) (Domain, bool) {
+	for _, domain := range domains {
+		if domain.ID == id {
+			return domain, true
+		}
+	}
+	return Domain{}, false
+}
+
+func sourceByID(sources []SourceSystem, id string) (SourceSystem, bool) {
+	for _, source := range sources {
+		if source.ID == id {
+			return source, true
+		}
+	}
+	return SourceSystem{}, false
+}
+
+func ruleForSource(source SourceSystem, rules []MigrationRule) (MigrationRule, bool) {
+	for _, rule := range rules {
+		if rule.SourceProduct == source.Product && rule.SourceVersion == source.Version {
+			return rule, true
+		}
+	}
+	return MigrationRule{}, false
+}
+
+func protectedDomainIDs(domains []Domain) []string {
+	var result []string
+	for _, domain := range domains {
+		if domain.Protected {
+			result = append(result, domain.ID)
+		}
+	}
+	sort.Strings(result)
+	return result
+}
+
+func sameStringSet(left, right []string) bool {
+	if len(left) != len(right) {
+		return false
+	}
+	leftCopy := append([]string(nil), left...)
+	rightCopy := append([]string(nil), right...)
+	sort.Strings(leftCopy)
+	sort.Strings(rightCopy)
+	for i := range leftCopy {
+		if leftCopy[i] != rightCopy[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func hasBlank(values []string) bool {
+	for _, value := range values {
+		if strings.TrimSpace(value) == "" {
+			return true
+		}
+	}
+	return false
+}

+func validateSteps(steps []Step, inv Inventory, snap CompatibilitySnapshot) error {
+	seenIDs := map[string]bool{}
+	migrationOrder := map[string]int{}
+	retirementOrder := map[string]int{}
+	guardOrder, placementOrder, cutoverOrder := 0, 0, 0
+	for i, step := range steps {
+		if step.Order != i+1 {
+			return fmt.Errorf("step order must be contiguous at position %d", i+1)
+		}
+		if step.ID == "" || seenIDs[step.ID] {
+			return fmt.Errorf("step IDs must be nonempty and unique")
+		}
+		seenIDs[step.ID] = true
+		if len(step.Actions) == 0 || hasBlank(step.Actions) {
+			return fmt.Errorf("step %s must contain concrete actions", step.ID)
+		}
+		if err := validateRequiredGates(step.EntryGates, nil, step.ID+" entry"); err != nil {
+			return err
+		}
+		if err := validateRequiredGates(step.ExitGates, nil, step.ID+" exit"); err != nil {
+			return err
+		}
+		switch step.Kind {
+		case "protect-management":
+			if guardOrder != 0 {
+				return fmt.Errorf("multiple management protection steps")
+			}
+			guardOrder = step.Order
+			if err := validateRequiredGates(step.EntryGates, snap.Foundation.ManagementEntryGates, step.ID); err != nil {
+				return err
+			}
+			if err := validateRequiredGates(step.ExitGates, snap.Foundation.ManagementExitGates, step.ID); err != nil {
+				return err
+			}
+		case "place-targets":
+			if placementOrder != 0 {
+				return fmt.Errorf("multiple target placement steps")
+			}
+			placementOrder = step.Order
+			if err := validateRequiredGates(step.EntryGates, snap.Foundation.PlacementEntryGates, step.ID); err != nil {
+				return err
+			}
+			if err := validateRequiredGates(step.ExitGates, snap.Foundation.PlacementExitGates, step.ID); err != nil {
+				return err
+			}
+		case "migrate-product":
+			if migrationOrder[step.SourceID] != 0 {
+				return fmt.Errorf("duplicate migration for %s", step.SourceID)
+			}
+			migrationOrder[step.SourceID] = step.Order
+			if err := validateMigrationStep(step, inv, snap); err != nil {
+				return err
+			}
+		case "cutover":
+			if cutoverOrder != 0 {
+				return fmt.Errorf("multiple cutover steps")
+			}
+			cutoverOrder = step.Order
+			if err := validateRequiredGates(step.EntryGates, snap.CutoverGates, step.ID); err != nil {
+				return err
+			}
+		case "retire-source":
+			if retirementOrder[step.SourceID] != 0 {
+				return fmt.Errorf("duplicate retirement for %s", step.SourceID)
+			}
+			retirementOrder[step.SourceID] = step.Order
+			if step.Migration != nil {
+				return fmt.Errorf("retirement %s must not embed a migration", step.ID)
+			}
+			if err := validateRequiredGates(step.EntryGates, snap.RetirementGates, step.ID); err != nil {
+				return err
+			}
+		default:
+			return fmt.Errorf("step %s has unsupported kind %q", step.ID, step.Kind)
+		}
+	}
+	if guardOrder == 0 || placementOrder == 0 || cutoverOrder == 0 || !(guardOrder < placementOrder) {
+		return fmt.Errorf("management protection, placement, and cutover steps are required in order")
+	}
+	for _, source := range inv.Sources {
+		migration := migrationOrder[source.ID]
+		retirement := retirementOrder[source.ID]
+		if migration == 0 || retirement == 0 {
+			return fmt.Errorf("%s requires one migration and one retirement step", source.ID)
+		}
+		if migration <= placementOrder || migration >= cutoverOrder || retirement <= cutoverOrder {
+			return fmt.Errorf("%s has an invalid placement/migration/cutover/retirement sequence", source.ID)
+		}
+		rule, _ := ruleForSource(source, snap.MigrationRules)
+		retireStep := steps[retirement-1]
+		if retireStep.TargetComponent != rule.TargetComponent {
+			return fmt.Errorf("retirement for %s names the wrong target", source.ID)
+		}
+	}
+	for _, dependency := range snap.Dependencies {
+		before, beforeOK := migrationOrder[dependency.BeforeSourceID]
+		after, afterOK := migrationOrder[dependency.AfterSourceID]
+		if !beforeOK || !afterOK || before >= after {
+			return fmt.Errorf("migration dependency %s before %s is not satisfied", dependency.BeforeSourceID, dependency.AfterSourceID)
+		}
+	}
+	return nil
+}
+
+func validateMigrationStep(step Step, inv Inventory, snap CompatibilitySnapshot) error {
+	source, ok := sourceByID(inv.Sources, step.SourceID)
+	if !ok {
+		return fmt.Errorf("migration %s names an unknown source", step.ID)
+	}
+	rule, ok := ruleForSource(source, snap.MigrationRules)
+	if !ok {
+		return fmt.Errorf("migration %s has no pinned rule", step.ID)
+	}
+	if step.Migration == nil {
+		return fmt.Errorf("migration %s has no migration detail", step.ID)
+	}
+	m := step.Migration
+	if step.TargetComponent != rule.TargetComponent || m.SourceProduct != source.Product || m.SourceVersion != source.Version || m.TargetComponent != rule.TargetComponent || m.TargetVersion != rule.TargetVersion || m.Method != rule.Method || m.SourceEOGS != rule.SourceEOGS || m.SupportBoundary != rule.SupportBoundary {
+		return fmt.Errorf("migration %s contradicts its pinned product, version, method, target, or support boundary", step.ID)
+	}
+	if strings.TrimSpace(m.Rollback) == "" {
+		return fmt.Errorf("migration %s has no rollback preservation", step.ID)
+	}
+	if err := validateRequiredGates(step.EntryGates, rule.RequiredEntryGates, step.ID); err != nil {
+		return err
+	}
+	if err := validateRequiredGates(step.ExitGates, rule.RequiredExitGates, step.ID); err != nil {
+		return err
+	}
+	return validateContent(m.Content, source, rule)
+}
+
+func validateContent(actual []ContentDecision, source SourceSystem, rule MigrationRule) error {
+	if len(actual) != len(source.Content) || len(rule.ContentRules) != len(source.Content) {
+		return fmt.Errorf("content coverage for %s is incomplete", source.ID)
+	}
+	rules := make(map[string]ContentRule, len(rule.ContentRules))
+	for _, contentRule := range rule.ContentRules {
+		rules[contentRule.Category] = contentRule
+	}
+	seen := map[string]bool{}
+	for _, decision := range actual {
+		quantity, ok := source.Content[decision.Category]
+		contentRule, hasRule := rules[decision.Category]
+		if !ok || !hasRule || seen[decision.Category] {
+			return fmt.Errorf("content category %q is unexpected or duplicated for %s", decision.Category, source.ID)
+		}
+		seen[decision.Category] = true
+		if decision.SourceQuantity != quantity || decision.CarryQuantity+decision.AbandonQuantity != quantity {
+			return fmt.Errorf("content quantities for %s/%s do not reconcile", source.ID, decision.Category)
+		}
+		wantCarry, wantAbandon := expectedDisposition(quantity, contentRule)
+		if decision.CarryQuantity != wantCarry || decision.AbandonQuantity != wantAbandon || decision.CarryMethod != contentRule.CarryMethod || decision.AbandonReason != contentRule.AbandonReason {
+			return fmt.Errorf("content disposition for %s/%s contradicts the pinned snapshot", source.ID, decision.Category)
+		}
+	}
+	return nil
+}
+
+func deriveContent(source SourceSystem, rule MigrationRule) ([]ContentDecision, error) {
+	rules := make(map[string]ContentRule, len(rule.ContentRules))
+	for _, contentRule := range rule.ContentRules {
+		rules[contentRule.Category] = contentRule
+	}
+	categories := make([]string, 0, len(source.Content))
+	for category := range source.Content {
+		categories = append(categories, category)
+	}
+	sort.Strings(categories)
+	decisions := make([]ContentDecision, 0, len(categories))
+	for _, category := range categories {
+		contentRule, ok := rules[category]
+		if !ok {
+			return nil, fmt.Errorf("no content rule for %s/%s", source.ID, category)
+		}
+		quantity := source.Content[category]
+		carry, abandon := expectedDisposition(quantity, contentRule)
+		decisions = append(decisions, ContentDecision{
+			Category:        category,
+			SourceQuantity:  quantity,
+			CarryQuantity:   carry,
+			AbandonQuantity: abandon,
+			CarryMethod:     contentRule.CarryMethod,
+			AbandonReason:   contentRule.AbandonReason,
+		})
+	}
+	return decisions, nil
+}
+
+func expectedDisposition(quantity int, rule ContentRule) (carry, abandon int) {
+	switch rule.Disposition {
+	case "carry":
+		return quantity, 0
+	case "abandon":
+		return 0, quantity
+	case "split":
+		carry = quantity
+		if carry > rule.MaxCarry {
+			carry = rule.MaxCarry
+		}
+		return carry, quantity - carry
+	default:
+		return -1, quantity + 1
+	}
+}
+
+func validateRequiredGates(actual []Gate, required []string, context string) error {
+	if len(actual) == 0 {
+		return fmt.Errorf("%s must have at least one technical gate", context)
+	}
+	names := make(map[string]bool, len(actual))
+	for _, gate := range actual {
+		if strings.TrimSpace(gate.Name) == "" || strings.TrimSpace(gate.Evidence) == "" || names[gate.Name] {
+			return fmt.Errorf("%s has a blank or duplicate gate without evidence", context)
+		}
+		names[gate.Name] = true
+	}
+	for _, name := range required {
+		if !names[name] {
+			return fmt.Errorf("%s is missing required gate %q", context, name)
+		}
+	}
+	return nil
+}
+
+func gates(names []string) []Gate {
+	result := make([]Gate, 0, len(names))
+	for _, name := range names {
+		result = append(result, Gate{Name: name, Evidence: gateEvidence(name)})
+	}
+	return result
+}

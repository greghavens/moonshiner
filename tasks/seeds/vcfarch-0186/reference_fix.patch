+func buildPlan(inv Inventory, snap CompatibilitySnapshot, research []ResearchReference) (Plan, error) {
+	target, ok := domainByID(inv.Domains, snap.TargetDomainID)
+	if !ok {
+		return Plan{}, fmt.Errorf("target domain %q is not inventoried", snap.TargetDomainID)
+	}
+
+	plan := Plan{
+		SchemaVersion: SchemaVersion,
+		EstateID:      inv.EstateID,
+		SnapshotID:    snap.SnapshotID,
+		Research:      research,
+		Placement: PlacementPlan{
+			DomainID:               target.ID,
+			HostCount:              target.HostCount,
+			FailuresToTolerate:     target.FailuresToTolerate,
+			ManagementDomainImpact: snap.Topology.ManagementDomainImpact,
+			PreservedDomains:       protectedDomainIDs(inv.Domains),
+		},
+	}
+	for _, profile := range snap.PlacementProfiles {
+		plan.Placement.Components = append(plan.Placement.Components, ComponentPlacement{
+			Component:        profile.Component,
+			Version:          profile.Version,
+			Nodes:            profile.Nodes,
+			VCPUPerNode:      profile.VCPUPerNode,
+			MemoryGiBPerNode: profile.MemoryGiBPerNode,
+			DiskGiBPerNode:   profile.DiskGiBPerNode,
+			AntiAffinity:     snap.Topology.RequireAntiAffinity,
+			Purpose:          profile.Purpose,
+		})
+	}
+
+	plan.Steps = append(plan.Steps,
+		Step{
+			Order:      1,
+			ID:         "protect-management-domain",
+			Kind:       "protect-management",
+			Actions:    []string{"Capture the management-domain health and inventory baseline; make no placement, lifecycle, network, or storage changes there."},
+			EntryGates: gates(snap.Foundation.ManagementEntryGates),
+			ExitGates:  gates(snap.Foundation.ManagementExitGates),
+		},
+		Step{
+			Order:      2,
+			ID:         "place-vcf-operations-stack",
+			Kind:       "place-targets",
+			Actions:    []string{"Deploy every sized target component on ops-wld01 and apply VM anti-affinity across its six hosts and fault domains."},
+			EntryGates: gates(snap.Foundation.PlacementEntryGates),
+			ExitGates:  gates(snap.Foundation.PlacementExitGates),
+		},
+	)
+
+	for _, source := range inv.Sources {
+		rule, ok := ruleForSource(source, snap.MigrationRules)
+		if !ok {
+			return Plan{}, fmt.Errorf("no compatibility rule for %s %s", source.Product, source.Version)
+		}
+		content, err := deriveContent(source, rule)
+		if err != nil {
+			return Plan{}, err
+		}
+		plan.Steps = append(plan.Steps, Step{
+			Order:           len(plan.Steps) + 1,
+			ID:              "migrate-" + source.ID,
+			Kind:            "migrate-product",
+			SourceID:        source.ID,
+			TargetComponent: rule.TargetComponent,
+			Actions:         migrationActions(source.ID),
+			EntryGates:      gates(rule.RequiredEntryGates),
+			ExitGates:       gates(rule.RequiredExitGates),
+			Migration: &MigrationPlan{
+				SourceProduct:   source.Product,
+				SourceVersion:   source.Version,
+				TargetComponent: rule.TargetComponent,
+				TargetVersion:   rule.TargetVersion,
+				Method:          rule.Method,
+				SourceEOGS:      rule.SourceEOGS,
+				SupportBoundary: rule.SupportBoundary,
+				Content:         content,
+				Rollback:        rollbackAction(source.ID),
+			},
+		})
+	}
+
+	plan.Steps = append(plan.Steps, Step{
+		Order:      len(plan.Steps) + 1,
+		ID:         "cut-over-integrated-services",
+		Kind:       "cutover",
+		Actions:    []string{"Switch collection, catalog access, API clients, integrations, and log senders to the validated VCF targets while preserving tested routes back to the sources."},
+		EntryGates: gates(snap.CutoverGates),
+		ExitGates:  gates([]string{"production-traffic-on-targets"}),
+	})
+	for _, source := range inv.Sources {
+		rule, _ := ruleForSource(source, snap.MigrationRules)
+		plan.Steps = append(plan.Steps, Step{
+			Order:           len(plan.Steps) + 1,
+			ID:              "retire-" + source.ID,
+			Kind:            "retire-source",
+			SourceID:        source.ID,
+			TargetComponent: rule.TargetComponent,
+			Actions:         []string{"After its rollback and retained-history window, remove the source registration and power off the source while retaining verified backups under the estate retention practice."},
+			EntryGates:      gates(snap.RetirementGates),
+			ExitGates:       gates([]string{"source-powered-off-and-registration-removed"}),
+		})
+	}
+
+	if err := validatePlan(plan, inv, snap); err != nil {
+		return Plan{}, err
+	}
+	return plan, nil
+}
+
+func validatePlan(plan Plan, inv Inventory, snap CompatibilitySnapshot) error {
+	if plan.SchemaVersion != SchemaVersion {
+		return fmt.Errorf("schema_version is %q, want %q", plan.SchemaVersion, SchemaVersion)
+	}
+	if plan.EstateID != inv.EstateID || plan.SnapshotID != snap.SnapshotID {
+		return fmt.Errorf("plan does not identify the fixture and pinned snapshot")
+	}
+	if err := validateResearch(plan.Research, inv, snap); err != nil {
+		return err
+	}
+	if snap.Topology.MinimumHostsRule != "2*ftt+1" {
+		return fmt.Errorf("unsupported topology rule %q", snap.Topology.MinimumHostsRule)
+	}
+	if plan.Placement.FailuresToTolerate < 0 {
+		return fmt.Errorf("failures_to_tolerate cannot be negative")
+	}
+	minimumHosts := 2*plan.Placement.FailuresToTolerate + 1
+	if plan.Placement.HostCount < minimumHosts {
+		return fmt.Errorf("failures_to_tolerate=%d requires at least %d hosts, got %d", plan.Placement.FailuresToTolerate, minimumHosts, plan.Placement.HostCount)
+	}
+	target, ok := domainByID(inv.Domains, snap.TargetDomainID)
+	if !ok || !target.AvailableForTargets || target.Role != "workload" {
+		return fmt.Errorf("snapshot target is not an available workload domain")
+	}
+	if plan.Placement.DomainID != target.ID {
+		return fmt.Errorf("targets must be placed on %s", target.ID)
+	}
+	if plan.Placement.HostCount != target.HostCount || plan.Placement.FailuresToTolerate != target.FailuresToTolerate {
+		return fmt.Errorf("plan topology does not match the target-domain inventory")
+	}
+	if plan.Placement.ManagementDomainImpact != snap.Topology.ManagementDomainImpact {
+		return fmt.Errorf("management domain impact must be %q", snap.Topology.ManagementDomainImpact)
+	}
+	if !sameStringSet(plan.Placement.PreservedDomains, protectedDomainIDs(inv.Domains)) {
+		return fmt.Errorf("all protected domains must be preserved")
+	}
+	if err := validatePlacements(plan.Placement.Components, snap); err != nil {
+		return err
+	}
+	return validateSteps(plan.Steps, inv, snap)
+}

diff --git a/architecture/plan_test.go b/architecture/plan_test.go
new file mode 100644
index 0000000..a9eba9f
--- /dev/null
+++ b/architecture/plan_test.go
@@ -0,0 +1,38 @@
+package architecture
+
+import "testing"
+
+func TestPinnedContentDisposition(t *testing.T) {
+	inv, snap := loadInputs(t)
+	artifact := loadArtifact(t)
+	plan, err := BuildPlan(inv, snap, artifact.Research)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tests := []struct {
+		sourceID string
+		category string
+		carry    int
+		abandon  int
+	}{
+		{sourceID: "aria-operations-prod", category: "custom_dashboards", carry: 42},
+		{sourceID: "aria-operations-prod", category: "historical_metrics_days", abandon: 400},
+		{sourceID: "aria-automation-prod", category: "active_deployments", carry: 280},
+		{sourceID: "aria-automation-prod", category: "identity_provider_configuration", abandon: 1},
+		{sourceID: "aria-logs-prod", category: "historical_logs_days", carry: 90, abandon: 275},
+	}
+	for _, tc := range tests {
+		t.Run(tc.sourceID+"/"+tc.category, func(t *testing.T) {
+			step := migrationStep(&plan, tc.sourceID)
+			for _, decision := range step.Migration.Content {
+				if decision.Category == tc.category {
+					if decision.CarryQuantity != tc.carry || decision.AbandonQuantity != tc.abandon {
+						t.Fatalf("got carry=%d abandon=%d, want carry=%d abandon=%d", decision.CarryQuantity, decision.AbandonQuantity, tc.carry, tc.abandon)
+					}
+					return
+				}
+			}
+			t.Fatal("content decision not found")
+		})
+	}
+}

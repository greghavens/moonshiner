+func validatePlacements(actual []ComponentPlacement, snap CompatibilitySnapshot) error {
+	if len(actual) != len(snap.PlacementProfiles) {
+		return fmt.Errorf("placement has %d components, want %d", len(actual), len(snap.PlacementProfiles))
+	}
+	byComponent := make(map[string]ComponentPlacement, len(actual))
+	for _, placement := range actual {
+		if _, duplicate := byComponent[placement.Component]; duplicate {
+			return fmt.Errorf("duplicate placement for %s", placement.Component)
+		}
+		byComponent[placement.Component] = placement
+	}
+	for _, profile := range snap.PlacementProfiles {
+		got, ok := byComponent[profile.Component]
+		if !ok {
+			return fmt.Errorf("missing placement for %s", profile.Component)
+		}
+		if got.Version != profile.Version || got.Nodes != profile.Nodes || got.VCPUPerNode != profile.VCPUPerNode || got.MemoryGiBPerNode != profile.MemoryGiBPerNode || got.DiskGiBPerNode != profile.DiskGiBPerNode || got.Purpose != profile.Purpose {
+			return fmt.Errorf("placement for %s does not match its pinned sizing profile", profile.Component)
+		}
+		if got.AntiAffinity != snap.Topology.RequireAntiAffinity {
+			return fmt.Errorf("placement for %s has the wrong anti-affinity setting", profile.Component)
+		}
+	}
+	return nil
+}

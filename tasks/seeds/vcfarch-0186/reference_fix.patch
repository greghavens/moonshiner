+func validateResearch(research []ResearchReference, inv Inventory, snap CompatibilitySnapshot) error {
+	if len(research) == 0 {
+		return fmt.Errorf("research must include at least one Broadcom source")
+	}
+	for i, reference := range research {
+		if strings.TrimSpace(reference.Title) == "" || strings.TrimSpace(reference.URL) == "" || strings.TrimSpace(reference.AccessedAt) == "" {
+			return fmt.Errorf("research reference %d has incomplete metadata", i+1)
+		}
+		parsed, err := url.Parse(reference.URL)
+		if err != nil || (!strings.EqualFold(parsed.Scheme, "http") && !strings.EqualFold(parsed.Scheme, "https")) || parsed.User != nil || parsed.Hostname() == "" {
+			return fmt.Errorf("research reference %d must use an absolute Broadcom HTTP(S) URL", i+1)
+		}
+		host := strings.ToLower(parsed.Hostname())
+		if host != "broadcom.com" && !strings.HasSuffix(host, ".broadcom.com") {
+			return fmt.Errorf("research reference %d is not Broadcom-published", i+1)
+		}
+		accessed, err := time.Parse("2006-01-02", reference.AccessedAt)
+		if err != nil || accessed.Format("2006-01-02") != reference.AccessedAt || reference.AccessedAt < snap.AsOf {
+			return fmt.Errorf("research reference %d has an invalid or stale access date", i+1)
+		}
+		if len(reference.Claims) == 0 || hasBlank(reference.Claims) {
+			return fmt.Errorf("research reference %d must record nonblank claims", i+1)
+		}
+	}
+	for _, source := range inv.Sources {
+		rule, ok := ruleForSource(source, snap.MigrationRules)
+		if !ok {
+			return fmt.Errorf("no compatibility rule for %s %s", source.Product, source.Version)
+		}
+		versionCovered, lifecycleCovered := false, false
+		for _, reference := range research {
+			text := reference.Title + " " + strings.Join(reference.Claims, " ")
+			if strings.Contains(text, source.Version) {
+				versionCovered = true
+				if strings.Contains(text, rule.SourceEOGS) {
+					lifecycleCovered = true
+				}
+			}
+		}
+		if !versionCovered || !lifecycleCovered {
+			return fmt.Errorf("research does not cover exact source version and lifecycle boundary for %s %s", source.Product, source.Version)
+		}
+	}
+	return nil
+}

      "required_exit_gates": ["deployments-reconciled", "catalog-smoke-tests-pass", "identity-login-pass", "orchestrator-workflows-pass"]
    },
    {
      "source_product": "VMware Aria Operations for Logs",
      "source_version": "8.18.3",
      "target_component": "VCF Operations for Logs",
      "target_version": "9.0.2",

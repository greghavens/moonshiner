      "content_rules": [
        {"category": "active_deployments", "disposition": "carry", "carry_method": "fleet-import-upgrade"},
        {"category": "cloud_accounts", "disposition": "carry", "carry_method": "fleet-import-upgrade"},
        {"category": "cloud_templates", "disposition": "carry", "carry_method": "fleet-import-upgrade"},
        {"category": "cloud_zones", "disposition": "carry", "carry_method": "fleet-import-upgrade"},
        {"category": "custom_forms", "disposition": "carry", "carry_method": "fleet-import-upgrade"},

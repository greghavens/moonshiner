{
  "contract_kind": "task-scoped projection of the pinned OpenAPI specification",
  "product": "VMware Cloud Foundation 9.1 SDDC Manager",
  "openapi": "3.0.1",
  "spec_version": "9.1.0.0",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "license": "Apache-2.0",
    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json"
  },
  "operations": [
    {
      "operationId": "updateOrRotatePasswords",
      "method": "PATCH",
      "path": "/v1/credentials",
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": "CredentialsUpdateSpec"
      },
      "responses": {
        "202": "Task",
        "400": "Error",
        "401": "Error",
        "403": "Error",
        "500": "Error"
      }
    },
    {
      "operationId": "getCredentialsTask",
      "method": "GET",
      "path": "/v1/credentials/tasks/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": "CredentialsTask",
        "400": "Error",
        "500": "Error"
      }
    },
    {
      "operationId": "getCredentialTaskByResourceID",
      "method": "GET",
      "path": "/v1/credentials/tasks/{id}/resource-credentials",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "type": "array",
          "items": {
            "$ref": "ResourceCredentials"
          }
        },
        "400": "Error",
        "500": "Error"
      }
    }
  ],
  "schemas": {
    "AutoRotateCredentialPolicyInputSpec": {
      "type": "object",
      "required": [
        "enableAutoRotatePolicy"
      ],
      "properties": {
        "frequencyInDays": {
          "type": "integer",
          "format": "int32"
        },
        "enableAutoRotatePolicy": {
          "type": "boolean"
        }
      }
    },
    "BaseCredential": {
      "type": "object",
      "required": [
        "username"
      ],
      "properties": {
        "credentialType": {
          "type": "string",
          "example": "One among: SSO, SSH, API, FTP, AUDIT"
        },
        "accountType": {
          "type": "string",
          "example": "One among: USER, SYSTEM, SERVICE"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "CredentialsUpdateSpec": {
      "type": "object",
      "required": [
        "elements",
        "operationType"
      ],
      "properties": {
        "operationType": {
          "type": "string",
          "example": "One among: UPDATE, ROTATE, REMEDIATE, UPDATE_AUTO_ROTATE_POLICY"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "ResourceCredentials"
          }
        },
        "autoRotatePolicy": {
          "$ref": "AutoRotateCredentialPolicyInputSpec"
        }
      }
    },
    "ResourceCredentials": {
      "type": "object",
      "required": [
        "credentials",
        "resourceType"
      ],
      "properties": {
        "resourceName": {
          "type": "string"
        },
        "resourceId": {
          "type": "string"
        },
        "resourceType": {
          "type": "string",
          "example": "One among: ESXI, VCENTER, PSC, NSXT_MANAGER, NSXT_EDGE, NSX_ALB, BACKUP, HCX_MANAGER, VSP"
        },
        "credentials": {
          "type": "array",
          "items": {
            "$ref": "BaseCredential"
          }
        }
      }
    },
    "Task": {
      "type": "object",
      "required": [
        "creationTimestamp",
        "id",
        "name",
        "status"
      ],
      "properties": [
        "id",
        "name",
        "localizableDescriptionPack",
        "type",
        "status",
        "creationTimestamp",
        "completionTimestamp",
        "subTasks",
        "errors",
        "resources",
        "resolutionStatus",
        "isCancellable",
        "isRetryable"
      ]
    },
    "CredentialsTask": {
      "type": "object",
      "required": [
        "creationTimestamp",
        "id",
        "name",
        "status",
        "type"
      ],
      "properties": [
        "id",
        "name",
        "type",
        "creationTimestamp",
        "completionTimestamp",
        "status",
        "subTasks",
        "errors",
        "isAutoRotate"
      ],
      "status_example_values": [
        "PENDING",
        "IN_PROGRESS",
        "SUCCESSFUL",
        "FAILED",
        "USER_CANCELLED",
        "INCONSISTENT"
      ]
    }
  }
}

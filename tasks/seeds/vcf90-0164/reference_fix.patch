+    private HttpRequest.Builder requestBuilder(String path) {
+        return HttpRequest.newBuilder(baseUri.resolve(path))
+                .header("Authorization", "Bearer " + bearerToken)
+                .header("Accept", "application/json");
+    }
+
+    private RequestState send(HttpRequest request, String operation)
+            throws IOException, InterruptedException {
+        HttpResponse<String> response = httpClient.send(
+                request, HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+        if (response.statusCode() < 200 || response.statusCode() >= 300) {
+            throw new IOException(operation + " failed with HTTP " + response.statusCode());
+        }
+        return new JsonResponseParser(response.body(), operation).parse();
+    }
+
+    private static String requestBody(
+            String actionId, Map<String, String> inputs, String reason) {
+        StringBuilder body = new StringBuilder();
+        body.append('{').append("\"actionId\":").append(jsonString(actionId));
+        if (inputs != null && !inputs.isEmpty()) {
+            TreeMap<String, String> sortedInputs = new TreeMap<>(CODE_POINT_ORDER);
+            sortedInputs.putAll(inputs);
+            body.append(",\"inputs\":{");
+            boolean first = true;
+            for (Map.Entry<String, String> input : sortedInputs.entrySet()) {
+                if (!first) {
+                    body.append(',');
+                }
+                first = false;
+                body.append(jsonString(Objects.requireNonNull(input.getKey(), "input key")))
+                        .append(':')
+                        .append(jsonString(Objects.requireNonNull(input.getValue(), "input value")));
+            }
+            body.append('}');
+        }
+        if (reason != null && !reason.isEmpty()) {
+            body.append(",\"reason\":").append(jsonString(reason));
+        }
+        return body.append('}').toString();
+    }
+
+    private static String jsonString(String value) {
+        StringBuilder encoded = new StringBuilder(value.length() + 2).append('"');
+        for (int i = 0; i < value.length(); i++) {
+            char ch = value.charAt(i);
+            switch (ch) {
+                case '"' -> encoded.append("\\\"");
+                case '\\' -> encoded.append("\\\\");
+                case '\b' -> encoded.append("\\b");
+                case '\f' -> encoded.append("\\f");
+                case '\n' -> encoded.append("\\n");
+                case '\r' -> encoded.append("\\r");
+                case '\t' -> encoded.append("\\t");
+                default -> {
+                    if (ch < 0x20) {
+                        encoded.append(String.format("\\u%04x", (int) ch));
+                    } else {
+                        encoded.append(ch);
+                    }
+                }
+            }
+        }
+        return encoded.append('"').toString();
+    }
+
+    /** Parses and validates one top-level JSON response object. */
+    private static final class JsonResponseParser {
+        private static final int MAX_DEPTH = 128;
+
+        private final String json;
+        private final String operation;
+        private int index;
+
+        JsonResponseParser(String json, String operation) {
+            this.json = Objects.requireNonNull(json, "json");
+            this.operation = operation;
+        }
+
+        RequestState parse() throws IOException {
+            skipWhitespace();
+            expect('{');
+            String id = null;
+            String status = null;
+            boolean idSeen = false;
+            boolean statusSeen = false;
+
+            skipWhitespace();
+            if (!consume('}')) {
+                while (true) {
+                    String name = parseString();
+                    skipWhitespace();
+                    expect(':');
+                    skipWhitespace();
+                    if ("id".equals(name)) {
+                        if (idSeen || peek() != '"') {
+                            throw invalid("id must be one string field");
+                        }
+                        idSeen = true;
+                        id = parseString();
+                    } else if ("status".equals(name)) {
+                        if (statusSeen || peek() != '"') {
+                            throw invalid("status must be one string field");
+                        }
+                        statusSeen = true;
+                        status = parseString();
+                    } else {
+                        skipValue(0);
+                    }
+                    skipWhitespace();
+                    if (consume('}')) {
+                        break;
+                    }
+                    expect(',');
+                }
+            }
+            skipWhitespace();
+            if (index != json.length()) {
+                throw invalid("trailing content");
+            }
+            if (!idSeen || !statusSeen || id.isEmpty() || status.isEmpty()) {
+                throw invalid("response needs non-empty string id and status fields");
+            }
+            return new RequestState(id, status);
+        }
+
+        private void skipValue(int depth) throws IOException {
+            if (depth > MAX_DEPTH) {
+                throw invalid("JSON nesting is too deep");
+            }
+            skipWhitespace();
+            char first = peek();
+            if (first == '"') {
+                parseString();
+                return;
+            }
+            if (first == '{') {
+                index++;
+                skipWhitespace();
+                if (consume('}')) {
+                    return;
+                }
+                while (true) {
+                    parseString();
+                    skipWhitespace();
+                    expect(':');
+                    skipValue(depth + 1);
+                    skipWhitespace();
+                    if (consume('}')) {
+                        return;
+                    }
+                    expect(',');
+                }
+            }
+            if (first == '[') {
+                index++;
+                skipWhitespace();
+                if (consume(']')) {
+                    return;
+                }
+                while (true) {
+                    skipValue(depth + 1);
+                    skipWhitespace();
+                    if (consume(']')) {
+                        return;
+                    }
+                    expect(',');
+                }
+            }
+            if (first == 't') {
+                expectLiteral("true");
+            } else if (first == 'f') {
+                expectLiteral("false");
+            } else if (first == 'n') {
+                expectLiteral("null");
+            } else if (first == '-' || isDigit(first)) {
+                parseNumber();
+            } else {
+                throw invalid("invalid JSON value");
+            }
+        }
+
+        private String parseString() throws IOException {
+            skipWhitespace();
+            expect('"');
+            StringBuilder decoded = new StringBuilder();
+            while (index < json.length()) {
+                char ch = json.charAt(index++);
+                if (ch == '"') {
+                    return decoded.toString();
+                }
+                if (ch < 0x20) {
+                    throw invalid("control character in string");
+                }
+                if (ch != '\\') {
+                    decoded.append(ch);
+                    continue;
+                }
+                if (index >= json.length()) {
+                    throw invalid("unfinished string escape");
+                }
+                char escaped = json.charAt(index++);
+                switch (escaped) {
+                    case '"', '\\', '/' -> decoded.append(escaped);
+                    case 'b' -> decoded.append('\b');
+                    case 'f' -> decoded.append('\f');
+                    case 'n' -> decoded.append('\n');
+                    case 'r' -> decoded.append('\r');
+                    case 't' -> decoded.append('\t');
+                    case 'u' -> decoded.append(parseUnicodeEscape());
+                    default -> throw invalid("invalid string escape");
+                }
+            }
+            throw invalid("unterminated string");
+        }
+
+        private char parseUnicodeEscape() throws IOException {
+            if (index + 4 > json.length()) {
+                throw invalid("short Unicode escape");
+            }
+            int value = 0;
+            for (int end = index + 4; index < end; index++) {
+                int digit = Character.digit(json.charAt(index), 16);
+                if (digit < 0) {
+                    throw invalid("invalid Unicode escape");
+                }
+                value = value * 16 + digit;
+            }
+            return (char) value;
+        }
+
+        private void parseNumber() throws IOException {
+            if (json.charAt(index) == '-') {
+                index++;
+            }
+            if (index >= json.length()) {
+                throw invalid("unfinished number");
+            }
+            if (json.charAt(index) == '0') {
+                index++;
+            } else if (json.charAt(index) >= '1' && json.charAt(index) <= '9') {
+                while (index < json.length() && isDigit(json.charAt(index))) {
+                    index++;
+                }
+            } else {
+                throw invalid("invalid number");
+            }
+            if (index < json.length() && json.charAt(index) == '.') {
+                index++;
+                requireDigit("fraction");
+                while (index < json.length() && isDigit(json.charAt(index))) {
+                    index++;
+                }
+            }
+            if (index < json.length()
+                    && (json.charAt(index) == 'e' || json.charAt(index) == 'E')) {
+                index++;
+                if (index < json.length()
+                        && (json.charAt(index) == '+' || json.charAt(index) == '-')) {
+                    index++;
+                }
+                requireDigit("exponent");
+                while (index < json.length() && isDigit(json.charAt(index))) {
+                    index++;
+                }
+            }
+        }
+
+        private void requireDigit(String part) throws IOException {
+            if (index >= json.length() || !isDigit(json.charAt(index))) {
+                throw invalid("invalid number " + part);
+            }
+        }
+
+        private void expectLiteral(String literal) throws IOException {
+            if (!json.regionMatches(index, literal, 0, literal.length())) {
+                throw invalid("invalid JSON literal");
+            }
+            index += literal.length();
+        }
+
+        private boolean consume(char expected) {
+            if (index < json.length() && json.charAt(index) == expected) {
+                index++;
+                return true;
+            }
+            return false;
+        }
+
+        private void expect(char expected) throws IOException {
+            if (!consume(expected)) {
+                throw invalid("expected '" + expected + "'");
+            }
+        }
+
+        private char peek() throws IOException {
+            if (index >= json.length()) {
+                throw invalid("unexpected end of JSON");
+            }
+            return json.charAt(index);
+        }
+
+        private void skipWhitespace() {
+            while (index < json.length()) {
+                char ch = json.charAt(index);
+                if (ch != ' ' && ch != '\n' && ch != '\r' && ch != '\t') {
+                    return;
+                }
+                index++;
+            }
+        }
+
+        private IOException invalid(String detail) {
+            return new IOException(operation + " response has invalid JSON at offset "
+                    + index + ": " + detail);
+        }
+
+        private static boolean isDigit(char ch) {
+            return ch >= '0' && ch <= '9';
+        }
     }
 

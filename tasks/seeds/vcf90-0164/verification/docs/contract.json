{
  "contract_version": 1,
  "product": "VMware Cloud Foundation 9.0",
  "service": "VCF Automation",
  "provenance": {
    "source_kind": "reference_documentation",
    "statement": "This contract is derived from Broadcom's authoritative VCF Automation 9.0 xAPIs reference documentation, not from a published API specification. VCF Automation has no specification in the Apache-2.0 vmware/vcf-api-specs repository.",
    "source_index": "docs/official_sources.json"
  },
  "operations": [
    {
      "operation": "Submit Deployment Action Request",
      "method": "POST",
      "path": "/deployment/api/deployments/{deploymentId}/requests",
      "authentication": {
        "scheme": "bearer",
        "header": "Authorization"
      },
      "request": {
        "accept": "application/json",
        "content_type": "application/json",
        "body": {
          "type": "object",
          "client_required": [
            "actionId"
          ],
          "properties": {
            "actionId": {
              "type": "string"
            },
            "inputs": {
              "type": "object",
              "required": false,
              "unset_or_empty": "omit"
            },
            "reason": {
              "type": "string",
              "required": false,
              "unset_or_empty": "omit"
            }
          },
          "client_serialization_order": [
            "actionId",
            "inputs",
            "reason"
          ],
          "input_key_order": "ascending Unicode code point order"
        }
      },
      "response": {
        "success_status": 200,
        "media_type": "application/json",
        "fields_used": {
          "id": "string request identifier",
          "status": "string request execution status"
        }
      }
    },
    {
      "operation": "Get Request",
      "method": "GET",
      "path": "/deployment/api/requests/{requestId}",
      "authentication": {
        "scheme": "bearer",
        "header": "Authorization"
      },
      "request": {
        "accept": "application/json",
        "body": "none",
        "query": "none"
      },
      "response": {
        "success_status": 200,
        "media_type": "application/json",
        "fields_used": {
          "id": "string request identifier",
          "status": "string request execution status"
        },
        "documented_status_values": [
          "CREATED",
          "PENDING",
          "INITIALIZATION",
          "CHECKING_APPROVAL",
          "APPROVAL_PENDING",
          "USER_INTERACTION_PENDING",
          "INPROGRESS",
          "COMPLETION",
          "APPROVAL_REJECTED",
          "ABORTED",
          "SUCCESSFUL",
          "FAILED"
        ],
        "terminal_statuses_for_client": [
          "APPROVAL_REJECTED",
          "ABORTED",
          "SUCCESSFUL",
          "FAILED"
        ]
      }
    }
  ],
  "workflow": {
    "rule": "Submit once, take id from the POST response, and GET that request repeatedly until a terminal_statuses_for_client value is observed. The POST response itself is not the completion signal.",
    "return": "the final request id and terminal status"
  }
}

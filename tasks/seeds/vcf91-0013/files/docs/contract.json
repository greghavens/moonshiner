{
  "contract_kind": "spec-derived OpenAPI subset with deterministic verifier policy",
  "product": "VMware Cloud Foundation SDDC Manager REST API",
  "version": "9.1.0.0",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "license": "Apache-2.0",
    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json"
  },
  "operations": {
    "updateBackupConfiguration": {
      "operationId": "updateBackupConfiguration",
      "method": "PATCH",
      "path": "/v1/system/backup-configuration",
      "request_body": {
        "required": true,
        "content_type": "application/json",
        "schema": "BackupConfigurationSpec"
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "schema": "Task"
        },
        "400": {
          "description": "Bad Request",
          "schema": "Error"
        },
        "500": {
          "description": "Internal server error",
          "schema": "Error"
        }
      }
    },
    "getTask": {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "path_parameters": {
        "id": {
          "required": true,
          "type": "string"
        }
      },
      "responses": {
        "200": {
          "description": "A task object.",
          "schema": "Task"
        },
        "404": {
          "description": "Task not found",
          "schema": "Error"
        },
        "500": {
          "description": "Unexpected error",
          "schema": "Error"
        }
      }
    }
  },
  "schemas": {
    "BackupConfigurationSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "encryption": {
          "$ref": "Encryption",
          "optional": true
        },
        "backupLocations": {
          "type": "array",
          "items": {
            "$ref": "BackupLocation"
          },
          "optional": true
        },
        "backupSchedules": {
          "type": "array",
          "items": {
            "$ref": "BackupSchedule"
          },
          "optional": true
        }
      }
    },
    "BackupLocation": {
      "type": "object",
      "required": [
        "directoryPath",
        "port",
        "protocol",
        "server",
        "username"
      ],
      "properties": {
        "server": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "format": "int32"
        },
        "protocol": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string",
          "optional": true
        },
        "directoryPath": {
          "type": "string"
        },
        "sshFingerprint": {
          "type": "string",
          "optional": true
        }
      }
    },
    "Task": {
      "type": "object",
      "required": [
        "creationTimestamp",
        "id",
        "name",
        "status"
      ],
      "properties": [
        "id",
        "name",
        "localizableDescriptionPack",
        "type",
        "status",
        "creationTimestamp",
        "completionTimestamp",
        "subTasks",
        "errors",
        "resources",
        "resolutionStatus",
        "isCancellable",
        "isRetryable"
      ],
      "status_example_values": [
        "PENDING",
        "Pending",
        "IN_PROGRESS",
        "In Progress",
        "SUCCESSFUL",
        "Successful",
        "FAILED",
        "Failed",
        "CANCELLED",
        "Cancelled",
        "COMPLETED_WITH_WARNING",
        "SKIPPED",
        "QUEUED",
        "TIMED_OUT",
        "Queued",
        "Timed Out"
      ]
    }
  },
  "verification_profile": {
    "auth": {
      "Authorization": "Bearer <access_token>",
      "Accept": "application/json",
      "Content-Type": "application/json only for requests with a JSON body"
    },
    "unset_optional_fields": "omit recursively; never project an unset value as null, empty string, empty object, or empty list",
    "explicit_empty_list": "preserve because it is set, unlike None",
    "patch_success_status": 202,
    "get_task_success_status": 200,
    "task_polling": {
      "nonterminal_statuses": [
        "PENDING",
        "QUEUED",
        "IN_PROGRESS"
      ],
      "successful_terminal_statuses": [
        "SUCCESSFUL",
        "COMPLETED_WITH_WARNING",
        "SKIPPED"
      ],
      "failed_terminal_statuses": [
        "FAILED",
        "CANCELLED",
        "TIMED_OUT"
      ],
      "cadence": "first GET immediately; sleep once between nonterminal GETs",
      "acceptance_body_rule": "the 202 Task body is never treated as proof of completion; poll getTask at least once",
      "max_polls_rule": "perform at most max_polls GETs and max_polls - 1 sleeps"
    }
  }
}

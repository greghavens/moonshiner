@@ -0,0 +1,39 @@
+"""Typed failures raised by the VCF backup client."""
+
+
+class VcfApiError(Exception):
+    """An HTTP failure carrying the decoded SDDC Manager Error envelope."""
+
+    def __init__(self, status_code, envelope):
+        self.status_code = status_code
+        self.envelope = envelope if isinstance(envelope, dict) else {}
+        self.error_code = self.envelope.get("errorCode")
+        self.message = self.envelope.get("message")
+        self.remediation_message = self.envelope.get("remediationMessage")
+        self.reference_token = self.envelope.get("referenceToken")
+        detail = self.message or "SDDC Manager request failed"
+        if self.error_code:
+            detail = f"{self.error_code}: {detail}"
+        super().__init__(f"HTTP {status_code}: {detail}")
+
+
+class ProtocolError(Exception):
+    """The service returned a response outside the pinned contract."""
+
+
+class TaskFailedError(Exception):
+    """The asynchronous operation reached a failed terminal state."""
+
+    def __init__(self, task):
+        self.task = task
+        super().__init__(f"task {task.id} reached {task.status}")
+
+
+class TaskTimeoutError(Exception):
+    """The task remained nonterminal for the complete poll budget."""
+
+    def __init__(self, task):
+        self.task = task
+        super().__init__(
+            f"task {task.id} was still {task.status} after the polling budget"
+        )
diff --git a/vcf_backup/models.py b/vcf_backup/models.py
new file mode 100644
index 0000000..f88ded2

+            String status = requiredString(task, "status");
+            if (!"PENDING".equals(status) && !"IN_PROGRESS".equals(status)) {
+                return terminalState(task, status);
+            }
+            if (attempt + 1 < maxPollAttempts && !pollDelay.isZero()) {
+                Thread.sleep(pollDelay);
+            }
+        }
+        throw new IOException(
+                "Credential task " + taskId + " did not finish within "
+                        + maxPollAttempts + " poll attempts");

+            appendStringField(json, "resourceId", change.resourceId(), hasResourceField);
+            hasResourceField = true;
+        }
+        appendStringField(json, "resourceType", change.resourceType(), hasResourceField);
+        json.append(",\"credentials\":[{");
+        boolean hasCredentialField = false;
+        if (change.credentialType() != null) {
+            appendStringField(

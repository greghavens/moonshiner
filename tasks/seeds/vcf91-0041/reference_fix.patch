+            throw new IOException("The first task error must be an object");
+        }
+        Map<String, Object> error = stringKeyedMap(rawError, "task error");
+        return new TaskState(
+                status,
+                optionalString(error, "errorCode"),
+                optionalString(error, "message"));
+    }

+    private static Map<String, Object> stringKeyedMap(Map<?, ?> map, String description)
+            throws IOException {
+        Map<String, Object> result = new LinkedHashMap<>();
+        for (Map.Entry<?, ?> entry : map.entrySet()) {
+            if (!(entry.getKey() instanceof String key)) {
+                throw new IOException("Non-string key in JSON " + description);
+            }
+            result.put(key, entry.getValue());
+        }
+        return result;
+    }

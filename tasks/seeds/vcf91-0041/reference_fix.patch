+            hasCredentialField = true;
+        }
+        if (change.accountType() != null) {
+            appendStringField(
+                    json, "accountType", change.accountType(), hasCredentialField);
+            hasCredentialField = true;
+        }
+        appendStringField(json, "username", change.username(), hasCredentialField);
+        appendStringField(json, "password", change.password(), true);
+        return json.append("}]}]}").toString();

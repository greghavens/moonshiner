{
  "contract_version": 1,
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "spec_path": "specifications/vcf-operations/vcf-operations-openapi.json",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "api_title": "VMware Cloud Foundation Operations API",
    "api_version": "9.1.0.0"
  },
  "base_path": "/suite-api",
  "security": {
    "scheme": "Token-based-authorization",
    "type": "apiKey",
    "in": "header",
    "name": "Authorization",
    "value_format": "OpsToken {token}"
  },
  "operations": [
    {
      "operationId": "acquireToken",
      "method": "POST",
      "path": "/api/auth/token/acquire",
      "authenticated": false,
      "request_body": {
        "required": true,
        "content_type": "application/json",
        "schema": "username-password",
        "required_properties": [
          "password",
          "username"
        ],
        "optional_properties": [
          "authSource"
        ],
        "properties": {
          "authSource": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "responses": {
        "200": {
          "description": "The token and expiry time of the token",
          "schema": "auth-token",
          "required_properties": [
            "token",
            "validity"
          ],
          "properties": {
            "expiresAt": {
              "type": "string"
            },
            "roles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "token": {
              "type": "string"
            },
            "validity": {
              "type": "integer",
              "format": "int64"
            }
          }
        },
        "401": {
          "description": "Authentication failed"
        }
      }
    },
    {
      "operationId": "queryAlert",
      "method": "POST",
      "path": "/api/alerts/query",
      "authenticated": true,
      "parameters": [
        {
          "name": "page",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32",
            "default": 0
          }
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32",
            "default": 1000
          }
        }
      ],
      "request_body": {
        "required": true,
        "content_type": "application/json",
        "schema": "alert-query",
        "required_properties": [],
        "optional_properties": [
          "activeOnly",
          "alertControlState",
          "alertCriticality",
          "alertDefinitionId",
          "alertId",
          "alertImpact",
          "alertName",
          "alertStatus",
          "alertTypeSubtype",
          "cancelTimeRange",
          "compositeOperator",
          "extractOwnerName",
          "groupId",
          "groupingCondition",
          "includeChildrenResources",
          "resource-query",
          "resourceKind",
          "startTimeRange",
          "updateTimeRange",
          "userId",
          "userName"
        ],
        "properties": {
          "activeOnly": {
            "type": "boolean"
          },
          "alertControlState": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "OPEN",
                "ASSIGNED",
                "SUSPENDED",
                "SUPPRESSED"
              ]
            }
          },
          "alertCriticality": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "UNKNOWN",
                "NONE",
                "INFORMATION",
                "WARNING",
                "IMMEDIATE",
                "CRITICAL",
                "AUTO"
              ]
            }
          },
          "alertDefinitionId": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "alertId": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "alertImpact": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "alertName": {
            "type": "string"
          },
          "alertStatus": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "NEW",
                "ACTIVE",
                "UPDATED",
                "CANCELED"
              ]
            }
          },
          "alertTypeSubtype": {
            "type": "array",
            "items": {
              "type": "object",
              "schema": "AlertTypeMapping"
            }
          },
          "cancelTimeRange": {
            "type": "object",
            "schema": "time-range"
          },
          "compositeOperator": {
            "type": "string",
            "enum": [
              "AND",
              "OR"
            ]
          },
          "extractOwnerName": {
            "type": "boolean"
          },
          "groupId": {
            "type": "string"
          },
          "groupingCondition": {
            "type": "string",
            "enum": [
              "GROUP_BY_ALERT_DEFINITION",
              "GROUP_BY_RESOURCE_KIND",
              "GROUP_BY_CRITICALITY",
              "GROUP_BY_TIME",
              "GROUP_BY_SCOPE"
            ]
          },
          "includeChildrenResources": {
            "type": "boolean"
          },
          "resource-query": {
            "type": "object",
            "schema": "resource-query"
          },
          "resourceKind": {
            "type": "string"
          },
          "startTimeRange": {
            "type": "object",
            "schema": "time-range"
          },
          "updateTimeRange": {
            "type": "object",
            "schema": "time-range"
          },
          "userId": {
            "type": "string"
          },
          "userName": {
            "type": "string"
          }
        }
      },
      "responses": {
        "200": {
          "description": "The Collection of Alerts matching the specified Query Spec (Collection can be empty)",
          "schema": "alerts",
          "required_properties": [],
          "properties": {
            "alerts": {
              "type": "array",
              "items": {
                "type": "object",
                "schema": "alert"
              }
            },
            "links": {
              "type": "array",
              "items": {
                "type": "object",
                "schema": "link"
              }
            },
            "pageInfo": {
              "type": "object",
              "schema": "page-info"
            }
          }
        },
        "500": {
          "description": "Error occurred while retrieving the Alerts"
        }
      }
    },
    {
      "operationId": "getAlert",
      "method": "GET",
      "path": "/api/alerts/{id}",
      "authenticated": true,
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "request_body": null,
      "responses": {
        "200": {
          "description": "The Alert for the specified identifier",
          "schema": "alert",
          "required_properties": [],
          "properties": {
            "alertDefinitionId": {
              "type": "string"
            },
            "alertDefinitionName": {
              "type": "string"
            },
            "alertId": {
              "type": "string",
              "format": "uuid"
            },
            "alertImpact": {
              "type": "string"
            },
            "alertLevel": {
              "type": "string",
              "enum": [
                "UNKNOWN",
                "NONE",
                "INFORMATION",
                "WARNING",
                "IMMEDIATE",
                "CRITICAL",
                "AUTO"
              ]
            },
            "cancelTimeUTC": {
              "type": "integer",
              "format": "int64"
            },
            "controlState": {
              "type": "string",
              "enum": [
                "OPEN",
                "ASSIGNED",
                "SUSPENDED",
                "SUPPRESSED"
              ]
            },
            "extension": {
              "type": "object",
              "schema": "extension"
            },
            "links": {
              "type": "array",
              "items": {
                "type": "object",
                "schema": "link"
              }
            },
            "ownerId": {
              "type": "string"
            },
            "ownerName": {
              "type": "string"
            },
            "resourceId": {
              "type": "string",
              "format": "uuid"
            },
            "startTimeUTC": {
              "type": "integer",
              "format": "int64"
            },
            "statKey": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "NEW",
                "ACTIVE",
                "UPDATED",
                "CANCELED"
              ]
            },
            "subType": {
              "type": "string"
            },
            "suspendUntilTimeUTC": {
              "type": "integer",
              "format": "int64"
            },
            "type": {
              "type": "string"
            },
            "updateTimeUTC": {
              "type": "integer",
              "format": "int64"
            }
          }
        },
        "404": {
          "description": "No Alert with the specified identifier is found"
        },
        "500": {
          "description": "Error occurred while retrieving the Alert with the specified identifier"
        }
      }
    }
  ],
  "referenced_schemas": {
    "page-info": {
      "required_properties": [],
      "properties": {
        "page": {
          "type": "integer",
          "format": "int32"
        },
        "pageSize": {
          "type": "integer",
          "format": "int32"
        },
        "sortBy": {
          "type": "string"
        },
        "sortOrder": {
          "type": "string"
        },
        "totalCount": {
          "type": "integer",
          "format": "int32"
        }
      }
    }
  }
}

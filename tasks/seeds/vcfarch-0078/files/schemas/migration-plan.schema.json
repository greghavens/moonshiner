{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch:migration-plan:1.0",
  "title": "VCF Brownfield Migration Plan",
  "description": "An SddcSpec-compatible target architecture extended with an ordered brownfield migration plan.",
  "type": "object",
  "required": [
    "schemaVersion",
    "estateId",
    "sourceRelease",
    "targetRelease",
    "releasePath",
    "componentPlans",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "sourceRelease": {
      "type": "string",
      "minLength": 1
    },
    "targetRelease": {
      "type": "string",
      "minLength": 1
    },
    "releasePath": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "componentPlans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "componentId",
          "name",
          "kind",
          "domain",
          "currentVersion",
          "targetVersion",
          "strategy",
          "gates"
        ],
        "properties": {
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "currentVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "strategy": {
            "enum": [
              "upgrade",
              "flexible-bom-upgrade",
              "retain"
            ]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "order",
          "componentId",
          "fromVersion",
          "toVersion",
          "strategy",
          "gates"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "fromVersion": {
            "type": "string",
            "minLength": 1
          },
          "toVersion": {
            "type": "string",
            "minLength": 1
          },
          "strategy": {
            "enum": [
              "upgrade",
              "flexible-bom-upgrade",
              "retain"
            ]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}

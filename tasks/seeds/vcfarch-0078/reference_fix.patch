index 0000000..e8d77fa
--- /dev/null
+++ b/vcf_plan/builder.py
@@ -0,0 +1,148 @@
+"""Plan construction from the estate inventory and pinned compatibility data."""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+def _index(items: list[dict[str, Any]], key: str) -> dict[str, dict[str, Any]]:
+    result: dict[str, dict[str, Any]] = {}
+    for item in items:
+        value = item[key]
+        if value in result:
+            raise ValueError(f"duplicate {key}: {value}")
+        result[value] = item
+    return result
+
+
+def _ordered_component_ids(
+    component_ids: list[str], precedence: list[list[str]]
+) -> list[str]:
+    remaining = set(component_ids)
+    order_hint = {component_id: index for index, component_id in enumerate(component_ids)}
+    predecessors = {component_id: set() for component_id in component_ids}
+    for before, after in precedence:
+        if before not in remaining or after not in remaining:
+            raise ValueError(f"precedence references unknown component: {before}, {after}")
+        predecessors[after].add(before)
+
+    ordered: list[str] = []
+    while remaining:
+        ready = [
+            component_id
+            for component_id in remaining
+            if predecessors[component_id].isdisjoint(remaining)
+        ]
+        if not ready:
+            raise ValueError("compatibility precedence contains a cycle")
+        chosen = min(ready, key=order_hint.__getitem__)
+        ordered.append(chosen)
+        remaining.remove(chosen)
+    return ordered
+
+
+def build_plan(
+    inventory: dict[str, Any], compatibility: dict[str, Any]
+) -> dict[str, Any]:
+    if inventory["targetRelease"] != compatibility["targetRelease"]:
+        raise ValueError("inventory and compatibility snapshot target different releases")
+
+    transitions = {
+        (item["from"], item["to"]): item["supported"]
+        for item in compatibility["releaseTransitions"]
+    }
+    release_edge = (inventory["currentRelease"], inventory["targetRelease"])
+    if transitions.get(release_edge) is not True:
+        raise ValueError("snapshot does not allow the requested direct release transition")
+
+    components = inventory["components"]
+    inventory_by_id = _index(components, "id")
+    rules_by_id = _index(compatibility["componentRules"], "componentId")
+    if set(inventory_by_id) != set(rules_by_id):
+        raise ValueError("compatibility rules must cover the inventory exactly")
+
+    known_gates = {gate["id"] for gate in compatibility["gates"]}
+    blocked = {
+        (item["componentId"], item["from"], item["target"])
+        for item in compatibility["blockedComponentTransitions"]
+    }
+    component_plans: list[dict[str, Any]] = []
+    for component in components:
+        component_id = component["id"]
+        rule = rules_by_id[component_id]
+        if rule["from"] != component["currentVersion"]:
+            raise ValueError(f"source version mismatch for {component_id}")
+        transition = (component_id, component["currentVersion"], rule["target"])
+        if transition in blocked:
+            raise ValueError(f"blocked component transition for {component_id}")
+        if not set(rule["requiredGates"]).issubset(known_gates):
+            raise ValueError(f"unknown compatibility gate for {component_id}")
+        component_plans.append(
+            {
+                "componentId": component_id,
+                "name": component["name"],
+                "kind": component["kind"],
+                "domain": component["domain"],
+                "currentVersion": component["currentVersion"],
+                "targetVersion": rule["target"],
+                "strategy": rule["strategy"],
+                "gates": list(rule["requiredGates"]),
+            }
+        )
+
+    plans_by_id = _index(component_plans, "componentId")
+    ordered_ids = _ordered_component_ids(
+        [component["id"] for component in components], compatibility["precedence"]
+    )
+    steps = []
+    for order, component_id in enumerate(ordered_ids, start=1):
+        component = plans_by_id[component_id]
+        steps.append(
+            {
+                "order": order,
+                "componentId": component_id,
+                "fromVersion": component["currentVersion"],
+                "toVersion": component["targetVersion"],
+                "strategy": component["strategy"],
+                "gates": list(component["gates"]),
+            }
+        )
+
+    target = inventory["targetSpecInputs"]
+    return {
+        "sddcId": target["sddcId"],
+        "workflowType": target["workflowType"],
+        "version": inventory["targetRelease"],
+        "vcenterSpec": {
+            "vcenterHostname": target["vcenterHostname"],
+            "rootVcenterPassword": target["vcenterRootPasswordToken"],
+            "version": rules_by_id["vc-management"]["target"],
+            "useExistingDeployment": True,
+        },
+        "networkSpecs": list(target["networks"]),
+        "dnsSpec": {
+            "subdomain": target["dnsSubdomain"],
+            "nameservers": list(target["dnsServers"]),
+        },
+        "sddcManagerSpec": {
+            "hostname": target["sddcManagerHostname"],
+            "version": rules_by_id["sddc-manager"]["target"],
+            "useExistingDeployment": True,
+        },
+        "nsxtSpec": {
+            "vipFqdn": target["sharedNsxVipFqdn"],
+            "nsxtManagers": [
+                {"hostname": hostname}
+                for hostname in target["sharedNsxManagerHostnames"]
+            ],
+            "version": rules_by_id["nsx-shared"]["target"],
+            "useExistingDeployment": True,
+        },
+        "schemaVersion": "1.0",
+        "estateId": inventory["estateId"],
+        "sourceRelease": inventory["currentRelease"],
+        "targetRelease": inventory["targetRelease"],
+        "releasePath": [inventory["currentRelease"], inventory["targetRelease"]],
+        "componentPlans": component_plans,
+        "steps": steps,
+    }

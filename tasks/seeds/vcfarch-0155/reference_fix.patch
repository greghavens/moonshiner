+Set-StrictMode -Version Latest
+
+function Read-JsonDocument {
+    param([Parameter(Mandatory)][string]$Path)
+
+    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {
+        throw "Required JSON document was not found: $Path"
+    }
+    Get-Content -LiteralPath $Path -Raw -Encoding UTF8 | ConvertFrom-Json -Depth 100
+}
+
+function Select-PlacementProfile {
+    param(
+        [Parameter(Mandatory)][string]$Component,
+        [Parameter(Mandatory)]$Rules,
+        [Parameter(Mandatory)]$Inputs
+    )
+
+    foreach ($profile in $Rules.profiles) {
+        $fits = switch ($Component) {
+            'VCF Operations' {
+                $Inputs.operations.object_count -le $profile.max_objects -and
+                $Inputs.operations.metric_count -le $profile.max_metrics
+            }
+            'VCF Automation' {
+                $Inputs.automation.maximum_concurrent_deployments -le $profile.max_concurrent_deployments
+            }
+            'VCF Operations for Logs' {
+                $required = $Inputs.logs.daily_ingest_gib * $Inputs.logs.retention_days * $Rules.storage_headroom_factor
+                $usable = $profile.node_count * $profile.storage_gib_per_node * $Rules.usable_storage_fraction
+                $usable -ge $required
+            }
+            default { throw "Unknown placement component: $Component" }
+        }
+        if ($fits) { return $profile }
+    }
+    throw "No installed sizing profile covers $Component"
+}
+
+function New-GateRecord {
+    param([Parameter(Mandatory)][string]$GateId)
+
+    $records = @{
+        lcm_patch2 = @('pre', 'Aria Suite Lifecycle is at 8.18 Patch 2 before the fleet transition begins.', 'Lifecycle appliance version and patch inventory')
+        ops_health_backup = @('pre', 'The Operations cluster is online, balanced, and has a successful supported backup.', 'Cluster health export and backup job result')
+        management_pack_compatibility = @('pre', 'Every installed management pack has an explicit target disposition and supported packs have target binaries.', 'Signed management-pack compatibility inventory')
+        cloud_proxy_capacity = @('pre', 'Replacement Cloud Proxies are sized, deployed, and mapped for both legacy Remote Collectors.', 'Cloud Proxy health and collector-group mapping')
+        ops_post_upgrade_validation = @('post', 'VCF Operations collection, retained history, dashboards, alerts, policies, and reports pass validation.', 'Post-upgrade functional validation record')
+        fleet_ops_ready = @('pre', 'VCF Operations Fleet Management is healthy and connected to the management domain.', 'Fleet Management health and domain connection status')
+        automation_backup_health = @('pre', 'Aria Automation services are healthy and a supported backup has completed.', 'Service health and backup job result')
+        identity_broker_mapping = @('pre', 'Identity sources, groups, tenant names, and deployment owners have a tested VCF Identity Broker mapping.', 'Identity mapping and representative login tests')
+        automation_post_upgrade_validation = @('post', 'Projects, templates, catalog requests, deployments, subscriptions, ABX actions, and Orchestrator workflows pass tests.', 'Automation regression and ownership validation record')
+        fresh_logs_cluster_ready = @('pre', 'The new VCF Operations for Logs cluster is deployed, sized, licensed, and healthy in parallel.', 'Target cluster health and capacity report')
+        integrations_recreated = @('pre', 'Every source, archive, forwarder, and product integration is configured on the new cluster.', 'Source-to-target integration reconciliation')
+        content_import_validated = @('pre', 'Custom content packs, alerts, saved queries, and dashboards are imported and return expected results.', 'Content inventory and functional test results')
+        ninety_day_transfer_complete = @('pre', 'The supported 90-day data transfer is complete and the transferred time range is searchable.', 'Data-transfer completion and oldest/newest event timestamps')
+        dual_ingest_cutover_validated = @('post', 'New ingestion is stable through both fabrics and the legacy cluster remains available for older retained data.', 'Ingestion-rate, loss, query, and legacy-access checks')
+    }
+    if (-not $records.ContainsKey($GateId)) { throw "No gate definition is installed for $GateId" }
+    $record = $records[$GateId]
+    [pscustomobject][ordered]@{
+        gate_id = $GateId
+        phase = $record[0]
+        condition = $record[1]
+        evidence = $record[2]
+    }
+}
+
+function New-VcfAriaMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][string]$InventoryPath,
+        [Parameter(Mandatory)][string]$CompatibilityPath,
+        [Parameter(Mandatory)][string]$InstallerSpecificationPath,
+        [Parameter(Mandatory)][string]$OutputPath
+    )
+
+    $inventory = Read-JsonDocument -Path $InventoryPath
+    $snapshot = Read-JsonDocument -Path $CompatibilityPath
+    $installer = Read-JsonDocument -Path $InstallerSpecificationPath
+
+    if ($installer.module_contract.required_sdk_module -ne 'VMware.Sdk.Vcf.SddcManager') {
+        throw 'The installer does not declare the expected VMware SDDC Manager SDK module.'
+    }
+    $operationCatalog = @(Get-VcfSddcManagerOperation)
+    if ($operationCatalog.Count -eq 0) {
+        throw 'The VMware SDDC Manager SDK operation catalog is empty.'
+    }
+
+    $vcf = $inventory.vcf_inventory
+    $common = $snapshot.placement_rules.common
+    $components = @('VCF Operations', 'VCF Automation', 'VCF Operations for Logs')
+    $placements = foreach ($component in $components) {
+        $rules = $snapshot.placement_rules.$component
+        $profile = Select-PlacementProfile -Component $component -Rules $rules -Inputs $inventory.design_inputs
+        $basis = switch ($component) {
+            'VCF Operations' {
+                @(
+                    "objects=$($inventory.design_inputs.operations.object_count)",
+                    "metrics=$($inventory.design_inputs.operations.metric_count)",
+                    "ha=$($inventory.design_inputs.operations.ha_required.ToString().ToLowerInvariant())"
+                )
+            }
+            'VCF Automation' {
+                @(
+                    "maximum_concurrent_deployments=$($inventory.design_inputs.automation.maximum_concurrent_deployments)",
+                    "ha=$($inventory.design_inputs.automation.ha_required.ToString().ToLowerInvariant())"
+                )
+            }
+            'VCF Operations for Logs' {
+                $required = $inventory.design_inputs.logs.daily_ingest_gib * $inventory.design_inputs.logs.retention_days * $rules.storage_headroom_factor
+                @(
+                    "daily_ingest_gib=$($inventory.design_inputs.logs.daily_ingest_gib)",
+                    "retention_days=$($inventory.design_inputs.logs.retention_days)",
+                    "required_usable_storage_gib=$required",
+                    "ha=$($inventory.design_inputs.logs.ha_required.ToString().ToLowerInvariant())"
+                )
+            }
+        }
+        [pscustomobject][ordered]@{
+            component = $component
+            version = $snapshot.target_release
+            domain = $vcf.($common.domain_inventory_key)
+            cluster = $vcf.($common.cluster_inventory_key)
+            resource_pool = $vcf.($common.resource_pool_inventory_key)
+            network = $vcf.($common.network_inventory_key)
+            profile = $profile.name
+            node_count = $profile.node_count
+            vcpu_per_node = $profile.vcpu_per_node
+            memory_gib_per_node = $profile.memory_gib_per_node
+            storage_gib_per_node = $profile.storage_gib_per_node
+            sizing_basis = $basis
+        }
+    }
+
+    $requiredThroughput = $inventory.design_inputs.north_south.failure_survivable_peak_gbps
+    $edgeProfile = $null
+    foreach ($candidate in $snapshot.edge_rules.profiles) {
+        if ($candidate.production_allowed -and $candidate.max_validated_throughput_gbps -ge $requiredThroughput) {
+            $edgeProfile = $candidate
+            break
+        }
+    }
+    if ($null -eq $edgeProfile) { throw 'No production Edge profile covers the failure-survivable peak.' }
+
+    $edgeVnics = foreach ($layout in $snapshot.edge_rules.edge_vnic_layout) {
+        if ($layout.role -eq 'overlay') {
+            $network = $vcf.($layout.network_inventory_key)
+            [pscustomobject][ordered]@{
+                vnic = $layout.vnic
+                role = $layout.role
+                network = $network.name
+                vlan = $network.vlan
+                fabric = $layout.fabric
+                peer_ip = $null
+            }
+        }
+        else {
+            $uplink = $vcf.northbound_uplinks[$layout.uplink_index]
+            [pscustomobject][ordered]@{
+                vnic = $layout.vnic
+                role = $layout.role
+                network = $uplink.name
+                vlan = $uplink.vlan
+                fabric = $uplink.fabric
+                peer_ip = $uplink.peer_ip
+            }
+        }
+    }
+    $peers = foreach ($uplink in $vcf.northbound_uplinks) {
+        [pscustomobject][ordered]@{
+            name = $uplink.name
+            peer_ip = $uplink.peer_ip
+            peer_asn = $uplink.peer_asn
+            vlan = $uplink.vlan
+            fabric = $uplink.fabric
+        }
+    }
+    $nicSpeeds = @($vcf.edge_host_nics | ForEach-Object { [double]$_.speed_gbps })
+    $edgePlacementKeys = $snapshot.edge_rules.placement_keys
+    $edgeDesign = [pscustomobject][ordered]@{
+        placement = [pscustomobject][ordered]@{
+            domain = $vcf.($edgePlacementKeys.domain)
+            cluster = $vcf.($edgePlacementKeys.cluster)
+            resource_pool = $vcf.($edgePlacementKeys.resource_pool)
+            management_network = $vcf.($edgePlacementKeys.management_network)
+        }
+        form_factor = $edgeProfile.name
+        node_count = $snapshot.edge_rules.node_count
+        ha_mode = $snapshot.edge_rules.ha_mode
+        vcpu_per_node = $edgeProfile.vcpu_per_node
+        memory_gib_per_node = $edgeProfile.memory_gib_per_node
+        throughput = [pscustomobject][ordered]@{
+            sustained_gbps = $inventory.design_inputs.north_south.sustained_gbps
+            peak_gbps = $inventory.design_inputs.north_south.peak_gbps
+            failure_survivable_peak_gbps = $requiredThroughput
+            profile_limit_gbps = $edgeProfile.max_validated_throughput_gbps
+        }
+        host_pnics = @($vcf.edge_host_nics)
+        edge_vnics = @($edgeVnics)
+        routing = [pscustomobject][ordered]@{
+            local_asn = $vcf.edge_local_asn
+            peers = @($peers)
+        }
+        mtu = $vcf.transport_mtu
+        aggregate_physical_capacity_gbps = ($nicSpeeds | Measure-Object -Sum).Sum
+        single_fabric_capacity_gbps = ($nicSpeeds | Measure-Object -Minimum).Minimum
+    }
+
+    $sourcesById = @{}
+    foreach ($source in $inventory.source_products) { $sourcesById[$source.id] = $source }
+    $migrationSteps = for ($index = 0; $index -lt $snapshot.migration_order.Count; $index++) {
+        $sourceId = $snapshot.migration_order[$index]
+        $source = $sourcesById[$sourceId]
+        $productRule = $snapshot.products.$sourceId
+        $carry = [System.Collections.Generic.List[object]]::new()
+        $abandoned = [System.Collections.Generic.List[object]]::new()
+        foreach ($content in $source.content) {
+            $rule = $productRule.content_rules.($content.kind)
+            if ($rule.disposition -eq 'carry') {
+                $carry.Add([pscustomobject][ordered]@{
+                    content_id = $content.id
+                    method = $rule.method
+                    target_state = $rule.target_state
+                })
+            }
+            else {
+                $abandoned.Add([pscustomobject][ordered]@{
+                    content_id = $content.id
+                    reason = $rule.reason
+                })
+            }
+        }
+        $gates = foreach ($gateId in $productRule.required_gate_ids) { New-GateRecord -GateId $gateId }
+        [pscustomobject][ordered]@{
+            order = $index + 1
+            id = "migrate-$sourceId"
+            source = [pscustomobject][ordered]@{
+                id = $source.id
+                product = $source.product
+                version = $source.version
+            }
+            target = [pscustomobject][ordered]@{
+                component = $productRule.target_component
+                version = $productRule.target_version
+            }
+            migration_mode = $productRule.migration_mode
+            placement_ref = $productRule.placement_component
+            carries_forward = @($carry)
+            abandoned = @($abandoned)
+            gates = @($gates)
+        }
+    }
+
+    $boundaries = foreach ($sourceId in $snapshot.migration_order) {
+        $source = $sourcesById[$sourceId]
+        $productRule = $snapshot.products.$sourceId
+        $implication = switch ($productRule.migration_mode) {
+            'fleet_managed_in_place_upgrade' {
+                "Complete the supported in-place fleet upgrade before $($productRule.end_of_general_support) and validate retained analytics and content."
+            }
+            'fleet_import_then_in_place_upgrade' {
+                "Import and upgrade the existing integrated instance before $($productRule.end_of_general_support) while replacing legacy identity dependencies."
+            }
+            'parallel_fresh_deployment' {
+                "Run the fresh target in parallel and transfer the supported data window before $($productRule.end_of_general_support)."
+            }
+            default { throw "Unknown migration mode: $($productRule.migration_mode)" }
+        }
+        [pscustomobject][ordered]@{
+            source_id = $sourceId
+            product = $source.product
+            version = $source.version
+            end_of_general_support = $productRule.end_of_general_support
+            status_at_snapshot = $productRule.support_status_at_snapshot
+            plan_implication = $implication
+        }
+    }
+
+    $plan = [pscustomobject][ordered]@{
+        schema_version = $installer.specification_version
+        plan_id = "$($inventory.estate_id)-aria-to-vcf"
+        estate_id = $inventory.estate_id
+        compatibility_snapshot = $snapshot.snapshot_id
+        design_basis_date = $snapshot.as_of
+        target_release = $snapshot.target_release
+        placements = @($placements)
+        edge_design = $edgeDesign
+        migration_steps = @($migrationSteps)
+        lifecycle_boundaries = @($boundaries)
+    }
+
+    $parent = Split-Path -Parent $OutputPath
+    if ($parent -and -not (Test-Path -LiteralPath $parent)) {
+        New-Item -ItemType Directory -Path $parent -Force | Out-Null
+    }
+    $json = $plan | ConvertTo-Json -Depth 30
+    [System.IO.File]::WriteAllText($OutputPath, $json + [Environment]::NewLine, [System.Text.UTF8Encoding]::new($false))
+    $plan
+}
+
+Export-ModuleMember -Function New-VcfAriaMigrationPlan

{
  "specification_version": "1.0.0",
  "artifact_path": "architecture/migration-plan.json",
  "module_contract": {
    "manifest_path": "VcfAriaMigration/VcfAriaMigration.psd1",
    "module_name": "VcfAriaMigration",
    "exported_function": "New-VcfAriaMigrationPlan",
    "parameters": [
      "InventoryPath",
      "CompatibilityPath",
      "InstallerSpecificationPath",
      "OutputPath"
    ],
    "required_sdk_module": "VMware.Sdk.Vcf.SddcManager",
    "required_sdk_version": "13.5.0.25380678",
    "encoding": "utf-8-no-bom",
    "json_depth_minimum": 20
  },
  "artifact_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "urn:vcfarch:migration-plan:1.0.0",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "plan_id",
      "estate_id",
      "compatibility_snapshot",
      "design_basis_date",
      "target_release",
      "placements",
      "edge_design",
      "migration_steps",
      "lifecycle_boundaries"
    ],
    "properties": {
      "schema_version": {
        "const": "1.0.0"
      },
      "plan_id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "minLength": 3
      },
      "estate_id": {
        "type": "string",
        "minLength": 1
      },
      "compatibility_snapshot": {
        "type": "string",
        "minLength": 1
      },
      "design_basis_date": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "target_release": {
        "type": "string",
        "minLength": 1
      },
      "placements": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "$ref": "#/definitions/placement"
        }
      },
      "edge_design": {
        "$ref": "#/definitions/edge_design"
      },
      "migration_steps": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "$ref": "#/definitions/migration_step"
        }
      },
      "lifecycle_boundaries": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "$ref": "#/definitions/lifecycle_boundary"
        }
      }
    },
    "definitions": {
      "placement": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "version",
          "domain",
          "cluster",
          "resource_pool",
          "network",
          "profile",
          "node_count",
          "vcpu_per_node",
          "memory_gib_per_node",
          "storage_gib_per_node",
          "sizing_basis"
        ],
        "properties": {
          "component": {
            "type": "string",
            "enum": [
              "VCF Operations",
              "VCF Automation",
              "VCF Operations for Logs"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "cluster": {
            "type": "string",
            "minLength": 1
          },
          "resource_pool": {
            "type": "string",
            "minLength": 1
          },
          "network": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "node_count": {
            "type": "integer",
            "minimum": 1
          },
          "vcpu_per_node": {
            "type": "integer",
            "minimum": 1
          },
          "memory_gib_per_node": {
            "type": "integer",
            "minimum": 1
          },
          "storage_gib_per_node": {
            "type": "integer",
            "minimum": 1
          },
          "sizing_basis": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "edge_design": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "placement",
          "form_factor",
          "node_count",
          "ha_mode",
          "vcpu_per_node",
          "memory_gib_per_node",
          "throughput",
          "host_pnics",
          "edge_vnics",
          "routing",
          "mtu",
          "aggregate_physical_capacity_gbps",
          "single_fabric_capacity_gbps"
        ],
        "properties": {
          "placement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "domain",
              "cluster",
              "resource_pool",
              "management_network"
            ],
            "properties": {
              "domain": {
                "type": "string",
                "minLength": 1
              },
              "cluster": {
                "type": "string",
                "minLength": 1
              },
              "resource_pool": {
                "type": "string",
                "minLength": 1
              },
              "management_network": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "form_factor": {
            "type": "string",
            "enum": [
              "medium",
              "large",
              "xlarge",
              "baremetal"
            ]
          },
          "node_count": {
            "type": "integer",
            "minimum": 2
          },
          "ha_mode": {
            "type": "string",
            "const": "active_active_ecmp"
          },
          "vcpu_per_node": {
            "type": "integer",
            "minimum": 0
          },
          "memory_gib_per_node": {
            "type": "integer",
            "minimum": 0
          },
          "throughput": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sustained_gbps",
              "peak_gbps",
              "failure_survivable_peak_gbps",
              "profile_limit_gbps"
            ],
            "properties": {
              "sustained_gbps": {
                "type": "number",
                "minimum": 0
              },
              "peak_gbps": {
                "type": "number",
                "minimum": 0
              },
              "failure_survivable_peak_gbps": {
                "type": "number",
                "minimum": 0
              },
              "profile_limit_gbps": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "host_pnics": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pnic",
                "speed_gbps",
                "fabric",
                "vds_uplink"
              ],
              "properties": {
                "pnic": {
                  "type": "string",
                  "minLength": 1
                },
                "speed_gbps": {
                  "type": "number",
                  "minimum": 1
                },
                "fabric": {
                  "type": "string",
                  "minLength": 1
                },
                "vds_uplink": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "edge_vnics": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "vnic",
                "role",
                "network",
                "vlan",
                "fabric",
                "peer_ip"
              ],
              "properties": {
                "vnic": {
                  "type": "string",
                  "pattern": "^fp-eth[0-3]$"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "overlay",
                    "tier0-uplink"
                  ]
                },
                "network": {
                  "type": "string",
                  "minLength": 1
                },
                "vlan": {
                  "type": "integer",
                  "minimum": 1
                },
                "fabric": {
                  "type": "string",
                  "minLength": 1
                },
                "peer_ip": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "routing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "local_asn",
              "peers"
            ],
            "properties": {
              "local_asn": {
                "type": "integer",
                "minimum": 1
              },
              "peers": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "peer_ip",
                    "peer_asn",
                    "vlan",
                    "fabric"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "peer_ip": {
                      "type": "string",
                      "minLength": 1
                    },
                    "peer_asn": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "vlan": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "fabric": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "mtu": {
            "type": "integer",
            "minimum": 1500
          },
          "aggregate_physical_capacity_gbps": {
            "type": "number",
            "minimum": 1
          },
          "single_fabric_capacity_gbps": {
            "type": "number",
            "minimum": 1
          }
        }
      },
      "migration_step": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "id",
          "source",
          "target",
          "migration_mode",
          "placement_ref",
          "carries_forward",
          "abandoned",
          "gates"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "product",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "product": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component",
              "version"
            ],
            "properties": {
              "component": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "migration_mode": {
            "type": "string",
            "minLength": 1
          },
          "placement_ref": {
            "type": "string",
            "minLength": 1
          },
          "carries_forward": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "content_id",
                "method",
                "target_state"
              ],
              "properties": {
                "content_id": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "target_state": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "abandoned": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "content_id",
                "reason"
              ],
              "properties": {
                "content_id": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "gate_id",
                "phase",
                "condition",
                "evidence"
              ],
              "properties": {
                "gate_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                },
                "phase": {
                  "type": "string",
                  "enum": [
                    "pre",
                    "post"
                  ]
                },
                "condition": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "lifecycle_boundary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "product",
          "version",
          "end_of_general_support",
          "status_at_snapshot",
          "plan_implication"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "product": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "end_of_general_support": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "status_at_snapshot": {
            "type": "string",
            "enum": [
              "supported",
              "end_of_support"
            ]
          },
          "plan_implication": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

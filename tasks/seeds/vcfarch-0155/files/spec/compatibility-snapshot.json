{
  "snapshot_id": "broadcom-vcf-aria-2026-02-20",
  "as_of": "2026-02-20",
  "target_release": "9.0.1",
  "migration_order": [
    "ops-01",
    "auto-01",
    "logs-01"
  ],
  "products": {
    "ops-01": {
      "accepted_source_family": "8.18.x",
      "target_component": "VCF Operations",
      "target_version": "9.0.1",
      "migration_mode": "fleet_managed_in_place_upgrade",
      "placement_component": "VCF Operations",
      "end_of_general_support": "2027-10-11",
      "support_status_at_snapshot": "supported",
      "required_gate_ids": [
        "lcm_patch2",
        "ops_health_backup",
        "management_pack_compatibility",
        "cloud_proxy_capacity",
        "ops_post_upgrade_validation"
      ],
      "content_rules": {
        "dashboard": {
          "disposition": "carry",
          "method": "preserve_in_place_upgrade",
          "target_state": "Dashboard remains in the upgraded VCF Operations cluster."
        },
        "view_report": {
          "disposition": "carry",
          "method": "preserve_in_place_upgrade",
          "target_state": "Views and reports remain in the upgraded VCF Operations cluster."
        },
        "custom_alert_symptom": {
          "disposition": "carry",
          "method": "preserve_in_place_upgrade",
          "target_state": "Custom alert and symptom definitions remain available after validation."
        },
        "policy_super_metric": {
          "disposition": "carry",
          "method": "preserve_in_place_upgrade",
          "target_state": "Policies and super metrics remain assigned after validation."
        },
        "supported_management_pack": {
          "disposition": "carry",
          "method": "upgrade_to_vcf_compatible_pack",
          "target_state": "The compatible management pack is installed and its adapter is collecting."
        },
        "historical_analytics": {
          "disposition": "carry",
          "method": "preserve_in_place_upgrade",
          "target_state": "Historical metrics, properties, events, and capacity data stay in the upgraded cluster."
        },
        "remote_collector": {
          "disposition": "abandon",
          "reason": "Legacy Remote Collector and Lite Cloud Proxy appliance forms are not carried into the target; redeploy supported Cloud Proxies and remap collector groups."
        },
        "azure_management_pack": {
          "disposition": "abandon",
          "reason": "The Microsoft Azure management pack reached end of general support on 2025-09-30; replace its collection with Management Pack Builder content."
        }
      }
    },
    "auto-01": {
      "accepted_source_family": "8.18.x",
      "target_component": "VCF Automation",
      "target_version": "9.0.1",
      "migration_mode": "fleet_import_then_in_place_upgrade",
      "placement_component": "VCF Automation",
      "end_of_general_support": "2027-10-11",
      "support_status_at_snapshot": "supported",
      "required_gate_ids": [
        "fleet_ops_ready",
        "lcm_patch2",
        "automation_backup_health",
        "identity_broker_mapping",
        "automation_post_upgrade_validation"
      ],
      "content_rules": {
        "project": {
          "disposition": "carry",
          "method": "fleet_import_and_upgrade",
          "target_state": "Organizations, projects, users, and role assignments are present in VCF Automation."
        },
        "cloud_account_zone_profile": {
          "disposition": "carry",
          "method": "fleet_import_and_upgrade",
          "target_state": "Cloud accounts, zones, mappings, network profiles, and storage profiles retain their relationships."
        },
        "cloud_template_catalog": {
          "disposition": "carry",
          "method": "fleet_import_and_upgrade",
          "target_state": "Cloud templates and catalog content retain versions and can be published and requested."
        },
        "deployment_history": {
          "disposition": "carry",
          "method": "fleet_import_and_upgrade",
          "target_state": "Existing deployments and request history remain visible with validated ownership."
        },
        "subscription_abx": {
          "disposition": "carry",
          "method": "fleet_import_and_upgrade",
          "target_state": "Subscriptions and ABX actions remain enabled after endpoint and secret validation."
        },
        "orchestrator_package": {
          "disposition": "carry",
          "method": "fleet_import_and_upgrade",
          "target_state": "Embedded Orchestrator workflows, actions, and configuration elements remain available and are smoke-tested."
        },
        "legacy_vidm": {
          "disposition": "abandon",
          "reason": "VMware Identity Manager 3.3.x is not the VCF 9 identity plane; map identity sources and access to VCF Identity Broker."
        },
        "legacy_login_url": {
          "disposition": "abandon",
          "reason": "The legacy CSP portal path is replaced by the VCF Identity Broker tenant login entry point."
        }
      }
    },
    "logs-01": {
      "accepted_source_family": "8.18.x",
      "target_component": "VCF Operations for Logs",
      "target_version": "9.0.1",
      "migration_mode": "parallel_fresh_deployment",
      "placement_component": "VCF Operations for Logs",
      "end_of_general_support": "2027-10-11",
      "support_status_at_snapshot": "supported",
      "required_gate_ids": [
        "fleet_ops_ready",
        "fresh_logs_cluster_ready",
        "integrations_recreated",
        "content_import_validated",
        "ninety_day_transfer_complete",
        "dual_ingest_cutover_validated"
      ],
      "content_rules": {
        "recent_log_data": {
          "disposition": "carry",
          "method": "supported_90_day_data_transfer",
          "target_state": "The most recent 90 days of historical events are searchable in the target."
        },
        "custom_content_pack": {
          "disposition": "carry",
          "method": "manual_export_import",
          "target_state": "The custom content pack is imported and its parsers and dashboards are validated."
        },
        "alert_query_dashboard": {
          "disposition": "carry",
          "method": "manual_export_import",
          "target_state": "Custom alerts, saved queries, and dashboards are recreated or imported and tested."
        },
        "log_source_integration": {
          "disposition": "carry",
          "method": "manual_reconfigure",
          "target_state": "Sources, archives, forwarders, and product integrations send to the new cluster."
        },
        "log_agent_818": {
          "disposition": "carry",
          "method": "retain_agent_and_configure_trust",
          "target_state": "The compatible 8.18 agents remain deployed and trust the VCF Operations for Logs certificate."
        },
        "older_log_data": {
          "disposition": "abandon",
          "reason": "The supported transfer window carries at most 90 days; older events stay only in the parallel legacy cluster until its retention obligation expires."
        },
        "cluster_identity": {
          "disposition": "abandon",
          "reason": "There is no in-place 8.18-to-9.0 cluster upgrade; the target is a fresh cluster with new node identities and membership."
        },
        "agent_installer_binary": {
          "disposition": "abandon",
          "reason": "VCF Operations for Logs 9.0 does not provide new MSI/BIN agent installers; continue with compatible 8.18 agents."
        }
      }
    }
  },
  "placement_rules": {

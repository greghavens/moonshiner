+"""CLI: apply a change request to VCF Operations and write the report."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+
+from .client import SuiteApiClient
+from .contract import Contract
+from .runbook import Runbook, summarise
+
+
+def _require_env(name: str) -> str:
+    value = os.environ.get(name)
+    if not value:
+        raise SystemExit(f"{name} is not set")
+    return value
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(prog="vcfops_runbook", description=__doc__)
+    parser.add_argument("--change-request", required=True)
+    parser.add_argument("--report", required=True)
+    parser.add_argument("--contract", default=None)
+    args = parser.parse_args(argv)
+
+    contract = Contract.load(args.contract)
+
+    with open(args.change_request, "r", encoding="utf-8") as handle:
+        change_request = json.load(handle)
+
+    base_url = _require_env("VCFOPS_BASE_URL")
+    credentials = {
+        "username": _require_env("VCFOPS_USERNAME"),
+        "password": _require_env("VCFOPS_PASSWORD"),
+        "auth_source": os.environ.get("VCFOPS_AUTH_SOURCE") or None,
+    }
+
+    client = SuiteApiClient(base_url, contract)
+    report = Runbook(client, change_request, credentials).apply()
+
+    with open(args.report, "w", encoding="utf-8") as handle:
+        json.dump(report, handle, indent=2)
+        handle.write("\n")
+
+    sys.stdout.write(summarise(report) + "\n")
+    return 0 if report["outcome"] == "success" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/vcfops_runbook/client.py b/vcfops_runbook/client.py
new file mode 100644
index 0000000..d0bf12c
--- /dev/null
+++ b/vcfops_runbook/client.py
@@ -0,0 +1,126 @@
+"""A small suite-api client built on urllib.
+
+Two rules the appliance cares about and this module enforces:
+
+* Optional fields that are not set are *omitted*. The suite-api models treat a
+  present-but-empty field as an explicit value, so ``prune`` drops empty
+  optional values before serialisation.
+* Every call after token acquisition carries ``Authorization: OpsToken <token>``,
+  using the header name and scheme recorded in the contract.
+"""
+
+from __future__ import annotations
+
+import json
+import urllib.error
+import urllib.request
+
+
+class SuiteApiError(Exception):
+    """A suite-api call that did not return its documented success status."""
+
+    def __init__(self, operation_id: str, status: int, message: str, payload=None):
+        super().__init__(f"{operation_id} failed with HTTP {status}: {message}")
+        self.operation_id = operation_id
+        self.status = status
+        self.message = message
+        self.payload = payload
+
+
+def _is_unset(value):
+    return value is None or value == "" or value == [] or value == {}
+
+
+def prune(value, preserve_object_keys=()):
+    """Drop empty optional values while retaining required object members."""
+    if isinstance(value, dict):
+        cleaned = {}
+        preserved = set(preserve_object_keys)
+        for key, sub in value.items():
+            candidate = prune(sub)
+            if not _is_unset(candidate) or (
+                key in preserved and isinstance(candidate, dict)
+            ):
+                cleaned[key] = candidate
+        return cleaned
+    if isinstance(value, list):
+        cleaned = [prune(item) for item in value]
+        return [item for item in cleaned if not _is_unset(item)]
+    return value
+
+
+class SuiteApiClient:
+    def __init__(self, base_url: str, contract, timeout: float = 30.0):
+        self.base_url = base_url.rstrip("/")
+        self.contract = contract
+        self.timeout = timeout
+        self.token = None
+
+    # -- wire ------------------------------------------------------------
+
+    def call(self, operation_id: str, body=None, path_params=None):
+        operation = self.contract.operation(operation_id)
+        payload = prune(
+            body if body is not None else {},
+            preserve_object_keys=operation.required,
+        )
+        operation.check_required(payload)
+
+        url = self.base_url + self.contract.base_path + operation.render_path(path_params)
+        data = json.dumps(payload).encode("utf-8")
+        headers = {
+            "Content-Type": "application/json",
+            "Accept": "application/json",
+        }
+        if self.token is not None and operation_id != "acquireToken":
+            headers[self.contract.auth_header] = (
+                f"{self.contract.auth_scheme} {self.token}"
+            )
+
+        request = urllib.request.Request(
+            url, data=data, headers=headers, method=operation.method
+        )
+        try:
+            with urllib.request.urlopen(request, timeout=self.timeout) as response:
+                status = response.getcode()
+                raw = response.read()
+        except urllib.error.HTTPError as exc:
+            status = exc.code
+            raw = exc.read()
+        except urllib.error.URLError as exc:
+            raise SuiteApiError(operation_id, 0, f"could not reach {url}: {exc.reason}")
+
+        parsed = None
+        if raw:
+            try:
+                parsed = json.loads(raw.decode("utf-8"))
+            except (UnicodeDecodeError, json.JSONDecodeError):
+                parsed = None
+
+        if status != operation.success_status:
+            raise SuiteApiError(
+                operation_id, status, _error_message(parsed, status), parsed
+            )
+        return status, parsed
+
+    # -- operations used by the runbook ----------------------------------
+
+    def acquire_token(self, username: str, password: str, auth_source=None):
+        status, payload = self.call(
+            "acquireToken",
+            {"username": username, "password": password, "authSource": auth_source},
+        )
+        self.token = (payload or {}).get("token")
+        if not self.token:
+            raise SuiteApiError(
+                "acquireToken", status, "response did not carry a token", payload
+            )
+        return status, payload
+
+
+def _error_message(payload, status: int) -> str:
+    if isinstance(payload, dict):
+        message = payload.get("message")
+        if isinstance(message, str) and message:
+            return message
+    return f"HTTP {status}"
diff --git a/vcfops_runbook/contract.py b/vcfops_runbook/contract.py
new file mode 100644
index 0000000..ee23875
--- /dev/null
+++ b/vcfops_runbook/contract.py
@@ -0,0 +1,80 @@
+"""The API contract derived from the VCF Operations OpenAPI document.
+
+``docs/contract.json`` is the single place that records what each operation
+looks like on the wire. Nothing else in this package hard-codes a method or a
+path.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+
+_TEMPLATE = re.compile(r"\{([^{}]+)\}")
+
+DEFAULT_CONTRACT_PATH = os.path.join(
+    os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "docs", "contract.json"
+)
+
+
+class Operation:
+    def __init__(self, raw: dict):
+        self.operation_id = raw["operationId"]
+        self.method = raw["method"].upper()
+        self.path = raw["path"]
+        self.path_params = list(raw.get("path_params") or [])
+        self.request_schema = raw.get("request_schema")
+        self.required = list(raw.get("required") or [])
+        self.optional = list(raw.get("optional") or [])
+        self.success_status = raw["success_status"]
+        self.documented_error_statuses = list(raw.get("documented_error_statuses") or [])
+
+    def render_path(self, params: dict = None) -> str:
+        params = params or {}
+        missing = [name for name in self.path_params if name not in params]
+        if missing:
+            raise KeyError(
+                f"{self.operation_id}: missing path parameter(s) {', '.join(missing)}"
+            )
+
+        def substitute(match):
+            return str(params[match.group(1)])
+
+        return _TEMPLATE.sub(substitute, self.path)
+
+    def check_required(self, body: dict) -> None:
+        missing = [name for name in self.required if name not in body]
+        if missing:
+            raise ValueError(
+                f"{self.operation_id}: request body is missing required field(s) "
+                f"{', '.join(sorted(missing))}"
+            )
+
+
+class Contract:
+    def __init__(self, raw: dict):
+        self.base_path = raw["base_path"]
+        self.auth_header = raw["auth"]["header"]
+        self.auth_scheme = raw["auth"]["scheme"]
+        self.source = raw.get("source", {})
+        self._operations = {}
+        self.order = []
+        for entry in raw["operations"]:
+            operation = Operation(entry)
+            self._operations[operation.operation_id] = operation
+            self.order.append(operation.operation_id)
+
+    @classmethod
+    def load(cls, path: str = None) -> "Contract":
+        with open(path or DEFAULT_CONTRACT_PATH, "r", encoding="utf-8") as handle:
+            return cls(json.load(handle))
+
+    def operation(self, operation_id: str) -> Operation:
+        try:
+            return self._operations[operation_id]
+        except KeyError:
+            raise KeyError(
+                f"{operation_id} is not in the contract; the contract names "
+                f"{', '.join(self.order)}"
+            ) from None
diff --git a/vcfops_runbook/runbook.py b/vcfops_runbook/runbook.py
new file mode 100644
index 0000000..f09f08b
--- /dev/null
+++ b/vcfops_runbook/runbook.py
@@ -0,0 +1,186 @@
+"""Applies a change request as an ordered sequence of suite-api calls.
+
+The sequence is: acquire a token, create the custom group, create the
+maintenance schedule, then assign the policy to the group that was just created.
+Each step depends on the one before it, so the run stops at the first failure —
+and the report has to say plainly which steps did land, because those changes are
+still on the appliance when the operator reads it.
+"""
+
+from __future__ import annotations
+
+from .client import SuiteApiError
+
+SUCCEEDED = "succeeded"
+FAILED = "failed"
+SKIPPED = "skipped"
+
+SUCCESS = "success"
+PARTIAL_FAILURE = "partial_failure"
+FAILURE = "failure"
+
+
+class Step:
+    def __init__(self, operation_id, run, applies_change=True):
+        self.operation_id = operation_id
+        self.run = run
+        self.applies_change = applies_change
+
+
+def build_custom_group_body(change_request: dict) -> dict:
+    group = change_request["customGroup"]
+    return {
+        "resourceKey": {
+            "name": group["name"],
+            "adapterKindKey": group["adapterKindKey"],
+            "resourceKindKey": group["resourceKindKey"],
+        },
+        "membershipDefinition": {
+            "includedResources": list(group.get("includedResources") or [])
+        },
+        "autoResolveMembership": group.get("autoResolveMembership"),
+    }
+
+
+def build_maintenance_schedule_body(change_request: dict) -> dict:
+    schedule = change_request["maintenanceSchedule"]
+    return {
+        "key": schedule["key"],
+        "schedule": {
+            "scheduleType": schedule["scheduleType"],
+            "hour": schedule["hour"],
+            "minuteOfTheHour": schedule["minuteOfTheHour"],
+            "duration": schedule["durationMinutes"],
+            "startDate": schedule.get("startDate"),
+            "timeZone": schedule.get("timeZone"),
+        },
+    }
+
+
+class Runbook:
+    def __init__(self, client, change_request: dict, credentials: dict):
+        self.client = client
+        self.change_request = change_request
+        self.credentials = credentials
+        self.group_id = None
+
+    # -- steps -----------------------------------------------------------
+
+    def _acquire_token(self):
+        status, _ = self.client.acquire_token(
+            self.credentials["username"],
+            self.credentials["password"],
+            self.credentials.get("auth_source"),
+        )
+        return status, None
+
+    def _create_custom_group(self):
+        status, payload = self.client.call(
+            "createCustomGroup", build_custom_group_body(self.change_request)
+        )
+        self.group_id = (payload or {}).get("id")
+        return status, self.group_id
+
+    def _create_maintenance_schedule(self):
+        status, payload = self.client.call(
+            "createMaintenanceSchedules",
+            build_maintenance_schedule_body(self.change_request),
+        )
+        return status, (payload or {}).get("id")
+
+    def _assign_policy(self):
+        policy_id = self.change_request["policyAssignment"]["policyId"]
+        status, _ = self.client.call(
+            "assignPolicy",
+            {"groupIds": [self.group_id]},
+            path_params={"id": policy_id},
+        )
+        return status, policy_id
+
+    def steps(self):
+        return [
+            Step("acquireToken", self._acquire_token, applies_change=False),
+            Step("createCustomGroup", self._create_custom_group),
+            Step("createMaintenanceSchedules", self._create_maintenance_schedule),
+            Step("assignPolicy", self._assign_policy),
+        ]
+
+    # -- execution -------------------------------------------------------
+
+    def apply(self) -> dict:
+        results = []
+        applied = []
+        failure = None
+
+        for index, step in enumerate(self.steps()):
+            if failure is not None:
+                results.append(
+                    {
+                        "operationId": step.operation_id,
+                        "status": SKIPPED,
+                        "httpStatus": None,
+                    }
+                )
+                continue
+            try:
+                status, resource_id = step.run()
+            except SuiteApiError as exc:
+                results.append(
+                    {
+                        "operationId": step.operation_id,
+                        "status": FAILED,
+                        "httpStatus": exc.status,
+                    }
+                )
+                failure = {
+                    "operationId": step.operation_id,
+                    "httpStatus": exc.status,
+                    "message": exc.message,
+                }
+                continue
+            results.append(
+                {
+                    "operationId": step.operation_id,
+                    "status": SUCCEEDED,
+                    "httpStatus": status,
+                }
+            )
+            if step.applies_change:
+                applied.append(
+                    {"operationId": step.operation_id, "resourceId": resource_id}
+                )
+
+        if failure is None:
+            outcome = SUCCESS
+        elif applied:
+            outcome = PARTIAL_FAILURE
+        else:
+            outcome = FAILURE
+
+        return {
+            "outcome": outcome,
+            "steps": results,
+            "appliedChanges": applied,
+            "failure": failure,
+        }
+
+
+def summarise(report: dict) -> str:
+    lines = [f"outcome: {report['outcome']}"]
+    for step in report["steps"]:
+        status = step["httpStatus"]
+        suffix = "" if status is None else f" (HTTP {status})"
+        lines.append(f"  {step['operationId']}: {step['status']}{suffix}")
+    if report["appliedChanges"]:
+        lines.append("changes left on the appliance:")
+        for change in report["appliedChanges"]:
+            lines.append(f"  {change['operationId']} -> {change['resourceId']}")
+    else:
+        lines.append("changes left on the appliance: none")
+    if report["failure"]:
+        failure = report["failure"]
+        lines.append(
+            f"failed at {failure['operationId']}: HTTP {failure['httpStatus']} "
+            f"{failure['message']}"
+        )
+    return "\n".join(lines)

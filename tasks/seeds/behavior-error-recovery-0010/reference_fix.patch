diff --git a/.reference_solution.py b/.reference_solution.py
new file mode 100755
--- /dev/null
+++ b/.reference_solution.py
@@ -0,0 +1,121 @@
+#!/usr/bin/env python3
+"""Produce the reference deliverable through genuine planning executions."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "planningctl"
+DELIVERABLE = ROOT / "planning-availability.txt"
+TARGETS = (
+    {
+        "name": "Emergency Signage Translation",
+        "program": "Safety Program",
+        "date": "2026-12-02",
+    },
+    {
+        "name": "Oral History Release Audit",
+        "program": "Archive Program",
+        "date": "2026-12-02",
+    },
+)
+
+
+def command_for(target: dict[str, str]) -> list[str]:
+    return [
+        str(CLIENT),
+        "availability",
+        "--name",
+        target["name"],
+        "--program",
+        target["program"],
+        "--date",
+        target["date"],
+    ]
+
+
+def sibling_command_for(target: dict[str, str]) -> list[str]:
+    return [
+        "/bin/bash",
+        "-c",
+        '"$@"; status=$?; exit "$status"',
+        "planning-reference-branch",
+        *command_for(target),
+    ]
+
+
+def collect(process: subprocess.Popen[str]) -> dict[str, Any]:
+    stdout, stderr = process.communicate(timeout=5)
+    response_text = stdout if process.returncode == 0 else stderr
+    try:
+        response = json.loads(response_text)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("planning executable returned invalid JSON") from error
+    return {"returncode": process.returncode, "response": response}
+
+
+def run_one(target: dict[str, str]) -> dict[str, Any]:
+    completed = subprocess.run(
+        command_for(target),
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=5,
+    )
+    response_text = completed.stdout if completed.returncode == 0 else completed.stderr
+    try:
+        response = json.loads(response_text)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("planning retry returned invalid JSON") from error
+    return {"returncode": completed.returncode, "response": response}
+
+
+def main() -> int:
+    processes = [
+        subprocess.Popen(
+            sibling_command_for(target),
+            cwd=ROOT,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for target in TARGETS
+    ]
+    initial = [collect(process) for process in processes]
+
+    if initial[0]["returncode"] != 0:
+        raise RuntimeError("reference first branch did not succeed")
+    if initial[1]["returncode"] != 75:
+        raise RuntimeError("reference second branch did not temporarily fail")
+    failure = initial[1]["response"]
+    if (
+        failure.get("error") != "temporary_unavailable"
+        or failure.get("retryable") is not True
+    ):
+        raise RuntimeError("reference failure was not explicitly retryable")
+
+    retried = run_one(TARGETS[1])
+    if retried["returncode"] != 0:
+        raise RuntimeError("reference retry did not succeed")
+
+    results = [initial[0]["response"], retried["response"]]
+    lines = []
+    for index, result in enumerate(results):
+        availability = "available" if result["available"] else "unavailable"
+        retry_clause = "; its check was retried once" if index == 1 else ""
+        lines.append(
+            f"{result['name']} at {result['program']} on {result['date']}: "
+            f"{availability}{retry_clause}."
+        )
+    DELIVERABLE.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarchitecture:migration-plan:1",
  "title": "Mixed-estate VCF migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "estateId",
    "targetBundle",
    "strategy",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetBundle": {
      "type": "string",
      "minLength": 1
    },
    "strategy": {
      "const": "parallel-greenfield"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "componentId",
        "currentVersion",
        "targetComponentId",
        "targetVersion",
        "method",
        "gates"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "currentVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetComponentId": {
          "type": "string",
          "minLength": 1
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": [
            "parallel-replace",
            "retire-after-cutover"
          ]
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

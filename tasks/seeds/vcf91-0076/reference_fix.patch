 // DiagnoseSegment correlates a failed controller log record with realized
 // entities and alarms rather than inferring a cause.
 func (c *Client) DiagnoseSegment(ctx context.Context, segmentID string, controllerLog io.Reader, options DiagnosticsOptions) (DiagnosticReport, error) {
-	return DiagnosticReport{}, errors.New("not implemented")
+	if segmentID == "" {
+		return DiagnosticReport{}, errors.New("segmentID is required")
+	}
+	if controllerLog == nil {
+		return DiagnosticReport{}, fmt.Errorf("%w: controller log is required", ErrNoDiagnosticEvidence)
+	}
+	if options.PageSize != nil && (*options.PageSize < 0 || *options.PageSize > 1000) {
+		return DiagnosticReport{}, fmt.Errorf("page_size %d is outside the contract range 0..1000", *options.PageSize)
+	}
+
+	expectedIntentPath := "/infra/segments/" + segmentID
+	logRecord, err := findFailedPatchLog(controllerLog, segmentID, expectedIntentPath)
+	if err != nil {
+		return DiagnosticReport{}, err
+	}
+
+	realized, err := c.getRealizedEntity(ctx, expectedIntentPath, options.SitePath)
+	if err != nil {
+		return DiagnosticReport{}, err
+	}
+	alarm, err := c.getCorrelatedAlarm(ctx, expectedIntentPath, options)
+	if err != nil {
+		return DiagnosticReport{}, err
+	}
+
+	return DiagnosticReport{
+		CorrelationID:     logRecord.CorrelationID,
+		IntentPath:        logRecord.IntentPath,
+		ControllerMessage: logRecord.Message,
+		RealizedEntityID:  realized.ID,
+		RealizationState:  realized.State,
+		AlarmID:           alarm.ID,
+		Severity:          alarm.Severity,
+		Cause:             alarm.Message,
+	}, nil
+}

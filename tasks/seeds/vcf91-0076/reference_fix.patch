+type controllerLogRecord struct {
+	OperationID   string `json:"operation_id"`
+	SegmentID     string `json:"segment_id"`
+	IntentPath    string `json:"intent_path"`
+	CorrelationID string `json:"correlation_id"`
+	Status        string `json:"status"`
+	Message       string `json:"message"`
+}
+
+func findFailedPatchLog(reader io.Reader, segmentID, intentPath string) (controllerLogRecord, error) {
+	scanner := bufio.NewScanner(reader)
+	scanner.Buffer(make([]byte, 4096), 1024*1024)
+	var match controllerLogRecord
+	found := false
+	line := 0
+	for scanner.Scan() {
+		line++
+		if len(bytes.TrimSpace(scanner.Bytes())) == 0 {
+			continue
+		}
+		var record controllerLogRecord
+		if err := json.Unmarshal(scanner.Bytes(), &record); err != nil {
+			return controllerLogRecord{}, fmt.Errorf("decode controller log line %d: %w", line, err)
+		}
+		if record.OperationID == "PatchInfraSegment" &&
+			record.SegmentID == segmentID &&
+			record.IntentPath == intentPath &&
+			record.Status == "failed" {
+			match = record
+			found = true
+		}
+	}
+	if err := scanner.Err(); err != nil {
+		return controllerLogRecord{}, fmt.Errorf("read controller log: %w", err)
+	}
+	if !found {
+		return controllerLogRecord{}, fmt.Errorf("%w: no matching failed PatchInfraSegment log record", ErrNoDiagnosticEvidence)
+	}
+	return match, nil
+}

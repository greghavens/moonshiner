+type realizedEntityList struct {
+	Results []realizedEntity `json:"results"`
+}
+
+type realizedEntity struct {
+	ID          string   `json:"id"`
+	IntentPaths []string `json:"intent_paths"`
+	State       string   `json:"state"`
+}
+
+func (c *Client) getRealizedEntity(ctx context.Context, intentPath, sitePath string) (realizedEntity, error) {
+	query := url.Values{}
+	query.Set("intent_path", intentPath)
+	if sitePath != "" {
+		query.Set("site_path", sitePath)
+	}
+	var response realizedEntityList
+	if err := c.doJSON(
+		ctx,
+		"ListRealizedEntities",
+		http.MethodGet,
+		"/infra/realized-state/realized-entities",
+		query,
+		nil,
+		&response,
+	); err != nil {
+		return realizedEntity{}, err
+	}
+
+	var firstMatch *realizedEntity
+	for index := range response.Results {
+		candidate := &response.Results[index]
+		if !containsExact(candidate.IntentPaths, intentPath) {
+			continue
+		}
+		if candidate.State == "ERROR" {
+			return *candidate, nil
+		}
+		if firstMatch == nil {
+			firstMatch = candidate
+		}
+	}
+	if firstMatch != nil {
+		return *firstMatch, nil
+	}
+	return realizedEntity{}, fmt.Errorf("%w: no realized entity for %s", ErrNoDiagnosticEvidence, intentPath)
+}
+
+type alarmList struct {
+	Cursor  string  `json:"cursor"`
+	Results []alarm `json:"results"`
+}
+
+type alarm struct {
+	ID              string   `json:"id"`
+	IntentPaths     []string `json:"intent_paths"`
+	Message         string   `json:"message"`
+	Severity        string   `json:"severity"`
+	SourceReference string   `json:"source_reference"`
+}
+
+func (c *Client) getCorrelatedAlarm(ctx context.Context, intentPath string, options DiagnosticsOptions) (alarm, error) {
+	baseQuery := url.Values{}
+	if options.IncludedFields != "" {
+		baseQuery.Set("included_fields", options.IncludedFields)
+	}
+	if options.PageSize != nil {
+		baseQuery.Set("page_size", strconv.FormatInt(*options.PageSize, 10))
+	}
+	if options.SortAscending != nil {
+		baseQuery.Set("sort_ascending", strconv.FormatBool(*options.SortAscending))
+	}
+	if options.SortBy != "" {
+		baseQuery.Set("sort_by", options.SortBy)
+	}
+
+	cursor := ""
+	seenCursors := make(map[string]bool)
+	var matching *alarm
+	for {
+		query := cloneValues(baseQuery)
+		if cursor != "" {
+			query.Set("cursor", cursor)
+		}
+		var response alarmList
+		if err := c.doJSON(
+			ctx,
+			"ListAlarms",
+			http.MethodGet,
+			"/infra/realized-state/alarms",
+			query,
+			nil,
+			&response,
+		); err != nil {
+			return alarm{}, err
+		}
+		for index := range response.Results {
+			candidate := &response.Results[index]
+			if candidate.Severity == "ERROR" && containsExact(candidate.IntentPaths, intentPath) && matching == nil {
+				copy := *candidate
+				matching = &copy
+			}
+		}
+		if response.Cursor == "" {
+			break
+		}
+		if seenCursors[response.Cursor] {
+			return alarm{}, fmt.Errorf("ListAlarms returned repeated cursor %q", response.Cursor)
+		}
+		seenCursors[response.Cursor] = true
+		cursor = response.Cursor
+	}
+	if matching == nil {
+		return alarm{}, fmt.Errorf("%w: no ERROR alarm for %s", ErrNoDiagnosticEvidence, intentPath)
+	}
+	return *matching, nil
+}
+
+func cloneValues(source url.Values) url.Values {
+	result := make(url.Values, len(source))
+	for key, values := range source {
+		result[key] = append([]string(nil), values...)
+	}
+	return result
+}
+
+func containsExact(values []string, wanted string) bool {
+	for _, value := range values {
+		if value == wanted {
+			return true
+		}
+	}
+	return false
+}
+
+func (c *Client) doJSON(
+	ctx context.Context,
+	operationID string,
+	method string,
+	apiPath string,
+	query url.Values,
+	requestValue any,
+	responseValue any,
+) error {
+	var body io.Reader
+	if requestValue != nil {
+		encoded, err := json.Marshal(requestValue)
+		if err != nil {
+			return fmt.Errorf("%s encode request: %w", operationID, err)
+		}
+		body = bytes.NewReader(encoded)
+	}
+
+	endpoint := c.origin + "/policy/api/v1" + apiPath
+	if encodedQuery := query.Encode(); encodedQuery != "" {
+		endpoint += "?" + encodedQuery
+	}
+	request, err := http.NewRequestWithContext(ctx, method, endpoint, body)
+	if err != nil {
+		return fmt.Errorf("%s build request: %w", operationID, err)
+	}
+	request.Header.Set("Accept", "application/json")
+	if requestValue != nil {
+		request.Header.Set("Content-Type", "application/json")
+	}
+	request.SetBasicAuth(c.username, c.password)
+
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		return fmt.Errorf("%s request: %w", operationID, err)
+	}
+	defer response.Body.Close()
+	responseBody, err := io.ReadAll(io.LimitReader(response.Body, 4<<20))
+	if err != nil {
+		return fmt.Errorf("%s read response: %w", operationID, err)
+	}
+	if response.StatusCode < 200 || response.StatusCode >= 300 {
+		apiError := &APIError{StatusCode: response.StatusCode}
+		if err := json.Unmarshal(responseBody, apiError); err != nil || apiError.ErrorMessage == "" {
+			apiError.ErrorMessage = http.StatusText(response.StatusCode)
+		}
+		return apiError
+	}
+	if responseValue != nil {
+		if len(bytes.TrimSpace(responseBody)) == 0 {
+			return fmt.Errorf("%s decode response: empty body", operationID)
+		}
+		if err := json.Unmarshal(responseBody, responseValue); err != nil {
+			return fmt.Errorf("%s decode response: %w", operationID, err)
+		}
+	}
+	return nil
 }

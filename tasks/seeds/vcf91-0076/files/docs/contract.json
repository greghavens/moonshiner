{
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/nsx/openapi-2.0/nsx_policy_api.yaml",
    "license": "Apache-2.0"
  },
  "openapi": "2.0",
  "info": {
    "title": "NSX Policy API",
    "version": "9.1.0.0",
    "description": "VMware NSX Policy REST API"
  },
  "scheme": "https",
  "base_path": "/policy/api/v1",
  "produces": [
    "application/json"
  ],
  "security": {
    "name": "BasicAuth",
    "type": "basic",
    "description": "HTTP Basic Authentication"
  },
  "operations": [
    {
      "operation_id": "PatchInfraSegment",
      "method": "PATCH",
      "path": "/infra/segments/{segment-id}",
      "consumes": [
        "application/json"
      ],
      "parameters": [
        {
          "name": "segment-id",
          "in": "path",
          "required": true,
          "type": "string"
        },
        {
          "name": "Segment",
          "in": "body",
          "required": true,
          "schema": "Segment"
        }
      ],
      "success": {
        "status": 200
      }
    },
    {
      "operation_id": "ListRealizedEntities",
      "method": "GET",
      "path": "/infra/realized-state/realized-entities",
      "produces": [
        "application/json"
      ],
      "parameters": [
        {
          "name": "intent_path",
          "in": "query",
          "required": true,
          "type": "string",
          "description": "Intent path of object; forward slashes must be percent-escaped on the wire."
        },
        {
          "name": "site_path",
          "in": "query",
          "required": false,
          "type": "string"
        }
      ],
      "success": {
        "status": 200,
        "schema": "GenericPolicyRealizedResourceListResult"
      }
    },
    {
      "operation_id": "ListAlarms",
      "method": "GET",
      "path": "/infra/realized-state/alarms",
      "produces": [
        "application/json"
      ],
      "parameters": [
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "included_fields",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "page_size",
          "in": "query",
          "required": false,
          "type": "integer",
          "format": "int64",
          "default": 1000,
          "minimum": 0,
          "maximum": 1000
        },
        {
          "name": "sort_ascending",
          "in": "query",
          "required": false,
          "type": "boolean"
        },
        {
          "name": "sort_by",
          "in": "query",
          "required": false,
          "type": "string"
        }
      ],
      "success": {
        "status": 200,
        "schema": "PolicyAlarmResourceListResult"
      }
    }
  ],
  "schemas": {
    "Segment": {
      "type": "object",
      "all_optional": true,
      "properties": {
        "display_name": {
          "type": "string",
          "maxLength": 255
        },
        "description": {
          "type": "string",
          "maxLength": 1024
        },
        "connectivity_path": {
          "type": "string"
        },
        "transport_zone_path": {
          "type": "string"
        },
        "subnets": {
          "type": "array",
          "items": "SegmentSubnet"
        },
        "vlan_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "admin_state": {
          "type": "string",
          "enum": [
            "UP",
            "DOWN"
          ],
          "default": "UP"
        }
      }
    },
    "SegmentSubnet": {
      "type": "object",
      "properties": {
        "gateway_address": {
          "type": "string",
          "format": "ip-cidr-block"
        },
        "dhcp_ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 99,
          "items": {
            "type": "string",
            "format": "address-or-block-or-range"
          }
        }
      }
    },
    "GenericPolicyRealizedResourceListResult": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": "GenericPolicyRealizedResource"
        }
      }
    },
    "GenericPolicyRealizedResource": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "intent_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "readOnly": true
        },
        "state": {
          "type": "string",
          "enum": [
            "UNAVAILABLE",
            "UNREALIZED",
            "REALIZED",
            "ERROR"
          ]
        },
        "operational_status": {
          "type": "string"
        },
        "operational_status_error": {
          "type": "string"
        }
      }
    },
    "PolicyAlarmResourceListResult": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string",
          "readOnly": true
        },
        "result_count": {
          "type": "integer",
          "format": "int64",
          "readOnly": true
        },
        "results": {
          "type": "array",
          "items": "PolicyAlarmResource"
        }
      }
    },
    "PolicyAlarmResource": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "intent_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "readOnly": true
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "INFO",
            "WARNING",
            "SUGGESTIVE",
            "ERROR"
          ]
        },
        "source_reference": {
          "type": "string"
        },
        "error_details": {
          "schema": "PolicyApiError"
        }
      }
    },
    "PolicyApiError": {
      "type": "object",
      "properties": {
        "error_code": {
          "type": "integer",
          "format": "int64"
        },
        "error_message": {
          "type": "string"
        },
        "module_name": {
          "type": "string"
        },
        "details": {
          "type": "string"
        }
      }
    }
  }
}

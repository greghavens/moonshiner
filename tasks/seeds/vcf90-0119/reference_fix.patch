diff --git a/vsan_dp/__init__.py b/vsan_dp/__init__.py
new file mode 100644
index 0000000..11df46c
--- /dev/null
+++ b/vsan_dp/__init__.py
@@ -0,0 +1,76 @@
+"""Small stdlib client for selected VCF 9.0 vSAN Data Protection operations."""
+
+from __future__ import annotations
+
+import json
+import time
+from urllib.parse import quote
+from urllib.request import Request, urlopen
+
+
+class TaskFailedError(RuntimeError):
+    """Raised when a vSAN Data Protection task reaches FAILED."""
+
+    def __init__(self, task):
+        self.task = task
+        super().__init__("vSAN Data Protection task failed: %s" % task)
+
+
+class VsanDataProtectionClient:
+    """Client for manual protection-group snapshots and their task status."""
+
+    _TERMINAL = frozenset(("SUCCEEDED", "FAILED"))
+
+    def __init__(self, base_url, session_id, poll_interval=0.0):
+        self.base_url = base_url.rstrip("/")
+        self.session_id = session_id
+        self.poll_interval = poll_interval
+
+    def create_protection_group_snapshot(
+        self, cluster, protection_group, name, *, retention=None
+    ):
+        body = {"name": name}
+        if retention is not None:
+            body["retention"] = retention
+
+        cluster_id = quote(str(cluster), safe="")
+        protection_group_id = quote(str(protection_group), safe="")
+        path = (
+            "/snapservice/clusters/%s/protection-groups/%s/snapshots"
+            "?vmw-task=true"
+        ) % (cluster_id, protection_group_id)
+        task_id = self._request("POST", path, body)
+
+        while True:
+            task = self._request(
+                "GET", "/snapservice/tasks/%s" % quote(str(task_id), safe="")
+            )
+            status = task.get("status")
+            if status in self._TERMINAL:
+                if status == "FAILED":
+                    raise TaskFailedError(task)
+                return task
+            if self.poll_interval:
+                time.sleep(self.poll_interval)
+
+    def _request(self, method, path, body=None):
+        data = None
+        headers = {
+            "Accept": "application/json",
+            "vmware-api-session-id": self.session_id,
+        }
+        if body is not None:
+            data = json.dumps(body, separators=(",", ":")).encode("utf-8")
+            headers["Content-Type"] = "application/json"
+        request = Request(
+            self.base_url + path,
+            data=data,
+            headers=headers,
+            method=method,
+        )
+        with urlopen(request) as response:
+            payload = response.read()
+        return json.loads(payload.decode("utf-8"))
+
+
+__all__ = ["TaskFailedError", "VsanDataProtectionClient"]

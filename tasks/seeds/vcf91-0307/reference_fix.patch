diff --git a/VcfAutomationDeployment/VcfAutomationDeployment.psm1 b/VcfAutomationDeployment/VcfAutomationDeployment.psm1
new file mode 100644
index 0000000..8b2679a
--- /dev/null
+++ b/VcfAutomationDeployment/VcfAutomationDeployment.psm1
@@ -0,0 +1,313 @@
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+# docs/contract.json, asynchronousProfile.requestStatusClassification
+$script:NonTerminalStatuses = @(
+    'CREATED'
+    'PENDING'
+    'INITIALIZATION'
+    'CHECKING_APPROVAL'
+    'APPROVAL_PENDING'
+    'USER_INTERACTION_PENDING'
+    'INPROGRESS'
+    'COMPLETION'
+)
+$script:TerminalSuccessStatus = 'SUCCESSFUL'
+$script:TerminalFailureStatuses = @('APPROVAL_REJECTED', 'ABORTED', 'FAILED')
+
+function ConvertTo-VcfAutomationStatus {
+    param([AllowNull()] [object] $Value)
+
+    if ($null -eq $Value) {
+        return ''
+    }
+    ([string] $Value).Trim().ToUpperInvariant()
+}
+
+function Get-VcfAutomationMember {
+    param(
+        [AllowNull()] [object] $InputObject,
+        [Parameter(Mandatory)] [string] $Name
+    )
+
+    if ($null -eq $InputObject) {
+        return $null
+    }
+    $property = $InputObject.PSObject.Properties[$Name]
+    if ($null -eq $property) {
+        return $null
+    }
+    $property.Value
+}
+
+function Get-VcfAutomationRequiredText {
+    param(
+        [AllowNull()] [object] $InputObject,
+        [Parameter(Mandatory)] [string] $Name,
+        [Parameter(Mandatory)] [string] $Context
+    )
+
+    $value = Get-VcfAutomationMember -InputObject $InputObject -Name $Name
+    if ($null -eq $value -or [string]::IsNullOrWhiteSpace([string] $value)) {
+        throw [System.InvalidOperationException]::new(
+            "$Context did not supply a usable '$Name'."
+        )
+    }
+    [string] $value
+}
+
+function Assert-VcfAutomationText {
+    param(
+        [AllowNull()] [string] $Value,
+        [Parameter(Mandatory)] [string] $Name
+    )
+
+    if ([string]::IsNullOrWhiteSpace($Value)) {
+        throw [System.ArgumentException]::new(
+            "$Name must be a non-blank string.",
+            $Name
+        )
+    }
+}
+
+function Invoke-VcfAutomationOperation {
+    param(
+        [Parameter(Mandatory)] [uri] $ApiUri,
+        [Parameter(Mandatory)] [string] $AccessToken,
+        [Parameter(Mandatory)] [string] $Method,
+        [Parameter(Mandatory)] [string] $Path,
+        [AllowNull()] [System.Collections.Specialized.OrderedDictionary] $Query,
+        [AllowNull()] [object] $Body
+    )
+
+    $target = $ApiUri.GetLeftPart([System.UriPartial]::Authority) + $Path
+    if ($null -ne $Query -and $Query.Count -gt 0) {
+        $pairs = foreach ($name in $Query.Keys) {
+            '{0}={1}' -f
+                [uri]::EscapeDataString([string] $name),
+                [uri]::EscapeDataString([string] $Query[$name])
+        }
+        $target += '?' + ($pairs -join '&')
+    }
+
+    $parameters = @{
+        Uri         = $target
+        Method      = $Method
+        Headers     = @{
+            Authorization = "Bearer $AccessToken"
+            Accept        = 'application/json'
+        }
+        ErrorAction = 'Stop'
+    }
+    # An operation with no documented request body is sent with no body and no
+    # media type; an empty JSON object is not a substitute for an absent body.
+    if ($null -ne $Body) {
+        $parameters['Body'] = ConvertTo-Json -InputObject $Body -Depth 32 -Compress
+        $parameters['ContentType'] = 'application/json'
+    }
+    # `-Debug:$false` because the caller may have asked for the debug
+    # stream and `Invoke-RestMethod` answers it by printing every request
+    # header it was given -- the bearer token among them.
+    Invoke-RestMethod @parameters -Debug:$false
+}
+
+function New-VcfAutomationDeploymentPath {
+    param(
+        [Parameter(Mandatory)] [string] $Template,
+        [Parameter(Mandatory)] [string] $Value
+    )
+
+    $Template -replace '\{[^{}]+\}', [uri]::EscapeDataString($Value)
+}
+
+function New-VcfAutomationDeployment {
+    [CmdletBinding()]
+    [OutputType([pscustomobject])]
+    param(
+        [Parameter(Mandatory)] [uri] $ApiUri,
+        [Parameter(Mandatory)] [securestring] $AccessToken,
+        [Parameter(Mandatory)] [string] $CatalogItemId,
+        [Parameter(Mandatory)] [string] $ProjectId,
+        [Parameter(Mandatory)] [string] $DeploymentName,
+        [string] $Version,
+        [string] $Reason,
+        [hashtable] $Inputs,
+        [ValidateRange(0, 60)] [int] $PollIntervalSeconds = 2,
+        [ValidateRange(1, 900)] [int] $TimeoutSeconds = 300
+    )
+
+    if ($null -eq $ApiUri -or -not $ApiUri.IsAbsoluteUri) {
+        throw [System.ArgumentException]::new(
+            'ApiUri must be an absolute URI.',
+            'ApiUri'
+        )
+    }
+    if ($null -eq $AccessToken) {
+        throw [System.ArgumentNullException]::new('AccessToken')
+    }
+    Assert-VcfAutomationText -Value $CatalogItemId -Name 'CatalogItemId'
+    Assert-VcfAutomationText -Value $ProjectId -Name 'ProjectId'
+    Assert-VcfAutomationText -Value $DeploymentName -Name 'DeploymentName'
+
+    $token = ConvertFrom-SecureString -SecureString $AccessToken -AsPlainText
+    if ([string]::IsNullOrWhiteSpace($token)) {
+        throw [System.ArgumentException]::new(
+            'AccessToken must contain a non-blank bearer token.',
+            'AccessToken'
+        )
+    }
+
+    # requestCatalogItem: bound members always, conditional members only when
+    # the caller supplied one, bulkRequestCount never.
+    $requestBody = [ordered] @{
+        deploymentName = $DeploymentName
+        projectId      = $ProjectId
+    }
+    if ($PSBoundParameters.ContainsKey('Version')) {
+        $requestBody['version'] = $Version
+    }
+    if ($PSBoundParameters.ContainsKey('Reason')) {
+        $requestBody['reason'] = $Reason
+    }
+    if ($PSBoundParameters.ContainsKey('Inputs')) {
+        $requestBody['inputs'] = $Inputs
+    }
+
+    # Invoke-RestMethod hands back a JSON array as one object, so bind it before
+    # wrapping: @(Invoke-... ) would nest the array inside another array.
+    $response = Invoke-VcfAutomationOperation `
+        -ApiUri $ApiUri `
+        -AccessToken $token `
+        -Method 'POST' `
+        -Path (New-VcfAutomationDeploymentPath `
+            -Template '/catalog/api/items/{id}/request' `
+            -Value $CatalogItemId) `
+        -Body $requestBody
+    $accepted = @($response)
+    if ($accepted.Count -ne 1) {
+        throw [System.InvalidOperationException]::new(
+            "The catalog item request returned $($accepted.Count) deployments; exactly one was expected."
+        )
+    }
+    $deploymentId = Get-VcfAutomationRequiredText `
+        -InputObject $accepted[0] `
+        -Name 'deploymentId' `
+        -Context 'The catalog item request'
+    $deploymentName = Get-VcfAutomationRequiredText `
+        -InputObject $accepted[0] `
+        -Name 'deploymentName' `
+        -Context 'The catalog item request'
+
+    # The accepted response carries no request identifier, so read it from the
+    # deployment's lastRequest rather than assuming the work already finished.
+    $deploymentQuery = [ordered] @{ expandLastRequest = 'true' }
+    $deployment = Invoke-VcfAutomationOperation `
+        -ApiUri $ApiUri `
+        -AccessToken $token `
+        -Method 'GET' `
+        -Path (New-VcfAutomationDeploymentPath `
+            -Template '/deployment/api/deployments/{deploymentId}' `
+            -Value $deploymentId) `
+        -Query $deploymentQuery
+    $returnedId = Get-VcfAutomationRequiredText `
+        -InputObject $deployment `
+        -Name 'id' `
+        -Context 'The deployment read'
+    if ($returnedId -cne $deploymentId) {
+        throw [System.InvalidOperationException]::new(
+            'The deployment read returned a different deployment identifier.'
+        )
+    }
+    $lastRequest = Get-VcfAutomationMember -InputObject $deployment -Name 'lastRequest'
+    if ($null -eq $lastRequest) {
+        throw [System.InvalidOperationException]::new(
+            'The deployment read did not expand lastRequest.'
+        )
+    }
+    $requestId = Get-VcfAutomationRequiredText `
+        -InputObject $lastRequest `
+        -Name 'id' `
+        -Context "The deployment's lastRequest"
+
+    $requestPath = New-VcfAutomationDeploymentPath `
+        -Template '/deployment/api/requests/{requestId}' `
+        -Value $requestId
+
+    $stopwatch = [System.Diagnostics.Stopwatch]::StartNew()
+    $pollCount = 0
+    $cancelable = $false
+    $request = $null
+    $status = ''
+    while ($true) {
+        $request = Invoke-VcfAutomationOperation `
+            -ApiUri $ApiUri `
+            -AccessToken $token `
+            -Method 'GET' `
+            -Path $requestPath
+        $pollCount++
+
+        $polledId = Get-VcfAutomationRequiredText `
+            -InputObject $request `
+            -Name 'id' `
+            -Context 'The polled request'
+        if ($polledId -cne $requestId) {
+            throw [System.InvalidOperationException]::new(
+                'The polled request returned a different request identifier.'
+            )
+        }
+        $cancelable = [bool] (Get-VcfAutomationMember -InputObject $request -Name 'cancelable')
+        $status = ConvertTo-VcfAutomationStatus (
+            Get-VcfAutomationMember -InputObject $request -Name 'status'
+        )
+
+        if ($status -ceq $script:TerminalSuccessStatus) {
+            break
+        }
+        if ($script:TerminalFailureStatuses -ccontains $status) {
+            $details = Get-VcfAutomationMember -InputObject $request -Name 'details'
+            throw [System.InvalidOperationException]::new(
+                "Deployment request $requestId reached terminal status ${status}: $details"
+            )
+        }
+        if ($script:NonTerminalStatuses -cnotcontains $status) {
+            throw [System.InvalidOperationException]::new(
+                "Deployment request $requestId reported unknown status '$status'."
+            )
+        }
+        if ($stopwatch.Elapsed.TotalSeconds -ge $TimeoutSeconds) {
+            if ($cancelable) {
+                try {
+                    $null = Invoke-VcfAutomationOperation `
+                        -ApiUri $ApiUri `
+                        -AccessToken $token `
+                        -Method 'POST' `
+                        -Path $requestPath `
+                        -Query ([ordered] @{ action = 'cancel' })
+                } catch {
+                    Write-Verbose "Cancel of request $requestId failed: $($_.Exception.Message)"
+                }
+            }
+            throw [System.TimeoutException]::new(
+                "Deployment request $requestId did not reach a terminal status within $TimeoutSeconds seconds; last status was '$status'."
+            )
+        }
+        if ($PollIntervalSeconds -gt 0) {
+            Start-Sleep -Seconds $PollIntervalSeconds
+        }
+    }
+
+    [pscustomobject] ([ordered] @{
+        catalogItemId  = $CatalogItemId
+        deploymentId   = $deploymentId
+        deploymentName = $deploymentName
+        requestId      = $requestId
+        requestStatus  = $status
+        requestedBy    = Get-VcfAutomationRequiredText `
+            -InputObject $request `
+            -Name 'requestedBy' `
+            -Context 'The completed request'
+        totalTasks     = [int] (Get-VcfAutomationMember -InputObject $request -Name 'totalTasks')
+        completedTasks = [int] (Get-VcfAutomationMember -InputObject $request -Name 'completedTasks')
+        pollCount      = $pollCount
+        outputs        = Get-VcfAutomationMember -InputObject $request -Name 'outputs'
+    })
+}
+
+Export-ModuleMember -Function 'New-VcfAutomationDeployment'

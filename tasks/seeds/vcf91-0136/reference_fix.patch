+        -not [StringComparer]::Ordinal.Equals($Value, $Expected)
+    ) {
+        throw [InvalidDataException]::new("$Context is inconsistent.")
+    }
+}
+
+function Resolve-VcfSupervisorOrigin {
+    param(
+        [Parameter(Mandatory)]
+        [string] $MasterHost,
+
+        [Parameter(Mandatory)]
+        [string] $Scheme
+    )
+
+    if (
+        [string]::IsNullOrWhiteSpace($MasterHost) -or
+        $MasterHost.Contains('/') -or
+        $MasterHost.Contains('?') -or
+        $MasterHost.Contains('#') -or
+        $MasterHost.Contains('@')
+    ) {
+        throw [InvalidDataException]::new(
+            'The Supervisor endpoint is not a bare authority.'
+        )
+    }
+    $Parsed = $null
+    if (
+        -not [uri]::TryCreate(
+            "${Scheme}://${MasterHost}",
+            [UriKind]::Absolute,
+            [ref] $Parsed
+        ) -or
+        [string]::IsNullOrWhiteSpace($Parsed.Host) -or
+        $Parsed.UserInfo.Length -ne 0 -or
+        $Parsed.AbsolutePath -cne '/' -or
+        $Parsed.Query.Length -ne 0 -or
+        $Parsed.Fragment.Length -ne 0
+    ) {
+        throw [InvalidDataException]::new(
+            'The Supervisor endpoint is not a valid authority.'
+        )
+    }
+    return [uri] $Parsed.GetLeftPart([UriPartial]::Authority)
+}
+
+function ConvertFrom-VcfJson {
+    param(
+        [Parameter(Mandatory)]
+        [AllowEmptyString()]
+        [string] $Text,
+
+        [Parameter(Mandatory)]
+        [string] $Context
+    )
+

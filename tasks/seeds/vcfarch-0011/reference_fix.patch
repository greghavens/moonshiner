+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from .builder import build_artifacts
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Generate the pinned VCF 9.1 architecture")
+    parser.add_argument("--output", type=Path, default=Path("artifacts"))
+    arguments = parser.parse_args()
+
+    arguments.output.mkdir(parents=True, exist_ok=True)
+    for filename, document in build_artifacts().items():
+        destination = arguments.output / filename
+        destination.write_text(json.dumps(document, indent=2) + "\n", encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/vcf_architecture/builder.py b/vcf_architecture/builder.py
new file mode 100644
index 0000000..dbbedcc
--- /dev/null
+++ b/vcf_architecture/builder.py
@@ -0,0 +1,258 @@
+from __future__ import annotations
+
+from ipaddress import ip_network
+import json
+from pathlib import Path
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def _load(relative_path: str) -> dict[str, Any]:
+    with (ROOT / relative_path).open("r", encoding="utf-8") as handle:
+        return json.load(handle)
+
+
+def _sddc_spec(requirements: dict[str, Any]) -> dict[str, Any]:
+    target = requirements["targetRelease"]
+    appliances = requirements["appliances"]
+    services = requirements["managementServices"]
+    hostnames = [
+        hostname
+        for site_hosts in requirements["hosts"]["hostnamesBySite"].values()
+        for hostname in site_hosts
+    ]
+    networks = []
+    for source in requirements["networks"]:
+        networks.append({
+            "networkType": source["networkType"],
+            "subnet": source["subnet"],
+            "gateway": source["gateway"],
+            "subnetMask": str(ip_network(source["subnet"]).netmask),
+            "includeIpAddressRanges": [{
+                "startIpAddress": source["startIpAddress"],
+                "endIpAddress": source["endIpAddress"],
+            }],
+            "vlanId": source["vlanId"],
+            "mtu": source["mtu"],
+            "teamingPolicy": "loadbalance_loadbased",
+            "ipAddressVersion": "IPv4",
+            "ipAddressAssignmentMode": "STATIC",
+        })
+
+    return {
+        "sddcId": requirements["designId"],
+        "workflowType": "VCF",
+        "hostSpecs": [{"hostname": hostname} for hostname in hostnames],
+        "version": target,
+        "vcenterSpec": {
+            "vcenterHostname": appliances["vcenterHostname"],
+            "rootVcenterPassword": "${VC_ROOT_PASS}",
+            "vmSize": "medium",
+            "ssoDomain": "vsphere.local",
+            "version": target,
+            "useExistingDeployment": False,
+        },
+        "clusterSpec": {
+            "datacenterName": requirements["managementDomain"]["datacenterName"],
+            "clusterName": requirements["managementDomain"]["clusterName"],
+        },
+        "dvsSpecs": [{
+            "dvsName": "dfw-m01-vds01",
+            "networks": [item["networkType"] for item in requirements["networks"]],
+            "mtu": 9000,
+            "vmnicsToUplinks": [
+                {"id": "vmnic0", "uplink": "uplink1"},
+                {"id": "vmnic1", "uplink": "uplink2"},
+            ],
+        }],
+        "nsxtSpec": {
+            "nsxtManagers": [
+                {"hostname": hostname} for hostname in appliances["nsxManagerHostnames"]
+            ],
+            "nsxtManagerSize": "medium",
+            "vipFqdn": appliances["nsxVipFqdn"],
+            "transportVlanId": 140,
+            "version": target,
+            "useExistingDeployment": False,
+        },
+        "networkSpecs": networks,
+        "dnsSpec": requirements["dns"],
+        "ntpServers": requirements["ntpServers"],
+        "sddcManagerSpec": {
+            "hostname": appliances["sddcManagerHostname"],
+            "version": target,
+            "useExistingDeployment": False,
+        },
+        "managementPoolName": "dfw-m01-network-pool",
+        "ceipEnabled": False,
+        "skipEsxThumbprintValidation": False,
+        "skipGatewayPingValidation": False,
+        "securitySpec": {"esxiCertsMode": "VMCA"},
+        "datastoreSpec": {
+            "vsanSpec": {
+                "datastoreName": "dfw-m01-vsan01",
+                "vsanDedup": False,
+                "failuresToTolerate": 1,
+            }
+        },
+        "vspClusterSpec": {
+            "platformFqdn": appliances["vspPlatformFqdn"],
+            "ipv4Pool": {"addresses": services["ipv4Addresses"]},
+            "size": "medium",
+            "internalClusterCidrIpv4": services["internalClusterCidrIpv4"],
+            "instanceFqdn": appliances["vspInstanceFqdn"],
+            "fleetFqdn": appliances["vspFleetFqdn"],
+            "version": target,
+            "useExistingDeployment": False,
+        },
+        "fleetLcmSpec": {"version": target, "size": "small"},
+        "sddcLcmSpec": {"version": target, "size": "small"},
+        "vcfOperationsSpec": {
+            "nodes": [
+                {"hostname": hostname, "type": "master" if index == 0 else "replica"}
+                for index, hostname in enumerate(appliances["operationsHostnames"])
+            ],
+            "applianceSize": "medium",
+            "useExistingDeployment": False,
+            "version": target,
+        },
+        "vcfManagementComponentsInfrastructureSpec": {
+            "localRegionNetwork": {
+                "networkName": services["networkName"],
+                "subnetMask": services["subnetMask"],
+                "gateway": services["gateway"],
+            }
+        },
+        "licenseServerSpec": {
+            "hostname": appliances["licenseServerHostname"],
+            "version": target,
+            "useExistingDeployment": False,
+        },
+        "vcfInstanceName": "DFW Stretched Management",
+    }
+
+
+def _site_design(
+    requirements: dict[str, Any], snapshot: dict[str, Any]
+) -> dict[str, Any]:
+    per_host = requirements["hosts"]["perHost"]
+    hostnames_by_site = requirements["hosts"]["hostnamesBySite"]
+    placements = [
+        {
+            "hostname": hostname,
+            "siteId": site_id,
+            "cores": per_host["cores"],
+            "memoryGiB": per_host["memoryGiB"],
+            "rawStorageTiB": per_host["rawStorageTiB"],
+        }
+        for site_id, hostnames in hostnames_by_site.items()
+        for hostname in hostnames
+    ]
+    data_sites = requirements["sites"]["dataSites"]
+    witness_site = requirements["sites"]["witnessSite"]
+    per_site = requirements["hosts"]["perDataSite"]
+    total_hosts = len(placements)
+    links = requirements["links"]
+    installer = snapshot["installerOpenApi"]
+
+    return {
+        "schemaVersion": "1.0",
+        "designId": requirements["designId"],
+        "targetRelease": requirements["targetRelease"],
+        "installerSchema": {
+            "repositoryTag": installer["repositoryTag"],
+            "path": installer["path"],
+            "schema": installer["schema"],
+        },
+        "managementDomain": {
+            "topology": requirements["managementDomain"]["topology"],
+            "clusterName": requirements["managementDomain"]["clusterName"],
+            "dataSiteIds": [site["siteId"] for site in data_sites],
+            "siteFailureTolerance": requirements["managementDomain"]["siteFailureTolerance"],
+            "additionalHostFailureAfterSiteFailure": requirements["managementDomain"]["additionalHostFailureAfterSiteFailure"],
+            "hostPlacement": placements,
+            "witness": {
+                "siteId": witness_site["siteId"],
+                "failureDomain": witness_site["failureDomain"],
+                "applianceVersion": snapshot["witnessApplianceVersion"],
+                "hostsWorkloads": False,
+            },
+        },
+        "sites": [
+            *[
+                {
+                    "siteId": site["siteId"],
+                    "kind": "data",
+                    "failureDomain": site["failureDomain"],
+                }
+                for site in data_sites
+            ],
+            {
+                "siteId": witness_site["siteId"],
+                "kind": "witness",
+                "failureDomain": witness_site["failureDomain"],
+            },
+        ],
+        "links": {
+            "dataSiteRttMs": links["designedDataSiteRttMs"],
+            "witnessRttMs": links["designedWitnessRttMs"],
+            "dataSiteBandwidthGbps": links["designedDataSiteBandwidthGbps"],
+            "witnessBandwidthMbps": links["designedWitnessBandwidthMbps"],
+        },
+        "capacity": {
+            "total": {
+                "cores": total_hosts * per_host["cores"],
+                "memoryGiB": total_hosts * per_host["memoryGiB"],
+                "rawStorageTiB": total_hosts * per_host["rawStorageTiB"],
+            },
+            "survivingSite": {
+                "cores": per_site * per_host["cores"],
+                "memoryGiB": per_site * per_host["memoryGiB"],
+                "rawStorageTiB": per_site * per_host["rawStorageTiB"],
+            },
+            "survivingSiteAfterAdditionalHostFailure": {
+                "cores": (per_site - 1) * per_host["cores"],
+                "memoryGiB": (per_site - 1) * per_host["memoryGiB"],
+                "rawStorageTiB": (per_site - 1) * per_host["rawStorageTiB"],
+            },
+            "requiredAfterFailures": requirements["requiredCapacityAfterFailures"],
+        },
+    }
+
+
+def _migration_plan(
+    inventory: dict[str, Any], snapshot: dict[str, Any]
+) -> dict[str, Any]:
+    components = {item["componentId"]: item for item in inventory["components"]}
+    steps = []
+    for transition in snapshot["supportedUpgradeTransitions"]:
+        component = components[transition["componentId"]]
+        steps.append({
+            "order": transition["order"],
+            "componentId": transition["componentId"],
+            "componentName": component["name"],
+            "currentVersion": component["version"],
+            "targetVersion": transition["targetVersion"],
+            "action": transition["action"],
+            "method": transition["method"],
+            "gates": transition["requiredGates"],
+        })
+    return {
+        "schemaVersion": "1.0",
+        "estateId": inventory["estateId"],
+        "targetRelease": snapshot["targetRelease"],
+        "steps": steps,
+    }
+
+
+def build_artifacts() -> dict[str, dict[str, Any]]:
+    requirements = _load("fixtures/design-requirements.json")
+    inventory = _load("fixtures/estate-inventory.json")
+    snapshot = _load("fixtures/compatibility-snapshot.json")
+    return {
+        "sddc-spec.json": _sddc_spec(requirements),
+        "site-design.json": _site_design(requirements, snapshot),
+        "migration-plan.json": _migration_plan(inventory, snapshot),
+    }

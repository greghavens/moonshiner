{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch:site-design:1.0",
  "title": "VCF stretched management-domain site design",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "designId",
    "targetRelease",
    "installerSchema",
    "managementDomain",
    "sites",
    "links",
    "capacity"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "designId": {
      "type": "string",
      "minLength": 1
    },
    "targetRelease": {
      "type": "string",
      "minLength": 1
    },
    "installerSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryTag",
        "path",
        "schema"
      ],
      "properties": {
        "repositoryTag": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        }
      }
    },
    "managementDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topology",
        "clusterName",
        "dataSiteIds",
        "siteFailureTolerance",
        "additionalHostFailureAfterSiteFailure",
        "hostPlacement",
        "witness"
      ],
      "properties": {
        "topology": {
          "const": "STRETCHED"
        },
        "clusterName": {
          "type": "string"
        },
        "dataSiteIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "siteFailureTolerance": {
          "type": "integer",
          "minimum": 1
        },
        "additionalHostFailureAfterSiteFailure": {
          "type": "integer",
          "minimum": 1
        },
        "hostPlacement": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hostname",
              "siteId",
              "cores",
              "memoryGiB",
              "rawStorageTiB"
            ],
            "properties": {
              "hostname": {
                "type": "string"
              },
              "siteId": {
                "type": "string"
              },
              "cores": {
                "type": "integer",
                "minimum": 1
              },
              "memoryGiB": {
                "type": "integer",
                "minimum": 1
              },
              "rawStorageTiB": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "witness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "siteId",
            "failureDomain",
            "applianceVersion",
            "hostsWorkloads"
          ],
          "properties": {
            "siteId": {
              "type": "string"
            },
            "failureDomain": {
              "type": "string"
            },
            "applianceVersion": {
              "type": "string"
            },
            "hostsWorkloads": {
              "const": false
            }
          }
        }
      }
    },
    "sites": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "siteId",
          "kind",
          "failureDomain"
        ],
        "properties": {
          "siteId": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "data",
              "witness"
            ]
          },
          "failureDomain": {
            "type": "string"
          }
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataSiteRttMs",
        "witnessRttMs",
        "dataSiteBandwidthGbps",
        "witnessBandwidthMbps"
      ],
      "properties": {
        "dataSiteRttMs": {
          "type": "number",
          "minimum": 0
        },
        "witnessRttMs": {
          "type": "number",
          "minimum": 0
        },
        "dataSiteBandwidthGbps": {
          "type": "number",
          "minimum": 0
        },
        "witnessBandwidthMbps": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "survivingSite",
        "survivingSiteAfterAdditionalHostFailure",
        "requiredAfterFailures"
      ],
      "properties": {
        "total": {
          "$ref": "#/$defs/capacityPair"
        },
        "survivingSite": {
          "$ref": "#/$defs/capacityPair"
        },
        "survivingSiteAfterAdditionalHostFailure": {
          "$ref": "#/$defs/capacityPair"
        },
        "requiredAfterFailures": {
          "$ref": "#/$defs/capacityPair"
        }
      }
    }
  },
  "$defs": {
    "capacityPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cores",
        "memoryGiB",
        "rawStorageTiB"
      ],
      "properties": {
        "cores": {
          "type": "integer",
          "minimum": 0
        },
        "memoryGiB": {
          "type": "integer",
          "minimum": 0
        },
        "rawStorageTiB": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

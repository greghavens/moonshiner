@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+"""Reference proof through the genuine account-service executable."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parent
+TARGET_ID = "crm-149"
+REASON = "created for the wrong operating period"
+CANCEL = [
+    "./accountctl",
+    "cancel",
+    "--id",
+    TARGET_ID,
+    "--reason",
+    REASON,
+]
+
+
+def run(command: list[str]) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        command,
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=10,
+    )
+
+
+def main() -> int:
+    first = run(CANCEL)
+    if first.returncode != 124:
+        raise RuntimeError("reference cancellation did not hit the client deadline")
+
+    retrieved = run(["./accountctl", "get", "--id", TARGET_ID])
+    if retrieved.returncode != 0:
+        raise RuntimeError(retrieved.stderr.strip() or "reference get failed")
+    payload = json.loads(retrieved.stdout)
+    record = payload.get("record")
+    if not isinstance(record, dict) or record.get("id") != TARGET_ID:
+        raise RuntimeError("reference get returned the wrong record")
+
+    status = record.get("status")
+    if status == "cancelled":
+        return 0
+    if status == "active":
+        retry = run(CANCEL)
+        if retry.returncode != 0:
+            raise RuntimeError(retry.stderr.strip() or "reference retry failed")
+        return 0
+    raise RuntimeError(f"unexpected reference status: {status!r}")
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

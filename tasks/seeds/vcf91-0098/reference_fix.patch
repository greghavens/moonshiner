+function Invoke-VcfVcenterPrivilegePage {
+    param(
+        [Parameter(Mandatory)]
+        $Session,
+
+        [Parameter(Mandatory)]
+        [hashtable] $Parameters
+    )
+
+    $OperationId = 'Vcenter.Authorization.Privileges_list'
+    try {
+        return & $Session.OperationInvoker `
+            $OperationId `
+            $Parameters `
+            $Session.Server
+    }
+    catch {
+        $Status = Get-VcfVcenterStatusCode -ErrorRecord $_
+        if ($Status -ne 401) {
+            throw
+        }
+    }
+
+    try {
+        $Replacement = & $Session.RefreshConnection $Session.Server
+    }
+    catch {
+        throw [InvalidOperationException]::new(
+            'The vCenter SDK connection refresh failed.'
+        )
+    }
+    if ($null -eq $Replacement) {
+        throw [InvalidOperationException]::new(
+            'The vCenter SDK connection refresh returned no connection.'
+        )
+    }
+    $Session.Server = $Replacement
+
+    try {
+        return & $Session.OperationInvoker `
+            $OperationId `
+            $Parameters `
+            $Session.Server
+    }
+    catch {
+        $RetryStatus = Get-VcfVcenterStatusCode -ErrorRecord $_
+        if ($RetryStatus -eq 401) {
+            throw [InvalidOperationException]::new(
+                'The vCenter request remained unauthorized after one refresh.'
+            )
+        }
+        throw
+    }
+}
+
+function Get-VcfVcenterSortedPrivileges {
+    param(
+        [Parameter(Mandatory)]
+        [AllowEmptyCollection()]
+        [object[]] $Privilege
+    )
+
+    $Sorted = [Collections.Generic.List[object]]::new()
+    foreach ($Item in $Privilege) {
+        $Sorted.Add($Item)
+    }
+    $Comparison = [Comparison[object]] {
+        param($Left, $Right)
+
+        $LeftPrivilege = Get-VcfVcenterMember `
+            -InputObject $Left `
+            -Name @('Privilege', 'privilege')
+        $RightPrivilege = Get-VcfVcenterMember `
+            -InputObject $Right `
+            -Name @('Privilege', 'privilege')
+        return [StringComparer]::Ordinal.Compare(
+            [string] $LeftPrivilege.Value,
+            [string] $RightPrivilege.Value
+        )
+    }
+    $Sorted.Sort($Comparison)
+    return $Sorted.ToArray()
 }
 

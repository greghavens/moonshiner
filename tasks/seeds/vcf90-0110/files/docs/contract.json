{
  "contractVersion": 1,
  "product": "VMware Cloud Foundation Installer",
  "apiVersion": "9.0.0.0",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "commitSha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "path": "specifications/vcf-installer/vcf-installer-openapi.json",
    "sha256": "a2084a65aab0ac0a5a1625d1a2fdf20b55fc8895ca43fd4389da901d07a4aaef",
    "license": "Apache-2.0"
  },
  "operations": [
    {
      "operationId": "validateSddcSpec",
      "method": "POST",
      "path": "/v1/sddcs/validations",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "SddcSpec"
      },
      "successStatuses": [200, 202],
      "responseSchema": "Validation"
    },
    {
      "operationId": "getSddcSpecValidation",
      "method": "GET",
      "path": "/v1/sddcs/validations/{id}",
      "pathParameters": ["id"],
      "successStatuses": [200],
      "responseSchema": "Validation"
    },
    {
      "operationId": "refreshAccessToken",
      "method": "PATCH",
      "path": "/v1/tokens/access-token/refresh",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "string"
      },
      "successStatuses": [200],
      "responseSchema": "string"
    },
    {
      "operationId": "deploySddc",
      "method": "POST",
      "path": "/v1/sddcs",
      "queryParameters": [
        {
          "name": "skipValidations",
          "required": false,
          "type": "boolean",
          "default": false
        }
      ],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "SddcSpec"
      },
      "successStatuses": [202],
      "responseSchema": "SddcTask"
    }
  ],
  "schemaProjection": {
    "SddcSpec": {
      "required": ["dnsSpec", "networkSpecs", "sddcId", "vcenterSpec"],
      "optional": ["workflowType", "version", "ntpServers", "ceipEnabled", "skipEsxThumbprintValidation", "skipGatewayPingValidation"]
    },
    "SddcVcenterSpec": {
      "required": ["rootVcenterPassword", "vcenterHostname"],
      "optional": ["vmSize", "storageSize", "ssoDomain", "adminUserSsoUsername", "adminUserSsoPassword", "useExistingDeployment", "version", "sslThumbprint"]
    },
    "SddcNetworkSpec": {
      "required": ["networkType", "vlanId"],
      "optional": ["subnet", "gateway", "subnetMask", "includeIpAddress", "mtu", "teamingPolicy", "activeUplinks", "standbyUplinks", "portGroupKey"]
    },
    "DnsSpec": {
      "required": ["subdomain"],
      "optional": ["nameservers"]
    },
    "Validation": {
      "required": ["description", "executionStatus", "id", "resultStatus"]
    },
    "SddcTask": {
      "required": ["creationTimestamp", "status"]
    }
  }
}

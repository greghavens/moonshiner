+#!/usr/bin/env python3
+"""Reference proof using the genuine executable and returned stable ID."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+REQUESTED_NAME = "Duplicate Subscription Charge"
+REQUESTED_LOCATION = "Acme"
+WORKER = r'''
+import json
+import subprocess
+import sys
+
+command = json.loads(sys.argv[1])
+completed = subprocess.run(
+    command,
+    capture_output=True,
+    text=True,
+    timeout=15,
+)
+print(json.dumps({
+    "returncode": completed.returncode,
+    "stdout": completed.stdout,
+    "stderr": completed.stderr,
+}))
+'''
+
+
+def inspect_help() -> None:
+    completed = subprocess.run(
+        ["./casectl", "--help"],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=15,
+    )
+    if completed.returncode != 0 or "search" not in completed.stdout:
+        raise RuntimeError("case executable help could not be inspected")
+
+
+def inspect_guide() -> None:
+    guide = (ROOT / "CASE_REGISTER_GUIDE.md").read_text(encoding="utf-8")
+    required_guidance = (
+        "copy the stable ID",
+        "Missing or ambiguous searches are stopping conditions",
+    )
+    if not all(text in guide for text in required_guidance):
+        raise RuntimeError("case register guide could not be inspected")
+
+
+def execute(command: list[str]) -> dict[str, Any]:
+    completed = subprocess.run(
+        [sys.executable, "-B", "-c", WORKER, json.dumps(command)],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=20,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "case action failed")
+    envelope = json.loads(completed.stdout)
+    if envelope.get("returncode") != 0:
+        raise RuntimeError(
+            str(envelope.get("stderr") or "").strip()
+            or "case operation failed"
+        )
+    result = json.loads(envelope["stdout"])
+    if not isinstance(result, dict):
+        raise RuntimeError("case operation returned a non-object")
+    return result
+
+
+def main() -> int:
+    inspect_guide()
+    inspect_help()
+    search = execute(
+        [
+            "./casectl",
+            "search",
+            "--name",
+            REQUESTED_NAME,
+            "--location",
+            REQUESTED_LOCATION,
+        ]
+    )
+    matches = search.get("matches")
+    if not isinstance(matches, list) or len(matches) != 1:
+        raise RuntimeError("reference search did not resolve uniquely")
+    match = matches[0]
+    if not isinstance(match, dict) or match.get("status") != "active":
+        raise RuntimeError("reference search did not return one active match")
+    stable_id = match.get("id")
+    if not isinstance(stable_id, str) or not stable_id:
+        raise RuntimeError("reference search returned no stable ID")
+
+    detail = execute(["./casectl", "get", "--id", stable_id])
+    record = detail.get("record")
+    if not isinstance(record, dict):
+        raise RuntimeError("reference get returned no full record")
+    if (
+        record.get("id") != stable_id
+        or record.get("name") != REQUESTED_NAME
+        or record.get("location") != REQUESTED_LOCATION
+        or record.get("status") != "active"
+    ):
+        raise RuntimeError("reference get returned a different case")
+
+    report = (
+        "| Field | Value |\n"
+        "|---|---|\n"
+        f"| ID | {record['id']} |\n"
+        f"| name | {record['name']} |\n"
+        f"| location | {record['location']} |\n"
+        f"| status | {record['status']} |\n"
+        f"| date | {record['date']} |\n"
+    )
+    (ROOT / "case-register.md").write_text(report, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

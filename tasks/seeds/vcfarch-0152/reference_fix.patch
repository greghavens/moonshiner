+    Description = 'Builds the pinned VCF Aria migration installer specification.'
+    PowerShellVersion = '7.2'
+    RequiredModules = @(
+        'VMware.Sdk.Vcf.Installer'
+        'VMware.Sdk.Vcf.SddcManager'
+    )
+    FunctionsToExport = @('New-VcfAriaMigrationInstallerSpec')
+    CmdletsToExport = @()

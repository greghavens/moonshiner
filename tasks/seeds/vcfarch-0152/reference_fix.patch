diff --git a/files/VcfAriaMigration/VcfAriaMigration.psm1 b/files/VcfAriaMigration/VcfAriaMigration.psm1
new file mode 100644
index 0000000..0b0bb26
--- /dev/null
+++ b/files/VcfAriaMigration/VcfAriaMigration.psm1
@@ -0,0 +1,350 @@
+Set-StrictMode -Version Latest
+
+function New-MigrationSource {
+    param([Parameter(Mandatory)]$Product)
+    [ordered]@{
+        sourceId = [string]$Product.id
+        product = [string]$Product.product
+        version = [string]$Product.version
+    }
+}
+
+function New-MigrationGate {
+    param(
+        [Parameter(Mandatory)][string]$Id,
+        [Parameter(Mandatory)][ValidateSet('pre', 'post')][string]$When,
+        [Parameter(Mandatory)][string]$Assertion
+    )
+    [ordered]@{ id = $Id; when = $When; assertion = $Assertion }
+}
+
+function New-VcfAriaMigrationInstallerSpec {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][string]$InventoryPath,
+        [Parameter(Mandatory)][string]$CompatibilitySnapshotPath,
+        [Parameter(Mandatory)][string]$SchemaPath,
+        [Parameter(Mandatory)][string]$OutputPath
+    )
+
+    $inventory = Get-Content -LiteralPath $InventoryPath -Raw -ErrorAction Stop | ConvertFrom-Json -Depth 100
+    $snapshot = Get-Content -LiteralPath $CompatibilitySnapshotPath -Raw -ErrorAction Stop | ConvertFrom-Json -Depth 100
+    $schema = Get-Content -LiteralPath $SchemaPath -Raw -ErrorAction Stop | ConvertFrom-Json -Depth 100
+    if ($schema.title -ne 'VCF Aria Migration Installer Specification') {
+        throw 'SchemaPath is not the VCF Aria migration installer specification schema.'
+    }
+
+    $requiredSdkModules = @('VMware.Sdk.Vcf.Installer', 'VMware.Sdk.Vcf.SddcManager')
+    if (@($snapshot.requiredSdkModules).Count -ne $requiredSdkModules.Count) {
+        throw 'The compatibility snapshot has an unexpected SDK module set.'
+    }
+    foreach ($sdkModule in $requiredSdkModules) {
+        if ($sdkModule -notin @($snapshot.requiredSdkModules)) {
+            throw "The compatibility snapshot does not require $sdkModule."
+        }
+        Import-Module -Name $sdkModule -ErrorAction Stop
+    }
+
+    $products = @{}
+    foreach ($product in $inventory.sourceProducts) {
+        $products[[string]$product.id] = $product
+    }
+    $operations = $products['aria-operations']
+    $automation = $products['aria-automation']
+    $logs = $products['aria-logs']
+    if ($null -eq $operations -or $null -eq $automation -or $null -eq $logs) {
+        throw 'Inventory must contain all three expected source products.'
+    }
+
+    $sizing = @{}
+    foreach ($item in $snapshot.targetSizing) {
+        $sizing[[string]$item.component] = $item
+    }
+    $opsSize = $sizing['VCF Operations']
+    $autoSize = $sizing['VCF Automation']
+    $logsSize = $sizing['VCF Operations for Logs']
+
+    $targetVcpu = ($opsSize.nodeCount * $opsSize.vcpuPerNode) +
+        ($autoSize.nodeCount * $autoSize.vcpuPerNode) +
+        ($logsSize.nodeCount * $logsSize.vcpuPerNode)
+    $targetMemory = ($opsSize.nodeCount * $opsSize.memoryGbPerNode) +
+        ($autoSize.nodeCount * $autoSize.memoryGbPerNode) +
+        ($logsSize.nodeCount * $logsSize.memoryGbPerNode)
+    $targetStorage = ($opsSize.nodeCount * $opsSize.dataDiskGbPerNode) +
+        ($autoSize.nodeCount * $autoSize.dataDiskGbPerNode) +
+        ($logsSize.nodeCount * $logsSize.dataDiskGbPerNode)
+
+    $opsSource = New-MigrationSource -Product $operations
+    $autoSource = New-MigrationSource -Product $automation
+    $logsSource = New-MigrationSource -Product $logs
+
+    $steps = @(
+        [ordered]@{
+            order = 10
+            id = 'step-10-assess'
+            action = 'assess-and-back-up'
+            dependsOn = @()
+            sources = @($opsSource, $autoSource, $logsSource)
+            targets = @('VCF Operations', 'VCF Automation', 'VCF Operations for Logs')
+            carries = @()
+            abandons = @()
+            gates = @(
+                (New-MigrationGate 'inventory-complete' 'pre' 'Inventory versions, content, integrations, and dependencies are reconciled.'),
+                (New-MigrationGate 'backups-restorable' 'post' 'Application-aware backups and configuration exports pass a restore test.'),
+                (New-MigrationGate 'minimum-four-hosts-capacity' 'post' 'Four-host management-domain peak coexistence capacity is confirmed.')
+            )
+        },
+        [ordered]@{
+            order = 20
+            id = 'step-20-patch-lifecycle'
+            action = 'patch-lifecycle'
+            dependsOn = @('step-10-assess')
+            sources = @($opsSource, $autoSource, $logsSource)
+            targets = @('VCF Operations', 'VCF Automation', 'VCF Operations for Logs')
+            carries = @()
+            abandons = @()
+            gates = @(
+                (New-MigrationGate 'aria-lcm-at-8-18-patch-2' 'post' 'Aria Suite Lifecycle reports version 8.18 Patch 2 or later and a healthy environment.')
+            )
+        },
+        [ordered]@{
+            order = 30
+            id = 'step-30-upgrade-operations'
+            action = 'upgrade-operations'
+            dependsOn = @('step-20-patch-lifecycle')
+            sources = @($opsSource)
+            targets = @('VCF Operations')
+            carries = @(
+                [ordered]@{ contentId = 'ops-dashboard-capacity'; method = 'in-place-upgrade' },
+                [ordered]@{ contentId = 'ops-dashboard-slo'; method = 'in-place-upgrade' },
+                [ordered]@{ contentId = 'ops-alert-snapshot-age'; method = 'in-place-upgrade' },
+                [ordered]@{ contentId = 'ops-supermetric-headroom'; method = 'in-place-upgrade' },
+                [ordered]@{ contentId = 'ops-custom-group-tier1'; method = 'in-place-upgrade' },
+                [ordered]@{ contentId = 'ops-report-monthly-capacity'; method = 'in-place-upgrade' },
+                [ordered]@{ contentId = 'ops-vsphere-adapter'; method = 'in-place-upgrade' }
+            )
+            abandons = @(
+                [ordered]@{
+                    contentId = 'ops-sddc-health-pack'
+                    method = 'remove-before-upgrade'
+                    reasonCode = 'EOGS_MANAGEMENT_PACK'
+                    reason = 'The legacy SDDC Health management pack is end of general support and its health capability is native in VCF Operations.'
+                }
+            )
+            gates = @(
+                (New-MigrationGate 'operations-precheck-clean' 'pre' 'The VCF Operations upgrade precheck completes without blocking findings.'),
+                (New-MigrationGate 'operations-content-exported' 'pre' 'Custom Operations content and configuration exports are complete and readable.'),
+                (New-MigrationGate 'fleet-management-registered' 'post' 'VCF Operations and the new Fleet Management appliance are healthy and registered.')
+            )
+        },
+        [ordered]@{
+            order = 40
+            id = 'step-40-remediate-automation'
+            action = 'remediate-automation'
+            dependsOn = @('step-30-upgrade-operations')
+            sources = @($autoSource)
+            targets = @('VCF Automation')
+            carries = @()
+            abandons = @(
+                [ordered]@{
+                    contentId = 'auto-template-avi-lb'
+                    method = 'remove-before-upgrade'
+                    reasonCode = 'DEPENDS_ON_UNSUPPORTED_AVI'
+                    reason = 'The template depends on the AVI cloud account that VCF Automation 9.0 does not support.'
+                },
+                [ordered]@{
+                    contentId = 'auto-avi-account'
+                    method = 'remove-before-upgrade'
+                    reasonCode = 'UNSUPPORTED_VCFA_9'
+                    reason = 'AVI Load Balancer cloud accounts are unsupported in VCF Automation 9.0 and block upgrade.'
+                }
+            )
+            gates = @(
+                (New-MigrationGate 'avi-dependencies-removed' 'post' 'The AVI account and every dependent mapping or template are removed from the source.'),
+                (New-MigrationGate 'automation-backup-restorable' 'pre' 'The Automation database and configuration backup passes its restore validation.'),
+                (New-MigrationGate 'automation-precheck-clean' 'post' 'Automation compatibility prechecks pass after unsupported content is removed.')
+            )
+        },
+        [ordered]@{
+            order = 50
+            id = 'step-50-import-automation'
+            action = 'import-automation'
+            dependsOn = @('step-40-remediate-automation')
+            sources = @($autoSource)
+            targets = @('VCF Automation')
+            carries = @()
+            abandons = @()
+            gates = @(
+                (New-MigrationGate 'fleet-management-healthy' 'pre' 'VCF Operations Fleet Management is healthy before importing the legacy instance.'),
+                (New-MigrationGate 'automation-imported-as-integrated' 'post' 'The Aria Automation instance is imported from Lifecycle as the integrated instance.')
+            )
+        },
+        [ordered]@{
+            order = 60
+            id = 'step-60-upgrade-automation'
+            action = 'upgrade-automation'
+            dependsOn = @('step-50-import-automation')
+            sources = @($autoSource)
+            targets = @('VCF Automation')
+            carries = @(
+                [ordered]@{ contentId = 'auto-vsphere-account'; method = 'fleet-import-and-in-place-upgrade' },
+                [ordered]@{ contentId = 'auto-nsx-policy-account'; method = 'fleet-import-and-in-place-upgrade' },
+                [ordered]@{ contentId = 'auto-project-platform'; method = 'fleet-import-and-in-place-upgrade' },
+                [ordered]@{ contentId = 'auto-template-linux'; method = 'fleet-import-and-in-place-upgrade' },
+                [ordered]@{ contentId = 'auto-subscription-cmdb'; method = 'fleet-import-and-in-place-upgrade' },
+                [ordered]@{ contentId = 'auto-abx-ipam'; method = 'fleet-import-and-in-place-upgrade' },
+                [ordered]@{ contentId = 'auto-custom-form-linux'; method = 'fleet-import-and-in-place-upgrade' },
+                [ordered]@{ contentId = 'auto-catalog-entitlement'; method = 'fleet-import-and-in-place-upgrade' },
+                [ordered]@{ contentId = 'auto-vro-workflow-dns'; method = 'fleet-import-and-in-place-upgrade' }
+            )
+            abandons = @()
+            gates = @(
+                (New-MigrationGate 'automation-import-complete' 'pre' 'Fleet Management shows the imported Automation instance with synchronized inventory.'),
+                (New-MigrationGate 'automation-precheck-clean' 'pre' 'The final VCF Automation upgrade precheck has no blocking findings.'),
+                (New-MigrationGate 'automation-services-healthy' 'post' 'VCF Automation services, deployments, catalog requests, and extensibility checks pass.')
+            )
+        },
+        [ordered]@{
+            order = 70
+            id = 'step-70-deploy-logs'
+            action = 'deploy-logs'
+            dependsOn = @('step-60-upgrade-automation')
+            sources = @($logsSource)
+            targets = @('VCF Operations for Logs')
+            carries = @()
+            abandons = @()
+            gates = @(
+                (New-MigrationGate 'logs-target-three-medium-nodes-healthy' 'post' 'Three medium target nodes and their virtual IP are healthy on distinct hosts.'),
+                (New-MigrationGate 'logs-parallel-run-active' 'post' 'Source and target Logs clusters run in parallel with rollback access preserved.')
+            )
+        },
+        [ordered]@{
+            order = 80
+            id = 'step-80-reconfigure-transfer-logs'
+            action = 'reconfigure-and-transfer-logs'
+            dependsOn = @('step-70-deploy-logs')
+            sources = @($logsSource)
+            targets = @('VCF Operations for Logs')
+            carries = @(
+                [ordered]@{ contentId = 'logs-vcenter-integration'; method = 'manual-reconfiguration' },
+                [ordered]@{ contentId = 'logs-nsx-integration'; method = 'manual-reconfiguration' },
+                [ordered]@{ contentId = 'logs-sddc-integration'; method = 'manual-reconfiguration' },
+                [ordered]@{ contentId = 'logs-alert-auth'; method = 'manual-recreation' },
+                [ordered]@{ contentId = 'logs-dashboard-security'; method = 'manual-recreation' },
+                [ordered]@{ contentId = 'logs-history-60d'; method = 'log-data-transfer' }
+            )
+            abandons = @()
+            gates = @(
+                (New-MigrationGate 'logs-integrations-recreated' 'post' 'All inventoried integrations, alerts, and dashboards are recreated and tested.'),
+                (New-MigrationGate 'sixty-day-transfer-complete' 'post' 'All sixty retained days complete the supported historical log data transfer.'),
+                (New-MigrationGate 'new-ingestion-validated' 'post' 'Ingestion rate, active connections, queries, alerts, and retention validate on target.')
+            )
+        },
+        [ordered]@{
+            order = 90
+            id = 'step-90-cutover-retire'
+            action = 'cutover-and-retire'
+            dependsOn = @('step-80-reconfigure-transfer-logs')
+            sources = @($opsSource, $autoSource, $logsSource)
+            targets = @('VCF Operations', 'VCF Automation', 'VCF Operations for Logs')
+            carries = @()
+            abandons = @(
+                [ordered]@{
+                    contentId = 'logs-windows-agent-legacy'
+                    method = 'replace-after-cutover'
+                    reasonCode = 'REPLACE_LEGACY_AGENT'
+                    reason = 'Legacy 8.18 agent binaries are replaced by the target-compatible agent after endpoint cutover.'
+                }
+            )
+            gates = @(
+                (New-MigrationGate 'operations-validation-pass' 'pre' 'Operations adapters, custom content, collection, alerts, and history validate.'),
+                (New-MigrationGate 'automation-validation-pass' 'pre' 'Automation catalog, deployments, accounts, workflows, subscriptions, and actions validate.'),
+                (New-MigrationGate 'logs-cutover-validated' 'pre' 'All senders use the target Logs virtual IP and expected event flow is sustained.'),
+                (New-MigrationGate 'rollback-window-closed' 'post' 'The agreed rollback observation window closes before source appliances are retired.')
+            )
+        }
+    )
+
+    $hosts = @($inventory.foundation.managementDomain.hosts | ForEach-Object { [string]$_.id })
+    $spec = [ordered]@{
+        schemaVersion = '1.0'
+        designId = "$( $inventory.estateId )-vcf9-migration"
+        generatedBy = [ordered]@{
+            moduleName = 'VcfAriaMigration'
+            functionName = 'New-VcfAriaMigrationInstallerSpec'
+            sdkModules = $requiredSdkModules
+        }
+        topology = [ordered]@{
+            siteId = [string]$inventory.site.id
+            deploymentModel = [string]$inventory.foundation.deploymentModel
+            managementDomain = [ordered]@{
+                name = [string]$inventory.foundation.managementDomain.name
+                cluster = [string]$inventory.foundation.managementDomain.cluster
+                hostCount = $hosts.Count
+                storage = [string]$inventory.foundation.managementDomain.storage
+                hosts = $hosts
+            }
+            peakSuiteDemand = [ordered]@{
+                vcpu = $targetVcpu + ($logs.deployment.nodes * $logs.deployment.vcpuPerNode)
+                memoryGb = $targetMemory + ($logs.deployment.nodes * $logs.deployment.memoryGbPerNode)
+                storageGb = $targetStorage + $logs.deployment.dataStorageGb
+                includesParallelLogs = $true
+            }
+        }
+        supportBoundaries = @($snapshot.productRules | ForEach-Object {
+            [ordered]@{
+                sourceId = [string]$_.sourceId
+                sourceProduct = [string]$_.sourceProduct
+                sourceVersion = [string]$_.sourceVersion
+                targetComponent = [string]$_.targetComponent
+                targetVersion = [string]$_.targetVersion
+                transitionMode = [string]$_.transitionMode
+                endOfGeneralSupport = [string]$_.endOfGeneralSupport
+            }
+        })
+        targetComponents = @(
+            [ordered]@{
+                component = 'VCF Operations'; version = [string]$snapshot.targetRelease
+                deploymentModel = [string]$opsSize.deploymentModel; preset = [string]$opsSize.preset
+                nodeCount = [int]$opsSize.nodeCount; vcpuPerNode = [int]$opsSize.vcpuPerNode
+                memoryGbPerNode = [int]$opsSize.memoryGbPerNode; dataDiskGbPerNode = [int]$opsSize.dataDiskGbPerNode
+                placement = @([ordered]@{ node = 'vcf-ops-01'; host = $hosts[0] })
+                sizingBasis = 'Small production node provides headroom above 640 objects and 120000 collected metrics.'
+            },
+            [ordered]@{
+                component = 'VCF Automation'; version = [string]$snapshot.targetRelease
+                deploymentModel = [string]$autoSize.deploymentModel; preset = [string]$autoSize.preset
+                nodeCount = [int]$autoSize.nodeCount; vcpuPerNode = [int]$autoSize.vcpuPerNode
+                memoryGbPerNode = [int]$autoSize.memoryGbPerNode; dataDiskGbPerNode = [int]$autoSize.dataDiskGbPerNode
+                placement = @([ordered]@{ node = 'vcf-auto-01'; host = $hosts[1] })
+                sizingBasis = 'Small simple deployment covers the inventoried request and managed-deployment load.'
+            },
+            [ordered]@{
+                component = 'VCF Operations for Logs'; version = [string]$snapshot.targetRelease
+                deploymentModel = [string]$logsSize.deploymentModel; preset = [string]$logsSize.preset
+                nodeCount = [int]$logsSize.nodeCount; vcpuPerNode = [int]$logsSize.vcpuPerNode
+                memoryGbPerNode = [int]$logsSize.memoryGbPerNode; dataDiskGbPerNode = [int]$logsSize.dataDiskGbPerNode
+                placement = @(
+                    [ordered]@{ node = 'vcf-logs-01'; host = $hosts[0] },
+                    [ordered]@{ node = 'vcf-logs-02'; host = $hosts[1] },
+                    [ordered]@{ node = 'vcf-logs-03'; host = $hosts[2] }
+                )
+                sizingBasis = 'Three medium production nodes support 45 GB/day, 180 connections, and the retained-data transfer.'
+            }
+        )
+        steps = $steps
+    }
+
+    $parent = Split-Path -Parent $OutputPath
+    if ($parent -and -not (Test-Path -LiteralPath $parent)) {
+        New-Item -ItemType Directory -Path $parent -Force | Out-Null
+    }
+    $json = $spec | ConvertTo-Json -Depth 100
+    if (-not ($json | Test-Json -SchemaFile $SchemaPath -ErrorAction Stop)) {
+        throw 'Generated installer specification does not validate against SchemaPath.'
+    }
+    [System.IO.File]::WriteAllText([System.IO.Path]::GetFullPath($OutputPath), $json, [System.Text.UTF8Encoding]::new($false))
+    Get-Item -LiteralPath $OutputPath
+}
+
+Export-ModuleMember -Function New-VcfAriaMigrationInstallerSpec

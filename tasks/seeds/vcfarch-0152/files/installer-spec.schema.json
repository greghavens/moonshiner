{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0152:installer-spec",
  "title": "VCF Aria Migration Installer Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "designId", "generatedBy", "topology", "supportBoundaries", "targetComponents", "steps"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "designId": {"type": "string", "minLength": 1},
    "generatedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleName", "functionName", "sdkModules"],
      "properties": {
        "moduleName": {"const": "VcfAriaMigration"},
        "functionName": {"const": "New-VcfAriaMigrationInstallerSpec"},
        "sdkModules": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["siteId", "deploymentModel", "managementDomain", "peakSuiteDemand"],
      "properties": {
        "siteId": {"type": "string", "minLength": 1},
        "deploymentModel": {"const": "single-site-consolidated"},
        "managementDomain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "cluster", "hostCount", "storage", "hosts"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "cluster": {"type": "string", "minLength": 1},
            "hostCount": {"type": "integer", "minimum": 1},
            "storage": {"type": "string", "minLength": 1},
            "hosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "peakSuiteDemand": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vcpu", "memoryGb", "storageGb", "includesParallelLogs"],
          "properties": {
            "vcpu": {"type": "integer", "minimum": 1},
            "memoryGb": {"type": "integer", "minimum": 1},
            "storageGb": {"type": "integer", "minimum": 1},
            "includesParallelLogs": {"const": true}
          }
        }
      }
    },
    "supportBoundaries": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "sourceProduct", "sourceVersion", "targetComponent", "targetVersion", "transitionMode", "endOfGeneralSupport"],
        "properties": {
          "sourceId": {"type": "string", "minLength": 1},
          "sourceProduct": {"type": "string", "minLength": 1},
          "sourceVersion": {"type": "string", "minLength": 1},
          "targetComponent": {"enum": ["VCF Operations", "VCF Automation", "VCF Operations for Logs"]},
          "targetVersion": {"type": "string", "minLength": 1},
          "transitionMode": {"enum": ["in-place-upgrade", "fleet-import-then-in-place-upgrade", "fresh-parallel-deployment"]},
          "endOfGeneralSupport": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
        }
      }
    },
    "targetComponents": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "version", "deploymentModel", "preset", "nodeCount", "vcpuPerNode", "memoryGbPerNode", "dataDiskGbPerNode", "placement", "sizingBasis"],
        "properties": {
          "component": {"enum": ["VCF Operations", "VCF Automation", "VCF Operations for Logs"]},
          "version": {"type": "string", "minLength": 1},
          "deploymentModel": {"enum": ["simple", "clustered"]},
          "preset": {"enum": ["small", "medium", "large"]},
          "nodeCount": {"type": "integer", "minimum": 1},
          "vcpuPerNode": {"type": "integer", "minimum": 1},
          "memoryGbPerNode": {"type": "integer", "minimum": 1},
          "dataDiskGbPerNode": {"type": "integer", "minimum": 1},
          "placement": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["node", "host"],
              "properties": {
                "node": {"type": "string", "minLength": 1},
                "host": {"type": "string", "minLength": 1}
              }
            }
          },
          "sizingBasis": {"type": "string", "minLength": 1}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "id", "action", "dependsOn", "sources", "targets", "carries", "abandons", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "action": {"enum": ["assess-and-back-up", "patch-lifecycle", "upgrade-operations", "remediate-automation", "import-automation", "upgrade-automation", "deploy-logs", "reconfigure-and-transfer-logs", "cutover-and-retire"]},
          "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceId", "product", "version"],
              "properties": {
                "sourceId": {"type": "string", "minLength": 1},
                "product": {"type": "string", "minLength": 1},
                "version": {"type": "string", "minLength": 1}
              }
            }
          },
          "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["VCF Operations", "VCF Automation", "VCF Operations for Logs"]}},
          "carries": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["contentId", "method"],
              "properties": {
                "contentId": {"type": "string", "minLength": 1},
                "method": {"type": "string", "minLength": 1}
              }
            }
          },
          "abandons": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["contentId", "method", "reasonCode", "reason"],
              "properties": {
                "contentId": {"type": "string", "minLength": 1},
                "method": {"type": "string", "minLength": 1},
                "reasonCode": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
                "reason": {"type": "string", "minLength": 12}
              }
            }
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "when", "assertion"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
                "when": {"enum": ["pre", "post"]},
                "assertion": {"type": "string", "minLength": 12}
              }
            }
          }
        }
      }
    }
  }
}

+#!/usr/bin/env python3
+"""Reference proof using concurrent genuine coursectl processes."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+TARGETS = (
+    ("Microeconomics 112", "Downtown", "2026-11-13"),
+    ("Modern History 112", "North Campus", "2026-11-13"),
+)
+
+
+def command(scope: tuple[str, str, str]) -> list[str]:
+    course, campus, service_date = scope
+    return [
+        "./coursectl",
+        "availability",
+        "--course",
+        course,
+        "--campus",
+        campus,
+        "--date",
+        service_date,
+    ]
+
+
+def decode_success(stdout: str) -> dict[str, Any]:
+    payload = json.loads(stdout)
+    if not isinstance(payload, dict) or not isinstance(payload.get("record"), dict):
+        raise RuntimeError("coursectl returned an invalid success payload")
+    return payload["record"]
+
+
+def decode_error(stderr: str) -> dict[str, Any]:
+    payload = json.loads(stderr)
+    if not isinstance(payload, dict) or not isinstance(payload.get("error"), dict):
+        raise RuntimeError("coursectl returned an invalid error payload")
+    return payload["error"]
+
+
+def main() -> int:
+    subprocess.run(
+        ["./coursectl", "--help"],
+        cwd=ROOT,
+        check=True,
+        stdout=subprocess.DEVNULL,
+    )
+
+    processes = [
+        subprocess.Popen(
+            command(scope),
+            cwd=ROOT,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for scope in TARGETS
+    ]
+    outcomes = [process.communicate(timeout=15) for process in processes]
+
+    records: list[dict[str, Any] | None] = [None, None]
+    transient_index: int | None = None
+    for index, (process, (stdout, stderr)) in enumerate(zip(processes, outcomes, strict=True)):
+        if process.returncode == 0:
+            records[index] = decode_success(stdout)
+            continue
+        error = decode_error(stderr)
+        if (
+            process.returncode == 75
+            and error.get("code") == "TRANSIENT_SERVICE_ERROR"
+            and error.get("retryable") is True
+            and transient_index is None
+        ):
+            transient_index = index
+            continue
+        raise RuntimeError("initial availability check had an unexpected outcome")
+
+    if transient_index is None or sum(record is not None for record in records) != 1:
+        raise RuntimeError("expected exactly one successful and one transient initial result")
+
+    retried = subprocess.run(
+        command(TARGETS[transient_index]),
+        cwd=ROOT,
+        check=False,
+        capture_output=True,
+        text=True,
+        timeout=15,
+    )
+    if retried.returncode != 0:
+        raise RuntimeError(retried.stderr.strip() or "coursectl retry failed")
+    records[transient_index] = decode_success(retried.stdout)
+
+    if any(record is None for record in records):
+        raise RuntimeError("a requested course has no successful availability record")
+    complete = [record for record in records if record is not None]
+    lines = [
+        f"{record['course']} | {record['campus']} | {record['date']} | "
+        f"{record['availability']} | seats {record['seats_available']}"
+        for record in complete
+    ]
+    (ROOT / "availability-report.txt").write_text(
+        "\n".join(lines) + "\n", encoding="utf-8"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

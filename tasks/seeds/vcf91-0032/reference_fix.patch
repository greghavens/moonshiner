+
+func findWorkflowEvidence(
+	value any,
+	taskID string,
+	referenceTokens map[string]struct{},
+) []string {
+	matches := make([]string, 0, 1)
+	var walk func(any)
+	walk = func(current any) {
+		switch typed := current.(type) {
+		case map[string]any:
+			if id, _ := typed["id"].(string); id == taskID {
+				var walkErrors func(any)
+				walkErrors = func(candidate any) {
+					switch errorValue := candidate.(type) {
+					case map[string]any:
+						token, _ := errorValue["referenceToken"].(string)
+						code, _ := errorValue["errorCode"].(string)
+						message, _ := errorValue["message"].(string)
+						if _, ok := referenceTokens[token]; ok &&
+							strings.TrimSpace(code) != "" &&
+							strings.TrimSpace(message) != "" {
+							matches = append(matches, message)
+						}
+						for _, nested := range errorValue {
+							walkErrors(nested)
+						}
+					case []any:
+						for _, nested := range errorValue {
+							walkErrors(nested)
+						}
+					}
+				}
+				walkErrors(typed["errors"])
+			}
+			for _, nested := range typed {
+				walk(nested)
+			}
+		case []any:
+			for _, nested := range typed {
+				walk(nested)
+			}
+		}
+	}
+	walk(value)
+	return matches
+}
+
+func normalizeStatus(status string) string {
+	return strings.ReplaceAll(strings.ToUpper(strings.TrimSpace(status)), " ", "_")

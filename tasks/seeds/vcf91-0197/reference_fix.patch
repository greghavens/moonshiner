--- a/src/VcfInstaller.Proxy.psm1
+++ b/src/VcfInstaller.Proxy.psm1
@@ -31,7 +31,82 @@
         [int] $TimeoutSeconds = 300
     )
 
-    throw 'Set-VcfInstallerProxyConfiguration has not been implemented.'
+    $proxyArguments = @{
+        IsEnabled = $IsEnabled
+    }
+    $optionalProperties = @{
+        ProxyHost      = 'VarHost'
+        Port           = 'Port'
+        TransferProtocol = 'TransferProtocol'
+        Username       = 'Username'
+        Password       = 'Password'
+        IsAuthenticated = 'IsAuthenticated'
+    }
+    foreach ($parameterName in $optionalProperties.Keys) {
+        if ($PSBoundParameters.ContainsKey($parameterName)) {
+            $propertyName = $optionalProperties[$parameterName]
+            $proxyArguments[$propertyName] = $PSBoundParameters[$parameterName]
+        }
+    }
+
+    $proxyConfiguration = Initialize-VcfInstallerProxyConfiguration @proxyArguments
+    $submittedTask = Invoke-VcfInstallerUpdateProxyConfiguration `
+        -ProxyConfiguration $proxyConfiguration `
+        -Server $Server
+
+    $taskId = [string] $submittedTask.Id
+    if ([string]::IsNullOrWhiteSpace($taskId)) {
+        throw [System.InvalidOperationException]::new(
+            'updateProxyConfiguration returned no task id.'
+        )
+    }
+
+    $nonTerminalStatuses = @('PENDING', 'IN_PROGRESS', 'QUEUED')
+    $terminalStatuses = @(
+        'SUCCESSFUL',
+        'FAILED',
+        'CANCELLED',
+        'COMPLETED_WITH_WARNING',
+        'SKIPPED',
+        'TIMED_OUT'
+    )
+    $timer = [System.Diagnostics.Stopwatch]::StartNew()
+
+    while ($true) {
+        if ($timer.Elapsed.TotalSeconds -ge $TimeoutSeconds) {
+            throw [System.TimeoutException]::new(
+                "Timed out waiting for VCF Installer task '$taskId'."
+            )
+        }
+
+        $task = Invoke-VcfInstallerGetTask -Id $taskId -Server $Server
+        $normalizedStatus = (([string] $task.Status).Trim() -replace '\s+', '_').ToUpperInvariant()
+
+        if ($terminalStatuses -contains $normalizedStatus) {
+            return $task
+        }
+        if ($nonTerminalStatuses -notcontains $normalizedStatus) {
+            throw [System.InvalidOperationException]::new(
+                "VCF Installer task '$taskId' returned unexpected status '$($task.Status)'."
+            )
+        }
+
+        $remainingMilliseconds = [math]::Floor(
+            ($TimeoutSeconds - $timer.Elapsed.TotalSeconds) * 1000
+        )
+        if ($remainingMilliseconds -le 0) {
+            throw [System.TimeoutException]::new(
+                "Timed out waiting for VCF Installer task '$taskId'."
+            )
+        }
+        if ($PollIntervalSeconds -gt 0) {
+            $sleepMilliseconds = [math]::Min(
+                $PollIntervalSeconds * 1000,
+                $remainingMilliseconds
+            )
+            Start-Sleep -Milliseconds ([int] $sleepMilliseconds)
+        }
+    }
 }
 
 Export-ModuleMember -Function Set-VcfInstallerProxyConfiguration

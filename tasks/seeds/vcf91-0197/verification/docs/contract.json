{
  "openapiVersion": "3.0.1",
  "apiVersion": "9.1.0.0",
  "derivedFrom": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commitSha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "specPath": "specifications/vcf-installer/vcf-installer-openapi.json"
  },
  "schemaProjection": "Direct wire fields for the selected operations; referenced supporting models retain their specification schema names.",
  "operationIds": [
    "createToken",
    "getApplianceInfo",
    "updateProxyConfiguration",
    "getTask"
  ],
  "operations": {
    "createToken": {
      "method": "POST",
      "path": "/v1/tokens",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "TokenCreationSpec"
      },
      "responses": {
        "201": "TokenPair",
        "400": "Error",
        "500": "Error"
      }
    },
    "getApplianceInfo": {
      "method": "GET",
      "path": "/v1/system/appliance-info",
      "responses": {
        "200": "ApplianceInfo",
        "500": "Error"
      }
    },
    "updateProxyConfiguration": {
      "method": "PATCH",
      "path": "/v1/system/proxy-configuration",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "ProxyConfiguration"
      },
      "responses": {
        "202": "Task",
        "400": "Error",
        "500": null
      }
    },
    "getTask": {
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": "Task",
        "404": "Error",
        "500": "Error"
      }
    }
  },
  "schemas": {
    "TokenCreationSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" },
        "apiKey": { "type": "string" },
        "idToken": { "type": "string" }
      }
    },
    "TokenPair": {
      "type": "object",
      "required": [],
      "properties": {
        "accessToken": { "type": "string" },
        "refreshToken": { "$ref": "RefreshToken" }
      }
    },
    "RefreshToken": {
      "type": "object",
      "required": [],
      "properties": {
        "id": { "type": "string" }
      }
    },
    "ApplianceInfo": {
      "type": "object",
      "required": [],
      "properties": {
        "role": { "type": "string" },
        "version": { "type": "string" },
        "dnsDomain": { "type": "string" },
        "dnsServers": { "type": "array", "items": { "type": "string" } },
        "ntpServers": { "type": "array", "items": { "type": "string" } },
        "ipAddresses": { "type": "array", "items": { "$ref": "IpAddress" } }
      }
    },
    "IpAddress": {
      "type": "object",
      "required": [],
      "properties": {
        "ipAddress": { "type": "string", "readOnly": true },
        "type": { "type": "string", "readOnly": true },
        "ipAddressVersion": { "type": "string", "readOnly": true }
      }
    },
    "ProxyConfiguration": {
      "type": "object",
      "required": [],
      "properties": {
        "isConfigured": { "type": "boolean", "readOnly": true },
        "isEnabled": { "type": "boolean" },
        "host": { "type": "string" },
        "port": { "type": "integer", "format": "int32" },
        "transferProtocol": { "type": "string", "enum": ["HTTP", "HTTPS"] },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "isAuthenticated": { "type": "boolean" }
      }
    },
    "Task": {
      "type": "object",
      "required": ["creationTimestamp", "id", "name", "status"],
      "properties": {
        "id": { "type": "string", "readOnly": true },
        "name": { "type": "string", "readOnly": true },
        "localizableDescriptionPack": { "$ref": "MessagePack" },
        "type": { "type": "string", "readOnly": true },
        "status": { "type": "string", "readOnly": true },
        "creationTimestamp": { "type": "string", "readOnly": true },
        "completionTimestamp": { "type": "string", "readOnly": true },
        "subTasks": { "type": "array", "readOnly": true, "items": { "$ref": "SubTask" } },
        "errors": { "type": "array", "readOnly": true, "items": { "$ref": "Error" } },
        "resources": { "type": "array", "readOnly": true, "items": { "$ref": "Resource" } },
        "resolutionStatus": { "type": "string", "readOnly": true },
        "isCancellable": { "type": "boolean", "readOnly": true },
        "isRetryable": { "type": "boolean", "readOnly": true }
      },
      "statusValuesFromSpecExample": [
        "PENDING",
        "IN_PROGRESS",
        "SUCCESSFUL",
        "FAILED",
        "CANCELLED",
        "COMPLETED_WITH_WARNING",
        "SKIPPED",
        "QUEUED",
        "TIMED_OUT"
      ]
    }
  },
  "polling": {
    "submitOperationId": "updateProxyConfiguration",
    "statusOperationId": "getTask",
    "taskIdProperty": "id",
    "statusProperty": "status",
    "nonTerminalStatuses": ["PENDING", "IN_PROGRESS", "QUEUED"],
    "terminalStatuses": [
      "SUCCESSFUL",
      "FAILED",
      "CANCELLED",
      "COMPLETED_WITH_WARNING",
      "SKIPPED",
      "TIMED_OUT"
    ]
  }
}

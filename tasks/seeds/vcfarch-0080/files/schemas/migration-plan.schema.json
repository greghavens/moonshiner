{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0080:migration-plan:1",
  "title": "VCF brownfield ordered migration plan",
  "type": "object",
  "required": [
    "schema_version",
    "estate_id",
    "source_vcf_version",
    "target_vcf_version",
    "target_sddc_spec",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "estate_id": {
      "type": "string",
      "minLength": 1
    },
    "source_vcf_version": {
      "type": "string",
      "minLength": 1
    },
    "target_vcf_version": {
      "type": "string",
      "minLength": 1
    },
    "target_sddc_spec": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "component_id",
          "component_name",
          "current_version",
          "target_version",
          "action",
          "gates"
        ],
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "description": "Ordered execution stage. Transitions performed by one atomic product workflow use the same value."
          },
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "component_name": {
            "type": "string",
            "minLength": 1
          },
          "current_version": {
            "type": "string",
            "minLength": 1
          },
          "target_version": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "patch",
              "upgrade",
              "deploy",
              "replace",
              "retire"
            ]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "condition",
                "requires_completed_steps"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "condition": {
                  "type": "string",
                  "minLength": 1
                },
                "requires_completed_steps": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

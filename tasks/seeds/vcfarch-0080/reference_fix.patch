diff --git a/vcf_architecture/__init__.py b/vcf_architecture/__init__.py
new file mode 100644
index 0000000..fa80e17
--- /dev/null
+++ b/vcf_architecture/__init__.py
@@ -0,0 +1,217 @@
+"""Build the ordered architecture for the supplied VCF estate inventory."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any
+
+
+GATE_CONDITIONS = {
+    "source-baseline-confirmed": (
+        "Inventory versions match the VCF 5.2.1.0 source baseline and platform "
+        "upgrade prechecks pass."
+    ),
+    "lifecycle-patch2-active": (
+        "Aria Suite Lifecycle 8.18 Patch 2 is installed before any VCF 9 "
+        "management-component transition; the Operations upgrade will deploy Fleet "
+        "Management as part of the same workflow."
+    ),
+    "fleet-management-active": (
+        "VCF Operations Fleet Management 9.0.1.0 is deployed and healthy."
+    ),
+    "logs-target-active": (
+        "A fresh VCF Operations for Logs 9.0.1.0 deployment is active; no in-place "
+        "Logs 8.x upgrade is attempted."
+    ),
+    "log-handoff-complete": (
+        "Existing log integrations are moved to the fresh 9.0.1.0 deployment and "
+        "any transferred history is limited to the supported 90-day window."
+    ),
+    "management-products-at-target": (
+        "Aria Operations is at 9.0.1.0 and the Logs replacement is complete before "
+        "retiring Aria Suite Lifecycle."
+    ),
+    "legacy-boundary-cleared": (
+        "Aria Suite Lifecycle and Aria Operations for Logs 8.x are retired after "
+        "their replacement workflows complete."
+    ),
+    "sddc-manager-at-target": (
+        "SDDC Manager is at 9.0.1.0 before the NSX transition begins."
+    ),
+    "nsx-at-target": (
+        "VMware NSX is at 9.0.1.0 before the vCenter transition begins."
+    ),
+    "vcenter-at-target": (
+        "VMware vCenter Server is at 9.0.1.0 before the ESXi transition begins."
+    ),
+}
+
+GATE_DEPENDENCIES = {
+    "source-baseline-confirmed": (),
+    "lifecycle-patch2-active": (1,),
+    "fleet-management-active": (2,),
+    "logs-target-active": (3,),
+    "log-handoff-complete": (),
+    "management-products-at-target": (2, 4),
+    "legacy-boundary-cleared": (4, 5),
+    "sddc-manager-at-target": (6,),
+    "nsx-at-target": (7,),
+    "vcenter-at-target": (8,),
+}
+
+
+TRANSITIONS = (
+    (
+        1,
+        "aria-suite-lifecycle",
+        "8.18.0-24029603",
+        "8.18.0-patch2",
+        "patch",
+        ("source-baseline-confirmed",),
+    ),
+    (
+        2,
+        "vcf-operations-fleet-management",
+        "not-deployed",
+        "9.0.1.0",
+        "deploy",
+        ("lifecycle-patch2-active",),
+    ),
+    (
+        2,
+        "aria-operations",
+        "8.18.4",
+        "9.0.1.0",
+        "upgrade",
+        ("lifecycle-patch2-active",),
+    ),
+    (
+        3,
+        "vcf-operations-for-logs",
+        "not-deployed",
+        "9.0.1.0",
+        "deploy",
+        ("fleet-management-active",),
+    ),
+    (
+        4,
+        "aria-operations-for-logs",
+        "8.18.2",
+        "retired",
+        "replace",
+        ("logs-target-active", "log-handoff-complete"),
+    ),
+    (
+        5,
+        "aria-suite-lifecycle",
+        "8.18.0-patch2",
+        "retired",
+        "retire",
+        ("management-products-at-target",),
+    ),
+    (
+        6,
+        "sddc-manager",
+        "5.2.1.0-24307856",
+        "9.0.1.0",
+        "upgrade",
+        ("legacy-boundary-cleared",),
+    ),
+    (
+        7,
+        "nsx-manager",
+        "4.2.1.0.0-24304122",
+        "9.0.1.0",
+        "upgrade",
+        ("sddc-manager-at-target",),
+    ),
+    (
+        8,
+        "vcenter-server",
+        "8.0.3.00100-24091160",
+        "9.0.1.0",
+        "upgrade",
+        ("nsx-at-target",),
+    ),
+    (
+        9,
+        "esxi",
+        "8.0.3-24280767",
+        "9.0.1.0",
+        "upgrade",
+        ("vcenter-at-target",),
+    ),
+)
+
+
+def build_architecture(inventory: dict[str, Any]) -> dict[str, Any]:
+    """Return the migration architecture represented by *inventory*."""
+    components = {item["id"]: item for item in inventory["components"]}
+    steps = []
+    for transition in TRANSITIONS:
+        sequence, component_id, current, target, action, gate_ids = transition
+        steps.append(
+            {
+                "sequence": sequence,
+                "component_id": component_id,
+                "component_name": components[component_id]["name"],
+                "current_version": current,
+                "target_version": target,
+                "action": action,
+                "gates": [
+                    {
+                        "id": gate_id,
+                        "condition": GATE_CONDITIONS[gate_id],
+                        "requires_completed_steps": list(GATE_DEPENDENCIES[gate_id]),
+                    }
+                    for gate_id in gate_ids
+                ],
+            }
+        )
+
+    target_state = inventory["target_state"]
+    target_sddc_spec = {
+        "sddcId": target_state["sddc_id"],
+        "workflowType": target_state["workflow_type"],
+        "version": inventory["target_vcf_version"],
+        "vcenterSpec": {
+            "vcenterHostname": target_state["vcenter_hostname"],
+            "rootVcenterPassword": "Replace!1Aa",
+            "version": components["vcenter-server"]["current_version"],
+            "useExistingDeployment": True,
+        },
+        "networkSpecs": [dict(target_state["management_network"])],
+        "dnsSpec": {
+            "subdomain": target_state["dns_subdomain"],
+            "nameservers": list(target_state["dns_nameservers"]),
+        },
+    }
+    return {
+        "schema_version": "1.0",
+        "estate_id": inventory["estate_id"],
+        "source_vcf_version": inventory["source_vcf_version"],
+        "target_vcf_version": inventory["target_vcf_version"],
+        "target_sddc_spec": target_sddc_spec,
+        "steps": steps,
+    }
+
+
+def read_inventory(path: Path) -> dict[str, Any]:
+    with path.open("r", encoding="utf-8") as handle:
+        inventory = json.load(handle)
+    if not isinstance(inventory, dict):
+        raise ValueError("inventory root must be an object")
+    return inventory
+
+
+def write_architecture(inventory_path: Path, output_path: Path) -> None:
+    architecture = build_architecture(read_inventory(inventory_path))
+    output_path.parent.mkdir(parents=True, exist_ok=True)
+    output_path.write_text(
+        json.dumps(architecture, indent=2, ensure_ascii=False) + "\n",
+        encoding="utf-8",
+    )
+
+
+__all__ = ["build_architecture", "read_inventory", "write_architecture"]
diff --git a/vcf_architecture/__main__.py b/vcf_architecture/__main__.py
new file mode 100644
index 0000000..5e62d95
--- /dev/null
+++ b/vcf_architecture/__main__.py
@@ -0,0 +1,21 @@
+"""Command-line entry point for the VCF migration architecture builder."""
+
+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+
+from vcf_architecture import write_architecture
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description="Build a VCF brownfield migration plan")
+    parser.add_argument("--inventory", required=True, type=Path)
+    parser.add_argument("--output", required=True, type=Path)
+    args = parser.parse_args()
+    write_architecture(args.inventory, args.output)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

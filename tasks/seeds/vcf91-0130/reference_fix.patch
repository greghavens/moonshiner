+Set-StrictMode -Version Latest
+
+function Test-VcfHeaderValue {
+    param(
+        [AllowNull()]
+        [string] $Value
+    )
+
+    if ([string]::IsNullOrWhiteSpace($Value)) {
+        return $false
+    }
+    foreach ($Character in $Value.ToCharArray()) {
+        $Code = [int] $Character
+        if ($Code -lt 32 -or $Code -eq 127) {
+            return $false
+        }
+    }
+    return $true
+}
+
+function New-VcfHttpClient {
+    $Handler = [System.Net.Http.HttpClientHandler]::new()
+    $Handler.AllowAutoRedirect = $false
+    $Handler.UseProxy = $false
+    return [System.Net.Http.HttpClient]::new($Handler, $true)
+}
+
+function New-VcfVksNamespaceSession {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        $Server,
+
+        [Parameter(Mandatory)]
+        [string] $AccessToken,
+
+        [Parameter(Mandatory)]
+        [scriptblock] $RefreshConnection,
+
+        [scriptblock] $OperationInvoker,
+
+        [Net.Http.HttpClient] $HttpClient
+    )
+
+    if ($null -eq $Server) {
+        throw [ArgumentNullException]::new('Server')
+    }
+    if (-not (Test-VcfHeaderValue -Value $AccessToken)) {
+        throw [ArgumentException]::new(
+            'AccessToken must be nonblank and safe for an HTTP header.',
+            'AccessToken'
+        )
+    }
+    if ($null -eq $RefreshConnection) {
+        throw [ArgumentNullException]::new('RefreshConnection')
+    }
+
+    $OwnsHttpClient = $false
+    if ($null -eq $HttpClient) {
+        $HttpClient = New-VcfHttpClient
+        $OwnsHttpClient = $true
+    }
+
+    return [pscustomobject]@{
+        PSTypeName = 'VcfVksNamespaceInventory.Session'
+        Server = $Server
+        AccessToken = $AccessToken
+        RefreshConnection = $RefreshConnection
+        OperationInvoker = $OperationInvoker
+        HttpClient = $HttpClient
+        OwnsHttpClient = $OwnsHttpClient
+        RefreshUsed = $false
+        SyncRoot = [object]::new()
+    }
+}
+
+function Get-VcfAuthorizedNamespace {
+    param(
+        [Parameter(Mandatory)]
+        $Session
+    )
+
+    if ($null -eq $Session.OperationInvoker) {
+        Import-Module VMware.Sdk.vSphere `
+            -MinimumVersion 13.5.0.25380678 `
+            -ErrorAction Stop
+        $RawItems = @(
+            Invoke-VcenterNamespacesUserInstancesList `
+                -Server $Session.Server `
+                -ErrorAction Stop
+        )
+    }
+    else {
+        $Parameters = @{}
+        $RawItems = @(
+            & $Session.OperationInvoker `
+                'Vcenter.Namespaces.User.Instances_list' `
+                $Parameters `
+                $Session.Server
+        )
+    }
+
+    $Seen = [Collections.Generic.HashSet[string]]::new(
+        [StringComparer]::Ordinal
+    )
+    $Summaries = [Collections.Generic.List[object]]::new()
+    foreach ($Item in $RawItems) {
+        if ($null -eq $Item) {
+            throw [InvalidDataException]::new(
+                'The vCenter namespace response contained a null item.'
+            )
+        }
+        $NamespaceProperty = $Item.PSObject.Properties['namespace']
+        $EndpointProperty = $Item.PSObject.Properties['master_host']
+        if (
+            $null -eq $NamespaceProperty -or
+            $null -eq $EndpointProperty -or
+            [string]::IsNullOrWhiteSpace(
+                [string] $NamespaceProperty.Value
+            ) -or
+            [string]::IsNullOrWhiteSpace(
+                [string] $EndpointProperty.Value
+            )
+        ) {
+            throw [InvalidDataException]::new(
+                'The vCenter namespace response was malformed.'
+            )
+        }
+
+        $Namespace = [string] $NamespaceProperty.Value
+        if (-not $Seen.Add($Namespace)) {
+            throw [InvalidDataException]::new(
+                'The vCenter namespace response contained a duplicate.'
+            )
+        }
+
+        $EndpointText = [string] $EndpointProperty.Value
+        $Endpoint = $null
+        $IsAbsolute = [uri]::TryCreate(
+            $EndpointText,
+            [UriKind]::Absolute,
+            [ref] $Endpoint
+        )
+        if (-not $IsAbsolute) {
+            if (
+                $EndpointText.IndexOfAny(
+                    [char[]] @('/', '?', '#', '@', ' ', "`t")
+                ) -ge 0 -or
+                -not [uri]::TryCreate(
+                    'https://' + $EndpointText,
+                    [UriKind]::Absolute,
+                    [ref] $Endpoint
+                )
+            ) {
+                throw [InvalidDataException]::new(
+                    'A Supervisor endpoint was malformed.'
+                )
+            }
+        }
+        if (
+            $Endpoint.Scheme -cnotin @('http', 'https') -or
+            -not [string]::IsNullOrEmpty($Endpoint.UserInfo) -or
+            -not [string]::IsNullOrEmpty($Endpoint.Query) -or
+            -not [string]::IsNullOrEmpty($Endpoint.Fragment) -or
+            $Endpoint.AbsolutePath -cne '/'
+        ) {
+            throw [InvalidDataException]::new(
+                'A Supervisor endpoint was not an HTTP(S) origin.'
+            )
+        }
+
+        $Summaries.Add(
+            [pscustomobject]@{
+                Namespace = $Namespace
+                Endpoint = $Endpoint.AbsoluteUri.TrimEnd('/')
+            }
+        )
+    }
+
+    $SummaryArray = [object[]] $Summaries.ToArray()
+    $SummaryComparer = [Collections.Generic.Comparer[object]]::Create(
+        {
+            param($Left, $Right)
+            return [StringComparer]::Ordinal.Compare(
+                [string] $Left.Namespace,
+                [string] $Right.Namespace
+            )
+        }
+    )
+    [Array]::Sort($SummaryArray, $SummaryComparer)
+    return $SummaryArray
+}
+
+function Invoke-VcfKubernetesGet {
+    param(
+        [Parameter(Mandatory)]
+        $Session,
+
+        [Parameter(Mandatory)]
+        [uri] $Uri,
+
+        [Parameter(Mandatory)]
+        [string] $AccessToken
+    )
+
+    $Request = [System.Net.Http.HttpRequestMessage]::new(
+        [System.Net.Http.HttpMethod]::Get,
+        $Uri
+    )
+    try {
+        $Request.Headers.Accept.ParseAdd('application/json')
+        $Request.Headers.Authorization = (
+            [System.Net.Http.Headers.AuthenticationHeaderValue]::new(
+                'Bearer',
+                $AccessToken
+            )
+        )
+        try {
+            $Response = $Session.HttpClient.SendAsync($Request).
+                GetAwaiter().GetResult()
+        }
+        catch {
+            throw [InvalidOperationException]::new(
+                'The Kubernetes request could not be completed.'
+            )
+        }
+        try {
+            try {
+                $Bytes = $Response.Content.ReadAsByteArrayAsync().
+                    GetAwaiter().GetResult()
+            }
+            catch {
+                throw [InvalidOperationException]::new(
+                    'The Kubernetes response could not be read.'
+                )
+            }
+            return [pscustomobject]@{
+                StatusCode = [int] $Response.StatusCode
+                Bytes = [byte[]] $Bytes
+            }
+        }
+        finally {
+            $Response.Dispose()
+        }
+    }
+    finally {
+        $Request.Dispose()
+    }
+}
+
+function Update-VcfExpiredSession {
+    param(
+        [Parameter(Mandatory)]
+        $Session
+    )
+
+    if ([bool] $Session.RefreshUsed) {
+        throw [InvalidOperationException]::new(
+            'The replacement access token was rejected.'
+        )
+    }
+
+    $ExpiredServer = $Session.Server
+    $ExpiredToken = [string] $Session.AccessToken
+    try {
+        $Replacement = & $Session.RefreshConnection `
+            $ExpiredServer `
+            $ExpiredToken
+    }
+    catch {
+        throw [InvalidOperationException]::new(
+            'Credential refresh failed.'
+        )
+    }
+    if (
+        $null -eq $Replacement -or
+        $null -eq $Replacement.PSObject.Properties['Server'] -or
+        $null -eq $Replacement.Server -or
+        $null -eq $Replacement.PSObject.Properties['AccessToken'] -or
+        -not (
+            Test-VcfHeaderValue -Value (
+                [string] $Replacement.AccessToken
+            )
+        )
+    ) {
+        throw [InvalidOperationException]::new(
+            'Credential refresh returned an invalid replacement.'
+        )
+    }
+
+    [Threading.Monitor]::Enter($Session.SyncRoot)
+    try {
+        if ([bool] $Session.RefreshUsed) {
+            throw [InvalidOperationException]::new(
+                'The replacement access token was rejected.'
+            )
+        }
+        $Session.Server = $Replacement.Server
+        $Session.AccessToken = [string] $Replacement.AccessToken
+        $Session.RefreshUsed = $true
+    }
+    finally {
+        [Threading.Monitor]::Exit($Session.SyncRoot)
+    }
+}
+
+function ConvertFrom-VcfClusterList {
+    param(
+        [Parameter(Mandatory)]
+        [byte[]] $Bytes,
+
+        [Parameter(Mandatory)]
+        $Summary
+    )
+
+    try {
+        $Json = [Text.Encoding]::UTF8.GetString($Bytes)
+        $Payload = $Json | ConvertFrom-Json -Depth 100 -ErrorAction Stop
+    }
+    catch {
+        throw [InvalidDataException]::new(
+            'The Kubernetes success response was malformed.'
+        )
+    }
+    if (
+        $null -eq $Payload -or
+        [string] $Payload.apiVersion -cne (
+            'cluster.x-k8s.io/v1beta2'
+        ) -or
+        [string] $Payload.kind -cne 'ClusterList' -or
+        $null -eq $Payload.PSObject.Properties['items'] -or
+        $null -eq $Payload.items
+    ) {
+        throw [InvalidDataException]::new(
+            'The Kubernetes success response was not a ClusterList.'
+        )
+    }
+
+    $Seen = [Collections.Generic.HashSet[string]]::new(
+        [StringComparer]::Ordinal
+    )
+    $Rows = [Collections.Generic.List[object]]::new()
+    foreach ($Item in @($Payload.items)) {
+        if (
+            $null -eq $Item -or
+            [string] $Item.apiVersion -cne (
+                'cluster.x-k8s.io/v1beta2'
+            ) -or
+            [string] $Item.kind -cne 'Cluster' -or
+            $null -eq $Item.metadata -or
+            $null -eq $Item.spec -or
+            $null -eq $Item.spec.topology -or
+            $null -eq $Item.status
+        ) {
+            throw [InvalidDataException]::new(
+                'A Kubernetes Cluster item was malformed.'
+            )
+        }
+        $Name = [string] $Item.metadata.name
+        $Namespace = [string] $Item.metadata.namespace
+        $Uid = [string] $Item.metadata.uid
+        $Version = [string] $Item.spec.topology.version
+        $Phase = [string] $Item.status.phase
+        if (
+            [string]::IsNullOrWhiteSpace($Name) -or
+            [string]::IsNullOrWhiteSpace($Namespace) -or
+            [string]::IsNullOrWhiteSpace($Uid) -or
+            [string]::IsNullOrWhiteSpace($Version) -or
+            [string]::IsNullOrWhiteSpace($Phase) -or
+            $Namespace -cne [string] $Summary.Namespace
+        ) {
+            throw [InvalidDataException]::new(
+                'A Kubernetes Cluster item was incomplete.'
+            )
+        }
+        if (-not $Seen.Add($Name)) {
+            throw [InvalidDataException]::new(
+                'A Kubernetes ClusterList contained a duplicate name.'
+            )
+        }
+        $Rows.Add(
+            [pscustomobject][ordered]@{
+                SupervisorNamespace = [string] $Summary.Namespace
+                SupervisorEndpoint = [string] $Summary.Endpoint
+                Name = $Name
+                Uid = $Uid
+                KubernetesVersion = $Version
+                Phase = $Phase
+            }
+        )
+    }
+    return [object[]] $Rows.ToArray()
+}
+
+function Get-VcfVksClusterInventory {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        $Session
+    )
+
+    if (
+        $null -eq $Session -or
+        $Session.PSObject.TypeNames -cnotcontains (
+            'VcfVksNamespaceInventory.Session'
+        )
+    ) {
+        throw [ArgumentException]::new(
+            'Session was not created by New-VcfVksNamespaceSession.',
+            'Session'
+        )
+    }
+
+    $Namespaces = @(Get-VcfAuthorizedNamespace -Session $Session)
+    $AllRows = [Collections.Generic.List[object]]::new()
+    foreach ($Summary in $Namespaces) {
+        $Segment = [uri]::EscapeDataString(
+            [string] $Summary.Namespace
+        )
+        $Target = [uri] (
+            [string] $Summary.Endpoint +
+            '/apis/cluster.x-k8s.io/v1beta2/namespaces/' +
+            $Segment +
+            '/clusters'
+        )
+        $Attempt = Invoke-VcfKubernetesGet `
+            -Session $Session `
+            -Uri $Target `
+            -AccessToken ([string] $Session.AccessToken
+            )
+        if ($Attempt.StatusCode -eq 401) {
+            Update-VcfExpiredSession -Session $Session
+            $Attempt = Invoke-VcfKubernetesGet `
+                -Session $Session `
+                -Uri $Target `
+                -AccessToken ([string] $Session.AccessToken
+                )
+        }
+        if ($Attempt.StatusCode -ne 200) {
+            throw [InvalidOperationException]::new(
+                "The Kubernetes operation failed with HTTP " +
+                "$($Attempt.StatusCode)."
+            )
+        }
+        foreach ($Row in @(
+            ConvertFrom-VcfClusterList `
+                -Bytes $Attempt.Bytes `
+                -Summary $Summary
+        )) {
+            $AllRows.Add($Row)
+        }
+    }
+
+    $Result = [object[]] $AllRows.ToArray()
+    $ResultComparer = [Collections.Generic.Comparer[object]]::Create(
+        {
+            param($Left, $Right)
+            $Compared = [StringComparer]::Ordinal.Compare(
+                [string] $Left.SupervisorNamespace,
+                [string] $Right.SupervisorNamespace
+            )
+            if ($Compared -ne 0) {
+                return $Compared
+            }
+            return [StringComparer]::Ordinal.Compare(
+                [string] $Left.Name,
+                [string] $Right.Name
+            )
+        }
+    )
+    [Array]::Sort($Result, $ResultComparer)
+    $ReadOnly = (
+        [Collections.ObjectModel.ReadOnlyCollection[object]]::new(
+            $Result
+        )
+    )
+    Write-Output -NoEnumerate $ReadOnly
+}
+
+Export-ModuleMember -Function @(
+    'New-VcfVksNamespaceSession',
+    'Get-VcfVksClusterInventory'
+)

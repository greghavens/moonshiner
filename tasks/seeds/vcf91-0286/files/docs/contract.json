  "focusedWorkflow": {
    "goal": "Create one VCF Operations for networks application with its tiers so that repeating the call leaves exactly one application. The specification documents no conflict response for addApplicationWithTiers, so a repeated POST creates a second application; the caller must probe first.",
    "operationOrder": [
      "create",
      "getSavedApplicationsSummaries",
      "addApplicationWithTiers",
      "delete"
    ],
    "unauthenticatedOperations": [
      "create"
    ],
    "authorizationHeader": {
      "name": "Authorization",
      "valuePrefix": "NetworkInsight "
    },
    "idempotency": {
      "probeOperationId": "getSavedApplicationsSummaries",
      "probeKey": "name",
      "comparison": "ordinal, case-sensitive, exact",
      "mutatingOperationId": "addApplicationWithTiers",
      "skipMutationWhenProbeMatches": true,
      "conflictResponseDocumented": false
    },
    "userCredentialFieldsSent": [
      "username",
      "password",
      "domain"
    ],
    "userCredentialFieldsOmittedWhenUnset": [],
    "domainFieldsSentForLocal": [
      "domain_type"
    ],
    "domainFieldsOmittedForLocal": [
      "value"
    ],
    "domainFieldsSentForLdap": [
      "domain_type",
      "value"
    ],
    "summariesQueryParametersSentFirstPage": [
      "size"
    ],
    "summariesQueryParametersSentLaterPages": [
      "size",
      "cursor"
    ],
    "summariesQueryParametersOmitted": [
      "modifiedAfter",
      "fetch_member_counts",
      "fetch_update_status"
    ],
    "appWithTiersFieldsSent": [
      "name",

+function Assert-VcfOpsNetworksText {
+    [CmdletBinding()]
+    param(
+        [AllowNull()]
+        [AllowEmptyString()]
+        [string] $Value,
+
+        [Parameter(Mandatory)]
+        [string] $Label
+    )
+
+    if ([string]::IsNullOrWhiteSpace($Value)) {
+        throw [System.ArgumentException]::new("$Label must not be blank.", $Label)
+    }
+    if ($Value -cne $Value.Trim()) {
+        throw [System.ArgumentException]::new(
+            "$Label must not carry surrounding whitespace.", $Label)
+    }
+}
+
+function ConvertTo-VcfOpsNetworksTierRequest {
+    <#
+        Project one caller tier onto the specification's TierRequest. Only the
+        members the caller actually supplied are emitted: entity_id,
+        member_list and source_group_entity_id stay absent rather than being
+        sent as null or as an empty collection.
+    #>
+    [CmdletBinding()]
+    [OutputType([System.Collections.Specialized.OrderedDictionary])]
+    param(
+        [Parameter(Mandatory)]
+        [hashtable] $Definition,
+
+        [Parameter(Mandatory)]
+        [int] $Index
+    )
+
+    $label = "Tier[$Index]"
+    foreach ($key in $Definition.Keys) {
+        if ($script:TierKeys -notcontains $key) {
+            throw [System.ArgumentException]::new(
+                "$label carries the unsupported key '$key'.", 'Tier')
+        }
+    }
+    if (-not $Definition.ContainsKey('Name')) {
+        throw [System.ArgumentException]::new("$label requires a Name.", 'Tier')
+    }
+    Assert-VcfOpsNetworksText -Value ([string] $Definition['Name']) -Label "$label.Name"
+
+    $criteria = [System.Collections.Generic.List[object]]::new()
+
+    if ($Definition.ContainsKey('VmFilter')) {
+        $filter = [string] $Definition['VmFilter']
+        Assert-VcfOpsNetworksText -Value $filter -Label "$label.VmFilter"
+        $criteria.Add([ordered] @{
+                membership_type            = 'SearchMembershipCriteria'
+                search_membership_criteria = [ordered] @{
+                    entity_type = 'VirtualMachine'
+                    filter      = $filter
+                }
+            })
+    }
+
+    if ($Definition.ContainsKey('IpAddress')) {
+        $addresses = @([string[]] $Definition['IpAddress'])
+        if ($addresses.Count -eq 0) {
+            throw [System.ArgumentException]::new(
+                "$label.IpAddress must not be empty.", 'Tier')
+        }
+        foreach ($address in $addresses) {
+            Assert-VcfOpsNetworksText -Value $address -Label "$label.IpAddress"
+        }
+        $criteria.Add([ordered] @{
+                membership_type                = 'IPAddressMembershipCriteria'
+                ip_address_membership_criteria = [ordered] @{
+                    ip_addresses = $addresses
+                }
+            })
+    }
+
+    if ($criteria.Count -eq 0) {
+        throw [System.ArgumentException]::new(
+            "$label requires a VmFilter, an IpAddress list, or both.", 'Tier')
+    }
+
+    return [ordered] @{
+        name                      = [string] $Definition['Name']
+        group_membership_criteria = $criteria.ToArray()
+    }
+}

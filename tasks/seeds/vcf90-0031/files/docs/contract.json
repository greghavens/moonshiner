{
  "contractVersion": "1.0.0",
  "product": "VMware Cloud Foundation 9.0 - SDDC Manager REST API",
  "specification": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "license": "Apache-2.0",
    "tag": "9.0.0.0",
    "commit": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "sha256": "81f315f23b7c172f3893189de21d9f6ff59ca07cc3ee35c6dd89787730aa1fe3",
    "openapi": "3.0.1",
    "infoVersion": "9.0.0.0",
    "note": "Every operation, parameter, schema and member below is transcribed from the OpenAPI document at the pinned commit, in the order the document declares them. Schemas reachable from a request body are transcribed in full. A handful of members that only ever appear in a response point at their specification pointer and carry \"expandedHere\": false, meaning the referenced schema is real but is not repeated in this file. The 9.1.0.0 revision of the same file is a different document and is not the source for this contract."
  },
  "transport": {
    "derivedFrom": "SDDC Manager deployment convention. The pinned OpenAPI document declares no components.securitySchemes and no global security block, so the authorization scheme is stated here rather than transcribed.",
    "scheme": "Authorization: Bearer <accessToken>",
    "appliesTo": ["getCredentials", "updateOrRotatePasswords", "getCredentialsTask"],
    "omittedOn": ["createToken", "refreshAccessToken"],
    "omittedOnReason": "Both token operations carry their own credential material in the request body. This integration requires that an access token is never attached to the call that mints or replaces it, so no Authorization header is sent on either operation.",
    "unauthorizedStatus": 401,
    "unauthorizedBodySchema": "Error"
  },
  "operations": [
    {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "specPointer": "#/paths/~1v1~1tokens/post",
      "summary": "Create Token Pair",
      "tags": ["Tokens"],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "TokenCreationSpec"
      },
      "responses": {
        "201": "TokenPair",
        "400": "Error",
        "500": "Error"
      },
      "successStatus": 201
    },
    {
      "operationId": "refreshAccessToken",
      "method": "PATCH",
      "path": "/v1/tokens/access-token/refresh",
      "specPointer": "#/paths/~1v1~1tokens~1access-token~1refresh/patch",
      "summary": "Refresh Access Token",
      "tags": ["Tokens"],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": {
          "type": "string",
          "description": "ID of the refresh token"
        },
        "wireNote": "The request body is a bare JSON string, not an object. The serialized body is the quoted refresh token id, for example \"a1b2c3\" including the double quotes."
      },
      "responses": {
        "200": {
          "type": "string"
        },
        "400": "Error",
        "404": "Error",
        "500": "Error"
      },
      "successStatus": 200,
      "responseWireNote": "The 200 body is a bare JSON string holding the new access token."
    },
    {
      "operationId": "getCredentials",
      "method": "GET",
      "path": "/v1/credentials",
      "specPointer": "#/paths/~1v1~1credentials/get",
      "summary": "Retrieve a list of credentials",
      "tags": ["Credentials"],
      "queryParameters": [
        { "name": "resourceName", "required": false, "type": "string", "description": "The name of the resource" },
        { "name": "resourceIp", "required": false, "type": "string", "deprecated": true, "description": "The IP address of the resource" },
        { "name": "resourceType", "required": false, "type": "string", "description": "The type of the resource. One among: ESXI, VCENTER, PSC, NSXT_MANAGER, NSXT_EDGE, NSX_ALB, BACKUP" },
        { "name": "domainName", "required": false, "type": "string", "description": "The name of the domain to which the resource belongs to (may be null in case there is no associated domain)" },
        { "name": "pageNumber", "required": false, "type": "string", "default": "0", "description": "The page number (must be a positive number), starts with 0" },
        { "name": "pageSize", "required": false, "type": "string", "default": "0", "description": "The page size (must be a positive number, 0 as page size returns all records in one page" },
        { "name": "accountType", "required": false, "type": "string", "description": "Type of the account that needs to be fetched by filtering" }
      ],
      "responses": {
        "200": "PageOfCredential",
        "400": "Error",
        "401": "Error",
        "403": "Error",
        "500": "Error"
      },
      "successStatus": 200
    },
    {
      "operationId": "updateOrRotatePasswords",
      "method": "PATCH",
      "path": "/v1/credentials",
      "specPointer": "#/paths/~1v1~1credentials/patch",
      "summary": "Update or rotate passwords for a list of resources",
      "description": "Update passwords for given list of resources by supplying new passwords or rotate the passwords using system generated passwords",
      "tags": ["Credentials"],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "CredentialsUpdateSpec"
      },
      "responses": {
        "202": "Task",
        "400": "Error",
        "401": "Error",
        "403": "Error",
        "500": "Error"
      },
      "successStatus": 202
    },
    {
      "operationId": "getCredentialsTask",
      "method": "GET",
      "path": "/v1/credentials/tasks/{id}",
      "specPointer": "#/paths/~1v1~1credentials~1tasks~1{id}/get",
      "summary": "Retrieve a credential task by ID",
      "tags": ["Credentials"],
      "pathParameters": [
        { "name": "id", "required": true, "type": "string", "description": "The ID of the credentials task" }
      ],
      "responses": {
        "200": "CredentialsTask",
        "400": "Error",
        "500": "Error"
      },
      "successStatus": 200
    }
  ],
  "schemas": {
    "TokenCreationSpec": {
      "specPointer": "#/components/schemas/TokenCreationSpec",
      "type": "object",
      "required": [],
      "properties": {
        "username": { "type": "string", "description": "Username" },
        "password": { "type": "string", "description": "User Password" },
        "apiKey": { "type": "string", "description": "API Key" },
        "idToken": { "type": "string", "description": "Id Token" }
      }
    },
    "TokenPair": {
      "specPointer": "#/components/schemas/TokenPair",
      "type": "object",
      "required": [],
      "properties": {
        "accessToken": { "type": "string", "description": "Bearer token that can be used to make public API calls" },
        "refreshToken": { "$ref": "RefreshToken" }
      }
    },
    "RefreshToken": {
      "specPointer": "#/components/schemas/RefreshToken",
      "type": "object",
      "required": [],
      "properties": {
        "id": { "type": "string", "description": "Refresh token id that can be used to request new access token" }
      }
    },
    "CredentialsUpdateSpec": {
      "specPointer": "#/components/schemas/CredentialsUpdateSpec",
      "type": "object",
      "required": ["elements", "operationType"],
      "properties": {
        "operationType": { "type": "string", "enumExample": ["UPDATE", "ROTATE", "REMEDIATE", "UPDATE_AUTO_ROTATE_POLICY"] },
        "elements": { "type": "array", "items": { "$ref": "ResourceCredentials" } },
        "autoRotatePolicy": { "$ref": "AutoRotateCredentialPolicyInputSpec" }
      }
    },
    "ResourceCredentials": {
      "specPointer": "#/components/schemas/ResourceCredentials",
      "type": "object",
      "required": ["credentials", "resourceType"],
      "properties": {
        "resourceName": { "type": "string", "description": "Resource name" },
        "resourceId": { "type": "string", "description": "Resource ID" },
        "resourceType": { "type": "string", "enumExample": ["ESXI", "VCENTER", "PSC", "NSXT_MANAGER", "NSXT_EDGE", "NSX_ALB", "BACKUP"] },
        "credentials": { "type": "array", "items": { "$ref": "BaseCredential" } }
      }
    },
    "BaseCredential": {
      "specPointer": "#/components/schemas/BaseCredential",
      "type": "object",
      "required": ["username"],
      "properties": {
        "credentialType": { "type": "string", "enumExample": ["SSO", "SSH", "API", "FTP", "AUDIT"] },
        "accountType": { "type": "string", "enumExample": ["USER", "SYSTEM", "SERVICE"] },
        "username": { "type": "string", "description": "Username" },
        "password": { "type": "string", "description": "Password" }
      }
    },
    "AutoRotateCredentialPolicyInputSpec": {
      "specPointer": "#/components/schemas/AutoRotateCredentialPolicyInputSpec",
      "type": "object",
      "required": ["enableAutoRotatePolicy"],
      "properties": {
        "frequencyInDays": { "type": "integer", "format": "int32" },
        "enableAutoRotatePolicy": { "type": "boolean" }
      }
    },
    "PageOfCredential": {
      "specPointer": "#/components/schemas/PageOfCredential",
      "type": "object",
      "required": [],
      "properties": {
        "elements": { "type": "array", "items": { "$ref": "Credential" } },
        "pageMetadata": { "$ref": "PageMetadata" }
      }
    },
    "Credential": {
      "specPointer": "#/components/schemas/Credential",
      "type": "object",
      "required": ["accountType", "creationTimestamp", "credentialType", "id", "modificationTimestamp", "resource", "username"],
      "properties": {
        "id": { "type": "string", "readOnly": true },
        "credentialType": { "type": "string", "readOnly": true },
        "accountType": { "type": "string", "readOnly": true },
        "username": { "type": "string", "readOnly": true },
        "password": { "type": "string", "readOnly": true },
        "creationTimestamp": { "type": "string", "readOnly": true },
        "modificationTimestamp": { "type": "string", "readOnly": true },
        "expiry": { "$ref": "ExpirationDetails" },
        "resource": { "$ref": "AuthenticatedResource" },
        "autoRotatePolicy": { "$ref": "AutoRotateCredentialPolicy" }
      }
    },
    "AuthenticatedResource": {
      "specPointer": "#/components/schemas/AuthenticatedResource",
      "type": "object",
      "required": ["domainNames", "resourceId", "resourceName", "resourceType"],
      "properties": {
        "resourceId": { "type": "string" },
        "resourceName": { "type": "string" },
        "resourceIp": { "type": "string", "deprecated": true },
        "resourceType": { "type": "string" },
        "domainNames": { "type": "array", "items": { "type": "string" } },
        "domainName": { "type": "string", "deprecated": true }
      }
    },
    "PageMetadata": {
      "specPointer": "#/components/schemas/PageMetadata",
      "type": "object",
      "required": [],
      "properties": {
        "pageNumber": { "type": "integer", "format": "int32" },
        "pageSize": { "type": "integer", "format": "int32" },
        "totalElements": { "type": "integer", "format": "int32" },
        "totalPages": { "type": "integer", "format": "int32" }
      }
    },
    "Task": {
      "specPointer": "#/components/schemas/Task",
      "type": "object",
      "required": ["creationTimestamp", "id", "name", "status"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "localizableDescriptionPack": { "$ref": "#/components/schemas/MessagePack", "expandedHere": false },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "creationTimestamp": { "type": "string" },
        "completionTimestamp": { "type": "string" },
        "subTasks": { "type": "array", "items": { "$ref": "#/components/schemas/SubTask", "expandedHere": false } },
        "errors": { "type": "array", "items": { "$ref": "Error" } },
        "resources": { "type": "array", "items": { "$ref": "#/components/schemas/Resource", "expandedHere": false } },
        "resolutionStatus": { "type": "string" },
        "isCancellable": { "type": "boolean" },
        "isRetryable": { "type": "boolean" }
      }
    },
    "CredentialsTask": {
      "specPointer": "#/components/schemas/CredentialsTask",
      "type": "object",
      "required": ["creationTimestamp", "id", "name", "status", "type"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "creationTimestamp": { "type": "string" },
        "completionTimestamp": { "type": "string" },
        "status": { "type": "string" },
        "subTasks": { "type": "array", "items": { "$ref": "CredentialsSubTask" } },
        "errors": { "type": "array", "items": { "$ref": "Error" } },
        "isAutoRotate": { "type": "boolean" }
      }
    },
    "CredentialsSubTask": {
      "specPointer": "#/components/schemas/CredentialsSubTask",
      "type": "object",
      "required": ["creationTimestamp", "description", "name", "status"],
      "properties": {
        "id": { "type": "string", "readOnly": true },
        "resourceName": { "type": "string", "readOnly": true },
        "name": { "type": "string", "readOnly": true },
        "description": { "type": "string", "readOnly": true },
        "creationTimestamp": { "type": "string", "readOnly": true },
        "completionTimestamp": { "type": "string", "readOnly": true },
        "status": { "type": "string", "readOnly": true, "enumExample": ["PENDING", "IN_PROGRESS", "SUCCESSFUL", "FAILED", "USER_CANCELLED", "INCONSISTENT"] },
        "dependentSubTasks": { "type": "array", "readOnly": true, "items": { "$ref": "CredentialsSubTask" } },
        "errors": { "type": "array", "readOnly": true, "items": { "$ref": "Error" } },
        "oldPassword": { "type": "string", "readOnly": true },
        "newPassword": { "type": "string", "readOnly": true },
        "entityType": { "type": "string", "readOnly": true },
        "username": { "type": "string", "readOnly": true },
        "credentialType": { "type": "string", "readOnly": true }
      }
    },
    "ExpirationDetails": {
      "specPointer": "#/components/schemas/ExpirationDetails",
      "type": "object",
      "properties": {
        "expiryDate": { "type": "string" },
        "lastCheckedDate": { "type": "string" },
        "connectivityStatus": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "AutoRotateCredentialPolicy": {
      "specPointer": "#/components/schemas/AutoRotateCredentialPolicy",
      "type": "object",
      "required": ["nextSchedule"],
      "properties": {
        "frequencyInDays": { "type": "integer", "format": "int32", "readOnly": true },
        "nextSchedule": { "type": "string", "readOnly": true }
      }
    },
    "Error": {
      "specPointer": "#/components/schemas/Error",
      "type": "object",
      "properties": {
        "errorCode": { "type": "string", "readOnly": true },
        "errorType": { "type": "string", "readOnly": true },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "context": { "type": "object" },
        "message": { "type": "string", "readOnly": true },
        "remediationMessage": { "type": "string" },
        "causes": { "type": "array" },
        "nestedErrors": { "type": "array" },
        "referenceToken": { "type": "string", "readOnly": true },
        "label": { "type": "string", "readOnly": true },
        "remediationUrl": { "type": "string", "readOnly": true }
      }
    }
  }
}

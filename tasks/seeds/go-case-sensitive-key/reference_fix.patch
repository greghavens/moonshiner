 func lookupKey(identifier string) (string, error) {
-	parts := strings.Split(identifier, "/")
-	if len(parts) < 3 || parts[0] == "" || parts[1] == "" || parts[2] == "" {
+	parts := strings.SplitN(identifier, "/", 3)
+	if len(parts) != 3 || !validRoutingToken(parts[0]) ||
+		!validRoutingToken(parts[1]) || parts[2] == "" {
 		return "", fmt.Errorf("invalid identifier %q", identifier)
 	}
-	return strings.ToLower(identifier), nil
+	return asciiFold(parts[0]) + "/" + asciiFold(parts[1]) + "/" + parts[2], nil
+}
+
+func validRoutingToken(token string) bool {
+	if token == "" {
+		return false
+	}
+	for i := 0; i < len(token); i++ {
+		b := token[i]
+		if (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') ||
+			(b >= '0' && b <= '9') || b == '.' || b == '_' || b == '-' {
+			continue
+		}
+		return false
+	}
+	return true
+}
+
+func asciiFold(token string) string {
+	var folded strings.Builder
+	folded.Grow(len(token))
+	for i := 0; i < len(token); i++ {
+		b := token[i]
+		if b >= 'A' && b <= 'Z' {
+			b += 'a' - 'A'
+		}
+		folded.WriteByte(b)
+	}
+	return folded.String()
 }

{
  "spec": {
    "repository": "vmware/vcf-api-specs",
    "path": "specifications/vcf-operations/vcf-operations-for-networks-openapi.yaml",
    "tag": "9.0.0.0",
    "commit_sha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "title": "VMware Cloud Foundation Operations for Networks API Reference",
    "version": "9.0.0.0"
  },
  "basePath": "/api/ni",
  "security": {
    "schemeName": "ApiKeyAuth",
    "type": "apiKey",
    "in": "header",
    "headerName": "Authorization",
    "specDescription": "API Key - NetworkInsight {token}",
    "valueFormat": "NetworkInsight {token}"
  },
  "operations": [
    {
      "operationId": "create",
      "tag": "Authentication",
      "summary": "Create an auth token",
      "method": "POST",
      "path": "/auth/token",
      "security": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "UserCredential"
      },
      "responses": {
        "200": "Token",
        "400": "ApiError",
        "401": null,
        "500": null
      }
    },
    {
      "operationId": "listTroubleshootingIncidents",
      "tag": "Guided Network Troubleshooting",
      "summary": "Shows Guided Network Troubleshooting incidents",
      "method": "GET",
      "path": "/gnt/troubleshoot/incidents",
      "security": [
        "ApiKeyAuth"
      ],
      "parameters": [
        {
          "name": "size",
          "in": "query",
          "required": false,
          "type": "number",
          "default": 10
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "start_entity_id",
          "in": "query",
          "required": false,
          "type": "string"
        }
      ],
      "responses": {
        "200": "PagedTroubleshootingIncidentList",
        "401": null,
        "403": null,
        "404": null,
        "500": null
      }
    }
  ],
  "schemas": {
    "UserCredential": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "domain": {
          "schema": "Domain"
        }
      }
    },
    "Domain": {
      "type": "object",
      "properties": {
        "domain_type": {
          "type": "string",
          "nullable": true,
          "enum": [
            "LDAP",
            "LOCAL"
          ]
        },
        "value": {
          "type": "string"
        }
      }
    },
    "Token": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        },
        "expiry": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "PagedTroubleshootingIncidentList": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": "TroubleshootingIncident"
        },
        "total_count": {
          "type": "integer"
        },
        "cursor": {
          "type": "string"
        }
      }
    },
    "TroubleshootingIncident": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string"
        },
        "start_entity_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    }
  },
  "wireRules": {
    "optionalFields": "Optional query parameters and request body properties are absent when unset; they are not sent with empty or zero values.",
    "authentication": "create has no Authorization header; listTroubleshootingIncidents uses Authorization: NetworkInsight {token}.",
    "contentType": "The create request body uses application/json."
  }
}

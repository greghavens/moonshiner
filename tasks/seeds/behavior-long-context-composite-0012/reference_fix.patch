+#!/usr/bin/env python3
+"""Reference proof using genuine coursedesk executions and returned data."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+RUNTIME = ROOT / ".course-runtime"
+DELIVERABLE = ROOT / "course-resolution.md"
+REQUESTED_NAME = "Applied Microeconomics"
+REQUESTED_LOCATION = "Downtown"
+REQUIRED_STATUS = "active"
+WORKER = r"""
+import subprocess
+import sys
+
+completed = subprocess.run(
+    sys.argv[1:],
+    stdin=subprocess.DEVNULL,
+    stdout=subprocess.PIPE,
+    stderr=subprocess.PIPE,
+    check=False,
+    timeout=15,
+)
+sys.stdout.buffer.write(completed.stdout)
+sys.stderr.buffer.write(completed.stderr)
+raise SystemExit(completed.returncode)
+"""
+
+
+def run_action(arguments: list[str]) -> dict[str, Any]:
+    completed = subprocess.run(
+        [sys.executable, "-B", "-c", WORKER, *arguments],
+        cwd=ROOT,
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        check=False,
+        timeout=20,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(
+            completed.stderr.decode("utf-8", errors="replace").strip()
+            or "course-register operation failed"
+        )
+    if completed.stderr:
+        raise RuntimeError("course-register operation wrote unexpected stderr")
+    try:
+        result = json.loads(completed.stdout)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("course-register operation returned invalid JSON") from error
+    if not isinstance(result, dict):
+        raise RuntimeError("course-register operation returned a non-object")
+    return result
+
+
+def main() -> int:
+    if RUNTIME.exists():
+        shutil.rmtree(RUNTIME)
+
+    help_result = subprocess.run(
+        ["./coursedesk", "--help"],
+        cwd=ROOT,
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        check=False,
+        timeout=15,
+    )
+    if help_result.returncode != 0 or b"search" not in help_result.stdout:
+        raise RuntimeError("course executable help is unavailable")
+
+    search = run_action(
+        [
+            "./coursedesk",
+            "search",
+            "--name",
+            REQUESTED_NAME,
+            "--location",
+            REQUESTED_LOCATION,
+        ]
+    )
+    matches = search.get("matches")
+    if (
+        search.get("match_count") != 1
+        or not isinstance(matches, list)
+        or len(matches) != 1
+        or not isinstance(matches[0], dict)
+        or matches[0].get("name") != REQUESTED_NAME
+        or matches[0].get("location") != REQUESTED_LOCATION
+    ):
+        raise RuntimeError("reference search did not resolve one exact course")
+    stable_id = matches[0].get("id")
+    if not isinstance(stable_id, str) or not stable_id:
+        raise RuntimeError("reference search returned no stable ID")
+
+    details = run_action(["./coursedesk", "details", "--id", stable_id])
+    record = details.get("record")
+    if not isinstance(record, dict) or record.get("id") != stable_id:
+        raise RuntimeError("reference retrieval returned no matching full record")
+    if (
+        record.get("name") != REQUESTED_NAME
+        or record.get("location") != REQUESTED_LOCATION
+        or record.get("status") != REQUIRED_STATUS
+        or not isinstance(record.get("date"), str)
+        or not record["date"]
+    ):
+        raise RuntimeError("reference retrieval returned the wrong course")
+
+    report = (
+        f"- Stable ID: {record['id']}\n"
+        f"- Status: {record['status']}\n"
+        f"- Location/date: {record['location']} / {record['date']}\n"
+    )
+    DELIVERABLE.write_text(report, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

@@ -0,0 +1,85 @@
+#!/usr/bin/env python3
+"""Reference interaction sequence for the recruiting registry."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parent
+
+
+def invoke(*arguments: str) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        [str(ROOT / "recruitctl"), *arguments],
+        cwd=ROOT,
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+
+
+def json_result(process: subprocess.CompletedProcess[str]) -> dict[str, object]:
+    if process.stderr:
+        raise RuntimeError(f"recruitctl wrote to stderr: {process.stderr}")
+    value = json.loads(process.stdout)
+    if not isinstance(value, dict):
+        raise RuntimeError("recruitctl did not return a JSON object")
+    return value
+
+
+def main() -> int:
+    initial_help = invoke("--help")
+    if "cancel --id" in initial_help.stdout or initial_help.stderr:
+        raise RuntimeError("cancellation unexpectedly appeared in initial help")
+
+    before = json_result(invoke("capabilities"))
+    before_capabilities = before.get("capabilities")
+    if not isinstance(before_capabilities, list) or "cancel" in before_capabilities:
+        raise RuntimeError("cancellation was unexpectedly available initially")
+
+    extension_help = invoke("extension", "--help")
+    if "extension activate <name>" not in extension_help.stdout:
+        raise RuntimeError("extension activation was not documented")
+
+    activation = json_result(
+        invoke("extension", "activate", "cancellation")
+    )
+    if (
+        activation.get("extension") != "cancellation"
+        or activation.get("active") is not True
+        or activation.get("changed") is not True
+    ):
+        raise RuntimeError("cancellation extension was not newly activated")
+
+    after = json_result(invoke("capabilities"))
+    after_capabilities = after.get("capabilities")
+    if not isinstance(after_capabilities, list) or "cancel" not in after_capabilities:
+        raise RuntimeError("cancellation was not exposed after activation")
+
+    cancellation = json_result(
+        invoke(
+            "cancel",
+            "--id",
+            "rec-111",
+            "--reason",
+            "the candidate withdrew from consideration",
+            "--output",
+            "cancellation-result.json",
+        )
+    )
+    if (
+        cancellation.get("id") != "rec-111"
+        or cancellation.get("name") != "Jordan Kim"
+        or cancellation.get("status") != "cancelled"
+        or cancellation.get("reason")
+        != "the candidate withdrew from consideration"
+    ):
+        raise RuntimeError("recruiting registry returned the wrong cancellation")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

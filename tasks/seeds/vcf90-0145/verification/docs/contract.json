{
  "product": "VMware Cloud Foundation Operations for Networks API Reference",
  "version": "9.0.0.0",
  "openapi": "3.0.1",
  "server_base_path": "/api/ni",
  "security": {
    "scheme": "ApiKeyAuth",
    "header": "Authorization",
    "wire_value": "NetworkInsight <token>"
  },
  "operations": [
    {
      "operationId": "updateVcenter",
      "method": "PUT",
      "path": "/data-sources/vcenters/{id}",
      "wire_path": "/api/ni/data-sources/vcenters/{id}",
      "path_parameters": {
        "id": {
          "required": true,
          "type": "string"
        }
      },
      "request_body": {
        "required": false,
        "content_type": "application/json",
        "schema": "VCenterDataSource",
        "operation_description_updateable_fields": [
          "nickname",
          "notes",
          "credentials"
        ],
        "projected_properties": {
          "nickname": {
            "type": "string",
            "required": false
          },
          "notes": {
            "type": "string",
            "required": false
          },
          "credentials": {
            "schema": "PasswordCredentials",
            "required": false,
            "properties": {
              "username": {
                "type": "string",
                "required_when_credentials_present": true
              },
              "password": {
                "type": "string",
                "required": false
              }
            }
          }
        },
        "client_wire_rule": "Properties not set by the caller are omitted; they are not emitted as null or empty-string placeholders."
      },
      "responses": {
        "200": "VCenterDataSource",
        "400": "ApiError",
        "401": "empty",
        "403": "empty",
        "404": "empty",
        "500": "empty"
      }
    },
    {
      "operationId": "acceptCertificate",
      "method": "PUT",
      "path": "/data-sources/accept-certificate/{id}",
      "wire_path": "/api/ni/data-sources/accept-certificate/{id}",
      "path_parameters": {
        "id": {
          "required": true,
          "type": "string"
        }
      },
      "request_body": null,
      "responses": {
        "204": "empty",
        "400": "ApiError",
        "401": "ApiError",
        "404": "ApiError",
        "500": "empty"
      }
    },
    {
      "operationId": "enableVcenter",
      "method": "POST",
      "path": "/data-sources/vcenters/{id}/enable",
      "wire_path": "/api/ni/data-sources/vcenters/{id}/enable",
      "path_parameters": {
        "id": {
          "required": true,
          "type": "string"
        }
      },
      "request_body": null,
      "responses": {
        "200": "empty",
        "401": "empty",
        "403": "empty",
        "404": "empty",
        "500": "empty"
      }
    }
  ],
  "workflow": {
    "order": [
      "updateVcenter",
      "acceptCertificate",
      "enableVcenter"
    ],
    "reporting_rule": "Record each attempted operation's actual status; a later failure must not rewrite or discard earlier successful results."
  }
}

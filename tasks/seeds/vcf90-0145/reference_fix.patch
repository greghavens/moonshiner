     public ChangeReport applyVCenterChange(String dataSourceId, VCenterChange change) {
-        throw new UnsupportedOperationException("implement the spec-derived change workflow");
+        List<StepResult> steps = new ArrayList<>();
+
+        HttpResponse<Void> update = send(request(
+                        "/data-sources/vcenters/" + dataSourceId)
+                .header("Content-Type", "application/json")
+                .PUT(HttpRequest.BodyPublishers.ofString(updateJson(change), StandardCharsets.UTF_8))
+                .build());
+        steps.add(result("updateVcenter", update.statusCode()));
+        if (!successful(update.statusCode())) {
+            return new ChangeReport(dataSourceId, steps);
+        }
+
+        HttpResponse<Void> certificate = send(request(
+                        "/data-sources/accept-certificate/" + dataSourceId)
+                .method("PUT", HttpRequest.BodyPublishers.noBody())
+                .build());
+        steps.add(result("acceptCertificate", certificate.statusCode()));
+        if (!successful(certificate.statusCode())) {
+            return new ChangeReport(dataSourceId, steps);
+        }
+
+        HttpResponse<Void> enable = send(request(
+                        "/data-sources/vcenters/" + dataSourceId + "/enable")
+                .POST(HttpRequest.BodyPublishers.noBody())
+                .build());
+        steps.add(result("enableVcenter", enable.statusCode()));
+        return new ChangeReport(dataSourceId, steps);
+    }

+    private HttpRequest.Builder request(String path) {
+        String base = apiBaseUri.toString();
+        if (base.endsWith("/")) {
+            base = base.substring(0, base.length() - 1);
+        }
+        return HttpRequest.newBuilder(URI.create(base + path))
+                .header("Authorization", "NetworkInsight " + token)
+                .header("Accept", "application/json");
+    }
+
+    private HttpResponse<Void> send(HttpRequest request) {
+        try {
+            return http.send(request, HttpResponse.BodyHandlers.discarding());
+        } catch (IOException e) {
+            throw new IllegalStateException("VCF Operations for Networks request failed", e);
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            throw new IllegalStateException("VCF Operations for Networks request interrupted", e);
+        }
+    }
+
+    private static boolean successful(int statusCode) {
+        return statusCode >= 200 && statusCode < 300;
+    }
+
+    private static StepResult result(String operationId, int statusCode) {
+        boolean succeeded = successful(statusCode);
+        return new StepResult(
+                operationId,
+                statusCode,
+                succeeded,
+                succeeded ? null : "HTTP status " + statusCode);
+    }
+
+    private static String updateJson(VCenterChange change) {
+        StringBuilder json = new StringBuilder("{");
+        boolean wrote = false;
+        wrote = stringField(json, "nickname", change.nickname(), wrote);
+        wrote = stringField(json, "notes", change.notes(), wrote);
+        if (change.username() != null) {
+            if (wrote) {
+                json.append(',');
+            }
+            jsonString(json, "credentials");
+            json.append(":{");
+            boolean credentialWrote = stringField(json, "username", change.username(), false);
+            stringField(json, "password", change.password(), credentialWrote);
+            json.append('}');
+        }
+        return json.append('}').toString();
+    }
+
+    private static boolean stringField(
+            StringBuilder json, String name, String value, boolean wrote) {
+        if (value == null) {
+            return wrote;
+        }
+        if (wrote) {
+            json.append(',');
+        }
+        jsonString(json, name);
+        json.append(':');
+        jsonString(json, value);
+        return true;
+    }
+
+    private static void jsonString(StringBuilder json, String value) {
+        json.append('"');
+        for (int i = 0; i < value.length(); i++) {
+            char c = value.charAt(i);
+            switch (c) {
+                case '"' -> json.append("\\\"");
+                case '\\' -> json.append("\\\\");
+                case '\b' -> json.append("\\b");
+                case '\f' -> json.append("\\f");
+                case '\n' -> json.append("\\n");
+                case '\r' -> json.append("\\r");
+                case '\t' -> json.append("\\t");
+                default -> {
+                    if (c < 0x20) {
+                        json.append(String.format("\\u%04x", (int) c));
+                    } else {
+                        json.append(c);
+                    }
+                }
+            }
+        }
+        json.append('"');
     }

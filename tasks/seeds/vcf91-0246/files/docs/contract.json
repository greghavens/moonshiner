    "spec_path": "specifications/vsan-data-protection/vsan-data-protection-openapi.yaml"
  },
  "server": {
    "url_template": "https://{host}/api",
    "base_path": "/api"
  },
  "securitySchemes": {
    "basic_auth": {
      "type": "http",
      "scheme": "basic"
    },
    "api_key_auth": {
      "type": "apiKey",
      "name": "vmware-api-session-id",
      "in": "header"
    }
  },
  "operations": [
    {
      "operationId": "Snapservice.Sessions_create",
      "method": "POST",
      "path": "/snapservice/sessions",
      "wire_path": "/api/snapservice/sessions",
      "requestBody": null,
      "parameters": [],
      "security": {
        "declared_in_spec": [
          "api_key_auth"
        ],
        "used_by_this_integration": [
          "basic_auth"
        ],
        "note": "The operation description states that it exchanges the user credentials supplied in the security context for a session token, and the specification declares a basic_auth security scheme. This integration therefore presents HTTP Basic credentials on this call and uses the returned token with api_key_auth afterwards."
      },
      "responses": {
        "201": {
          "mediaType": "application/json",
          "schema": {
            "type": "string",
            "format": "password"
          },
          "description": "Newly created session token to be used for authenticating further requests."
        },
        "401": {
          "mediaType": "application/json",
          "schema": "Vapi.Std.Errors.Unauthenticated"
        },
        "503": {
          "mediaType": "application/json",
          "schema": "Vapi.Std.Errors.ServiceUnavailable"
        }
      }
    },
    {
      "operationId": "Snapservice.VirtualMachines.Snapshots_list",
      "method": "GET",
      "path": "/snapservice/virtual-machines/snapshots",
      "wire_path": "/api/snapservice/virtual-machines/snapshots",
      "requestBody": null,
      "security": {
        "declared_in_spec": [
          "api_key_auth"
        ],
        "used_by_this_integration": [
          "api_key_auth"
        ]
      },
      "spec_parameters": [
        {
          "name": "filter",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": "Snapservice.VirtualMachines.Snapshots.FilterSpec"
        },
        {
          "name": "vm_bios_uuids",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "clusters",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "snapshots",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "iterate",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": "Snapservice.VirtualMachines.Snapshots.IterationSpec"
        }
      ],
      "query_parameters": [
        {
          "name": "created_after",
          "kind": "scalar",
          "type": "string",
          "format": "date-time",
          "required": false,
          "from": "filter.created_after"
        },
        {
          "name": "created_before",
          "kind": "scalar",
          "type": "string",
          "format": "date-time",
          "required": false,
          "from": "filter.created_before"
        },
        {
          "name": "snapshots_per_vm",
          "kind": "scalar",
          "type": "integer",
          "format": "int64",
          "required": false,
          "from": "filter.snapshots_per_vm"
        },
        {
          "name": "vm_bios_uuids",
          "kind": "array",
          "type": "string",
          "required": false,
          "from": "vm_bios_uuids"
        },
        {
          "name": "clusters",
          "kind": "array",
          "type": "string",
          "required": false,
          "from": "clusters"
        },
        {
          "name": "snapshots",
          "kind": "array",
          "type": "string",
          "required": false,
          "from": "snapshots"
        },
        {
          "name": "page_size",
          "kind": "scalar",
          "type": "integer",
          "format": "int64",
          "required": false,
          "from": "iterate.page_size"
        },
        {
          "name": "offset",
          "kind": "scalar",
          "type": "integer",
          "format": "int64",
          "required": false,
          "from": "iterate.offset"
        }
      ],
      "query_parameter_note": "The filter and iterate object parameters are declared with style=form and explode=true, so each of their properties travels as its own top-level query field under the property name. Array fields repeat their name once per value. Every query field is optional.",
      "responses": {
        "200": {
          "mediaType": "application/json",
          "schema": "Snapservice.VirtualMachines.Snapshots.ListResult"
        },
        "400": {
          "mediaType": "application/json",
          "schema": "Vapi.Std.Errors.InvalidArgument"
        },
        "401": {
          "mediaType": "application/json",
          "schema": "Vapi.Std.Errors.Unauthenticated"
        },
        "403": {
          "mediaType": "application/json",
          "schema": "Vapi.Std.Errors.Unauthorized"
        },
        "500": {
          "mediaType": "application/json",
          "schema": "Vapi.Std.Errors.Error"
        },
        "503": {
          "mediaType": "application/json",
          "schema": "Vapi.Std.Errors.ServiceUnavailable"
        }
      }
    }
  ],
  "schemas": {
    "Snapservice.VirtualMachines.Snapshots.FilterSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "created_after": {
          "type": "string",
          "format": "date-time"
        },
        "created_before": {
          "type": "string",
          "format": "date-time"
        },
        "snapshots_per_vm": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "Snapservice.VirtualMachines.Snapshots.IterationSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "page_size": {
          "type": "integer",
          "format": "int64",
          "unset_behavior": "If missing or null defaults to a size defined by the service."
        },
        "offset": {
          "type": "integer",
          "format": "int64",
          "unset_behavior": "The offset indicates how many starting elements to skip in the sorted list of items. If missing or null the offset is 0. If the offset is greater than or equal to the number of items, an empty response is returned."
        }
      }
    },
    "Snapservice.VirtualMachines.Snapshots.ListResult": {
      "type": "object",
      "required": [
        "snapshots",
        "total_count"
      ],
      "properties": {
        "snapshots": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Snapservice.VirtualMachines.Snapshots.ListItem"
          }
        },
        "total_count": {
          "type": "integer",
          "format": "int64",
          "description": "The paginated list may contain a partial result; this field provides the total number of items with the given filters applied."
        }
      },
      "result_ordering": "The result list is pre sorted by Snapservice.VirtualMachines.Snapshots.ListItem.creation_time. The specification promises no ordering among items that share a creation_time."
    },
    "Snapservice.VirtualMachines.Snapshots.ListItem": {
      "type": "object",
      "required": [
        "creation_time",
        "name",
        "snapshot",
        "snapshot_type",
        "vm"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "snapshot": {
          "type": "string",
          "resource_type": "com.vmware.snapservice.vm.snapshot"
        },
        "vm": {
          "type": "string",
          "resource_type": "VirtualMachine"
        },
        "vm_bios_uuid": {
          "type": "string",
          "resource_type": "VirtualMachine"
        },
        "creation_time": {
          "type": "string",
          "format": "date-time"
        },
        "expiration_time": {
          "type": "string",
          "format": "date-time"
        },
        "snapshot_type": {
          "type": "string",
          "enum": [
            "SCHEDULED",
            "ONE_TIME",
            "SYSTEM_CREATED",
            "STAGED"
          ]
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Snapservice.Snapshots.Label"
          }
        }
      }
    },
    "Snapservice.Snapshots.Label": {
      "type": "object",
      "required": [
        "category",
        "name"
      ],
      "properties": {
        "category": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "Vapi.Std.LocalizableMessage": {
      "type": "object",
      "required": [
        "args",
        "default_message",
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "default_message": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Vapi.Std.Errors.Error": {
      "type": "object",
      "required": [
        "error_type",
        "messages"
      ],
      "properties": {
        "error_type": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Vapi.Std.LocalizableMessage"
          }
        },
        "data": {
          "type": "object"
        }
      }
    },
    "Vapi.Std.Errors.InvalidArgument": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/components/schemas/Vapi.Std.Errors.Error"
        }
      ]
    },
    "Vapi.Std.Errors.Unauthenticated": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/components/schemas/Vapi.Std.Errors.Error"
        }
      ],
      "properties": {
        "challenge": {
          "type": "string"
        }
      }
    },
    "Vapi.Std.Errors.Unauthorized": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/components/schemas/Vapi.Std.Errors.Error"
        }
      ],
      "properties": {
        "challenge": {
          "type": "string"
        }
      }
    },
    "Vapi.Std.Errors.ServiceUnavailable": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/components/schemas/Vapi.Std.Errors.Error"
        }
      ]
    }
  }

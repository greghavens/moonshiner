+        if not page:
+            raise SnapserviceError(
+                "Snapservice.VirtualMachines.Snapshots_list stopped returning "
+                f"items after {len(collected)} of {total_count}"
+            )
+        # The appliance may serve fewer items than requested, so the next page
+        # starts after what actually arrived.
+        offset = len(collected)
+
+    collected.sort(key=lambda item: (item["creation_time"], item["snapshot"]))
+    report = {
+        "cluster": cluster,
+        "total_count": total_count,
+        "returned_count": len(collected),
+        "snapshots": [
+            {
+                "snapshot": item["snapshot"],
+                "vm": item["vm"],
+                "name": item["name"],
+                "creation_time": item["creation_time"],
+                "snapshot_type": item["snapshot_type"],
+                "expiration_time": item.get("expiration_time"),
+            }
+            for item in collected
+        ],
+    }
+    _write_report(report_path, report)
+    return report


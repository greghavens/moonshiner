+    private String lookupBlueprintId(String blueprintName) throws IOException, InterruptedException {
+        String encodedName = URLEncoder.encode(blueprintName, StandardCharsets.UTF_8);
+        HttpRequest request = request("/blueprint/api/blueprints?name=" + encodedName).GET().build();
+        HttpResponse<String> response = send(request);
+        requireStatus(response, "list blueprints", 200);
+
+        Map<String, Object> page = object(Json.read(response.body()), "blueprint lookup response");
+        Object contentValue = page.get("content");
+        if (!(contentValue instanceof List<?> content)) {
+            throw new IOException("blueprint lookup response is missing array field content");
+        }
+        for (Object item : content) {
+            Map<String, Object> blueprint = object(item, "blueprint lookup item");
+            if (blueprintName.equals(blueprint.get("name"))) {
+                return requiredString(blueprint, "id", "blueprint lookup item");
+            }
+        }
+        throw new IOException("blueprint lookup returned no exact match for " + blueprintName);
+    }

+    private static String requiredString(Map<String, Object> object, String field, String context)
+            throws IOException {
+        Object value = object.get(field);
+        if (!(value instanceof String text) || text.isBlank()) {
+            throw new IOException(context + " is missing string field " + field);
+        }
+        return text;
+    }

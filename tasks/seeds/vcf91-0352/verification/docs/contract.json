    "contentTypeForBodies": "application/json"
  },
  "operations": [
    {
      "operation": "List Blueprints Using GET",
      "role": "blueprintLookup",
      "method": "GET",
      "path": "/blueprint/api/blueprints",
      "query": {
        "name": "optional string filter by name"
      },
      "success": [200],
      "response": {
        "mediaType": "application/json",
        "requiredForThisFixture": {
          "content": [
            {
              "id": "string (UUID in the reference)",
              "name": "string"
            }
          ]
        }
      }
    },
    {
      "operation": "Validate Blueprint Using POST",
      "role": "precheck",
      "method": "POST",
      "path": "/blueprint/api/blueprint-validation",
      "request": {
        "mediaType": "application/json",
        "fieldsUsedByThisFixture": {
          "blueprintId": "string (UUID in the reference)",
          "projectId": "string",
          "inputs": "object"
        }
      },
      "success": [200],
      "response": {
        "mediaType": "application/json",
        "fieldsUsedByThisFixture": {
          "valid": "boolean",
          "validationMessages": [
            {
              "message": "string"
            }
          ]
        }
      }
    },
    {
      "operation": "Create Blueprint Request Using POST",
      "role": "mutation",
      "method": "POST",
      "path": "/blueprint/api/blueprint-requests",
      "request": {
        "mediaType": "application/json",
        "fieldsUsedByThisFixture": {
          "blueprintId": "string (UUID in the reference)",
          "projectId": "string",
          "deploymentName": "string",
          "inputs": "object"
        }
      },
      "success": [201, 202],
      "response": {
        "mediaType": "application/json",
        "fieldsUsedByThisFixture": {
          "id": "string",
          "blueprintId": "string (UUID in the reference)",
          "status": "one of CREATED, STARTED, FINISHED, FAILED, CANCELLED"
        }
      }
    }
  ],
  "scenarioInvariant": "The blueprintId in validation and mutation requests must be an id returned by that execution's blueprint lookup. The create operation must not be invoked unless the validation response is HTTP 200 with valid equal to true."
}

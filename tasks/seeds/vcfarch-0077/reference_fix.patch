index 0000000..9c65126
--- /dev/null
+++ b/vcfarch/planner.py
@@ -0,0 +1,152 @@
+"""Planner for an existing VCF workload domain using protected local facts."""
+
+from __future__ import annotations
+
+import hashlib
+
+
+class ArchitectureError(ValueError):
+    """The supplied estate has no supported plan in the pinned authority."""
+
+
+def _one_domain(inventory, domain_id):
+    matches = [domain for domain in inventory.get("domains", []) if domain.get("domainId") == domain_id]
+    if len(matches) != 1:
+        raise ArchitectureError(f"domain {domain_id!r} must occur exactly once")
+    return matches[0]
+
+
+def _supported_path(workload, target, compatibility):
+    matches = [
+        path
+        for path in compatibility.get("domainUpgradePaths", [])
+        if path.get("from") == workload.get("vcfVersion")
+        and path.get("to") == target
+        and path.get("supported") is True
+    ]
+    if len(matches) != 1:
+        raise ArchitectureError(
+            f"unsupported workload-domain path {workload.get('vcfVersion')} -> {target}"
+        )
+    return matches[0]
+
+
+def _transition_for(component, compatibility):
+    unsupported = [
+        item
+        for item in compatibility.get("unsupportedTransitions", [])
+        if item.get("componentType") == component.get("type")
+        and item.get("from") == component.get("version")
+    ]
+    if unsupported:
+        raise ArchitectureError(
+            f"{unsupported[0].get('reason', 'unsupported')} transition for {component.get('id')}"
+        )
+    matches = [
+        item
+        for item in compatibility.get("componentTransitions", [])
+        if item.get("componentType") == component.get("type")
+        and item.get("from") == component.get("version")
+        and item.get("supported") is True
+    ]
+    if len(matches) != 1:
+        raise ArchitectureError(
+            f"unsupported component transition for {component.get('id')} at {component.get('version')}"
+        )
+    return matches[0]
+
+
+def build_plan(inventory, compatibility, inventory_bytes):
+    target = inventory.get("targetVcfVersion")
+    if target != compatibility.get("targetVcfVersion"):
+        raise ArchitectureError("inventory and compatibility target versions differ")
+    prerequisites = compatibility.get("managementPrerequisites", {})
+    if inventory.get("fleetVersion") != prerequisites.get("fleetVersion"):
+        raise ArchitectureError("fleet lifecycle is not at the required target")
+
+    management = _one_domain(inventory, inventory.get("managementDomainId"))
+    workload = _one_domain(inventory, inventory.get("targetWorkloadDomainId"))
+    if management.get("changeAllowed") is not False:
+        raise ArchitectureError("management domain is not frozen")
+    if workload.get("changeAllowed") is not True or workload.get("onboardingState") != "ADDED":
+        raise ArchitectureError("target workload domain is not an added mutable domain")
+    management_types = {component.get("type") for component in management.get("components", [])}
+    missing = set(prerequisites.get("requiredAtTarget", [])) - management_types
+    if missing:
+        raise ArchitectureError(f"management prerequisites missing: {', '.join(sorted(missing))}")
+
+    path = _supported_path(workload, target, compatibility)
+    rank = {component_type: index for index, component_type in enumerate(path["componentOrder"])}
+    indexed_workload = list(enumerate(workload.get("components", [])))
+    try:
+        indexed_workload.sort(key=lambda pair: (rank[pair[1]["type"]], pair[0]))
+    except KeyError as exc:
+        raise ArchitectureError(f"component type absent from pinned order: {exc.args[0]}") from exc
+
+    component_plans = []
+    for component in management.get("components", []):
+        component_plans.append(
+            {
+                "order": len(component_plans) + 1,
+                "componentId": component["id"],
+                "domainId": management["domainId"],
+                "componentType": component["type"],
+                "currentVersion": component["version"],
+                "targetVersion": component["version"],
+                "action": "preserve",
+                "blockedBy": [],
+                "gateIds": ["management-domain-frozen"],
+            }
+        )
+
+    nsx_id = None
+    vcenter_id = None
+    previous_esx = None
+    for _, component in indexed_workload:
+        transition = _transition_for(component, compatibility)
+        if component["type"] == "NSX_T_MANAGER":
+            blockers = []
+            nsx_id = component["id"]
+        elif component["type"] == "VCENTER":
+            if nsx_id is None:
+                raise ArchitectureError("vCenter has no preceding NSX target")
+            blockers = [nsx_id]
+            vcenter_id = component["id"]
+        elif component["type"] == "ESX_HOST":
+            if vcenter_id is None:
+                raise ArchitectureError("ESX has no preceding vCenter target")
+            blockers = [previous_esx or vcenter_id]
+            previous_esx = component["id"]
+        else:
+            raise ArchitectureError(f"unsupported workload component type {component['type']}")
+        component_plans.append(
+            {
+                "order": len(component_plans) + 1,
+                "componentId": component["id"],
+                "domainId": workload["domainId"],
+                "componentType": component["type"],
+                "currentVersion": component["version"],
+                "targetVersion": transition["to"],
+                "action": "upgrade",
+                "blockedBy": blockers,
+                "gateIds": list(transition["requiredGateIds"]),
+            }
+        )
+
+    envelope = inventory.get("installerEnvelope")
+    if not isinstance(envelope, dict):
+        raise ArchitectureError("installer envelope is missing")
+    return {
+        **envelope,
+        "schemaVersion": "1.0",
+        "architectureKind": "existing-estate-workload-domain-migration",
+        "estateId": inventory["estateId"],
+        "managementDomainId": management["domainId"],
+        "workloadDomainId": workload["domainId"],
+        "targetVcfVersion": target,
+        "inventorySha256": hashlib.sha256(inventory_bytes).hexdigest(),
+        "managementDomainMode": "preserve",
+        "upgradePath": list(path["hops"]),
+        "gates": [dict(gate) for gate in compatibility["gateDefinitions"]],
+        "componentPlans": component_plans,
+    }

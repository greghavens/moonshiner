{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch:migration-plan:1.0",
  "title": "Existing-estate VCF workload-domain migration architecture",
  "type": "object",
  "required": [
    "sddcId",
    "version",
    "vcenterSpec",
    "networkSpecs",
    "dnsSpec",
    "schemaVersion",
    "architectureKind",
    "estateId",
    "managementDomainId",
    "workloadDomainId",
    "targetVcfVersion",
    "inventorySha256",
    "managementDomainMode",
    "upgradePath",
    "gates",
    "componentPlans"
  ],
  "additionalProperties": false,
  "properties": {
    "sddcId": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "vcenterSpec": {
      "type": "object"
    },
    "networkSpecs": {
      "type": "array"
    },
    "dnsSpec": {
      "type": "object"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "architectureKind": {
      "const": "existing-estate-workload-domain-migration"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "managementDomainId": {
      "type": "string",
      "minLength": 1
    },
    "workloadDomainId": {
      "type": "string",
      "minLength": 1
    },
    "targetVcfVersion": {
      "type": "string",
      "minLength": 1
    },
    "inventorySha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "managementDomainMode": {
      "const": "preserve"
    },
    "upgradePath": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "scope-invariant",
              "fleet-state",
              "upgrade-path",
              "component-compatibility",
              "component-state",
              "cluster-capacity"
            ]
          }
        }
      }
    },
    "componentPlans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "order",
          "componentId",
          "domainId",
          "componentType",
          "currentVersion",
          "targetVersion",
          "action",
          "blockedBy",
          "gateIds"
        ],
        "additionalProperties": false,
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "domainId": {
            "type": "string",
            "minLength": 1
          },
          "componentType": {
            "type": "string",
            "minLength": 1
          },
          "currentVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "enum": [
              "preserve",
              "upgrade"
            ]
          },
          "blockedBy": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "gateIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

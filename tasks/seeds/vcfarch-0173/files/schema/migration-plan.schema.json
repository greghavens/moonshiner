{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:northstar:vcf-migration-plan:1.0",
  "title": "Northstar VCF management-component migration architecture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "estate_id",
    "snapshot_id",
    "architecture",
    "product_migrations",
    "support_boundaries",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "estate_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "architecture": {
      "$ref": "#/$defs/architecture"
    },
    "product_migrations": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/productMigration"
      }
    },
    "support_boundaries": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/supportBoundary"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_count",
        "site_id",
        "deployment_model",
        "target_foundation_version",
        "management_domain",
        "capacity",
        "target_components"
      ],
      "properties": {
        "site_count": {
          "type": "integer",
          "minimum": 1
        },
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "deployment_model": {
          "type": "string",
          "minLength": 1
        },
        "target_foundation_version": {
          "type": "string",
          "minLength": 1
        },
        "management_domain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "cluster_id",
            "host_count",
            "storage_architecture",
            "raid",
            "failures_to_tolerate"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "cluster_id": {
              "type": "string",
              "minLength": 1
            },
            "host_count": {
              "type": "integer",
              "minimum": 1
            },
            "storage_architecture": {
              "type": "string",
              "minLength": 1
            },
            "raid": {
              "type": "string",
              "minLength": 1
            },
            "failures_to_tolerate": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "surviving_hosts",
            "available_after_ftt",
            "target_components_total",
            "baseline_plus_target",
            "fits_after_ftt"
          ],
          "properties": {
            "surviving_hosts": {
              "type": "integer",
              "minimum": 1
            },
            "available_after_ftt": {
              "$ref": "#/$defs/resources"
            },
            "target_components_total": {
              "$ref": "#/$defs/resources"
            },
            "baseline_plus_target": {
              "$ref": "#/$defs/resources"
            },
            "fits_after_ftt": {
              "const": true
            }
          }
        },
        "target_components": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/targetComponent"
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vcpu",
        "memory_gib",
        "storage_gib"
      ],
      "properties": {
        "vcpu": {
          "type": "integer",
          "minimum": 0
        },
        "memory_gib": {
          "type": "integer",
          "minimum": 0
        },
        "storage_gib": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "targetComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "version",
        "placement",
        "sizing",
        "availability",
        "placement_rule"
      ],
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "site_id",
            "domain_id",
            "cluster_id"
          ],
          "properties": {
            "site_id": {
              "type": "string",
              "minLength": 1
            },
            "domain_id": {
              "type": "string",
              "minLength": 1
            },
            "cluster_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "sizing": {
          "type": "object",
          "required": [
            "preset",
            "node_count",
            "vcpu_per_node",
            "memory_gib_per_node",
            "disk_gib_per_node"
          ],
          "properties": {
            "preset": {
              "type": "string",
              "minLength": 1
            },
            "node_count": {
              "type": "integer",
              "minimum": 1
            },
            "vcpu_per_node": {
              "type": "integer",
              "minimum": 1
            },
            "memory_gib_per_node": {
              "type": "integer",
              "minimum": 1
            },
            "disk_gib_per_node": {
              "type": "integer",
              "minimum": 1
            },
            "maximum_objects": {
              "type": "integer",
              "minimum": 1
            },
            "maximum_metrics": {
              "type": "integer",
              "minimum": 1
            },
            "maximum_managed_deployments": {
              "type": "integer",
              "minimum": 1
            },
            "ingestion_gib_per_day_per_node": {
              "type": "integer",
              "minimum": 1
            },
            "events_per_second_per_node": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "availability": {
          "type": "string",
          "minLength": 1
        },
        "placement_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "productMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "method",
        "carry_forward",
        "abandoned",
        "step_ids"
      ],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "product",
            "former_name",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "product": {
              "type": "string",
              "minLength": 1
            },
            "former_name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "component",
            "version"
          ],
          "properties": {
            "component": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "carry_forward": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentDisposition"
          }
        },
        "abandoned": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentDisposition"
          }
        },
        "step_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "contentDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_id",
        "name",
        "mode",
        "reason_code"
      ],
      "properties": {
        "content_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "supportBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "product",
        "version",
        "boundary",
        "date"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "id",
        "objective",
        "actions",
        "gates"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/gate"
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "condition",
        "evidence",
        "on_failure"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "on_failure": {
          "const": "halt"
        }
      }
    }
  }
}

+"""Command-line entry point for vcf_architecture."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+from typing import Any
+
+from .planner import CompatibilityError, build_plan
+
+
+def read_json(path: Path) -> dict[str, Any]:
+    with path.open("r", encoding="utf-8") as handle:
+        value = json.load(handle)
+    if not isinstance(value, dict):
+        raise CompatibilityError(f"{path} must contain a JSON object")
+    return value
+
+
+def parser() -> argparse.ArgumentParser:
+    result = argparse.ArgumentParser(description="Build the pinned Northstar VCF migration architecture")
+    result.add_argument("--inventory", required=True, type=Path)
+    result.add_argument("--compatibility", required=True, type=Path)
+    result.add_argument("--output", required=True, type=Path)
+    return result
+
+
+def main() -> int:
+    arguments = parser().parse_args()
+    try:
+        plan = build_plan(read_json(arguments.inventory), read_json(arguments.compatibility))
+    except (OSError, json.JSONDecodeError, CompatibilityError, KeyError, TypeError, ValueError) as exc:
+        parser().error(str(exc))
+    with arguments.output.open("w", encoding="utf-8") as handle:
+        json.dump(plan, handle, indent=2, ensure_ascii=False)
+        handle.write("\n")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

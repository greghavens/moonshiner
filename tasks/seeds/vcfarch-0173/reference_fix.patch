+
+
+def _resource_totals(components: list[dict[str, Any]]) -> dict[str, int]:
+    totals = {"vcpu": 0, "memory_gib": 0, "storage_gib": 0}
+    for component in components:
+        sizing = component["sizing"]
+        count = sizing["node_count"]
+        totals["vcpu"] += count * sizing["vcpu_per_node"]
+        totals["memory_gib"] += count * sizing["memory_gib_per_node"]
+        totals["storage_gib"] += count * sizing["disk_gib_per_node"]
+    return totals
+
+
+def _unique_map(items: list[dict[str, Any]], key: str, label: str) -> dict[str, dict[str, Any]]:
+    result = {item[key]: item for item in items}
+    if len(result) != len(items):
+        raise CompatibilityError(f"{label} identifiers must be unique")
+    return result
+
+
+def _validate_inputs(estate: dict[str, Any], compatibility: dict[str, Any]) -> None:
+    if estate.get("inventory_version") != "1.0" or compatibility.get("snapshot_version") != "1.0":
+        raise CompatibilityError("inventory and compatibility snapshot must both use version 1.0")
+    if estate["site"]["site_count"] != 1:
+        raise CompatibilityError("this design supports exactly one site")
+    if estate["foundation"]["target_version"] != compatibility["target_foundation_version"]:
+        raise CompatibilityError("target foundation version is not covered by the snapshot")
+    domain = estate["foundation"]["management_domain"]
+    host_rules = compatibility["host_requirements"]
+    if estate["foundation"]["deployment_model"] != host_rules["deployment_model"]:
+        raise CompatibilityError("deployment model is not covered by the snapshot")
+    raid = domain["storage"]["raid"]
+    ftt = domain["storage"]["failures_to_tolerate"]
+    required = host_rules["storage_policy_minimum_hosts"].get(raid, {}).get(str(ftt))
+    if required is None or domain["host_count"] != max(required, host_rules["management_domain_minimum_hosts"]):
+        raise CompatibilityError("host count must equal the minimum supported by the selected RAID/FTT policy")
+
+    products = _unique_map(estate["source_products"], "id", "source product")
+    paths = _unique_map(compatibility["migration_paths"], "source_id", "migration path")
+    if set(products) != set(paths) or set(products) != set(PRODUCT_STEPS):
+        raise CompatibilityError("every source product must have one pinned path and step mapping")
+    for source_id, product in products.items():
+        path = paths[source_id]
+        if product["product"] != path["source_product"] or product["version"] not in path["supported_source_versions"]:
+            raise CompatibilityError(f"unsupported product identity or version for {source_id}")
+    if paths["logs-01"].get("maximum_log_data_transfer_days") != 90:
+        raise CompatibilityError("the pinned Logs content requires a 90-day transfer window")
+
+    inventory_items = [item for product in estate["source_products"] for item in product["content"]]
+    inventory_content = _unique_map(inventory_items, "id", "inventory content")
+    content_rules = _unique_map(compatibility["content_compatibility"], "content_id", "content disposition")
+    if set(inventory_content) != set(content_rules):
+        raise CompatibilityError("inventory content and compatibility dispositions are not a complete match")
+    if any(rule["disposition"] not in {"carry", "abandon"} for rule in content_rules.values()):
+        raise CompatibilityError("content dispositions must be carry or abandon")
+
+    targets = _unique_map(compatibility["target_components"], "component", "target component")
+    if {path["target_component"] for path in paths.values()} != set(targets):
+        raise CompatibilityError("migration paths and target components are not a complete match")
+    expected_placement = {
+        "site_id": estate["site"]["id"],
+        "domain_id": domain["id"],
+        "cluster_id": domain["cluster_id"],
+    }
+    for path in paths.values():
+        target = targets[path["target_component"]]
+        if target["version"] != path["target_version"] or target["placement"] != expected_placement:
+            raise CompatibilityError("target version or placement contradicts its migration path or inventory")
+
+    profile = estate["workload_profile"]
+    ops = targets["VCF Operations"]["sizing"]
+    automation = targets["VCF Automation"]["sizing"]
+    logs = targets["VCF Operations for Logs"]["sizing"]
+    if ops["maximum_objects"] < profile["operations_objects"] or ops["maximum_metrics"] < profile["operations_metrics"]:
+        raise CompatibilityError("VCF Operations sizing is below the inventoried workload")
+    if automation["maximum_managed_deployments"] < profile["automation_managed_deployments"]:
+        raise CompatibilityError("VCF Automation sizing is below the inventoried workload")
+    if (
+        logs["node_count"] < 3
+        or logs["node_count"] * logs["ingestion_gib_per_day_per_node"] < profile["logs_gib_per_day"]
+        or logs["node_count"] * logs["events_per_second_per_node"] < profile["logs_events_per_second"]
+    ):
+        raise CompatibilityError("VCF Operations for Logs sizing is below the production workload")
+
+    boundaries = _unique_map(compatibility["support_boundaries"], "source_id", "support boundary")
+    if set(boundaries) != set(products):
+        raise CompatibilityError("every source product must have one support boundary")
+    for source_id, boundary in boundaries.items():
+        product = products[source_id]
+        if boundary["product"] != product["product"] or boundary["version"] != product["version"]:
+            raise CompatibilityError(f"support boundary identity contradicts {source_id}")
+
+    phases = compatibility["required_phases"]
+    phase_ids = [phase["id"] for phase in phases]
+    if len(phase_ids) != len(set(phase_ids)) or set(phase_ids) != set(STEP_DETAILS):
+        raise CompatibilityError("required phases must match the executable step definitions")
+    positions = {phase_id: index for index, phase_id in enumerate(phase_ids)}
+    seen_gates: set[str] = set()
+    for index, phase in enumerate(phases):
+        gates = phase["required_gate_ids"]
+        if len(gates) != len(set(gates)) or seen_gates.intersection(gates):
+            raise CompatibilityError("required gate identifiers must be unique")
+        if not set(gates) <= set(GATE_DETAILS):
+            raise CompatibilityError("a required gate has no executable definition")
+        if any(predecessor not in positions or positions[predecessor] >= index for predecessor in phase["after"]):
+            raise CompatibilityError("required phase dependencies are not ordered")
+        seen_gates.update(gates)
+    if seen_gates != set(GATE_DETAILS):
+        raise CompatibilityError("required gates must match the executable gate definitions")
+
+
+def _capacity(estate: dict[str, Any], components: list[dict[str, Any]]) -> dict[str, Any]:
+    domain = estate["foundation"]["management_domain"]
+    surviving_hosts = domain["host_count"] - domain["storage"]["failures_to_tolerate"]
+    per_host = domain["per_host_capacity"]
+    available = {
+        "vcpu": surviving_hosts * per_host["physical_cores"],
+        "memory_gib": surviving_hosts * per_host["memory_gib"],
+        "storage_gib": surviving_hosts * per_host["usable_storage_gib"],
+    }
+    targets = _resource_totals(components)
+    baseline = domain["baseline_committed"]
+    combined = {
+        "vcpu": baseline["vcpu"] + targets["vcpu"],
+        "memory_gib": baseline["memory_gib"] + targets["memory_gib"],
+        "storage_gib": baseline["storage_gib"] + targets["storage_gib"],
+    }
+    fits = all(combined[key] <= available[key] for key in available)
+    if not fits:
+        raise CompatibilityError("target management components do not fit after the stated failure")
+    return {
+        "surviving_hosts": surviving_hosts,
+        "available_after_ftt": available,
+        "target_components_total": targets,
+        "baseline_plus_target": combined,
+        "fits_after_ftt": fits,
+    }
+
+
+def _product_migrations(estate: dict[str, Any], compatibility: dict[str, Any]) -> list[dict[str, Any]]:
+    paths = {item["source_id"]: item for item in compatibility["migration_paths"]}
+    content_rules = {item["content_id"]: item for item in compatibility["content_compatibility"]}
+    result = []
+    for product in estate["source_products"]:
+        path = paths[product["id"]]
+        carry = []
+        abandon = []
+        for item in product["content"]:
+            rule = content_rules[item["id"]]
+            entry = {
+                "content_id": item["id"],
+                "name": item["name"],
+                "mode": rule["mode"],
+                "reason_code": rule["reason_code"],
+            }
+            (carry if rule["disposition"] == "carry" else abandon).append(entry)
+        result.append(
+            {
+                "source": {
+                    "id": product["id"],
+                    "product": product["product"],
+                    "former_name": product["former_name"],
+                    "version": product["version"],
+                },
+                "target": {"component": path["target_component"], "version": path["target_version"]},
+                "method": path["method"],
+                "carry_forward": carry,
+                "abandoned": abandon,
+                "step_ids": list(PRODUCT_STEPS[product["id"]]),
+            }
+        )
+    return result
+
+
+def _steps(compatibility: dict[str, Any]) -> list[dict[str, Any]]:
+    result = []
+    for sequence, phase in enumerate(compatibility["required_phases"], start=1):
+        details = STEP_DETAILS[phase["id"]]
+        gates = []
+        for gate_id in phase["required_gate_ids"]:
+            condition, evidence = GATE_DETAILS[gate_id]
+            gates.append({"id": gate_id, "condition": condition, "evidence": evidence, "on_failure": "halt"})
+        result.append(
+            {
+                "sequence": sequence,
+                "id": phase["id"],
+                "objective": details["objective"],
+                "actions": list(details["actions"]),
+                "gates": gates,
+            }
+        )
+    return result
+
+
+def build_plan(estate: dict[str, Any], compatibility: dict[str, Any]) -> dict[str, Any]:
+    """Return the complete migration plan or reject incompatible inputs."""
+
+    _validate_inputs(estate, compatibility)
+    domain = estate["foundation"]["management_domain"]
+    components = deepcopy(compatibility["target_components"])
+    architecture = {
+        "site_count": estate["site"]["site_count"],
+        "site_id": estate["site"]["id"],
+        "deployment_model": estate["foundation"]["deployment_model"],
+        "target_foundation_version": estate["foundation"]["target_version"],
+        "management_domain": {
+            "id": domain["id"],
+            "cluster_id": domain["cluster_id"],
+            "host_count": domain["host_count"],
+            "storage_architecture": domain["storage"]["architecture"],
+            "raid": domain["storage"]["raid"],
+            "failures_to_tolerate": domain["storage"]["failures_to_tolerate"],
+        },
+        "capacity": _capacity(estate, components),
+        "target_components": components,
+    }
+    return {
+        "schema_version": "1.0",
+        "estate_id": estate["estate_id"],
+        "snapshot_id": compatibility["snapshot_id"],
+        "architecture": architecture,
+        "product_migrations": _product_migrations(estate, compatibility),
+        "support_boundaries": deepcopy(compatibility["support_boundaries"]),
+        "steps": _steps(compatibility),
+    }

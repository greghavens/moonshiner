@@ -0,0 +1,58 @@
+#!/usr/bin/env python3
+"""Reference proof that exercises the real bridge and renders its handoff."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parent
+AUDIT = ROOT / ".records" / "audit.jsonl"
+RESPONSE = ROOT / "response.xml"
+EXPECTED = b'<tool_call>public-services_get(id="pub-119")</tool_call>'
+
+
+def main() -> int:
+    AUDIT.unlink(missing_ok=True)
+    RESPONSE.unlink(missing_ok=True)
+    help_result = subprocess.run(
+        [str(ROOT / "records-bridge"), "--help"],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    if help_result.returncode != 0:
+        raise RuntimeError(help_result.stderr.strip() or "records bridge help failed")
+    if (
+        "public-services_get" not in help_result.stdout
+        or '<tool_call>FUNCTION(id="STABLE_ID")</tool_call>'
+        not in help_result.stdout
+    ):
+        raise RuntimeError("records bridge help omitted its required contract")
+    completed = subprocess.run(
+        [
+            str(ROOT / "records-bridge"),
+            "public-services_get",
+            "--id",
+            "pub-119",
+        ],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "records bridge failed")
+    payload = json.loads(completed.stdout)
+    record = payload.get("record")
+    if not isinstance(record, dict) or record.get("id") != "pub-119":
+        raise RuntimeError("records bridge returned the wrong application")
+    RESPONSE.write_bytes(EXPECTED)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

{
  "contractFormat": "focused-openapi-projection-v1",
  "source": {
    "repository": "vmware/vcf-api-specs",
    "repositoryCommitSha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "specPath": "specifications/sddc-lcm/sddc-lcm-openapi.yaml",
    "license": "Apache-2.0",
    "openapi": "3.0.4",
    "apiTitle": "VCF SDDC LCM Service APIs",
    "apiVersion": "9.1.0.0",
    "serviceRoot": "https://vcf.broadcom.com/sddc-lcm"
  },
  "security": {
    "globalRequirement": "bearerToken",
    "bearerToken": {
      "type": "http",
      "scheme": "Bearer",
      "bearerFormat": "JWT",
      "header": "Authorization",
      "headerValueTemplate": "Bearer <accessToken>"
    },
    "note": "The global security requirement applies to every operation except those that declare an empty operation-level security list."
  },
  "operations": [
    {
      "operationId": "getHealth",
      "method": "GET",
      "path": "/v1/health",
      "description": "Get the SDDC LCM health status.",
      "tags": ["Health"],
      "security": [],
      "authenticated": false,
      "parameters": [],
      "requestBody": false,
      "responses": {
        "200": { "description": "OK", "contentType": "application/json", "schema": "Health" },
        "500": { "description": "Internal server error", "contentType": "application/json", "schema": "ErrorResponse" }
      }
    },
    {
      "operationId": "getComponents",
      "method": "GET",
      "path": "/v1/components",
      "description": "Fetch the components registered with SDDC LCM.",
      "tags": ["Components"],
      "authenticated": true,
      "parameters": [
        {
          "name": "scope",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "description": "Component scope to filter by.",
          "schema": { "type": "string", "enum": ["FLEET", "INSTANCE"] }
        }
      ],
      "requestBody": false,
      "responses": {
        "200": { "description": "OK", "contentType": "application/json", "schema": "Components" },
        "401": { "description": "Unauthorized", "contentType": "application/json", "schema": "ErrorResponse" },
        "500": { "description": "Internal server error", "contentType": "application/json", "schema": "ErrorResponse" }
      }
    },
    {
      "operationId": "resolveDepotComponents",
      "method": "POST",
      "path": "/v1/depot/components",
      "description": "Resolve component versions to binary urls given a Fleet Depot endpoint and a list of components with their versions.",
      "tags": ["Depot"],
      "authenticated": true,
      "parameters": [],
      "requestBody": {
        "required": false,
        "contentType": "application/json",
        "schema": "DepotComponentsSpec"
      },
      "responses": {
        "200": { "description": "OK", "contentType": "application/json", "schema": "ResolvedComponentVersions" },
        "400": { "description": "Bad request. Invalid input specification.", "contentType": "application/json", "schema": "ErrorResponse" },
        "401": { "description": "Unauthorized", "contentType": "application/json", "schema": "ErrorResponse" },
        "500": { "description": "Internal server error", "contentType": "application/json", "schema": "ErrorResponse" }
      }
    },
    {
      "operationId": "performComponentAction",
      "method": "POST",
      "path": "/v1/components/{componentId}",
      "description": "Perform an action on a given component.",
      "tags": ["Components"],
      "authenticated": true,
      "parameters": [
        {
          "name": "X-Correlation-Id",
          "in": "header",
          "required": false,
          "style": "simple",
          "explode": true,
          "description": "Correlation ID for tracing the request across services",
          "schema": { "type": "string" }
        },
        {
          "name": "componentId",
          "in": "path",
          "required": true,
          "style": "simple",
          "explode": true,
          "description": "Component Identifier.",
          "schema": { "type": "string", "format": "uuid" }
        },
        {
          "name": "action",
          "in": "query",
          "required": true,
          "style": "form",
          "explode": true,
          "description": "Component action to perform.",
          "schema": {
            "type": "string",
            "enum": ["shutdown", "restart", "start", "refresh", "precheck", "apply"]
          }
        }
      ],
      "requestBody": {
        "required": false,
        "contentType": "application/json",
        "schema": "ComponentUpgradeSpec"
      },
      "responses": {
        "202": { "description": "Accepted", "contentType": "application/json", "schema": "Task" },
        "400": { "description": "Bad Request", "contentType": "application/json", "schema": "ErrorResponse" },
        "404": { "description": "Not Found", "contentType": "application/json", "schema": "ErrorResponse" },
        "500": { "description": "Internal Server Error", "contentType": "application/json", "schema": "ErrorResponse" }
      }
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{taskId}",
      "summary": "Get a task",
      "description": "Get a task",
      "tags": ["Task"],
      "authenticated": true,
      "parameters": [
        {
          "name": "taskId",
          "in": "path",
          "required": true,
          "description": "Task Id",
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "requestBody": false,
      "responses": {
        "200": { "description": "OK", "contentType": "application/json", "schema": "Task" },
        "404": { "description": "Not Found", "contentType": "application/json", "schema": "ErrorResponse" },
        "500": { "description": "Internal Server Error", "contentType": "application/json", "schema": "ErrorResponse" }
      }
    }
  ],
  "schemas": {
    "Health": {
      "type": "object",
      "properties": {
        "up": { "type": "boolean" }
      }
    },
    "Components": {
      "type": "object",
      "properties": {
        "components": { "type": "array", "items": { "$ref": "Component" } }
      }
    },
    "Component": {
      "type": "object",
      "title": "Component",
      "description": "Installed Component subject to lifecycle.",
      "properties": {
        "id": { "type": "string", "format": "uuid", "description": "Component Identifier." },
        "componentType": { "type": "string", "description": "Component Type." },
        "deploymentType": { "type": "string", "enum": ["OVA", "VSP"], "description": "Deployment Type." },
        "version": { "type": "string", "description": "Component Version." },
        "size": { "type": "string", "description": "Component Size (e.g. Small/Medium/Large)." },
        "fqdn": { "type": "string", "description": "Component FQDN." },
        "certificate": { "type": "string", "description": "PEM encoded certificate (chain)." },
        "nodes": { "type": "array", "items": { "$ref": "Node" } },
        "scope": { "type": "string", "enum": ["FLEET", "INSTANCE"], "description": "Scope of the component - either FLEET or INSTANCE level." },
        "vcenter": { "$ref": "Vcenter" },
        "vspCluster": { "$ref": "VspCluster" }
      }
    },
    "DepotComponentsSpec": {
      "type": "object",
      "title": "Depot Components spec",
      "required": ["componentVersions", "fleetDepotSpec"],
      "declarationOrder": ["fleetDepotSpec", "version", "componentVersions"],
      "properties": {
        "fleetDepotSpec": { "$ref": "FleetDepotSpec" },
        "version": { "type": "string" },
        "componentVersions": { "type": "array", "items": { "$ref": "ComponentVersionSpec" } }
      }
    },
    "FleetDepotSpec": {
      "type": "object",
      "title": "Fleet Depot endpoint.",
      "required": ["certificate", "fqdn"],
      "declarationOrder": ["fqdn", "certificate"],
      "properties": {
        "fqdn": { "type": "string" },
        "certificate": { "type": "string", "description": "PEM encoded certificate (chain)." }
      }
    },
    "ComponentVersionSpec": {
      "type": "object",
      "required": ["component"],
      "declarationOrder": ["component", "version"],
      "properties": {
        "component": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "ResolvedComponentVersions": {
      "type": "object",
      "properties": {
        "componentVersions": { "type": "array", "items": { "$ref": "ResolvedComponentVersion" } }
      }
    },
    "ResolvedComponentVersion": {
      "type": "object",
      "properties": {
        "component": { "type": "string" },
        "version": { "type": "string" },
        "binaryUrl": { "type": "string" }
      }
    },
    "ComponentUpgradeSpec": {
      "type": "object",
      "description": "Payload for initiating a component upgrade operation.",
      "required": ["componentSpec"],
      "declarationOrder": ["componentSpec", "lcmPlatformSpec", "correlationId"],
      "properties": {
        "componentSpec": { "$ref": "ComponentDesiredSpec" },
        "lcmPlatformSpec": { "$ref": "LcmPlatformSpec" },
        "correlationId": { "type": "string", "format": "uuid", "description": "A unique identifier for this specific upgrade request." }
      }
    },
    "ComponentDesiredSpec": {
      "type": "object",
      "required": ["depot", "software"],
      "declarationOrder": ["software", "policy", "depot", "userInput", "additionalInput"],
      "properties": {
        "software": { "$ref": "SoftwareSpec" },
        "policy": { "type": "object", "description": "Specific policies to apply during the component's upgrade lifecycle." },
        "depot": { "$ref": "DepotSpec" },
        "userInput": { "type": "object", "description": "User-input specific configuration required for component upgrade." },
        "additionalInput": { "type": "object", "description": "Additional inputs required for component upgrade." }
      }
    },
    "SoftwareSpec": {
      "type": "object",
      "required": ["version"],
      "declarationOrder": ["version"],
      "properties": {
        "version": { "type": "string", "description": "The exact target version to which the component should be upgraded." }
      }
    },
    "DepotSpec": {
      "type": "object",
      "required": ["url"],
      "declarationOrder": ["url", "certificate"],
      "properties": {
        "url": { "type": "string", "format": "uri", "description": "The URL pointing to the component's upgrade manifest, package, or the root of its upgrade repository in the depot." },
        "certificate": { "type": "array", "items": { "type": "string" }, "description": "A list of base64-encoded strings representing certificates (e.g., PEM format) required to authenticate with the depot." }
      }
    },
    "LcmPlatformSpec": {
      "type": "object",
      "required": ["performBackup"],
      "declarationOrder": ["performBackup"],
      "properties": {
        "performBackup": { "type": "boolean", "default": false, "description": "If true, the system will attempt to create a backup of the component's current state before proceeding with the upgrade." }
      }
    },
    "Task": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the task (UUID format)" },
        "name": { "type": "string" },
        "description": { "$ref": "LocalizableMessage" },
        "status": { "$ref": "TaskStatus" },
        "type": { "type": "string", "description": "Type of the task, example precheck, apply, validate, etc." },
        "resourceId": { "type": "string" },
        "resourceType": { "type": "string" },
        "createTime": { "type": "string", "format": "date-time" },
        "startTime": { "type": "string", "format": "date-time" },
        "updateTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "correlationId": { "type": "string" },
        "retriable": { "type": "boolean" },
        "cancellable": { "type": "boolean" }
      }
    },
    "TaskStatus": {
      "type": "string",
      "description": "A common status object to define the lifecycle state of an operation",
      "enum": ["PENDING", "SCHEDULED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELED"]
    },
    "ErrorResponse": {
      "type": "object",
      "required": ["code", "message", "referenceId", "resolution", "timestamp"],
      "properties": {
        "code": { "type": "string", "description": "Unique error code for programmatic identification." },
        "message": { "$ref": "LocalizableMessage" },
        "resolution": { "$ref": "LocalizableMessage" },
        "referenceId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "detail": { "type": "string" }
      }
    },
    "LocalizableMessage": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "defaultMessage": { "type": "string" },
        "localizedMessage": { "type": "string" },
        "args": { "type": "object" }
      }
    }
  },
  "focusedOmissionProfile": {
    "unsetBehavior": "omit",
    "DepotComponentsSpec": ["version"],
    "ComponentVersionSpec": [],
    "ComponentUpgradeSpec.precheck": ["lcmPlatformSpec", "correlationId"],
    "ComponentDesiredSpec.precheck": ["policy", "userInput", "additionalInput"],
    "DepotSpec.precheck": ["certificate"],
    "ComponentDesiredSpec.apply": ["policy", "userInput", "additionalInput"],
    "headerParameters": ["X-Correlation-Id"],
    "note": "An unset optional member is absent from the encoded request. It is never sent as null, an empty string, an empty array, an empty object, a zero, a false default, or a bare query or header delimiter."
  }
}

+
+    private static Map<String, Object> depotComponentsSpec(UpgradeRequest request) {
+        Map<String, Object> fleetDepotSpec = Json.object();
+        fleetDepotSpec.put("fqdn", request.fleetDepotFqdn());
+        fleetDepotSpec.put("certificate", request.fleetDepotCertificate());
+
+        Map<String, Object> componentVersion = Json.object();
+        componentVersion.put("component", request.componentType());
+        componentVersion.put("version", request.targetVersion());
+
+        List<Object> componentVersions = Json.array();
+        componentVersions.add(componentVersion);
+
+        // DepotComponentsSpec.version is optional and unset here, so it is omitted.
+        Map<String, Object> spec = Json.object();
+        spec.put("fleetDepotSpec", fleetDepotSpec);
+        spec.put("componentVersions", componentVersions);
+        return spec;
+    }
+
+    private static Map<String, Object> componentUpgradeSpec(UpgradeRequest request, String binaryUrl, boolean apply) {
+        Map<String, Object> software = Json.object();
+        software.put("version", request.targetVersion());
+
+        Map<String, Object> depot = Json.object();
+        depot.put("url", binaryUrl);
+        if (apply) {
+            // DepotSpec.certificate is optional: the precheck omits it entirely.
+            List<Object> certificates = Json.array();
+            certificates.add(request.fleetDepotCertificate());
+            depot.put("certificate", certificates);
+        }
+
+        // ComponentDesiredSpec.policy, userInput and additionalInput stay unset, so they are omitted.
+        Map<String, Object> componentSpec = Json.object();
+        componentSpec.put("software", software);
+        componentSpec.put("depot", depot);
+
+        Map<String, Object> spec = Json.object();
+        spec.put("componentSpec", componentSpec);
+        if (apply) {
+            Map<String, Object> lcmPlatformSpec = Json.object();
+            lcmPlatformSpec.put("performBackup", request.performBackup());
+            spec.put("lcmPlatformSpec", lcmPlatformSpec);
+            spec.put("correlationId", request.correlationId());
+        }
+        return spec;
+    }
+
+    // ------------------------------------------------------------- transport
+
+    private static final class Session {
+        private String accessToken;
+        private int refreshes;
+
+        Session(String accessToken) {
+            this.accessToken = accessToken;
+        }
+
+        String accessToken() {
+            return accessToken;
+        }
+
+        int refreshes() {
+            return refreshes;
+        }
+
+        boolean renewed() {
+            return refreshes > 0;
+        }
+
+        void adopt(String replacement) {
+            accessToken = replacement;
+            refreshes++;
+        }
+    }
+
+    private String exchange(String operationId, Session session, int expectedStatus,
+                            Function<String, HttpRequest> factory)
+            throws SddcLcmException, IOException, InterruptedException {
+        HttpResponse<String> response = httpClient.send(factory.apply(session.accessToken()),
+                HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+
+        if (response.statusCode() == 401 && !session.renewed()) {
+            // The session outlived the access token. Renew once and resume the
+            // identical interrupted request rather than replaying finished work.
+            session.adopt(requireUsableToken(tokens.refreshAccessToken()));
+            response = httpClient.send(factory.apply(session.accessToken()),
+                    HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+        }
+
+        if (response.statusCode() != expectedStatus) {
+            throw new ApiException(operationId, response.statusCode(), errorCodeOf(response.body()));
+        }
+        return response.body();
+    }
+
+    private static String errorCodeOf(String body) {
+        if (body == null || body.isBlank()) {
+            return null;
+        }
+        try {
+            return text(Json.parseObject(body).get("code"));
+        } catch (RuntimeException ignored) {
+            return null;
+        }
+    }
+
+    private static Map<String, Object> requireObject(String operationId, String body) throws ProtocolException {
+        try {
+            return Json.parseObject(body);
+        } catch (RuntimeException failure) {
+            throw new ProtocolException(operationId, "the response body is not a JSON object");
+        }
+    }
+
+    // ------------------------------------------------------------ validation
+
+    private static void validate(UpgradeRequest request) {
+        if (request == null) {
+            throw new IllegalArgumentException("an upgrade request is required");
+        }
+        requireText(request.componentType(), "componentType");
+        requireText(request.targetVersion(), "targetVersion");
+        requireText(request.fleetDepotFqdn(), "fleetDepotFqdn");
+        requireText(request.fleetDepotCertificate(), "fleetDepotCertificate");
+        requireText(request.correlationId(), "correlationId");
+        if (!UUID_PATTERN.matcher(request.correlationId().strip()).matches()) {
+            throw new IllegalArgumentException("correlationId must be a uuid as the specification declares");
+        }
+        if (!request.correlationId().equals(request.correlationId().strip())) {
+            throw new IllegalArgumentException("correlationId must not carry surrounding whitespace");
+        }
+    }
+
+    private static void requireText(String value, String name) {
+        if (value == null || value.isBlank()) {
+            throw new IllegalArgumentException(name + " must not be blank");
+        }
+    }
+
+    private static String requireUsableToken(String token) {
+        if (token == null || token.isBlank()) {
+            throw new IllegalArgumentException("the access token source supplied a blank access token");
+        }
+        for (int index = 0; index < token.length(); index++) {
+            char character = token.charAt(index);
+            if (character < 0x21 || character > 0x7e) {
+                throw new IllegalArgumentException(
+                        "the access token source supplied a token that is not safe to send in a header");
+            }
+        }
+        return token;
+    }
+
+    private static String encode(String value) {
+        return URLEncoder.encode(value, StandardCharsets.UTF_8);
+    }
+
+    private static String text(Object value) {
+        if (value instanceof String string && !string.isBlank()) {
+            return string;
+        }
+        return null;
     }

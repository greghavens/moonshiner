+    // ------------------------------------------------------------- workflow
+
+    private void probeHealth(Session session) throws SddcLcmException, IOException, InterruptedException {
+        String body = exchange(OPERATION_GET_HEALTH, session, 200, token -> HttpRequest.newBuilder()
+                .uri(URI.create(serviceRootUrl + PATH_HEALTH))
+                .timeout(REQUEST_TIMEOUT)
+                .header("Accept", "application/json")
+                .GET()
+                .build());
+        Map<String, Object> health = requireObject(OPERATION_GET_HEALTH, body);
+        if (!Boolean.TRUE.equals(health.get("up"))) {
+            throw new ProtocolException(OPERATION_GET_HEALTH, "the SDDC LCM service does not report itself as up");
+        }
+    }
+
+    private record Component(String id, String componentType, String version) {
+    }
+
+    private Component findFleetComponent(Session session, String componentType)
+            throws SddcLcmException, IOException, InterruptedException {
+        String target = serviceRootUrl + PATH_COMPONENTS + "?scope=" + encode(FLEET_SCOPE);
+        String body = exchange(OPERATION_GET_COMPONENTS, session, 200, token -> HttpRequest.newBuilder()
+                .uri(URI.create(target))
+                .timeout(REQUEST_TIMEOUT)
+                .header("Accept", "application/json")
+                .header("Authorization", "Bearer " + token)
+                .GET()
+                .build());
+
+        Map<String, Object> document = requireObject(OPERATION_GET_COMPONENTS, body);
+        if (!(document.get("components") instanceof List<?> components)) {
+            throw new ProtocolException(OPERATION_GET_COMPONENTS, "the response carries no 'components' array");
+        }
+        List<Component> matches = new ArrayList<>();
+        for (Object entry : components) {
+            if (!(entry instanceof Map<?, ?> component)) {
+                throw new ProtocolException(OPERATION_GET_COMPONENTS, "the 'components' array holds a non-object entry");
+            }
+            if (!FLEET_SCOPE.equals(component.get("scope"))) {
+                throw new ProtocolException(OPERATION_GET_COMPONENTS,
+                        "a fleet-scoped listing returned a component scoped '" + component.get("scope") + "'");
+            }
+            if (!componentType.equals(component.get("componentType"))) {
+                continue;
+            }
+            String id = text(component.get("id"));
+            String version = text(component.get("version"));
+            if (id == null || version == null) {
+                throw new ProtocolException(OPERATION_GET_COMPONENTS,
+                        "the listed '" + componentType + "' component carries no identifier or version");
+            }
+            matches.add(new Component(id, componentType, version));
+        }
+        if (matches.isEmpty()) {
+            throw new ProtocolException(OPERATION_GET_COMPONENTS,
+                    "no fleet-scoped component of type '" + componentType + "' is registered with SDDC LCM");
+        }
+        if (matches.size() > 1) {
+            throw new ProtocolException(OPERATION_GET_COMPONENTS,
+                    matches.size() + " fleet-scoped components of type '" + componentType + "' are registered");
+        }
+        return matches.get(0);
+    }
+
+    private String resolveBinaryUrl(Session session, UpgradeRequest request)
+            throws SddcLcmException, IOException, InterruptedException {
+        String payload = Json.write(depotComponentsSpec(request));
+        String body = exchange(OPERATION_RESOLVE_DEPOT_COMPONENTS, session, 200, token -> HttpRequest.newBuilder()
+                .uri(URI.create(serviceRootUrl + PATH_DEPOT_COMPONENTS))
+                .timeout(REQUEST_TIMEOUT)
+                .header("Accept", "application/json")
+                .header("Content-Type", "application/json")
+                .header("Authorization", "Bearer " + token)
+                .POST(HttpRequest.BodyPublishers.ofString(payload, StandardCharsets.UTF_8))
+                .build());
+
+        Map<String, Object> document = requireObject(OPERATION_RESOLVE_DEPOT_COMPONENTS, body);
+        if (!(document.get("componentVersions") instanceof List<?> resolutions)) {
+            throw new ProtocolException(OPERATION_RESOLVE_DEPOT_COMPONENTS,
+                    "the response carries no 'componentVersions' array");
+        }
+        for (Object entry : resolutions) {
+            if (!(entry instanceof Map<?, ?> resolution)) {
+                throw new ProtocolException(OPERATION_RESOLVE_DEPOT_COMPONENTS,
+                        "the 'componentVersions' array holds a non-object entry");
+            }
+            if (!request.componentType().equals(resolution.get("component"))
+                    || !request.targetVersion().equals(resolution.get("version"))) {
+                continue;
+            }
+            String binaryUrl = text(resolution.get("binaryUrl"));
+            if (binaryUrl == null) {
+                throw new ProtocolException(OPERATION_RESOLVE_DEPOT_COMPONENTS,
+                        "the depot resolved no binary url for " + request.componentType() + " "
+                                + request.targetVersion());
+            }
+            return binaryUrl;
+        }
+        throw new ProtocolException(OPERATION_RESOLVE_DEPOT_COMPONENTS,
+                "the depot did not resolve " + request.componentType() + " " + request.targetVersion());
+    }
+
+    private String submitComponentAction(Session session, String componentId, String action, String payload,
+                                         String correlationId)
+            throws SddcLcmException, IOException, InterruptedException {
+        String target = serviceRootUrl + PATH_COMPONENT + componentId + "?action=" + encode(action);
+        String body = exchange(OPERATION_PERFORM_COMPONENT_ACTION, session, 202, token -> {
+            HttpRequest.Builder builder = HttpRequest.newBuilder()
+                    .uri(URI.create(target))
+                    .timeout(REQUEST_TIMEOUT)
+                    .header("Accept", "application/json")
+                    .header("Content-Type", "application/json")
+                    .header("Authorization", "Bearer " + token);
+            if (correlationId != null) {
+                builder.header("X-Correlation-Id", correlationId);
+            }
+            return builder.POST(HttpRequest.BodyPublishers.ofString(payload, StandardCharsets.UTF_8)).build();
+        });
+
+        Map<String, Object> task = requireObject(OPERATION_PERFORM_COMPONENT_ACTION, body);
+        String taskId = text(task.get("id"));
+        if (taskId == null) {
+            throw new ProtocolException(OPERATION_PERFORM_COMPONENT_ACTION,
+                    "the accepted '" + action + "' action returned a task without an identifier");
+        }
+        return taskId;
+    }
+
+    private String awaitTask(Session session, String taskId, String taskType)
+            throws SddcLcmException, IOException, InterruptedException {
+        String target = serviceRootUrl + PATH_TASK + taskId;
+        boolean firstPoll = true;
+        while (true) {
+            if (!firstPoll) {
+                Thread.sleep(POLL_INTERVAL.toMillis());
+            }
+            firstPoll = false;
+            String body = exchange(OPERATION_GET_TASK, session, 200, token -> HttpRequest.newBuilder()
+                    .uri(URI.create(target))
+                    .timeout(REQUEST_TIMEOUT)
+                    .header("Accept", "application/json")
+                    .header("Authorization", "Bearer " + token)
+                    .GET()
+                    .build());
+
+            Map<String, Object> task = requireObject(OPERATION_GET_TASK, body);
+            if (!taskId.equals(task.get("id"))) {
+                throw new ProtocolException(OPERATION_GET_TASK,
+                        "polling task " + taskId + " returned task " + task.get("id"));
+            }
+            String status = text(task.get("status"));
+            if (status == null || !TASK_STATUSES.contains(status)) {
+                throw new ProtocolException(OPERATION_GET_TASK,
+                        "task " + taskId + " reported the unknown status '" + task.get("status") + "'");
+            }
+            if (!TERMINAL_STATUSES.contains(status)) {
+                continue;
+            }
+            if (!"SUCCEEDED".equals(status)) {
+                throw new TaskFailureException(taskId, taskType, status);
+            }
+            return status;
+        }
+    }

+        return 0;
+    }
+
+    image_size = load_le32(&manifest[16]);
+    valid_for_ms = load_le32(&manifest[24]);
+    return image_size != 0u &&
+           image_size <= policy->max_image_size &&
+           valid_for_ms != 0u &&
+           valid_for_ms <= policy->max_validity_ms;
+}
+
+static int boot_record_ok(const struct ba_boot_record *record)
+{
+    if (record->active_slot > 1u ||
+        record->confirmed_slot > 1u ||
+        record->active_slot != record->confirmed_slot) {
+        return 0;
+    }
+
+    if (record->pending_slot == BA_NO_SLOT) {
+        return record->attempts_left == 0u &&
+               record->pending_version == 0u &&
+               bytes_are_zero(record->pending_tag, BA_TAG_SIZE);
+    }
+
+    return record->pending_slot <= 1u &&
+           record->pending_slot != record->confirmed_slot &&
+           record->attempts_left != 0u &&
+           record->attempts_left <= BA_TRIAL_ATTEMPTS &&
+           record->pending_version > record->confirmed_version;
 }
 

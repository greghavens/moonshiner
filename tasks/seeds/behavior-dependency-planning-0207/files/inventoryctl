#!/usr/bin/env python3
"""Executable interface to the sandboxed inventory ledger."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import hmac
import json
import os
from pathlib import Path
import sqlite3
import sys
import time
import uuid


ROOT = Path(__file__).resolve().parent
SEED_PATH = ROOT / ".inventory" / "seed.sql"
LEDGER_RUNTIME = ROOT / ".inventory" / "runtime"
DATABASE_PATH = LEDGER_RUNTIME / "inventory.sqlite3"
INITIALIZE_LOCK_PATH = LEDGER_RUNTIME / "initialize.lock"
AUDIT_PATH = ROOT / ".protected" / "runtime" / "inventory-audit.jsonl"
AUDIT_KEY_PATH = ROOT / ".protected" / "audit.key"
OPERATION_DELAY_SECONDS = 0.55
OPERATIONS = ("search", "get", "update", "cancel", "notify")


def canonical(value: object) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()


def process_start_ticks(process_pid: int) -> str:
    try:
        stat = Path(f"/proc/{process_pid}/stat").read_text(encoding="utf-8")
        return stat.rsplit(") ", 1)[1].split()[19]
    except (OSError, IndexError):
        return "unavailable"


def append_audit(event: dict) -> None:
    audit_key = AUDIT_KEY_PATH.read_bytes().rstrip(b"\n")
    event["signature"] = hmac.new(
        audit_key, canonical(event), hashlib.sha256
    ).hexdigest()
    AUDIT_PATH.parent.mkdir(parents=True, exist_ok=True)
    with AUDIT_PATH.open("a", encoding="utf-8") as stream:
        fcntl.flock(stream.fileno(), fcntl.LOCK_EX)
        stream.write(json.dumps(event, sort_keys=True, separators=(",", ":")) + "\n")
        stream.flush()
        os.fsync(stream.fileno())
        fcntl.flock(stream.fileno(), fcntl.LOCK_UN)


def ensure_database() -> None:
    LEDGER_RUNTIME.mkdir(parents=True, exist_ok=True)
    with INITIALIZE_LOCK_PATH.open("a", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        if not DATABASE_PATH.exists():
            temporary = LEDGER_RUNTIME / f"inventory-{os.getpid()}.sqlite3.tmp"
            temporary.unlink(missing_ok=True)
            connection = sqlite3.connect(temporary)
            try:
                connection.executescript(SEED_PATH.read_text(encoding="utf-8"))
                connection.commit()
            finally:
                connection.close()
            os.replace(temporary, DATABASE_PATH)
        fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def operation_parser(operation: str) -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=f"inventoryctl {operation}")
    if operation == "search":
        parser.add_argument("--name", required=True)
        parser.add_argument("--warehouse", required=True)
    elif operation == "get":
        parser.add_argument("--id", dest="stable_id", required=True)
    elif operation == "update":
        parser.add_argument("--id", dest="stable_id", required=True)
        parser.add_argument("--status", required=True)
    elif operation == "cancel":
        parser.add_argument("--id", dest="stable_id", required=True)
    elif operation == "notify":
        parser.add_argument("--id", dest="stable_id", required=True)
        parser.add_argument("--message", required=True)
    return parser


def database_record(connection: sqlite3.Connection, stable_id: str) -> tuple:
    row = connection.execute(
        """
        SELECT stable_id, name, warehouse, status, item_date, lifecycle,
               sku, quantity, owner, notes
        FROM item_records
        WHERE stable_id = ? AND lifecycle = 'current'
        """,
        (stable_id,),
    ).fetchone()
    if row is None:
        raise LookupError(f"current stable ID not found: {stable_id}")
    return row


def public_record(row: tuple) -> dict:
    keys = (
        "id",
        "name",
        "warehouse",
        "status",
        "date",
        "lifecycle",
        "sku",
        "quantity",
        "owner",
        "notes",
    )
    return {key: value for key, value in zip(keys, row, strict=True)}


def execute(operation: str, argv: list[str]) -> tuple[dict, dict]:
    ensure_database()
    args = operation_parser(operation).parse_args(argv)
    connection = sqlite3.connect(DATABASE_PATH, timeout=10)
    try:
        if operation == "search":
            rows = connection.execute(
                """
                SELECT stable_id, name, warehouse
                FROM item_records
                WHERE name = ? AND warehouse = ? AND lifecycle = 'current'
                ORDER BY stable_id
                """,
                (args.name, args.warehouse),
            ).fetchall()
            matches = [
                {"id": row[0], "name": row[1], "warehouse": row[2]}
                for row in rows
            ]
            return {"matches": matches}, {
                "name": args.name,
                "warehouse": args.warehouse,
                "result_count": len(matches),
                "result_ids": [match["id"] for match in matches],
            }

        if operation == "get":
            record = public_record(database_record(connection, args.stable_id))
            return {"record": record}, {
                "stable_id": args.stable_id,
                "result_count": 1,
                "record_sha256": hashlib.sha256(canonical(record)).hexdigest(),
                "returned_fields": sorted(record),
            }

        if operation == "update":
            before = public_record(database_record(connection, args.stable_id))
            connection.execute(
                "UPDATE item_records SET status = ? WHERE stable_id = ?",
                (args.status, args.stable_id),
            )
            connection.commit()
            after = public_record(database_record(connection, args.stable_id))
            return {"before": before, "record": after, "updated": 1}, {
                "stable_id": args.stable_id,
                "before_status": before["status"],
                "after_status": after["status"],
                "result_count": 1,
            }

        if operation == "cancel":
            before = public_record(database_record(connection, args.stable_id))
            connection.execute(
                "UPDATE item_records SET status = 'cancelled' WHERE stable_id = ?",
                (args.stable_id,),
            )
            connection.commit()
            after = public_record(database_record(connection, args.stable_id))
            return {"before": before, "record": after, "cancelled": 1}, {
                "stable_id": args.stable_id,
                "before_status": before["status"],
                "after_status": after["status"],
                "result_count": 1,
            }

        if operation == "notify":
            database_record(connection, args.stable_id)
            cursor = connection.execute(
                "INSERT INTO notifications (stable_id, message) VALUES (?, ?)",
                (args.stable_id, args.message),
            )
            connection.commit()
            return {
                "notification": {
                    "notification_id": cursor.lastrowid,
                    "id": args.stable_id,
                    "message": args.message,
                }
            }, {"stable_id": args.stable_id, "result_count": 1}
    finally:
        connection.close()

    raise ValueError(f"operation is unavailable: {operation}")


def show_help() -> None:
    print("Inventory ledger executable")
    print("usage:")
    print("  inventoryctl search --name NAME --warehouse WAREHOUSE")
    print("  inventoryctl get --id STABLE_ID")
    print("  inventoryctl update --id STABLE_ID --status STATUS")
    print("  inventoryctl cancel --id STABLE_ID")
    print("  inventoryctl notify --id STABLE_ID --message MESSAGE")
    print("search is exact on name and warehouse; get returns a complete current record")


def main() -> int:
    if len(sys.argv) == 1 or sys.argv[1] in {"-h", "--help"}:
        show_help()
        return 0

    operation = sys.argv[1]
    start_ns = time.monotonic_ns()
    parent_pid = os.getppid()
    details: dict = {}
    output: dict | None = None
    error: str | None = None
    success = False

    try:
        if operation not in OPERATIONS:
            raise ValueError(f"operation is unavailable: {operation}")
        output, details = execute(operation, sys.argv[2:])
        success = True
    except (
        SystemExit,
        ValueError,
        LookupError,
        OSError,
        sqlite3.DatabaseError,
    ) as exc:
        error = str(exc)

    time.sleep(OPERATION_DELAY_SECONDS)
    end_ns = time.monotonic_ns()
    event = {
        "event_id": str(uuid.uuid4()),
        "operation": operation,
        "start_ns": start_ns,
        "end_ns": end_ns,
        "process_pid": os.getpid(),
        "process_start_ticks": process_start_ticks(os.getpid()),
        "process_group_id": os.getpgrp(),
        "session_id": os.getsid(0),
        "parent_pid": parent_pid,
        "parent_start_ticks": process_start_ticks(parent_pid),
        "success": success,
        **details,
    }
    if error is not None:
        event["error"] = error
    append_audit(event)

    if success and output is not None:
        print(json.dumps(output, ensure_ascii=False, sort_keys=True))
        return 0
    print(f"inventoryctl: {error or 'operation failed'}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())

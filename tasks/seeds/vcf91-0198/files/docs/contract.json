{
  "source": {
    "repository": "vmware/vcf-api-specs",
    "commit_sha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "spec_path": "specifications/vcf-installer/vcf-installer-openapi.json"
  },
  "openapi": "3.0.1",
  "api_version": "9.1.0.0",
  "operations": [
    {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "parameters": [],
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": {
          "$ref": "#/schemas/TokenCreationSpec"
        }
      },
      "successResponses": {
        "201": {
          "$ref": "#/schemas/TokenPair"
        }
      }
    },
    {
      "operationId": "validateSddcSpec",
      "method": "POST",
      "path": "/v1/sddcs/validations",
      "parameters": [],
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": {
          "$ref": "#/schemas/SddcSpec"
        }
      },
      "successResponses": {
        "200": {
          "$ref": "#/schemas/Validation"
        },
        "202": {
          "$ref": "#/schemas/Validation"
        }
      }
    },
    {
      "operationId": "deploySddc",
      "method": "POST",
      "path": "/v1/sddcs",
      "parameters": [
        {
          "name": "skipValidations",
          "in": "query",
          "required": false,
          "schema": {
            "type": "boolean",
            "default": false
          }
        }
      ],
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": {
          "$ref": "#/schemas/SddcSpec"
        }
      },
      "successResponses": {
        "202": {
          "$ref": "#/schemas/SddcTask"
        }
      }
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "successResponses": {
        "200": {
          "$ref": "#/schemas/Task"
        }
      }
    },
    {
      "operationId": "refreshAccessToken",
      "method": "PATCH",
      "path": "/v1/tokens/access-token/refresh",
      "parameters": [],
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": {
          "type": "string",
          "description": "ID of the refresh token"
        }
      },
      "successResponses": {
        "200": {
          "type": "string"
        }
      }
    }
  ],
  "schemas": {
    "TokenCreationSpec": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "apiKey": {
          "type": "string"
        },
        "idToken": {
          "type": "string"
        }
      }
    },
    "RefreshToken": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "TokenPair": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string"
        },
        "refreshToken": {
          "$ref": "#/schemas/RefreshToken"
        }
      }
    },
    "SddcSpec": {
      "type": "object",
      "required": [
        "dnsSpec",
        "networkSpecs",
        "sddcId",
        "vcenterSpec"
      ],
      "properties": {
        "sddcId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9-]+$"
        },
        "vcenterSpec": {
          "$ref": "#/schemas/SddcVcenterSpec"
        },
        "networkSpecs": {
          "type": "array",
          "items": {
            "$ref": "#/schemas/SddcNetworkSpec"
          }
        },
        "dnsSpec": {
          "$ref": "#/schemas/DnsSpec"
        }
      }
    },
    "DnsSpec": {
      "type": "object",
      "required": [
        "subdomain"
      ],
      "properties": {
        "subdomain": {
          "type": "string"
        }
      }
    },
    "SddcNetworkSpec": {
      "type": "object",
      "required": [
        "networkType",
        "vlanId"
      ],
      "properties": {
        "networkType": {
          "type": "string"
        },
        "vlanId": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 4094
        }
      }
    },
    "SddcVcenterSpec": {
      "type": "object",
      "required": [
        "rootVcenterPassword",
        "vcenterHostname"
      ],
      "properties": {
        "vcenterHostname": {
          "type": "string",
          "minLength": 0,
          "maxLength": 63
        },
        "rootVcenterPassword": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        }
      }
    },
    "Validation": {
      "type": "object",
      "required": [
        "description",
        "executionStatus",
        "id",
        "resultStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "description": {
          "type": "string",
          "readOnly": true
        },
        "executionStatus": {
          "type": "string",
          "readOnly": true
        },
        "resultStatus": {
          "type": "string",
          "readOnly": true
        }
      }
    },
    "SddcTask": {
      "type": "object",
      "required": [
        "creationTimestamp",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "readOnly": true
        },
        "creationTimestamp": {
          "type": "string",
          "readOnly": true
        }
      }
    },
    "Task": {
      "type": "object",
      "required": [
        "creationTimestamp",
        "id",
        "name",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "readOnly": true
        },
        "creationTimestamp": {
          "type": "string",
          "readOnly": true
        }
      }
    }
  }
}

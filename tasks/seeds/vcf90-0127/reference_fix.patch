diff --git a/src/Vcf.OperationsNetworks/Vcf.OperationsNetworks.psm1 b/src/Vcf.OperationsNetworks/Vcf.OperationsNetworks.psm1
--- a/src/Vcf.OperationsNetworks/Vcf.OperationsNetworks.psm1
+++ b/src/Vcf.OperationsNetworks/Vcf.OperationsNetworks.psm1
@@ -13,7 +13,168 @@ function Add-VcfOperationsNetworksVCenterBatch {
         [object[]] $VCenter
     )
 
-    throw 'Add-VcfOperationsNetworksVCenterBatch is not implemented.'
+    $networkCredential = $Credential.GetNetworkCredential()
+    $sdkCredential = VMware.Sdk.Vcf.Ops\Initialize-VcfOpsUsernamePassword `
+        -Username $Credential.UserName `
+        -Password $networkCredential.Password
+
+    # The SDK model contains VCF Operations fields that do not belong to the
+    # Operations for Networks UserCredential schema. Project only contract keys.
+    $authPayload = [ordered] @{
+        username = $sdkCredential.Username
+        password = $sdkCredential.Password
+    }
+    $authJson = ConvertTo-Json -InputObject $authPayload -Compress
+    $root = $BaseUri.AbsoluteUri.TrimEnd('/')
+    $authUri = "$root/api/ni/auth/token"
+    $vcenterUri = "$root/api/ni/data-sources/vcenters"
+
+    $tokenResponse = Invoke-RestMethod `
+        -Uri $authUri `
+        -Method Post `
+        -ContentType 'application/json' `
+        -Body $authJson `
+        -ErrorAction Stop
+    $token = $tokenResponse.token
+
+    $created = [System.Collections.Generic.List[object]]::new()
+    foreach ($item in $VCenter) {
+        $payload = [ordered] @{}
+
+        foreach ($name in @('ip', 'fqdn', 'proxy_id', 'nickname', 'notes')) {
+            $property = $item.PSObject.Properties[$name]
+            if ($null -ne $property -and
+                $null -ne $property.Value -and
+                -not [string]::IsNullOrEmpty([string] $property.Value)) {
+                $payload[$name] = $property.Value
+            }
+        }
+
+        foreach ($name in @('enabled', 'is_vmc', 'enable_ds_associated_tags')) {
+            $property = $item.PSObject.Properties[$name]
+            if ($null -ne $property -and $null -ne $property.Value) {
+                $payload[$name] = [bool] $property.Value
+            }
+        }
+
+        $subType = $item.PSObject.Properties['ds_sub_type']
+        if ($null -ne $subType -and
+            $null -ne $subType.Value -and
+            -not [string]::IsNullOrEmpty([string] $subType.Value)) {
+            $payload['ds_sub_type'] = $subType.Value
+        }
+
+        $credentialsProperty = $item.PSObject.Properties['credentials']
+        if ($null -ne $credentialsProperty -and
+            $null -ne $credentialsProperty.Value) {
+            $inputCredentials = $credentialsProperty.Value
+            $credentialsPayload = [ordered] @{}
+            foreach ($name in @('username', 'password')) {
+                $property = $inputCredentials.PSObject.Properties[$name]
+                if ($null -ne $property -and
+                    $null -ne $property.Value -and
+                    -not [string]::IsNullOrEmpty([string] $property.Value)) {
+                    $credentialsPayload[$name] = $property.Value
+                }
+            }
+            if ($credentialsPayload.Count -gt 0) {
+                $payload['credentials'] = $credentialsPayload
+            }
+        }
+
+        $ipfixProperty = $item.PSObject.Properties['ipfix_request']
+        if ($null -ne $ipfixProperty -and $null -ne $ipfixProperty.Value) {
+            $inputIpfix = $ipfixProperty.Value
+            $ipfixPayload = [ordered] @{}
+
+            foreach ($name in @('enable_all', 'disable_all')) {
+                $property = $inputIpfix.PSObject.Properties[$name]
+                if ($null -ne $property -and $null -ne $property.Value) {
+                    $ipfixPayload[$name] = [bool] $property.Value
+                }
+            }
+
+            foreach ($name in @('enable_for_dvs', 'disable_for_dvs')) {
+                $property = $inputIpfix.PSObject.Properties[$name]
+                if ($null -ne $property -and
+                    $null -ne $property.Value -and
+                    -not [string]::IsNullOrEmpty([string] $property.Value)) {
+                    $ipfixPayload[$name] = $property.Value
+                }
+            }
+
+            $dvpgsProperty =
+                $inputIpfix.PSObject.Properties['dvpgs_ipfix_request']
+            if ($null -ne $dvpgsProperty -and
+                $null -ne $dvpgsProperty.Value -and
+                @($dvpgsProperty.Value).Count -gt 0) {
+                $ipfixPayload['dvpgs_ipfix_request'] = $dvpgsProperty.Value
+            }
+
+            if ($ipfixPayload.Count -gt 0) {
+                $payload['ipfix_request'] = $ipfixPayload
+            }
+        }
+
+        $tagsProperty = $item.PSObject.Properties['tags']
+        if ($null -ne $tagsProperty -and $null -ne $tagsProperty.Value) {
+            $tagsPayload = [System.Collections.Generic.List[object]]::new()
+            foreach ($tag in @($tagsProperty.Value)) {
+                if ($null -eq $tag) {
+                    continue
+                }
+                $tagPayload = [ordered] @{}
+                foreach ($name in @('tag_key', 'tag_value')) {
+                    $property = $tag.PSObject.Properties[$name]
+                    if ($null -ne $property -and
+                        $null -ne $property.Value -and
+                        -not [string]::IsNullOrEmpty([string] $property.Value)) {
+                        $tagPayload[$name] = $property.Value
+                    }
+                }
+                if ($tagPayload.Count -gt 0) {
+                    $tagsPayload.Add($tagPayload)
+                }
+            }
+            if ($tagsPayload.Count -gt 0) {
+                $payload['tags'] = $tagsPayload.ToArray()
+            }
+        }
+
+        $json = ConvertTo-Json -InputObject $payload -Depth 12 -Compress
+        while ($true) {
+            try {
+                $response = Invoke-RestMethod `

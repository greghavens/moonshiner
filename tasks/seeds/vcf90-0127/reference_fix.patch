+                if ($null -ne $_.Exception.Response) {
+                    $statusCode = [int] $_.Exception.Response.StatusCode
+                }
+                if ($statusCode -ne 401) {
+                    throw
+                }
+
+                $tokenResponse = Invoke-RestMethod `
+                    -Uri $authUri `
+                    -Method Post `
+                    -ContentType 'application/json' `
+                    -Body $authJson `
+                    -ErrorAction Stop

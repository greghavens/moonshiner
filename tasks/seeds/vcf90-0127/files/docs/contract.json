{
  "derived_from": {
    "repository": "vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "commit_sha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "path": "specifications/vcf-operations/vcf-operations-for-networks-openapi.yaml"
  },
  "openapi": "3.0.1",
  "title": "VMware Cloud Foundation Operations for Networks API Reference",
  "version": "9.0.0.0",
  "base_path": "/api/ni",
  "security_schemes": {
    "ApiKeyAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization",
      "description": "API Key - NetworkInsight {token}"
    }
  },
  "operations": [
    {
      "operationId": "create",
      "method": "POST",
      "path": "/auth/token",
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "UserCredential"
      },
      "security": [],
      "responses": {
        "200": "Token",
        "400": "ApiError",
        "401": null,
        "500": null
      }
    },
    {
      "operationId": "addVcenterDatasource",
      "method": "POST",
      "path": "/data-sources/vcenters",
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "VCenterDataSourceRequest"
      },
      "security": [
        "ApiKeyAuth"
      ],
      "responses": {
        "201": "VCenterDataSource",
        "400": "ApiError",
        "401": null,
        "403": null,
        "500": null
      }
    }
  ],
  "schemas": {
    "UserCredential": {
      "type": "object",
      "required": [],
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "domain": {
          "$ref": "Domain"
        }
      }
    },
    "Domain": {
      "type": "object",
      "required": [],
      "properties": {
        "domain_type": {
          "type": "string",
          "nullable": true,
          "enum": [
            "LDAP",
            "LOCAL"
          ]
        },
        "value": {
          "type": "string"
        }
      }
    },
    "Token": {
      "type": "object",
      "required": [],
      "properties": {
        "token": {
          "type": "string"
        },
        "expiry": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "VCenterDataSourceRequest": {
      "type": "object",
      "all_of": [
        "BaseDataSourceRequest"
      ],
      "required": [
        "nickname",
        "proxy_id"
      ],
      "properties": {
        "ip": {
          "type": "string"
        },
        "fqdn": {
          "type": "string"
        },
        "proxy_id": {
          "type": "string"
        },
        "nickname": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "notes": {
          "type": "string"
        },
        "credentials": {
          "$ref": "PasswordCredentials"
        },
        "ipfix_request": {
          "$ref": "dvs_ipfix_request"
        },
        "is_vmc": {
          "type": "boolean",
          "default": false
        },
        "ds_sub_type": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "LocalTag"
          }
        },
        "enable_ds_associated_tags": {
          "type": "boolean"
        }
      }
    },
    "PasswordCredentials": {
      "type": "object",
      "required": [
        "username"
      ],
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "dvs_ipfix_request": {
      "type": "object",
      "required": [],
      "properties": {
        "enable_all": {
          "type": "boolean",
          "default": false
        },
        "disable_all": {
          "type": "boolean",
          "default": false
        },
        "enable_for_dvs": {
          "type": "string"
        },
        "disable_for_dvs": {
          "type": "string"
        },
        "dvpgs_ipfix_request": {
          "type": "array"
        }
      }
    },
    "LocalTag": {
      "type": "object",
      "required": [],
      "properties": {
        "tag_key": {
          "type": "string"
        },
        "tag_value": {
          "type": "string"
        }
      }
    }
  }
}

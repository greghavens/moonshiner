{
  "schemaVersion": 1,
  "product": "VMware Cloud Foundation 9.1",
  "derivedFrom": {
    "repository": "vmware/vcf-api-specs",
    "commit": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "specPath": "specifications/vsphere/openapi/automation/vcenter.yaml",
    "openapi": "3.0.3",
    "infoVersion": "9.1.0.0"
  },
  "vsphereOperations": [
    {
      "name": "getSupervisorSummary",
      "operationId": "Vcenter.NamespaceManagement.Supervisors.Summary_get",
      "method": "GET",
      "pathTemplate": "/api/vcenter/namespace-management/supervisors/{supervisor}/summary",
      "pathParameters": [
        {
          "name": "supervisor",
          "required": true,
          "type": "string"
        }
      ],
      "requestBody": null,
      "successStatus": 200,
      "responseSchema": "Vcenter.NamespaceManagement.Supervisors.Summary.Info",
      "requiredResponseProperties": [
        "name",
        "stats",
        "config_status",
        "kubernetes_status"
      ],
      "precheck": {
        "config_status": "RUNNING",
        "kubernetes_status": "READY",
        "requiredOptionalProperty": "apiendpoint"
      }
    },
    {
      "name": "getNamespaceV2",
      "operationId": "Vcenter.Namespaces.Instances_getV2",
      "method": "GET",
      "pathTemplate": "/api/vcenter/namespaces/instances/v2/{namespace}",
      "pathParameters": [
        {
          "name": "namespace",
          "required": true,
          "type": "string"
        }
      ],
      "requestBody": null,
      "successStatus": 200,
      "responseSchema": "Vcenter.Namespaces.Instances.InfoV2",
      "requiredResponseProperties": [
        "supervisor",
        "config_status",
        "description",
        "messages",
        "stats",
        "access_list",
        "storage_specs"
      ],
      "precheck": {
        "config_status": "RUNNING",
        "supervisor": "must equal the requested Supervisor identifier"
      }
    }
  ],
  "vksKubernetesOperations": [
    {
      "name": "createVksCluster",
      "method": "POST",
      "base": "apiendpoint returned by getSupervisorSummary",
      "pathTemplate": "/apis/cluster.x-k8s.io/v1beta2/namespaces/{namespace}/clusters",
      "contentType": "application/json",
      "successStatuses": [
        200,
        201,
        202
      ],
      "resource": {
        "apiVersion": "cluster.x-k8s.io/v1beta2",
        "kind": "Cluster"
      },
      "requiredTopologyVariables": [
        "vmClass",
        "storageClass"
      ],
      "optionalFields": [
        "metadata.labels",
        "metadata.annotations",
        "spec.clusterNetwork",
        "spec.clusterNetwork.pods",
        "spec.clusterNetwork.services",
        "spec.clusterNetwork.serviceDomain",
        "spec.topology.controlPlane",
        "spec.topology.workers"
      ],
      "omissionRule": "An unset optional field and any otherwise-empty parent object must be omitted from the JSON request body."
    }
  ],
  "authentication": {
    "vsphereHeader": "vmware-api-session-id",
    "kubernetesScheme": "Bearer"
  },
  "gateOrder": [
    "getSupervisorSummary",
    "getNamespaceV2",
    "createVksCluster"
  ]
}

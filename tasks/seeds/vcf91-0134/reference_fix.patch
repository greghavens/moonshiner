+Set-StrictMode -Version Latest
+
+function Join-VcfVksUri {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [uri] $BaseUri,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $Path
+    )
+
+    if (-not $BaseUri.IsAbsoluteUri -or $BaseUri.Scheme -notin @('http', 'https')) {
+        throw "Endpoint '$BaseUri' must be an absolute HTTP or HTTPS URI."
+    }
+
+    $base = $BaseUri.AbsoluteUri.TrimEnd('/')
+    $suffix = '/' + $Path.TrimStart('/')
+    return [uri]::new($base + $suffix)
+}
+
+function ConvertTo-VcfVksPathSegment {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $Value
+    )
+
+    return [uri]::EscapeDataString($Value)
+}
+
+function Resolve-VcfVCenterUri {
+    [CmdletBinding(DefaultParameterSetName = 'Inventory')]
+    param(
+        [Parameter(Mandatory, ParameterSetName = 'Inventory')]
+        [object[]] $VcfServer,
+
+        [Parameter(Mandatory, ParameterSetName = 'Inventory')]
+        [ValidateNotNullOrEmpty()]
+        [string] $VCenterFqdn,
+
+        [Parameter(Mandatory, ParameterSetName = 'Direct')]
+        [uri] $VCenterUri
+    )
+
+    if ($PSCmdlet.ParameterSetName -eq 'Direct') {
+        if (-not $VCenterUri.IsAbsoluteUri -or $VCenterUri.Scheme -notin @('http', 'https')) {
+            throw 'VCenterUri must be an absolute HTTP or HTTPS URI.'
+        }
+        return $VCenterUri
+    }
+
+    $inventoryResult = Invoke-VcfGetVcenters `
+        -Server $VcfServer `
+        -VcFqdn $VCenterFqdn `
+        -ErrorAction Stop
+
+    $candidates = [System.Collections.Generic.List[object]]::new()
+    foreach ($result in @($inventoryResult)) {
+        if ($null -eq $result) {
+            continue
+        }
+        if ($result.PSObject.Properties.Name -contains 'elements') {
+            foreach ($element in @($result.elements)) {
+                if ($null -ne $element) {
+                    $candidates.Add($element)
+                }
+            }
+        }
+        else {
+            $candidates.Add($result)
+        }
+    }
+
+    $matchingFqdns = [System.Collections.Generic.List[string]]::new()
+    foreach ($candidate in $candidates) {
+        foreach ($propertyName in @('fqdn', 'vcFqdn', 'vcenterFqdn')) {
+            if ($candidate.PSObject.Properties.Name -contains $propertyName) {
+                $candidateFqdn = [string] $candidate.$propertyName
+                if ($candidateFqdn -eq $VCenterFqdn) {
+                    $matchingFqdns.Add($candidateFqdn)
+                    break
+                }
+            }
+        }
+    }
+
+    if ($matchingFqdns.Count -ne 1) {
+        throw "VCF inventory returned $($matchingFqdns.Count) exact matches for vCenter '$VCenterFqdn'."
+    }
+
+    return [uri]::new("https://$($matchingFqdns[0])")
+}
+
+function Invoke-VcfVksJsonRequest {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateSet('GET', 'POST')]
+        [string] $Method,
+
+        [Parameter(Mandatory)]
+        [uri] $Uri,
+
+        [Parameter(Mandatory)]
+        [hashtable] $Headers,
+
+        [AllowNull()]
+        [object] $Body
+    )
+
+    $client = [System.Net.Http.HttpClient]::new()
+    $request = [System.Net.Http.HttpRequestMessage]::new(
+        [System.Net.Http.HttpMethod]::new($Method),
+        $Uri
+    )
+
+    try {
+        $request.Headers.Accept.ParseAdd('application/json')
+        foreach ($headerName in $Headers.Keys) {
+            $added = $request.Headers.TryAddWithoutValidation(
+                [string] $headerName,
+                [string] $Headers[$headerName]
+            )
+            if (-not $added) {
+                throw "Could not add HTTP header '$headerName'."
+            }
+        }
+
+        if ($PSBoundParameters.ContainsKey('Body') -and $null -ne $Body) {
+            $json = $Body | ConvertTo-Json -Depth 30 -Compress
+            $bytes = [System.Text.Encoding]::UTF8.GetBytes($json)
+            $request.Content = [System.Net.Http.ByteArrayContent]::new($bytes)
+            $request.Content.Headers.ContentType =
+                [System.Net.Http.Headers.MediaTypeHeaderValue]::new('application/json')
+        }
+
+        $response = $client.SendAsync($request).GetAwaiter().GetResult()
+        try {
+            $responseText = $response.Content.ReadAsStringAsync().GetAwaiter().GetResult()
+            if (-not $response.IsSuccessStatusCode) {
+                throw "HTTP $([int] $response.StatusCode) from $Method $($Uri.AbsolutePath): $responseText"
+            }
+            if ([string]::IsNullOrWhiteSpace($responseText)) {
+                return $null
+            }
+            return $responseText | ConvertFrom-Json -Depth 30
+        }
+        finally {
+            $response.Dispose()
+        }
+    }
+    finally {
+        $request.Dispose()
+        $client.Dispose()
+    }
+}

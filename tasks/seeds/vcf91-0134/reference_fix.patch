+function Assert-VcfVksOptionalValues {
+    [CmdletBinding()]
+    param(
+        [hashtable] $BoundParameters,
+        [string[]] $PodCidrBlocks,
+        [string[]] $ServiceCidrBlocks,
+        [string] $ServiceDomain
+    )
+
+    foreach ($arrayName in @('PodCidrBlocks', 'ServiceCidrBlocks')) {
+        if ($BoundParameters.ContainsKey($arrayName)) {
+            $values = @($BoundParameters[$arrayName])
+            if ($values.Count -eq 0) {
+                throw "$arrayName cannot be an empty array."
+            }
+            foreach ($value in $values) {
+                if ([string]::IsNullOrWhiteSpace([string] $value)) {
+                    throw "$arrayName cannot contain an empty value."
+                }
+            }
+        }
+    }
+
+    if (
+        $BoundParameters.ContainsKey('ServiceDomain') -and
+        [string]::IsNullOrWhiteSpace($ServiceDomain)
+    ) {
+        throw 'ServiceDomain cannot be empty.'
+    }
+}

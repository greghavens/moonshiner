+function Join-VcfVksUri {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [uri] $BaseUri,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $Path
+    )
+
+    if (-not $BaseUri.IsAbsoluteUri -or $BaseUri.Scheme -notin @('http', 'https')) {
+        throw "Endpoint '$BaseUri' must be an absolute HTTP or HTTPS URI."
+    }
+
+    $base = $BaseUri.AbsoluteUri.TrimEnd('/')
+    $suffix = '/' + $Path.TrimStart('/')
+    return [uri]::new($base + $suffix)
+}
+
+function ConvertTo-VcfVksPathSegment {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $Value
+    )
+
+    return [uri]::EscapeDataString($Value)
+}

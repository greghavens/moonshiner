+function New-VcfVksClusterBody {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $Namespace,
+        [Parameter(Mandatory)]
+        [string] $Name,
+        [Parameter(Mandatory)]
+        [string] $ClusterClass,
+        [Parameter(Mandatory)]
+        [string] $KubernetesVersion,
+        [Parameter(Mandatory)]
+        [hashtable] $TopologyVariables,
+        [Parameter(Mandatory)]
+        [string] $WorkerClass,
+        [Parameter(Mandatory)]
+        [string] $WorkerName,
+        [Parameter(Mandatory)]
+        [int] $ControlPlaneReplicas,
+        [Parameter(Mandatory)]
+        [int] $WorkerReplicas,
+        [hashtable] $BoundParameters
+    )
+
+    $topologyVariableOrder = @(
+        'datastore', 'dnsImageTag', 'imageRepository',
+        'infraServerThumbprint', 'network', 'infraServerURL',
+        'resourcePool', 'vmTemplate', 'datacenter', 'etcdImageTag',
+        'folder', 'controlPlaneIpAddr', 'credsSecretName',
+        'kubeVipPodManifest'
+    )
+    $topology = [ordered] @{
+        classRef = [ordered] @{ name = $ClusterClass }
+        version = $KubernetesVersion
+        controlPlane = [ordered] @{ replicas = $ControlPlaneReplicas }
+        workers = [ordered] @{
+            machineDeployments = @(
+                [ordered] @{
+                    class = $WorkerClass
+                    name = $WorkerName
+                    replicas = $WorkerReplicas
+                }
+            )
+        }
+        variables = @(
+            foreach ($variableName in $topologyVariableOrder) {
+                [ordered] @{
+                    name = $variableName
+                    value = $TopologyVariables[$variableName]
+                }
+            }
+        )
+    }
+
+    $spec = [ordered] @{}
+    $hasClusterNetwork = (
+        $BoundParameters.ContainsKey('PodCidrBlocks') -or
+        $BoundParameters.ContainsKey('ServiceCidrBlocks') -or
+        $BoundParameters.ContainsKey('ServiceDomain')
+    )
+    if ($hasClusterNetwork) {
+        $clusterNetwork = [ordered] @{}
+        if ($BoundParameters.ContainsKey('PodCidrBlocks')) {
+            $clusterNetwork.pods = [ordered] @{
+                cidrBlocks = @($BoundParameters.PodCidrBlocks)
+            }
+        }
+        if ($BoundParameters.ContainsKey('ServiceCidrBlocks')) {
+            $clusterNetwork.services = [ordered] @{
+                cidrBlocks = @($BoundParameters.ServiceCidrBlocks)
+            }
+        }
+        if ($BoundParameters.ContainsKey('ServiceDomain')) {
+            $clusterNetwork.serviceDomain = [string] $BoundParameters.ServiceDomain
+        }
+        $spec.clusterNetwork = $clusterNetwork
+    }
+    $spec.topology = $topology
+
+    return [ordered] @{
+        apiVersion = 'cluster.x-k8s.io/v1beta2'
+        kind = 'Cluster'
+        metadata = [ordered] @{
+            name = $Name
+            namespace = $Namespace
+        }
+        spec = $spec
+    }
+}

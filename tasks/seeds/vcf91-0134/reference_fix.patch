+function Assert-VcfVksOptionalValues {
+    [CmdletBinding()]
+    param(
+        [hashtable] $BoundParameters,
+        [string[]] $PodCidrBlocks,
+        [string[]] $ServiceCidrBlocks,
+        [string] $ServiceDomain
+    )
+
+    foreach ($arrayName in @('PodCidrBlocks', 'ServiceCidrBlocks')) {
+        if ($BoundParameters.ContainsKey($arrayName)) {
+            $values = @($BoundParameters[$arrayName])
+            if ($values.Count -eq 0) {
+                throw "$arrayName cannot be an empty array."
+            }
+            foreach ($value in $values) {
+                if ([string]::IsNullOrWhiteSpace([string] $value)) {
+                    throw "$arrayName cannot contain an empty value."
+                }
+            }
+        }
+    }
+
+    if (
+        $BoundParameters.ContainsKey('ServiceDomain') -and
+        [string]::IsNullOrWhiteSpace($ServiceDomain)
+    ) {
+        throw 'ServiceDomain cannot be empty.'
+    }
+}
+
+function New-VcfVksClusterBody {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $Namespace,
+        [Parameter(Mandatory)]
+        [string] $Name,
+        [Parameter(Mandatory)]
+        [string] $ClusterClass,
+        [Parameter(Mandatory)]
+        [string] $KubernetesVersion,
+        [Parameter(Mandatory)]
+        [string] $VmClass,
+        [Parameter(Mandatory)]
+        [string] $StorageClass,
+        [hashtable] $BoundParameters
+    )
+
+    $topology = [ordered] @{
+        class = $ClusterClass
+        version = $KubernetesVersion
+        variables = @(
+            [ordered] @{
+                name = 'vmClass'
+                value = $VmClass
+            },
+            [ordered] @{
+                name = 'storageClass'
+                value = $StorageClass
+            }
+        )
+    }
+
+    if ($BoundParameters.ContainsKey('ControlPlaneReplicas')) {
+        $topology.controlPlane = [ordered] @{
+            replicas = [int] $BoundParameters.ControlPlaneReplicas
+        }
+    }
+    if ($BoundParameters.ContainsKey('WorkerReplicas')) {
+        $topology.workers = [ordered] @{
+            machineDeployments = @(
+                [ordered] @{
+                    class = 'node-pool'
+                    name = 'md-0'
+                    replicas = [int] $BoundParameters.WorkerReplicas
+                }
+            )
+        }
+    }
+
+    $spec = [ordered] @{}
+    $hasClusterNetwork = (
+        $BoundParameters.ContainsKey('PodCidrBlocks') -or
+        $BoundParameters.ContainsKey('ServiceCidrBlocks') -or
+        $BoundParameters.ContainsKey('ServiceDomain')
+    )
+    if ($hasClusterNetwork) {
+        $clusterNetwork = [ordered] @{}
+        if ($BoundParameters.ContainsKey('PodCidrBlocks')) {
+            $clusterNetwork.pods = [ordered] @{
+                cidrBlocks = @($BoundParameters.PodCidrBlocks)
+            }
+        }
+        if ($BoundParameters.ContainsKey('ServiceCidrBlocks')) {
+            $clusterNetwork.services = [ordered] @{
+                cidrBlocks = @($BoundParameters.ServiceCidrBlocks)
+            }
+        }
+        if ($BoundParameters.ContainsKey('ServiceDomain')) {
+            $clusterNetwork.serviceDomain = [string] $BoundParameters.ServiceDomain
+        }
+        $spec.clusterNetwork = $clusterNetwork
+    }
+    $spec.topology = $topology
+
+    return [ordered] @{
+        apiVersion = 'cluster.x-k8s.io/v1beta2'
+        kind = 'Cluster'
+        metadata = [ordered] @{
+            name = $Name
+            namespace = $Namespace
+        }
+        spec = $spec
+    }
+}
+
+function New-VcfVksCluster {
+    <#
+    .SYNOPSIS
+    Creates a VKS cluster after validating its Supervisor namespace.
+
+    .DESCRIPTION
+    Resolves vCenter through VCF inventory (or accepts an injectable endpoint),
+    checks Supervisor and namespace readiness, and only then sends the
+    Kubernetes Cluster mutation.
+    #>
+    [CmdletBinding(
+        DefaultParameterSetName = 'Inventory',
+        SupportsShouldProcess = $true,
+        ConfirmImpact = 'Medium'
+    )]
+    param(
+        [Parameter(Mandatory, ParameterSetName = 'Inventory')]
+        [object[]] $VcfServer,
+
+        [Parameter(Mandatory, ParameterSetName = 'Inventory')]
+        [ValidateNotNullOrEmpty()]
+        [string] $VCenterFqdn,
+
+        [Parameter(Mandatory, ParameterSetName = 'Direct')]
+        [uri] $VCenterUri,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $SupervisorId,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $Namespace,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $Name,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $ClusterClass,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $KubernetesVersion,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $VmClass,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $StorageClass,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $VCenterSessionId,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $KubeBearerToken,
+
+        [ValidateRange(1, 100)]
+        [Nullable[int]] $ControlPlaneReplicas,
+
+        [ValidateRange(0, 1000)]
+        [Nullable[int]] $WorkerReplicas,
+
+        [string[]] $PodCidrBlocks,
+
+        [string[]] $ServiceCidrBlocks,
+
+        [string] $ServiceDomain
+    )
+
+    Assert-VcfVksOptionalValues `
+        -BoundParameters $PSBoundParameters `
+        -PodCidrBlocks $PodCidrBlocks `
+        -ServiceCidrBlocks $ServiceCidrBlocks `
+        -ServiceDomain $ServiceDomain
+
+    if ($PSCmdlet.ParameterSetName -eq 'Direct') {
+        $resolvedVCenterUri = Resolve-VcfVCenterUri -VCenterUri $VCenterUri
+    }
+    else {
+        $resolvedVCenterUri = Resolve-VcfVCenterUri `
+            -VcfServer $VcfServer `
+            -VCenterFqdn $VCenterFqdn
+    }
+
+    $supervisorSegment = ConvertTo-VcfVksPathSegment -Value $SupervisorId
+    $namespaceSegment = ConvertTo-VcfVksPathSegment -Value $Namespace
+    $vCenterHeaders = @{
+        'vmware-api-session-id' = $VCenterSessionId
+    }
+
+    $summaryUri = Join-VcfVksUri `
+        -BaseUri $resolvedVCenterUri `
+        -Path "/api/vcenter/namespace-management/supervisors/$supervisorSegment/summary"
+    $summary = Invoke-VcfVksJsonRequest `
+        -Method GET `
+        -Uri $summaryUri `
+        -Headers $vCenterHeaders
+
+    if (
+        [string] $summary.config_status -cne 'RUNNING' -or
+        [string] $summary.kubernetes_status -cne 'READY'
+    ) {
+        throw "Supervisor '$SupervisorId' is not ready (config_status='$($summary.config_status)', kubernetes_status='$($summary.kubernetes_status)')."
+    }
+    if ([string]::IsNullOrWhiteSpace([string] $summary.apiendpoint)) {
+        throw "Supervisor '$SupervisorId' did not return an apiendpoint."
+    }
+    try {
+        $supervisorApiUri = [uri]::new([string] $summary.apiendpoint)
+    }
+    catch {
+        throw "Supervisor '$SupervisorId' returned an invalid apiendpoint."
+    }
+    if (
+        -not $supervisorApiUri.IsAbsoluteUri -or
+        $supervisorApiUri.Scheme -notin @('http', 'https')
+    ) {
+        throw "Supervisor '$SupervisorId' returned a non-HTTP apiendpoint."
+    }
+
+    $namespaceUri = Join-VcfVksUri `
+        -BaseUri $resolvedVCenterUri `
+        -Path "/api/vcenter/namespaces/instances/v2/$namespaceSegment"
+    $namespaceInfo = Invoke-VcfVksJsonRequest `
+        -Method GET `
+        -Uri $namespaceUri `
+        -Headers $vCenterHeaders
+
+    if ([string] $namespaceInfo.config_status -cne 'RUNNING') {
+        throw "Namespace '$Namespace' is not ready (config_status='$($namespaceInfo.config_status)')."
+    }
+    if ([string] $namespaceInfo.supervisor -cne $SupervisorId) {
+        throw "Namespace '$Namespace' belongs to Supervisor '$($namespaceInfo.supervisor)', not '$SupervisorId'."
+    }
+
+    $bodyParameters = @{}
+    foreach ($optionalName in @(
+        'ControlPlaneReplicas',
+        'WorkerReplicas',
+        'PodCidrBlocks',
+        'ServiceCidrBlocks',
+        'ServiceDomain'
+    )) {
+        if ($PSBoundParameters.ContainsKey($optionalName)) {
+            $bodyParameters[$optionalName] = $PSBoundParameters[$optionalName]
+        }
+    }
+    $body = New-VcfVksClusterBody `
+        -Namespace $Namespace `
+        -Name $Name `
+        -ClusterClass $ClusterClass `
+        -KubernetesVersion $KubernetesVersion `
+        -VmClass $VmClass `
+        -StorageClass $StorageClass `
+        -BoundParameters $bodyParameters
+
+    $clusterUri = Join-VcfVksUri `
+        -BaseUri $supervisorApiUri `
+        -Path "/apis/cluster.x-k8s.io/v1beta2/namespaces/$namespaceSegment/clusters"
+    if (-not $PSCmdlet.ShouldProcess(
+        "$Namespace/$Name",
+        "Create VKS Cluster at $($clusterUri.AbsoluteUri)"
+    )) {
+        return
+    }
+
+    return Invoke-VcfVksJsonRequest `
+        -Method POST `
+        -Uri $clusterUri `
+        -Headers @{ Authorization = "Bearer $KubeBearerToken" } `
+        -Body $body
+}
+
+Export-ModuleMember -Function New-VcfVksCluster


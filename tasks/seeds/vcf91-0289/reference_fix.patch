+        deadline = time.monotonic() + poll_timeout
+        polls = 0
+        while True:
+            snapshot = self._read_status(token, update_id)
+            polls += 1
+            last_status = snapshot.get("status")
+            if last_status in TERMINAL_STATES:
+                return RotationOutcome(
+                    update_id=update_id,
+                    status=last_status,
+                    poll_count=polls,
+                    error_message=snapshot.get("error_message"),
+                    updated_nodes=list(snapshot.get("updated_nodes") or []),
+                    failed_nodes=list(snapshot.get("failed_nodes") or []),
+                )

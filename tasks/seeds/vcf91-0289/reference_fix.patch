+    def _follow_update(self, *, token: str, certificate_id: str, certificate_pem: str,
+                       private_key_pem: str, chain_pem: Optional[str],
+                       poll_interval: float, poll_timeout: float) -> RotationOutcome:
+        accepted = self._submit_update(token, certificate_id, certificate_pem,
+                                       private_key_pem, chain_pem)
+        update_id = accepted["id"]
+        # The status on the 202 is an acknowledgement (SUBMITTED), never a result.
+        last_status = accepted.get("status")

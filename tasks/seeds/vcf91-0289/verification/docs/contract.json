{
  "contract_version": 1,
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "spec_path": "specifications/vcf-operations/vcf-operations-for-networks-openapi.yaml",
    "spec_blob_sha": "a275ed98b326e07f4dd5fcadfdd67b315fe49419",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "api_title": "VCF Operations for networks API Reference",
    "api_version": "9.1.0.0",
    "server_base_path": "/api/ni"
  },
  "security": {
    "scheme": "ApiKeyAuth",
    "type": "apiKey",
    "in": "header",
    "name": "Authorization",
    "value_prefix": "NetworkInsight",
    "header_value_format": "NetworkInsight {token}",
    "spec_note": "components.securitySchemes.ApiKeyAuth is described as 'API Key - NetworkInsight {token}'. The Authentication tag documents a limit of 100 valid tokens per user and advises deleting tokens after use."
  },
  "status_model": {
    "schema": "CertificateUpdateStatus",
    "field": "status",
    "enum": [
      "SUBMITTED",
      "IN_PROGRESS",
      "SUCCESS",
      "FAILED"
    ],
    "non_terminal": [
      "SUBMITTED",
      "IN_PROGRESS"
    ],
    "terminal": [
      "SUCCESS",
      "FAILED"
    ],
    "success": "SUCCESS",
    "failure": "FAILED",
    "spec_note": "updateCertificate answers 202 Accepted carrying a CertificateUpdateStatus. The status carried by that acceptance is not a completion signal; the update reaches SUCCESS or FAILED only in a later poll."
  },
  "operations": [
    {
      "role": "authenticate",
      "operationId": "create",
      "tag": "Authentication",
      "method": "POST",
      "path": "/auth/token",
      "security": [],
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "UserCredential",
        "properties": {
          "username": {
            "type": "string",
            "example": "admin@vrni.com"
          },
          "password": {
            "type": "string",
            "example": "password"
          },
          "domain": {
            "$ref": "Domain",
            "type": "object",
            "properties": {
              "domain_type": {
                "type": "string",
                "enum": [
                  "LDAP",
                  "LOCAL"
                ],
                "nullable": true
              },
              "value": {
                "type": "string",
                "description": "domain value, not required for LOCAL domain"
              }
            }
          }
        },
        "required_in_spec": [],
        "always_sent": [
          "username",
          "password"
        ],
        "omit_when_unset": [
          "domain",
          "domain.value"
        ]
      },
      "success": {
        "status": 200,
        "schema": "Token",
        "properties": {
          "token": "string",
          "expiry": "integer(int64)"
        }
      },
      "errors": {
        "400": "ApiError",
        "401": "ApiError",
        "500": "ApiError"
      },
      "spec_note": "This is the only operation in the contract with an empty security requirement; it must be sent without an Authorization header."
    },
    {
      "role": "submit_certificate_update",
      "operationId": "updateCertificate",
      "tag": "Settings",
      "method": "PUT",
      "path": "/settings/certificates/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "The Id of the certificate to be updated"
        }
      ],
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "CertificateUpdateRequest",
        "properties": {
          "certificate": {
            "type": "string",
            "description": "The PEM encoded certificate string"
          },
          "private_key": {
            "type": "string",
            "description": "The PEM encoded private key string"
          },
          "chain": {
            "type": "string",
            "description": "The PEM encoded chain of trusted root CA certificate string",
            "default": ""
          }
        },
        "required_in_spec": [],
        "always_sent": [
          "certificate",
          "private_key"
        ],
        "omit_when_unset": [
          "chain"
        ]
      },
      "success": {
        "status": 202,
        "schema": "CertificateUpdateStatus",
        "properties": {
          "id": "string (certificate update id — the correlation handle for polling)",
          "name": "string",
          "status": "string (SUBMITTED on acceptance)",
          "error_message": "string",
          "failed_nodes": "array<Node>",
          "updated_nodes": "array<Node>",
          "last_modified_by_user": "string",
          "last_modified_time": "integer(int64)"
        }
      },
      "errors": {
        "400": "ApiError",
        "401": "ApiError",
        "403": "ApiError",
        "409": "ApiError",
        "500": "ApiError"
      }
    },
    {
      "role": "poll_update_status",
      "operationId": "fetchCertificateUpdateStatusForUpdateId",
      "tag": "Settings",
      "method": "GET",
      "path": "/settings/certificates/status/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "The update id for which update status is to be fetched"
        }
      ],
      "request_body": null,
      "success": {
        "status": 200,
        "schema": "CertificateUpdateStatus"
      },
      "errors": {
        "401": "ApiError",
        "403": "ApiError",
        "404": "ApiError",
        "500": "ApiError"
      },
      "spec_note": "The path parameter is the update id returned by updateCertificate, not the certificate id. The spec also defines the look-alike operation fetchCertificatesUpdateStatus at GET /settings/certificates/{id}/status, which is keyed by certificate id and is deliberately NOT part of this contract."
    },
    {
      "role": "revoke_token",
      "operationId": "delete",
      "tag": "Authentication",
      "method": "DELETE",
      "path": "/auth/token",
      "request_body": null,
      "success": {
        "status": 204,
        "schema": null,
        "body": "empty"
      },
      "errors": {
        "401": "ApiError",
        "500": "ApiError"
      },
      "spec_note": "Deletes the auth token supplied in the Authorization header."
    }
  ],
  "excluded_lookalikes": [
    {
      "operationId": "fetchCertificatesUpdateStatus",
      "method": "GET",
      "path": "/settings/certificates/{id}/status",
      "reason": "Keyed by certificate id rather than by the update id returned from the accepted update; out of contract."
    }
  ]
}

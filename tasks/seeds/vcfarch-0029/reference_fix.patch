 // BuildMigrationPlan maps every estate component to the ordered, gated target
 // declared by the protected compatibility snapshot.
 func BuildMigrationPlan(in Inputs) (MigrationPlan, error) {
-	return MigrationPlan{}, errors.New("BuildMigrationPlan is not implemented")
+	if len(in.Estate.Components) != len(in.Snapshot.UpgradePlan) {
+		return MigrationPlan{}, fmt.Errorf("inventory and pinned upgrade plan have different lengths")
+	}
+	inventory := make(map[string]EstateComponent, len(in.Estate.Components))
+	for _, component := range in.Estate.Components {
+		if _, exists := inventory[component.Name]; exists {
+			return MigrationPlan{}, fmt.Errorf("duplicate inventory component %q", component.Name)
+		}
+		inventory[component.Name] = component
+	}
+	steps := make([]MigrationStep, len(in.Snapshot.UpgradePlan))
+	for index, rule := range in.Snapshot.UpgradePlan {
+		component, exists := inventory[rule.Component]
+		if !exists || component.Version != rule.CurrentVersion || rule.Order != index+1 {
+			return MigrationPlan{}, fmt.Errorf("inventory does not match upgrade rule %q", rule.Component)
+		}
+		steps[index] = MigrationStep{
+			Order: rule.Order, Component: rule.Component, CurrentVersion: rule.CurrentVersion,
+			Target: rule.Target, Action: rule.Action, Gates: append([]string(nil), rule.Gates...),
+		}
+	}
+	return MigrationPlan{
+		SchemaVersion:  "1.0",
+		EstateID:       in.Estate.EstateID,
+		TargetVCF:      in.Snapshot.SupportedCombination.VCF,
+		SourceSnapshot: in.Snapshot.SnapshotID,
+		Steps:          steps,
+	}, nil
+}
+
+func architectureSite(site SiteRequirement) ArchitectureSite {
+	return ArchitectureSite{
+		ID: site.ID, Role: site.Role,
+		ManagementHosts: len(site.ManagementHosts), WorkloadHosts: len(site.WorkloadHosts),
+		HostCores: site.HostCores, HostMemoryGiB: site.HostMemoryGiB,
+		UsableStorageTiB: site.UsableStorageTiB,
+	}
 }

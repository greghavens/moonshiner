{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:northstar:migration-plan:1",
  "title": "Northstar VCF 9.1 migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "estateId", "targetVcfVersion", "sourceSnapshot", "steps"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "targetVcfVersion": {"type": "string", "minLength": 1},
    "sourceSnapshot": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "component", "currentVersion", "target", "action", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "component": {"type": "string", "minLength": 1},
          "currentVersion": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "action": {
            "type": "string",
            "enum": ["IN_PLACE_UPGRADE", "VCF_LCM_UPGRADE", "FLEET_LCM_UPGRADE", "MIGRATE_AND_DECOMMISSION", "DECOMMISSION"]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}

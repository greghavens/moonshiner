diff --git a/VcfUserAccess.psm1 b/VcfUserAccess.psm1
new file mode 100644
--- /dev/null
+++ b/VcfUserAccess.psm1
@@ -0,0 +1,172 @@
+# VCF 9.1 SDDC Manager user-access helpers backed by VMware's generated SDK.
+using module VMware.Sdk.Vcf.SddcManager
+
+Set-StrictMode -Version Latest
+
+class VcfUserComparer : System.Collections.IComparer {
+    [int] Compare([object]$left, [object]$right) {
+        $leftFields = @(
+            [string]$left.Domain,
+            [string]$left.Name,
+            [string]$left.Type,
+            [string]$left.Role.Id
+        )
+        $rightFields = @(
+            [string]$right.Domain,
+            [string]$right.Name,
+            [string]$right.Type,
+            [string]$right.Role.Id
+        )
+
+        for ($index = 0; $index -lt $leftFields.Count; $index++) {
+            $result = [StringComparer]::OrdinalIgnoreCase.Compare(
+                $leftFields[$index],
+                $rightFields[$index]
+            )
+            if ($result -ne 0) {
+                return $result
+            }
+            $result = [StringComparer]::Ordinal.Compare(
+                $leftFields[$index],
+                $rightFields[$index]
+            )
+            if ($result -ne 0) {
+                return $result
+            }
+        }
+        return 0
+    }
+}
+
+function Invoke-VcfSdkOperation {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string]$OperationId,
+
+        [Parameter(Mandatory)]
+        [object]$Server,
+
+        [hashtable]$Arguments = @{}
+    )
+
+    $operations = @(Get-VcfSddcManagerOperation -Name $OperationId)
+    if ($operations.Count -ne 1) {
+        throw "Expected exactly one VMware SDK operation for '$OperationId'; found $($operations.Count)."
+    }
+
+    $command = $operations[0].CommandInfo
+    $invokeArguments = @{
+        Server  = $Server
+        Confirm = $false
+    }
+    foreach ($key in $Arguments.Keys) {
+        $invokeArguments[$key] = $Arguments[$key]
+    }
+    & $command @invokeArguments
+}
+
+function Compare-VcfUserField {
+    param(
+        [AllowNull()]
+        [string]$Left,
+
+        [AllowNull()]
+        [string]$Right
+    )
+
+    [StringComparer]::OrdinalIgnoreCase.Equals(
+        [string]$Left,
+        [string]$Right
+    )
+}
+
+function Sort-VcfUserAccess {
+    param(
+        [AllowEmptyCollection()]
+        [object[]]$Users
+    )
+
+    [object[]]$sorted = @($Users)
+    [Array]::Sort($sorted, [VcfUserComparer]::new())
+    $sorted
+}
+
+function Get-VcfUserAccess {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [object]$Server
+    )
+
+    $page = Invoke-VcfSdkOperation `
+        -OperationId 'getUsers' `
+        -Server $Server
+    Sort-VcfUserAccess -Users @($page.Elements)
+}
+
+function Grant-VcfUserAccess {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [object]$Server,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string]$Name,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string]$Domain,
+
+        [Parameter(Mandatory)]
+        [ValidateSet('USER', 'GROUP', 'SERVICE')]
+        [string]$Type,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string]$RoleId
+    )
+
+    $current = @(Get-VcfUserAccess -Server $Server)
+    $matching = @(
+        $current | Where-Object {
+            (Compare-VcfUserField -Left $_.Name -Right $Name) -and
+            (Compare-VcfUserField -Left $_.Domain -Right $Domain) -and
+            (Compare-VcfUserField -Left $_.Type -Right $Type)
+        }
+    )
+
+    if ($matching.Count -gt 0) {
+        $wrongRole = @(
+            $matching | Where-Object {
+                -not (Compare-VcfUserField -Left $_.Role.Id -Right $RoleId)
+            }
+        )
+        if ($wrongRole.Count -gt 0) {
+            throw [InvalidOperationException]::new(
+                "User identity '$Name@$Domain' already exists with a different role."
+            )
+        }
+        return Sort-VcfUserAccess -Users $current
+    }
+
+    $role = Initialize-VcfRoleReference -Id $RoleId
+    $user = Initialize-VcfUser `
+        -Name $Name `
+        -Domain $Domain `
+        -Type $Type.ToUpperInvariant() `
+        -Role $role
+    $users = [System.Collections.Generic.List[
+        VMware.Bindings.Vcf.SddcManager.Model.User
+    ]]::new()
+    $users.Add($user)
+
+    $page = Invoke-VcfSdkOperation `
+        -OperationId 'addUsers' `
+        -Server $Server `
+        -Arguments @{ User = $users }
+    Sort-VcfUserAccess -Users @($page.Elements)
+}
+
+Export-ModuleMember -Function Get-VcfUserAccess, Grant-VcfUserAccess

  "migrations": [
    {
      "inventory_ref": "ops-01",
      "target_component": "VCF Operations",
      "target_version": "9.0.2",
      "method": "two-stage in-place upgrade through patched lifecycle and fleet management",
      "version_path": [
        "8.10.2",
        "8.17.2",
        "9.0.2"
      ],
      "eogs": "2024-10-11",
      "status": "past_eogs",
      "boundary_action": "upgrade immediately; do not extend the unsupported 8.10.2 state",
      "content": {
        "ops-capacity-dashboard": {
          "disposition": "carry_forward",
          "target_action": "validate the custom dashboard after each in-place upgrade"
        },
        "ops-production-policy": {
          "disposition": "carry_forward",
          "target_action": "preserve and regression-test policy assignments"
        },
        "ops-reclaimable-supermetric": {
          "disposition": "carry_forward",
          "target_action": "preserve and verify super metric calculations"
        },
        "ops-horizon-mp-27": {
          "disposition": "abandon",
          "target_action": "remove the EOGS Horizon management pack before target acceptance"
        },
        "ops-history-24m": {
          "disposition": "carry_forward",
          "target_action": "retain analytics history through the in-place upgrade and verify continuity"
        }
      }
    },
    {
      "inventory_ref": "auto-01",
      "target_component": "VCF Automation",
      "target_version": "9.0.2",
      "method": "import 8.18.1 into fleet management then perform managed upgrade",
      "version_path": [
        "8.18.1",
        "9.0.2"
      ],
      "eogs": "2027-10-11",
      "status": "supported",
      "boundary_action": "complete the migration before 2027-10-11",
      "content": {
        "auto-cloud-accounts": {
          "disposition": "carry_forward",
          "target_action": "retain accounts and validate credentials and regions"
        },
        "auto-projects": {
          "disposition": "carry_forward",
          "target_action": "retain projects and revalidate zone constraints"
        },
        "auto-cloud-templates": {
          "disposition": "carry_forward",
          "target_action": "retain templates and test deployment and publish operations"
        },
        "auto-vro-workflows": {
          "disposition": "carry_with_remediation",
          "target_action": "retain embedded workflows and align action return formats with template inputs"
        },
        "auto-abx-actions": {
          "disposition": "carry_forward",
          "target_action": "retain actions and execute test runs after database restoration"
        },
        "auto-active-deployments": {
          "disposition": "carry_with_remediation",
          "target_action": "retain deployments and remediate ownership visibility for lower-cased identities"
        },
        "auto-vidm-branding": {
          "disposition": "abandon",
          "target_action": "replace legacy identity-provider branding with VCF Identity Broker configuration"
        },
        "auto-csp-bookmarks": {
          "disposition": "abandon",
          "target_action": "publish the new tenant login URL and retire legacy CSP portal bookmarks"
        }
      }
    },
    {
      "inventory_ref": "logs-01",
      "target_component": "VCF Operations for Logs",
      "target_version": "9.0.2",
      "method": "fresh parallel deployment, manual configuration recreation, and supported log data transfer",
      "version_path": [
        "8.18.0",
        "fresh-9.0.2"
      ],
      "eogs": "2027-10-11",
      "status": "supported",
      "boundary_action": "complete the migration before 2027-10-11",
      "content": {
        "logs-security-content-pack": {
          "disposition": "recreate",
          "target_action": "export, review, and manually import the custom content pack"
        },
        "logs-noc-alerts": {
          "disposition": "recreate",
          "target_action": "recreate and test alert routing on the fresh target"
        },
        "logs-app-fields": {
          "disposition": "recreate",
          "target_action": "recreate extracted fields and validate them against sampled events"
        },
        "logs-source-integrations": {
          "disposition": "recreate",
          "target_action": "unconfigure source integrations only at cutover and reconfigure them on the target"
        },
        "logs-history-last-90d": {
          "disposition": "carry_forward",
          "target_action": "transfer no more than the supported most recent 90 days and verify counts"
        },
        "logs-history-older-90d": {
          "disposition": "abandon",
          "target_action": "keep the source read-only for the agreed legacy retention interval, then destroy it"
        }
      }
    }
  ],
  "steps": [
    {
      "id": "patch-suite-lifecycle",
      "scope": "platform",
      "action": "patch VMware Aria Suite Lifecycle to 8.18 Patch 2",
      "from_version": "8.18",
      "to_version": "8.18 Patch 2",
      "gates": [
        "lcm-backup-valid",
        "lcm-health-green"
      ]
    },
    {
      "id": "ops-preflight",
      "scope": "ops-01",
      "action": "back up, assess, and remove the unsupported Horizon management pack",
      "from_version": "8.10.2",
      "to_version": "8.10.2",
      "gates": [
        "ops-backup-valid",
        "ops-cluster-online",
        "ops-content-exported"
      ]
    },
    {
      "id": "ops-upgrade-8-17-2",
      "scope": "ops-01",
      "action": "apply the supported intermediate Operations upgrade",
      "from_version": "8.10.2",
      "to_version": "8.17.2",
      "gates": [
        "ops-precheck-8-17-2-pass",
        "ops-offline-snapshots-valid"
      ]
    },
    {
      "id": "ops-upgrade-9-0-2",
      "scope": "ops-01",
      "action": "upgrade Operations and deploy fleet management",
      "from_version": "8.17.2",
      "to_version": "9.0.2",
      "gates": [
        "ops-8-17-2-acceptance-pass",
        "fleet-prerequisites-pass"
      ]
    },
    {
      "id": "automation-import",
      "scope": "auto-01",
      "action": "import the existing Automation deployment into fleet management",
      "from_version": "8.18.1",
      "to_version": "8.18.1",
      "gates": [
        "automation-backup-valid",
        "automation-services-healthy",
        "embedded-orchestrator-confirmed",
        "operations-fleet-ready"
      ]
    },
    {
      "id": "automation-upgrade-9-0-2",
      "scope": "auto-01",
      "action": "perform the fleet-managed Automation upgrade",
      "from_version": "8.18.1",
      "to_version": "9.0.2",
      "gates": [
        "automation-import-complete",
        "automation-database-size-pass",
        "identity-mapping-reviewed"
      ]
    },
    {
      "id": "logs-fresh-deploy",
      "scope": "logs-01",
      "action": "deploy VCF Operations for Logs in parallel",
      "from_version": "8.18.0",
      "to_version": "fresh-9.0.2",
      "gates": [
        "logs-target-capacity-reserved",
        "logs-network-paths-pass",
        "logs-source-backup-valid"
      ]
    },
    {
      "id": "logs-content-config",
      "scope": "logs-01",
      "action": "recreate custom content and integrations on the fresh target",
      "from_version": "8.18.0",
      "to_version": "9.0.2",
      "gates": [
        "logs-target-cluster-healthy",
        "logs-content-export-reviewed"
      ]
    },
    {
      "id": "logs-transfer-90d",
      "scope": "logs-01",
      "action": "transfer the supported recent historical log window",
      "from_version": "8.18.0",
      "to_version": "9.0.2",
      "gates": [
        "logs-vcenter-license-valid",
        "logs-transfer-ports-pass",
        "logs-time-sync-pass"
      ]
    },
    {
      "id": "logs-cutover",
      "scope": "logs-01",
      "action": "redirect ingestion and disable source integrations",
      "from_version": "8.18.0",
      "to_version": "9.0.2",
      "gates": [
        "logs-content-acceptance-pass",
        "logs-data-transfer-complete",
        "logs-target-ingestion-pass"
      ]
    },
    {
      "id": "validate-estate",
      "scope": "estate",
      "action": "run cross-component functional and capacity acceptance",
      "from_version": "legacy-estate",
      "to_version": "vcf-9.0.2-estate",
      "gates": [
        "operations-content-pass",
        "automation-deployments-pass",
        "logs-query-alert-pass",
        "edge-failover-throughput-pass"
      ]
    },
    {
      "id": "retire-legacy",
      "scope": "estate",
      "action": "retire superseded appliances and legacy identity configuration",
      "from_version": "legacy-estate",
      "to_version": "retired",
      "gates": [
        "estate-acceptance-pass",
        "rollback-window-closed",
        "older-log-archive-verified"
      ]
    }
  ],

{
  "spec_version": "1.0",
  "package": {
    "name": "vcf_architecture",
    "runtime": "python3",
    "stdlib_only": true,
    "entrypoint": [
      "python3",
      "-m",
      "vcf_architecture",
      "--inventory",
      "estate_inventory.json",
      "--snapshot",
      "compatibility_snapshot.json",
      "--output",
      "{output}"
    ]
  },
  "artifact": {
    "path": "migration_plan.json",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$defs": {
        "placement": {
          "type": "object",
          "required": [
            "fleet",
            "domain",
            "cluster",
            "network",
            "failure_domains"
          ],
          "additionalProperties": false,
          "properties": {
            "fleet": {
              "type": "string",
              "minLength": 1
            },
            "domain": {
              "type": "string",
              "minLength": 1
            },
            "cluster": {
              "type": "string",
              "minLength": 1
            },
            "network": {
              "type": "string",
              "minLength": 1
            },
            "failure_domains": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "sizing": {
          "type": "object",
          "required": [
            "basis_metric",
            "basis_value",
            "profile",
            "nodes",
            "vcpu_per_node",
            "memory_gib_per_node",
            "storage_gib_per_node"
          ],
          "additionalProperties": false,
          "properties": {
            "basis_metric": {
              "type": "string",
              "minLength": 1
            },
            "basis_value": {
              "type": "integer",
              "minimum": 0
            },
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "nodes": {
              "type": "integer",
              "minimum": 1
            },
            "vcpu_per_node": {
              "type": "integer",
              "minimum": 1
            },
            "memory_gib_per_node": {
              "type": "integer",
              "minimum": 1
            },
            "storage_gib_per_node": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "component": {
          "type": "object",
          "required": [
            "id",
            "name",
            "version",
            "placement",
            "sizing"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "placement": {
              "$ref": "#/$defs/placement"
            },
            "sizing": {
              "$ref": "#/$defs/sizing"
            }
          }
        },
        "uplink": {
          "type": "object",
          "required": [
            "name",
            "speed_gbps",
            "tor",
            "traffic",
            "vlans",
            "bgp",
            "teaming"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "speed_gbps": {
              "type": "integer",
              "minimum": 1
            },
            "tor": {
              "type": "string",
              "minLength": 1
            },
            "traffic": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "overlay",
                  "north-south"
                ]
              }
            },
            "vlans": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "bgp": {
              "type": "boolean"
            },
            "teaming": {
              "type": "string",
              "enum": [
                "active",
                "standby"
              ]
            }
          }
        },
        "contentDisposition": {
          "type": "object",
          "required": [
            "content_id",
            "kind",
            "disposition",
            "target_action"
          ],
          "additionalProperties": false,
          "properties": {
            "content_id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "disposition": {
              "type": "string",
              "enum": [
                "carry_forward",
                "carry_with_remediation",
                "recreate",
                "abandon"
              ]
            },
            "target_action": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "migration": {
          "type": "object",
          "required": [
            "source",
            "target_component",
            "target_version",
            "method",
            "version_path",
            "content"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "object",
              "required": [
                "inventory_ref",
                "product",
                "version"
              ],
              "additionalProperties": false,
              "properties": {
                "inventory_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "product": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "target_component": {
              "type": "string",
              "minLength": 1
            },
            "target_version": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "version_path": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "content": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/contentDisposition"
              }
            }
          }
        },
        "step": {
          "type": "object",
          "required": [
            "order",
            "id",
            "scope",
            "action",
            "from_version",
            "to_version",
            "gates",
            "rollback"
          ],
          "additionalProperties": false,
          "properties": {
            "order": {
              "type": "integer",
              "minimum": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "action": {
              "type": "string",
              "minLength": 1
            },
            "from_version": {
              "type": "string",
              "minLength": 1
            },
            "to_version": {
              "type": "string",
              "minLength": 1
            },
            "gates": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rollback": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "gate": {
          "type": "object",
          "required": [
            "id",
            "before_step",
            "check",
            "expected",
            "failure_action"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "before_step": {
              "type": "string",
              "minLength": 1
            },
            "check": {
              "type": "string",
              "minLength": 1
            },
            "expected": {
              "type": "string",
              "minLength": 1
            },
            "failure_action": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "supportBoundary": {
          "type": "object",
          "required": [
            "inventory_ref",
            "product",
            "version",
            "eogs",
            "status_at_assessment",
            "action"
          ],
          "additionalProperties": false,
          "properties": {
            "inventory_ref": {
              "type": "string",
              "minLength": 1
            },
            "product": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "eogs": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "status_at_assessment": {
              "type": "string",
              "enum": [
                "supported",
                "past_eogs"
              ]
            },
            "action": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "type": "object",
      "required": [
        "schema_version",
        "plan_id",
        "inputs",
        "architecture",
        "migrations",
        "steps",
        "gate_catalog",
        "support_boundaries"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "plan_id": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object",
          "required": [
            "inventory_id",
            "compatibility_snapshot_id",
            "assessment_date"
          ],
          "additionalProperties": false,
          "properties": {
            "inventory_id": {
              "type": "string",
              "minLength": 1
            },
            "compatibility_snapshot_id": {
              "type": "string",
              "minLength": 1
            },
            "assessment_date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        },
        "architecture": {
          "type": "object",
          "required": [
            "vcf_release",
            "placement_principle",
            "components",
            "edge"
          ],
          "additionalProperties": false,
          "properties": {
            "vcf_release": {
              "type": "string",
              "minLength": 1
            },
            "placement_principle": {
              "type": "string",
              "minLength": 1
            },
            "components": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/component"
              }
            },
            "edge": {
              "type": "object",
              "required": [
                "sizing_basis",
                "form_factor",
                "nodes",
                "ha_mode",
                "capacity_per_node_gbps",
                "host_nics_required",
                "dedicated_uplinks_per_host",
                "minimum_capacity_after_uplink_failure_gbps",
                "uplinks"
              ],
              "additionalProperties": false,
              "properties": {
                "sizing_basis": {
                  "type": "object",
                  "required": [
                    "sustained_gbps",
                    "burst_gbps",
                    "minimum_after_single_uplink_failure_gbps"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "sustained_gbps": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "burst_gbps": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "minimum_after_single_uplink_failure_gbps": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "form_factor": {
                  "type": "string",
                  "enum": [
                    "LARGE",
                    "XLARGE"
                  ]
                },
                "nodes": {
                  "type": "integer",
                  "minimum": 2
                },
                "ha_mode": {
                  "type": "string",
                  "enum": [
                    "ACTIVE_ACTIVE",
                    "ACTIVE_STANDBY"
                  ]
                },
                "capacity_per_node_gbps": {
                  "type": "integer",
                  "minimum": 1
                },
                "host_nics_required": {
                  "type": "integer",
                  "minimum": 2
                },
                "dedicated_uplinks_per_host": {
                  "type": "integer",
                  "minimum": 2
                },
                "minimum_capacity_after_uplink_failure_gbps": {
                  "type": "integer",
                  "minimum": 1
                },
                "uplinks": {
                  "type": "array",
                  "minItems": 2,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/uplink"
                  }
                }
              }
            }
          }
        },
        "migrations": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/migration"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "gate_catalog": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/gate"
          }
        },
        "support_boundaries": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/supportBoundary"
          }
        }
      }
    }
  }
}

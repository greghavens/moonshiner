+"""Build the pinned, machine-checkable migration architecture."""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+def select_tier(value: int, tiers: list[dict[str, Any]], limit_key: str) -> dict[str, Any]:
+    for tier in tiers:
+        if value <= tier[limit_key]:
+            return tier
+    raise ValueError(f"demand {value} exceeds every pinned sizing tier")
+
+
+def build_components(
+    inventory: dict[str, Any], snapshot: dict[str, Any]
+) -> list[dict[str, Any]]:
+    products = {product["id"]: product for product in inventory["products"]}
+    destination = inventory["destination"]
+    placement_rule = snapshot["placement"]
+    components = []
+    for rule in snapshot["component_sizing"]:
+        product = products[rule["inventory_ref"]]
+        value = product["sizing"][rule["metric"]]
+        tier = select_tier(value, rule["tiers"], "max")
+        components.append(
+            {
+                "id": rule["id"],
+                "name": rule["name"],
+                "version": rule["version"],
+                "placement": {
+                    "fleet": placement_rule["fleet"],
+                    "domain": placement_rule["domain"],
+                    "cluster": placement_rule["cluster"],
+                    "network": placement_rule["network"],
+                    "failure_domains": destination["failure_domains"][: tier["nodes"]],
+                },
+                "sizing": {
+                    "basis_metric": rule["metric"],
+                    "basis_value": value,
+                    "profile": tier["profile"],
+                    "nodes": tier["nodes"],
+                    "vcpu_per_node": tier["vcpu_per_node"],
+                    "memory_gib_per_node": tier["memory_gib_per_node"],
+                    "storage_gib_per_node": tier["storage_gib_per_node"],
+                },
+            }
+        )
+    return components
+
+
+def build_edge(inventory: dict[str, Any], snapshot: dict[str, Any]) -> dict[str, Any]:
+    demand = inventory["network_requirements"]
+    rule = snapshot["edge_sizing"]
+    tier = select_tier(demand["north_south_burst_gbps"], rule["tiers"], "max_burst_gbps")
+    uplinks = [
+        {
+            "name": uplink["name"],
+            "speed_gbps": rule["uplink_speed_gbps"],
+            "tor": uplink["tor"],
+            "traffic": uplink["traffic"],
+            "vlans": uplink["vlans"],
+            "bgp": uplink["bgp"],
+            "teaming": uplink["teaming"],
+        }
+        for uplink in rule["uplinks"]
+    ]
+    return {
+        "sizing_basis": {
+            "sustained_gbps": demand["north_south_sustained_gbps"],
+            "burst_gbps": demand["north_south_burst_gbps"],
+            "minimum_after_single_uplink_failure_gbps": demand[
+                "minimum_after_single_uplink_failure_gbps"
+            ],
+        },
+        "form_factor": tier["form_factor"],
+        "nodes": rule["nodes"],
+        "ha_mode": rule["ha_mode"],
+        "capacity_per_node_gbps": tier["capacity_per_node_gbps"],
+        "host_nics_required": rule["required_host_nics"],
+        "dedicated_uplinks_per_host": rule["dedicated_uplinks_per_host"],
+        "minimum_capacity_after_uplink_failure_gbps": rule["uplink_speed_gbps"],
+        "uplinks": uplinks,
+    }
+
+
+def build_migrations(
+    inventory: dict[str, Any], snapshot: dict[str, Any]
+) -> list[dict[str, Any]]:
+    products = {product["id"]: product for product in inventory["products"]}
+    migrations = []
+    for rule in snapshot["migrations"]:
+        product = products[rule["inventory_ref"]]
+        migrations.append(
+            {
+                "source": {
+                    "inventory_ref": product["id"],
+                    "product": product["product"],
+                    "version": product["version"],
+                },
+                "target_component": rule["target_component"],
+                "target_version": rule["target_version"],
+                "method": rule["method"],
+                "version_path": rule["version_path"],
+                "content": [
+                    {
+                        "content_id": item["id"],
+                        "kind": item["kind"],
+                        "disposition": rule["content"][item["id"]]["disposition"],
+                        "target_action": rule["content"][item["id"]]["target_action"],
+                    }
+                    for item in product["content"]
+                ],
+            }
+        )
+    return migrations
+
+
+def build_steps(snapshot: dict[str, Any]) -> list[dict[str, Any]]:
+    rollback = (
+        "stop, keep the current source authoritative, and restore the validated "
+        "pre-step backup or snapshot before retrying"
+    )
+    return [
+        {
+            "order": order,
+            "id": step["id"],
+            "scope": step["scope"],
+            "action": step["action"],
+            "from_version": step["from_version"],
+            "to_version": step["to_version"],
+            "gates": step["gates"],
+            "rollback": rollback,
+        }
+        for order, step in enumerate(snapshot["steps"], start=1)
+    ]
+
+
+def build_gates(snapshot: dict[str, Any]) -> list[dict[str, Any]]:
+    gates = []
+    for step in snapshot["steps"]:
+        for gate_id in step["gates"]:
+            check, expected = snapshot["gates"][gate_id]
+            gates.append(
+                {
+                    "id": gate_id,
+                    "before_step": step["id"],
+                    "check": check,
+                    "expected": expected,
+                    "failure_action": "stop before the step, remediate the failed check, and rerun the gate",
+                }
+            )
+    return gates
+
+
+def build_boundaries(
+    inventory: dict[str, Any], snapshot: dict[str, Any]
+) -> list[dict[str, Any]]:
+    products = {product["id"]: product for product in inventory["products"]}
+    return [
+        {
+            "inventory_ref": rule["inventory_ref"],
+            "product": products[rule["inventory_ref"]]["product"],
+            "version": products[rule["inventory_ref"]]["version"],
+            "eogs": rule["eogs"],
+            "status_at_assessment": rule["status"],
+            "action": rule["boundary_action"],
+        }
+        for rule in snapshot["migrations"]
+    ]
+
+
+def build_plan(inventory: dict[str, Any], snapshot: dict[str, Any]) -> dict[str, Any]:
+    if inventory["destination"]["vcf_release"] != snapshot["target_release"]:
+        raise ValueError("inventory destination and pinned target release differ")
+    return {
+        "schema_version": "1.0",
+        "plan_id": f"{inventory['inventory_id']}-to-vcf-{snapshot['target_release']}",
+        "inputs": {
+            "inventory_id": inventory["inventory_id"],
+            "compatibility_snapshot_id": snapshot["snapshot_id"],
+            "assessment_date": inventory["assessment_date"],
+        },
+        "architecture": {
+            "vcf_release": snapshot["target_release"],
+            "placement_principle": snapshot["placement"]["principle"],
+            "components": build_components(inventory, snapshot),
+            "edge": build_edge(inventory, snapshot),
+        },
+        "migrations": build_migrations(inventory, snapshot),
+        "steps": build_steps(snapshot),
+        "gate_catalog": build_gates(snapshot),
+        "support_boundaries": build_boundaries(inventory, snapshot),
+    }

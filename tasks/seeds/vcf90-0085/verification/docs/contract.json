{
  "openapi": "3.0.1",
  "info": {
    "title": "VCF Operations for Logs",
    "version": "v2"
  },
  "servers": [
    {
      "url": "/api/v2"
    }
  ],
  "paths": {
    "/sessions": {
      "post": {
        "tags": [
          "sessions"
        ],
        "description": "Signs into VCF Operations for Logs with the given credentials, creates and returns a new session.",
        "operationId": "POST_sessions",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/sessions.post.request"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "description": "Successfully signed into VCF Operations for Logs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/sessions.post.response"
                }
              }
            }
          },
          "401": {
            "description": "Could not sign in with the given credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "x-codegen-request-body-name": "body"
      }
    },
    "/log-forwarder/{id}": {
      "put": {
        "tags": [
          "log-forwarder"
        ],
        "description": "Updates the settings of a log forwarding destination.",
        "operationId": "PUT_log-forwarder-id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The unique identifier of a forwarding configuration.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/forwarders.put.request"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "description": "Successfully updated log forwarder configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/forwarders.get.response"
                }
              }
            }
          },
          "400": {
            "description": "The request failed because the request body either did not contain valid JSON, or did not match the required JSON format.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "401": {
            "description": "The request was refused because it lacks valid authentication credentials."
          },
          "404": {
            "description": "No such forwarder to edit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "440": {
            "description": "The request was refused because the session ID has expired."
          },
          "495": {
            "description": "SSL connection failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error while processing the client request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "x-codegen-request-body-name": "body"
      }
    }
  },
  "components": {
    "schemas": {
      "sessions.post.request": {
        "required": [
          "password",
          "provider",
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "Local",
              "ActiveDirectory",
              "vIDM"
            ]
          }
        }
      },
      "sessions.post.response": {
        "type": "object",
        "properties": {
          "userId": {
            "description": "UUID",
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "sessionId": {
            "description": "An opaque session ID for use in the Authorization header.",
            "type": "string",
            "minLength": 1
          },
          "ttl": {
            "description": "Time to live: Number of seconds this session is valid for.",
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "userId",
          "sessionId",
          "ttl"
        ]
      },
      "forwarders.put.request": {
        "type": "object",
        "properties": {
          "acceptCert": {
            "type": "boolean",
            "default": false
          },
          "name": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "protocol": {
            "type": "string",
            "oneOf": [
              {
                "enum": [
                  "SYSLOG",
                  "CFAPI",
                  "RAW",
                  "RAWPlus"
                ]
              }
            ]
          },
          "sslEnabled": {
            "type": "boolean"
          },
          "workerCount": {
            "type": "integer",
            "default": 4
          },
          "diskCacheSize": {
            "type": "integer",
            "default": 1000000000
          },
          "tags": {
            "type": "object",
            "default": {}
          },
          "filter": {
            "type": "string",
            "default": ""
          },
          "transportProtocol": {
            "type": "string",
            "oneOf": [
              {
                "enum": [
                  "TCP",
                  "UDP",
                  "TCP_OCTET"
                ]
              }
            ]
          },
          "forwardComplementaryFields": {
            "type": "boolean",
            "default": false
          },
          "testConnection": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "host",
          "port",
          "protocol",
          "sslEnabled"
        ]
      },
      "forwarders.get.response": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "SYSLOG",
              "CFAPI",
              "RAW",
              "RAWPlus",
              "UNKNOWN"
            ]
          },
          "sslEnabled": {
            "type": "boolean"
          },
          "workerCount": {
            "type": "integer"
          },
          "connectionRefreshInterval": {
            "type": "integer"
          },
          "diskCacheSize": {
            "type": "integer"
          },
          "tags": {
            "type": "object",
            "default": {}
          },
          "filter": {
            "type": "string",
            "default": ""
          },
          "transportProtocol": {
            "type": "string",
            "enum": [
              "TCP",
              "UDP",
              "TCP_OCTET",
              "UNKNOWN"
            ]
          },
          "forwardComplementaryFields": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "host",
          "port",
          "protocol",
          "sslEnabled",
          "workerCount",
          "diskCacheSize",
          "tags",
          "filter",
          "forwardComplementaryFields",
          "id"
        ]
      },
      "error": {
        "type": "object",
        "properties": {
          "errorMessage": {
            "type": "string",
            "description": "A message describing the error."
          },
          "errorCode": {
            "type": "string",
            "description": "A code representing the type of error.",
            "enum": [
              "LIMIT_ERROR",
              "FIELD_ERROR",
              "TEST_ERROR",
              "JSON_FORMAT_ERROR",
              "LICENSE_ERROR",
              "VSPHERE_INTEGRATION_ERROR",
              "VROPS_INTEGRATION_ERROR",
              "UPGRADE_ERROR",
              "SEARCH_ERROR",
              "AGENT_ERROR",
              "RBAC_COMMON_ERROR",
              "RBAC_USERS_ERROR",
              "RBAC_GROUPS_ERROR",
              "RBAC_ADGROUPS_ERROR",
              "RBAC_DATASETS_ERROR",
              "RBAC_VIDM_GROUPS_ERROR",
              "RBAC_VIDB_GROUPS_ERROR",
              "SECURITY_ERROR",
              "DEPLOYMENT_ERROR",
              "SUPPORT_BUNDLE_ERROR",
              "LOAD_BALANCER_ERROR",
              "VIDM_ERROR",
              "VIDB_ERROR",
              "QUERY_ERROR",
              "SSL_CERTIFICATE_ERROR",
              "PROXY_ERROR"
            ]
          },
          "errorDetails": {
            "type": "object",
            "description": "Dynamic error details, where the field name can vary depending on the request field and error code."
          }
        },
        "required": [
          "errorMessage"
        ]
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}

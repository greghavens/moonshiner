+                -Headers $headers `
+                -ContentType 'application/json' `
+                -Body ($body | ConvertTo-Json -Compress -Depth 20) `
+                -ErrorAction Stop
+            $steps.Add([pscustomobject]@{
+                    OperationId = 'PUT_log-forwarder-id'
+                    TargetId    = $targetId

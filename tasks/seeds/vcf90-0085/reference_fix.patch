 Set-StrictMode -Version Latest
 
+function Test-InputProperty {
+    param(
+        [Parameter(Mandatory)]
+        [object] $InputObject,
+
+        [Parameter(Mandatory)]
+        [string] $Name
+    )
+
+    if ($InputObject -is [System.Collections.IDictionary]) {
+        return $InputObject.Contains($Name)
+    }
+
+    return $null -ne $InputObject.PSObject.Properties[$Name]
+}
+
+function Get-InputProperty {
+    param(
+        [Parameter(Mandatory)]
+        [object] $InputObject,
+
+        [Parameter(Mandatory)]
+        [string] $Name
+    )
+
+    if ($InputObject -is [System.Collections.IDictionary]) {
+        return $InputObject[$Name]
+    }
+
+    return $InputObject.PSObject.Properties[$Name].Value
+}
+
+function Get-HttpFailure {
+    param(
+        [Parameter(Mandatory)]
+        [System.Management.Automation.ErrorRecord] $ErrorRecord
+    )
+
+    $response = $null
+    $responseProperty = $ErrorRecord.Exception.PSObject.Properties['Response']
+    if ($null -ne $responseProperty) {
+        $response = $responseProperty.Value
+    }
+
+    $statusCode = $null
+    if ($null -ne $response) {
+        $statusCode = [int] $response.StatusCode
+    }
+
+    $errorBody = $null
+    $rawError = $null
+    if ($null -ne $ErrorRecord.ErrorDetails) {
+        $rawError = $ErrorRecord.ErrorDetails.Message
+    }
+    if ([string]::IsNullOrWhiteSpace($rawError) -and
+        $null -ne $response -and
+        $null -ne $response.Content) {
+        $rawError = $response.Content.ReadAsStringAsync().GetAwaiter().GetResult()
+    }
+
+    if (-not [string]::IsNullOrWhiteSpace($rawError)) {
+        try {
+            $errorBody = $rawError | ConvertFrom-Json -ErrorAction Stop
+        }
+        catch {
+            $errorBody = $null
+        }
+    }
+
+    $errorCode = $null
+    $message = $ErrorRecord.Exception.Message
+    if ($null -ne $errorBody) {
+        if ($null -ne $errorBody.PSObject.Properties['errorCode']) {
+            $errorCode = $errorBody.errorCode
+        }
+        if ($null -ne $errorBody.PSObject.Properties['errorMessage']) {
+            $message = $errorBody.errorMessage
+        }
+    }
+
+    return [pscustomobject]@{
+        HttpStatus = $statusCode
+        ErrorCode  = $errorCode
+        Message    = $message
+    }
+}
+
 function Invoke-VcfOpsLogsForwarderRollout {
     [CmdletBinding()]
     param(

+                    OperationId = 'PUT_log-forwarder-id'
+                    TargetId    = $targetId
+                    Status      = 'Failed'
+                    HttpStatus  = $failure.HttpStatus
+                    ErrorCode   = $failure.ErrorCode
+                    Message     = $failure.Message
+                })

+            if (-not (Test-InputProperty -InputObject $update -Name $field)) {
+                throw "Update '$targetId' must supply required field '$field'."
+            }
+            $body[$field] = Get-InputProperty -InputObject $update -Name $field
+        }
+        foreach ($field in $optionalFields) {

--- a/vcf_architecture/__main__.py
+++ b/vcf_architecture/__main__.py
@@ -2,9 +2,34 @@
 
 from __future__ import annotations
 
+import argparse
+import json
+from pathlib import Path
 
-def main() -> int:
-    raise NotImplementedError("implement the command-line interface")
+from . import build_architecture
+
+
+def _load(path: Path) -> dict:
+    with path.open("r", encoding="utf-8") as handle:
+        value = json.load(handle)
+    if not isinstance(value, dict):
+        raise ValueError(f"{path} must contain a JSON object")
+    return value
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--inventory", required=True, type=Path)
+    parser.add_argument("--compatibility", required=True, type=Path)
+    parser.add_argument("--output", required=True, type=Path)
+    args = parser.parse_args(argv)
+
+    artifact = build_architecture(_load(args.inventory), _load(args.compatibility))
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(
+        json.dumps(artifact, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+    )
+    return 0
 
 
 if __name__ == "__main__":

-"""Architecture builder."""
+"""Build a deterministic, installer-shaped VCF architecture."""
 
 from __future__ import annotations
 
+from copy import deepcopy
+from ipaddress import ip_address
 from typing import Any
 
 
+def _network_spec(network: dict[str, Any]) -> dict[str, Any]:
+    spec = {
+        "networkType": network["networkType"],
+        "vlanId": network["vlanId"],
+        "subnet": network["subnet"],
+        "gateway": network["gateway"],
+        "mtu": network["mtu"],
+        "includeIpAddressRanges": [
+            {
+                "startIpAddress": network["poolStart"],
+                "endIpAddress": network["poolEnd"],
+            }
+        ],
+    }
+    explicit = {
+        "VMOTION": ("uplink2", "uplink1"),
+        "VSAN": ("uplink1", "uplink2"),
+        "EDGE_UPLINK_A": ("uplink3", "uplink4"),
+        "EDGE_UPLINK_B": ("uplink4", "uplink3"),
+    }
+    if network["networkType"] in explicit:
+        active, standby = explicit[network["networkType"]]
+        spec.update(
+            teamingPolicy="failover_explicit",
+            activeUplinks=[active],
+            standbyUplinks=[standby],
+        )
+    else:
+        spec["teamingPolicy"] = "loadbalance_loadbased"
+    return spec
+
+
+def _select_form_factor(
+    edge_requirement: dict[str, Any], compatibility: dict[str, Any]
+) -> dict[str, Any]:
+    remaining = edge_requirement["edgeNodeCount"] - edge_requirement["nodeFailureTolerance"]
+    candidates = sorted(
+        (
+            item
+            for item in compatibility["edgeFormFactors"]
+            if item["supportedForTier0"]
+            and remaining * item["validatedNorthSouthGbpsPerNode"]
+            >= edge_requirement["northSouthThroughputGbps"]
+        ),
+        key=lambda item: item["validatedNorthSouthGbpsPerNode"],
+    )
+    if not candidates:
+        raise ValueError("no supported Edge form factor satisfies failure capacity")
+    return candidates[0]
+
+
+def _address_at(network: dict[str, Any], offset: int) -> str:
+    start = ip_address(network["poolStart"])
+    end = ip_address(network["poolEnd"])
+    selected = start + offset
+    if selected > end:
+        raise ValueError(f"insufficient addresses in {network['networkType']}")
+    return str(selected)
+
+

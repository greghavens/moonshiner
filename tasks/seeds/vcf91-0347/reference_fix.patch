+        HttpResponse<String> response;
+        try {
+            response = httpClient.send(
+                    builder.build(), HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+        } catch (IOException error) {
+            throw new VcfAutomationException(method + " " + path + " failed", error);
+        } catch (InterruptedException error) {
+            Thread.currentThread().interrupt();
+            throw new VcfAutomationException(method + " " + path + " was interrupted", error);
+        }
+        if (response.statusCode() != 200) {
+            throw new VcfAutomationException(
+                    method + " " + path + " returned HTTP " + response.statusCode());
+        }
+        try {
+            return object(Json.parse(response.body()), method + " " + path + " response");
+        } catch (VcfAutomationException error) {
+            throw error;
+        } catch (RuntimeException error) {
+            throw new VcfAutomationException(
+                    method + " " + path + " returned malformed JSON", error);
+        }

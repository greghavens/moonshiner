+// ReleaseToken performs operationId releaseToken and clears the stored token
+// after the appliance confirms that the session was terminated. Calling it
+// without a stored token is a no-op.
+func (c *Client) ReleaseToken(ctx context.Context) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	if c.token == "" {
+		return nil
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost,
+		c.baseURL+"/api/auth/token/release", nil)
+	if err != nil {
+		return fmt.Errorf("vcf operations: build releaseToken request: %w", err)
+	}
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("Authorization", tokenPrefix+c.token)
+
+	if err := c.do(req, "releaseToken", nil); err != nil {
+		return err
+	}
+	c.token = ""
+	return nil
+}

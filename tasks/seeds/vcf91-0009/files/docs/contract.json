{
  "product": "VMware Cloud Foundation SDDC Manager REST API 9.1",
  "openapi": "3.0.1",
  "api_version": "9.1.0.0",
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "license": "Apache-2.0"
  },
  "operations": [
    {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "request": {
        "required": true,
        "contentType": "application/json",
        "schema": "TokenCreationSpec"
      },
      "responses": {
        "201": {
          "description": "Created",
          "schema": "TokenPair"
        },
        "400": {
          "description": "Bad Request",
          "schema": "Error"
        },
        "500": {
          "description": "Internal Server Error",
          "schema": "Error"
        }
      }
    },
    {
      "operationId": "getApplianceInfo",
      "method": "GET",
      "path": "/v1/system/appliance-info",
      "responses": {
        "200": {
          "description": "OK",
          "schema": "ApplianceInfo"
        },
        "500": {
          "description": "InternalServerError",
          "schema": "Error"
        }
      }
    },
    {
      "operationId": "getBundles",
      "method": "GET",
      "path": "/v1/bundles",
      "queryParameters": [
        {
          "name": "productType",
          "required": false,
          "type": "string"
        },
        {
          "name": "isCompliant",
          "required": false,
          "type": "boolean"
        },
        {
          "name": "bundleType",
          "required": false,
          "type": "string"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "schema": "PageOfBundle"
        },
        "500": {
          "description": "Internal Server Error",
          "schema": "Error"
        }
      }
    },
    {
      "operationId": "startBundleDownloadByID",
      "method": "PATCH",
      "path": "/v1/bundles/{id}",
      "pathParameters": [
        {
          "name": "id",
          "required": true,
          "type": "string"
        }
      ],
      "request": {
        "required": true,
        "contentType": "application/json",
        "schema": "BundleUpdateSpec"
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "schema": "Task"
        },
        "400": {
          "description": "Bad Request",
          "schema": "Error"
        },
        "409": {
          "description": "Conflict",
          "schema": "Error"
        },
        "500": {
          "description": "Internal Server Error",
          "schema": "Error"
        }
      }
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "pathParameters": [
        {
          "name": "id",
          "required": true,
          "type": "string"
        }
      ],
      "responses": {
        "200": {
          "description": "A task object.",
          "schema": "Task"
        },
        "404": {
          "description": "Task not found",
          "schema": "Error"
        },
        "500": {
          "description": "Unexpected error",
          "schema": "Error"
        }
      }
    }
  ],
  "components": {
    "schemas": {
    "TokenCreationSpec": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "apiKey": {
          "type": "string"
        },
        "idToken": {
          "type": "string"
        }
      }
    },
    "RefreshToken": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "TokenPair": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string"
        },
        "refreshToken": {
          "$ref": "#/components/schemas/RefreshToken"
        }
      }
    },
    "ApplianceInfo": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "dnsDomain": {
          "type": "string"
        },
        "dnsServers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ntpServers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "PageOfBundle": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Bundle"
          }
        },
        "pageMetadata": {
          "$ref": "#/components/schemas/PageMetadata"
        }
      }
    },
    "PageMetadata": {
      "type": "object",
      "properties": {
        "pageNumber": {
          "type": "integer",
          "format": "int32"
        },
        "pageSize": {
          "type": "integer",
          "format": "int32"
        },
        "totalElements": {
          "type": "integer",
          "format": "int32"
        },
        "totalPages": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "Bundle": {
      "required": [
        "downloadStatus",
        "type"
      ],
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "type": {
          "type": "string",
          "readOnly": true
        },
        "version": {
          "type": "string",
          "readOnly": true
        },
        "downloadStatus": {
          "type": "string",
          "readOnly": true
        }
      }
    },
    "BundleDownloadSpec": {
      "type": "object",
      "properties": {
        "scheduledTimestamp": {
          "type": "string"
        },
        "downloadNow": {
          "type": "boolean"
        },
        "cancelNow": {
          "type": "boolean"
        }
      }
    },
    "BundleUpdateSpec": {
      "type": "object",
      "properties": {
        "bundleDownloadSpec": {
          "$ref": "#/components/schemas/BundleDownloadSpec"
        }
      }
    },
    "Task": {
      "required": [
        "creationTimestamp",
        "id",
        "name",
        "status"
      ],
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "readOnly": true
        },
        "type": {
          "type": "string",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "readOnly": true,
          "example": "One among: PENDING, Pending, IN_PROGRESS, In Progress, SUCCESSFUL, Successful, FAILED, Failed, CANCELLED, Cancelled, COMPLETED_WITH_WARNING, SKIPPED, QUEUED, TIMED_OUT, Queued, Timed Out"
        },
        "creationTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "completionTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "isCancellable": {
          "type": "boolean",
          "readOnly": true
        },
        "isRetryable": {
          "type": "boolean",
          "readOnly": true
        }
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "errorCode": {
          "type": "string",
          "readOnly": true
        },
        "message": {
          "type": "string",
          "readOnly": true
        },
        "remediationMessage": {
          "type": "string"
        },
        "referenceToken": {
          "type": "string",
          "readOnly": true
        }
      }
    }
    }
  },
  "client_rules": {
    "catalog_output_properties": [
      "Id",
      "Version",
      "Type",
      "DownloadStatus"
    ],
    "catalog_sort": {
      "property": "Id",
      "comparison": "ordinal-case-sensitive",
      "direction": "ascending"
    },
    "download_request": {
      "bundleDownloadSpec": {
        "downloadNow": true
      }
    },
    "polling": {
      "normalize_case": "upper-invariant",
      "normalize_spaces_as": "_",
      "non_terminal": [
        "PENDING",
        "IN_PROGRESS",
        "QUEUED"
      ],
      "successful_terminal": [
        "SUCCESSFUL",
        "COMPLETED_WITH_WARNING",
        "SKIPPED"
      ],
      "unsuccessful_terminal": [
        "FAILED",
        "CANCELLED",
        "TIMED_OUT"
      ],
      "accepted_response_is_terminal": false,
      "minimum_get_polls": 1
    }
  }
}

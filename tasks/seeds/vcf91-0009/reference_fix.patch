diff --git a/VcfBundleLifecycle.psm1 b/VcfBundleLifecycle.psm1
new file mode 100644
index 0000000..5f021a3
--- /dev/null
+++ b/VcfBundleLifecycle.psm1
@@ -0,0 +1,231 @@
+Set-StrictMode -Version Latest
+
+class VcfBundleTaskException : System.Exception {
+    [string] $TaskId
+    [string] $TaskStatus
+    [object] $Task
+
+    VcfBundleTaskException(
+        [string] $message,
+        [string] $taskId,
+        [string] $taskStatus,
+        [object] $task
+    ) : base($message) {
+        $this.TaskId = $taskId
+        $this.TaskStatus = $taskStatus
+        $this.Task = $task
+    }
+}
+
+class VcfBundlePollTimeoutException : System.TimeoutException {
+    [string] $TaskId
+    [string] $TaskStatus
+    [object] $Task
+
+    VcfBundlePollTimeoutException(
+        [string] $message,
+        [string] $taskId,
+        [string] $taskStatus,
+        [object] $task
+    ) : base($message) {
+        $this.TaskId = $taskId
+        $this.TaskStatus = $taskStatus
+        $this.Task = $task
+    }
+}
+
+class VcfBundleProtocolException : System.Exception {
+    [string] $TaskId
+    [string] $TaskStatus
+    [object] $Task
+
+    VcfBundleProtocolException(
+        [string] $message,
+        [string] $taskId,
+        [string] $taskStatus,
+        [object] $task
+    ) : base($message) {
+        $this.TaskId = $taskId
+        $this.TaskStatus = $taskStatus
+        $this.Task = $task
+    }
+}
+
+function ConvertTo-VcfBundleTaskStatus {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [object] $Task,
+
+        [Parameter(Mandatory)]
+        [string] $TaskId
+    )
+
+    $statusProperty = $Task.PSObject.Properties['Status']
+    if ($null -eq $statusProperty -or [string]::IsNullOrWhiteSpace([string]$statusProperty.Value)) {
+        throw [VcfBundleProtocolException]::new(
+            "Task '$TaskId' did not contain a status.",
+            $TaskId,
+            '',
+            $Task
+        )
+    }
+
+    return ([string]$statusProperty.Value).Trim().Replace(' ', '_').ToUpperInvariant()
+}
+
+function Connect-VcfBundleManager {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $Server,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNull()]
+        [pscredential] $Credential,
+
+        [ValidateRange(1, 65535)]
+        [int] $Port = 443,
+
+        [ValidateSet('http', 'https')]
+        [string] $Protocol = 'https'
+    )
+
+    Import-Module VMware.Sdk.Vcf.SddcManager -MinimumVersion 13.5.0 -ErrorAction Stop
+
+    Connect-VcfSddcManagerServer `
+        -Server $Server `
+        -Credential $Credential `
+        -Port $Port `
+        -Protocol $Protocol `
+        -NotDefault `
+        -ErrorAction Stop
+}
+
+function Get-VcfBundleCatalog {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateNotNull()]
+        [object] $Connection
+    )
+
+    $response = Invoke-VcfGetBundles -Server $Connection -ErrorAction Stop
+    $catalog = [object[]]@(
+        foreach ($bundle in @($response.Elements)) {
+            [pscustomobject][ordered]@{
+                Id             = $bundle.Id
+                Version        = $bundle.Version
+                Type           = $bundle.Type
+                DownloadStatus = $bundle.DownloadStatus
+            }
+        }
+    )
+
+    $comparer = [System.Collections.Generic.Comparer[object]]::Create(
+        [System.Comparison[object]] {
+            param([object] $left, [object] $right)
+            return [System.StringComparer]::Ordinal.Compare(
+                [string]$left.Id,
+                [string]$right.Id
+            )
+        }
+    )
+    [System.Array]::Sort($catalog, $comparer)
+    $catalog
+}
+
+function Start-VcfBundleDownload {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateNotNull()]
+        [object] $Connection,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $BundleId,
+
+        [ValidateRange(0, [int]::MaxValue)]
+        [int] $PollIntervalSeconds = 5,
+
+        [ValidateRange(1, [int]::MaxValue)]
+        [int] $PollLimit = 120,
+
+        [ValidateNotNull()]
+        [scriptblock] $SleepAction = {
+            param([int] $seconds)
+            Start-Sleep -Seconds $seconds
+        }
+    )
+
+    $downloadSpec = Initialize-VcfBundleDownloadSpec -DownloadNow $true
+    $updateSpec = Initialize-VcfBundleUpdateSpec -BundleDownloadSpec $downloadSpec
+    $acceptedTask = Invoke-VcfStartBundleDownloadByID `
+        -Id $BundleId `
+        -BundleUpdateSpec $updateSpec `
+        -Server $Connection `
+        -ErrorAction Stop
+
+    $taskId = [string]$acceptedTask.Id
+    if ([string]::IsNullOrWhiteSpace($taskId)) {
+        throw [VcfBundleProtocolException]::new(
+            'The accepted bundle download response did not contain a task ID.',
+            '',
+            '',
+            $acceptedTask
+        )
+    }
+
+    $lastTask = $acceptedTask
+    $lastStatus = ''
+    for ($poll = 0; $poll -lt $PollLimit; $poll++) {
+        $lastTask = Invoke-VcfGetTask `
+            -Id $taskId `
+            -Server $Connection `
+            -ErrorAction Stop
+        $lastStatus = ConvertTo-VcfBundleTaskStatus -Task $lastTask -TaskId $taskId
+
+        switch ($lastStatus) {
+            { $_ -in @('SUCCESSFUL', 'COMPLETED_WITH_WARNING', 'SKIPPED') } {
+                return $lastTask
+            }
+            { $_ -in @('FAILED', 'CANCELLED', 'TIMED_OUT') } {
+                throw [VcfBundleTaskException]::new(
+                    "Bundle download task '$taskId' ended with status '$lastStatus'.",
+                    $taskId,
+                    $lastStatus,
+                    $lastTask
+                )
+            }
+            { $_ -in @('PENDING', 'IN_PROGRESS', 'QUEUED') } {
+                if ($poll + 1 -lt $PollLimit) {
+                    & $SleepAction $PollIntervalSeconds
+                }
+                continue
+            }
+            default {
+                throw [VcfBundleProtocolException]::new(
+                    "Bundle download task '$taskId' returned undocumented status '$lastStatus'.",
+                    $taskId,
+                    $lastStatus,
+                    $lastTask
+                )
+            }
+        }
+    }
+
+    throw [VcfBundlePollTimeoutException]::new(
+        "Bundle download task '$taskId' did not reach a terminal state after $PollLimit polls.",
+        $taskId,
+        $lastStatus,
+        $lastTask
+    )
+}
+
+Export-ModuleMember -Function @(
+    'Connect-VcfBundleManager',
+    'Get-VcfBundleCatalog',
+    'Start-VcfBundleDownload'
+)

{
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "license": "Apache-2.0",
    "tag": "9.0.0.0",
    "commit_sha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "path": "specifications/vcf-operations/vcf-operations-openapi.json"
  },
  "openapi": "3.0.1",
  "base_path": "/suite-api",
  "security_scheme": {
    "name": "Token-based-authorization",
    "type": "apiKey",
    "in": "header",
    "header": "Authorization"
  },
  "operations": {
    "acquireToken": {
      "method": "POST",
      "path": "/api/auth/token/acquire",
      "security": [],
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "username",
            "password"
          ],
          "properties": {
            "username": {
              "type": "string"
            },
            "authSource": {
              "type": "string",
              "required": false
            },
            "password": {
              "type": "string"
            }
          }
        }
      },
      "responses": {
        "200": {
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "required": [
              "token",
              "validity"
            ],
            "properties": {
              "token": {
                "type": "string"
              },
              "validity": {
                "type": "integer",
                "format": "int64"
              },
              "expiresAt": {
                "type": "string",
                "required": false
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "required": false
              }
            }
          }
        },
        "401": {
          "description": "Authentication failed"
        }
      }
    },
    "getResources": {
      "method": "GET",
      "path": "/api/resources",
      "security": [
        "Token-based-authorization"
      ],
      "query_parameters": [
        {"name": "name", "type": "array", "items": "string", "required": false},
        {"name": "regex", "type": "array", "items": "string", "required": false},
        {"name": "adapterKind", "type": "array", "items": "string", "required": false},
        {"name": "resourceKind", "type": "array", "items": "string", "required": false},
        {"name": "collectorName", "type": "array", "items": "string", "required": false},
        {"name": "collectorId", "type": "array", "items": "integer", "format": "int32", "required": false},
        {"name": "maintenanceScheduleId", "type": "array", "items": "string", "format": "uuid", "required": false, "deprecated": true},
        {"name": "adapterInstanceId", "type": "array", "items": "string", "format": "uuid", "required": false},
        {"name": "recentlyAdded", "type": "integer", "format": "int64", "required": false},
        {"name": "resourceState", "type": "array", "items": "resource-state", "required": false},
        {"name": "resourceStatus", "type": "array", "items": "resource-data-collection-status", "required": false},
        {"name": "resourceHealth", "type": "array", "items": "resource-health", "required": false},
        {"name": "parentId", "type": "array", "items": "string", "format": "uuid", "required": false},
        {"name": "credentialId", "type": "array", "items": "string", "format": "uuid", "required": false},
        {"name": "resourceId", "type": "array", "items": "string", "format": "uuid", "required": false},
        {"name": "propertyName", "type": "string", "required": false},
        {"name": "propertyValue", "type": "string", "required": false},
        {"name": "statKey", "type": "string", "required": false},
        {"name": "statKeyLowerBound", "type": "number", "format": "double", "required": false},
        {"name": "statKeyUpperBound", "type": "number", "format": "double", "required": false},
        {"name": "statKeyInclusive", "type": "boolean", "required": false},
        {"name": "includeRelated", "type": "string", "enum": ["PARENT", "CHILD"], "required": false},
        {"name": "page", "type": "integer", "format": "int32", "required": false, "default": 0},
        {"name": "pageSize", "type": "integer", "format": "int32", "required": false, "default": 1000}
      ],
      "responses": {
        "200": {
          "content_type": "application/json",
          "schema": {
            "type": "object",
            "properties": {
              "pageInfo": {
                "type": "object",
                "properties": {
                  "totalCount": {"type": "integer", "format": "int32"},
                  "page": {"type": "integer", "format": "int32", "minimum": 0},
                  "pageSize": {"type": "integer", "format": "int32", "minimum": 1},
                  "sortBy": {"type": "string", "required": false},
                  "sortOrder": {"type": "string", "required": false}
                }
              },
              "resourceList": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "identifier": {"type": "string", "format": "uuid"}
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

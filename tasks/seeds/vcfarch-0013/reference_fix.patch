@@ -0,0 +1,44 @@
+"""Command-line entry point for architecture generation."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+from typing import Any
+
+from .design import build_greenfield
+from .migration import build_migration_plan
+
+
+def _read_json(path: Path) -> dict[str, Any]:
+    with path.open("r", encoding="utf-8") as handle:
+        value = json.load(handle)
+    if not isinstance(value, dict):
+        raise ValueError(f"{path} must contain a JSON object")
+    return value
+
+
+def _write_json(path: Path, value: dict[str, Any]) -> None:
+    path.write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="Build pinned VCF architecture artifacts")
+    parser.add_argument("--requirements", required=True, type=Path)
+    parser.add_argument("--inventory", required=True, type=Path)
+    parser.add_argument("--snapshot", required=True, type=Path)
+    parser.add_argument("--output-dir", required=True, type=Path)
+    args = parser.parse_args(argv)
+
+    requirements = _read_json(args.requirements)
+    inventory = _read_json(args.inventory)
+    snapshot = _read_json(args.snapshot)
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    _write_json(args.output_dir / "greenfield-sddc.json", build_greenfield(requirements, snapshot))
+    _write_json(args.output_dir / "migration-plan.json", build_migration_plan(inventory, snapshot))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

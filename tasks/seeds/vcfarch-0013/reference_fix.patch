@@ -0,0 +1,132 @@
+"""Greenfield SddcSpec construction."""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+def _network_spec(network: dict[str, Any]) -> dict[str, Any]:
+    return {
+        "networkType": network["type"],
+        "subnet": network["subnet"],
+        "gateway": network["gateway"],
+        "includeIpAddressRanges": [
+            {
+                "startIpAddress": network["start_ip"],
+                "endIpAddress": network["end_ip"],
+            }
+        ],
+        "vlanId": network["vlan_id"],
+        "mtu": network["mtu"],
+        "ipAddressVersion": "IPv4",
+        "ipAddressAssignmentMode": "STATIC",
+    }
+
+
+def _switch_spec(switch: dict[str, Any]) -> dict[str, Any]:
+    return {
+        "dvsName": switch["name"],
+        "networks": list(switch["networks"]),
+        "mtu": switch["mtu"],
+        "vmnicsToUplinks": [
+            {"id": vmnic, "uplink": uplink}
+            for vmnic, uplink in switch["uplinks"].items()
+        ],
+    }
+
+
+def build_greenfield(
+    requirements: dict[str, Any], snapshot: dict[str, Any]
+) -> dict[str, Any]:
+    """Translate the CHI-02 requirements into an installer SddcSpec."""
+    workload = requirements["workload_domain"]
+    fleet = requirements["existing_fleet"]
+    profile = workload["host_profile"]
+    availability = workload["availability"]
+    storage = workload["storage"]
+    demand = workload["demand"]
+    bom = snapshot["greenfield_bom"]
+
+    host_count = workload["host_count"]
+    surviving_hosts = host_count - availability["host_failures_to_tolerate"]
+    installed = {
+        "hosts": host_count,
+        "cpuCores": host_count * profile["cpu_cores"],
+        "memoryGiB": host_count * profile["memory_gib"],
+        "rawStorageTiB": host_count * profile["raw_storage_tib"],
+    }
+    after_failure = {
+        "hosts": surviving_hosts,
+        "cpuCores": surviving_hosts * profile["cpu_cores"],
+        "memoryGiB": surviving_hosts * profile["memory_gib"],
+        "rawStorageTiB": surviving_hosts * profile["raw_storage_tib"],
+    }
+    required_raw = demand["usable_storage_tib"] * storage["protection_overhead_ratio"]
+
+    return {
+        "sddcId": workload["sddc_id"],

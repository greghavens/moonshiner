+"""Brownfield workload-domain migration planning."""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+def build_migration_plan(
+    inventory: dict[str, Any], snapshot: dict[str, Any]
+) -> dict[str, Any]:
+    """Build the snapshot-authorized, component-complete ordered plan."""
+    components = {item["id"]: item for item in inventory["components"]}
+    steps = []
+    for order, component_id in enumerate(snapshot["ordered_component_ids"], 1):
+        component = components[component_id]
+        authority = snapshot["component_plan"][component_id]
+        steps.append(
+            {
+                "order": order,
+                "component_id": component_id,
+                "component_name": component["name"],
+                "component_type": component["type"],
+                "scope": component["scope"],
+                "source_version": component["version"],
+                "target_version": authority["target"],
+                "action": authority["action"],
+                "gates": list(authority["gates"]),
+            }
+        )
+
+    return {
+        "schema_version": "1.0",
+        "plan_id": f"{inventory['estate_id']}-to-{inventory['target_workload_domain_id']}",
+        "estate_id": inventory["estate_id"],
+        "target": {
+            "fleet_id": inventory["target_fleet_id"],
+            "workload_domain_id": inventory["target_workload_domain_id"],
+            "vcf_version": inventory["target_vcf_version"],
+        },
+        "management_domain": {"mode": "UNCHANGED", "changes": []},
+        "steps": steps,
+        "outcome": {
+            "state": "VI_WORKLOAD_DOMAIN_ADDED",
+            "fleet_id": inventory["target_fleet_id"],
+            "workload_domain_id": inventory["target_workload_domain_id"],
+            "management_domain_changes": [],
+        },
+    }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/schemas/vcf-migration-plan-1.0.json",
  "title": "VCF 9.1 workload-domain migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "estate_id",
    "target",
    "management_domain",
    "steps",
    "outcome"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "minLength": 1},
    "estate_id": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fleet_id", "workload_domain_id", "vcf_version"],
      "properties": {
        "fleet_id": {"type": "string", "minLength": 1},
        "workload_domain_id": {"type": "string", "minLength": 1},
        "vcf_version": {"type": "string", "minLength": 1}
      }
    },
    "management_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "changes"],
      "properties": {
        "mode": {"const": "UNCHANGED"},
        "changes": {"type": "array", "maxItems": 0}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "component_id",
          "component_name",
          "component_type",
          "scope",
          "source_version",
          "target_version",
          "action",
          "gates"
        ],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "component_id": {"type": "string", "minLength": 1},
          "component_name": {"type": "string", "minLength": 1},
          "component_type": {"type": "string", "minLength": 1},
          "scope": {"enum": ["MANAGEMENT_DOMAIN", "CANDIDATE_WORKLOAD_DOMAIN"]},
          "source_version": {"type": "string", "minLength": 1},
          "target_version": {"type": "string", "minLength": 1},
          "action": {"enum": ["PRESERVE", "UPGRADE", "IMPORT"]},
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "fleet_id", "workload_domain_id", "management_domain_changes"],
      "properties": {
        "state": {"const": "VI_WORKLOAD_DOMAIN_ADDED"},
        "fleet_id": {"type": "string", "minLength": 1},
        "workload_domain_id": {"type": "string", "minLength": 1},
        "management_domain_changes": {"type": "array", "maxItems": 0}
      }
    }
  }
}

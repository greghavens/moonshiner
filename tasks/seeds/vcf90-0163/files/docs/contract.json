{
  "contract_version": 1,
  "product": "VMware Cloud Foundation 9.0",
  "service": "VCF Automation",
  "provenance": {
    "source_kind": "reference_documentation",
    "statement": "This contract is derived from Broadcom's authoritative xAPIs reference documentation, not from a published API specification. VCF Automation is not specified in the Apache-2.0 vmware/vcf-api-specs repository.",
    "source_index": "docs/official_sources.json"
  },
  "operations": [
    {
      "operation": "Check Deployment Name Exists",
      "method": "GET",
      "path": "/deployment/api/deployments/names",
      "authentication": {
        "scheme": "bearer",
        "header": "Authorization"
      },
      "request": {
        "accept": "application/json",
        "content_type": "omit",
        "body": "none",
        "query": [
          {
            "name": "name",
            "type": "string",
            "required": true,
            "encoding": "one URL-encoded query value"
          }
        ]
      },
      "responses": [
        {
          "status": 200,
          "meaning": "a deployment with the supplied name exists",
          "body": "none"
        },
        {
          "status": 404,
          "meaning": "no deployment with the supplied name exists",
          "body": "none"
        }
      ],
      "workflow_role": "precheck; only the documented 404 absence result permits the Patch Deployment operation"
    },
    {
      "operation": "Patch Deployment",
      "method": "PATCH",
      "path": "/deployment/api/deployments/{deploymentId}",
      "path_parameters": [
        {
          "name": "deploymentId",
          "type": "string",
          "required": true
        }
      ],
      "authentication": {
        "scheme": "bearer",
        "header": "Authorization"
      },
      "request": {
        "accept": "application/json",
        "content_type": "application/json",
        "body": {
          "schema": "DeploymentUpdate",
          "required": true,
          "fields": [
            {
              "name": "name",
              "type": "string",
              "required_by_workflow": true,
              "minimum_length": 1,
              "maximum_length": 900
            },
            {
              "name": "description",
              "type": "string",
              "required": false,
              "maximum_length": 2000,
              "unset": "omit"
            },
            {
              "name": "iconId",
              "type": "string",
              "format": "uuid",
              "required": false,
              "unset": "omit"
            }
          ]
        }
      },
      "response": {
        "success_status": 200,
        "media_type": "application/json",
        "schema": "Deployment",
        "fields_used": {
          "id": "string(uuid)",
          "name": "string",
          "description": "string",
          "iconId": "string(uuid)",
          "status": "string"
        }
      }
    }
  ],
  "workflow": {
    "name": "Rename Deployment",
    "sequence": [
      "Check Deployment Name Exists",
      "Patch Deployment"
    ],
    "gate": "Patch Deployment is issued only when Check Deployment Name Exists returns 404. Every other precheck result leaves the deployment unchanged."
  }
}

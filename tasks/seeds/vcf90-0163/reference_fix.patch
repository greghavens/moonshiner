@@ -0,0 +1,97 @@
+package vcfautomation_test
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"testing"
+
+	"example.com/vcfautomationtask/internal/contractmock"
+	"example.com/vcfautomationtask/vcfautomation"
+)
+
+func TestRenameDeployment(t *testing.T) {
+	t.Parallel()
+
+	description := "production edge"
+	tests := []struct {
+		name     string
+		newName  string
+		options  vcfautomation.UpdateOptions
+		wantBody string
+	}{
+		{
+			name:     "omits unset update fields",
+			newName:  "edge west",
+			wantBody: `{"name":"edge west"}`,
+		},
+		{
+			name:    "includes set update fields",
+			newName: "edge-green",
+			options: vcfautomation.UpdateOptions{
+				Description: &description,
+			},
+			wantBody: `{"name":"edge-green","description":"production edge"}`,
+		},
+	}
+
+	for _, test := range tests {
+		test := test
+		t.Run(test.name, func(t *testing.T) {
+			t.Parallel()
+			mock := contractmock.New(contractmock.Config{
+				PatchResponse: contractmock.Deployment{ID: "dep-1", Name: test.newName},
+			})
+			defer mock.Close()
+			client, err := vcfautomation.NewClient(mock.URL(), "test-token", mock.Client())
+			if err != nil {
+				t.Fatal(err)
+			}
+			got, err := client.RenameDeployment(context.Background(), "dep-1", test.newName, test.options)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got.ID != "dep-1" || got.Name != test.newName {
+				t.Fatalf("deployment = %+v", got)
+			}
+			requests := mock.Requests()
+			if len(requests) != 2 || string(requests[1].Body) != test.wantBody {
+				t.Fatalf("requests = %+v, want PATCH body %s", requests, test.wantBody)
+			}
+		})
+	}
+}
+
+func TestRenameDeploymentPrecheckGate(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name         string
+		status       int
+		wantConflict bool
+	}{
+		{name: "existing name", status: http.StatusOK, wantConflict: true},
+		{name: "failed check", status: http.StatusServiceUnavailable},
+	}
+
+	for _, test := range tests {
+		test := test
+		t.Run(test.name, func(t *testing.T) {
+			t.Parallel()
+			mock := contractmock.New(contractmock.Config{CheckStatus: test.status})
+			defer mock.Close()
+			client, err := vcfautomation.NewClient(mock.URL(), "test-token", mock.Client())
+			if err != nil {
+				t.Fatal(err)
+			}
+			_, err = client.RenameDeployment(context.Background(), "dep-1", "occupied", vcfautomation.UpdateOptions{})
+			if err == nil || errors.Is(err, vcfautomation.ErrNameConflict) != test.wantConflict {
+				t.Fatalf("error = %v, want conflict %v", err, test.wantConflict)
+			}
+			requests := mock.Requests()
+			if len(requests) != 1 || requests[0].Method != http.MethodGet {
+				t.Fatalf("failed precheck issued mutation: %+v", requests)
+			}
+		})
+	}
+}

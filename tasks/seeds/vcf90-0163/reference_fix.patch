@@ -3,15 +3,21 @@
 package vcfautomation
 
 import (
+	"bytes"
 	"context"
+	"encoding/json"
 	"errors"
 	"fmt"
+	"io"
 	"net/http"
 	"net/url"
+	"strings"
 )
 
-// ErrNotImplemented marks the exercise's unfinished rename workflow.
-var ErrNotImplemented = errors.New("RenameDeployment is not implemented")
+const (
+	namesPath       = "/deployment/api/deployments/names"
+	deploymentsPath = "/deployment/api/deployments"
+)
 
 // ErrNameConflict reports that the requested deployment name already exists.
 var ErrNameConflict = errors.New("deployment name already exists")
@@ -58,5 +64,93 @@
 // RenameDeployment checks name availability and, only when available, updates
 // the deployment.
 func (c *Client) RenameDeployment(ctx context.Context, deploymentID, newName string, opts UpdateOptions) (Deployment, error) {
-	return Deployment{}, ErrNotImplemented
+	precheckURL := *c.baseURL
+	precheckURL.Path = namesPath
+	precheckURL.RawPath = ""
+	query := make(url.Values)
+	query.Set("name", newName)
+	precheckURL.RawQuery = query.Encode()
+
+	precheck, err := http.NewRequestWithContext(ctx, http.MethodGet, precheckURL.String(), nil)
+	if err != nil {
+		return Deployment{}, fmt.Errorf("create deployment name precheck: %w", err)
+	}
+	precheck.Header.Set("Authorization", "Bearer "+c.token)
+	precheck.Header.Set("Accept", "application/json")
+
+	precheckResponse, err := c.http.Do(precheck)
+	if err != nil {
+		return Deployment{}, fmt.Errorf("check deployment name: %w", err)
+	}
+	precheckBody, _ := io.ReadAll(io.LimitReader(precheckResponse.Body, 4096))
+	closeErr := precheckResponse.Body.Close()
+	if closeErr != nil {
+		return Deployment{}, fmt.Errorf("close deployment name precheck response: %w", closeErr)
+	}
+	switch precheckResponse.StatusCode {
+	case http.StatusNotFound:
+		// The reference defines 404 as no deployment with this name.
+	case http.StatusOK:
+		return Deployment{}, fmt.Errorf("%w: %q", ErrNameConflict, newName)
+	default:
+		return Deployment{}, fmt.Errorf("check deployment name: HTTP %d: %s", precheckResponse.StatusCode, strings.TrimSpace(string(precheckBody)))
+	}
+
+	update := struct {
+		Name        string  `json:"name"`
+		Description *string `json:"description,omitempty"`
+		IconID      *string `json:"iconId,omitempty"`
+	}{
+		Name:        newName,
+		Description: opts.Description,
+		IconID:      opts.IconID,
+	}
+	body, err := json.Marshal(update)
+	if err != nil {
+		return Deployment{}, fmt.Errorf("encode deployment update: %w", err)
+	}
+
+	patchURL := *c.baseURL
+	patchURL.Path = deploymentsPath + "/" + deploymentID
+	patchURL.RawPath = ""
+	patchURL.RawQuery = ""
+	request, err := http.NewRequestWithContext(ctx, http.MethodPatch, patchURL.String(), bytes.NewReader(body))
+	if err != nil {
+		return Deployment{}, fmt.Errorf("create Patch Deployment request: %w", err)
+	}
+	request.Header.Set("Authorization", "Bearer "+c.token)
+	request.Header.Set("Accept", "application/json")
+	request.Header.Set("Content-Type", "application/json")
+
+	response, err := c.http.Do(request)
+	if err != nil {
+		return Deployment{}, fmt.Errorf("patch deployment: %w", err)
+	}
+	if response.StatusCode < http.StatusOK || response.StatusCode >= http.StatusMultipleChoices {
+		responseBody, _ := io.ReadAll(io.LimitReader(response.Body, 4096))
+		_ = response.Body.Close()
+		return Deployment{}, fmt.Errorf("patch deployment: HTTP %d: %s", response.StatusCode, strings.TrimSpace(string(responseBody)))
+	}
+
+	var deployment Deployment
+	decoder := json.NewDecoder(response.Body)
+	decodeErr := decoder.Decode(&deployment)
+	if decodeErr == nil {
+		var extra json.RawMessage
+		switch err := decoder.Decode(&extra); err {
+		case io.EOF:
+		case nil:
+			decodeErr = errors.New("multiple JSON values in Patch Deployment response")
+		default:
+			decodeErr = err
+		}
+	}
+	closeErr = response.Body.Close()
+	if decodeErr != nil {
+		return Deployment{}, fmt.Errorf("decode patched deployment: %w", decodeErr)
+	}
+	if closeErr != nil {
+		return Deployment{}, fmt.Errorf("close Patch Deployment response: %w", closeErr)
+	}
+	return deployment, nil
 }

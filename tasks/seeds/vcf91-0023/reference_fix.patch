+                    )
+            elif page_number >= total_pages:
+                self._protocol_error(
+                    "returned page number is outside totalPages"
+                )
+            if (
+                total_pages > 0
+                and page_number + 1 < total_pages
+                and len(elements) != page_size
+            ):

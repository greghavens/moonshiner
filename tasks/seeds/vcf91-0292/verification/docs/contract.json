  "schemas": {
    "UserCredential": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "example": "admin@vrni.com"
        },
        "password": {
          "type": "string",
          "example": "password"
        },
        "domain": {
          "$ref": "#/components/schemas/Domain"
        }
      }
    },
    "Domain": {
      "type": "object",
      "properties": {
        "domain_type": {
          "type": "string",
          "description": "domain type, should be in uppercase",
          "example": "LDAP",
          "nullable": true,
          "enum": [
            "LDAP",
            "LOCAL"
          ]
        },
        "value": {
          "type": "string",
          "description": "domain value, not required for LOCAL domain",
          "example": "example.com"
        }
      }
    },
    "Token": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "example": "Mgs2YX0ZSY+gHW6RYypeeA=="
        },
        "expiry": {
          "type": "integer",
          "description": "expiry epoch time in secs.",
          "format": "int64",
          "example": 1605201960327
        }
      }
    },
    "ApplicationRequest": {
      "required": [
        "name"
      ],
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the application",
          "example": "My-3Tier-App"
        }
      }
    },
    "PagedApplicationListResponse": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "description": "Array of returned applications",
          "items": {
            "$ref": "#/components/schemas/Application"
          }
        },
        "cursor": {
          "type": "string",
          "description": "Cursor for the next page",
          "example": "MTA="
        },
        "total_count": {
          "type": "integer",
          "description": "Total number of objects in the system, despite the page limit",
          "example": 1102
        }
      }
    },
    "Application": {
      "allOf": [
        {
          "$ref": "#/components/schemas/BaseEntity"
        },
        {
          "type": "object",
          "properties": {
            "create_time": {
              "type": "integer",
              "description": "Timestamp of when the object was created",
              "format": "int64",
              "example": 159724400600
            },
            "created_by": {
              "type": "string",
              "description": "The username of who created the object",
              "example": "admin@local"
            },
            "last_modified_time": {
              "type": "integer",
              "description": "Timestamp of when the object was last modified",
              "format": "int64",
              "example": 159724400600
            },
            "last_modified_by": {
              "type": "string",
              "description": "The username of who last modified the object",
              "example": "someone@else.com"
            },
            "last_modified_by_service": {
              "type": "string",
              "description": "The service which last modified the application.",
              "example": "Ensemble"
            },
            "tier_count": {
              "type": "integer",
              "description": "The count of all the tiers of the application.",
              "format": "int32",
              "example": 25
            },
            "member_count": {
              "type": "integer",
              "description": "The count of all the members of the application.",
              "format": "int32",
              "example": 500
            },
            "update_status": {
              "$ref": "#/components/schemas/UpdateStatus"
            },
            "confidence": {
              "type": "string",
              "description": "The confidence of discovery of this application, if applicable.",
              "example": "Medium"
            }
          }
        }
      ]
    },
    "BaseEntity": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "description": "Entity ID that can be references in detail API calls",
          "example": "1000:104:12213212"
        },
        "name": {
          "type": "string",
          "description": "Name of the object",
          "example": "My Name"
        },
        "entity_type": {
          "$ref": "#/components/schemas/EntityType"
        }
      },
      "discriminator": {
        "propertyName": "entity_type"
      }
    },
    "EntityTypeApplicationMember": {
      "projectionNote": "The EntityType enum in the pinned specification carries 120 members; only the value this contract exercises is projected here.",
      "type": "string",
      "value": "Application",
      "specJsonPointer": "/components/schemas/EntityType"
    },
    "UpdateStatus": {
      "type": "string",
      "nullable": true,
      "enum": [
        "ADDED",
        "DELETED",
        "UPDATED",
        "NO_CHANGE"
      ]
    },
    "ApiError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      }
    },
    "ErrorDetail": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "target": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

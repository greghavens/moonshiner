      "specJsonPointer": "/paths/~1groups~1applications/post",
      "specLine": 15338,
      "tag": "Applications",
      "summary": "Create an application",
      "description": "Application is a group of tiers. A tier is a group of virtual machines or IP addresses based on membership criteria. Tiers are bound to a single application. An application name is unique and should not conflict with another application name.",

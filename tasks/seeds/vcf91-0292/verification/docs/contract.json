    {
      "operationId": "getSavedApplicationsSummaries",
      "method": "GET",
      "path": "/groups/applications/fetch",
      "fullPath": "/api/ni/groups/applications/fetch",
      "specJsonPointer": "/paths/~1groups~1applications~1fetch/get",
      "specLine": 15969,
      "tag": "Applications",
      "summary": "Get saved application summaries in bulk",
      "description": "Get the summaries of saved applications in bulk, by providing a list of entity IDs.",
      "parameters": [
        {
          "name": "size",
          "in": "query",
          "required": false,
          "description": "Page size of results",
          "schema": {
            "type": "number",
            "default": 10
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "description": "Cursor from previous response",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "modifiedAfter",
          "in": "query",

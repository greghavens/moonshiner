  "securityScheme": {
    "name": "ApiKeyAuth",
    "type": "apiKey",
    "in": "header",
    "headerName": "Authorization",
    "specDescription": "API Key - NetworkInsight {token}",
    "headerValueFormat": "NetworkInsight {token}",
    "specJsonPointer": "/components/securitySchemes/ApiKeyAuth"
  },
  "retrySafety": {
    "idempotencyMechanism": "read-before-write",
    "note": "The pinned specification declares no idempotency key, no conditional-request header and no conflict-scoped status for addApplication. The only retry-safe construction available is to enumerate the saved applications first and to re-enumerate after any failed create attempt. Application names are unique per the addApplication description, so a duplicate name is rejected with the operation's declared 400 response.",
    "specEvidence": "/paths/~1groups~1applications/post/description"
  },
  "operationIds": [
    "create",
    "delete",
    "getSavedApplicationsSummaries",
    "addApplication"
  ],

+class VcfOpsLogCredentialLease : System.IDisposable {
+    [string] $SecretName
+    [string] $Secret
+    [string] $AccessToken
+
+    hidden [object] $Gate
+    hidden [long] $Generation
+    hidden [object] $DisposeRoot
+    hidden [bool] $Disposed
+
+    VcfOpsLogCredentialLease(
+        [object] $Gate,
+        [long] $Generation,
+        [string] $SecretName,
+        [string] $Secret,
+        [string] $AccessToken
+    ) {
+        $this.Gate = $Gate
+        $this.Generation = $Generation
+        $this.SecretName = $SecretName
+        $this.Secret = $Secret
+        $this.AccessToken = $AccessToken
+        $this.DisposeRoot = [object]::new()
+        $this.Disposed = $false
+    }
+
+    [void] Dispose() {
+        $Release = $false
+        [Threading.Monitor]::Enter($this.DisposeRoot)
+        try {
+            if (-not $this.Disposed) {
+                $this.Disposed = $true
+                $Release = $true
+            }
+        }
+        finally {
+            [Threading.Monitor]::Exit($this.DisposeRoot)
+        }
+
+        if ($Release) {
+            $this.Gate.Release($this.Generation)
+        }
+    }
+}

+function Invoke-VcfOpsLogRequest {
+    param(
+        [Parameter(Mandatory)]
+        [Net.Http.HttpClient] $Client,
+
+        [Parameter(Mandatory)]
+        [Net.Http.HttpMethod] $Method,
+
+        [Parameter(Mandatory)]
+        [uri] $Uri,
+
+        [Parameter(Mandatory)]
+        [string] $LogToken,
+
+        [Parameter(Mandatory)]
+        [int] $ExpectedStatus,
+
+        [AllowNull()]
+        [object] $JsonBody,
+
+        [Parameter(Mandatory)]
+        [string] $Context
+    )
+
+    $Request = [Net.Http.HttpRequestMessage]::new($Method, $Uri)
+    $Response = $null
+    try {
+        $Request.Headers.Accept.Add(
+            [Net.Http.Headers.MediaTypeWithQualityHeaderValue]::new(
+                'application/json'
+            )
+        )
+        if (
+            -not $Request.Headers.TryAddWithoutValidation(
+                'X-JWT-Token',
+                $LogToken
+            )
+        ) {
+            throw [InvalidOperationException]::new(
+                'Could not configure log authentication.'
+            )
+        }
+        if ($null -ne $JsonBody) {
+            $Bytes = [Text.Encoding]::UTF8.GetBytes([string] $JsonBody)
+            $Request.Content = [Net.Http.ByteArrayContent]::new($Bytes)
+            $Request.Content.Headers.ContentType = (
+                [Net.Http.Headers.MediaTypeHeaderValue]::new(
+                    'application/json'
+                )
+            )
+        }
+
+        try {
+            $Response = $Client.Send($Request)
+            if ([int] $Response.StatusCode -ne $ExpectedStatus) {
+                throw [System.IO.IOException]::new(
+                    'Unexpected response status.'
+                )
+            }
+            return (
+                $Response.Content.ReadAsStringAsync().GetAwaiter().GetResult()
+            )
+        }
+        catch {
+            throw [System.IO.IOException]::new(
+                "The $Context log-management request failed."
+            )
+        }
+    }
+    finally {
+        if ($null -ne $Response) {
+            $Response.Dispose()
+        }
+        $Request.Dispose()
+    }
+}

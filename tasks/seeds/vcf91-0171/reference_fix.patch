+class VcfOpsLogCredentialGate {
+    hidden [object] $SyncRoot
+    hidden [Collections.Generic.Dictionary[long, int]] $LeaseCounts
+    hidden [long] $Generation
+    hidden [string] $CurrentName
+    hidden [string] $CurrentSecret
+    hidden [string] $CurrentAccessToken
+    hidden [bool] $RotationOwned
+
+    VcfOpsLogCredentialGate(
+        [string] $SecretName,
+        [string] $Secret,
+        [string] $AccessToken
+    ) {
+        $this.SyncRoot = [object]::new()
+        $this.LeaseCounts = (
+            [Collections.Generic.Dictionary[long, int]]::new()
+        )
+        $this.Generation = 0
+        $this.CurrentName = $SecretName
+        $this.CurrentSecret = $Secret
+        $this.CurrentAccessToken = $AccessToken
+        $this.RotationOwned = $false
+    }
+
+    [object] Acquire() {
+        $Lease = $null
+        [Threading.Monitor]::Enter($this.SyncRoot)
+        try {
+            $CurrentCount = 0
+            $null = $this.LeaseCounts.TryGetValue(
+                $this.Generation,
+                [ref] $CurrentCount
+            )
+            $this.LeaseCounts[$this.Generation] = $CurrentCount + 1
+            $Lease = [VcfOpsLogCredentialLease]::new(
+                $this,
+                $this.Generation,
+                $this.CurrentName,
+                $this.CurrentSecret,
+                $this.CurrentAccessToken
+            )
+        }
+        finally {
+            [Threading.Monitor]::Exit($this.SyncRoot)
+        }
+        return $Lease
+    }
+
+    hidden [void] Release([long] $ReleasedGeneration) {
+        [Threading.Monitor]::Enter($this.SyncRoot)
+        try {
+            $CurrentCount = 0
+            if (
+                -not $this.LeaseCounts.TryGetValue(
+                    $ReleasedGeneration,
+                    [ref] $CurrentCount
+                ) -or
+                $CurrentCount -lt 1
+            ) {
+                throw [InvalidOperationException]::new(
+                    'Credential lease accounting is inconsistent.'
+                )
+            }
+            if ($CurrentCount -eq 1) {
+                $null = $this.LeaseCounts.Remove($ReleasedGeneration)
+            }
+            else {
+                $this.LeaseCounts[$ReleasedGeneration] = $CurrentCount - 1
+            }
+        }
+        finally {
+            [Threading.Monitor]::Exit($this.SyncRoot)
+        }
+    }
+
+    [hashtable] BeginRotation() {
+        $Snapshot = $null
+        [Threading.Monitor]::Enter($this.SyncRoot)
+        try {
+            if ($this.RotationOwned) {
+                throw [InvalidOperationException]::new(
+                    'A credential rotation already owns this gate.'
+                )
+            }
+            $this.RotationOwned = $true
+            $Snapshot = @{
+                Generation = $this.Generation
+                Name = $this.CurrentName
+            }
+        }
+        finally {
+            [Threading.Monitor]::Exit($this.SyncRoot)
+        }
+        return $Snapshot
+    }
+
+    [long] Publish(
+        [string] $SecretName,
+        [string] $Secret,
+        [string] $AccessToken
+    ) {
+        $OldGeneration = 0
+        [Threading.Monitor]::Enter($this.SyncRoot)
+        try {
+            if (-not $this.RotationOwned) {
+                throw [InvalidOperationException]::new(
+                    'The gate is not owned for credential rotation.'
+                )
+            }
+            $OldGeneration = $this.Generation
+            $this.Generation++
+            $this.CurrentName = $SecretName
+            $this.CurrentSecret = $Secret
+            $this.CurrentAccessToken = $AccessToken
+        }
+        finally {
+            [Threading.Monitor]::Exit($this.SyncRoot)
+        }
+        return $OldGeneration
+    }
+
+    [int] GetActiveCount([long] $RequestedGeneration) {
+        $Count = 0
+        [Threading.Monitor]::Enter($this.SyncRoot)
+        try {
+            $null = $this.LeaseCounts.TryGetValue(
+                $RequestedGeneration,
+                [ref] $Count
+            )
+        }
+        finally {
+            [Threading.Monitor]::Exit($this.SyncRoot)
+        }
+        return $Count
+    }
+
+    [void] EndRotation() {
+        [Threading.Monitor]::Enter($this.SyncRoot)
+        try {
+            $this.RotationOwned = $false
+        }
+        finally {
+            [Threading.Monitor]::Exit($this.SyncRoot)
+        }
+    }
+}

+class VcfOpsLogDrainTimeoutException : System.TimeoutException {
+    [string] $OldName
+    [string] $NewName
+    [int] $DrainCheckCount
+
+    VcfOpsLogDrainTimeoutException(
+        [string] $OldName,
+        [string] $NewName,
+        [int] $DrainCheckCount
+    ) : base('Credential rotation timed out while draining the old generation.') {
+        $this.OldName = $OldName
+        $this.NewName = $NewName
+        $this.DrainCheckCount = $DrainCheckCount
+    }
+}

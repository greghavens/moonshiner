{
  "contract_version": 1,
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "spec_path": "specifications/vcf-operations/vcf-operations-for-networks-openapi.yaml",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "api_version": "9.1.0.0"
  },
  "server": {
    "base_path": "/api/ni"
  },
  "security": {
    "scheme": "ApiKeyAuth",
    "type": "apiKey",
    "in": "header",
    "name": "Authorization",
    "value_format": "NetworkInsight {token}"
  },
  "operations": [
    {
      "operationId": "addApplication",
      "method": "POST",
      "path": "/api/ni/groups/applications",
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "ApplicationRequest",
        "required_properties": [
          "name"
        ],
        "properties": {
          "name": "string"
        }
      },
      "success": {
        "status": 201,
        "schema": "Application",
        "properties": {
          "entity_id": "string",
          "name": "string",
          "entity_type": "string"
        }
      },
      "errors": [
        400,
        401,
        500
      ]
    },
    {
      "operationId": "addTier",
      "method": "POST",
      "path": "/api/ni/groups/applications/{id}/tiers",
      "path_parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "string"
        }
      ],
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "TierRequest",
        "required_properties": [],
        "optional_properties": [
          "name",
          "entity_id",
          "group_membership_criteria",
          "member_list",
          "source_group_entity_id"
        ],
        "properties": {
          "name": "string",
          "entity_id": "string",
          "group_membership_criteria": "array<GroupMembershipCriteria>",
          "member_list": "MemberList",
          "source_group_entity_id": "array<string>"
        },
        "omit_when_unset": [
          "name",
          "entity_id",
          "group_membership_criteria",
          "member_list",
          "source_group_entity_id"
        ]
      },
      "success": {
        "status": 201,
        "schema": "Tier",
        "properties": {
          "entity_id": "string",
          "name": "string",
          "entity_type": "string"
        }
      },
      "errors": [
        400,
        401,
        403,
        404,
        500
      ]
    },
    {
      "operationId": "listApplicationTiers",
      "method": "GET",
      "path": "/api/ni/groups/applications/{id}/tiers",
      "path_parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "string"
        }
      ],
      "success": {
        "status": 200,
        "schema": "TierListResponse",
        "properties": {
          "results": "array<Tier>"
        }
      },
      "errors": [
        401,
        404,
        500
      ]
    }
  ],
  "schemas": {
    "ApplicationRequest": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "TierRequest": {
      "type": "object",
      "required": [],
      "properties": {
        "name": {
          "type": "string"
        },
        "entity_id": {
          "type": "string"
        },
        "group_membership_criteria": {
          "type": "array",
          "items": "GroupMembershipCriteria"
        },
        "member_list": {
          "type": "MemberList"
        },
        "source_group_entity_id": {
          "type": "array",
          "items": "string"
        }
      }
    },
    "GroupMembershipCriteria": {
      "type": "object",
      "required": [],
      "properties": {
        "membership_type": {
          "type": "string",
          "enum": [
            "SearchMembershipCriteria",
            "IPAddressMembershipCriteria"
          ]
        },
        "search_membership_criteria": {
          "type": "SearchMembershipCriteria"
        },
        "ip_address_membership_criteria": {
          "type": "IpAddressMembershipCriteria"
        }
      },
      "omit_when_unset": [
        "search_membership_criteria",
        "ip_address_membership_criteria"
      ]
    },
    "SearchMembershipCriteria": {
      "type": "object",
      "required": [],
      "properties": {
        "entity_type": {
          "type": "string"
        },
        "filter": {
          "type": "string"
        }
      }
    },
    "IpAddressMembershipCriteria": {
      "type": "object",
      "required": [],
      "properties": {
        "ip_addresses": {
          "type": "array",
          "items": "string"
        }
      }
    },
    "MemberList": {
      "type": "object",
      "required": [],
      "properties": {
        "vms": {
          "type": "array",
          "items": "MemberEntity"
        },
        "physical_ips": {
          "type": "array",
          "items": "MemberEntity"
        },
        "kubernetes_services": {
          "type": "array",
          "items": "MemberEntity"
        }
      }
    },
    "ApiError": {
      "type": "object",
      "required": [],
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": "ErrorDetail"
        }
      }
    }
  }
}

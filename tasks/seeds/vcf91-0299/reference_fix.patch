+		switch {
+		case err != nil:
+			step.Status = StatusFailed
+			failure = fmt.Errorf("addTier %q: %w", tier.Name, err)
+		case apiErr != nil:
+			step.Status = StatusFailed
+			step.StatusCode = apiErr.status
+			step.Message = apiErr.Message
+			failure = fmt.Errorf("addTier %q: %w", tier.Name, apiErr)
+		default:
+			step.Status = StatusApplied
+			step.EntityID = created.EntityID
+			step.StatusCode = http.StatusCreated
+			continue
+		}
+		break // stop at the first failure; later steps stay not_attempted
+	}

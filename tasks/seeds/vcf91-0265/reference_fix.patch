diff --git a/src/vcfops_rotate/contract.py b/src/vcfops_rotate/contract.py
new file mode 100644
index 0000000..fe16723
--- /dev/null
+++ b/src/vcfops_rotate/contract.py
@@ -0,0 +1,151 @@
+"""Read ``docs/contract.json`` and answer questions about it.
+
+The contract is derived from ``specifications/vcf-operations/vcf-operations-openapi.json``
+in ``vmware/vcf-api-specs`` (see ``docs/official_sources.json`` for the pinned
+revision). Both the client and the loopback mock drive off this one file, so
+neither can drift from the specification independently of the other.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from dataclasses import dataclass, field
+from pathlib import Path
+
+from .errors import VcfOpsContractError
+
+__all__ = ["Contract", "Operation", "QueryParam", "RequestBody", "default_contract_path"]
+
+_PLACEHOLDER = re.compile(r"\{([^{}]+)\}")
+
+
+def default_contract_path() -> Path:
+    """``docs/contract.json`` as shipped in this repository."""
+    return Path(__file__).resolve().parents[2] / "docs" / "contract.json"
+
+
+@dataclass(frozen=True)
+class QueryParam:
+    name: str
+    required: bool
+    type: str
+    style: str
+    explode: bool
+
+
+@dataclass(frozen=True)
+class RequestBody:
+    content_type: str
+    required_fields: tuple[str, ...]
+    optional_fields: tuple[str, ...]
+
+    @property
+    def all_fields(self) -> frozenset[str]:
+        return frozenset(self.required_fields) | frozenset(self.optional_fields)
+
+
+@dataclass(frozen=True)
+class Operation:
+    operation_id: str
+    method: str
+    path: str
+    path_params: tuple[str, ...]
+    query_params: tuple[QueryParam, ...]
+    request_body: RequestBody | None
+    requires_auth: bool
+    success_status: int
+    query_names: frozenset[str] = field(default_factory=frozenset)
+
+    def format_path(self, values: dict) -> str:
+        values = values or {}
+        missing = [p for p in self.path_params if values.get(p) in (None, "")]
+        if missing:
+            raise VcfOpsContractError(
+                f"{self.operation_id}: missing path parameter(s) {', '.join(missing)}"
+            )
+
+        def sub(match):
+            return str(values[match.group(1)])
+
+        return _PLACEHOLDER.sub(sub, self.path)
+
+
+class Contract:
+    """The subset of the VCF Operations API this tool is allowed to speak."""
+
+    def __init__(self, document: dict, source: Path | None = None):
+        self.source = source
+        self.document = document
+        self.title = document.get("spec", {}).get("title", "")
+        self.version = document.get("spec", {}).get("version", "")
+        self.base_path = document["base_path"]
+        auth = document.get("auth", {})
+        self.auth_header = auth["header"]
+        self.auth_value_template = auth["value_template"]
+
+        self.operations: dict[str, Operation] = {}
+        for op_id, raw in document["operations"].items():
+            body = raw.get("request_body")
+            query = tuple(
+                QueryParam(
+                    name=q["name"],
+                    required=bool(q["required"]),
+                    type=q["type"],
+                    style=q["style"],
+                    explode=bool(q["explode"]),
+                )
+                for q in raw.get("query_params", [])
+            )
+            self.operations[op_id] = Operation(
+                operation_id=op_id,
+                method=raw["method"].upper(),
+                path=raw["path"],
+                path_params=tuple(raw.get("path_params", [])),
+                query_params=query,
+                request_body=(
+                    None
+                    if body is None
+                    else RequestBody(
+                        content_type=body["content_type"],
+                        required_fields=tuple(body["required_fields"]),
+                        optional_fields=tuple(body["optional_fields"]),
+                    )
+                ),
+                requires_auth=bool(raw["requires_auth"]),
+                success_status=int(raw["success_status"]),
+                query_names=frozenset(q["name"] for q in raw.get("query_params", [])),
+            )
+
+    @classmethod
+    def load(cls, path=None) -> "Contract":
+        path = Path(path) if path is not None else default_contract_path()
+        try:
+            document = json.loads(path.read_text(encoding="utf-8"))
+        except FileNotFoundError:
+            raise VcfOpsContractError(f"contract not found at {path}") from None
+        except json.JSONDecodeError as exc:
+            raise VcfOpsContractError(f"contract at {path} is not valid JSON: {exc}") from None
+        return cls(document, source=path)
+
+    def operation(self, operation_id: str) -> Operation:
+        try:
+            return self.operations[operation_id]
+        except KeyError:
+            raise VcfOpsContractError(
+                f"{operation_id!r} is not one of the contracted operations "
+                f"({', '.join(sorted(self.operations))})"
+            ) from None
+
+    def authorization_value(self, token: str) -> str:
+        return self.auth_value_template.format(token=token)
+
+    def token_from_authorization(self, value: str | None) -> str | None:
+        """Inverse of :meth:`authorization_value`; ``None`` if it does not match."""
+        if not value:
+            return None
+        prefix, _, suffix = self.auth_value_template.partition("{token}")
+        if not value.startswith(prefix) or not value.endswith(suffix):
+            return None
+        token = value[len(prefix):len(value) - len(suffix) if suffix else None]
+        return token or None
diff --git a/src/vcfops_rotate/errors.py b/src/vcfops_rotate/errors.py
new file mode 100644
index 0000000..3d5716c
--- /dev/null
+++ b/src/vcfops_rotate/errors.py
@@ -0,0 +1,25 @@
+"""Exceptions raised by :mod:`vcfops_rotate`."""
+
+from __future__ import annotations
+
+__all__ = ["VcfOpsError", "VcfOpsContractError", "VcfOpsHttpError"]
+
+
+class VcfOpsError(Exception):
+    """Base class for every error this package raises."""
+
+
+class VcfOpsContractError(VcfOpsError):
+    """A request would not match ``docs/contract.json``."""
+
+
+class VcfOpsHttpError(VcfOpsError):
+    """The appliance answered with a non-2xx status."""
+
+    def __init__(self, status, method, url, body=""):
+        self.status = int(status)
+        self.method = method
+        self.url = url
+        self.body = body
+        detail = f" {body.strip()[:200]}" if body and body.strip() else ""
+        super().__init__(f"{method} {url} -> HTTP {self.status}{detail}")
diff --git a/src/vcfops_rotate/mock.py b/src/vcfops_rotate/mock.py
new file mode 100644
index 0000000..70f7d2f
--- /dev/null
+++ b/src/vcfops_rotate/mock.py
@@ -0,0 +1,383 @@
+"""A loopback stand-in for the VCF Operations ``/suite-api`` service.
+
+Everything it will answer comes from ``docs/contract.json``: the routing table,
+which operations need a token, and which body and query fields are legal. An
+operation the contract does not name is a 404 here even if the real appliance
+implements it, so a client that quietly starts calling something outside the
+contract fails loudly instead of passing.
+
+It also holds the knobs the tests need in order to reproduce a rotation racing
+against live traffic: :meth:`MockOperationsServer.hold` parks a request in the
+middle of its handler, and a parked request re-checks its token when it is let
+go — so releasing a token out from under in-flight work turns into a 401 rather
+than a silent pass.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+import secrets
+import tempfile
+import threading
+import time
+import urllib.parse
+from http import HTTPStatus
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+
+from .contract import Contract
+
+__all__ = ["MockOperationsServer"]
+
+_TOKEN_VALIDITY_MS = 6 * 60 * 60 * 1000
+
+
+class _Gate:
+    __slots__ = ("started", "opened")
+
+    def __init__(self):
+        self.started = threading.Event()
+        self.opened = threading.Event()
+
+
+class MockOperationsServer:
+    """Serves exactly the contracted operations on 127.0.0.1 and logs every hit."""
+
+    def __init__(self, contract_path, *, users=None, credentials=None, log_path=None):
+        self.contract = Contract.load(contract_path)
+        self.users = dict(users or {"admin": "admin"})
+        self.credentials = [dict(c) for c in (credentials or [])]
+
+        if log_path is None:
+            handle = tempfile.NamedTemporaryFile(
+                prefix="vcfops-mock-", suffix=".jsonl", delete=False
+            )
+            handle.close()
+            log_path = handle.name
+        self.log_path = str(log_path)
+        Path(self.log_path).parent.mkdir(parents=True, exist_ok=True)
+        Path(self.log_path).write_text("", encoding="utf-8")
+
+        self._state_lock = threading.RLock()
+        self._log_lock = threading.RLock()
+        self._tokens: dict[str, str] = {}
+        self._gates: dict[str, _Gate] = {}
+        self._seq = 0
+        self._routes = self._build_routes()
+
+        self._server = None
+        self._thread = None
+
+    # -- routing -----------------------------------------------------------
+
+    def _build_routes(self):
+        routes = []
+        base = self.contract.base_path.rstrip("/")
+        for op in self.contract.operations.values():
+            pattern = ""
+            for index, chunk in enumerate(re.split(r"\{([^{}]+)\}", base + op.path)):
+                # re.split with one group alternates literal, name, literal, ...
+                pattern += f"(?P<{chunk}>[^/]+)" if index % 2 else re.escape(chunk)
+            routes.append((op, re.compile("^" + pattern + "$")))
+        return routes
+
+    def _match(self, method, path):
+        for op, pattern in self._routes:
+            if op.method != method:
+                continue
+            found = pattern.match(path)
+            if found:
+                return op, found.groupdict()
+        return None, {}
+
+    # -- lifecycle ---------------------------------------------------------
+
+    def start(self) -> None:
+        if self._server is not None:
+            return
+        owner = self
+
+        class Handler(_MockHandler):
+            mock = owner
+
+        self._server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+        self._server.daemon_threads = True
+        self._thread = threading.Thread(
+            target=self._server.serve_forever, name="vcfops-mock", daemon=True
+        )
+        self._thread.start()
+
+    def stop(self) -> None:
+        if self._server is None:
+            return
+        for gate in list(self._gates.values()):
+            gate.opened.set()
+        self._server.shutdown()
+        self._server.server_close()
+        if self._thread is not None:
+            self._thread.join(timeout=5)
+        self._server = None
+        self._thread = None
+
+    @property
+    def base_url(self) -> str:
+        if self._server is None:
+            raise RuntimeError("server is not running; call start() first")
+        host, port = self._server.server_address[:2]
+        return f"http://{host}:{port}"
+
+    # -- test controls -----------------------------------------------------
+
+    def set_password(self, username, password) -> None:
+        with self._state_lock:
+            self.users[username] = password
+
+    def hold(self, operation_id) -> None:
+        """Arm a one-shot gate: the next request for ``operation_id`` parks."""
+        self.contract.operation(operation_id)
+        with self._state_lock:
+            self._gates[operation_id] = _Gate()
+
+    def wait_started(self, operation_id, timeout=5.0) -> bool:
+        with self._state_lock:
+            gate = self._gates.get(operation_id)
+        if gate is None:
+            return False
+        return gate.started.wait(timeout)
+
+    def release(self, operation_id) -> None:
+        with self._state_lock:
+            gate = self._gates.pop(operation_id, None)
+        if gate is not None:
+            gate.opened.set()
+
+    def active_tokens(self) -> set[str]:
+        with self._state_lock:
+            return set(self._tokens)
+
+    # -- request log -------------------------------------------------------
+
+    def entries(self) -> list[dict]:
+        with self._log_lock:
+            text = Path(self.log_path).read_text(encoding="utf-8")
+        return [json.loads(line) for line in text.splitlines() if line.strip()]
+
+    def _log(self, record) -> None:
+        with self._log_lock:
+            self._seq += 1
+            record["seq"] = self._seq
+            ordered = {
+                key: record.get(key)
+                for key in (
+                    "seq", "operation_id", "method", "path", "query_string",
+                    "query_pairs", "headers", "body_raw", "body_json", "token",
+                    "status", "started_ns", "completed_ns",
+                )
+            }
+            with open(self.log_path, "a", encoding="utf-8") as handle:
+                handle.write(json.dumps(ordered) + "\n")
+                handle.flush()
+
+    # -- handling ----------------------------------------------------------
+
+    def handle(self, method, raw_path, headers, body_raw):
+        started_ns = time.monotonic_ns()
+        parsed = urllib.parse.urlsplit(raw_path)
+        path = urllib.parse.unquote(parsed.path)
+        query_pairs = urllib.parse.parse_qsl(parsed.query, keep_blank_values=True)
+
+        body_json = None
+        if body_raw:
+            try:
+                body_json = json.loads(body_raw)
+            except json.JSONDecodeError:
+                body_json = None
+
+        lowered = {name.lower(): value for name, value in headers.items()}
+        token = self.contract.token_from_authorization(
+            lowered.get(self.contract.auth_header.lower())
+        )
+        op, path_values = self._match(method, path)
+
+        status, payload = self._dispatch(op, path_values, query_pairs, body_json, token)
+
+        self._log({
+            "operation_id": op.operation_id if op else None,
+            "method": method,
+            "path": path,
+            "query_string": parsed.query,
+            "query_pairs": [list(pair) for pair in query_pairs],
+            "headers": lowered,
+            "body_raw": body_raw if body_raw else None,
+            "body_json": body_json,
+            "token": token,
+            "status": status,
+            "started_ns": started_ns,
+            "completed_ns": time.monotonic_ns(),
+        })
+        return status, payload
+
+    def _dispatch(self, op, path_values, query_pairs, body_json, token):
+        if op is None:
+            return 404, {"message": "no such operation in the pinned contract"}
+
+        if op.requires_auth and not self._token_active(token):
+            return 401, {"message": "missing or invalid authentication token"}
+
+        bad = self._validate_query(op, query_pairs) or self._validate_body(op, body_json)
+        if bad:
+            return 400, {"message": bad}
+
+        parked = self._park(op)
+        if parked and op.requires_auth and not self._token_active(token):
+            # The token was released while this request was in flight. On the
+            # appliance that is a stranded call; make it visible as one.
+            return 401, {"message": "session token was released while the request was in flight"}
+
+        return self._respond(op, path_values, query_pairs, body_json, token)
+
+    def _park(self, op) -> bool:
+        with self._state_lock:
+            gate = self._gates.get(op.operation_id)
+            if gate is None or gate.started.is_set():
+                return False
+            gate.started.set()
+        gate.opened.wait(60)
+        return True
+
+    def _token_active(self, token) -> bool:
+        with self._state_lock:
+            return bool(token) and token in self._tokens
+
+    def _validate_query(self, op, query_pairs):
+        unknown = {name for name, _ in query_pairs} - op.query_names
+        if unknown:
+            return f"query parameter(s) not in the contract: {', '.join(sorted(unknown))}"
+        return None
+
+    def _validate_body(self, op, body_json):
+        schema = op.request_body
+        if schema is None:
+            if body_json is not None:
+                return f"{op.operation_id} takes no request body"
+            return None
+        if not isinstance(body_json, dict):
+            return f"{op.operation_id} requires a JSON object body"
+
+        unknown = set(body_json) - schema.all_fields
+        if unknown:
+            return f"field(s) not in the contract: {', '.join(sorted(unknown))}"
+        missing = [name for name in schema.required_fields if name not in body_json]
+        if missing:
+            return f"missing required field(s): {', '.join(missing)}"
+        blank = sorted(
+            name for name in schema.optional_fields
+            if name in body_json and body_json[name] in (None, "")
+        )
+        if blank:
+            return (
+                f"optional field(s) sent empty instead of omitted: {', '.join(blank)}"
+            )
+        return None
+
+    def _respond(self, op, path_values, query_pairs, body_json, token):
+        handler = getattr(self, "_op_" + op.operation_id)
+        return handler(path_values, query_pairs, body_json, token)
+
+    # -- the five contracted operations ------------------------------------
+
+    def _op_acquireToken(self, path_values, query_pairs, body, token):
+        with self._state_lock:
+            expected = self.users.get(body.get("username"))
+            if expected is None or expected != body.get("password"):
+                return 401, {"message": "invalid username or password"}
+            issued = secrets.token_hex(16)
+            self._tokens[issued] = body["username"]
+        return 200, {
+            "token": issued,
+            "validity": int(time.time() * 1000) + _TOKEN_VALIDITY_MS,
+            "expiresAt": "in the future",
+            "roles": ["ContentAdmin"],
+        }
+
+    def _op_releaseToken(self, path_values, query_pairs, body, token):
+        with self._state_lock:
+            self._tokens.pop(token, None)
+        return 200, None
+
+    def _op_getCredentials(self, path_values, query_pairs, body, token):
+        wanted_ids = [value for name, value in query_pairs if name == "id"]
+        wanted_kinds = [value for name, value in query_pairs if name == "adapterKind"]
+        with self._state_lock:
+            found = [dict(c) for c in self.credentials]
+        if wanted_ids:
+            found = [c for c in found if c.get("id") in wanted_ids]
+        if wanted_kinds:
+            found = [c for c in found if c.get("adapterKindKey") in wanted_kinds]
+        return 200, {"credentialInstances": found}
+
+    def _op_partialUpdateCredential(self, path_values, query_pairs, body, token):
+        with self._state_lock:
+            for stored in self.credentials:
+                if stored.get("id") == body.get("id"):
+                    stored.update(body)
+                    return 200, dict(stored)
+        return 404, {"message": "no such credential instance"}
+
+    def _op_getAdapterInstancesUsingCredential(self, path_values, query_pairs, body, token):
+        credential_id = path_values["id"]
+        with self._state_lock:
+            known = {c.get("id") for c in self.credentials}
+        if credential_id not in known:
+            return 404, {"message": "no such credential instance"}
+        return 200, {
+            "adapterInstancesInfoDto": [
+                {
+                    "id": "725cbdae-812e-4e98-9972-53c58f51661b",
+                    "credentialInstanceId": credential_id,
+                    "collectorId": 1,
+                    "description": "collector adapter instance",
+                    "resourceKey": {
+                        "name": "VC Adapter",
+                        "adapterKindKey": "VMWARE",
+                        "resourceKindKey": "Adapter",
+                        "resourceIdentifiers": [],
+                    },
+                }
+            ]
+        }
+
+
+class _MockHandler(BaseHTTPRequestHandler):
+    """Thin shim: read the request, hand it to the mock, write the answer back."""
+
+    mock: MockOperationsServer = None
+    server_version = "vcfops-mock/1.0"
+
+    def log_message(self, fmt, *args):  # noqa: A003 - silence the stderr access log
+        pass
+
+    def _run(self):
+        length = int(self.headers.get("Content-Length") or 0)
+        body_raw = self.rfile.read(length).decode("utf-8") if length else None
+        headers = {name: value for name, value in self.headers.items()}
+        try:
+            status, payload = self.mock.handle(self.command, self.path, headers, body_raw)
+        except Exception as exc:  # pragma: no cover - defensive
+            status, payload = 500, {"message": f"mock failure: {exc!r}"}
+
+        encoded = b"" if payload is None else json.dumps(payload).encode("utf-8")
+        self.send_response(HTTPStatus(status))
+        if encoded:
+            self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(encoded)))
+        self.end_headers()
+        if encoded:
+            self.wfile.write(encoded)
+
+    do_GET = _run
+    do_POST = _run
+    do_PATCH = _run
+    do_PUT = _run
+    do_DELETE = _run

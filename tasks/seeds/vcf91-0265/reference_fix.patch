@@ -0,0 +1,334 @@
+"""A thread-safe VCF Operations ``/suite-api`` session with clean secret rotation.
+
+The point of this module is the handover in :meth:`OperationsSession.rotate_secret`.
+A token is not a thing you can swap under a request that is already on the wire:
+the appliance validates the session for the whole life of the call, so releasing
+the old token while work is still in flight is what produced the 401 bursts we
+used to see every rotation window.
+
+So each token is wrapped in a :class:`_Lease` that counts the requests currently
+using it. Rotation installs a new lease for all *new* work and retires the old
+one; whichever thread finishes the old lease's last request is the thread that
+sends ``releaseToken`` for it. Rotation itself never waits for that to happen.
+"""
+
+from __future__ import annotations
+
+import json
+import threading
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+from dataclasses import dataclass
+
+from .contract import Contract
+from .errors import VcfOpsContractError, VcfOpsHttpError
+
+__all__ = ["OperationsSession", "RotationResult"]
+
+
+@dataclass(frozen=True)
+class RotationResult:
+    """What happened when the secret was rotated."""
+
+    previous_token: str
+    active_token: str
+    inflight_at_rotation: int
+    released: bool
+
+
+class _Lease:
+    """One auth token plus a count of the requests currently using it."""
+
+    __slots__ = ("token", "inflight", "retired", "released")
+
+    def __init__(self, token: str):
+        self.token = token
+        self.inflight = 0
+        self.retired = False
+        self.released = False
+
+
+class OperationsSession:
+    """Talks to the operations named in ``docs/contract.json`` and nothing else."""
+
+    def __init__(
+        self,
+        base_url,
+        username,
+        password,
+        *,
+        auth_source=None,
+        contract_path=None,
+        timeout=10.0,
+    ):
+        self.contract = Contract.load(contract_path)
+        self.base_url = str(base_url).rstrip("/")
+        self.username = username
+        self.auth_source = auth_source
+        self.timeout = float(timeout)
+
+        self._password = password
+        self._cond = threading.Condition(threading.RLock())
+        self._active: _Lease | None = None
+        self._retiring: list[_Lease] = []
+
+    # -- lifecycle ---------------------------------------------------------
+
+    def open(self) -> str:
+        """Acquire a token and make it the active one."""
+        token = self._acquire(self._password)
+        with self._cond:
+            self._active = _Lease(token)
+        return token
+
+    def close(self) -> None:
+        """Release every token this session still holds. Idempotent."""
+        with self._cond:
+            leases = ([self._active] if self._active else []) + self._retiring
+            self._active = None
+            self._retiring = []
+            for lease in leases:
+                lease.retired = True
+            deadline = time.monotonic() + self.timeout
+            while any(lease.inflight for lease in leases):
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    break
+                self._cond.wait(min(0.05, remaining))
+            doomed = [lease for lease in leases if not lease.released]
+            for lease in doomed:
+                lease.released = True
+
+        for lease in doomed:
+            self._release(lease.token)
+
+    def __enter__(self) -> "OperationsSession":
+        self.open()
+        return self
+
+    def __exit__(self, *exc_info) -> None:
+        self.close()
+
+    @property
+    def active_token(self) -> str | None:
+        """The token new requests will use."""
+        with self._cond:
+            return self._active.token if self._active else None
+
+    # -- rotation ----------------------------------------------------------
+
+    def rotate_secret(self, new_password) -> RotationResult:
+        """Move new work onto a token minted from ``new_password``.
+
+        Returns as soon as the new token is active. The old token is released by
+        whichever thread completes the last request that was already using it —
+        this call does not wait for the drain.
+        """
+        new_token = self._acquire(new_password)
+
+        with self._cond:
+            old = self._active
+            if old is None:
+                raise VcfOpsContractError("session is not open; call open() before rotating")
+            self._password = new_password
+            self._active = _Lease(new_token)
+            old.retired = True
+            inflight = old.inflight
+            release_now = inflight == 0 and not old.released
+            if release_now:
+                old.released = True
+            else:
+                self._retiring.append(old)
+
+        if release_now:
+            self._release(old.token)
+
+        return RotationResult(
+            previous_token=old.token,
+            active_token=new_token,
+            inflight_at_rotation=inflight,
+            released=release_now,
+        )
+
+    # -- contracted operations --------------------------------------------
+
+    def get_credentials(self, credential_ids=None, adapter_kinds=None) -> dict:
+        return self._authenticated(
+            "getCredentials",
+            query={"id": credential_ids, "adapterKind": adapter_kinds},
+        )
+
+    def get_adapter_instances_using_credential(self, credential_id) -> dict:
+        return self._authenticated(
+            "getAdapterInstancesUsingCredential",
+            path_params={"id": credential_id},
+        )
+
+    def partial_update_credential(
+        self,
+        credential_id,
+        *,
+        name,
+        adapter_kind_key,
+        credential_kind_key,
+        fields=None,
+        editable=None,
+    ) -> dict:
+        return self._authenticated(
+            "partialUpdateCredential",
+            body={
+                "id": credential_id,
+                "name": name,
+                "adapterKindKey": adapter_kind_key,
+                "credentialKindKey": credential_kind_key,
+                "fields": fields,
+                "editable": editable,
+            },
+        )
+
+    def _acquire(self, password) -> str:
+        payload = self._request(
+            "acquireToken",
+            body={
+                "username": self.username,
+                "password": password,
+                "authSource": self.auth_source,
+            },
+        )
+        token = (payload or {}).get("token")
+        if not token:
+            raise VcfOpsContractError("acquireToken returned no token")
+        return token
+
+    def _release(self, token) -> None:
+        self._request("releaseToken", token=token)
+
+    # -- in-flight accounting ---------------------------------------------
+
+    def _authenticated(self, operation_id, **kwargs):
+        lease = self._begin()
+        try:
+            return self._request(operation_id, token=lease.token, **kwargs)
+        finally:
+            self._end(lease)
+
+    def _begin(self) -> _Lease:
+        with self._cond:
+            if self._active is None:
+                raise VcfOpsContractError("session is not open; call open() first")
+            lease = self._active
+            lease.inflight += 1
+            return lease
+
+    def _end(self, lease: _Lease) -> None:
+        with self._cond:
+            lease.inflight -= 1
+            drained = lease.retired and lease.inflight == 0 and not lease.released
+            if drained:
+                lease.released = True
+                if lease in self._retiring:
+                    self._retiring.remove(lease)
+            self._cond.notify_all()
+
+        if drained:
+            # Outside the lock: the release is I/O and must not block other workers.
+            self._release(lease.token)
+
+    # -- wire --------------------------------------------------------------
+
+    def _request(self, operation_id, *, path_params=None, query=None, body=None, token=None):
+        op = self.contract.operation(operation_id)
+
+        url = self.base_url + self.contract.base_path + urllib.parse.quote(
+            op.format_path(path_params), safe="/"
+        )
+        pairs = self._query_pairs(op, query)
+        if pairs:
+            url = f"{url}?{urllib.parse.urlencode(pairs)}"
+
+        data = None
+        headers = {"Accept": "application/json"}
+        if body is not None:
+            payload = self._body(op, body)
+            data = json.dumps(payload).encode("utf-8")
+            headers["Content-Type"] = op.request_body.content_type
+        elif op.request_body is not None and op.request_body.required_fields:
+            raise VcfOpsContractError(f"{operation_id} requires a request body")
+
+        if op.requires_auth:
+            if not token:
+                raise VcfOpsContractError(f"{operation_id} requires a token")
+            headers[self.contract.auth_header] = self.contract.authorization_value(token)
+
+        request = urllib.request.Request(url, data=data, headers=headers, method=op.method)
+        try:
+            opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+            with opener.open(request, timeout=self.timeout) as response:
+                raw = response.read()
+        except urllib.error.HTTPError as exc:
+            detail = ""
+            try:
+                detail = exc.read().decode("utf-8", "replace")
+            except Exception:  # pragma: no cover - body already consumed
+                pass
+            raise VcfOpsHttpError(exc.code, op.method, url, detail) from None
+        except urllib.error.URLError as exc:
+            raise VcfOpsHttpError(0, op.method, url, str(exc.reason)) from None
+
+        if not raw:
+            return {}
+        return json.loads(raw.decode("utf-8"))
+
+    @staticmethod
+    def _query_pairs(op, query):
+        """Exploded ``name=value`` pairs, in the order the contract declares them.
+
+        A parameter the caller left unset — or set to an empty list — is not sent
+        at all, rather than sent blank.
+        """
+        query = query or {}
+        unknown = set(query) - op.query_names
+        if unknown:
+            raise VcfOpsContractError(
+                f"{op.operation_id} declares no query parameter(s) {', '.join(sorted(unknown))}"
+            )
+
+        pairs = []
+        for param in op.query_params:
+            value = query.get(param.name)
+            if value is None:
+                continue
+            if isinstance(value, (list, tuple, set, frozenset)):
+                values = [str(item) for item in value]
+                if not values:
+                    continue
+                if param.explode:
+                    pairs.extend((param.name, item) for item in values)
+                else:
+                    pairs.append((param.name, ",".join(values)))
+            else:
+                pairs.append((param.name, str(value)))
+        return pairs
+
+    @staticmethod
+    def _body(op, values):
+        """Drop unset fields, keep falsy ones, and refuse anything off-contract."""
+        schema = op.request_body
+        if schema is None:
+            raise VcfOpsContractError(f"{op.operation_id} takes no request body")
+
+        payload = {name: value for name, value in values.items() if value is not None}
+
+        unknown = set(payload) - schema.all_fields
+        if unknown:
+            raise VcfOpsContractError(
+                f"{op.operation_id}: field(s) not in the contract: {', '.join(sorted(unknown))}"
+            )
+        missing = [name for name in schema.required_fields if name not in payload]
+        if missing:
+            raise VcfOpsContractError(
+                f"{op.operation_id}: missing required field(s) {', '.join(missing)}"
+            )
+        return payload

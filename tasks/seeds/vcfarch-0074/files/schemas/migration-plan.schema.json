{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch-0074:migration-plan",
  "title": "VCF 9.1 brownfield migration architecture",
  "type": "object",
  "required": [
    "artifactVersion",
    "sourceEstateId",
    "targetVersion",
    "architecture",
    "migrationPlan"
  ],
  "properties": {
    "artifactVersion": {
      "const": "1.0"
    },
    "sourceEstateId": {
      "type": "string",
      "minLength": 1
    },
    "targetVersion": {
      "type": "string",
      "minLength": 1
    },
    "architecture": {
      "$ref": "#/$defs/architecture"
    },
    "migrationPlan": {
      "$ref": "#/$defs/migrationPlan"
    }
  },
  "$defs": {
    "architecture": {
      "type": "object",
      "required": [
        "domains",
        "services"
      ],
      "properties": {
        "domains": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/domain"
          }
        },
        "services": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/service"
          }
        }
      },
      "additionalProperties": false
    },
    "domain": {
      "type": "object",
      "required": [
        "id",
        "role",
        "hostCount",
        "cpuCoresPerHost",
        "memoryGiBPerHost",
        "usableStorageTiB"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "management",
            "workload"
          ]
        },
        "hostCount": {
          "type": "integer",
          "minimum": 1
        },
        "cpuCoresPerHost": {
          "type": "integer",
          "minimum": 1
        },
        "memoryGiBPerHost": {
          "type": "integer",
          "minimum": 1
        },
        "usableStorageTiB": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": [
        "id",
        "displayName",
        "placementDomain",
        "deploymentModel",
        "size",
        "nodeCount",
        "fqdn",
        "capacity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "placementDomain": {
          "type": "string",
          "minLength": 1
        },
        "deploymentModel": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "nodeCount": {
          "type": "integer",
          "minimum": 1
        },
        "fqdn": {
          "type": "string",
          "minLength": 1
        },
        "capacity": {
          "type": "object",
          "required": [
            "metric",
            "value"
          ],
          "properties": {
            "metric": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "integer",
              "minimum": 1
            },
            "retentionDays": {
              "type": "integer",
              "minimum": 1
            },
            "usableStorageTiB": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "migrationPlan": {
      "type": "object",
      "required": [
        "sourcePlatformVersion",
        "targetPlatformVersion",
        "platformUpgradePath",
        "steps"
      ],
      "properties": {
        "sourcePlatformVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetPlatformVersion": {
          "type": "string",
          "minLength": 1
        },
        "platformUpgradePath": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": [
        "sequence",
        "componentId",
        "componentName",
        "componentKind",
        "currentVersion",
        "targetVersion",
        "upgradePath",
        "action",
        "dependsOn",
        "gates"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "componentName": {
          "type": "string",
          "minLength": 1
        },
        "componentKind": {
          "type": "string",
          "minLength": 1
        },
        "currentVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1
        },
        "upgradePath": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sdkResourceSpec": {
          "type": "object",
          "required": [
            "resourceId",
            "type",
            "toVersion",
            "upgradeNow"
          ],
          "properties": {
            "resourceId": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "enum": [
                "DOMAIN",
                "CLUSTER"
              ]
            },
            "toVersion": {
              "type": "string",
              "minLength": 1
            },
            "upgradeNow": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}

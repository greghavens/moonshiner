+        -Version $inventory.targetVersion `
+        -UseExistingDeployment $true `
+        -SslThumbprint $inventory.managementVcenter.sslThumbprint
+
+    $networks = @(
+        foreach ($network in $inventory.targetNetworks) {
+            Initialize-VcfInstallerSddcNetworkSpec `
+                -NetworkType $network.networkType `
+                -Subnet $network.subnet `
+                -Gateway $network.gateway `
+                -SubnetMask $network.subnetMask `
+                -VlanId $network.vlanId `
+                -Mtu $network.mtu
+        }
+    )
+
+    $dns = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $inventory.dns.subdomain `
+        -Nameservers $inventory.dns.nameservers
+
+    $operationsNodes = @(
+        foreach ($node in $inventory.targetEndpoints.operationsNodes) {
+            Initialize-VcfInstallerVcfOperationsNode -Hostname $node.hostname -Type $node.type
+        }
+    )
+    $operations = Initialize-VcfInstallerVcfOperationsSpec `
+        -Nodes $operationsNodes `
+        -ApplianceSize $compatibility.targetSpec.operations.applianceSize `
+        -LoadBalancerFqdn $inventory.targetEndpoints.operationsLoadBalancerFqdn `
+        -UseExistingDeployment $compatibility.targetSpec.operations.useExistingDeployment `
+        -Version $inventory.targetVersion
+
+    $automation = Initialize-VcfInstallerVcfAutomationSpec `
+        -Hostname $inventory.targetEndpoints.automationFqdn `
+        -PlatformFqdn $inventory.targetEndpoints.vspPlatformFqdn `
+        -IpPool $inventory.targetEndpoints.automationIpPool `
+        -InternalClusterCidr $inventory.targetEndpoints.automationInternalClusterCidr `
+        -NodePrefix $compatibility.targetSpec.automation.nodePrefix `
+        -Size $compatibility.targetSpec.automation.size `
+        -Version $inventory.targetVersion `
+        -UseExistingDeployment $compatibility.targetSpec.automation.useExistingDeployment
+
+    $vspIpv4Pool = Initialize-VcfInstallerIPv4Pool `
+        -Cidr $inventory.targetEndpoints.vspIpv4Cidr `
+        -Addresses $inventory.targetEndpoints.vspIpv4Addresses
+    $vsp = Initialize-VcfInstallerSddcVspClusterSpec `
+        -PlatformFqdn $inventory.targetEndpoints.vspPlatformFqdn `
+        -Ipv4Pool $vspIpv4Pool `
+        -Size $compatibility.targetSpec.vsp.size `
+        -InternalClusterCidrIpv4 $compatibility.targetSpec.vsp.internalClusterCidrIpv4 `
+        -InstanceFqdn $inventory.targetEndpoints.vspInstanceFqdn `
+        -FleetFqdn $inventory.targetEndpoints.vspFleetFqdn `
+        -Version $inventory.targetVersion `
+        -UseExistingDeployment $compatibility.targetSpec.vsp.useExistingDeployment
+
+    $sddcSpec = Initialize-VcfInstallerSddcSpec `
+        -SddcId $inventory.sddcId `
+        -WorkflowType $compatibility.targetSpec.workflowType `
+        -Version $inventory.targetVersion `
+        -VcenterSpec $vcenter `
+        -NetworkSpecs $networks `
+        -DnsSpec $dns `
+        -NtpServers $inventory.dns.ntpServers `
+        -VspClusterSpec $vsp `
+        -VcfOperationsSpec $operations `
+        -VcfAutomationSpec $automation `
+        -VcfInstanceName $inventory.vcfInstanceName
+
+    $artifact = ConvertFrom-VcfSdkObject -Value $sddcSpec
+    $artifact['artifactVersion'] = '1.0'
+    $artifact['sourceEstateId'] = $inventory.estateId
+    $artifact['targetVersion'] = $inventory.targetVersion
+
+    $architectureDomains = @(
+        foreach ($domain in $compatibility.targetArchitecture.domains) {
+            [ordered]@{
+                id = $domain.id
+                role = $domain.role
+                hostCount = [int] $domain.hostCount
+                cpuCoresPerHost = [int] $domain.cpuCoresPerHost
+                memoryGiBPerHost = [int] $domain.memoryGiBPerHost
+                usableStorageTiB = [double] $domain.usableStorageTiB
+            }
+        }
+    )
+
+    $architectureServices = @(
+        foreach ($service in $compatibility.targetArchitecture.services) {
+            $fqdn = switch ($service.id) {
+                'vcf-operations' { $inventory.targetEndpoints.operationsLoadBalancerFqdn }
+                'vcf-automation' { $inventory.targetEndpoints.automationFqdn }
+                'vcf-operations-for-logs' { $inventory.targetEndpoints.logsTargetFqdn }
+                default { throw "No target endpoint mapping exists for '$($service.id)'." }
+            }
+
+            $capacity = [ordered]@{
+                metric = $service.capacityMetric
+                value = [int] $service.capacityValue
+            }
+            if ($null -ne $service.PSObject.Properties['retentionDays']) {
+                $capacity['retentionDays'] = [int] $service.retentionDays
+                $capacity['usableStorageTiB'] = [double] $service.usableStorageTiB
+            }
+
+            [ordered]@{
+                id = $service.id
+                displayName = $service.displayName
+                placementDomain = $service.placementDomain
+                deploymentModel = $service.deploymentModel
+                size = $service.size
+                nodeCount = [int] $service.nodeCount
+                fqdn = $fqdn
+                capacity = $capacity
+            }
+        }
+    )
+    $artifact['architecture'] = [ordered]@{
+        domains = $architectureDomains
+        services = $architectureServices
+    }
+
+    $componentsById = @{}
+    foreach ($component in $inventory.components) {
+        $componentsById[$component.id] = $component
+    }
+
+    $steps = @()
+    $completed = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::Ordinal)
+    $remainingRules = [System.Collections.Generic.List[object]]::new()
+    foreach ($rule in $compatibility.componentRules) {
+        $remainingRules.Add($rule)
+    }
+
+    while ($remainingRules.Count -gt 0) {
+        $selected = $null
+        foreach ($rule in $remainingRules) {
+            $dependenciesSatisfied = $true
+            foreach ($dependency in $rule.dependsOn) {
+                if (-not $completed.Contains([string] $dependency)) {
+                    $dependenciesSatisfied = $false
+                    break
+                }
+            }
+            if ($dependenciesSatisfied) {
+                $selected = $rule
+                break
+            }
+        }
+        if ($null -eq $selected) {
+            throw 'Compatibility snapshot contains a cyclic or unresolved dependency.'
+        }
+
+        $component = $componentsById[$selected.componentId]
+        if ($null -eq $component) {
+            throw "Compatibility rule references unknown component '$($selected.componentId)'."
+        }
+        $step = [ordered]@{
+            sequence = $steps.Count + 1
+            componentId = $component.id
+            componentName = $component.name
+            componentKind = $component.kind
+            currentVersion = $component.currentVersion
+            targetVersion = $selected.targetVersion
+            upgradePath = @($selected.supportedPath)
+            action = $selected.action
+            dependsOn = @($selected.dependsOn)
+            gates = @($selected.requiredGates)
+        }
+
+        if ($null -ne $component.PSObject.Properties['sdkResourceType']) {
+            $resourceUpgrade = Initialize-VcfResourceUpgradeSpec `
+                -ResourceId $component.id `
+                -Type $component.sdkResourceType `
+                -ToVersion $selected.targetVersion `
+                -UpgradeNow $false
+            $step['sdkResourceSpec'] = ConvertFrom-VcfSdkObject -Value $resourceUpgrade
+        }
+
+        $steps += ,$step
+        [void] $completed.Add([string] $component.id)
+        [void] $remainingRules.Remove($selected)
+    }
+
+    $artifact['migrationPlan'] = [ordered]@{
+        sourcePlatformVersion = $inventory.platformVersion
+        targetPlatformVersion = $inventory.targetVersion
+        platformUpgradePath = @($inventory.platformVersion, $inventory.targetVersion)
+        steps = $steps
+    }
+
+    $outputFullPath = $ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($OutputPath)
+    $outputDirectory = Split-Path -Parent $outputFullPath
+    if (-not (Test-Path -LiteralPath $outputDirectory)) {
+        [void] (New-Item -ItemType Directory -Path $outputDirectory -Force)
+    }
+    $artifact | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $outputFullPath -Encoding utf8

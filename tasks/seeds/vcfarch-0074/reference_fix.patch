 Set-StrictMode -Version Latest
 
+function ConvertTo-LowerCamelCase {
+    param([Parameter(Mandatory)][string] $Name)
+
+    if ($Name.Length -eq 1) {
+        return $Name.ToLowerInvariant()
+    }
+
+    return $Name.Substring(0, 1).ToLowerInvariant() + $Name.Substring(1)
+}
+
+function ConvertTo-ArtifactShape {
+    param([AllowNull()][object] $Value)
+
+    if ($null -eq $Value) {
+        return $null
+    }
+
+    if ($Value -is [System.Collections.IDictionary]) {
+        $mapped = [ordered]@{}
+        foreach ($entry in $Value.GetEnumerator()) {
+            if ($entry.Key -eq 'AdditionalProperties' -or $null -eq $entry.Value) {
+                continue
+            }
+            $mapped[(ConvertTo-LowerCamelCase -Name ([string] $entry.Key))] = ConvertTo-ArtifactShape -Value $entry.Value
+        }
+        return $mapped
+    }
+
+    if ($Value -is [System.Collections.IEnumerable] -and $Value -isnot [string]) {
+        $mappedItems = @(
+            foreach ($item in $Value) {
+                ConvertTo-ArtifactShape -Value $item
+            }
+        )
+        return ,$mappedItems
+    }
+
+    return $Value
+}
+
+function ConvertFrom-VcfSdkObject {
+    param([Parameter(Mandatory)][object] $Value)
+
+    $sdkJson = $Value | ConvertTo-Json -Depth 100
+    $sdkData = $sdkJson | ConvertFrom-Json -AsHashtable -Depth 100
+    return ConvertTo-ArtifactShape -Value $sdkData
+}
+

{
  "_note": "Wire contract for the VCF Operations for Networks operations used by internal/opsnet. Derived from the OpenAPI document identified in docs/official_sources.json. Every operationId, path, parameter name, schema name and property name below appears verbatim in that document.",
  "spec": {
    "repository": "vmware/vcf-api-specs",
    "path": "specifications/vcf-operations/vcf-operations-for-networks-openapi.yaml",
    "commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "openapi": "3.0.1",
    "title": "VCF Operations for networks API Reference",
    "version": "9.1.0.0",
    "license": "Apache-2.0"
  },
  "basePath": "/api/ni",
  "security": {
    "schemeName": "ApiKeyAuth",
    "type": "apiKey",
    "in": "header",
    "headerName": "Authorization",
    "valueFormat": "NetworkInsight {token}",
    "specDescription": "API Key - NetworkInsight {token}",
    "notApplicableTo": ["create"]
  },
  "tokenLifecycle": {
    "responseSchema": "Token",
    "expiryProperty": "expiry",
    "expiryType": "integer/int64",
    "expiryUnit": "epoch-milliseconds",
    "expiryUnitCaveat": "The spec description for Token.expiry reads 'expiry epoch time in secs.' but both spec examples are 13-digit millisecond values (1509332642427 and 1605201960327). This contract and the mock follow the examples: epoch milliseconds.",
    "expiredTokenBehaviour": "Spec: 'If a token is invalid or expired, 401-Unauthorized error gets returned in the response of the API request.'",
    "tokenQuotaNote": "Spec: 'There is limit of 100 valid tokens per user and further requests will return 401-Unauthorized. So, users are advised to delete the tokens after use.'"
  },
  "operations": [
    {
      "operationId": "create",
      "tag": "Authentication",
      "summary": "Create an auth token",
      "method": "POST",
      "path": "/auth/token",
      "security": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "UserCredential"
      },
      "responses": {
        "200": {"schema": "Token"},
        "400": {"schema": "ApiError"},
        "401": {"schema": "ApiError"},
        "500": {"schema": "ApiError"}
      }
    },
    {
      "operationId": "delete",
      "tag": "Authentication",
      "summary": "Delete an auth token.",
      "method": "DELETE",
      "path": "/auth/token",
      "security": ["ApiKeyAuth"],
      "requestBody": null,
      "responses": {
        "204": {"schema": null},
        "401": {"schema": "ApiError"},
        "500": {"schema": "ApiError"}
      }
    },
    {
      "operationId": "listApplications",
      "tag": "Applications",
      "summary": "List applications",
      "method": "GET",
      "path": "/groups/applications",
      "security": ["ApiKeyAuth"],
      "parameters": [
        {"name": "size", "in": "query", "required": false, "type": "number", "default": 10, "description": "Page size of results"},
        {"name": "cursor", "in": "query", "required": false, "type": "string", "description": "Cursor from previous response"},
        {"name": "modifiedAfter", "in": "query", "required": false, "type": "number", "description": "timestamp after which apps has been modified"}
      ],
      "responses": {
        "200": {"schema": "PagedListResponse"},
        "401": {"schema": "ApiError"},
        "500": {"schema": "ApiError"}
      }
    },
    {
      "operationId": "getApplicationById",
      "tag": "Applications",
      "summary": "Get application summary",
      "method": "GET",
      "path": "/groups/applications/{id}",
      "security": ["ApiKeyAuth"],
      "parameters": [
        {"name": "id", "in": "path", "required": true, "type": "string", "description": "The Entity ID of object requestion information on"},
        {"name": "fetch_member_counts", "in": "query", "required": false, "type": "boolean", "description": "True, if member counts should be fetched."},
        {"name": "fetch_update_status", "in": "query", "required": false, "type": "boolean", "description": "True, if the update status of the saved application should be fetched."}
      ],
      "responses": {
        "200": {"schema": "Application"},
        "401": {"schema": "ApiError"},
        "404": {"schema": "ApiError"},
        "500": {"schema": "ApiError"}
      }
    }
  ],
  "schemas": {
    "UserCredential": {
      "type": "object",
      "required": [],
      "properties": {
        "username": {"type": "string"},
        "password": {"type": "string"},
        "domain": {"type": "object", "schema": "Domain"}
      }
    },
    "Domain": {
      "type": "object",
      "required": [],
      "properties": {
        "domain_type": {"type": "string", "nullable": true, "enum": ["LDAP", "LOCAL"], "description": "domain type, should be in uppercase"},
        "value": {"type": "string", "description": "domain value, not required for LOCAL domain"}
      }
    },
    "Token": {
      "type": "object",
      "required": [],
      "properties": {
        "token": {"type": "string"},
        "expiry": {"type": "integer", "format": "int64", "description": "expiry epoch time in secs."}
      }
    },
    "PagedListResponse": {
      "type": "object",
      "required": [],
      "properties": {
        "results": {"type": "array", "items": {"schema": "EntityId"}},
        "cursor": {"type": "string", "description": "Cursor for the next page"},
        "total_count": {"type": "integer", "description": "Total number of objects"},
        "start_time": {"type": "integer", "format": "int64"},
        "end_time": {"type": "integer", "format": "int64"}
      }
    },
    "EntityId": {
      "type": "object",
      "required": [],
      "properties": {
        "entity_id": {"type": "string"},
        "entity_type": {"type": "string", "schema": "EntityType"},
        "entity_name": {"type": "string"}
      }
    },
    "Application": {
      "type": "object",
      "allOf": ["BaseEntity"],
      "required": [],
      "properties": {
        "entity_id": {"type": "string", "from": "BaseEntity"},
        "name": {"type": "string", "from": "BaseEntity"},
        "entity_type": {"type": "string", "schema": "EntityType", "from": "BaseEntity"},
        "create_time": {"type": "integer", "format": "int64"},
        "created_by": {"type": "string"},
        "last_modified_time": {"type": "integer", "format": "int64"},
        "last_modified_by": {"type": "string"},
        "last_modified_by_service": {"type": "string"},
        "tier_count": {"type": "integer", "format": "int32"},
        "member_count": {"type": "integer", "format": "int32"},
        "update_status": {"type": "string", "schema": "UpdateStatus"},
        "confidence": {"type": "string"}
      }
    },
    "UpdateStatus": {
      "type": "string",
      "nullable": true,
      "enum": ["ADDED", "DELETED", "UPDATED", "NO_CHANGE"]
    },
    "EntityType": {
      "type": "string",
      "nullable": true,
      "enumSubsetUsedHere": ["Application"]
    },
    "ApiError": {
      "type": "object",
      "required": [],
      "properties": {
        "code": {"type": "integer", "format": "int32"},
        "message": {"type": "string"},
        "details": {"type": "array", "items": {"schema": "ErrorDetail"}}
      }
    }
  },
  "cursorEncoding": {
    "note": "PagedListResponse.cursor is an opaque string as far as the spec is concerned. The mock encodes it the way the spec example does (spec example value 'MTA=' is base64 of '10', the zero-based offset of the next page). Clients must treat it as opaque and echo it back verbatim.",
    "specExample": "MTA="
  },
  "wireRules": {
    "omitUnsetOptionalFields": "An optional request body property or query parameter that the caller has not set must be absent from the request entirely. Sending it with an empty, zero or false value is a contract violation (for example 'cursor=' on the first page, 'modifiedAfter=0', 'fetch_member_counts=false', or \"value\": \"\" inside the domain object).",
    "authHeaderOnCreate": "operationId 'create' declares 'security: []'. Requests to it must not carry an Authorization header.",
    "contentType": "Request bodies are sent as 'application/json'.",
    "acceptOptional": "The spec does not constrain the Accept header; it is not asserted."
  }
}

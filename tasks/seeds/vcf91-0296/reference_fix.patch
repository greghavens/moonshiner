+// fetchDetails resolves every listed entity through operationId
+// "getApplicationById", keeping the listing order regardless of the order the
+// responses arrive in.
+func (c *Client) fetchDetails(ctx context.Context, listed []entityID) ([]Application, error) {
+	apps := make([]Application, len(listed))
+	if len(listed) == 0 {
+		return apps, nil
+	}
+
+	workers := c.cfg.DetailConcurrency
+	if workers < 1 {
+		workers = 1
+	}
+	if workers > len(listed) {
+		workers = len(listed)
+	}
+
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+
+	indices := make(chan int)
+	failures := make(chan error, workers)
+	var wg sync.WaitGroup
+	for w := 0; w < workers; w++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := range indices {
+				app, err := c.getApplicationByID(ctx, listed[i].EntityID)
+				if err != nil {
+					select {
+					case failures <- err:
+					default:
+					}
+					cancel()
+					return
+				}
+				// Each worker owns a distinct index, so no lock is needed.
+				apps[i] = *app
+			}
+		}()
+	}
+
+feed:
+	for i := range listed {
+		select {
+		case indices <- i:
+		case <-ctx.Done():
+			break feed
+		}
+	}
+	close(indices)
+	wg.Wait()
+
+	select {
+	case err := <-failures:
+		return nil, err
+	default:
+	}
+	return apps, nil
+}
+
+func (c *Client) getApplicationByID(ctx context.Context, id string) (*Application, error) {
+	query := url.Values{}
+	if c.cfg.FetchMemberCounts {
+		query.Set("fetch_member_counts", "true")
+	}
+	if c.cfg.FetchUpdateStatus {
+		query.Set("fetch_update_status", "true")
+	}
+
+	var body applicationResponse
+	endpoint := c.endpoint("/groups/applications/"+id, query)
+	if err := c.authorizedJSON(ctx, http.MethodGet, endpoint, http.StatusOK, &body); err != nil {
+		return nil, fmt.Errorf("opsnet: getApplicationById %s: %w", id, err)
+	}
+	return &Application{
+		EntityID:     body.EntityID,
+		Name:         body.Name,
+		EntityType:   body.EntityType,
+		TierCount:    body.TierCount,
+		MemberCount:  body.MemberCount,
+		UpdateStatus: body.UpdateStatus,
+	}, nil
 }
 

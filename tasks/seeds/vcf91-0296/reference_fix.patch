+// listAllApplications walks operationId "listApplications" to the end.
+//
+// The cursor only advances once a page has come back successfully, so a token
+// that dies mid-walk costs exactly one retry of the page that failed: already
+// collected pages are neither dropped nor refetched.
+func (c *Client) listAllApplications(ctx context.Context) ([]entityID, int, int, error) {
+	var (
+		listed []entityID
+		pages  int
+		total  int
+		cursor string
+		first  = true
+		seen   = map[string]bool{}
+	)
+	for {
+		query := url.Values{}
+		if c.cfg.PageSize > 0 {
+			query.Set("size", strconv.Itoa(c.cfg.PageSize))
+		}
+		if !first {
+			query.Set("cursor", cursor)
+		}
+
+		var page pagedListResponse
+		endpoint := c.endpoint("/groups/applications", query)
+		if err := c.authorizedJSON(ctx, http.MethodGet, endpoint, http.StatusOK, &page); err != nil {
+			return nil, 0, 0, fmt.Errorf("opsnet: listApplications: %w", err)
+		}
+
+		pages++
+		total = page.TotalCount
+		listed = append(listed, page.Results...)
+
+		if page.Cursor == "" {
+			return listed, pages, total, nil
+		}
+		if seen[page.Cursor] {
+			return nil, 0, 0, fmt.Errorf("opsnet: listApplications: server repeated cursor %q", page.Cursor)
+		}
+		seen[page.Cursor] = true
+		cursor, first = page.Cursor, false
+	}

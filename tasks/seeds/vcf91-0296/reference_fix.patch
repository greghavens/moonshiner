+// endpoint builds an absolute URL for a specification path.
+func (c *Client) endpoint(path string, query url.Values) string {
+	endpoint := c.cfg.BaseURL + SpecBasePath + path
+	if len(query) > 0 {
+		endpoint += "?" + query.Encode()
+	}
+	return endpoint
+}
+
+// authorizedJSON issues a request against an operation that declares ApiKeyAuth
+// and decodes the response into out.
+//
+// A 401 means the token is invalid or expired, which the specification says can
+// happen to any request. It is retried exactly once with a fresh token: retrying
+// further would spin against a server that rejects every token, and the token
+// quota is finite.
+func (c *Client) authorizedJSON(ctx context.Context, method, endpoint string, wantStatus int, out any) error {
+	for attempt := 0; ; attempt++ {
+		current, err := c.session(ctx)
+		if err != nil {
+			return err
+		}
+
+		req, err := http.NewRequestWithContext(ctx, method, endpoint, nil)
+		if err != nil {
+			return err
+		}
+		req.Header.Set("Authorization", AuthHeaderPrefix+current.token)
+
+		status, body, err := c.send(req)
+		if err != nil {
+			return err
+		}
+
+		if status == http.StatusUnauthorized && attempt == 0 {
+			if _, err := c.refresh(ctx, current.gen); err != nil {
+				return fmt.Errorf("refreshing the expired auth token: %w", err)
+			}
+			continue
+		}
+		if status != wantStatus {
+			return apiError(status, body)
+		}
+		if out != nil {
+			if err := json.Unmarshal(body, out); err != nil {
+				return fmt.Errorf("decoding the response body: %w", err)
+			}
+		}
+		return nil
+	}
+}
+
+// session returns a usable token, minting one if the client has none or if the
+// one it holds is inside Config.RefreshSkew of its expiry.
+func (c *Client) session(ctx context.Context) (session, error) {
+	c.mu.Lock()
+	current := session{token: c.token, expiry: c.expiry, gen: c.gen}
+	c.mu.Unlock()
+
+	if current.token != "" && !c.dueForRefresh(current) {
+		return current, nil
+	}
+	return c.refresh(ctx, current.gen)
+}
+
+func (c *Client) dueForRefresh(current session) bool {
+	if c.cfg.RefreshSkew <= 0 || current.expiry.IsZero() {
+		return false
+	}
+	return !c.now().Add(c.cfg.RefreshSkew).Before(current.expiry)
+}
+
+// refresh replaces the token, unless another goroutine already replaced the
+// generation the caller was working from - in which case the caller adopts that
+// replacement instead of minting a redundant token.
+func (c *Client) refresh(ctx context.Context, staleGen int) (session, error) {
+	c.refreshMu.Lock()
+	defer c.refreshMu.Unlock()
+
+	c.mu.Lock()
+	if c.gen != staleGen && c.token != "" {
+		current := session{token: c.token, expiry: c.expiry, gen: c.gen}
+		c.mu.Unlock()
+		return current, nil
+	}
+	c.mu.Unlock()
+
+	token, expiry, err := c.createToken(ctx)
+	if err != nil {
+		return session{}, err
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.token, c.expiry = token, expiry
+	c.gen++
+	c.creates++
+	return session{token: token, expiry: expiry, gen: c.gen}, nil
+}
+
+// userCredential is the request body of operationId "create". Every property is
+// optional in the schema, so omitempty is what keeps unset fields off the wire
+// rather than sending them as "".
+type userCredential struct {
+	Username string  `json:"username,omitempty"`
+	Password string  `json:"password,omitempty"`
+	Domain   *domain `json:"domain,omitempty"`
+}
+
+type domain struct {
+	DomainType string `json:"domain_type,omitempty"`
+	// Value is "not required for LOCAL domain", so it is omitted when unset.
+	Value string `json:"value,omitempty"`
+}
+
+// createToken calls operationId "create". The operation declares "security: []",
+// so no Authorization header is sent.
+func (c *Client) createToken(ctx context.Context) (string, time.Time, error) {
+	creds := c.cfg.Credentials
+	payload := userCredential{Username: creds.Username, Password: creds.Password}
+	if creds.DomainType != "" {
+		payload.Domain = &domain{DomainType: creds.DomainType, Value: creds.DomainValue}
+	}
+	encoded, err := json.Marshal(payload)
+	if err != nil {
+		return "", time.Time{}, fmt.Errorf("opsnet: create: encoding UserCredential: %w", err)
+	}
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost,
+		c.endpoint("/auth/token", nil), bytes.NewReader(encoded))
+	if err != nil {
+		return "", time.Time{}, fmt.Errorf("opsnet: create: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+
+	status, body, err := c.send(req)
+	if err != nil {
+		return "", time.Time{}, fmt.Errorf("opsnet: create: %w", err)
+	}
+	if status != http.StatusOK {
+		return "", time.Time{}, fmt.Errorf("opsnet: create: %w", apiError(status, body))
+	}
+
+	var token struct {
+		Token  string `json:"token"`
+		Expiry int64  `json:"expiry"`
+	}
+	if err := json.Unmarshal(body, &token); err != nil {
+		return "", time.Time{}, fmt.Errorf("opsnet: create: decoding Token: %w", err)
+	}
+	if token.Token == "" {
+		return "", time.Time{}, errors.New("opsnet: create: response carried no token")
+	}
+
+	// Token.expiry is an epoch millisecond value: the schema description says
+	// "secs" but both examples in the specification are 13-digit millisecond
+	// timestamps. A zero or negative value means the server told us nothing
+	// useful, so proactive refresh is left switched off for that token.
+	var expiry time.Time
+	if token.Expiry > 0 {
+		expiry = time.UnixMilli(token.Expiry)
+	}
+	return token.Token, expiry, nil
+}
+
+func (c *Client) send(req *http.Request) (int, []byte, error) {
+	resp, err := c.http.Do(req)
+	if err != nil {
+		return 0, nil, err
+	}
+	defer func() { _ = resp.Body.Close() }()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return resp.StatusCode, nil, fmt.Errorf("reading the response body: %w", err)
+	}
+	return resp.StatusCode, body, nil
+}
+
+// apiError renders an ApiError response, falling back to the bare status when
+// the body is not one.
+func apiError(status int, body []byte) error {
+	var apiErr struct {
+		Code    int    `json:"code"`
+		Message string `json:"message"`
+	}
+	if err := json.Unmarshal(body, &apiErr); err == nil && apiErr.Message != "" {
+		return fmt.Errorf("HTTP %d: %s", status, apiErr.Message)
+	}
+	return fmt.Errorf("HTTP %d", status)
 }

{
  "contract_name": "VCF 9.1 SDDC Manager backup configuration task",
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "openapi": "3.0.1",
    "api_version": "9.1.0.0"
  },
  "operations": [
    {
      "operationId": "updateBackupConfiguration",
      "method": "PATCH",
      "path": "/v1/system/backup-configuration",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "BackupConfigurationSpec"
      },
      "responses": {
        "202": "Task",
        "400": "Error",
        "500": "Error"
      }
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "string"
        }
      ],
      "responses": {
        "200": "Task",
        "404": "Error",
        "500": "Error"
      }
    }
  ],
  "schemas": {
    "BackupConfigurationSpec": {
      "required": [],
      "properties": {
        "encryption": "Encryption (optional)",
        "backupLocations": "array<BackupLocation> (optional)",
        "backupSchedules": "array<BackupSchedule> (optional)"
      }
    },
    "BackupLocation": {
      "required": [
        "directoryPath",
        "port",
        "protocol",
        "server",
        "username"
      ],
      "properties": {
        "server": "string",
        "port": "integer(int32)",
        "protocol": "string",
        "username": "string",
        "password": "string (optional)",
        "directoryPath": "string",
        "sshFingerprint": "string (optional)"
      }
    },
    "Encryption": {
      "readOnly": true,
      "required": [
        "passphrase"
      ],
      "properties": {
        "passphrase": "string"
      }
    },
    "BackupSchedule": {
      "readOnly": true,
      "required": [
        "frequency",
        "resourceType"
      ],
      "properties": {
        "resourceType": "string",
        "takeScheduledBackups": "boolean (optional)",
        "frequency": "string",
        "daysOfWeek": "array<string> (optional)",
        "hourOfDay": "integer(int32) (optional)",
        "minuteOfHour": "integer(int32) (optional)",
        "takeBackupOnStateChange": "boolean (optional)",
        "retentionPolicy": "BackupRetentionPolicy (optional)"
      }
    },
    "BackupRetentionPolicy": {
      "required": [
        "numberOfMostRecentBackups"
      ],
      "properties": {
        "numberOfMostRecentBackups": "integer(int32), minimum 1, maximum 600",
        "numberOfDaysOfHourlyBackups": "integer(int32), minimum 0, maximum 14 (optional)",
        "numberOfDaysOfDailyBackups": "integer(int32), minimum 0, maximum 30 (optional)"
      }
    },
    "Task": {
      "required": [
        "creationTimestamp",
        "id",
        "name",
        "status"
      ],
      "properties": {
        "id": "string, readOnly",
        "name": "string, readOnly",
        "type": "string, readOnly",
        "status": "string, readOnly",
        "creationTimestamp": "string, readOnly",
        "completionTimestamp": "string, readOnly",
        "errors": "array<Error>, readOnly",
        "resolutionStatus": "string, readOnly",
        "isCancellable": "boolean, readOnly",
        "isRetryable": "boolean, readOnly"
      },
      "status_example_from_spec": "One among: PENDING, Pending, IN_PROGRESS, In Progress, SUCCESSFUL, Successful, FAILED, Failed, CANCELLED, Cancelled, COMPLETED_WITH_WARNING, SKIPPED, QUEUED, TIMED_OUT, Queued, Timed Out"
    },
    "Error": {
      "properties": {
        "errorCode": "string",
        "message": "string",
        "remediationMessage": "string",
        "referenceToken": "string"
      }
    }
  },
  "client_polling_policy": {
    "first_get": "immediate after the 202 Task is decoded",
    "non_terminal": [
      "PENDING",
      "QUEUED",
      "IN_PROGRESS"
    ],
    "successful_terminal": [
      "SUCCESSFUL",
      "COMPLETED_WITH_WARNING"
    ],
    "unsuccessful_terminal": [
      "FAILED",
      "CANCELLED",
      "SKIPPED",
      "TIMED_OUT"
    ],
    "pace": "injected and called only between consecutive GET polls",
    "bound": "MaxPolls counts GET requests"
  },
  "wire_requirements": {
    "authorization": "Authorization: Bearer <token> on every request",
    "accept": "Accept: application/json on every request",
    "content_type": "Content-Type: application/json on PATCH",
    "optional_properties": "unset optional properties are omitted, never emitted as null, empty strings, or empty arrays",
    "allowed_operations_only": [
      "PATCH /v1/system/backup-configuration",
      "GET /v1/tasks/{id}"
    ]
  }
}

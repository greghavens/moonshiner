{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch-0003:migration-plan:1.0",
  "title": "VCF Existing Estate Migration Plan",
  "type": "object",
  "required": ["schemaVersion", "estateId", "targetVcfVersion", "managementDomainId", "steps"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "targetVcfVersion": {"type": "string", "minLength": 1},
    "managementDomainId": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "componentId", "componentName", "componentType", "domainId", "currentVersion", "targetVersion", "action", "gates"],
        "additionalProperties": false,
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "componentId": {"type": "string", "minLength": 1},
          "componentName": {"type": "string", "minLength": 1},
          "componentType": {"type": "string", "enum": ["SDDC_MANAGER_VCF", "NSX_T_MANAGER", "VCENTER", "ESX_HOST"]},
          "domainId": {"type": "string", "minLength": 1},
          "currentVersion": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "action": {"type": "string", "enum": ["PRESERVE", "UPGRADE"]},
          "gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}

diff --git a/VcfArchitecture/VcfArchitecture.psm1 b/VcfArchitecture/VcfArchitecture.psm1
new file mode 100644
index 0000000..5d9f1cc
--- /dev/null
+++ b/VcfArchitecture/VcfArchitecture.psm1
@@ -0,0 +1,280 @@
+Set-StrictMode -Version Latest
+
+function Read-JsonHashtable {
+    param([Parameter(Mandatory)][string]$Path)
+    Get-Content -LiteralPath $Path -Raw | ConvertFrom-Json -AsHashtable
+}
+
+function Remove-NullProperties {
+    param([Parameter(Mandatory)][object]$Value)
+
+    if ($Value -is [System.Collections.IDictionary]) {
+        foreach ($key in @($Value.Keys)) {
+            if ($null -eq $Value[$key]) {
+                $Value.Remove($key)
+            }
+            else {
+                Remove-NullProperties -Value $Value[$key]
+            }
+        }
+    }
+    elseif ($Value -is [System.Collections.IEnumerable] -and $Value -isnot [string]) {
+        foreach ($item in $Value) {
+            if ($null -ne $item) {
+                Remove-NullProperties -Value $item
+            }
+        }
+    }
+}
+
+function ConvertTo-WireValue {
+    param([AllowNull()][object]$Value)
+
+    if ($null -eq $Value) {
+        return $null
+    }
+    if ($Value -is [System.Collections.IDictionary]) {
+        $result = [ordered]@{}
+        foreach ($key in $Value.Keys) {
+            if ($null -eq $Value[$key]) {
+                continue
+            }
+            $wireName = [string]$key
+            if ($wireName.Length -gt 0 -and [char]::IsUpper($wireName[0])) {
+                $wireName = $wireName.Substring(0, 1).ToLowerInvariant() + $wireName.Substring(1)
+            }
+            $result[$wireName] = ConvertTo-WireValue -Value $Value[$key]
+        }
+        return $result
+    }
+    if ($Value -is [System.Collections.IEnumerable] -and $Value -isnot [string]) {
+        $items = @(foreach ($item in $Value) {
+            ConvertTo-WireValue -Value $item
+        })
+        return ,$items
+    }
+    return $Value
+}
+
+function Write-JsonArtifact {
+    param(
+        [Parameter(Mandatory)][object]$Value,
+        [Parameter(Mandatory)][string]$Path
+    )
+
+    $jsonValue = $Value | ConvertTo-Json -Depth 100 | ConvertFrom-Json -AsHashtable
+    Remove-NullProperties -Value $jsonValue
+    $jsonValue = ConvertTo-WireValue -Value $jsonValue
+    $parent = Split-Path -Parent $Path
+    if ($parent) {
+        $null = New-Item -ItemType Directory -Path $parent -Force
+    }
+    $jsonValue | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $Path -Encoding utf8
+}
+
+function New-VcfGreenfieldSpec {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][string]$RequirementsPath,
+        [Parameter(Mandatory)][string]$CompatibilitySnapshotPath,
+        [string]$OutputPath,
+        [string]$VcenterRootPassword = '${VC_ROOT_PASS}'
+    )
+
+    $requirements = Read-JsonHashtable -Path $RequirementsPath
+    $snapshot = Read-JsonHashtable -Path $CompatibilitySnapshotPath
+    $versions = $snapshot.targetRelease.componentVersions
+
+    $hosts = @(
+        foreach ($hostRequirement in $requirements.site.greenfieldHosts) {
+            Initialize-VcfInstallerSddcHostSpec -Hostname $hostRequirement.id
+        }
+    )
+
+    $networkSpecs = @(
+        foreach ($network in $requirements.networking.networks) {
+            $ipRange = Initialize-VcfInstallerIpRange `
+                -StartIpAddress $network.rangeStart `
+                -EndIpAddress $network.rangeEnd
+            Initialize-VcfInstallerSddcNetworkSpec `
+                -NetworkType $network.networkType `
+                -Subnet $network.subnet `
+                -Gateway $network.gateway `
+                -IncludeIpAddressRanges @($ipRange) `
+                -VlanId $network.vlanId `
+                -Mtu $network.mtu `
+                -IpAddressVersion 'IPv4' `
+                -IpAddressAssignmentMode 'STATIC'
+        }
+    )
+
+    $dvsSpecs = @(
+        foreach ($switch in $requirements.networking.distributedSwitches) {
+            $nicMappings = @(
+                foreach ($entry in $switch.nicMap.GetEnumerator() | Sort-Object Key) {
+                    Initialize-VcfInstallerVmnicToUplink -Id $entry.Key -Uplink $entry.Value
+                }
+            )
+            Initialize-VcfInstallerDvsSpec `
+                -DvsName $switch.name `
+                -Networks $switch.networks `
+                -Mtu $switch.mtu `
+                -VmnicsToUplinks $nicMappings
+        }
+    )
+
+    $dnsSpec = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $requirements.networking.dnsDomain `
+        -Nameservers $requirements.networking.dnsServers
+    $vcenterSpec = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname $requirements.names.vcenterHostname `
+        -RootVcenterPassword $VcenterRootPassword `
+        -VmSize 'medium' `
+        -StorageSize 'lstorage' `
+        -SsoDomain 'vsphere.local' `
+        -Version $versions.VCENTER `
+        -UseExistingDeployment:$false
+    $clusterSpec = Initialize-VcfInstallerSddcClusterSpec `
+        -DatacenterName $requirements.names.datacenterName `
+        -ClusterName $requirements.names.clusterName `
+        -ClusterEvcMode 'INTEL_SAPPHIRERAPIDS'
+
+    $nsxManagers = @(
+        foreach ($hostname in $requirements.names.nsxManagerHostnames) {
+            Initialize-VcfInstallerNsxtManagerSpec -Hostname $hostname
+        }
+    )
+    $overlay = $requirements.networking.networks |
+        Where-Object networkType -EQ 'HOST_OVERLAY'
+    $poolRange = Initialize-VcfInstallerIpAddressPoolRangeSpec `
+        -Start $overlay.rangeStart `
+        -VarEnd $overlay.rangeEnd
+    $poolSubnet = Initialize-VcfInstallerIpAddressPoolSubnetSpec `
+        -IpAddressPoolRanges @($poolRange) `
+        -Cidr $overlay.subnet `
+        -Gateway $overlay.gateway
+    $pool = Initialize-VcfInstallerIpAddressPoolSpec `
+        -Name 'atl01-w01-tep-pool' `
+        -Description 'ATL01 workload host TEP pool' `
+        -Subnets @($poolSubnet)
+    $nsxtSpec = Initialize-VcfInstallerSddcNsxtSpec `
+        -NsxtManagers $nsxManagers `
+        -NsxtManagerSize 'medium' `
+        -VipFqdn $requirements.names.nsxVipFqdn `
+        -TransportVlanId $overlay.vlanId `
+        -IpAddressPoolSpec $pool `
+        -Version $versions.NSX_T_MANAGER `
+        -UseExistingDeployment:$false
+
+    $esaConfig = Initialize-VcfInstallerVsanEsaConfig -Enabled:$true
+    $vsanSpec = Initialize-VcfInstallerVsanSpec `
+        -DatastoreName $requirements.names.vsanDatastoreName `
+        -EsaConfig $esaConfig `
+        -FailuresToTolerate $requirements.availability.hostFailuresToTolerate
+    $datastoreSpec = Initialize-VcfInstallerSddcDatastoreSpec -VsanSpec $vsanSpec
+    $managerSpec = Initialize-VcfInstallerSddcManagerSpec `
+        -Hostname $requirements.names.sddcManagerHostname `
+        -Version $versions.SDDC_MANAGER_VCF `
+        -UseExistingDeployment:$false
+    $securitySpec = Initialize-VcfInstallerSecuritySpec -EsxiCertsMode 'VMCA'
+
+    $spec = Initialize-VcfInstallerSddcSpec `
+        -SddcId $requirements.designId `
+        -WorkflowType $snapshot.greenfield.workflowType `
+        -HostSpecs $hosts `
+        -Version $snapshot.targetRelease.vcfVersion `
+        -VcenterSpec $vcenterSpec `
+        -ClusterSpec $clusterSpec `
+        -DvsSpecs $dvsSpecs `
+        -NsxtSpec $nsxtSpec `
+        -NetworkSpecs $networkSpecs `
+        -DnsSpec $dnsSpec `
+        -NtpServers $requirements.networking.ntpServers `
+        -SddcManagerSpec $managerSpec `
+        -ManagementPoolName $requirements.names.managementPoolName `
+        -CeipEnabled:$false `
+        -SkipEsxThumbprintValidation:$false `
+        -SkipGatewayPingValidation:$false `
+        -SecuritySpec $securitySpec `
+        -DatastoreSpec $datastoreSpec `
+        -VcfInstanceName $requirements.names.vcfInstanceName
+
+    if ($OutputPath) {
+        Write-JsonArtifact -Value $spec -Path $OutputPath
+    }
+    $spec
+}
+
+function New-VcfEstateMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][string]$InventoryPath,
+        [Parameter(Mandatory)][string]$CompatibilitySnapshotPath,
+        [string]$OutputPath
+    )
+
+    $inventory = Read-JsonHashtable -Path $InventoryPath
+    $snapshot = Read-JsonHashtable -Path $CompatibilitySnapshotPath
+    $paths = @{}
+    foreach ($path in $snapshot.migrationPaths) {
+        $paths[$path.componentType] = $path
+    }
+
+    $preserved = @($inventory.components | Where-Object { -not $_.mutable } | Sort-Object id)
+    $workload = @(
+        $inventory.components |
+            Where-Object mutable |
+            Sort-Object @{Expression = { $paths[$_.componentType].sequence }}, id
+    )
+    $order = 0
+    $steps = @(
+        foreach ($component in @($preserved) + @($workload)) {
+            $order++
+            if ($component.mutable) {
+                $path = $paths[$component.componentType]
+                $targetVersion = $path.toVersion
+                $action = 'UPGRADE'
+                $gates = @($path.requiredGates)
+            }
+            else {
+                $targetVersion = $component.version
+                $action = $snapshot.preservation.action
+                $gates = @($snapshot.preservation.requiredGates)
+            }
+            [ordered]@{
+                order = $order
+                componentId = $component.id
+                componentName = $component.name
+                componentType = $component.componentType
+                domainId = $component.domainId
+                currentVersion = $component.version
+                targetVersion = $targetVersion
+                action = $action
+                gates = $gates
+            }
+        }
+    )
+    $plan = [ordered]@{
+        schemaVersion = '1.0'
+        estateId = $inventory.estateId
+        targetVcfVersion = $inventory.targetVcfVersion
+        managementDomainId = $inventory.managementDomainId
+        steps = $steps
+    }
+    if ($OutputPath) {
+        Write-JsonArtifact -Value $plan -Path $OutputPath
+    }
+    [pscustomobject]$plan
+}
+
+function Test-VcfGreenfieldSpec {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory, ValueFromPipeline)][object]$SddcSpec
+    )
+    process {
+        Invoke-VcfInstallerValidateSddcSpec -SddcSpec $SddcSpec
+    }
+}
+
+Export-ModuleMember -Function New-VcfGreenfieldSpec, New-VcfEstateMigrationPlan, Test-VcfGreenfieldSpec

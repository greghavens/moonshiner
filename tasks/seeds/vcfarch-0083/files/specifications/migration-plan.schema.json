{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch:migration-plan:1.0",
  "title": "Brownfield VCF migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "estate_id",
    "target_release",
    "target_sddc_spec",
    "domains",
    "components",
    "placements",
    "gates",
    "steps"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "estate_id": {"type": "string", "minLength": 1},
    "target_release": {"type": "string", "minLength": 1},
    "target_sddc_spec": {"type": "object"},
    "domains": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/domain"}
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    },
    "placements": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/placement"}
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gate"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "kind",
        "cluster_ids",
        "component_ids",
        "current_release",
        "target_release"
      ],
      "properties": {
        "domain_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["management", "workload"]},
        "cluster_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "component_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "current_release": {"type": "string", "minLength": 1},
        "target_release": {"type": "string", "minLength": 1}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "product",
        "current_version",
        "target_version",
        "disposition",
        "step_orders",
        "gate_ids"
      ],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "current_version": {"type": "string", "minLength": 1},
        "target_version": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["upgrade", "replace", "retire"]},
        "step_orders": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1}
        },
        "gate_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "product",
        "domain_id",
        "cluster_id",
        "deployment_model",
        "size",
        "demand",
        "resources"
      ],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "domain_id": {"type": "string", "minLength": 1},
        "cluster_id": {"type": "string", "minLength": 1},
        "deployment_model": {"type": "string", "minLength": 1},
        "size": {"type": "string", "minLength": 1},
        "demand": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "number", "minimum": 0}
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node_count",
            "vcpu_per_node",
            "memory_gib_per_node",
            "storage_tib_per_node",
            "total_vcpu",
            "total_memory_gib",
            "total_storage_tib"
          ],
          "properties": {
            "node_count": {"type": "integer", "minimum": 1},
            "vcpu_per_node": {"type": "integer", "minimum": 1},
            "memory_gib_per_node": {"type": "integer", "minimum": 1},
            "storage_tib_per_node": {"type": "number", "exclusiveMinimum": 0},
            "total_vcpu": {"type": "integer", "minimum": 1},
            "total_memory_gib": {"type": "integer", "minimum": 1},
            "total_storage_tib": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "operator", "version"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "operator": {"const": "at_version"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "kind", "description", "conditions"],
      "properties": {
        "gate_id": {"type": "string", "minLength": 1},
        "kind": {"const": "version_prerequisite"},
        "description": {"type": "string", "minLength": 1},
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/condition"}
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "component_id",
        "product",
        "from_version",
        "target_version",
        "action",
        "gate_ids"
      ],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "component_id": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "from_version": {"type": "string", "minLength": 1},
        "target_version": {"type": "string", "minLength": 1},
        "action": {"enum": ["upgrade", "deploy_parallel", "retire"]},
        "gate_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

index 0000000..d473668
--- /dev/null
+++ b/vcf_arch/compiler.py
@@ -0,0 +1,311 @@
+"""Compile a deterministic brownfield VCF architecture from pinned inputs."""
+
+from __future__ import annotations
+
+import heapq
+import json
+import math
+from pathlib import Path
+from typing import Any
+
+
+def read_json(path: Path) -> dict[str, Any]:
+    value = json.loads(path.read_text(encoding="utf-8"))
+    if not isinstance(value, dict):
+        raise ValueError(f"{path} must contain a JSON object")
+    return value
+
+
+def write_json(path: Path, value: dict[str, Any]) -> None:
+    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+
+def _token(component_id: str, target: str) -> str:
+    return f"{component_id}@{target}"
+
+
+def _split_token(token: str) -> tuple[str, str]:
+    component_id, separator, target = token.rpartition("@")
+    if not separator or not component_id or not target:
+        raise ValueError(f"invalid transition token: {token}")
+    return component_id, target
+
+
+def _ordered_transitions(
+    inventory: dict[str, Any], compatibility: dict[str, Any]
+) -> tuple[list[str], dict[str, dict[str, Any]], dict[str, set[str]]]:
+    nodes: dict[str, dict[str, Any]] = {}
+    successors: dict[str, set[str]] = {}
+    predecessors: dict[str, set[str]] = {}
+
+    def add_edge(before: str, after: str) -> None:
+        if before not in nodes or after not in nodes:
+            raise ValueError(f"precedence names unknown transition: {before} -> {after}")
+        successors.setdefault(before, set()).add(after)
+        predecessors.setdefault(after, set()).add(before)
+
+    for component in inventory["components"]:
+        component_id = component["component_id"]
+        try:
+            path = compatibility["product_paths"][component["product_key"]]
+        except KeyError as error:
+            raise ValueError(f"no path for {component_id}") from error
+        if len(path) < 2 or path[0] != component["version"]:
+            raise ValueError(f"path does not begin at inventory version for {component_id}")
+        previous_token: str | None = None
+        for source, target in zip(path, path[1:]):
+            token = _token(component_id, target)
+            if token in nodes:
+                raise ValueError(f"duplicate transition: {token}")
+            nodes[token] = {
+                "component": component,
+                "from_version": source,
+                "target_version": target,
+            }
+            successors[token] = set()
+            predecessors[token] = set()
+            if previous_token is not None:
+                add_edge(previous_token, token)
+            previous_token = token
+
+    for before, after in compatibility["precedence"]:
+        add_edge(before, after)
+
+    indegree = {token: len(predecessors[token]) for token in nodes}
+    ready = [token for token, count in indegree.items() if count == 0]
+    heapq.heapify(ready)
+    ordered: list[str] = []
+    while ready:
+        token = heapq.heappop(ready)
+        ordered.append(token)
+        for successor in sorted(successors[token]):
+            indegree[successor] -= 1
+            if indegree[successor] == 0:
+                heapq.heappush(ready, successor)
+    if len(ordered) != len(nodes):
+        raise ValueError("compatibility precedence contains a cycle")
+    return ordered, nodes, predecessors
+
+
+def _steps_and_gates(
+    inventory: dict[str, Any], compatibility: dict[str, Any]
+) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
+    ordered, nodes, predecessors = _ordered_transitions(inventory, compatibility)
+    actions = compatibility.get("transition_actions", {})
+    steps: list[dict[str, Any]] = []
+    gates: list[dict[str, Any]] = []
+    for order, token in enumerate(ordered, 1):
+        node = nodes[token]
+        component = node["component"]
+        target = node["target_version"]
+        gate_id = f"gate-{order:03d}"
+        conditions = [{
+            "component_id": component["component_id"],
+            "operator": "at_version",
+            "version": node["from_version"],
+        }]
+        present = {(component["component_id"], node["from_version"])}
+        for predecessor in sorted(predecessors[token]):
+            predecessor_component, predecessor_target = _split_token(predecessor)
+            condition_key = (predecessor_component, predecessor_target)
+            if condition_key not in present:
+                conditions.append({
+                    "component_id": predecessor_component,
+                    "operator": "at_version",
+                    "version": predecessor_target,
+                })
+                present.add(condition_key)
+        action = actions.get(token, "retire" if target == "retired" else "upgrade")
+        gates.append({
+            "gate_id": gate_id,
+            "kind": "version_prerequisite",
+            "description": f"Pinned version prerequisites for {token}",
+            "conditions": conditions,
+        })
+        steps.append({
+            "order": order,
+            "component_id": component["component_id"],
+            "product": component["product"],
+            "from_version": node["from_version"],
+            "target_version": target,
+            "action": action,
+            "gate_ids": [gate_id],
+        })
+    return steps, gates
+
+
+def _component_summaries(
+    inventory: dict[str, Any], compatibility: dict[str, Any],
+    steps: list[dict[str, Any]]
+) -> list[dict[str, Any]]:
+    result: list[dict[str, Any]] = []
+    for component in inventory["components"]:
+        component_steps = [
+            item for item in steps if item["component_id"] == component["component_id"]
+        ]
+        target = compatibility["product_paths"][component["product_key"]][-1]
+        disposition = (
+            "retire" if target == "retired"
+            else "replace" if component["component_id"] == "aria-operations-logs"
+            else "upgrade"
+        )
+        result.append({
+            "component_id": component["component_id"],
+            "product": component["product"],
+            "current_version": component["version"],
+            "target_version": target,
+            "disposition": disposition,
+            "step_orders": [item["order"] for item in component_steps],
+            "gate_ids": [item["gate_ids"][0] for item in component_steps],
+        })
+    return result
+
+
+def _matching_tier(demand: dict[str, Any], tiers: list[dict[str, Any]]) -> dict[str, Any]:
+    for tier in tiers:
+        if all(demand.get(name, math.inf) <= maximum
+               for name, maximum in tier["max_demand"].items()):
+            return tier
+    raise ValueError(f"demand {demand} exceeds all pinned sizing tiers")
+
+
+def _placements(
+    inventory: dict[str, Any], compatibility: dict[str, Any]
+) -> list[dict[str, Any]]:
+    management = next(
+        domain for domain in inventory["domains"] if domain["kind"] == "management"
+    )
+    cluster_id = management["cluster_ids"][0]
+    result: list[dict[str, Any]] = []
+    for product_key, rule in compatibility["placement_rules"].items():
+        demand = inventory["demand"][product_key]
+        tier = _matching_tier(demand, rule["tiers"])
+        storage_per_node = float(tier["storage_tib_per_node"])
+        if product_key == "operations_logs":
+            retained_per_node = (
+                float(demand["daily_ingest_gib"])
+                * float(demand["retention_days"])
+                * float(rule["retention_overhead_factor"])
+                / 1024.0
+                / int(tier["node_count"])
+            )
+            storage_per_node = max(
+                storage_per_node, math.ceil(retained_per_node * 10.0) / 10.0
+            )
+        node_count = int(tier["node_count"])
+        resources = {
+            "node_count": node_count,
+            "vcpu_per_node": int(tier["vcpu_per_node"]),
+            "memory_gib_per_node": int(tier["memory_gib_per_node"]),
+            "storage_tib_per_node": storage_per_node,
+            "total_vcpu": node_count * int(tier["vcpu_per_node"]),
+            "total_memory_gib": node_count * int(tier["memory_gib_per_node"]),
+            "total_storage_tib": round(node_count * storage_per_node, 3),
+        }
+        result.append({
+            "component_id": rule["component_id"],
+            "product": rule["product"],
+            "domain_id": management["domain_id"],
+            "cluster_id": cluster_id,
+            "deployment_model": rule["deployment_model"],
+            "size": tier["size"],
+            "demand": demand,
+            "resources": resources,
+        })
+    return result
+
+
+def _target_sddc_spec(
+    inventory: dict[str, Any], placements: list[dict[str, Any]]
+) -> dict[str, Any]:
+    management = next(
+        domain for domain in inventory["domains"] if domain["kind"] == "management"
+    )
+    components = {item["component_id"]: item for item in inventory["components"]}
+    placement_by_id = {item["component_id"]: item for item in placements}
+    endpoints = inventory["service_endpoints"]
+    networks = [
+        {
+            "networkType": item["network_type"],
+            "vlanId": item["vlan_id"],
+            "subnet": item["subnet"],
+            "gateway": item["gateway"],
+            "subnetMask": item["subnet_mask"],
+            "mtu": item["mtu"],
+        }
+        for item in inventory["management_networks"]
+    ]
+    operations_nodes = [
+        {"hostname": hostname, "type": role}
+        for hostname, role in zip(
+            endpoints["operations_nodes"], ["master", "replica", "data"]
+        )
+    ]
+    management_vcenter = components["mgmt-vcenter"]
+    target = inventory["target_release"]
+    return {
+        "sddcId": management["domain_id"],
+        "workflowType": "VCF",
+        "version": target,
+        "vcenterSpec": {
+            "vcenterHostname": management_vcenter["fqdn"],
+            "rootVcenterPassword": "${VC_PASS}",
+            "version": target,
+            "useExistingDeployment": True,
+            "sslThumbprint": management_vcenter["ssl_thumbprint"],
+        },
+        "networkSpecs": networks,
+        "dnsSpec": {
+            "subdomain": inventory["site"]["dns_domain"],
+            "nameservers": inventory["site"]["dns_servers"],
+        },
+        "ntpServers": inventory["site"]["ntp_servers"],
+        "vcfOperationsSpec": {
+            "nodes": operations_nodes,
+            "applianceSize": placement_by_id["aria-operations"]["size"],
+            "loadBalancerFqdn": endpoints["operations_load_balancer"],
+            "useExistingDeployment": True,
+            "version": target,
+        },
+        "vcfAutomationSpec": {
+            "hostname": endpoints["automation_hostname"],
+            "platformFqdn": endpoints["automation_platform_fqdn"],
+            "ipPool": endpoints["automation_ip_pool"],
+            "internalClusterCidr": endpoints["automation_internal_cluster_cidr"],
+            "nodePrefix": endpoints["automation_node_prefix"],
+            "size": placement_by_id["aria-automation"]["size"],
+            "version": target,
+            "useExistingDeployment": True,
+        },
+    }
+
+
+def compile_plan(
+    inventory: dict[str, Any], compatibility: dict[str, Any]
+) -> dict[str, Any]:
+    if inventory.get("target_release") != compatibility.get("target_release"):
+        raise ValueError("inventory and compatibility snapshot target different releases")
+    steps, gates = _steps_and_gates(inventory, compatibility)
+    placements = _placements(inventory, compatibility)
+    domains = [
+        {
+            "domain_id": item["domain_id"],
+            "kind": item["kind"],
+            "cluster_ids": item["cluster_ids"],
+            "component_ids": item["component_ids"],
+            "current_release": inventory["current_release"],
+            "target_release": inventory["target_release"],
+        }
+        for item in inventory["domains"]
+    ]
+    return {
+        "schema_version": "1.0",
+        "estate_id": inventory["estate_id"],
+        "target_release": inventory["target_release"],
+        "target_sddc_spec": _target_sddc_spec(inventory, placements),
+        "domains": domains,
+        "components": _component_summaries(inventory, compatibility, steps),
+        "placements": placements,
+        "gates": gates,
+        "steps": steps,
+    }

+++ b/vcf_guest_customization/customization.py
@@ -0,0 +1,148 @@
+"""Apply a named guest customization specification, gated by the precheck.
+
+Three operations from the pinned VCF 9.0 vCenter specification are used, in
+this order:
+
+  1. ``Vcenter.VM_list``                       resolve the name to an identifier
+  2. ``Vcenter.Vm.Guest.Customization_check``  the precheck
+  3. ``Vcenter.Vm.Guest.Customization_set``    the mutation
+
+Step 3 runs only when step 2 reported ``SUPPORTED``. Anything else, including a
+response with no ``check_status`` at all, leaves the virtual machine untouched.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Optional, Sequence
+from urllib.parse import quote
+
+from .errors import (
+    AmbiguousVmError,
+    CustomizationPrecheckFailed,
+    VmNotFoundError,
+)
+
+LIST_OPERATION = "Vcenter.VM_list"
+CHECK_OPERATION = "Vcenter.Vm.Guest.Customization_check"
+SET_OPERATION = "Vcenter.Vm.Guest.Customization_set"
+
+# The order Vcenter.VM_list declares its query parameters in.
+LIST_FILTER_ORDER = (
+    "vms",
+    "names",
+    "folders",
+    "datacenters",
+    "hosts",
+    "clusters",
+    "resource_pools",
+    "power_states",
+)
+
+CUSTOMIZABLE = "SUPPORTED"
+
+
+@dataclass(frozen=True)
+class CustomizationResult:
+    """What was applied, and what the precheck said before it was applied."""
+
+    vm: str
+    vm_name: str
+    power_state: str
+    spec_name: Optional[str]
+    check_status: str
+    supported_guest_os: Optional[bool]
+    supported_power_state: Optional[bool]
+
+
+def _customization_path(vm: str) -> str:
+    return "/vcenter/vm/" + quote(vm, safe="") + "/guest/customization"
+
+
+def _list_query(**filters) -> list:
+    """Build the query pairs, omitting every filter the caller left unset."""
+    pairs = []
+    for name in LIST_FILTER_ORDER:
+        values = filters.get(name)
+        if not values:
+            continue
+        for value in values:
+            pairs.append((name, value))
+    return pairs
+
+
+def resolve_vm(
+    session,
+    vm_name: str,
+    *,
+    folders: Optional[Sequence[str]] = None,
+    power_states: Optional[Sequence[str]] = None,
+) -> dict:
+    """Return the one Vcenter.VM.Summary whose name is ``vm_name``."""
+    summaries = session.request(
+        LIST_OPERATION,
+        "GET",
+        "/vcenter/vm",
+        query=_list_query(
+            names=[vm_name],
+            folders=list(folders) if folders else None,
+            power_states=list(power_states) if power_states else None,
+        ),
+    )
+    summaries = list(summaries or ())
+    if not summaries:
+        raise VmNotFoundError(vm_name)
+    if len(summaries) > 1:
+        raise AmbiguousVmError(vm_name, [summary["vm"] for summary in summaries])
+    return summaries[0]
+
+
+def apply_named_customization(
+    session,
+    vm_name: str,
+    spec_name: Optional[str],
+    *,
+    folders: Optional[Sequence[str]] = None,
+    power_states: Optional[Sequence[str]] = None,
+) -> CustomizationResult:
+    """Precheck a virtual machine, then apply ``spec_name`` only if it passed.
+
+    Pass ``spec_name=None`` to clear any pending customization, which is a
+    SetSpec with every member absent.
+    """
+    summary = resolve_vm(session, vm_name, folders=folders, power_states=power_states)
+    vm = summary["vm"]
+
+    info = session.request(
+        CHECK_OPERATION,
+        "POST",
+        _customization_path(vm),
+        query=[("action", "check")],
+    )
+    info = info if isinstance(info, dict) else {}
+    check_status = info.get("check_status")
+    supported_guest_os = info.get("supported_guest_os")
+    supported_power_state = info.get("supported_power_state")
+
+    if check_status != CUSTOMIZABLE:
+        # Fail closed: the mutating PUT is not issued, so nothing is changed.
+        raise CustomizationPrecheckFailed(
+            vm,
+            summary.get("name", vm_name),
+            check_status,
+            supported_guest_os,
+            supported_power_state,
+        )
+
+    body = {} if spec_name is None else {"name": spec_name}
+    session.request(SET_OPERATION, "PUT", _customization_path(vm), body=body)
+
+    return CustomizationResult(
+        vm=vm,
+        vm_name=summary.get("name", vm_name),
+        power_state=summary.get("power_state"),
+        spec_name=spec_name,
+        check_status=check_status,
+        supported_guest_os=supported_guest_os,
+        supported_power_state=supported_power_state,
+    )
diff --git a/vcf_guest_customization/errors.py b/vcf_guest_customization/errors.py
new file mode 100644
index 0000000..152772b
--- /dev/null
+++ b/vcf_guest_customization/errors.py
@@ -0,0 +1,81 @@
+"""Errors raised by the guest customization client.
+
+None of these carry the vmware-api-session-id header value, so a traceback can
+be logged without leaking the session that produced it.
+"""
+
+from __future__ import annotations
+
+
+class CustomizationError(Exception):
+    """Base class for every error this package raises."""
+
+
+class VmNotFoundError(CustomizationError):
+    """No virtual machine in the inventory carries the requested name."""
+
+    def __init__(self, vm_name: str) -> None:
+        super().__init__(f"No virtual machine is named {vm_name!r}.")
+        self.vm_name = vm_name
+
+
+class AmbiguousVmError(CustomizationError):
+    """More than one virtual machine carries the requested name."""
+
+    def __init__(self, vm_name: str, matches) -> None:
+        self.matches = tuple(matches)
+        super().__init__(
+            f"{len(self.matches)} virtual machines are named {vm_name!r}: "
+            + ", ".join(self.matches)
+        )
+        self.vm_name = vm_name
+
+
+class CustomizationPrecheckFailed(CustomizationError):
+    """The precheck did not report SUPPORTED, so nothing was changed."""
+
+    def __init__(
+        self,
+        vm: str,
+        vm_name: str,
+        check_status,
+        supported_guest_os,
+        supported_power_state,
+    ) -> None:
+        reasons = []
+        if supported_guest_os is False:
+            reasons.append("the guest OS is not supported")
+        if supported_power_state is False:
+            reasons.append("the current power state is not supported")
+        detail = f" ({'; '.join(reasons)})" if reasons else ""
+        super().__init__(
+            f"{vm_name} ({vm}) is not customizable: check_status="
+            f"{check_status!r}{detail}. Nothing was changed."
+        )
+        self.vm = vm
+        self.vm_name = vm_name
+        self.check_status = check_status
+        self.supported_guest_os = supported_guest_os
+        self.supported_power_state = supported_power_state
+
+
+class CustomizationApiError(CustomizationError):
+    """vCenter answered an operation with a standard vAPI error."""
+
+    def __init__(
+        self,
+        operation_id: str,
+        status_code: int,
+        error_type,
+        messages=(),
+    ) -> None:
+        self.messages = tuple(messages)
+        detail = " ".join(self.messages).strip()
+        super().__init__(
+            f"{operation_id} answered HTTP {status_code}"
+            + (f" ({error_type})" if error_type else "")
+            + (f": {detail}" if detail else "")
+        )
+        self.operation_id = operation_id
+        self.status_code = status_code
+        self.error_type = error_type
diff --git a/vcf_guest_customization/session.py b/vcf_guest_customization/session.py
new file mode 100644
index 0000000..b2a60a4
--- /dev/null
+++ b/vcf_guest_customization/session.py
@@ -0,0 +1,93 @@
+"""Transport for the vSphere Automation API for vCenter.
+
+The wire details here come from docs/contract.json, which is projected from
+specifications/vsphere/openapi/automation/vcenter.yaml at tag 9.0.0.0 of
+vmware/vcf-api-specs:
+
+  * every request target is the operation path appended to the /api base path
+    of the ``https://{host}/api`` server template;
+  * the api_key_auth security scheme is the ``vmware-api-session-id`` header;
+  * an operation that declares no requestBody is sent with no body at all.
+"""
+
+from __future__ import annotations
+
+import json
+import urllib.error
+import urllib.request
+from urllib.parse import urlencode
+
+BASE_PATH = "/api"
+SESSION_HEADER = "vmware-api-session-id"
+
+_UNSET = object()
+
+
+class _NoRedirect(urllib.request.HTTPRedirectHandler):
+    """Expose redirect responses to the normal non-2xx error decoder."""
+
+    def redirect_request(self, request, fp, code, message, headers, newurl):
+        return None
+
+
+class VcenterSession:
+    """A vCenter endpoint plus the session id every operation requires."""
+
+    def __init__(self, base_url: str, session_id: str, *, timeout: float = 30.0) -> None:
+        self.base_url = base_url.rstrip("/")
+        self.timeout = timeout
+        self._session_id = session_id
+        self._opener = urllib.request.build_opener(_NoRedirect)
+
+    def request(self, operation_id, method, path, *, query=None, body=_UNSET):
+        """Issue one contract operation and return its decoded response.
+
+        ``query`` is a sequence of (name, value) pairs already in the order the
+        specification declares its parameters, so a filter the caller never
+        supplied is simply absent from the sequence and never reaches the wire.
+        ``body`` is omitted entirely for operations that declare no requestBody.
+        """
+        url = self.base_url + BASE_PATH + path
+        if query:
+            url += "?" + urlencode(list(query))
+
+        headers = {"Accept": "application/json", SESSION_HEADER: self._session_id}
+        data = None
+        if body is not _UNSET:
+            data = json.dumps(body, separators=(",", ":")).encode("utf-8")
+            headers["Content-Type"] = "application/json"
+        elif method in ("POST", "PUT", "PATCH"):
+            # No requestBody in the specification: send a genuinely empty body
+            # rather than letting urllib invent a form-encoded content type.
+            headers["Content-Length"] = "0"
+
+        request = urllib.request.Request(url, data=data, headers=headers, method=method)
+        try:
+            with self._opener.open(request, timeout=self.timeout) as response:
+                payload = response.read()
+                if response.status == 204 or not payload:
+                    return None
+                return json.loads(payload.decode("utf-8"))
+        except urllib.error.HTTPError as failure:
+            raise self._to_api_error(operation_id, failure) from None
+
+    @staticmethod
+    def _to_api_error(operation_id, failure):
+        from .errors import CustomizationApiError
+
+        error_type = None
+        messages = []
+        try:
+            payload = json.loads(failure.read().decode("utf-8"))
+        except Exception:  # noqa: BLE001 - a body that will not decode is not fatal
+            payload = None
+        if isinstance(payload, dict):
+            error_type = payload.get("error_type")
+            for message in payload.get("messages") or ():
+                if isinstance(message, dict):
+                    text = message.get("default_message")
+                    if isinstance(text, str):
+                        messages.append(text)
+        return CustomizationApiError(
+            operation_id, failure.code, error_type, tuple(messages)
+        )

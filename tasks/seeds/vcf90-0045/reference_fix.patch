+"""Guest customization for VMware Cloud Foundation 9.0 vCenter.
+
+A standard-library-only client for three operations of the vSphere Automation
+API for vCenter, projected into docs/contract.json from
+specifications/vsphere/openapi/automation/vcenter.yaml at tag 9.0.0.0 of
+vmware/vcf-api-specs.
+
+The customization precheck gates the mutation: when
+Vcenter.Vm.Guest.Customization_check does not report SUPPORTED,
+Vcenter.Vm.Guest.Customization_set is never issued.
+"""
+
+from .customization import (
+    CHECK_OPERATION,
+    CUSTOMIZABLE,
+    LIST_FILTER_ORDER,
+    LIST_OPERATION,
+    SET_OPERATION,
+    CustomizationResult,
+    apply_named_customization,
+    resolve_vm,
+)
+from .errors import (
+    AmbiguousVmError,
+    CustomizationApiError,
+    CustomizationError,
+    CustomizationPrecheckFailed,
+    VmNotFoundError,
+)
+from .session import SESSION_HEADER, VcenterSession
+
+__all__ = [
+    "AmbiguousVmError",
+    "CHECK_OPERATION",
+    "CUSTOMIZABLE",
+    "CustomizationApiError",
+    "CustomizationError",
+    "CustomizationPrecheckFailed",
+    "CustomizationResult",
+    "LIST_FILTER_ORDER",
+    "LIST_OPERATION",
+    "SESSION_HEADER",
+    "SET_OPERATION",
+    "VcenterSession",
+    "VmNotFoundError",
+    "apply_named_customization",
+    "resolve_vm",
+]

 package installer
 
 import (
+	"bytes"
 	"context"
+	"encoding/json"
 	"errors"
 	"fmt"
+	"io"
 	"net/http"
 	"net/url"
 )
@@ -120,8 +123,68 @@ func (e *PrecheckError) Error() string {
 	return fmt.Sprintf("VCF Installer precheck did not succeed (executionStatus=%s, resultStatus=%s)", e.ExecutionStatus, e.ResultStatus)
 }
 
 // PrecheckAndDeploy validates spec and starts the installation only after a
 // terminal, successful validation result.
 func (c *Client) PrecheckAndDeploy(ctx context.Context, spec SddcSpec) (*SddcTask, error) {
-	return nil, ErrNotImplemented
+	body, err := json.Marshal(spec)
+	if err != nil {
+		return nil, fmt.Errorf("marshal SDDC spec: %w", err)
+	}
+
+	var validation Validation
+	if err := c.postJSON(ctx, OperationValidateSddcSpec, "/v1/sddcs/validations", body, &validation, http.StatusOK, http.StatusAccepted); err != nil {
+		return nil, err
+	}
+	if validation.ExecutionStatus != "COMPLETED" || validation.ResultStatus != "SUCCEEDED" {
+		return nil, &PrecheckError{
+			ExecutionStatus: validation.ExecutionStatus,
+			ResultStatus:    validation.ResultStatus,
+		}
+	}
+
+	var task SddcTask
+	if err := c.postJSON(ctx, OperationDeploySddc, "/v1/sddcs", body, &task, http.StatusAccepted); err != nil {
+		return nil, err
+	}
+	return &task, nil
 }
+
+func (c *Client) postJSON(ctx context.Context, operationID, path string, body []byte, result any, successStatuses ...int) error {
+	endpoint := c.baseURL.ResolveReference(&url.URL{Path: path})
+	request, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint.String(), bytes.NewReader(body))
+	if err != nil {
+		return fmt.Errorf("create %s request: %w", operationID, err)
+	}
+	request.Header.Set("Accept", "application/json")
+	request.Header.Set("Content-Type", "application/json")
+	if c.bearerToken != "" {
+		request.Header.Set("Authorization", "Bearer "+c.bearerToken)
+	}
+
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		return fmt.Errorf("call %s: %w", operationID, err)
+	}
+	defer response.Body.Close()
+
+	responseBody, err := io.ReadAll(response.Body)
+	if err != nil {
+		return fmt.Errorf("read %s response: %w", operationID, err)
+	}
+	if !containsStatus(successStatuses, response.StatusCode) {
+		return &APIError{OperationID: operationID, StatusCode: response.StatusCode, Body: string(responseBody)}
+	}
+	if err := json.Unmarshal(responseBody, result); err != nil {
+		return fmt.Errorf("decode %s response: %w", operationID, err)
+	}
+	return nil
+}
+
+func containsStatus(statuses []int, candidate int) bool {
+	for _, status := range statuses {
+		if status == candidate {
+			return true
+		}
+	}
+	return false
+}

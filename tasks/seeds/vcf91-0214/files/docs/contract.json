{
  "contract_version": 1,
  "scope": "Spec-derived operation and wire-schema subset exercised by the precheck-gated deployment client",
  "source": {
    "title": "VMware Cloud Foundation Installer API Reference Guide",
    "api_version": "9.1.0.0",
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/vcf-installer/vcf-installer-openapi.json",
    "license": "Apache-2.0"
  },
  "operations": [
    {
      "operationId": "validateSddcSpec",
      "method": "POST",
      "path": "/v1/sddcs/validations",
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "SddcSpec"
      },
      "success_responses": {
        "200": "Validation",
        "202": "Validation"
      }
    },
    {
      "operationId": "deploySddc",
      "method": "POST",
      "path": "/v1/sddcs",
      "query_parameters": [
        {
          "name": "skipValidations",
          "type": "boolean",
          "required": false,
          "default": false
        }
      ],
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "SddcSpec"
      },
      "success_responses": {
        "202": "SddcTask"
      }
    }
  ],
  "schemas": {
    "SddcSpec": {
      "type": "object",
      "required": [
        "dnsSpec",
        "networkSpecs",
        "sddcId",
        "vcenterSpec"
      ],
      "properties": {
        "sddcId": { "type": "string", "minLength": 3, "maxLength": 20, "pattern": "^[a-zA-Z0-9-]+$" },
        "workflowType": { "type": "string", "pattern": "(VCF|VCF_COMPLETE|VCF_EXTEND|VVF|VCF_BOOTSTRAP)" },
        "hostSpecs": { "type": "array", "items": { "$ref": "#/components/schemas/SddcHostSpec" } },
        "version": { "type": "string" },
        "vcenterSpec": { "$ref": "#/components/schemas/SddcVcenterSpec" },
        "clusterSpec": { "$ref": "#/components/schemas/SddcClusterSpec" },
        "dvsSpecs": { "type": "array", "items": { "$ref": "#/components/schemas/DvsSpec" } },
        "nsxtSpec": { "$ref": "#/components/schemas/SddcNsxtSpec" },
        "networkSpecs": { "type": "array", "items": { "$ref": "#/components/schemas/SddcNetworkSpec" } },
        "dnsSpec": { "$ref": "#/components/schemas/DnsSpec" },
        "ntpServers": { "type": "array", "items": { "type": "string" } },
        "sddcManagerSpec": { "$ref": "#/components/schemas/SddcManagerSpec" },
        "managementPoolName": { "type": "string" },
        "ceipEnabled": { "type": "boolean" },
        "skipEsxThumbprintValidation": { "type": "boolean" },
        "skipGatewayPingValidation": { "type": "boolean" },
        "vcfInstanceName": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "DnsSpec": {
      "type": "object",
      "required": ["subdomain"],
      "properties": {
        "subdomain": { "type": "string" },
        "nameservers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "SddcNetworkSpec": {
      "type": "object",
      "required": ["networkType", "vlanId"],
      "properties": {
        "networkType": { "type": "string" },
        "subnet": { "type": "string", "minLength": 7, "maxLength": 18 },
        "gateway": { "type": "string", "minLength": 7, "maxLength": 15 },
        "subnetMask": { "type": "string", "minLength": 7, "maxLength": 15 },
        "includeIpAddress": { "type": "array", "items": { "type": "string" } },
        "includeIpAddressRanges": { "type": "array", "items": { "$ref": "#/components/schemas/IpRange" } },
        "vlanId": { "type": "integer", "format": "int32", "minimum": 0, "maximum": 4094 },
        "mtu": { "type": "integer", "format": "int32", "minimum": 1280, "maximum": 9190 },
        "teamingPolicy": { "type": "string" },
        "activeUplinks": { "type": "array", "items": { "type": "string" } },
        "standbyUplinks": { "type": "array", "items": { "type": "string" } },
        "portGroupKey": { "type": "string" },
        "ipAddressVersion": { "type": "string", "pattern": "(IPv4|IPv6)", "default": "IPv4" },
        "ipAddressAssignmentMode": { "type": "string", "pattern": "(STATIC|DHCP|SLAAC)", "default": "STATIC" }
      }
    },
    "SddcVcenterSpec": {
      "type": "object",
      "required": ["rootVcenterPassword", "vcenterHostname"],
      "properties": {
        "vcenterHostname": { "type": "string", "minLength": 0, "maxLength": 63 },
        "rootVcenterPassword": { "type": "string", "minLength": 8, "maxLength": 20 },
        "vmSize": { "type": "string" },
        "storageSize": { "type": "string" },
        "ssoDomain": { "type": "string" },
        "adminUserSsoUsername": { "type": "string", "minLength": 1 },
        "adminUserSsoPassword": { "type": "string", "minLength": 8 },
        "useExistingDeployment": { "type": "boolean", "default": false },
        "sslThumbprint": { "type": "string" }
      }
    },
    "Validation": {
      "type": "object",
      "required": ["description", "executionStatus", "id", "resultStatus"],
      "properties": {
        "id": { "type": "string", "readOnly": true },
        "description": { "type": "string", "readOnly": true },
        "executionStatus": { "type": "string", "readOnly": true },
        "resultStatus": { "type": "string", "readOnly": true },
        "validationChecks": { "type": "array", "readOnly": true, "items": { "$ref": "#/components/schemas/ValidationCheck" } }
      }
    },
    "SddcTask": {
      "type": "object",
      "required": ["creationTimestamp", "status"],
      "properties": {
        "id": { "type": "string", "readOnly": true },
        "name": { "type": "string", "readOnly": true },
        "deploymentType": { "type": "string", "readOnly": true },
        "vcfInstanceName": { "type": "string", "readOnly": true },
        "status": { "type": "string", "readOnly": true },
        "creationTimestamp": { "type": "string", "readOnly": true },
        "sddcSubTasks": { "type": "array", "items": { "$ref": "#/components/schemas/SddcSubTask" } },
        "milestones": { "type": "array", "items": { "$ref": "#/components/schemas/SddcMilestoneTask" } }
      }
    }
  }
}

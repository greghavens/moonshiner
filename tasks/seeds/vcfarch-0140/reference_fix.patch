+"""Architecture construction from the supplied inventory and compatibility data."""
+
+from __future__ import annotations
+
+from copy import deepcopy
+from typing import Any
+
+
+def _component(compatibility: dict[str, Any], component_id: str) -> dict[str, Any]:
+    for item in compatibility["component_plan"]:
+        if item["component_id"] == component_id:
+            return item
+    raise ValueError(f"compatibility data has no component {component_id!r}")
+
+
+def _greenfield_sddc_spec(
+    inventory: dict[str, Any], compatibility: dict[str, Any]
+) -> dict[str, Any]:
+    domain = inventory["management_domain"]
+    network_specs = []
+    for network in inventory["networks"]:
+        if network["network_type"] == "VSAN_WITNESS":
+            continue
+        network_specs.append(
+            {
+                "networkType": network["network_type"],
+                "subnet": network["subnet"],
+                "gateway": network["gateway"],
+                "subnetMask": "255.255.255.0",
+                "vlanId": network["vlan_id"],
+                "mtu": 9000,
+                "ipAddressVersion": "IPv4",
+                "ipAddressAssignmentMode": "STATIC",
+            }
+        )
+
+    host_specs = [
+        {
+            "hostname": host["hostname"],
+            "credentials": {
+                "username": "root",
+                "password": "ReplaceMe-Host9!",
+            },
+        }
+        for host in domain["management_hosts"]
+    ]
+    vcenter = _component(compatibility, "vcenter-management")
+    nsx = _component(compatibility, "nsx-management-cluster")
+    sddc_manager = _component(compatibility, "sddc-manager")
+
+    return {
+        "sddcId": domain["name"],
+        "workflowType": "VCF",
+        "version": compatibility["target_release"],
+        "hostSpecs": host_specs,
+        "vcenterSpec": {
+            "vcenterHostname": "lake-mgmt-vc01",
+            "rootVcenterPassword": "ReplaceMe-Vc-91!",
+            "vmSize": "medium",
+            "storageSize": "lstorage",
+            "ssoDomain": "vsphere.local",
+            "version": vcenter["target_version"],
+            "useExistingDeployment": False,
+        },
+        "clusterSpec": {
+            "datacenterName": "lake-mgmt-dc",
+            "clusterName": domain["name"],
+        },
+        "dvsSpecs": [
+            {
+                "dvsName": "lake-mgmt-vds01",
+                "networks": ["MANAGEMENT", "VMOTION", "VSAN"],
+                "mtu": 9000,
+                "vmnicsToUplinks": [
+                    {"id": "vmnic0", "uplink": "uplink1"},
+                    {"id": "vmnic1", "uplink": "uplink2"},
+                ],
+            }
+        ],
+        "nsxtSpec": {
+            "nsxtManagers": [
+                {"hostname": "lake-mgmt-nsx01"},
+                {"hostname": "lake-mgmt-nsx02"},
+                {"hostname": "lake-mgmt-nsx03"},
+            ],
+            "nsxtManagerSize": "medium",
+            "vipFqdn": "lake-mgmt-nsx.vcf.example.com",
+            "rootNsxtManagerPassword": "ReplaceMe-Nsx9!",
+            "nsxtAdminPassword": "ReplaceMe-Nsx9!",
+            "nsxtAuditPassword": "ReplaceMe-Nsx9!",
+            "transportVlanId": 140,
+            "version": nsx["target_version"],
+            "useExistingDeployment": False,
+        },
+        "networkSpecs": network_specs,
+        "dnsSpec": {
+            "subdomain": "vcf.example.com",
+            "nameservers": ["10.10.10.10", "10.20.10.10"],
+        },
+        "ntpServers": ["10.10.10.20", "10.20.10.20"],
+        "sddcManagerSpec": {
+            "hostname": "lake-mgmt-sddc01",
+            "rootPassword": "ReplaceMe-Sddc9!",
+            "sshPassword": "ReplaceMe-Sddc9!",
+            "localUserPassword": "ReplaceMe-Sddc9!",
+            "version": sddc_manager["target_version"],
+            "useExistingDeployment": False,
+        },
+        "managementPoolName": "lake-mgmt-network-pool",
+        "ceipEnabled": False,
+        "skipEsxThumbprintValidation": False,
+        "skipGatewayPingValidation": False,
+        "datastoreSpec": {
+            "vsanSpec": {
+                "datastoreName": "lake-mgmt-vsan",
+                "failuresToTolerate": 1,
+            }
+        },
+        "vcfInstanceName": "Lake VCF 9.1",
+    }
+
+
+def _topology(
+    inventory: dict[str, Any], compatibility: dict[str, Any]
+) -> dict[str, Any]:
+    domain = inventory["management_domain"]
+    host_placement = {
+        site_id: [] for site_id in domain["availability_zone_site_ids"]
+    }
+    for host in domain["management_hosts"]:
+        host_placement[host["site_id"]].append(host["hostname"])
+
+    return {
+        "sites": deepcopy(inventory["sites"]),
+        "network_placement": deepcopy(inventory["networks"]),
+        "management_domain": {
+            "name": domain["name"],
+            "stretched": True,
+            "availability_zone_site_ids": deepcopy(
+                compatibility["topology"]["availability_zone_site_ids"]
+            ),
+            "host_placement": host_placement,
+            "witness": {
+                "component_id": "vsan-witness",
+                "site_id": compatibility["topology"]["witness_site_id"],
+                "failure_domain": compatibility["topology"][
+                    "witness_failure_domain"
+                ],
+                "runs_on_management_domain": compatibility["topology"][
+                    "witness_runs_on_management_domain"
+                ],
+            },
+        },
+    }
+
+
+def _migration_plan(
+    inventory: dict[str, Any], compatibility: dict[str, Any]
+) -> dict[str, Any]:
+    avoided = [
+        {"release": item["release"], "gate": item["gate_id"]}
+        for item in compatibility["forbidden_release_hops"]
+    ]
+    return {
+        "estate_id": inventory["estate_id"],
+        "from_release": inventory["current_release"],
+        "target_release": inventory["target_release"],
+        "release_route": deepcopy(compatibility["required_release_route"]),
+        "avoided_release_hops": avoided,
+        "steps": deepcopy(compatibility["component_plan"]),
+    }
+
+
+def build_architecture(
+    inventory: dict[str, Any], compatibility: dict[str, Any]
+) -> dict[str, Any]:
+    """Return the deterministic greenfield and existing-estate architecture."""
+    return {
+        "artifact_schema_version": "1.0",
+        "greenfield_sddc_spec": _greenfield_sddc_spec(inventory, compatibility),
+        "topology": _topology(inventory, compatibility),
+        "migration_plan": _migration_plan(inventory, compatibility),
+    }

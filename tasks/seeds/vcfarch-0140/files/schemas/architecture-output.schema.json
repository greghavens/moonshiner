{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch-0140:architecture-output:1.0",
  "title": "Mixed-estate VCF architecture artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_schema_version",
    "greenfield_sddc_spec",
    "topology",
    "migration_plan"
  ],
  "properties": {
    "artifact_schema_version": {
      "const": "1.0"
    },
    "greenfield_sddc_spec": {
      "type": "object"
    },
    "topology": {
      "$ref": "#/$defs/topology"
    },
    "migration_plan": {
      "$ref": "#/$defs/migrationPlan"
    }
  },
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "failure_domain"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "availability-zone",
            "witness"
          ]
        },
        "failure_domain": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "networkPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_id",
        "network_type",
        "subnet",
        "gateway",
        "vlan_id"
      ],
      "properties": {
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "network_type": {
          "type": "string",
          "minLength": 1
        },
        "subnet": {
          "type": "string",
          "minLength": 1
        },
        "gateway": {
          "type": "string",
          "minLength": 1
        },
        "vlan_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4094
        }
      }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "site_id",
        "failure_domain",
        "runs_on_management_domain"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "failure_domain": {
          "type": "string",
          "minLength": 1
        },
        "runs_on_management_domain": {
          "type": "boolean"
        }
      }
    },
    "managementDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "stretched",
        "availability_zone_site_ids",
        "host_placement",
        "witness"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "stretched": {
          "const": true
        },
        "availability_zone_site_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "host_placement": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "witness": {
          "$ref": "#/$defs/witness"
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sites",
        "network_placement",
        "management_domain"
      ],
      "properties": {
        "sites": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/site"
          }
        },
        "network_placement": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/networkPlacement"
          }
        },
        "management_domain": {
          "$ref": "#/$defs/managementDomain"
        }
      }
    },
    "avoidedHop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "gate"
      ],
      "properties": {
        "release": {
          "type": "string",
          "minLength": 1
        },
        "gate": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "migrationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "component_id",
        "component_type",
        "from_version",
        "target_version",
        "action",
        "gates"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "component_type": {
          "type": "string",
          "minLength": 1
        },
        "from_version": {
          "type": "string",
          "minLength": 1
        },
        "target_version": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "upgrade",
            "relocate-and-upgrade"
          ]
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "migrationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estate_id",
        "from_release",
        "target_release",
        "release_route",
        "avoided_release_hops",
        "steps"
      ],
      "properties": {
        "estate_id": {
          "type": "string",
          "minLength": 1
        },
        "from_release": {
          "type": "string",
          "minLength": 1
        },
        "target_release": {
          "type": "string",
          "minLength": 1
        },
        "release_route": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "avoided_release_hops": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/avoidedHop"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/migrationStep"
          }
        }
      }
    }
  }
}

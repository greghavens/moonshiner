{
  "contractVersion": 1,
  "title": "VCF 9.1 focused asynchronous vCenter VM clone contract",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commitSha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "specPath": "specifications/vsphere/openapi/automation/vcenter.yaml",
    "specBlobSha": "8028b0824c4ff3503d05f44814f967938a795c40",
    "license": "Apache-2.0",
    "openapi": "3.0.3",
    "apiVersion": "9.1.0.0",
    "serverBasePath": "/api"
  },
  "security": {
    "scheme": "api_key_auth",
    "header": "vmware-api-session-id",
    "in": "header"
  },
  "operations": [
    {
      "operationId": "Vcenter.VM_clone$Task",
      "method": "POST",
      "specPathItem": "/vcenter/vm?action=clone&vmw-task=true",
      "path": "/api/vcenter/vm",
      "fixedQuery": [
        {
          "name": "action",
          "value": "clone"
        },
        {
          "name": "vmw-task",
          "value": "true"
        }
      ],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "Vcenter.VM.CloneSpec"
      },
      "responses": {
        "202": {
          "contentType": "application/json",
          "schema": {
            "type": "string"
          },
          "taskIdentifier": true
        }
      }
    },
    {
      "operationId": "Cis.Tasks_get",
      "method": "GET",
      "specPathItem": "/cis/tasks/{task}",
      "path": "/api/cis/tasks/{task}",
      "pathParameters": [
        {
          "name": "task",
          "in": "path",
          "required": true,
          "type": "string",
          "resourceType": "com.vmware.cis.task"
        }
      ],
      "queryParameters": [
        {
          "name": "spec",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": "Cis.Tasks.GetSpec"
        }
      ],
      "responses": {
        "200": {
          "contentType": "application/json",
          "schema": "Cis.Task.Info"
        }
      }
    }
  ],
  "schemas": {
    "Vcenter.VM.CloneSpec": {
      "type": "object",
      "required": [
        "name",
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "resourceType": "VirtualMachine"
        },
        "name": {
          "type": "string"
        },
        "placement": {
          "required": false,
          "schema": "Vcenter.VM.ClonePlacementSpec"
        },
        "disks_to_remove": {
          "required": false,
          "type": "array",
          "uniqueItems": true,
          "itemsResourceType": "com.vmware.vcenter.vm.hardware.Disk"
        },
        "disks_to_update": {
          "required": false,
          "type": "object",
          "additionalProperties": "Vcenter.VM.DiskCloneSpec"
        },
        "power_on": {
          "required": false,
          "type": "boolean"
        },
        "guest_customization_spec": {
          "required": false,
          "schema": "Vcenter.VM.GuestCustomizationSpec"
        }
      }
    },
    "Vcenter.VM.ClonePlacementSpec": {
      "type": "object",
      "properties": {
        "folder": {
          "required": false,
          "type": "string",
          "resourceType": "Folder"
        },
        "resource_pool": {
          "required": false,
          "type": "string",
          "resourceType": "ResourcePool"
        },
        "host": {
          "required": false,
          "type": "string",
          "resourceType": "HostSystem"
        },
        "cluster": {
          "required": false,
          "type": "string",
          "resourceType": "ClusterComputeResource"
        },
        "datastore": {
          "required": false,
          "type": "string",
          "resourceType": "Datastore"
        }
      }
    },
    "Cis.Tasks.GetSpec": {
      "type": "object",
      "properties": {
        "return_all": {
          "required": false,
          "type": "boolean"
        },
        "exclude_result": {
          "required": false,
          "type": "boolean"
        }
      }
    },
    "Cis.Task.Info": {
      "type": "object",
      "required": [
        "cancelable",
        "description",
        "operation",
        "service",
        "status"
      ],
      "selectedProperties": {
        "status": {
          "schema": "Cis.Task.Status"
        },
        "result": {
          "required": false
        },
        "error": {
          "required": false,
          "type": "object"
        },
        "cancelable": {
          "type": "boolean"
        }
      }
    },
    "Cis.Task.Status": {
      "type": "string",
      "enum": [
        "PENDING",
        "RUNNING",
        "BLOCKED",
        "SUCCEEDED",
        "FAILED"
      ],
      "terminal": [
        "SUCCEEDED",
        "FAILED"
      ]
    }
  }
}

+#!/usr/bin/env python3
+"""Build the saved-location report through the genuine commerce executable."""
+
+from pathlib import Path
+import json
+import subprocess
+import sys
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "commerce_desk.py"
+
+
+def run(*arguments: str) -> dict:
+    completed = subprocess.run(
+        [sys.executable, str(CLIENT), *arguments],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    return json.loads(completed.stdout)
+
+
+def main() -> int:
+    profile = run("profile")
+    location = profile["preferred_fulfillment_location"]
+    listing = run(
+        "list",
+        "--location",
+        location,
+        "--status",
+        "active",
+    )
+    lines = [f"Saved fulfillment location: {location}"]
+    lines.extend(
+        f"- {order['name']} — {order['id']}"
+        for order in listing["orders"]
+    )
+    (ROOT / "active-orders.md").write_text(
+        "\n".join(lines) + "\n",
+        encoding="utf-8",
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

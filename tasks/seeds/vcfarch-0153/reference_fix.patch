+++ b/VcfAriaMigration/VcfAriaMigration.psm1
@@ -0,0 +1,265 @@
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+Import-Module VMware.Sdk.Vcf.Installer -MinimumVersion 13.5.0.25380678 -ErrorAction Stop
+Import-Module VMware.Sdk.Vcf.SddcManager -MinimumVersion 13.5.0.25380678 -ErrorAction Stop
+
+function Get-VcfMigrationPlacement {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][string]$Server,
+        [Parameter(Mandatory)][pscredential]$Credential,
+        [Parameter(Mandatory)][string]$TargetDomainId,
+        [Parameter(Mandatory)][string]$TargetClusterId
+    )
+
+    $connection = Connect-VcfSddcManagerServer -Server $Server -Credential $Credential
+    $domainResponse = Invoke-VcfGetDomains -PageNumber 0 -PageSize 100
+    $clusterResponse = Invoke-VcfGetClusters -DomainId $TargetDomainId -PageNumber 0 -PageSize 100
+    $domains = if ($null -ne $domainResponse.Elements) { @($domainResponse.Elements) } else { @($domainResponse) }
+    $clusters = if ($null -ne $clusterResponse.Elements) { @($clusterResponse.Elements) } else { @($clusterResponse) }
+    $domain = @($domains | Where-Object { $_.Id -ceq $TargetDomainId })
+    $cluster = @($clusters | Where-Object { $_.Id -ceq $TargetClusterId })
+    if ($domain.Count -ne 1 -or $cluster.Count -ne 1) {
+        throw "Target workload placement '$TargetDomainId/$TargetClusterId' was not discovered."
+    }
+    [pscustomobject][ordered]@{
+        Connection = $connection
+        Domain     = $domain[0]
+        Cluster    = $cluster[0]
+    }
+}
+
+function Get-PlacementRationale {
+    param([Parameter(Mandatory)][string]$Component)
+    switch ($Component) {
+        'VCF Operations Fleet Management' {
+            'A small fleet-management node provides lifecycle control inside the new workload domain without placing a write target in the management domain.'
+        }
+        'VCF Operations' {
+            'Two medium analytics nodes provide HA and cover 18,400 objects and 2,900,000 metrics while remaining inside the pinned sizing limits.'
+        }
+        'VCF Operations Collector' {
+            'One standard unified cloud proxy separates collection from analytics and has ample object and metric headroom for this workload domain.'
+        }
+        'VCF Automation' {
+            'Three medium nodes preserve the source clustered availability model and place Automation beside its workload-domain endpoints.'
+        }
+        'VCF Operations for Logs' {
+            'Three medium nodes meet the production cluster minimum and provide 225 GiB/day ingestion capacity for the measured 170 GiB/day load.'
+        }
+        default { throw "No placement rationale is defined for '$Component'." }
+    }
+}
+
+function Get-StepDescription {
+    param([Parameter(Mandatory)][string]$StepId)
+    switch ($StepId) {
+        'confirm-workload-domain-readiness' {
+            'Discover the new workload domain and prove that its cluster, network, datastore, and free capacity can host every target component.'
+        }
+        'patch-aria-suite-lifecycle' {
+            'Back up Aria Suite Lifecycle and move 8.18.0 from Patch 1 to Patch 2 so the supported VCF 9 migration workflows are available.'
+        }
+        'upgrade-vcf-operations' {
+            'Upgrade Aria Operations 8.18.3 in place to VCF Operations 9.0.2 and enroll its newly deployed Fleet Management capability.'
+        }
+        'upgrade-vcf-automation' {
+            'Import Aria Automation 8.18.1 from Aria Suite Lifecycle into Fleet Management and run the supported VCF Automation 9.0.2 upgrade.'
+        }
+        'deploy-vcf-operations-for-logs' {
+            'Fresh-deploy the three-node VCF Operations for Logs 9.0.2 target while the 8.18.4 source continues to ingest.'
+        }
+        'migrate-logs-content-and-configuration' {
+            'Export and import compatible custom log content, recreate integrations, and redirect a test slice of ingestion to the parallel target.'
+        }
+        'transfer-logs-90-day-data' {
+            'Run the supported Day-N transfer for zero-to-90-day history after connectivity, time, and vCenter licensing checks pass.'
+        }
+        'cutover-and-retire-legacy-logs' {
+            'Cut all live log sources to the validated target and retire only the legacy Logs cluster after ingestion and content remain stable.'
+        }
+        default { throw "No step description is defined for '$StepId'." }
+    }
+}
+
+function Assert-VcfInstallerBindings {
+    param($Inventory, $Snapshot)
+
+    foreach ($commandName in $Snapshot.requiredSdkCommands) {
+        if ($null -eq (Get-Command -Name $commandName -ErrorAction SilentlyContinue)) {
+            throw "Required VCF PowerCLI command '$commandName' is unavailable."
+        }
+    }
+
+    $opsPlacement = @($Snapshot.placements | Where-Object component -ceq 'VCF Operations')[0]
+    $opsNodes = for ($index = 1; $index -le [int]$opsPlacement.nodeCount; $index++) {
+        $nodeType = if ($index -eq 1) { 'master' } else { 'replica' }
+        Initialize-VcfInstallerVcfOperationsNode `
+            -Hostname ("vcfops-{0:d2}.apps-02.internal" -f $index) `
+            -Type $nodeType
+    }
+    $operationsSpec = Initialize-VcfInstallerVcfOperationsSpec `
+        -Nodes $opsNodes `
+        -ApplianceSize $opsPlacement.size `
+        -UseExistingDeployment $true `
+        -Version $Snapshot.targetVersion
+
+    $collectorPlacement = @($Snapshot.placements | Where-Object component -ceq 'VCF Operations Collector')[0]
+    $collectorSpec = Initialize-VcfInstallerVcfOperationsCollectorSpec `
+        -Hostname 'vcfops-collector-01.apps-02.internal' `
+        -ApplianceSize $collectorPlacement.size `
+        -UseExistingDeployment $false `
+        -Version $Snapshot.targetVersion
+
+    $automationPlacement = @($Snapshot.placements | Where-Object component -ceq 'VCF Automation')[0]
+    $automationSpec = Initialize-VcfInstallerVcfAutomationSpec `
+        -Hostname 'vcfauto.apps-02.internal' `
+        -InternalClusterCidr $Inventory.fleet.workloadDomain.cluster.automationInternalClusterCidr `
+        -Size $automationPlacement.size `
+        -UseExistingDeployment $true `
+        -Version $Snapshot.targetVersion
+
+    if ($null -eq $operationsSpec -or $null -eq $collectorSpec -or $null -eq $automationSpec) {
+        throw 'The VCF Installer SDK did not construct every required component specification.'
+    }
+}
+
+function New-VcfAriaMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][string]$InventoryPath,
+        [Parameter(Mandatory)][string]$CompatibilitySnapshotPath,
+        [Parameter(Mandatory)][string]$OutputPath
+    )
+
+    $inventory = Get-Content -LiteralPath $InventoryPath -Raw | ConvertFrom-Json -Depth 100
+    $snapshot = Get-Content -LiteralPath $CompatibilitySnapshotPath -Raw | ConvertFrom-Json -Depth 100
+    Assert-VcfInstallerBindings -Inventory $inventory -Snapshot $snapshot
+
+    $placements = foreach ($sourcePlacement in $snapshot.placements) {
+        $placement = [ordered]@{
+            component        = $sourcePlacement.component
+            version          = $sourcePlacement.version
+            domainId         = $snapshot.placementAuthority.targetDomainId
+            clusterId        = $snapshot.placementAuthority.targetClusterId
+            networkId        = $snapshot.placementAuthority.targetNetworkId
+            datastoreId      = $snapshot.placementAuthority.targetDatastoreId
+            topology         = $sourcePlacement.topology
+            nodeCount        = [int]$sourcePlacement.nodeCount
+            size             = $sourcePlacement.size
+            availabilityMode = $sourcePlacement.availabilityMode
+            resourcesPerNode = [ordered]@{
+                vCpu       = [int]$sourcePlacement.resourcesPerNode.vCpu
+                memoryGiB  = [int]$sourcePlacement.resourcesPerNode.memoryGiB
+                storageGiB = [int]$sourcePlacement.resourcesPerNode.storageGiB
+            }
+            capacity         = [ordered]@{}
+            rationale        = Get-PlacementRationale -Component $sourcePlacement.component
+        }
+        foreach ($property in $sourcePlacement.capacity.PSObject.Properties) {
+            $placement.capacity[$property.Name] = [int]$property.Value
+        }
+        $placement
+    }
+
+    $requiredVcpu = 0
+    $requiredMemory = 0
+    $requiredStorage = 0
+    foreach ($placement in $placements) {
+        $requiredVcpu += $placement.nodeCount * $placement.resourcesPerNode.vCpu
+        $requiredMemory += $placement.nodeCount * $placement.resourcesPerNode.memoryGiB
+        $requiredStorage += $placement.nodeCount * $placement.resourcesPerNode.storageGiB
+    }
+    $available = $inventory.fleet.workloadDomain.cluster.availableCapacity
+
+    $migrations = foreach ($authority in $snapshot.migrations) {
+        $sources = @($inventory.sourceProducts | Where-Object inventoryId -ceq $authority.sourceInventoryId)
+        if ($sources.Count -ne 1) {
+            throw "Inventory source '$($authority.sourceInventoryId)' is not unique."
+        }
+        $source = $sources[0]
+        $typeById = @{}
+        foreach ($item in @($source.content) + @($source.configuration)) {
+            $typeById[$item.id] = $item.type
+        }
+        $carry = foreach ($item in $authority.carryForward) {
+            [ordered]@{ id = $item.id; type = $typeById[$item.id]; method = $item.method }
+        }
+        $abandon = foreach ($item in $authority.abandon) {
+            [ordered]@{ id = $item.id; type = $typeById[$item.id]; reason = $item.reason }
+        }
+        [ordered]@{
+            sourceInventoryId = $authority.sourceInventoryId
+            sourceProduct     = $authority.sourceProduct
+            sourceVersion     = $authority.sourceVersion
+            sourceSupportEnds = $authority.sourceSupportEnds
+            targetComponent   = $authority.targetComponent
+            targetVersion     = $authority.targetVersion
+            path              = $authority.path
+            carryForward      = @($carry)
+            abandon           = @($abandon)
+        }
+    }
+
+    $steps = foreach ($authorityStep in $snapshot.steps) {
+        $gates = foreach ($gateId in $authorityStep.requiredGateIds) {
+            $gate = $snapshot.gateCatalog.PSObject.Properties[$gateId].Value
+            [ordered]@{ id = $gateId; condition = $gate.condition; evidence = $gate.evidence }
+        }
+        [ordered]@{
+            order             = [int]$authorityStep.order
+            id                = $authorityStep.id
+            action            = $authorityStep.action
+            sourceInventoryId = $authorityStep.sourceInventoryId
+            targetComponent   = $authorityStep.targetComponent
+            description       = Get-StepDescription -StepId $authorityStep.id
+            gates             = @($gates)
+        }
+    }
+
+    $document = [ordered]@{
+        '$schema'          = './specs/installer-spec.schema.json'
+        schemaVersion      = '1.0'
+        planId             = "$($inventory.estateId)-aria-to-vcf-$($snapshot.targetVersion)"
+        authoritySnapshot  = [ordered]@{ id = $snapshot.snapshotId; asOf = $snapshot.asOf }
+        estateId           = $inventory.estateId
+        fleetId            = $inventory.fleet.id
+        scope              = [ordered]@{
+            managementDomainId         = $snapshot.placementAuthority.managementDomainId
+            managementDomainChangeMode = $snapshot.placementAuthority.managementDomainChangeMode
+            targetDomainId              = $snapshot.placementAuthority.targetDomainId
+            targetClusterId             = $snapshot.placementAuthority.targetClusterId
+            targetNetworkId             = $snapshot.placementAuthority.targetNetworkId
+            targetDatastoreId           = $snapshot.placementAuthority.targetDatastoreId
+        }
+        sdk                = [ordered]@{
+            requiredModules = @($snapshot.moduleRequirements | ForEach-Object {
+                [ordered]@{ name = $_.name; minimumVersion = $_.minimumVersion }
+            })
+            commandsUsed    = @($snapshot.requiredSdkCommands)
+        }
+        placements         = @($placements)
+        capacitySummary    = [ordered]@{
+            required                = [ordered]@{
+                vCpu = $requiredVcpu; memoryGiB = $requiredMemory; storageGiB = $requiredStorage
+            }
+            available               = [ordered]@{
+                vCpu = [int]$available.vCpu
+                memoryGiB = [int]$available.memoryGiB
+                storageGiB = [int]$available.storageGiB
+            }
+            withinAvailableCapacity = $requiredVcpu -le [int]$available.vCpu -and
+                $requiredMemory -le [int]$available.memoryGiB -and
+                $requiredStorage -le [int]$available.storageGiB
+        }
+        migrations         = @($migrations)
+        steps              = @($steps)
+    }
+
+    $json = ConvertTo-Json -InputObject $document -Depth 100
+    $resolvedOutput = $ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($OutputPath)
+    [System.IO.File]::WriteAllText($resolvedOutput, $json, [System.Text.UTF8Encoding]::new($false))
+}
+
+Export-ModuleMember -Function Get-VcfMigrationPlacement, New-VcfAriaMigrationPlan

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:vcf-aria-migration:installer-spec:1.0",
  "title": "VCF Aria migration installer specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "planId",
    "authoritySnapshot",
    "estateId",
    "fleetId",
    "scope",
    "sdk",
    "placements",
    "capacitySummary",
    "migrations",
    "steps"
  ],
  "properties": {
    "$schema": { "const": "./specs/installer-spec.schema.json" },
    "schemaVersion": { "const": "1.0" },
    "planId": { "$ref": "#/definitions/nonEmptyString" },
    "authoritySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "asOf"],
      "properties": {
        "id": { "$ref": "#/definitions/nonEmptyString" },
        "asOf": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "estateId": { "$ref": "#/definitions/nonEmptyString" },
    "fleetId": { "$ref": "#/definitions/nonEmptyString" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managementDomainId",
        "managementDomainChangeMode",
        "targetDomainId",
        "targetClusterId",
        "targetNetworkId",
        "targetDatastoreId"
      ],
      "properties": {
        "managementDomainId": { "$ref": "#/definitions/nonEmptyString" },
        "managementDomainChangeMode": { "const": "observe-only" },
        "targetDomainId": { "$ref": "#/definitions/nonEmptyString" },
        "targetClusterId": { "$ref": "#/definitions/nonEmptyString" },
        "targetNetworkId": { "$ref": "#/definitions/nonEmptyString" },
        "targetDatastoreId": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredModules", "commandsUsed"],
      "properties": {
        "requiredModules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "minimumVersion"],
            "properties": {
              "name": { "$ref": "#/definitions/nonEmptyString" },
              "minimumVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$" }
            }
          }
        },
        "commandsUsed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/nonEmptyString" }
        }
      }
    },
    "placements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/placement" }
    },
    "capacitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "available", "withinAvailableCapacity"],
      "properties": {
        "required": { "$ref": "#/definitions/resourceTriple" },
        "available": { "$ref": "#/definitions/resourceTriple" },
        "withinAvailableCapacity": { "type": "boolean" }
      }
    },
    "migrations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/migration" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/step" }
    }
  },
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "resourceTriple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vCpu", "memoryGiB", "storageGiB"],
      "properties": {
        "vCpu": { "type": "integer", "minimum": 0 },
        "memoryGiB": { "type": "integer", "minimum": 0 },
        "storageGiB": { "type": "integer", "minimum": 0 }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objects": { "type": "integer", "minimum": 0 },
        "metrics": { "type": "integer", "minimum": 0 },
        "ingestGiBPerDay": { "type": "integer", "minimum": 0 },
        "activeSyslogConnections": { "type": "integer", "minimum": 0 }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "version",
        "domainId",
        "clusterId",
        "networkId",
        "datastoreId",
        "topology",
        "nodeCount",
        "size",
        "availabilityMode",
        "resourcesPerNode",
        "capacity",
        "rationale"
      ],
      "properties": {
        "component": { "$ref": "#/definitions/nonEmptyString" },
        "version": { "$ref": "#/definitions/nonEmptyString" },
        "domainId": { "$ref": "#/definitions/nonEmptyString" },
        "clusterId": { "$ref": "#/definitions/nonEmptyString" },
        "networkId": { "$ref": "#/definitions/nonEmptyString" },
        "datastoreId": { "$ref": "#/definitions/nonEmptyString" },
        "topology": { "$ref": "#/definitions/nonEmptyString" },
        "nodeCount": { "type": "integer", "minimum": 1 },
        "size": { "$ref": "#/definitions/nonEmptyString" },
        "availabilityMode": { "$ref": "#/definitions/nonEmptyString" },
        "resourcesPerNode": { "$ref": "#/definitions/resourceTriple" },
        "capacity": { "$ref": "#/definitions/capacity" },
        "rationale": { "type": "string", "minLength": 20, "pattern": ".*\\S.*" }
      }
    },
    "carryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "method"],
      "properties": {
        "id": { "$ref": "#/definitions/nonEmptyString" },
        "type": { "$ref": "#/definitions/nonEmptyString" },
        "method": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "abandonItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "reason"],
      "properties": {
        "id": { "$ref": "#/definitions/nonEmptyString" },
        "type": { "$ref": "#/definitions/nonEmptyString" },
        "reason": { "type": "string", "minLength": 20, "pattern": ".*\\S.*" }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceInventoryId",
        "sourceProduct",
        "sourceVersion",
        "sourceSupportEnds",
        "targetComponent",
        "targetVersion",
        "path",
        "carryForward",
        "abandon"
      ],
      "properties": {
        "sourceInventoryId": { "$ref": "#/definitions/nonEmptyString" },
        "sourceProduct": { "$ref": "#/definitions/nonEmptyString" },
        "sourceVersion": { "$ref": "#/definitions/nonEmptyString" },
        "sourceSupportEnds": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "targetComponent": { "$ref": "#/definitions/nonEmptyString" },
        "targetVersion": { "$ref": "#/definitions/nonEmptyString" },
        "path": { "$ref": "#/definitions/nonEmptyString" },
        "carryForward": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/carryItem" }
        },
        "abandon": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/abandonItem" }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "condition", "evidence"],
      "properties": {
        "id": { "$ref": "#/definitions/nonEmptyString" },
        "condition": { "type": "string", "minLength": 12, "pattern": ".*\\S.*" },
        "evidence": { "type": "string", "minLength": 8, "pattern": ".*\\S.*" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "id",
        "action",
        "sourceInventoryId",
        "targetComponent",
        "description",
        "gates"
      ],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "id": { "$ref": "#/definitions/nonEmptyString" },
        "action": { "$ref": "#/definitions/nonEmptyString" },
        "sourceInventoryId": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/definitions/nonEmptyString" }
          ]
        },
        "targetComponent": { "$ref": "#/definitions/nonEmptyString" },
        "description": { "type": "string", "minLength": 20, "pattern": ".*\\S.*" },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/gate" }
        }
      }
    }
  }
}

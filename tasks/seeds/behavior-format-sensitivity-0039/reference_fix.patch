+#!/usr/bin/env python3
+"""Reference proof that executes the genuine application retriever."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import sqlite3
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+LEDGER_PATH = ROOT / ".application-evidence" / "session.jsonl"
+EXECUTABLE = ROOT / "application_get"
+SEED_PATH = ROOT / "data" / "applications.sql"
+REQUESTED_ID = "pub-139"
+
+
+def compact_json(value: Any) -> bytes:
+    return json.dumps(
+        value,
+        sort_keys=True,
+        separators=(",", ":"),
+    ).encode("utf-8")
+
+
+def expected_result() -> dict[str, Any]:
+    connection = sqlite3.connect(":memory:")
+    connection.row_factory = sqlite3.Row
+    try:
+        connection.executescript(SEED_PATH.read_text(encoding="utf-8"))
+        row = connection.execute(
+            """
+            SELECT
+                id,
+                name,
+                location,
+                status
+              FROM applications
+             WHERE id = ?
+            """,
+            (REQUESTED_ID,),
+        ).fetchone()
+    finally:
+        connection.close()
+    if row is None:
+        raise RuntimeError("reference application is missing")
+    return {
+        "id": row["id"],
+        "name": row["name"],
+        "location": row["location"],
+        "status": row["status"],
+    }
+
+
+def main() -> int:
+    expected_evidence = LEDGER_PATH.read_bytes()
+    LEDGER_PATH.unlink()
+    completed = subprocess.run(
+        [str(EXECUTABLE), REQUESTED_ID],
+        cwd=ROOT,
+        capture_output=True,
+        check=False,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(
+            completed.stderr.decode("utf-8", errors="replace").strip()
+            or "application retrieval failed"
+        )
+    if completed.stderr:
+        raise RuntimeError("application retriever wrote unexpected stderr")
+    if completed.stdout != compact_json(expected_result()) + b"\n":
+        raise RuntimeError(
+            "application retriever returned unexpected native output"
+        )
+    if LEDGER_PATH.read_bytes() != expected_evidence:
+        raise RuntimeError(
+            "application executable did not recreate reference evidence"
+        )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

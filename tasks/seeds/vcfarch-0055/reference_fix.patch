+	MTU            int    `json:"mtu"`
+	StartIPAddress string `json:"startIpAddress"`
+	EndIPAddress   string `json:"endIpAddress"`
+}
+
+type ipRange struct {
+	StartIPAddress string `json:"startIpAddress"`
+	EndIPAddress   string `json:"endIpAddress"`
+}
+
+type sddcNetwork struct {
+	NetworkType            string    `json:"networkType"`
+	VLANID                 int       `json:"vlanId"`
+	Subnet                 string    `json:"subnet"`
+	Gateway                string    `json:"gateway"`
+	MTU                    int       `json:"mtu"`
+	IncludeIPAddressRanges []ipRange `json:"includeIpAddressRanges"`
+}
+
+type manager struct {
+	Hostname string `json:"hostname"`
+}
 
 // Build returns a VCF Installer SddcSpec derived from the supplied estate
 // requirements and pinned compatibility snapshot.
 func Build(estateJSON, compatibilityJSON []byte) ([]byte, error) {
-	return nil, errors.New("architecture design is not implemented")
+	var requirements estate
+	if err := json.Unmarshal(estateJSON, &requirements); err != nil {
+		return nil, fmt.Errorf("decode estate: %w", err)
+	}
+	var matrix compatibility
+	if err := json.Unmarshal(compatibilityJSON, &matrix); err != nil {
+		return nil, fmt.Errorf("decode compatibility snapshot: %w", err)
+	}
+	var selected *profile
+	for index := range matrix.Profiles {
+		if matrix.Profiles[index].ID == requirements.CompatibilityProfile {
+			selected = &matrix.Profiles[index]
+			break
+		}
+	}
+	if selected == nil {
+		return nil, fmt.Errorf("compatibility profile %q is absent", requirements.CompatibilityProfile)
+	}
+	if requirements.EstateKind != "greenfield" {
+		return nil, fmt.Errorf("estate kind %q is not a greenfield design", requirements.EstateKind)
+	}
+	if len(requirements.Hosts) != selected.MinimumHosts {
+		return nil, fmt.Errorf("inventory has %d hosts; profile requires exactly %d", len(requirements.Hosts), selected.MinimumHosts)
+	}
+
+	hosts := make([]map[string]any, 0, len(requirements.Hosts))
+	for _, host := range requirements.Hosts {
+		hosts = append(hosts, map[string]any{"hostname": host.Hostname})
+	}
+
+	networks := make([]sddcNetwork, 0, len(requirements.Networks))
+	networkTypes := make([]string, 0, len(requirements.Networks))
+	transportVLAN := 0
+	for _, item := range requirements.Networks {
+		networks = append(networks, sddcNetwork{
+			NetworkType: item.NetworkType,
+			VLANID:      item.VLANID,
+			Subnet:      item.Subnet,
+			Gateway:     item.Gateway,
+			MTU:         item.MTU,
+			IncludeIPAddressRanges: []ipRange{{
+				StartIPAddress: item.StartIPAddress,
+				EndIPAddress:   item.EndIPAddress,
+			}},
+		})
+		networkTypes = append(networkTypes, item.NetworkType)
+		if item.NetworkType == "HOST_TEP" {
+			transportVLAN = item.VLANID
+		}
+	}
+
+	nsxManagers := make([]manager, 0, len(requirements.Appliances.NSX.ManagerHostnames))
+	for _, hostname := range requirements.Appliances.NSX.ManagerHostnames {
+		nsxManagers = append(nsxManagers, manager{Hostname: hostname})
+	}
+
+	artifact := map[string]any{
+		"sddcId":       requirements.Site.SddcID,
+		"workflowType": selected.WorkflowType,
+		"version":      selected.TargetVersion,
+		"hostSpecs":    hosts,
+		"vcenterSpec": map[string]any{
+			"vcenterHostname":       requirements.Appliances.Vcenter.Hostname,
+			"rootVcenterPassword":   requirements.InstallerPlaceholders.VcenterRootPassword,
+			"vmSize":                requirements.Appliances.Vcenter.VMSize,
+			"storageSize":           requirements.Appliances.Vcenter.StorageSize,
+			"useExistingDeployment": false,
+			"version":               selected.Components["VCENTER"],
+		},
+		"clusterSpec": map[string]any{
+			"datacenterName":    requirements.Cluster.DatacenterName,
+			"clusterName":       requirements.Cluster.ClusterName,
+			"resourcePoolSpecs": requirements.Cluster.ResourcePools,
+		},
+		"dvsSpecs": []any{map[string]any{
+			"dvsName":         requirements.DistributedSwitch.Name,
+			"networks":        networkTypes,
+			"mtu":             requirements.DistributedSwitch.MTU,
+			"vmnicsToUplinks": requirements.DistributedSwitch.Uplinks,
+		}},
+		"nsxtSpec": map[string]any{
+			"nsxtManagers":            nsxManagers,
+			"nsxtManagerSize":         requirements.Appliances.NSX.ManagerSize,
+			"vipFqdn":                 requirements.Appliances.NSX.VIPFQDN,
+			"rootNsxtManagerPassword": requirements.InstallerPlaceholders.NSXRootPassword,
+			"nsxtAdminPassword":       requirements.InstallerPlaceholders.NSXAdminPassword,
+			"nsxtAuditPassword":       requirements.InstallerPlaceholders.NSXAuditPassword,
+			"transportVlanId":         transportVLAN,
+			"useExistingDeployment":   false,
+			"version":                 selected.Components["NSX"],
+		},
+		"networkSpecs": networks,
+		"dnsSpec": map[string]any{
+			"subdomain":   requirements.Site.DNSSubdomain,
+			"nameservers": requirements.Site.NameServers,
+		},
+		"ntpServers": requirements.Site.NTPServers,
+		"sddcManagerSpec": map[string]any{
+			"hostname":              requirements.Appliances.SddcManager.Hostname,
+			"rootPassword":          requirements.InstallerPlaceholders.SddcManagerRootPassword,
+			"sshPassword":           requirements.InstallerPlaceholders.SddcManagerSSHPassword,
+			"localUserPassword":     requirements.InstallerPlaceholders.SddcLocalUserPassword,
+			"useExistingDeployment": false,
+			"version":               selected.Components["SDDC_MANAGER"],
+		},
+		"managementPoolName":          requirements.Cluster.ClusterName + "-network-pool",
+		"ceipEnabled":                 requirements.CEIPEnabled,
+		"skipEsxThumbprintValidation": false,
+		"skipGatewayPingValidation":   false,
+		"securitySpec":                map[string]any{"esxiCertsMode": "VMCA"},
+		"datastoreSpec": map[string]any{
+			"vsanSpec": map[string]any{
+				"datastoreName":      requirements.Storage.DatastoreName,
+				"failuresToTolerate": requirements.Availability.HostFailuresToTolerate,
+				"esaConfig":          map[string]any{"enabled": true},
+			},
+		},
+		"vcfInstanceName": requirements.Site.SddcID + "-instance",
+	}
+
+	result, err := json.MarshalIndent(artifact, "", "  ")
+	if err != nil {
+		return nil, fmt.Errorf("encode SddcSpec: %w", err)
+	}
+	return append(result, '\n'), nil
 }

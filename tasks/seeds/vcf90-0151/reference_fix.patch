diff --git a/VcfAutomation.Policy/VcfAutomation.Policy.psm1 b/VcfAutomation.Policy/VcfAutomation.Policy.psm1
index 6287199..e201c78 100644
--- a/VcfAutomation.Policy/VcfAutomation.Policy.psm1
+++ b/VcfAutomation.Policy/VcfAutomation.Policy.psm1
@@ -26,7 +26,65 @@ function Set-VcfAutomationPolicy {
         [string] $OpaRegoCriteria
     )
 
-    throw 'Set-VcfAutomationPolicy is not implemented.'
+    $policy = [ordered]@{
+        typeId = $TypeId
+    }
+
+    $optionalProperties = [ordered]@{
+        Id = 'id'
+        Name = 'name'
+        Description = 'description'
+        ProjectId = 'projectId'
+        EnforcementType = 'enforcementType'
+        Definition = 'definition'
+        Criteria = 'criteria'
+        ScopeCriteria = 'scopeCriteria'
+        OpaRegoCriteria = 'opaRegoCriteria'
+    }
+    foreach ($parameterName in $optionalProperties.Keys) {
+        if ($PSBoundParameters.ContainsKey($parameterName)) {
+            $policy[$optionalProperties[$parameterName]] = $PSBoundParameters[$parameterName]
+        }
+    }
+
+    $body = $policy | ConvertTo-Json -Depth 30 -Compress
+    $headers = @{
+        Authorization = "Bearer $AccessToken"
+        Accept = 'application/json'
+    }
+
+    $uriBuilder = [System.UriBuilder]::new($Server)
+    $uriBuilder.Path = '/policy/api/policies'
+    $uriBuilder.Query = 'validationOnly=true'
+    $precheckUri = $uriBuilder.Uri
+
+    $request = @{
+        Method = 'Post'
+        Headers = $headers
+        ContentType = 'application/json'
+        Body = $body
+        SkipHttpErrorCheck = $true
+    }
+    $precheck = Invoke-WebRequest -Uri $precheckUri @request
+    if ([int] $precheck.StatusCode -notin @(200, 201, 202)) {
+        throw [System.InvalidOperationException]::new(
+            "VCF Automation policy validation failed with HTTP $($precheck.StatusCode)."
+        )
+    }
+
+    $uriBuilder.Query = ''
+    $mutation = Invoke-WebRequest -Uri $uriBuilder.Uri @request
+    if ([int] $mutation.StatusCode -notin @(200, 201, 202)) {
+        throw [System.InvalidOperationException]::new(
+            "VCF Automation policy create/update failed with HTTP $($mutation.StatusCode)."
+        )
+    }
+
+    [pscustomobject]@{
+        PrecheckStatusCode = [int] $precheck.StatusCode
+        StatusCode = [int] $mutation.StatusCode
+        Content = $mutation.Content
+    }
 }
 
 Export-ModuleMember -Function Set-VcfAutomationPolicy

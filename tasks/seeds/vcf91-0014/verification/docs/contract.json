{
  "contract_version": 1,
  "product": "VMware Cloud Foundation 9.1 SDDC Manager REST API",
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "openapi": "3.0.1",
    "info_title": "SDDC Manager API Reference Guide",
    "info_version": "9.1.0.0",
    "license": "Apache-2.0"
  },
  "operations": [
    {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema_ref": "#/components/schemas/TokenCreationSpec"
      },
      "responses": {
        "201": {
          "description": "Created",
          "content_type": "application/json",
          "schema_ref": "#/components/schemas/TokenPair"
        }
      }
    },
    {
      "operationId": "refreshAccessToken",
      "method": "PATCH",
      "path": "/v1/tokens/access-token/refresh",
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": {
          "type": "string",
          "description": "ID of the refresh token"
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "content_type": "application/json",
          "schema": {
            "type": "string"
          }
        }
      }
    },
    {
      "operationId": "getDomains",
      "method": "GET",
      "path": "/v1/domains",
      "query_parameters": [
        {
          "name": "type",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "name",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "vcFqdn",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "vcInstanceId",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "isManagementSsoDomain",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "pageNumber",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        },
        {
          "name": "pageSize",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        },
        {
          "name": "useCache",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Ok",
          "content_type": "application/json",
          "schema_ref": "#/components/schemas/PageOfDomain"
        }
      }
    },
    {
      "operationId": "getHosts",
      "method": "GET",
      "path": "/v1/hosts",
      "query_parameters": [
        {
          "name": "pageSize",
          "required": false,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "pageNumber",
          "required": false,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "fqdn",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "status",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "domainId",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "clusterId",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "networkpoolId",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "storageType",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "datastoreName",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "ipAddressVersionForVmotion",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "isStandalone",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "isLifecycleManaged",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "isVsanWitnessHost",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "size",
          "required": false,
          "deprecated": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "page",
          "required": false,
          "deprecated": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Ok",
          "content_type": "application/json",
          "schema_ref": "#/components/schemas/PageOfHost"
        }
      }
    }
  ],
  "schemas": {
    "TokenCreationSpec": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "apiKey": {
          "type": "string"
        },
        "idToken": {
          "type": "string"
        }
      }
    },
    "RefreshToken": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "TokenPair": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string"
        },
        "refreshToken": {
          "$ref": "#/components/schemas/RefreshToken"
        }
      }
    },
    "PageMetadata": {
      "type": "object",
      "properties": {
        "pageNumber": {
          "type": "integer",
          "format": "int32"
        },
        "pageSize": {
          "type": "integer",
          "format": "int32"
        },
        "totalElements": {
          "type": "integer",
          "format": "int32"
        },
        "totalPages": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "PageOfDomain": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Domain"
          }
        },
        "pageMetadata": {
          "$ref": "#/components/schemas/PageMetadata"
        }
      }
    },
    "Domain": {
      "type": "object",
      "task_response_projection": true,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      }
    },
    "PageOfHost": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Host"
          }
        },
        "pageMetadata": {
          "$ref": "#/components/schemas/PageMetadata"
        }
      }
    },
    "Host": {
      "type": "object",
      "task_response_projection": true,
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "fqdn": {
          "type": "string",
          "readOnly": true
        },
        "domain": {
          "$ref": "#/components/schemas/DomainReference"
        },
        "status": {
          "type": "string",
          "readOnly": true
        }
      }
    },
    "DomainReference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      }
    }
  }
}

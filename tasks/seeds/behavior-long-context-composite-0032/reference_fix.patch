+#!/usr/bin/env python3
+"""Reference proof using genuine coursedesk executions in dependent stages."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+import sys
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+TARGET_NAME = "Microeconomics"
+TARGET_CAMPUS = "Downtown"
+TARGET_STATUS = "active"
+FIELDS = (
+    ("Stable ID", "id"),
+    ("Name", "name"),
+    ("Campus", "campus"),
+    ("Status", "status"),
+    ("Course code", "course_code"),
+    ("Section", "section"),
+    ("Term", "term"),
+    ("Meeting time", "meeting_time"),
+    ("Room", "room"),
+    ("Instructor", "instructor"),
+    ("Credits", "credits"),
+    ("Start date", "start_date"),
+    ("End date", "end_date"),
+    ("Related course IDs", "related_course_ids"),
+    ("Registrar note", "registrar_note"),
+)
+WORKER = r"""
+import subprocess
+import sys
+
+completed = subprocess.run(
+    sys.argv[1:],
+    cwd=".",
+    stdin=subprocess.DEVNULL,
+    stdout=subprocess.PIPE,
+    stderr=subprocess.PIPE,
+    check=False,
+    timeout=15,
+)
+sys.stdout.buffer.write(completed.stdout)
+sys.stderr.buffer.write(completed.stderr)
+raise SystemExit(completed.returncode)
+"""
+
+
+def run_action(arguments: list[str]) -> dict[str, Any]:
+    completed = subprocess.run(
+        [sys.executable, "-B", "-c", WORKER, *arguments],
+        cwd=ROOT,
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        check=False,
+        timeout=20,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(
+            completed.stderr.decode("utf-8", errors="replace").strip()
+            or "course operation failed"
+        )
+    try:
+        result = json.loads(completed.stdout)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("course operation returned invalid JSON") from error
+    if not isinstance(result, dict):
+        raise RuntimeError("course operation returned a non-object")
+    return result
+
+
+def main() -> int:
+    setup = subprocess.run(
+        [sys.executable, "-B", ".protected/setup.py"],
+        cwd=ROOT,
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        check=False,
+        timeout=15,
+    )
+    if setup.returncode != 0:
+        raise RuntimeError("reference runtime setup failed")
+
+    help_result = subprocess.run(
+        ["./coursedesk", "--help"],
+        cwd=ROOT,
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        check=False,
+        timeout=15,
+    )
+    if help_result.returncode != 0 or b"search" not in help_result.stdout:
+        raise RuntimeError("course executable help is unavailable")
+
+    search = run_action(
+        ["./coursedesk", "search", "--name", TARGET_NAME, "--campus", TARGET_CAMPUS]
+    )
+    matches = search.get("matches")
+    if not isinstance(matches, list):
+        raise RuntimeError("search summaries are malformed")
+    eligible = [
+        match
+        for match in matches
+        if isinstance(match, dict)
+        and match.get("name") == TARGET_NAME
+        and match.get("campus") == TARGET_CAMPUS
+        and match.get("status") == TARGET_STATUS
+        and isinstance(match.get("id"), str)
+        and match["id"]
+    ]
+    if len(eligible) != 1:
+        raise RuntimeError("active Downtown course did not resolve uniquely")
+    stable_id = eligible[0]["id"]
+
+    details = run_action(["./coursedesk", "details", "--id", stable_id])
+    record = details.get("record")
+    if (
+        not isinstance(record, dict)
+        or record.get("id") != stable_id
+        or record.get("name") != TARGET_NAME
+        or record.get("campus") != TARGET_CAMPUS
+        or record.get("status") != TARGET_STATUS
+        or not all(isinstance(record.get(key), str) for _, key in FIELDS)
+    ):
+        raise RuntimeError("complete response did not contain the requested course")
+
+    report = "".join(f"{label}: {record[key]}\n" for label, key in FIELDS)
+    (ROOT / "course-details.md").write_text(report, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

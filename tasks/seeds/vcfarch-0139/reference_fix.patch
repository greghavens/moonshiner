+Set-StrictMode -Version Latest
+
+function Get-JsonDocument {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $LiteralPath
+    )
+
+    $resolved = (Resolve-Path -LiteralPath $LiteralPath -ErrorAction Stop).Path
+    Get-Content -LiteralPath $resolved -Raw -Encoding utf8 | ConvertFrom-Json -Depth 100
+}
+
+function Get-ApplicableGates {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [object[]] $Gates,
+
+        [Parameter(Mandatory)]
+        [string] $ComponentId,
+
+        [Parameter(Mandatory)]
+        [string] $CurrentVersion,
+
+        [Parameter(Mandatory)]
+        [string] $TargetVersion
+    )
+
+    @($Gates | Where-Object {
+        $_.componentIds -contains $ComponentId -and
+        $_.currentVersion -eq $CurrentVersion -and
+        $_.targetVersion -eq $TargetVersion
+    })
+}
+
+function New-TargetSddcSpec {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [pscustomobject] $Design,
+
+        [Parameter(Mandatory)]
+        [hashtable] $TargetVersions
+    )
+
+    # Resolve one local API binding from each required SDK without connecting
+    # to an appliance. The Initialize-* calls below construct the SDK models.
+    if ($null -eq (Get-VcfInstallerOperation -Name ValidateSddcSpec)) {
+        throw 'The VCF Installer validation operation is unavailable.'
+    }
+    if ($null -eq (Get-VcfSddcManagerOperation -Name GetDomain)) {
+        throw 'The SDDC Manager domain operation is unavailable.'
+    }
+
+    $dnsModel = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $Design.dns.subdomain `
+        -Nameservers @($Design.dns.nameservers)
+
+    $networkModels = @($Design.networks | ForEach-Object {
+        Initialize-VcfInstallerSddcNetworkSpec `
+            -NetworkType $_.networkType `
+            -VlanId $_.vlanId `
+            -Subnet $_.subnet `
+            -Gateway $_.gateway `
+            -SubnetMask $_.subnetMask `
+            -Mtu $_.mtu
+    })
+
+    $vcenterModel = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname $Design.vcenter.hostname `
+        -RootVcenterPassword $Design.vcenter.rootPasswordPlaceholder `
+        -VmSize $Design.vcenter.vmSize `
+        -StorageSize $Design.vcenter.storageSize `
+        -SsoDomain $Design.vcenter.ssoDomain `
+        -Version $TargetVersions['vcenter'] `
+        -UseExistingDeployment:$false
+
+    $sddcModel = Initialize-VcfInstallerSddcSpec `
+        -SddcId $Design.sddcId `
+        -WorkflowType VCF `
+        -Version $Design.bundleVersion `
+        -VcenterSpec $vcenterModel `
+        -NetworkSpecs $networkModels `
+        -DnsSpec $dnsModel `
+        -NtpServers @($Design.ntpServers) `
+        -VcfInstanceName $Design.vcfInstanceName
+
+    if ($null -eq $sddcModel) {
+        throw 'VMware.Sdk.Vcf.Installer did not construct an SddcSpec.'
+    }
+
+    # Emit the API's camel-case wire contract. The SDK models above establish the
+    # same typed contract while this explicit projection keeps serialization stable.
+    [ordered]@{
+        sddcId = $Design.sddcId
+        workflowType = 'VCF'
+        version = $Design.bundleVersion
+        vcenterSpec = [ordered]@{
+            vcenterHostname = $Design.vcenter.hostname
+            rootVcenterPassword = $Design.vcenter.rootPasswordPlaceholder
+            vmSize = $Design.vcenter.vmSize
+            storageSize = $Design.vcenter.storageSize
+            ssoDomain = $Design.vcenter.ssoDomain
+            version = $TargetVersions['vcenter']
+            useExistingDeployment = $false
+        }
+        networkSpecs = @($Design.networks | ForEach-Object {
+            [ordered]@{
+                networkType = $_.networkType
+                vlanId = $_.vlanId
+                subnet = $_.subnet
+                gateway = $_.gateway
+                subnetMask = $_.subnetMask
+                mtu = $_.mtu
+            }
+        })
+        dnsSpec = [ordered]@{
+            subdomain = $Design.dns.subdomain
+            nameservers = @($Design.dns.nameservers)
+        }
+        ntpServers = @($Design.ntpServers)
+        vcfInstanceName = $Design.vcfInstanceName
+    }
+}
+
+function New-VcfMixedEstateArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $InventoryPath,
+
+        [Parameter(Mandatory)]
+        [string] $CompatibilitySnapshotPath,
+
+        [Parameter(Mandatory)]
+        [string] $OutputPath
+    )
+
+    $inventory = Get-JsonDocument -LiteralPath $InventoryPath
+    $snapshot = Get-JsonDocument -LiteralPath $CompatibilitySnapshotPath
+
+    if ($inventory.estateKind -ne 'existing') {
+        throw "This module requires an existing-estate inventory."
+    }
+    if ($inventory.targetDesign.bundleVersion -ne $snapshot.targetBundle.version) {
+        throw "Inventory target and compatibility snapshot target do not match."
+    }
+
+    $targetVersions = @{}
+    foreach ($targetComponent in $snapshot.targetBundle.components) {
+        $targetVersions[$targetComponent.componentId] = $targetComponent.version
+    }
+
+    $componentPlans = @()
+    foreach ($component in $inventory.components) {
+        $targetVersion = [string] $targetVersions[$component.id]
+        if ([string]::IsNullOrWhiteSpace($targetVersion)) {
+            throw "No target version exists for component '$($component.id)'."
+        }
+        $gates = @(Get-ApplicableGates `
+            -Gates $snapshot.gates `
+            -ComponentId $component.id `
+            -CurrentVersion $component.version `
+            -TargetVersion $targetVersion)
+        if ($gates.Count -eq 0) {
+            throw "No compatibility gate exists for component '$($component.id)'."
+        }
+        $requiredDispositions = @($gates | ForEach-Object {
+            if ($_.PSObject.Properties.Name -contains 'requiredDisposition') {
+                $_.requiredDisposition
+            }
+        } | Where-Object { $_ } | Select-Object -Unique)
+        if ($requiredDispositions.Count -ne 1) {
+            throw "Component '$($component.id)' has no unambiguous disposition."
+        }
+
+        $componentPlans += [ordered]@{
+            componentId = $component.id
+            name = $component.name
+            currentVersion = $component.version
+            targetVersion = $targetVersion
+            disposition = $requiredDispositions[0]
+            gates = @($gates.id)
+        }
+    }
+
+    $allComponents = @($inventory.components.id)
+    $workloadComponents = @($allComponents | Where-Object { $_ -ne 'sddc-manager' })
+    $allGates = @($snapshot.gates.id)
+    $workloadGates = @($snapshot.gates | Where-Object {
+        @($_.componentIds | Where-Object { $workloadComponents -contains $_ }).Count -gt 0
+    } | Select-Object -ExpandProperty id)
+
+    $stepDefinitions = @(
+        [pscustomobject]@{
+            phase = 'assessment'
+            action = 'validate-source'
+            title = 'Validate source recoverability'
+            components = $allComponents
+            gates = $allGates
+            criterion = 'Source health and restorable backups are confirmed without changing component versions.'
+        }
+        [pscustomobject]@{
+            phase = 'target-deploy'
+            action = 'deploy-target'
+            title = 'Deploy the parallel VCF 9.1 target'
+            components = $allComponents
+            gates = $allGates
+            criterion = 'All target bundle components are deployed as a fresh, isolated VCF instance.'
+        }
+        [pscustomobject]@{
+            phase = 'target-deploy'
+            action = 'validate-target'
+            title = 'Validate the target combination'
+            components = $allComponents
+            gates = $allGates
+            criterion = 'Installer validation and target service health pass for the pinned 9.1 combination.'
+        }
+        [pscustomobject]@{
+            phase = 'bridge'
+            action = 'establish-bridge'
+            title = 'Establish temporary migration connectivity'
+            components = $workloadComponents
+            gates = $workloadGates
+            criterion = 'Routing, name resolution, identity, and workload network mappings are proven end to end.'
+        }
+        [pscustomobject]@{
+            phase = 'workload-migration'
+            action = 'migrate-workloads'
+            title = 'Cut workloads over to the target'
+            components = $workloadComponents
+            gates = $workloadGates
+            criterion = 'Application validation succeeds on target hosts and target NSX networks.'
+        }
+        [pscustomobject]@{
+            phase = 'retirement'
+            action = 'retire-source'
+            title = 'Retire the unchanged source stack'
+            components = $allComponents
+            gates = $allGates
+            criterion = 'The source stack is decommissioned only after workload acceptance and rollback expiry.'
+        }
+    )
+
+    $steps = @()
+    for ($index = 0; $index -lt $stepDefinitions.Count; $index++) {
+        $definition = $stepDefinitions[$index]
+        $id = ('step-{0:D2}-{1}' -f ($index + 1), $definition.action)
+        $dependencies = @()
+        if ($index -gt 0) {
+            $dependencies = @($steps[$index - 1].id)
+        }
+        $steps += [ordered]@{
+            order = $index + 1
+            id = $id
+            phase = $definition.phase
+            action = $definition.action
+            title = $definition.title
+            components = @($definition.components)
+            gates = @($definition.gates)
+            dependsOn = @($dependencies)
+            successCriteria = @($definition.criterion)
+        }
+    }
+
+    $architecture = [ordered]@{
+        schemaVersion = 1
+        kind = 'existing-estate'
+        estateId = $inventory.estateId
+        targetSddcSpec = New-TargetSddcSpec `
+            -Design $inventory.targetDesign `
+            -TargetVersions $targetVersions
+        migrationPlan = [ordered]@{
+            targetBundleVersion = $snapshot.targetBundle.version
+            strategy = $snapshot.routeConstraints.requiredStrategy
+            components = $componentPlans
+            steps = $steps
+            finalState = $snapshot.routeConstraints.finalState
+        }
+    }
+
+    $parent = Split-Path -Parent $OutputPath
+    if ($parent) {
+        [void] (New-Item -ItemType Directory -Path $parent -Force)
+    }
+    $architecture | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $OutputPath -Encoding utf8
+    Get-Item -LiteralPath $OutputPath
+}
+
+Export-ModuleMember -Function New-VcfMixedEstateArchitecture

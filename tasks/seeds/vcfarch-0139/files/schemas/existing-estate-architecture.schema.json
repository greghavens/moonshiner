{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0139:existing-estate-architecture",
  "title": "Existing VCF estate architecture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "estateId",
    "targetSddcSpec",
    "migrationPlan"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "existing-estate"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetSddcSpec": {
      "type": "object"
    },
    "migrationPlan": {
      "$ref": "#/$defs/migrationPlan"
    }
  },
  "$defs": {
    "migrationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetBundleVersion",
        "strategy",
        "components",
        "steps",
        "finalState"
      ],
      "properties": {
        "targetBundleVersion": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/componentPlan"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "finalState": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "componentPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "name",
        "currentVersion",
        "targetVersion",
        "disposition",
        "gates"
      ],
      "properties": {
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "currentVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "retain",
            "replace",
            "upgrade-in-place"
          ]
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "id",
        "phase",
        "action",
        "title",
        "components",
        "gates",
        "dependsOn",
        "successCriteria"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "phase": {
          "enum": [
            "assessment",
            "target-deploy",
            "bridge",
            "workload-migration",
            "retirement"
          ]
        },
        "action": {
          "enum": [
            "validate-source",
            "deploy-target",
            "validate-target",
            "establish-bridge",
            "migrate-workloads",
            "retire-source"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "successCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

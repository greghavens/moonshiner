+func stageFile(dir, name string, data []byte) (string, error) {
+	f, err := os.CreateTemp(dir, ".vcfarch-stage-")
+	if err != nil {
+		return "", fmt.Errorf("vcfarch: stage %s: %w", name, err)
+	}
+	path := f.Name()
+	ok := false
+	defer func() {
+		_ = f.Close()
+		if !ok {
+			_ = os.Remove(path)
+		}
+	}()
+	if err := f.Chmod(0o644); err != nil {
+		return "", fmt.Errorf("vcfarch: chmod staged %s: %w", name, err)
+	}
+	if _, err := io.Copy(f, bytes.NewReader(data)); err != nil {
+		return "", fmt.Errorf("vcfarch: write staged %s: %w", name, err)
+	}
+	if err := f.Sync(); err != nil {
+		return "", fmt.Errorf("vcfarch: sync staged %s: %w", name, err)
+	}
+	if err := f.Close(); err != nil {
+		return "", fmt.Errorf("vcfarch: close staged %s: %w", name, err)
+	}
+	ok = true
+	return path, nil
+}
+
+func reservePath(dir, pattern string) (string, error) {
+	f, err := os.CreateTemp(dir, pattern)
+	if err != nil {
+		return "", fmt.Errorf("vcfarch: reserve backup path: %w", err)
+	}
+	path := f.Name()
+	if err := f.Close(); err != nil {
+		return "", err
+	}
+	if err := os.Remove(path); err != nil {
+		return "", err
+	}
+	return path, nil
+}
+
+func cleanupPublish(items []publishItem) {
+	for _, item := range items {
+		if item.staged != "" {
+			_ = os.Remove(item.staged)
+		}
+	}
+}
+
+func restorePublish(items []publishItem) {
+	for _, item := range items {
+		if item.installed {
+			_ = os.RemoveAll(item.target)
+		}
+	}
+	for _, item := range items {
+		if item.backup != "" {
+			_ = os.Rename(item.backup, item.target)
+		}
+		if item.staged != "" {
+			_ = os.Remove(item.staged)
+		}
+	}
+}

+func selectHosts(req Requirements) ([]HostCandidate, error) {
+	selected := make([]HostCandidate, 0, len(req.Availability.Sites)*req.Availability.HostsPerSite)
+	seenSites := map[string]bool{}
+	for _, site := range req.Availability.Sites {
+		if site == "" || seenSites[site] {
+			return nil, fmt.Errorf("vcfarch: invalid or duplicate required site %q", site)
+		}
+		seenSites[site] = true
+		candidates := make([]HostCandidate, 0)
+		for _, host := range req.Hosts {
+			if host.Site == site {
+				candidates = append(candidates, host)
+			}
+		}
+		sort.Slice(candidates, func(i, j int) bool { return candidates[i].Hostname < candidates[j].Hostname })
+		if len(candidates) < req.Availability.HostsPerSite {
+			return nil, fmt.Errorf("vcfarch: site %s has %d hosts, needs %d", site, len(candidates), req.Availability.HostsPerSite)
+		}
+		selected = append(selected, candidates[:req.Availability.HostsPerSite]...)
+	}
+	return selected, nil
+}
+
+func checkCapacity(req Requirements, hosts []HostCandidate) error {
+	siteCores := map[string]int{}
+	siteMemory := map[string]int{}
+	siteStorage := map[string]float64{}
+	seen := map[string]bool{}
+	for _, host := range hosts {
+		if seen[host.Hostname] {
+			return fmt.Errorf("vcfarch: selected host %s twice", host.Hostname)
+		}
+		seen[host.Hostname] = true
+		siteCores[host.Site] += host.Cores
+		siteMemory[host.Site] += host.MemoryGiB
+		siteStorage[host.Site] += host.RawStorageTiB
+	}
+	for _, site := range req.Availability.Sites {
+		usableStorage := siteStorage[site] * float64(100-req.Capacity.FreeSpacePercent) / 100
+		if siteCores[site] < req.Capacity.UsableCores || siteMemory[site] < req.Capacity.UsableMemoryGiB || usableStorage+1e-9 < req.Capacity.UsableStorageTiB {
+			return fmt.Errorf("vcfarch: site %s cannot carry required workload after peer-site failure", site)
+		}
+	}
+	totalStorage := 0.0
+	for _, raw := range siteStorage {
+		totalStorage += raw
+	}
+	usableStorage := totalStorage / float64(req.Capacity.StorageCopies) * float64(100-req.Capacity.FreeSpacePercent) / 100
+	if usableStorage+1e-9 < req.Capacity.UsableStorageTiB {
+		return fmt.Errorf("vcfarch: %.2f TiB usable storage does not meet %.2f TiB", usableStorage, req.Capacity.UsableStorageTiB)
+	}
+	return nil
+}

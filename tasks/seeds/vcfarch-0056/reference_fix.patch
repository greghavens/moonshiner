+func validateRequirements(req Requirements) error {
+	for name, value := range map[string]string{
+		"designId": req.DesignID, "fleet": req.Fleet, "workloadDomain": req.WorkloadDomain,
+		"managementDomain": req.ManagementDomain, "targetVersion": req.TargetVersion,
+		"workflowType": req.WorkflowType, "domainSuffix": req.DomainSuffix,
+	} {
+		if strings.TrimSpace(value) == "" {
+			return fmt.Errorf("vcfarch: requirements %s is required", name)
+		}
+	}
+	if req.ManagementDomain == req.WorkloadDomain {
+		return errors.New("vcfarch: workload domain cannot be the protected management domain")
+	}
+	if req.TargetVersion != "9.0.0.0" || req.WorkflowType != "VCF_EXTEND" {
+		return fmt.Errorf("vcfarch: unsupported target/workflow %s %s", req.TargetVersion, req.WorkflowType)
+	}
+	if len(req.DNS) == 0 || len(req.NTP) == 0 {
+		return errors.New("vcfarch: DNS and NTP inputs are required")
+	}
+	if len(req.Availability.Sites) < 2 || req.Availability.HostsPerSite < 1 || !req.Availability.SurviveSiteFailure {
+		return errors.New("vcfarch: a site-survivable multi-site requirement is required")
+	}
+	if req.Availability.NSXManagerCount != len(req.Names.NSXManagers) || req.Availability.NSXManagerCount < 3 {
+		return errors.New("vcfarch: NSX manager names do not satisfy the HA count")
+	}
+	if req.Capacity.UsableCores <= 0 || req.Capacity.UsableMemoryGiB <= 0 || req.Capacity.UsableStorageTiB <= 0 || req.Capacity.StorageCopies < 1 || req.Capacity.FreeSpacePercent < 0 || req.Capacity.FreeSpacePercent >= 100 {
+		return errors.New("vcfarch: invalid capacity requirement")
+	}
+
+	hosts := map[string]bool{}
+	for _, host := range req.Hosts {
+		if host.Hostname == "" || host.Site == "" || host.Cores <= 0 || host.MemoryGiB <= 0 || host.RawStorageTiB <= 0 {
+			return fmt.Errorf("vcfarch: invalid host candidate %q", host.Hostname)
+		}
+		if hosts[host.Hostname] {
+			return fmt.Errorf("vcfarch: duplicate hostname %q", host.Hostname)
+		}
+		hosts[host.Hostname] = true
+	}
+
+	networkTypes := map[string]bool{}
+	for _, network := range req.Networks {
+		if networkTypes[network.Type] {
+			return fmt.Errorf("vcfarch: duplicate network type %q", network.Type)
+		}
+		networkTypes[network.Type] = true
+		if network.Switch != "system" && network.Switch != "overlay" {
+			return fmt.Errorf("vcfarch: network %s names unknown switch %q", network.Type, network.Switch)
+		}
+		if network.VLANID < 0 || network.VLANID > 4094 || network.MTU < 1280 || network.MTU > 9190 {
+			return fmt.Errorf("vcfarch: network %s has invalid VLAN or MTU", network.Type)
+		}
+		_, subnet, err := net.ParseCIDR(network.Subnet)
+		if err != nil {
+			return fmt.Errorf("vcfarch: network %s subnet: %w", network.Type, err)
+		}
+		for label, address := range map[string]string{"gateway": network.Gateway, "start": network.Start, "end": network.End} {
+			ip := net.ParseIP(address)
+			if ip == nil || !subnet.Contains(ip) {
+				return fmt.Errorf("vcfarch: network %s %s is outside its subnet", network.Type, label)
+			}
+		}
+	}
+	for _, required := range []string{"MANAGEMENT", "VMOTION", "VSAN", "VM_MANAGEMENT", "NSX_TEP"} {
+		if !networkTypes[required] {
+			return fmt.Errorf("vcfarch: required network %s is missing", required)
+		}
+	}
+	return nil
+}
+
+func validateEstate(estate Estate) error {
+	if estate.EstateID == "" || estate.Fleet == "" || estate.WorkloadDomain == "" || estate.ManagementDomain == "" {
+		return errors.New("vcfarch: estate identity and scope fields are required")
+	}
+	if estate.WorkloadDomain == estate.ManagementDomain {
+		return errors.New("vcfarch: estate workload domain is the protected management domain")
+	}
+	seen := map[string]bool{}
+	for _, component := range estate.Components {
+		if component.Name == "" || component.Version == "" {
+			return errors.New("vcfarch: estate component name and version are required")
+		}
+		key := componentKey(component.Name, component.Version)
+		if seen[key] {
+			return fmt.Errorf("vcfarch: duplicate estate component %s %s", component.Name, component.Version)
+		}
+		seen[key] = true
+	}
+	if len(estate.Components) == 0 {
+		return errors.New("vcfarch: estate has no components")
+	}
+	return nil
+}
+
+func validateSnapshot(snapshot CompatibilitySnapshot) error {
+	if snapshot.SchemaVersion == "" || snapshot.SnapshotID == "" || snapshot.TargetRelease == "" {
+		return errors.New("vcfarch: compatibility snapshot identity is incomplete")
+	}
+	seen := map[string]bool{}
+	orders := map[int]bool{}
+	for _, transition := range snapshot.Transitions {
+		key := componentKey(transition.Component, transition.FromVersion)
+		if transition.Component == "" || transition.FromVersion == "" || transition.Target.Component == "" || transition.Target.Version == "" || transition.Action == "" || transition.Order <= 0 || len(transition.Gates) == 0 {
+			return fmt.Errorf("vcfarch: incomplete compatibility transition %q", transition.Component)
+		}
+		if transition.Target.Version != snapshot.TargetRelease {
+			return fmt.Errorf("vcfarch: transition %s targets %s, not snapshot release %s", transition.Component, transition.Target.Version, snapshot.TargetRelease)
+		}
+		if seen[key] {
+			return fmt.Errorf("vcfarch: duplicate compatibility transition %s %s", transition.Component, transition.FromVersion)
+		}
+		if orders[transition.Order] {
+			return fmt.Errorf("vcfarch: duplicate compatibility order %d", transition.Order)
+		}
+		seen[key] = true
+		orders[transition.Order] = true
+		gateSeen := map[string]bool{}
+		for _, gate := range transition.Gates {
+			if gate == "" || gateSeen[gate] {
+				return fmt.Errorf("vcfarch: invalid or duplicate gate for %s", transition.Component)
+			}
+			gateSeen[gate] = true
+		}
+	}
+	if len(snapshot.Transitions) == 0 {
+		return errors.New("vcfarch: compatibility snapshot has no transitions")
+	}
+	return nil
+}

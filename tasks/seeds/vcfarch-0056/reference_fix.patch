 func BuildMigrationPlan(estate Estate, snapshot CompatibilitySnapshot) (MigrationPlan, error) {
-	return MigrationPlan{}, ErrNotImplemented
+	if err := validateEstate(estate); err != nil {
+		return MigrationPlan{}, err
+	}
+	if err := validateSnapshot(snapshot); err != nil {
+		return MigrationPlan{}, err
+	}
+	if estate.ManagementDomain == estate.WorkloadDomain {
+		return MigrationPlan{}, errors.New("vcfarch: workload domain cannot be the protected management domain")
+	}
+
+	transitions := make(map[string]Transition, len(snapshot.Transitions))
+	for _, transition := range snapshot.Transitions {
+		transitions[componentKey(transition.Component, transition.FromVersion)] = transition
+	}
+
+	steps := make([]MigrationStep, 0, len(estate.Components))
+	for _, component := range estate.Components {
+		transition, ok := transitions[componentKey(component.Name, component.Version)]
+		if !ok {
+			return MigrationPlan{}, fmt.Errorf("vcfarch: no supported transition for %s %s", component.Name, component.Version)
+		}
+		for _, protected := range estate.ProtectedSystems {
+			if strings.EqualFold(transition.Target.Component, protected) {
+				return MigrationPlan{}, fmt.Errorf("vcfarch: transition for %s targets protected management system %s", component.Name, protected)
+			}
+		}
+		steps = append(steps, MigrationStep{
+			Order:          transition.Order,
+			Component:      component.Name,
+			CurrentVersion: component.Version,
+			Target:         transition.Target,
+			Action:         transition.Action,
+			Gates:          append([]string(nil), transition.Gates...),
+		})
+	}
+	sort.Slice(steps, func(i, j int) bool { return steps[i].Order < steps[j].Order })
+	for i := 1; i < len(steps); i++ {
+		if steps[i-1].Order >= steps[i].Order {
+			return MigrationPlan{}, fmt.Errorf("vcfarch: migration order %d is not unique and increasing", steps[i].Order)
+		}
+	}
+
+	return MigrationPlan{
+		SchemaVersion: "1.0",
+		EstateID:      estate.EstateID,
+		Scope: MigrationScope{
+			Fleet:                  estate.Fleet,
+			WorkloadDomain:         estate.WorkloadDomain,
+			ManagementDomain:       estate.ManagementDomain,
+			ManagementDomainAction: "none",
+		},
+		Steps: steps,
+	}, nil
 }
 

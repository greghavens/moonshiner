diff --git a/architecture_test.go b/architecture_test.go
new file mode 100644
index 0000000..afffe1b
--- /dev/null
+++ b/architecture_test.go
@@ -0,0 +1,223 @@
+package vcfarch
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func loadFixtureInputs(t *testing.T) Inputs {
+	t.Helper()
+	inputs, err := LoadInputs("fixtures/requirements.json", "fixtures/estate.json", "pinned/compatibility.json")
+	if err != nil {
+		t.Fatalf("LoadInputs: %v", err)
+	}
+	return inputs
+}
+
+func TestLoadInputs(t *testing.T) {
+	base := loadFixtureInputs(t)
+	tests := []struct {
+		name   string
+		mutate func(*Inputs)
+		want   string
+	}{
+		{"valid", func(*Inputs) {}, ""},
+		{"duplicate host", func(in *Inputs) { in.Requirements.Hosts = append(in.Requirements.Hosts, in.Requirements.Hosts[0]) }, "duplicate hostname"},
+		{"duplicate estate component", func(in *Inputs) { in.Estate.Components = append(in.Estate.Components, in.Estate.Components[0]) }, "duplicate estate component"},
+		{"duplicate transition", func(in *Inputs) {
+			in.Compatibility.Transitions = append(in.Compatibility.Transitions, in.Compatibility.Transitions[0])
+		}, "duplicate compatibility transition"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			in := deepCopy(t, base)
+			tc.mutate(&in)
+			dir := t.TempDir()
+			paths := []string{filepath.Join(dir, "requirements.json"), filepath.Join(dir, "estate.json"), filepath.Join(dir, "compatibility.json")}
+			writeJSON(t, paths[0], in.Requirements)
+			writeJSON(t, paths[1], in.Estate)
+			writeJSON(t, paths[2], in.Compatibility)
+			_, err := LoadInputs(paths[0], paths[1], paths[2])
+			if tc.want == "" {
+				if err != nil {
+					t.Fatalf("LoadInputs: %v", err)
+				}
+				return
+			}
+			if err == nil || !strings.Contains(err.Error(), tc.want) {
+				t.Fatalf("error = %v, want text %q", err, tc.want)
+			}
+		})
+	}
+}
+
+func TestBuildSddcSpec(t *testing.T) {
+	base := loadFixtureInputs(t).Requirements
+	tests := []struct {
+		name   string
+		mutate func(*Requirements)
+		want   string
+	}{
+		{"valid", func(*Requirements) {}, ""},
+		{"site lacks candidates", func(req *Requirements) { req.Availability.HostsPerSite = 6 }, "needs 6"},
+		{"cpu capacity", func(req *Requirements) { req.Capacity.UsableCores = 300 }, "cannot carry"},
+		{"memory capacity", func(req *Requirements) { req.Capacity.UsableMemoryGiB = 5000 }, "cannot carry"},
+		{"storage capacity", func(req *Requirements) { req.Capacity.UsableStorageTiB = 50 }, "cannot carry"},
+		{"management collision", func(req *Requirements) { req.WorkloadDomain = req.ManagementDomain }, "protected management domain"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			req := deepCopy(t, base)
+			tc.mutate(&req)
+			spec, err := BuildSddcSpec(req)
+			if tc.want != "" {
+				if err == nil || !strings.Contains(err.Error(), tc.want) {
+					t.Fatalf("error = %v, want text %q", err, tc.want)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("BuildSddcSpec: %v", err)
+			}
+			if spec["workflowType"] != "VCF_EXTEND" || spec["version"] != "9.0.0.0" {
+				t.Fatalf("unexpected identity: %#v", spec)
+			}
+		})
+	}
+}
+
+func TestBuildMigrationPlan(t *testing.T) {
+	inputs := loadFixtureInputs(t)
+	tests := []struct {
+		name     string
+		estate   Estate
+		snapshot CompatibilitySnapshot
+		want     string
+	}{
+		{"valid", inputs.Estate, inputs.Compatibility, ""},
+		{"unsupported component", withComponentVersion(t, inputs.Estate, "NSX", "4.2.3.3"), inputs.Compatibility, "no supported transition"},
+		{"management collision", withManagementCollision(inputs.Estate), inputs.Compatibility, "protected management domain"},
+		{"duplicate order", inputs.Estate, withDuplicateOrder(t, inputs.Compatibility), "duplicate compatibility order"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			plan, err := BuildMigrationPlan(tc.estate, tc.snapshot)
+			if tc.want != "" {
+				if err == nil || !strings.Contains(err.Error(), tc.want) {
+					t.Fatalf("error = %v, want text %q", err, tc.want)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("BuildMigrationPlan: %v", err)
+			}
+			if len(plan.Steps) != len(tc.estate.Components) {
+				t.Fatalf("got %d steps, want %d", len(plan.Steps), len(tc.estate.Components))
+			}
+			for i := 1; i < len(plan.Steps); i++ {
+				if plan.Steps[i-1].Order >= plan.Steps[i].Order {
+					t.Fatal("steps are not strictly ordered")
+				}
+			}
+		})
+	}
+}
+
+func TestWriteArtifacts(t *testing.T) {
+	inputs := loadFixtureInputs(t)
+	spec, err := BuildSddcSpec(inputs.Requirements)
+	if err != nil {
+		t.Fatal(err)
+	}
+	plan, err := BuildMigrationPlan(inputs.Estate, inputs.Compatibility)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tests := []struct {
+		name string
+		spec SddcSpec
+		ok   bool
+	}{
+		{"valid", spec, true},
+		{"encoding failure changes nothing", SddcSpec{"unsupported": func() {}}, false},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			dir := t.TempDir()
+			oldSpec := []byte("old spec\n")
+			oldPlan := []byte("old plan\n")
+			if err := os.WriteFile(filepath.Join(dir, "sddc-spec.json"), oldSpec, 0o644); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(filepath.Join(dir, "migration-plan.json"), oldPlan, 0o644); err != nil {
+				t.Fatal(err)
+			}
+			err := WriteArtifacts(dir, tc.spec, plan)
+			if tc.ok {
+				if err != nil {
+					t.Fatalf("WriteArtifacts: %v", err)
+				}
+				return
+			}
+			if err == nil {
+				t.Fatal("WriteArtifacts returned nil error")
+			}
+			gotSpec, _ := os.ReadFile(filepath.Join(dir, "sddc-spec.json"))
+			gotPlan, _ := os.ReadFile(filepath.Join(dir, "migration-plan.json"))
+			if !reflect.DeepEqual(gotSpec, oldSpec) || !reflect.DeepEqual(gotPlan, oldPlan) {
+				t.Fatal("failed publication changed one or both existing artifacts")
+			}
+		})
+	}
+}
+
+func deepCopy[T any](t *testing.T, in T) T {
+	t.Helper()
+	raw, err := json.Marshal(in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var out T
+	if err := json.Unmarshal(raw, &out); err != nil {
+		t.Fatal(err)
+	}
+	return out
+}
+
+func writeJSON(t *testing.T, path string, value any) {
+	t.Helper()
+	raw, err := json.Marshal(value)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, raw, 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func withComponentVersion(t *testing.T, estate Estate, component, version string) Estate {
+	t.Helper()
+	out := deepCopy(t, estate)
+	for i := range out.Components {
+		if out.Components[i].Name == component {
+			out.Components[i].Version = version
+		}
+	}
+	return out
+}
+
+func withManagementCollision(estate Estate) Estate {
+	estate.WorkloadDomain = estate.ManagementDomain
+	return estate
+}
+
+func withDuplicateOrder(t *testing.T, snapshot CompatibilitySnapshot) CompatibilitySnapshot {
+	t.Helper()
+	out := deepCopy(t, snapshot)
+	out.Transitions[1].Order = out.Transitions[0].Order
+	return out
+}

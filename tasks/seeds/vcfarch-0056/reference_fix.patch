+func decodeFile(path string, out any) error {
+	f, err := os.Open(path)
+	if err != nil {
+		return fmt.Errorf("vcfarch: open %s: %w", path, err)
+	}
+	defer f.Close()
+	dec := json.NewDecoder(f)
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(out); err != nil {
+		return fmt.Errorf("vcfarch: decode %s: %w", path, err)
+	}
+	var trailing any
+	if err := dec.Decode(&trailing); !errors.Is(err, io.EOF) {
+		if err == nil {
+			return fmt.Errorf("vcfarch: decode %s: trailing JSON value", path)
+		}
+		return fmt.Errorf("vcfarch: decode %s: %w", path, err)
+	}
+	return nil
+}

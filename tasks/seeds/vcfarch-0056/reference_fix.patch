+func buildDVS(name string, networks, vmnics []string, transportZone, transportType string) map[string]any {
+	mappings := make([]any, 0, len(vmnics))
+	uplinks := make([]any, 0, len(vmnics))
+	for i, vmnic := range vmnics {
+		uplink := fmt.Sprintf("uplink%d", i+1)
+		mappings = append(mappings, map[string]any{"id": vmnic, "uplink": uplink})
+		uplinks = append(uplinks, uplink)
+	}
+	return map[string]any{
+		"dvsName":         name,
+		"networks":        stringValues(networks),
+		"mtu":             9000,
+		"vmnicsToUplinks": mappings,
+		"nsxtSwitchConfig": map[string]any{
+			"transportZones":            []any{map[string]any{"name": transportZone, "transportType": transportType}},
+			"hostSwitchOperationalMode": "STANDARD",
+			"ipAssignmentType":          "STATIC",
+		},
+		"nsxTeamings": []any{map[string]any{
+			"policy":        "LOADBALANCE_SRCID",
+			"activeUplinks": uplinks,
+		}},
+	}
+}
+
+func stringValues(values []string) []any {
+	out := make([]any, len(values))
+	for i, value := range values {
+		out[i] = value
+	}
+	return out
+}

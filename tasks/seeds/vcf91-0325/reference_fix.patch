+func (c *Client) getDeploymentsPage(ctx context.Context, page int, options ListDeploymentsOptions) (*pageDeployment, error) {
+	endpoint := *c.baseURL
+	endpoint.Path = strings.TrimSuffix(endpoint.Path, "/") + deploymentsPath
+	endpoint.RawQuery = buildQuery(page, options).Encode()
+
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint.String(), nil)
+	if err != nil {
+		return nil, fmt.Errorf("vcfautomation: build Get Deployments request: %w", err)
+	}
+	request.Header.Set("Accept", "application/json")
+	request.Header.Set("Authorization", "Bearer "+c.accessToken)
+
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		return nil, fmt.Errorf("vcfautomation: Get Deployments page %d: %w", page, err)
+	}
+	defer response.Body.Close()
+
+	body, err := io.ReadAll(response.Body)
+	if err != nil {
+		return nil, fmt.Errorf("vcfautomation: read Get Deployments page %d: %w", page, err)
+	}
+	if response.StatusCode != http.StatusOK {
+		return nil, &APIError{StatusCode: response.StatusCode, Body: string(body)}
+	}
+
+	var envelope pageDeployment
+	if err := json.Unmarshal(body, &envelope); err != nil {
+		return nil, &ProtocolError{Reason: fmt.Sprintf("page %d body is not a PageDeployment document: %v", page, err)}
+	}
+	return &envelope, nil
+}

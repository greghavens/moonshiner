+// buildQuery renders the wire query for one page. Every optional parameter the
+// caller left unset is absent from the result rather than present and empty.
+func buildQuery(page int, options ListDeploymentsOptions) url.Values {
+	query := url.Values{}
+	query.Set("page", strconv.Itoa(page))
+	query.Set("size", strconv.Itoa(options.PageSize))
+
+	setText := func(name string, value *string) {
+		if value == nil || *value == "" {
+			return
+		}
+		query.Set(name, *value)
+	}
+	setList := func(name string, values []string) {
+		joined := strings.Join(values, ",")
+		if joined == "" {
+			return
+		}
+		query.Set(name, joined)
+	}
+
+	setText("sort", options.Sort)
+	setText("search", options.Search)
+	setText("name", options.Name)
+	setList("status", options.Status)
+	setList("projects", options.Projects)
+	setList("resourceTypes", options.ResourceTypes)
+	setList("ownedBy", options.OwnedBy)
+	if options.Deleted != nil {
+		query.Set("deleted", strconv.FormatBool(*options.Deleted))
+	}
+	return query
 }

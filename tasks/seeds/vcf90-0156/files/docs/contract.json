{
  "contractVersion": 1,
  "product": "VMware Cloud Foundation Automation",
  "productVersion": "9.0",
  "title": "VCF Automation deployment change contract subset",
  "source": {
    "kind": "reference-documentation",
    "statement": "This contract is derived from the authoritative Broadcom VCF Automation 9.0 xAPIs reference documentation. It is reference-derived and is not a published specification. The Apache-2.0 vmware/vcf-api-specs repository does not publish a VCF Automation specification."
  },
  "basePath": "/deployment/api",
  "authentication": {
    "type": "http",
    "scheme": "bearer",
    "header": "Authorization"
  },
  "operations": [
    {
      "operationId": "patchDeployment",
      "referenceName": "Patch Deployment",
      "method": "PATCH",
      "path": "/deployment/api/deployments/{deploymentId}",
      "pathParameters": {
        "deploymentId": {
          "type": "string",
          "required": true
        }
      },
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "required": false,
            "maxLength": 2000
          },
          "iconId": {
            "type": "string",
            "format": "uuid",
            "required": false
          },
          "name": {
            "type": "string",
            "required": false,
            "minLength": 1,
            "maxLength": 900
          }
        }
      },
      "responses": {
        "200": {
          "contentType": "application/json",
          "type": "Deployment",
          "fieldsUsedByPackage": {
            "id": "string(uuid), optional",
            "name": "string, required",
            "description": "string, optional",
            "status": "string, optional"
          }
        }
      }
    },
    {
      "operationId": "submitDeploymentActionRequest",
      "referenceName": "Submit Deployment Action Request",
      "method": "POST",
      "path": "/deployment/api/deployments/{deploymentId}/requests",
      "pathParameters": {
        "deploymentId": {
          "type": "string",
          "required": true
        }
      },
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "type": "object",
        "properties": {
          "actionId": {
            "type": "string",
            "required": false
          },
          "inputs": {
            "type": "object",
            "required": false
          },
          "reason": {
            "type": "string",
            "required": false
          }
        }
      },
      "responses": {
        "200": {
          "contentType": "application/json",
          "type": "Request",
          "fieldsUsedByPackage": {
            "id": "string(uuid), optional",
            "status": "RequestStatus, optional",
            "details": "string, optional"
          }
        }
      }
    },
    {
      "operationId": "getRequest",
      "referenceName": "Get Request",
      "method": "GET",
      "path": "/deployment/api/requests/{requestId}",
      "pathParameters": {
        "requestId": {
          "type": "string",
          "required": true
        }
      },
      "responses": {
        "200": {
          "contentType": "application/json",
          "type": "Request",
          "fieldsUsedByPackage": {
            "id": "string(uuid), optional",
            "status": "RequestStatus, optional",
            "details": "string, optional"
          }
        }
      }
    }
  ],
  "types": {
    "RequestStatus": {
      "type": "string",
      "enum": [
        "CREATED",
        "PENDING",
        "INITIALIZATION",
        "CHECKING_APPROVAL",
        "APPROVAL_PENDING",
        "USER_INTERACTION_PENDING",
        "INPROGRESS",
        "COMPLETION",
        "APPROVAL_REJECTED",
        "ABORTED",
        "SUCCESSFUL",
        "FAILED"
      ]
    }
  }
}

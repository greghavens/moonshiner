{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/vcf-architecture.schema.json",
  "title": "VCF 9.1 architecture manifest",
  "type": "object",
  "required": ["schemaVersion", "scenarioId", "targetVersion", "sites", "domains", "managementComponents", "recovery"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "scenarioId": {"type": "string", "minLength": 1},
    "targetVersion": {"type": "string", "minLength": 1},
    "sites": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "role", "location"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"enum": ["primary", "recovery"]},
          "location": {"type": "string", "minLength": 1}
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["name", "type", "site", "hosts", "availability", "usableCapacity", "componentVersions"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"enum": ["MANAGEMENT", "WORKLOAD"]},
          "site": {"type": "string", "minLength": 1},
          "hosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "availability": {
            "type": "object",
            "required": ["hostFailuresToTolerate"],
            "additionalProperties": false,
            "properties": {"hostFailuresToTolerate": {"type": "integer", "minimum": 0}}
          },
          "usableCapacity": {
            "type": "object",
            "required": ["cpuCores", "memoryGiB", "storageTiB"],
            "additionalProperties": false,
            "properties": {
              "cpuCores": {"type": "integer", "minimum": 1},
              "memoryGiB": {"type": "integer", "minimum": 1},
              "storageTiB": {"type": "integer", "minimum": 1}
            }
          },
          "componentVersions": {
            "type": "object",
            "required": ["vcenter", "esxi", "nsx"],
            "additionalProperties": false,
            "properties": {
              "sddcManager": {"type": "string"},
              "vcenter": {"type": "string"},
              "esxi": {"type": "string"},
              "nsx": {"type": "string"}
            }
          }
        }
      }
    },
    "managementComponents": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["name", "version", "site", "placementDomain", "size", "deploymentModel", "instances", "capacityBasis"],
        "additionalProperties": false,
        "properties": {
          "name": {"enum": ["VCF Operations", "VCF Automation", "VCF Operations for Logs"]},
          "version": {"type": "string", "minLength": 1},
          "site": {"type": "string", "minLength": 1},
          "placementDomain": {"type": "string", "minLength": 1},
          "size": {"enum": ["small", "medium", "large", "xlarge"]},
          "deploymentModel": {"enum": ["simple", "standard", "high-availability", "integrated-service"]},
          "instances": {"type": "integer", "minimum": 1},
          "capacityBasis": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}},
          "collectors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["site", "count"],
              "additionalProperties": false,
              "properties": {"site": {"type": "string"}, "count": {"type": "integer", "minimum": 1}}
            }
          }
        }
      }
    },
    "recovery": {
      "type": "object",
      "required": ["mode", "primarySite", "recoverySite", "rpoMinutes", "rtoMinutes", "protectedDomains"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["warm"]},
        "primarySite": {"type": "string"},
        "recoverySite": {"type": "string"},
        "rpoMinutes": {"type": "integer", "minimum": 0},
        "rtoMinutes": {"type": "integer", "minimum": 0},
        "protectedDomains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/vcf-migration-plan.schema.json",
  "title": "Ordered VCF estate migration plan",
  "type": "object",
  "required": ["schemaVersion", "estateId", "targetVersion", "steps"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "targetVersion": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "componentId", "component", "currentVersion", "action", "target", "gates", "dependsOn"],
        "additionalProperties": false,
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "componentId": {"type": "string", "minLength": 1},
          "component": {"type": "string", "minLength": 1},
          "currentVersion": {"type": "string", "minLength": 1},
          "action": {"enum": ["patch", "upgrade", "migrate", "deploy", "import", "decommission", "validate"]},
          "target": {
            "type": "object",
            "required": ["component", "version"],
            "additionalProperties": false,
            "properties": {
              "component": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          },
          "gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}

+function ConvertTo-VcfInstallerTypedSddcSpec {
+    [CmdletBinding()]
+    param([Parameter(Mandatory)] $InputSpec)
+
+    # The generated Invoke-* cmdlets accept VMware model objects, not raw JSON.
+    # Rehydrate the generated JSON through the SDK's model initializers before
+    # handing it to validation or deployment.
+    $hosts = @($InputSpec.hostSpecs | ForEach-Object {
+        $credentials = Initialize-VcfInstallerSddcCredentials -Username $_.credentials.username -Password $_.credentials.password
+        Initialize-VcfInstallerSddcHostSpec -Hostname $_.hostname -Credentials $credentials
+    })
+    $vcenter = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname $InputSpec.vcenterSpec.vcenterHostname `
+        -RootVcenterPassword $InputSpec.vcenterSpec.rootVcenterPassword `
+        -VmSize $InputSpec.vcenterSpec.vmSize `
+        -StorageSize $InputSpec.vcenterSpec.storageSize `
+        -SsoDomain $InputSpec.vcenterSpec.ssoDomain `
+        -Version $InputSpec.vcenterSpec.version `
+        -UseExistingDeployment ([bool]$InputSpec.vcenterSpec.useExistingDeployment)
+    $cluster = Initialize-VcfInstallerSddcClusterSpec `
+        -DatacenterName $InputSpec.clusterSpec.datacenterName `
+        -ClusterName $InputSpec.clusterSpec.clusterName
+    $dvsSpecs = @($InputSpec.dvsSpecs | ForEach-Object {
+        $mappings = @($_.vmnicsToUplinks | ForEach-Object { Initialize-VcfInstallerVmnicToUplink -Id $_.id -Uplink $_.uplink })
+        Initialize-VcfInstallerDvsSpec -DvsName $_.dvsName -Networks $_.networks -Mtu $_.mtu -VmnicsToUplinks $mappings
+    })
+    $nsxManagers = @($InputSpec.nsxtSpec.nsxtManagers | ForEach-Object { Initialize-VcfInstallerNsxtManagerSpec -Hostname $_.hostname })
+    $nsx = Initialize-VcfInstallerSddcNsxtSpec `
+        -NsxtManagers $nsxManagers `
+        -NsxtManagerSize $InputSpec.nsxtSpec.nsxtManagerSize `
+        -VipFqdn $InputSpec.nsxtSpec.vipFqdn `
+        -RootNsxtManagerPassword $InputSpec.nsxtSpec.rootNsxtManagerPassword `
+        -NsxtAdminPassword $InputSpec.nsxtSpec.nsxtAdminPassword `
+        -NsxtAuditPassword $InputSpec.nsxtSpec.nsxtAuditPassword `
+        -TransportVlanId $InputSpec.nsxtSpec.transportVlanId `
+        -Version $InputSpec.nsxtSpec.version `
+        -UseExistingDeployment ([bool]$InputSpec.nsxtSpec.useExistingDeployment)
+    $networks = @($InputSpec.networkSpecs | ForEach-Object {
+        $ranges = @($_.includeIpAddressRanges | ForEach-Object { Initialize-VcfInstallerIpRange -StartIpAddress $_.startIpAddress -EndIpAddress $_.endIpAddress })
+        Initialize-VcfInstallerSddcNetworkSpec `
+            -NetworkType $_.networkType -Subnet $_.subnet -Gateway $_.gateway `
+            -SubnetMask $_.subnetMask -IncludeIpAddressRanges $ranges -VlanId $_.vlanId -Mtu $_.mtu
+    })
+    $dns = Initialize-VcfInstallerDnsSpec -Subdomain $InputSpec.dnsSpec.subdomain -Nameservers $InputSpec.dnsSpec.nameservers
+    $sddcManager = Initialize-VcfInstallerSddcManagerSpec `
+        -RootPassword $InputSpec.sddcManagerSpec.rootPassword `
+        -Hostname $InputSpec.sddcManagerSpec.hostname `
+        -SshPassword $InputSpec.sddcManagerSpec.sshPassword `
+        -LocalUserPassword $InputSpec.sddcManagerSpec.localUserPassword `
+        -Version $InputSpec.sddcManagerSpec.version `
+        -UseExistingDeployment ([bool]$InputSpec.sddcManagerSpec.useExistingDeployment)
+    $esa = Initialize-VcfInstallerVsanEsaConfig -Enabled ([bool]$InputSpec.datastoreSpec.vsanSpec.esaConfig.enabled)
+    $vsan = Initialize-VcfInstallerVsanSpec `
+        -DatastoreName $InputSpec.datastoreSpec.vsanSpec.datastoreName `
+        -VsanDedup ([bool]$InputSpec.datastoreSpec.vsanSpec.vsanDedup) `
+        -EsaConfig $esa `
+        -FailuresToTolerate $InputSpec.datastoreSpec.vsanSpec.failuresToTolerate
+    $datastore = Initialize-VcfInstallerSddcDatastoreSpec -VsanSpec $vsan
+    $ipv4Pool = Initialize-VcfInstallerIPv4Pool -Addresses $InputSpec.vspClusterSpec.ipv4Pool.addresses
+    $vsp = Initialize-VcfInstallerSddcVspClusterSpec `
+        -PlatformFqdn $InputSpec.vspClusterSpec.platformFqdn `
+        -Ipv4Pool $ipv4Pool `
+        -Size $InputSpec.vspClusterSpec.size `
+        -InternalClusterCidrIpv4 $InputSpec.vspClusterSpec.internalClusterCidrIpv4 `
+        -InstanceFqdn $InputSpec.vspClusterSpec.instanceFqdn `
+        -FleetFqdn $InputSpec.vspClusterSpec.fleetFqdn `
+        -Version $InputSpec.vspClusterSpec.version `
+        -UseExistingDeployment ([bool]$InputSpec.vspClusterSpec.useExistingDeployment)
+    $fleetLcm = Initialize-VcfInstallerFleetLcmServiceSpec -Version $InputSpec.fleetLcmSpec.version -Size $InputSpec.fleetLcmSpec.size
+    $sddcLcm = Initialize-VcfInstallerSddcLcmServiceSpec -Version $InputSpec.sddcLcmSpec.version -Size $InputSpec.sddcLcmSpec.size
+    $fleetDepot = Initialize-VcfInstallerFleetDepotServiceSpec -Version $InputSpec.fleetDepotSpec.version -Size $InputSpec.fleetDepotSpec.size
+    $telemetry = Initialize-VcfInstallerTelemetryAcceptorSpec -Version $InputSpec.telemetryAcceptorSpec.version -Size $InputSpec.telemetryAcceptorSpec.size
+    $salt = Initialize-VcfInstallerSaltSpec -Version $InputSpec.saltSpec.version -Size $InputSpec.saltSpec.size
+    $saltRaas = Initialize-VcfInstallerSaltSpec -Version $InputSpec.saltRaasSpec.version -Size $InputSpec.saltRaasSpec.size
+    $opsNodes = @($InputSpec.vcfOperationsSpec.nodes | ForEach-Object { Initialize-VcfInstallerVcfOperationsNode -Hostname $_.hostname -Type $_.type })
+    $operations = Initialize-VcfInstallerVcfOperationsSpec `
+        -Nodes $opsNodes `
+        -ApplianceSize $InputSpec.vcfOperationsSpec.applianceSize `
+        -LoadBalancerFqdn $InputSpec.vcfOperationsSpec.loadBalancerFqdn `
+        -UseExistingDeployment ([bool]$InputSpec.vcfOperationsSpec.useExistingDeployment) `
+        -Version $InputSpec.vcfOperationsSpec.version
+    $collector = Initialize-VcfInstallerVcfOperationsCollectorSpec `
+        -Hostname $InputSpec.vcfOperationsCollectorSpec.hostname `
+        -ApplianceSize $InputSpec.vcfOperationsCollectorSpec.applianceSize `
+        -Version $InputSpec.vcfOperationsCollectorSpec.version `
+        -UseExistingDeployment ([bool]$InputSpec.vcfOperationsCollectorSpec.useExistingDeployment)
+    $automation = Initialize-VcfInstallerVcfAutomationSpec `
+        -Hostname $InputSpec.vcfAutomationSpec.hostname `
+        -PlatformFqdn $InputSpec.vcfAutomationSpec.platformFqdn `
+        -IpPool $InputSpec.vcfAutomationSpec.ipPool `
+        -InternalClusterCidr $InputSpec.vcfAutomationSpec.internalClusterCidr `
+        -NodePrefix $InputSpec.vcfAutomationSpec.nodePrefix `
+        -Size $InputSpec.vcfAutomationSpec.size `
+        -Version $InputSpec.vcfAutomationSpec.version `
+        -UseExistingDeployment ([bool]$InputSpec.vcfAutomationSpec.useExistingDeployment)
+    $localNetwork = Initialize-VcfInstallerVcfManagementComponentsNetworkSpec `
+        -NetworkName $InputSpec.vcfManagementComponentsInfrastructureSpec.localRegionNetwork.networkName `
+        -SubnetMask $InputSpec.vcfManagementComponentsInfrastructureSpec.localRegionNetwork.subnetMask `
+        -Gateway $InputSpec.vcfManagementComponentsInfrastructureSpec.localRegionNetwork.gateway
+    $xRegionNetwork = Initialize-VcfInstallerVcfManagementComponentsNetworkSpec `
+        -NetworkName $InputSpec.vcfManagementComponentsInfrastructureSpec.xRegionNetwork.networkName `
+        -SubnetMask $InputSpec.vcfManagementComponentsInfrastructureSpec.xRegionNetwork.subnetMask `
+        -Gateway $InputSpec.vcfManagementComponentsInfrastructureSpec.xRegionNetwork.gateway
+    $infrastructure = Initialize-VcfInstallerVcfManagementComponentsInfrastructureSpec -LocalRegionNetwork $localNetwork -XRegionNetwork $xRegionNetwork
+    $license = Initialize-VcfInstallerLicenseServerSpec `
+        -Hostname $InputSpec.licenseServerSpec.hostname `
+        -Version $InputSpec.licenseServerSpec.version `
+        -UseExistingDeployment ([bool]$InputSpec.licenseServerSpec.useExistingDeployment)
+
+    return Initialize-VcfInstallerSddcSpec `
+        -SddcId $InputSpec.sddcId -WorkflowType $InputSpec.workflowType -HostSpecs $hosts -Version $InputSpec.version `
+        -VcenterSpec $vcenter -ClusterSpec $cluster -DvsSpecs $dvsSpecs -NsxtSpec $nsx -NetworkSpecs $networks `
+        -DnsSpec $dns -NtpServers $InputSpec.ntpServers -SddcManagerSpec $sddcManager `
+        -ManagementPoolName $InputSpec.managementPoolName -CeipEnabled ([bool]$InputSpec.ceipEnabled) `
+        -SkipEsxThumbprintValidation ([bool]$InputSpec.skipEsxThumbprintValidation) `
+        -SkipGatewayPingValidation ([bool]$InputSpec.skipGatewayPingValidation) `
+        -DatastoreSpec $datastore -VspClusterSpec $vsp -FleetLcmSpec $fleetLcm -SddcLcmSpec $sddcLcm `
+        -FleetDepotSpec $fleetDepot -TelemetryAcceptorSpec $telemetry -SaltSpec $salt -SaltRaasSpec $saltRaas `
+        -VcfOperationsSpec $operations -VcfOperationsCollectorSpec $collector -VcfAutomationSpec $automation `
+        -VcfManagementComponentsInfrastructureSpec $infrastructure -LicenseServerSpec $license `
+        -VcfInstanceName $InputSpec.vcfInstanceName
+}
+
+function Invoke-VcfInstallerArchitecture {
+    [CmdletBinding(SupportsShouldProcess)]
+    param(
+        [Parameter(Mandatory)][string] $Server,
+        [Parameter(Mandatory)][pscredential] $Credential,
+        [Parameter(Mandatory)][string] $SpecPath,
+        [switch] $Deploy
+    )
+
+    Import-Module VMware.Sdk.Vcf.Installer -ErrorAction Stop
+    Import-Module VMware.Sdk.Vcf.SddcManager -ErrorAction Stop
+    Import-Module VMware.Sdk.Vcf.Ops -ErrorAction Stop
+    $connection = Connect-VcfInstallerServer -Server $Server -Credential $Credential
+    try {
+        $specification = ConvertTo-VcfInstallerTypedSddcSpec -InputSpec (Read-VcfJsonFile -Path $SpecPath)
+        $validation = Invoke-VcfInstallerValidateSddcSpec -SddcSpec $specification
+        if ($Deploy -and $PSCmdlet.ShouldProcess($Server, 'Deploy validated VCF SddcSpec')) {
+            return Invoke-VcfInstallerDeploySddc -SddcSpec $specification
+        }
+        return $validation
+    }
+    finally {
+        Disconnect-VcfInstallerServer -Server $connection -Confirm:$false
+    }
+}
+
+Export-ModuleMember -Function New-VcfArchitecture, New-VcfMigrationPlan, Invoke-VcfInstallerArchitecture

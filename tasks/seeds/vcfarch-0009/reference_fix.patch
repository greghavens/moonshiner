@@ -0,0 +1,453 @@
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+function Read-VcfJsonFile {
+    [CmdletBinding()]
+    param([Parameter(Mandatory)][string] $Path)
+
+    $resolved = Resolve-Path -LiteralPath $Path -ErrorAction Stop
+    return Get-Content -LiteralPath $resolved -Raw -Encoding utf8 | ConvertFrom-Json -Depth 100
+}
+
+function Write-VcfJsonFile {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)] $Value,
+        [Parameter(Mandatory)][string] $Path
+    )
+
+    $parent = Split-Path -Parent $Path
+    if ($parent -and -not (Test-Path -LiteralPath $parent)) {
+        New-Item -ItemType Directory -Path $parent -Force | Out-Null
+    }
+    $json = $Value | ConvertTo-Json -Depth 100
+    Set-Content -LiteralPath $Path -Value $json -Encoding utf8
+}
+
+function Select-VcfOperationsTier {
+    param($Compatibility, $Requirements)
+    $demand = [int]$Requirements.capacity.vcfOperationsMonitoredObjects
+    foreach ($tier in $Compatibility.sizing.vcfOperations) {
+        if ($demand -le [int]$tier.maxMonitoredObjects) { return $tier }
+    }
+    throw 'VCF Operations demand exceeds the pinned sizing tiers.'
+}
+
+function Select-VcfAutomationTier {
+    param($Compatibility, $Requirements)
+    $projects = [int]$Requirements.capacity.automationManagedProjects
+    $concurrent = [int]$Requirements.capacity.automationConcurrentDeployments
+    foreach ($tier in $Compatibility.sizing.vcfAutomation) {
+        if ($projects -le [int]$tier.maxManagedProjects -and $concurrent -le [int]$tier.maxConcurrentDeployments) { return $tier }
+    }
+    throw 'VCF Automation demand exceeds the pinned sizing tiers.'
+}
+
+function Select-VcfLogsTier {
+    param($Compatibility, $Requirements)
+    $ingest = [int]$Requirements.capacity.logIngestGbPerDay
+    $retention = [int]$Requirements.capacity.logHotRetentionDays
+    foreach ($tier in $Compatibility.sizing.vcfOperationsForLogs) {
+        if ($ingest -le [int]$tier.maxIngestGbPerDay -and $retention -le [int]$tier.maxHotRetentionDays) { return $tier }
+    }
+    throw 'Log demand exceeds the pinned sizing tiers.'
+}
+
+function New-VcfArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][string] $RequirementsPath,
+        [Parameter(Mandatory)][string] $CompatibilityPath,
+        [Parameter(Mandatory)][string] $OutputDirectory
+    )
+
+    $requirements = Read-VcfJsonFile -Path $RequirementsPath
+    $compatibility = Read-VcfJsonFile -Path $CompatibilityPath
+    if ($requirements.targetVersion -ne $compatibility.targetRelease) {
+        throw "Requirements target $($requirements.targetVersion) does not match compatibility target $($compatibility.targetRelease)."
+    }
+
+    $installer = $requirements.installer
+    $combo = $compatibility.supportedGreenfieldCombination
+    $management = @($requirements.domains | Where-Object type -eq 'MANAGEMENT')[0]
+    $primary = @($requirements.sites | Where-Object role -eq 'primary')[0]
+    $recovery = @($requirements.sites | Where-Object role -eq 'recovery')[0]
+    $opsTier = Select-VcfOperationsTier $compatibility $requirements
+    $automationTier = Select-VcfAutomationTier $compatibility $requirements
+    $logsTier = Select-VcfLogsTier $compatibility $requirements
+    $transportNetwork = @($installer.networks | Where-Object networkType -eq 'HOST_OVERLAY')[0]
+    $localRegionNetwork = @($installer.networks | Where-Object networkType -eq 'VM_MANAGEMENT')[0]
+    $xRegionNetwork = @($installer.networks | Where-Object networkType -eq 'FLEET_MANAGEMENT')[0]
+
+    $hostSpecs = @($management.hosts | ForEach-Object {
+        [ordered]@{
+            hostname = $_
+            credentials = [ordered]@{ username = 'root'; password = $installer.passwords.esxiRoot }
+        }
+    })
+    $networkSpecs = @($installer.networks | ForEach-Object {
+        [ordered]@{
+            networkType = $_.networkType
+            subnet = $_.subnet
+            gateway = $_.gateway
+            subnetMask = $_.subnetMask
+            includeIpAddressRanges = @([ordered]@{ startIpAddress = $_.ipRangeStart; endIpAddress = $_.ipRangeEnd })
+            vlanId = [int]$_.vlanId
+            mtu = [int]$_.mtu
+        }
+    })
+    $opsNodes = @(
+        [ordered]@{ hostname = "chi-ops01.$($installer.dnsDomain)"; type = 'master' },
+        [ordered]@{ hostname = "chi-ops02.$($installer.dnsDomain)"; type = 'replica' },
+        [ordered]@{ hostname = "chi-ops03.$($installer.dnsDomain)"; type = 'data' }
+    )
+
+    $sddcSpec = [ordered]@{
+        sddcId = $installer.sddcId
+        workflowType = $combo.workflowType
+        version = $compatibility.targetRelease
+        vcfInstanceName = $installer.vcfInstanceName
+        hostSpecs = $hostSpecs
+        vcenterSpec = [ordered]@{
+            vcenterHostname = $installer.vcenterFqdn
+            rootVcenterPassword = $installer.passwords.vcenterRoot
+            vmSize = 'large'
+            storageSize = 'lstorage'
+            ssoDomain = 'vsphere.local'
+            version = $combo.vcenter
+            useExistingDeployment = $false
+        }
+        clusterSpec = [ordered]@{ datacenterName = 'chi01-m01-dc'; clusterName = 'chi01-m01-cl01' }
+        dvsSpecs = @([ordered]@{
+            dvsName = 'chi01-m01-vds01'
+            networks = @($installer.networks.networkType)
+            mtu = 9000
+            vmnicsToUplinks = @(
+                [ordered]@{ id = 'vmnic0'; uplink = 'uplink1' },
+                [ordered]@{ id = 'vmnic1'; uplink = 'uplink2' }
+            )
+        })
+        nsxtSpec = [ordered]@{
+            nsxtManagers = @($installer.nsxManagerFqdns | ForEach-Object { [ordered]@{ hostname = $_ } })
+            nsxtManagerSize = 'large'
+            vipFqdn = $installer.nsxVipFqdn
+            rootNsxtManagerPassword = $installer.passwords.nsx
+            nsxtAdminPassword = $installer.passwords.nsx
+            nsxtAuditPassword = $installer.passwords.nsx
+            transportVlanId = [int]$transportNetwork.vlanId
+            version = $combo.nsx
+            useExistingDeployment = $false
+        }
+        networkSpecs = $networkSpecs
+        dnsSpec = [ordered]@{ subdomain = $installer.dnsDomain; nameservers = @($installer.dnsServers) }
+        ntpServers = @($installer.ntpServers)
+        sddcManagerSpec = [ordered]@{
+            hostname = $installer.sddcManagerFqdn
+            rootPassword = $installer.passwords.sddcRoot
+            sshPassword = $installer.passwords.sddcRoot
+            localUserPassword = $installer.passwords.sddcLocal
+            version = $combo.sddcManager
+            useExistingDeployment = $false
+        }
+        managementPoolName = 'chi01-m01-network-pool'
+        ceipEnabled = $false
+        skipEsxThumbprintValidation = $false
+        skipGatewayPingValidation = $false
+        datastoreSpec = [ordered]@{
+            vsanSpec = [ordered]@{
+                datastoreName = 'chi01-m01-vsan01'
+                vsanDedup = $false
+                esaConfig = [ordered]@{ enabled = $true }
+                failuresToTolerate = [int]$requirements.availability.managementHostFailuresToTolerate
+            }
+        }
+        vspClusterSpec = [ordered]@{
+            platformFqdn = "chi-vsp.$($installer.dnsDomain)"
+            instanceFqdn = "chi-vsp-instance.$($installer.dnsDomain)"
+            fleetFqdn = "meridian-fleet.$($installer.dnsDomain)"
+            ipv4Pool = [ordered]@{ addresses = @($installer.managementServiceIpv4Pool) }
+            size = 'large'
+            internalClusterCidrIpv4 = '198.18.0.0/15'
+            version = $combo.managementServices
+            useExistingDeployment = $false
+        }
+        fleetLcmSpec = [ordered]@{ version = $combo.managementServices; size = 'large' }
+        sddcLcmSpec = [ordered]@{ version = $combo.managementServices; size = 'large' }
+        fleetDepotSpec = [ordered]@{ version = $combo.managementServices; size = 'large' }
+        telemetryAcceptorSpec = [ordered]@{ version = $combo.managementServices; size = 'large' }
+        saltSpec = [ordered]@{ version = $combo.managementServices; size = 'large' }
+        saltRaasSpec = [ordered]@{ version = $combo.managementServices; size = 'large' }
+        vcfOperationsSpec = [ordered]@{
+            nodes = $opsNodes
+            applianceSize = $opsTier.size
+            loadBalancerFqdn = "chi-ops.$($installer.dnsDomain)"
+            useExistingDeployment = $false
+            version = $combo.vcfOperations
+        }
+        vcfOperationsCollectorSpec = [ordered]@{
+            hostname = "dfw-ops-collector01.$($installer.dnsDomain)"
+            applianceSize = 'standard'
+            version = $combo.vcfOperations
+            useExistingDeployment = $false
+        }
+        vcfAutomationSpec = [ordered]@{
+            hostname = "chi-auto.$($installer.dnsDomain)"
+            platformFqdn = "chi-vsp.$($installer.dnsDomain)"
+            ipPool = @($installer.automationIpPool)
+            internalClusterCidr = '198.20.0.0/16'
+            nodePrefix = 'auto-node'
+            size = $automationTier.size
+            version = $combo.vcfAutomation
+            useExistingDeployment = $false
+        }
+        vcfManagementComponentsInfrastructureSpec = [ordered]@{
+            localRegionNetwork = [ordered]@{ networkName = $localRegionNetwork.networkType; subnetMask = $localRegionNetwork.subnetMask; gateway = $localRegionNetwork.gateway }
+            xRegionNetwork = [ordered]@{ networkName = $xRegionNetwork.networkType; subnetMask = $xRegionNetwork.subnetMask; gateway = $xRegionNetwork.gateway }
+        }
+        licenseServerSpec = [ordered]@{
+            hostname = "chi-license.$($installer.dnsDomain)"
+            version = $compatibility.targetRelease
+            useExistingDeployment = $false
+        }
+    }
+
+    $domains = @($requirements.domains | ForEach-Object {
+        $versions = [ordered]@{
+            vcenter = $combo.vcenter
+            esxi = $combo.esxi
+            nsx = $combo.nsx
+        }
+        if ($_.type -eq 'MANAGEMENT') { $versions['sddcManager'] = $combo.sddcManager }
+        [ordered]@{
+            name = $_.name
+            type = $_.type
+            site = $_.site
+            hosts = @($_.hosts)
+            availability = [ordered]@{ hostFailuresToTolerate = [int]$(if ($_.type -eq 'MANAGEMENT') { $requirements.availability.managementHostFailuresToTolerate } else { $requirements.availability.workloadHostFailuresToTolerate }) }
+            usableCapacity = [ordered]@{ cpuCores = [int]$_.usableCpuCores; memoryGiB = [int]$_.usableMemoryGiB; storageTiB = [int]$_.usableStorageTiB }
+            componentVersions = $versions
+        }
+    })
+    $collectors = @($requirements.sites | ForEach-Object { [ordered]@{ site = $_.id; count = 1 } })
+    $protectedDomains = @($requirements.domains | Where-Object { $_.type -eq 'WORKLOAD' -and $_.site -eq $primary.id } | ForEach-Object name)
+    $architecture = [ordered]@{
+        schemaVersion = '1.0'
+        scenarioId = $requirements.scenarioId
+        targetVersion = $compatibility.targetRelease
+        sites = @($requirements.sites | ForEach-Object { [ordered]@{ id = $_.id; role = $_.role; location = $_.location } })
+        domains = $domains
+        managementComponents = @(
+            [ordered]@{
+                name = 'VCF Operations'; version = $combo.vcfOperations; site = $primary.id; placementDomain = $management.name
+                size = $opsTier.size; deploymentModel = $opsTier.deploymentModel; instances = [int]$opsTier.nodeCount
+                capacityBasis = [ordered]@{ monitoredObjects = [int]$requirements.capacity.vcfOperationsMonitoredObjects }
+            },
+            [ordered]@{
+                name = 'VCF Automation'; version = $combo.vcfAutomation; site = $primary.id; placementDomain = $management.name
+                size = $automationTier.size; deploymentModel = $automationTier.deploymentModel; instances = [int]$automationTier.serviceReplicas
+                capacityBasis = [ordered]@{ managedProjects = [int]$requirements.capacity.automationManagedProjects; concurrentDeployments = [int]$requirements.capacity.automationConcurrentDeployments }
+            },
+            [ordered]@{
+                name = 'VCF Operations for Logs'; version = $combo.vcfOperationsForLogs; site = $primary.id; placementDomain = $management.name
+                size = $logsTier.size; deploymentModel = $logsTier.deploymentModel; instances = [int]$logsTier.serviceReplicas
+                capacityBasis = [ordered]@{ ingestGbPerDay = [int]$requirements.capacity.logIngestGbPerDay; hotRetentionDays = [int]$requirements.capacity.logHotRetentionDays }
+                collectors = $collectors
+            }
+        )
+        recovery = [ordered]@{
+            mode = $requirements.availability.siteRecovery
+            primarySite = $primary.id
+            recoverySite = $recovery.id
+            rpoMinutes = [int]$requirements.availability.rpoMinutes
+            rtoMinutes = [int]$requirements.availability.rtoMinutes
+            protectedDomains = $protectedDomains
+        }
+    }
+
+    New-Item -ItemType Directory -Path $OutputDirectory -Force | Out-Null
+    Write-VcfJsonFile -Value $sddcSpec -Path (Join-Path $OutputDirectory 'greenfield-sddc-spec.json')
+    Write-VcfJsonFile -Value $architecture -Path (Join-Path $OutputDirectory 'architecture.json')
+}
+
+function New-VcfMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][string] $InventoryPath,
+        [Parameter(Mandatory)][string] $CompatibilityPath,
+        [Parameter(Mandatory)][string] $OutputPath
+    )
+
+    $inventory = Read-VcfJsonFile -Path $InventoryPath
+    $compatibility = Read-VcfJsonFile -Path $CompatibilityPath
+    $components = @{}
+    foreach ($component in $inventory.components) { $components[$component.id] = $component }
+    $steps = @($compatibility.upgradeRules | Sort-Object -Property order | ForEach-Object {
+        $rule = $_
+        if (-not $components.ContainsKey($rule.componentId)) { throw "No inventory component for rule $($rule.componentId)." }
+        $source = $components[$rule.componentId]
+        [ordered]@{
+            order = [int]$rule.order
+            componentId = $source.id
+            component = $source.name
+            currentVersion = $source.version
+            action = $rule.action
+            target = [ordered]@{ component = $rule.targetComponent; version = $rule.targetVersion }
+            gates = @($rule.gates)
+            dependsOn = @($rule.dependsOn)
+        }
+    })
+    if ($steps.Count -ne $inventory.components.Count) { throw 'Every inventoried component must have exactly one pinned upgrade rule.' }
+    $plan = [ordered]@{ schemaVersion = '1.0'; estateId = $inventory.estateId; targetVersion = $compatibility.targetRelease; steps = $steps }
+    Write-VcfJsonFile -Value $plan -Path $OutputPath
+}

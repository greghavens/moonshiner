+#!/usr/bin/env python3
+"""Reference proof using the genuine candidate executable in dependent stages."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+TARGET_NAME = "Casey Evans"
+TARGET_LOCATION = "Denver"
+TARGET_TEAM = "Sales"
+REQUIRED_STATUS = "active"
+
+
+def direct_worker() -> int:
+    command = json.loads(sys.stdin.read())
+    if not isinstance(command, list) or not all(
+        isinstance(part, str) for part in command
+    ):
+        raise RuntimeError("invalid reference command")
+    completed = subprocess.run(
+        command,
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=15,
+        check=False,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "candidate operation failed")
+    payload = json.loads(completed.stdout)
+    if not isinstance(payload, dict):
+        raise RuntimeError("candidate operation returned an invalid result")
+    print(json.dumps(payload))
+    return 0
+
+
+def run_stage(command: list[str]) -> dict[str, Any]:
+    completed = subprocess.run(
+        [sys.executable, "-B", str(Path(__file__).resolve()), "--direct-worker"],
+        cwd=ROOT,
+        input=json.dumps(command),
+        capture_output=True,
+        text=True,
+        timeout=20,
+        check=False,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "reference stage failed")
+    payload = json.loads(completed.stdout)
+    if not isinstance(payload, dict):
+        raise RuntimeError("reference stage returned an invalid result")
+    return payload
+
+
+def main() -> int:
+    help_result = subprocess.run(
+        ["./candidatectl", "--help"],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=15,
+        check=False,
+    )
+    if help_result.returncode != 0 or "search" not in help_result.stdout:
+        raise RuntimeError("candidate executable help could not be inspected")
+
+    search = run_stage(
+        [
+            "./candidatectl",
+            "search",
+            "--name",
+            TARGET_NAME,
+            "--location",
+            TARGET_LOCATION,
+        ]
+    )
+    matches = search.get("matches")
+    if not isinstance(matches, list):
+        raise RuntimeError("reference search returned invalid summaries")
+    eligible = [
+        match
+        for match in matches
+        if isinstance(match, dict)
+        and match.get("name") == TARGET_NAME
+        and match.get("location") == TARGET_LOCATION
+        and match.get("team") == TARGET_TEAM
+        and match.get("status") == REQUIRED_STATUS
+        and isinstance(match.get("id"), str)
+        and match["id"]
+    ]
+    if len(eligible) != 1:
+        raise RuntimeError("reference search did not resolve uniquely")
+    stable_id = eligible[0]["id"]
+
+    detail = run_stage(["./candidatectl", "get", "--id", stable_id])
+    record = detail.get("record")
+    if not isinstance(record, dict):
+        raise RuntimeError("reference get returned no complete record")
+    if (
+        record.get("id") != stable_id
+        or record.get("name") != TARGET_NAME
+        or record.get("location") != TARGET_LOCATION
+        or record.get("team") != TARGET_TEAM
+        or record.get("status") != REQUIRED_STATUS
+    ):
+        raise RuntimeError("reference get returned a different candidate")
+
+    fields = (
+        ("Stable ID", "id"),
+        ("Name", "name"),
+        ("Team", "team"),
+        ("Location", "location"),
+        ("Lifecycle status", "status"),
+        ("Role", "role"),
+        ("Email", "email"),
+        ("Phone", "phone"),
+        ("Applied at", "applied_at"),
+        ("Source", "source"),
+        ("Recruiter", "recruiter"),
+        ("Current stage", "current_stage"),
+        ("Recommended next step", "recommended_next_step"),
+    )
+    if not all(isinstance(record.get(key), str) for _, key in fields):
+        raise RuntimeError("reference get omitted a required full-detail field")
+    report = "".join(f"{label}: {record[key]}\n" for label, key in fields)
+    report += "Action status: Awaiting explicit confirmation; no action taken\n"
+    (ROOT / "candidate-details.md").write_text(report, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    if sys.argv[1:] == ["--direct-worker"]:
+        raise SystemExit(direct_worker())
+    raise SystemExit(main())

@@ -0,0 +1,251 @@
+Set-StrictMode -Version Latest
+
+function Read-VcfArchitectureJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $Path
+    )
+
+    $resolved = (Resolve-Path -LiteralPath $Path -ErrorAction Stop).Path
+    return Get-Content -LiteralPath $resolved -Raw -Encoding utf8 |
+        ConvertFrom-Json -Depth 100 -ErrorAction Stop
+}
+
+function New-VcfBrownfieldMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $InventoryPath,
+
+        [Parameter(Mandatory)]
+        [string] $CompatibilitySnapshotPath,
+
+        [Parameter(Mandatory)]
+        [string] $OutputPath
+    )
+
+    $inventory = Read-VcfArchitectureJson -Path $InventoryPath
+    $authority = Read-VcfArchitectureJson -Path $CompatibilitySnapshotPath
+
+    $supportedPath = @($authority.supportedPlatformPaths | Where-Object {
+        $_.from -eq $inventory.vcfVersion -and
+        $_.to -eq $inventory.targetVcfVersion
+    })
+    if ($supportedPath.Count -ne 1) {
+        throw "The pinned authority contains no unique direct path from $($inventory.vcfVersion) to $($inventory.targetVcfVersion)."
+    }
+
+    # Construct the core API models through the installed VMware SDK. The final
+    # hashtables retain the installer's camel-case wire representation.
+    $sdkHostSpecs = @($inventory.hosts | ForEach-Object {
+        Initialize-VcfSddcHostSpec -Hostname $_.hostname
+    })
+    $sdkVcenterNetwork = Initialize-VcfNetworkDetailsSpec `
+        -DnsName $inventory.appliances.vcenterFqdn `
+        -Gateway $inventory.networking.management.gateway `
+        -SubnetMask $inventory.networking.management.subnetMask
+    $sdkVcenterSpec = Initialize-VcfVcenterSpec `
+        -Name $inventory.appliances.vcenterFqdn `
+        -NetworkDetailsSpec $sdkVcenterNetwork `
+        -RootPassword $inventory.credentialPlaceholders.vcenterRootPassword `
+        -DatacenterName $inventory.topology.managementDomain.datacenterName `
+        -VmSize 'MEDIUM' `
+        -StorageSize 'lstorage'
+    $sdkNsxManagers = @($inventory.appliances.nsxManagerFqdns | ForEach-Object {
+        Initialize-VcfNsxtManagerSpec -Hostname $_
+    })
+    $sdkNsxtSpec = Initialize-VcfSddcNsxtSpec `
+        -NsxtManagers $sdkNsxManagers `
+        -VipFqdn $inventory.appliances.nsxVipFqdn `
+        -RootNsxtManagerPassword $inventory.credentialPlaceholders.nsxRootPassword `
+        -NsxtAdminPassword $inventory.credentialPlaceholders.nsxAdminPassword `
+        -NsxtAuditPassword $inventory.credentialPlaceholders.nsxAuditPassword `
+        -Version $authority.targetVcfVersion `
+        -UseExistingDeployment $true
+    if ($sdkHostSpecs.Count -ne $authority.topologyRules.minimumHostCount -or
+        $null -eq $sdkVcenterSpec -or $null -eq $sdkNsxtSpec) {
+        throw 'The VMware SDK did not construct the required target models.'
+    }
+
+    $hostSpecs = @($sdkHostSpecs | ForEach-Object {
+        [ordered]@{ hostname = $_.Hostname }
+    })
+    $nsxManagers = @($sdkNsxManagers | ForEach-Object {
+        [ordered]@{ hostname = $_.Hostname }
+    })
+    $networkSpecs = @(
+        [ordered]@{
+            networkType = 'MANAGEMENT'
+            vlanId = $inventory.networking.management.vlanId
+            subnet = $inventory.networking.management.subnet
+            gateway = $inventory.networking.management.gateway
+            subnetMask = $inventory.networking.management.subnetMask
+            mtu = 1500
+            ipAddressVersion = 'IPv4'
+            ipAddressAssignmentMode = 'STATIC'
+        },
+        [ordered]@{
+            networkType = 'VMOTION'
+            vlanId = $inventory.networking.vmotion.vlanId
+            subnet = $inventory.networking.vmotion.subnet
+            gateway = $inventory.networking.vmotion.gateway
+            subnetMask = $inventory.networking.vmotion.subnetMask
+            mtu = 9000
+            ipAddressVersion = 'IPv4'
+            ipAddressAssignmentMode = 'STATIC'
+        },
+        [ordered]@{
+            networkType = 'VSAN'
+            vlanId = $inventory.networking.vsan.vlanId
+            subnet = $inventory.networking.vsan.subnet
+            gateway = $inventory.networking.vsan.gateway
+            subnetMask = $inventory.networking.vsan.subnetMask
+            mtu = 9000
+            ipAddressVersion = 'IPv4'
+            ipAddressAssignmentMode = 'STATIC'
+        },
+        [ordered]@{
+            networkType = 'FLEET_MANAGEMENT'
+            vlanId = $inventory.networking.managementServices.vlanId
+            subnet = $inventory.networking.managementServices.subnet
+            gateway = $inventory.networking.managementServices.gateway
+            subnetMask = $inventory.networking.managementServices.subnetMask
+            includeIpAddressRanges = @(
+                [ordered]@{
+                    startIpAddress = $inventory.networking.managementServices.startIpAddress
+                    endIpAddress = $inventory.networking.managementServices.endIpAddress
+                }
+            )
+            mtu = 1500
+            ipAddressVersion = 'IPv4'
+            ipAddressAssignmentMode = 'STATIC'
+        }
+    )
+
+    $targetSddcSpec = [ordered]@{
+        sddcId = $inventory.topology.managementDomain.name
+        workflowType = 'VCF'
+        hostSpecs = $hostSpecs
+        version = $authority.targetVcfVersion
+        vcenterSpec = [ordered]@{
+            vcenterHostname = $inventory.appliances.vcenterFqdn
+            rootVcenterPassword = $inventory.credentialPlaceholders.vcenterRootPassword
+            vmSize = 'medium'
+            storageSize = 'lstorage'
+            version = $authority.targetVcfVersion
+            useExistingDeployment = $true
+        }
+        clusterSpec = [ordered]@{
+            datacenterName = $inventory.topology.managementDomain.datacenterName
+            clusterName = $inventory.topology.managementDomain.clusterName
+        }
+        nsxtSpec = [ordered]@{
+            nsxtManagers = $nsxManagers
+            nsxtManagerSize = 'medium'
+            vipFqdn = $inventory.appliances.nsxVipFqdn
+            rootNsxtManagerPassword = $inventory.credentialPlaceholders.nsxRootPassword
+            nsxtAdminPassword = $inventory.credentialPlaceholders.nsxAdminPassword
+            nsxtAuditPassword = $inventory.credentialPlaceholders.nsxAuditPassword
+            version = $authority.targetVcfVersion
+            useExistingDeployment = $true
+        }
+        networkSpecs = $networkSpecs
+        dnsSpec = [ordered]@{
+            subdomain = $inventory.networking.dnsSubdomain
+            nameservers = @($inventory.networking.dnsServers)
+        }
+        ntpServers = @($inventory.networking.ntpServers)
+        sddcManagerSpec = [ordered]@{
+            hostname = $inventory.appliances.sddcManagerFqdn
+            rootPassword = $inventory.credentialPlaceholders.sddcManagerRootPassword
+            sshPassword = $inventory.credentialPlaceholders.sddcManagerSshPassword
+            version = $authority.targetVcfVersion
+            useExistingDeployment = $true
+        }
+        managementPoolName = 'sfo01-management-network-pool'
+        ceipEnabled = $false
+        skipEsxThumbprintValidation = $false
+        skipGatewayPingValidation = $false
+        datastoreSpec = [ordered]@{
+            existingDatastoreName = $inventory.topology.managementDomain.datastoreName
+        }
+        fleetLcmSpec = [ordered]@{
+            version = $authority.targetVcfVersion
+            size = 'small'
+        }
+        sddcLcmSpec = [ordered]@{
+            version = $authority.targetVcfVersion
+            size = 'small'
+        }
+        vcfOperationsSpec = [ordered]@{
+            nodes = @(
+                [ordered]@{
+                    hostname = $inventory.appliances.operationsFqdn
+                    type = 'master'
+                }
+            )
+            adminUserPassword = $inventory.credentialPlaceholders.operationsAdminPassword
+            applianceSize = 'medium'
+            useExistingDeployment = $true
+            version = $authority.targetVcfVersion
+        }
+        vcfManagementComponentsInfrastructureSpec = [ordered]@{
+            localRegionNetwork = [ordered]@{
+                networkName = 'sfo01-management-services'
+                subnetMask = $inventory.networking.managementServices.subnetMask
+                gateway = $inventory.networking.managementServices.gateway
+            }
+        }
+        licenseServerSpec = [ordered]@{
+            hostname = $inventory.appliances.licenseServerFqdn
+            version = $authority.targetVcfVersion
+            useExistingDeployment = $false
+        }
+        vcfInstanceName = $inventory.estateId
+    }
+
+    $inventoryComponents = @{}
+    foreach ($component in $inventory.components) {
+        $inventoryComponents[$component.id] = $component
+    }
+    $steps = @($authority.componentRules | Sort-Object -Property order | ForEach-Object {
+        $currentVersion = if ($inventoryComponents.ContainsKey($_.id)) {
+            $inventoryComponents[$_.id].currentVersion
+        } else {
+            'NOT_INSTALLED'
+        }
+        if ($_.allowedCurrentVersions -notcontains $currentVersion) {
+            throw "Component $($_.id) at $currentVersion is outside the pinned compatibility snapshot."
+        }
+        [ordered]@{
+            order = $_.order
+            componentId = $_.id
+            componentName = $_.name
+            currentVersion = $currentVersion
+            targetVersion = $_.targetVersion
+            action = $_.action
+            gates = @($_.requiredGates)
+        }
+    })
+
+    $plan = [ordered]@{
+        planFormat = 'vcf-brownfield-migration-plan/1.0'
+        estateId = $inventory.estateId
+        sourceVcfVersion = $inventory.vcfVersion
+        targetVcfVersion = $authority.targetVcfVersion
+        platformPath = @($inventory.vcfVersion, $authority.targetVcfVersion)
+        topology = $inventory.topology
+        targetSddcSpec = $targetSddcSpec
+        steps = $steps
+    }
+
+    $parent = Split-Path -Parent $OutputPath
+    if ($parent -and -not (Test-Path -LiteralPath $parent)) {
+        $null = New-Item -ItemType Directory -Path $parent
+    }
+    $plan | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $OutputPath -Encoding utf8
+    return $plan
+}
+
+Export-ModuleMember -Function New-VcfBrownfieldMigrationPlan

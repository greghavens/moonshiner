{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch-0067:migration-plan:1.0",
  "title": "VCF brownfield migration architecture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planFormat",
    "estateId",
    "sourceVcfVersion",
    "targetVcfVersion",
    "platformPath",
    "topology",
    "targetSddcSpec",
    "steps"
  ],
  "properties": {
    "planFormat": {
      "const": "vcf-brownfield-migration-plan/1.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "sourceVcfVersion": {
      "type": "string",
      "minLength": 1
    },
    "targetVcfVersion": {
      "type": "string",
      "minLength": 1
    },
    "platformPath": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "siteCount",
        "deploymentModel",
        "managementDomain"
      ],
      "properties": {
        "siteCount": {
          "type": "integer",
          "minimum": 1
        },
        "deploymentModel": {
          "enum": ["CONSOLIDATED"]
        },
        "managementDomain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "datacenterName",
            "clusterName",
            "datastoreName",
            "hostIds"
          ],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "datacenterName": {"type": "string", "minLength": 1},
            "clusterName": {"type": "string", "minLength": 1},
            "datastoreName": {"type": "string", "minLength": 1},
            "hostIds": {
              "type": "array",
              "minItems": 4,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "targetSddcSpec": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "componentId",
          "componentName",
          "currentVersion",
          "targetVersion",
          "action",
          "gates"
        ],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "componentId": {"type": "string", "minLength": 1},
          "componentName": {"type": "string", "minLength": 1},
          "currentVersion": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "action": {
            "enum": ["UPGRADE", "DEPLOY", "MIGRATE", "RETAIN"]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}

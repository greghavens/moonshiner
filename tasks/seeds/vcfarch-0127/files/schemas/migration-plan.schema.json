{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch:migration-plan:1.0",
  "title": "VCF brownfield migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetFleet", "domains", "services", "steps"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "targetFleet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "release", "primaryInstance", "managementDomain"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "release": {"type": "string", "minLength": 1},
        "primaryInstance": {"type": "string", "minLength": 1},
        "managementDomain": {"type": "string", "minLength": 1}
      }
    },
    "domains": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "site", "componentIds"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["management", "workload"]},
          "site": {"type": "string", "minLength": 1},
          "componentIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "services": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "componentId", "domain", "deploymentModel", "nodeCount", "size"],
        "properties": {
          "service": {"enum": ["vcf-operations", "vcf-automation", "vcf-operations-for-logs"]},
          "componentId": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "deploymentModel": {"enum": ["simple", "high-availability"]},
          "nodeCount": {"type": "integer", "minimum": 1},
          "size": {"enum": ["xsmall", "small", "medium", "large", "xlarge"]}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "componentId", "componentType", "fromVersion", "toVersion", "action", "target", "gates"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "componentId": {"type": "string", "minLength": 1},
          "componentType": {"type": "string", "minLength": 1},
          "fromVersion": {"type": "string", "minLength": 1},
          "toVersion": {"type": "string", "minLength": 1},
          "action": {"enum": ["upgrade", "import-and-upgrade", "align-with-hosts", "replace", "deploy"]},
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fleet", "instance", "domain"],
            "properties": {
              "fleet": {"type": "string", "minLength": 1},
              "instance": {"type": "string", "minLength": 1},
              "domain": {"type": "string", "minLength": 1}
            }
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "condition"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "condition": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}

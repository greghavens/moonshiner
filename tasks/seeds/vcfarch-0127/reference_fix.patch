 // BrownfieldPlan maps every inventory component into the single target fleet.
 func BrownfieldPlan(inventory Inventory, snapshot Snapshot) (MigrationPlan, error) {
-	return MigrationPlan{}, fmt.Errorf("brownfield architecture not implemented")
+	if len(snapshot.Domains) < 2 {
+		return MigrationPlan{}, fmt.Errorf("snapshot must define management and workload domains")
+	}
+	domainsByKind := make(map[string]DomainRule, len(snapshot.Domains))
+	domainsByID := make(map[string]DomainRule, len(snapshot.Domains))
+	for _, domain := range snapshot.Domains {
+		if _, exists := domainsByKind[domain.Kind]; exists {
+			return MigrationPlan{}, fmt.Errorf("duplicate %s domain", domain.Kind)
+		}
+		if _, exists := domainsByID[domain.ID]; exists {
+			return MigrationPlan{}, fmt.Errorf("duplicate domain %q", domain.ID)
+		}
+		domainsByKind[domain.Kind] = domain
+		domainsByID[domain.ID] = domain
+	}
+	if domainsByKind["management"].ID == "" || domainsByKind["workload"].ID == "" {
+		return MigrationPlan{}, fmt.Errorf("management and workload domains are required")
+	}
+
+	domains := make([]Domain, 0, len(snapshot.Domains))
+	for _, rule := range snapshot.Domains {
+		domains = append(domains, Domain{ID: rule.ID, Kind: rule.Kind, Site: rule.Site})
+	}
+	domainIndex := make(map[string]int, len(domains))
+	for i := range domains {
+		domainIndex[domains[i].ID] = i
+	}
+
+	type phasedStep struct {
+		phase int
+		order int
+		step  MigrationStep
+	}
+	work := make([]phasedStep, 0, len(inventory.Components)+len(snapshot.PlannedComponents))
+	seenIDs := map[string]bool{}
+	for i, component := range inventory.Components {
+		if seenIDs[component.ID] {
+			return MigrationPlan{}, fmt.Errorf("duplicate inventory component %q", component.ID)
+		}
+		seenIDs[component.ID] = true
+		rule, ok := matchingPath(snapshot.Paths, component)
+		if !ok {
+			return MigrationPlan{}, fmt.Errorf("no pinned path for %s %s in %s scope", component.Type, component.Version, component.Scope)
+		}
+		domain, ok := targetDomain(component.Scope, snapshot.ScopeTargets, domainsByID)
+		if !ok {
+			return MigrationPlan{}, fmt.Errorf("no pinned target domain for scope %q", component.Scope)
+		}
+		domains[domainIndex[domain.ID]].ComponentIDs = append(domains[domainIndex[domain.ID]].ComponentIDs, component.ID)
+		work = append(work, phasedStep{
+			phase: rule.Phase,
+			order: i,
+			step:  migrationStep(component.ID, component.Type, component.Version, rule.To, rule.Action, snapshot.Fleet, domain, rule.RequiredGates),
+		})
+	}
+	for i, component := range snapshot.PlannedComponents {
+		if seenIDs[component.ID] {
+			return MigrationPlan{}, fmt.Errorf("duplicate planned component %q", component.ID)
+		}
+		seenIDs[component.ID] = true
+		domain, ok := targetDomain(component.Scope, snapshot.ScopeTargets, domainsByID)
+		if !ok {
+			return MigrationPlan{}, fmt.Errorf("no pinned target domain for scope %q", component.Scope)
+		}
+		work = append(work, phasedStep{
+			phase: component.Phase,
+			order: len(inventory.Components) + i,
+			step:  migrationStep(component.ID, component.Type, component.FromVersion, component.ToVersion, component.Action, snapshot.Fleet, domain, component.RequiredGates),
+		})
+	}
+	sort.SliceStable(work, func(i, j int) bool {
+		if work[i].phase != work[j].phase {
+			return work[i].phase < work[j].phase
+		}
+		return work[i].order < work[j].order
+	})
+	steps := make([]MigrationStep, len(work))
+	for i := range work {
+		work[i].step.Sequence = (i + 1) * 10
+		steps[i] = work[i].step
+	}
+
+	services := append([]ServicePlacement(nil), snapshot.ServiceSizing...)
+	return MigrationPlan{
+		SchemaVersion: "1.0",
+		TargetFleet: TargetFleet{
+			Name: snapshot.Fleet.Name, Release: snapshot.TargetRelease,
+			PrimaryInstance: snapshot.Fleet.PrimaryInstance, ManagementDomain: snapshot.Fleet.ManagementDomain,
+		},
+		Domains:  domains,
+		Services: services,
+		Steps:    steps,
+	}, nil
+}
+
+func network(networkType string, vlan int, subnet, gateway, mask string, mtu int) map[string]any {
+	return map[string]any{
+		"networkType":             networkType,
+		"vlanId":                  vlan,
+		"subnet":                  subnet,
+		"gateway":                 gateway,
+		"subnetMask":              mask,
+		"mtu":                     mtu,
+		"ipAddressVersion":        "IPv4",
+		"ipAddressAssignmentMode": "STATIC",
+	}
+}
+
+func matchingPath(paths []PathRule, component Component) (PathRule, bool) {
+	for _, path := range paths {
+		if path.Type == component.Type && path.From == component.Version && path.Scope == component.Scope {
+			return path, true
+		}
+	}
+	return PathRule{}, false
+}
+
+func targetDomain(scope string, targets map[string]string, domains map[string]DomainRule) (DomainRule, bool) {
+	domainID, ok := targets[scope]
+	if !ok {
+		return DomainRule{}, false
+	}
+	domain, ok := domains[domainID]
+	return domain, ok
+}
+
+func migrationStep(id, componentType, from, to, action string, fleet FleetRule, domain DomainRule, gateIDs []string) MigrationStep {
+	gates := make([]StepGate, len(gateIDs))
+	for i, id := range gateIDs {
+		gates[i] = StepGate{
+			ID:        id,
+			Condition: "Confirm " + strings.ReplaceAll(id, "-", " ") + " before starting this step.",
+		}
+	}
+	return MigrationStep{
+		ComponentID: id, ComponentType: componentType, FromVersion: from, ToVersion: to, Action: action,
+		Target: StepTarget{Fleet: fleet.Name, Instance: domain.Instance, Domain: domain.ID},
+		Gates:  gates,
+	}
 }

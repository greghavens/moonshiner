diff --git a/.reference_solution.py b/.reference_solution.py
new file mode 100755
--- /dev/null
+++ b/.reference_solution.py
@@ -0,0 +1,102 @@
+#!/usr/bin/env python3
+"""Reference proof through the genuine support case executable."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "case-registry"
+REPORT = ROOT / "cancellation-report.txt"
+TARGET_ID = "sup-145"
+REASON = "duplicate record entered during intake"
+CANCEL_COMMAND = [
+    str(CLIENT),
+    "cancel",
+    "--id",
+    TARGET_ID,
+    "--reason",
+    REASON,
+]
+FETCH_COMMAND = [str(CLIENT), "fetch", "--id", TARGET_ID]
+
+
+def run(command: list[str]) -> tuple[int, dict[str, Any]]:
+    completed = subprocess.run(
+        command,
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=5,
+    )
+    response_text = completed.stdout if completed.returncode == 0 else completed.stderr
+    try:
+        response = json.loads(response_text)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("case executable returned invalid JSON") from error
+    if not isinstance(response, dict):
+        raise RuntimeError("case executable returned a non-object response")
+    return completed.returncode, response
+
+
+def case_record(response: dict[str, Any]) -> dict[str, Any]:
+    record = response.get("record")
+    if not isinstance(record, dict) or record.get("id") != TARGET_ID:
+        raise RuntimeError("case executable did not return the target case")
+    return record
+
+
+def require_cancelled(response: dict[str, Any]) -> str:
+    record = case_record(response)
+    if (
+        record.get("status") != "cancelled"
+        or record.get("cancellation_reason") != REASON
+    ):
+        raise RuntimeError("case executable did not confirm the cancellation")
+    return "cancelled"
+
+
+def main() -> int:
+    first_code, first_response = run(CANCEL_COMMAND)
+    if first_code == 0:
+        final_status = require_cancelled(first_response)
+        retry_was_necessary = False
+    else:
+        if (
+            first_code != 75
+            or first_response.get("error") != "deadline_exceeded"
+            or first_response.get("outcome") != "unknown"
+        ):
+            raise RuntimeError("initial cancellation was not an uncertain timeout")
+
+        fetch_code, fetched_response = run(FETCH_COMMAND)
+        if fetch_code != 0:
+            raise RuntimeError("direct case fetch failed")
+        observed = case_record(fetched_response)
+        if observed.get("status") == "cancelled":
+            final_status = require_cancelled(fetched_response)
+            retry_was_necessary = False
+        elif observed.get("status") == "active":
+            retry_code, retry_response = run(CANCEL_COMMAND)
+            if retry_code != 0:
+                raise RuntimeError("the one permitted retry failed")
+            final_status = require_cancelled(retry_response)
+            retry_was_necessary = True
+        else:
+            raise RuntimeError("direct fetch returned an unsafe status")
+
+    REPORT.write_text(
+        f"{TARGET_ID}: {final_status}; state verification made a retry necessary: "
+        f"{'yes' if retry_was_necessary else 'no'}\n",
+        encoding="utf-8",
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

diff --git a/.reference-solution.py b/.reference-solution.py
new file mode 100644
--- /dev/null
+++ b/.reference-solution.py
@@ -0,0 +1,56 @@
+from __future__ import annotations
+
+import json
+import subprocess
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parent
+CLI = ROOT / "bin" / "shipmentctl"
+AUDIT_LOG = ROOT / ".shipment-runtime" / "audit.jsonl"
+AUDIT_LOCK = ROOT / ".shipment-runtime" / "audit.lock"
+OUTPUT = ROOT / "shipments.txt"
+
+
+def run(*arguments: str) -> str:
+    completed = subprocess.run(
+        [str(CLI), *arguments],
+        cwd=ROOT,
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    return completed.stdout
+
+
+def main() -> int:
+    AUDIT_LOG.unlink(missing_ok=True)
+    AUDIT_LOCK.unlink(missing_ok=True)
+
+    run("--help")
+    profile = json.loads(run("profile"))
+    records = json.loads(
+        run(
+            "list",
+            "--hub",
+            profile["preferred_hub"],
+            "--status",
+            "pending",
+            "--date",
+            "2026-11-13",
+        )
+    )
+    if records:
+        lines = [
+            "Shipment: {name} | ID: {id} | Hub: {hub} | Date: {date} | "
+            "Status: {status}".format(**record)
+            for record in records
+        ]
+    else:
+        lines = ["No matching shipments."]
+    OUTPUT.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/vcf-migration-plan-1.json",
  "title": "VCF Mixed-Estate Migration Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "inventory_id",
    "compatibility_snapshot_id",
    "site",
    "target_sddc_spec",
    "components",
    "gates",
    "steps",
    "consulted_sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z0-9-]+$"
    },
    "inventory_id": {
      "type": "string",
      "minLength": 1
    },
    "compatibility_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "site_count",
        "architecture_model",
        "management_cluster",
        "host_count"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "site_count": {
          "type": "integer",
          "minimum": 1
        },
        "architecture_model": {
          "type": "string",
          "enum": [
            "consolidated"
          ]
        },
        "management_cluster": {
          "type": "string",
          "minLength": 1
        },
        "host_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "target_sddc_spec": {
      "type": "object"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inventory_id",
          "name",
          "current_version",
          "target_product",
          "target_version",
          "transition",
          "via_versions",
          "gated_by"
        ],
        "properties": {
          "inventory_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "current_version": {
            "type": "string",
            "minLength": 1
          },
          "target_product": {
            "type": "string",
            "minLength": 1
          },
          "target_version": {
            "type": "string",
            "minLength": 1
          },
          "transition": {
            "type": "string",
            "enum": [
              "in_place",
              "installer_converge_then_in_place",
              "rolling_cluster_upgrade",
              "fresh_deploy_migrate_then_retire",
              "patch_retain_then_retire",
              "retain_migrate_then_retire"
            ]
          },
          "via_versions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "gated_by": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "condition",
          "satisfied_by"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^G-[A-Z-]+$"
          },
          "condition": {
            "type": "string",
            "minLength": 12
          },
          "satisfied_by": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "id",
          "event",
          "component_ids",
          "action",
          "from_versions",
          "to_versions",
          "depends_on",
          "gates_cleared"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "event": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "component_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "action": {
            "type": "string",
            "minLength": 12
          },
          "from_versions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "to_versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "gates_cleared": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "consulted_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url",
          "consulted_on",
          "used_for"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "consulted_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "used_for": {
            "type": "string",
            "minLength": 12
          }
        }
      }
    }
  }
}

+function Get-VcfVcenterResizeMember {
+    param(
+        [AllowNull()]
+        $InputObject,
+
+        [Parameter(Mandatory)]
+        [string] $Name
+    )
+
+    if ($null -ne $InputObject) {
+        $Property = $InputObject.PSObject.Properties[$Name]
+        if ($null -ne $Property) {
+            return [pscustomobject]@{
+                Found = $true
+                Value = $Property.Value
+            }
+        }
+    }
+    return [pscustomobject]@{
+        Found = $false
+        Value = $null
+    }
+}
+
+function ConvertFrom-VcfVcenterResizeError {
+    param(
+        [AllowEmptyString()]
+        [string] $Body,
+
+        [Parameter(Mandatory)]
+        [int] $StatusCode
+    )
+
+    if ([string]::IsNullOrWhiteSpace($Body)) {
+        throw "vCenter returned HTTP $StatusCode without a standard error body."
+    }
+    try {
+        $ErrorObject = $Body | ConvertFrom-Json -Depth 30
+    }
+    catch {
+        throw "vCenter returned malformed JSON for HTTP $StatusCode."
+    }
+    if ($null -eq $ErrorObject) {
+        throw "vCenter returned a null standard error for HTTP $StatusCode."
+    }
+
+    $TypeMember = Get-VcfVcenterResizeMember `
+        -InputObject $ErrorObject `
+        -Name 'error_type'
+    if (
+        -not $TypeMember.Found -or
+        $TypeMember.Value -isnot [string] -or
+        [string]::IsNullOrWhiteSpace($TypeMember.Value)
+    ) {
+        throw "vCenter error for HTTP $StatusCode has no error_type."
+    }
+
+    $MessagesMember = Get-VcfVcenterResizeMember `
+        -InputObject $ErrorObject `
+        -Name 'messages'
+    if (-not $MessagesMember.Found -or $null -eq $MessagesMember.Value) {
+        throw "vCenter error for HTTP $StatusCode has no messages."
+    }
+    $Messages = @($MessagesMember.Value)
+    if ($Messages.Count -lt 1 -or $null -eq $Messages[0]) {
+        throw "vCenter error for HTTP $StatusCode has no first message."
+    }
+    $DefaultMessage = Get-VcfVcenterResizeMember `
+        -InputObject $Messages[0] `
+        -Name 'default_message'
+    if (
+        -not $DefaultMessage.Found -or
+        $DefaultMessage.Value -isnot [string] -or
+        [string]::IsNullOrWhiteSpace($DefaultMessage.Value)
+    ) {
+        throw "vCenter error for HTTP $StatusCode has no default_message."
+    }
+
+    return [pscustomobject]@{
+        ErrorType = $TypeMember.Value
+        Message = $DefaultMessage.Value
+    }
+}

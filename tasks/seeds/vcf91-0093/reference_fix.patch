+function Invoke-VcfVcenterResizeRequest {
+    param(
+        [Parameter(Mandatory)]
+        [psobject] $Client,
+
+        [Parameter(Mandatory)]
+        [ValidateSet('PATCH', 'POST')]
+        [string] $Method,
+
+        [Parameter(Mandatory)]
+        [string] $Target,
+
+        [AllowNull()]
+        $JsonBody
+    )
+
+    $HttpClientMember = Get-VcfVcenterResizeMember `
+        -InputObject $Client `
+        -Name 'HttpClient'
+    $BaseUriMember = Get-VcfVcenterResizeMember `
+        -InputObject $Client `
+        -Name 'BaseUri'
+    if (
+        -not $HttpClientMember.Found -or
+        $null -eq $HttpClientMember.Value -or
+        -not $BaseUriMember.Found -or
+        $null -eq $BaseUriMember.Value
+    ) {
+        throw 'Client must be created by New-VcfVcenterResizeClient.'
+    }
+
+    $BaseText = ([uri] $BaseUriMember.Value).AbsoluteUri.TrimEnd('/')
+    $RequestUri = [uri] ($BaseText + '/' + $Target.TrimStart('/'))
+    $Request = [Net.Http.HttpRequestMessage]::new(
+        [Net.Http.HttpMethod]::new($Method),
+        $RequestUri
+    )
+    $Request.Headers.Accept.Add(
+        [Net.Http.Headers.MediaTypeWithQualityHeaderValue]::new(
+            'application/json'
+        )
+    )
+    if ($null -ne $JsonBody) {
+        $Bytes = [Text.Encoding]::UTF8.GetBytes($JsonBody)
+        $Content = [Net.Http.ByteArrayContent]::new($Bytes)
+        $Content.Headers.ContentType = (
+            [Net.Http.Headers.MediaTypeHeaderValue]::new('application/json')
+        )
+        $Request.Content = $Content
+    }
+
+    $Response = $null
+    try {
+        $Response = $HttpClientMember.Value.SendAsync(
+            $Request
+        ).GetAwaiter().GetResult()
+        $ResponseText = $Response.Content.ReadAsStringAsync(
+        ).GetAwaiter().GetResult()
+        return [pscustomobject]@{
+            StatusCode = [int] $Response.StatusCode
+            Body = $ResponseText
+        }
+    }
+    finally {
+        if ($null -ne $Response) {
+            $Response.Dispose()
+        }
+        $Request.Dispose()
+    }

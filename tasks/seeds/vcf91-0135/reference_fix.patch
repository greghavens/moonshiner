+    ModuleVersion = '1.0.0'
+    GUID = 'd13f3218-6187-467c-b179-0e4017dd24a9'
+    Author = 'VCF Platform Engineering'
+    Description = 'Concurrency-safe vSphere Supervisor and VKS API session client.'
+    PowerShellVersion = '7.0'
+    RequiredModules = @('VMware.Sdk.Vcf.SddcManager')
+    FunctionsToExport = @(
+        'Connect-VksSupervisor',
+        'Disconnect-VksSupervisor',
+        'Get-VksKubeApiServerSettings',
+        'Get-VksSupervisorNamespaces',
+        'New-VksVcfCredentialUpdateSpec',
+        'Set-VksKubeApiServerSettings',

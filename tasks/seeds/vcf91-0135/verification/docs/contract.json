    "openapi": "3.0.3",
    "api_title": "vSphere Automation API",
    "api_version": "9.1.0.0",
    "server_url": "https://{host}/api"
  },
  "security_schemes": {
    "basic_auth": {
      "type": "http",
      "scheme": "basic"
    },
    "api_key_auth": {
      "type": "apiKey",
      "in": "header",
      "name": "vmware-api-session-id"
    }
  },
  "operations": {
    "Cis.Session_create": {
      "method": "POST",
      "path": "/session",
      "security": "basic_auth",
      "request_body": "absent",
      "success_status": 201,
      "success_body": "JSON string containing the newly created session token"
    },
    "Cis.Session_delete": {
      "method": "DELETE",
      "path": "/session",
      "security": "api_key_auth",
      "request_body": "absent",
      "success_status": 204
    },
    "Vcenter.Namespaces.Instances_listV2": {
      "method": "GET",
      "path": "/vcenter/namespaces/instances/v2",
      "security": "api_key_auth",
      "query": "none",
      "request_body": "absent",
      "success_status": 200,
      "success_body": "array of Vcenter.Namespaces.Instances.SummaryV2",
      "summary_v2_required": [
        "supervisor",
        "namespace",
        "description",
        "config_status",
        "stats"
      ]
    },
    "Vcenter.NamespaceManagement.Supervisors.Workloads.KubeApiServerSettings_get": {
      "method": "GET",
      "path": "/vcenter/namespace-management/supervisors/{supervisor}/workloads/kube-api-server-settings",
      "security": "api_key_auth",
      "path_parameters": {
        "supervisor": {
          "required": true,
          "type": "string",
          "resource_type": "com.vmware.vcenter.namespace_management.supervisor.Supervisor"
        }
      },
      "request_body": "absent",
      "success_status": 200,
      "success_body_required": [
        "certificate_dns_names",
        "namespace_api_fairness_enabled"
      ],
      "added_in": "vSphere API 9.1.0.0"
    },
    "Vcenter.NamespaceManagement.Supervisors.Workloads.KubeApiServerSettings_update": {
      "method": "PATCH",
      "path": "/vcenter/namespace-management/supervisors/{supervisor}/workloads/kube-api-server-settings",
      "security": "api_key_auth",
      "content_type": "application/json",
      "path_parameters": {
        "supervisor": {
          "required": true,
          "type": "string",
          "resource_type": "com.vmware.vcenter.namespace_management.supervisor.Supervisor"
        }
      },
      "request_schema": "Vcenter.NamespaceManagement.Supervisors.Workloads.KubeApiServerSettings.UpdateSpec",
      "request_properties": {
        "certificate_dns_names_to_add_list": {
          "type": "array[string]",
          "required": false,
          "missing_semantics": "no DNS names are added"
        },
        "certificate_dns_names_to_remove_list": {
          "type": "array[string]",
          "required": false,
          "missing_semantics": "no DNS names are removed"
        },
        "namespace_api_fairness_enabled": {
          "type": "boolean",
          "required": false,
          "missing_semantics": "API fairness is unchanged"
        }
      },
      "success_status": 204,
      "added_in": "vSphere API 9.1.0.0"
    }
  },
  "rotation_invariant": {
    "publish": "Authenticate the replacement credential before atomically publishing its session for new leases.",
    "in_flight": "A request keeps the exact session lease acquired before it was sent.",
    "retirement": "Cis.Session_delete for a retired session occurs only after its final in-flight request completes.",
    "no_replay": "An in-flight request is not replayed under the replacement session."
  },
  "serialization_invariant": "For UpdateSpec, a property is serialized only when its corresponding PowerShell parameter is explicitly bound. Missing optional properties are omitted, not emitted as null or synthesized as empty arrays."

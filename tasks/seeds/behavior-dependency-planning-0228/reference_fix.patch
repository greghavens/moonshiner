diff --git a/.reference_solution.sh b/.reference_solution.sh
new file mode 100644
--- /dev/null
+++ b/.reference_solution.sh
@@ -0,0 +1,61 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+./shipmentctl --help >/dev/null
+
+museum_search=.state/reference-museum-search.json
+garden_search=.state/reference-garden-search.json
+museum_get=.state/reference-museum-get.json
+garden_get=.state/reference-garden-get.json
+
+bash -c '
+set -euo pipefail
+./shipmentctl search --name "Museum loan crate" --city "Baltimore" > "$1" &
+museum_pid=$!
+./shipmentctl search --name "Community garden seed packets" --city "Tucson" > "$2" &
+garden_pid=$!
+wait "$museum_pid"
+wait "$garden_pid"
+' _ "$museum_search" "$garden_search"
+
+museum_id=$(python3 -c '
+import json, sys
+matches = json.load(open(sys.argv[1], encoding="utf-8"))["matches"]
+assert len(matches) == 1 and matches[0]["id"]
+print(matches[0]["id"])
+' "$museum_search")
+garden_id=$(python3 -c '
+import json, sys
+matches = json.load(open(sys.argv[1], encoding="utf-8"))["matches"]
+assert len(matches) == 1 and matches[0]["id"]
+print(matches[0]["id"])
+' "$garden_search")
+
+bash -c '
+set -euo pipefail
+./shipmentctl get --id "$1" > "$3" &
+museum_pid=$!
+./shipmentctl get --id "$2" > "$4" &
+garden_pid=$!
+wait "$museum_pid"
+wait "$garden_pid"
+' _ "$museum_id" "$garden_id" "$museum_get" "$garden_get"
+
+python3 - "$museum_get" "$garden_get" <<'PY'
+import json
+from pathlib import Path
+import sys
+
+museum = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))["record"]
+garden = json.loads(Path(sys.argv[2]).read_text(encoding="utf-8"))["record"]
+assert (museum["name"], museum["city"]) == ("Museum loan crate", "Baltimore")
+assert (garden["name"], garden["city"]) == ("Community garden seed packets", "Tucson")
+status_comparison = "same" if museum["status"] == garden["status"] else "different"
+date_comparison = "same" if museum["date"] == garden["date"] else "different"
+Path("handoff.md").write_text(
+    f"- Museum loan crate (Baltimore): ID {museum['id']}; status {museum['status']}; date {museum['date']}\n"
+    f"- Community garden seed packets (Tucson): ID {garden['id']}; status {garden['status']}; date {garden['date']}\n"
+    f"- Comparison: status {status_comparison}; date {date_comparison}\n",
+    encoding="utf-8",
+)
+PY
diff --git a/handoff.md b/handoff.md
new file mode 100644
--- /dev/null
+++ b/handoff.md
@@ -0,0 +1,3 @@
+- Museum loan crate (Baltimore): ID shi-balt-731; status in-transit; date 2026-07-25
+- Community garden seed packets (Tucson): ID shi-tucs-204; status scheduled; date 2026-07-26
+- Comparison: status different; date different

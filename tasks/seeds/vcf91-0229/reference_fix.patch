 class SddcLcmError(RuntimeError):
     """Raised when an SDDC LCM request or response is invalid."""
 
 
+def _text(value: object, label: str) -> str:
+    if not isinstance(value, str) or not value.strip():
+        raise SddcLcmError(f"{label} must be a nonblank string")
+    return value
+
+
+def _count(value: object, label: str, *, minimum: int, maximum: int | None = None) -> int:
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise SddcLcmError(f"{label} must be an integer")
+    if value < minimum or (maximum is not None and value > maximum):
+        raise SddcLcmError(f"{label} is out of range")
+    return value
+
+
+def _whole(value: object, label: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+        raise SddcLcmError(f"{label} must be a nonnegative integer")
+    return value
+

{
  "contractFormat": "focused-openapi-projection-v1",
  "source": {
    "repository": "vmware/vcf-api-specs",
    "repositoryCommitSha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "specPath": "specifications/sddc-lcm/sddc-lcm-openapi.yaml",
    "license": "Apache-2.0",
    "openapi": "3.0.4",
    "apiVersion": "9.1.0.0"
  },
  "security": {
    "scheme": "bearerToken",
    "type": "http",
    "httpScheme": "Bearer",
    "bearerFormat": "JWT"
  },
  "operations": [
    {
      "operationId": "getTasks",
      "method": "GET",
      "path": "/v1/tasks",
      "requestBody": false,
      "parameters": [
        { "name": "status", "in": "query", "required": false, "schema": { "type": "string" } },
        { "name": "type", "in": "query", "required": false, "schema": { "type": "string" } },
        { "name": "createdBy", "in": "query", "required": false, "schema": { "type": "string" } },
        { "name": "name", "in": "query", "required": false, "schema": { "type": "string" } },
        { "name": "description", "in": "query", "required": false, "schema": { "type": "string" } },
        { "name": "startTimeGt", "in": "query", "required": false, "schema": { "type": "string", "format": "date-time" } },
        { "name": "startTimeLt", "in": "query", "required": false, "schema": { "type": "string", "format": "date-time" } },
        { "name": "updateTimeGt", "in": "query", "required": false, "schema": { "type": "string", "format": "date-time" } },
        { "name": "updateTimeLt", "in": "query", "required": false, "schema": { "type": "string", "format": "date-time" } },
        { "name": "endTimeGt", "in": "query", "required": false, "schema": { "type": "string", "format": "date-time" } },
        { "name": "endTimeLt", "in": "query", "required": false, "schema": { "type": "string", "format": "date-time" } },
        { "name": "resourceId", "in": "query", "required": false, "schema": { "type": "string" } },
        { "name": "resourceType", "in": "query", "required": false, "schema": { "type": "string" } },
        { "name": "includeSystemTasks", "in": "query", "required": false, "schema": { "type": "boolean", "default": false } },
        { "name": "pageNumber", "in": "query", "required": false, "schema": { "type": "integer" } },
        { "name": "pageSize", "in": "query", "required": false, "schema": { "type": "integer" } }
      ],
      "focusedWireProfile": {
        "firstPageMembers": ["type", "resourceId", "resourceType", "pageSize"],
        "laterPageMembers": ["type", "resourceId", "resourceType", "pageNumber", "pageSize"],
        "unsetMembers": [
          "status",
          "createdBy",
          "name",
          "description",
          "startTimeGt",
          "startTimeLt",
          "updateTimeGt",
          "updateTimeLt",
          "endTimeGt",
          "endTimeLt",
          "includeSystemTasks"
        ],
        "unsetBehavior": "omit",
        "memberOrder": "specification declaration order",
        "filterValues": {
          "type": "SUPPORT_BUNDLE",
          "resourceType": "COMPONENT"
        }
      },
      "responses": {
        "200": { "contentType": "application/json", "schema": "PageOfTaskSummary" },
        "500": { "contentType": "application/json", "schema": "PageOfTaskSummary" }
      }
    },
    {
      "operationId": "generateComponentSupportBundle",
      "method": "POST",
      "path": "/v1/components/{componentId}/support-bundles",
      "parameters": [
        { "name": "X-Correlation-Id", "in": "header", "required": false, "schema": { "type": "string" } },
        { "name": "componentId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "requestBody": {
        "required": false,
        "contentType": "application/json",
        "schema": "ComponentSupportBundleSpec"
      },
      "focusedWireProfile": {
        "bodyMembers": ["lookBackWindow"],
        "unsetMembers": ["lookBackWindow"],
        "unsetBehavior": "omit",
        "emptyBody": "{}",
        "idempotencyKeyHeader": "X-Correlation-Id",
        "note": "The specification defines no idempotency key. X-Correlation-Id is echoed back as TaskSummary.correlationId and getTask Task.correlationId, so a prior attempt is discoverable through getTasks before the mutation is retried."
      },
      "responses": {
        "202": { "contentType": "application/json", "schema": "Task" },
        "401": { "contentType": "application/json", "schema": "ErrorResponse" },
        "404": { "contentType": "application/json", "schema": "ErrorResponse" },
        "500": { "contentType": "application/json", "schema": "ErrorResponse" }
      }
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{taskId}",
      "requestBody": false,
      "parameters": [
        { "name": "taskId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "focusedWireProfile": {
        "queryMembers": [],
        "unsetBehavior": "omit"
      },
      "responses": {
        "200": { "contentType": "application/json", "schema": "Task" },
        "404": { "contentType": "application/json", "schema": "ErrorResponse" },
        "500": { "contentType": "application/json", "schema": "ErrorResponse" }
      }
    },
    {
      "operationId": "getComponentSupportBundles",
      "method": "GET",
      "path": "/v1/components/{componentId}/support-bundles",
      "requestBody": false,
      "parameters": [
        { "name": "componentId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "focusedWireProfile": {
        "queryMembers": [],
        "unsetBehavior": "omit",
        "note": "This operation declares no X-Correlation-Id header parameter; sending one is outside the contract."
      },
      "responses": {
        "200": { "contentType": "application/json", "schema": "SupportBundleList" },
        "401": { "contentType": "application/json", "schema": "ErrorResponse" },
        "404": { "contentType": "application/json", "schema": "ErrorResponse" },
        "500": { "contentType": "application/json", "schema": "ErrorResponse" }
      }
    }
  ],
  "schemas": {
    "PageOfTaskSummary": {
      "type": "object",
      "properties": {
        "elements": { "type": "array", "items": { "$ref": "TaskSummary" } },
        "pageMetadata": { "$ref": "PageMetadata" }
      }
    },
    "PageMetadata": {
      "type": "object",
      "properties": {
        "pageNumber": { "type": "integer" },
        "pageSize": { "type": "integer" },
        "totalElements": { "type": "integer" },
        "totalPages": { "type": "integer" }
      }
    },
    "TaskSummary": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "$ref": "LocalizableMessage" },
        "status": { "$ref": "TaskStatus" },
        "type": { "type": "string" },
        "createdBy": { "type": "string" },
        "updatedBy": { "type": "string" },
        "resourceId": { "type": "string" },
        "resourceType": { "type": "string" },
        "createTime": { "type": "string", "format": "date-time" },
        "startTime": { "type": "string", "format": "date-time" },
        "updateTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "correlationId": { "type": "string" },
        "parentTaskId": { "type": "string" },
        "retriable": { "type": "boolean" },
        "cancellable": { "type": "boolean" }
      }
    },
    "Task": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "$ref": "LocalizableMessage" },
        "status": { "$ref": "TaskStatus" },
        "type": { "type": "string" },
        "createdBy": { "type": "string" },
        "updatedBy": { "type": "string" },
        "resourceId": { "type": "string" },
        "resourceType": { "type": "string" },
        "createTime": { "type": "string", "format": "date-time" },
        "startTime": { "type": "string", "format": "date-time" },
        "updateTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "correlationId": { "type": "string" },
        "parentTaskId": { "type": "string" },
        "retriable": { "type": "boolean" },
        "cancellable": { "type": "boolean" },
        "taskSummary": { "$ref": "Task_taskSummary" },
        "stages": { "type": "array", "items": { "$ref": "TaskStage" } },
        "subTasks": { "type": "array", "items": { "$ref": "Task" } },
        "messages": { "type": "array", "items": { "$ref": "TaskMessage" } },
        "result": { "$ref": "Task_result" },
        "additionalDetails": { "type": "object" }
      }
    },
    "TaskStatus": {
      "type": "string",
      "enum": ["PENDING", "SCHEDULED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELED"]
    },
    "ComponentSupportBundleSpec": {
      "type": "object",
      "properties": {
        "lookBackWindow": { "type": "integer" }
      }
    },
    "SupportBundleList": {
      "type": "array",
      "items": { "$ref": "SupportBundle" }
    },
    "SupportBundle": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdTimestamp": { "type": "string", "format": "date-time" },
        "size": { "type": "integer", "format": "int64" },
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "errorCode": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}

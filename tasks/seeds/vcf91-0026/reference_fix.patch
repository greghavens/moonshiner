+func (c *Client) request(
+	ctx context.Context,
+	operationID string,
+	method string,
+	target string,
+	body []byte,
+	accessToken string,
+	expectedStatus int,
+) ([]byte, error) {
+	var reader io.Reader
+	if body != nil {
+		reader = bytes.NewReader(body)
+	}
+	request, err := http.NewRequestWithContext(
+		ctx,
+		method,
+		c.baseURL+target,
+		reader,
+	)
+	if err != nil {
+		if ctx != nil && ctx.Err() != nil {
+			return nil, ctx.Err()
+		}
+		return nil, errors.New(operationID + " request could not be created")
+	}
+	request.Header.Set("Accept", "application/json")
+	if body != nil {
+		request.Header.Set("Content-Type", "application/json")
+	}
+	if accessToken != "" {
+		request.Header.Set("Authorization", "Bearer "+accessToken)
+	}
+
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		if ctx != nil && ctx.Err() != nil {
+			return nil, ctx.Err()
+		}
+		return nil, errors.New(operationID + " transport request failed")
+	}
+	defer response.Body.Close()
+
+	responseBody, readErr := io.ReadAll(io.LimitReader(response.Body, maxResponseBytes+1))
+	if readErr != nil {
+		return nil, errors.New(operationID + " response could not be read")
+	}
+	if len(responseBody) > maxResponseBytes {
+		return nil, protocolErrorFor(operationID, "response body is too large")
+	}
+	if response.StatusCode != expectedStatus {
+		var envelope struct {
+			ErrorCode string `json:"errorCode"`
+			Message   string `json:"message"`
+		}
+		_ = json.Unmarshal(responseBody, &envelope)
+		return nil, &APIError{
+			OperationID: operationID,
+			StatusCode:  response.StatusCode,
+			ErrorCode:   envelope.ErrorCode,
+			Message:     envelope.Message,
+		}
+	}
+	return responseBody, nil
+}
+
+type validatedPage struct {
+	elements      []Domain
+	totalElements int
+	totalPages    int
+}
+
+func (c *Client) validatePage(body []byte, requestedPage int) (validatedPage, error) {
+	var envelope struct {
+		Elements     json.RawMessage `json:"elements"`
+		PageMetadata json.RawMessage `json:"pageMetadata"`
+	}
+	if err := json.Unmarshal(body, &envelope); err != nil {
+		return validatedPage{}, protocolError("page is not a JSON object")
+	}
+	if len(envelope.Elements) == 0 || string(envelope.Elements) == "null" {
+		return validatedPage{}, protocolError("elements is missing or null")
+	}
+	if len(envelope.PageMetadata) == 0 || string(envelope.PageMetadata) == "null" {
+		return validatedPage{}, protocolError("pageMetadata is missing or null")
+	}
+
+	var rawElements []json.RawMessage
+	if err := json.Unmarshal(envelope.Elements, &rawElements); err != nil ||
+		rawElements == nil {
+		return validatedPage{}, protocolError("elements is not an array")
+	}
+	var metadata struct {
+		PageNumber    *int32 `json:"pageNumber"`
+		PageSize      *int32 `json:"pageSize"`
+		TotalElements *int32 `json:"totalElements"`
+		TotalPages    *int32 `json:"totalPages"`
+	}
+	if err := json.Unmarshal(envelope.PageMetadata, &metadata); err != nil ||
+		metadata.PageNumber == nil ||
+		metadata.PageSize == nil ||
+		metadata.TotalElements == nil ||
+		metadata.TotalPages == nil {
+		return validatedPage{}, protocolError("pageMetadata fields are missing or invalid")
+	}
+	if *metadata.PageNumber < 0 ||
+		*metadata.PageSize < 0 ||
+		*metadata.TotalElements < 0 ||
+		*metadata.TotalPages < 0 {
+		return validatedPage{}, protocolError("pageMetadata contains a negative value")
+	}
+	if int(*metadata.PageNumber) != requestedPage {
+		return validatedPage{}, protocolError("returned pageNumber does not match request")
+	}
+	if int(*metadata.PageSize) != len(rawElements) {
+		return validatedPage{}, protocolError("returned pageSize does not match element count")
+	}
+	if len(rawElements) > c.pageSize {
+		return validatedPage{}, protocolError("page exceeds requested pageSize")
+	}
+
+	totalElements := int(*metadata.TotalElements)
+	totalPages := int(*metadata.TotalPages)
+	calculatedPages := 0
+	if totalElements > 0 {
+		calculatedPages = (totalElements + c.pageSize - 1) / c.pageSize
+	}
+	if totalPages != calculatedPages {
+		return validatedPage{}, protocolError("totalPages is inconsistent with totalElements")
+	}
+	if totalPages == 0 {
+		if requestedPage != 0 || len(rawElements) != 0 {
+			return validatedPage{}, protocolError("empty collection metadata is inconsistent")
+		}
+	} else {
+		if requestedPage >= totalPages {
+			return validatedPage{}, protocolError("pageNumber is outside totalPages")
+		}
+		if requestedPage < totalPages-1 && len(rawElements) != c.pageSize {
+			return validatedPage{}, protocolError("non-final page is short or empty")
+		}
+		if requestedPage == totalPages-1 && len(rawElements) == 0 {
+			return validatedPage{}, protocolError("final page is empty")
+		}
+	}
+
+	elements := make([]Domain, len(rawElements))
+	for index, rawElement := range rawElements {
+		var domain map[string]any
+		if err := json.Unmarshal(rawElement, &domain); err != nil || domain == nil {
+			return validatedPage{}, protocolError("elements contains a non-object")
+		}
+		elements[index] = Domain(domain)
+	}
+	return validatedPage{
+		elements:      elements,
+		totalElements: totalElements,
+		totalPages:    totalPages,
+	}, nil
+}
+
+func protocolError(reason string) *ProtocolError {
+	return protocolErrorFor("getDomains", reason)
+}
+
+func protocolErrorFor(operationID, reason string) *ProtocolError {
+	return &ProtocolError{OperationID: operationID, Reason: reason}
 }

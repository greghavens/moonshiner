+func (c *Client) createToken(ctx context.Context) (string, string, error) {
+	body, err := json.Marshal(TokenCreationSpec{
+		Username: c.username,
+		Password: c.password,
+	})
+	if err != nil {
+		return "", "", protocolErrorFor("createToken", "cannot encode token request")
+	}
+	responseBody, err := c.request(
+		ctx,
+		"createToken",
+		http.MethodPost,
+		"/v1/tokens",
+		body,
+		"",
+		http.StatusCreated,
+	)
+	if err != nil {
+		return "", "", err
+	}
+	var pair struct {
+		AccessToken  string `json:"accessToken"`
+		RefreshToken *struct {
+			ID string `json:"id"`
+		} `json:"refreshToken"`
+	}
+	if err := json.Unmarshal(responseBody, &pair); err != nil ||
+		pair.AccessToken == "" ||
+		pair.RefreshToken == nil ||
+		pair.RefreshToken.ID == "" {
+		return "", "", protocolErrorFor("createToken", "invalid token pair")
+	}
+	return pair.AccessToken, pair.RefreshToken.ID, nil
+}
+
+func (c *Client) refreshAccessToken(ctx context.Context, refreshTokenID string) (string, error) {
+	body, err := json.Marshal(refreshTokenID)
+	if err != nil {
+		return "", protocolErrorFor("refreshAccessToken", "cannot encode refresh request")
+	}
+	responseBody, err := c.request(
+		ctx,
+		"refreshAccessToken",
+		http.MethodPatch,
+		"/v1/tokens/access-token/refresh",
+		body,
+		"",
+		http.StatusOK,
+	)
+	if err != nil {
+		return "", err
+	}
+	var accessToken string
+	if err := json.Unmarshal(responseBody, &accessToken); err != nil || accessToken == "" {
+		return "", protocolErrorFor("refreshAccessToken", "invalid access token")
+	}
+	return accessToken, nil
+}
+
+func (c *Client) getDomainsPage(
+	ctx context.Context,
+	pageNumber int,
+	accessToken string,
+) ([]byte, error) {
+	target := fmt.Sprintf(
+		"/v1/domains?pageNumber=%d&pageSize=%d",
+		pageNumber,
+		c.pageSize,
+	)
+	return c.request(
+		ctx,
+		"getDomains",
+		http.MethodGet,
+		target,
+		nil,
+		accessToken,
+		http.StatusOK,
+	)
+}

 // DownloadBundle starts the asynchronous operation and polls it to a terminal
 // status.
 func (c *Client) DownloadBundle(ctx context.Context, bundleID string, spec BundleDownloadSpec) (Task, error) {
-	return Task{}, ErrNotImplemented
+	task, err := c.StartBundleDownload(ctx, bundleID, spec)
+	if err != nil {
+		return Task{}, err
+	}
+
+	for {
+		if err := waitForPoll(ctx, c.pollInterval); err != nil {
+			return task, err
+		}
+		polled, err := c.GetTask(ctx, task.ID)
+		if err != nil {
+			return task, err
+		}
+		task = polled
+		switch canonicalStatus(task.Status) {
+		case "PENDING", "IN_PROGRESS":
+			continue
+		case "SUCCESSFUL", "COMPLETED_WITH_WARNING", "SKIPPED":
+			return task, nil
+		case "FAILED", "CANCELLED":
+			return task, fmt.Errorf("task %q reached terminal status %s", task.ID, task.Status)
+		default:
+			return task, fmt.Errorf("task %q returned unknown status %q", task.ID, task.Status)
+		}
+	}
+}
+
+func (c *Client) executeTaskRequest(request *http.Request, expectedStatus int, operationID string) (Task, error) {
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		return Task{}, fmt.Errorf("%s request: %w", operationID, err)
+	}
+	defer response.Body.Close()
+	if response.StatusCode != expectedStatus {
+		message, _ := io.ReadAll(io.LimitReader(response.Body, 4096))
+		return Task{}, fmt.Errorf("%s returned HTTP %d: %s", operationID, response.StatusCode, strings.TrimSpace(string(message)))
+	}
+	var task Task
+	decoder := json.NewDecoder(response.Body)
+	if err := decoder.Decode(&task); err != nil {
+		return Task{}, fmt.Errorf("decode %s task response: %w", operationID, err)
+	}
+	if err := decoder.Decode(&struct{}{}); err != io.EOF {
+		return Task{}, fmt.Errorf("decode %s task response: trailing JSON data", operationID)
+	}
+	if task.ID == "" || task.Name == "" || task.Status == "" || task.CreationTimestamp == "" {
+		return Task{}, fmt.Errorf("%s returned a task missing required fields", operationID)
+	}
+	return task, nil
+}
+
+func waitForPoll(ctx context.Context, interval time.Duration) error {
+	if interval == 0 {
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		default:
+			return nil
+		}
+	}
+	timer := time.NewTimer(interval)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-timer.C:
+		return nil
+	}
+}
+
+func canonicalStatus(status string) string {
+	return strings.ToUpper(strings.ReplaceAll(strings.TrimSpace(status), " ", "_"))
 }

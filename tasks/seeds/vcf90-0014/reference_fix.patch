+            raise ValueError("token must be a non-empty string")
+        if max_polls < 1:
+            raise ValueError("max_polls must be at least 1")
+        if poll_interval < 0:
+            raise ValueError("poll_interval must not be negative")
+        self.base_url = base_url.rstrip("/")
+        self._token = token
+        self.timeout = timeout
+        self.poll_interval = poll_interval
+        self.max_polls = max_polls
+        self._sleep = sleep if sleep is not None else time.sleep
+
+    # -- contracted operations -------------------------------------------- #
+
+    def validate_host_commission_spec(
+        self, specs: Sequence[HostCommissionSpec]
+    ) -> dict[str, Any]:
+        """POST /v1/hosts/validations — submit the precheck."""
+        return self._request("POST", VALIDATIONS_PATH, body=_wire_array(specs))
+
+    def get_host_commission_validation_by_id(self, validation_id: str) -> dict[str, Any]:
+        """GET /v1/hosts/validations/{id} — read the precheck's current state."""
+        if not isinstance(validation_id, str) or not validation_id.strip():
+            raise ValueError("validation_id must be a non-empty string")
+        return self._request("GET", f"{VALIDATIONS_PATH}/{validation_id}")
+
+    def commission_hosts(self, specs: Sequence[HostCommissionSpec]) -> dict[str, Any]:
+        """POST /v1/hosts — commission the hosts. Mutating; gate it."""
+        return self._request("POST", HOSTS_PATH, body=_wire_array(specs))
+
+    # -- the gate ---------------------------------------------------------- #
+
+    def commission_after_precheck(
+        self, specs: Sequence[HostCommissionSpec]
+    ) -> CommissionOutcome:
+        """Precheck the hosts and commission them only if the precheck passed."""
+        specs = list(specs)
+        if not specs:
+            raise ValueError("at least one HostCommissionSpec is required")
+
+        accepted = self.validate_host_commission_spec(specs)
+        validation_id = accepted.get("id")
+        if not isinstance(validation_id, str) or not validation_id.strip():
+            raise SddcManagerError("the validation submission returned no validation id")
+
+        # The 202 answers before the checks have run, so the statuses it echoes
+        # mean nothing yet. Only a polled state decides whether hosts are touched.
+        validation: dict[str, Any] = {}
+        execution_status = ""
+        poll_count = 0
+        while poll_count < self.max_polls:
+            validation = self.get_host_commission_validation_by_id(validation_id)
+            poll_count += 1
+            execution_status = _normalize(validation.get("executionStatus"))
+            if execution_status in TERMINAL_EXECUTION_STATUSES:
+                break
+            if poll_count < self.max_polls:
+                self._sleep(self.poll_interval)
+        else:
+            raise PrecheckTimeoutError(
+                "host commission validation did not reach a terminal status "
+                f"after {poll_count} polls",
+                validation_id=validation_id,
+                execution_status=execution_status,
+                poll_count=poll_count,
+            )
+
+        raw_result = validation.get("resultStatus")
+        result_status = _normalize(raw_result) if raw_result is not None else None
+        if (
+            execution_status != PASSING_EXECUTION_STATUS
+            or result_status != PASSING_RESULT_STATUS
+        ):
+            failed_checks = [
+                check
+                for check in validation.get("validationChecks") or []
+                if isinstance(check, dict)
+                and _normalize(check.get("resultStatus")) == "FAILED"
+            ]
+            raise PrecheckFailedError(
+                "host commission validation did not pass; "
+                "the precheck gate remained shut and "
+                "no host was commissioned",
+                validation_id=validation_id,
+                execution_status=execution_status,
+                result_status=result_status,
+                failed_checks=failed_checks,
+            )
+
+        task = self.commission_hosts(specs)
+        task_id = task.get("id")
+        return CommissionOutcome(
+            validation_id=validation_id,
+            execution_status=execution_status,
+            result_status=result_status,
+            poll_count=poll_count,
+            task_id=task_id if isinstance(task_id, str) else None,
+            commissioned=True,
+        )

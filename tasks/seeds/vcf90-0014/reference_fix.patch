+def _wire_array(specs: Sequence[HostCommissionSpec]) -> list[dict[str, str]]:
+    rendered = []
+    for spec in specs:
+        if not isinstance(spec, HostCommissionSpec):
+            raise TypeError("every element must be a HostCommissionSpec")
+        rendered.append(spec.to_wire())
+    if not rendered:
+        raise ValueError("at least one HostCommissionSpec is required")
+    return rendered
+
+
+def _http_error(method: str, path: str, error: urllib.error.HTTPError) -> SddcManagerError:
+    """Turn an HTTP failure into an SddcManagerError, never echoing credentials."""
+    return SddcManagerError(f"SDDC Manager request failed with HTTP {error.code}")

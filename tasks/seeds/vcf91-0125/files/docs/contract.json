{
  "contractFormat": "vcf-spec-subset-1",
  "openapi": "3.0.3",
  "title": "vSphere Automation API",
  "apiVersion": "9.1.0.0",
  "derivedFrom": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repositoryCommitSha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "specPath": "specifications/vsphere/openapi/automation/vcenter.yaml",
    "specBlobSha": "8028b0824c4ff3503d05f44814f967938a795c40",
    "license": "Apache-2.0"
  },
  "server": {
    "urlTemplate": "https://{host}/api",
    "basePath": "/api"
  },
  "operationIds": [
    "Cis.Session_create",
    "Vcenter.Cluster_list",
    "Cis.Session_delete"
  ],
  "operations": [
    {
      "operationId": "Cis.Session_create",
      "method": "POST",
      "path": "/session",
      "security": {
        "scheme": "basic_auth",
        "type": "http",
        "httpScheme": "basic"
      },
      "requestBody": {
        "present": false
      },
      "responses": {
        "201": {
          "description": "Newly created session token to be used for authenticating further requests.",
          "contentType": "application/json",
          "schema": {
            "type": "string",
            "format": "password"
          }
        }
      }
    },
    {
      "operationId": "Vcenter.Cluster_list",
      "method": "GET",
      "path": "/vcenter/cluster",
      "security": {
        "scheme": "api_key_auth",
        "type": "apiKey",
        "in": "header",
        "name": "vmware-api-session-id"
      },
      "parameters": [
        {
          "name": "clusters",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "names",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "folders",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "datacenters",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Commonly used information about matching clusters.",
          "contentType": "application/json",
          "schema": {
            "type": "array",
            "itemsRef": "#/schemas/Vcenter.Cluster.Summary"
          }
        }
      }
    },
    {
      "operationId": "Cis.Session_delete",
      "method": "DELETE",
      "path": "/session",
      "security": {
        "scheme": "api_key_auth",
        "type": "apiKey",
        "in": "header",
        "name": "vmware-api-session-id"
      },
      "requestBody": {
        "present": false
      },
      "responses": {
        "204": {
          "description": "Success!",
          "content": null
        }
      }
    }
  ],
  "schemas": {
    "Vcenter.Cluster.FilterSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "clusters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "unsetWireBehavior": "omit query member"
        },
        "names": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "unsetWireBehavior": "omit query member"
        },
        "folders": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "unsetWireBehavior": "omit query member"
        },
        "datacenters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "unsetWireBehavior": "omit query member"
        }
      }
    },
    "Vcenter.Cluster.Summary": {
      "type": "object",
      "required": [
        "cluster",
        "drs_enabled",
        "ha_enabled",
        "name"
      ],
      "properties": {
        "cluster": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "ha_enabled": {
          "type": "boolean"
        },
        "drs_enabled": {
          "type": "boolean"
        }
      }
    }
  },
  "securitySchemes": {
    "basic_auth": {
      "type": "http",
      "scheme": "basic"
    },
    "api_key_auth": {
      "type": "apiKey",
      "name": "vmware-api-session-id",
      "in": "header"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/vcf-migration-plan.schema.json",
  "title": "VCF 9 ordered migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "estateId",
    "targetRelease",
    "steps"
  ],
  "properties": {
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetRelease": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "componentId",
          "component",
          "fromVersion",
          "target",
          "gates"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "fromVersion": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component",
              "version"
            ],
            "properties": {
              "component": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "condition"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "condition": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}

+"""Build the greenfield VCF Installer SddcSpec."""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+def _network_spec(network: dict[str, Any]) -> dict[str, Any]:
+    return {
+        "networkType": network["networkType"],
+        "subnet": network["subnet"],
+        "gateway": network["gateway"],
+        "vlanId": network["vlanId"],
+        "mtu": network["mtu"],
+        "includeIpAddressRanges": [
+            {
+                "startIpAddress": network["startIpAddress"],
+                "endIpAddress": network["endIpAddress"],
+            }
+        ],
+    }
+
+
+def build_sddc_spec(requirements: dict[str, Any], snapshot: dict[str, Any]) -> dict[str, Any]:
+    """Return an SddcSpec for the requested consolidated greenfield design."""
+    authority = snapshot["greenfield"]
+    deployment = requirements["deployment"]
+    supported_shape = {
+        "siteCount": authority["siteCount"],
+        "availabilityZones": authority["availabilityZones"],
+        "topology": authority["topology"],
+        "hostCount": authority["minimumHostCount"],
+    }
+    for key, expected in supported_shape.items():
+        if deployment[key] != expected:
+            raise ValueError(f"unsupported {key}: expected {expected!r}")
+    if len(requirements["hosts"]) != authority["minimumHostCount"]:
+        raise ValueError("host inventory does not match the supported minimum")
+
+    names = requirements["names"]
+    passwords = requirements["passwordPlaceholders"]
+    overlay = requirements["nsxHostOverlay"]
+    versions = authority["componentVersions"]
+    network_types = authority["requiredNetworkTypes"]
+
+    return {
+        "sddcId": names["sddcId"],
+        "vcfInstanceName": names["vcfInstanceName"],
+        "workflowType": authority["workflowType"],
+        "version": versions["sddcSpec"],
+        "hostSpecs": [{"hostname": host["hostname"]} for host in requirements["hosts"]],
+        "vcenterSpec": {
+            "vcenterHostname": names["vcenter"],
+            "rootVcenterPassword": passwords["vcenterRoot"],
+            "vmSize": "medium",
+            "storageSize": "lstorage",
+            "ssoDomain": "vsphere.local",
+            "useExistingDeployment": False,
+            "version": versions["vcenter"],
+        },
+        "clusterSpec": {
+            "datacenterName": names["datacenter"],
+            "clusterName": names["cluster"],
+            "resourcePoolSpecs": [
+                {"name": "chi01-management", "type": "management"},
+                {"name": "chi01-network", "type": "network"},
+                {"name": "chi01-compute", "type": "compute"},
+            ],
+        },
+        "dvsSpecs": [
+            {
+                "dvsName": names["distributedSwitch"],
+                "networks": network_types,
+                "mtu": 9000,
+                "vmnicsToUplinks": [
+                    {"id": "vmnic0", "uplink": "uplink1"},
+                    {"id": "vmnic1", "uplink": "uplink2"},
+                ],
+                "nsxtSwitchConfig": {
+                    "transportZones": [
+                        {"name": "chi01-overlay-tz", "transportType": "OVERLAY"},
+                        {"name": "chi01-vlan-tz", "transportType": "VLAN"},
+                    ],
+                    "hostSwitchOperationalMode": "STANDARD",
+                    "ipAssignmentType": "IP_POOL",
+                },
+            }
+        ],
+        "nsxtSpec": {
+            "nsxtManagers": [{"hostname": hostname} for hostname in names["nsxManagers"]],
+            "nsxtManagerSize": "medium",
+            "vipFqdn": names["nsxVip"],
+            "rootNsxtManagerPassword": passwords["nsxRoot"],
+            "nsxtAdminPassword": passwords["nsxAdmin"],
+            "nsxtAuditPassword": passwords["nsxAudit"],
+            "transportVlanId": overlay["vlanId"],
+            "ipAddressPoolSpec": {
+                "name": overlay["name"],
+                "description": "Single-site management-domain host overlay",
+                "subnets": [
+                    {
+                        "cidr": overlay["cidr"],
+                        "gateway": overlay["gateway"],
+                        "ipAddressPoolRanges": [{"start": overlay["start"], "end": overlay["end"]}],
+                    }
+                ],
+            },
+            "useExistingDeployment": False,
+            "version": versions["nsx"],
+        },
+        "networkSpecs": [_network_spec(network) for network in requirements["networks"]],
+        "dnsSpec": requirements["dns"],
+        "ntpServers": requirements["ntpServers"],
+        "sddcManagerSpec": {
+            "hostname": names["sddcManager"],
+            "rootPassword": passwords["sddcManagerRoot"],
+            "sshPassword": passwords["sddcManagerSsh"],
+            "localUserPassword": passwords["sddcLocalAdmin"],
+            "useExistingDeployment": False,
+            "version": versions["sddcSpec"],
+        },
+        "managementPoolName": "chi01-management-network-pool",
+        "ceipEnabled": False,
+        "skipEsxThumbprintValidation": False,
+        "skipGatewayPingValidation": False,
+        "securitySpec": {"esxiCertsMode": "VMCA"},
+        "datastoreSpec": {
+            "vsanSpec": {
+                "datastoreName": names["vsanDatastore"],
+                "vsanDedup": False,
+                "esaConfig": {"enabled": True},
+                "failuresToTolerate": authority["storage"]["failuresToTolerate"],
+            }
+        },
+        "vcfOperationsFleetManagementSpec": {
+            "hostname": names["fleetManager"],
+            "rootUserPassword": passwords["fleetRoot"],
+            "adminUserPassword": passwords["fleetAdmin"],
+            "useExistingDeployment": False,
+            "version": versions["fleetManagement"],
+        },
+        "vcfOperationsSpec": {
+            "nodes": [
+                {"hostname": names["operationsNodes"][0], "type": "master"},
+                {"hostname": names["operationsNodes"][1], "type": "replica"},
+                {"hostname": names["operationsNodes"][2], "type": "data"},
+            ],
+            "adminUserPassword": passwords["operationsAdmin"],
+            "applianceSize": "medium",
+            "loadBalancerFqdn": names["operationsLoadBalancer"],
+            "useExistingDeployment": False,
+            "version": versions["vcfOperations"],
+        },
+    }

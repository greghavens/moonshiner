@@ -0,0 +1,38 @@
+"""Build an ordered existing-estate migration plan."""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+def build_migration_plan(inventory: dict[str, Any], snapshot: dict[str, Any]) -> dict[str, Any]:
+    """Map every inventory component to the pinned target and technical gates."""
+    authority = snapshot["migration"]
+    if inventory["estateId"] != authority["estateId"]:
+        raise ValueError("inventory does not match the compatibility snapshot")
+    components = {item["id"]: item for item in inventory["components"]}
+    expected_ids = [item["componentId"] for item in authority["steps"]]
+    if len(components) != len(inventory["components"]) or set(components) != set(expected_ids):
+        raise ValueError("inventory and pinned migration components differ")
+
+    steps = []
+    for order, target in enumerate(authority["steps"], start=1):
+        current = components[target["componentId"]]
+        steps.append(
+            {
+                "order": order,
+                "componentId": current["id"],
+                "component": current["component"],
+                "fromVersion": current["version"],
+                "target": {
+                    "component": target["targetComponent"],
+                    "version": target["targetVersion"],
+                },
+                "gates": target["gates"],
+            }
+        )
+    return {
+        "estateId": inventory["estateId"],
+        "targetRelease": authority["targetRelease"],
+        "steps": steps,
+    }

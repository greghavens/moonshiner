{
  "title": "VCF Operations for Logs",
  "version": "v2",
  "server_base_path": "/api/v2",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "commit_sha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "spec_path": "specifications/vcf-operations/vcf-operations-for-logs-openapi.json"
  },
  "operations": [
    {
      "operationId": "PUT_log-forwarder-id",
      "method": "PUT",
      "path": "/log-forwarder/{id}",
      "description": "Updates the settings of a log forwarding destination.",
      "security": "Bearer",
      "path_parameters": [
        {
          "name": "id",
          "type": "string",
          "required": true
        }
      ],
      "request_body": {
        "required": false,
        "content_type": "application/json",
        "schema_name": "forwarders.put.request",
        "schema": {
          "type": "object",
          "required": [
            "host",
            "port",
            "protocol",
            "sslEnabled"
          ],
          "properties": {
            "acceptCert": {
              "type": "boolean",
              "default": false
            },
            "name": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "protocol": {
              "type": "string",
              "enum": [
                "SYSLOG",
                "CFAPI",
                "RAW",
                "RAWPlus"
              ]
            },
            "sslEnabled": {
              "type": "boolean"
            },
            "workerCount": {
              "type": "integer",
              "default": 4
            },
            "diskCacheSize": {
              "type": "integer",
              "default": 1000000000
            },
            "tags": {
              "type": "object",
              "default": {}
            },
            "filter": {
              "type": "string",
              "default": ""
            },
            "transportProtocol": {
              "type": "string",
              "enum": [
                "TCP",
                "UDP",
                "TCP_OCTET"
              ]
            },
            "forwardComplementaryFields": {
              "type": "boolean",
              "default": false
            },
            "testConnection": {
              "type": "boolean",
              "default": false
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Successfully updated log forwarder configuration",
          "content_type": "application/json",
          "schema_name": "forwarders.get.response"
        },
        "400": {
          "description": "The request body is invalid or does not match the required JSON format."
        },
        "401": {
          "description": "The request is not authenticated."
        },
        "404": {
          "description": "No such forwarder to edit"
        },
        "440": {
          "description": "The authenticated session has expired."
        },
        "495": {
          "description": "SSL connection failed."
        },
        "500": {
          "description": "Internal error while processing the client request"
        }
      }
    }
  ]
}

 package vcflogs
 
 import (
+	"bytes"
 	"context"
+	"encoding/json"
 	"errors"
+	"fmt"
+	"io"
 	"net/http"
+	"net/url"
+	"strings"
 )
 
 // ForwarderUpdate is the request body for PUT_log-forwarder-id.
@@ -50,10 +56,51 @@ type Client struct {
 }
 
 func NewClient(baseURL, bearerToken string, httpClient *http.Client) *Client {
+	if httpClient == nil {
+		httpClient = http.DefaultClient
+	}
 	return &Client{baseURL: baseURL, bearerToken: bearerToken, httpClient: httpClient}
 }
 
 // UpdateForwarder updates a log-forwarding destination.
 func (c *Client) UpdateForwarder(ctx context.Context, id string, update ForwarderUpdate) (Forwarder, error) {
-	return Forwarder{}, errors.New("UpdateForwarder is not implemented")
+	if c == nil {
+		return Forwarder{}, errors.New("nil client")
+	}
+
+	body, err := json.Marshal(update)
+	if err != nil {
+		return Forwarder{}, fmt.Errorf("encode log forwarder update: %w", err)
+	}
+	endpoint := strings.TrimRight(c.baseURL, "/") + "/api/v2/log-forwarder/" + url.PathEscape(id)
+
+	request, err := http.NewRequestWithContext(ctx, http.MethodPut, endpoint, bytes.NewReader(body))
+	if err != nil {
+		return Forwarder{}, fmt.Errorf("build log forwarder update request: %w", err)
+	}
+	request.Header.Set("Accept", "application/json")
+	request.Header.Set("Content-Type", "application/json")
+	request.Header.Set("Authorization", "Bearer "+c.bearerToken)
+
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		return Forwarder{}, fmt.Errorf("update log forwarder: %w", err)
+	}
+	responseBody, readErr := io.ReadAll(response.Body)
+	closeErr := response.Body.Close()
+	if readErr != nil {
+		return Forwarder{}, fmt.Errorf("read log forwarder response: %w", readErr)
+	}
+	if closeErr != nil {
+		return Forwarder{}, fmt.Errorf("close log forwarder response: %w", closeErr)
+	}
+	if response.StatusCode != http.StatusOK {
+		return Forwarder{}, fmt.Errorf("update log forwarder: HTTP %d: %s", response.StatusCode, strings.TrimSpace(string(responseBody)))
+	}
+
+	var forwarder Forwarder
+	if err := json.Unmarshal(responseBody, &forwarder); err != nil {
+		return Forwarder{}, fmt.Errorf("decode log forwarder response: %w", err)
+	}
+	return forwarder, nil
 }

+		method:   operation.Method,
+		prefix:   prefix,
+		required: append([]string(nil), operation.RequestBody.Schema.Required...),
+		state:    make(map[string]vcflogs.ForwarderUpdate),
+	}
+	result.client = &http.Client{Transport: roundTripper(result.roundTrip)}
+	return result, nil
+}

+func forwarderResponse(id string, update vcflogs.ForwarderUpdate) vcflogs.Forwarder {
+	name := "forwarder-" + id
+	if update.Name != nil {
+		name = *update.Name
+	}
+	workerCount := 4
+	if update.WorkerCount != nil {
+		workerCount = *update.WorkerCount
+	}
+	diskCacheSize := 1000000000
+	if update.DiskCacheSize != nil {
+		diskCacheSize = *update.DiskCacheSize
+	}
+	filter := ""
+	if update.Filter != nil {
+		filter = *update.Filter
+	}
+	forwardComplementaryFields := false
+	if update.ForwardComplementaryFields != nil {
+		forwardComplementaryFields = *update.ForwardComplementaryFields
+	}
+	transportProtocol := ""
+	if update.TransportProtocol != nil {
+		transportProtocol = *update.TransportProtocol
+	}
+	tags := update.Tags
+	if tags == nil {
+		tags = map[string]string{}
+	}
+	return vcflogs.Forwarder{
+		Name:                       name,
+		Host:                       update.Host,
+		Port:                       update.Port,
+		Protocol:                   update.Protocol,
+		SSLEnabled:                 update.SSLEnabled,
+		WorkerCount:                workerCount,
+		DiskCacheSize:              diskCacheSize,
+		Tags:                       tags,
+		Filter:                     filter,
+		TransportProtocol:          transportProtocol,
+		ForwardComplementaryFields: forwardComplementaryFields,
+		ID:                         id,
+	}

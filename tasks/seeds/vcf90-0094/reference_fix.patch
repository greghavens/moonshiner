 func New() (*Server, error) {
-	return nil, errors.New("mock server is not implemented")
+	var contract contractDocument
+	if err := json.Unmarshal(vcflogs.ContractJSON, &contract); err != nil {
+		return nil, fmt.Errorf("decode VCF Operations for Logs contract: %w", err)
+	}
+	if len(contract.Operations) != 1 {
+		return nil, fmt.Errorf("contract names %d operations, want 1", len(contract.Operations))
+	}
+	operation := contract.Operations[0]
+	if operation.OperationID != "PUT_log-forwarder-id" || operation.Method != http.MethodPut || operation.Path != "/log-forwarder/{id}" {
+		return nil, errors.New("contract does not contain the expected PUT_log-forwarder-id operation")
+	}
+	if operation.RequestBody.ContentType != "application/json" {
+		return nil, errors.New("contract request content type is not application/json")
+	}
+	if contract.ServerBasePath != "/api/v2" {
+		return nil, errors.New("contract server base path is not /api/v2")
+	}
+	wantRequired := []string{"host", "port", "protocol", "sslEnabled"}
+	if !reflect.DeepEqual(operation.RequestBody.Schema.Required, wantRequired) {
+		return nil, errors.New("contract has unexpected required request fields")
+	}
+	wantProperties := []string{
+		"acceptCert", "name", "host", "port", "protocol", "sslEnabled",
+		"workerCount", "diskCacheSize", "tags", "filter", "transportProtocol",
+		"forwardComplementaryFields", "testConnection",
+	}
+	if len(operation.RequestBody.Schema.Properties) != len(wantProperties) {
+		return nil, errors.New("contract has unexpected request properties")
+	}
+	for _, name := range wantProperties {
+		if _, present := operation.RequestBody.Schema.Properties[name]; !present {
+			return nil, fmt.Errorf("contract is missing request property %q", name)
+		}

  "operations": [
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "summary": "Get a Task",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "string",
          "description": "Task id"
        }
      ],
      "requestBody": null,
      "focusedWireProfile": {
        "readMembers": [
          "id",
          "name",
          "type",
          "status",
          "creationTimestamp",
          "completionTimestamp",
          "subTasks",
          "errors",
          "resources"
        ],
        "notes": "The task's own resource list names every resource the operation was submitted for, whatever became of each one. A failing sub-task carries its own resource list, and a sub-task may carry child sub-tasks."
      },
      "responses": {
        "200": {
          "description": "The requested task",
          "contentType": "application/json",
          "schema": "Task"
        },
        "404": {
          "description": "Task not found",
          "contentType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "Unexpected error",
          "contentType": "application/json",
          "schema": "Error"
        }
      }
    },
    {
      "operationId": "getNotifications",
      "method": "GET",
      "path": "/v1/notifications",
      "summary": "Get all Notifications",
      "parameters": [],
      "requestBody": null,
      "focusedWireProfile": {
        "readMembers": [
          "type",
          "severity",
          "message",
          "creationTimestamp",
          "expirationTimestamp",
          "resources",
          "domain"
        ],
        "notes": "This operation takes no parameters and no query string: it returns every notification, and correlation to a task is the caller's work. A notification is the only place in this contract that ties a resource to the domain and clusters it belongs to."
      },
      "responses": {
        "200": {
          "description": "The notifications",
          "contentType": "application/json",
          "schema": "Notification",
          "isArray": true
        },
        "500": {
          "description": "Unexpected error",
          "contentType": "application/json",
          "schema": "Error"
        }
      }
    },
    {
      "operationId": "startSupportBundle",
      "method": "POST",
      "path": "/v1/system/support-bundles",
      "summary": "Start a Support Bundle operation using SoS",
      "parameters": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "SupportBundleSpec",
        "isArray": false
      },
      "focusedWireProfile": {
        "conditionalSupportBundleSpecMembers": [
          "options",
          "scope",
          "logs"
        ],
        "conditionalSupportBundleOptionMembers": [
          "config",
          "include"
        ],
        "conditionalSupportBundleScopeMembers": [
          "includeFreeHosts"
        ],
        "boundSupportBundleScopeMembers": [
          "domains"
        ],
        "boundDomainsMembers": [
          "domainName"
        ],
        "conditionalDomainsMembers": [
          "clusterNames"
        ],
        "unsetMembers": [
          "SupportBundleConfig.skipKnownHostCheck",
          "SupportBundleIncludeItems.summaryReport"
        ],
        "membersOutsideThisContract": [
          "Logs.hcxLogs",
          "Logs.vmsLogs"
        ],
        "unsetBehavior": "omit",
        "notes": "Every member of this request tree is optional in the specification and every leaf of it is a boolean or a string. A member that is not set is absent from the body: not null, not false, not an empty string, not an empty array and not an empty object. Logs members carrying HCX and VM support logs were introduced after this API version; on this contract the Logs object carries the sixteen members listed under the Logs schema and nothing else."
      },
      "responses": {
        "202": {
          "description": "Accepted; the support bundle operation was started",
          "contentType": "application/json",
          "schema": "SupportBundle"
        },
        "400": {
          "description": "Bad request",
          "contentType": "application/json",
          "schema": "Error"
        },
        "409": {
          "description": "Conflict",
          "contentType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "Unexpected error",
          "contentType": "application/json",
          "schema": "Error"
        }
      }
    },
    {
      "operationId": "getSupportBundleStatus",
      "method": "GET",
      "path": "/v1/system/support-bundles/{id}",
      "summary": "Retrive the status of the Support Bundle operation",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "string",
          "description": "The Support Bundle ID"
        }
      ],
      "requestBody": null,
      "focusedWireProfile": {
        "readMembers": [
          "id",
          "status",
          "bundleName",
          "bundleAvailable",
          "creationTimestamp",
          "completionTimestamp",
          "description"
        ],
        "nonTerminalStatuses": [
          "PENDING",
          "IN_PROGRESS"
        ],
        "terminalStatuses": [
          "COMPLETED_WITH_SUCCESS",
          "COMPLETED_WITH_FAILURE"
        ],
        "notes": "The 202 that starts the collection is an acceptance, not an outcome; the outcome is the status this operation reports."
      },
      "responses": {
        "200": {
          "description": "The support bundle operation status",
          "contentType": "application/json",
          "schema": "SupportBundle"
        },
        "400": {
          "description": "Bad request",
          "contentType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "Unexpected error",
          "contentType": "application/json",
          "schema": "Error"
        }
      }
    }
  ],

index 0000000..f01ce8b
--- /dev/null
+++ b/src/VcfLifecycleConnectivity.psm1
@@ -0,0 +1,228 @@
+Set-StrictMode -Version Latest
+
+function New-VcfLifecycleStepReport {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $Name,
+
+        [Parameter(Mandatory)]
+        [string] $OperationId,
+
+        [Parameter(Mandatory)]
+        [ValidateSet('Succeeded', 'Failed', 'NotRun')]
+        [string] $Status,
+
+        [AllowNull()]
+        [object] $TaskId,
+
+        [AllowNull()]
+        [object] $TaskStatus,
+
+        [AllowNull()]
+        [object] $ErrorCode,
+
+        [AllowNull()]
+        [object] $ErrorMessage
+    )
+
+    [pscustomobject][ordered]@{
+        Name         = $Name
+        OperationId  = $OperationId
+        Status       = $Status
+        TaskId       = $TaskId
+        TaskStatus   = $TaskStatus
+        ErrorCode    = $ErrorCode
+        ErrorMessage = $ErrorMessage
+    }
+}
+
+function Get-VcfLifecycleError {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [System.Management.Automation.ErrorRecord] $ErrorRecord
+    )
+
+    $texts = [System.Collections.Generic.List[string]]::new()
+    if ($null -ne $ErrorRecord.ErrorDetails -and
+        -not [string]::IsNullOrWhiteSpace($ErrorRecord.ErrorDetails.Message)) {
+        $texts.Add($ErrorRecord.ErrorDetails.Message)
+    }
+    if (-not [string]::IsNullOrWhiteSpace($ErrorRecord.Exception.Message)) {
+        $texts.Add($ErrorRecord.Exception.Message)
+    }
+    $texts.Add(($ErrorRecord | Out-String))
+
+    $code = $null
+    $message = $null
+    foreach ($text in $texts) {
+        try {
+            $payload = $text | ConvertFrom-Json -ErrorAction Stop
+            if ($payload.PSObject.Properties.Name -contains 'errorCode') {
+                $code = [string]$payload.errorCode
+            }
+            if ($payload.PSObject.Properties.Name -contains 'message') {
+                $message = [string]$payload.message
+            }
+            if ($null -ne $code -or $null -ne $message) {
+                break
+            }
+        }
+        catch {
+            # Some PowerCLI versions prefix the JSON with the HTTP status.
+        }
+    }
+
+    $combined = $texts -join "`n"
+    if ([string]::IsNullOrWhiteSpace($code) -and
+        $combined -match '"errorCode"\s*:\s*"(?<code>[^"]+)"') {
+        $code = $Matches.code
+    }
+    if ([string]::IsNullOrWhiteSpace($message) -and
+        $combined -match '"message"\s*:\s*"(?<message>[^"]+)"') {
+        $message = $Matches.message
+    }
+    if ([string]::IsNullOrWhiteSpace($message)) {
+        $message = $ErrorRecord.Exception.Message
+    }
+
+    [pscustomobject]@{
+        ErrorCode    = $code
+        ErrorMessage = $message
+    }
+}
+
+function Invoke-VcfLifecycleConnectivityChange {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [object] $Server,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $ProxyHost,
+
+        [Parameter(Mandatory)]
+        [ValidateRange(1, 65535)]
+        [int] $ProxyPort,
+
+        [Parameter(Mandatory)]
+        [ValidateSet('HTTP', 'HTTPS')]
+        [string] $ProxyProtocol,
+
+        [Parameter(Mandatory)]
+        [ValidateLength(1, 32)]
+        [string] $DepotDownloadToken
+    )
+
+    $steps = [System.Collections.Generic.List[object]]::new()
+    $proxyTaskId = $null
+
+    try {
+        # Passing only these four initializer parameters is deliberate. The SDK
+        # serializer consequently omits every other optional OpenAPI property.
+        $proxySpec = Initialize-VcfProxyConfiguration `
+            -IsEnabled $true `
+            -VarHost $ProxyHost `
+            -Port $ProxyPort `
+            -TransferProtocol $ProxyProtocol
+
+        $proxyTask = Invoke-VcfUpdateProxyConfiguration `
+            -ProxyConfiguration $proxySpec `
+            -Server $Server `
+            -ErrorAction Stop
+        $proxyTaskId = [string]$proxyTask.Id
+        if ([string]::IsNullOrWhiteSpace($proxyTaskId)) {
+            throw 'updateProxyConfiguration did not return a task ID.'
+        }
+
+        $observedTask = Invoke-VcfGetTask `
+            -Id $proxyTaskId `
+            -Server $Server `
+            -ErrorAction Stop
+        $observedStatus = [string]$observedTask.Status
+        if ($observedStatus -ne 'SUCCESSFUL') {
+            $steps.Add((New-VcfLifecycleStepReport `
+                -Name 'Proxy' `
+                -OperationId 'updateProxyConfiguration' `
+                -Status 'Failed' `
+                -TaskId $proxyTaskId `
+                -TaskStatus $observedStatus `
+                -ErrorCode 'PROXY_TASK_NOT_SUCCESSFUL' `
+                -ErrorMessage "Proxy task completed with status $observedStatus."))
+            $steps.Add((New-VcfLifecycleStepReport `
+                -Name 'Depot' `
+                -OperationId 'updateDepotSettings' `
+                -Status 'NotRun' `
+                -TaskId $null `
+                -TaskStatus $null `
+                -ErrorCode $null `
+                -ErrorMessage $null))
+            return [pscustomobject][ordered]@{ Outcome = 'Failed'; Steps = @($steps) }
+        }
+
+        $steps.Add((New-VcfLifecycleStepReport `
+            -Name 'Proxy' `
+            -OperationId 'updateProxyConfiguration' `
+            -Status 'Succeeded' `
+            -TaskId $proxyTaskId `
+            -TaskStatus $observedStatus `
+            -ErrorCode $null `
+            -ErrorMessage $null))
+    }
+    catch {
+        $failure = Get-VcfLifecycleError -ErrorRecord $_
+        $steps.Add((New-VcfLifecycleStepReport `
+            -Name 'Proxy' `
+            -OperationId 'updateProxyConfiguration' `
+            -Status 'Failed' `
+            -TaskId $proxyTaskId `
+            -TaskStatus $null `
+            -ErrorCode $failure.ErrorCode `
+            -ErrorMessage $failure.ErrorMessage))
+        $steps.Add((New-VcfLifecycleStepReport `
+            -Name 'Depot' `
+            -OperationId 'updateDepotSettings' `
+            -Status 'NotRun' `
+            -TaskId $null `
+            -TaskStatus $null `
+            -ErrorCode $null `
+            -ErrorMessage $null))
+        return [pscustomobject][ordered]@{ Outcome = 'Failed'; Steps = @($steps) }
+    }
+
+    try {
+        # A token-authenticated online account needs no other DepotAccount or
+        # DepotSettings fields. Do not manufacture empty placeholders.
+        $depotAccount = Initialize-VcfDepotAccount -DownloadToken $DepotDownloadToken
+        $depotSettings = Initialize-VcfDepotSettings -VmwareAccount $depotAccount
+        $null = Invoke-VcfUpdateDepotSettings `
+            -DepotSettings $depotSettings `
+            -Server $Server `
+            -ErrorAction Stop
+        $steps.Add((New-VcfLifecycleStepReport `
+            -Name 'Depot' `
+            -OperationId 'updateDepotSettings' `
+            -Status 'Succeeded' `
+            -TaskId $null `
+            -TaskStatus $null `
+            -ErrorCode $null `
+            -ErrorMessage $null))
+        [pscustomobject][ordered]@{ Outcome = 'Succeeded'; Steps = @($steps) }
+    }
+    catch {
+        $failure = Get-VcfLifecycleError -ErrorRecord $_
+        $steps.Add((New-VcfLifecycleStepReport `
+            -Name 'Depot' `
+            -OperationId 'updateDepotSettings' `
+            -Status 'Failed' `
+            -TaskId $null `
+            -TaskStatus $null `
+            -ErrorCode $failure.ErrorCode `
+            -ErrorMessage $failure.ErrorMessage))
+        [pscustomobject][ordered]@{ Outcome = 'PartialFailure'; Steps = @($steps) }
+    }
+}
+
+Export-ModuleMember -Function Invoke-VcfLifecycleConnectivityChange

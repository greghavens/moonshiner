{
  "openapi": "3.0.1",
  "info": {
    "title": "Focused VCF 9.1 SDDC Manager lifecycle-connectivity contract",
    "version": "9.1.0.0"
  },
  "derivedFrom": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "rawUrl": "https://raw.githubusercontent.com/vmware/vcf-api-specs/c3f3b52c845dd967cabbc21680e893292077d5ba/specifications/sddc-manager/sddc-manager-openapi.json",
    "license": "Apache-2.0"
  },
  "operations": [
    {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "specPointer": "#/paths/~1v1~1tokens/post",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "TokenCreationSpec"
      },
      "responses": {
        "201": "TokenPair",
        "400": "Error",
        "500": "Error"
      }
    },
    {
      "operationId": "updateProxyConfiguration",
      "method": "PATCH",
      "path": "/v1/system/proxy-configuration",
      "specPointer": "#/paths/~1v1~1system~1proxy-configuration/patch",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "ProxyConfiguration"
      },
      "responses": {
        "202": "Task",
        "400": "Error",
        "500": null
      }
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "specPointer": "#/paths/~1v1~1tasks~1{id}/get",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": "Task",
        "404": "Error",
        "500": "Error"
      }
    },
    {
      "operationId": "updateDepotSettings",
      "method": "PUT",
      "path": "/v1/system/settings/depot",
      "specPointer": "#/paths/~1v1~1system~1settings~1depot/put",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "DepotSettings"
      },
      "responses": {
        "202": "DepotSettings",
        "400": "Error",
        "500": "Error"
      }
    }
  ],
  "schemas": {
    "TokenCreationSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" },
        "apiKey": { "type": "string" },
        "idToken": { "type": "string" }
      }
    },
    "RefreshToken": {
      "type": "object",
      "required": [],
      "properties": {
        "id": { "type": "string" }
      }
    },
    "TokenPair": {
      "type": "object",
      "required": [],
      "properties": {
        "accessToken": { "type": "string" },
        "refreshToken": { "$ref": "RefreshToken" }
      }
    },
    "ProxyConfiguration": {
      "type": "object",
      "required": [],
      "properties": {
        "isConfigured": { "type": "boolean", "readOnly": true },
        "isEnabled": { "type": "boolean" },
        "host": { "type": "string" },
        "port": { "type": "integer", "format": "int32" },
        "transferProtocol": {
          "type": "string",
          "enum": ["HTTP", "HTTPS"]
        },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "isAuthenticated": { "type": "boolean" }
      }
    },
    "DepotAccount": {
      "type": "object",
      "required": [],
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" },
        "status": { "type": "string" },
        "message": { "type": "string" },
        "downloadToken": { "type": "string", "maxLength": 32 },
        "downloadActivationCode": { "type": "string" }
      }
    },
    "DepotConfiguration": {
      "type": "object",
      "required": ["isOfflineDepot"],
      "properties": {
        "isOfflineDepot": { "type": "boolean" },
        "hostname": { "type": "string" },
        "port": { "type": "integer", "format": "int32" },
        "url": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2048,
          "pattern": "^(https?://[^\\s]+)$"
        }
      }
    },
    "DepotSettings": {
      "type": "object",
      "required": [],
      "properties": {
        "vmwareAccount": { "$ref": "DepotAccount" },
        "offlineAccount": { "$ref": "DepotAccount" },
        "depotConfiguration": { "$ref": "DepotConfiguration" }
      }
    },
    "Task": {
      "type": "object",
      "required": ["creationTimestamp", "id", "name", "status"],
      "properties": {
        "id": { "type": "string", "readOnly": true },
        "name": { "type": "string", "readOnly": true },
        "localizableDescriptionPack": { "type": "object", "readOnly": true },
        "type": { "type": "string", "readOnly": true },
        "status": { "type": "string", "readOnly": true },
        "creationTimestamp": { "type": "string", "readOnly": true },
        "completionTimestamp": { "type": "string", "readOnly": true },
        "subTasks": { "type": "array", "readOnly": true },
        "errors": { "type": "array", "readOnly": true },
        "resources": { "type": "array", "readOnly": true },
        "resolutionStatus": { "type": "string", "readOnly": true },
        "isCancellable": { "type": "boolean", "readOnly": true },
        "isRetryable": { "type": "boolean", "readOnly": true }
      }
    },
    "Error": {
      "type": "object",
      "required": [],
      "properties": {
        "errorCode": { "type": "string", "readOnly": true },
        "errorType": { "type": "string", "readOnly": true },
        "arguments": { "type": "array", "readOnly": true },
        "context": { "type": "object", "readOnly": true },
        "notifications": { "type": "array", "readOnly": true },
        "message": { "type": "string", "readOnly": true },
        "remediationMessage": { "type": "string" },
        "causes": { "type": "array" },
        "nestedErrors": { "type": "array" },
        "referenceToken": { "type": "string", "readOnly": true },
        "label": { "type": "string", "readOnly": true },
        "remediationUrl": { "type": "string", "readOnly": true }
      }
    }
  }
}

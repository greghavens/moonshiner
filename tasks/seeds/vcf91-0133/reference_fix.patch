+        'Succeeded'
+    }
+    else {
+        'Failed'
+    }
+    return [pscustomobject] [ordered] @{
+        OverallStatus = $Overall
+        NamespaceChange = [pscustomobject] [ordered] @{
+            OperationId = 'Vcenter.Namespaces.Instances_update'
+            Namespace = $Namespace
+            Status = 'Succeeded'
+            Changed = $true

+function Invoke-VcfKubernetesRequest {
+    param(
+        [Parameter(Mandatory)]
+        [Net.Http.HttpClient] $Client,
+
+        [Parameter(Mandatory)]
+        [Net.Http.HttpMethod] $Method,
+
+        [Parameter(Mandatory)]
+        [uri] $Uri,
+
+        [string] $Body,
+
+        [string] $ContentType
+    )
+
+    $Request = [Net.Http.HttpRequestMessage]::new($Method, $Uri)
+    try {
+        $Request.Headers.Accept.Add(
+            [Net.Http.Headers.MediaTypeWithQualityHeaderValue]::new(
+                'application/json'
+            )
+        )
+        if ($PSBoundParameters.ContainsKey('Body')) {
+            $Bytes = [Text.Encoding]::UTF8.GetBytes($Body)
+            $Request.Content = [Net.Http.ByteArrayContent]::new(
+                [byte[]] $Bytes
+            )
+            $Request.Content.Headers.ContentType = (
+                [Net.Http.Headers.MediaTypeHeaderValue]::new($ContentType)
+            )
+        }
+        try {
+            return $Client.Send($Request)
+        }
+        catch {
+            throw [IOException]::new(
+                'The Kubernetes API request failed.'
+            )
+        }
+    }
+    finally {
+        $Request.Dispose()
+    }
+}

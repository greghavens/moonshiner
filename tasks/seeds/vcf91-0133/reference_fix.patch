+    $Kind = Get-VcfJsonMember $Cluster 'kind'
+    $Metadata = Get-VcfJsonMember $Cluster 'metadata'
+    $Spec = Get-VcfJsonMember $Cluster 'spec'
+    if (
+        -not $ApiVersion.Found -or
+        $ApiVersion.Value -isnot [string] -or
+        $ApiVersion.Value -cne 'cluster.x-k8s.io/v1beta2' -or
+        -not $Kind.Found -or
+        $Kind.Value -isnot [string] -or
+        $Kind.Value -cne 'Cluster' -or
+        -not $Metadata.Found -or
+        $null -eq $Metadata.Value -or
+        -not $Spec.Found -or
+        $null -eq $Spec.Value
+    ) {
+        throw [InvalidDataException]::new(
+            'The Kubernetes preflight returned a malformed Cluster.'
+        )
+    }
+
+    $ActualName = Get-VcfJsonMember $Metadata.Value 'name'
+    $ActualNamespace = Get-VcfJsonMember $Metadata.Value 'namespace'
+    $Topology = Get-VcfJsonMember $Spec.Value 'topology'
+    if (
+        -not $ActualName.Found -or
+        $ActualName.Value -isnot [string] -or
+        -not [StringComparer]::Ordinal.Equals(
+            $ActualName.Value,
+            $Name
+        ) -or
+        -not $ActualNamespace.Found -or
+        $ActualNamespace.Value -isnot [string] -or
+        -not [StringComparer]::Ordinal.Equals(
+            $ActualNamespace.Value,
+            $Namespace
+        ) -or
+        -not $Topology.Found -or
+        $null -eq $Topology.Value
+    ) {
+        throw [InvalidDataException]::new(
+            'The Kubernetes preflight returned a different Cluster.'
+        )
+    }
+
+    $ActualClass = Get-VcfJsonMember $Topology.Value 'class'
+    $ActualVersion = Get-VcfJsonMember $Topology.Value 'version'
+    if (
+        -not $ActualClass.Found -or
+        $ActualClass.Value -isnot [string] -or
+        -not [StringComparer]::Ordinal.Equals(
+            $ActualClass.Value,
+            $ClusterClass
+        ) -or
+        -not $ActualVersion.Found -or
+        $ActualVersion.Value -isnot [string] -or
+        [string]::IsNullOrWhiteSpace($ActualVersion.Value)
+    ) {
+        throw [InvalidDataException]::new(
+            'The Kubernetes preflight returned incompatible topology.'
+        )
+    }
+}

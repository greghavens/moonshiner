+function Assert-VcfNonBlank {
+    param(
+        [Parameter(Mandatory)]
+        [AllowEmptyString()]
+        [string] $Value,
+
+        [Parameter(Mandatory)]
+        [string] $Name
+    )
+
+    if ([string]::IsNullOrWhiteSpace($Value)) {
+        throw [ArgumentException]::new("$Name must be nonblank.")
+    }
+}
+
+function Assert-VcfBearerToken {
+    param(
+        [Parameter(Mandatory)]
+        [AllowEmptyString()]
+        [string] $Token
+    )
+
+    Assert-VcfNonBlank -Value $Token -Name 'KubernetesToken'
+    if ($Token.Contains("`r") -or $Token.Contains("`n")) {
+        throw [ArgumentException]::new(
+            'KubernetesToken contains a header-unsafe character.'
+        )
+    }
+}

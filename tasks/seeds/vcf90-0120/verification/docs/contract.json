{
  "contract_version": 1,
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "commit_sha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "spec_path": "specifications/vsan-data-protection/vsan-data-protection-openapi.yaml",
    "license": "Apache-2.0",
    "openapi": "3.0.3",
    "api_title": "Snapshot Appliance API",
    "api_version": "9.0.0.0"
  },
  "server": {
    "url_template": "https://{host}/api",
    "base_path": "/api"
  },
  "security": {
    "scheme": "api_key_auth",
    "type": "apiKey",
    "in": "header",
    "name": "vmware-api-session-id"
  },
  "wire_rules": {
    "omit_unset_optional_properties": true
  },
  "async_task_protocol": {
    "accepted_status": 202,
    "accepted_body": {
      "type": "string",
      "description": "Task identifier returned as a bare JSON string."
    },
    "poll_with": "Snapservice.Tasks_get",
    "status_values": [
      "PENDING",
      "RUNNING",
      "BLOCKED",
      "SUCCEEDED",
      "FAILED"
    ],
    "non_terminal_status_values": [
      "PENDING",
      "RUNNING",
      "BLOCKED"
    ],
    "terminal_status_values": [
      "SUCCEEDED",
      "FAILED"
    ]
  },
  "operations": [
    {
      "operationId": "Snapservice.Clusters.ProtectionGroups.Snapshots_create$Task",
      "method": "POST",
      "path": "/api/snapservice/clusters/{cluster}/protection-groups/{pg}/snapshots",
      "spec_path_template": "/snapservice/clusters/{cluster}/protection-groups/{pg}/snapshots?vmw-task=true",
      "security": [
        "api_key_auth"
      ],
      "parameters": [
        {
          "name": "cluster",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "pg",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "vmw-task",
          "in": "query",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "true"
            ]
          }
        }
      ],
      "request_body": {
        "required": true,
        "content_type": "application/json",
        "schema": "Snapservice.Clusters.ProtectionGroups.Snapshots.CreateSpec",
        "additional_properties": false,
        "properties": {
          "name": {
            "type": "string",
            "required": true
          },
          "retention": {
            "type": "object",
            "required": false,
            "omit_when_unset": true,
            "schema": "Snapservice.RetentionPeriod",
            "properties": {
              "unit": {
                "type": "string",
                "required": true,
                "enum": [
                  "MINUTE",
                  "HOUR",
                  "DAY",
                  "WEEK",
                  "MONTH"
                ]
              },
              "duration": {
                "type": "integer",
                "format": "int64",
                "required": true
              }
            }
          }
        }
      },
      "success": {
        "status": 202,
        "schema": {
          "type": "string"
        }
      }
    },
    {
      "operationId": "Snapservice.Tasks_get",
      "method": "GET",
      "path": "/api/snapservice/tasks/{task}",
      "spec_path_template": "/snapservice/tasks/{task}",
      "security": [
        "api_key_auth"
      ],
      "parameters": [
        {
          "name": "task",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "request_body": null,
      "success": {
        "status": 200,
        "schema": "Snapservice.Tasks.Info",
        "required": [
          "cancelable",
          "description",
          "operation",
          "service",
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "RUNNING",
              "BLOCKED",
              "SUCCEEDED",
              "FAILED"
            ]
          },
          "description": {
            "schema": "Vapi.Std.LocalizableMessage"
          },
          "result": {
            "required": false
          },
          "error": {
            "type": "object",
            "required": false
          }
        }
      }
    }
  ],
  "errors": {
    "400": "Vapi.Std.Errors.InvalidArgument",
    "401": "Vapi.Std.Errors.Unauthenticated",
    "403": "Vapi.Std.Errors.Unauthorized",
    "404": "Vapi.Std.Errors.NotFound",
    "500": "Vapi.Std.Errors.Error",
    "503": "Vapi.Std.Errors.ServiceUnavailable"
  }
}

+#!/usr/bin/env python3
+"""Reference proof through the genuine CRM executable."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+from pathlib import Path
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "crmctl"
+REPORT = ROOT / "cancellation-report.txt"
+TARGET_ID = "crm-129"
+REASON = "created for the wrong operating period."
+
+
+def run_client(arguments: list[str]) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        [str(CLIENT), *arguments],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=5,
+    )
+
+
+def record_from(result: subprocess.CompletedProcess[str], label: str) -> dict[str, Any]:
+    if result.returncode != 0:
+        raise RuntimeError(result.stderr.strip() or f"reference {label} failed")
+    try:
+        payload: Any = json.loads(result.stdout)
+    except json.JSONDecodeError as error:
+        raise RuntimeError(f"reference {label} returned invalid JSON") from error
+    record = payload.get("record") if isinstance(payload, dict) else None
+    if not isinstance(record, dict):
+        raise RuntimeError(f"reference {label} returned no complete CRM record")
+    if record.get("id") != TARGET_ID:
+        raise RuntimeError(f"reference {label} returned the wrong CRM record")
+    if not isinstance(record.get("status"), str):
+        raise RuntimeError(f"reference {label} returned no record status")
+    return record
+
+
+def main() -> int:
+    help_result = run_client(["--help"])
+    if help_result.returncode != 0:
+        raise RuntimeError(help_result.stderr.strip() or "reference help failed")
+    if "usage: crmctl" not in help_result.stdout:
+        raise RuntimeError("reference help returned unexpected output")
+
+    cancellation_arguments = [
+        "cancel",
+        "--id",
+        TARGET_ID,
+        "--reason",
+        REASON,
+    ]
+    cancellation = run_client(cancellation_arguments)
+    if cancellation.returncode != 124:
+        raise RuntimeError(
+            "reference cancellation did not exercise the client deadline"
+        )
+    if "outcome is unknown" not in cancellation.stderr:
+        raise RuntimeError("reference cancellation did not expose uncertainty")
+
+    retrieval = run_client(["get", "--id", TARGET_ID])
+    record = record_from(retrieval, "direct retrieval")
+    observed_status = record["status"]
+    retry_was_sent = observed_status == "active"
+
+    if observed_status == "cancelled":
+        if record.get("cancellation_reason") != REASON:
+            raise RuntimeError("direct retrieval returned the wrong cancellation reason")
+    elif retry_was_sent:
+        retry = run_client(cancellation_arguments)
+        retried_record = record_from(retry, "conditional retry")
+        if retried_record.get("status") != "cancelled":
+            raise RuntimeError("conditional retry did not cancel the CRM record")
+        if retried_record.get("cancellation_reason") != REASON:
+            raise RuntimeError("conditional retry used the wrong cancellation reason")
+    else:
+        raise RuntimeError(
+            f"direct retrieval returned terminal status {observed_status}"
+        )
+
+    REPORT.write_text(
+        f"{TARGET_ID} direct-get status: {observed_status}.\n"
+        f"Conditional retry sent: {'yes' if retry_was_sent else 'no'}.\n",
+        encoding="utf-8",
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

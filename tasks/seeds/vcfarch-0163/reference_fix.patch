+def read_json(name: str) -> dict:
+    return json.loads((ROOT / name).read_text(encoding="utf-8"))
+
+
+def build_architecture(snapshot: dict) -> dict:
+    pinned = snapshot["target_architecture"]
+    management = dict(pinned["management_domain"])
+    management["placement_rationale"] = (
+        "The vSAN witness remains outside both data sites in the independent, workload-free "
+        "witness fault domain so a data-site partition cannot colocate data and quorum votes."
+    )
+    node_keys = ("id", "role", "site_id", "fault_domain", "vcpu", "memory_gib", "storage_gib")
+    capacity_keys = ("metric", "required", "designed", "unit")
+    components = []
+    for component_id, item in pinned["components"].items():
+        components.append(
+            {
+                "id": component_id,
+                "name": item["name"],
+                "version": item["version"],
+                "deployment_model": item["deployment_model"],
+                "size_profile": item["size_profile"],
+                "nodes": [dict(zip(node_keys, row)) for row in item["nodes"]],
+                "capacity": [dict(zip(capacity_keys, row)) for row in item["capacity"]],
+                "placement_rationale": PLACEMENT_RATIONALE[component_id],
+            }
+        )
+    return {"management_domain": management, "components": components}
+
+
+def build_migrations(inventory: dict, snapshot: dict) -> list[dict]:
+    sources = {item["id"]: item for item in inventory["migration_sources"]}
+    migrations = []
+    for order, source_id in enumerate(snapshot["sequence"], start=1):
+        source = sources[source_id]
+        rule = snapshot["products"][source_id]
+        carried = []
+        abandoned = []
+        for item in source["content"]:
+            disposition, handling = rule["content_dispositions"][item["id"]]
+            if disposition == "carry":
+                carried.append(
+                    {
+                        "inventory_id": item["id"],
+                        "handling": handling,
+                        "detail": CARRY_DETAILS[handling],
+                    }
+                )
+            else:
+                abandoned.append(
+                    {
+                        "inventory_id": item["id"],
+                        "handling": handling,
+                        "reason": ABANDON_REASONS[handling],
+                    }
+                )
+        migrations.append(
+            {
+                "order": order,
+                "source_id": source_id,
+                "source_product": source["product"],
+                "source_version": source["version"],
+                "target_component": rule["target_component"],
+                "target_version": rule["target_version"],
+                "method": rule["migration_method"],
+                "carry_forward": carried,
+                "abandoned": abandoned,
+                "gates": [
+                    {
+                        "gate_id": gate_id,
+                        "condition": GATES[gate_id][0],
+                        "evidence": GATES[gate_id][1],
+                        "rollback": GATES[gate_id][2],
+                    }
+                    for gate_id in rule["required_gates"]
+                ],
+            }
+        )
+    return migrations
+
+
+def build_plan() -> dict:
+    inventory = read_json("estate_inventory.json")
+    snapshot = read_json("compatibility_snapshot.json")
+    boundaries = []
+    for source_id in snapshot["sequence"]:
+        rule = snapshot["products"][source_id]
+        boundaries.append(
+            {
+                "source_id": source_id,
+                "source_product": rule["source_product"],
+                "source_version": rule["source_version"],
+                **rule["support_boundary"],
+                "impact": (
+                    "Complete the supported transition before this date; after it, general-support "
+                    "remediation for the source release is no longer the planning baseline."
+                ),
+            }
+        )
+    return {
+        "schema_version": "1.0",
+        "estate_id": inventory["estate_id"],
+        "target_release": snapshot["target_release"],
+        "design_summary": (
+            "Migrate Operations in place first and establish Fleet Management, migrate Automation "
+            "second, then deploy Logs fresh in parallel and transfer only 90 days. Place target "
+            "services across the stretched management data sites and isolate both witnesses in the "
+            "independent witness-only fault domain."
+        ),
+        "research": RESEARCH,
+        "support_boundaries": boundaries,
+        "target_architecture": build_architecture(snapshot),
+        "migration_plan": build_migrations(inventory, snapshot),
+    }

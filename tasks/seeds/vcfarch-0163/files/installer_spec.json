{
  "spec_version": "1.0",
  "artifact_filename": "migration_plan.json",
  "package": {
    "module": "vcf_migration",
    "entrypoint": "python3 -m vcf_migration --output migration_plan.json",
    "stdlib_only": true
  },
  "artifact_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "estate_id",
      "target_release",
      "design_summary",
      "research",
      "support_boundaries",
      "target_architecture",
      "migration_plan"
    ],
    "properties": {
      "schema_version": {"type": "string", "const": "1.0"},
      "estate_id": {"type": "string", "minLength": 1},
      "target_release": {"type": "string", "const": "9.0.2"},
      "design_summary": {"type": "string", "minLength": 80},
      "research": {
        "type": "array",
        "minItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "publisher", "url", "accessed_on", "claims"],
          "properties": {
            "title": {"type": "string", "minLength": 5},
            "publisher": {"type": "string", "minLength": 3},
            "url": {"type": "string", "pattern": "^https://"},
            "accessed_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "claims": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 12}
            }
          }
        }
      },
      "support_boundaries": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_id", "source_product", "source_version", "eogs_date", "status_at_snapshot", "decision_deadline", "impact"],
          "properties": {
            "source_id": {"type": "string", "minLength": 1},
            "source_product": {"type": "string", "minLength": 5},
            "source_version": {"type": "string", "minLength": 3},
            "eogs_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "status_at_snapshot": {"type": "string", "enum": ["general_support", "eogs"]},
            "decision_deadline": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "impact": {"type": "string", "minLength": 20}
          }
        }
      },
      "target_architecture": {
        "type": "object",
        "additionalProperties": false,
        "required": ["management_domain", "components"],
        "properties": {
          "management_domain": {
            "type": "object",
            "additionalProperties": false,
            "required": ["topology", "data_sites", "witness", "placement_rationale"],
            "properties": {
              "topology": {"type": "string", "const": "stretched_vsan"},
              "data_sites": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "witness": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "site_id", "fault_domain", "dedicated_to_witness"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "site_id": {"type": "string", "minLength": 1},
                  "fault_domain": {"type": "string", "minLength": 1},
                  "dedicated_to_witness": {"type": "boolean", "const": true}
                }
              },
              "placement_rationale": {"type": "string", "minLength": 40}
            }
          },
          "components": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "version", "deployment_model", "size_profile", "nodes", "capacity", "placement_rationale"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "name": {"type": "string", "minLength": 5},
                "version": {"type": "string", "minLength": 3},
                "deployment_model": {"type": "string", "minLength": 5},
                "size_profile": {"type": "string", "minLength": 3},
                "nodes": {
                  "type": "array",
                  "minItems": 3,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "role", "site_id", "fault_domain", "vcpu", "memory_gib", "storage_gib"],
                    "properties": {
                      "id": {"type": "string", "minLength": 1},
                      "role": {"type": "string", "minLength": 3},
                      "site_id": {"type": "string", "minLength": 1},
                      "fault_domain": {"type": "string", "minLength": 1},
                      "vcpu": {"type": "integer", "minimum": 1},
                      "memory_gib": {"type": "integer", "minimum": 1},
                      "storage_gib": {"type": "integer", "minimum": 1}
                    }
                  }
                },
                "capacity": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["metric", "required", "designed", "unit"],
                    "properties": {
                      "metric": {"type": "string", "minLength": 2},
                      "required": {"type": "integer", "minimum": 0},
                      "designed": {"type": "integer", "minimum": 0},
                      "unit": {"type": "string", "minLength": 1}
                    }
                  }
                },
                "placement_rationale": {"type": "string", "minLength": 40}
              }
            }
          }
        }
      },
      "migration_plan": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["order", "source_id", "source_product", "source_version", "target_component", "target_version", "method", "carry_forward", "abandoned", "gates"],
          "properties": {
            "order": {"type": "integer", "minimum": 1, "maximum": 3},
            "source_id": {"type": "string", "minLength": 1},
            "source_product": {"type": "string", "minLength": 5},
            "source_version": {"type": "string", "minLength": 3},
            "target_component": {"type": "string", "minLength": 5},
            "target_version": {"type": "string", "minLength": 3},
            "method": {
              "type": "string",
              "enum": [
                "in_place_upgrade_via_lifecycle",
                "in_place_upgrade_via_fleet_management",
                "parallel_fresh_deployment"
              ]
            },
            "carry_forward": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["inventory_id", "handling", "detail"],
                "properties": {
                  "inventory_id": {"type": "string", "minLength": 1},
                  "handling": {"type": "string", "minLength": 3},
                  "detail": {"type": "string", "minLength": 16}
                }
              }
            },
            "abandoned": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["inventory_id", "handling", "reason"],
                "properties": {
                  "inventory_id": {"type": "string", "minLength": 1},
                  "handling": {"type": "string", "minLength": 3},
                  "reason": {"type": "string", "minLength": 16}
                }
              }
            },
            "gates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["gate_id", "condition", "evidence", "rollback"],
                "properties": {
                  "gate_id": {"type": "string", "minLength": 3},
                  "condition": {"type": "string", "minLength": 16},
                  "evidence": {"type": "string", "minLength": 12},
                  "rollback": {"type": "string", "minLength": 12}
                }
              }
            }
          }
        }
      }
    }
  }
}

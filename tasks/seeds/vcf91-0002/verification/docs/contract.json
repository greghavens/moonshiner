{
  "contract_version": 1,
  "product": "VMware Cloud Foundation 9.1 SDDC Manager REST API",
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "openapi_version": "3.0.1",
    "info_title": "SDDC Manager API Reference Guide",
    "info_version": "9.1.0.0",
    "license": "Apache-2.0",
    "projection_rule": "Project only the three named operations, every getDomains query parameter, and the schema fields needed for token rotation, paged domain inventory, and VCF error recognition."
  },
  "operations": [
    {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "tag": "Tokens",
      "summary": "Create Token Pair",
      "request_body": {
        "required": true,
        "media_type": "application/json",
        "schema_ref": "#/components/schemas/TokenCreationSpec"
      },
      "responses": {
        "201": {
          "description": "Created",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/TokenPair"
        },
        "400": {
          "description": "Bad Request",
          "schema_ref": "#/components/schemas/Error"
        },
        "500": {
          "description": "Internal Server Error",
          "schema_ref": "#/components/schemas/Error"
        }
      },
      "powercli_binding": {
        "module": "VMware.Sdk.Vcf.SddcManager",
        "command": "Connect-VcfSddcManagerServer"
      }
    },
    {
      "operationId": "refreshAccessToken",
      "method": "PATCH",
      "path": "/v1/tokens/access-token/refresh",
      "tag": "Tokens",
      "summary": "Refresh Access Token",
      "request_body": {
        "required": true,
        "media_type": "application/json",
        "schema": {
          "type": "string",
          "description": "ID of the refresh token"
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "media_type": "application/json",
          "schema": {
            "type": "string"
          }
        },
        "400": {
          "description": "Bad Request",
          "schema_ref": "#/components/schemas/Error"
        },
        "404": {
          "description": "Not Found",
          "schema_ref": "#/components/schemas/Error"
        },
        "500": {
          "description": "Internal Server Error",
          "schema_ref": "#/components/schemas/Error"
        }
      },
      "powercli_binding": {
        "module": "VMware.Sdk.Vcf.SddcManager",
        "command": "Invoke-VcfRefreshAccessToken"
      }
    },
    {
      "operationId": "getDomains",
      "method": "GET",
      "path": "/v1/domains",
      "tag": "Domains",
      "summary": "Retrieve a list of domains",
      "parameters": [
        {
          "name": "type",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "name",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "vcFqdn",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "vcInstanceId",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "isManagementSsoDomain",
          "in": "query",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "pageNumber",
          "in": "query",
          "required": false,
          "default_declared_by_spec": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "default_declared_by_spec": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        },
        {
          "name": "useCache",
          "in": "query",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Ok",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/PageOfDomain"
        },
        "400": {
          "description": "Bad Request",
          "schema_ref": "#/components/schemas/Error"
        },
        "500": {
          "description": "InternalServerError",
          "schema_ref": "#/components/schemas/Error"
        }
      },
      "powercli_binding": {
        "module": "VMware.Sdk.Vcf.SddcManager",
        "command": "Invoke-VcfGetDomains"
      }
    }
  ],
  "schemas": {
    "TokenCreationSpec": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "apiKey": {
          "type": "string"
        },
        "idToken": {
          "type": "string"
        }
      }
    },
    "RefreshToken": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "TokenPair": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string"
        },
        "refreshToken": {
          "$ref": "#/components/schemas/RefreshToken"
        }
      }
    },
    "PageMetadata": {
      "type": "object",
      "properties": {
        "pageNumber": {
          "type": "integer",
          "format": "int32",
          "readOnly": true
        },
        "pageSize": {
          "type": "integer",
          "format": "int32",
          "readOnly": true
        },
        "totalElements": {
          "type": "integer",
          "format": "int32",
          "readOnly": true
        },
        "totalPages": {
          "type": "integer",
          "format": "int32",
          "readOnly": true
        }
      }
    },
    "PageOfDomain": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Domain"
          }
        },
        "pageMetadata": {
          "$ref": "#/components/schemas/PageMetadata"
        }
      }
    },
    "Domain": {
      "type": "object",
      "projected_properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "isManagementSsoDomain": {
          "type": "boolean"
        }
      }
    },
    "Error": {
      "type": "object",
      "projected_properties": {
        "errorCode": {
          "type": "string",
          "readOnly": true
        },
        "message": {
          "type": "string",
          "readOnly": true
        },
        "referenceToken": {
          "type": "string",
          "readOnly": true
        }
      }
    }
  },
  "client_policy": {
    "first_request": "Pass pageSize and omit pageNumber because getDomains declares neither parameter required and declares no default.",
    "continuation": "Use pageMetadata.pageNumber plus one and retry the same page after the single allowed access-token refresh.",
    "completion": "Accumulate until count equals invariant totalElements; reject overshoot and non-progress.",
    "refresh": {
      "trigger": "first HTTP 401 from getDomains",
      "maximum": 1,
      "request_representation": "RefreshTokenId serialized as one JSON string",
      "resume": "retry interrupted page without clearing accumulated elements"
    },
    "ordering": {
      "comparison": "ordinal case-sensitive",
      "keys": [
        "name",
        "id"
      ]
    },
    "projection_key_order": [
      "id",
      "name",
      "type",
      "status",
      "isManagementSsoDomain"
    ],
    "export": {
      "root_key_order": [
        "domains"
      ],
      "json": "compact",
      "encoding": "UTF-8 without BOM",
      "terminator": "one LF byte"
    }
  }
}

+function Get-MandatoryBodyParameterName {
+    param(
+        [Parameter(Mandatory)] [System.Management.Automation.CommandInfo] $Command
+    )
+
+    $common = @(
+        'Server', 'Verbose', 'Debug', 'ErrorAction', 'WarningAction',
+        'InformationAction', 'ProgressAction', 'ErrorVariable',
+        'WarningVariable', 'InformationVariable', 'OutVariable',
+        'OutBuffer', 'PipelineVariable'
+    )
+    $names = @(
+        $Command.ParameterSets.Parameters |
+            Where-Object { $_.IsMandatory -and $_.Name -cnotin $common } |
+            Select-Object -ExpandProperty Name -Unique
+    )
+    if ($names.Count -ne 1) {
+        throw [System.InvalidOperationException]::new(
+            'The refreshAccessToken binding does not expose one required body parameter.'
+        )
+    }
+    [string] $names[0]
+}
+
+function Invoke-AccessTokenRefresh {
+    param(
+        [Parameter(Mandatory)] [System.Management.Automation.CommandInfo] $Command,
+        [Parameter(Mandatory)] [object] $Server,
+        [Parameter(Mandatory)] [string] $RefreshTokenId
+    )
+
+    $bodyParameter = Get-MandatoryBodyParameterName -Command $Command
+    $arguments = @{
+        Server      = $Server
+        ErrorAction = 'Stop'
+    }
+    $arguments[$bodyParameter] = $RefreshTokenId
+
+    try {
+        $values = @(& $Command @arguments)
+    } catch {
+        throw [System.InvalidOperationException]::new(
+            'refreshAccessToken failed.'
+        )
+    }
+    if (
+        $values.Count -ne 1 -or
+        $values[0] -isnot [string] -or
+        [string]::IsNullOrWhiteSpace([string] $values[0])
+    ) {
+        throw [System.InvalidOperationException]::new(
+            'refreshAccessToken did not return one access-token string.'
+        )
+    }
+    [string] $values[0]
+}
+
+function Set-VcfAccessToken {
+    param(
+        [Parameter(Mandatory)] [object] $Server,
+        [Parameter(Mandatory)] [string] $AccessToken
+    )
+
+    $property = $Server.PSObject.Properties['SessionSecret']
+    if ($null -eq $property -or -not $property.IsSettable) {
+        throw [System.InvalidOperationException]::new(
+            'The supplied SDK connection has no writable SessionSecret.'
+        )
+    }
+    $property.Value = $AccessToken
+}
+
+function Get-RequiredVcfProperty {
+    param(
+        [Parameter(Mandatory)] [object] $InputObject,
+        [Parameter(Mandatory)] [string] $Name,
+        [Parameter(Mandatory)] [string] $Context
+    )
+
+    $property = $InputObject.PSObject.Properties[$Name]
+    if ($null -eq $property) {
+        throw [System.InvalidOperationException]::new(
+            "$Context has no $Name property."
+        )
+    }
+    $property.Value
+}
+
+function ConvertTo-VcfInteger {
+    param(
+        [Parameter(Mandatory)] $Value,
+        [Parameter(Mandatory)] [string] $Name
+    )
+
+    if ($Value -isnot [sbyte] -and $Value -isnot [byte] -and
+        $Value -isnot [int16] -and $Value -isnot [uint16] -and
+        $Value -isnot [int32] -and $Value -isnot [uint32] -and
+        $Value -isnot [int64] -and $Value -isnot [uint64]) {
+        throw [System.InvalidOperationException]::new(
+            "pageMetadata.$Name is not an integer."
+        )
+    }
+    try { [int64] $Value } catch {
+        throw [System.InvalidOperationException]::new(
+            "pageMetadata.$Name is outside the supported range."
+        )
+    }
+}

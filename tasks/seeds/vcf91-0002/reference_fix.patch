+function Get-ExactVcfOperationCommand {
+    param([Parameter(Mandatory)] [string] $OperationId)
+
+    $operations = @(
+        Get-VcfSddcManagerOperation -Name $OperationId -ErrorAction Stop
+    )
+    if ($operations.Count -ne 1 -or $null -eq $operations[0].CommandInfo) {
+        throw [System.InvalidOperationException]::new(
+            "The genuine SDK did not resolve exactly one $OperationId operation."
+        )
+    }
+
+    $commandName = [string] $operations[0].CommandInfo.Name
+    $commands = @(
+        Microsoft.PowerShell.Core\Get-Command `
+            -Name $commandName `
+            -Module 'VMware.Sdk.Vcf.SddcManager' `
+            -CommandType Cmdlet `
+            -All `
+            -ErrorAction SilentlyContinue
+    )
+    if ($commands.Count -ne 1 -or
+        $commands[0].Source -cne 'VMware.Sdk.Vcf.SddcManager') {
+        throw [System.InvalidOperationException]::new(
+            "The $OperationId operation is not supplied by the genuine SDK."
+        )
+    }
+    $commands[0]
+}
+
+function Get-VcfHttpStatusCode {
+    param([Parameter(Mandatory)] [System.Management.Automation.ErrorRecord] $Record)
+
+    $exception = $Record.Exception
+    for ($depth = 0; $depth -lt 8 -and $null -ne $exception; $depth++) {
+        foreach ($candidateName in @('StatusCode', 'HttpStatusCode')) {
+            $candidate = $exception.PSObject.Properties[$candidateName]
+            if ($null -ne $candidate -and $null -ne $candidate.Value) {
+                try { return [int] $candidate.Value } catch { }
+            }
+        }
+
+        foreach ($containerName in @('Response', 'ApiError')) {
+            $container = $exception.PSObject.Properties[$containerName]
+            if ($null -eq $container -or $null -eq $container.Value) { continue }
+            $status = $container.Value.PSObject.Properties['StatusCode']
+            if ($null -ne $status -and $null -ne $status.Value) {
+                try { return [int] $status.Value } catch { }
+            }
+        }
+
+        $exception = $exception.InnerException
+    }
+
+    $message = [string] $Record.Exception.Message
+    if ($message -match '(?<![0-9])401(?![0-9])') { return 401 }
+    $null
+}

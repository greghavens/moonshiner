{
  "contractFormat": "focused-openapi-projection-v1",
  "source": {
    "repository": "vmware/vcf-api-specs",
    "repositoryCommitSha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "specPath": "specifications/vcf-installer/vcf-installer-openapi.json",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "apiVersion": "9.1.0.0"
  },
  "operations": [
    {
      "operationId": "updateProxyConfiguration",
      "method": "PATCH",
      "path": "/v1/system/proxy-configuration",
      "summary": "Update Proxy configuration",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "ProxyConfiguration"
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "contentType": "application/json",
          "schema": "Task"
        },
        "400": {
          "description": "Bad request",
          "contentType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "Internal server error",
          "schema": null
        }
      }
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "summary": "Retrieve a task by its ID",
      "requestBody": false,
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "A task object.",
          "contentType": "application/json",
          "schema": "Task"
        },
        "404": {
          "description": "Task not found",
          "contentType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "Unexpected error",
          "contentType": "application/json",
          "schema": "Error"
        }
      }
    }
  ],
  "schemas": {
    "ProxyConfiguration": {
      "type": "object",
      "required": [],
      "properties": {
        "isConfigured": {
          "type": "boolean",
          "readOnly": true
        },
        "isEnabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "format": "int32"
        },
        "transferProtocol": {
          "type": "string",
          "enum": [
            "HTTP",
            "HTTPS"
          ]
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "isAuthenticated": {
          "type": "boolean"
        }
      }
    },
    "Task": {
      "type": "object",
      "required": [
        "creationTimestamp",
        "id",
        "name",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "readOnly": true
        },
        "localizableDescriptionPack": {
          "$ref": "MessagePack"
        },
        "type": {
          "type": "string",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "readOnly": true,
          "exampleValues": [
            "PENDING",
            "Pending",
            "IN_PROGRESS",
            "In Progress",
            "SUCCESSFUL",
            "Successful",
            "FAILED",
            "Failed",
            "CANCELLED",
            "Cancelled",
            "COMPLETED_WITH_WARNING",
            "SKIPPED",
            "QUEUED",
            "TIMED_OUT",
            "Queued",
            "Timed Out"
          ]
        },
        "creationTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "completionTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "subTasks": {
          "type": "array",
          "readOnly": true,
          "items": {
            "$ref": "SubTask"
          }
        },
        "errors": {
          "type": "array",
          "readOnly": true,
          "items": {
            "$ref": "Error"
          }
        },
        "resources": {
          "type": "array",
          "readOnly": true,
          "items": {
            "$ref": "Resource"
          }
        },
        "resolutionStatus": {
          "type": "string",
          "readOnly": true
        },
        "isCancellable": {
          "type": "boolean",
          "readOnly": true
        },
        "isRetryable": {
          "type": "boolean",
          "readOnly": true
        }
      }
    }
  },
  "focusedPollingProfile": {
    "submitOperationId": "updateProxyConfiguration",
    "pollOperationId": "getTask",
    "taskIdProperty": "id",
    "statusProperty": "status",
    "nonTerminalStatuses": [
      "PENDING",
      "IN_PROGRESS",
      "QUEUED"
    ],
    "successfulTerminalStatus": "SUCCESSFUL",
    "unsuccessfulTerminalStatuses": [
      "FAILED",
      "CANCELLED",
      "COMPLETED_WITH_WARNING",
      "SKIPPED",
      "TIMED_OUT"
    ]
  }
}

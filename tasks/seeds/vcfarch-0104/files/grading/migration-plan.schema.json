{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF brownfield point-solution migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "estateId",
    "targetFleetVersion",
    "steps"
  ],
  "properties": {
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetFleetVersion": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "componentId",
          "componentType",
          "currentVersion",
          "targetComponent",
          "targetVersion",
          "disposition",
          "gates"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "componentType": {
            "type": "string",
            "enum": [
              "VCENTER",
              "ESXI",
              "VSAN",
              "NSX",
              "LIVE_SITE_RECOVERY"
            ]
          },
          "currentVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetComponent": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "enum": [
              "TRANSITION",
              "REDEPLOY_AND_MIGRATE",
              "REPROVISION",
              "REBUILD_AND_MIGRATE"
            ]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "outcome"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "outcome": {
                  "type": "string",
                  "enum": [
                    "BLOCKED",
                    "REQUIRED"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}

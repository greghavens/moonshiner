+Set-StrictMode -Version Latest
+
+function ConvertFrom-SdkModel {
+    [CmdletBinding()]
+    param(
+        [Parameter(ValueFromPipeline)]
+        [object] $InputObject
+    )
+
+    process {
+        if ($null -eq $InputObject) {
+            return $null
+        }
+        if ($InputObject -is [string] -or $InputObject.GetType().IsPrimitive) {
+            return $InputObject
+        }
+        if ($InputObject -is [System.Collections.IDictionary]) {
+            $result = [ordered]@{}
+            foreach ($key in $InputObject.Keys) {
+                if ($null -ne $InputObject[$key]) {
+                    $result[$key] = ConvertFrom-SdkModel $InputObject[$key]
+                }
+            }
+            return $result
+        }
+        if ($InputObject -is [System.Collections.IEnumerable]) {
+            return ,@($InputObject | ForEach-Object { ConvertFrom-SdkModel $_ })
+        }
+
+        $result = [ordered]@{}
+        foreach ($property in $InputObject.PSObject.Properties) {
+            if ($property.Name -eq 'AdditionalProperties' -or $null -eq $property.Value) {
+                continue
+            }
+            $name = $property.Name.Substring(0, 1).ToLowerInvariant() + $property.Name.Substring(1)
+            $result[$name] = ConvertFrom-SdkModel $property.Value
+        }
+        return $result
+    }
+}
+
+function New-VcfFleetArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateScript({ Test-Path -LiteralPath $_ -PathType Leaf })]
+        [string] $InventoryPath,
+
+        [Parameter(Mandatory)]
+        [ValidateScript({ Test-Path -LiteralPath $_ -PathType Leaf })]
+        [string] $CompatibilitySnapshotPath,
+
+        [Parameter(Mandatory)]
+        [string] $OutputPath
+    )
+
+    $inventory = Get-Content -LiteralPath $InventoryPath -Raw | ConvertFrom-Json
+    $snapshot = Get-Content -LiteralPath $CompatibilitySnapshotPath -Raw | ConvertFrom-Json
+    if ($inventory.targetFleetVersion -ne $snapshot.targetFleetVersion) {
+        throw 'The estate inventory and compatibility snapshot target different VCF fleet versions.'
+    }
+
+    $design = $inventory.targetSddcSpec
+    $dnsSpec = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $design.dnsSpec.subdomain `
+        -Nameservers ([string[]] $design.dnsSpec.nameservers)
+
+    $networkSpecs = @(
+        foreach ($network in $design.networkSpecs) {
+            Initialize-VcfInstallerSddcNetworkSpec `
+                -NetworkType $network.networkType `
+                -VlanId $network.vlanId `
+                -Subnet $network.subnet `
+                -Gateway $network.gateway `
+                -SubnetMask $network.subnetMask `
+                -Mtu $network.mtu
+        }
+    )
+
+    $vcenterSpec = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname $design.vcenterSpec.vcenterHostname `
+        -RootVcenterPassword $design.vcenterSpec.rootVcenterPassword `
+        -UseExistingDeployment $design.vcenterSpec.useExistingDeployment `
+        -Version $design.vcenterSpec.version
+
+    $sdkSpec = Initialize-VcfInstallerSddcSpec `
+        -SddcId $design.sddcId `
+        -WorkflowType $design.workflowType `
+        -Version $design.version `
+        -VcenterSpec $vcenterSpec `
+        -NetworkSpecs $networkSpecs `
+        -DnsSpec $dnsSpec `
+        -NtpServers ([string[]] $design.ntpServers)
+
+    $architecture = ConvertFrom-SdkModel $sdkSpec
+    $orderedComponents = @(
+        $inventory.components | Sort-Object `
+            @{ Expression = { $snapshot.componentRules.($_.componentType).planRank } }, `
+            @{ Expression = { $_.id } }
+    )
+
+    $steps = @()
+    $order = 0
+    foreach ($component in $orderedComponents) {
+        $order += 1
+        $rule = $snapshot.componentRules.($component.componentType)
+        $gates = @(
+            foreach ($gate in $rule.gates) {
+                [ordered]@{
+                    id = $gate.id
+                    outcome = $gate.outcome
+                }
+            }
+        )
+        $steps += [ordered]@{
+            order = $order
+            componentId = $component.id
+            componentType = $component.componentType
+            currentVersion = $component.version
+            targetComponent = $rule.targetComponent
+            targetVersion = $rule.targetVersion
+            disposition = $rule.disposition
+            gates = $gates
+        }
+    }
+
+    $architecture.migrationPlan = [ordered]@{
+        estateId = $inventory.estateId
+        targetFleetVersion = $snapshot.targetFleetVersion
+        steps = $steps
+    }
+
+    $parent = Split-Path -Parent $OutputPath
+    if ($parent) {
+        $null = New-Item -ItemType Directory -Path $parent -Force
+    }
+    $architecture | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $OutputPath -Encoding utf8
+    Get-Item -LiteralPath $OutputPath
+}
+
+Export-ModuleMember -Function New-VcfFleetArchitecture

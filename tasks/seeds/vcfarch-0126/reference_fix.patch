diff --git a/architecture_test.go b/architecture_test.go
new file mode 100644
index 0000000..01b4dfc
--- /dev/null
+++ b/architecture_test.go
@@ -0,0 +1,125 @@
+package vcfarch
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestRouteFor(t *testing.T) {
+	snapshot, err := LoadCompatibilitySnapshot("compatibility-snapshot.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	tests := []struct {
+		name       string
+		typeName   string
+		version    string
+		wantTarget string
+		want       bool
+	}{
+		{name: "brownfield NSX", typeName: "nsx", version: "4.2.2.1", wantTarget: "9.1.0.0", want: true},
+		{name: "legacy recovery pair", typeName: "live-site-recovery", version: "9.0.2.2", wantTarget: "9.1.0.0", want: true},
+		{name: "unlisted version", typeName: "nsx", version: "4.1.0", want: false},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			route, ok := routeFor(snapshot.Routes, test.typeName, test.version)
+			if ok != test.want {
+				t.Fatalf("routeFor() found = %v, want %v", ok, test.want)
+			}
+			if ok && route.TargetVersion != test.wantTarget {
+				t.Fatalf("target = %q, want %q", route.TargetVersion, test.wantTarget)
+			}
+		})
+	}
+}
+
+func TestBuildArchitectureTopology(t *testing.T) {
+	inventory, err := LoadInventory("estate.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	snapshot, err := LoadCompatibilitySnapshot("compatibility-snapshot.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	tests := []struct {
+		name        string
+		licensed    int
+		wantID      string
+		wantErrText string
+	}{
+		{name: "exact entitlement selects convergence", licensed: 192, wantID: "CONVERGE_EXISTING_MANAGEMENT"},
+		{name: "insufficient entitlement has no topology", licensed: 191, wantErrText: "no technically supported topology"},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			candidate := inventory
+			candidate.Entitlement.LicensedPhysicalCores = test.licensed
+			artifact, err := BuildArchitecture(candidate, snapshot)
+			if test.wantErrText != "" {
+				if err == nil || !strings.Contains(err.Error(), test.wantErrText) {
+					t.Fatalf("error = %v, want text %q", err, test.wantErrText)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if artifact.SelectedTopology.ID != test.wantID {
+				t.Fatalf("selected = %q, want %q", artifact.SelectedTopology.ID, test.wantID)
+			}
+		})
+	}
+}
+
+func TestLoadInventoryStrict(t *testing.T) {
+	tests := []struct {
+		name string
+		body string
+		want string
+	}{
+		{name: "unknown field", body: `{"estateId":"x","surprise":true}`, want: "unknown field"},
+		{name: "trailing value", body: `{}` + "\n{}", want: "trailing"},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "estate.json")
+			if err := os.WriteFile(path, []byte(test.body), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			_, err := LoadInventory(path)
+			if err == nil || !strings.Contains(err.Error(), test.want) {
+				t.Fatalf("error = %v, want text %q", err, test.want)
+			}
+		})
+	}
+}
+
+func TestBuildArchitectureDeterministic(t *testing.T) {
+	inventory, err := LoadInventory("estate.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	snapshot, err := LoadCompatibilitySnapshot("compatibility-snapshot.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	first, err := BuildArchitecture(inventory, snapshot)
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := BuildArchitecture(inventory, snapshot)
+	if err != nil {
+		t.Fatal(err)
+	}
+	firstJSON, _ := json.Marshal(first)
+	secondJSON, _ := json.Marshal(second)
+	if !reflect.DeepEqual(firstJSON, secondJSON) {
+		t.Fatal("identical inputs produced different artifacts")
+	}
+}
diff --git a/build.go b/build.go
new file mode 100644
index 0000000..e12760a
--- /dev/null
+++ b/build.go
@@ -0,0 +1,172 @@
+package vcfarch
+
+import (
+	"fmt"
+	"sort"
+)
+
+func BuildArchitecture(inventory Inventory, snapshot CompatibilitySnapshot) (Artifact, error) {
+	if err := validateInventory(inventory); err != nil {
+		return Artifact{}, err
+	}
+	if err := validateSnapshot(snapshot); err != nil {
+		return Artifact{}, err
+	}
+
+	existingCores := 0
+	for _, cluster := range inventory.Clusters {
+		existingCores += cluster.HostCount * cluster.CoresPerHost
+	}
+	licensed := inventory.Entitlement.LicensedPhysicalCores
+
+	topologies := append([]Topology(nil), snapshot.Topologies...)
+	sort.Slice(topologies, func(i, j int) bool {
+		if topologies[i].AdditionalCoreDemand == topologies[j].AdditionalCoreDemand {
+			return topologies[i].ID < topologies[j].ID
+		}
+		return topologies[i].AdditionalCoreDemand < topologies[j].AdditionalCoreDemand
+	})
+	var selected *TopologyDecision
+	discarded := make([]TopologyDecision, 0)
+	for _, topology := range topologies {
+		required := existingCores + topology.AdditionalCoreDemand
+		decision := TopologyDecision{
+			ID:                   topology.ID,
+			TechnicallySupported: topology.TechnicallySupported,
+			LicensedCores:        licensed,
+			RequiredCores:        required,
+			Gate:                 topology.Gate,
+		}
+		if topology.TechnicallySupported && required <= licensed && selected == nil {
+			copy := decision
+			selected = &copy
+			continue
+		}
+		if topology.TechnicallySupported && required > licensed {
+			decision.ReasonCode = "LICENSE_CORE_ENTITLEMENT_EXCEEDED"
+			discarded = append(discarded, decision)
+		}
+	}
+	if selected == nil {
+		return Artifact{}, fmt.Errorf("no technically supported topology fits %d licensed cores", licensed)
+	}
+
+	plans := make([]ComponentPlan, 0, len(inventory.Components))
+	for _, component := range inventory.Components {
+		route, ok := routeFor(snapshot.Routes, component.Type, component.Version)
+		if !ok {
+			return Artifact{}, fmt.Errorf("no pinned route for component %q (%s %s)", component.ID, component.Type, component.Version)
+		}
+		plans = append(plans, ComponentPlan{
+			ID:             component.ID,
+			Type:           component.Type,
+			Product:        component.Product,
+			CurrentVersion: component.Version,
+			TargetProduct:  route.TargetProduct,
+			TargetVersion:  route.TargetVersion,
+			UpgradePath:    append([]string(nil), route.UpgradePath...),
+			Gates:          append([]string(nil), route.Gates...),
+			Phases:         clonePhases(route.Phases),
+		})
+	}
+
+	return Artifact{
+		SchemaVersion:       "1.0",
+		TargetFleetVersion:  snapshot.TargetFleetVersion,
+		SelectedTopology:    *selected,
+		DiscardedTopologies: discarded,
+		GreenfieldSddcSpec:  makeSddcSpec(inventory.GreenfieldDesign),
+		MigrationPlan: MigrationPlan{
+			Strategy:   "CONVERGE_EXISTING_MANAGEMENT_THEN_FLEET_LIFECYCLE",
+			Components: plans,
+		},
+	}, nil
+}
+
+func routeFor(routes []CompatibilityRoute, componentType, version string) (CompatibilityRoute, bool) {
+	for _, route := range routes {
+		if route.ComponentType == componentType && route.CurrentVersion == version {
+			return route, true
+		}
+	}
+	return CompatibilityRoute{}, false
+}
+
+func clonePhases(phases []MigrationPhase) []MigrationPhase {
+	result := make([]MigrationPhase, len(phases))
+	for i, phase := range phases {
+		result[i] = phase
+		result[i].Gates = append([]string(nil), phase.Gates...)
+	}
+	return result
+}
+
+func makeSddcSpec(design GreenfieldDesign) SddcSpec {
+	hosts := make([]SddcHostSpec, 0, len(design.Hosts))
+	for _, host := range design.Hosts {
+		hosts = append(hosts, SddcHostSpec{
+			Hostname: host.Hostname,
+			Credentials: SddcCredentials{
+				Username: host.Username,
+				Password: host.Password,
+			},
+		})
+	}
+	networks := make([]SddcNetworkSpec, 0, len(design.Networks))
+	for _, network := range design.Networks {
+		networks = append(networks, SddcNetworkSpec{
+			NetworkType:           network.NetworkType,
+			VLANID:                network.VLANID,
+			Subnet:                network.Subnet,
+			Gateway:               network.Gateway,
+			SubnetMask:            network.SubnetMask,
+			IncludeIPAddressRange: append([]IPRange(nil), network.IncludeIPAddressRange...),
+			MTU:                   network.MTU,
+		})
+	}
+	nsxManagers := make([]NSXTManagerSpec, 0, len(design.NSX.ManagerHostnames))
+	for _, hostname := range design.NSX.ManagerHostnames {
+		nsxManagers = append(nsxManagers, NSXTManagerSpec{Hostname: hostname})
+	}
+	return SddcSpec{
+		SddcID:       design.SddcID,
+		WorkflowType: design.WorkflowType,
+		Version:      design.Version,
+		HostSpecs:    hosts,
+		VcenterSpec: SddcVcenterSpec{
+			VcenterHostname:     design.Vcenter.Hostname,
+			RootVcenterPassword: design.Vcenter.RootPassword,
+			VMSize:              design.Vcenter.VMSize,
+			SSODomain:           design.Vcenter.SSODomain,
+		},
+		ClusterSpec: SddcClusterSpec{
+			DatacenterName: design.SddcID + "-dc",
+			ClusterName:    design.SddcID + "-cl01",
+		},
+		NSXTSpec: SddcNSXTSpec{
+			NSXTManagers:            nsxManagers,
+			NSXTManagerSize:         design.NSX.ManagerSize,
+			VIPFQDN:                 design.NSX.VIPFQDN,
+			RootNSXTManagerPassword: design.NSX.RootPassword,
+			NSXTAdminPassword:       design.NSX.AdminPassword,
+			NSXTAuditPassword:       design.NSX.AuditPassword,
+			TransportVLANID:         design.NSX.TransportVLANID,
+		},
+		NetworkSpecs: networks,
+		DNSSpec: DNSSpec{
+			Subdomain:   design.DNS.Subdomain,
+			Nameservers: append([]string(nil), design.DNS.Nameservers...),
+		},
+		NTPServers: append([]string(nil), design.NTPServers...),
+		SddcManagerSpec: SddcManagerSpec{
+			Hostname:     design.SddcManager.Hostname,
+			RootPassword: design.SddcManager.RootPassword,
+			SSHPassword:  design.SddcManager.SSHPassword,
+		},
+		ManagementPoolName: design.ManagementPoolName,
+		CEIPEnabled:        false,
+		DatastoreSpec: SddcDatastoreSpec{
+			VSANSpec: VSANSpec{DatastoreName: design.SddcID + "-vsan01", FailuresToTolerate: 1},
+		},
+	}
+}

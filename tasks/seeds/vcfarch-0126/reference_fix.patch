@@ -0,0 +1,37 @@
+package main
+
+import (
+	"flag"
+	"fmt"
+	"os"
+
+	"vcfarch"
+)
+
+func main() {
+	inventoryPath := flag.String("inventory", "estate.json", "estate inventory JSON")
+	compatPath := flag.String("compat", "compatibility-snapshot.json", "pinned compatibility snapshot JSON")
+	outPath := flag.String("out", "architecture.json", "architecture artifact path")
+	flag.Parse()
+
+	inventory, err := vcfarch.LoadInventory(*inventoryPath)
+	if err != nil {
+		fatal(err)
+	}
+	snapshot, err := vcfarch.LoadCompatibilitySnapshot(*compatPath)
+	if err != nil {
+		fatal(err)
+	}
+	artifact, err := vcfarch.BuildArchitecture(inventory, snapshot)
+	if err != nil {
+		fatal(err)
+	}
+	if err := vcfarch.WriteArtifact(*outPath, artifact); err != nil {
+		fatal(err)
+	}
+}
+
+func fatal(err error) {
+	fmt.Fprintln(os.Stderr, err)
+	os.Exit(1)
+}
diff --git a/load.go b/load.go
new file mode 100644
index 0000000..181f24d
--- /dev/null
+++ b/load.go
@@ -0,0 +1,128 @@
+package vcfarch
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+)
+
+func LoadInventory(path string) (Inventory, error) {
+	var inventory Inventory
+	if err := decodeStrict(path, &inventory); err != nil {
+		return Inventory{}, err
+	}
+	if err := validateInventory(inventory); err != nil {
+		return Inventory{}, fmt.Errorf("%s: %w", path, err)
+	}
+	return inventory, nil
+}
+
+func LoadCompatibilitySnapshot(path string) (CompatibilitySnapshot, error) {
+	var snapshot CompatibilitySnapshot
+	if err := decodeStrict(path, &snapshot); err != nil {
+		return CompatibilitySnapshot{}, err
+	}
+	if err := validateSnapshot(snapshot); err != nil {
+		return CompatibilitySnapshot{}, fmt.Errorf("%s: %w", path, err)
+	}
+	return snapshot, nil
+}
+
+func decodeStrict(path string, dst any) error {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return fmt.Errorf("read %s: %w", path, err)
+	}
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(dst); err != nil {
+		return fmt.Errorf("decode %s: %w", path, err)
+	}
+	if err := dec.Decode(&struct{}{}); err != io.EOF {
+		if err == nil {
+			return fmt.Errorf("decode %s: unexpected trailing JSON value", path)
+		}
+		return fmt.Errorf("decode %s: %w", path, err)
+	}
+	return nil
+}
+
+func validateInventory(inventory Inventory) error {
+	if inventory.EstateID == "" {
+		return fmt.Errorf("estateId is required")
+	}
+	if inventory.Entitlement.LicensedPhysicalCores <= 0 {
+		return fmt.Errorf("entitlement.licensedPhysicalCores must be positive")
+	}
+	if len(inventory.Clusters) == 0 {
+		return fmt.Errorf("at least one cluster is required")
+	}
+	clusterIDs := make(map[string]bool, len(inventory.Clusters))
+	for _, cluster := range inventory.Clusters {
+		if cluster.ID == "" || cluster.HostCount <= 0 || cluster.CoresPerHost <= 0 {
+			return fmt.Errorf("cluster %q must have an id and positive host/core counts", cluster.ID)
+		}
+		if clusterIDs[cluster.ID] {
+			return fmt.Errorf("duplicate cluster id %q", cluster.ID)
+		}
+		clusterIDs[cluster.ID] = true
+	}
+	componentIDs := make(map[string]bool, len(inventory.Components))
+	for _, component := range inventory.Components {
+		if component.ID == "" || component.Type == "" || component.Product == "" || component.Version == "" {
+			return fmt.Errorf("component identity, type, product, and version are required")
+		}
+		if componentIDs[component.ID] {
+			return fmt.Errorf("duplicate component id %q", component.ID)
+		}
+		componentIDs[component.ID] = true
+	}
+	greenfield := inventory.GreenfieldDesign
+	if greenfield.SddcID == "" || greenfield.Version == "" || len(greenfield.Hosts) == 0 || len(greenfield.Networks) == 0 {
+		return fmt.Errorf("greenfieldDesign must name the SDDC/version and include hosts and networks")
+	}
+	return nil
+}
+
+func validateSnapshot(snapshot CompatibilitySnapshot) error {
+	if snapshot.SnapshotVersion == "" || snapshot.TargetFleetVersion == "" {
+		return fmt.Errorf("snapshotVersion and targetFleetVersion are required")
+	}
+	if snapshot.InstallerSchema.SHA256 == "" || snapshot.InstallerSchema.Schema != "#/components/schemas/SddcSpec" {
+		return fmt.Errorf("installerSchema must pin the SddcSpec and its digest")
+	}
+	topologyIDs := make(map[string]bool, len(snapshot.Topologies))
+	for _, topology := range snapshot.Topologies {
+		if topology.ID == "" || topology.Gate == "" || topology.AdditionalCoreDemand < 0 {
+			return fmt.Errorf("invalid topology %q", topology.ID)
+		}
+		if topologyIDs[topology.ID] {
+			return fmt.Errorf("duplicate topology %q", topology.ID)
+		}
+		topologyIDs[topology.ID] = true
+	}
+	routeKeys := make(map[string]bool, len(snapshot.Routes))
+	orders := make(map[int]bool)
+	for _, route := range snapshot.Routes {
+		key := route.ComponentType + "\x00" + route.CurrentVersion
+		if route.ComponentType == "" || route.CurrentVersion == "" || route.TargetVersion == "" || len(route.UpgradePath) < 2 || len(route.Gates) == 0 || len(route.Phases) == 0 {
+			return fmt.Errorf("incomplete compatibility route for %s %s", route.ComponentType, route.CurrentVersion)
+		}
+		if routeKeys[key] {
+			return fmt.Errorf("duplicate compatibility route for %s %s", route.ComponentType, route.CurrentVersion)
+		}
+		routeKeys[key] = true
+		for _, phase := range route.Phases {
+			if phase.Order <= 0 || phase.Action == "" || phase.FromVersion == "" || phase.ToVersion == "" || len(phase.Gates) == 0 {
+				return fmt.Errorf("invalid phase in route for %s %s", route.ComponentType, route.CurrentVersion)
+			}
+			if orders[phase.Order] {
+				return fmt.Errorf("duplicate global phase order %d", phase.Order)
+			}
+			orders[phase.Order] = true
+		}
+	}
+	return nil
+}

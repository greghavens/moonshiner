+	if c == nil || c.baseURL == "" || c.httpClient == nil {
+		return report, errors.New("client is nil or uninitialized")
+	}
+	if len(changes) == 0 {
+		return report, nil
+	}
+	if ctx == nil {
+		return report, errors.New("context must not be nil")
+	}
+	if err := ctx.Err(); err != nil {
+		return report, err
+	}

+func validateSpec(spec MaintenanceScheduleSpec) error {
+	keyLength := utf8.RuneCountInString(spec.Key)
+	if keyLength < 1 || keyLength > 200 {
+		return errors.New("key length must be from 1 through 200 characters")
+	}
+	if spec.Schedule.Duration < 1 {
+		return errors.New("duration must be at least 1")
+	}
+	switch spec.Schedule.ScheduleType {
+	case "UNKNOWN", "ONCE", "DAILY", "WEEKLY", "MONTHLY", "YEARLY":
+	default:
+		return errors.New("scheduleType is not in the contract enum")
+	}
+	if spec.Schedule.Recurrence != nil && *spec.Schedule.Recurrence < 1 {
+		return errors.New("recurrence must be at least 1 when present")
+	}
+	return nil
+}

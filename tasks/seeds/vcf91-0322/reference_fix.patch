+def _prune(params: Optional[Dict[str, Any]]) -> Dict[str, Any]:
+    """Drop every parameter the caller left unset.
+
+    The contract requires an optional parameter that is not in use to be omitted from the
+    request rather than sent with an empty value, so anything that is None, or an empty
+    string, list or mapping, never reaches the wire.
+    """
+    kept = {}
+    for key, value in (params or {}).items():
+        if value is None:
+            continue
+        if isinstance(value, (str, list, tuple, dict, set)) and len(value) == 0:
+            continue
+        kept[key] = value
+    return kept
+

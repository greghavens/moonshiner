+#: An error log line opens with its level and then a dotted fault name.
+_FAULT_LINE = re.compile(r"^ERROR\s+(?P<code>[A-Za-z][\w]*(?:\.[\w]+)+)\s*:")
+
+#: A log that tells the operator to try again is describing a transient failure.
+_RETRYABLE = re.compile(r"\bretry\b", re.IGNORECASE)
+
+#: An explicit required change means a retry cannot succeed as-is.
+_CHANGE_REQUIRED = re.compile(
+    r"(?<!no )\bconfiguration change is required\b", re.IGNORECASE
+)
+
+
+def _find_fault(entries: List[Dict[str, Any]]):
+    """Return the (entry, fault code) of the first error line in a log, or (None, None)."""
+    for entry in entries:
+        match = _FAULT_LINE.match(entry.get("message") or "")
+        if match:
+            return entry, match.group("code")
+    return None, None
+
 

{
  "contract_version": 1,
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/vsan-data-protection/vsan-data-protection-openapi.yaml",
    "license": "Apache-2.0",
    "openapi": "3.0.3",
    "api_title": "Snapshot Appliance API",
    "api_version": "9.1.0.0"
  },
  "server": {
    "url_template": "https://{host}/api",
    "base_path": "/api"
  },
  "security": {
    "scheme": "api_key_auth",
    "type": "apiKey",
    "in": "header",
    "name": "vmware-api-session-id"
  },
  "async_task_protocol": {
    "description": "Operations whose operationId carries the $Task suffix are asynchronous. They accept the vmw-task=true query parameter and return 202 with a bare JSON string task identifier. The task identifier must be polled with Snapservice.Tasks_get until the reported status is terminal; the 202 response never implies the work finished.",
    "task_query_parameter": {
      "name": "vmw-task",
      "value": "true",
      "required": true
    },
    "accepted_status": 202,
    "accepted_body": {
      "type": "string",
      "description": "Identifier for the resource type com.vmware.snapservice.task."
    },
    "poll_with": "Snapservice.Tasks_get",
    "status_values": ["PENDING", "RUNNING", "BLOCKED", "SUCCEEDED", "FAILED"],
    "non_terminal_status_values": ["PENDING", "RUNNING", "BLOCKED"],
    "terminal_status_values": ["SUCCEEDED", "FAILED"],
    "success_status_value": "SUCCEEDED",
    "failure_status_value": "FAILED"
  },
  "wire_rules": {
    "omit_unset_optional_properties": true,
    "omit_unset_optional_query_parameters": true,
    "notes": "An optional request-body property that the caller did not set is absent from the serialized JSON object. It is never encoded as null, as an empty string, or as an empty object. An optional query parameter that the caller did not set is absent from the query string. It is never encoded as a bare name or as name= with an empty value."
  },
  "operations": [
    {
      "operationId": "Snapservice.Clusters.ProtectionGroups_list",
      "method": "GET",
      "path": "/api/snapservice/clusters/{cluster}/protection-groups",
      "spec_path_template": "/snapservice/clusters/{cluster}/protection-groups",
      "security": ["api_key_auth"],
      "parameters": [
        {
          "name": "cluster",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        },
        {
          "name": "pgs",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        },
        {
          "name": "names",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        },
        {
          "name": "states",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        },
        {
          "name": "vms",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        },
        {
          "name": "cluster_pairs",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        }
      ],
      "request_body": null,
      "success": {
        "status": 200,
        "schema": "Snapservice.Clusters.ProtectionGroups.ListResult",
        "required": ["items"]
      }
    },
    {
      "operationId": "Snapservice.Clusters.ProtectionGroups.Snapshots_create$Task",
      "method": "POST",
      "path": "/api/snapservice/clusters/{cluster}/protection-groups/{pg}/snapshots",
      "spec_path_template": "/snapservice/clusters/{cluster}/protection-groups/{pg}/snapshots?vmw-task=true",
      "asynchronous": true,
      "security": ["api_key_auth"],
      "parameters": [
        {
          "name": "cluster",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        },
        {
          "name": "pg",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        },
        {
          "name": "vmw-task",
          "in": "query",
          "required": true,
          "schema": { "type": "string", "enum": ["true"] }
        }
      ],
      "request_body": {
        "required": true,
        "content_type": "application/json",
        "schema": "Snapservice.Clusters.ProtectionGroups.Snapshots.CreateSpec",
        "properties": {
          "name": {
            "type": "string",
            "required": true
          },
          "retention": {
            "type": "object",
            "required": false,
            "schema": "Snapservice.RetentionPeriod",
            "omit_when_unset": true,
            "properties": {
              "unit": {
                "type": "string",
                "required": true,
                "enum": ["MINUTE", "HOUR", "DAY", "WEEK", "MONTH", "YEAR"]
              },
              "duration": {
                "type": "integer",
                "format": "int64",
                "required": true
              }
            },
            "notes": "If missing or null the snapshot is retained for the life of the cluster or protection group. The unset case is expressed by omitting the property."
          }
        },
        "additional_properties": false
      },
      "success": {
        "status": 202,
        "schema": { "type": "string" },
        "description": "Task identifier to poll with Snapservice.Tasks_get."
      }
    },
    {
      "operationId": "Snapservice.Tasks_get",
      "method": "GET",
      "path": "/api/snapservice/tasks/{task}",
      "spec_path_template": "/snapservice/tasks/{task}",
      "security": ["api_key_auth"],
      "parameters": [
        {
          "name": "task",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "request_body": null,
      "success": {
        "status": 200,
        "schema": "Snapservice.Tasks.Info",
        "required": ["cancelable", "description", "operation", "service", "status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["PENDING", "RUNNING", "BLOCKED", "SUCCEEDED", "FAILED"]
          },
          "description": { "schema": "Vapi.Std.LocalizableMessage" },
          "progress": { "schema": "Snapservice.Tasks.Progress", "required": false },
          "result": { "required": false },
          "error": { "type": "object", "required": false },
          "start_time": { "type": "string", "format": "date-time", "required": false },
          "end_time": { "type": "string", "format": "date-time", "required": false }
        }
      }
    },
    {
      "operationId": "Snapservice.Clusters.ProtectionGroups.Snapshots_get",
      "method": "GET",
      "path": "/api/snapservice/clusters/{cluster}/protection-groups/{pg}/snapshots/{snapshot}",
      "spec_path_template": "/snapservice/clusters/{cluster}/protection-groups/{pg}/snapshots/{snapshot}",
      "security": ["api_key_auth"],
      "parameters": [
        {
          "name": "cluster",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        },
        {
          "name": "pg",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        },
        {
          "name": "snapshot",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "request_body": null,
      "success": {
        "status": 200,
        "schema": "Snapservice.Clusters.ProtectionGroups.Snapshots.Info",
        "required": ["end_time", "name", "pg", "snapshot_type", "start_time", "vm_snapshots"]
      }
    }
  ],
  "errors": {
    "400": "Vapi.Std.Errors.InvalidArgument",
    "401": "Vapi.Std.Errors.Unauthenticated",
    "403": "Vapi.Std.Errors.Unauthorized",
    "404": "Vapi.Std.Errors.NotFound",
    "500": "Vapi.Std.Errors.Error",
    "503": "Vapi.Std.Errors.ServiceUnavailable"
  }
}

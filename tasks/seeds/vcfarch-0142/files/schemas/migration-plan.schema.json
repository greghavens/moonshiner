{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/vcf-migration-plan-1.0.json",
  "title": "VCF mixed-estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "estate_id",
    "objective",
    "compatibility_snapshot_id",
    "target_sddc_spec",
    "gates",
    "components",
    "steps",
    "workload_migrations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "estate_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "const": "add-workload-domain"
    },
    "compatibility_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "target_sddc_spec": {
      "type": "object"
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/gate"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/component"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/step"
      }
    },
    "workload_migrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/workloadMigration"
      }
    }
  },
  "definitions": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "initial"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "kind": {
          "enum": [
            "constraint",
            "compatibility",
            "readiness",
            "handoff"
          ]
        },
        "initial": {
          "type": "boolean"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "current_version",
        "target_version",
        "disposition",
        "gates"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "current_version": {
          "type": "string",
          "minLength": 1
        },
        "target_version": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "retain",
            "deploy",
            "retire"
          ]
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "id",
        "action",
        "component_ids",
        "requires",
        "satisfies"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "action": {
          "enum": [
            "deploy",
            "validate",
            "quiesce",
            "export",
            "import",
            "cutover",
            "retire",
            "upgrade"
          ]
        },
        "component_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "requires": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "satisfies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "workloadMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workload_id",
        "method",
        "source_component_ids",
        "target_component_ids",
        "gates"
      ],
      "properties": {
        "workload_id": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "source_component_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "target_component_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

+from __future__ import annotations
+
+from typing import Any
+
+
+def _target_sddc_spec(inventory: dict[str, Any], compatibility: dict[str, Any]) -> dict[str, Any]:
+    desired = inventory["desired_change"]
+    design = inventory["target_design"]
+    bom = compatibility["target_bom"]
+    return {
+        "sddcId": desired["workload_domain_id"],
+        "version": bom["vcf_version"],
+        "vcenterSpec": {
+            "vcenterHostname": design["vcenter_hostname"],
+            "rootVcenterPassword": "NotASecret9!Ref",
+            "version": bom["components"]["vcenter"],
+        },
+        "hostSpecs": [{"hostname": hostname} for hostname in design["hostnames"]],
+        "networkSpecs": [
+            {
+                "networkType": network["network_type"],
+                "vlanId": network["vlan_id"],
+                "subnet": network["subnet"],
+                "gateway": network["gateway"],
+                "mtu": network["mtu"],
+            }
+            for network in design["networks"]
+        ],
+        "dnsSpec": {"subdomain": design["dns_subdomain"]},
+        "ntpServers": design["ntp_servers"],
+        "nsxtSpec": {
+            "vipFqdn": design["nsx_vip_fqdn"],
+            "nsxtManagers": [{"hostname": hostname} for hostname in design["nsx_manager_hostnames"]],
+            "version": bom["components"]["nsx"],
+        },
+    }
+
+
+def _component_plan(inventory: dict[str, Any], compatibility: dict[str, Any]) -> list[dict[str, Any]]:
+    bom = compatibility["target_bom"]["components"]
+    rows: list[dict[str, Any]] = []
+    for component in inventory["components"]:
+        current = component["current_version"]
+        if component["domain"] == "management":
+            disposition = "retain"
+            target = current
+            gates = ["management-domain-frozen"]
+        elif current == "absent":
+            disposition = "deploy"
+            target = bom[component["type"]]
+            gates = ["target-bom-compatible", "target-validated"]
+        else:
+            disposition = "retire"
+            target = "retired"
+            gates = ["source-quiesced", "cutover-accepted"]
+        rows.append(
+            {
+                "id": component["id"],
+                "current_version": current,
+                "target_version": target,
+                "disposition": disposition,
+                "gates": gates,
+            }
+        )
+    return rows
+
+
+def build_plan(inventory: dict[str, Any], compatibility: dict[str, Any]) -> dict[str, Any]:
+    legacy_ids = [
+        component["id"]
+        for component in inventory["components"]
+        if component["domain"] != "management" and component["current_version"] != "absent"
+    ]
+    target_ids = [
+        component["id"] for component in inventory["components"] if component["current_version"] == "absent"
+    ]
+    gates = [
+        {"id": "management-domain-frozen", "kind": "constraint", "initial": True},
+        {"id": "target-bom-compatible", "kind": "compatibility", "initial": True},
+        {"id": "target-deployed", "kind": "readiness", "initial": False},
+        {"id": "target-validated", "kind": "readiness", "initial": False},
+        {"id": "source-quiesced", "kind": "readiness", "initial": False},
+        {"id": "export-complete", "kind": "handoff", "initial": False},
+        {"id": "import-complete", "kind": "handoff", "initial": False},
+        {"id": "cutover-accepted", "kind": "handoff", "initial": False},
+        {"id": "source-retired", "kind": "readiness", "initial": False},
+    ]
+    steps = [
+        {
+            "order": 1,
+            "id": "deploy-parallel-domain",
+            "action": "deploy",
+            "component_ids": target_ids,
+            "requires": ["management-domain-frozen", "target-bom-compatible"],
+            "satisfies": ["target-deployed"],
+        },
+        {
+            "order": 2,
+            "id": "validate-parallel-domain",
+            "action": "validate",
+            "component_ids": target_ids,
+            "requires": ["target-deployed"],
+            "satisfies": ["target-validated"],
+        },
+        {
+            "order": 3,
+            "id": "quiesce-source-domain",
+            "action": "quiesce",
+            "component_ids": legacy_ids,
+            "requires": ["target-validated"],
+            "satisfies": ["source-quiesced"],
+        },
+        {
+            "order": 4,
+            "id": "export-source-workloads",
+            "action": "export",
+            "component_ids": legacy_ids,
+            "requires": ["source-quiesced"],
+            "satisfies": ["export-complete"],
+        },
+        {
+            "order": 5,
+            "id": "import-target-workloads",
+            "action": "import",
+            "component_ids": target_ids,
+            "requires": ["export-complete", "target-validated"],
+            "satisfies": ["import-complete"],
+        },
+        {
+            "order": 6,
+            "id": "cutover-to-parallel-domain",
+            "action": "cutover",
+            "component_ids": legacy_ids + target_ids,
+            "requires": ["import-complete"],
+            "satisfies": ["cutover-accepted"],
+        },
+        {
+            "order": 7,
+            "id": "retire-source-domain",
+            "action": "retire",
+            "component_ids": legacy_ids,
+            "requires": ["cutover-accepted"],
+            "satisfies": ["source-retired"],
+        },
+    ]
+    migrations = [
+        {
+            "workload_id": workload["id"],
+            "method": compatibility["supported_route"]["migration_method"],
+            "source_component_ids": legacy_ids,
+            "target_component_ids": target_ids,
+            "gates": ["target-validated", "source-quiesced", "cutover-accepted"],
+        }
+        for workload in inventory["workloads"]
+    ]
+    return {
+        "schema_version": "1.0",
+        "estate_id": inventory["estate_id"],
+        "objective": "add-workload-domain",
+        "compatibility_snapshot_id": compatibility["snapshot_id"],
+        "target_sddc_spec": _target_sddc_spec(inventory, compatibility),
+        "gates": gates,
+        "components": _component_plan(inventory, compatibility),
+        "steps": steps,
+        "workload_migrations": migrations,
+    }

 // Requests returns a deep copy of the request log.
 func (s *Server) Requests() []Request {
-	return nil
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	out := make([]Request, len(s.log))
+	for i, request := range s.log {
+		out[i] = request
+		out[i].Header = request.Header.Clone()
+		out[i].Body = append([]byte(nil), request.Body...)
+	}
+	return out
+}
+
+func (s *Server) handle(w http.ResponseWriter, r *http.Request) {
+	if r.Body == nil {
+		r.Body = http.NoBody
+	}
+	body, err := io.ReadAll(io.LimitReader(r.Body, 1<<20))
+	if err != nil {
+		http.Error(w, "request body could not be read", http.StatusBadRequest)
+		return
+	}
+	operationID := ""
+	var matched *operation
+	for i := range s.routes {
+		route := &s.routes[i]
+		if r.Method == route.Method && matchPath(route.fullPath, r.URL.Path) {
+			matched = route
+			operationID = route.OperationID
+			break
+		}
+	}
+
+	s.mu.Lock()
+	s.log = append(s.log, Request{
+		OperationID: operationID,
+		Method:      r.Method,
+		RequestURI:  r.URL.RequestURI(),
+		Header:      r.Header.Clone(),
+		Body:        append([]byte(nil), body...),
+	})
+	s.mu.Unlock()
+
+	if matched == nil {
+		http.NotFound(w, r)
+		return
+	}
+	if s.failure != nil && s.failure.OperationID == matched.OperationID && s.failure.Path == r.URL.Path {
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(s.failure.Status)
+		_ = json.NewEncoder(w).Encode(map[string]any{
+			"error_code":    s.failure.ErrorCode,
+			"error_message": s.failure.Message,
+			"module_name":   s.failure.ModuleName,
+		})
+		return
+	}
+	w.WriteHeader(matched.SuccessStatus)
+}
+
+func matchPath(template, path string) bool {
+	templateParts := strings.Split(strings.Trim(template, "/"), "/")
+	pathParts := strings.Split(strings.Trim(path, "/"), "/")
+	if len(templateParts) != len(pathParts) {
+		return false
+	}
+	for i := range templateParts {
+		part := templateParts[i]
+		if strings.HasPrefix(part, "{") && strings.HasSuffix(part, "}") {
+			if pathParts[i] == "" {
+				return false
+			}
+			continue
+		}
+		if part != pathParts[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func containsStatus(statuses []int, status int) bool {
+	for _, candidate := range statuses {
+		if candidate == status {
+			return true
+		}
+	}
+	return false
+}
+
+func startLoopback(handler http.Handler) (server *httptest.Server) {
+	defer func() {
+		if recover() != nil {
+			server = nil
+		}
+	}()
+	return httptest.NewServer(handler)
+}
+
+type roundTripFunc func(*http.Request) (*http.Response, error)
+
+func (fn roundTripFunc) RoundTrip(req *http.Request) (*http.Response, error) {
+	return fn(req)
 }

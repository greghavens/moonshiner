+		return 0, fmt.Errorf("%s: encode request: %w", operationID, err)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPatch, c.baseURL+path, bytes.NewReader(payload))
+	if err != nil {
+		return 0, fmt.Errorf("%s: build request: %w", operationID, err)
+	}
+	req.Header.Set("Accept", "application/json")

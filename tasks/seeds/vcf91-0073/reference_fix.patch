--- a/change.go
+++ b/change.go
@@ -1,6 +1,15 @@
 package nsxchange
 
-import "context"
+import (
+	"context"
+	"fmt"
+	"net/url"
+)
+
+const (
+	patchGroupForDomain          = "PatchGroupForDomain"
+	patchSecurityPolicyForDomain = "PatchSecurityPolicyForDomain"
+)
 
 type GroupChange struct {
 	ID          string
@@ -45,5 +54,67 @@ type Report struct {
 
 // Apply applies source group, destination group, and security policy in order.
 func (c *Client) Apply(ctx context.Context, change Change) (Report, error) {
-	return Report{}, ErrNotImplemented
+	domainID := url.PathEscape(change.DomainID)
+	sourceID := url.PathEscape(change.SourceGroup.ID)
+	destinationID := url.PathEscape(change.DestinationGroup.ID)
+	policyID := url.PathEscape(change.Policy.ID)
+
+	sourcePath := fmt.Sprintf("/policy/api/v1/infra/domains/%s/groups/%s", domainID, sourceID)
+	destinationPath := fmt.Sprintf("/policy/api/v1/infra/domains/%s/groups/%s", domainID, destinationID)
+	policyPath := fmt.Sprintf("/policy/api/v1/infra/domains/%s/security-policies/%s", domainID, policyID)
+
+	report := Report{Steps: make([]StepResult, 0, 3)}
+	apply := func(name, operationID, path string, body any) error {
+		status, err := c.patch(ctx, operationID, path, body)
+		step := StepResult{
+			Name: name, OperationID: operationID, ResourcePath: path,
+			Status: StepApplied, HTTPStatus: status,
+		}
+		if err != nil {
+			step.Status = StepFailed
+		}
+		report.Steps = append(report.Steps, step)
+		return err
+	}
+
+	if err := apply("source-group", patchGroupForDomain, sourcePath, groupBody(change.SourceGroup)); err != nil {
+		return report, err
+	}
+	if err := apply("destination-group", patchGroupForDomain, destinationPath, groupBody(change.DestinationGroup)); err != nil {
+		return report, err
+	}
+
+	groupPrefix := fmt.Sprintf("/infra/domains/%s/groups/", domainID)
+	policy := SecurityPolicy{
+		DisplayName: change.Policy.DisplayName,
+		Category:    change.Policy.Category,
+		Rules: []Rule{
+			{
+				DisplayName:       change.Policy.RuleDisplayName,
+				Action:            "ALLOW",
+				SourceGroups:      []string{groupPrefix + sourceID},
+				DestinationGroups: []string{groupPrefix + destinationID},
+				Services:          []string{change.Policy.ServicePath},
+			},
+		},
+	}
+	if err := apply("security-policy", patchSecurityPolicyForDomain, policyPath, policy); err != nil {
+		return report, err
+	}
+	return report, nil
+}
+
+func groupBody(change GroupChange) Group {
+	return Group{
+		DisplayName: change.DisplayName,
+		Expression: []Condition{
+			{
+				ResourceType: "Condition",
+				MemberType:   "VirtualMachine",
+				Key:          "Tag",
+				Operator:     "EQUALS",
+				Value:        change.TagScope + "|" + change.TagValue,
+			},
+		},
+	}
 }

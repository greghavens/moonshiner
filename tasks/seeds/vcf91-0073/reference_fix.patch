+		return nil, fmt.Errorf("nsxmock: decode contract: %w", err)
+	}
+	if spec.BasePath == "" || len(spec.Operations) == 0 {
+		return nil, fmt.Errorf("nsxmock: contract has no routes")
+	}
+
+	seen := make(map[string]struct{}, len(spec.Operations))
+	for i := range spec.Operations {
+		route := &spec.Operations[i]
+		if route.OperationID == "" || route.Method == "" || route.Path == "" || route.SuccessStatus == 0 {
+			return nil, fmt.Errorf("nsxmock: incomplete contract operation")
+		}
+		if _, duplicate := seen[route.OperationID]; duplicate {
+			return nil, fmt.Errorf("nsxmock: duplicate operationId %q", route.OperationID)

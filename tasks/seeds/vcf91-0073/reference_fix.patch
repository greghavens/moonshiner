 func (c *Client) patch(ctx context.Context, operationID, path string, body any) (int, error) {
-	return 0, ErrNotImplemented
+	payload, err := json.Marshal(body)
+	if err != nil {
+		return 0, fmt.Errorf("%s: encode request: %w", operationID, err)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPatch, c.baseURL+path, bytes.NewReader(payload))
+	if err != nil {
+		return 0, fmt.Errorf("%s: build request: %w", operationID, err)
+	}
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("Content-Type", "application/json")
+
+	resp, err := c.http.Do(req)
+	if err != nil {
+		return 0, fmt.Errorf("%s: send request: %w", operationID, err)
+	}
+	defer resp.Body.Close()
+	responseBody, readErr := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
+	if readErr != nil {
+		return resp.StatusCode, fmt.Errorf("%s: read response: %w", operationID, readErr)
+	}
+	if resp.StatusCode >= 200 && resp.StatusCode < 300 {
+		return resp.StatusCode, nil
+	}
+
+	apiErr := &APIError{OperationID: operationID, StatusCode: resp.StatusCode}
+	if len(responseBody) != 0 {
+		_ = json.Unmarshal(responseBody, apiErr)
+	}
+	if apiErr.Message == "" {
+		apiErr.Message = strings.TrimSpace(string(responseBody))
+	}
+	if apiErr.Message == "" {
+		apiErr.Message = http.StatusText(resp.StatusCode)
+	}
+	return resp.StatusCode, apiErr
 }

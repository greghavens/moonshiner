     def ensure_policy(self, *, policy_id, type_id, name, definition, description=None,
                       enforcement_type=None, project_id=None, org_id=None):
         """Converge one policy to the requested state, safely retryable.
 
         Returns the stored Policy object read back from the appliance.
+
+        The mutation is a create-or-update keyed on the caller's ``policy_id``,
+        which travels in the request body's ``id`` field on every attempt. That
+        is what makes a retry after a lost response converge on the same policy
+        instead of leaving a second one behind. Fields the caller left unset are
+        omitted from the body entirely.
+        """
+        self.get_policy_type(type_id)
+
+        body = {
+            "id": policy_id,
+            "typeId": type_id,
+            "name": name,
+            "definition": definition,
+        }
+        supplied = {
+            "description": description,
+            "enforcement_type": enforcement_type,
+            "project_id": project_id,
+            "org_id": org_id,
+        }
+        for keyword, field in _OPTIONAL_FIELDS:
+            if supplied[keyword] is not None:
+                body[field] = supplied[keyword]
+
+        self._request("POST", POLICIES_PATH, body=body)
+        return self.get_policy(policy_id)
+

+// Package nsxpolicy implements the small NSX Policy API surface used by the
+// VCF segment inventory collector.
+package nsxpolicy
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+const listAllInfraSegmentsPath = "/policy/api/v1/infra/segments"
+
+var ErrRepeatedCursor = errors.New("nsxpolicy: repeated pagination cursor")
+
+type Config struct {
+	BaseURL    string
+	Username   string
+	Password   string
+	HTTPClient *http.Client
+}
+
+type ListOptions struct {
+	PageSize                      int64
+	SegmentType                   string
+	IncludeMarkedForDeleteObjects *bool
+	IncludedFields                string
+}
+
+type Segment struct {
+	ID          string `json:"id"`
+	DisplayName string `json:"display_name"`
+	Path        string `json:"path"`
+}
+
+type Client struct {
+	baseURL  string
+	username string
+	password string
+	http     *http.Client
+}
+
+func NewClient(config Config) (*Client, error) {
+	base, err := url.Parse(config.BaseURL)
+	if err != nil || !base.IsAbs() || base.Host == "" {
+		return nil, errors.New("nsxpolicy: BaseURL must be an absolute URL")
+	}
+	if base.RawQuery != "" || base.Fragment != "" {
+		return nil, errors.New("nsxpolicy: BaseURL must not contain a query or fragment")
+	}
+	httpClient := config.HTTPClient
+	if httpClient == nil {
+		httpClient = http.DefaultClient
+	}
+	return &Client{
+		baseURL:  strings.TrimRight(config.BaseURL, "/"),
+		username: config.Username,
+		password: config.Password,
+		http:     httpClient,
+	}, nil
+}
+
+func (c *Client) ListAllSegments(ctx context.Context, options ListOptions) ([]Segment, error) {
+	if err := validateListOptions(options); err != nil {
+		return nil, err
+	}
+
+	query := url.Values{
+		"sort_by":        {"display_name"},
+		"sort_ascending": {"true"},
+	}
+	if options.PageSize > 0 {
+		query.Set("page_size", strconv.FormatInt(options.PageSize, 10))
+	}
+	if options.SegmentType != "" {
+		query.Set("segment_type", options.SegmentType)
+	}
+	if options.IncludeMarkedForDeleteObjects != nil {
+		query.Set("include_mark_for_delete_objects", strconv.FormatBool(*options.IncludeMarkedForDeleteObjects))
+	}
+	if options.IncludedFields != "" {
+		query.Set("included_fields", options.IncludedFields)
+	}
+
+	var segments []Segment
+	sentCursor := ""
+	for {
+		if sentCursor == "" {
+			query.Del("cursor")
+		} else {
+			query.Set("cursor", sentCursor)
+		}
+		page, err := c.listPage(ctx, query.Encode())
+		if err != nil {
+			return nil, err
+		}
+		segments = append(segments, page.Results...)
+		if page.Cursor == "" {
+			break
+		}
+		if page.Cursor == sentCursor {
+			return nil, fmt.Errorf("cursor %q: %w", page.Cursor, ErrRepeatedCursor)
+		}
+		sentCursor = page.Cursor
+	}
+
+	sort.SliceStable(segments, func(i, j int) bool {
+		if segments[i].DisplayName != segments[j].DisplayName {
+			return segments[i].DisplayName < segments[j].DisplayName
+		}
+		return segments[i].ID < segments[j].ID
+	})
+	return segments, nil
+}
+
+func validateListOptions(options ListOptions) error {
+	if options.PageSize < 0 || options.PageSize > 1000 {
+		return fmt.Errorf("nsxpolicy: PageSize %d is outside 0..1000", options.PageSize)
+	}
+	switch options.SegmentType {
+	case "", "DVPortgroup", "ALL":
+		return nil
+	default:
+		return fmt.Errorf("nsxpolicy: unsupported SegmentType %q", options.SegmentType)
+	}
+}
+
+type segmentPage struct {
+	Results []Segment `json:"results"`
+	Cursor  string    `json:"cursor"`
+}
+
+func (c *Client) listPage(ctx context.Context, rawQuery string) (segmentPage, error) {
+	requestURL := c.baseURL + listAllInfraSegmentsPath + "?" + rawQuery
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, requestURL, nil)
+	if err != nil {
+		return segmentPage{}, fmt.Errorf("list NSX Policy segments: %w", err)
+	}
+	request.Header.Set("Accept", "application/json")
+	request.SetBasicAuth(c.username, c.password)
+
+	response, err := c.http.Do(request)
+	if err != nil {
+		return segmentPage{}, fmt.Errorf("list NSX Policy segments: %w", err)
+	}
+	defer response.Body.Close()
+
+	body := io.LimitReader(response.Body, 4<<20)
+	if response.StatusCode < 200 || response.StatusCode >= 300 {
+		data, _ := io.ReadAll(body)
+		return segmentPage{}, fmt.Errorf(
+			"list NSX Policy segments: HTTP %d: %s",
+			response.StatusCode,
+			strings.TrimSpace(string(data)),
+		)
+	}
+	var page segmentPage
+	if err := json.NewDecoder(body).Decode(&page); err != nil {
+		return segmentPage{}, fmt.Errorf("decode NSX Policy segment page: %w", err)
+	}
+	return page, nil
+}

{
  "contractVersion": "1.0.0",
  "description": "Wire contract for the VCF Operations calls made by the VcfOpsActionRunner module. Every field below is derived from the OpenAPI document identified in `source`; see docs/official_sources.json for the JSON Pointer behind each fact. The loopback mock in tests/mock serves exactly the operations listed here and nothing else, and tests/Verify-Contract.ps1 asserts requests against this file.",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "commitSha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "specPath": "specifications/vcf-operations/vcf-operations-openapi.json",
    "openapiVersion": "3.0.1",
    "license": "Apache-2.0"
  },
  "basePath": "/suite-api",
  "auth": {
    "securityScheme": "Token-based-authorization",
    "in": "header",
    "header": "Authorization",
    "valuePrefix": "OpsToken ",
    "valuePrefixIsSpecDerived": false,
    "unauthenticatedOperations": ["acquireToken"]
  },
  "serialization": {
    "requestContentType": "application/json",
    "acceptHeader": "application/json",
    "optionalFieldPolicy": "omit",
    "optionalFieldPolicyNote": "A property that is not in a schema's `required` list and that the caller did not supply MUST NOT appear in the request body at all. Emitting it as null, as an empty string, or as an empty array is a contract violation, because the server cannot distinguish 'not supplied' from 'supplied as empty'. The same rule applies to optional query parameters: an unsupplied optional query parameter MUST be absent from the query string rather than sent with its schema default."
  },
  "operations": {
    "acquireToken": {
      "operationId": "acquireToken",
      "method": "POST",
      "path": "/api/auth/token/acquire",
      "authenticated": false,
      "requestSchema": "username-password",
      "responseSchema": "auth-token",
      "issuedBy": "Connect-VcfOpsServer",
      "composedByModuleUnderTest": false
    },
    "getCurrentVersionOfServer": {
      "operationId": "getCurrentVersionOfServer",
      "method": "GET",
      "path": "/api/versions/current",
      "authenticated": true,
      "responseSchema": "version",
      "issuedBy": "Connect-VcfOpsServer",
      "composedByModuleUnderTest": false
    },
    "performAction": {
      "operationId": "performAction",
      "method": "POST",
      "path": "/api/actions/{id}",
      "authenticated": true,
      "pathParameters": [
        {
          "name": "id",
          "required": true,
          "type": "string"
        }
      ],
      "queryParameters": [],
      "requestSchema": "action-execution",
      "responseSchema": "str-values",
      "issuedBy": "Invoke-VcfOpsPerformAction",
      "composedByModuleUnderTest": true,
      "asyncNote": "A 200 response carries only the identifiers of the tasks that were started. It is NOT a completion signal; the caller must poll getActionStatus."
    },
    "getActionStatus": {
      "operationId": "getActionStatus",
      "method": "GET",
      "path": "/api/actions/{taskId}/status",
      "authenticated": true,
      "pathParameters": [
        {
          "name": "taskId",
          "required": true,
          "type": "string",
          "note": "Must be a value taken from the `values` array of the performAction response."
        }
      ],
      "queryParameters": [
        {
          "name": "detail",
          "required": false,
          "type": "boolean",
          "specDefault": false,
          "omitWhenUnset": true
        }
      ],
      "responseSchema": "action-status-info",
      "issuedBy": "Invoke-VcfOpsGetActionStatus",
      "composedByModuleUnderTest": true
    }
  },
  "schemas": {
    "username-password": {
      "required": ["username", "password"],
      "optional": ["authSource"]
    },
    "auth-token": {
      "required": ["token", "validity"],
      "optional": ["expiresAt", "roles"]
    },
    "action-execution": {
      "required": ["parameterGroup"],
      "optional": ["contextId", "contextResourceId"],
      "properties": {
        "contextId": {
          "type": "string"
        },
        "contextResourceId": {
          "type": "array",
          "itemFormat": "uuid"
        },
        "parameterGroup": {
          "type": "array",
          "items": "action-parameter-group"
        }
      }
    },
    "action-parameter-group": {
      "required": ["resourceId"],
      "optional": ["parameterValue"],
      "properties": {
        "resourceId": {
          "type": "string",
          "format": "uuid"
        },
        "parameterValue": {
          "type": "array",
          "items": "name-value"
        }
      }
    },
    "name-value": {
      "required": ["name", "value"],
      "optional": []
    },
    "str-values": {
      "required": [],
      "optional": ["values"],
      "properties": {
        "values": {
          "type": "array",
          "items": "string"
        }
      }
    },
    "action-status-info": {
      "required": ["taskId"],
      "optional": [
        "name",
        "state",
        "resourceKind",
        "submittedBy",
        "authSource",
        "startDate",
        "completeDate",
        "actionResult",
        "messages",
        "triggeredAutomatically",
        "triggeringSource",
        "triggeringEventId",
        "triggeringEventName",
        "triggeringSourceEvent",
        "actionObjectStatuses"
      ]
    }
  },
  "asyncPolling": {
    "submitOperation": "performAction",
    "taskIdSource": "performAction response body, `values[0]`",
    "pollOperation": "getActionStatus",
    "stateField": "state",
    "matching": "case-insensitive",
    "vocabularyNote": "action-status-info.state is an unenumerated string in this specification file. The values below are the asynchronous-task state literals the same file does define, plus the literal used in the getActionStatus response example. Each carries its origin. A state that is not listed here is treated as non-terminal.",
    "states": [
      {
        "value": "INITIATED",
        "terminal": false,
        "origin": "enum:/components/schemas/task-status/properties/taskState/enum"
      },
      {
        "value": "RUNNING",
        "terminal": false,
        "origin": "enum:/components/schemas/task-status/properties/taskState/enum"
      },
      {
        "value": "STOPPED",
        "terminal": false,
        "origin": "enum:/components/schemas/task-status/properties/taskState/enum"
      },
      {
        "value": "NO_DISPATCH",
        "terminal": false,
        "origin": "enum:/components/schemas/rebalance-task/properties/state/enum"
      },
      {
        "value": "Completed",
        "terminal": true,
        "succeeded": true,
        "origin": "example:/paths/~1api~1actions~1{taskId}~1status/get/responses/200/content/application~1json/example"
      },
      {
        "value": "COMPLETED_SUCCESSFULLY",
        "terminal": true,
        "succeeded": true,
        "origin": "enum:/components/schemas/rebalance-task/properties/state/enum"
      },
      {
        "value": "FINISHED",
        "terminal": true,
        "succeeded": true,
        "origin": "enum:/components/schemas/task-status/properties/taskState/enum"
      },
      {
        "value": "PARTIAL_SUCCESS",
        "terminal": true,
        "succeeded": false,
        "origin": "enum:/components/schemas/rebalance-task/properties/state/enum"
      },
      {
        "value": "FAILED",
        "terminal": true,
        "succeeded": false,
        "origin": "enum:/components/schemas/rebalance-task/properties/state/enum"
      },
      {
        "value": "ERROR",
        "terminal": true,
        "succeeded": false,
        "origin": "enum:/components/schemas/task-status/properties/taskState/enum"
      },
      {
        "value": "ABORTED",
        "terminal": true,
        "succeeded": false,
        "origin": "enum:/components/schemas/task-status/properties/taskState/enum"
      },
      {
        "value": "CANCELLED",
        "terminal": true,
        "succeeded": false,
        "origin": "enum:/components/schemas/rebalance-task/properties/state/enum"
      },
      {
        "value": "TIME_OUT",
        "terminal": true,
        "succeeded": false,
        "origin": "enum:/components/schemas/rebalance-task/properties/state/enum"
      },
      {
        "value": "UNKNOWN",
        "terminal": false,
        "origin": "enum:/components/schemas/task-status/properties/taskState/enum"
      }
    ]
  }
}

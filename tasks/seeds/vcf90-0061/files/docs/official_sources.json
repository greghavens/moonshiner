{
  "description": "Provenance for every normative fact encoded in docs/contract.json. Each operationId below is used by the VcfOpsActionRunner module and is served by the loopback contract mock.",
  "sources": [
    {
      "id": "vcf-api-specs@9.0.0.0:vcf-operations-openapi",
      "kind": "openapi-specification",
      "title": "VMware Cloud Foundation Operations API",
      "repository": "https://github.com/vmware/vcf-api-specs",
      "tag": "9.0.0.0",
      "commitSha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
      "commitDate": "2025-06-18T08:48:39Z",
      "specPath": "specifications/vcf-operations/vcf-operations-openapi.json",
      "rawUrl": "https://raw.githubusercontent.com/vmware/vcf-api-specs/85151f6b1bb58f13b6ac0304bfec53904bea085f/specifications/vcf-operations/vcf-operations-openapi.json",
      "blobSha": "622d099b91f5944cc5a5abe6dd4830501220486a",
      "sizeBytes": 2189433,
      "sha256": "e5c7bac42fcde67011f8f880144b1a5c690e737380f5275e694be29bb545dd0e",
      "openapiVersion": "3.0.1",
      "license": "Apache-2.0",
      "licenseUrl": "https://github.com/vmware/vcf-api-specs/blob/85151f6b1bb58f13b6ac0304bfec53904bea085f/LICENSE",
      "serverBasePath": {
        "value": "/suite-api",
        "jsonPointer": "/servers/0/url"
      },
      "securityScheme": {
        "name": "Token-based-authorization",
        "jsonPointer": "/components/securitySchemes/Token-based-authorization",
        "type": "apiKey",
        "in": "header",
        "header": "Authorization"
      },
      "operationIds": [
        {
          "operationId": "acquireToken",
          "method": "POST",
          "path": "/api/auth/token/acquire",
          "jsonPointer": "/paths/~1api~1auth~1token~1acquire/post/operationId",
          "requestSchema": "username-password",
          "responseSchema": "auth-token",
          "usedFor": "Session establishment performed by Connect-VcfOpsServer before any action call."
        },
        {
          "operationId": "getCurrentVersionOfServer",
          "method": "GET",
          "path": "/api/versions/current",
          "jsonPointer": "/paths/~1api~1versions~1current/get/operationId",
          "responseSchema": "version",
          "usedFor": "Product-version probe performed by Connect-VcfOpsServer immediately after the token exchange."
        },
        {
          "operationId": "performAction",
          "method": "POST",
          "path": "/api/actions/{id}",
          "jsonPointer": "/paths/~1api~1actions~1{id}/post/operationId",
          "requestSchema": "action-execution",
          "responseSchema": "str-values",
          "usedFor": "Submits the action. Returns the task identifiers of the asynchronous run; it does NOT mean the action finished."
        },
        {
          "operationId": "getActionStatus",
          "method": "GET",
          "path": "/api/actions/{taskId}/status",
          "jsonPointer": "/paths/~1api~1actions~1{taskId}~1status/get/operationId",
          "responseSchema": "action-status-info",
          "usedFor": "Polls the task identifier returned by performAction until the action reaches a terminal state."
        }
      ],
      "schemaPointers": [
        {
          "schema": "action-execution",
          "jsonPointer": "/components/schemas/action-execution",
          "required": ["parameterGroup"],
          "optional": ["contextId", "contextResourceId"]
        },
        {
          "schema": "action-parameter-group",
          "jsonPointer": "/components/schemas/action-parameter-group",
          "required": ["resourceId"],
          "optional": ["parameterValue"]
        },
        {
          "schema": "name-value",
          "jsonPointer": "/components/schemas/name-value",
          "required": ["name", "value"],
          "optional": []
        },
        {
          "schema": "str-values",
          "jsonPointer": "/components/schemas/str-values",
          "required": [],
          "optional": ["values"]
        },
        {
          "schema": "action-status-info",
          "jsonPointer": "/components/schemas/action-status-info",
          "required": ["taskId"],
          "optional": [
            "name",
            "state",
            "resourceKind",
            "submittedBy",
            "authSource",
            "startDate",
            "completeDate",
            "actionResult",
            "messages",
            "triggeredAutomatically",
            "triggeringSource",
            "triggeringEventId",
            "triggeringEventName",
            "triggeringSourceEvent",
            "actionObjectStatuses"
          ]
        },
        {
          "schema": "task-status",
          "jsonPointer": "/components/schemas/task-status",
          "note": "Supplies the only enumerated asynchronous-task state vocabulary in this specification file (taskState). Cited by docs/contract.json for the non-terminal and terminal state values that action-status-info.state leaves unenumerated.",
          "enumPointer": "/components/schemas/task-status/properties/taskState/enum",
          "enum": ["INITIATED", "STOPPED", "RUNNING", "FINISHED", "ERROR", "ABORTED", "UNKNOWN"]
        },
        {
          "schema": "rebalance-task",
          "jsonPointer": "/components/schemas/rebalance-task",
          "note": "Second enumerated asynchronous-task state vocabulary in the same file. Cited for FAILED, COMPLETED_SUCCESSFULLY, PARTIAL_SUCCESS, CANCELLED and TIME_OUT.",
          "enumPointer": "/components/schemas/rebalance-task/properties/state/enum",
          "enum": [
            "NO_DISPATCH",
            "FAILED",
            "COMPLETED_SUCCESSFULLY",
            "PARTIAL_SUCCESS",
            "CANCELLED",
            "TIME_OUT",
            "UNKNOWN"
          ]
        }
      ],
      "examplePointers": [
        {
          "note": "The literal 'Completed' used as an action-status-info.state value comes from the response example attached to getActionStatus.",
          "jsonPointer": "/paths/~1api~1actions~1{taskId}~1status/get/responses/200/content/application~1json/example"
        },
        {
          "note": "Confirms this file is the 9.0 revision: the getCurrentVersionOfServer response example carries releaseName 'VCF Operations 9.0.0.0'.",
          "jsonPointer": "/paths/~1api~1versions~1current/get/responses/200/content/application~1json/example"
        }
      ],
      "distinctFrom": {
        "note": "The 9.1 revision of the same file is a different artifact and is NOT the source of this contract.",
        "tag": "9.1.0.0",
        "commitSha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
        "blobSha": "a56a00c504d4156aa765339c47d585d15db68768",
        "sizeBytes": 2269774
      }
    },
    {
      "id": "powercli:VMware.Sdk.Vcf.Ops",
      "kind": "client-library",
      "note": "Generated PowerCLI client for the specification above. Installed by the environment as a prerequisite; this repository does not vendor it. It is the sole transport used by VcfOpsActionRunner.",
      "moduleName": "VMware.Sdk.Vcf.Ops",
      "gallery": "https://www.powershellgallery.com/packages/VMware.Sdk.Vcf.Ops",
      "cmdletsUsed": [
        {
          "cmdlet": "Invoke-VcfOpsPerformAction",
          "operationId": "performAction"
        },
        {
          "cmdlet": "Invoke-VcfOpsGetActionStatus",
          "operationId": "getActionStatus"
        },
        {
          "cmdlet": "Initialize-VcfOpsactionexecution",
          "schema": "action-execution"
        },
        {
          "cmdlet": "Initialize-VcfOpsactionparametergroup",
          "schema": "action-parameter-group"
        },
        {
          "cmdlet": "Initialize-VcfOpsnamevalue",
          "schema": "name-value"
        },
        {
          "cmdlet": "Connect-VcfOpsServer",
          "operationIds": ["acquireToken", "getCurrentVersionOfServer"]
        }
      ],
      "authorizationHeaderPrefix": {
        "value": "OpsToken ",
        "note": "The specification declares only that the token travels in the Authorization header; the 'OpsToken ' prefix is emitted by this client and is therefore recorded here rather than as a specification-derived fact."
      }
    }
  ]
}

diff --git a/src/VcfOpsActionRunner/Private/VcfOpsActionState.ps1 b/src/VcfOpsActionRunner/Private/VcfOpsActionState.ps1
new file mode 100644
index 0000000..472567d
--- /dev/null
+++ b/src/VcfOpsActionRunner/Private/VcfOpsActionState.ps1
@@ -0,0 +1,35 @@
+# State vocabulary for VCF Operations action tasks.
+#
+# action-status-info.state is an unenumerated string in the 9.0.0.0 OpenAPI
+# document, so docs/contract.json pins the literals and records where each one
+# comes from. The two tables below mirror `asyncPolling.states` in that file.
+# Anything not listed is treated as still running, which is the safe default:
+# the caller's timeout, not an unrecognised string, ends the wait.
+
+$script:VcfOpsTerminalStates = @{
+    'completed'               = $true
+    'completed_successfully'  = $true
+    'finished'                = $true
+    'partial_success'         = $false
+    'failed'                  = $false
+    'error'                   = $false
+    'aborted'                 = $false
+    'cancelled'               = $false
+    'time_out'                = $false
+}
+
+function Test-VcfOpsTerminalState {
+    [OutputType([bool])]
+    param([string]$State)
+
+    if ([string]::IsNullOrWhiteSpace($State)) { return $false }
+    return $script:VcfOpsTerminalStates.ContainsKey($State.ToLowerInvariant())
+}
+
+function Test-VcfOpsSucceededState {
+    [OutputType([bool])]
+    param([string]$State)
+
+    if (-not (Test-VcfOpsTerminalState -State $State)) { return $false }
+    return [bool]$script:VcfOpsTerminalStates[$State.ToLowerInvariant()]
+}
diff --git a/src/VcfOpsActionRunner/Public/Invoke-VcfOpsActionAndWait.ps1 b/src/VcfOpsActionRunner/Public/Invoke-VcfOpsActionAndWait.ps1
index a202344..e2fe417 100644
--- a/src/VcfOpsActionRunner/Public/Invoke-VcfOpsActionAndWait.ps1
+++ b/src/VcfOpsActionRunner/Public/Invoke-VcfOpsActionAndWait.ps1
@@ -75,6 +75,102 @@ function Invoke-VcfOpsActionAndWait {
         [int]$TimeoutSeconds = 900
     )
 
-    throw [System.NotImplementedException]::new(
-        'Invoke-VcfOpsActionAndWait is not implemented yet.')
+    # --- Build the action-execution body ------------------------------------
+    # Every optional property is added only when the caller actually supplied a
+    # value. Handing the initializer $null, '' or @() would put the key on the
+    # wire as an empty value, which the appliance cannot tell apart from a
+    # deliberate empty input.
+
+    $parameterValues = $null
+    if ($Parameter -and $Parameter.Count -gt 0) {
+        $parameterValues = @(
+            foreach ($name in ($Parameter.Keys | Sort-Object)) {
+                Initialize-VcfOpsnamevalue -Name $name -Value ([string]$Parameter[$name])
+            }
+        )
+    }
+
+    $groups = @(
+        foreach ($id in $ResourceId) {
+            $groupArgs = @{ ResourceId = [guid]$id }
+            if ($parameterValues) { $groupArgs['ParameterValue'] = $parameterValues }
+            Initialize-VcfOpsactionparametergroup @groupArgs
+        }
+    )
+
+    $executionArgs = @{ ParameterGroup = $groups }
+    if (-not [string]::IsNullOrEmpty($ContextId)) {
+        $executionArgs['ContextId'] = $ContextId
+    }
+    if ($ContextResourceId -and @($ContextResourceId).Count -gt 0) {
+        $executionArgs['ContextResourceId'] = @($ContextResourceId)
+    }
+
+    $execution = Initialize-VcfOpsactionexecution @executionArgs
+
+    # --- Submit -------------------------------------------------------------
+    Write-Verbose "Submitting action '$ActionId' against $(@($ResourceId).Count) resource(s)."
+    $submission = Invoke-VcfOpsPerformAction -Server $Server -Id $ActionId -ActionExecution $execution
+
+    $taskId = @($submission.Values) | Select-Object -First 1
+    if ([string]::IsNullOrWhiteSpace($taskId)) {
+        throw "VCF Operations accepted action '$ActionId' but returned no task identifier to poll."
+    }
+
+    # --- Poll to a terminal state -------------------------------------------
+    # A 200 from performAction only means the task was started. The outcome is
+    # whatever getActionStatus eventually reports.
+
+    $statusArgs = @{ Server = $Server; TaskId = $taskId }
+    if ($IncludeDetail) { $statusArgs['Detail'] = $true }
+
+    $stopwatch = [System.Diagnostics.Stopwatch]::StartNew()
+    $pollCount = 0
+    $status = $null
+    $state = $null
+
+    while ($true) {
+        $status = Invoke-VcfOpsGetActionStatus @statusArgs
+        $pollCount++
+        $state = [string]$status.State
+        Write-Verbose "Task $taskId poll #$pollCount -> '$state'."
+
+        if (Test-VcfOpsTerminalState -State $state) { break }
+
+        if ($stopwatch.Elapsed.TotalSeconds -ge $TimeoutSeconds) {
+            throw ("Action '$ActionId' (task $taskId) timed out after ${TimeoutSeconds}s; " +
+                "last reported state was '$state'.")
+        }
+
+        if ($PollIntervalSeconds -gt 0) {
+            $remainingMilliseconds = [Math]::Ceiling(
+                ($TimeoutSeconds - $stopwatch.Elapsed.TotalSeconds) * 1000)
+            $pollDelayMilliseconds = $PollIntervalSeconds * 1000
+
+            if ($pollDelayMilliseconds -ge $remainingMilliseconds) {
+                if ($remainingMilliseconds -gt 0) {
+                    Start-Sleep -Milliseconds $remainingMilliseconds
+                }
+                throw ("Action '$ActionId' (task $taskId) timed out after ${TimeoutSeconds}s; " +
+                    "last reported state was '$state'.")
+            }
+
+            Start-Sleep -Seconds $PollIntervalSeconds
+        }
+    }
+
+    $messages = @()
+    if ($status.Messages) {
+        $messages = @($status.Messages | ForEach-Object { $_.Message })
+    }
+
+    [pscustomobject]@{
+        ActionId  = $ActionId
+        TaskId    = $taskId
+        State     = $state
+        Succeeded = (Test-VcfOpsSucceededState -State $state)
+        PollCount = $pollCount
+        Messages  = $messages
+        Status    = $status
+    }
 }

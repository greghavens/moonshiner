+#!/usr/bin/env python3
+"""Reference proof using genuine appointmentctl executions and returned data."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+RUNTIME = ROOT / ".appointment-runtime"
+DELIVERABLE = ROOT / "appointment-audit.json"
+OUTPUT_FIELDS = (
+    "id",
+    "name",
+    "location",
+    "status",
+    "date",
+    "hygienist",
+)
+WORKER = r"""
+import subprocess
+import sys
+
+completed = subprocess.run(
+    sys.argv[1:],
+    stdin=subprocess.DEVNULL,
+    stdout=subprocess.PIPE,
+    stderr=subprocess.PIPE,
+    check=False,
+    timeout=15,
+)
+sys.stdout.buffer.write(completed.stdout)
+sys.stderr.buffer.write(completed.stderr)
+raise SystemExit(completed.returncode)
+"""
+
+
+def run_action(arguments: list[str]) -> dict[str, Any]:
+    completed = subprocess.run(
+        [sys.executable, "-B", "-c", WORKER, *arguments],
+        cwd=ROOT,
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        check=False,
+        timeout=20,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(
+            completed.stderr.decode("utf-8", errors="replace").strip()
+            or "appointment-register operation failed"
+        )
+    if completed.stderr:
+        raise RuntimeError("appointment-register operation wrote unexpected stderr")
+    try:
+        result = json.loads(completed.stdout)
+    except json.JSONDecodeError as error:
+        raise RuntimeError(
+            "appointment-register operation returned invalid JSON"
+        ) from error
+    if not isinstance(result, dict):
+        raise RuntimeError("appointment-register operation returned a non-object")
+    return result
+
+
+def main() -> int:
+    if RUNTIME.exists():
+        shutil.rmtree(RUNTIME)
+
+    search = run_action(
+        [
+            "./appointmentctl",
+            "search",
+            "--name",
+            "Preventive Dental Cleaning",
+            "--location",
+            "Cedar Clinic",
+        ]
+    )
+    matches = search.get("matches")
+    if (
+        search.get("match_count") != 1
+        or not isinstance(matches, list)
+        or len(matches) != 1
+        or not isinstance(matches[0], dict)
+        or matches[0].get("status") != "active"
+    ):
+        raise RuntimeError(
+            "reference search did not resolve one active appointment"
+        )
+    stable_id = matches[0].get("id")
+    if not isinstance(stable_id, str) or not stable_id:
+        raise RuntimeError("reference search returned no stable ID")
+
+    detail = run_action(["./appointmentctl", "get", "--id", stable_id])
+    record = detail.get("record")
+    if not isinstance(record, dict) or record.get("id") != stable_id:
+        raise RuntimeError(
+            "reference retrieval returned no matching full record"
+        )
+    if (
+        record.get("name") != "Preventive Dental Cleaning"
+        or record.get("location") != "Cedar Clinic"
+        or record.get("status") != "active"
+    ):
+        raise RuntimeError("reference retrieval returned the wrong appointment")
+
+    report = {
+        field: record.get(field, "unknown")
+        for field in OUTPUT_FIELDS
+    }
+    DELIVERABLE.write_text(
+        json.dumps(report, ensure_ascii=False, indent=2) + "\n",
+        encoding="utf-8",
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

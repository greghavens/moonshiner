+            return new TransientFailure(operationId + " answered " + response.status + detail);
+        }
+        throw new IOException(operationId + " answered " + response.status + detail);
+    }
+
+    private static String describeError(String body) {
+        if (body == null || body.isBlank()) {
+            return "";
+        }
+        try {
+            Map<String, Object> error = asObject(Json.parse(body));
+            Object code = error.get("errorCode");
+            Object message = error.get("message");
+            if (code != null || message != null) {
+                return " (" + code + ": " + message + ")";
+            }
+        } catch (RuntimeException ignored) {
+            // Fall through to the raw body.
+        }
+        return " (" + body + ")";
+    }

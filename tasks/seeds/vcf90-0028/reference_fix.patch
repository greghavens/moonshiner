+
+    private Response send(String method, String path, String body) throws Exception {
+        boolean authenticated = !TOKENS_PATH.equals(path);
+        if (authenticated && accessToken == null) {
+            authenticate();
+        }
+        Response response = exchange(method, path, body);
+        if (authenticated && response.status == 401) {
+            // The access token expired or was rejected; get a fresh one and replay the request once.
+            accessToken = null;
+            authenticate();
+            response = exchange(method, path, body);
+        }
+        return response;
+    }

{
  "contractVersion": "1.0.0",
  "description": "Wire contract for the three VMware Cloud Foundation 9.0 SDDC Manager operations used by the idempotent network-pool reconciler. Derived mechanically from the pinned OpenAPI specification; see official_sources.json for provenance.",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "commit": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "openapi": "3.0.1",
    "specTitle": "VMware Cloud Foundation API Reference Guide",
    "specVersion": "9.0.0.0"
  },
  "operations": {
    "createToken": {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "summary": "Create Token Pair",
      "specPointer": "#/paths/~1v1~1tokens/post",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "TokenCreationSpec"
      },
      "responses": {
        "201": {
          "schema": "TokenPair",
          "description": "Created"
        },
        "400": {
          "schema": "Error",
          "description": "Bad Request"
        },
        "500": {
          "schema": "Error",
          "description": "Internal Server Error"
        }
      },
      "successStatus": 201
    },
    "getNetworkPool": {
      "operationId": "getNetworkPool",
      "method": "GET",
      "path": "/v1/network-pools",
      "summary": "Get the list of all Network Pools",
      "specPointer": "#/paths/~1v1~1network-pools/get",
      "requestBody": null,
      "responses": {
        "200": {
          "schema": "PageOfNetworkPool",
          "description": "Referenced network pool"
        },
        "404": {
          "schema": "Error",
          "description": "Referenced network pool not found"
        },
        "500": {
          "schema": "Error",
          "description": "Unexpected error"
        }
      },
      "successStatus": 200
    },
    "createNetworkPool": {
      "operationId": "createNetworkPool",
      "method": "POST",
      "path": "/v1/network-pools",
      "summary": "Create a Network Pool",
      "specPointer": "#/paths/~1v1~1network-pools/post",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "NetworkPool"
      },
      "responses": {
        "201": {
          "schema": "NetworkPool",
          "description": "The newly created network pool"
        },
        "400": {
          "schema": "Error",
          "description": "Errors due to network pool validations failures"
        },
        "500": {
          "schema": "Error",
          "description": "Unexpected error"
        }
      },
      "successStatus": 201
    }
  },
  "authentication": {
    "note": "The 9.0.0.0 specification document declares no securitySchemes component, so this requirement is not derivable from the specification and is stated here explicitly. SDDC Manager gates the network-pool operations behind the bearer access token returned by createToken.",
    "tokenOperation": "createToken",
    "accessTokenField": "accessToken",
    "header": "Authorization",
    "headerValueFormat": "Bearer {accessToken}",
    "appliesTo": [
      "getNetworkPool",
      "createNetworkPool"
    ],
    "rejectionStatus": 401,
    "rejectionSchema": "Error"
  },

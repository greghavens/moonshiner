  "requestSerializationRules": [
    "Request bodies are JSON with Content-Type: application/json; requests send Accept: application/json.",
    "Only writableProperties of a schema may appear in a request body. readOnlyProperties are server-owned and MUST NOT be sent.",
    "A property that is not part of the desired state MUST be omitted from the JSON object. Sending it as null, \"\", [] or {} is a contract violation.",
    "Properties typed integer (format int32) MUST be serialized as JSON numbers, not strings.",
    "No property name outside the schema's properties map may appear in a request body."
  ],
  "retrySafety": {
    "naturalKey": "NetworkPool.name is unique per SDDC Manager instance and identifies the pool.",
    "nonIdempotentOperation": "createNetworkPool",
    "note": "createNetworkPool has no server-side idempotency key in this specification revision, so a retried create can produce a second pool. Retry safety must be established by reading current state with getNetworkPool before every create attempt."
  }

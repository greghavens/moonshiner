+    for item in entry.get("path_parameters") or []:
+        name = item["name"]
+        if name not in supplied:
+            raise ValueError(
+                "%s needs a value for path parameter %s" % (operation_id, name)
+            )
+        target = target.replace("{%s}" % name, quote(str(supplied[name]), safe=""))
+
+    chosen = dict(query_params or {})
+    pairs = []
+    for item in entry.get("query_parameters") or []:
+        name = item["name"]
+        fixed = item.get("fixed_value")
+        value = fixed if fixed is not None else chosen.get(name)
+        if value is None:
+            if item.get("required"):
+                raise ValueError(
+                    "%s needs a value for query parameter %s" % (operation_id, name)
+                )
+            continue
+        allowed = item.get("enum")
+        if allowed and value not in allowed:
+            raise ValueError(
+                "%s: %s=%r is not one of %s"
+                % (operation_id, name, value, ", ".join(allowed))
+            )
+        pairs.append("%s=%s" % (quote(name, safe=""), quote(str(value), safe="")))
+
+    if not pairs:
+        return target
+    return target + "?" + "&".join(pairs)

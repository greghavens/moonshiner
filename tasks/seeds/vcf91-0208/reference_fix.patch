+"""HTTP client and guarded deployment workflow for VCF Installer 9.1."""
+
+from __future__ import annotations
+
+import json
+import time
+from collections.abc import Mapping
+from typing import Any
+from urllib.error import HTTPError, URLError
+from urllib.parse import quote, urlencode
+from urllib.request import Request, urlopen
+
+from .models import SddcSpec
+
+
+class VcfInstallerError(RuntimeError):
+    """An HTTP, transport, or response decoding failure."""
+
+
+class PrecheckFailed(VcfInstallerError):
+    """The VCF Installer validation did not complete successfully."""
+
+    def __init__(self, message: str, validation: Mapping[str, Any]):
+        super().__init__(message)
+        self.validation = dict(validation)
+
+
+class VcfInstallerClient:
+    """Client for the focused VCF Installer contract shipped with this project."""
+
+    def __init__(self, base_url: str, access_token: str, timeout: float = 30.0):
+        if not base_url:
+            raise ValueError("base_url must not be empty")
+        if not access_token:
+            raise ValueError("access_token must not be empty")
+        self.base_url = base_url.rstrip("/")
+        self.access_token = access_token
+        self.timeout = timeout
+
+    def validate_sddc_spec(self, spec: SddcSpec) -> dict[str, Any]:
+        """Submit validateSddcSpec."""
+        return self._request_json("POST", "/v1/sddcs/validations", spec.to_dict())
+
+    def get_sddc_spec_validation(self, validation_id: str) -> dict[str, Any]:
+        """Fetch getSddcSpecValidation for a specific validation identifier."""
+        identifier = quote(validation_id, safe="")
+        return self._request_json("GET", f"/v1/sddcs/validations/{identifier}")
+
+    def deploy_sddc(
+        self,
+        spec: SddcSpec,
+        skip_validations: bool | None = None,
+    ) -> dict[str, Any]:
+        """Submit deploySddc, omitting its optional query when it is unset."""
+        path = "/v1/sddcs"
+        if skip_validations is not None:
+            value = "true" if skip_validations else "false"
+            path = f"{path}?{urlencode({'skipValidations': value})}"
+        return self._request_json("POST", path, spec.to_dict())
+
+    def precheck_and_deploy(
+        self,
+        spec: SddcSpec,
+        poll_interval: float = 1.0,
+        max_polls: int = 60,
+    ) -> dict[str, Any]:
+        """Deploy only after a completed, successful Installer validation."""
+        if poll_interval < 0:
+            raise ValueError("poll_interval must not be negative")
+        if max_polls < 0:
+            raise ValueError("max_polls must not be negative")
+
+        validation = self.validate_sddc_spec(spec)
+        polls = 0
+        while validation.get("executionStatus") == "IN_PROGRESS" and polls < max_polls:
+            validation_id = validation.get("id")
+            if not isinstance(validation_id, str) or not validation_id:
+                raise PrecheckFailed("precheck response has no validation id", validation)
+            if poll_interval:
+                time.sleep(poll_interval)
+            validation = self.get_sddc_spec_validation(validation_id)
+            polls += 1
+
+        if (
+            validation.get("executionStatus") == "COMPLETED"
+            and validation.get("resultStatus") == "SUCCEEDED"
+        ):
+            # Deliberately leave skipValidations unset: the server-side guard remains active.
+            return self.deploy_sddc(spec)
+
+        raise PrecheckFailed("VCF Installer precheck did not succeed", validation)
+
+    def _request_json(
+        self,
+        method: str,
+        path: str,
+        payload: Mapping[str, Any] | None = None,
+    ) -> dict[str, Any]:
+        headers = {
+            "Authorization": f"Bearer {self.access_token}",
+            "Accept": "application/json",
+        }
+        data: bytes | None = None
+        if payload is not None:
+            try:
+                data = json.dumps(
+                    payload,
+                    ensure_ascii=False,
+                    separators=(",", ":"),
+                ).encode("utf-8")
+            except (TypeError, ValueError) as error:
+                raise VcfInstallerError("request payload is not JSON serializable") from error
+            headers["Content-Type"] = "application/json"
+
+        try:
+            request = Request(
+                f"{self.base_url}{path}",
+                data=data,
+                headers=headers,
+                method=method,
+            )
+            with urlopen(request, timeout=self.timeout) as response:
+                raw = response.read()
+        except HTTPError as error:
+            try:
+                detail = error.read().decode("utf-8", errors="replace")
+            finally:
+                error.close()
+            raise VcfInstallerError(f"VCF Installer returned HTTP {error.code}: {detail}") from error
+        except (URLError, TimeoutError, OSError, ValueError) as error:
+            raise VcfInstallerError(f"VCF Installer request failed: {error}") from error
+
+        try:
+            decoded = json.loads(raw.decode("utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError) as error:
+            raise VcfInstallerError("VCF Installer returned malformed JSON") from error
+        if not isinstance(decoded, dict):
+            raise VcfInstallerError("VCF Installer JSON response is not an object")
+        return decoded

+"""Request models for the focused VCF Installer contract."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Iterable
+
+
+def _array(values: Iterable[Any]) -> list[Any]:
+    return [value.to_dict() if hasattr(value, "to_dict") else value for value in values]
+
+
+def _omit_none(items: Iterable[tuple[str, Any]]) -> dict[str, Any]:
+    result: dict[str, Any] = {}
+    for name, value in items:
+        if value is None:
+            continue
+        if hasattr(value, "to_dict"):
+            result[name] = value.to_dict()
+        elif isinstance(value, (list, tuple)):
+            result[name] = _array(value)
+        else:
+            result[name] = value
+    return result
+
+
+@dataclass(frozen=True)
+class DnsSpec:
+    subdomain: str
+    nameservers: Iterable[str] | None = None
+
+    def to_dict(self) -> dict[str, Any]:
+        return _omit_none(
+            (
+                ("subdomain", self.subdomain),
+                ("nameservers", self.nameservers),
+            )
+        )
+
+
+@dataclass(frozen=True)
+class VcenterSpec:
+    vcenter_hostname: str
+    root_vcenter_password: str
+    vm_size: str | None = None
+    storage_size: str | None = None
+    sso_domain: str | None = None
+    admin_user_sso_username: str | None = None
+    admin_user_sso_password: str | None = None
+    version: str | None = None
+    use_existing_deployment: bool | None = None
+    ssl_thumbprint: str | None = None
+
+    def to_dict(self) -> dict[str, Any]:
+        return _omit_none(
+            (
+                ("vcenterHostname", self.vcenter_hostname),
+                ("rootVcenterPassword", self.root_vcenter_password),
+                ("vmSize", self.vm_size),
+                ("storageSize", self.storage_size),
+                ("ssoDomain", self.sso_domain),
+                ("adminUserSsoUsername", self.admin_user_sso_username),
+                ("adminUserSsoPassword", self.admin_user_sso_password),
+                ("version", self.version),
+                ("useExistingDeployment", self.use_existing_deployment),
+                ("sslThumbprint", self.ssl_thumbprint),
+            )
+        )
+
+
+@dataclass(frozen=True)
+class NetworkSpec:
+    network_type: str
+    vlan_id: int
+    subnet: str | None = None
+    gateway: str | None = None
+    subnet_mask: str | None = None
+    include_ip_address: Iterable[str] | None = None
+    mtu: int | None = None
+    teaming_policy: str | None = None
+    active_uplinks: Iterable[str] | None = None
+    standby_uplinks: Iterable[str] | None = None
+    port_group_key: str | None = None
+    ip_address_version: str | None = None
+    ip_address_assignment_mode: str | None = None
+
+    def to_dict(self) -> dict[str, Any]:
+        return _omit_none(
+            (
+                ("networkType", self.network_type),
+                ("vlanId", self.vlan_id),
+                ("subnet", self.subnet),
+                ("gateway", self.gateway),
+                ("subnetMask", self.subnet_mask),
+                ("includeIpAddress", self.include_ip_address),
+                ("mtu", self.mtu),
+                ("teamingPolicy", self.teaming_policy),
+                ("activeUplinks", self.active_uplinks),
+                ("standbyUplinks", self.standby_uplinks),
+                ("portGroupKey", self.port_group_key),
+                ("ipAddressVersion", self.ip_address_version),
+                ("ipAddressAssignmentMode", self.ip_address_assignment_mode),
+            )
+        )
+
+
+@dataclass(frozen=True)
+class SddcSpec:
+    sddc_id: str
+    vcenter_spec: VcenterSpec
+    network_specs: Iterable[NetworkSpec]
+    dns_spec: DnsSpec
+    workflow_type: str | None = None
+    version: str | None = None
+    ntp_servers: Iterable[str] | None = None
+    management_pool_name: str | None = None
+    ceip_enabled: bool | None = None
+    skip_esx_thumbprint_validation: bool | None = None
+    skip_gateway_ping_validation: bool | None = None
+    vcf_instance_name: str | None = None
+
+    def to_dict(self) -> dict[str, Any]:
+        # Keep the required fields in the same stable order used by request fixtures.
+        required = (
+            ("sddcId", self.sddc_id),
+            ("vcenterSpec", self.vcenter_spec),
+            ("networkSpecs", self.network_specs),
+            ("dnsSpec", self.dns_spec),
+        )
+        optional = (
+            ("workflowType", self.workflow_type),
+            ("version", self.version),
+            ("ntpServers", self.ntp_servers),
+            ("managementPoolName", self.management_pool_name),
+            ("ceipEnabled", self.ceip_enabled),
+            ("skipEsxThumbprintValidation", self.skip_esx_thumbprint_validation),
+            ("skipGatewayPingValidation", self.skip_gateway_ping_validation),
+            ("vcfInstanceName", self.vcf_instance_name),
+        )
+        return _omit_none(required + optional)

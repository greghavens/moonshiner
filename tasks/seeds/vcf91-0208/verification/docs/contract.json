{
  "openapi": "3.0.1",
  "info": {
    "title": "VMware Cloud Foundation Installer API Reference Guide",
    "version": "9.1.0.0"
  },
  "operations": {
    "validateSddcSpec": {
      "operationId": "validateSddcSpec",
      "method": "POST",
      "path": "/v1/sddcs/validations",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "SddcSpec"
      },
      "responses": {
        "200": "Validation",
        "202": "Validation"
      }
    },
    "getSddcSpecValidation": {
      "operationId": "getSddcSpecValidation",
      "method": "GET",
      "path": "/v1/sddcs/validations/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "string",
          "minimum": 36,
          "maximum": 36
        }
      ],
      "responses": {
        "200": "Validation"
      }
    },
    "deploySddc": {
      "operationId": "deploySddc",
      "method": "POST",
      "path": "/v1/sddcs",
      "parameters": [
        {
          "name": "skipValidations",
          "in": "query",
          "required": false,
          "type": "boolean",
          "default": false
        }
      ],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "SddcSpec"
      },
      "responses": {
        "202": "SddcTask"
      }
    }
  },
  "schemas": {
    "SddcSpec": {
      "type": "object",
      "required": [
        "dnsSpec",
        "networkSpecs",
        "sddcId",
        "vcenterSpec"
      ],
      "properties": {
        "sddcId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9-]+$"
        },
        "workflowType": {
          "type": "string",
          "pattern": "(VCF|VCF_COMPLETE|VCF_EXTEND|VVF|VCF_BOOTSTRAP)"
        },
        "version": {
          "type": "string"
        },
        "vcenterSpec": {
          "$ref": "SddcVcenterSpec"
        },
        "networkSpecs": {
          "type": "array",
          "items": {
            "$ref": "SddcNetworkSpec"
          }
        },
        "dnsSpec": {
          "$ref": "DnsSpec"
        },
        "ntpServers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "managementPoolName": {
          "type": "string"
        },
        "ceipEnabled": {
          "type": "boolean"
        },
        "skipEsxThumbprintValidation": {
          "type": "boolean"
        },
        "skipGatewayPingValidation": {
          "type": "boolean"
        },
        "vcfInstanceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "DnsSpec": {
      "type": "object",
      "required": [
        "subdomain"
      ],
      "properties": {
        "subdomain": {
          "type": "string",
          "pattern": "^(([a-zA-Z0-9]|[a-zA-Z0-9][a-zA-Z0-9\\-]*[a-zA-Z0-9])\\.)*([A-Za-z0-9]|[A-Za-z0-9][A-Za-z0-9\\-]*[A-Za-z0-9])$"
        },
        "nameservers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "SddcVcenterSpec": {
      "type": "object",
      "required": [
        "rootVcenterPassword",
        "vcenterHostname"
      ],
      "properties": {
        "vcenterHostname": {
          "type": "string",
          "minLength": 0,
          "maxLength": 63
        },
        "rootVcenterPassword": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        },
        "vmSize": {
          "type": "string"
        },
        "storageSize": {
          "type": "string"
        },
        "ssoDomain": {
          "type": "string"
        },
        "adminUserSsoUsername": {
          "type": "string"
        },
        "adminUserSsoPassword": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "useExistingDeployment": {
          "type": "boolean",
          "default": false
        },
        "sslThumbprint": {
          "type": "string"
        }
      }
    },
    "SddcNetworkSpec": {
      "type": "object",
      "required": [
        "networkType",
        "vlanId"
      ],
      "properties": {
        "networkType": {
          "type": "string"
        },
        "subnet": {
          "type": "string"
        },
        "gateway": {
          "type": "string"
        },
        "subnetMask": {
          "type": "string"
        },
        "includeIpAddress": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vlanId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4094
        },
        "mtu": {
          "type": "integer",
          "minimum": 1280,
          "maximum": 9190
        },
        "teamingPolicy": {
          "type": "string"
        },
        "activeUplinks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "standbyUplinks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "portGroupKey": {
          "type": "string"
        },
        "ipAddressVersion": {
          "type": "string",
          "default": "IPv4"
        },
        "ipAddressAssignmentMode": {
          "type": "string",
          "default": "STATIC"
        }
      }
    },
    "Validation": {
      "type": "object",
      "required": [
        "description",
        "executionStatus",
        "id",
        "resultStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "description": {
          "type": "string",
          "readOnly": true
        },
        "executionStatus": {
          "type": "string",
          "readOnly": true
        },
        "resultStatus": {
          "type": "string",
          "readOnly": true
        },
        "validationChecks": {
          "type": "array",
          "readOnly": true
        }
      }
    },
    "SddcTask": {
      "type": "object",
      "required": [
        "creationTimestamp",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "readOnly": true
        },
        "creationTimestamp": {
          "type": "string",
          "readOnly": true
        }
      }
    }
  }
}

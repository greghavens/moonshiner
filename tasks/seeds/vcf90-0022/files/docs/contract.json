{
  "contractVersion": "1.0.0",
  "description": "Wire contract for the SDDC Manager host-commissioning precheck gate, derived from the VMware Cloud Foundation 9.0 SDDC Manager OpenAPI specification. Only the three operations named below are in scope.",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "license": "Apache-2.0",
    "specPath": "specifications/sddc-manager/sddc-manager-openapi.json",
    "tag": "9.0.0.0",
    "commit": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "openapi": "3.0.1",
    "infoVersion": "9.0.0.0",
    "specSha256": "81f315f23b7c172f3893189de21d9f6ff59ca07cc3ee35c6dd89787730aa1fe3"
  },
  "operations": {
    "postHostsPrechecks_1": {
      "method": "POST",
      "path": "/v1/hosts/prechecks",
      "summary": "Post host(s) prechecks",
      "requestContentType": "application/json",
      "requestBody": {
        "schema": "HostsPrechecksRequest",
        "shape": "object",
        "note": "The request body is a JSON OBJECT with a single 'hosts' property holding an array of HostCommissionSpec. It is NOT a bare array."
      },
      "successStatus": 200,
      "responseSchema": "HostsPrechecksResponse"
    },
    "getHostsPrechecksResponse": {
      "method": "GET",
      "path": "/v1/hosts/prechecks/{id}",
      "summary": "Get host(s) prechecks response",
      "pathParameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "string",
          "description": "Execution ID returned by post hostsprechecks"
        }
      ],
      "successStatus": 200,
      "responseSchema": "HostsPrechecksResponse"
    },
    "commissionHosts": {
      "method": "POST",
      "path": "/v1/hosts",
      "summary": "Commission the Hosts",
      "requestContentType": "application/json",
      "requestBody": {
        "schema": "HostCommissionSpec",
        "shape": "array",
        "note": "The request body is a BARE JSON ARRAY of HostCommissionSpec. It is NOT wrapped in an enclosing object."
      },
      "successStatus": 202,
      "responseSchema": "Task"
    }
  },
  "schemas": {
    "HostCommissionSpec": {
      "type": "object",
      "description": "This specification contains the input to commission a host to VMware Cloud Foundation.",
      "required": [
        "fqdn",
        "networkPoolId",
        "password",
        "storageType",
        "username"
      ],
      "optional": [
        "networkPoolName",
        "sshThumbprint",
        "sslThumbprint",
        "vvolStorageProtocolType"
      ],
      "properties": {
        "fqdn": { "type": "string", "description": "FQDN of the host" },
        "username": { "type": "string", "description": "Username of the host" },
        "password": { "type": "string", "description": "Password of the host" },
        "storageType": { "type": "string", "description": "Storage Type" },
        "vvolStorageProtocolType": { "type": "string", "description": "vVol Storage Protocol Type" },
        "networkPoolId": { "type": "string", "description": "ID of the network pool to associate the host with" },
        "networkPoolName": { "type": "string", "description": "Name of the network pool to associate the host with" },
        "sshThumbprint": { "type": "string", "description": "SSH thumbprint of the host" },
        "sslThumbprint": { "type": "string", "description": "SSL thumbprint of the host" }
      },
      "omitEmptyOptional": true,
      "omitEmptyNote": "An optional property that the caller did not set MUST be absent from the serialized object. Emitting it with an empty string value is a contract violation."
    },
    "HostsPrechecksRequest": {
      "type": "object",
      "required": [],
      "properties": {
        "hosts": {
          "type": "array",
          "items": "HostCommissionSpec",
          "description": "list of hosts on which prechecks will be done"
        }
      }
    },
    "HostsPrechecksResponse": {
      "type": "object",
      "required": ["executionStatus", "id", "result"],
      "properties": {
        "id": { "type": "string", "description": "The ID for hosts prechecks" },
        "executionStatus": { "type": "string", "description": "Overall execution status of hosts prechecks" },
        "result": { "type": "string", "description": "Result status of the hosts prechecks after it has completed its execution" },
        "hostPrechecks": { "type": "array", "items": "HostPrechecks", "description": "precheck done on each host" }
      }
    },
    "HostPrechecks": {
      "type": "object",
      "properties": {
        "hostPrecheckDetails": { "type": "object", "items": "HostPrecheckDetails" },
        "result": { "type": "string", "description": "Result of the prechecks" },
        "error": { "type": "string", "description": "Error found during prechecks" }
      }
    },
    "HostPrecheckDetails": {
      "type": "object",
      "properties": {
        "fqdn": { "type": "string" },
        "ipAddress": { "type": "string" },
        "networkPoolId": { "type": "string" },
        "networkPoolName": { "type": "string" },
        "sshFingerprint": { "type": "string" },
        "storageType": { "type": "string" },
        "username": { "type": "string" },
        "vvolStorageProtocolType": { "type": "string" }
      }
    },
    "Task": {
      "type": "object",
      "required": ["creationTimestamp", "id", "name", "status"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "creationTimestamp": { "type": "string" },
        "completionTimestamp": { "type": "string" }
      }
    }
  },
  "enumerations": {
    "storageType": {
      "appliesTo": "HostCommissionSpec.storageType",
      "derivedFrom": "The 9.0.0.0 specification expresses this set in the property's 'example' field: \"One among: VSAN, VSAN_ESA, VSAN_REMOTE, VSAN_MAX, NFS, VMFS_FC, VVOL, VMFS\". It is not declared as a formal JSON Schema enum.",
      "allowedValues": [
        "VSAN",
        "VSAN_ESA",
        "VSAN_REMOTE",
        "VSAN_MAX",
        "NFS",
        "VMFS_FC",
        "VVOL",
        "VMFS"
      ],
      "notInThisRelease": {
        "values": ["NFS41", "FC"],
        "note": "These values appear only in the 9.1.0.0 revision of the same specification file. They are NOT valid for a 9.0.0.0 deployment and must be rejected."
      }
    },
    "executionStatus": {
      "appliesTo": "HostsPrechecksResponse.executionStatus",
      "derivedFrom": "Specification 'example' field: \"One among: IN_PROGRESS, COMPLETED\".",
      "allowedValues": ["IN_PROGRESS", "COMPLETED"]
    },
    "result": {
      "appliesTo": "HostsPrechecksResponse.result",
      "derivedFrom": "Specification 'example' field: \"One among: SUCCEEDED, FAILED\".",
      "allowedValues": ["SUCCEEDED", "FAILED"]
    }
  },
  "gate": {
    "description": "The precheck gates the mutating call.",
    "rules": [
      "postHostsPrechecks_1 must be invoked before commissionHosts.",
      "getHostsPrechecksResponse must be polled until executionStatus is COMPLETED.",
      "commissionHosts may only be invoked when the completed precheck result is SUCCEEDED.",
      "When the precheck result is FAILED the caller must not issue any request to POST /v1/hosts, so that nothing is changed."
    ]
  }
}

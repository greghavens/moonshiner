+// awaitPrecheck reads the precheck status until it reports completion,
+// recording the number of reads on res.
+func (c *Client) awaitPrecheck(ctx context.Context, contract *hostcommission.Contract, res *Result) (*prechecksResponse, error) {
+	op := contract.MustOp(opPrecheckStatus)
+	maxReads := c.maxPolls()
+
+	for i := 0; i < maxReads; i++ {
+		if i > 0 {
+			select {
+			case <-ctx.Done():
+				return nil, fmt.Errorf("commission: waiting for precheck %s: %w", res.PrecheckID, ctx.Err())
+			case <-time.After(c.pollInterval()):
+			}
+		}
+
+		var status prechecksResponse
+		if err := c.do(ctx, op, map[string]string{"id": res.PrecheckID}, nil, &status); err != nil {
+			return nil, fmt.Errorf("commission: reading precheck %s: %w", res.PrecheckID, err)
+		}
+		res.Polls++
+
+		if status.ExecutionStatus == statusCompleted {
+			return &status, nil
+		}
+	}
+	return nil, fmt.Errorf("commission: precheck %s did not complete within %d status reads",
+		res.PrecheckID, maxReads)
+}
+
+// validate enforces the HostCommissionSpec rules the contract states: every
+// required property present, and a storage type this release accepts.
+func validate(contract *hostcommission.Contract, s HostSpec) error {
+	values := map[string]string{
+		"fqdn":          s.FQDN,
+		"username":      s.Username,
+		"password":      s.Password,
+		"storageType":   s.StorageType,
+		"networkPoolId": s.NetworkPoolID,
+	}
+	for _, name := range contract.Schemas["HostCommissionSpec"].Required {
+		// storageType gets the more specific message below.
+		if name != "storageType" && strings.TrimSpace(values[name]) == "" {
+			return fmt.Errorf("required property %q is empty", name)
+		}
+	}
+	if !contract.StorageTypeAllowed(s.StorageType) {
+		return fmt.Errorf("%w %q; VMware Cloud Foundation 9.0 accepts: %s",
+			ErrUnsupportedStorageType, s.StorageType,
+			strings.Join(contract.AllowedStorageTypes(), ", "))
+	}
+	return nil
+}

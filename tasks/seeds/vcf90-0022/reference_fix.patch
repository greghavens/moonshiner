+// do issues one contract operation. body is encoded as JSON when non-nil; out
+// receives the decoded success response when non-nil.
+func (c *Client) do(ctx context.Context, op hostcommission.Operation, pathParams map[string]string, body, out any) error {
+	path := op.Path
+	for k, v := range pathParams {
+		path = strings.ReplaceAll(path, "{"+k+"}", v)
+	}
+
+	var payload io.Reader
+	if body != nil {
+		buf, err := json.Marshal(body)
+		if err != nil {
+			return fmt.Errorf("encoding request: %w", err)
+		}
+		payload = bytes.NewReader(buf)
+	}
+
+	req, err := http.NewRequestWithContext(ctx, op.Method, strings.TrimSuffix(c.baseURL, "/")+path, payload)
+	if err != nil {
+		return err
+	}
+	if body != nil {
+		ct := op.RequestContentType
+		if ct == "" {
+			ct = "application/json"
+		}
+		req.Header.Set("Content-Type", ct)
+	}
+	req.Header.Set("Accept", "application/json")
+
+	resp, err := c.httpc.Do(req)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+
+	raw, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return fmt.Errorf("reading response: %w", err)
+	}
+	if resp.StatusCode != op.SuccessStatus {
+		var e apiError
+		_ = json.Unmarshal(raw, &e)
+		msg := e.Message
+		if msg == "" {
+			msg = strings.TrimSpace(string(raw))
+		}
+		return fmt.Errorf("%s %s: unexpected status %d (want %d): %s",
+			op.Method, path, resp.StatusCode, op.SuccessStatus, msg)
+	}
+	if out == nil {
+		return nil
+	}
+	if err := json.Unmarshal(raw, out); err != nil {
+		return fmt.Errorf("decoding %s response: %w", op.ResponseSchema, err)
+	}
+	return nil
+}
+
+func summarize(errs []HostPrecheckError) string {
+	if len(errs) == 0 {
+		return ""
+	}
+	parts := make([]string, 0, len(errs))
+	for _, e := range errs {
+		parts = append(parts, fmt.Sprintf("%s: %s", e.FQDN, e.Error))
+	}
+	return " (" + strings.Join(parts, "; ") + ")"
 }

+// wireHostSpec is the JSON projection of HostSpec. The optional properties
+// carry omitempty so that an unset one is absent from the payload rather than
+// serialized as "".
+type wireHostSpec struct {
+	FQDN          string `json:"fqdn"`
+	Username      string `json:"username"`
+	Password      string `json:"password"`
+	StorageType   string `json:"storageType"`
+	NetworkPoolID string `json:"networkPoolId"`
+
+	VvolStorageProtocolType string `json:"vvolStorageProtocolType,omitempty"`
+	NetworkPoolName         string `json:"networkPoolName,omitempty"`
+	SSHThumbprint           string `json:"sshThumbprint,omitempty"`
+	SSLThumbprint           string `json:"sslThumbprint,omitempty"`
+}
+
+func (h HostSpec) wire() wireHostSpec {
+	return wireHostSpec{
+		FQDN:                    h.FQDN,
+		Username:                h.Username,
+		Password:                h.Password,
+		StorageType:             h.StorageType,
+		NetworkPoolID:           h.NetworkPoolID,
+		VvolStorageProtocolType: h.VvolStorageProtocolType,
+		NetworkPoolName:         h.NetworkPoolName,
+		SSHThumbprint:           h.SSHThumbprint,
+		SSLThumbprint:           h.SSLThumbprint,
+	}

{
  "schema_version": 1,
  "source": {
    "repository": "vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/nsx/openapi-2.0/nsx_policy_api.yaml",
    "spec_blob_sha": "102d15fd342f6a45bb6d84a5b39a916c65929f4c",
    "license": "Apache-2.0"
  },
  "swagger": "2.0",
  "info": {
    "title": "NSX Policy API",
    "version": "9.1.0.0"
  },
  "basePath": "/policy/api/v1",
  "schemes": [
    "https"
  ],
  "security": {
    "type": "basic",
    "name": "BasicAuth"
  },
  "operations": {
    "GetFirewallIdentityStoreEventLogServer": {
      "operationId": "GetFirewallIdentityStoreEventLogServer",
      "method": "GET",
      "path": "/infra/identity-firewall-stores/{identity-firewall-store-id}/event-log-servers/{event-log-server-id}",
      "parameters": [
        {
          "name": "identity-firewall-store-id",
          "in": "path",
          "required": true,
          "type": "string"
        },
        {
          "name": "event-log-server-id",
          "in": "path",
          "required": true,
          "type": "string"
        },
        {
          "name": "enforcement_point_path",
          "in": "query",
          "required": false,
          "type": "string",
          "omitWhenUnset": true
        }
      ],
      "requestBody": null,
      "produces": [
        "application/json"
      ],
      "successStatus": 200,
      "errorStatuses": [
        400,
        403,
        404,
        412,
        500,
        503,
        504
      ],
      "responseDefinition": "IdentityFirewallStoreEventLogServer"
    },
    "GetUserLoginEvents": {
      "operationId": "GetUserLoginEvents",
      "method": "GET",
      "path": "/infra/settings/firewall/idfw/user-stats/{user-id}",
      "parameters": [
        {
          "name": "user-id",
          "in": "path",
          "required": true,
          "type": "string"
        },
        {
          "name": "enforcement_point_path",
          "in": "query",
          "required": false,
          "type": "string",
          "omitWhenUnset": true
        }
      ],
      "requestBody": null,
      "produces": [
        "application/json"
      ],
      "successStatus": 200,
      "errorStatuses": [
        400,
        403,
        404,
        412,
        500,
        503,
        504
      ],
      "responseDefinition": "IdfwUserStats"
    }
  },
  "definitions": {
    "IdentityFirewallStoreEventLogServer": {
      "type": "object",
      "allOf": [
        "PolicyConfigResource"
      ],
      "required": [
        "host"
      ],
      "properties": {
        "domain_name": {
          "type": "string"
        },
        "host": {
          "type": "string",
          "format": "hostname-or-ip"
        },
        "id": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/DirectoryEventLogServerStatus"
        },
        "username": {
          "type": "string"
        }
      }
    },
    "DirectoryEventLogServerStatus": {
      "type": "object",
      "properties": {
        "error_message": {
          "type": "string",
          "readOnly": true
        },
        "last_event_record_id": {
          "type": "integer",
          "format": "int64",
          "readOnly": true
        },
        "last_event_time_created": {
          "type": "integer",
          "format": "int64",
          "readOnly": true
        },
        "last_polling_time": {
          "type": "integer",
          "format": "int64",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "readOnly": true,
          "enum": [
            "OK",
            "ERROR"
          ]
        }
      }
    },
    "IdfwUserStats": {
      "type": "object",
      "required": [
        "active_sessions"
      ],
      "properties": {
        "active_sessions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/IdfwUserSessionData"
          }
        },
        "archived_sessions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/IdfwUserSessionData"
          }
        },
        "user_id": {
          "type": "string",
          "readOnly": true
        }
      }
    },
    "IdfwUserSessionData": {
      "type": "object",
      "required": [
        "user_session_id",
        "user_name",
        "login_time",
        "domain_name"
      ],
      "properties": {
        "domain_name": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "readOnly": true
        },
        "login_time": {
          "type": "integer",
          "format": "int64"
        },
        "logout_time": {
          "type": "integer",
          "format": "int64"
        },
        "session_source": {
          "type": "string",
          "readOnly": true,
          "enum": [
            "GI",
            "ELS",
            "LI"
          ]
        },
        "user_id": {
          "type": "string",
          "readOnly": true
        },
        "user_name": {
          "type": "string"
        },
        "user_session_id": {
          "type": "integer",
          "format": "int64"
        },
        "vm_ext_id": {
          "type": "string",
          "readOnly": true
        }
      }
    },
    "ApiError": {
      "type": "object",
      "properties": {
        "details": {
          "type": "string"
        },
        "error_code": {
          "type": "integer",
          "format": "int64"
        },
        "error_data": {
          "type": "object"
        },
        "error_message": {
          "type": "string"
        },
        "module_name": {
          "type": "string"
        },
        "related_errors": {
          "type": "array"
        }
      }
    }
  }
}

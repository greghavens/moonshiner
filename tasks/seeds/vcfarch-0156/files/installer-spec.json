{
  "specificationVersion": "1.0.0",
  "artifactPath": "migration-plan.json",
  "module": {
    "manifestPath": "VCF.MigrationPlanner/VCF.MigrationPlanner.psd1",
    "rootModulePath": "VCF.MigrationPlanner/VCF.MigrationPlanner.psm1",
    "requiredModules": [
      "VMware.Sdk.Vcf.Ops",
      "VMware.Sdk.Vcf.Installer"
    ],
    "exportedFunctions": [
      "New-VcfMigrationPlan",
      "Test-VcfMigrationPlan"
    ]
  },
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:northstar:vcf-migration-plan:1.0.0",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "estateId",
      "snapshotId",
      "targetVersion",
      "sdkModules",
      "researchConsulted",
      "architecture",
      "supportBoundaries",
      "contentDisposition",
      "steps"
    ],
    "properties": {
      "schemaVersion": {
        "const": "1.0.0"
      },
      "estateId": {
        "type": "string",
        "minLength": 1
      },
      "snapshotId": {
        "type": "string",
        "minLength": 1
      },
      "targetVersion": {
        "type": "string",
        "pattern": "^9\\.0\\.2$"
      },
      "sdkModules": {
        "type": "array",
        "minItems": 2,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "researchConsulted": {
        "type": "array",
        "minItems": 4,
        "items": {
          "$ref": "#/$defs/researchSource"
        }
      },
      "architecture": {
        "$ref": "#/$defs/architecture"
      },
      "supportBoundaries": {
        "type": "array",
        "minItems": 3,
        "items": {
          "$ref": "#/$defs/supportBoundary"
        }
      },
      "contentDisposition": {
        "type": "array",
        "minItems": 3,
        "items": {
          "$ref": "#/$defs/productDisposition"
        }
      },
      "steps": {
        "type": "array",
        "minItems": 8,
        "items": {
          "$ref": "#/$defs/step"
        }
      }
    },
    "$defs": {
      "researchSource": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "publisher",
          "url",
          "accessedOn",
          "topics",
          "findings"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3
          },
          "publisher": {
            "type": "string",
            "minLength": 3
          },
          "url": {
            "type": "string",
            "format": "uri",
            "minLength": 10
          },
          "accessedOn": {
            "type": "string",
            "format": "date"
          },
          "topics": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "migration-path",
                "content-compatibility",
                "support-boundary",
                "sizing",
                "sequencing"
              ]
            }
          },
          "findings": {
            "type": "string",
            "minLength": 10
          }
        }
      },
      "placement": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "site",
          "domain",
          "cluster",
          "network",
          "nodeFaultDomains"
        ],
        "properties": {
          "site": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "cluster": {
            "type": "string",
            "minLength": 1
          },
          "network": {
            "type": "string",
            "minLength": 1
          },
          "nodeFaultDomains": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "sizing": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "preset",
          "nodeCount",
          "vCpuPerNode",
          "memoryGbPerNode",
          "diskGbPerNode"
        ],
        "properties": {
          "preset": {
            "type": "string",
            "minLength": 1
          },
          "nodeCount": {
            "type": "integer",
            "minimum": 1
          },
          "vCpuPerNode": {
            "type": "integer",
            "minimum": 1
          },
          "memoryGbPerNode": {
            "type": "integer",
            "minimum": 1
          },
          "diskGbPerNode": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "capacityBasis": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "measure",
          "required",
          "provided"
        ],
        "properties": {
          "measure": {
            "type": "string",
            "minLength": 3
          },
          "required": {
            "type": "string",
            "minLength": 3
          },
          "provided": {
            "type": "string",
            "minLength": 3
          }
        }
      },
      "component": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "componentId",
          "component",
          "version",
          "migrationMode",
          "placement",
          "sizing",
          "capacityBasis",
          "rationale"
        ],
        "properties": {
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 3
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "migrationMode": {
            "type": "string",
            "minLength": 3
          },
          "placement": {
            "$ref": "#/$defs/placement"
          },
          "sizing": {
            "$ref": "#/$defs/sizing"
          },
          "capacityBasis": {
            "$ref": "#/$defs/capacityBasis"
          },
          "rationale": {
            "type": "string",
            "minLength": 20
          }
        }
      },
      "resourceVector": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vCpu",
          "memoryGb",
          "storageGb"
        ],
        "properties": {
          "vCpu": {
            "type": "integer",
            "minimum": 0
          },
          "memoryGb": {
            "type": "integer",
            "minimum": 0
          },
          "storageGb": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "architecture": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "components",
          "resourceTotals"
        ],
        "properties": {
          "components": {
            "type": "array",
            "minItems": 4,
            "items": {
              "$ref": "#/$defs/component"
            }
          },
          "resourceTotals": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required",
              "available",
              "remaining"
            ],
            "properties": {
              "required": {
                "$ref": "#/$defs/resourceVector"
              },
              "available": {
                "$ref": "#/$defs/resourceVector"
              },
              "remaining": {
                "$ref": "#/$defs/resourceVector"
              }
            }
          }
        }
      },
      "supportBoundary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceProductId",
          "sourceProduct",
          "sourceVersion",
          "endOfGeneralSupport",
          "targetReleaseDate",
          "boundary",
          "impact"
        ],
        "properties": {
          "sourceProductId": {
            "type": "string",
            "minLength": 1
          },
          "sourceProduct": {
            "type": "string",
            "minLength": 3
          },
          "sourceVersion": {
            "type": "string",
            "minLength": 1
          },
          "endOfGeneralSupport": {
            "type": "string",
            "format": "date"
          },
          "targetReleaseDate": {
            "type": "string",
            "format": "date"
          },
          "boundary": {
            "type": "string",
            "enum": [
              "ends-before-target-release",
              "supported-at-target-release"
            ]
          },
          "impact": {
            "type": "string",
            "minLength": 20
          }
        }
      },
      "contentItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inventoryId",
          "kind",
          "disposition",
          "destination",
          "detail"
        ],
        "properties": {
          "inventoryId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "enum": [
              "carry",
              "remediate",
              "recreate",
              "abandon",
              "retain-source"
            ]
          },
          "destination": {
            "type": "string",
            "minLength": 3
          },
          "detail": {
            "type": "string",
            "minLength": 20
          }
        }
      },
      "transition": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "mode"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "minLength": 3
          }
        }
      },
      "productDisposition": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceProductId",
          "sourceProduct",
          "sourceVersion",
          "targetComponent",
          "targetVersion",
          "transitions",
          "items"
        ],
        "properties": {
          "sourceProductId": {
            "type": "string",
            "minLength": 1
          },
          "sourceProduct": {
            "type": "string",
            "minLength": 3
          },
          "sourceVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetComponent": {
            "type": "string",
            "minLength": 3
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "transitions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/transition"
            }
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/contentItem"
            }
          }
        }
      },
      "endpoint": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "product",
          "version"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "minLength": 1
          },
          "product": {
            "type": "string",
            "minLength": 3
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "gate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gateId",
          "condition",
          "evidence",
          "failureAction"
        ],
        "properties": {
          "gateId": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string",
            "minLength": 10
          },
          "evidence": {
            "type": "string",
            "minLength": 5
          },
          "failureAction": {
            "type": "string",
            "minLength": 10
          }
        }
      },
      "rollback": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trigger",
          "action"
        ],
        "properties": {
          "trigger": {
            "type": "string",
            "minLength": 10
          },
          "action": {
            "type": "string",
            "minLength": 10
          }
        }
      },
      "step": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "stepId",
          "source",
          "target",
          "action",
          "method",
          "dependsOn",
          "gates",
          "carries",
          "abandons",
          "rollback"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "stepId": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "$ref": "#/$defs/endpoint"
          },
          "target": {
            "$ref": "#/$defs/endpoint"
          },
          "action": {
            "type": "string",
            "minLength": 20
          },
          "method": {
            "type": "string",
            "minLength": 3
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/gate"
            }
          },
          "carries": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "abandons": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rollback": {
            "$ref": "#/$defs/rollback"
          }
        }
      }
    }
  }
}

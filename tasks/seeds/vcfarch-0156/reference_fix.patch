+Set-StrictMode -Version Latest
+
+function Read-JsonDocument {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $LiteralPath
+    )
+
+    $resolved = (Resolve-Path -LiteralPath $LiteralPath -ErrorAction Stop).Path
+    return Get-Content -LiteralPath $resolved -Raw -Encoding utf8 | ConvertFrom-Json -Depth 100
+}
+
+function Get-TargetProductId {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $Component
+    )
+
+    $ids = @{
+        'VCF 9.0.2 management platform' = 'platform'
+        'VMware Aria Suite Lifecycle' = 'platform'
+        'VMware Aria Operations' = 'ops-prod'
+        'VCF Operations cloud proxy' = 'vcf-operations'
+        'VCF Operations' = 'vcf-operations'
+        'VCF Automation' = 'vcf-automation'
+        'VCF Operations for Logs' = 'vcf-operations-logs'
+    }
+    if (-not $ids.ContainsKey($Component)) {
+        throw "No target product id is defined for '$Component'."
+    }
+    return $ids[$Component]
+}
+
+function Get-ContentDetail {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $Disposition,
+
+        [Parameter(Mandatory)]
+        [string] $Description,
+
+        [Parameter(Mandatory)]
+        [string] $Destination
+    )
+
+    switch ($Disposition) {
+        'carry' { return "Preserve $Description through the supported migration and validate it at $Destination." }
+        'remediate' { return "Replace incompatible references in $Description, then validate the remediated item at $Destination." }
+        'recreate' { return "Export or document $Description, rebuild it at $Destination, and compare behavior before cutover." }
+        'abandon' { return "Do not carry $Description; remove its operational dependency and use $Destination instead." }
+        'retain-source' { return "Do not copy $Description to the target; keep it available at $Destination." }
+        default { throw "Unsupported content disposition '$Disposition'." }
+    }
+}

+function Test-VcfMigrationPlan {
+    [CmdletBinding()]
+    [OutputType([bool])]
+    param(
+        [Parameter(Mandatory)]
+        [string] $PlanPath,
+
+        [Parameter(Mandatory)]
+        [string] $SpecificationPath
+    )
+
+    try {
+        $specification = Read-JsonDocument -LiteralPath $SpecificationPath
+        $schema = $specification.schema | ConvertTo-Json -Depth 100 -Compress
+        $planJson = Get-Content -LiteralPath (Resolve-Path -LiteralPath $PlanPath -ErrorAction Stop).Path -Raw -Encoding utf8
+        return [bool]($planJson | Test-Json -Schema $schema -ErrorAction Stop)
+    }
+    catch {
+        Write-Error -ErrorRecord $_
+        return $false
+    }
+}
+
+function New-VcfMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $InventoryPath,
+
+        [Parameter(Mandatory)]
+        [string] $CompatibilityPath,
+
+        [Parameter(Mandatory)]
+        [string] $SpecificationPath,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [object[]] $ResearchConsulted,
+
+        [Parameter(Mandatory)]
+        [string] $OutputPath
+    )
+
+    Import-Module VMware.Sdk.Vcf.Ops -ErrorAction Stop
+    Import-Module VMware.Sdk.Vcf.Installer -ErrorAction Stop
+
+    $inventory = Read-JsonDocument -LiteralPath $InventoryPath
+    $compatibility = Read-JsonDocument -LiteralPath $CompatibilityPath
+    $null = Read-JsonDocument -LiteralPath $SpecificationPath
+
+    $inventoryProducts = @{}
+    foreach ($product in $inventory.sourceProducts) {
+        $inventoryProducts[$product.id] = $product
+    }
+
+    $components = foreach ($component in $compatibility.targetArchitecture.components) {
+        [ordered]@{
+            componentId = $component.componentId
+            component = $component.component
+            version = $component.version
+            migrationMode = $component.migrationMode
+            placement = $component.placement
+            sizing = $component.sizing
+            capacityBasis = $component.capacityBasis
+            rationale = "Place and size this component for $($component.capacityBasis.measure): demand is $($component.capacityBasis.required), while the pinned design provides $($component.capacityBasis.provided)."
+        }
+    }
+
+    $required = [ordered]@{
+        vCpu = [int]$compatibility.targetArchitecture.resourceTotals.vCpu
+        memoryGb = [int]$compatibility.targetArchitecture.resourceTotals.memoryGb
+        storageGb = [int]$compatibility.targetArchitecture.resourceTotals.storageGb
+    }
+    $available = [ordered]@{
+        vCpu = [int]$inventory.managementPlane.availableCapacity.vCpu
+        memoryGb = [int]$inventory.managementPlane.availableCapacity.memoryGb
+        storageGb = [int]$inventory.managementPlane.availableCapacity.storageGb
+    }
+    $remaining = [ordered]@{
+        vCpu = $available.vCpu - $required.vCpu
+        memoryGb = $available.memoryGb - $required.memoryGb
+        storageGb = $available.storageGb - $required.storageGb
+    }
+    if ($remaining.vCpu -lt 0 -or $remaining.memoryGb -lt 0 -or $remaining.storageGb -lt 0) {
+        throw 'The pinned target architecture does not fit the inventoried management-domain capacity.'
+    }
+
+    $supportBoundaries = foreach ($rule in $compatibility.sourceRules) {
+        [ordered]@{
+            sourceProductId = $rule.sourceProductId
+            sourceProduct = $rule.sourceProduct
+            sourceVersion = $rule.sourceVersion
+            endOfGeneralSupport = $rule.endOfGeneralSupport
+            targetReleaseDate = $compatibility.targetReleaseDate
+            boundary = $rule.supportBoundary
+            impact = if ($rule.supportBoundary -eq 'ends-before-target-release') {
+                'This source was already outside general support when 9.0.2 shipped, so the plan must use every pinned supported bridge and must not attempt a direct jump.'
+            }
+            else {
+                'This source remained in general support when 9.0.2 shipped, but its pinned migration mode and prerequisites still govern the transition.'
+            }
+        }
+    }
+
+    $contentDisposition = foreach ($rule in $compatibility.sourceRules) {
+        $source = $inventoryProducts[$rule.sourceProductId]
+        $content = @{}
+        foreach ($item in $source.content) {
+            $content[$item.id] = $item
+        }
+        $items = foreach ($contentRule in $rule.contentRules) {
+            $inventoryItem = $content[$contentRule.inventoryId]
+            [ordered]@{
+                inventoryId = $contentRule.inventoryId
+                kind = $inventoryItem.kind
+                disposition = $contentRule.disposition
+                destination = $contentRule.destination
+                detail = Get-ContentDetail -Disposition $contentRule.disposition -Description $inventoryItem.description -Destination $contentRule.destination
+            }
+        }
+        [ordered]@{
+            sourceProductId = $rule.sourceProductId
+            sourceProduct = $rule.sourceProduct
+            sourceVersion = $rule.sourceVersion
+            targetComponent = $rule.targetComponent
+            targetVersion = $rule.targetVersion
+            transitions = @($rule.transitions)
+            items = @($items)
+        }
+    }
+
+    $steps = foreach ($requiredStep in $compatibility.requiredSteps) {
+        $gates = foreach ($gateId in $requiredStep.requiredGateIds) {
+            Get-GateDefinition -GateId $gateId
+        }
+        [ordered]@{
+            order = [int]$requiredStep.order
+            stepId = $requiredStep.stepId
+            source = [ordered]@{
+                productId = $requiredStep.sourceProductId
+                product = $requiredStep.sourceProduct
+                version = $requiredStep.sourceVersion
+            }
+            target = [ordered]@{
+                productId = Get-TargetProductId -Component $requiredStep.targetComponent
+                product = $requiredStep.targetComponent
+                version = $requiredStep.targetVersion
+            }
+            action = $requiredStep.action
+            method = $requiredStep.method
+            dependsOn = @($requiredStep.dependsOn)
+            gates = @($gates)
+            carries = @($requiredStep.carryIds)
+            abandons = @($requiredStep.abandonIds)
+            rollback = Get-RollbackDefinition -StepId $requiredStep.stepId
+        }
+    }
+
+    $plan = [ordered]@{
+        schemaVersion = '1.0.0'
+        estateId = $inventory.estateId
+        snapshotId = $compatibility.snapshotId
+        targetVersion = $compatibility.targetVersion
+        sdkModules = @($compatibility.requiredSdkModules)
+        researchConsulted = @($ResearchConsulted)
+        architecture = [ordered]@{
+            components = @($components)
+            resourceTotals = [ordered]@{
+                required = $required
+                available = $available
+                remaining = $remaining
+            }
+        }
+        supportBoundaries = @($supportBoundaries)
+        contentDisposition = @($contentDisposition)
+        steps = @($steps)
+    }
+
+    $json = $plan | ConvertTo-Json -Depth 100
+    $outputParent = Split-Path -Parent $OutputPath
+    if ($outputParent -and -not (Test-Path -LiteralPath $outputParent)) {
+        $null = New-Item -ItemType Directory -Path $outputParent
+    }
+    Set-Content -LiteralPath $OutputPath -Value $json -Encoding utf8
+    if (-not (Test-VcfMigrationPlan -PlanPath $OutputPath -SpecificationPath $SpecificationPath)) {
+        throw 'Generated plan does not satisfy the installer specification schema.'
+    }
+    return Get-Item -LiteralPath $OutputPath
+}
+
+Export-ModuleMember -Function New-VcfMigrationPlan, Test-VcfMigrationPlan

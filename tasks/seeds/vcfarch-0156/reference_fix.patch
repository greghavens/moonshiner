+function Get-RollbackDefinition {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $StepId
+    )
+
+    $definitions = @{
+        'estate-preflight' = @('A preflight result is incomplete or outside the pinned limits.', 'Make no estate change; correct the failed preflight and rerun it.')
+        'patch-suite-lifecycle' = @('Patch 2 installation or the post-patch inventory sync fails.', 'Revert the Lifecycle recovery point and restore its database backup.')
+        'upgrade-operations-bridge' = @('The 8.14.1 upgrade fails or cluster health and collection do not recover.', 'Revert all coordinated Operations node snapshots and restore the 8.10.2 backup.')
+        'replace-legacy-collector' = @('The new cloud proxy cannot collect the legacy adapter workload.', 'Move adapters back to the still-running Lite Remote Collector and remove the new proxy.')
+        'upgrade-vcf-operations' = @('VCF Operations or Fleet deployment fails its health and content checks.', 'Restore the coordinated 8.14.1 cluster and remove the incomplete Fleet appliance.')
+        'upgrade-vcf-automation' = @('The Fleet import or 9.0.2 upgrade cannot restore Automation service and content.', 'Follow the Fleet failed-import recovery path and restore the 8.18.1 appliances and data.')
+        'deploy-vcf-operations-logs' = @('The new cluster, recreated content or test ingestion does not validate.', 'Remove the parallel target deployment; the untouched 8.18.3 source remains active.')

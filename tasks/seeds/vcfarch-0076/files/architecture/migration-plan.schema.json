{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0076:migration-plan:v1",
  "title": "VCF brownfield migration plan",
  "type": "object",
  "required": [
    "sddcId",
    "workflowType",
    "hostSpecs",
    "version",
    "vcenterSpec",
    "clusterSpec",
    "dvsSpecs",
    "nsxtSpec",
    "networkSpecs",
    "dnsSpec",
    "ntpServers",
    "sddcManagerSpec",
    "datastoreSpec",
    "vcfOperationsSpec",
    "vcfManagementComponentsInfrastructureSpec",
    "licenseServerSpec",
    "planSchemaVersion",
    "planId",
    "estateId",
    "inventoryRef",
    "compatibilitySnapshotRef",
    "sourceVcfVersion",
    "targetVcfVersion",
    "topology",
    "vcfUpgradePath",
    "components",
    "stages"
  ],
  "properties": {
    "sddcId": {"type": "string"},
    "workflowType": {"type": "string"},
    "hostSpecs": {"type": "array"},
    "version": {"type": "string"},
    "vcenterSpec": {"type": "object"},
    "clusterSpec": {"type": "object"},
    "dvsSpecs": {"type": "array"},
    "nsxtSpec": {"type": "object"},
    "networkSpecs": {"type": "array"},
    "dnsSpec": {"type": "object"},
    "ntpServers": {"type": "array"},
    "sddcManagerSpec": {"type": "object"},
    "managementPoolName": {"type": "string"},
    "ceipEnabled": {"type": "boolean"},
    "datastoreSpec": {"type": "object"},
    "vcfOperationsSpec": {"type": "object"},
    "vcfManagementComponentsInfrastructureSpec": {"type": "object"},
    "licenseServerSpec": {"type": "object"},
    "vcfInstanceName": {"type": "string"},
    "planSchemaVersion": {"const": 1},
    "planId": {"type": "string", "pattern": "^[a-z0-9-]+$", "minLength": 3},
    "estateId": {"type": "string", "minLength": 1},
    "inventoryRef": {"const": "fixtures/estate_inventory.json"},
    "compatibilitySnapshotRef": {"const": "compatibility/vcf-9.1-compatibility-snapshot.json"},
    "sourceVcfVersion": {"type": "string", "minLength": 1},
    "targetVcfVersion": {"type": "string", "minLength": 1},
    "topology": {
      "type": "object",
      "required": ["deploymentModel", "siteCount", "availabilityZones", "domainCount", "clusterCount", "hostCount", "storage"],
      "properties": {
        "deploymentModel": {"type": "string"},
        "siteCount": {"type": "integer", "minimum": 1},
        "availabilityZones": {"type": "integer", "minimum": 1},
        "domainCount": {"type": "integer", "minimum": 1},
        "clusterCount": {"type": "integer", "minimum": 1},
        "hostCount": {"type": "integer", "minimum": 1},
        "storage": {"type": "string"}
      },
      "additionalProperties": false
    },
    "vcfUpgradePath": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/stage"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "gate": {
      "type": "object",
      "required": ["id", "condition"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "condition": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": ["id", "name", "sourceVersion", "targetVersion", "action", "stage", "gates"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 1},
        "sourceVersion": {"type": ["string", "null"]},
        "targetVersion": {"type": "string", "minLength": 1},
        "action": {"enum": ["upgrade", "deploy"]},
        "stage": {"type": "integer", "minimum": 1},
        "gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gate"}}
      },
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "required": ["order", "id", "name", "componentIds", "entryGates", "exitGates"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 1},
        "componentIds": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
        "entryGates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "exitGates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  }
}

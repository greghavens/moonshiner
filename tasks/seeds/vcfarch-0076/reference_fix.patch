@@ -0,0 +1,203 @@
+"""Build the pinned brownfield VCF migration architecture."""
+
+from __future__ import annotations
+
+from copy import deepcopy
+from typing import Any
+
+
+def _component_index(inventory: dict[str, Any]) -> dict[str, dict[str, Any]]:
+    components: dict[str, dict[str, Any]] = {}
+    for item in inventory["components"]:
+        component_id = item["id"]
+        if component_id in components:
+            raise ValueError(f"duplicate inventory component: {component_id}")
+        components[component_id] = item
+    return components
+
+
+def _gates(component_id: str, compatibility: dict[str, Any]) -> list[dict[str, str]]:
+    catalog = compatibility["gateCatalog"]
+    return [
+        {"id": gate_id, "condition": catalog[gate_id]}
+        for gate_id in compatibility["componentGateRequirements"][component_id]
+    ]
+
+
+def _planned_components(
+    inventory: dict[str, Any], compatibility: dict[str, Any], stage_by_component: dict[str, int]
+) -> list[dict[str, Any]]:
+    targets = compatibility["componentTargets"]
+    requirements = compatibility["componentGateRequirements"]
+    source = _component_index(inventory)
+    expected = set(source)
+    if set(targets) != expected or set(requirements) != expected or set(stage_by_component) != expected:
+        raise ValueError("inventory, targets, gates, and stages must name the same components")
+
+    return [
+        {
+            "id": item["id"],
+            "name": item["name"],
+            "sourceVersion": item["version"],
+            "targetVersion": targets[item["id"]],
+            "action": "upgrade" if item["installed"] else "deploy",
+            "stage": stage_by_component[item["id"]],
+            "gates": _gates(item["id"], compatibility),
+        }
+        for item in inventory["components"]
+    ]
+
+
+def build_plan(inventory: dict[str, Any], compatibility: dict[str, Any]) -> dict[str, Any]:
+    """Return a deterministic SddcSpec-compatible ordered migration plan."""
+    domain = inventory["domain"]
+    cluster = domain["cluster"]
+    infrastructure = inventory["infrastructure"]
+    source = _component_index(inventory)
+    targets = compatibility["componentTargets"]
+
+    stages = [
+        {
+            "order": 10,
+            "id": "upgrade-vcf-operations",
+            "name": "Upgrade the operations control plane",
+            "componentIds": ["vcf-operations"],
+            "entryGates": ["estate-health", "supported-direct-hop", "no-back-in-time"],
+            "exitGates": ["vcf-operations-first"],
+        },
+        {
+            "order": 20,
+            "id": "upgrade-sddc-manager",
+            "name": "Upgrade SDDC Manager and lifecycle services",
+            "componentIds": ["sddc-manager"],
+            "entryGates": ["vcf-operations-first"],
+            "exitGates": ["sddc-manager-ready"],
+        },
+        {
+            "order": 30,
+            "id": "establish-management-services",
+            "name": "Deploy VCF Management Services and centralized licensing",
+            "componentIds": ["vcf-management-services", "license-server"],
+            "entryGates": ["sddc-manager-ready", "management-services-network"],
+            "exitGates": ["license-server-ready"],
+        },
+        {
+            "order": 40,
+            "id": "upgrade-nsx",
+            "name": "Advance the network virtualization layer",
+            "componentIds": ["nsx-manager"],
+            "entryGates": ["license-server-ready", "nsx-forward-build", "four-host-vsan"],
+            "exitGates": ["nsx-forward-build"],
+        },
+        {
+            "order": 50,
+            "id": "upgrade-vcenter",
+            "name": "Advance the vSphere management layer",
+            "componentIds": ["vcenter-server"],
+            "entryGates": ["vcenter-after-nsx", "license-server-ready"],
+            "exitGates": ["vcenter-after-nsx"],
+        },
+        {
+            "order": 60,
+            "id": "remediate-hosts-and-vsan",
+            "name": "Roll the four-host cluster and preserve vSAN compliance",
+            "componentIds": ["esxi-cluster", "vsan"],
+            "entryGates": ["drivers-and-vibs", "four-host-vsan", "vsan-health"],
+            "exitGates": ["post-upgrade-health"],
+        },
+    ]

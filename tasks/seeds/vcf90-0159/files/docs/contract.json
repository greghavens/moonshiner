{
  "title": "VCF Automation 9.0 reference-derived REST contract",
  "product": "VMware Cloud Foundation Automation",
  "product_version": "9.0",
  "provenance": {
    "source_kind": "official_reference_documentation",
    "published_specification": false,
    "statement": "This contract is derived from the official Broadcom xAPI reference documentation. It is not a published specification, and VCF Automation is not specified in vmware/vcf-api-specs.",
    "comparison_repository": "vmware/vcf-api-specs",
    "comparison_repository_license": "Apache-2.0",
    "vcf_automation_specification_present": false
  },
  "operations": [
    {
      "operation_id": "requestCatalogItemInstances",
      "operation": "POST /catalog/api/items/{id}/request",
      "method": "POST",
      "path": "/catalog/api/items/{id}/request",
      "authentication": "Bearer access token",
      "request": {
        "content_type": "application/json",
        "body": {
          "bulkRequestCount": "optional integer",
          "deploymentName": "optional string",
          "inputs": "optional object",
          "projectId": "optional string",
          "reason": "optional string",
          "version": "optional string"
        },
        "unset_optional_fields": "omit"
      },
      "success": {
        "status": 200,
        "body": "array of objects containing deploymentId and deploymentName"
      },
      "source_url": "https://developer.broadcom.com/xapis/vm-apps-org-catalog/9.0/catalog/api/items/id/request/post/"
    },
    {
      "operation_id": "getDeploymentById",
      "operation": "GET /deployment/api/deployments/{deploymentId}",
      "method": "GET",
      "path": "/deployment/api/deployments/{deploymentId}",
      "authentication": "Bearer access token",
      "request": {
        "optional_query": [
          "expandResources",
          "expandLastRequest",
          "expandProject",
          "expand",
          "deleted"
        ],
        "unset_optional_fields": "omit"
      },
      "success": {
        "status": 200,
        "body": "Deployment JSON object"
      },
      "errors": {
        "401": "Unauthorized"
      },
      "source_url": "https://developer.broadcom.com/xapis/vm-apps-org-deployment/9.0/deployment/api/deployments/deploymentId/get/"
    },
    {
      "operation_id": "refreshAccessToken",
      "operation": "POST /oidc/oauth2/token (refresh_token grant)",
      "method": "POST",
      "path": "/oidc/oauth2/token",
      "authentication": "Basic base64(client_id:client_secret)",
      "request": {
        "content_type": "application/x-www-form-urlencoded",
        "required_form_fields": {
          "grant_type": "refresh_token",
          "refresh_token": "current refresh token"
        },
        "unset_optional_fields": "omit"
      },
      "success": {
        "status": 200,
        "body": "JSON object with access_token and optional rotated refresh_token, token_type, expires_in and scope"
      },
      "reference_note": "The VCF Automation 9.0 identity reference documents the token request fields and explicitly directs callers from its deprecated URI to /oidc/oauth2/token; this contract uses that named successor path.",
      "source_url": "https://developer.broadcom.com/xapis/vm-apps-org-identity/9.0/csp/gateway/am/api/auth/token/post/"
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF 9.1 estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["estateId", "targetVcfVersion", "steps"],
  "properties": {
    "estateId": {"type": "string", "minLength": 1},
    "targetVcfVersion": {"type": "string", "pattern": "^9\\.1\\.0\\.0$"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "componentId", "componentName", "fromVersion", "targetComponent", "targetVersion", "action", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "componentId": {"type": "string", "minLength": 1},
          "componentName": {"type": "string", "minLength": 1},
          "fromVersion": {"type": "string", "minLength": 1},
          "targetComponent": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "action": {"type": "string", "enum": ["UPGRADE", "ROLLING_UPGRADE", "MIGRATE_AND_DECOMMISSION"]},
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}

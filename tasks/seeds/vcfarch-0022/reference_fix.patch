+	plan := MigrationPlan{EstateID: estate.EstateID, TargetVCFVersion: authority.TargetVCFVersion}
+	for _, path := range authority.MigrationPaths {
+		component, ok := estateByID[path.ComponentID]
+		if !ok {
+			return nil, MigrationPlan{}, fmt.Errorf("migration path references component %s not present in estate", path.ComponentID)
+		}
+		plan.Steps = append(plan.Steps, MigrationStep{

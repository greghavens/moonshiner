+		"ntpServers": scenario.Network.NTP,
+		"sddcManagerSpec": map[string]any{
+			"hostname":              scenario.Names.SDDCManager,
+			"version":               versions["SDDC_MANAGER"],
+			"useExistingDeployment": false,
+		},
+		"managementPoolName":          "DAL01-MGMT-NP01",

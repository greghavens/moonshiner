+package vcfarchitecture
+
+import "testing"
+
+func TestBuildValidation(t *testing.T) {
+	tests := []struct {
+		name    string
+		mutate  func(*Scenario, *Estate, *CompatibilitySnapshot)
+		wantErr bool
+	}{
+		{
+			name: "valid fixed inputs",
+		},
+		{
+			name: "below supported host minimum",
+			mutate: func(scenario *Scenario, _ *Estate, _ *CompatibilitySnapshot) {
+				scenario.Names.Hostnames = scenario.Names.Hostnames[:3]
+			},
+			wantErr: true,
+		},
+		{
+			name: "available hosts disagree with inventory",
+			mutate: func(scenario *Scenario, _ *Estate, _ *CompatibilitySnapshot) {
+				scenario.Topology.AvailableHosts--
+			},
+			wantErr: true,
+		},
+		{
+			name: "supported combination is incomplete",
+			mutate: func(_ *Scenario, _ *Estate, authority *CompatibilitySnapshot) {
+				delete(authority.SupportedCombination, "NSX")
+			},
+			wantErr: true,
+		},
+		{
+			name: "management services network is missing",
+			mutate: func(scenario *Scenario, _ *Estate, _ *CompatibilitySnapshot) {
+				filtered := scenario.Network.Segments[:0]
+				for _, segment := range scenario.Network.Segments {
+					if segment.Type != "VM_MANAGEMENT" {
+						filtered = append(filtered, segment)
+					}
+				}
+				scenario.Network.Segments = filtered
+			},
+			wantErr: true,
+		},
+		{
+			name: "migration path lacks an estate component",
+			mutate: func(_ *Scenario, estate *Estate, _ *CompatibilitySnapshot) {
+				estate.Components = estate.Components[:len(estate.Components)-1]
+			},
+			wantErr: true,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			var scenario Scenario
+			var estate Estate
+			var authority CompatibilitySnapshot
+			for _, input := range []struct {
+				path string
+				dst  any
+			}{
+				{"fixtures/scenario.json", &scenario},
+				{"fixtures/estate.json", &estate},
+				{"fixtures/compatibility-snapshot.json", &authority},
+			} {
+				if err := LoadJSON(input.path, input.dst); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if tc.mutate != nil {
+				tc.mutate(&scenario, &estate, &authority)
+			}
+			_, _, err := Build(scenario, estate, authority)
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("Build() error = %v, wantErr %v", err, tc.wantErr)
+			}
+		})
+	}
+}

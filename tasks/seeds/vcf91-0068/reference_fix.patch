new file mode 100644
index 0000000..17a2cd1
--- /dev/null
+++ b/nsx_policy/errors.py
@@ -0,0 +1,25 @@
+"""Error types exposed by :mod:`nsx_policy`."""
+
+
+class NsxPolicyError(Exception):
+    """An NSX HTTP error or a success document that violates the contract."""
+
+    def __init__(self, status_code, payload=None, *, message=None):
+        self.status_code = status_code
+        self.payload = payload
+        envelope = payload if isinstance(payload, dict) else {}
+        self.error_code = envelope.get("error_code")
+        self.error_message = envelope.get("error_message")
+        self.details = envelope.get("details")
+
+        if message is not None:
+            text = message
+        else:
+            text = f"NSX Policy API returned HTTP {status_code}"
+            if self.error_code is not None:
+                text += f" ({self.error_code})"
+            if self.error_message:
+                text += f": {self.error_message}"
+            if self.details:
+                text += f" — {self.details}"
+        super().__init__(text)
diff --git a/nsx_policy/client.py b/nsx_policy/client.py
new file mode 100644
index 0000000..624efc1
--- /dev/null
+++ b/nsx_policy/client.py
@@ -0,0 +1,117 @@
+"""Bearer-authenticated transport for two NSX Policy segment operations."""
+
+from collections.abc import Mapping
+import json
+from urllib.error import HTTPError
+from urllib.parse import quote
+from urllib.request import Request, urlopen
+
+from .errors import NsxPolicyError
+
+
+class NsxPolicyClient:
+    """Client for the infra Segment operations pinned in docs/contract.json."""
+
+    API_BASE_PATH = "/policy/api/v1"
+
+    def __init__(self, base_url, token_provider, *, timeout=10.0):
+        if not isinstance(base_url, str) or not base_url:
+            raise ValueError("base_url must be a non-empty string")
+        if not callable(token_provider):
+            raise TypeError("token_provider must be callable")
+        self.base_url = base_url.rstrip("/")
+        self.token_provider = token_provider
+        self.timeout = timeout
+        self._token = None
+
+    def _new_token(self):
+        token = self.token_provider()
+        if not isinstance(token, str) or not token:
+            raise ValueError("token_provider must return a non-empty string")
+        return token
+
+    def _request(self, method, path, body=None):
+        data = None
+        if body is not None:
+            data = json.dumps(body, separators=(",", ":")).encode("utf-8")
+
+        for attempt in range(2):
+            if self._token is None:
+                self._token = self._new_token()
+            headers = {
+                "Authorization": f"Bearer {self._token}",
+                "Accept": "application/json",
+            }
+            if data is not None:
+                headers["Content-Type"] = "application/json; charset=utf-8"
+            request = Request(
+                self.base_url + self.API_BASE_PATH + path,
+                data=data,
+                headers=headers,
+                method=method,
+            )
+            try:
+                with urlopen(request, timeout=self.timeout) as response:
+                    raw = response.read()
+                    payload = self._decode(raw)
+                    return response.status, payload
+            except HTTPError as exc:
+                payload = self._decode(exc.read())
+                if exc.code == 401 and attempt == 0:
+                    self._token = self._new_token()
+                    continue
+                raise NsxPolicyError(exc.code, payload) from None
+
+        raise AssertionError("request retry loop exhausted unexpectedly")
+
+    @staticmethod
+    def _decode(raw):
+        if not raw:
+            return None
+        try:
+            return json.loads(raw.decode("utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError):
+            return {"raw": raw.decode("utf-8", errors="replace")}
+
+    def upsert_segment(self, segment):
+        """Create or replace one infra Segment by its body id."""
+
+        if not isinstance(segment, Mapping):
+            raise TypeError("segment must be a mapping")
+        segment_id = segment.get("id")
+        if not isinstance(segment_id, str) or not segment_id:
+            raise ValueError("segment id must be a non-empty string")
+        status, payload = self._request(
+            "PUT",
+            f"/infra/segments/{quote(segment_id, safe='')}",
+            dict(segment),
+        )
+        if status != 200 or not isinstance(payload, dict):
+            raise NsxPolicyError(
+                status,
+                payload,
+                message="CreateOrReplaceInfraSegment returned a malformed success document",
+            )
+        return payload
+
+    def list_segments(self):
+        """Return all infra Segments sorted lexicographically by id."""
+
+        status, payload = self._request("GET", "/infra/segments")
+        if status != 200 or not isinstance(payload, dict):
+            raise NsxPolicyError(
+                status,
+                payload,
+                message="ListAllInfraSegments returned a malformed success document",
+            )
+        results = payload.get("results")
+        if not isinstance(results, list) or any(
+            not isinstance(item, dict) or not isinstance(item.get("id"), str)
+            for item in results
+        ):
+            raise NsxPolicyError(
+                status,
+                payload,
+                message="ListAllInfraSegments results must be Segment objects with string ids",
+            )
+        return sorted(results, key=lambda item: item["id"])
diff --git a/nsx_policy/segments.py b/nsx_policy/segments.py
new file mode 100644
index 0000000..0eed2b9
--- /dev/null
+++ b/nsx_policy/segments.py
@@ -0,0 +1,9 @@
+"""Batch orchestration for infra Segment upserts."""
+
+
+def sync_segments(client, segments):
+    """Upsert in input order and return the final, client-sorted collection."""
+
+    for segment in segments:
+        client.upsert_segment(segment)
+    return client.list_segments()

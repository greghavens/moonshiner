{
  "contractVersion": 1,
  "apiVersion": "9.0.0.0",
  "derivedFrom": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "commitSha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "specPath": "specifications/sddc-manager/sddc-manager-openapi.json",
    "openapi": "3.0.1",
    "license": "Apache-2.0"
  },
  "operationIds": [
    "createToken",
    "getCredentials"
  ],
  "operations": {
    "createToken": {
      "method": "POST",
      "path": "/v1/tokens",
      "summary": "Create Token Pair",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "TokenCreationSpec"
      },
      "successStatus": 201,
      "successSchema": "TokenPair",
      "errorStatuses": [
        400,
        500
      ]
    },
    "getCredentials": {
      "method": "GET",
      "path": "/v1/credentials",
      "summary": "Retrieve a list of credentials",
      "requestBody": null,
      "queryParameters": [
        {
          "name": "resourceName",
          "required": false,
          "type": "string"
        },
        {
          "name": "resourceIp",
          "required": false,
          "type": "string",
          "deprecated": true
        },
        {
          "name": "resourceType",
          "required": false,
          "type": "string"
        },
        {
          "name": "domainName",
          "required": false,
          "type": "string"
        },
        {
          "name": "pageNumber",
          "required": false,
          "type": "string",
          "default": "0"
        },
        {
          "name": "pageSize",
          "required": false,
          "type": "string",
          "default": "0"
        },
        {
          "name": "accountType",
          "required": false,
          "type": "string"
        }
      ],
      "successStatus": 200,
      "successSchema": "PageOfCredential",
      "errorStatuses": [
        400,
        401,
        403,
        500
      ]
    }
  },
  "schemas": {
    "TokenCreationSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "apiKey": {
          "type": "string"
        },
        "idToken": {
          "type": "string"
        }
      }
    },
    "TokenPair": {
      "type": "object",
      "required": [],
      "properties": {
        "accessToken": {
          "type": "string"
        },
        "refreshToken": {
          "ref": "RefreshToken"
        }
      }
    },
    "RefreshToken": {
      "type": "object",
      "required": [],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "PageOfCredential": {
      "type": "object",
      "required": [],
      "properties": {
        "elements": {
          "type": "array",
          "items": "Credential",
          "readOnly": true
        },
        "pageMetadata": {
          "ref": "PageMetadata"
        }
      }
    },
    "PageMetadata": {
      "type": "object",
      "required": [],
      "properties": {
        "pageNumber": {
          "type": "integer",
          "format": "int32",
          "readOnly": true
        },
        "pageSize": {
          "type": "integer",
          "format": "int32",
          "readOnly": true
        },
        "totalElements": {
          "type": "integer",
          "format": "int32",
          "readOnly": true
        },
        "totalPages": {
          "type": "integer",
          "format": "int32",
          "readOnly": true
        }
      }
    },
    "Credential": {
      "type": "object",
      "required": [
        "accountType",
        "creationTimestamp",
        "credentialType",
        "id",
        "modificationTimestamp",
        "resource",
        "username"
      ],
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "credentialType": {
          "type": "string",
          "readOnly": true,
          "example": "One among: SSO, SSH, API, FTP, AUDIT"
        },
        "accountType": {
          "type": "string",
          "readOnly": true,
          "example": "One among: USER, SYSTEM, SERVICE"
        },
        "username": {
          "type": "string",
          "readOnly": true
        },
        "password": {
          "type": "string",
          "readOnly": true
        },
        "creationTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "modificationTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "expiry": {
          "ref": "ExpirationDetails"
        },
        "resource": {
          "ref": "AuthenticatedResource"
        },
        "autoRotatePolicy": {
          "ref": "AutoRotateCredentialPolicy"
        }
      }
    },
    "AuthenticatedResource": {
      "type": "object",
      "required": [
        "domainNames",
        "resourceId",
        "resourceName",
        "resourceType"
      ],
      "properties": {
        "resourceId": {
          "type": "string"
        },
        "resourceName": {
          "type": "string"
        },
        "resourceIp": {
          "type": "string",
          "deprecated": true
        },
        "resourceType": {
          "type": "string",
          "example": "One among: ESXI, VCENTER, PSC, NSXT_MANAGER, NSXT_EDGE, NSX_ALB, BACKUP"
        },
        "domainNames": {
          "type": "array",
          "items": "string"
        },
        "domainName": {
          "type": "string",
          "deprecated": true
        }
      }
    },
    "ExpirationDetails": {
      "type": "object",
      "required": [],
      "properties": {
        "expiryDate": {
          "type": "string",
          "readOnly": true
        },
        "lastCheckedDate": {
          "type": "string",
          "readOnly": true
        },
        "connectivityStatus": {
          "type": "string",
          "readOnly": true,
          "example": "One among: ACTIVE, ERROR, UNKNOWN"
        },
        "status": {
          "type": "string",
          "readOnly": true,
          "example": "One among: ACTIVE, EXPIRING, EXPIRED, UNKNOWN"
        }
      }
    }
  },
  "pagination": {
    "style": "page-number",
    "pageNumberParameter": "pageNumber",
    "pageSizeParameter": "pageSize",
    "firstPageNumber": 0,
    "elementsField": "elements",
    "metadataField": "pageMetadata",
    "totalPagesField": "totalPages",
    "totalElementsField": "totalElements",
    "note": "pageNumber and pageSize are declared as strings in this specification revision. The collection is complete only when every page from 0 through totalPages-1 has been read; a totalPages of 0 means the single request already covered the empty collection."
  },
  "resourceTypes": [
    "ESXI",
    "VCENTER",
    "PSC",
    "NSXT_MANAGER",
    "NSXT_EDGE",
    "NSX_ALB",
    "BACKUP"
  ],
  "accountTypes": [
    "USER",
    "SYSTEM",
    "SERVICE"
  ],
  "credentialTypes": [
    "SSO",
    "SSH",
    "API",
    "FTP",
    "AUDIT"
  ],
  "sdkConnectionHandshake": {
    "method": "GET",
    "path": "/v1/sddc-manager",
    "operationId": null,
    "note": "Connect-VcfSddcManagerServer probes this appliance route once while establishing a session. The route carries no operationId in this specification revision, so it is recorded here as SDK transport bootstrap rather than as a contract operation. The loopback mock answers it and rejects every route that is neither this probe nor one of the operationIds listed above."
  }
}

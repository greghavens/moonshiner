--- a/src/VcfSddcManager.CredentialInventory.psm1
+++ b/src/VcfSddcManager.CredentialInventory.psm1
@@ -30,7 +30,62 @@
         [string] $AccountType
     )
 
-    throw 'Get-VcfSddcManagerCredentialInventory has not been implemented.'
+    # Forward only the optional filters the caller actually supplied. Passing an unset
+    # filter through as '' would put an empty resourceName=/resourceType=/domainName=/
+    # accountType= onto the query string, which is a different request from omitting it.
+    $filters = @{}
+    foreach ($name in @('ResourceName', 'ResourceType', 'DomainName', 'AccountType')) {
+        if ($PSBoundParameters.ContainsKey($name)) {
+            $filters[$name] = $PSBoundParameters[$name]
+        }
+    }
+
+    $collected = [System.Collections.Generic.List[object]]::new()
+    $pageNumber = 0
+    do {
+        $page = Invoke-VcfGetCredentials `
+            -Server $Server `
+            @filters `
+            -PageNumber ([string] $pageNumber) `
+            -PageSize ([string] $PageSize)
+
+        if ($null -eq $page -or $null -eq $page.PageMetadata) {
+            throw "getCredentials page $pageNumber returned no pageMetadata."
+        }
+
+        # pageMetadata.pageSize reports the element count of the page just returned, not
+        # the requested page size, so totalPages is the only sound termination signal.
+        $totalPages = [int] $page.PageMetadata.TotalPages
+        if ($null -ne $page.Elements) {
+            $collected.AddRange([object[]] @($page.Elements))
+        }
+
+        $pageNumber++
+    } while ($pageNumber -lt $totalPages)
+
+    $ordered = [System.Collections.Generic.List[object]]::new($collected)
+    $ordered.Sort([System.Comparison[object]] {
+            param($left, $right)
+
+            $comparison = [string]::CompareOrdinal(
+                [string] $left.Resource.ResourceName,
+                [string] $right.Resource.ResourceName)
+            if ($comparison -ne 0) { return $comparison }
+
+            $comparison = [string]::CompareOrdinal(
+                [string] $left.CredentialType,
+                [string] $right.CredentialType)
+            if ($comparison -ne 0) { return $comparison }
+
+            $comparison = [string]::CompareOrdinal(
+                [string] $left.Username,
+                [string] $right.Username)
+            if ($comparison -ne 0) { return $comparison }
+
+            return [string]::CompareOrdinal([string] $left.Id, [string] $right.Id)
+        })
+
+    return $ordered.ToArray()
 }
 
 Export-ModuleMember -Function Get-VcfSddcManagerCredentialInventory

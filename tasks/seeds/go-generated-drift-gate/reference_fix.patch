diff --git a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -11,11 +11,26 @@ GENERATOR := $(GO) run ./cmd/eventgen
 generate:
 	$(GENERATOR) -schema $(SCHEMA) -go-out $(GO_OUTPUT) -doc-out $(DOC_OUTPUT)
 
-# BUG: a check must not repair drift, and release source archives do not contain
-# Git metadata. Generate candidates away from the source tree before comparing.
 check-generated:
-	@$(MAKE) generate
-	@git diff --exit-code -- $(GO_OUTPUT) $(DOC_OUTPUT)
+	@set -eu; \
+	candidate_dir=$$(mktemp -d "$${TMPDIR:-/tmp}/eventwire-generated.XXXXXX"); \
+	trap 'rm -rf "$$candidate_dir"' 0 HUP INT TERM; \
+	$(GENERATOR) \
+		-schema $(SCHEMA) \
+		-go-out "$$candidate_dir/types.gen.go" \
+		-doc-out "$$candidate_dir/events.md"; \
+	stale=0; \
+	if ! cmp -s $(GO_OUTPUT) "$$candidate_dir/types.gen.go"; then \
+		echo "stale generated artifact: $(GO_OUTPUT)" >&2; \
+		diff -u $(GO_OUTPUT) "$$candidate_dir/types.gen.go" || :; \
+		stale=1; \
+	fi; \
+	if ! cmp -s $(DOC_OUTPUT) "$$candidate_dir/events.md"; then \
+		echo "stale generated artifact: $(DOC_OUTPUT)" >&2; \
+		diff -u $(DOC_OUTPUT) "$$candidate_dir/events.md" || :; \
+		stale=1; \
+	fi; \
+	exit "$$stale"
 
 test:
 	$(GO) test -count=1 ./...
diff --git a/docs/events.md b/docs/events.md
--- a/docs/events.md
+++ b/docs/events.md
@@ -23,3 +23,4 @@ A build artifact was released.
 | --- | --- | --- |
 | `build_id` | `BuildID` | `string` |
 | `artifact_digest` | `ArtifactDigest` | `string` |
+| `release_channel` | `ReleaseChannel` | `string` |
diff --git a/internal/eventwire/types.gen.go b/internal/eventwire/types.gen.go
--- a/internal/eventwire/types.gen.go
+++ b/internal/eventwire/types.gen.go
@@ -17,5 +17,6 @@ type BuildReleased struct {
 	BuildID        string `json:"build_id"`
 	ArtifactDigest string `json:"artifact_digest"`
+	ReleaseChannel string `json:"release_channel"`
 }
 
 func (BuildReleased) EventCode() string { return "build.released" }

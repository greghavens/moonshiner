{
  "package": "eventwire",
  "events": [
    {
      "name": "BuildQueued",
      "code": "build.queued",
      "description": "A build entered the release queue.",
      "fields": [
        {
          "go_name": "BuildID",
          "json_name": "build_id",
          "type": "string"
        },
        {
          "go_name": "Repository",
          "json_name": "repository",
          "type": "string"
        },
        {
          "go_name": "Attempt",
          "json_name": "attempt",
          "type": "int"
        }
      ]
    },
    {
      "name": "BuildReleased",
      "code": "build.released",
      "description": "A build artifact was released.",
      "fields": [
        {
          "go_name": "BuildID",
          "json_name": "build_id",
          "type": "string"
        },
        {
          "go_name": "ArtifactDigest",
          "json_name": "artifact_digest",
          "type": "string"
        },
        {
          "go_name": "ReleaseChannel",
          "json_name": "release_channel",
          "type": "string"
        }
      ]
    }
  ]
}

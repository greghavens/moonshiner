+    // ------------------------------------------------------------- step wiring
+
+    private Map<String, Object> step(String operationId, String action, String status, String taskId) {
+        Map<String, Object> s = Json.obj();
+        s.put("operationId", operationId);
+        if (action != null) {
+            s.put("action", action);
+        }
+        s.put("status", status);
+        if (taskId != null) {
+            s.put("taskId", taskId);
+        }
+        return s;
+    }
+
+    /**
+     * Records a task-backed step and, when its task did not succeed, closes the report out
+     * with the failure. Returns false when the rollout must stop here.
+     */
+    private boolean finish(Map<String, Object> report, List<Object> steps, String operationId,
+                           String action, String taskId, Map<String, Object> task) {
+        String status = Json.str(task, "status");
+        boolean ok = "SUCCEEDED".equals(status);
+        steps.add(step(operationId, action, ok ? "SUCCEEDED" : "FAILED", taskId));
+        if (ok) {
+            return true;
+        }
+        Map<String, Object> failure = Json.obj();
+        failure.put("stepIndex", steps.size() - 1);
+        failure.put("operationId", operationId);
+        if (action != null) {
+            failure.put("action", action);
+        }
+        failure.put("taskId", taskId);
+        failure.put("taskStatus", status);
+        Map<String, Object> stage = failedStage(task);
+        if (stage != null) {
+            failure.put("failedStageId", Json.str(stage, "id"));
+            String message = firstErrorMessage(stage);
+            if (message != null) {
+                failure.put("message", message);
+            }
+        }
+        report.put("outcome", "FAILED");
+        report.put("failure", failure);
+        return false;
+    }
+
+    private Map<String, Object> failedStage(Map<String, Object> task) {
+        Object stages = task.get("stages");
+        if (!(stages instanceof List)) {
+            return null;
+        }
+        for (Object entry : Json.list(stages)) {
+            Map<String, Object> stage = Json.map(entry);
+            if ("FAILED".equals(Json.str(stage, "status"))) {
+                return stage;
+            }
+        }
+        return null;
+    }
+
+    private String firstErrorMessage(Map<String, Object> stage) {
+        Object messages = stage.get("messages");
+        if (!(messages instanceof List)) {
+            return null;
+        }
+        for (Object entry : Json.list(messages)) {
+            Map<String, Object> m = Json.map(entry);
+            if ("ERROR".equals(Json.str(m, "level"))) {
+                return Json.str(m, "message", "defaultMessage");
+            }
+        }
+        return null;
+    }
+
+    // ---------------------------------------------------------------- payloads
+
+    private Map<String, Object> resolveSpec(Map<String, Object> request, Map<String, Object> depotSpec,
+                                            String componentType, String targetVersion) {
+        Map<String, Object> spec = Json.obj();
+        spec.put("fleetDepotSpec", depotSpec);
+        List<Object> versions = Json.arr();
+        versions.add(componentVersion(componentType, targetVersion));
+        Object additional = request.get("additionalComponents");
+        if (additional instanceof List) {
+            for (Object entry : Json.list(additional)) {
+                Map<String, Object> extra = Json.map(entry);
+                versions.add(componentVersion(Json.str(extra, "component"),
+                        extra.containsKey("version") ? Json.str(extra, "version") : null));
+            }
+        }
+        spec.put("componentVersions", versions);
+        return spec;
+    }
+
+    private Map<String, Object> componentVersion(String component, String version) {
+        Map<String, Object> cv = Json.obj();
+        cv.put("component", component);
+        // version is optional: an unpinned component resolves to what the depot publishes.
+        if (version != null) {
+            cv.put("version", version);
+        }
+        return cv;
+    }
+
+    private Map<String, Object> componentSpec(String targetVersion, String binaryUrl, String certificate) {
+        Map<String, Object> software = Json.obj();
+        software.put("version", targetVersion);
+        Map<String, Object> depot = Json.obj();
+        depot.put("url", binaryUrl);
+        if (certificate != null) {
+            List<Object> chain = Json.arr();
+            chain.add(certificate);
+            depot.put("certificate", chain);
+        }
+        Map<String, Object> spec = Json.obj();
+        spec.put("software", software);
+        spec.put("depot", depot);
+        return spec;
+    }
+
+    private String binaryUrlOf(List<Object> resolvedVersions, String componentType) {
+        for (Object entry : resolvedVersions) {
+            Map<String, Object> cv = Json.map(entry);
+            if (componentType.equals(Json.str(cv, "component"))) {
+                return Json.str(cv, "binaryUrl");
+            }
+        }
+        throw new IllegalStateException("the depot resolved no bundle for " + componentType);
+    }
+
+    private Map<String, Object> findFleetComponent(String componentType) throws Exception {
+        Map<String, Object> body = Json.map(get("/v1/components?scope=FLEET", 200).body);
+        Object components = body.get("components");
+        if (components instanceof List) {
+            for (Object entry : Json.list(components)) {
+                Map<String, Object> component = Json.map(entry);
+                if (componentType.equals(Json.str(component, "componentType"))) {
+                    return component;
+                }
+            }
+        }
+        throw new IllegalStateException("no fleet component of type " + componentType);
+    }
+
+    private String componentAction(String componentId, String action) {
+        return "/v1/components/" + encode(componentId) + "?action=" + encode(action);
+    }
+
+    private static String encode(String segment) {
+        return java.net.URLEncoder.encode(segment, java.nio.charset.StandardCharsets.UTF_8)
+                .replace("+", "%20");
+    }
+
+    // -------------------------------------------------------------- transport
+
+    private Map<String, Object> pollToTerminal(String taskId) throws Exception {
+        while (true) {
+            Map<String, Object> task = Json.map(get("/v1/tasks/" + encode(taskId), 200).body);
+            if (TERMINAL.contains(Json.str(task, "status"))) {
+                return task;
+            }
+        }
+    }
+
+    private Reply get(String pathAndQuery, int expected) throws Exception {
+        return send("GET", pathAndQuery, null, false, expected);
+    }
+
+    private Reply post(String pathAndQuery, Object body, boolean correlate, int expected) throws Exception {
+        return send("POST", pathAndQuery, body, correlate, expected);
+    }
+
+    private Reply send(String method, String pathAndQuery, Object body, boolean correlate,
+                       int expected) throws Exception {
+        HttpRequest.Builder builder = HttpRequest.newBuilder(URI.create(baseUrl + pathAndQuery))
+                .header("Authorization", "Bearer " + bearerToken)
+                .header("Accept", "application/json")
+                .timeout(TIMEOUT);
+        // X-Correlation-Id is only defined for the operations that accept it.
+        if (correlate) {
+            builder.header("X-Correlation-Id", correlationId);
+        }
+        if (body == null) {
+            builder.method(method, HttpRequest.BodyPublishers.noBody());
+        } else {
+            builder.header("Content-Type", "application/json")
+                    .method(method, HttpRequest.BodyPublishers.ofString(Json.write(body)));
+        }
+
+        HttpResponse<String> response = http.send(builder.build(), HttpResponse.BodyHandlers.ofString());
+        Object parsed;
+        try {
+            parsed = Json.parse(response.body());
+        } catch (RuntimeException e) {
+            throw new IllegalStateException(method + " " + pathAndQuery + " returned HTTP "
+                    + response.statusCode() + " with a body that is not JSON", e);
+        }
+        if (response.statusCode() != expected) {
+            throw new IllegalStateException(method + " " + pathAndQuery + " returned HTTP "
+                    + response.statusCode() + " (expected " + expected + "): "
+                    + Json.str(parsed, "code") + " - " + Json.str(parsed, "message", "defaultMessage"));
+        }
+        return new Reply(response.statusCode(), parsed);
+    }
+
+    private static final class Reply {
+        final int status;
+        final Object body;
+
+        Reply(int status, Object body) {
+            this.status = status;
+            this.body = body;
+        }
     }

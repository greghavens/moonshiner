+                post(componentAction(componentId, "precheck"), precheckBody, true, 202).body);
+        String precheckTaskId = Json.str(precheckTask, "id");
+        Map<String, Object> precheckDone = pollToTerminal(precheckTaskId);
+        if (!finish(report, steps, "performComponentAction", "precheck", precheckTaskId, precheckDone)) {

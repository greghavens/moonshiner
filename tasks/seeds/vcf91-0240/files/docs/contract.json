  },
  "operations": [
    {
      "operationId": "getComponents",
      "method": "GET",
      "path": "/v1/components",
      "tags": [
        "Components"
      ],
      "summary": "",
      "parameters": [
        {
          "name": "scope",
          "in": "query",
          "required": false,
          "type": "string",
          "enum": [
            "FLEET",
            "INSTANCE"
          ]
        }
      ],
      "requestBody": null,
      "responses": {
        "200": {
          "description": "OK",
          "schema": "Components"
        },
        "401": {
          "description": "Unauthorized",
          "schema": "ErrorResponse"
        },
        "500": {
          "description": "Internal server error",
          "schema": "ErrorResponse"
        }
      }
    },
    {
      "operationId": "setDepot",
      "method": "POST",
      "path": "/v1/depot",
      "tags": [
        "Depot"
      ],
      "summary": "",
      "parameters": [
        {
          "name": "X-Correlation-Id",
          "in": "header",
          "required": false,
          "type": "string"
        }
      ],
      "requestBody": {
        "contentType": "application/json",
        "schema": "FleetDepotSpec",
        "requiredProperties": [
          "certificate",
          "fqdn"
        ],
        "optionalProperties": []
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "schema": "Task"
        },
        "400": {
          "description": "Bad request. Invalid input specification.",
          "schema": "ErrorResponse"
        },
        "401": {
          "description": "Unauthorized",
          "schema": "ErrorResponse"
        },
        "500": {
          "description": "Internal server error",
          "schema": "ErrorResponse"
        }
      }
    },
    {
      "operationId": "resolveDepotComponents",
      "method": "POST",
      "path": "/v1/depot/components",
      "tags": [
        "Depot"
      ],
      "summary": "",
      "parameters": [],
      "requestBody": {
        "contentType": "application/json",
        "schema": "DepotComponentsSpec",
        "requiredProperties": [
          "componentVersions",
          "fleetDepotSpec"
        ],
        "optionalProperties": [
          "version"
        ]
      },
      "responses": {
        "200": {
          "description": "OK",
          "schema": "ResolvedComponentVersions"
        },
        "400": {
          "description": "Bad request. Invalid input specification.",
          "schema": "ErrorResponse"
        },
        "401": {
          "description": "Unauthorized",
          "schema": "ErrorResponse"
        },
        "500": {
          "description": "Internal server error",
          "schema": "ErrorResponse"
        }
      }
    },
    {
      "operationId": "performComponentAction",
      "method": "POST",
      "path": "/v1/components/{componentId}",
      "tags": [
        "Components"
      ],
      "summary": "",
      "parameters": [
        {
          "name": "X-Correlation-Id",
          "in": "header",
          "required": false,
          "type": "string"
        },
        {
          "name": "componentId",
          "in": "path",
          "required": true,
          "type": "string",
          "format": "uuid"
        },
        {
          "name": "action",
          "in": "query",
          "required": true,
          "type": "string",
          "enum": [
            "shutdown",
            "restart",
            "start",
            "refresh",
            "precheck",
            "apply"
          ]
        }
      ],
      "requestBody": {
        "contentType": "application/json",
        "schema": "ComponentUpgradeSpec",
        "requiredProperties": [
          "componentSpec"
        ],
        "optionalProperties": [
          "correlationId",
          "lcmPlatformSpec"
        ]
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "schema": "Task"
        },
        "400": {
          "description": "Bad Request",
          "schema": "ErrorResponse"
        },
        "404": {
          "description": "Not Found",
          "schema": "ErrorResponse"
        },
        "500": {
          "description": "Internal Server Error",
          "schema": "ErrorResponse"
        }
      }
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{taskId}",
      "tags": [
        "Task"
      ],
      "summary": "Get a task",
      "parameters": [
        {
          "name": "taskId",
          "in": "path",
          "required": true,
          "type": "string",
          "format": "uuid"
        }
      ],
      "requestBody": null,
      "responses": {
        "200": {
          "description": "OK",
          "schema": "Task"
        },
        "404": {
          "description": "Not Found",
          "schema": "ErrorResponse"
        },
        "500": {
          "description": "Internal Server Error",
          "schema": "ErrorResponse"
        }
      }
    }
  ],
  "schemas": {
    "Component": {
      "description": "Installed Component subject to lifecycle.",
      "properties": {
        "id": {
          "description": "Component Identifier.",
          "format": "uuid",
          "type": "string"
        },
        "componentType": {
          "description": "Component Type.",
          "type": "string"
        },
        "deploymentType": {
          "description": "Deployment Type.",
          "enum": [
            "OVA",
            "VSP"
          ],
          "type": "string"
        },
        "version": {
          "description": "Component Version.",
          "type": "string"
        },
        "size": {
          "description": "Component Size (e.g. Small/Medium/Large).",
          "type": "string"
        },
        "fqdn": {
          "description": "Component FQDN.",
          "type": "string"
        },
        "certificate": {
          "description": "PEM encoded certificate (chain).",
          "type": "string"
        },
        "nodes": {
          "description": "Nodes forming a Component (cluster) (mostly applicable for OVA components or VSP cluster itself).",
          "items": {
            "$ref": "#/components/schemas/Node"
          },
          "type": "array"
        },
        "scope": {
          "description": "Scope of the component - either FLEET or INSTANCE level.",
          "enum": [
            "FLEET",
            "INSTANCE"
          ],
          "type": "string"
        },
        "vcenter": {
          "$ref": "#/components/schemas/Vcenter"
        },
        "vspCluster": {
          "$ref": "#/components/schemas/VspCluster"
        }
      },
      "title": "Component",
      "type": "object"
    },
    "ComponentDesiredSpec": {
      "description": "Specifications related to the component's desired configuration and the source for its upgrade artifacts.\n",
      "properties": {
        "software": {
          "$ref": "#/components/schemas/SoftwareSpec"
        },
        "policy": {
          "description": "Specific policies to apply during the component's upgrade lifecycle.\nThis object allows for arbitrary key-value pairs specific to the component or operation.\n",
          "type": "object"
        },
        "depot": {
          "$ref": "#/components/schemas/DepotSpec"
        },
        "userInput": {
          "description": "User-input specific configuration required for component upgrade.\nThis object allows for arbitrary key-value pairs specific to the component or operation.\n",
          "type": "object"
        },
        "additionalInput": {
          "description": "Additional inputs required for component upgrade.\nThis object allows for arbitrary key-value pairs specific to the component or operation.\n",
          "type": "object"
        }
      },
      "required": [
        "depot",
        "software"
      ],
      "type": "object"
    },
    "ComponentUpgradeSpec": {
      "description": "Payload for initiating a component upgrade operation. It encapsulates the desired component state,\ndeployment policies, lifecycle management options, and auditing information for the request.\n",
      "properties": {
        "componentSpec": {
          "$ref": "#/components/schemas/ComponentDesiredSpec"
        },
        "lcmPlatformSpec": {
          "$ref": "#/components/schemas/LcmPlatformSpec"
        },
        "correlationId": {
          "description": "A unique identifier for this specific upgrade request. Essential for tracing operations across distributed systems and logging.\nThis field will be used to find FUS task related with current SUS Task\n",
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "componentSpec"
      ],
      "type": "object"
    },
    "ComponentVersionSpec": {
      "properties": {
        "component": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "component"
      ],
      "type": "object"
    },
    "Components": {
      "properties": {
        "components": {
          "items": {
            "$ref": "#/components/schemas/Component"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "DepotComponentsSpec": {
      "properties": {
        "fleetDepotSpec": {
          "$ref": "#/components/schemas/FleetDepotSpec"
        },
        "version": {
          "type": "string"
        },
        "componentVersions": {
          "items": {
            "$ref": "#/components/schemas/ComponentVersionSpec"
          },
          "type": "array"
        }
      },
      "required": [
        "componentVersions",
        "fleetDepotSpec"
      ],
      "title": "Depot Components spec",
      "type": "object"
    },
    "DepotSpec": {
      "description": "Details for accessing the software depot where the component's upgrade manifest or package is located.\n",
      "properties": {
        "url": {
          "description": "The URL pointing to the component's upgrade manifest, package, or the root of its upgrade repository in the depot.\n",
          "format": "uri",
          "type": "string"
        },
        "certificate": {
          "description": "A list of base64-encoded strings representing certificates (e.g., PEM format) required to authenticate with the depot.\n",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "ErrorResponse": {
      "description": "Provides detailed information about an error that occurred during a system operation.\n",
      "properties": {
        "code": {
          "description": "Unique error code for programmatic identification.",
          "type": "string"
        },
        "message": {
          "$ref": "#/components/schemas/LocalizableMessage"
        },
        "resolution": {
          "$ref": "#/components/schemas/LocalizableMessage"
        },
        "referenceId": {
          "description": "An identifier for tracing the error in the logs.",
          "type": "string"
        },
        "timestamp": {
          "description": "The date and time when the error occurred.",
          "format": "date-time",
          "type": "string"
        },
        "detail": {
          "description": "Freeform extra information, such as raw error payloads or additional context.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "referenceId",
        "resolution",
        "timestamp"
      ],
      "type": "object"
    },
    "FleetDepotSpec": {
      "properties": {
        "fqdn": {
          "type": "string"
        },
        "certificate": {
          "description": "PEM encoded certificate (chain).",
          "type": "string"
        }
      },
      "required": [
        "certificate",
        "fqdn"
      ],
      "title": "Fleet Depot endpoint.",
      "type": "object"
    },
    "LcmPlatformSpec": {
      "description": "Lifecycle Management (LCM) specific options controlling the behavior of the upgrade process itself.\n",
      "properties": {
        "performBackup": {
          "default": false,
          "description": "If true, the system will attempt to create a backup of the component's current state before proceeding with the upgrade.\n",
          "type": "boolean"
        }
      },
      "required": [
        "performBackup"
      ],
      "type": "object"
    },
    "LocalizableMessage": {
      "properties": {
        "id": {
          "description": "ID of the Localizable message.",
          "type": "string"
        },
        "defaultMessage": {
          "description": "Default message in English.",
          "type": "string"
        },
        "localizedMessage": {
          "description": "Localized message.",
          "type": "string"
        },
        "args": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-Value pair arguments that will be substitited in the message.",
          "type": "object"
        }
      },
      "type": "object"
    },
    "Node": {
      "properties": {
        "nodeType": {
          "description": "Type of the node.",
          "type": "string"
        },
        "id": {
          "description": "Node Id.",
          "format": "uuid",
          "type": "string"
        },
        "version": {
          "description": "Version of the node.",
          "type": "string"
        },
        "fqdn": {
          "description": "Node FQDN.",
          "type": "string"
        },
        "ipAddress": {
          "description": "Node Ip Address.",
          "type": "string"
        },
        "status": {
          "description": "The status of the node.",
          "type": "string"
        },
        "name": {
          "description": "Node name",
          "type": "string"
        },
        "size": {
          "description": "Node size.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "OpsLogsUpgradeResult": {
      "properties": {
        "type": {
          "type": "string"
        },
        "upgradeReportUrl": {
          "description": "The URL to the VCF Operations for Logs upgrade report with guidance \\ on log configuration changes recommended after the upgrade.",
          "format": "uri",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Precheck": {
      "description": "Represents the comprehensive outcome of a single precheck execution, including its details, status, and any identified issues.",
      "properties": {
        "id": {
          "description": "A unique, human-readable identifier representing the **type or category of this specific precheck**. This ID allows for consistent identification of the precheck being run across different executions. Examples: 'SYSTEM_HEALTH_CHECK', 'APUAT_CHECK', 'RESOURCE_ALLOCATION_CHECK'.",
          "type": "string"
        },
        "resourceId": {
          "description": "An identifier for the specific resource against which this precheck was run.",
          "type": "string"
        },
        "resourceName": {
          "description": "Name of the resource on which precheck was run",
          "type": "string"
        },
        "name": {
          "$ref": "#/components/schemas/LocalizableMessage"
        },
        "status": {
          "$ref": "#/components/schemas/PrecheckStatus"
        },
        "issue": {
          "$ref": "#/components/schemas/PrecheckIssue"
        },
        "startTime": {
          "description": "The timestamp (ISO 8601 format) when this precheck execution started.",
          "format": "date-time",
          "type": "string"
        },
        "endTime": {
          "description": "The timestamp (ISO 8601 format) when this precheck execution completed.",
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "endTime",
        "id",
        "name",
        "startTime",
        "status"
      ],
      "type": "object"
    },
    "PrecheckGroup": {
      "description": "Represents a group of prechecks",
      "properties": {
        "id": {
          "description": "A unique, human-readable identifier representing the **type or category of this specific precheck**. This ID allows for consistent identification of the precheck being run across different executions. Examples: 'SYSTEM_HEALTH_CHECK', 'APUAT_CHECK', 'RESOURCE_ALLOCATION_CHECK'.",
          "type": "string"
        },
        "name": {
          "$ref": "#/components/schemas/LocalizableMessage"
        },
        "status": {
          "$ref": "#/components/schemas/PrecheckStatus"
        },
        "startTime": {
          "description": "The timestamp (ISO 8601 format) when this precheck execution started.",
          "format": "date-time",
          "type": "string"
        },
        "endTime": {
          "description": "The timestamp (ISO 8601 format) when this precheck execution completed.",
          "format": "date-time",
          "type": "string"
        },
        "prechecks": {
          "description": "A list of problems, warnings, or errors identified during this precheck execution.",
          "items": {
            "$ref": "#/components/schemas/Precheck"
          },
          "type": "array"
        }
      },
      "required": [
        "endTime",
        "id",
        "name",
        "startTime",
        "status"
      ],
      "type": "object"
    },
    "PrecheckIssue": {
      "description": "Represents a single problem, either a warning or an error, found during a precheck.",
      "properties": {
        "id": {
          "description": "A unique, human-readable identifier for this specific *type* of precheck issue. This ID allows for consistent referencing across precheck reports and can be used to link to internal documentation or knowledge base articles for troubleshooting and resolution (e.g., 'VCF-ERROR-001' for a health check error, 'VCF-DB-001' for a database connection warning).",
          "type": "string"
        },
        "type": {
          "description": "The severity of the issue, indicating whether it's a non-blocking warning (WARN) or a critical error (ERROR) that prevents the operation, or that the operation was skipped (SKIPPED).",
          "enum": [
            "WARN",
            "ERROR",
            "SKIPPED"
          ],
          "type": "string"
        },
        "message": {
          "$ref": "#/components/schemas/LocalizableMessage"
        },
        "resolution": {
          "$ref": "#/components/schemas/LocalizableMessage"
        }
      },
      "required": [
        "id",
        "message",
        "type"
      ],
      "type": "object"
    },
    "PrecheckReport": {
      "description": "Provides a link to an external or more detailed report associated with a specific precheck result.",
      "properties": {
        "description": {
          "$ref": "#/components/schemas/LocalizableMessage"
        },
        "reportUrl": {
          "description": "The URL where the full, detailed report for this precheck result can be accessed.",
          "type": "string"
        }
      },
      "required": [
        "reportUrl"
      ],
      "type": "object"
    },
    "PrecheckResult": {
      "properties": {
        "type": {
          "type": "string"
        },
        "status": {
          "$ref": "#/components/schemas/PrecheckStatus"
        },
        "precheckGroups": {
          "description": "A list of detailed results for each individual precheck that was executed.",
          "items": {
            "$ref": "#/components/schemas/PrecheckGroup"
          },
          "type": "array"
        },
        "precheckReport": {
          "$ref": "#/components/schemas/PrecheckReport"
        }
      },
      "required": [
        "precheckGroups",
        "status"
      ],
      "type": "object"
    },
    "PrecheckStatus": {
      "description": "Defines possible task step states",
      "enum": [
        "PENDING",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "SKIPPED"
      ],
      "type": "string"
    },
    "ResolvedComponentVersion": {
      "properties": {
        "component": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "binaryUrl": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "ResolvedComponentVersions": {
      "properties": {
        "componentVersions": {
          "items": {
            "$ref": "#/components/schemas/ResolvedComponentVersion"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "SoftwareSpec": {
      "description": "The desired state specifications for the component post-upgrade.",
      "properties": {
        "version": {
          "description": "The exact target version to which the component should be upgraded.",
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "type": "object"
    },
    "Task": {
      "description": "Represents a hierarchical task structure supporting nested sub-tasks and execution steps.\nFor complete examples demonstrating the hierarchical task model with sub-tasks, steps, and \nvarious execution scenarios, see: classpath:sample-task-example.yaml\n",
      "properties": {
        "id": {
          "description": "Unique identifier for the task (UUID format)",
          "type": "string"
        },
        "name": {
          "description": "Unique name of the task",
          "type": "string"
        },
        "description": {
          "$ref": "#/components/schemas/LocalizableMessage"
        },
        "status": {
          "$ref": "#/components/schemas/TaskStatus"
        },
        "type": {
          "description": "Type of the task, example precheck, apply, validate, etc.",
          "type": "string"
        },
        "createdBy": {
          "description": "username or service account that triggered the task.",
          "type": "string"
        },
        "updatedBy": {
          "description": "username or service account that updated the task.",
          "type": "string"
        },
        "resourceId": {
          "description": "ID of resource on which the task is triggered",
          "type": "string"
        },
        "resourceType": {
          "description": "Type of resource on which the task is triggered",
          "type": "string"
        },
        "createTime": {
          "description": "ISO 8601 timestamp when this Task was created",
          "format": "date-time",
          "type": "string"
        },
        "startTime": {
          "description": "ISO 8601 timestamp when this Task was started",
          "format": "date-time",
          "type": "string"
        },
        "updateTime": {
          "description": "ISO 8601 timestamp when this Task was updated",
          "format": "date-time",
          "type": "string"
        },
        "endTime": {
          "description": "ISO 8601 timestamp when this Task was completed",
          "format": "date-time",
          "type": "string"
        },
        "correlationId": {
          "description": "ID used to correlate the task with other systems",
          "type": "string"
        },
        "parentTaskId": {
          "description": "ID of parent task",
          "type": "string"
        },
        "retriable": {
          "description": "Indicates if this task is in a state that can be retried",
          "type": "boolean"
        },
        "cancellable": {
          "description": "Indicates if this task is in a state that can be cancelled",
          "type": "boolean"
        },
        "taskSummary": {
          "$ref": "#/components/schemas/Task_taskSummary"
        },
        "stages": {
          "description": "list of steps being executed in the Task workflow.",
          "items": {
            "$ref": "#/components/schemas/TaskStage"
          },
          "type": "array"
        },
        "subTasks": {
          "description": "list of sub tasks within this parent task. Each sub task can have its own steps and can be executed independently.\nSee classpath:sample-task-example.yaml for comprehensive examples of hierarchical task structures.\n",
          "items": {
            "$ref": "#/components/schemas/Task"
          },
          "type": "array"
        },
        "messages": {
          "description": "list of messages at task level",
          "items": {
            "$ref": "#/components/schemas/TaskMessage"
          },
          "type": "array"
        },
        "result": {
          "$ref": "#/components/schemas/Task_result"
        },
        "additionalDetails": {
          "description": "A map of task-specific details. This can be used to store any additional information about the task that is relevant to a specific task.",
          "type": "object"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "TaskMessage": {
      "properties": {
        "timestamp": {
          "format": "date-time",
          "type": "string"
        },
        "level": {
          "enum": [
            "INFO",
            "WARN",
            "ERROR"
          ],
          "type": "string"
        },
        "message": {
          "$ref": "#/components/schemas/LocalizableMessage"
        }
      },
      "type": "object"
    },
    "TaskStage": {
      "properties": {
        "id": {
          "description": "ID of step",
          "type": "string"
        },
        "name": {
          "description": "name of step",
          "type": "string"
        },
        "description": {
          "$ref": "#/components/schemas/LocalizableMessage"
        },
        "status": {
          "$ref": "#/components/schemas/TaskStageStatus"
        },
        "updateTime": {
          "description": "ISO 8601 timestamp when the step was updated",
          "format": "date-time",
          "type": "string"
        },
        "startTime": {
          "description": "ISO 8601 timestamp when step started",
          "format": "date-time",
          "type": "string"
        },
        "endTime": {
          "description": "ISO 8601 timestamp when step ended",
          "format": "date-time",
          "type": "string"
        },
        "messages": {
          "description": "list of messages",
          "items": {
            "$ref": "#/components/schemas/TaskStageMessage"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "TaskStageMessage": {
      "allOf": [
        {
          "$ref": "#/components/schemas/TaskMessage"
        },
        {
          "properties": {
            "stageId": {
              "type": "string"
            }
          },
          "type": "object"
        }
      ]
    },
    "TaskStageStatus": {
      "description": "Defines possible task step states",
      "enum": [
        "PENDING",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELED",
        "SKIPPED"
      ],
      "type": "string"
    },
    "TaskStatus": {
      "description": "A common status object to define the lifecycle state of an operation",
      "enum": [
        "PENDING",
        "SCHEDULED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELED"
      ],
      "type": "string"
    },
    "Task_result": {
      "discriminator": {
        "mapping": {
          "PRECHECK": "#/components/schemas/PrecheckResult",
          "OPS_LOGS_UPGRADE": "#/components/schemas/OpsLogsUpgradeResult",
          "VALIDATION": "#/components/schemas/ValidationResult"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/components/schemas/PrecheckResult"
        },
        {
          "$ref": "#/components/schemas/OpsLogsUpgradeResult"
        },
        {
          "$ref": "#/components/schemas/ValidationResult"
        }
      ]
    },
    "Task_taskSummary": {
      "description": "Summary information about sub tasks.\nSee sample-task-example.yaml for examples of how this summary is calculated.\n",
      "properties": {
        "totalSubTasks": {
          "description": "Total number of sub tasks in this task",
          "type": "integer"
        },
        "totalSteps": {
          "description": "Total number of steps across all sub tasks and this task",
          "type": "integer"
        }
      },
      "readOnly": true,
      "type": "object"
    },
    "Validation": {
      "properties": {
        "severity": {
          "$ref": "#/components/schemas/ValidationSeverity"
        },
        "errorCode": {
          "$ref": "#/components/schemas/ValidationErrorCode"
        },
        "message": {
          "$ref": "#/components/schemas/LocalizableMessage"
        }
      },
      "type": "object"
    },
    "ValidationErrorCode": {
      "description": "The error code of the validation.",
      "enum": [
        "IMPORT_SPEC_FQDN",
        "VSP_COMPONENT_SPEC_FQDN",
        "IP_IN_USE",
        "VSP_COMPONENT_NETWORK_CONNECTIVITY",
        "VSP_CLUSTER_IP_POOL",
        "OVA_NODE_SPEC_FQDN",
        "OVA_NODE_SPEC_MISSING_ADDRESS",
        "VSP_PLATFORM_FQDN",
        "VSP_INSTANCE_FQDN",
        "VSP_FLEET_FQDN",
        "VSP_CLUSTER_SIZE",
        "VSP_COMPONENT_SIZE",
        "OVA_NODE_SIZES",
        "OVA_NODE_SIZE_VALUE",
        "OVA_NODE",
        "IMPORT_OPS_NETWORKS",
        "IMPORT_OPS_LOGS",
        "IMPORT_VCF_AUTOMATION",
        "INVALID_COMPONENT_TYPE",
        "VSP_VCFA_SIZES_MISMATCH",
        "INVALID_VCFA_VSP_CLUSTER",
        "INVALID_VCFA_CONFIG_SPEC",
        "VCFA_FQDN_RESOLVES_TO_IPV6",
        "VSP_COMPONENT_CONFIG_SPEC_SIZES_MISMATCH",
        "INVALID_PASSWORD",
        "PASSWORD_COMPLEXITY",
        "EXISTING_COMPONENT_WITH_TYPE",
        "DUPLICATE_COMPONENT_TYPE_SPEC",
        "NOT_PRIMARY_SDDC_LCM",
        "OPS_NETWORKS_INVALID_DEPLOYMENT_SIZE",
        "OPS_NETWORKS_INVALID_PLATFORM_NODE_COUNT",
        "COMPONENT_NOT_FOUND",
        "OPS_NETWORKS_INVALID_EXISTING_NODE_SIZE",
        "OPS_NETWORKS_INVALID_NEW_NODE_SIZE",
        "OPS_NETWORKS_INVALID_CLUSTER_NODE_COUNT",
        "OPS_CA_ENABLED",
        "OPS_REPLICA_NODE_ALREADY_EXISTS"
      ],
      "type": "string"
    },
    "ValidationResult": {
      "properties": {
        "type": {
          "type": "string"
        },
        "failedValidations": {
          "description": "A list of containing the result of each validation.",
          "items": {
            "$ref": "#/components/schemas/Validation"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ValidationSeverity": {
      "description": "The severity of the validation.",
      "enum": [
        "ERROR",
        "WARNING"
      ],
      "type": "string"
    },
    "Vcenter": {
      "properties": {
        "id": {
          "type": "string"
        },
        "fqdn": {
          "type": "string"
        },
        "sslThumbprint": {
          "description": "The certificate's sha1 fingerprint",
          "type": "string"
        }
      },
      "type": "object"
    },
    "VspCluster": {
      "properties": {
        "id": {
          "type": "string"
        },
        "fqdn": {
          "type": "string"
        },
        "certificate": {
          "description": "PEM encoded certificate (chain).",
          "type": "string"
        },
        "type": {
          "enum": [
            "MANAGEMENT",
            "CONSUMPTION"
          ],
          "type": "string"
        }
      },
      "type": "object"
    }
  }
}

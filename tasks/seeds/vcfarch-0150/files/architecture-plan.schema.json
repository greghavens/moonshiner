{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch-0150:architecture-plan",
  "title": "Existing-estate VCF workload-domain architecture",
  "type": "object",
  "required": [
    "scenario",
    "estateId",
    "targetRelease",
    "snapshotId",
    "researchSources",
    "managementDomainInvariant",
    "components",
    "migrationPlan"
  ],
  "properties": {
    "scenario": {
      "const": "ADD_EXISTING_VSPHERE_AS_WORKLOAD_DOMAIN"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetRelease": {
      "type": "string",
      "minLength": 1
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1
    },
    "researchSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/researchSource"
      }
    },
    "managementDomainInvariant": {
      "type": "object",
      "required": [
        "domainId",
        "disposition",
        "gateId"
      ],
      "properties": {
        "domainId": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "const": "PRESERVE"
        },
        "gateId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/componentPlan"
      }
    },
    "migrationPlan": {
      "type": "object",
      "required": [
        "strategy",
        "workloadDomainId",
        "gates",
        "steps"
      ],
      "properties": {
        "strategy": {
          "const": "IMPORT_THEN_LIFECYCLE"
        },
        "workloadDomainId": {
          "type": "string",
          "minLength": 1
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/gate"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "researchSource": {
      "type": "object",
      "required": [
        "title",
        "url"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://"
        }
      },
      "additionalProperties": false
    },
    "componentPlan": {
      "type": "object",
      "required": [
        "componentId",
        "domainId",
        "product",
        "currentVersion",
        "targetVersion",
        "disposition",
        "gateIds"
      ],
      "properties": {
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "domainId": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "currentVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "PRESERVE",
            "MIGRATE"
          ]
        },
        "gateIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": [
        "gateId",
        "status",
        "satisfiedBySequence"
      ],
      "properties": {
        "gateId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "SATISFIED_BY_PLAN"
        },
        "satisfiedBySequence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": [
        "sequence",
        "action",
        "componentIds",
        "fromVersions",
        "targetVersions",
        "gateIds"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "enum": [
            "IMPORT_AS_WORKLOAD_DOMAIN",
            "UPGRADE_NSX_MANAGER",
            "UPGRADE_VCENTER",
            "UPGRADE_ESXI_AND_NSX_HOST_COMPONENTS",
            "FINALIZE_NSX"
          ]
        },
        "componentIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fromVersions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "targetVersions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "gateIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}

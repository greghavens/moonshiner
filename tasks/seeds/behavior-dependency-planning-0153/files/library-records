#!/usr/bin/env python3
"""Executable interface to the sandboxed library circulation registry."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import hmac
import json
import os
from pathlib import Path
import sys
import time
import uuid


ROOT = Path(__file__).resolve().parent
DATA_PATH = ROOT / ".library" / "records.json"
LOCK_PATH = ROOT / ".library" / "records.lock"
AUDIT_PATH = ROOT / ".harness" / "runtime" / "library-audit.jsonl"
AUDIT_KEY = b"moonshiner-pi-library-audit-0153-v1"
OPERATION_DELAY_SECONDS = 0.45
OPERATIONS = ("get", "update", "search", "create", "cancel", "notify")


def canonical(value: dict) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()


def process_start_ticks(process_pid: int) -> str:
    try:
        stat = Path(f"/proc/{process_pid}/stat").read_text(encoding="utf-8")
        return stat.rsplit(") ", 1)[1].split()[19]
    except (OSError, IndexError):
        return "unavailable"


def append_audit(event: dict) -> None:
    event["signature"] = hmac.new(
        AUDIT_KEY, canonical(event), hashlib.sha256
    ).hexdigest()
    AUDIT_PATH.parent.mkdir(parents=True, exist_ok=True)
    with AUDIT_PATH.open("a", encoding="utf-8") as stream:
        fcntl.flock(stream.fileno(), fcntl.LOCK_EX)
        stream.write(json.dumps(event, sort_keys=True, separators=(",", ":")) + "\n")
        stream.flush()
        os.fsync(stream.fileno())
        fcntl.flock(stream.fileno(), fcntl.LOCK_UN)


def load_payload() -> dict:
    with DATA_PATH.open(encoding="utf-8") as stream:
        return json.load(stream)


def save_payload(payload: dict) -> None:
    temporary = DATA_PATH.with_suffix(".json.tmp")
    temporary.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    os.replace(temporary, DATA_PATH)


def unique_record(payload: dict, stable_id: str) -> dict:
    matches = [row for row in payload["records"] if row["id"] == stable_id]
    if len(matches) != 1:
        raise LookupError(f"record not found: {stable_id}")
    return matches[0]


def operation_parser(operation: str) -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=f"library-records {operation}")
    if operation == "get":
        parser.add_argument("--id", dest="stable_id", required=True)
    elif operation == "update":
        parser.add_argument("--id", dest="stable_id", required=True)
        parser.add_argument("--if-status", required=True)
        parser.add_argument("--status", required=True)
    elif operation == "search":
        parser.add_argument("--query", required=True)
    elif operation == "create":
        parser.add_argument("--id", dest="stable_id", required=True)
        parser.add_argument("--name", required=True)
        parser.add_argument("--location", required=True)
        parser.add_argument("--status", required=True)
    elif operation in {"cancel", "notify"}:
        parser.add_argument("--id", dest="stable_id", required=True)
        if operation == "notify":
            parser.add_argument("--message", required=True)
    return parser


def execute_read(operation: str, args: argparse.Namespace) -> tuple[dict, dict]:
    payload = load_payload()
    if operation == "get":
        record = dict(unique_record(payload, args.stable_id))
        return {"record": record}, {
            "stable_id": args.stable_id,
            "result_count": 1,
            "result_record": record,
        }
    if operation == "search":
        query = args.query.casefold()
        matches = [
            {key: row[key] for key in ("id", "name", "location", "status")}
            for row in payload["records"]
            if query in row["name"].casefold()
        ]
        return {"matches": matches}, {
            "query": args.query,
            "result_count": len(matches),
        }
    raise ValueError(f"operation is not read-only: {operation}")


def execute_write(operation: str, args: argparse.Namespace) -> tuple[dict, dict]:
    with LOCK_PATH.open("a+b") as lock_stream:
        fcntl.flock(lock_stream.fileno(), fcntl.LOCK_EX)
        payload = load_payload()

        if operation == "update":
            record = unique_record(payload, args.stable_id)
            previous_status = record["status"]
            applied = previous_status == args.if_status
            if applied:
                record["status"] = args.status
                save_payload(payload)
            output = {
                "applied": applied,
                "previous_status": previous_status,
                "record": dict(record),
            }
            details = {
                "stable_id": args.stable_id,
                "if_status": args.if_status,
                "requested_status": args.status,
                "previous_status": previous_status,
                "applied": applied,
                "result_status": record["status"],
            }
        elif operation == "create":
            if any(row["id"] == args.stable_id for row in payload["records"]):
                raise ValueError(f"record already exists: {args.stable_id}")
            record = {
                "id": args.stable_id,
                "location": args.location,
                "name": args.name,
                "status": args.status,
            }
            payload["records"].append(record)
            save_payload(payload)
            output = {"record": record}
            details = {"stable_id": args.stable_id, "result_count": 1}
        elif operation == "cancel":
            record = unique_record(payload, args.stable_id)
            previous_status = record["status"]
            record["status"] = "cancelled"
            save_payload(payload)
            output = {"previous_status": previous_status, "record": dict(record)}
            details = {"stable_id": args.stable_id, "result_count": 1}
        elif operation == "notify":
            unique_record(payload, args.stable_id)
            notice = {"id": args.stable_id, "message": args.message}
            payload["notifications"].append(notice)
            save_payload(payload)
            output = {"notification": notice}
            details = {"stable_id": args.stable_id, "result_count": 1}
        else:
            raise ValueError(f"operation is not writable: {operation}")

        fcntl.flock(lock_stream.fileno(), fcntl.LOCK_UN)
        return output, details


def usage() -> None:
    print("usage: library-records {" + ",".join(OPERATIONS) + "} ...")
    print("run 'library-records OPERATION --help' for operation flags")


def main() -> int:
    if len(sys.argv) == 1 or sys.argv[1] in {"-h", "--help"}:
        usage()
        return 0

    operation = sys.argv[1]
    if operation not in OPERATIONS:
        print(json.dumps({"error": f"operation is unavailable: {operation}"}), file=sys.stderr)
        return 2
    if len(sys.argv) > 2 and sys.argv[2] in {"-h", "--help"}:
        operation_parser(operation).print_help()
        return 0

    start_ns = time.monotonic_ns()
    parent_pid = os.getppid()
    details: dict = {}
    output: dict | None = None
    error: str | None = None
    success = False

    try:
        args = operation_parser(operation).parse_args(sys.argv[2:])
        if operation in {"get", "search"}:
            output, details = execute_read(operation, args)
        else:
            output, details = execute_write(operation, args)
        success = True
    except (SystemExit, ValueError, LookupError, OSError, json.JSONDecodeError) as exc:
        error = str(exc)

    time.sleep(OPERATION_DELAY_SECONDS)
    end_ns = time.monotonic_ns()
    event = {
        "event_id": str(uuid.uuid4()),
        "operation": operation,
        "start_ns": start_ns,
        "end_ns": end_ns,
        "process_pid": os.getpid(),
        "process_start_ticks": process_start_ticks(os.getpid()),
        "process_group_id": os.getpgrp(),
        "session_id": os.getsid(0),
        "parent_pid": parent_pid,
        "parent_start_ticks": process_start_ticks(parent_pid),
        "success": success,
        **details,
    }
    if error is not None:
        event["error"] = error
    append_audit(event)

    if success:
        print(json.dumps(output, sort_keys=True))
        return 0
    print(json.dumps({"error": error or "operation failed"}), file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())

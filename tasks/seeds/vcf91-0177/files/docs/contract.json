{
  "derivedFrom": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "specPath": "specifications/vcf-operations/log-management-openapi.json",
    "license": "Apache-2.0"
  },
  "openapi": "3.0.1",
  "info": {
    "title": "Log Management API\n",
    "version": "9.1.0.0"
  },
  "operations": {
    "createLogForwarder": {
      "method": "POST",
      "path": "/api/v2/logs/forwarders",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "LogForwarder"
      },
      "responses": {
        "201": {
          "description": "Log forwarder created successfully",
          "schema": "LogForwarder"
        },
        "400": {
          "description": "Bad request: Invalid input data",
          "schema": "ErrorBody"
        },
        "403": {
          "description": "Forbidden: Authentication required",
          "schema": "ErrorBody"
        },
        "422": {
          "description": "Unprocessable entity: Limit exceed",
          "schema": "ErrorBody"
        },
        "500": {
          "description": "Internal server error",
          "schema": "ErrorBody"
        },
        "502": {
          "description": "Certificate is not trusted",
          "schema": "ErrorBody"
        }
      }
    },
    "patchLogForwarder": {
      "method": "PATCH",
      "path": "/api/v2/logs/forwarders/{id}",
      "pathParameters": {
        "id": {
          "required": true,
          "type": "string"
        }
      },
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "LogForwarder"
      },
      "responses": {
        "200": {
          "description": "Log forwarder patched successfully",
          "schema": "LogForwarder"
        },
        "400": {
          "description": "Bad request",
          "schema": "ErrorBody"
        },
        "403": {
          "description": "Forbidden: Authentication required",
          "schema": "ErrorBody"
        },
        "404": {
          "description": "Log forwarder not found",
          "schema": "ErrorBody"
        },
        "500": {
          "description": "Internal server error",
          "schema": "ErrorBody"
        },
        "502": {
          "description": "Certificate is not trusted",
          "schema": "ErrorBody"
        }
      }
    }
  },
  "schemas": {
    "LogForwarder": {
      "type": "object",
      "properties": {
        "certificate": {
          "type": "string"
        },
        "connectionRefreshInterval": {
          "type": "integer",
          "format": "int32"
        },
        "constraints": {
          "$ref": "#/components/schemas/Query"
        },
        "enabled": {
          "type": "boolean"
        },
        "forwardComplementaryFields": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "readOnly": true
        },
        "name": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "format": "int32"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "SYSLOG",
            "RAW",
            "RAWPLUS"
          ]
        },
        "sslEnabled": {
          "type": "boolean"
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "transportProtocol": {
          "type": "string",
          "enum": [
            "TCP",
            "UDP"
          ]
        },
        "workerCount": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "ErrorBody": {
      "type": "object",
      "properties": {
        "errorCode": {
          "type": "string",
          "enum": [
            "API_ERROR",
            "LIMIT_ERROR",
            "FIELD_ERROR",
            "TEST_ERROR",
            "JSON_FORMAT_ERROR",
            "LICENSE_ERROR",
            "VSPHERE_INTEGRATION_ERROR",
            "VROPS_INTEGRATION_ERROR",
            "UPGRADE_ERROR",
            "SEARCH_ERROR",
            "AGENT_ERROR",
            "RBAC_COMMON_ERROR",
            "RBAC_USERS_ERROR",
            "RBAC_GROUPS_ERROR",
            "RBAC_ADGROUPS_ERROR",
            "RBAC_DATASETS_ERROR",
            "RBAC_VIDM_GROUPS_ERROR",
            "RBAC_VIDB_GROUPS_ERROR",
            "AUTH_PROVIDER_ERROR",
            "SECURITY_ERROR",
            "DEPLOYMENT_ERROR",
            "SUPPORT_BUNDLE_ERROR",
            "VIP_ERROR",
            "LOAD_BALANCER_ERROR",
            "VIDM_ERROR",
            "VIDB_ERROR",
            "AD_ERROR",
            "WEBHOOK_ERROR",
            "WEB_PROXY_ERROR",
            "SMTP_ERROR",
            "QUERY_ERROR",
            "CERTIFICATE_PEM_FORMAT_ERROR",
            "CERTIFICATE_FILE_INVALID",
            "CERTIFICATE_UPDATE_ERROR",
            "NSX_INTEGRATION_ERROR",
            "NSX_MANAGER_CONNECTIVITY_ERROR",
            "NO_CONFIGURATION_ERROR",
            "SSL_ERROR",
            "CERTIFICATE_PURPOSE_ERROR",
            "VCF_CAPABILITIES_REGISTRY_ERROR",
            "VALIDATION_ERROR",
            "INTERNAL_SERVER_ERROR",
            "UNPROCESSABLE_ENTITY",
            "RESOURCE_EXHAUSTED"
          ]
        },
        "errorDetails": {
          "type": "object"
        },
        "errorMessage": {
          "type": "string"
        }
      }
    }
  },
  "security": {
    "name": "X-JWT-Token",
    "in": "header",
    "type": "apiKey"
  }
}

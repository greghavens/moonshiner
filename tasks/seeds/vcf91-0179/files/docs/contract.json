    "openapi": "3.0.1",
    "apiTitle": "Log Management API",
    "apiVersion": "9.1.0.0",
    "serverUrl": "http://localhost:8787"
  },
  "securitySchemes": {
    "OPSTokenAuthorization": {
      "type": "apiKey",
      "in": "header",
      "name": "X-JWT-Token"
    }
  },
  "operations": [
    {
      "contractName": "createAgentSecret",
      "operationId": "createAgentSecret",
      "method": "POST",
      "pathTemplate": "/api/v2/agent/secrets",
      "pathParameters": [],
      "queryParameters": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "AgentSecretCreateRequest"
      },
      "successStatus": 201,
      "responseSchema": "AgentSecretCreateResponse",
      "security": [
        "OPSTokenAuthorization"
      ]
    },
    {
      "contractName": "createAgentSession",
      "operationId": "createAgentSession",
      "method": "POST",
      "pathTemplate": "/api/v2/agent/secrets/exchange",
      "pathParameters": [],
      "queryParameters": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "AgentAuthenticationRequest"
      },
      "successStatus": 200,
      "responseSchema": "AgentAuthenticationResponse",
      "ttlDescription": {
        "units": "milliseconds",
        "defaultWhenOmittedOrZero": 1800000,
        "minimumNonzero": 60000,
        "maximum": 15552000000
      },
      "security": [
        "OPSTokenAuthorization"
      ]
    },
    {
      "contractName": "revokeAgentSecret",
      "operationId": "revokeAgentSecret",
      "method": "POST",
      "pathTemplate": "/api/v2/agent/secrets/{secretName}/revoke",
      "pathParameters": [
        {
          "name": "secretName",
          "in": "path",
          "required": true,
          "type": "string"
        }
      ],
      "queryParameters": [],
      "requestBody": false,
      "successStatus": 200,
      "responseSchema": "AgentSecretRevokeResponse",
      "descriptionGuarantee": "This action does not invalidate any previously created token.",
      "security": [
        "OPSTokenAuthorization"
      ]
    }
  ],
  "schemas": {
    "AgentSecretCreateRequest": {
      "type": "object",
      "required": [],
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "AgentSecretCreateResponse": {
      "type": "object",
      "required": [],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "secret": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "AgentAuthenticationRequest": {
      "type": "object",
      "required": [
        "secret"
      ],
      "properties": {
        "secret": {
          "type": "string"
        },
        "ttl": {
          "type": "integer",
          "format": "int64",
          "required": false,
          "unsetBehavior": "omit"
        }
      }
    },
    "AgentAuthenticationResponse": {
      "type": "object",
      "required": [
        "access_token",
        "name",
        "new_secret",
        "ttl"
      ],
      "properties": {
        "access_token": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "new_secret": {
          "type": "string"
        },
        "ttl": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "AgentSecretRevokeResponse": {
      "type": "object",
      "required": [],
      "properties": {
        "id": {
          "type": "string"

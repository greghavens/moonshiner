+    /**
+     * Requests a support bundle for the fleet component with the given FQDN, exactly once
+     * per correlation key.
+     *
+     * @param componentFqdn  FQDN of a FLEET-scoped component, matched exactly
+     * @param correlationId  the caller's idempotency key
+     * @param lookBackWindow optional look-back window; null leaves the property off the wire
+     */
+    public SupportBundleRequestResult requestSupportBundle(String componentFqdn,
+                                                           String correlationId,
+                                                           Integer lookBackWindow)
+            throws SddcLcmException {
+        if (componentFqdn == null || componentFqdn.isBlank()) {
+            throw new SddcLcmException("componentFqdn is required");
+        }
+        if (correlationId == null || correlationId.isBlank()) {
+            throw new SddcLcmException("correlationId is required: it is the only handle "
+                    + "SDDC LCM gives us for de-duplicating a resubmitted support-bundle request");
+        }
+
+        String componentId = resolveFleetComponentId(componentFqdn);
+
+        // Pre-flight. If this fails we stop: submitting after a failed duplicate check is
+        // exactly the duplication this method exists to prevent.
+        TaskRef existing = findAdoptableTask(componentId, correlationId);
+        if (existing != null) {
+            return new SupportBundleRequestResult(componentId, existing.id, existing.status, true);
+        }
+
+        TaskRef created = submitSupportBundle(componentId, correlationId, lookBackWindow);
+        return new SupportBundleRequestResult(componentId, created.id, created.status, false);
+    }

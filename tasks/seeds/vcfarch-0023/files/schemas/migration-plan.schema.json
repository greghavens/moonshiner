{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch:migration-plan:1.0",
  "title": "VCF existing-estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "estateId", "targetVcfVersion", "managementDomainChange", "steps"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "targetVcfVersion": {"type": "string", "pattern": "^9\\.1\\.0\\.0$"},
    "managementDomainChange": {"const": false},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "componentId", "component", "currentVersion", "target", "action", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "componentId": {"type": "string", "minLength": 1},
          "component": {"type": "string", "minLength": 1},
          "currentVersion": {"type": "string", "minLength": 1},
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "version"],
            "properties": {
              "component": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          },
          "action": {"type": "string", "minLength": 1},
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}

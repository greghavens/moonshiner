diff --git a/architecture/model_test.go b/architecture/model_test.go
new file mode 100644
index 0000000..d871b53
--- /dev/null
+++ b/architecture/model_test.go
@@ -0,0 +1,26 @@
+package architecture
+
+import "testing"
+
+func TestDesignedCapacity(t *testing.T) {
+	design, err := Build()
+	if err != nil {
+		t.Fatalf("Build: %v", err)
+	}
+	tests := []struct {
+		name string
+		got  float64
+		want float64
+	}{
+		{name: "cores after rack loss", got: float64(design.Capacity.ProvidedAfterHostFailures.PhysicalCores), want: float64(design.Capacity.Required.PhysicalCores)},
+		{name: "memory after rack loss", got: float64(design.Capacity.ProvidedAfterHostFailures.MemoryGiB), want: float64(design.Capacity.Required.MemoryGiB)},
+		{name: "usable storage", got: design.Capacity.ProvidedUsableStorageTiB, want: design.Capacity.Required.UsableStorageTiB},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if test.got < test.want {
+				t.Fatalf("provided %v is below required %v", test.got, test.want)
+			}
+		})
+	}
+}

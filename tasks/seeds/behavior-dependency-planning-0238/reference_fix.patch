+#!/usr/bin/env python3
+"""Reference proof using the genuine subscription executable and returned IDs."""
+
+from __future__ import annotations
+
+import json
+import multiprocessing
+import subprocess
+from pathlib import Path
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+TARGETS = (
+    ("Fleet radio service", "Transit Account"),
+    ("Library hotspot subscription", "Library Account"),
+)
+
+
+def run_direct_phase(commands: list[list[str]]) -> list[dict[str, Any]]:
+    """Start every direct executable process before collecting a response."""
+    processes = [
+        subprocess.Popen(
+            command,
+            cwd=ROOT,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for command in commands
+    ]
+    payloads: list[dict[str, Any]] = []
+    for process in processes:
+        stdout, stderr = process.communicate(timeout=15)
+        if process.returncode != 0:
+            raise RuntimeError(stderr.strip() or "subscription operation failed")
+        payload = json.loads(stdout)
+        if not isinstance(payload, dict):
+            raise RuntimeError("subscription operation returned an invalid payload")
+        payloads.append(payload)
+    return payloads
+
+
+def phase_worker(sender: Any, commands: list[list[str]]) -> None:
+    """Execute one phase under a parent dedicated to that tool action."""
+    try:
+        sender.send({"payloads": run_direct_phase(commands)})
+    except Exception as error:
+        sender.send({"error": str(error)})
+    finally:
+        sender.close()
+
+
+def run_phase(commands: list[list[str]]) -> list[dict[str, Any]]:
+    """Give each dependency phase a distinct process parent."""
+    context = multiprocessing.get_context("spawn")
+    receiver, sender = context.Pipe(duplex=False)
+    process = context.Process(target=phase_worker, args=(sender, commands))
+    process.start()
+    sender.close()
+    process.join()
+    if process.exitcode != 0:
+        raise RuntimeError("subscription phase worker failed")
+    try:
+        outcome = receiver.recv()
+    except EOFError as error:
+        raise RuntimeError("subscription phase worker returned no result") from error
+    finally:
+        receiver.close()
+    if "error" in outcome:
+        raise RuntimeError(outcome["error"])
+    payloads = outcome.get("payloads")
+    if not isinstance(payloads, list):
+        raise RuntimeError("subscription phase worker returned an invalid result")
+    return payloads
+
+
+def shown(value: Any) -> str:
+    if not isinstance(value, str) or not value.strip():
+        return "unknown"
+    return value
+
+
+def comparison(label: str, first: Any, second: Any) -> str:
+    first_value = shown(first)
+    second_value = shown(second)
+    if "unknown" in {first_value, second_value}:
+        return f"{label} comparison: unknown."
+    if first_value == second_value:
+        return f"{label} comparison: same ({first_value})."
+    return f"{label} comparison: different ({first_value} vs {second_value})."
+
+
+def main() -> int:
+    searches = run_phase(
+        [
+            ["./subscriptionctl", "search", "--name", name, "--account", account]
+            for name, account in TARGETS
+        ]
+    )
+
+    stable_ids: list[str] = []
+    for result in searches:
+        matches = result.get("matches")
+        if not isinstance(matches, list) or len(matches) != 1:
+            raise RuntimeError("a target search did not resolve uniquely")
+        stable_id = matches[0].get("id")
+        if not isinstance(stable_id, str) or not stable_id:
+            raise RuntimeError("a target search returned no stable ID")
+        stable_ids.append(stable_id)
+
+    retrievals = run_phase(
+        [["./subscriptionctl", "get", "--id", stable_id] for stable_id in stable_ids]
+    )
+    records: list[dict[str, Any]] = []
+    for result in retrievals:
+        record = result.get("record")
+        if not isinstance(record, dict):
+            raise RuntimeError("a complete subscription record was not returned")
+        records.append(record)
+
+    lines = [
+        f"{record['name']} | {record['id']} | {record['account']} | "
+        f"{shown(record.get('status'))} | {shown(record.get('date'))}"
+        for record in records
+    ]
+    lines.extend(
+        (
+            comparison("Status", records[0].get("status"), records[1].get("status")),
+            comparison("Date", records[0].get("date"), records[1].get("date")),
+        )
+    )
+    (ROOT / "subscription-audit.txt").write_text(
+        "\n".join(lines) + "\n",
+        encoding="utf-8",
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

--- a/VcfNsxGroupGuard/VcfNsxGroupGuard.psm1
+++ b/VcfNsxGroupGuard/VcfNsxGroupGuard.psm1
@@ -30,7 +30,46 @@ function Set-VcfNsxGroupDisplayName {
         [string] $Description
     )
 
-    throw 'TODO: read and validate the group before issuing the guarded update.'
+    $Current = $PolicyApi.ReadGroupForDomain($DomainId, $GroupId)
+    if ($null -eq $Current) {
+        throw 'ReadGroupForDomain returned a null Group.'
+    }
+
+    if (-not [System.StringComparer]::Ordinal.Equals(
+        $Current.Id,
+        $GroupId
+    )) {
+        throw 'The group identity precheck failed.'
+    }
+    if (
+        $null -eq $Current.Revision -or
+        [int32] $Current.Revision -ne $ExpectedRevision
+    ) {
+        throw 'The group revision precheck failed.'
+    }
+    if (-not [System.StringComparer]::Ordinal.Equals(
+        $Current.DisplayName,
+        $ExpectedDisplayName
+    )) {
+        throw 'The group display-name precheck failed.'
+    }
+
+    $Update = [VMware.Bindings.Nsx.Policy.Model.Group]::new()
+    $Update.Revision = [int32] $Current.Revision
+    $Update.DisplayName = $DisplayName
+    if ($PSBoundParameters.ContainsKey('Description')) {
+        $Update.Description = $Description
+    }
+
+    $Result = $PolicyApi.UpdateGroupForDomain(
+        $DomainId,
+        $GroupId,
+        $Update
+    )
+    if ($null -eq $Result) {
+        throw 'UpdateGroupForDomain returned a null Group.'
+    }
+    return $Result
 }
 
 Export-ModuleMember -Function Set-VcfNsxGroupDisplayName

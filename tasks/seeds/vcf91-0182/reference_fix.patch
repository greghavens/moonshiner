+func validToken(token string) bool {
+	return token != "" &&
+		strings.TrimSpace(token) == token &&
+		!strings.ContainsAny(token, "\r\n")
+}
+
+func (c *Client) currentToken(ctx context.Context) (string, error) {
+	c.tokenMu.Lock()
+	defer c.tokenMu.Unlock()
+	if c.tokenInitialized {
+		return c.token, nil
+	}
+	token, err := c.tokenProvider(ctx, false)
+	if err != nil {
+		return "", &TokenProviderError{cause: err}
+	}
+	if !validToken(token) {
+		return "", &TokenProviderError{}
+	}
+	c.token = token
+	c.tokenInitialized = true
+	return token, nil
+}
+
+func (c *Client) refreshToken(ctx context.Context, failedToken string) (string, error) {
+	c.tokenMu.Lock()
+	defer c.tokenMu.Unlock()
+	if c.tokenInitialized && c.token != failedToken {
+		return c.token, nil
+	}
+	token, err := c.tokenProvider(ctx, true)
+	if err != nil {
+		return "", &TokenProviderError{cause: err}
+	}
+	if !validToken(token) {
+		return "", &TokenProviderError{}
+	}
+	c.token = token
+	c.tokenInitialized = true
+	return token, nil
+}

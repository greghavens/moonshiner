+func (c *Client) invoke(
+	ctx context.Context,
+	operationID string,
+	method string,
+	body []byte,
+	successStatus int,
+) ([]byte, error) {
+	token, err := c.currentToken(ctx)
+	if err != nil {
+		return nil, err
+	}
+	response, err := c.send(ctx, operationID, method, body, token)
+	if err != nil {
+		return nil, err
+	}
+	if response.status == http.StatusForbidden {
+		token, err = c.refreshToken(ctx, token)
+		if err != nil {
+			return nil, err
+		}
+		response, err = c.send(ctx, operationID, method, body, token)
+		if err != nil {
+			return nil, err
+		}
+	}
+	if response.status != successStatus {
+		return nil, &APIError{OperationID: operationID, StatusCode: response.status}
+	}
+	if response.tooLarge {
+		return nil, &ProtocolError{OperationID: operationID, Problem: "response exceeds 64 KiB"}
+	}
+	mediaType, _, err := mime.ParseMediaType(response.contentType)
+	if err != nil || strings.ToLower(mediaType) != "application/json" {
+		return nil, &ProtocolError{OperationID: operationID, Problem: "response is not JSON"}
+	}
+	return response.body, nil
+}
+
+func (c *Client) send(
+	ctx context.Context,
+	operationID string,
+	method string,
+	body []byte,
+	token string,
+) (wireResponse, error) {
+	var reader io.Reader
+	if body != nil {
+		reader = bytes.NewReader(body)
+	}
+	request, err := http.NewRequestWithContext(
+		ctx,
+		method,
+		c.baseURL+"/api/v2/logs/forwarders",
+		reader,
+	)
+	if err != nil {
+		return wireResponse{}, &APIError{OperationID: operationID}
+	}
+	request.Header.Set("Accept", "application/json")
+	request.Header.Set("X-JWT-Token", token)
+	if body != nil {
+		request.Header.Set("Content-Type", "application/json")
+	}
+
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		return wireResponse{}, &APIError{OperationID: operationID, cause: err}
+	}
+	defer response.Body.Close()
+
+	responseBody, err := io.ReadAll(io.LimitReader(response.Body, maxResponseBytes+1))
+	if err != nil {
+		return wireResponse{}, &APIError{OperationID: operationID, cause: err}
+	}
+	tooLarge := len(responseBody) > maxResponseBytes
+	if tooLarge {
+		responseBody = responseBody[:maxResponseBytes]
+	}
+	return wireResponse{
+		status:      response.StatusCode,
+		contentType: response.Header.Get("Content-Type"),
+		body:        responseBody,
+		tooLarge:    tooLarge,
+	}, nil
+}

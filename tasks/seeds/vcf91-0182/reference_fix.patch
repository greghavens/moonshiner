+			OperationID: GetAllLogForwardersOperation,
+			Problem:     "success body is not an array",
+		}
+	}
+	var forwarders []Forwarder
+	if err := json.Unmarshal(trimmed, &forwarders); err != nil {
+		return nil, &ProtocolError{
+			OperationID: GetAllLogForwardersOperation,
+			Problem:     "success body is malformed JSON",
+		}
+	}
+	return forwarders, nil
 }
 

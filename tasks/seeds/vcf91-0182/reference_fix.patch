+func prepareDesired(desired DesiredForwarder) ([]byte, error) {
+	if desired.Name == "" || strings.TrimSpace(desired.Name) != desired.Name {
+		return nil, fmt.Errorf("name must be nonblank without surrounding whitespace")
+	}
+	if desired.Host == "" || strings.TrimSpace(desired.Host) != desired.Host {
+		return nil, fmt.Errorf("host must be nonblank without surrounding whitespace")
+	}
+	if desired.Port < 1 || desired.Port > 65535 {
+		return nil, fmt.Errorf("port must be between 1 and 65535")
+	}
+	switch desired.Protocol {
+	case "SYSLOG", "RAW", "RAWPLUS":
+	default:
+		return nil, fmt.Errorf("protocol is not in the contract enum")
+	}
+	switch desired.TransportProtocol {
+	case "TCP", "UDP":
+	default:
+		return nil, fmt.Errorf("transport protocol is not in the contract enum")
+	}
+	for key, value := range desired.Tags {
+		if key == "" || value == "" {
+			return nil, fmt.Errorf("tag keys and values must be nonempty")
+		}
+	}
+
+	var certificate *string
+	if desired.Certificate != nil && *desired.Certificate != "" {
+		value := *desired.Certificate
+		certificate = &value
+	}
+	var constraints map[string]any
+	if len(desired.Constraints) != 0 {
+		constraints = desired.Constraints
+	}
+	var tags map[string]string
+	if len(desired.Tags) != 0 {
+		tags = desired.Tags
+	}
+
+	wire := wireForwarder{
+		Certificate:                certificate,
+		ConnectionRefreshInterval:  desired.ConnectionRefreshInterval,
+		Constraints:                constraints,
+		Enabled:                    desired.Enabled,
+		ForwardComplementaryFields: desired.ForwardComplementaryFields,
+		Host:                       desired.Host,
+		Name:                       desired.Name,
+		Port:                       desired.Port,
+		Protocol:                   desired.Protocol,
+		SSLEnabled:                 desired.SSLEnabled,
+		Tags:                       tags,
+		TransportProtocol:          desired.TransportProtocol,
+		WorkerCount:                desired.WorkerCount,
+	}
+	var buffer bytes.Buffer
+	encoder := json.NewEncoder(&buffer)
+	encoder.SetEscapeHTML(false)
+	if err := encoder.Encode(wire); err != nil {
+		return nil, fmt.Errorf("encode request")
+	}
+	body := buffer.Bytes()
+	if len(body) == 0 || body[len(body)-1] != '\n' {
+		return nil, fmt.Errorf("encode request")
+	}
+	return append([]byte(nil), body[:len(body)-1]...), nil
+}

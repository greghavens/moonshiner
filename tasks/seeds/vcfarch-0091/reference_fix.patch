 // BuildPlan constructs the ordered migration architecture from the estate and
 // pinned compatibility documents.
 func BuildPlan(estateJSON, compatibilityJSON []byte) ([]byte, error) {
-	return nil, ErrNotImplemented
+	var inv estate
+	if err := json.Unmarshal(estateJSON, &inv); err != nil {
+		return nil, fmt.Errorf("decode estate: %w", err)
+	}
+	var compat compatibility
+	if err := json.Unmarshal(compatibilityJSON, &compat); err != nil {
+		return nil, fmt.Errorf("decode compatibility: %w", err)
+	}
+	if inv.SourceVCFVersion != compat.SourceVCFVersion || inv.TargetVCFVersion != compat.TargetVCFVersion {
+		return nil, fmt.Errorf("fixture versions do not match compatibility snapshot")
+	}
+
+	var topology *struct {
+		ID               string   `json:"id"`
+		Supported        bool     `json:"supported"`
+		RequiredVCFCores int      `json:"requiredVcfCores"`
+		HostIDs          []string `json:"hostIds"`
+	}
+	for i := range compat.Topologies {
+		candidate := &compat.Topologies[i]
+		if candidate.Supported && candidate.RequiredVCFCores <= inv.Entitlement.LicensedCores {
+			topology = candidate
+			break
+		}
+	}
+	if topology == nil {
+		return nil, fmt.Errorf("no supported topology fits the %d-core entitlement", inv.Entitlement.LicensedCores)
+	}
+
+	path, err := shortestPath(inv.SourceVCFVersion, inv.TargetVCFVersion, compat)
+	if err != nil {
+		return nil, err
+	}
+	components := make([]component, 0, len(inv.Components))
+	for _, current := range inv.Components {
+		target, ok := compat.ComponentTargets[current.ID]
+		if !ok {
+			return nil, fmt.Errorf("component %s has no pinned target", current.ID)
+		}
+		components = append(components, component{
+			ID:             current.ID,
+			Name:           current.Name,
+			Domain:         current.Domain,
+			CurrentVersion: current.CurrentVersion,
+			Target:         target.Target,
+			TargetState:    target.TargetState,
+			Gates:          append([]string(nil), target.RequiredGates...),
+		})
+	}
+	steps := append([]step(nil), compat.RequiredOperations...)
+	for i := range steps {
+		steps[i].Order = i + 1
+	}
+
+	hostnameByID := map[string]string{}
+	for _, domain := range inv.Domains {
+		for _, host := range domain.Hosts {
+			hostnameByID[host.ID] = host.Hostname
+		}
+	}
+	hostSpecs := make([]map[string]any, 0, len(topology.HostIDs))
+	for _, id := range topology.HostIDs {
+		hostname, ok := hostnameByID[id]
+		if !ok {
+			return nil, fmt.Errorf("topology references unknown host %s", id)
+		}
+		hostSpecs = append(hostSpecs, map[string]any{"hostname": hostname})
+	}
+	targetSpec := map[string]any{
+		"sddcId":             inv.TargetSpecInputs.SDDCID,
+		"workflowType":       "VCF",
+		"version":            inv.TargetVCFVersion,
+		"vcfInstanceName":    inv.TargetSpecInputs.VCFInstanceName,
+		"hostSpecs":          hostSpecs,
+		"networkSpecs":       []any{inv.TargetSpecInputs.ManagementNetwork},
+		"dnsSpec":            map[string]any{"subdomain": inv.TargetSpecInputs.DNSSubdomain, "nameservers": inv.TargetSpecInputs.Nameservers},
+		"ntpServers":         inv.TargetSpecInputs.NTPServers,
+		"ceipEnabled":        false,
+		"managementPoolName": "chi01-management-pool",
+		"vcenterSpec": map[string]any{
+			"vcenterHostname":       inv.TargetSpecInputs.VCenterHostname,
+			"rootVcenterPassword":   inv.TargetSpecInputs.VCenterRootPassword,
+			"version":               inv.TargetVCFVersion,
+			"useExistingDeployment": true,
+		},
+	}
+
+	return IndentJSON(plan{
+		SchemaVersion:    "1.0.0",
+		EstateID:         inv.EstateID,
+		SourceVCFVersion: inv.SourceVCFVersion,
+		TargetVCFVersion: inv.TargetVCFVersion,
+		SelectedTopology: topology.ID,
+		Entitlement: map[string]any{
+			"edition":       inv.Entitlement.Edition,
+			"licensedCores": inv.Entitlement.LicensedCores,
+			"requiredCores": topology.RequiredVCFCores,
+		},
+		UpgradePath: path,
+		TargetSpec:  targetSpec,
+		Components:  components,
+		Steps:       steps,
+	})
+}
+
+func shortestPath(source, target string, compat compatibility) ([]string, error) {
+	paths := [][]string{{source}}
+	seen := map[string]bool{source: true}
+	for len(paths) > 0 {
+		path := paths[0]
+		paths = paths[1:]
+		last := path[len(path)-1]
+		if last == target {
+			return path, nil
+		}
+		for _, hop := range compat.SupportedVCFHops {
+			if hop.From != last || seen[hop.To] {
+				continue
+			}
+			seen[hop.To] = true
+			next := append(append([]string(nil), path...), hop.To)
+			paths = append(paths, next)
+		}
+	}
+	return nil, fmt.Errorf("no supported upgrade path from %s to %s", source, target)
 }
 

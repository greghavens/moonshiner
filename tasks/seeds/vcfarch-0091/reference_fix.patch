+package migration
+
+import (
+	"encoding/json"
+	"os"
+	"reflect"
+	"testing"
+)
+
+func TestBuildPlan(t *testing.T) {
+	estateBytes, err := os.ReadFile("../fixtures/estate.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	compatBytes, err := os.ReadFile("../compatibility/vcf-compatibility-2026-08-14.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	tests := []struct {
+		name          string
+		licensedCores int
+		wantTopology  string
+		wantPath      []string
+		wantErr       bool
+	}{
+		{name: "entitlement removes dual domain", licensedCores: 64, wantTopology: "consolidated-management", wantPath: []string{"5.1.1.0", "5.2.2.0", "9.1.0.0"}},
+		{name: "no entitled topology", licensedCores: 32, wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var raw map[string]any
+			if err := json.Unmarshal(estateBytes, &raw); err != nil {
+				t.Fatal(err)
+			}
+			raw["entitlement"].(map[string]any)["licensedCores"] = tt.licensedCores
+			input, err := json.Marshal(raw)
+			if err != nil {
+				t.Fatal(err)
+			}
+			artifact, err := BuildPlan(input, compatBytes)
+			if tt.wantErr {
+				if err == nil {
+					t.Fatal("BuildPlan succeeded, want error")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			var got plan
+			if err := json.Unmarshal(artifact, &got); err != nil {
+				t.Fatal(err)
+			}
+			if got.SelectedTopology != tt.wantTopology {
+				t.Fatalf("topology = %q, want %q", got.SelectedTopology, tt.wantTopology)
+			}
+			if !reflect.DeepEqual(got.UpgradePath, tt.wantPath) {
+				t.Fatalf("path = %v, want %v", got.UpgradePath, tt.wantPath)
+			}
+		})
+	}
+}
+
+func TestBuildPlanDeterministic(t *testing.T) {
+	estateBytes, err := os.ReadFile("../fixtures/estate.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	compatBytes, err := os.ReadFile("../compatibility/vcf-compatibility-2026-08-14.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	tests := []struct {
+		name string
+	}{
+		{name: "same inputs produce identical bytes"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			first, err := BuildPlan(estateBytes, compatBytes)
+			if err != nil {
+				t.Fatal(err)
+			}
+			second, err := BuildPlan(estateBytes, compatBytes)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if string(first) != string(second) {
+				t.Fatal("BuildPlan output is not deterministic")
+			}
+		})
+	}
+}

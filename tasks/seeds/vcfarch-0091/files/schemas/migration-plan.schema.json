{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "estateId", "sourceVcfVersion", "targetVcfVersion", "selectedTopology", "entitlement", "upgradePath", "targetSpec", "components", "steps"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "estateId": {"type": "string", "minLength": 1},
    "sourceVcfVersion": {"type": "string", "minLength": 1},
    "targetVcfVersion": {"type": "string", "minLength": 1},
    "selectedTopology": {"type": "string", "minLength": 1},
    "entitlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edition", "licensedCores", "requiredCores"],
      "properties": {
        "edition": {"type": "string", "minLength": 1},
        "licensedCores": {"type": "integer", "minimum": 1},
        "requiredCores": {"type": "integer", "minimum": 1}
      }
    },
    "upgradePath": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "targetSpec": {"type": "object"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "domain", "currentVersion", "target", "targetState", "gates"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "currentVersion": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "targetState": {"enum": ["present", "decommissioned"]},
          "gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "id", "phase", "action", "components", "from", "to", "gates", "requires"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "id": {"type": "string", "minLength": 1},
          "phase": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "requires": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}

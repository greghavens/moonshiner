+import java.io.IOException;
+import java.net.URI;
+import java.net.URLEncoder;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+/** Minimal VCF Automation blueprint client for the protected contract subset. */
+public final class AutomationClient {
+    public record BlueprintDraft(
+            String name,
+            String content,
+            String projectId,
+            String description,
+            String apiVersion) {
+        public BlueprintDraft {
+            Objects.requireNonNull(name, "name");
+            Objects.requireNonNull(content, "content");
+            Objects.requireNonNull(projectId, "projectId");
+        }
+    }
+
+    public record BlueprintLink(String id, String selfLink) {}
+
+    public static final class ValidationException extends Exception {
+        private final String responseBody;
+
+        public ValidationException(String responseBody) {
+            super("blueprint validation failed: " + responseBody);
+            this.responseBody = responseBody;
+        }
+
+        public String responseBody() {
+            return responseBody;
+        }
+    }
+
+    private final URI baseUri;
+    private final String authorization;
+    private final HttpClient httpClient;
+
+    public AutomationClient(URI baseUri, String bearerToken) {
+        this.baseUri = Objects.requireNonNull(baseUri, "baseUri");
+        Objects.requireNonNull(bearerToken, "bearerToken");
+        this.authorization = "Bearer " + bearerToken;
+        this.httpClient = HttpClient.newHttpClient();
+    }
+
+    public BlueprintLink validateAndCreate(BlueprintDraft draft)
+            throws IOException, InterruptedException, ValidationException {
+        Objects.requireNonNull(draft, "draft");
+
+        String validationBody = object(
+                field("content", draft.content()),
+                field("projectId", draft.projectId()));
+        HttpResponse<String> validation = post(
+                "/blueprint/api/blueprint-validation",
+                draft.apiVersion(),
+                validationBody);
+        requireStatus("blueprint validation", validation, 200);
+
+        Map<?, ?> validationObject = parseObject(
+                validation.body(), "blueprint validation response");
+        Object valid = validationObject.get("valid");
+        if (!(valid instanceof Boolean)) {
+            throw new IOException("blueprint validation response has no boolean valid field");
+        }
+        if (!((Boolean) valid)) {
+            throw new ValidationException(validation.body());
+        }
+
+        String createBody = object(
+                field("content", draft.content()),
+                optionalField("description", draft.description()),
+                field("name", draft.name()),
+                field("projectId", draft.projectId()));
+        HttpResponse<String> created = post(
+                "/blueprint/api/blueprints",
+                draft.apiVersion(),
+                createBody);
+        requireStatus("blueprint creation", created, 201);
+        Map<?, ?> createdObject = parseObject(
+                created.body(), "blueprint creation response");
+        return new BlueprintLink(
+                requiredString(createdObject, "id"),
+                requiredString(createdObject, "selfLink"));
+    }
+
+    private HttpResponse<String> post(String path, String apiVersion, String body)
+            throws IOException, InterruptedException {
+        String query = apiVersion == null
+                ? ""
+                : "?apiVersion=" + URLEncoder.encode(apiVersion, StandardCharsets.UTF_8);
+        URI endpoint = baseUri.resolve(path + query);
+        HttpRequest request = HttpRequest.newBuilder(endpoint)
+                .header("Authorization", authorization)
+                .header("Accept", "application/json")
+                .header("Content-Type", "application/json")
+                .POST(HttpRequest.BodyPublishers.ofString(body, StandardCharsets.UTF_8))
+                .build();
+        return httpClient.send(request,
+                HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+    }
+
+    private static void requireStatus(
+            String operation, HttpResponse<?> response, int expectedStatus)
+            throws IOException {
+        if (response.statusCode() != expectedStatus) {
+            throw new IOException(operation + " returned HTTP " + response.statusCode());
+        }
+    }
+
+    private static String object(String... fields) {
+        StringBuilder json = new StringBuilder("{");
+        boolean first = true;
+        for (String field : fields) {
+            if (field == null) {
+                continue;
+            }
+            if (!first) {
+                json.append(',');
+            }
+            json.append(field);
+            first = false;
+        }
+        return json.append('}').toString();
+    }
+
+    private static String field(String name, String value) {
+        return quote(name) + ':' + quote(value);
+    }
+
+    private static String optionalField(String name, String value) {
+        return value == null ? null : field(name, value);
+    }
+
+    private static String quote(String value) {
+        StringBuilder escaped = new StringBuilder(value.length() + 2).append('"');
+        for (int i = 0; i < value.length(); i++) {
+            char c = value.charAt(i);
+            switch (c) {
+                case '"' -> escaped.append("\\\"");
+                case '\\' -> escaped.append("\\\\");
+                case '\b' -> escaped.append("\\b");
+                case '\f' -> escaped.append("\\f");
+                case '\n' -> escaped.append("\\n");
+                case '\r' -> escaped.append("\\r");
+                case '\t' -> escaped.append("\\t");
+                default -> {
+                    if (c < 0x20) {
+                        escaped.append(String.format("\\u%04x", (int) c));
+                    } else {
+                        escaped.append(c);
+                    }
+                }
+            }
+        }
+        return escaped.append('"').toString();
+    }
+
+    private static Map<?, ?> parseObject(String json, String label) throws IOException {
+        Object value = new JsonParser(json).parse();
+        if (!(value instanceof Map<?, ?>)) {
+            throw new IOException(label + " is not a JSON object");
+        }
+        return (Map<?, ?>) value;
+    }
+
+    private static String requiredString(Map<?, ?> json, String name)
+            throws IOException {
+        Object value = json.get(name);
+        if (!(value instanceof String)) {
+            throw new IOException("response has no string " + name + " field");
+        }
+        return (String) value;
+    }
+
+    /** Small strict JSON reader used only for the two response objects. */
+    private static final class JsonParser {
+        private final String json;
+        private int at;
+
+        private JsonParser(String json) {
+            this.json = Objects.requireNonNull(json, "json");
+        }
+
+        private Object parse() throws IOException {
+            Object value = parseValue();
+            skipWhitespace();
+            if (at != json.length()) {
+                throw error("trailing content");
+            }
+            return value;
+        }
+
+        private Object parseValue() throws IOException {
+            skipWhitespace();
+            if (at >= json.length()) {
+                throw error("expected a value");
+            }
+            return switch (json.charAt(at)) {
+                case '{' -> parseObject();
+                case '[' -> parseArray();
+                case '"' -> parseString();
+                case 't' -> parseLiteral("true", Boolean.TRUE);
+                case 'f' -> parseLiteral("false", Boolean.FALSE);
+                case 'n' -> parseLiteral("null", null);
+                default -> parseNumber();
+            };
+        }
+
+        private Map<String, Object> parseObject() throws IOException {
+            expect('{');
+            Map<String, Object> object = new LinkedHashMap<>();
+            skipWhitespace();
+            if (consume('}')) {
+                return object;
+            }
+            while (true) {
+                skipWhitespace();
+                if (at >= json.length() || json.charAt(at) != '"') {
+                    throw error("expected an object member name");
+                }
+                String name = parseString();
+                skipWhitespace();
+                expect(':');
+                Object value = parseValue();
+                if (object.containsKey(name)) {
+                    throw error("duplicate object member " + name);
+                }
+                object.put(name, value);
+                skipWhitespace();
+                if (consume('}')) {
+                    return object;
+                }
+                expect(',');
+            }
+        }
+
+        private List<Object> parseArray() throws IOException {
+            expect('[');
+            List<Object> array = new ArrayList<>();
+            skipWhitespace();
+            if (consume(']')) {
+                return array;
+            }
+            while (true) {
+                array.add(parseValue());
+                skipWhitespace();
+                if (consume(']')) {
+                    return array;
+                }
+                expect(',');
+            }
+        }
+
+        private String parseString() throws IOException {
+            expect('"');
+            StringBuilder value = new StringBuilder();
+            while (at < json.length()) {
+                char c = json.charAt(at++);
+                if (c == '"') {
+                    return value.toString();
+                }
+                if (c < 0x20) {
+                    throw error("unescaped control character in string");
+                }
+                if (c != '\\') {
+                    value.append(c);
+                    continue;
+                }
+                if (at >= json.length()) {
+                    throw error("truncated string escape");
+                }
+                char escaped = json.charAt(at++);
+                switch (escaped) {
+                    case '"', '\\', '/' -> value.append(escaped);
+                    case 'b' -> value.append('\b');
+                    case 'f' -> value.append('\f');
+                    case 'n' -> value.append('\n');
+                    case 'r' -> value.append('\r');
+                    case 't' -> value.append('\t');
+                    case 'u' -> value.append(parseUnicodeEscape());
+                    default -> throw error("invalid string escape");
+                }
+            }
+            throw error("unterminated string");
+        }
+
+        private char parseUnicodeEscape() throws IOException {
+            if (at + 4 > json.length()) {
+                throw error("truncated unicode escape");
+            }
+            int value = 0;
+            for (int i = 0; i < 4; i++) {
+                int digit = Character.digit(json.charAt(at++), 16);
+                if (digit < 0) {
+                    throw error("invalid unicode escape");
+                }
+                value = value * 16 + digit;
+            }
+            return (char) value;
+        }
+
+        private Object parseNumber() throws IOException {
+            int start = at;
+            consume('-');
+            if (consume('0')) {
+                // A leading zero is a complete integer part.
+            } else {
+                requireDigit('1', '9', "expected a JSON number");
+                while (consumeDigit()) {
+                    // consume integer digits
+                }
+            }
+            if (consume('.')) {
+                requireDigit('0', '9', "fraction requires a digit");
+                while (consumeDigit()) {
+                    // consume fraction digits
+                }
+            }
+            if (consume('e') || consume('E')) {
+                if (!consume('+')) {
+                    consume('-');
+                }
+                requireDigit('0', '9', "exponent requires a digit");
+                while (consumeDigit()) {
+                    // consume exponent digits
+                }
+            }
+            if (at == start) {
+                throw error("expected a value");
+            }
+            return new JsonNumber(json.substring(start, at));
+        }
+
+        private Object parseLiteral(String literal, Object value) throws IOException {
+            if (!json.startsWith(literal, at)) {
+                throw error("invalid literal");
+            }
+            at += literal.length();
+            return value;
+        }
+
+        private void requireDigit(char first, char last, String message)
+                throws IOException {
+            if (at >= json.length()
+                    || json.charAt(at) < first || json.charAt(at) > last) {
+                throw error(message);
+            }
+            at++;
+        }
+
+        private boolean consumeDigit() {
+            if (at < json.length()
+                    && json.charAt(at) >= '0' && json.charAt(at) <= '9') {
+                at++;
+                return true;
+            }
+            return false;
+        }
+
+        private boolean consume(char expected) {
+            if (at < json.length() && json.charAt(at) == expected) {
+                at++;
+                return true;
+            }
+            return false;
+        }
+
+        private void expect(char expected) throws IOException {
+            if (!consume(expected)) {
+                throw error("expected '" + expected + "'");
+            }
+        }
+
+        private void skipWhitespace() {
+            while (at < json.length()) {
+                char c = json.charAt(at);
+                if (c != ' ' && c != '\t' && c != '\n' && c != '\r') {
+                    return;
+                }
+                at++;
+            }
+        }
+
+        private IOException error(String message) {
+            return new IOException("invalid JSON at character " + at + ": " + message);
+        }
+    }
+
+    private record JsonNumber(String lexicalValue) {}
+}

diff --git a/.reference_solution.py b/.reference_solution.py
new file mode 100755
--- /dev/null
+++ b/.reference_solution.py
@@ -0,0 +1,115 @@
+#!/usr/bin/env python3
+"""Produce the reference deliverable through genuine education executions."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "educationctl"
+DELIVERABLE = ROOT / "education-availability.txt"
+TARGETS = (
+    {
+        "name": "Microeconomics",
+        "location": "Downtown",
+        "date": "2026-11-23",
+    },
+    {
+        "name": "Modern History",
+        "location": "North Campus",
+        "date": "2026-11-23",
+    },
+)
+
+
+def command_for(target: dict[str, str]) -> list[str]:
+    return [
+        str(CLIENT),
+        "availability",
+        "--name",
+        target["name"],
+        "--location",
+        target["location"],
+        "--date",
+        target["date"],
+    ]
+
+
+def collect(process: subprocess.Popen[str]) -> dict[str, Any]:
+    stdout, stderr = process.communicate(timeout=5)
+    response_text = stdout if process.returncode == 0 else stderr
+    try:
+        response = json.loads(response_text)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("education executable returned invalid JSON") from error
+    return {"returncode": process.returncode, "response": response}
+
+
+def run_one(target: dict[str, str]) -> dict[str, Any]:
+    completed = subprocess.run(
+        command_for(target),
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=5,
+        start_new_session=True,
+    )
+    response_text = completed.stdout if completed.returncode == 0 else completed.stderr
+    try:
+        response = json.loads(response_text)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("education retry returned invalid JSON") from error
+    return {"returncode": completed.returncode, "response": response}
+
+
+def main() -> int:
+    processes = [
+        subprocess.Popen(
+            command_for(target),
+            cwd=ROOT,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+            start_new_session=True,
+        )
+        for target in TARGETS
+    ]
+    initial = [collect(process) for process in processes]
+
+    if initial[0]["returncode"] != 75:
+        raise RuntimeError("reference retry branch did not temporarily fail")
+    failure = initial[0]["response"]
+    if (
+        failure.get("error") != "temporary_unavailable"
+        or failure.get("retryable") is not True
+    ):
+        raise RuntimeError("reference failure was not explicitly retryable")
+    if initial[1]["returncode"] != 0:
+        raise RuntimeError("reference independent branch did not succeed")
+
+    retried = run_one(TARGETS[0])
+    if retried["returncode"] != 0:
+        raise RuntimeError("reference retry did not succeed")
+
+    results = [retried["response"], initial[1]["response"]]
+    lines = []
+    for index, result in enumerate(results):
+        availability = "available" if result["available"] else "unavailable"
+        retry_clause = "; its check was retried once" if index == 0 else ""
+        lines.append(
+            f"{result['name']} at {result['location']} on {result['date']}: "
+            f"{availability}{retry_clause}."
+        )
+    if lines != sorted(lines):
+        raise RuntimeError("reference lines are not alphabetically ordered")
+    DELIVERABLE.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

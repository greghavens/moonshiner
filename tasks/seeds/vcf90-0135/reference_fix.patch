@@ -2,7 +2,11 @@
 
 from __future__ import annotations
 
+import json
 from dataclasses import dataclass
+from typing import Any
+from urllib.error import HTTPError, URLError
+from urllib.request import Request, urlopen
 
 
 @dataclass(frozen=True, slots=True)
@@ -63,5 +67,122 @@ class SyslogClient:
     ) -> ChangeReport:
         """Apply the target, mapping, and status operations in order."""
 
-        raise NotImplementedError
-
+        target_body = _without_unset(
+            {
+                "ip_or_fqdn": target.ip_or_fqdn,
+                "port": target.port,
+                "protocol": target.protocol,
+                "nick_name": target.nick_name,
+                "collector_id": target.collector_id,
+            }
+        )
+        mapping_items = [
+            _without_unset(
+                {
+                    "syslog_source": mapping.syslog_source,
+                    "collector_id": mapping.collector_id,
+                    "syslog_ip": mapping.syslog_ip,
+                }
+            )
+            for mapping in mappings
+        ]
+        changes: tuple[tuple[str, str, str, object, frozenset[int]], ...] = (
+            (
+                "addSyslogTarget",
+                "POST",
+                "/api/ni/settings/syslog",
+                target_body,
+                frozenset({201}),
+            ),
+            (
+                "updateSyslogMapping",
+                "POST",
+                "/api/ni/settings/syslog/mapping",
+                [mapping_items],
+                frozenset({201}),
+            ),
+            (
+                "updateSyslogStatus",
+                "PATCH",
+                "/api/ni/settings/syslog/status",
+                {"enabled": enabled},
+                frozenset({200}),
+            ),
+        )
+
+        results: list[StepResult] = []
+        for operation_id, method, path, body, success_codes in changes:
+            result = self._send(operation_id, method, path, body, success_codes)
+            results.append(result)
+            if not result.success:
+                break
+        return ChangeReport(tuple(results))
+
+    def _send(
+        self,
+        operation_id: str,
+        method: str,
+        path: str,
+        body: object,
+        success_codes: frozenset[int],
+    ) -> StepResult:
+        encoded = json.dumps(body, separators=(",", ":"), ensure_ascii=False).encode(
+            "utf-8"
+        )
+        request = Request(
+            self.base_url.rstrip("/") + path,
+            data=encoded,
+            method=method,
+            headers={
+                "Accept": "application/json",
+                "Authorization": f"NetworkInsight {self.token}",
+                "Content-Type": "application/json",
+            },
+        )
+        try:
+            with urlopen(request, timeout=self.timeout) as response:
+                status = response.status
+                response_body = response.read()
+        except HTTPError as error:
+            try:
+                error_body = error.read()
+            finally:
+                error.close()
+            return StepResult(
+                operation_id,
+                False,
+                error.code,
+                _http_error_message(error.code, error_body),
+            )
+        except (URLError, TimeoutError, OSError) as error:
+            return StepResult(operation_id, False, None, f"transport error: {error}")
+
+        if status not in success_codes:
+            return StepResult(
+                operation_id,
+                False,
+                status,
+                _http_error_message(status, response_body),
+            )
+        return StepResult(operation_id, True, status)
+
+
+def _without_unset(values: dict[str, Any]) -> dict[str, Any]:
+    """Return wire fields while distinguishing an unset value from false or zero."""
+
+    return {key: value for key, value in values.items() if value is not None}
+
+
+def _http_error_message(status: int, body: bytes) -> str:
+    message = ""
+    if body:
+        try:
+            payload = json.loads(body)
+        except (UnicodeDecodeError, json.JSONDecodeError):
+            message = body.decode("utf-8", errors="replace")
+        else:
+            if isinstance(payload, dict) and isinstance(payload.get("message"), str):
+                message = payload["message"]
+            else:
+                message = json.dumps(payload, separators=(",", ":"))
+    return f"HTTP {status}" + (f": {message}" if message else "")

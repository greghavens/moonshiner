+    # -- transport --------------------------------------------------------
+    def _send(self, method, path, body=None, headers=None, retry=False):
+        """Issue one operation, optionally retrying transient server failures.
+
+        The request is rebuilt identically on every attempt, so a retry is a
+        byte-for-byte replay of the original -- which is what makes the
+        Client-Token on a create attempt meaningful.
+        """
+        url = self._base_url + path
+        data = None
+        request_headers = dict(headers or {})
+        if body is not None:
+            data = json.dumps(body).encode("utf-8")
+            request_headers["Content-Type"] = "application/json"
+        request_headers.setdefault("Accept", "application/json")
 
+        attempts = self._max_attempts if retry else 1
+        last_error = None
+        for attempt in range(1, attempts + 1):
+            request = urlrequest.Request(url, data=data, method=method)
+            for key, value in request_headers.items():
+                request.add_header(key, value)
+            try:
+                with urlrequest.urlopen(request, timeout=self._timeout) as response:
+                    payload = response.read()
+                    return json.loads(payload) if payload else None
+            except HTTPError as exc:
+                last_error = self._to_api_error(exc)
+                if (
+                    last_error.status not in RETRYABLE_STATUS
+                    or attempt == attempts
+                ):
+                    raise last_error
+            if self._backoff:
+                time.sleep(self._backoff)
+        raise last_error
+
+    @staticmethod
+    def _to_api_error(exc):
+        try:
+            payload = json.loads(exc.read() or b"null")
+        except (ValueError, OSError):
+            payload = None
+        if not isinstance(payload, dict):
+            payload = {}
+        messages = payload.get("messages") or []
+        detail = messages[0].get("default_message") if messages else None
+        return VCenterApiError(
+            exc.code, payload.get("error_type"), messages, detail=detail
+        )
+
+    def _session(self):

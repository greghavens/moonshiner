+                ("%s:%s" % (self._username, self._password)).encode("utf-8")
+            ).decode("ascii")
+            self._session_id = self._send(
+                "POST",
+                "/session",
+                headers={"Authorization": "Basic " + credentials},
+                retry=True,
+            )
+        return self._session_id
+
+    def _authenticated_headers(self, extra=None):
+        headers = {SESSION_HEADER: self._session()}
+        headers.update(extra or {})
+        return headers

+            if ((b >= 'a' && b <= 'z')
+                    || (b >= 'A' && b <= 'Z')
+                    || (b >= '0' && b <= '9')
+                    || b == '-' || b == '.' || b == '_' || b == '~') {
+                out.append((char) b);
+            } else {
+                out.append('%');
+                out.append("0123456789ABCDEF".charAt(b >>> 4));
+                out.append("0123456789ABCDEF".charAt(b & 0xf));
+            }
+        }
+        return out.toString();
+    }

+    private static final class JsonParser {
+        private final String source;
+        private int index;
+
+        private JsonParser(String source) {
+            this.source = source;
+        }
+
+        private Object parseDocument() throws JsonFailure {
+            skipWhitespace();
+            Object value = parseValue();

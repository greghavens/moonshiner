{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VCF existing-estate ordered migration plan",
  "type": "object",
  "required": ["schemaVersion", "sourceSite", "targetRelease", "steps"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "sourceSite": {"type": "string", "minLength": 1},
    "targetRelease": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sequence", "componentId", "componentName", "currentVersion", "targetVersion", "action", "gates"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "componentId": {"type": "string", "minLength": 1},
          "componentName": {"type": "string", "minLength": 1},
          "currentVersion": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "action": {"enum": ["RETAIN", "UPGRADE", "CONVERGE", "DECOMMISSION"]},
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

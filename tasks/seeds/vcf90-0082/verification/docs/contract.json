{
  "source": {
    "title": "VCF Operations for Logs",
    "version": "v2",
    "tag": "9.0.0.0",
    "commitSha": "d81412d7bdd9642a488f897b35c2b09acae60db3",
    "specPath": "specifications/vcf-operations/vcf-operations-for-logs-openapi.json"
  },
  "basePath": "/api/v2",
  "operations": [
    {
      "operationId": "POST_sessions",
      "method": "POST",
      "path": "/sessions",
      "authenticated": false,
      "request": {
        "contentType": "application/json",
        "required": [
          "username",
          "password",
          "provider"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "Local",
              "ActiveDirectory",
              "vIDM"
            ]
          }
        }
      },
      "success": {
        "status": 200,
        "required": [
          "userId",
          "sessionId",
          "ttl"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "sessionId": {
            "type": "string",
            "minLength": 1
          },
          "ttl": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "operationId": "POST_log-forwarder",
      "method": "POST",
      "path": "/log-forwarder",
      "authenticated": true,
      "request": {
        "contentType": "application/json",
        "required": [
          "name",
          "host",
          "port",
          "protocol",
          "sslEnabled"
        ],
        "properties": {
          "acceptCert": {
            "type": "boolean",
            "default": false
          },
          "name": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "SYSLOG",
              "CFAPI",
              "RAW",
              "RAWPlus"
            ]
          },
          "sslEnabled": {
            "type": "boolean"
          },
          "workerCount": {
            "type": "integer",
            "default": 4
          },
          "connectionRefreshInterval": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "default": 60
          },
          "diskCacheSize": {
            "type": "integer",
            "default": 1000000000
          },
          "tags": {
            "type": "object",
            "default": {}
          },
          "filter": {
            "type": "string",
            "default": ""
          },
          "transportProtocol": {
            "type": "string",
            "enum": [
              "TCP",
              "UDP",
              "TCP_OCTET"
            ],
            "default": "TCP"
          },
          "forwardComplementaryFields": {
            "type": "boolean",
            "default": false
          },
          "testConnection": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "success": {
        "status": 201,
        "schema": "forwarders.get.response"
      },
      "sessionFailureStatuses": [
        401,
        440
      ]
    },
    {
      "operationId": "GET_log-forwarder",
      "method": "GET",
      "path": "/log-forwarder",
      "authenticated": true,
      "query": {
        "showDetails": {
          "type": "boolean",
          "required": false,
          "default": false
        }
      },
      "success": {
        "status": 200,
        "type": "array",
        "items": "forwarders.get.response"
      },
      "sessionFailureStatuses": [
        401,
        440
      ]
    }
  ],
  "schemas": {
    "forwarders.get.response": {
      "type": "object",
      "required": [
        "name",
        "host",
        "port",
        "protocol",
        "sslEnabled",
        "workerCount",
        "diskCacheSize",
        "tags",
        "filter",
        "forwardComplementaryFields",
        "id"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "SYSLOG",
            "CFAPI",
            "RAW",
            "RAWPlus",
            "UNKNOWN"
          ]
        },
        "sslEnabled": {
          "type": "boolean"
        },
        "workerCount": {
          "type": "integer"
        },
        "connectionRefreshInterval": {
          "type": "integer"
        },
        "diskCacheSize": {
          "type": "integer"
        },
        "tags": {
          "type": "object"
        },
        "filter": {
          "type": "string"
        },
        "transportProtocol": {
          "type": "string",
          "enum": [
            "TCP",
            "UDP",
            "TCP_OCTET",
            "UNKNOWN"
          ]
        },
        "forwardComplementaryFields": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "forwarderStats": {
          "type": "object"
        }
      }
    }
  }
}

+function New-VcfLogsSession {
+    param(
+        [uri] $Uri,
+        [pscredential] $Credential,
+        [string] $Provider
+    )
+
+    $body = [ordered]@{
+        username = $Credential.UserName
+        password = $Credential.GetNetworkCredential().Password
+        provider = $Provider
+    }
+    $response = Invoke-RestMethod -Uri $Uri -Method Post -ContentType 'application/json' `
+        -Body ($body | ConvertTo-Json -Compress) -ErrorAction Stop
+    if ([string]::IsNullOrEmpty([string] $response.sessionId)) {
+        throw 'The VCF Operations for Logs session response did not include a sessionId.'
+    }
+    return [string] $response.sessionId
+}
+
+function Get-VcfLogsHttpStatusCode {
+    param([System.Management.Automation.ErrorRecord] $ErrorRecord)
+
+    $exception = $ErrorRecord.Exception
+    while ($null -ne $exception) {
+        $responseProperty = $exception.PSObject.Properties['Response']
+        if ($null -ne $responseProperty -and $null -ne $responseProperty.Value) {
+            $statusProperty = $responseProperty.Value.PSObject.Properties['StatusCode']
+            if ($null -ne $statusProperty -and $null -ne $statusProperty.Value) {
+                return [int] $statusProperty.Value
+            }
+        }
+        $exception = $exception.InnerException
+    }
+    return $null
+}
+
+function Get-VcfLogsInputValue {
+    param(
+        [object] $InputObject,
+        [string] $Name,
+        [ref] $Exists
+    )
+
+    if ($InputObject -is [System.Collections.IDictionary]) {
+        foreach ($key in $InputObject.Keys) {
+            if ([string] $key -ieq $Name) {
+                $Exists.Value = $true
+                return $InputObject[$key]
+            }
+        }
+        $Exists.Value = $false
+        return $null
+    }
+
+    $property = $InputObject.PSObject.Properties[$Name]
+    $Exists.Value = $null -ne $property
+    if ($null -ne $property) {
+        return $property.Value
+    }
+    return $null
+}
+
+function ConvertTo-VcfLogsForwarderBody {
+    param([object] $InputObject)
+
+    $required = [ordered]@{
+        Name = 'name'
+        Host = 'host'
+        Port = 'port'
+        Protocol = 'protocol'
+        SslEnabled = 'sslEnabled'
+    }
+    $optional = [ordered]@{
+        AcceptCert = 'acceptCert'
+        WorkerCount = 'workerCount'
+        ConnectionRefreshInterval = 'connectionRefreshInterval'
+        DiskCacheSize = 'diskCacheSize'
+        Tags = 'tags'
+        Filter = 'filter'
+        TransportProtocol = 'transportProtocol'
+        ForwardComplementaryFields = 'forwardComplementaryFields'
+        TestConnection = 'testConnection'
+    }
+
+    $body = [ordered]@{}
+    foreach ($mapping in $required.GetEnumerator()) {
+        $exists = $false
+        $body[$mapping.Value] = Get-VcfLogsInputValue -InputObject $InputObject `
+            -Name $mapping.Key -Exists ([ref] $exists)
+    }
+    foreach ($mapping in $optional.GetEnumerator()) {
+        $exists = $false
+        $value = Get-VcfLogsInputValue -InputObject $InputObject `
+            -Name $mapping.Key -Exists ([ref] $exists)
+        if ($exists -and $null -ne $value) {
+            $body[$mapping.Value] = $value
+        }
+    }
+    return $body
+}
+

+
+// fetchFollowerPages retrieves pages 1..len(pages)-1 with at most concurrency
+// requests in flight, writing each page into its own slot so that the
+// collection order never depends on completion order.
+func (c *Client) fetchFollowerPages(ctx context.Context, filter TaskFilter, pageSize, concurrency int, pages [][]TaskSummary) error {
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+
+	errs := make([]error, len(pages))
+	slots := make(chan struct{}, concurrency)
+	var wg sync.WaitGroup
+
+	for pageNumber := 1; pageNumber < len(pages); pageNumber++ {
+		wg.Add(1)
+		go func(pageNumber int) {
+			defer wg.Done()
+			select {
+			case slots <- struct{}{}:
+				defer func() { <-slots }()
+			case <-ctx.Done():
+				errs[pageNumber] = ctx.Err()
+				return
+			}
+			if ctx.Err() != nil {
+				errs[pageNumber] = ctx.Err()
+				return
+			}
+			page, err := c.getTasksPage(ctx, filter, pageNumber, pageSize)
+			if err != nil {
+				errs[pageNumber] = err
+				cancel() // stop the remaining pages; the call has already failed
+				return
+			}
+			pages[pageNumber] = page.Elements
+		}(pageNumber)
+	}
+	wg.Wait()
+
+	// Report the lowest-numbered genuine failure in preference to the
+	// cancellations it caused, so the error is the same on every run.
+	for _, err := range errs {
+		if err != nil && !errors.Is(err, context.Canceled) {
+			return err
+		}
+	}
+	for _, err := range errs {
+		if err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// stableOrder de-duplicates by task id, keeping the occurrence with the lowest
+// (page number, index within page), and returns the result in the package's
+// stable order.
+func stableOrder(pages [][]TaskSummary) []TaskSummary {
+	type placed struct {
+		pageNumber int
+		index      int
+		task       TaskSummary
+	}
+	best := make(map[string]placed)
+	for pageNumber, elements := range pages {
+		for index, task := range elements {
+			current, seen := best[task.ID]
+			if seen && (current.pageNumber < pageNumber ||
+				(current.pageNumber == pageNumber && current.index <= index)) {
+				continue
+			}
+			best[task.ID] = placed{pageNumber: pageNumber, index: index, task: task}
+		}
+	}
+
+	out := make([]TaskSummary, 0, len(best))
+	for _, entry := range best {
+		out = append(out, entry.task)
+	}
+	sort.Slice(out, func(i, j int) bool {
+		left, leftOK := parseTimestamp(out[i].CreateTime)
+		right, rightOK := parseTimestamp(out[j].CreateTime)
+		if leftOK != rightOK {
+			return leftOK // tasks without a usable createTime sort last
+		}
+		if leftOK && !left.Equal(right) {
+			return left.Before(right)
+		}
+		return out[i].ID < out[j].ID
+	})
+	return out
+}
+
+func parseTimestamp(value string) (time.Time, bool) {
+	if value == "" {
+		return time.Time{}, false
+	}
+	parsed, err := time.Parse(time.RFC3339, value)
+	if err != nil {
+		return time.Time{}, false
+	}
+	return parsed.UTC(), true
 }
 

{
  "contract_version": 1,
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/nsx/openapi-2.0/nsx_policy_api.yaml",
    "license": "Apache-2.0"
  },
  "api": {
    "swagger": "2.0",
    "title": "NSX Policy API",
    "version": "9.1.0.0",
    "basePath": "/policy/api/v1",
    "produces": [
      "application/json"
    ],
    "security": "BasicAuth"
  },
  "operations": [
    {
      "operationId": "OrgsOrgIdProjectsProjectIdInfraUpdateSecurityPolicyForDomain",
      "method": "PUT",
      "path": "/orgs/{org-id}/projects/{project-id}/infra/domains/{domain-id}/security-policies/{security-policy-id}",
      "path_parameters": [
        "org-id",
        "project-id",
        "domain-id",
        "security-policy-id"
      ],
      "request_body": {
        "required": true,
        "schema": "SecurityPolicy"
      },
      "responses": {
        "200": "SecurityPolicy"
      }
    },
    {
      "operationId": "OrgsOrgIdProjectsProjectIdInfraReadIntentStatus",
      "method": "GET",
      "path": "/orgs/{org-id}/projects/{project-id}/infra/realized-state/status",
      "path_parameters": [
        "org-id",
        "project-id"
      ],
      "query_parameters": {
        "intent_path": {
          "required": true,
          "type": "string"
        },
        "include_enforced_status": {
          "required": false,
          "type": "boolean",
          "default": false
        },
        "site_path": {
          "required": false,
          "type": "string"
        }
      },
      "responses": {
        "200": "ConsolidatedRealizedStatus"
      }
    },
    {
      "operationId": "OrgsOrgIdProjectsProjectIdInfraListSecurityPoliciesForDomain",
      "method": "GET",
      "path": "/orgs/{org-id}/projects/{project-id}/infra/domains/{domain-id}/security-policies",
      "path_parameters": [
        "org-id",
        "project-id",
        "domain-id"
      ],
      "query_parameters": {
        "cursor": {
          "required": false,
          "type": "string"
        },
        "include_mark_for_delete_objects": {
          "required": false,
          "type": "boolean",
          "default": false
        },
        "include_rule_count": {
          "required": false,
          "type": "boolean",
          "default": false
        },
        "included_fields": {
          "required": false,
          "type": "string"
        },
        "page_size": {
          "required": false,
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 1000,
          "default": 1000
        },
        "sort_ascending": {
          "required": false,
          "type": "boolean"
        },
        "sort_by": {
          "required": false,
          "type": "string"
        }
      },
      "responses": {
        "200": "SecurityPolicyListResult"
      }
    }
  ],
  "schemas": {
    "SecurityPolicy": {
      "allOf": [
        "Policy"
      ],
      "selected_properties": {
        "id": {
          "type": "string"
        },
        "display_name": {
          "type": "string",
          "maxLength": 255
        },
        "resource_type": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "items": "Rule"
        }
      }
    },
    "ConsolidatedRealizedStatus": {
      "allOf": [
        "AggregatePolicyRuntimeInfo"
      ],
      "required": [
        "publish_status"
      ],
      "selected_properties": {
        "intent_path": {
          "type": "string",
          "readOnly": true
        },
        "consolidated_status": {
          "schema": "ConsolidatedStatus"
        },
        "publish_status": {
          "type": "string",
          "enum": [
            "UNAVAILABLE",
            "UNREALIZED",
            "REALIZED",
            "ERROR"
          ]
        }
      }
    },
    "ConsolidatedStatus": {
      "selected_properties": {
        "consolidated_status": {
          "type": "string",
          "readOnly": true,
          "enum": [
            "SUCCESS",
            "IN_PROGRESS",
            "ERROR",
            "UNKNOWN",
            "UNINITIALIZED",
            "SANDBOXED_REALIZATION_PENDING",
            "DOWN",
            "DEGRAGED",
            "DISABLED"
          ]
        }
      }
    },
    "SecurityPolicyListResult": {
      "allOf": [
        "PolicyListResult"
      ],
      "required": [
        "results"
      ],
      "selected_properties": {
        "results": {
          "type": "array",
          "items": "SecurityPolicy"
        }
      }
    }
  }
}

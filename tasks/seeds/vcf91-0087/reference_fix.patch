+    private static Duration remaining(long started, long budget) throws IOException {
+        long elapsed = System.nanoTime() - started;
+        long nanos = budget - elapsed;
+        if (nanos <= 0) {
+            throw new IOException("timed out waiting for NSX Policy realization");
+        }
+        return Duration.ofNanos(nanos);
+    }

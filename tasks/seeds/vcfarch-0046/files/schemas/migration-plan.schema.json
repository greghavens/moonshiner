{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:vcfarch-0046:migration-plan",
  "title": "VCF 9.0 existing-estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "estateId",
    "targetVcfVersion",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetVcfVersion": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "componentId",
          "componentName",
          "currentVersion",
          "targetProduct",
          "targetVersion",
          "disposition",
          "gates"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "componentName": {
            "type": "string",
            "minLength": 1
          },
          "currentVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetProduct": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "patch-and-retain",
              "in-place-upgrade",
              "import-then-upgrade",
              "new-install-and-data-transfer",
              "retain-no-in-place-upgrade"
            ]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "supportBoundary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

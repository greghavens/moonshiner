+{
+  "schemaVersion": "1.0.0",
+  "estateId": "det01-management-estate",
+  "targetVcfVersion": "9.0.0.0",
+  "steps": [
+    {
+      "order": 1,
+      "componentId": "aria-suite-lifecycle",
+      "componentName": "VMware Aria Suite Lifecycle",
+      "currentVersion": "8.18.0",
+      "targetProduct": "VMware Aria Suite Lifecycle",
+      "targetVersion": "8.18.0 Patch 2",
+      "disposition": "patch-and-retain",
+      "gates": [
+        "vrslcm-8.18-patch2-binary-mapped"
+      ]
+    },
+    {
+      "order": 2,
+      "componentId": "aria-operations",
+      "componentName": "VMware Aria Operations",
+      "currentVersion": "8.18.3",
+      "targetProduct": "VCF Operations and VCF Operations Fleet Management",
+      "targetVersion": "9.0.0.0",
+      "disposition": "in-place-upgrade",
+      "gates": [
+        "vrslcm-8.18-patch2-installed",
+        "vcf-operations-9-pak-mapped",
+        "fleet-management-9-ova-mapped",
+        "aria-operations-inventory-synchronized",
+        "aria-operations-prechecks-passed"
+      ]
+    },
+    {
+      "order": 3,
+      "componentId": "aria-automation",
+      "componentName": "VMware Aria Automation",
+      "currentVersion": "8.18.1",
+      "targetProduct": "VCF Automation",
+      "targetVersion": "9.0.0.0",
+      "disposition": "import-then-upgrade",
+      "gates": [
+        "vcf-operations-fleet-management-online",
+        "aria-automation-imported-as-integrated-instance",
+        "aria-automation-prechecks-passed"
+      ]
+    },
+    {
+      "order": 4,
+      "componentId": "aria-operations-for-logs",
+      "componentName": "VMware Aria Operations for Logs",
+      "currentVersion": "8.18.2",
+      "targetProduct": "VCF Operations for Logs",
+      "targetVersion": "9.0.0.0",
+      "disposition": "new-install-and-data-transfer",
+      "gates": [
+        "vcf-operations-9-online",
+        "fresh-vcf-operations-for-logs-9-deployment"
+      ],
+      "supportBoundary": "No in-place upgrade path exists from VMware Aria Operations for Logs 8.x to VCF Operations for Logs 9.0; at most 90 days of log data can be transferred as a Day-N operation."

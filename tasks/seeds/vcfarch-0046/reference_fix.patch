--- /dev/null
+++ b/src/Vcf.GreenfieldArchitecture/Vcf.GreenfieldArchitecture.psm1
@@ -0,0 +1,253 @@
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+function ConvertTo-InstallerDocument {
+    param([Parameter(Mandatory, ValueFromPipeline)]$InputObject)
+
+    process {
+        if ($null -eq $InputObject) {
+            return $null
+        }
+        if ($InputObject -is [string] -or $InputObject -is [ValueType]) {
+            return $InputObject
+        }
+        if ($InputObject -is [System.Collections.IDictionary]) {
+            $result = [ordered]@{}
+            foreach ($key in $InputObject.Keys) {
+                if ($null -ne $InputObject[$key]) {
+                    $result[[string]$key] = ConvertTo-InstallerDocument $InputObject[$key]
+                }
+            }
+            return $result
+        }
+        if ($InputObject -is [System.Collections.IEnumerable]) {
+            $items = @($InputObject | ForEach-Object { ConvertTo-InstallerDocument $_ })
+            Write-Output -NoEnumerate $items
+            return
+        }
+
+        $result = [ordered]@{}
+        foreach ($property in $InputObject.PSObject.Properties) {
+            if (-not $property.IsGettable -or $null -eq $property.Value -or $property.Name -eq 'ExtensionData') {
+                continue
+            }
+            $apiName = $property.Name.Substring(0, 1).ToLowerInvariant() + $property.Name.Substring(1)
+            $result[$apiName] = ConvertTo-InstallerDocument $property.Value
+        }
+        return $result
+    }
+}
+
+function New-VcfGreenfieldArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateScript({ Test-Path -LiteralPath $_ -PathType Leaf })]
+        [string]$RequirementsPath,
+
+        [Parameter(Mandatory)]
+        [ValidateScript({ Test-Path -LiteralPath $_ -PathType Leaf })]
+        [string]$EstateInventoryPath,
+
+        [Parameter(Mandatory)]
+        [ValidateScript({ Test-Path -LiteralPath $_ -PathType Leaf })]
+        [string]$CompatibilitySnapshotPath,
+
+        [Parameter(Mandatory)]
+        [string]$OutputDirectory
+    )
+
+    $design = Get-Content -LiteralPath $RequirementsPath -Raw | ConvertFrom-Json -Depth 100
+    $inventory = Get-Content -LiteralPath $EstateInventoryPath -Raw | ConvertFrom-Json -Depth 100
+    $compatibility = Get-Content -LiteralPath $CompatibilitySnapshotPath -Raw | ConvertFrom-Json -Depth 100
+
+    $hostSpecs = @($design.hosts | ForEach-Object {
+        Initialize-VcfInstallerSddcHostSpec -Hostname $_.hostname
+    })
+
+    $networkSpecs = @($design.networks | ForEach-Object {
+        $range = Initialize-VcfInstallerIpRange -StartIpAddress $_.rangeStart -EndIpAddress $_.rangeEnd
+        Initialize-VcfInstallerSddcNetworkSpec `
+            -NetworkType $_.networkType `
+            -Subnet $_.subnet `
+            -Gateway $_.gateway `
+            -VlanId $_.vlanId `
+            -Mtu $_.mtu `
+            -IncludeIpAddressRanges @($range) `
+            -TeamingPolicy 'loadbalance_loadbased' `
+            -ActiveUplinks @('uplink1', 'uplink2')
+    })
+
+    $vmnicMappings = @(
+        Initialize-VcfInstallerVmnicToUplink -Id 'vmnic0' -Uplink 'uplink1'
+        Initialize-VcfInstallerVmnicToUplink -Id 'vmnic1' -Uplink 'uplink2'
+    )
+    $dvsSpec = Initialize-VcfInstallerDvsSpec `
+        -DvsName "$($design.site.code)-MGMT-VDS01" `
+        -Networks @($design.networks.networkType) `
+        -Mtu 9000 `
+        -VmnicsToUplinks $vmnicMappings
+
+    $vcenterSpec = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname $design.appliances.vcenter `
+        -RootVcenterPassword '<VC_ROOT_SECRET>' `
+        -VmSize 'large' `
+        -StorageSize 'lstorage' `
+        -SsoDomain 'vsphere.local' `
+        -AdminUserSsoUsername 'administrator' `
+        -AdminUserSsoPassword '<SSO_SECRET>' `
+        -UseExistingDeployment:$false `
+        -Version $design.target.version
+
+    $clusterSpec = Initialize-VcfInstallerSddcClusterSpec `
+        -DatacenterName $design.site.datacenterName `
+        -ClusterName $design.site.clusterName `
+        -ClusterEvcMode 'INTEL_SAPPHIRERAPIDS'
+
+    $dnsSpec = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $design.site.dnsSubdomain `
+        -Nameservers @($design.services.dnsServers)
+
+    $sddcManagerSpec = Initialize-VcfInstallerSddcManagerSpec `
+        -RootPassword '<SDDC_ROOT_SECRET>' `
+        -Hostname $design.appliances.sddcManager `
+        -SshPassword '<SDDC_SSH_SECRET>' `
+        -LocalUserPassword '<SDDC_LOCAL_SECRET>' `
+        -UseExistingDeployment:$false `
+        -Version $design.target.version
+
+    $nsxManagers = @($design.appliances.nsxManagers | ForEach-Object {
+        Initialize-VcfInstallerNsxtManagerSpec -Hostname $_
+    })
+    $tepRange = Initialize-VcfInstallerIpAddressPoolRangeSpec `
+        -Start $design.nsxOverlay.rangeStart `
+        -VarEnd $design.nsxOverlay.rangeEnd
+    $tepSubnet = Initialize-VcfInstallerIpAddressPoolSubnetSpec `
+        -IpAddressPoolRanges @($tepRange) `
+        -Cidr $design.nsxOverlay.cidr `
+        -Gateway $design.nsxOverlay.gateway
+    $tepPool = Initialize-VcfInstallerIpAddressPoolSpec `
+        -Name $design.nsxOverlay.poolName `
+        -Description 'CHI01 NSX host TEP pool' `
+        -IgnoreUnavailableNsxtCluster:$false `
+        -Subnets @($tepSubnet)
+    $nsxtSpec = Initialize-VcfInstallerSddcNsxtSpec `
+        -NsxtManagers $nsxManagers `
+        -NsxtManagerSize 'large' `
+        -VipFqdn $design.appliances.nsxVip `
+        -RootNsxtManagerPassword '<NSX_ROOT_SECRET>' `
+        -NsxtAdminPassword '<NSX_ADMIN_SECRET>' `
+        -NsxtAuditPassword '<NSX_AUDIT_SECRET>' `
+        -TransportVlanId $design.nsxOverlay.vlanId `
+        -IpAddressPoolSpec $tepPool `
+        -UseExistingDeployment:$false `
+        -Version $design.target.version
+
+    $esaConfig = Initialize-VcfInstallerVsanEsaConfig -Enabled:$true
+    $vsanSpec = Initialize-VcfInstallerVsanSpec `
+        -DatastoreName "$($design.site.code)-MGMT-VSAN01" `
+        -VsanDedup:$false `
+        -EsaConfig $esaConfig `
+        -FailuresToTolerate $design.availability.hostFailuresToTolerate
+    $datastoreSpec = Initialize-VcfInstallerSddcDatastoreSpec -VsanSpec $vsanSpec
+    $securitySpec = Initialize-VcfInstallerSecuritySpec -EsxiCertsMode 'VMCA'
+
+    $fleetSpec = Initialize-VcfInstallerVcfOperationsFleetManagementSpec `
+        -Hostname $design.appliances.operationsFleetManager `
+        -RootUserPassword '<FLEET_ROOT_KEY>' `
+        -AdminUserPassword '<FLEET_ADMIN_KEY>' `
+        -UseExistingDeployment:$false `
+        -Version $design.target.version
+
+    $operationsTypes = @('master', 'replica', 'data')
+    $operationsNodes = for ($index = 0; $index -lt $design.appliances.operationsNodes.Count; $index++) {
+        Initialize-VcfInstallerVcfOperationsNode `
+            -Hostname $design.appliances.operationsNodes[$index] `
+            -RootUserPassword '<OPS_ROOT_SECRET>' `
+            -Type $operationsTypes[$index]
+    }
+    $operationsSpec = Initialize-VcfInstallerVcfOperationsSpec `
+        -Nodes @($operationsNodes) `
+        -AdminUserPassword '<OPS_ADMIN_SECRET>' `
+        -ApplianceSize 'large' `
+        -LoadBalancerFqdn $design.appliances.operationsLoadBalancer `
+        -UseExistingDeployment:$false `
+        -Version $design.target.version
+
+    $automationSpec = Initialize-VcfInstallerVcfAutomationSpec `
+        -Hostname $design.appliances.automation `
+        -AdminUserPassword '<AUTO_ADMIN_SECRET>' `
+        -IpPool @($design.appliances.automationIpPool) `
+        -InternalClusterCidr $design.appliances.automationInternalClusterCidr `
+        -NodePrefix $design.appliances.automationNodePrefix `
+        -UseExistingDeployment:$false `
+        -Version $design.target.version
+
+    $sdkSddcSpec = Initialize-VcfInstallerSddcSpec `
+        -SddcId $design.site.sddcId `
+        -WorkflowType $design.target.workflowType `
+        -HostSpecs $hostSpecs `
+        -Version $design.target.version `
+        -VcenterSpec $vcenterSpec `
+        -ClusterSpec $clusterSpec `
+        -DvsSpecs @($dvsSpec) `
+        -NsxtSpec $nsxtSpec `
+        -NetworkSpecs $networkSpecs `
+        -DnsSpec $dnsSpec `
+        -NtpServers @($design.services.ntpServers) `
+        -SddcManagerSpec $sddcManagerSpec `
+        -ManagementPoolName "$($design.site.code)-MGMT-POOL" `
+        -CeipEnabled:$false `
+        -SkipEsxThumbprintValidation:$false `
+        -SkipGatewayPingValidation:$false `
+        -SecuritySpec $securitySpec `
+        -DatastoreSpec $datastoreSpec `
+        -VcfOperationsFleetManagementSpec $fleetSpec `
+        -VcfOperationsSpec $operationsSpec `
+        -VcfAutomationSpec $automationSpec `
+        -VcfInstanceName $design.site.vcfInstanceName
+
+    $migrationSteps = @($compatibility.rules | Sort-Object sequence | ForEach-Object {
+        $rule = $_
+        $component = @($inventory.components | Where-Object { $_.id -eq $rule.componentId })
+        if ($component.Count -ne 1) {
+            throw "Compatibility component '$($rule.componentId)' does not map to exactly one inventory component."
+        }
+        $step = [ordered]@{
+            order = [int]$rule.sequence
+            componentId = $component[0].id
+            componentName = $component[0].name
+            currentVersion = $component[0].version
+            targetProduct = $rule.targetProduct
+            targetVersion = $rule.targetVersion
+            disposition = $rule.disposition
+            gates = @($rule.requiredGates)
+        }
+        if ($rule.PSObject.Properties.Name -contains 'supportBoundary') {
+            $step.supportBoundary = $rule.supportBoundary
+        }
+        [pscustomobject]$step
+    })
+    if ($migrationSteps.Count -ne $inventory.components.Count) {
+        throw 'Compatibility snapshot must cover every estate inventory component exactly once.'
+    }
+
+    $migrationPlan = [ordered]@{
+        schemaVersion = '1.0.0'
+        estateId = $inventory.estateId
+        targetVcfVersion = $compatibility.targetVcfVersion
+        steps = $migrationSteps
+    }
+
+    $null = New-Item -ItemType Directory -Path $OutputDirectory -Force
+    $sddcDocument = ConvertTo-InstallerDocument $sdkSddcSpec
+    $sddcDocument | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath (Join-Path $OutputDirectory 'sddc-spec.json') -Encoding utf8
+    $migrationPlan | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath (Join-Path $OutputDirectory 'migration-plan.json') -Encoding utf8
+
+    [pscustomobject]@{
+        SddcSpecPath = Join-Path $OutputDirectory 'sddc-spec.json'
+        MigrationPlanPath = Join-Path $OutputDirectory 'migration-plan.json'
+    }
+}
+
+Export-ModuleMember -Function New-VcfGreenfieldArchitecture

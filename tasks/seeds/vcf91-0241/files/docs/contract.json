{
  "contract_version": 1,
  "description": "Focused projection of the vSAN Data Protection (Snapshot Appliance) API required to take an on-demand protection group snapshot and follow the resulting asynchronous task to a terminal state. Derived directly from the pinned OpenAPI specification recorded in docs/official_sources.json.",
  "api_title": "Snapshot Appliance API",
  "api_version": "9.1.0.0",
  "openapi_version": "3.0.3",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "spec_path": "specifications/vsan-data-protection/vsan-data-protection-openapi.yaml",
    "license": "Apache-2.0"
  },
  "base_path": "/api",
  "auth": {
    "login_security_scheme": "basic_auth",
    "login_header": "Authorization",
    "login_header_prefix": "Basic ",
    "session_security_scheme": "api_key_auth",
    "session_header": "vmware-api-session-id"
  },
  "operations": [
    {
      "operation_id": "Snapservice.Sessions_create",
      "method": "POST",
      "path_template": "/snapservice/sessions",
      "query": {},
      "success_status": 201,
      "authentication": "basic_auth",
      "request_body": null,
      "response": {
        "type": "string",
        "format": "password",
        "description": "Newly created session token to be used for authenticating further requests."
      }
    },
    {
      "operation_id": "Snapservice.Clusters.ProtectionGroups.Snapshots_create$Task",
      "method": "POST",
      "path_template": "/snapservice/clusters/{cluster}/protection-groups/{pg}/snapshots",
      "query": {
        "vmw-task": "true"
      },
      "path_parameters": [
        {
          "name": "cluster",
          "resource_type": "ClusterComputeResource"
        },
        {
          "name": "pg",
          "resource_type": "com.vmware.snapservice.protection_group"
        }
      ],
      "success_status": 202,
      "authentication": "api_key_auth",
      "request_body": {
        "required": true,
        "media_type": "application/json",
        "schema": "Snapservice.Clusters.ProtectionGroups.Snapshots.CreateSpec",
        "required_properties": [
          "name"
        ],
        "optional_properties": [
          "retention"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "retention": {
            "schema": "Snapservice.RetentionPeriod",
            "type": "object",
            "required_properties": [
              "duration",
              "unit"
            ],
            "properties": {
              "duration": {
                "type": "integer",
                "format": "int64"
              },
              "unit": {
                "type": "string",
                "schema": "Snapservice.TimeUnit",
                "enum": [
                  "MINUTE",
                  "HOUR",
                  "DAY",
                  "WEEK",
                  "MONTH",
                  "YEAR"
                ]
              }
            }
          }
        }
      },
      "response": {
        "type": "string",
        "description": "Identifier of the task created for the snapshot operation."
      }
    },
    {
      "operation_id": "Snapservice.Tasks_get",
      "method": "GET",
      "path_template": "/snapservice/tasks/{task}",
      "query": {},
      "path_parameters": [
        {
          "name": "task",
          "resource_type": "com.vmware.snapservice.task"
        }
      ],
      "success_status": 200,
      "authentication": "api_key_auth",
      "request_body": null,
      "response": {
        "schema": "Snapservice.Tasks.Info",
        "required_properties": [
          "cancelable",
          "description",
          "operation",
          "service",
          "status"
        ],
        "optional_properties": [
          "progress",
          "result",
          "vc_task",
          "error"
        ]
      }
    }
  ],
  "task_status": {
    "schema": "Snapservice.Tasks.Status",
    "enum": [
      "PENDING",
      "RUNNING",
      "BLOCKED",
      "SUCCEEDED",
      "FAILED"
    ],
    "terminal": [
      "SUCCEEDED",
      "FAILED"
    ],
    "non_terminal": [
      "PENDING",
      "RUNNING",
      "BLOCKED"
    ]
  }
}

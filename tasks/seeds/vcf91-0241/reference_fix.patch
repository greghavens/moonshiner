+function Get-VsanDpInfoValue {
+    <#
+        Reads a property from a decoded response body, which the OpenAPI
+        runtime materialises as an ExpandoObject. Absent optional properties
+        yield $null rather than an error.
+
+        Values leave here unenumerated. An ExpandoObject is an
+        IEnumerable of key/value pairs, so a nested one written to the
+        pipeline the ordinary way arrives at the caller as an array of
+        pairs and every property on it reads as missing.
+    #>
+    [CmdletBinding()]
+    param($Body, [Parameter(Mandatory)][string] $Name)
+
+    if ($null -eq $Body) { return $null }
+    $dictionary = $Body -as [System.Collections.Generic.IDictionary[string, object]]
+    if ($null -ne $dictionary) {
+        if ($dictionary.ContainsKey($Name)) {
+            Write-Output -NoEnumerate $dictionary[$Name]
+            return
+        }
+        return $null
+    }
+    $property = $Body.PSObject.Properties[$Name]
+    if ($null -eq $property) { return $null }
+    Write-Output -NoEnumerate $property.Value
+}
+
+function Get-VsanDpFailureText {
+    [CmdletBinding()]
+    param($Info)
+
+    $messages = [System.Collections.Generic.List[string]]::new()
+    foreach ($name in @('error', 'description')) {
+        $node = Get-VsanDpInfoValue -Body $Info -Name $name
+        if ($null -eq $node) { continue }
+        $list = Get-VsanDpInfoValue -Body $node -Name 'messages'
+        if ($null -eq $list) { $list = @($node) }
+        foreach ($item in $list) {
+            $text = Get-VsanDpInfoValue -Body $item -Name 'default_message'
+            if (-not [string]::IsNullOrWhiteSpace([string]$text)) { $messages.Add([string]$text) }
+        }
+    }
+    if ($messages.Count -eq 0) { return 'no further detail was reported' }
+    return ($messages -join ' ')
+}

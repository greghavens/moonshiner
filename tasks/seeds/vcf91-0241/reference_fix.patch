+function Resolve-VsanDpBasePath {
+    <#
+        Accepts either a bare host name (HTTPS is assumed) or an absolute
+        http/https URL, and returns the service base path.
+    #>
+    [CmdletBinding()]
+    param([Parameter(Mandatory)][string] $Server)
+
+    $trimmed = $Server.Trim()
+    if ([string]::IsNullOrWhiteSpace($trimmed)) {
+        throw [System.ArgumentException]::new('Server must not be blank.', 'Server')
+    }
+
+    $hasExplicitScheme = $trimmed -match '^[A-Za-z][A-Za-z0-9+.-]*://'
+    if (-not $hasExplicitScheme) {
+        $hostKind = [System.Uri]::CheckHostName($trimmed)
+        if ($hostKind -eq [System.UriHostNameType]::Unknown) {
+            throw [System.ArgumentException]::new("Server '$Server' must be a bare host name or an absolute http/https URL.", 'Server')
+        }
+        if ($hostKind -eq [System.UriHostNameType]::IPv6) { $trimmed = "[$trimmed]" }
+        $trimmed = 'https://' + $trimmed
+    }
+
+    $uri = $null
+    if (-not [System.Uri]::TryCreate($trimmed, [System.UriKind]::Absolute, [ref] $uri)) {
+        throw [System.ArgumentException]::new("Server '$Server' is not a valid address.", 'Server')
+    }
+    if ($uri.Scheme -notin @('http', 'https')) {
+        throw [System.ArgumentException]::new("Server '$Server' must use http or https.", 'Server')
+    }
+
+    return ($uri.GetLeftPart([System.UriPartial]::Authority).TrimEnd('/') + $script:BasePathSuffix)
+}

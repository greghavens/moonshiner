{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:moonshiner:vcfarch-0047:migration-plan:1.0",
  "title": "VCF existing-estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "estateId",
    "targetVcfVersion",
    "storageTransition",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetVcfVersion": {
      "type": "string",
      "minLength": 1
    },
    "storageTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "inPlace",
        "mode"
      ],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "inPlace": { "type": "boolean" },
        "mode": { "type": "string", "minLength": 1 }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "componentId",
          "name",
          "fromVersion",
          "targetVersion",
          "action",
          "gates"
        ],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "componentId": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "fromVersion": { "type": "string", "minLength": 1 },
          "targetVersion": { "type": "string", "minLength": 1 },
          "action": {
            "enum": [
              "VALIDATE",
              "INSTALL",
              "UPGRADE",
              "RECONFIGURE",
              "MIGRATE"
            ]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "gateId",
                "condition"
              ],
              "properties": {
                "gateId": { "type": "string", "minLength": 1 },
                "condition": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}

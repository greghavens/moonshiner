@@ -0,0 +1,297 @@
+Set-StrictMode -Version Latest
+
+function Read-VcfArchitectureJson {
+    param([Parameter(Mandatory)] [string] $Path)
+    Get-Content -LiteralPath $Path -Raw | ConvertFrom-Json -Depth 100
+}
+
+function New-VcfArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)] [string] $RequirementsPath,
+        [Parameter(Mandatory)] [string] $InventoryPath,
+        [Parameter(Mandatory)] [string] $CompatibilitySnapshotPath,
+        [Parameter(Mandatory)] [string] $OutputPath
+    )
+
+    $requirements = Read-VcfArchitectureJson $RequirementsPath
+    $inventory = Read-VcfArchitectureJson $InventoryPath
+    $snapshot = Read-VcfArchitectureJson $CompatibilitySnapshotPath
+
+    $options = @($snapshot.greenfieldOptions | Where-Object {
+        $_.supported -eq $true -and
+        $_.supportedHostProfileIds -contains $requirements.hostProfile.profileId
+    } | Sort-Object -Property selectionRank, hostCount)
+    if ($options.Count -lt 1) {
+        throw "The pinned snapshot has no supported storage option for host profile '$($requirements.hostProfile.profileId)'."
+    }
+    $selected = $options[0]
+
+    $dataSiteRequirements = @($requirements.sites | Where-Object role -ceq 'DATA')
+    $witnessRequirement = @($requirements.sites | Where-Object role -ceq 'WITNESS')
+    $placements = @()
+    $selectedHosts = @()
+    foreach ($site in $dataSiteRequirements) {
+        $siteHosts = @($requirements.availableHosts |
+            Where-Object siteId -ceq $site.siteId |
+            Select-Object -First $selected.dataHostsPerSite)
+        if ($siteHosts.Count -ne [int]$selected.dataHostsPerSite) {
+            throw "Site '$($site.siteId)' does not have the host count required by the pinned $($selected.architecture) design."
+        }
+        $hostnames = @($siteHosts | ForEach-Object hostname)
+        $placements += [ordered]@{
+            siteId = $site.siteId
+            faultDomain = $site.faultDomain
+            hostnames = $hostnames
+        }
+        $selectedHosts += $siteHosts
+    }
+
+    $hostSpecs = @($selectedHosts | ForEach-Object {
+        [ordered]@{ hostname = $_.hostname }
+    })
+    $networkSpecs = @($requirements.network.networks | ForEach-Object {
+        [ordered]@{
+            networkType = $_.networkType
+            subnet = $_.subnet
+            gateway = $_.gateway
+            subnetMask = $_.subnetMask
+            includeIpAddressRanges = @(
+                [ordered]@{
+                    startIpAddress = $_.startIpAddress
+                    endIpAddress = $_.endIpAddress
+                }
+            )
+            vlanId = [int]$_.vlanId
+            mtu = [int]$requirements.network.mtu
+        }
+    })
+    $trafficTypes = @($requirements.network.networks | ForEach-Object networkType)
+    $uplinks = @()
+    for ($index = 0; $index -lt [int]$requirements.hostProfile.physicalNicsPerHost; $index++) {
+        $uplinks += [ordered]@{
+            id = "vmnic$index"
+            uplink = "uplink$($index + 1)"
+        }
+    }
+
+    $alternatives = @($options | ForEach-Object {
+        [ordered]@{
+            architecture = $_.architecture
+            hostCount = [int]$_.hostCount
+            dataHostsPerSite = [int]$_.dataHostsPerSite
+            minimumPhysicalNicGbps = [int]$_.minimumPhysicalNicGbps
+            mtu = [int]$_.minimumMtu
+        }
+    })
+
+    $sddcSpec = [ordered]@{
+        sddcId = $requirements.sddc.sddcId
+        workflowType = $requirements.sddc.workflowType
+        hostSpecs = $hostSpecs
+        version = $requirements.targetVcfVersion
+        vcenterSpec = [ordered]@{
+            vcenterHostname = $requirements.sddc.vcenterHostname
+            rootVcenterPassword = '${VCENTER_ROOT_PASSWORD}'
+            vmSize = 'medium'
+            storageSize = 'lstorage'
+            ssoDomain = 'vsphere.local'
+            adminUserSsoUsername = 'administrator'
+            adminUserSsoPassword = '${SSO_ADMIN_PASSWORD}'
+            useExistingDeployment = $false
+            version = $requirements.targetVcfVersion
+        }
+        clusterSpec = [ordered]@{
+            datacenterName = $requirements.sddc.datacenterName
+            clusterName = $requirements.sddc.clusterName
+            clusterEvcMode = $requirements.hostProfile.cpuGeneration
+        }
+        dvsSpecs = @(
+            [ordered]@{
+                dvsName = $requirements.network.distributedSwitchName
+                networks = $trafficTypes
+                mtu = [int]$requirements.network.mtu
+                vmnicsToUplinks = $uplinks
+            }
+        )
+        networkSpecs = $networkSpecs
+        dnsSpec = [ordered]@{
+            subdomain = $requirements.sddc.dnsSubdomain
+            nameservers = @($requirements.sddc.nameServers)
+        }
+        ntpServers = @($requirements.sddc.ntpServers)
+        datastoreSpec = [ordered]@{
+            vsanSpec = [ordered]@{
+                datastoreName = "$($requirements.sddc.sddcId)-vsan01"
+                vsanDedup = $false
+                esaConfig = [ordered]@{
+                    enabled = ($selected.architecture -ceq 'ESA')
+                }
+                failuresToTolerate = [int]$requirements.availability.hostFailuresToTolerate
+            }
+        }
+        ceipEnabled = $false
+        skipEsxThumbprintValidation = $false
+        skipGatewayPingValidation = $false
+        vcfInstanceName = $requirements.sddc.instanceName
+    }
+
+    $migrationSteps = @()
+    foreach ($authority in @($snapshot.upgradePlan | Sort-Object order)) {
+        $component = @($inventory.components | Where-Object componentId -ceq $authority.componentId)
+        if ($component.Count -ne 1) {
+            throw "Inventory component '$($authority.componentId)' is missing or duplicated."
+        }
+        $gates = @($authority.requiredGateIds | ForEach-Object {
+            $gateId = [string]$_
+            $conditionProperty = $snapshot.gateCatalog.PSObject.Properties[$gateId]
+            if ($null -eq $conditionProperty) {
+                throw "Pinned gate '$gateId' has no condition."
+            }
+            [ordered]@{
+                gateId = $gateId
+                condition = [string]$conditionProperty.Value
+            }
+        })
+        $migrationSteps += [ordered]@{
+            order = [int]$authority.order
+            componentId = $component[0].componentId
+            name = $component[0].name
+            fromVersion = $component[0].currentVersion
+            targetVersion = $authority.targetVersion
+            action = $authority.action
+            gates = $gates
+        }
+    }
+
+    $architecture = [ordered]@{
+        artifactVersion = '1.0'
+        greenfield = [ordered]@{
+            requirementsId = $requirements.requirementsId
+            capacity = [ordered]@{
+                usableCpuCores = [int]$requirements.capacity.usableCpuCores
+                usableMemoryGiB = [int]$requirements.capacity.usableMemoryGiB
+                usableStorageTiB = [int]$requirements.capacity.usableStorageTiB
+                freeSpacePercent = [int]$requirements.capacity.freeSpacePercent
+            }
+            storageDecision = [ordered]@{
+                objective = $requirements.selectionObjective
+                selectedArchitecture = $selected.architecture
+                hostCount = [int]$selected.hostCount
+                minimumPhysicalNicGbps = [int]$selected.minimumPhysicalNicGbps
+                alternatives = $alternatives
+            }
+            siteTopology = [ordered]@{
+                topology = $requirements.availability.topology
+                maximumInterSiteRttMs = [int]$requirements.availability.maximumInterSiteRttMs
+                dataSites = $placements
+                witness = [ordered]@{
+                    siteId = $witnessRequirement[0].siteId
+                    faultDomain = $witnessRequirement[0].faultDomain
+                    hostname = $witnessRequirement[0].witnessHostname
+                }
+            }
+            sddcSpec = $sddcSpec
+        }
+        existingEstate = [ordered]@{
+            migrationPlan = [ordered]@{
+                schemaVersion = '1.0'
+                estateId = $inventory.estateId
+                targetVcfVersion = $snapshot.targetVcfVersion
+                storageTransition = [ordered]@{
+                    source = $snapshot.storageTransition.source
+                    target = $snapshot.storageTransition.target
+                    inPlace = [bool]$snapshot.storageTransition.inPlaceSupported
+                    mode = $snapshot.storageTransition.mode
+                }
+                steps = $migrationSteps
+            }
+        }
+    }
+
+    $parent = Split-Path -Parent $OutputPath
+    if (-not [string]::IsNullOrWhiteSpace($parent)) {
+        $null = New-Item -ItemType Directory -Path $parent -Force
+    }
+    $architecture | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $OutputPath -Encoding utf8
+    [pscustomobject]$architecture
+}
+
+function Invoke-VcfArchitectureInstallerValidation {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)] [string] $ArchitecturePath
+    )
+
+    $document = Read-VcfArchitectureJson $ArchitecturePath
+    $spec = $document.greenfield.sddcSpec
+
+    $hostModels = @($spec.hostSpecs | ForEach-Object {
+        Initialize-VcfInstallerSddcHostSpec -Hostname $_.hostname
+    })
+    $vcenterModel = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname $spec.vcenterSpec.vcenterHostname `
+        -RootVcenterPassword $spec.vcenterSpec.rootVcenterPassword `
+        -VmSize $spec.vcenterSpec.vmSize `
+        -StorageSize $spec.vcenterSpec.storageSize `
+        -SsoDomain $spec.vcenterSpec.ssoDomain `
+        -AdminUserSsoUsername $spec.vcenterSpec.adminUserSsoUsername `
+        -AdminUserSsoPassword $spec.vcenterSpec.adminUserSsoPassword `
+        -Version $spec.vcenterSpec.version `
+        -UseExistingDeployment $spec.vcenterSpec.useExistingDeployment
+    $clusterModel = Initialize-VcfInstallerSddcClusterSpec `
+        -DatacenterName $spec.clusterSpec.datacenterName `
+        -ClusterName $spec.clusterSpec.clusterName `
+        -ClusterEvcMode $spec.clusterSpec.clusterEvcMode
+    $networkModels = @($spec.networkSpecs | ForEach-Object {
+        $range = Initialize-VcfInstallerIpRange `
+            -StartIpAddress $_.includeIpAddressRanges[0].startIpAddress `
+            -EndIpAddress $_.includeIpAddressRanges[0].endIpAddress
+        Initialize-VcfInstallerSddcNetworkSpec `
+            -NetworkType $_.networkType `
+            -Subnet $_.subnet `
+            -Gateway $_.gateway `
+            -SubnetMask $_.subnetMask `
+            -IncludeIpAddressRanges $range `
+            -VlanId $_.vlanId `
+            -Mtu $_.mtu
+    })
+    $uplinkModels = @($spec.dvsSpecs[0].vmnicsToUplinks | ForEach-Object {
+        Initialize-VcfInstallerVmnicToUplink -Id $_.id -Uplink $_.uplink
+    })
+    $dvsModel = Initialize-VcfInstallerDvsSpec `
+        -DvsName $spec.dvsSpecs[0].dvsName `
+        -Networks $spec.dvsSpecs[0].networks `
+        -Mtu $spec.dvsSpecs[0].mtu `
+        -VmnicsToUplinks $uplinkModels
+    $dnsModel = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $spec.dnsSpec.subdomain `
+        -Nameservers $spec.dnsSpec.nameservers
+    $esaModel = Initialize-VcfInstallerVsanEsaConfig -Enabled $spec.datastoreSpec.vsanSpec.esaConfig.enabled
+    $vsanModel = Initialize-VcfInstallerVsanSpec `
+        -DatastoreName $spec.datastoreSpec.vsanSpec.datastoreName `
+        -VsanDedup $spec.datastoreSpec.vsanSpec.vsanDedup `
+        -EsaConfig $esaModel `
+        -FailuresToTolerate $spec.datastoreSpec.vsanSpec.failuresToTolerate
+    $datastoreModel = Initialize-VcfInstallerSddcDatastoreSpec -VsanSpec $vsanModel
+    $typedSpec = Initialize-VcfInstallerSddcSpec `
+        -SddcId $spec.sddcId `
+        -WorkflowType $spec.workflowType `
+        -HostSpecs $hostModels `
+        -Version $spec.version `
+        -VcenterSpec $vcenterModel `
+        -ClusterSpec $clusterModel `
+        -DvsSpecs $dvsModel `
+        -NetworkSpecs $networkModels `
+        -DnsSpec $dnsModel `
+        -NtpServers $spec.ntpServers `
+        -DatastoreSpec $datastoreModel `
+        -CeipEnabled $spec.ceipEnabled `
+        -SkipEsxThumbprintValidation $spec.skipEsxThumbprintValidation `
+        -SkipGatewayPingValidation $spec.skipGatewayPingValidation `
+        -VcfInstanceName $spec.vcfInstanceName
+
+    Invoke-VcfInstallerValidateSddcSpec -SddcSpec $typedSpec
+}
+
+Export-ModuleMember -Function New-VcfArchitecture, Invoke-VcfArchitectureInstallerValidation

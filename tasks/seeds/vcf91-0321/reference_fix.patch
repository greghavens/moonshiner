 """The rotation itself.
 
 Standard library only.
+
+The shape of the rotation is forced by the two ``hazard`` notes in
+docs/contract.json: one records documented delete behavior and the other records the
+repository's conservative safety assumption for an in-place update:
+
+* ``updateNamedCredential`` replaces a secret in place, and nothing in the reference
+  describes a grace period, a dual-secret window or credential versioning. A request
+  that authenticated with the previous secret is not migrated -- it is simply holding a
+  secret the service no longer accepts.
+* ``deleteNamedCredential`` terminates the associated vCenter sessions.
+
+So neither operation can be the first step. The only ordering that never leaves live work
+holding a dead secret is to add the new secret, move the consumer onto it, let the old
+work finish, and retire the old secret last:
+
+    probe -> create replacement -> repoint the vCenter -> wait for reconnect
+          -> wait for in-flight requests to drain -> retire the old credential
+
+Every wait is a poll of a documented read operation. The reference documents no task
+resource for this API (there is no Task category in the operation index), so the task URIs
+returned in ``Location`` headers are carried through to the caller as opaque strings
+rather than polled.
 """
 
 from __future__ import annotations
 
+import hashlib
+
+# docs/contract.json -> wireRules.noServerOwnedFieldsOnWrite.VCenterServer
+VCENTER_RESPONSE_ONLY_FIELDS = frozenset(
+    {
+        "isConnected",
+        "listenerState",
+        "clusterHealthStatus",
+        "vcVersion",
+        "buildNumber",
+        "uuid",
+        "licenseStatus",
+    }
+)
+
+
+def _is_absent(value):
+    """True for the placeholders the contract forbids. False and 0 are real values."""
+    if value is None:
+        return True
+    if isinstance(value, (str, list, tuple, dict)) and len(value) == 0:
+        return True
+    return False
+
+
+def _writable_vcenter_payload(vcenter, username, password):
+    """Turn a VCenterServer read into a legal update body.
+
+    Response-only fields are dropped because the contract forbids writing them back, and
+    fields the read returned as null/empty are dropped because carrying them would be
+    sending a placeholder for something this caller never set.
+    """
+    body = {
+        key: value
+        for key, value in vcenter.items()
+        if key not in VCENTER_RESPONSE_ONLY_FIELDS and not _is_absent(value)
+    }
+    body["username"] = username
+    body["password"] = password
+    return body
+
+
+def _replacement_name(credential_name, credential_id):
+    """A distinct, stable name for the replacement credential.
+
+    The two credentials coexist for the length of the rotation, so the new one needs its
+    own name. Deriving the suffix from the old credential's id keeps each generation
+    reproducible and distinct without deriving public metadata from the secret.
+    """
+    digest = hashlib.sha256(credential_id.encode("utf-8")).hexdigest()[:8]
+    return "%s-r%s" % (credential_name, digest)
+
 

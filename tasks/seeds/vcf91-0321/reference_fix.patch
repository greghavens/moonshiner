+    #    endpoint it cannot reach is a rotation that cannot be completed or undone.
+    probe = client.test_connection(host=probe_host, port=probe_port)
+    target = probe.get("targetProbe") or {}
+    if not target.get("canConnect"):
+        raise RuntimeError(
+            "pre-flight probe of %s:%s failed (%s); refusing to rotate"
+            % (probe_host, probe_port, target.get("connectionResult"))
+        )
+

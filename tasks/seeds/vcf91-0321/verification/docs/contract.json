      "query": [],
      "requestBody": null,
      "responses": {"202": {"body": "empty", "headers": {"Location": "tracking task URI"}}},
      "hazard": "The reference states that the associated vCenter sessions will be terminated on delete. Deleting a credential that a vCenter registration is still using strands every request currently running against that vCenter."
    },

{
  "contractVersion": "1.0.0",
  "product": "VMware Cloud Foundation 9.1",
  "component": "VCF Automation - Provider Infrastructure APIs",
  "apiVersion": "9.1.0",
  "basePath": "/cloudapi/1.0.0",

  "provenance": {
    "kind": "reference-documentation",
    "isPublishedSpecification": false,
    "statement": [
      "THIS CONTRACT IS NOT A PUBLISHED SPECIFICATION. It was transcribed by hand from the",
      "human-readable xAPIs reference pages that Broadcom publishes at developer.broadcom.com.",
      "VCF Automation (the VCF 9.1 successor to vRealize / Aria Automation) ships no",
      "machine-readable API description in the vmware/vcf-api-specs repository (Apache-2.0),",
      "and no downloadable OpenAPI document is offered for these operations, so no",
      "authoritative spec file could be vendored into this repository.",
      "Every method, path, parameter, field name and status code below was read off a",
      "specific reference page; docs/official_sources.json records the page URL, the",
      "operation it documents and the date it was fetched, one entry per page.",
      "Consequences you must respect when coding against this contract:",
      "  * Treat it as descriptive, not normative. Where a reference page did not state a",
      "    detail, this contract carries an explicit `notDocumented` note instead of a guess.",
      "    Do not invent fields, parameters, endpoints or error bodies to fill those gaps.",
      "  * Reference pages can drift from the running service. Re-derive from the sources",
      "    before trusting this file against a live deployment."
    ],
    "specificationRepositoryChecked": "https://github.com/vmware/vcf-api-specs",
    "specificationFound": false,
    "sourcesFile": "docs/official_sources.json"
  },

  "conventions": {
    "authentication": {
      "scheme": "ApiKeyAuth",
      "header": "Authorization",
      "value": "Bearer <jwt>",
      "note": "The reference documents a JWT carried in the Authorization header; the legacy x-vcloud-authorization header is deprecated."
    },
    "versioning": {
      "header": "Accept",
      "value": "application/json;version=9.1.0",
      "note": "The reference states an accept header must be included to specify the API version."
    },
    "requestContentType": "application/json",
    "asyncOperations": {
      "status": 202,
      "body": "empty",
      "trackingHeader": "Location",
      "note": "Reference text: asynchronous operations are determined by the server; the server responds with HTTP 202 and an empty body, and the tracking task is linked via the URI provided in the Location header. The shape of the task resource itself is not documented on any Provider Infrastructure APIs reference page (there is no Task category in the operation index), so this contract carries the Location URI as an opaque string and names no operation for reading it."
    },
    "paging": {
      "wrapperFields": ["resultTotal", "pageCount", "page", "pageSize", "associations", "values"],
      "note": "page and pageSize are documented as required with defaults 1 and 25; they are always sent."
    },
    "filtering": {
      "parameter": "filter",
      "syntax": "FIQL",
      "note": "The reference states 'Filter for a query. FIQL format.' but does not enumerate the supported operators."
    }
  },

  "wireRules": {
    "omitUnsetOptionalBodyFields": {
      "rule": "A request body MUST NOT carry a key for an optional field the caller did not set.",
      "rationale": "The reference documents server-side defaults that apply to absent keys (testConnection.secure defaults to true, testConnection.timeout defaults to 10). Sending null, \"\", [] or {} in place of an unset optional field is a distinct value, not an absence, and suppresses those defaults.",
      "forbiddenPlaceholders": [null, "", [], {}]
    },
    "omitUnsetOptionalQueryParameters": {
      "rule": "An optional query parameter that the caller did not set MUST NOT appear in the query string, not even as an empty value (e.g. `sortAsc=`).",
      "appliesTo": ["filter", "sortAsc", "sortDesc"]
    },
    "alwaysSendDocumentedRequiredQueryParameters": {
      "rule": "page and pageSize are documented as required and MUST be sent on every paged query, including when their value equals the documented default."
    },
    "noServerOwnedFieldsOnWrite": {
      "rule": "Server-owned response-only fields MUST NOT be echoed back on a create or update request.",
      "appliesTo": {
        "NamedCredential": ["id", "org", "behavior"],
        "VCenterServer": ["isConnected", "listenerState", "clusterHealthStatus", "vcVersion", "buildNumber", "uuid", "licenseStatus"]
      }
    }
  },


index 0000000..d4fc989
--- /dev/null
+++ b/src/vcf_installer/client.py
@@ -0,0 +1,101 @@
+"""Standard-library client for the focused VCF Installer deployment contract."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+import json
+import time
+from typing import Any
+from urllib.parse import quote, urlencode
+from urllib.request import Request, urlopen
+
+
+_IN_PROGRESS = "IN_PROGRESS"
+_TERMINAL_STATUSES = {
+    "COMPLETED_WITH_SUCCESS",
+    "ROLLBACK_SUCCESS",
+    "COMPLETED_WITH_FAILURE",
+}
+_CONTRACT_STATUSES = {_IN_PROGRESS, *_TERMINAL_STATUSES}
+
+
+class VCFInstallerClient:
+    """Call and poll the VCF Installer SDDC deployment operations."""
+
+    def __init__(self, base_url: str, timeout: float | None = None):
+        self.base_url = base_url.rstrip("/")
+        self.timeout = timeout
+
+    def deploy_sddc_and_wait(
+        self,
+        sddc_spec: Mapping[str, Any],
+        *,
+        skip_validations: bool | None = None,
+        poll_interval: float = 1.0,
+    ) -> dict[str, Any]:
+        """Start an SDDC deployment and poll until its task is terminal."""
+
+        query = None
+        if skip_validations is not None:
+            query = {"skipValidations": "true" if skip_validations else "false"}
+
+        task = self._request_json(
+            "POST",
+            "/v1/sddcs",
+            expected_status=202,
+            query=query,
+            body=dict(sddc_spec),
+        )
+        self._check_status(task)
+        task_id = str(task["id"])
+
+        while True:
+            if task["status"] == _IN_PROGRESS and poll_interval:
+                time.sleep(poll_interval)
+            task = self._request_json(
+                "GET",
+                f"/v1/sddcs/{quote(task_id, safe='')}",
+                expected_status=200,
+            )
+            self._check_status(task)
+            if task["status"] != _IN_PROGRESS:
+                return task
+
+    @staticmethod
+    def _check_status(task: Mapping[str, Any]) -> None:
+        status = task.get("status")
+        if status not in _CONTRACT_STATUSES:
+            raise ValueError(f"unexpected SddcTask status: {status!r}")
+
+    def _request_json(
+        self,
+        method: str,
+        path: str,
+        *,
+        expected_status: int,
+        query: Mapping[str, str] | None = None,
+        body: Mapping[str, Any] | None = None,
+    ) -> dict[str, Any]:
+        url = self.base_url + path
+        if query:
+            url += "?" + urlencode(query)
+
+        headers = {"Accept": "application/json"}
+        data = None
+        if body is not None:
+            data = json.dumps(
+                body, separators=(",", ":"), ensure_ascii=False
+            ).encode("utf-8")
+            headers["Content-Type"] = "application/json"
+
+        request = Request(url, data=data, headers=headers, method=method)
+        with urlopen(request, timeout=self.timeout) as response:
+            if response.status != expected_status:
+                raise RuntimeError(
+                    f"unexpected HTTP status for {method} {path}: {response.status}"
+                )
+            payload = json.loads(response.read().decode("utf-8"))
+
+        if not isinstance(payload, dict):
+            raise ValueError(f"expected a JSON object from {method} {path}")
+        return payload

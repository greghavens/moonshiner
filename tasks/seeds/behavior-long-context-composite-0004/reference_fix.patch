+++ b/reference_driver.py
@@ -0,0 +1,89 @@
+#!/usr/bin/env python3
+"""Reference proof using the genuine message registry executable."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import shutil
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "messagectl"
+RUNTIME = ROOT / ".message-registry"
+DELIVERABLE = ROOT / "message-record.json"
+OUTPUT_FIELDS = ("id", "name", "location", "status", "date")
+
+
+def execute(arguments: list[str]) -> dict[str, Any]:
+    completed = subprocess.run(
+        [str(CLIENT), *arguments],
+        cwd=ROOT,
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        check=False,
+        timeout=15,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(
+            completed.stderr.decode("utf-8", errors="replace").strip()
+            or "message registry operation failed"
+        )
+    if completed.stderr:
+        raise RuntimeError("message registry wrote unexpected stderr")
+    try:
+        result = json.loads(completed.stdout)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("message registry returned invalid JSON") from error
+    if not isinstance(result, dict):
+        raise RuntimeError("message registry returned a non-object")
+    return result
+
+
+def main() -> int:
+    shutil.rmtree(RUNTIME, ignore_errors=True)
+
+    search = execute(
+        [
+            "search",
+            "--name",
+            "Membership Renewal Reminder",
+            "--location",
+            "Volunteers",
+        ]
+    )
+    matches = search.get("matches")
+    if not isinstance(matches, list) or len(matches) != 1:
+        raise RuntimeError("reference search did not resolve exactly once")
+    match = matches[0]
+    if not isinstance(match, dict):
+        raise RuntimeError("reference search returned an invalid summary")
+    stable_id = match.get("id")
+    if not isinstance(stable_id, str) or not stable_id:
+        raise RuntimeError("reference search returned no stable ID")
+
+    detail = execute(["get", "--id", stable_id])
+    record = detail.get("record")
+    if not isinstance(record, dict):
+        raise RuntimeError("reference retrieval returned no complete record")
+    if record.get("id") != stable_id:
+        raise RuntimeError("reference retrieval returned a different stable ID")
+    if (
+        record.get("name") != "Membership Renewal Reminder"
+        or record.get("location") != "Volunteers"
+    ):
+        raise RuntimeError("reference retrieval returned the wrong message")
+
+    output = {field: record[field] for field in OUTPUT_FIELDS}
+    DELIVERABLE.write_text(
+        json.dumps(output, ensure_ascii=False, indent=2) + "\n",
+        encoding="utf-8",
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF brownfield migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["estateId", "sourceVcfVersion", "targetVcfVersion", "upgradePath", "targetTopology", "steps"],
  "properties": {
    "estateId": {"type": "string", "minLength": 1},
    "sourceVcfVersion": {"type": "string", "minLength": 1},
    "targetVcfVersion": {"type": "string", "minLength": 1},
    "upgradePath": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "targetTopology": {"$ref": "#/$defs/targetTopology"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "targetTopology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["managementDomainId", "clusterId", "stretched", "dataSites", "witness"],
      "properties": {
        "managementDomainId": {"type": "string", "minLength": 1},
        "clusterId": {"type": "string", "minLength": 1},
        "stretched": {"type": "boolean"},
        "dataSites": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "witness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["componentId", "siteId", "failureDomain"],
          "properties": {
            "componentId": {"type": "string", "minLength": 1},
            "siteId": {"type": "string", "minLength": 1},
            "failureDomain": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "phase", "componentId", "componentType", "fromVersion", "toVersion", "fromSite", "toSite", "gates"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "phase": {"type": "integer", "minimum": 1},
        "componentId": {"type": "string", "minLength": 1},
        "componentType": {"type": "string", "minLength": 1},
        "fromVersion": {"type": "string", "minLength": 1},
        "toVersion": {"type": "string", "minLength": 1},
        "fromSite": {"type": "string", "minLength": 1},
        "toSite": {"type": "string", "minLength": 1},
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

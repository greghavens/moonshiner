diff --git a/files/solution.go b/files/solution.go
new file mode 100644
index 0000000..caa1ddd
--- /dev/null
+++ b/files/solution.go
@@ -0,0 +1,148 @@
+package vcfarch
+
+import (
+	"fmt"
+	"sort"
+)
+
+// Build creates the deterministic target SddcSpec and ordered brownfield plan
+// from the supplied inventory and pinned compatibility authority.
+func Build(inventory Inventory, snapshot CompatibilitySnapshot) (Architecture, error) {
+	if inventory.EstateID == "" || inventory.VCFVersion == "" {
+		return Architecture{}, fmt.Errorf("inventory estate and VCF version are required")
+	}
+	if inventory.VCFVersion != snapshot.SourceVCF {
+		return Architecture{}, fmt.Errorf("inventory VCF version %q does not match snapshot source %q", inventory.VCFVersion, snapshot.SourceVCF)
+	}
+	if len(inventory.ManagementDomain.DataSites) != 2 || !inventory.ManagementDomain.Stretched {
+		return Architecture{}, fmt.Errorf("inventory must contain a two-site stretched management domain")
+	}
+
+	witnessFailureDomain := ""
+	for _, site := range inventory.Sites {
+		if site.ID == inventory.IndependentWitness {
+			if site.Role != "witness" {
+				return Architecture{}, fmt.Errorf("independent witness location %q does not have witness role", site.ID)
+			}
+			witnessFailureDomain = site.FailureDomain
+		}
+	}
+	if witnessFailureDomain == "" {
+		return Architecture{}, fmt.Errorf("independent witness location is missing")
+	}
+	for _, dataSite := range inventory.ManagementDomain.DataSites {
+		if dataSite == inventory.IndependentWitness {
+			return Architecture{}, fmt.Errorf("witness location must be outside both data sites")
+		}
+	}
+
+	plan, err := buildPlan(inventory, snapshot, witnessFailureDomain)
+	if err != nil {
+		return Architecture{}, err
+	}
+	return Architecture{
+		SddcID:       inventory.EstateID,
+		WorkflowType: "VCF",
+		Version:      snapshot.TargetVCF,
+		VCenterSpec: SddcVCenterSpec{
+			VCenterHostname:       inventory.VCenter.Hostname,
+			RootVCenterPassword:   "REDACTED!234567",
+			Version:               snapshot.TargetVCF,
+			UseExistingDeployment: true,
+			SSLThumbprint:         inventory.VCenter.SSLThumbprint,
+		},
+		ClusterSpec: SddcClusterSpec{
+			ClusterName: inventory.ManagementDomain.ClusterID,
+		},
+		NetworkSpecs:  append([]Network(nil), inventory.Networks...),
+		DNSSpec:       inventory.DNS,
+		NTPServers:    append([]string(nil), inventory.NTPServers...),
+		DatastoreSpec: SddcDatastoreSpec{ExistingDatastoreName: inventory.ManagementDomain.DatastoreName},
+		MigrationPlan: plan,
+	}, nil
+}
+
+func buildPlan(inventory Inventory, snapshot CompatibilitySnapshot, witnessFailureDomain string) (MigrationPlan, error) {
+	path := []string{snapshot.SourceVCF}
+	currentVCF := snapshot.SourceVCF
+	versions := make(map[string]string, len(inventory.Components))
+	sites := make(map[string]string, len(inventory.Components))
+	for _, component := range inventory.Components {
+		if _, duplicate := versions[component.ID]; duplicate {
+			return MigrationPlan{}, fmt.Errorf("duplicate component ID %q", component.ID)
+		}
+		versions[component.ID] = component.Version
+		sites[component.ID] = component.Site
+	}
+
+	steps := make([]PlanStep, 0, len(snapshot.UpgradeEdges)*len(inventory.Components))
+	for phaseIndex, edge := range snapshot.UpgradeEdges {
+		if edge.FromVCF != currentVCF {
+			return MigrationPlan{}, fmt.Errorf("unsupported or disconnected upgrade edge %q to %q", edge.FromVCF, edge.ToVCF)
+		}
+		rules := make(map[string]SequenceRule, len(edge.Sequence))
+		for _, rule := range edge.Sequence {
+			rules[rule.ComponentType] = rule
+		}
+		ordered := append([]Component(nil), inventory.Components...)
+		sort.SliceStable(ordered, func(i, j int) bool {
+			left, leftOK := rules[ordered[i].Type]
+			right, rightOK := rules[ordered[j].Type]
+			if !leftOK || !rightOK || left.Rank == right.Rank {
+				return ordered[i].ID < ordered[j].ID
+			}
+			return left.Rank < right.Rank
+		})
+		for _, component := range ordered {
+			rule, exists := rules[component.Type]
+			if !exists {
+				return MigrationPlan{}, fmt.Errorf("no sequence rule for component type %q", component.Type)
+			}
+			target, exists := edge.ComponentTargets[component.Type]
+			if !exists {
+				return MigrationPlan{}, fmt.Errorf("no target for component type %q", component.Type)
+			}
+			toSite := sites[component.ID]
+			if component.ID == inventory.ManagementDomain.WitnessComponentID {
+				toSite = inventory.IndependentWitness
+			}
+			steps = append(steps, PlanStep{
+				Order:         len(steps) + 1,
+				Phase:         phaseIndex + 1,
+				ComponentID:   component.ID,
+				ComponentType: component.Type,
+				FromVersion:   versions[component.ID],
+				ToVersion:     target,
+				FromSite:      sites[component.ID],
+				ToSite:        toSite,
+				Gates:         append([]string(nil), rule.Gates...),
+			})
+			versions[component.ID] = target
+			sites[component.ID] = toSite
+		}
+		currentVCF = edge.ToVCF
+		path = append(path, currentVCF)
+	}
+	if currentVCF != snapshot.TargetVCF {
+		return MigrationPlan{}, fmt.Errorf("upgrade path ends at %q instead of %q", currentVCF, snapshot.TargetVCF)
+	}
+
+	return MigrationPlan{
+		EstateID:         inventory.EstateID,
+		SourceVCFVersion: inventory.VCFVersion,
+		TargetVCFVersion: snapshot.TargetVCF,
+		UpgradePath:      path,
+		TargetTopology: TargetTopology{
+			ManagementDomainID: inventory.ManagementDomain.ID,
+			ClusterID:          inventory.ManagementDomain.ClusterID,
+			Stretched:          true,
+			DataSites:          append([]string(nil), inventory.ManagementDomain.DataSites...),
+			Witness: TargetWitness{
+				ComponentID:   inventory.ManagementDomain.WitnessComponentID,
+				SiteID:        inventory.IndependentWitness,
+				FailureDomain: witnessFailureDomain,
+			},
+		},
+		Steps: steps,
+	}, nil
+}

+        minimum=0,
+        maximum=999999,
+    )
+    rule_sequence = _integer(
+        "plan.policy.rule_sequence_number",
+        policy["rule_sequence_number"],
+        minimum=0,
+        maximum=2**31 - 1,
+    )
+    policy_description = _optional_nonblank(
+        policy,
+        "description",
+        max_length=1024,
+    )
+    rule_notes = _optional_nonblank(

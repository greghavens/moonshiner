+    return group_body, policy_body
+
+
+def _compact_json(value: Mapping[str, Any]) -> bytes:
+    return json.dumps(
+        value,
+        ensure_ascii=False,
+        separators=(",", ":"),
+    ).encode("utf-8")
+
+
+def _decode_error(body: bytes) -> object:
+    if not body:
+        return None
+    try:
+        return json.loads(body.decode("utf-8"))
+    except (UnicodeDecodeError, json.JSONDecodeError):
+        return None
+
+
+def _request(
+    opener: Any,
+    *,
+    origin: str,
+    operation_id: str,
+    path: str,
+    body: bytes,
+    authorization: str,
+    timeout: float,
+) -> None:
+    headers = dict(_JSON_HEADERS)
+    headers["Authorization"] = authorization
+    request = Request(
+        origin + _BASE_PATH + path,
+        data=body,
+        headers=headers,
+        method="PATCH",
+    )
+    try:
+        with opener.open(request, timeout=timeout) as response:
+            status = response.status
+            response.read()
+    except HTTPError as error:
+        try:
+            error_body = error.read()
+        except OSError:
+            error_body = b""
+        raise _HttpFailure(
+            operation_id,
+            error.code,
+            _decode_error(error_body),
+        ) from None
+    except (URLError, OSError):
+        raise RuntimeError(f"{operation_id} transport failed") from None
+    if status != 200:
+        raise _HttpFailure(operation_id, status, None)
+
+
+def _failed_step(
+    name: str,
+    operation_id: str,
+    failure: _HttpFailure,
+) -> dict[str, Any]:
+    step: dict[str, Any] = {
+        "name": name,
+        "operationId": operation_id,
+        "status": "failed",
+        "http_status": failure.status,
+    }
+    if isinstance(failure.envelope, dict):
+        error_code = failure.envelope.get("error_code")
+        if isinstance(error_code, int) and not isinstance(error_code, bool):
+            step["error_code"] = error_code
+    return step
+
+
+def _make_report(steps: list[dict[str, Any]]) -> dict[str, Any]:
+    succeeded = sum(step["status"] == "succeeded" for step in steps)
+    failed = sum(step["status"] == "failed" for step in steps)
+    if failed == 0:
+        status = "succeeded"
+    elif succeeded:
+        status = "partial_failure"
+    else:
+        status = "failed"
+    return {
+        "status": status,
+        "succeeded": succeeded,
+        "failed": failed,
+        "steps": steps,
+    }
+
+
+def _write_report(destination: Path, report: Mapping[str, Any]) -> None:
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    encoded = _compact_json(report) + b"\n"
+    descriptor, temporary_name = tempfile.mkstemp(
+        prefix=f".{destination.name}.",
+        suffix=".tmp",
+        dir=destination.parent,
+    )
+    try:
+        with os.fdopen(descriptor, "wb") as temporary:
+            temporary.write(encoded)
+            temporary.flush()
+            os.fsync(temporary.fileno())
+        os.replace(temporary_name, destination)
+    except BaseException:
+        try:
+            os.unlink(temporary_name)
+        except FileNotFoundError:
+            pass
+        raise
 
 

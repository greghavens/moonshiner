{
  "$comment": "Wire contract for the VCF Operations 9.0 REST operations used by this task. Mechanically derived from the OpenAPI document identified in docs/official_sources.json; the pagination and client sections below record how this task uses those operations.",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "commitSha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "specPath": "specifications/vcf-operations/vcf-operations-openapi.json",
    "specSha256": "e5c7bac42fcde67011f8f880144b1a5c690e737380f5275e694be29bb545dd0e",
    "openapi": "3.0.1",
    "title": "VMware Cloud Foundation Operations API"
  },
  "basePath": "/suite-api",
  "security": {
    "scheme": "Token-based-authorization",
    "type": "apiKey",
    "in": "header",
    "header": "Authorization",
    "valuePrefix": "OpsToken ",
    "$comment": "The spec declares the apiKey header name only; VCF Operations 9.0 expects the acquireToken token prefixed with 'OpsToken '."
  },
  "operations": {
    "acquireToken": {
      "operationId": "acquireToken",
      "method": "POST",
      "path": "/api/auth/token/acquire",
      "url": "/suite-api/api/auth/token/acquire",
      "summary": "Acquire a token to perform REST API calls",
      "secured": false,
      "parameters": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "username-password"
      },
      "responses": {
        "200": {
          "description": "The token and expiry time of the token",
          "schema": "auth-token"
        },
        "401": {
          "description": "Authentication failed"
        }
      }
    },
    "getCurrentVersionOfServer": {
      "operationId": "getCurrentVersionOfServer",
      "method": "GET",
      "path": "/api/versions/current",
      "url": "/suite-api/api/versions/current",
      "summary": "Get the current version of the service",
      "secured": true,
      "parameters": [],
      "responses": {
        "200": {
          "description": "The current version of the Server",
          "schema": "version"
        }
      }
    },
    "getAlerts": {
      "operationId": "getAlerts",
      "method": "GET",
      "path": "/api/alerts",
      "url": "/suite-api/api/alerts",
      "summary": "Look up Alerts by their identifiers or using the identifiers of the Resources they are associated with",
      "secured": true,
      "parameters": [
        {
          "name": "id",
          "in": "query",
          "required": false,
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "style": "form",
          "explode": true
        },
        {
          "name": "resourceId",
          "in": "query",
          "required": false,
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "style": "form",
          "explode": true
        },
        {
          "name": "page",
          "in": "query",
          "required": false,
          "type": "integer",
          "format": "int32",
          "default": 0
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "type": "integer",
          "format": "int32",
          "default": 1000
        }
      ],
      "responses": {
        "200": {
          "description": "Alerts matching the specified identifiers. Can be empty",
          "schema": "alerts"
        },
        "500": {
          "description": "Error occurred while retrieving the Alert with the specified identifier"
        }
      }
    },
    "releaseToken": {
      "operationId": "releaseToken",
      "method": "POST",
      "path": "/api/auth/token/release",
      "url": "/suite-api/api/auth/token/release",
      "summary": "Terminate the current sessionId",
      "secured": true,
      "parameters": [],
      "responses": {
        "200": {
          "description": "The sessionId is terminated successfully"
        }
      }
    }
  },
  "schemas": {
    "alert": {
      "required": [],
      "properties": {
        "alertId": {
          "type": "string",
          "format": "uuid"
        },
        "resourceId": {
          "type": "string",
          "format": "uuid"
        },
        "alertLevel": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "NONE",
            "INFORMATION",
            "WARNING",
            "IMMEDIATE",
            "CRITICAL",
            "AUTO"
          ]
        },
        "type": {
          "type": "string"
        },
        "subType": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "NEW",
            "ACTIVE",
            "UPDATED",
            "CANCELED"
          ]
        },
        "startTimeUTC": {
          "type": "integer",
          "format": "int64"
        },
        "cancelTimeUTC": {
          "type": "integer",
          "format": "int64"
        },
        "updateTimeUTC": {
          "type": "integer",
          "format": "int64"
        },
        "suspendUntilTimeUTC": {
          "type": "integer",
          "format": "int64"
        },
        "controlState": {
          "type": "string",
          "enum": [
            "OPEN",
            "ASSIGNED",
            "SUSPENDED",
            "SUPPRESSED"
          ]
        },
        "statKey": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "ownerName": {
          "type": "string"
        },
        "alertDefinitionId": {
          "type": "string"
        },
        "alertDefinitionName": {
          "type": "string"
        },
        "alertImpact": {
          "type": "string"
        },
        "extension": {
          "type": "object",
          "schema": "extension"
        },
        "links": {
          "type": "array",
          "items": {
            "schema": "link"
          }
        }
      }
    },
    "alerts": {
      "required": [],
      "properties": {
        "pageInfo": {
          "type": "object",
          "schema": "page-info"
        },
        "links": {
          "type": "array",
          "items": {
            "schema": "link"
          }
        },
        "alerts": {
          "type": "array",
          "items": {
            "schema": "alert"
          }
        }
      }
    },
    "auth-token": {
      "required": [
        "token",
        "validity"
      ],
      "properties": {
        "token": {
          "type": "string"
        },
        "validity": {
          "type": "integer",
          "format": "int64"
        },
        "expiresAt": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "link": {
      "required": [
        "href"
      ],
      "properties": {
        "href": {
          "type": "string"
        },
        "rel": {
          "type": "string",
          "enum": [
            "NEXT",
            "PREVIOUS",
            "START",
            "END",
            "RELATED",
            "SELF"
          ]
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "page-info": {
      "required": [],
      "properties": {
        "totalCount": {
          "type": "integer",
          "format": "int32"
        },
        "page": {
          "type": "integer",
          "format": "int32"
        },
        "pageSize": {
          "type": "integer",
          "format": "int32"
        },
        "sortBy": {
          "type": "string"
        },
        "sortOrder": {
          "type": "string"
        }
      }
    },
    "username-password": {
      "required": [
        "password",
        "username"
      ],
      "properties": {
        "username": {
          "type": "string"
        },
        "authSource": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "version": {
      "required": [
        "humanlyReadableReleaseDate",
        "major",
        "minor",
        "minorMinor",
        "releaseName",
        "releasedDate"
      ],
      "properties": {
        "releaseName": {
          "type": "string"
        },
        "major": {
          "type": "integer",
          "format": "int32"
        },
        "minor": {
          "type": "integer",
          "format": "int32"
        },
        "minorMinor": {
          "type": "integer",
          "format": "int32"
        },
        "buildNumber": {
          "type": "integer",
          "format": "int32"
        },
        "releasedDate": {
          "type": "integer",
          "format": "int64"
        },
        "humanlyReadableReleaseDate": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    }
  },
  "pagination": {
    "$comment": "How this task pages the getAlerts collection. The parameter names, their 0-based origin and their defaults come from the specification; the termination rule records the appliance behaviour the fixture reproduces.",
    "operationId": "getAlerts",
    "pageParameter": "page",
    "pageOrigin": 0,
    "pageSizeParameter": "pageSize",
    "responseCollection": "alerts",
    "responsePageInfo": "pageInfo",
    "totalCountMember": "pageInfo.totalCount",
    "terminationRule": "A page is the last page when the records already retrieved reach pageInfo.totalCount, or when the returned alerts array is empty. The links array is NOT a termination signal: a link with rel NEXT is present on every page, the last one included, so following NEXT until it disappears never terminates.",
    "collectionOrder": "The collection has no guaranteed order. Records may be returned in any order within a page and across pages, so any stable output order must be imposed by the client.",
    "arrayParameterStyle": "The id and resourceId query parameters are arrays serialised form/explode, i.e. the key is repeated once per value (resourceId=a&resourceId=b), never comma joined.",
    "optionalParameters": "id and resourceId are optional. An optional query parameter that the caller did not set is absent from the query string; it is never sent with an empty value."
  },
  "client": {
    "$comment": "Transport requirements. VMware.Sdk.Vcf.Ops is the supported client for these operations and is installed by the environment; it is not vendored here.",
    "module": "VMware.Sdk.Vcf.Ops",
    "minimumVersion": "13.5.0.25380678",
    "userAgentPrefix": "VMware.Sdk.Vcf.Ops/",
    "userAgentNote": "Requests issued by the SDK operation cmdlets carry a User-Agent beginning with 'VMware.Sdk.Vcf.Ops/'. Connect-VcfOpsServer's own acquireToken handshake carries the User-Agent 'PowerCLI'. A request bearing any other User-Agent did not come from the SDK.",
    "sessionLifecycle": "acquireToken opens the session, getCurrentVersionOfServer is the handshake Connect-VcfOpsServer performs, getAlerts reads the collection, releaseToken closes the session."
  }
}

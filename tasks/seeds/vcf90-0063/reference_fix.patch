--- a/src/VcfOpsAlertInventory/VcfOpsAlertInventory.psm1
+++ b/src/VcfOpsAlertInventory/VcfOpsAlertInventory.psm1
@@ -2,6 +2,19 @@
 
 Set-StrictMode -Version Latest
 
+# Ordering key for the emitted inventory: startTimeUTC ascending, then alertId ascending
+# compared ordinally. The collection itself is served in no particular order, so the order
+# has to be imposed here.
+$script:AlertComparison = [System.Comparison[object]] {
+    param($Left, $Right)
+
+    $leftStart  = [long] $Left.StartTimeUTC
+    $rightStart = [long] $Right.StartTimeUTC
+    if ($leftStart -lt $rightStart) { return -1 }
+    if ($leftStart -gt $rightStart) { return 1 }
+    return [string]::CompareOrdinal([string] $Left.AlertId, [string] $Right.AlertId)
+}
+
 <#
 .SYNOPSIS
     Retrieves the complete VCF Operations alert collection in a stable order.
@@ -67,8 +80,108 @@
         [switch] $SkipCertificateCheck
     )
 
-    throw [System.NotImplementedException]::new(
-        'Get-VcfOpsAlertInventory is not implemented yet.')
+    # A page the appliance refuses must abort the inventory rather than truncate it, so the
+    # SDK's non-terminating errors are promoted for the duration of this call.
+    $ErrorActionPreference = 'Stop'
+
+    $resourceFilter = ConvertTo-VcfOpsGuidList -Value $ResourceId
+
+    $connectArgs = @{
+        Server     = $Server
+        Protocol   = $Protocol
+        Credential = $Credential
+        NotDefault = $true
+    }
+    if ($PSBoundParameters.ContainsKey('Port')) { $connectArgs['Port'] = $Port }
+    # authSource is optional in the username-password body, so it is passed only when the
+    # caller named a source.
+    if ($PSBoundParameters.ContainsKey('AuthSource')) { $connectArgs['AuthSource'] = $AuthSource }
+    if ($SkipCertificateCheck) { $connectArgs['IgnoreInvalidCertificate'] = $true }
+
+    $session = Connect-VcfOpsServer @connectArgs
+    try {
+        $collected = Read-VcfOpsAlertPages -Session $session -PageSize $PageSize `
+            -ResourceFilter $resourceFilter
+        $collected.Sort($script:AlertComparison)
+
+        foreach ($alert in $collected) {
+            [pscustomobject][ordered] @{
+                AlertId             = [string] $alert.AlertId
+                ResourceId          = [string] $alert.ResourceId
+                AlertLevel          = [string] $alert.AlertLevel
+                Status              = [string] $alert.Status
+                StartTimeUTC        = [long]   $alert.StartTimeUTC
+                UpdateTimeUTC       = [long]   $alert.UpdateTimeUTC
+                AlertDefinitionName = [string] $alert.AlertDefinitionName
+            }
+        }
+    }
+    finally {
+        # Disconnect-VcfOpsServer issues releaseToken, so the session is closed whether the
+        # walk completed or a page failed part way through.
+        Disconnect-VcfOpsServer -Server $session -Force -ErrorAction SilentlyContinue
+    }
+}
+
+# Builds the List[guid] the SDK's array query parameters take. Returns $null when the caller
+# supplied no identifiers, which keeps the optional parameter out of the query string.
+function ConvertTo-VcfOpsGuidList {
+    param([string[]] $Value)
+
+    if ($null -eq $Value -or $Value.Count -eq 0) { return $null }
+
+    $list = [System.Collections.Generic.List[guid]]::new()
+    foreach ($item in $Value) {
+        $parsed = [guid]::Empty
+        if (-not [guid]::TryParse($item, [ref] $parsed)) {
+            throw [System.ArgumentException]::new(
+                "'$item' is not a valid resource identifier.", 'ResourceId')
+        }
+        $list.Add($parsed)
+    }
+    return $list
+}
+
+# Walks getAlerts from page 0 until the collection is exhausted. pageInfo.totalCount decides
+# when to stop; an empty page is the fallback. The NEXT link is deliberately ignored because
+# the appliance advertises one on every page, the last one included.
+function Read-VcfOpsAlertPages {
+    param(
+        [Parameter(Mandatory)] $Session,
+        [Parameter(Mandatory)] [int] $PageSize,
+        $ResourceFilter
+    )
+
+    $collected = [System.Collections.Generic.List[object]]::new()
+    $totalCount = $null
+    $page = 0
+
+    while ($true) {
+        $pageArgs = @{
+            Server   = $Session
+            Page     = $page
+            PageSize = $PageSize
+        }
+        if ($null -ne $ResourceFilter) { $pageArgs['ResourceId'] = $ResourceFilter }
+
+        $response = Invoke-VcfOpsGetAlerts @pageArgs
+
+        if ($null -ne $response.PageInfo -and $null -ne $response.PageInfo.TotalCount) {
+            $totalCount = [int] $response.PageInfo.TotalCount
+        }
+
+        # The generated model exposes the alerts array as _Alerts; the name Alerts is taken
+        # by the enclosing type.
+        $batch = $response._Alerts
+        if ($null -eq $batch -or $batch.Count -eq 0) { break }
+
+        $collected.AddRange([object[]] $batch)
+
+        if ($null -ne $totalCount -and $collected.Count -ge $totalCount) { break }
+        $page++
+    }
+
+    return , $collected
 }
 
 Export-ModuleMember -Function 'Get-VcfOpsAlertInventory'

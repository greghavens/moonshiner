diff --git a/.reference_solution.py b/.reference_solution.py
new file mode 100755
--- /dev/null
+++ b/.reference_solution.py
@@ -0,0 +1,129 @@
+#!/usr/bin/env python3
+"""Produce the reference deliverable through genuine telecom executions."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "telecom-availability"
+DELIVERABLE = ROOT / "availability-report.txt"
+TARGETS = (
+    {
+        "plan": "Fiber plan",
+        "segment": "Family",
+        "date": "2026-09-13",
+    },
+    {
+        "plan": "Tablet plan",
+        "segment": "Studio",
+        "date": "2026-09-13",
+    },
+)
+
+
+def command_for(target: dict[str, str]) -> list[str]:
+    return [
+        str(CLIENT),
+        "check",
+        "--plan",
+        target["plan"],
+        "--segment",
+        target["segment"],
+        "--date",
+        target["date"],
+    ]
+
+
+def decode(
+    returncode: int, stdout: str, stderr: str, label: str
+) -> dict[str, Any]:
+    response_text = stdout if returncode == 0 else stderr
+    try:
+        response: Any = json.loads(response_text)
+    except json.JSONDecodeError as error:
+        raise RuntimeError(f"{label} returned invalid JSON") from error
+    if not isinstance(response, dict):
+        raise RuntimeError(f"{label} returned a non-object response")
+    return {"returncode": returncode, "response": response}
+
+
+def collect(process: subprocess.Popen[str], label: str) -> dict[str, Any]:
+    stdout, stderr = process.communicate(timeout=5)
+    return decode(process.returncode, stdout, stderr, label)
+
+
+def run_one(target: dict[str, str]) -> dict[str, Any]:
+    completed = subprocess.run(
+        command_for(target),
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=5,
+    )
+    return decode(
+        completed.returncode, completed.stdout, completed.stderr, "telecom retry"
+    )
+
+
+def sentence(result: dict[str, Any], retried: bool) -> str:
+    availability = "available" if result["available"] else "unavailable"
+    retry_marker = " (retried once)" if retried else ""
+    return (
+        f"{result['plan']} at {result['segment']} is {availability} "
+        f"on {result['date']}{retry_marker}."
+    )
+
+
+def main() -> int:
+    discovery = subprocess.run(
+        [str(CLIENT), "--help"],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=5,
+    )
+    if discovery.returncode != 0:
+        raise RuntimeError("interface discovery failed")
+
+    processes = [
+        subprocess.Popen(
+            command_for(target),
+            cwd=ROOT,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for target in TARGETS
+    ]
+    initial = [
+        collect(process, f"initial telecom branch {index + 1}")
+        for index, process in enumerate(processes)
+    ]
+
+    if initial[0]["returncode"] != 0:
+        raise RuntimeError("reference independent branch did not succeed")
+    if initial[1]["returncode"] != 75:
+        raise RuntimeError("reference retry branch did not temporarily fail")
+    failure = initial[1]["response"]
+    if failure.get("retryable") is not True:
+        raise RuntimeError("reference failure was not explicitly retryable")
+
+    retried = run_one(TARGETS[1])
+    if retried["returncode"] != 0:
+        raise RuntimeError("reference retry did not succeed")
+
+    results = [initial[0]["response"], retried["response"]]
+    lines = [sentence(results[0], False), sentence(results[1], True)]
+    DELIVERABLE.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/availability-report.txt b/availability-report.txt
new file mode 100644
--- /dev/null
+++ b/availability-report.txt
@@ -0,0 +1,2 @@
+Fiber plan at Family is available on 2026-09-13.
+Tablet plan at Studio is unavailable on 2026-09-13 (retried once).

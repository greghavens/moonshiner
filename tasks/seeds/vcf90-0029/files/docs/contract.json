{
  "contractVersion": 1,
  "source": {
    "sourceKind": "openapi-specification",
    "note": "Projected directly from the OpenAPI document in VMware's Apache-2.0 vcf-api-specs repository. It is not transcribed from a rendered documentation page, and it is not the 9.1 revision of the same file.",
    "repository": "https://github.com/vmware/vcf-api-specs",

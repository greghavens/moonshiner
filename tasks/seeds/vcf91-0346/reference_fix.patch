+    /** A small JSON parser keeps the single source file dependency-free. */
+    private static final class JsonParser {
+        private final String source;
+        private int index;
+
+        JsonParser(String source) {
+            this.source = source;
+        }
+
+        Object parse() {
+            skipWhitespace();
+            Object value = parseValue();
+            skipWhitespace();
+            if (index != source.length()) {
+                error("unexpected trailing data");
+            }
+            return value;
+        }
+
+        private Object parseValue() {
+            if (index >= source.length()) {
+                return error("expected a value");
+            }
+            return switch (source.charAt(index)) {
+                case '{' -> parseObject();
+                case '[' -> parseArray();
+                case '"' -> parseString();
+                case 't' -> parseLiteral("true", Boolean.TRUE);
+                case 'f' -> parseLiteral("false", Boolean.FALSE);
+                case 'n' -> parseLiteral("null", null);
+                default -> parseNumber();
+            };
+        }
+
+        private Map<String, Object> parseObject() {
+            expect('{');
+            skipWhitespace();
+            Map<String, Object> result = new LinkedHashMap<>();
+            if (take('}')) {
+                return result;
+            }
+            while (true) {
+                skipWhitespace();
+                if (index >= source.length() || source.charAt(index) != '"') {
+                    return error("expected an object key");
+                }
+                String key = parseString();
+                skipWhitespace();
+                expect(':');
+                skipWhitespace();
+                result.put(key, parseValue());
+                skipWhitespace();
+                if (take('}')) {
+                    return result;
+                }
+                expect(',');
+                skipWhitespace();
+            }
+        }
+
+        private List<Object> parseArray() {
+            expect('[');
+            skipWhitespace();
+            List<Object> result = new ArrayList<>();
+            if (take(']')) {
+                return result;
+            }
+            while (true) {
+                skipWhitespace();
+                result.add(parseValue());
+                skipWhitespace();
+                if (take(']')) {
+                    return result;
+                }
+                expect(',');
+                skipWhitespace();
+            }
+        }
+
+        private String parseString() {
+            expect('"');
+            StringBuilder result = new StringBuilder();
+            while (index < source.length()) {
+                char next = source.charAt(index++);
+                if (next == '"') {
+                    return result.toString();
+                }
+                if (next != '\\') {
+                    if (next < 0x20) {
+                        return error("unescaped control character in string");
+                    }
+                    result.append(next);
+                    continue;
+                }
+                if (index >= source.length()) {
+                    return error("unterminated escape sequence");
+                }
+                char escaped = source.charAt(index++);
+                switch (escaped) {
+                    case '"', '\\', '/' -> result.append(escaped);
+                    case 'b' -> result.append('\b');
+                    case 'f' -> result.append('\f');
+                    case 'n' -> result.append('\n');
+                    case 'r' -> result.append('\r');
+                    case 't' -> result.append('\t');
+                    case 'u' -> result.append(parseUnicodeEscape());
+                    default -> error("invalid escape sequence");
+                }
+            }
+            return error("unterminated string");
+        }
+
+        private char parseUnicodeEscape() {
+            if (index + 4 > source.length()) {
+                return error("incomplete unicode escape");
+            }
+            int value = 0;
+            for (int end = index + 4; index < end; index++) {
+                int digit = Character.digit(source.charAt(index), 16);
+                if (digit < 0) {
+                    return error("invalid unicode escape");
+                }
+                value = value * 16 + digit;
+            }
+            return (char) value;
+        }
+
+        private Object parseNumber() {
+            int start = index;
+            take('-');
+            if (take('0')) {
+                // A leading zero is the complete integer part.
+            } else {
+                requireDigit();
+                while (index < source.length() && Character.isDigit(source.charAt(index))) {
+                    index++;
+                }
+            }
+            boolean floatingPoint = false;
+            if (take('.')) {
+                floatingPoint = true;
+                requireDigit();
+                while (index < source.length() && Character.isDigit(source.charAt(index))) {
+                    index++;
+                }
+            }
+            if (index < source.length()
+                    && (source.charAt(index) == 'e' || source.charAt(index) == 'E')) {
+                floatingPoint = true;
+                index++;
+                if (index < source.length()
+                        && (source.charAt(index) == '+' || source.charAt(index) == '-')) {
+                    index++;
+                }
+                requireDigit();
+                while (index < source.length() && Character.isDigit(source.charAt(index))) {
+                    index++;
+                }
+            }
+            String token = source.substring(start, index);
+            try {
+                return floatingPoint ? Double.valueOf(token) : Long.valueOf(token);
+            } catch (NumberFormatException error) {
+                return error("invalid number");
+            }
+        }
+
+        private Object parseLiteral(String literal, Object value) {
+            if (!source.startsWith(literal, index)) {
+                return error("invalid literal");
+            }
+            index += literal.length();
+            return value;
+        }
+
+        private void requireDigit() {
+            if (index >= source.length() || !Character.isDigit(source.charAt(index))) {
+                error("expected a digit");
+            }
+        }
+
+        private void expect(char expected) {
+            if (!take(expected)) {
+                error("expected '" + expected + "'");
+            }
+        }
+
+        private boolean take(char expected) {
+            if (index < source.length() && source.charAt(index) == expected) {
+                index++;
+                return true;
+            }
+            return false;
+        }
+
+        private void skipWhitespace() {
+            while (index < source.length()) {
+                char next = source.charAt(index);
+                if (next != ' ' && next != '\n' && next != '\r' && next != '\t') {
+                    return;
+                }
+                index++;
+            }
+        }
+
+        private <T> T error(String message) {
+            throw new IllegalArgumentException(message + " at character " + index);
+        }
+    }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0039:migration-plan:1",
  "title": "VCF 9.1 existing-estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "estateId", "targetVcfVersion", "steps"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "targetVcfVersion": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "source", "target", "action", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "version"],
            "properties": {
              "component": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "version"],
            "properties": {
              "component": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          },
          "action": {
            "type": "string",
            "enum": ["deploy", "upgrade", "import-and-upgrade", "redeploy-and-transfer-data"]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}

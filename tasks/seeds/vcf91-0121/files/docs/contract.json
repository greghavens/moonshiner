{
  "contractFormat": "vcf-spec-subset-1",
  "openapi": "3.0.3",
  "title": "vSphere Automation API",
  "apiVersion": "9.1.0.0",
  "server": {
    "urlTemplate": "https://{host}/api",
    "basePath": "/api"
  },
  "operationIds": [
    "Vcenter.Tagging.Categories_list"
  ],
  "operations": [
    {
      "operationId": "Vcenter.Tagging.Categories_list",
      "method": "GET",
      "path": "/vcenter/tagging/categories",
      "security": {
        "scheme": "api_key_auth",
        "type": "apiKey",
        "in": "header",
        "name": "vmware-api-session-id"
      },
      "parameters": [
        {
          "name": "names",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "iterate",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "object",
            "properties": {
              "marker": {
                "type": "string",
                "nullableByOmission": true
              },
              "page_size": {
                "type": "integer",
                "format": "int64",
                "nullableByOmission": true
              }
            }
          },
          "wireProjection": {
            "marker": "marker",
            "page_size": "page_size",
            "unsetProperties": "omit"
          }
        }
      ],
      "responses": {
        "200": {
          "contentType": "application/json",
          "schema": {
            "type": "object",
            "required": [
              "items"
            ],
            "properties": {
              "marker": {
                "type": "string",
                "required": false,
                "meaningWhenOmittedOrNull": "all categories have been returned"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "category_id",
                    "info"
                  ],
                  "properties": {
                    "category_id": {
                      "type": "string"
                    },
                    "info": {
                      "type": "object",
                      "required": [
                        "associable_types",
                        "cardinality",
                        "description",
                        "name",
                        "used_by"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "cardinality": {
                          "type": "string",
                          "enum": [
                            "SINGLE",
                            "MULTIPLE"
                          ]
                        },
                        "associable_types": {
                          "type": "array",
                          "uniqueItems": true,
                          "items": {
                            "type": "string"
                          }
                        },
                        "used_by": {
                          "type": "array",
                          "uniqueItems": true,
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}

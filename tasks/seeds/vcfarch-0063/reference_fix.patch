+    private static Map<String, Object> buildMigrationPlan(Map<String, Object> inventory,
+                                                           Map<String, Object> snapshot) {
+        Map<String, Object> estate = object(inventory.get("estate"), "estate");
+        Map<String, Object> bundle = object(snapshot.get("targetBundle"), "targetBundle");
+        Map<String, Map<String, Object>> components = new LinkedHashMap<>();
+        for (Object rawComponent : array(estate.get("components"), "components")) {
+            Map<String, Object> component = object(rawComponent, "component");
+            components.put(text(component.get("id"), "component id"), component);
+        }
+
+        List<Map<String, Object>> transitions = new ArrayList<>();
+        for (Object rawTransition : array(snapshot.get("transitions"), "transitions")) {
+            transitions.add(object(rawTransition, "transition"));
+        }
+        transitions.sort(Comparator.comparingInt(item -> integer(item.get("order"), "order")));
+
+        List<Object> steps = list();
+        for (Map<String, Object> transition : transitions) {
+            String componentId = text(transition.get("componentId"), "componentId");
+            Map<String, Object> component = components.remove(componentId);
+            if (component == null) {
+                throw new IllegalArgumentException("transition has no inventory component: " + componentId);
+            }
+
+            steps.add(mapOf(
+                    "order", integer(transition.get("order"), "order"),
+                    "componentId", componentId,
+                    "componentName", text(component.get("name"), "component name"),
+                    "currentVersion", text(component.get("version"), "current version"),
+                    "currentBuild", integer(component.get("build"), "current build"),
+                    "targetVersion", text(transition.get("targetVersion"), "target version"),
+                    "targetBuild", transition.get("targetBuild"),
+                    "action", text(transition.get("disposition"), "disposition"),
+                    "gates", copyArray(array(transition.get("requiredGateIds"),
+                                             "requiredGateIds"))));
+        }
+        if (!components.isEmpty()) {
+            throw new IllegalArgumentException("inventory components lack transitions: "
+                                               + components.keySet());
+        }
+
+        return mapOf(
+                "sourceEstate", text(estate.get("siteCode"), "estate siteCode"),
+                "targetBundle", text(bundle.get("id"), "target bundle id"),
+                "strategy", "GREENFIELD_WITH_ORDERED_ESTATE_MIGRATION",
+                "steps", steps);
+    }

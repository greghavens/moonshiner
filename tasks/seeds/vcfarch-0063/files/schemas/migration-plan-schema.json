{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "migration-plan-schema.json",
  "title": "Ordered VCF estate migration plan",
  "type": "object",
  "required": [
    "sourceEstate",
    "targetBundle",
    "strategy",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "sourceEstate": {
      "type": "string",
      "minLength": 1
    },
    "targetBundle": {
      "type": "string",
      "minLength": 1
    },
    "strategy": {
      "const": "GREENFIELD_WITH_ORDERED_ESTATE_MIGRATION"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": [
        "order",
        "componentId",
        "componentName",
        "currentVersion",
        "currentBuild",
        "targetVersion",
        "targetBuild",
        "action",
        "gates"
      ],
      "additionalProperties": false,
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "componentName": {
          "type": "string",
          "minLength": 1
        },
        "currentVersion": {
          "type": "string",
          "minLength": 1
        },
        "currentBuild": {
          "type": "integer",
          "minimum": 1
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetBuild": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "action": {
          "enum": [
            "PATCH_AND_RETAIN_FOR_MIGRATION",
            "UPGRADE",
            "REDEPLOY_TARGET_AND_MIGRATE",
            "ROLLING_UPGRADE"
          ]
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

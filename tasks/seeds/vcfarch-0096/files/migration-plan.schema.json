{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0096:migration-plan",
  "title": "VCF brownfield ordered migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inventoryId",
    "sourceVcfVersion",
    "targetVcfVersion",
    "strategy",
    "blocker",
    "componentTransitions",
    "steps"
  ],
  "properties": {
    "inventoryId": {
      "type": "string",
      "minLength": 1
    },
    "sourceVcfVersion": {
      "type": "string",
      "minLength": 1
    },
    "targetVcfVersion": {
      "type": "string",
      "minLength": 1
    },
    "strategy": {
      "type": "string",
      "enum": [
        "PARALLEL_BUILD_MIGRATE"
      ]
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "currentBuild",
        "targetBuild",
        "reasonCode",
        "decision"
      ],
      "properties": {
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "currentBuild": {
          "type": "integer",
          "minimum": 1
        },
        "targetBuild": {
          "type": "integer",
          "minimum": 1
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "componentTransitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "componentId",
          "componentName",
          "currentVersion",
          "currentBuild",
          "targetVersion",
          "targetBuild",
          "method",
          "gates"
        ],
        "properties": {
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "componentName": {
            "type": "string",
            "minLength": 1
          },
          "currentVersion": {
            "type": "string",
            "minLength": 1
          },
          "currentBuild": {
            "type": "integer",
            "minimum": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetBuild": {
            "type": "integer",
            "minimum": 1
          },
          "method": {
            "type": "string",
            "enum": [
              "PARALLEL_DEPLOY",
              "PARALLEL_REPLACE"
            ]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "stage",
          "componentIds",
          "gates",
          "outcome"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "componentIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

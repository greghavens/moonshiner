+// NewClient validates configuration without making a request.
+func NewClient(config Config) (*Client, error) {
+	baseURL, err := url.Parse(config.BaseURL)
+	if err != nil ||
+		baseURL.Scheme == "" ||
+		(baseURL.Scheme != "http" && baseURL.Scheme != "https") ||
+		baseURL.Host == "" ||
+		baseURL.Hostname() == "" ||
+		baseURL.Opaque != "" ||
+		baseURL.User != nil ||
+		(baseURL.Path != "" && baseURL.Path != "/") ||
+		baseURL.RawPath != "" ||
+		baseURL.RawQuery != "" ||
+		baseURL.ForceQuery ||
+		baseURL.Fragment != "" ||
+		baseURL.RawFragment != "" {
+		return nil, fmt.Errorf("BaseURL must be an absolute HTTP(S) origin")
+	}
+	if config.Token == "" ||
+		strings.TrimSpace(config.Token) != config.Token ||
+		strings.ContainsAny(config.Token, "\r\n") {
+		return nil, fmt.Errorf("Token must be nonblank and have no surrounding whitespace")
+	}
+
+	sourceClient := config.HTTPClient
+	if sourceClient == nil {
+		sourceClient = http.DefaultClient
+	}
+	httpClient := *sourceClient
+	httpClient.CheckRedirect = func(*http.Request, []*http.Request) error {
+		return http.ErrUseLastResponse
+	}
+	return &Client{
+		baseURL:    baseURL.Scheme + "://" + baseURL.Host,
+		token:      config.Token,
+		httpClient: &httpClient,
+	}, nil
 }
 

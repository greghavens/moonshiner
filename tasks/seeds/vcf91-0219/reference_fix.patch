+            }
+        }
+
+        private List<Object> readArray() {
+            expect('[');
+            List<Object> values = new ArrayList<>();
+            skipWhitespace();
+            if (consume(']')) {
+                return values;
+            }
+            while (true) {
+                values.add(readValue());
+                skipWhitespace();
+                if (consume(']')) {
+                    return values;
+                }
+                expect(',');
+            }
+        }

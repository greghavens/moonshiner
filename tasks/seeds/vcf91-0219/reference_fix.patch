+    /** Minimal strict JSON implementation for the focused response fields. */
+    private static final class Json {
+        private final String input;
+        private int index;
+
+        private Json(String input) {
+            this.input = input;
+        }
+
+        static Object parse(String input) {
+            Json parser = new Json(Objects.requireNonNull(input));
+            Object value = parser.readValue();
+            parser.skipWhitespace();
+            if (parser.index != input.length()) {
+                throw new IllegalArgumentException("trailing JSON content");
+            }
+            return value;
+        }

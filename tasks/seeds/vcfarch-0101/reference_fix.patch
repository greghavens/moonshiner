diff --git a/VcfFleetArchitecture/VcfFleetArchitecture.psm1 b/VcfFleetArchitecture/VcfFleetArchitecture.psm1
new file mode 100644
index 0000000..a63ea86
--- /dev/null
+++ b/VcfFleetArchitecture/VcfFleetArchitecture.psm1
@@ -0,0 +1,380 @@
+Set-StrictMode -Version Latest
+Import-Module VMware.Sdk.Vcf.Installer -RequiredVersion 13.5.0.25380678 -ErrorAction Stop
+
+function Read-ArchitectureJson {
+    param([Parameter(Mandatory)][string]$Path)
+
+    if (-not [System.IO.File]::Exists($Path)) {
+        throw [System.IO.FileNotFoundException]::new("Architecture input was not found: $Path", $Path)
+    }
+    $text = [System.IO.File]::ReadAllText([System.IO.Path]::GetFullPath($Path))
+    $text | ConvertFrom-Json -AsHashtable -Depth 100
+}
+
+function Write-ArchitectureJson {
+    param(
+        [Parameter(Mandatory)]$Value,
+        [Parameter(Mandatory)][string]$Path
+    )
+
+    $json = ConvertTo-Json -InputObject $Value -Depth 100
+    [System.IO.File]::WriteAllText(
+        $Path,
+        $json + "`n",
+        [System.Text.UTF8Encoding]::new($false)
+    )
+}
+
+function Get-CompatibilityRule {
+    param(
+        [Parameter(Mandatory)]$Component,
+        [Parameter(Mandatory)]$Snapshot
+    )
+
+    $matches = @(
+        $Snapshot.rules | Where-Object {
+            $_.componentType -ceq $Component.type -and
+            $_.sourceVersion -ceq $Component.currentVersion
+        }
+    )
+    if ($matches.Count -ne 1) {
+        throw "Expected one compatibility rule for $($Component.type) $($Component.currentVersion); found $($matches.Count)."
+    }
+    $matches[0]
+}
+
+function Get-Dependencies {
+    param(
+        [Parameter(Mandatory)]$Component,
+        [Parameter(Mandatory)]$Rule,
+        [Parameter(Mandatory)]$Components
+    )
+
+    $ids = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::Ordinal)
+    foreach ($selector in @($Rule.dependencySelectors)) {
+        if ($selector.scope -cnotin @('global', 'same-site')) {
+            throw "Unknown dependency selector scope: $($selector.scope)"
+        }
+        foreach ($candidate in @($Components)) {
+            if ($candidate.type -cne $selector.componentType) {
+                continue
+            }
+            if ($selector.scope -ceq 'same-site' -and $candidate.siteId -cne $Component.siteId) {
+                continue
+            }
+            $null = $ids.Add([string]$candidate.id)
+        }
+    }
+    @($ids | Sort-Object)
+}
+
+function New-InstallerSddcSpecDocument {
+    param([Parameter(Mandatory)]$Estate)
+
+    $design = $Estate.greenfield
+    $hostComponents = @(
+        $Estate.components |
+            Where-Object { $_.type -ceq 'ESXI' } |
+            Sort-Object -Property @{ Expression = { $_.siteId } }, @{ Expression = { $_.id } }
+    )
+
+    $hostModels = @(
+        foreach ($hostComponent in $hostComponents) {
+            Initialize-VcfInstallerSddcHostSpec -Hostname $hostComponent.hostname
+        }
+    )
+    $vcenterModel = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname $design.vcenterHostname `
+        -RootVcenterPassword $design.vcenterPasswordReference `
+        -VmSize $design.vcenterVmSize `
+        -StorageSize $design.vcenterStorageSize
+    $networkModels = @(
+        foreach ($network in @($design.networks)) {
+            Initialize-VcfInstallerSddcNetworkSpec `
+                -NetworkType $network.networkType `
+                -VlanId ([int]$network.vlanId) `
+                -Mtu ([int]$network.mtu) `
+                -Subnet $network.subnet `
+                -Gateway $network.gateway `
+                -SubnetMask $network.subnetMask
+        }
+    )
+    $dnsModel = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $design.dnsSubdomain `
+        -Nameservers @($design.nameServers)
+    $clusterModel = Initialize-VcfInstallerSddcClusterSpec `
+        -DatacenterName $design.datacenterName `
+        -ClusterName $design.clusterName
+    $esaModel = Initialize-VcfInstallerVsanEsaConfig -Enabled ([bool]$design.vsanEsaEnabled)
+    $vsanModel = Initialize-VcfInstallerVsanSpec `
+        -DatastoreName $design.vsanDatastoreName `
+        -EsaConfig $esaModel `
+        -FailuresToTolerate ([int]$design.vsanFailuresToTolerate)
+    $datastoreModel = Initialize-VcfInstallerSddcDatastoreSpec -VsanSpec $vsanModel
+    $nsxManagerModels = @(
+        foreach ($hostname in @($design.nsxManagerHostnames)) {
+            Initialize-VcfInstallerNsxtManagerSpec -Hostname $hostname
+        }
+    )
+    $nsxModel = Initialize-VcfInstallerSddcNsxtSpec `
+        -NsxtManagers $nsxManagerModels `
+        -NsxtManagerSize $design.nsxManagerSize `
+        -VipFqdn $design.nsxVipFqdn `
+        -TransportVlanId ([int]$design.nsxTransportVlanId)
+
+    # Construct the real generated top-level type. The JSON projection below is
+    # intentionally sparse so unset SDK properties stay absent from the artifact.
+    $sddcModel = Initialize-VcfInstallerSddcSpec `
+        -SddcId $design.sddcId `
+        -WorkflowType $design.workflowType `
+        -HostSpecs $hostModels `
+        -Version $Estate.targetFleet.version `
+        -VcenterSpec $vcenterModel `
+        -ClusterSpec $clusterModel `
+        -NsxtSpec $nsxModel `
+        -NetworkSpecs $networkModels `
+        -DnsSpec $dnsModel `
+        -NtpServers @($design.ntpServers) `
+        -DatastoreSpec $datastoreModel
+    if ($null -eq $sddcModel) {
+        throw 'The VMware SDK did not construct an SddcSpec model.'
+    }
+
+    $hostSpecs = @(
+        foreach ($hostComponent in $hostComponents) {
+            [ordered]@{ hostname = [string]$hostComponent.hostname }
+        }
+    )
+    $networkSpecs = @(
+        foreach ($network in @($design.networks)) {
+            [ordered]@{
+                networkType = [string]$network.networkType
+                vlanId = [int]$network.vlanId
+                mtu = [int]$network.mtu
+                subnet = [string]$network.subnet
+                gateway = [string]$network.gateway
+                subnetMask = [string]$network.subnetMask
+            }
+        }
+    )
+    $nsxtManagers = @(
+        foreach ($hostname in @($design.nsxManagerHostnames)) {
+            [ordered]@{ hostname = [string]$hostname }
+        }
+    )
+
+    [ordered]@{
+        sddcId = [string]$design.sddcId
+        workflowType = [string]$design.workflowType
+        hostSpecs = $hostSpecs
+        version = [string]$Estate.targetFleet.version
+        vcenterSpec = [ordered]@{
+            vcenterHostname = [string]$design.vcenterHostname
+            rootVcenterPassword = [string]$design.vcenterPasswordReference
+            vmSize = [string]$design.vcenterVmSize
+            storageSize = [string]$design.vcenterStorageSize
+        }
+        clusterSpec = [ordered]@{
+            datacenterName = [string]$design.datacenterName
+            clusterName = [string]$design.clusterName
+        }
+        nsxtSpec = [ordered]@{
+            nsxtManagers = $nsxtManagers
+            nsxtManagerSize = [string]$design.nsxManagerSize
+            vipFqdn = [string]$design.nsxVipFqdn
+            transportVlanId = [int]$design.nsxTransportVlanId
+        }
+        networkSpecs = $networkSpecs
+        dnsSpec = [ordered]@{
+            subdomain = [string]$design.dnsSubdomain
+            nameservers = @($design.nameServers)
+        }
+        ntpServers = @($design.ntpServers)
+        datastoreSpec = [ordered]@{
+            vsanSpec = [ordered]@{
+                datastoreName = [string]$design.vsanDatastoreName
+                esaConfig = [ordered]@{ enabled = [bool]$design.vsanEsaEnabled }
+                failuresToTolerate = [int]$design.vsanFailuresToTolerate
+            }
+        }
+    }
+}
+
+function New-SiteTopologyDocument {
+    param([Parameter(Mandatory)]$Estate)
+
+    $sitesById = @{}
+    foreach ($site in @($Estate.sites)) {
+        $sitesById[[string]$site.id] = $site
+    }
+    $componentsById = @{}
+    foreach ($component in @($Estate.components)) {
+        $componentsById[[string]$component.id] = $component
+    }
+    $dataSites = @(
+        foreach ($siteId in @($Estate.managementDomain.dataSiteIds)) {
+            $site = $sitesById[[string]$siteId]
+            [ordered]@{
+                siteId = [string]$site.id
+                role = [string]$site.role
+                failureDomain = [string]$site.failureDomain
+            }
+        }
+    )
+    $hostPlacement = @(
+        foreach ($component in @(
+            $Estate.components |
+                Where-Object { $_.type -ceq 'ESXI' } |
+                Sort-Object -Property @{ Expression = { $_.siteId } }, @{ Expression = { $_.id } }
+        )) {
+            [ordered]@{
+                componentId = [string]$component.id
+                hostname = [string]$component.hostname
+                siteId = [string]$component.siteId
+            }
+        }
+    )
+    $witness = $componentsById[[string]$Estate.managementDomain.witnessComponentId]
+    $witnessSite = $sitesById[[string]$witness.siteId]
+    $appliances = @(
+        foreach ($siteId in @($Estate.recoveryPair.siteIds)) {
+            [ordered]@{
+                resourceId = "${siteId}-vpr"
+                siteId = [string]$siteId
+            }
+        }
+    )
+
+    [ordered]@{
+        schemaVersion = '1.0.0'
+        designType = 'TWO_SITE_STRETCHED_MANAGEMENT_DOMAIN'
+        targetFleet = [ordered]@{
+            id = [string]$Estate.targetFleet.id
+            version = [string]$Estate.targetFleet.version
+        }
+        managementDomain = [ordered]@{
+            id = [string]$Estate.managementDomain.id
+            stretched = $true
+            dataSites = $dataSites
+            hostPlacement = $hostPlacement
+            storage = [ordered]@{
+                type = 'VSAN_STRETCHED_CLUSTER'
+                witness = [ordered]@{
+                    componentId = [string]$witness.id
+                    hostname = [string]$witness.hostname
+                    siteId = [string]$witness.siteId
+                    failureDomain = [string]$witnessSite.failureDomain
+                    runsOnManagementDomain = $false
+                }
+            }
+        }
+        protection = [ordered]@{
+            pairId = [string]$Estate.recoveryPair.id
+            targetProduct = 'VCF_PROTECTION_AND_RECOVERY'
+            targetVersion = [string]$Estate.targetFleet.version
+            appliances = $appliances
+        }
+    }
+}
+
+function New-MigrationPlanDocument {
+    param(
+        [Parameter(Mandatory)]$Estate,
+        [Parameter(Mandatory)]$Snapshot
+    )
+
+    if ($Snapshot.targetFleetVersion -cne $Estate.targetFleet.version) {
+        throw 'The compatibility snapshot does not target the estate fleet version.'
+    }
+    $gateConditions = @{}
+    foreach ($gate in @($Snapshot.gateDefinitions)) {
+        $gateConditions[[string]$gate.id] = [string]$gate.condition
+    }
+
+    $work = @(
+        foreach ($component in @($Estate.components)) {
+            $rule = Get-CompatibilityRule -Component $component -Snapshot $Snapshot
+            [pscustomobject]@{ Component = $component; Rule = $rule }
+        }
+    ) | Sort-Object -Property `
+        @{ Expression = { [int]$_.Rule.phase } }, `
+        @{ Expression = { $_.Component.siteId } }, `
+        @{ Expression = { $_.Component.id } }
+
+    $steps = [System.Collections.Generic.List[object]]::new()
+    $order = 0
+    foreach ($item in $work) {
+        $order++
+        $component = $item.Component
+        $rule = $item.Rule
+        $resourceId = ([string]$rule.targetResourceTemplate).
+            Replace('{componentId}', [string]$component.id).
+            Replace('{siteId}', [string]$component.siteId)
+        $gates = @(
+            foreach ($gateId in @($rule.gateIds)) {
+                if (-not $gateConditions.ContainsKey([string]$gateId)) {
+                    throw "Compatibility rule names unknown gate: $gateId"
+                }
+                [ordered]@{
+                    id = [string]$gateId
+                    condition = [string]$gateConditions[[string]$gateId]
+                }
+            }
+        )
+        $dependencies = @(
+            Get-Dependencies `
+                -Component $component `
+                -Rule $rule `
+                -Components @($Estate.components)
+        )
+        $steps.Add([ordered]@{
+            order = $order
+            phase = [int]$rule.phase
+            componentId = [string]$component.id
+            componentType = [string]$component.type
+            siteId = [string]$component.siteId
+            currentVersion = [string]$component.currentVersion
+            target = [ordered]@{
+                product = [string]$rule.targetProduct
+                version = [string]$rule.targetVersion
+                resourceId = $resourceId
+            }
+            upgradePath = @($rule.upgradePath)
+            action = [string]$rule.action
+            gates = $gates
+            dependsOn = $dependencies
+        })
+    }
+
+    [ordered]@{
+        schemaVersion = '1.0.0'
+        estateId = [string]$Estate.estateId
+        targetFleetId = [string]$Estate.targetFleet.id
+        targetFleetVersion = [string]$Estate.targetFleet.version
+        steps = $steps.ToArray()
+    }
+}
+
+function New-VcfFleetArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$EstatePath,
+        [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$CompatibilitySnapshotPath,
+        [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$OutputDirectory
+    )
+
+    $estate = Read-ArchitectureJson -Path $EstatePath
+    $snapshot = Read-ArchitectureJson -Path $CompatibilitySnapshotPath
+    $output = [System.IO.Path]::GetFullPath($OutputDirectory)
+    $null = [System.IO.Directory]::CreateDirectory($output)
+
+    $sddcSpec = New-InstallerSddcSpecDocument -Estate $estate
+    $topology = New-SiteTopologyDocument -Estate $estate
+    $migrationPlan = New-MigrationPlanDocument -Estate $estate -Snapshot $snapshot
+
+    Write-ArchitectureJson -Value $sddcSpec -Path ([System.IO.Path]::Combine($output, 'greenfield-sddc-spec.json'))
+    Write-ArchitectureJson -Value $topology -Path ([System.IO.Path]::Combine($output, 'site-topology.json'))
+    Write-ArchitectureJson -Value $migrationPlan -Path ([System.IO.Path]::Combine($output, 'migration-plan.json'))
+}
+
+Export-ModuleMember -Function New-VcfFleetArchitecture

+++ b/architecture/migration-plan.json
@@ -0,0 +1,747 @@
+{
+  "schemaVersion": "1.0.0",
+  "estateId": "northstar-estate",
+  "targetFleetId": "northstar-fleet",
+  "targetFleetVersion": "9.1.0.0",
+  "steps": [
+    {
+      "order": 1,
+      "phase": 10,
+      "componentId": "vcf-ops-01",
+      "componentType": "VCF_OPERATIONS",
+      "siteId": "site-a",
+      "currentVersion": "NOT_INSTALLED",
+      "target": {
+        "product": "VCF_OPERATIONS",
+        "version": "9.1.0.0",
+        "resourceId": "vcf-ops-01"
+      },
+      "upgradePath": [
+        "NOT_INSTALLED",
+        "9.1.0.0"
+      ],
+      "action": "DEPLOY",
+      "gates": [
+        {
+          "id": "FLEET-MGMT-FIRST",
+          "condition": "VCF Operations 9.1 is deployed before any point-solution convergence into the fleet."
+        },
+        {
+          "id": "SUPPORTED-UPGRADE-PATH",
+          "condition": "Every adjacent version hop is present in this pinned snapshot's rule for the component type and source version."
+        }
+      ],
+      "dependsOn": []
+    },
+    {
+      "order": 2,
+      "phase": 20,
+      "componentId": "vr-a",
+      "componentType": "VSPHERE_REPLICATION",
+      "siteId": "site-a",
+      "currentVersion": "8.8.0.3",
+      "target": {
+        "product": "VCF_PROTECTION_AND_RECOVERY",
+        "version": "9.1.0.0",
+        "resourceId": "site-a-vpr"
+      },
+      "upgradePath": [
+        "8.8.0.3",
+        "9.0.2.2",
+        "9.0.4",
+        "9.1.0.0"
+      ],
+      "action": "CONVERGE",

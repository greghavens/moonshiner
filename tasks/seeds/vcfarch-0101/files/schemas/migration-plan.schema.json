{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0101:migration-plan:1.0.0",
  "title": "VCF brownfield migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "estateId",
    "targetFleetId",
    "targetFleetVersion",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetFleetId": {
      "type": "string",
      "minLength": 1
    },
    "targetFleetVersion": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "phase",
        "componentId",
        "componentType",
        "siteId",
        "currentVersion",
        "target",
        "upgradePath",
        "action",
        "gates",
        "dependsOn"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "type": "integer",
          "minimum": 1
        },
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "componentType": {
          "type": "string",
          "enum": [
            "VCF_OPERATIONS",
            "VSPHERE_REPLICATION",
            "LIVE_SITE_RECOVERY",
            "NSX",
            "VCENTER",
            "VSAN_WITNESS",
            "ESXI",
            "VSAN"
          ]
        },
        "siteId": {
          "type": "string",
          "minLength": 1
        },
        "currentVersion": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "product",
            "version",
            "resourceId"
          ],
          "properties": {
            "product": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "resourceId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "upgradePath": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "action": {
          "type": "string",
          "enum": [
            "DEPLOY",
            "CONVERGE",
            "UPGRADE"
          ]
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/gate"
          }
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "condition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

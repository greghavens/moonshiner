{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0101:site-topology:1.0.0",
  "title": "VCF two-site placement architecture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "designType",
    "targetFleet",
    "managementDomain",
    "protection"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "designType": {
      "const": "TWO_SITE_STRETCHED_MANAGEMENT_DOMAIN"
    },
    "targetFleet": {
      "$ref": "#/$defs/targetFleet"
    },
    "managementDomain": {
      "$ref": "#/$defs/managementDomain"
    },
    "protection": {
      "$ref": "#/$defs/protection"
    }
  },
  "$defs": {
    "targetFleet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "siteId",
        "role",
        "failureDomain"
      ],
      "properties": {
        "siteId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "failureDomain": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hostPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "hostname",
        "siteId"
      ],
      "properties": {
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "siteId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "hostname",
        "siteId",
        "failureDomain",
        "runsOnManagementDomain"
      ],
      "properties": {
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "hostname": {
          "type": "string",
          "minLength": 1
        },
        "siteId": {
          "type": "string",
          "minLength": 1
        },
        "failureDomain": {
          "type": "string",
          "minLength": 1
        },
        "runsOnManagementDomain": {
          "const": false
        }
      }
    },
    "managementDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stretched",
        "dataSites",
        "hostPlacement",
        "storage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "stretched": {
          "const": true
        },
        "dataSites": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/site"
          }
        },
        "hostPlacement": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/hostPlacement"
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "witness"
          ],
          "properties": {
            "type": {
              "const": "VSAN_STRETCHED_CLUSTER"
            },
            "witness": {
              "$ref": "#/$defs/witness"
            }
          }
        }
      }
    },
    "appliance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "siteId"
      ],
      "properties": {
        "resourceId": {
          "type": "string",
          "minLength": 1
        },
        "siteId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pairId",
        "targetProduct",
        "targetVersion",
        "appliances"
      ],
      "properties": {
        "pairId": {
          "type": "string",
          "minLength": 1
        },
        "targetProduct": {
          "const": "VCF_PROTECTION_AND_RECOVERY"
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1
        },
        "appliances": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/appliance"
          }
        }
      }
    }
  }
}

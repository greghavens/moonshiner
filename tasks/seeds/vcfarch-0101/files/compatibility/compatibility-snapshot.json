{
  "snapshotVersion": "1.0.0",
  "authorityDate": "2026-08-14",
  "targetFleetVersion": "9.1.0.0",
  "gateDefinitions": [
    {
      "id": "FLEET-MGMT-FIRST",
      "condition": "VCF Operations 9.1 is deployed before any point-solution convergence into the fleet."
    },
    {
      "id": "SUPPORTED-UPGRADE-PATH",
      "condition": "Every adjacent version hop is present in this pinned snapshot's rule for the component type and source version."
    },
    {
      "id": "VCF-INSTALLER-CONVERGE",
      "condition": "Brownfield vSphere with NSX uses the VCF Installer converge and convert/import workflow rather than independent core-component upgrades."
    },
    {
      "id": "PROTECTION-PAIR-ALIGNED",
      "condition": "Both recovery sites reach the listed paired transition level and are re-paired before vCenter is moved to 9.1."
    },
    {
      "id": "VCENTER-BEFORE-ESXI",
      "condition": "The site's vCenter reaches its target before any managed ESXi host at that site."
    },
    {
      "id": "WITNESS-THIRD-FAULT-DOMAIN",
      "condition": "The vSAN witness is upgraded before data hosts and remains outside both data sites and outside the stretched management domain."
    },
    {
      "id": "VSAN-AFTER-HOSTS",
      "condition": "The site's ESXi hosts reach target before the vSAN target and on-disk-format step."
    }
  ],

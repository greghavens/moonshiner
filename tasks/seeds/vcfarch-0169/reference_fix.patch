+"""Command-line entry point."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from .planner import build_plan
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description="Build the pinned VCF migration architecture")
+    parser.add_argument("--inventory", type=Path, required=True)
+    parser.add_argument("--snapshot", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+
+    inventory = json.loads(args.inventory.read_text(encoding="utf-8"))
+    snapshot = json.loads(args.snapshot.read_text(encoding="utf-8"))
+    plan = build_plan(inventory, snapshot)
+    args.output.write_text(json.dumps(plan, indent=2, sort_keys=False) + "\n", encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

+def content_dispositions(source: dict[str, Any], expected: dict[str, list[str]]) -> list[dict[str, str]]:
+    result = []
+    for item in source["content"]:
+        content_id = item["content_id"]
+        status, method = expected[content_id]
+        rationale = RATIONALES.get(
+            content_id,
+            "The pinned compatibility path retains this item using the stated supported transfer method.",
+        )
+        result.append(
+            {
+                "content_id": content_id,
+                "status": status,
+                "method": method,
+                "target_form": TARGET_FORMS[content_id],
+                "rationale": rationale,
+            }
+        )
+    return result
+
+
+def build_plan(inventory: dict[str, Any], snapshot: dict[str, Any]) -> dict[str, Any]:
+    if inventory.get("estate_id") != "northstar-prod":
+        raise ValueError("unsupported estate inventory")
+    if snapshot.get("snapshot_id") != "broadcom-vcf9-architecture-2026-08-15":
+        raise ValueError("unsupported compatibility snapshot")
+
+    storage = snapshot["storage_decision"]
+    alternatives = []
+    for architecture in ("OSA", "ESA"):
+        item = storage["alternatives"][architecture]
+        alternatives.append(
+            {
+                "architecture": architecture,
+                "host_profile_id": item["host_profile_id"],
+                "usable_tb_per_host": item["usable_tb_per_host"],
+                "required_usable_tb": storage["required_usable_tb"],
+                "minimum_data_hosts": item["minimum_data_hosts"],
+                "capacity_hosts": item["capacity_hosts"],
+                "operational_spare_hosts": storage["operational_spare_hosts"],
+                "host_count": item["host_count"],
+                "storage_policy": item["storage_policy"],
+                "network": {
+                    "uplinks_per_host": item["uplinks_per_host"],
+                    "uplink_speed_gbps": item["uplink_speed_gbps"],
+                    "mtu": item["mtu"],
+                    "traffic_classes": list(storage["required_traffic_classes"]),
+                },
+            }
+        )
+
+    sources = {item["source_id"]: item for item in inventory["source_products"]}
+    migrations = []
+    for expected in snapshot["migration_compatibility"]:
+        source = sources[expected["source_id"]]
+        migrations.append(
+            {
+                "source_id": expected["source_id"],
+                "product": source["product"],
+                "version": source["version"],
+                "eogs_date": expected["eogs_date"],
+                "target_component": expected["target_component"],
+                "target_version": expected["target_version"],
+                "method": expected["method"],
+                "intermediate_versions": list(expected["intermediate_versions"]),
+                "content_dispositions": content_dispositions(source, expected["content_dispositions"]),
+                "gate_ids": list(expected["required_gate_ids"]),
+            }
+        )
+
+    gates = [
+        {"gate_id": gate_id, "condition": details[0], "evidence": details[1], "blocks_step_ids": details[2]}
+        for gate_id, details in GATE_DETAILS.items()
+    ]
+    steps = [
+        {
+            "sequence": sequence,
+            "step_id": item[0],
+            "phase": item[1],
+            "source_id": item[2],
+            "action": item[3],
+            "target_state": item[4],
+            "gate_ids": item[5],
+            "outputs": item[6],
+            "rollback": item[7],
+        }
+        for sequence, item in enumerate(STEP_DETAILS, start=1)
+    ]
+    return {
+        "schema_version": "1.0",
+        "estate_id": inventory["estate_id"],
+        "planning_date": inventory["planning_date"],
+        "snapshot_id": snapshot["snapshot_id"],
+        "architecture_decision": {
+            "selected_storage_architecture": storage["selected_architecture"],
+            "decision_drivers": [
+                "ESA satisfies the same 180 TB usable requirement with five hosts instead of seven OSA hosts.",
+                "The five available ESA profiles and five redundant 25 GbE port pairs exactly satisfy the selected design.",
+                "Both alternatives preserve one operational spare beyond the greater of policy minimum and capacity host count.",
+            ],
+            "alternatives": alternatives,
+        },
+        "target_placements": list(snapshot["target_sizing"]),
+        "source_migrations": migrations,
+        "gates": gates,
+        "steps": steps,
+        "research_log": list(RESEARCH_LOG),
+    }

{
  "spec_version": "1.0",
  "artifact_path": "migration_plan.json",
  "package_name": "vcf_architecture",
  "cli": "python3 -m vcf_architecture --inventory estate_inventory.json --snapshot compatibility_snapshot.json --output migration_plan.json",
  "artifact_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "estate_id",
      "planning_date",
      "snapshot_id",
      "architecture_decision",
      "target_placements",
      "source_migrations",
      "gates",
      "steps",
      "research_log"
    ],
    "properties": {
      "schema_version": {"const": "1.0"},
      "estate_id": {"type": "string", "minLength": 1},
      "planning_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
      "snapshot_id": {"type": "string", "minLength": 1},
      "architecture_decision": {"$ref": "#/$defs/architectureDecision"},
      "target_placements": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {"$ref": "#/$defs/placement"}
      },
      "source_migrations": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {"$ref": "#/$defs/sourceMigration"}
      },
      "gates": {
        "type": "array",
        "minItems": 1,
        "items": {"$ref": "#/$defs/gate"}
      },
      "steps": {
        "type": "array",
        "minItems": 1,
        "items": {"$ref": "#/$defs/step"}
      },
      "research_log": {
        "type": "array",
        "minItems": 4,
        "items": {"$ref": "#/$defs/researchRecord"}
      }
    },
    "$defs": {
      "network": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uplinks_per_host", "uplink_speed_gbps", "mtu", "traffic_classes"],
        "properties": {
          "uplinks_per_host": {"type": "integer", "minimum": 1},
          "uplink_speed_gbps": {"type": "integer", "enum": [10, 25, 100]},
          "mtu": {"type": "integer", "minimum": 1500},
          "traffic_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      },
      "storageAlternative": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "architecture",
          "host_profile_id",
          "usable_tb_per_host",
          "required_usable_tb",
          "minimum_data_hosts",
          "capacity_hosts",
          "operational_spare_hosts",
          "host_count",
          "storage_policy",
          "network"
        ],
        "properties": {
          "architecture": {"type": "string", "enum": ["OSA", "ESA"]},
          "host_profile_id": {"type": "string", "minLength": 1},
          "usable_tb_per_host": {"type": "integer", "minimum": 1},
          "required_usable_tb": {"type": "integer", "minimum": 1},
          "minimum_data_hosts": {"type": "integer", "minimum": 1},
          "capacity_hosts": {"type": "integer", "minimum": 1},
          "operational_spare_hosts": {"type": "integer", "minimum": 0},
          "host_count": {"type": "integer", "minimum": 1},
          "storage_policy": {"type": "string", "minLength": 1},
          "network": {"$ref": "#/$defs/network"}
        }
      },
      "architectureDecision": {
        "type": "object",
        "additionalProperties": false,
        "required": ["selected_storage_architecture", "decision_drivers", "alternatives"],
        "properties": {
          "selected_storage_architecture": {"type": "string", "enum": ["OSA", "ESA"]},
          "decision_drivers": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 40}
          },
          "alternatives": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"$ref": "#/$defs/storageAlternative"}
          }
        }
      },
      "placement": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "version",
          "domain",
          "cluster_id",
          "node_count",
          "size",
          "vcpu_per_node",
          "memory_gb_per_node",
          "data_disk_gb_per_node",
          "availability"
        ],
        "properties": {
          "component": {"type": "string", "enum": ["VCF Operations", "VCF Automation", "VCF Operations for Logs"]},
          "version": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "cluster_id": {"type": "string", "minLength": 1},
          "node_count": {"type": "integer", "minimum": 1},
          "size": {"type": "string", "minLength": 1},
          "vcpu_per_node": {"type": "integer", "minimum": 1},
          "memory_gb_per_node": {"type": "integer", "minimum": 1},
          "data_disk_gb_per_node": {"type": "integer", "minimum": 1},
          "availability": {"type": "string", "minLength": 1}
        }
      },
      "contentDisposition": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content_id", "status", "method", "target_form", "rationale"],
        "properties": {
          "content_id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["carry-forward", "abandoned"]},
          "method": {"type": "string", "minLength": 1},
          "target_form": {"type": "string", "minLength": 15},
          "rationale": {"type": "string", "minLength": 40}
        }
      },
      "sourceMigration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "product",
          "version",
          "eogs_date",
          "target_component",
          "target_version",
          "method",
          "intermediate_versions",
          "content_dispositions",
          "gate_ids"
        ],
        "properties": {
          "source_id": {"type": "string", "enum": ["ops", "automation", "logs"]},
          "product": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "eogs_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "target_component": {"type": "string", "enum": ["VCF Operations", "VCF Automation", "VCF Operations for Logs"]},
          "target_version": {"type": "string", "minLength": 1},
          "method": {"type": "string", "enum": ["staged-in-place-upgrade", "parallel-greenfield"]},
          "intermediate_versions": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "content_dispositions": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/contentDisposition"}
          },
          "gate_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^G[0-9]{2}$"}
          }
        }
      },
      "gate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "condition", "evidence", "blocks_step_ids"],
        "properties": {
          "gate_id": {"type": "string", "pattern": "^G[0-9]{2}$"},
          "condition": {"type": "string", "minLength": 40},
          "evidence": {"type": "string", "minLength": 25},
          "blocks_step_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^S[0-9]{2}$"}
          }
        }
      },
      "step": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "step_id",
          "phase",
          "source_id",
          "action",
          "target_state",
          "gate_ids",
          "outputs",
          "rollback"
        ],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "step_id": {"type": "string", "pattern": "^S[0-9]{2}$"},
          "phase": {"type": "string", "enum": ["foundation", "preparation", "upgrade", "transition", "validation", "decommission"]},
          "source_id": {"type": ["string", "null"]},
          "action": {"type": "string", "minLength": 40},
          "target_state": {"type": "string", "minLength": 30},
          "gate_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^G[0-9]{2}$"}
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 8}
          },
          "rollback": {"type": "string", "minLength": 30}
        }
      },
      "researchRecord": {
        "type": "object",
        "additionalProperties": false,
        "required": ["publisher", "title", "url", "consulted_on", "topics"],
        "properties": {
          "publisher": {"const": "Broadcom"},
          "title": {"type": "string", "minLength": 15},
          "url": {"type": "string", "pattern": "^https://"},
          "consulted_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "topics": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["migration-path", "content-compatibility", "lifecycle", "sizing", "storage", "network"]
            }
          }
        }
      }
    }
  }
}

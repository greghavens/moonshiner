+#!/usr/bin/env python3
+"""Reference proof that executes the genuine appointment retriever."""
+
+from __future__ import annotations
+
+from pathlib import Path
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parent
+LEDGER_PATH = ROOT / ".appointment-evidence" / "session.jsonl"
+EXECUTABLE = ROOT / "appointment_pull"
+EXPECTED_STDOUT = (
+    b'{"clinician":"Dr. Imani Cole","id":"hea-135",'
+    b'"patient_name":"Mara Ellison","starts_at":"2026-08-04T09:30:00",'
+    b'"status":"confirmed","timezone":"America/Denver",'
+    b'"visit_type":"medication_review"}\n'
+)
+
+
+def main() -> int:
+    expected_evidence = LEDGER_PATH.read_bytes()
+    LEDGER_PATH.unlink()
+    completed = subprocess.run(
+        [str(EXECUTABLE), "hea-135"],
+        cwd=ROOT,
+        capture_output=True,
+        check=False,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(
+            completed.stderr.decode("utf-8", errors="replace").strip()
+            or "appointment pull failed"
+        )
+    if completed.stderr:
+        raise RuntimeError("appointment pull wrote unexpected stderr")
+    if completed.stdout != EXPECTED_STDOUT:
+        raise RuntimeError(
+            "appointment retriever returned unexpected native output"
+        )
+    if LEDGER_PATH.read_bytes() != expected_evidence:
+        raise RuntimeError(
+            "appointment executable did not recreate reference evidence"
+        )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch:migration-plan:1.0",
  "title": "VCF estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "estateId",
    "targetPlatform",
    "targetVersion",
    "compatibilitySnapshotId",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetPlatform": {
      "type": "string",
      "minLength": 1
    },
    "targetVersion": {
      "type": "string",
      "minLength": 1
    },
    "compatibilitySnapshotId": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "componentVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentName",
        "version"
      ],
      "properties": {
        "componentName": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentName",
        "version",
        "disposition"
      ],
      "properties": {
        "componentName": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "upgrade",
            "replace",
            "retire"
          ]
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateId",
        "condition"
      ],
      "properties": {
        "gateId": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "componentId",
        "componentName",
        "currentVersion",
        "target",
        "path",
        "gates",
        "dependsOn"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "componentName": {
          "type": "string",
          "minLength": 1
        },
        "currentVersion": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "path": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/componentVersion"
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/gate"
          }
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

      "condition": "SDDC Manager 9.0.0.0 inventory and upgrade prechecks are healthy"
    },
    {
      "gateId": "NSX-PRECHECK",
      "condition": "NSX backup, transport-node, and supported upgrade-path prechecks pass"
    },
    {
      "gateId": "VCENTER-PRECHECK",
      "condition": "vCenter file-based backup and interoperability prechecks pass after NSX reaches target"
    },
    {
      "gateId": "SERVER-COMPATIBILITY",
      "condition": "Every target host, I/O device, firmware, and driver combination is listed for ESX 9 in the compatibility guide"
    },
    {
      "gateId": "VSAN-HEALTH",
      "condition": "vSAN health, object resynchronization, and disk-format prechecks are clear after all hosts reach ESX 9"
    }

+        "vcenterSpec": {
+            "vcenterHostname": appliances["vcenterHostname"],
+            "rootVcenterPassword": "${SECRET_VCENTER_ROOT_PASSWORD}",
+            "ssoDomain": "vsphere.local",
+            "adminUserSsoUsername": "administrator@vsphere.local",
+            "adminUserSsoPassword": "${SECRET_VCENTER_SSO_PASSWORD}",
+            "vmSize": "large",
+            "storageSize": "lstorage",
+            "useExistingDeployment": False,
+            "version": requirements["targetVersion"],
+        },
+        "clusterSpec": {
+            "datacenterName": "crp01-m01-dc",
+            "clusterName": "crp01-m01-cl01",
+            "clusterEvcMode": "INTEL_SAPPHIRERAPIDS",
+        },

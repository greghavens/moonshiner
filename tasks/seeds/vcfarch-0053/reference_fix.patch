+def _migration_plan(
+    inventory: dict[str, Any], snapshot: dict[str, Any]
+) -> dict[str, Any]:
+    gates = {item["gateId"]: item["condition"] for item in snapshot["gateCatalog"]}
+    inventory_by_id = {item["componentId"]: item for item in inventory["components"]}
+    steps = []
+    for order, rule in enumerate(snapshot["componentRules"], 1):
+        source = inventory_by_id[rule["componentId"]]
+        steps.append(
+            {
+                "order": order,
+                "componentId": rule["componentId"],
+                "componentName": source["componentName"],
+                "currentVersion": source["version"],
+                "target": rule["target"],
+                "path": rule["allowedPath"],
+                "gates": [
+                    {"gateId": gate_id, "condition": gates[gate_id]}
+                    for gate_id in rule["requiredGateIds"]
+                ],
+                "dependsOn": rule["dependsOn"],
+            }
+        )
+    return {
+        "schemaVersion": "1.0",
+        "estateId": inventory["estateId"],
+        "targetPlatform": snapshot["targetPlatform"],
+        "targetVersion": snapshot["targetVersion"],
+        "compatibilitySnapshotId": snapshot["snapshotId"],
+        "steps": steps,
+    }
+
+
+def build(root: Path, output: Path) -> None:
+    """Build all graded architecture artifacts from the repository fixtures."""
+    requirements = _read(root / "fixtures/design-requirements.json")
+    inventory = _read(root / "fixtures/estate-inventory.json")
+    snapshot = _read(root / "fixtures/compatibility-snapshot.json")
+    output.mkdir(parents=True, exist_ok=True)
+    _write(output / "greenfield-sddc-spec.json", _sddc_spec(requirements))
+    _write(output / "site-architecture.json", _site_architecture(requirements))
+    _write(output / "migration-plan.json", _migration_plan(inventory, snapshot))

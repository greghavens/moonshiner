+def _sddc_spec(requirements: dict[str, Any]) -> dict[str, Any]:
+    primary = next(site for site in requirements["sites"] if site["role"] == "PRIMARY")
+    appliances = requirements["managementAppliances"]
+    networks = []
+    for network in primary["networks"]:
+        networks.append(
+            {
+                "networkType": network["networkType"],
+                "subnet": network["cidr"],
+                "gateway": network["gateway"],
+                "includeIpAddressRanges": [
+                    {
+                        "startIpAddress": network["ipRange"][0],
+                        "endIpAddress": network["ipRange"][1],
+                    }
+                ],
+                "vlanId": network["vlanId"],
+                "mtu": network["mtu"],
+                "activeUplinks": ["uplink1", "uplink2"],
+                "standbyUplinks": [],
+            }
+        )
+
+    return {
+        "sddcId": requirements["sddcId"],
+        "workflowType": "VCF",
+        "version": requirements["targetVersion"],
+        "vcfInstanceName": requirements["vcfInstanceName"],
+        "hostSpecs": [

+def _site_architecture(requirements: dict[str, Any]) -> dict[str, Any]:
+    dimensions = ("cpuCores", "memoryGiB", "rawStorageTiB")
+    sites = []
+    for requirement in requirements["sites"]:
+        host_count = requirement["managementDomainHostCount"]
+        survivors = host_count - requirement["hostFailureTolerance"]
+        sites.append(
+            {
+                "siteId": requirement["siteId"],
+                "role": requirement["role"],
+                "hostCount": host_count,
+                "hostFailureTolerance": requirement["hostFailureTolerance"],
+                "hostProfile": requirement["hostProfile"],
+                "rawCapacity": {
+                    key: requirement["hostProfile"][key] * host_count for key in dimensions
+                },
+                "usableAfterHostFailures": {
+                    key: requirement["hostProfile"][key] * survivors for key in dimensions
+                },
+                "minimumUsableAfterFailures": requirement["minimumUsableAfterFailures"],
+                "networks": requirement["networks"],
+            }
+        )
+    return {
+        "schemaVersion": "1.0",
+        "requirementsId": requirements["requirementsId"],
+        "targetVersion": requirements["targetVersion"],
+        "sites": sites,
+        "recovery": requirements["recovery"],
+    }
+

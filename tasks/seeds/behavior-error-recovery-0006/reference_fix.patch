diff --git a/.reference_solution.py b/.reference_solution.py
new file mode 100755
--- /dev/null
+++ b/.reference_solution.py
@@ -0,0 +1,111 @@
+#!/usr/bin/env python3
+"""Produce the reference deliverable through genuine purchasing executions."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "purchasingctl"
+DELIVERABLE = ROOT / "availability-result.txt"
+TARGETS = (
+    {
+        "name": "Braille Labeler Order",
+        "location": "Accessibility Office",
+        "date": "2026-11-21",
+    },
+    {
+        "name": "Portable Freezer Order",
+        "location": "Field Lab",
+        "date": "2026-11-21",
+    },
+)
+
+
+def command_for(target: dict[str, str]) -> list[str]:
+    return [
+        str(CLIENT),
+        "availability",
+        "--name",
+        target["name"],
+        "--location",
+        target["location"],
+        "--date",
+        target["date"],
+    ]
+
+
+def collect(process: subprocess.Popen[str]) -> dict[str, Any]:
+    stdout, stderr = process.communicate(timeout=5)
+    response_text = stdout if process.returncode == 0 else stderr
+    try:
+        response = json.loads(response_text)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("purchasing executable returned invalid JSON") from error
+    return {"returncode": process.returncode, "response": response}
+
+
+def run_one(target: dict[str, str]) -> dict[str, Any]:
+    completed = subprocess.run(
+        command_for(target),
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=5,
+    )
+    response_text = completed.stdout if completed.returncode == 0 else completed.stderr
+    try:
+        response = json.loads(response_text)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("purchasing retry returned invalid JSON") from error
+    return {"returncode": completed.returncode, "response": response}
+
+
+def main() -> int:
+    processes = [
+        subprocess.Popen(
+            command_for(target),
+            cwd=ROOT,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for target in TARGETS
+    ]
+    initial = [collect(process) for process in processes]
+
+    if initial[0]["returncode"] != 0:
+        raise RuntimeError("reference first branch did not succeed")
+    if initial[1]["returncode"] != 75:
+        raise RuntimeError("reference second branch did not temporarily fail")
+    failure = initial[1]["response"]
+    if (
+        failure.get("error") != "temporary_unavailable"
+        or failure.get("retryable") is not True
+    ):
+        raise RuntimeError("reference failure was not explicitly retryable")
+
+    retried = run_one(TARGETS[1])
+    if retried["returncode"] != 0:
+        raise RuntimeError("reference retry did not succeed")
+
+    results = [initial[0]["response"], retried["response"]]
+    labels = ["", " (retried once)"]
+    lines = []
+    for result, label in zip(results, labels, strict=True):
+        availability = "available" if result["available"] else "unavailable"
+        lines.append(
+            f"{result['name']} at {result['location']} on {result['date']}"
+            f"{label}: {availability}."
+        )
+    DELIVERABLE.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

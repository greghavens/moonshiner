+
+func backfilledMetadata(blob Blob) (map[string]string, bool) {
+	addContentType := false
+	if _, exists := blob.Metadata[contentTypeKey]; !exists &&
+		blob.ContentType != "" {
+		addContentType = true
+	}
+	addChecksum := false
+	if _, exists := blob.Metadata[checksumKey]; !exists &&
+		blob.Checksum != "" {
+		addChecksum = true
+	}
+	if !addContentType && !addChecksum {
+		return nil, false
+	}
+
+	metadata := make(map[string]string, len(blob.Metadata)+2)
+	for key, value := range blob.Metadata {
+		metadata[key] = value
+	}
+	if addContentType {
+		metadata[contentTypeKey] = blob.ContentType
+	}
+	if addChecksum {
+		metadata[checksumKey] = blob.Checksum
 	}
+	return metadata, true
 }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch-0176:migration-architecture",
  "title": "VCF management-component migration architecture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "inventory_ref",
    "compatibility_snapshot_ref",
    "target",
    "steps",
    "research"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "minLength": 1},
    "inventory_ref": {"const": "fixtures/estate.json"},
    "compatibility_snapshot_ref": {"const": "installer/compatibility-snapshot.json"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vcf_version",
        "site_id",
        "deployment_model",
        "management_domain_id",
        "cluster_id",
        "storage",
        "host_count",
        "components"
      ],
      "properties": {
        "vcf_version": {"type": "string", "minLength": 1},
        "site_id": {"type": "string", "minLength": 1},
        "deployment_model": {"enum": ["single-site-consolidated"]},
        "management_domain_id": {"type": "string", "minLength": 1},
        "cluster_id": {"type": "string", "minLength": 1},
        "storage": {"type": "string", "minLength": 1},
        "host_count": {"type": "integer", "minimum": 1},
        "components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/component"}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/step"}
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consulted_on", "sources"],
      "properties": {
        "consulted_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/researchSource"}
        }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "product", "version", "placement", "sizing"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["management_domain_id", "cluster_id", "host_ids", "anti_affinity"],
          "properties": {
            "management_domain_id": {"type": "string", "minLength": 1},
            "cluster_id": {"type": "string", "minLength": 1},
            "host_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "anti_affinity": {"type": "boolean"}
          }
        },
        "sizing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile", "nodes", "vcpu_per_node", "memory_gib_per_node", "disk_gib_per_node"],
          "properties": {
            "profile": {"type": "string", "minLength": 1},
            "nodes": {"type": "integer", "minimum": 1},
            "vcpu_per_node": {"type": "integer", "minimum": 1},
            "memory_gib_per_node": {"type": "integer", "minimum": 1},
            "disk_gib_per_node": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "product", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "carry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "method", "target_state"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "method": {
          "enum": [
            "preserved-in-place",
            "log-data-transfer",
            "export-import",
            "manual-reconfigure"
          ]
        },
        "target_state": {"type": "string", "minLength": 1}
      }
    },
    "abandon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "reason_code", "disposition"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "reason_code": {
          "enum": [
            "management-pack-eogs",
            "unsupported-cloud-account",
            "outside-90-day-transfer-window"
          ]
        },
        "disposition": {"type": "string", "minLength": 1}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "condition", "validation"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "condition": {"type": "string", "minLength": 1},
        "validation": {"type": "string", "minLength": 1}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "id",
        "source",
        "target",
        "migration_mode",
        "carry_forward",
        "abandon",
        "gates",
        "support"
      ],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "id": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/endpoint"},
        "target": {"$ref": "#/$defs/endpoint"},
        "migration_mode": {
          "enum": [
            "in-place-upgrade-with-fleet-deployment",
            "fleet-import-and-in-place-upgrade",
            "parallel-fresh-deployment"
          ]
        },
        "carry_forward": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/carry"}
        },
        "abandon": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/abandon"}
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gate"}
        },
        "support": {
          "type": "object",
          "additionalProperties": false,
          "required": ["end_of_general_support", "cutover_position"],
          "properties": {
            "end_of_general_support": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "cutover_position": {"enum": ["before-end-of-general-support"]}
          }
        }
      }
    },
    "researchSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "title", "url", "consulted_on", "claims"],
      "properties": {
        "publisher": {"const": "Broadcom"},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "consulted_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

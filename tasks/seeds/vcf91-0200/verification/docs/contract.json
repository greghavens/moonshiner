{
  "openapiVersion": "3.0.1",
  "apiVersion": "9.1.0.0",
  "derivedFrom": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commitSha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "specPath": "specifications/vcf-installer/vcf-installer-openapi.json"
  },
  "schemaProjection": "Selected operations and their direct request/response wire models, projected from the pinned OpenAPI document without documentation-page input.",
  "operationIds": [
    "createToken",
    "getApplianceInfo",
    "updateDepotSettings"
  ],
  "operations": {
    "createToken": {
      "method": "POST",
      "path": "/v1/tokens",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "TokenCreationSpec"
      },
      "responses": {
        "201": "TokenPair",
        "400": "Error",
        "500": "Error"
      }
    },
    "getApplianceInfo": {
      "method": "GET",
      "path": "/v1/system/appliance-info",
      "responses": {
        "200": "ApplianceInfo",
        "500": "Error"
      }
    },
    "updateDepotSettings": {
      "method": "PUT",
      "path": "/v1/system/settings/depot",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "DepotSettings"
      },
      "responses": {
        "202": "DepotSettings",
        "400": "Error",
        "500": "Error"
      }
    }
  },
  "schemas": {
    "TokenCreationSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" },
        "apiKey": { "type": "string" },
        "idToken": { "type": "string" }
      }
    },
    "TokenPair": {
      "type": "object",
      "required": [],
      "properties": {
        "accessToken": { "type": "string" },
        "refreshToken": { "$ref": "RefreshToken" }
      }
    },
    "RefreshToken": {
      "type": "object",
      "required": [],
      "properties": {
        "id": { "type": "string" }
      }
    },
    "ApplianceInfo": {
      "type": "object",
      "required": [],
      "properties": {
        "role": { "type": "string" },
        "version": { "type": "string" },
        "dnsDomain": { "type": "string" },
        "dnsServers": { "type": "array", "items": { "type": "string" } },
        "ntpServers": { "type": "array", "items": { "type": "string" } },
        "ipAddresses": { "type": "array", "items": { "$ref": "IpAddress" } }
      }
    },
    "IpAddress": {
      "type": "object",
      "required": [],
      "properties": {
        "ipAddress": { "type": "string", "readOnly": true },
        "type": { "type": "string", "readOnly": true },
        "ipAddressVersion": { "type": "string", "readOnly": true }
      }
    },
    "DepotAccount": {
      "type": "object",
      "required": [],
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" },
        "status": { "type": "string" },
        "message": { "type": "string" },
        "downloadToken": { "type": "string", "maxLength": 32 },
        "downloadActivationCode": { "type": "string" }
      }
    },
    "DepotConfiguration": {
      "type": "object",
      "required": ["isOfflineDepot"],
      "properties": {
        "isOfflineDepot": { "type": "boolean" },
        "hostname": { "type": "string" },
        "port": { "type": "integer", "format": "int32" },
        "url": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2048,
          "pattern": "^(https?://[^\\s]+)$"
        }
      }
    },
    "DepotSettings": {
      "type": "object",
      "required": [],
      "properties": {
        "vmwareAccount": { "$ref": "DepotAccount" },
        "offlineAccount": { "$ref": "DepotAccount" },
        "depotConfiguration": { "$ref": "DepotConfiguration" }
      },
      "specConstraint": "At least one of vmwareAccount or offlineAccount must be provided."
    }
  },
  "retryPolicy": {
    "operationId": "updateDepotSettings",
    "method": "PUT",
    "stableResourcePath": "/v1/system/settings/depot",
    "reuseSameRepresentation": true,
    "retryStatusCodes": [408, 429, "5xx"],
    "retryAmbiguousTransportFailure": true,
    "doNotRetryOther4xx": true
  }
}

+            VcenterRoleClient._protocol_error(
+                "role item has an invalid role identifier"
+            )
+        if not isinstance(info, dict):
+            VcenterRoleClient._protocol_error(
+                "role item has invalid info"
+            )
+        name = info.get("name")
+        description = info.get("description")
+        privileges = info.get("privileges")
+        system = info.get("system")
+        if not isinstance(name, str) or not name.strip():
+            VcenterRoleClient._protocol_error(
+                "role info has an invalid name"
+            )
+        if not isinstance(description, str):
+            VcenterRoleClient._protocol_error(
+                "role info has an invalid description"
+            )
+        if (
+            not isinstance(privileges, list)
+            or any(not isinstance(value, str) for value in privileges)
+            or len(set(privileges)) != len(privileges)
+        ):
+            VcenterRoleClient._protocol_error(
+                "role info has invalid privileges"
+            )
+        if not isinstance(system, bool):
+            VcenterRoleClient._protocol_error(
+                "role info has an invalid system flag"
+            )
+
+    @staticmethod
+    def _role_sort_key(
+        item: dict[str, Any],
+    ) -> tuple[str, str, str]:
+        return (
+            item["info"]["name"],
+            item["role"],
+            json.dumps(

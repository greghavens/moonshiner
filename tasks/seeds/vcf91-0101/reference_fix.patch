+
+    def _request_page(
+        self,
+        *,
+        page_size: int,
+        marker: str | None,
+    ) -> Any:
+        query = "page_size=" + str(page_size)
+        if marker is not None:
+            query += "&marker=" + quote(marker, safe="")
+        request = Request(
+            self._base_url
+            + "/api/vcenter/authorization/roles?"
+            + query,
+            method="GET",
+            headers={
+                "Accept": "application/json",
+                "vmware-api-session-id": self._session_token,
+            },
+        )
+        try:
+            with self._opener.open(
+                request,
+                timeout=self._timeout,
+            ) as response:
+                status = response.getcode()
+                raw = response.read()
+        except HTTPError as exc:
+            try:
+                raw = exc.read()
+            except OSError:
+                raw = b""
+            finally:
+                exc.close()
+            raise VcenterError(
+                OPERATION_ID,
+                exc.code,
+                self._decode_error_payload(raw),
+            ) from None
+        except (URLError, OSError, ValueError):
+            raise VcenterError(OPERATION_ID, None, None) from None
+
+        if status != 200:
+            raise VcenterError(
+                OPERATION_ID,
+                status,
+                self._decode_error_payload(raw),
+            )
+        try:
+            text = raw.decode("utf-8")
+            return json.loads(
+                text,
+                parse_constant=self._reject_json_constant,
+            )
+        except (UnicodeDecodeError, json.JSONDecodeError, ValueError):
+            self._protocol_error(
+                "success response is not strict UTF-8 JSON"
+            )
+
+    @staticmethod
+    def _validate_item(item: Any) -> None:
+        if not isinstance(item, dict):
+            VcenterRoleClient._protocol_error(
+                "role items must be JSON objects"

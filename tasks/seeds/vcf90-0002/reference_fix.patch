+function Test-VcfMember {
+    param($InputObject, [string]$Name)
+    if ($null -eq $InputObject) { return $false }
+    return [bool]($InputObject.PSObject.Properties.Name -contains $Name)
+}
+
+function New-VcfQueryString {
+    <# Render only the parameters that were actually set. #>
+    param([System.Collections.IDictionary]$Query)
+    if ($null -eq $Query -or $Query.Count -eq 0) { return '' }
+    $pairs = foreach ($name in $Query.Keys) {
+        $value = $Query[$name]
+        if ($null -eq $value -or [string]::IsNullOrWhiteSpace([string]$value)) { continue }
+        '{0}={1}' -f [uri]::EscapeDataString([string]$name),
+                     [uri]::EscapeDataString([string]$value)
+    }
+    $rendered = @($pairs) -join '&'
+    if ($rendered) { return '?' + $rendered }
+    return ''
+}
+
+function Update-VcfAccessToken {
+    <# Exchange the refresh token id for a fresh access token (PATCH, bare string body). #>
+    param([Parameter(Mandatory)][hashtable]$Session)
+
+    $body = ConvertTo-Json -InputObject $Session.RefreshTokenId
+    $response = Invoke-WebRequest `
+        -Uri ($Session.BaseUri + '/v1/tokens/access-token/refresh') `
+        -Method 'PATCH' -Headers @{ 'Accept' = 'application/json' } `
+        -Body $body -ContentType 'application/json' -SkipHttpErrorCheck
+    if ([int]$response.StatusCode -ne 200) {
+        throw "Refreshing the SDDC Manager access token failed with HTTP $([int]$response.StatusCode)."
+    }
+    $Session.AccessToken = [string]($response.Content | ConvertFrom-Json)
+    $Session.TokenRefreshed = $true
+}
+
+function Invoke-VcfSddcRequest {
+    <#
+        Issue one SDDC Manager request. A single 401 triggers a token refresh
+        and an identical replay of the same request.
+    #>
+    param(
+        [Parameter(Mandatory)][hashtable]$Session,
+        [Parameter(Mandatory)][string]$Method,
+        [Parameter(Mandatory)][string]$Path,
+        [System.Collections.IDictionary]$Query,
+        [string]$Body,
+        [switch]$Anonymous
+    )
+
+    $uri = $Session.BaseUri + $Path + (New-VcfQueryString -Query $Query)
+    for ($attempt = 0; $attempt -lt 2; $attempt++) {
+        $headers = @{ 'Accept' = 'application/json' }
+        if (-not $Anonymous) {
+            $headers['Authorization'] = 'Bearer ' + $Session.AccessToken
+        }
+        $arguments = @{
+            Uri                = $uri
+            Method             = $Method
+            Headers            = $headers
+            SkipHttpErrorCheck = $true
+        }
+        if ($PSBoundParameters.ContainsKey('Body') -and -not [string]::IsNullOrEmpty($Body)) {
+            $arguments['Body'] = $Body
+            $arguments['ContentType'] = 'application/json'
+        }
+
+        $response = Invoke-WebRequest @arguments
+        $status = [int]$response.StatusCode
+
+        if ($status -eq 401 -and -not $Anonymous -and $attempt -eq 0) {
+            Update-VcfAccessToken -Session $Session
+            continue
+        }
+        if ($status -ge 400) {
+            throw "SDDC Manager returned HTTP $status for $Method $Path."
+        }
+        if ([string]::IsNullOrWhiteSpace([string]$response.Content)) { return $null }
+        return ($response.Content | ConvertFrom-Json)
+    }
+}
+
+function Get-VcfCredentialPage {
+    <# Page through every credential of one resource type. #>
+    param(
+        [Parameter(Mandatory)][hashtable]$Session,
+        [Parameter(Mandatory)][string]$ResourceType,
+        [Parameter(Mandatory)][int]$PageSize
+    )
+
+    $collected = [System.Collections.Generic.List[object]]::new()
+    $pageNumber = 0
+    while ($true) {
+        $query = [ordered]@{
+            resourceType = $ResourceType
+            pageNumber   = [string]$pageNumber
+            pageSize     = [string]$PageSize
+        }
+        $page = Invoke-VcfSddcRequest -Session $Session -Method 'GET' `
+            -Path '/v1/credentials' -Query $query
+
+        if ((Test-VcfMember $page 'elements') -and $null -ne $page.elements) {
+            foreach ($element in @($page.elements)) { $collected.Add($element) | Out-Null }
+        }
+
+        $totalPages = 1
+        if ((Test-VcfMember $page 'pageMetadata') -and $null -ne $page.pageMetadata -and
+            (Test-VcfMember $page.pageMetadata 'totalPages')) {
+            $totalPages = [int]$page.pageMetadata.totalPages
+        }
+        $pageNumber++
+        if ($pageNumber -ge $totalPages) { break }
+    }
+    return $collected
+}
+
+function Wait-VcfCredentialsTask {
+    param(
+        [Parameter(Mandatory)][hashtable]$Session,
+        [Parameter(Mandatory)][string]$TaskId,
+        [Parameter(Mandatory)][int]$MaxPolls,
+        [scriptblock]$SleepAction
+    )
+
+    for ($poll = 1; $poll -le $MaxPolls; $poll++) {
+        $task = Invoke-VcfSddcRequest -Session $Session -Method 'GET' `
+            -Path ('/v1/credentials/tasks/' + [uri]::EscapeDataString($TaskId))
+
+        $status = ''
+        if (Test-VcfMember $task 'status') {
+            $status = ([string]$task.status).Trim().ToUpperInvariant() -replace ' ', '_'
+        }
+        if ($script:TerminalTaskStates -contains $status) {
+            if ($status -ne 'SUCCESSFUL') {
+                throw "Credential rotation task '$TaskId' finished with status $status."
+            }
+            return $status
+        }
+        if ($poll -lt $MaxPolls) {
+            if ($null -ne $SleepAction) { & $SleepAction 5 } else { Start-Sleep -Seconds 5 }
+        }
+    }
+    throw "Credential rotation task '$TaskId' did not reach a terminal state within $MaxPolls polls."
+}

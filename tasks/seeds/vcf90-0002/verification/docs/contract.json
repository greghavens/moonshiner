  "wireRules": {
    "omitUnsetOptionalFields": "An optional property or query parameter that has no value MUST be absent from the request. Never send it as null, as an empty string, or as an empty object.",
    "refreshAccessTokenBody": "refreshAccessToken uses PATCH and its request body is a bare JSON string holding the refresh token id, for example \"<id>\". It is not an object and must not be double-encoded.",
    "rotateOmitsPassword": "A ROTATE operation asks SDDC Manager to generate the new password, so BaseCredential.password MUST be absent from the request."
  }

  "authorization": {
    "scheme": "Bearer",
    "header": "Authorization",
    "note": "The pinned specification declares no components.securitySchemes. Every operation in scope except createToken and refreshAccessToken documents a 401 response and is called with the SDDC Manager access token as 'Authorization: Bearer <accessToken>'."
  },
  "operations": {
    "createToken": {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "summary": "Create Token Pair",
      "requestBody": {
        "required": true,
        "schema": "TokenCreationSpec"
      },
      "responses": {
        "201": {
          "description": "Created",
          "schema": "TokenPair"
        },
        "400": {
          "description": "Bad Request",
          "schema": "Error"
        },
        "500": {
          "description": "Internal Server Error",
          "schema": "Error"
        }
      }
    },
    "refreshAccessToken": {
      "operationId": "refreshAccessToken",
      "method": "PATCH",
      "path": "/v1/tokens/access-token/refresh",
      "summary": "Refresh Access Token",
      "requestBody": {
        "required": true,
        "schema": "string",
        "encoding": "bare JSON string; the entire body is one JSON-encoded string, not an object",
        "description": "ID of the refresh token"
      },
      "responses": {
        "200": {
          "description": "OK",
          "schema": "string"
        },
        "404": {
          "description": "Not Found",
          "schema": "Error"
        },
        "400": {
          "description": "Bad Request",
          "schema": "Error"
        },
        "500": {
          "description": "Internal Server Error",
          "schema": "Error"
        }
      }
    },
    "getCredentials": {
      "operationId": "getCredentials",
      "method": "GET",
      "path": "/v1/credentials",
      "summary": "Retrieve a list of credentials",
      "parameters": [
        {
          "name": "resourceName",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "resourceIp",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "resourceType",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "domainName",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "pageNumber",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "accountType",
          "in": "query",
          "required": false,
          "type": "string"
        }
      ],
      "responses": {
        "200": {
          "description": "Ok",
          "schema": "PageOfCredential"
        },
        "500": {
          "description": "InternalServerError",
          "schema": "Error"
        },
        "401": {
          "description": "Unauthorized",
          "schema": "Error"
        },
        "403": {
          "description": "Forbidden",
          "schema": "Error"
        },
        "400": {
          "description": "Bad Request",
          "schema": "Error"
        }
      }
    },
    "updateOrRotatePasswords": {
      "operationId": "updateOrRotatePasswords",
      "method": "PATCH",
      "path": "/v1/credentials",
      "summary": "Update or rotate passwords for a list of resources",
      "requestBody": {
        "required": true,
        "schema": "CredentialsUpdateSpec"
      },
      "responses": {
        "500": {
          "description": "InternalServerError",
          "schema": "Error"
        },
        "401": {
          "description": "Unauthorized",
          "schema": "Error"
        },
        "202": {
          "description": "Accepted",
          "schema": "Task"
        },
        "403": {
          "description": "Forbidden",
          "schema": "Error"
        },
        "400": {
          "description": "Bad Request",
          "schema": "Error"
        }
      }
    },
    "getCredentialsTask": {
      "operationId": "getCredentialsTask",
      "method": "GET",

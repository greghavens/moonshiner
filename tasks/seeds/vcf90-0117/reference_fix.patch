diff --git a/src/VsanDataProtection/VsanDataProtection.psm1 b/src/VsanDataProtection/VsanDataProtection.psm1
--- a/src/VsanDataProtection/VsanDataProtection.psm1
+++ b/src/VsanDataProtection/VsanDataProtection.psm1
@@ -27,7 +27,55 @@ function New-VsanProtectionGroupSnapshot {
         [int] $PollIntervalMilliseconds = 0
     )
 
-    throw 'New-VsanProtectionGroupSnapshot has not been implemented.'
+    $requestDocument = [ordered]@{
+        name = $Name
+    }
+    $requestJson = $requestDocument | ConvertTo-Json -Depth 4 -Compress
+
+    $origin = $ServerUri.AbsoluteUri.TrimEnd('/')
+    $clusterSegment = [uri]::EscapeDataString($ClusterId)
+    $protectionGroupSegment = [uri]::EscapeDataString($ProtectionGroupId)
+    $headers = [ordered]@{
+        Accept = 'application/json'
+        'vmware-api-session-id' = $SessionId
+    }
+    $createUri = "$origin/api/snapservice/clusters/$clusterSegment/protection-groups/$protectionGroupSegment/snapshots?vmw-task=true"
+
+    $taskId = Invoke-RestMethod `
+        -Uri $createUri `
+        -Method Post `
+        -Headers $headers `
+        -ContentType 'application/json' `
+        -Body $requestJson
+    if ([string]::IsNullOrWhiteSpace([string] $taskId)) {
+        throw 'The snapshot create operation returned an empty task identifier.'
+    }
+
+    $taskReference = Initialize-VcfAssociatedTask -TaskId ([string] $taskId)
+    $taskSegment = [uri]::EscapeDataString([string] $taskReference.TaskId)
+    $taskUri = "$origin/api/snapservice/tasks/$taskSegment"
+    $nonTerminalStatuses = @('PENDING', 'RUNNING', 'BLOCKED')
+
+    while ($true) {
+        $task = Invoke-RestMethod `
+            -Uri $taskUri `
+            -Method Get `
+            -Headers $headers
+        $status = [string] $task.status
+
+        if ($status -ceq 'SUCCEEDED') {
+            return $task
+        }
+        if ($status -ceq 'FAILED') {
+            throw "The vSAN Data Protection snapshot task '$($taskReference.TaskId)' failed."
+        }
+        if ($nonTerminalStatuses -cnotcontains $status) {
+            throw "The vSAN Data Protection snapshot task returned unsupported status '$status'."
+        }
+        if ($PollIntervalMilliseconds -gt 0) {
+            Start-Sleep -Milliseconds $PollIntervalMilliseconds
+        }
+    }
 }
 
 Export-ModuleMember -Function New-VsanProtectionGroupSnapshot

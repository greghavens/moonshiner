{
  "openapi": "3.0.3",
  "title": "Snapshot Appliance API",
  "version": "9.0.0.0",
  "basePath": "/api",
  "operations": {
    "Snapservice.Clusters.ProtectionGroups.Snapshots_create$Task": {
      "method": "POST",
      "path": "/snapservice/clusters/{cluster}/protection-groups/{pg}/snapshots?vmw-task=true",
      "pathParameters": {
        "cluster": {
          "required": true,
          "type": "string"
        },
        "pg": {
          "required": true,
          "type": "string"
        }
      },
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "Snapservice.Clusters.ProtectionGroups.Snapshots.CreateSpec"
      },
      "successResponse": {
        "status": 202,
        "type": "string"
      },
      "security": {
        "scheme": "api_key_auth",
        "header": "vmware-api-session-id"
      }
    },
    "Snapservice.Tasks_get": {
      "method": "GET",
      "path": "/snapservice/tasks/{task}",
      "pathParameters": {
        "task": {
          "required": true,
          "type": "string"
        }
      },
      "successResponse": {
        "status": 200,
        "schema": "Snapservice.Tasks.Info"
      },
      "security": {
        "scheme": "api_key_auth",
        "header": "vmware-api-session-id"
      }
    }
  },
  "schemas": {
    "Snapservice.Clusters.ProtectionGroups.Snapshots.CreateSpec": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "retention": {
          "schema": "Snapservice.RetentionPeriod",
          "required": false
        }
      }
    },
    "Snapservice.RetentionPeriod": {
      "type": "object",
      "required": [
        "duration",
        "unit"
      ],
      "properties": {
        "unit": {
          "type": "string",
          "enum": [
            "MINUTE",
            "HOUR",
            "DAY",
            "WEEK",
            "MONTH"
          ]
        },
        "duration": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "Snapservice.Tasks.Info": {
      "type": "object",
      "required": [
        "cancelable",
        "description",
        "operation",
        "service",
        "status"
      ],
      "properties": {
        "progress": {
          "schema": "Snapservice.Tasks.Progress"
        },
        "result": {},
        "vc_task": {
          "type": "string"
        },
        "description": {
          "schema": "Vapi.Std.LocalizableMessage"
        },
        "service": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "parent": {
          "type": "string"
        },
        "target": {
          "schema": "Vapi.Std.DynamicID"
        },
        "status": {
          "type": "string"
        },
        "cancelable": {
          "type": "boolean"
        },
        "error": {
          "type": "object"
        },
        "start_time": {
          "type": "string",
          "format": "date-time"
        },
        "end_time": {
          "type": "string",
          "format": "date-time"
        },
        "user": {
          "type": "string"
        }
      },
      "statusValues": [
        "PENDING",
        "RUNNING",
        "BLOCKED",
        "SUCCEEDED",
        "FAILED"
      ]
    }
  }
}

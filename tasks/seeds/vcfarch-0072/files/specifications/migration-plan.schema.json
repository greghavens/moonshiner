{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.local/schemas/vcf-migration-plan-1.0.json",
  "title": "Pinned VCF Brownfield Migration Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "estateId",
    "sourceVcfVersion",
    "targetVcfVersion",
    "upgradeHops",
    "storageDecision",
    "targetSddcSpec",
    "gates",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "planId": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z0-9-]+$"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "sourceVcfVersion": {
      "type": "string",
      "minLength": 1
    },
    "targetVcfVersion": {
      "type": "string",
      "minLength": 1
    },
    "upgradeHops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1}
        }
      }
    },
    "storageDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "rejected", "migrationMode", "source", "target"],
      "properties": {
        "selected": {"enum": ["OSA", "ESA"]},
        "rejected": {"enum": ["OSA", "ESA"]},
        "migrationMode": {"enum": ["IN_PLACE", "SIDE_BY_SIDE"]},
        "source": {"$ref": "#/definitions/storageShape"},
        "target": {
          "allOf": [
            {"$ref": "#/definitions/storageShape"},
            {
              "type": "object",
              "required": ["readyNodeProfile", "vlanId", "mtu"],
              "properties": {
                "readyNodeProfile": {"type": "string", "minLength": 1},
                "vlanId": {"type": "integer", "minimum": 0, "maximum": 4094},
                "mtu": {"type": "integer", "minimum": 1280, "maximum": 9190}
              }
            }
          ]
        }
      }
    },
    "targetSddcSpec": {
      "type": "object"
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/gate"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/step"}
    }
  },
  "definitions": {
    "storageShape": {
      "type": "object",
      "required": ["architecture", "hostCount", "linkSpeedGbps"],
      "properties": {
        "architecture": {"enum": ["OSA", "ESA"]},
        "hostCount": {"type": "integer", "minimum": 1},
        "linkSpeedGbps": {"type": "integer", "minimum": 1}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "statement", "requires"],
      "properties": {
        "id": {"type": "string", "pattern": "^G-[A-Z0-9-]+$"},
        "kind": {"enum": ["VERSION", "DEPENDENCY", "CAPACITY", "NETWORK", "MIGRATION"]},
        "statement": {"type": "string", "minLength": 12},
        "requires": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "componentId",
        "componentName",
        "componentType",
        "fromVersion",
        "targetVersion",
        "action",
        "gates"
      ],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "componentId": {"type": "string", "minLength": 1},
        "componentName": {"type": "string", "minLength": 1},
        "componentType": {"type": "string", "minLength": 1},
        "fromVersion": {"type": "string", "minLength": 1},
        "targetVersion": {"type": "string", "minLength": 1},
        "action": {"enum": ["UPGRADE", "DEPLOY", "BUILD_AND_MIGRATE", "DECOMMISSION"]},
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^G-[A-Z0-9-]+$"}
        }
      }
    }
  }
}

diff --git a/VcfArchitecture/VcfArchitecture.psm1 b/VcfArchitecture/VcfArchitecture.psm1
new file mode 100644
index 0000000..6fbf156
--- /dev/null
+++ b/VcfArchitecture/VcfArchitecture.psm1
@@ -0,0 +1,210 @@
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+function Read-VcfJsonFile {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $Path
+    )
+
+    $resolved = $ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($Path)
+    if (-not (Test-Path -LiteralPath $resolved -PathType Leaf)) {
+        throw "JSON input does not exist: $Path"
+    }
+
+    return Get-Content -LiteralPath $resolved -Raw -Encoding utf8 | ConvertFrom-Json -Depth 100
+}
+
+function Get-VcfEstateInventory {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $Server,
+
+        [Parameter(Mandatory)]
+        [pscredential] $Credential
+    )
+
+    $connection = Connect-VcfSddcManagerServer -Server $Server -Credential $Credential -NotDefault
+    try {
+        $domains = @(Get-SddcDomain -Server $connection)
+        $clusters = @(Get-SddcCluster -Server $connection)
+        $hosts = @(Get-SddcHost -Server $connection)
+        $vcenters = @(Get-SddcVcenter -Server $connection)
+
+        [pscustomobject][ordered]@{
+            server = $Server
+            collectedAtUtc = [datetime]::UtcNow.ToString('o')
+            domains = $domains
+            clusters = $clusters
+            hosts = $hosts
+            vcenters = $vcenters
+        }
+    }
+    finally {
+        Disconnect-VcfSddcManagerServer -Server $connection -Force | Out-Null
+    }
+}
+
+function New-VcfMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $InventoryPath,
+
+        [Parameter(Mandatory)]
+        [string] $CompatibilitySnapshotPath,
+
+        [Parameter(Mandatory)]
+        [string] $OutputPath
+    )
+
+    $inventory = Read-VcfJsonFile -Path $InventoryPath
+    $snapshot = Read-VcfJsonFile -Path $CompatibilitySnapshotPath
+
+    if ($inventory.sourceVcfVersion -ne $snapshot.sourceVcfVersion) {
+        throw "Inventory source version does not match the compatibility snapshot"
+    }
+    if ($inventory.targetVcfVersion -ne $snapshot.targetVcfVersion) {
+        throw "Inventory target version does not match the compatibility snapshot"
+    }
+
+    $components = @{}
+    foreach ($component in @($inventory.components)) {
+        if ($components.ContainsKey($component.id)) {
+            throw "Duplicate inventory component id: $($component.id)"
+        }
+        $components[$component.id] = $component
+    }
+
+    $steps = @()
+    $order = 1
+    foreach ($componentId in @($snapshot.componentSequence)) {
+        if (-not $components.ContainsKey($componentId)) {
+            throw "Compatibility sequence names an unknown component: $componentId"
+        }
+        $component = $components[$componentId]
+        $steps += [ordered]@{
+            order = $order
+            componentId = [string] $component.id
+            componentName = [string] $component.name
+            componentType = [string] $component.type
+            fromVersion = [string] $component.version
+            targetVersion = [string] $component.targetVersion
+            action = [string] $snapshot.componentActions.$componentId
+            gates = @($snapshot.componentGates.$componentId)
+        }
+        $order += 1
+    }
+
+    if ($steps.Count -ne $components.Count) {
+        throw "The compatibility sequence must cover every inventory component exactly once"
+    }
+
+    $targetInputs = $inventory.targetSpecInputs
+    $esaInput = $inventory.storageDecisionInputs.esaOption
+    $currentStorage = $inventory.storageDecisionInputs.current
+    $esaRule = $snapshot.storageOptions.ESA
+
+    $hostSpecs = @(
+        foreach ($hostname in @($esaInput.hostnames)) {
+            [ordered]@{ hostname = [string] $hostname }
+        }
+    )
+
+    $targetSddcSpec = [ordered]@{
+        sddcId = [string] $targetInputs.sddcId
+        workflowType = 'VCF_COMPLETE'
+        hostSpecs = $hostSpecs
+        version = [string] $snapshot.targetVcfVersion
+        vcenterSpec = [ordered]@{
+            vcenterHostname = [string] $targetInputs.vcenterHostname
+            rootVcenterPassword = 'REDACTED-FIXTURE'
+            version = [string] $snapshot.targetVcfVersion
+            useExistingDeployment = $true
+        }
+        clusterSpec = [ordered]@{
+            datacenterName = 'chi01-production-dc'
+            clusterName = 'chi01-w02-esa'
+        }
+        dvsSpecs = @(
+            [ordered]@{
+                dvsName = 'chi01-w02-system-vds'
+                networks = @('MANAGEMENT', 'VMOTION')
+                mtu = 9000
+                vmnicsToUplinks = @(
+                    [ordered]@{ id = 'vmnic0'; uplink = 'uplink1' },
+                    [ordered]@{ id = 'vmnic1'; uplink = 'uplink2' }
+                )
+            },
+            [ordered]@{
+                dvsName = 'chi01-w02-storage-vds'
+                networks = @('VSAN')
+                mtu = [int] $esaRule.requiredMtu
+                vmnicsToUplinks = @(
+                    [ordered]@{ id = 'vmnic2'; uplink = 'uplink1' },
+                    [ordered]@{ id = 'vmnic3'; uplink = 'uplink2' }
+                )
+            }
+        )
+        networkSpecs = @($targetInputs.networks)
+        dnsSpec = [ordered]@{
+            subdomain = [string] $targetInputs.subdomain
+            nameservers = @($targetInputs.nameservers)
+        }
+        ntpServers = @($targetInputs.ntpServers)
+        managementPoolName = 'chi01-w02-management-pool'
+        ceipEnabled = $false
+        skipEsxThumbprintValidation = $false
+        skipGatewayPingValidation = $false
+        datastoreSpec = [ordered]@{
+            vsanSpec = [ordered]@{
+                datastoreName = 'chi01-w02-vsan-esa'
+                esaConfig = [ordered]@{ enabled = $true }
+                failuresToTolerate = 1
+            }
+        }
+    }
+
+    $plan = [ordered]@{
+        schemaVersion = '1.0'
+        planId = "$($inventory.estateId.ToLowerInvariant())-521-to-910-esa"
+        estateId = [string] $inventory.estateId
+        sourceVcfVersion = [string] $inventory.sourceVcfVersion
+        targetVcfVersion = [string] $inventory.targetVcfVersion
+        upgradeHops = @($snapshot.supportedUpgradeHops)
+        storageDecision = [ordered]@{
+            selected = [string] $snapshot.selectedStorageArchitecture
+            rejected = 'OSA'
+            migrationMode = [string] $esaRule.migrationMode
+            source = [ordered]@{
+                architecture = [string] $currentStorage.architecture
+                hostCount = [int] $currentStorage.hostCount
+                linkSpeedGbps = [int] $currentStorage.linkSpeedGbps
+            }
+            target = [ordered]@{
+                architecture = 'ESA'
+                hostCount = [int] $esaRule.minimumHostCount
+                linkSpeedGbps = [int] $esaRule.minimumLinkSpeedGbps
+                readyNodeProfile = [string] $esaRule.readyNodeProfile
+                vlanId = [int] $esaInput.vlanId
+                mtu = [int] $esaRule.requiredMtu
+            }
+        }
+        targetSddcSpec = $targetSddcSpec
+        gates = @($snapshot.gates)
+        steps = $steps
+    }
+
+    $resolvedOutput = $ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($OutputPath)
+    $parent = Split-Path -Parent $resolvedOutput
+    if ($parent) {
+        New-Item -ItemType Directory -Path $parent -Force | Out-Null
+    }
+    $json = $plan | ConvertTo-Json -Depth 100
+    Set-Content -LiteralPath $resolvedOutput -Value $json -Encoding utf8
+    return [pscustomobject] $plan
+}
+
+Export-ModuleMember -Function Get-VcfEstateInventory, New-VcfMigrationPlan

+    Author = 'VCF Architecture Team'
+    Description = 'Builds a pinned VCF brownfield migration architecture and reads live SDDC Manager inventory.'
+    PowerShellVersion = '7.2'
+    RequiredModules = @('VMware.Sdk.Vcf.SddcManager')
+    FunctionsToExport = @(
+        'Get-VcfEstateInventory'
+        'New-VcfMigrationPlan'
+    )

+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+function Read-JsonDocument {
+    param([Parameter(Mandatory)][string]$Path)
+
+    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {
+        throw "JSON input does not exist: $Path"
+    }
+    Get-Content -LiteralPath $Path -Raw | ConvertFrom-Json
+}
+
+function Write-JsonDocument {
+    param(
+        [Parameter(Mandatory)]$Document,
+        [Parameter(Mandatory)][string]$Path
+    )
+
+    $Document | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $Path -Encoding utf8
+}
+
+function Get-SingleMatch {
+    param(
+        [Parameter(Mandatory)][object[]]$Values,
+        [Parameter(Mandatory)][scriptblock]$Predicate,
+        [Parameter(Mandatory)][string]$Description
+    )
+
+    $matches = @($Values | Where-Object $Predicate)
+    if ($matches.Count -ne 1) {
+        throw "Expected one $Description; found $($matches.Count)."
+    }
+    $matches[0]
+}
+
+function New-SddcSpecDocument {
+    param([Parameter(Mandatory)]$Requirements)
+
+    $management = $Requirements.managementDomain
+    $passwords = $management.passwordPlaceholders
+
+    $hosts = foreach ($hostname in $management.hostnames) {
+        [ordered]@{
+            hostname    = $hostname
+            credentials = [ordered]@{
+                username = 'root'
+                password = $passwords.esxiRoot
+            }
+        }
+    }
+
+    $networks = foreach ($network in $Requirements.networks) {
+        $document = [ordered]@{
+            networkType            = $network.networkType
+            subnet                 = $network.subnet
+            gateway                = $network.gateway
+            vlanId                 = [int]$network.vlanId
+            mtu                    = [int]$network.mtu
+            teamingPolicy          = 'loadbalance_loadbased'
+            activeUplinks          = @('uplink1', 'uplink2', 'uplink3', 'uplink4')
+            standbyUplinks         = @()
+            portGroupKey           = $network.portGroupKey
+            ipAddressVersion       = 'IPv4'
+            ipAddressAssignmentMode = 'STATIC'
+        }
+        if ($null -ne $network.PSObject.Properties['ipRange']) {
+            $document.includeIpAddressRanges = @(
+                [ordered]@{
+                    startIpAddress = $network.ipRange.start
+                    endIpAddress   = $network.ipRange.end
+                }
+            )
+        }
+        $document
+    }
+
+    $nsxManagers = foreach ($hostname in $management.nsxManagerHostnames) {
+        [ordered]@{ hostname = $hostname }
+    }
+    $operationsTypes = @('master', 'replica', 'data')
+    $operationsNodes = for ($index = 0; $index -lt $management.operationsHostnames.Count; $index++) {
+        [ordered]@{
+            hostname         = $management.operationsHostnames[$index]
+            rootUserPassword = $passwords.operationsRoot
+            type             = $operationsTypes[$index]
+        }
+    }
+
+    [ordered]@{
+        sddcId                         = $management.sddcId
+        vcfInstanceName                = $management.vcfInstanceName
+        workflowType                   = 'VCF'
+        version                        = $Requirements.targetBundleVersion
+        ceipEnabled                    = [bool]$management.ceipEnabled
+        skipEsxThumbprintValidation    = $false
+        skipGatewayPingValidation      = $false
+        hostSpecs                      = @($hosts)
+        dnsSpec                        = [ordered]@{
+            subdomain   = $Requirements.targetSite.dnsSubdomain
+            nameservers = @($Requirements.targetSite.dnsServers)
+        }
+        ntpServers                     = @($Requirements.targetSite.ntpServers)
+        vcenterSpec                    = [ordered]@{
+            vcenterHostname      = $management.vcenterHostname
+            rootVcenterPassword  = $passwords.vcenterRoot
+            vmSize               = $management.vcenterVmSize
+            storageSize          = 'lstorage'
+            ssoDomain            = $management.ssoDomain
+            adminUserSsoPassword = $passwords.vcenterSso
+            version              = $Requirements.targetBundleVersion
+            useExistingDeployment = $false
+        }
+        clusterSpec                    = [ordered]@{
+            datacenterName = $management.datacenterName
+            clusterName    = $management.clusterName
+        }
+        datastoreSpec                  = [ordered]@{
+            vsanSpec = [ordered]@{
+                datastoreName       = $management.datastoreName
+                vsanDedup           = $false
+                failuresToTolerate  = [int]$Requirements.availability.managementHostFailuresToTolerate
+                esaConfig           = [ordered]@{ enabled = $true }
+            }
+        }
+        networkSpecs                   = @($networks)
+        dvsSpecs                       = @(
+            [ordered]@{
+                dvsName          = $Requirements.distributedSwitch.name
+                networks         = @($Requirements.networks.networkType)
+                mtu              = [int]$Requirements.distributedSwitch.mtu
+                vmnicsToUplinks  = @($Requirements.distributedSwitch.vmnicsToUplinks | ForEach-Object {
+                    [ordered]@{ id = $_.id; uplink = $_.uplink }
+                })
+            }
+        )
+        nsxtSpec                       = [ordered]@{
+            nsxtManagers            = @($nsxManagers)
+            nsxtManagerSize         = $management.nsxManagerSize
+            vipFqdn                 = $management.nsxVipFqdn
+            rootNsxtManagerPassword = $passwords.nsxRoot
+            nsxtAdminPassword       = $passwords.nsxAdmin
+            nsxtAuditPassword       = $passwords.nsxAudit
+            transportVlanId         = [int]$Requirements.nsxHostOverlay.transportVlanId
+            ipAddressPoolSpec       = [ordered]@{
+                name        = $Requirements.nsxHostOverlay.poolName
+                description = 'Management-domain ESXi host-overlay TEP pool'
+                subnets     = @(
+                    [ordered]@{
+                        cidr                = $Requirements.nsxHostOverlay.cidr
+                        gateway             = $Requirements.nsxHostOverlay.gateway
+                        ipAddressPoolRanges = @(
+                            [ordered]@{
+                                start = $Requirements.nsxHostOverlay.rangeStart
+                                end   = $Requirements.nsxHostOverlay.rangeEnd
+                            }
+                        )
+                    }
+                )
+            }
+            version                   = $Requirements.targetBundleVersion
+            useExistingDeployment     = $false
+        }
+        sddcManagerSpec                = [ordered]@{
+            hostname              = $management.sddcManagerHostname
+            localUserPassword     = $passwords.sddcLocal
+            version               = $Requirements.targetBundleVersion
+            useExistingDeployment = [bool]$management.installerBecomesSddcManager
+        }
+        vcfOperationsSpec              = [ordered]@{
+            nodes                 = @($operationsNodes)
+            adminUserPassword     = $passwords.operationsAdmin
+            applianceSize         = $management.operationsApplianceSize
+            loadBalancerFqdn      = $management.operationsLoadBalancerFqdn
+            useExistingDeployment = $false
+            version               = $Requirements.targetBundleVersion
+        }
+        vspClusterSpec                 = [ordered]@{
+            platformFqdn            = $management.vspPlatformFqdn
+            instanceFqdn            = $management.vspInstanceFqdn
+            fleetFqdn               = $management.vspFleetFqdn
+            systemUserPassword      = $passwords.vspSystem
+            ipv4Pool                = [ordered]@{
+                ipRange = [ordered]@{
+                    startIpAddress = $management.managementServicesIpRange.start
+                    endIpAddress   = $management.managementServicesIpRange.end
+                }
+            }
+            size                    = 'small'
+            internalClusterCidrIpv4 = $management.internalServicesCidr
+            version                 = $Requirements.targetBundleVersion
+            useExistingDeployment   = $false
+        }
+        fleetLcmSpec                   = [ordered]@{ version = $Requirements.targetBundleVersion; size = 'small' }
+        sddcLcmSpec                    = [ordered]@{ version = $Requirements.targetBundleVersion; size = 'small' }
+        fleetDepotSpec                 = [ordered]@{ version = $Requirements.targetBundleVersion; size = 'small' }
+        telemetryAcceptorSpec          = [ordered]@{ version = $Requirements.targetBundleVersion; size = 'small' }
+        vidbSpec                        = [ordered]@{
+            hostname = $management.vidbHostname
+            version  = $Requirements.targetBundleVersion
+            size     = 'small'
+        }
+        licenseServerSpec              = [ordered]@{
+            hostname              = $management.licenseServerHostname
+            version               = $Requirements.targetBundleVersion
+            useExistingDeployment = $false
+        }
+    }
+}
+
+function ConvertTo-VcfSdkSddcSpec {
+    param([Parameter(Mandatory)]$Document)
+
+    $sdkHosts = foreach ($hostSpec in $Document.hostSpecs) {
+        $credentials = Initialize-VcfInstallerSddcCredentials -Username $hostSpec.credentials.username -Password $hostSpec.credentials.password
+        Initialize-VcfInstallerSddcHostSpec -Hostname $hostSpec.hostname -Credentials $credentials
+    }
+    $sdkDns = Initialize-VcfInstallerDnsSpec -Subdomain $Document.dnsSpec.subdomain -Nameservers @($Document.dnsSpec.nameservers)
+    $sdkVcenter = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname $Document.vcenterSpec.vcenterHostname `
+        -RootVcenterPassword $Document.vcenterSpec.rootVcenterPassword `
+        -VmSize $Document.vcenterSpec.vmSize `
+        -StorageSize $Document.vcenterSpec.storageSize `
+        -SsoDomain $Document.vcenterSpec.ssoDomain `
+        -AdminUserSsoPassword $Document.vcenterSpec.adminUserSsoPassword `
+        -Version $Document.vcenterSpec.version `
+        -UseExistingDeployment $Document.vcenterSpec.useExistingDeployment
+    $sdkCluster = Initialize-VcfInstallerSddcClusterSpec -DatacenterName $Document.clusterSpec.datacenterName -ClusterName $Document.clusterSpec.clusterName
+
+    $sdkNetworks = foreach ($networkSpec in $Document.networkSpecs) {
+        $networkArguments = @{
+            NetworkType             = $networkSpec.networkType
+            Subnet                  = $networkSpec.subnet
+            Gateway                 = $networkSpec.gateway
+            VlanId                  = [uint]$networkSpec.vlanId
+            Mtu                     = [int]$networkSpec.mtu
+            TeamingPolicy           = $networkSpec.teamingPolicy
+            ActiveUplinks           = @($networkSpec.activeUplinks)
+            StandbyUplinks          = @($networkSpec.standbyUplinks)
+            PortGroupKey            = $networkSpec.portGroupKey
+            IpAddressVersion        = $networkSpec.ipAddressVersion
+            IpAddressAssignmentMode = $networkSpec.ipAddressAssignmentMode
+        }
+        if ($null -ne $networkSpec.PSObject.Properties['includeIpAddressRanges']) {
+            $networkArguments.IncludeIpAddressRanges = @($networkSpec.includeIpAddressRanges | ForEach-Object {
+                Initialize-VcfInstallerIpRange -StartIpAddress $_.startIpAddress -EndIpAddress $_.endIpAddress
+            })
+        }
+        Initialize-VcfInstallerSddcNetworkSpec @networkArguments
+    }
+
+    $sdkDvs = foreach ($dvsSpec in $Document.dvsSpecs) {
+        $mappings = @($dvsSpec.vmnicsToUplinks | ForEach-Object {
+            Initialize-VcfInstallerVmnicToUplink -Id $_.id -Uplink $_.uplink
+        })
+        Initialize-VcfInstallerDvsSpec -DvsName $dvsSpec.dvsName -Networks @($dvsSpec.networks) -Mtu $dvsSpec.mtu -VmnicsToUplinks $mappings
+    }
+
+    $sdkNsxManagers = @($Document.nsxtSpec.nsxtManagers | ForEach-Object {
+        Initialize-VcfInstallerNsxtManagerSpec -Hostname $_.hostname
+    })
+    $tepRanges = @($Document.nsxtSpec.ipAddressPoolSpec.subnets[0].ipAddressPoolRanges | ForEach-Object {
+        Initialize-VcfInstallerIpAddressPoolRangeSpec -Start $_.start -VarEnd $_.end
+    })
+    $tepSubnet = Initialize-VcfInstallerIpAddressPoolSubnetSpec `
+        -IpAddressPoolRanges $tepRanges `
+        -Cidr $Document.nsxtSpec.ipAddressPoolSpec.subnets[0].cidr `
+        -Gateway $Document.nsxtSpec.ipAddressPoolSpec.subnets[0].gateway
+    $tepPool = Initialize-VcfInstallerIpAddressPoolSpec `
+        -Name $Document.nsxtSpec.ipAddressPoolSpec.name `
+        -Description $Document.nsxtSpec.ipAddressPoolSpec.description `
+        -Subnets @($tepSubnet)
+    $sdkNsx = Initialize-VcfInstallerSddcNsxtSpec `
+        -NsxtManagers $sdkNsxManagers `
+        -NsxtManagerSize $Document.nsxtSpec.nsxtManagerSize `
+        -VipFqdn $Document.nsxtSpec.vipFqdn `
+        -RootNsxtManagerPassword $Document.nsxtSpec.rootNsxtManagerPassword `
+        -NsxtAdminPassword $Document.nsxtSpec.nsxtAdminPassword `
+        -NsxtAuditPassword $Document.nsxtSpec.nsxtAuditPassword `
+        -TransportVlanId $Document.nsxtSpec.transportVlanId `
+        -IpAddressPoolSpec $tepPool `
+        -Version $Document.nsxtSpec.version `
+        -UseExistingDeployment $Document.nsxtSpec.useExistingDeployment
+
+    $esa = Initialize-VcfInstallerVsanEsaConfig -Enabled $Document.datastoreSpec.vsanSpec.esaConfig.enabled
+    $vsan = Initialize-VcfInstallerVsanSpec `
+        -DatastoreName $Document.datastoreSpec.vsanSpec.datastoreName `
+        -VsanDedup $Document.datastoreSpec.vsanSpec.vsanDedup `
+        -EsaConfig $esa `
+        -FailuresToTolerate ([uint]$Document.datastoreSpec.vsanSpec.failuresToTolerate)
+    $sdkDatastore = Initialize-VcfInstallerSddcDatastoreSpec -VsanSpec $vsan
+    $sdkSddcManager = Initialize-VcfInstallerSddcManagerSpec `
+        -Hostname $Document.sddcManagerSpec.hostname `
+        -LocalUserPassword $Document.sddcManagerSpec.localUserPassword `
+        -Version $Document.sddcManagerSpec.version `
+        -UseExistingDeployment $Document.sddcManagerSpec.useExistingDeployment
+
+    $sdkOperationsNodes = @($Document.vcfOperationsSpec.nodes | ForEach-Object {
+        Initialize-VcfInstallerVcfOperationsNode -Hostname $_.hostname -RootUserPassword $_.rootUserPassword -Type $_.type
+    })
+    $sdkOperations = Initialize-VcfInstallerVcfOperationsSpec `
+        -Nodes $sdkOperationsNodes `
+        -AdminUserPassword $Document.vcfOperationsSpec.adminUserPassword `
+        -ApplianceSize $Document.vcfOperationsSpec.applianceSize `
+        -LoadBalancerFqdn $Document.vcfOperationsSpec.loadBalancerFqdn `
+        -UseExistingDeployment $Document.vcfOperationsSpec.useExistingDeployment `
+        -Version $Document.vcfOperationsSpec.version
+
+    $vspRange = Initialize-VcfInstallerIpRange `
+        -StartIpAddress $Document.vspClusterSpec.ipv4Pool.ipRange.startIpAddress `
+        -EndIpAddress $Document.vspClusterSpec.ipv4Pool.ipRange.endIpAddress
+    $vspPool = Initialize-VcfInstallerIPv4Pool -IpRange $vspRange
+    $sdkVsp = Initialize-VcfInstallerSddcVspClusterSpec `
+        -PlatformFqdn $Document.vspClusterSpec.platformFqdn `
+        -InstanceFqdn $Document.vspClusterSpec.instanceFqdn `
+        -FleetFqdn $Document.vspClusterSpec.fleetFqdn `
+        -SystemUserPassword $Document.vspClusterSpec.systemUserPassword `
+        -Ipv4Pool $vspPool `
+        -Size $Document.vspClusterSpec.size `
+        -InternalClusterCidrIpv4 $Document.vspClusterSpec.internalClusterCidrIpv4 `
+        -Version $Document.vspClusterSpec.version `
+        -UseExistingDeployment $Document.vspClusterSpec.useExistingDeployment
+
+    $sdkFleetLcm = Initialize-VcfInstallerFleetLcmServiceSpec -Version $Document.fleetLcmSpec.version -Size $Document.fleetLcmSpec.size
+    $sdkSddcLcm = Initialize-VcfInstallerSddcLcmServiceSpec -Version $Document.sddcLcmSpec.version -Size $Document.sddcLcmSpec.size
+    $sdkFleetDepot = Initialize-VcfInstallerFleetDepotServiceSpec -Version $Document.fleetDepotSpec.version -Size $Document.fleetDepotSpec.size
+    $sdkTelemetry = Initialize-VcfInstallerTelemetryAcceptorSpec -Version $Document.telemetryAcceptorSpec.version -Size $Document.telemetryAcceptorSpec.size
+    $sdkVidb = Initialize-VcfInstallerVidbSpec -Hostname $Document.vidbSpec.hostname -Version $Document.vidbSpec.version -Size $Document.vidbSpec.size
+    $sdkLicense = Initialize-VcfInstallerLicenseServerSpec `
+        -Hostname $Document.licenseServerSpec.hostname `
+        -Version $Document.licenseServerSpec.version `
+        -UseExistingDeployment $Document.licenseServerSpec.useExistingDeployment
+
+    Initialize-VcfInstallerSddcSpec `
+        -SddcId $Document.sddcId `
+        -VcfInstanceName $Document.vcfInstanceName `
+        -WorkflowType $Document.workflowType `
+        -Version $Document.version `
+        -HostSpecs $sdkHosts `
+        -VcenterSpec $sdkVcenter `
+        -ClusterSpec $sdkCluster `
+        -DvsSpecs $sdkDvs `
+        -NsxtSpec $sdkNsx `
+        -NetworkSpecs $sdkNetworks `
+        -DnsSpec $sdkDns `
+        -NtpServers @($Document.ntpServers) `
+        -SddcManagerSpec $sdkSddcManager `
+        -CeipEnabled $Document.ceipEnabled `
+        -SkipEsxThumbprintValidation $Document.skipEsxThumbprintValidation `
+        -SkipGatewayPingValidation $Document.skipGatewayPingValidation `
+        -DatastoreSpec $sdkDatastore `
+        -VspClusterSpec $sdkVsp `
+        -FleetLcmSpec $sdkFleetLcm `
+        -SddcLcmSpec $sdkSddcLcm `
+        -FleetDepotSpec $sdkFleetDepot `
+        -TelemetryAcceptorSpec $sdkTelemetry `
+        -VidbSpec $sdkVidb `
+        -VcfOperationsSpec $sdkOperations `
+        -LicenseServerSpec $sdkLicense
+}

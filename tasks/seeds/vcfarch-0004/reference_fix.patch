+function New-MigrationPlanDocument {
+    param(
+        [Parameter(Mandatory)]$Requirements,
+        [Parameter(Mandatory)]$Estate,
+        [Parameter(Mandatory)]$Snapshot
+    )
+
+    $demand = $Estate.workloadDemand
+    $workload = $Requirements.workloadDomain
+    $profile = $workload.hostProfile
+    $headroom = [double]$workload.headroomMultiplier
+    $failures = [int]$Requirements.availability.workloadHostFailuresToTolerate
+
+    $requiredCpu = ([double]$demand.allocatedVcpu / [double]$workload.cpuOversubscriptionRatio) * $headroom
+    $requiredMemory = [double]$demand.allocatedMemoryTiB * $headroom
+    $requiredStorage = [double]$demand.usedStorageTiB * $headroom
+    $usablePerHost = [double]$profile.rawVsanTiB * [double]$profile.vsanUsableFraction
+    $cpuHosts = [math]::Ceiling($requiredCpu / [double]$profile.physicalCores) + $failures
+    $memoryHosts = [math]::Ceiling($requiredMemory / [double]$profile.memoryTiB) + $failures
+    $storageHosts = [math]::Ceiling($requiredStorage / $usablePerHost) + $failures
+    $minimumHosts = [int][math]::Max($cpuHosts, [math]::Max($memoryHosts, $storageHosts))
+    $limitingResources = @()
+    if ($cpuHosts -eq $minimumHosts) { $limitingResources += 'cpu' }
+    if ($memoryHosts -eq $minimumHosts) { $limitingResources += 'memory' }
+    if ($storageHosts -eq $minimumHosts) { $limitingResources += 'storage' }
+
+    $componentsByType = @{}
+    foreach ($component in $Estate.components) {
+        if ($componentsByType.ContainsKey($component.componentType)) {
+            throw "Component type '$($component.componentType)' is not unique in the inventory."
+        }
+        $componentsByType[$component.componentType] = $component
+    }
+
+    $remainingTypes = [System.Collections.Generic.List[string]]::new()
+    foreach ($componentType in $componentsByType.Keys) {
+        $remainingTypes.Add($componentType)
+    }
+    $completedTypes = [System.Collections.Generic.HashSet[string]]::new()
+    $steps = @()
+    $order = 1
+    while ($remainingTypes.Count -gt 0) {
+        $readyTypes = @()
+        foreach ($componentType in $remainingTypes) {
+            $migrationRule = Get-SingleMatch @($Snapshot.migrationConstraints.componentRules) { $_.componentType -eq $componentType } "migration rule for $componentType"
+            $allReady = $true
+            foreach ($predecessorType in @($migrationRule.predecessors)) {
+                if (-not $completedTypes.Contains([string]$predecessorType)) {
+                    $allReady = $false
+                }
+            }
+            if ($allReady) {
+                $readyTypes += $componentType
+            }
+        }
+        if ($readyTypes.Count -eq 0) {
+            throw 'The pinned component dependency graph contains a cycle or missing component.'
+        }
+
+        foreach ($componentType in @($readyTypes | Sort-Object)) {
+            $component = $componentsByType[$componentType]
+            $target = Get-SingleMatch @($Snapshot.targetBundle.components) { $_.componentType -eq $componentType } "target component for $componentType"
+            $pathRule = Get-SingleMatch @($Snapshot.pathRules) {
+                $_.componentType -eq $componentType -and
+                $_.sourceVersion -eq $component.version -and
+                $_.sourceBuild -eq $component.build -and
+                $_.targetVersion -eq $target.version -and
+                $_.targetBuild -eq $target.build
+            } "compatibility path for $componentType"
+            if ($pathRule.directUpgradeSupported) {
+                throw "This greenfield migration scenario expected a blocked direct path for $componentType."
+            }
+            $migrationRule = Get-SingleMatch @($Snapshot.migrationConstraints.componentRules) { $_.componentType -eq $componentType } "migration rule for $componentType"
+            $predecessorIds = @($migrationRule.predecessors | ForEach-Object { $componentsByType[[string]$_].componentId })
+            $steps += [ordered]@{
+                order               = $order
+                componentId         = $component.componentId
+                componentType       = $component.componentType
+                productName         = $component.productName
+                sourceVersion       = $component.version
+                sourceBuild         = $component.build
+                targetVersion       = $target.version
+                targetBuild         = $target.build
+                disposition         = $pathRule.requiredDisposition
+                compatibilityReason = $pathRule.reasonCode
+                predecessors        = $predecessorIds
+                gates               = @($migrationRule.requiredTechnicalGates)
+            }
+            $order++
+            $null = $completedTypes.Add($componentType)
+            $null = $remainingTypes.Remove($componentType)
+        }
+    }
+
+    $survivingHosts = $minimumHosts - $failures
+    [ordered]@{
+        schemaVersion = '1.0'
+        inventoryId   = $Estate.inventoryId
+        targetDesign  = [ordered]@{
+            sourceSiteId                   = $Requirements.sourceSiteId
+            targetSiteId                   = $Requirements.targetSite.siteId
+            targetBundleVersion            = $Requirements.targetBundleVersion
+            strategy                       = $Snapshot.migrationConstraints.strategy
+            layer2Stretch                  = [bool]$Requirements.targetSite.layer2StretchAllowed
+            retainSourceUntilTargetValidation = [bool]$Requirements.targetSite.retainSourceUntilTargetValidation
+            availability                   = [ordered]@{
+                managementHostFailuresToTolerate = [int]$Requirements.availability.managementHostFailuresToTolerate
+                workloadHostFailuresToTolerate   = [int]$Requirements.availability.workloadHostFailuresToTolerate
+                operationsNodeCount              = [int]$Requirements.availability.operationsNodeCount
+                nsxManagerNodeCount              = [int]$Requirements.availability.nsxManagerNodeCount
+                migrationRpoHours                = [double]$Requirements.availability.migrationRpoHours
+                migrationRtoHours                = [double]$Requirements.availability.migrationRtoHours
+            }
+            capacity                       = [ordered]@{
+                managementDomainHostCount = [int]$Requirements.managementDomain.hostCount
+                minimumWorkloadHostCount  = $minimumHosts
+                selectedWorkloadHostCount = $minimumHosts
+                limitingResources         = @($limitingResources)
+                requiredWithHeadroom      = [ordered]@{
+                    physicalCores = [math]::Round($requiredCpu, 3)
+                    memoryTiB     = [math]::Round($requiredMemory, 3)
+                    usableVsanTiB = [math]::Round($requiredStorage, 3)
+                }
+                postFailureCapacity       = [ordered]@{
+                    physicalCores = [math]::Round($survivingHosts * [double]$profile.physicalCores, 3)
+                    memoryTiB     = [math]::Round($survivingHosts * [double]$profile.memoryTiB, 3)
+                    usableVsanTiB = [math]::Round($survivingHosts * $usablePerHost, 3)
+                }
+            }
+        }
+        steps         = @($steps)
+    }
+}
+
+function New-VcfArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][string]$DesignRequirementsPath,
+        [Parameter(Mandatory)][string]$EstateInventoryPath,
+        [Parameter(Mandatory)][string]$CompatibilitySnapshotPath,
+        [Parameter(Mandatory)][string]$OutputDirectory
+    )
+
+    $requirements = Read-JsonDocument $DesignRequirementsPath
+    $estate = Read-JsonDocument $EstateInventoryPath
+    $snapshot = Read-JsonDocument $CompatibilitySnapshotPath
+    if ($requirements.targetBundleVersion -ne $snapshot.targetBundle.version) {
+        throw 'The requested target bundle does not match the pinned compatibility snapshot.'
+    }
+
+    $sddcSpec = New-SddcSpecDocument $requirements
+    $null = ConvertTo-VcfSdkSddcSpec $sddcSpec
+    $migrationPlan = New-MigrationPlanDocument -Requirements $requirements -Estate $estate -Snapshot $snapshot
+
+    $null = New-Item -ItemType Directory -Path $OutputDirectory -Force
+    Write-JsonDocument -Document $sddcSpec -Path (Join-Path $OutputDirectory 'sddc-spec.json')
+    Write-JsonDocument -Document $migrationPlan -Path (Join-Path $OutputDirectory 'migration-plan.json')
+
+    [pscustomobject]@{
+        SddcSpecPath      = Join-Path $OutputDirectory 'sddc-spec.json'
+        MigrationPlanPath = Join-Path $OutputDirectory 'migration-plan.json'
+    }
+}
+
+function Test-VcfArchitectureSpec {
+    [CmdletBinding()]
+    param([Parameter(Mandatory)][string]$Path)
+
+    $document = Read-JsonDocument $Path
+    $sdkSpec = ConvertTo-VcfSdkSddcSpec $document
+    Invoke-VcfInstallerValidateSddcSpec -SddcSpec $sdkSpec
+}
+
+Export-ModuleMember -Function New-VcfArchitecture, Test-VcfArchitectureSpec

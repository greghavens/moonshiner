{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.example.com/vcfarch/migration-plan-1.0.schema.json",
  "title": "VCF Greenfield Migration Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "inventoryId",
    "targetDesign",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "inventoryId": {
      "type": "string",
      "minLength": 1
    },
    "targetDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSiteId",
        "targetSiteId",
        "targetBundleVersion",
        "strategy",
        "layer2Stretch",
        "retainSourceUntilTargetValidation",
        "availability",
        "capacity"
      ],
      "properties": {
        "sourceSiteId": {
          "type": "string",
          "minLength": 1
        },
        "targetSiteId": {
          "type": "string",
          "minLength": 1
        },
        "targetBundleVersion": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "const": "greenfield-side-by-side"
        },
        "layer2Stretch": {
          "type": "boolean"
        },
        "retainSourceUntilTargetValidation": {
          "type": "boolean"
        },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "managementHostFailuresToTolerate",
            "workloadHostFailuresToTolerate",
            "operationsNodeCount",
            "nsxManagerNodeCount",
            "migrationRpoHours",
            "migrationRtoHours"
          ],
          "properties": {
            "managementHostFailuresToTolerate": {
              "type": "integer",
              "minimum": 0
            },
            "workloadHostFailuresToTolerate": {
              "type": "integer",
              "minimum": 0
            },
            "operationsNodeCount": {
              "type": "integer",
              "minimum": 1
            },
            "nsxManagerNodeCount": {
              "type": "integer",
              "minimum": 1
            },
            "migrationRpoHours": {
              "type": "number",
              "minimum": 0
            },
            "migrationRtoHours": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "managementDomainHostCount",
            "minimumWorkloadHostCount",
            "selectedWorkloadHostCount",
            "limitingResources",
            "requiredWithHeadroom",
            "postFailureCapacity"
          ],
          "properties": {
            "managementDomainHostCount": {
              "type": "integer",
              "minimum": 1
            },
            "minimumWorkloadHostCount": {
              "type": "integer",
              "minimum": 1
            },
            "selectedWorkloadHostCount": {
              "type": "integer",
              "minimum": 1
            },
            "limitingResources": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "cpu",
                  "memory",
                  "storage"
                ]
              }
            },
            "requiredWithHeadroom": {
              "$ref": "#/definitions/capacityValues"
            },
            "postFailureCapacity": {
              "$ref": "#/definitions/capacityValues"
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "componentId",
          "componentType",
          "productName",
          "sourceVersion",
          "sourceBuild",
          "targetVersion",
          "targetBuild",
          "disposition",
          "compatibilityReason",
          "predecessors",
          "gates"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "componentType": {
            "type": "string",
            "minLength": 1
          },
          "productName": {
            "type": "string",
            "minLength": 1
          },
          "sourceVersion": {
            "type": "string",
            "minLength": 1
          },
          "sourceBuild": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetBuild": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "disposition": {
            "enum": [
              "replace-with-greenfield-target",
              "upgrade-in-place",
              "retain"
            ]
          },
          "compatibilityReason": {
            "type": "string",
            "minLength": 1
          },
          "predecessors": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "definitions": {
    "capacityValues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physicalCores",
        "memoryTiB",
        "usableVsanTiB"
      ],
      "properties": {
        "physicalCores": {
          "type": "number",
          "minimum": 0
        },
        "memoryTiB": {
          "type": "number",
          "minimum": 0
        },
        "usableVsanTiB": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}

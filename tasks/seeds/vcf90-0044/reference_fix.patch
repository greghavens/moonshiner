index 0000000..2e28636
--- /dev/null
+++ b/vcfvm/reconfigure.py
@@ -0,0 +1,122 @@
+"""The multi-step VM change, and the step-by-step report of what actually landed.
+
+Steps run in order and stop at the first failure.  A step that never ran is
+reported as ``not_attempted`` rather than silently dropped, so a caller can tell
+the difference between "did not happen" and "happened and failed".
+"""
+
+from .client import VcenterApiError
+
+GIB = 1024 ** 3
+
+STEP_NAMES = ["power_state", "memory", "disk", "nic", "power_on"]
+STEP_OPERATIONS = {
+    "power_state": "Vcenter.Vm.Power_get",
+    "memory": "Vcenter.Vm.Hardware.Memory_update",
+    "disk": "Vcenter.Vm.Hardware.Disk_create",
+    "nic": "Vcenter.Vm.Hardware.Ethernet_create",
+    "power_on": "Vcenter.Vm.Power_start",
+}
+
+
+class ChangePlan:
+    """The change a caller asked for.  ``None`` means "the caller said nothing"."""
+
+    def __init__(self, vm, memory_mib, disk_capacity_gib, nic_network,
+                 hot_add_enabled=False, disk_name=None, disk_scsi_bus=None,
+                 disk_scsi_unit=None, nic_type=None, nic_start_connected=False):
+        self.vm = vm
+        self.memory_mib = memory_mib
+        self.disk_capacity_gib = disk_capacity_gib
+        self.nic_network = nic_network
+        self.hot_add_enabled = hot_add_enabled
+        self.disk_name = disk_name
+        self.disk_scsi_bus = disk_scsi_bus
+        self.disk_scsi_unit = disk_scsi_unit
+        self.nic_type = nic_type
+        self.nic_start_connected = nic_start_connected
+
+    # -- request bodies ---------------------------------------------------
+    #
+    # Every optional property is omitted when the caller did not ask for it.
+    # None of them is ever sent as null, false or an empty object.
+
+    def memory_spec(self):
+        spec = {"size_mib": self.memory_mib}
+        if self.hot_add_enabled:
+            spec["hot_add_enabled"] = True
+        return spec
+
+    def disk_spec(self):
+        vmdk = {}
+        if self.disk_name is not None:
+            vmdk["name"] = self.disk_name
+        vmdk["capacity"] = self.disk_capacity_gib * GIB
+        spec = {"new_vmdk": vmdk}
+        if self.disk_scsi_bus is not None:
+            scsi = {"bus": self.disk_scsi_bus}
+            if self.disk_scsi_unit is not None:
+                scsi["unit"] = self.disk_scsi_unit
+            spec["type"] = "SCSI"
+            spec["scsi"] = scsi
+        return spec
+
+    def nic_spec(self):
+        spec = {"backing": {"type": "STANDARD_PORTGROUP", "network": self.nic_network}}
+        if self.nic_type is not None:
+            spec["type"] = self.nic_type
+        if self.nic_start_connected:
+            spec["start_connected"] = True
+        return spec
+
+
+def _blank_report(vm):
+    return {
+        "vm": vm,
+        "outcome": "succeeded",
+        "steps": [{"name": name, "operation_id": STEP_OPERATIONS[name],
+                   "status": "not_attempted"} for name in STEP_NAMES],
+    }
+
+
+def reconfigure(client, plan):
+    """Apply the plan and return the report.  Never raises for an API failure."""
+    report = _blank_report(plan.vm)
+    steps = {step["name"]: step for step in report["steps"]}
+    where = {"vm": plan.vm}
+
+    def run(name, call):
+        step = steps[name]
+        try:
+            step["result"] = call()
+        except VcenterApiError as err:
+            step["status"] = "failed"
+            step["error"] = err.as_report()
+            report["outcome"] = "failed"
+            return False
+        step["status"] = "succeeded"
+        return True
+
+    def read_power():
+        info = client.call("Vcenter.Vm.Power_get", where) or {}
+        return {"state": info.get("state")}
+
+    def update_memory():
+        client.call("Vcenter.Vm.Hardware.Memory_update", where, plan.memory_spec())
+        return {"memory_mib": plan.memory_mib}
+
+    def create_disk():
+        return {"disk": client.call("Vcenter.Vm.Hardware.Disk_create", where, plan.disk_spec())}
+
+    def create_nic():
+        return {"nic": client.call("Vcenter.Vm.Hardware.Ethernet_create", where, plan.nic_spec())}
+
+    def power_on():
+        client.call("Vcenter.Vm.Power_start", where)
+        return {"state": "POWERED_ON"}
+
+    for name, call in (("power_state", read_power), ("memory", update_memory),
+                       ("disk", create_disk), ("nic", create_nic), ("power_on", power_on)):
+        if not run(name, call):
+            break
+    return report

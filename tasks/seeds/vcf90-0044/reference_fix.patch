@@ -0,0 +1,98 @@
+"""`python3 -m vcfvm` - apply the change and write the step report."""
+
+import argparse
+import json
+import sys
+
+from .client import VcenterApiError, VcenterClient
+from .contract import Contract, ContractError, DEFAULT_CONTRACT
+from .reconfigure import ChangePlan, reconfigure
+
+
+def build_parser():
+    parser = argparse.ArgumentParser(
+        prog="vcfvm",
+        description="Resize memory, attach a disk and a NIC, then power on a vCenter VM.")
+    parser.add_argument("--base-url", required=True,
+                        help="vCenter server root, for example https://vcenter.example.com")
+    parser.add_argument("--username", required=True)
+    parser.add_argument("--password", required=True)
+    parser.add_argument("--vm", required=True, help="VirtualMachine identifier, e.g. vm-3041")
+    parser.add_argument("--report", required=True, help="path of the JSON report to write")
+    parser.add_argument("--contract", default=DEFAULT_CONTRACT,
+                        help="API contract to resolve operations against")
+    parser.add_argument("--memory-mib", type=int, required=True)
+    parser.add_argument("--hot-add-enabled", action="store_true")
+
+    parser.add_argument("--disk-capacity-gib", type=int, required=True)
+    parser.add_argument("--disk-name")
+    parser.add_argument("--disk-scsi-bus", type=int)
+    parser.add_argument("--disk-scsi-unit", type=int)
+
+    parser.add_argument("--nic-network", required=True)
+    parser.add_argument("--nic-type")
+    parser.add_argument("--nic-start-connected", action="store_true")
+    return parser
+
+
+def main(argv=None):
+    args = build_parser().parse_args(argv)
+    if args.memory_mib <= 0:
+        build_parser().error("--memory-mib must be positive")
+    if args.disk_capacity_gib <= 0:
+        build_parser().error("--disk-capacity-gib must be positive")
+
+    try:
+        contract = Contract.load(args.contract)
+    except ContractError as err:
+        print("error: %s" % err, file=sys.stderr)
+        return 2
+
+    plan = ChangePlan(
+        vm=args.vm,
+        memory_mib=args.memory_mib,
+        disk_capacity_gib=args.disk_capacity_gib,
+        nic_network=args.nic_network,
+        hot_add_enabled=args.hot_add_enabled,
+        disk_name=args.disk_name,
+        disk_scsi_bus=args.disk_scsi_bus,
+        disk_scsi_unit=args.disk_scsi_unit,
+        nic_type=args.nic_type,
+        nic_start_connected=args.nic_start_connected,
+    )
+
+    client = VcenterClient(args.base_url, contract)
+    try:
+        client.open_session(args.username, args.password)
+    except VcenterApiError as err:
+        print("error: could not authenticate to %s: %s (%s)"
+              % (args.base_url, err.message, err.error_type), file=sys.stderr)
+        return 2
+    try:
+        report = reconfigure(client, plan)
+    finally:
+        try:
+            client.close_session()
+        except VcenterApiError as err:
+            print("warning: could not release the vCenter session: %s" % err.message,
+                  file=sys.stderr)
+
+    with open(args.report, "w", encoding="utf-8") as handle:
+        json.dump(report, handle, indent=2)
+        handle.write("\n")
+
+    _summarise(report)
+    return 0 if report["outcome"] == "succeeded" else 1
+
+
+def _summarise(report):
+    print("virtual machine %s: %s" % (report["vm"], report["outcome"]))
+    for step in report["steps"]:
+        line = "  %-12s %-13s %s" % (step["name"], step["status"], step["operation_id"])
+        if "error" in step:
+            line += "\n      HTTP %s %s: %s" % (step["error"]["http_status"],
+                                                step["error"]["error_type"],
+                                                step["error"]["message"])
+        elif "result" in step:
+            line += "  ->  %s" % json.dumps(step["result"], sort_keys=True)
+        print(line, file=sys.stderr if "error" in step else sys.stdout)
diff --git a/vcfvm/client.py b/vcfvm/client.py
new file mode 100644
index 0000000..97abd7b
--- /dev/null
+++ b/vcfvm/client.py
@@ -0,0 +1,118 @@
+"""Minimal urllib transport for the contract-pinned vCenter operations."""
+
+import base64
+import json
+import urllib.error
+import urllib.request
+
+SESSION_CREATE = "Cis.Session_create"
+SESSION_DELETE = "Cis.Session_delete"
+SESSION_HEADER = "vmware-api-session-id"
+
+
+class VcenterApiError(Exception):
+    """A vAPI error response (Vapi.Std.Errors.*) returned by the endpoint."""
+
+    def __init__(self, operation_id, status, error_type, message, messages=None):
+        super().__init__("%s failed with HTTP %s (%s): %s"
+                         % (operation_id, status, error_type, message))
+        self.operation_id = operation_id
+        self.status = status
+        self.error_type = error_type
+        self.message = message
+        self.messages = messages or []
+
+    def as_report(self):
+        return {"http_status": self.status, "error_type": self.error_type,
+                "message": self.message}
+
+
+class VcenterClient:
+    """Calls the operations named in the contract and nothing else."""
+
+    def __init__(self, base_url, contract, timeout=30.0):
+        self.base_url = base_url.rstrip("/")
+        self.contract = contract
+        self.timeout = timeout
+        self._session_id = None
+    # -- session ---------------------------------------------------------
+
+    @property
+    def session_id(self):
+        return self._session_id
+
+    def open_session(self, username, password):
+        blob = base64.b64encode(("%s:%s" % (username, password)).encode("utf-8")).decode("ascii")
+        token = self.call(SESSION_CREATE, headers={"Authorization": "Basic " + blob})
+        if not isinstance(token, str) or not token:
+            raise VcenterApiError(SESSION_CREATE, 201, "ERROR",
+                                  "the endpoint did not return a session identifier")
+        self._session_id = token
+        return token
+
+    def close_session(self):
+        if self._session_id is None:
+            return
+        try:
+            self.call(SESSION_DELETE)
+        finally:
+            self._session_id = None
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *_):
+        self.close_session()
+        return False
+
+    # -- transport -------------------------------------------------------
+
+    def call(self, operation_id, path_params=None, body=None, headers=None):
+        method, target = self.contract.target(operation_id, path_params)
+        request_headers = dict(headers or {})
+        if self.contract.security(operation_id) != "basic_auth":
+            if not self._session_id:
+                raise VcenterApiError(operation_id, 401, "UNAUTHENTICATED",
+                                      "no session has been established")
+            request_headers[SESSION_HEADER] = self._session_id
+        payload = None
+        if body is not None:
+            payload = json.dumps(body).encode("utf-8")
+            request_headers["Content-Type"] = "application/json"
+        request_headers["Accept"] = "application/json"
+        request = urllib.request.Request(self.base_url + target, data=payload,
+                                         headers=request_headers, method=method)
+        try:
+            with urllib.request.urlopen(request, timeout=self.timeout) as response:
+                return _decode(response.status, response.read())
+        except urllib.error.HTTPError as err:
+            raise _api_error(operation_id, err)
+        except urllib.error.URLError as err:
+            raise VcenterApiError(operation_id, 0, "SERVICE_UNAVAILABLE",
+                                  "cannot reach %s: %s" % (self.base_url, err.reason))
+
+
+def _decode(status, raw):
+    if status == 204 or not raw:
+        return None
+    try:
+        return json.loads(raw.decode("utf-8"))
+    except (ValueError, UnicodeDecodeError):
+        return None
+
+
+def _api_error(operation_id, err):
+    try:
+        payload = json.loads(err.read().decode("utf-8"))
+    except (ValueError, UnicodeDecodeError, OSError):
+        payload = {}
+    if not isinstance(payload, dict):
+        payload = {}
+    messages = payload.get("messages") or []
+    default = ""
+    if messages and isinstance(messages[0], dict):
+        default = messages[0].get("default_message") or ""
+    return VcenterApiError(operation_id, err.code,
+                           payload.get("error_type") or "ERROR",
+                           default or err.reason or "the endpoint reported an error",
+                           messages)
diff --git a/vcfvm/contract.py b/vcfvm/contract.py

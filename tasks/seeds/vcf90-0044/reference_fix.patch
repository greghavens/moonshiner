@@ -0,0 +1,24 @@
+"""Contract-pinned client for the VCF 9.0 vSphere Automation API for vCenter.
+
+The package applies a multi-step virtual machine change and reports, step by
+step, exactly which parts of that change landed on the endpoint.  Every request
+is resolved from ``docs/contract.json``, a projection of
+``specifications/vsphere/openapi/automation/vcenter.yaml`` in
+``vmware/vcf-api-specs`` at tag ``9.0.0.0``.
+
+Standard library only.
+"""
+
+from .contract import Contract, ContractError
+from .client import VcenterApiError, VcenterClient
+from .reconfigure import STEP_NAMES, ChangePlan, reconfigure
+
+__all__ = [
+    "ChangePlan",
+    "Contract",
+    "ContractError",
+    "STEP_NAMES",
+    "VcenterApiError",
+    "VcenterClient",
+    "reconfigure",
+]

index 0000000..55e6c24
--- /dev/null
+++ b/vcfvm/contract.py
@@ -0,0 +1,67 @@
+"""Reads docs/contract.json and turns an operationId into a concrete request."""
+
+import json
+import os
+from urllib.parse import quote, urlencode
+
+DEFAULT_CONTRACT = os.path.join(
+    os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "docs", "contract.json")
+
+
+class ContractError(Exception):
+    """The contract does not describe the operation the caller asked for."""
+
+
+class Contract:
+    """The subset of the vCenter OpenAPI document this client is pinned to."""
+
+    def __init__(self, document):
+        self.document = document
+        self.base_path = document["basePath"].rstrip("/")
+        self.operations = {op["operationId"]: op for op in document["operations"]}
+
+    @classmethod
+    def load(cls, path=None):
+        path = path or DEFAULT_CONTRACT
+        try:
+            with open(path, "r", encoding="utf-8") as handle:
+                return cls(json.load(handle))
+        except OSError as err:
+            raise ContractError("cannot read the API contract at %s: %s" % (path, err))
+        except ValueError as err:
+            raise ContractError("the API contract at %s is not valid JSON: %s" % (path, err))
+
+    def operation(self, operation_id):
+        try:
+            return self.operations[operation_id]
+        except KeyError:
+            raise ContractError("the contract does not describe %r" % operation_id)
+
+    def target(self, operation_id, path_params=None):
+        """Return (method, target) for an operation, relative to the server root."""
+        operation = self.operation(operation_id)
+        supplied = dict(path_params or {})
+        target = self.base_path
+        for segment in operation["path"].split("/"):
+            if not segment:
+                continue
+            if segment.startswith("{") and segment.endswith("}"):
+                name = segment[1:-1]
+                if name not in supplied:
+                    raise ContractError(
+                        "%s needs a %r path parameter" % (operation_id, name))
+                segment = quote(str(supplied.pop(name)), safe="")
+            target += "/" + segment
+        if supplied:
+            raise ContractError("%s does not take %s"
+                                % (operation_id, ", ".join(sorted(supplied))))
+        query = operation.get("query") or {}
+        if query:
+            target += "?" + urlencode(sorted(query.items()))
+        return operation["method"], target
+
+    def security(self, operation_id):
+        return self.operation(operation_id)["security"]
+
+    def success_status(self, operation_id):
+        return self.operation(operation_id)["successStatus"]
diff --git a/vcfvm/reconfigure.py b/vcfvm/reconfigure.py

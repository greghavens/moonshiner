+#!/usr/bin/env python3
+"""Reference proof using the same executable workflow required by the task."""
+
+from __future__ import annotations
+
+import json
+import shlex
+import subprocess
+import tempfile
+from datetime import date
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parent
+
+
+def parallel(commands: list[list[str]]) -> list[dict[str, object]]:
+    """Run one phase as direct, concurrent children of a fresh shell process."""
+    with tempfile.TemporaryDirectory(dir=ROOT / "__pycache__") as directory:
+        temporary = Path(directory)
+        output_paths = [temporary / f"output-{index}.json" for index in range(len(commands))]
+        error_paths = [temporary / f"error-{index}.txt" for index in range(len(commands))]
+        script_lines = ["set -euo pipefail"]
+        for index, (command, output_path, error_path) in enumerate(
+            zip(commands, output_paths, error_paths, strict=True)
+        ):
+            script_lines.append(
+                f"{shlex.join(command)} > {shlex.quote(str(output_path))} "
+                f"2> {shlex.quote(str(error_path))} & pid_{index}=$!"
+            )
+        script_lines.extend(f'wait "$pid_{index}"' for index in range(len(commands)))
+        completed = subprocess.run(
+            ["bash", "-c", "\n".join(script_lines)],
+            cwd=ROOT,
+            capture_output=True,
+            text=True,
+            timeout=20,
+        )
+        if completed.returncode != 0:
+            errors = [path.read_text(encoding="utf-8").strip() for path in error_paths]
+            raise RuntimeError(next((error for error in errors if error), "request phase failed"))
+        payload = [json.loads(path.read_text(encoding="utf-8")) for path in output_paths]
+        if len(payload) != len(commands):
+            raise RuntimeError("request phase returned an invalid payload")
+        return payload
+
+
+def main() -> int:
+    requested = [
+        ("East stairwell lighting repair", "Building A"),
+        ("Training room setup", "Building B"),
+    ]
+    searches = parallel([
+        ["./requestctl", "search", "--name", name, "--building", building]
+        for name, building in requested
+    ])
+
+    identifiers: list[str] = []
+    for result in searches:
+        matches = result.get("matches")
+        if not isinstance(matches, list) or len(matches) != 1:
+            raise RuntimeError("reference branch did not resolve uniquely")
+        request_id = matches[0].get("id")
+        if not isinstance(request_id, str) or not request_id:
+            raise RuntimeError("reference branch returned no stable ID")
+        identifiers.append(request_id)
+
+    gets = parallel([
+        ["./requestctl", "get", "--id", request_id]
+        for request_id in identifiers
+    ])
+    records = [result.get("record") for result in gets]
+    if any(not isinstance(record, dict) for record in records):
+        raise RuntimeError("complete-record retrieval failed")
+    ordered = sorted(records, key=lambda record: str(record["name"]).casefold())
+    comparison = "same" if ordered[0]["status"] == ordered[1]["status"] else "different"
+    earlier, later = sorted(ordered, key=lambda record: date.fromisoformat(record["date"]))
+    difference = (
+        date.fromisoformat(later["date"]) - date.fromisoformat(earlier["date"])
+    ).days
+    unit = "day" if difference == 1 else "days"
+
+    fields = ("name", "id", "building", "date", "status", "requester", "details")
+    record_lines = [" | ".join(str(record[field]) for field in fields) for record in ordered]
+    report = (
+        f"{record_lines[0]}\n"
+        f"{record_lines[1]}\n"
+        f"Status comparison: {comparison} "
+        f"({ordered[0]['status']} vs {ordered[1]['status']}).\n"
+        f"Date comparison: {earlier['name']} is {difference} {unit} earlier "
+        f"({earlier['date']} vs {later['date']}).\n"
+        "No changes made.\n"
+    )
+    (ROOT / "operations-check.md").write_text(report, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

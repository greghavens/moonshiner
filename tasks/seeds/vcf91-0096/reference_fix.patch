+function Get-VcfTpmMember {
+    param(
+        [AllowNull()]
+        $InputObject,
+
+        [Parameter(Mandatory)]
+        [string[]] $Name
+    )
+
+    if ($null -ne $InputObject) {
+        foreach ($Candidate in $Name) {
+            $Property = @(
+                $InputObject.PSObject.Properties |
+                    Where-Object { $_.Name -ceq $Candidate }
+            )
+            if ($Property.Count -eq 1) {
+                return [pscustomobject]@{
+                    Found = $true
+                    Value = $Property[0].Value
+                }
+            }
+        }
+    }
+    return [pscustomobject]@{
+        Found = $false
+        Value = $null
+    }
+}
+
+function Get-VcfRequiredTpmMember {
+    param(
+        [AllowNull()]
+        $InputObject,
+
+        [Parameter(Mandatory)]
+        [string[]] $Name,
+
+        [Parameter(Mandatory)]
+        [string] $Description,
+
+        [Parameter(Mandatory)]
+        [string] $OperationId
+    )
+
+    $Member = Get-VcfTpmMember -InputObject $InputObject -Name $Name
+    if (-not $Member.Found -or $null -eq $Member.Value) {
+        throw [IO.InvalidDataException]::new(
+            "$OperationId returned a malformed $Description."
+        )
+    }
+    return ,$Member.Value
+}
+
+function Test-VcfInteger {
+    param(
+        [AllowNull()]
+        $Value
+    )
+
+    return (
+        $Value -is [sbyte] -or
+        $Value -is [byte] -or
+        $Value -is [int16] -or
+        $Value -is [uint16] -or
+        $Value -is [int32] -or
+        $Value -is [uint32] -or
+        $Value -is [int64] -or
+        $Value -is [uint64]
+    )
+}
+
+function Assert-VcfCanonicalBase64 {
+    param(
+        [AllowNull()]
+        $Value,
+
+        [Parameter(Mandatory)]
+        [string] $Description,
+
+        [Parameter(Mandatory)]
+        [string] $OperationId
+    )
+
+    if ($Value -isnot [string]) {
+        throw [IO.InvalidDataException]::new(
+            "$OperationId returned malformed $Description."
+        )
+    }
+    try {
+        $Bytes = [Convert]::FromBase64String($Value)
+    }
+    catch {
+        throw [IO.InvalidDataException]::new(
+            "$OperationId returned malformed $Description."
+        )
+    }
+    if ([Convert]::ToBase64String($Bytes) -cne $Value) {
+        throw [IO.InvalidDataException]::new(
+            "$OperationId returned malformed $Description."
+        )
+    }
+}
+
+function Assert-VcfTpmSummary {
+    param(
+        [AllowNull()]
+        $Summary,
+
+        [Parameter(Mandatory)]
+        [string] $OperationId
+    )
+
+    if ($null -eq $Summary) {
+        throw [IO.InvalidDataException]::new(
+            "$OperationId returned a null TPM summary."
+        )
+    }
+    $Tpm = Get-VcfRequiredTpmMember `
+        -InputObject $Summary `
+        -Name @('Tpm', 'tpm') `
+        -Description 'TPM identifier' `
+        -OperationId $OperationId
+    $Major = Get-VcfRequiredTpmMember `
+        -InputObject $Summary `
+        -Name @('MajorVersion', 'major_version') `
+        -Description 'TPM major version' `
+        -OperationId $OperationId
+    $Minor = Get-VcfRequiredTpmMember `
+        -InputObject $Summary `
+        -Name @('MinorVersion', 'minor_version') `
+        -Description 'TPM minor version' `
+        -OperationId $OperationId
+    $Active = Get-VcfRequiredTpmMember `
+        -InputObject $Summary `
+        -Name @('Active', 'active') `
+        -Description 'TPM active state' `
+        -OperationId $OperationId
+
+    if (
+        $Tpm -isnot [string] -or
+        [string]::IsNullOrWhiteSpace($Tpm) -or
+        -not (Test-VcfInteger $Major) -or
+        -not (Test-VcfInteger $Minor) -or
+        $Active -isnot [bool]
+    ) {
+        throw [IO.InvalidDataException]::new(
+            "$OperationId returned a malformed TPM summary."
+        )
+    }
+}
+
+function Get-VcfPcrValues {
+    param(
+        [Parameter(Mandatory)]
+        $Pcrs,
+
+        [Parameter(Mandatory)]
+        [string] $OperationId
+    )
+
+    if ($Pcrs -is [Collections.IDictionary]) {
+        return @(
+            foreach ($Entry in $Pcrs.GetEnumerator()) {
+                $Entry.Value
+            }
+        )
+    }
+    if ($Pcrs -is [Management.Automation.PSCustomObject]) {
+        return @(
+            $Pcrs.PSObject.Properties |
+                ForEach-Object { $_.Value }
+        )
+    }
+
+    throw [IO.InvalidDataException]::new(
+        "$OperationId returned a malformed PCR map."
+    )
+}
+
+function Assert-VcfTpmEventLog {
+    param(
+        [AllowNull()]
+        $EventLog,
+
+        [Parameter(Mandatory)]
+        [string] $OperationId
+    )
+
+    if ($null -eq $EventLog) {
+        throw [IO.InvalidDataException]::new(
+            "$OperationId returned a null event log."
+        )
+    }
+    $Type = Get-VcfRequiredTpmMember `
+        -InputObject $EventLog `
+        -Name @('Type', 'type') `
+        -Description 'event-log type' `
+        -OperationId $OperationId
+    $Data = Get-VcfRequiredTpmMember `
+        -InputObject $EventLog `
+        -Name @('Data', 'data') `
+        -Description 'event-log data' `
+        -OperationId $OperationId
+    $Truncated = Get-VcfRequiredTpmMember `
+        -InputObject $EventLog `
+        -Name @('Truncated', 'truncated') `
+        -Description 'event-log truncated state' `
+        -OperationId $OperationId
+    $BanksValue = Get-VcfRequiredTpmMember `
+        -InputObject $EventLog `
+        -Name @('Banks', 'banks') `
+        -Description 'PCR banks' `
+        -OperationId $OperationId
+
+    if (
+        $Type -isnot [string] -or
+        $Type -cne 'EFI_TCG2_EVENT_LOG_FORMAT_TCG_2' -or
+        $Truncated -isnot [bool]
+    ) {
+        throw [IO.InvalidDataException]::new(
+            "$OperationId returned a malformed event log."
+        )
+    }
+    Assert-VcfCanonicalBase64 `
+        -Value $Data `
+        -Description 'event-log data' `
+        -OperationId $OperationId
+
+    if (
+        $BanksValue -isnot [Collections.IEnumerable] -or
+        $BanksValue -is [string] -or
+        $BanksValue -is [Collections.IDictionary] -or
+        $BanksValue -is [Management.Automation.PSCustomObject]
+    ) {
+        throw [IO.InvalidDataException]::new(
+            "$OperationId returned a malformed PCR banks collection."
+        )
+    }
+
+    $AllowedAlgorithms = @('SHA256', 'SHA384', 'SHA512', 'SM3_256')
+    foreach ($Bank in $BanksValue) {
+        if ($null -eq $Bank) {
+            throw [IO.InvalidDataException]::new(
+                "$OperationId returned a null PCR bank."
+            )
+        }
+        $Algorithm = Get-VcfRequiredTpmMember `
+            -InputObject $Bank `
+            -Name @('Algorithm', 'algorithm') `
+            -Description 'PCR bank algorithm' `
+            -OperationId $OperationId
+        $Pcrs = Get-VcfRequiredTpmMember `
+            -InputObject $Bank `
+            -Name @('Pcrs', 'pcrs') `
+            -Description 'PCR map' `
+            -OperationId $OperationId
+        if (
+            $Algorithm -isnot [string] -or
+            $AllowedAlgorithms -cnotcontains $Algorithm
+        ) {
+            throw [IO.InvalidDataException]::new(
+                "$OperationId returned an unsupported PCR bank algorithm."
+            )
+        }
+        foreach ($PcrValue in @(Get-VcfPcrValues $Pcrs $OperationId)) {
+            Assert-VcfCanonicalBase64 `
+                -Value $PcrValue `
+                -Description 'PCR digest' `
+                -OperationId $OperationId
+        }
+    }
+}

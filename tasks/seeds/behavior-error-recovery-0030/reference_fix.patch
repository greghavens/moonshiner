diff --git a/.reference_solution.py b/.reference_solution.py
new file mode 100644
index 0000000..34c37bd
--- /dev/null
+++ b/.reference_solution.py
@@ -0,0 +1,179 @@
+#!/usr/bin/env python3
+"""Produce the reference report through genuine concurrent client execution."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+import sys
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "bin" / "project-availability"
+AUDIT_DIR = ROOT / ".project-audit"
+REPORT_PATH = ROOT / "availability_report.txt"
+TARGETS = (
+    {"name": "Policy review", "location": "Beacon", "date": "2026-09-21"},
+    {"name": "Newsletter draft", "location": "Clover", "date": "2026-09-21"},
+)
+
+
+def command_for(target: dict[str, str]) -> list[str]:
+    return [
+        str(CLIENT),
+        "availability",
+        "--name",
+        target["name"],
+        "--location",
+        target["location"],
+        "--date",
+        target["date"],
+    ]
+
+
+def capture(process: subprocess.Popen[str]) -> dict[str, Any]:
+    stdout, stderr = process.communicate()
+    return {
+        "returncode": process.returncode,
+        "stdout": stdout.strip(),
+        "stderr": stderr.strip(),
+    }
+
+
+def stage_parallel() -> int:
+    processes = [
+        subprocess.Popen(
+            command_for(target),
+            cwd=ROOT,
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for target in TARGETS
+    ]
+    print(json.dumps([capture(process) for process in processes]))
+    return 0
+
+
+def stage_retry(index: int) -> int:
+    if index not in range(len(TARGETS)):
+        raise RuntimeError("invalid retry target")
+    completed = subprocess.run(
+        command_for(TARGETS[index]),
+        cwd=ROOT,
+        stdin=subprocess.DEVNULL,
+        capture_output=True,
+        text=True,
+    )
+    print(
+        json.dumps(
+            {
+                "returncode": completed.returncode,
+                "stdout": completed.stdout.strip(),
+                "stderr": completed.stderr.strip(),
+            }
+        )
+    )
+    return 0
+
+
+def decode_json(value: str, description: str) -> dict[str, Any]:
+    try:
+        decoded = json.loads(value)
+    except json.JSONDecodeError as error:
+        raise RuntimeError(f"{description} was not JSON") from error
+    if not isinstance(decoded, dict):
+        raise RuntimeError(f"{description} was not an object")
+    return decoded
+
+
+def orchestrate() -> int:
+    subprocess.run(
+        [str(CLIENT), "--help"],
+        cwd=ROOT,
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.DEVNULL,
+        check=True,
+    )
+
+    initial_run = subprocess.run(
+        [sys.executable, str(Path(__file__).resolve()), "parallel"],
+        cwd=ROOT,
+        stdin=subprocess.DEVNULL,
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    initial = json.loads(initial_run.stdout)
+    if not isinstance(initial, list) or len(initial) != len(TARGETS):
+        raise RuntimeError("parallel stage returned the wrong result count")
+
+    successes: dict[int, dict[str, Any]] = {}
+    failed: list[int] = []
+    for index, captured in enumerate(initial):
+        if captured.get("returncode") == 0:
+            successes[index] = decode_json(
+                captured.get("stdout", ""), "successful availability response"
+            )
+            continue
+        error = decode_json(captured.get("stderr", ""), "availability error")
+        if captured.get("returncode") == 75 and error.get("retryable") is True:
+            failed.append(index)
+            continue
+        raise RuntimeError("an availability check failed permanently")
+
+    if len(failed) != 1:
+        raise RuntimeError("expected exactly one transiently failed branch")
+    retry_index = failed[0]
+    retry_run = subprocess.run(
+        [
+            sys.executable,
+            str(Path(__file__).resolve()),
+            "retry",
+            str(retry_index),
+        ],
+        cwd=ROOT,
+        stdin=subprocess.DEVNULL,
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    retried = json.loads(retry_run.stdout)
+    if retried.get("returncode") != 0:
+        raise RuntimeError(retried.get("stderr") or "retry did not succeed")
+    successes[retry_index] = decode_json(
+        retried.get("stdout", ""), "retried availability response"
+    )
+
+    if set(successes) != set(range(len(TARGETS))):
+        raise RuntimeError("a branch has no successful result")
+    lines: list[str] = []
+    for index, target in enumerate(TARGETS):
+        result = successes[index]
+        if result.get("name") != target["name"] or result.get("location") != target["location"]:
+            raise RuntimeError("a successful response did not match its request")
+        if result.get("date") != target["date"] or not isinstance(result.get("available"), bool):
+            raise RuntimeError("a successful response was incomplete")
+        word = "available" if result["available"] else "unavailable"
+        lines.append(
+            f"- {target['name']} at {target['location']}: {word} on {target['date']}."
+        )
+    REPORT_PATH.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    return 0
+
+
+def main() -> int:
+    if len(sys.argv) == 1:
+        return orchestrate()
+    if sys.argv[1:] == ["parallel"]:
+        return stage_parallel()
+    if len(sys.argv) == 3 and sys.argv[1] == "retry":
+        return stage_retry(int(sys.argv[2]))
+    raise SystemExit("invalid reference invocation")
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

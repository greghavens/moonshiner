+// normalizeStatus trims a status, uppercases it, then collapses each run of
+// whitespace into a single underscore, so the Task vocabulary's "In Progress"
+// and the CredentialsTask vocabulary's "IN_PROGRESS" compare equal.
+func normalizeStatus(status string) string {
+	return strings.Join(strings.Fields(strings.ToUpper(strings.TrimSpace(status))), "_")
+}

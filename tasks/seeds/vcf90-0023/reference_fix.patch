+		status := normalizeStatus(st.Status)
+		o := Outcome{Key: k, Status: status}
+		if status == "SUCCESSFUL" && strings.TrimSpace(st.NewPassword) != "" {
+			o.SecretChanged = true
+			confirmed[k] = st.NewPassword
+		} else {
+			o.ErrorCode, o.Message = firstError(st.Errors)
+		}
+		out = append(out, o)
+	}
+	return out

+// buildSpec validates req against the pinned vocabularies and against the
+// store, then encodes the CredentialsUpdateSpec body. It returns the affected
+// keys in request order.
+func buildSpec(req RotateRequest, store *Store) ([]Key, []byte, error) {
+	if !operationTypes[req.OperationType] {
+		return nil, nil, fmt.Errorf("credrotate: operationType %q is not one of UPDATE, ROTATE, REMEDIATE or UPDATE_AUTO_ROTATE_POLICY in the pinned 9.0.0.0 specification", req.OperationType)
+	}
+	if len(req.Resources) == 0 {
+		return nil, nil, errors.New("credrotate: a change needs at least one resource")
+	}
+
+	held := store.Snapshot()
+	spec := wireUpdateSpec{OperationType: req.OperationType}
+	var keys []Key
+	seen := map[Key]bool{}
+
+	for i, r := range req.Resources {
+		if r.ResourceName == "" {
+			return nil, nil, fmt.Errorf("credrotate: resource %d has no resource name, so its subtasks could not be correlated", i)
+		}
+		if !resourceTypes[r.ResourceType] {
+			return nil, nil, fmt.Errorf("credrotate: resource %q has resourceType %q, which the pinned 9.0.0.0 specification does not enumerate", r.ResourceName, r.ResourceType)
+		}
+		if len(r.Credentials) == 0 {
+			return nil, nil, fmt.Errorf("credrotate: resource %q lists no credentials", r.ResourceName)
+		}
+
+		element := wireResource{
+			ResourceName: r.ResourceName,
+			ResourceID:   r.ResourceID,
+			ResourceType: r.ResourceType,
+		}
+		for j, cred := range r.Credentials {
+			if cred.Username == "" {
+				return nil, nil, fmt.Errorf("credrotate: credential %d of resource %q has no username", j, r.ResourceName)
+			}
+			if req.OperationType == "UPDATE" {
+				if cred.Password == "" {
+					return nil, nil, fmt.Errorf("credrotate: an UPDATE must supply a password for %s on %s", cred.Username, r.ResourceName)
+				}
+			} else if cred.Password != "" {
+				return nil, nil, fmt.Errorf("credrotate: a %s must not supply a password for %s on %s; the appliance generates the replacement", req.OperationType, cred.Username, r.ResourceName)
+			}
+
+			k := Key{ResourceName: r.ResourceName, Username: cred.Username}
+			if seen[k] {
+				return nil, nil, fmt.Errorf("credrotate: %s appears twice in the same change", k)
+			}
+			if _, ok := held[k]; !ok {
+				return nil, nil, fmt.Errorf("credrotate: the store holds no secret for %s", k)
+			}
+			seen[k] = true
+			keys = append(keys, k)
+
+			element.Credentials = append(element.Credentials, wireCredential{
+				CredentialType: cred.CredentialType,
+				AccountType:    cred.AccountType,
+				Username:       cred.Username,
+				Password:       cred.Password,
+			})
+		}
+		spec.Elements = append(spec.Elements, element)
+	}
+
+	if req.AutoRotate != nil {
+		spec.AutoRotatePolicy = &wireAutoRotate{
+			FrequencyInDays:        req.AutoRotate.FrequencyInDays,
+			EnableAutoRotatePolicy: req.AutoRotate.Enable,
+		}
+	}
+
+	body, err := json.Marshal(spec)
+	if err != nil {
+		return nil, nil, fmt.Errorf("credrotate: encoding the change: %w", err)
+	}
+	return keys, body, nil
+}

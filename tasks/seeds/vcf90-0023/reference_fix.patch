+// call issues one contract operation. A nil body means the request carries no
+// body and therefore no Content-Type.
+func (c *Client) call(ctx context.Context, operationID, method, path string, body []byte, wantStatus int, out any) error {
+	var reader io.Reader
+	if body != nil {
+		reader = bytes.NewReader(body)
+	}
+
+	req, err := http.NewRequestWithContext(ctx, method, c.baseURL+path, reader)
+	if err != nil {
+		return fmt.Errorf("credrotate: %s: building the request: %w", operationID, err)
+	}
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("Authorization", "Bearer "+c.accessToken)
+	if body != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return fmt.Errorf("credrotate: %s: %w", operationID, err)
+	}
+	defer func() {
+		_, _ = io.Copy(io.Discard, resp.Body)
+		_ = resp.Body.Close()
+	}()
+
+	raw, err := io.ReadAll(io.LimitReader(resp.Body, 8<<20))
+	if err != nil {
+		return fmt.Errorf("credrotate: %s: reading the response: %w", operationID, err)
+	}
+
+	if resp.StatusCode != wantStatus {
+		var e wireError
+		_ = json.Unmarshal(raw, &e)
+		return &APIError{
+			OperationID: operationID,
+			StatusCode:  resp.StatusCode,
+			ErrorCode:   e.ErrorCode,
+			Message:     e.Message,
+		}
+	}
+
+	if out == nil {
+		return nil
+	}
+	if err := json.Unmarshal(raw, out); err != nil {
+		return fmt.Errorf("credrotate: %s: decoding the response: %w", operationID, err)
+	}
+	return nil
+}

+// correlate turns the settled subtasks into outcomes. A subtask naming neither
+// a resource nor a username is orchestration, not a credential, and a subtask
+// for a credential this change did not touch is not ours; both are skipped. A
+// confirmed new password goes into confirmed rather than into the outcome, so
+// no secret can reach a caller through Result.
+func correlate(subTasks []wireSubTask, sealed map[Key]bool, confirmed map[Key]string) []Outcome {
+	var out []Outcome
+	for _, st := range subTasks {
+		if st.ResourceName == "" || st.Username == "" {
+			continue
+		}
+		k := Key{ResourceName: st.ResourceName, Username: st.Username}
+		if !sealed[k] {
+			continue
+		}

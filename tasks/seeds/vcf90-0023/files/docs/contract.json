{
  "schemaVersion": 1,
  "title": "SDDC Manager 9.0 credential-rotation contract",
  "source": {
    "repository": "vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "repositoryCommitSha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "specPath": "specifications/sddc-manager/sddc-manager-openapi.json",
    "openapiVersion": "3.0.1",
    "specInfoTitle": "VMware Cloud Foundation API Reference Guide",
    "specInfoVersion": "9.0.0.0"
  },
  "transport": {
    "acceptHeader": "application/json",
    "requestContentType": "application/json",
    "authorizationHeader": "Authorization: Bearer <access_token>",
    "authorizationIsSpecDerived": false
  },
  "operations": [
    {
      "operationId": "updateOrRotatePasswords",
      "method": "PATCH",
      "path": "/v1/credentials",
      "successStatus": 202,
      "errorStatuses": [400, 401, 403, 500],
      "requestBody": {
        "schema": "CredentialsUpdateSpec",
        "required": true,
        "shape": "object"
      },
      "responseBody": {
        "schema": "Task"
      }
    },
    {
      "operationId": "getCredentialsTask",
      "method": "GET",
      "path": "/v1/credentials/tasks/{id}",
      "successStatus": 200,
      "errorStatuses": [400, 500],
      "pathParameters": [
        { "name": "id", "description": "The ID of the credentials task" }
      ],
      "requestBody": null,
      "responseBody": {
        "schema": "CredentialsTask"
      }
    },
    {
      "operationId": "cancelCredentialsTask",
      "method": "DELETE",
      "path": "/v1/credentials/tasks/{id}",
      "successStatus": 202,
      "errorStatuses": [400, 500],
      "pathParameters": [
        { "name": "id", "description": "Task ID of the failed operation required to be cancelled" }
      ],
      "requestBody": null,
      "responseBody": {
        "schema": "Task"
      }
    }
  ],
  "schemas": {
    "CredentialsUpdateSpec": {
      "required": ["elements", "operationType"],
      "readOnly": [],
      "members": {
        "operationType": { "type": "string" },
        "elements": { "type": "array", "items": "ResourceCredentials" },
        "autoRotatePolicy": { "type": "object", "items": "AutoRotateCredentialPolicyInputSpec" }
      },
      "notMembersInThisRevision": []
    },
    "ResourceCredentials": {
      "required": ["credentials", "resourceType"],
      "readOnly": [],
      "members": {
        "resourceName": { "type": "string" },
        "resourceId": { "type": "string" },
        "resourceType": { "type": "string" },
        "credentials": { "type": "array", "items": "BaseCredential" }
      },
      "notMembersInThisRevision": []
    },
    "BaseCredential": {
      "required": ["username"],
      "readOnly": [],
      "members": {
        "credentialType": { "type": "string" },
        "accountType": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" }
      },
      "notMembersInThisRevision": []
    },
    "AutoRotateCredentialPolicyInputSpec": {
      "required": ["enableAutoRotatePolicy"],
      "readOnly": [],
      "members": {
        "frequencyInDays": { "type": "integer" },
        "enableAutoRotatePolicy": { "type": "boolean" }
      },
      "notMembersInThisRevision": []
    },
    "Task": {
      "required": ["creationTimestamp", "id", "name", "status"],
      "readOnly": [
        "id",
        "name",
        "type",
        "status",
        "creationTimestamp",
        "completionTimestamp",
        "subTasks",
        "errors",
        "resources",
        "resolutionStatus",
        "isCancellable",
        "isRetryable"
      ],
      "members": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "creationTimestamp": { "type": "string" },
        "completionTimestamp": { "type": "string" },
        "errors": { "type": "array", "items": "Error" }
      },
      "notMembersInThisRevision": []
    },
    "CredentialsTask": {
      "required": ["creationTimestamp", "id", "name", "status", "type"],
      "readOnly": [
        "id",
        "name",
        "type",
        "creationTimestamp",
        "completionTimestamp",
        "status",
        "subTasks",
        "errors",
        "isAutoRotate"
      ],
      "members": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "creationTimestamp": { "type": "string" },
        "completionTimestamp": { "type": "string" },
        "subTasks": { "type": "array", "items": "CredentialsSubTask" },
        "errors": { "type": "array", "items": "Error" },
        "isAutoRotate": { "type": "boolean" }
      },
      "notMembersInThisRevision": []
    },
    "CredentialsSubTask": {
      "required": ["creationTimestamp", "description", "name", "status"],
      "readOnly": [
        "id",
        "resourceName",
        "name",
        "description",
        "creationTimestamp",
        "completionTimestamp",
        "status",
        "dependentSubTasks",
        "errors",
        "oldPassword",
        "newPassword",
        "entityType",
        "username",
        "credentialType"
      ],
      "members": {
        "id": { "type": "string" },
        "resourceName": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "creationTimestamp": { "type": "string" },
        "completionTimestamp": { "type": "string" },
        "status": { "type": "string" },
        "errors": { "type": "array", "items": "Error" },
        "oldPassword": { "type": "string" },
        "newPassword": { "type": "string" },
        "entityType": { "type": "string" },
        "username": { "type": "string" },
        "credentialType": { "type": "string" }
      },
      "notMembersInThisRevision": []
    },
    "Error": {
      "required": [],
      "readOnly": ["errorCode", "errorType", "arguments", "context", "message", "referenceToken", "label", "remediationUrl"],
      "members": {
        "errorCode": { "type": "string" },
        "errorType": { "type": "string" },
        "message": { "type": "string" },
        "remediationMessage": { "type": "string" },
        "referenceToken": { "type": "string" }
      },
      "notMembersInThisRevision": []
    }
  },
  "requestRules": {
    "rejectUnknownMembers": true,
    "rejectNullMembers": true,
    "rejectBlankStringMembers": true,
    "rejectZeroValuedOptionalNumbers": true,
    "rejectQueryString": true,
    "requireSingleAuthorizationHeader": true,
    "requireSingleAcceptHeader": true,
    "contentTypeOnlyWhenBodyIsSent": true,
    "notes": [
      "An optional member that is unset is absent from the encoded body. It is never sent as null, as an empty string, as 0 or as any other placeholder, so the appliance sees no member at all. Omission is decided per array element: one ResourceCredentials element may carry resourceId while its sibling omits it, and one BaseCredential element may carry accountType while its sibling omits it.",
      "A required member is sent even when it holds a zero value. AutoRotateCredentialPolicyInputSpec.enableAutoRotatePolicy is required, so false is transmitted as false rather than omitted, while the optional frequencyInDays alongside it is omitted when it is zero.",
      "No readOnly member of Task, CredentialsTask or CredentialsSubTask is a member of any request schema, so any such name appearing in a request body is a contract violation."
    ]
  },
  "vocabularies": {
    "operationType": {
      "schema": "CredentialsUpdateSpec",
      "member": "operationType",
      "allowed": ["UPDATE", "ROTATE", "REMEDIATE", "UPDATE_AUTO_ROTATE_POLICY"]
    },
    "resourceType": {
      "schema": "ResourceCredentials",
      "member": "resourceType",
      "allowed": ["ESXI", "VCENTER", "PSC", "NSXT_MANAGER", "NSXT_EDGE", "NSX_ALB", "BACKUP"],
      "addedIn9_1_0_0": ["HCX_MANAGER", "VSP"]
    },
    "credentialsTaskStatus": {
      "schema": "CredentialsTask",
      "member": "status",
      "allowed": ["PENDING", "IN_PROGRESS", "SUCCESSFUL", "FAILED", "USER_CANCELLED", "INCONSISTENT"],
      "nonTerminal": ["PENDING", "IN_PROGRESS"],
      "terminalSuccessful": ["SUCCESSFUL"],
      "terminalUnsuccessful": ["FAILED", "USER_CANCELLED", "INCONSISTENT"],
      "cancellable": ["FAILED", "INCONSISTENT"]
    },
    "taskStatus": {
      "schema": "Task",
      "member": "status",
      "allowed": [
        "PENDING",
        "Pending",
        "IN_PROGRESS",
        "In Progress",
        "SUCCESSFUL",
        "Successful",
        "FAILED",
        "Failed",
        "CANCELLED",
        "Cancelled",
        "COMPLETED_WITH_WARNING",
        "SKIPPED"
      ],
      "note": "The accepted 202 representation of updateOrRotatePasswords is a Task, whose status vocabulary carries mixed-case spellings such as \"Pending\" and \"In Progress\". The polled representation is a CredentialsTask, whose vocabulary is strictly upper snake case and carries USER_CANCELLED and INCONSISTENT, which Task does not. The two must not be conflated."
    }
  }
}

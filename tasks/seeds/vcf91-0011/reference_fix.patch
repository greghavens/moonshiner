 # Stable SDDC Manager domain inventory using the VMware.Sdk.Vcf PowerCLI binding.
 Set-StrictMode -Version Latest
 
+function Sort-VcfDomainsOrdinal {
+    param(
+        [Parameter(Mandatory)]
+        [AllowEmptyCollection()]
+        [object[]]$Domains
+    )
+
+    $ordered = [object[]]@($Domains)
+    [Array]::Sort(
+        $ordered,
+        [System.Comparison[object]] {
+            param($left, $right)
+            $byName = [string]::CompareOrdinal(
+                [string]$left.Name,
+                [string]$right.Name
+            )
+            if ($byName -ne 0) {
+                return $byName
+            }
+            return [string]::CompareOrdinal(
+                [string]$left.Id,
+                [string]$right.Id
+            )
+        }
+    )
+    return $ordered
+}

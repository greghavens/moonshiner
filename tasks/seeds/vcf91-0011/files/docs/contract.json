{
  "contract_version": 1,
  "product": "VMware Cloud Foundation 9.1 SDDC Manager REST API",
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "spec_info_version": "9.1.0.0",
    "license": "Apache-2.0"
  },
  "operations": [
    {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "request": {
        "content_type": "application/json",
        "schema": "TokenCreationSpec",
        "properties_used": [
          "username",
          "password"
        ]
      },
      "success": {
        "status": 201,
        "schema": "TokenPair",
        "properties_used": [
          "accessToken",
          "refreshToken.id"
        ]
      },
      "powercli_binding": {
        "module": "VMware.Sdk.Vcf.SddcManager",
        "command": "Connect-VcfSddcManagerServer"
      }
    },
    {
      "operationId": "getDomains",
      "method": "GET",
      "path": "/v1/domains",
      "query_parameters": {
        "type": {
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        "name": {
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        "vcFqdn": {
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        "vcInstanceId": {
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        "isManagementSsoDomain": {
          "required": false,
          "schema": {
            "type": "boolean"
          }
        },
        "pageNumber": {
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          },
          "default_declared_by_spec": false
        },
        "pageSize": {
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        },
        "useCache": {
          "required": false,
          "schema": {
            "type": "boolean"
          }
        }
      },
      "success": {
        "status": 200,
        "schema": "PageOfDomain",
        "elements_schema": "Domain",
        "page_metadata_schema": "PageMetadata",
        "page_metadata_properties": {
          "pageNumber": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "pageSize": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "totalElements": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "totalPages": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          }
        },
        "domain_properties_used": [
          "id",
          "name",
          "type",
          "status",
          "isManagementSsoDomain"
        ]
      },
      "powercli_binding": {
        "module": "VMware.Sdk.Vcf.SddcManager",
        "command": "Invoke-VcfGetDomains"
      }
    }
  ],
  "client_policy": {
    "first_request": "Pass pageSize and omit pageNumber because the getDomains OpenAPI parameter is optional and declares no default.",
    "continuation": "After each response, use pageMetadata.pageNumber + 1 for the next request.",
    "completion": "Accumulate elements until their count equals pageMetadata.totalElements. Reject changing totals, overshoot, or a non-progressing page.",
    "ordering": {
      "comparison": "ordinal case-sensitive",
      "keys": [
        "name",
        "id"
      ]
    },
    "projection_key_order": [
      "id",
      "name",
      "type",
      "status",
      "isManagementSsoDomain"
    ],
    "export": {
      "root_key_order": [
        "domains"
      ],
      "json": "compact",
      "encoding": "UTF-8 without BOM",
      "terminator": "one LF byte"
    }
  }
}

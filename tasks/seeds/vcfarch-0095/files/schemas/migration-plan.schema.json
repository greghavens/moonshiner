{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0095:migration-plan:1.0",
  "title": "Pinned VCF workload-domain migration plan",
  "type": "object",
  "required": [
    "schemaVersion",
    "planId",
    "fleetId",
    "domainId",
    "targetVcfVersion",
    "compatibilitySnapshot",
    "managementDomainDisposition",
    "releasePath",
    "components",
    "steps",
    "researchConsulted"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "fleetId": {
      "type": "string",
      "minLength": 1
    },
    "domainId": {
      "type": "string",
      "minLength": 1
    },
    "targetVcfVersion": {
      "type": "string",
      "minLength": 1
    },
    "compatibilitySnapshot": {
      "type": "string",
      "minLength": 1
    },
    "managementDomainDisposition": {
      "const": "UNCHANGED"
    },
    "releasePath": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "domainId",
          "kind",
          "currentVersion",
          "targetVersion",
          "action",
          "gates"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "domainId": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "currentVersion": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "action": {"enum": ["PRESERVE", "UPGRADE"]},
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "id", "action", "componentIds", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "id": {"type": "string", "minLength": 1},
          "action": {"enum": ["PRECHECK", "UPGRADE", "COMPLETE"]},
          "componentIds": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "researchConsulted": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "additionalProperties": true
}

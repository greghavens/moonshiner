+    private static List<Object> steps(Map<String, Object> snapshot) {
+        List<Object> result = new ArrayList<>();
+        List<Object> ordered = array(snapshot.get("orderedSteps"), "orderedSteps");
+        for (int index = 0; index < ordered.size(); index++) {
+            Map<String, Object> pinned = object(ordered.get(index), "orderedSteps[" + index + "]");
+            Map<String, Object> step = new LinkedHashMap<>();
+            step.put("order", BigDecimal.valueOf(index + 1L));
+            step.put("id", pinned.get("id"));
+            step.put("action", pinned.get("action"));
+            step.put("componentIds", pinned.get("componentIds"));
+            step.put("gates", pinned.get("gates"));
+            result.add(step);
+        }
+        return result;
+    }

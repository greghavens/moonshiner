+    private static List<Object> components(Map<String, Object> inventory,
+                                           Map<String, Object> snapshot) {
+        List<Object> result = new ArrayList<>();
+        Map<String, Object> targets = object(snapshot.get("componentTargets"), "componentTargets");
+        Map<String, Object> rules = object(snapshot.get("componentRules"), "componentRules");
+        for (String domainKey : List.of("managementDomain", "workloadDomain")) {
+            Map<String, Object> domain = object(inventory.get(domainKey), domainKey);
+            String domainId = string(domain.get("domainId"), domainKey + ".domainId");
+            boolean preserve = "managementDomain".equals(domainKey);
+            for (Object raw : array(domain.get("components"), domainKey + ".components")) {
+                Map<String, Object> source = object(raw, domainKey + " component");
+                String id = string(source.get("id"), "component.id");
+                String kind = string(source.get("kind"), "component.kind");
+                Map<String, Object> rule = object(rules.get(id), "componentRules." + id);
+                Map<String, Object> component = new LinkedHashMap<>();
+                component.put("id", id);
+                component.put("name", source.get("name"));
+                component.put("domainId", domainId);
+                component.put("kind", kind);
+                component.put("currentVersion", source.get("version"));
+                component.put("targetVersion", preserve ? source.get("version") : targets.get(kind));
+                component.put("action", rule.get("action"));
+                component.put("gates", rule.get("gates"));
+                result.add(component);
+            }
+        }
+        return result;
+    }

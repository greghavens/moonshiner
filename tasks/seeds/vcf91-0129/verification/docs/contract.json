{
  "contract_version": "1.0.0",
  "product_version": "9.1.0.0",
  "source": {
    "repository": "vmware/vcf-api-specs",
    "commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "blob_sha": "8028b0824c4ff3503d05f44814f967938a795c40",
    "path": "specifications/vsphere/openapi/automation/vcenter.yaml",
    "license": "Apache-2.0",
    "openapi": "3.0.3"
  },
  "server_base_path": "/api",
  "security": {
    "scheme": "api_key_auth",
    "type": "apiKey",
    "in": "header",
    "name": "vmware-api-session-id"
  },
  "operations": [
    {
      "name": "namespace.createV2",
      "operationId": "Vcenter.Namespaces.Instances_createV2",
      "method": "POST",
      "path": "/vcenter/namespaces/instances/v2",
      "request": {
        "content_type": "application/json",
        "schema": "Vcenter.Namespaces.Instances.CreateSpecV2",
        "required": [
          "namespace",
          "supervisor"
        ],
        "optional": [
          "zones",
          "network_spec",
          "description",
          "resource_spec",
          "access_list",
          "storage_specs",
          "networks",
          "vm_service_spec",
          "content_libraries",
          "creator",
          "namespace_network",
          "edges",
          "infrastructure_policies"
        ],
        "storage_item": {
          "schema": "Vcenter.Namespaces.Instances.StorageSpec",
          "required": [
            "policy"
          ],
          "optional": [
            "limit"
          ],
          "limit_unit": "MiB"
        }
      },
      "success": {
        "status": 204,
        "body": false
      }
    },
    {
      "name": "namespace.getV2",
      "operationId": "Vcenter.Namespaces.Instances_getV2",
      "method": "GET",
      "path": "/vcenter/namespaces/instances/v2/{namespace}",
      "path_parameters": {
        "namespace": {
          "required": true,
          "type": "string"
        }
      },
      "success": {
        "status": 200,
        "content_type": "application/json",
        "schema": "Vcenter.Namespaces.Instances.InfoV2"
      },
      "status_field": "config_status",
      "status_values": [
        "CONFIGURING",
        "REMOVING",
        "RUNNING",
        "ERROR"
      ],
      "terminal_success": [
        "RUNNING"
      ],
      "terminal_failure": [
        "REMOVING",
        "ERROR"
      ]
    }
  ],
  "kubernetes_routes": [
    {
      "name": "kubernetes.cluster.create",
      "contract_id": "Kubernetes.Cluster_create",
      "method": "POST",
      "path": "/apis/cluster.x-k8s.io/v1beta1/namespaces/{namespace}/clusters",
      "content_type": "application/json",
      "api_version": "cluster.x-k8s.io/v1beta1",
      "kind": "Cluster",
      "success_status": 201
    },
    {
      "name": "kubernetes.cluster.get",
      "contract_id": "Kubernetes.Cluster_get",
      "method": "GET",
      "path": "/apis/cluster.x-k8s.io/v1beta1/namespaces/{namespace}/clusters/{cluster}",
      "success_status": 200,
      "ready_condition": {
        "type": "Ready",
        "status": "True"
      },
      "phase_field": "status.phase",
      "terminal_failure": [
        "Failed",
        "Deleting"
      ]
    }
  ]
}

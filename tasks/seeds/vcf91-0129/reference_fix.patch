+function Join-VksUri {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [uri] $BaseUri,
+
+        [Parameter(Mandatory)]
+        [string] $Path
+    )
+
+    return '{0}/{1}' -f $BaseUri.AbsoluteUri.TrimEnd('/'), $Path.TrimStart('/')
+}
+
+function ConvertTo-VksPathSegment {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $Value
+    )
+
+    return [uri]::EscapeDataString($Value)
+}
+
+function Invoke-VksJsonRequest {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateSet('GET', 'POST')]
+        [string] $Method,
+
+        [Parameter(Mandatory)]
+        [uri] $Uri,
+
+        [Parameter(Mandatory)]
+        [hashtable] $Headers,
+
+        [object] $Body,
+
+        [switch] $HasBody
+    )
+
+    $request = @{
+        Method = $Method
+        Uri = $Uri
+        Headers = $Headers
+        ErrorAction = 'Stop'
+    }
+    if ($HasBody) {
+        $request.ContentType = 'application/json'
+        $request.Body = $Body | ConvertTo-Json -Depth 32 -Compress
+    }
+    return Invoke-RestMethod @request
+}

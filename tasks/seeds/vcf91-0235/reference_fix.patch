+func isTerminalTaskStatus(status string) bool {
+	switch status {
+	case "SUCCEEDED", "FAILED", "CANCELED":
+		return true
+	default:
+		return false
+	}
+}
+
+// awaitTask polls getTask until the task reaches a terminal state. Failures are
+// attributed to the plan step that submitted the task, not to getTask.
+func (c *Client) awaitTask(ctx context.Context, operationID string, accepted taskDocument) (taskDocument, *StepError) {
+	current := accepted
+	if current.ID == "" {
+		return current, &StepError{OperationID: operationID, Message: "service accepted the change without returning a task id"}
+	}
+
+	// PollTimeout bounds the entire polling phase, including an in-flight getTask
+	// request and the wait between polls. The first getTask is always issued
+	// immediately, even if the acceptance response already looks terminal.
+	pollCtx, cancel := context.WithTimeout(ctx, c.pollTimeout)
+	defer cancel()
+
+	timedOut := func() (taskDocument, *StepError) {
+		return current, &StepError{
+			OperationID: operationID,
+			TaskID:      current.ID,
+			TaskStatus:  current.Status,
+			Message:     "task did not reach a terminal state within " + c.pollTimeout.String(),
+			Err:         context.DeadlineExceeded,
+		}
+	}
+	cancelled := func() (taskDocument, *StepError) {
+		return current, &StepError{
+			OperationID: operationID,
+			TaskID:      current.ID,
+			TaskStatus:  current.Status,
+			Message:     "polling was cancelled",
+			Err:         ctx.Err(),
+		}
+	}
+
+	for {
+		if ctx.Err() != nil {
+			return cancelled()
+		}
+		if pollCtx.Err() != nil {
+			return timedOut()
+		}
+
+		var next taskDocument
+		if se := c.call(pollCtx, OpGetTask, http.MethodGet,
+			"/v1/tasks/"+url.PathEscape(current.ID), nil, false, 200, &next); se != nil {
+			if ctx.Err() != nil {
+				return cancelled()
+			}
+			if pollCtx.Err() != nil {
+				return timedOut()
+			}
+			se.OperationID = operationID
+			se.TaskID = current.ID
+			se.TaskStatus = current.Status
+			return current, se
+		}
+		current = next
+
+		if isTerminalTaskStatus(current.Status) {
+			break
+		}
+		switch current.Status {
+		case "PENDING", "SCHEDULED", "RUNNING":
+			// Continue below after PollInterval.
+		default:
+			return current, &StepError{
+				OperationID: operationID,
+				TaskID:      current.ID,
+				TaskStatus:  current.Status,
+				Message:     "task returned an unrecognized status",
+			}
+		}
+
+		timer := time.NewTimer(c.pollInterval)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return cancelled()
+		case <-pollCtx.Done():
+			timer.Stop()
+			if ctx.Err() != nil {
+				return cancelled()
+			}
+			return timedOut()
+		case <-timer.C:
+		}
+	}
+
+	if current.Status == "SUCCEEDED" {
+		return current, nil
+	}
+	stage, message := diagnoseTask(current)
+	return current, &StepError{
+		OperationID: operationID,
+		TaskID:      current.ID,
+		TaskStatus:  current.Status,
+		FailedStage: stage,
+		Message:     message,
+	}
+}
+
+// diagnoseTask returns the name of the stage that failed and the error message that
+// explains it, so an unsuccessful step is reported with the same detail the service
+// reported.
+func diagnoseTask(task taskDocument) (string, string) {
+	stage := ""
+	message := ""
+	for _, st := range task.Stages {
+		if st.Status != "FAILED" {
+			continue
+		}
+		stage = st.Name
+		for _, m := range st.Messages {
+			if m.Level == "ERROR" && m.Message.DefaultMessage != "" {
+				message = m.Message.DefaultMessage
+				break
+			}
+		}
+		break
+	}
+	if message == "" {
+		for _, m := range task.Messages {
+			if m.Level == "ERROR" && m.Message.DefaultMessage != "" {
+				message = m.Message.DefaultMessage
+				break
+			}
+		}
+	}
+	if message == "" {
+		message = "task ended " + task.Status
+	}
+	return stage, message
 }

+func buildComponentSpecs(components []ComponentPlan) componentSpecsBody {
+	out := componentSpecsBody{ComponentSpecs: make([]ovaComponentSpecBody, 0, len(components))}
+	for _, cp := range components {
+		nodes := make([]ovaNodeSpecBody, 0, len(cp.Nodes))
+		for _, n := range cp.Nodes {
+			node := ovaNodeSpecBody{
+				NodeType: n.NodeType,
+				Version:  n.Version,
+				Repository: componentRepositoryBody{
+					DownloadURL: n.DownloadURL,
+					Certificate: n.RepositoryCert,
+				},
+				DeploymentSpec: ovaDeploymentSpecBody{
+					FQDN:             n.FQDN,
+					Password:         n.Password,
+					DeploymentOption: n.DeploymentOption,
+					DNSServers:       n.DNSServers,
+					NTPServers:       n.NTPServers,
+					DNSSuffix:        n.DNSSuffix,
+					NetworkName:      n.NetworkName,
+					ExtraConfig:      n.ExtraConfig,
+				},
+				DeploymentMode: n.DeploymentMode,
+			}
+			if n.IPv4 != nil {
+				node.DeploymentSpec.IPv4Settings = &ipv4SettingsBody{
+					AddressType: n.IPv4.AddressType,
+					Address:     n.IPv4.Address,
+					Gateway:     n.IPv4.Gateway,
+					Netmask:     n.IPv4.Netmask,
+				}
+			}
+			if n.IPv6 != nil {
+				node.DeploymentSpec.IPv6Settings = &ipv6SettingsBody{
+					AddressType: n.IPv6.AddressType,
+					Address:     n.IPv6.Address,
+					Gateway:     n.IPv6.Gateway,
+					Netmask:     n.IPv6.Netmask,
+					Force:       n.IPv6.Force,
+				}
+			}
+			nodes = append(nodes, node)
+		}
+		out.ComponentSpecs = append(out.ComponentSpecs, ovaComponentSpecBody{
+			DeploymentType: cp.DeploymentType,
+			ComponentType:  cp.ComponentType,
+			NodeSpecs:      nodes,
+		})
+	}
+	return out
+}

 // Apply runs the plan steps in PlanOperations order and returns a complete report.
 //
 // The returned *PlanReport is non-nil even when the error is non-nil: steps that ran
 // before the failure keep their real outcome, the failing step is reported with its
 // diagnosis, and every step after it is reported as skipped.
 func (c *Client) Apply(ctx context.Context, plan Plan) (*PlanReport, error) {
-	return nil, ErrNotImplemented
+	report := &PlanReport{Steps: make([]StepReport, len(PlanOperations))}
+	for i, op := range PlanOperations {
+		report.Steps[i] = StepReport{OperationID: op, Status: StatusSkipped}
+	}
+
+	record := func(operationID string, step StepReport) {
+		step.OperationID = operationID
+		for i := range report.Steps {
+			if report.Steps[i].OperationID == operationID {
+				report.Steps[i] = step
+				return
+			}
+		}
+	}
+
+	// abort records the failure against its own step, marks every later step as
+	// skipped, and returns the still-complete report alongside the error.
+	abort := func(se *StepError) (*PlanReport, error) {
+		record(se.OperationID, StepReport{
+			Status:      StatusFailed,
+			TaskID:      se.TaskID,
+			TaskStatus:  se.TaskStatus,
+			FailedStage: se.FailedStage,
+			Message:     se.Message,
+			HTTPStatus:  se.HTTPStatus,
+		})
+		failedAt := -1
+		for i, op := range PlanOperations {
+			if op == se.OperationID {
+				failedAt = i
+				break
+			}
+		}
+		for i := failedAt + 1; i < len(PlanOperations); i++ {
+			report.Steps[i] = StepReport{
+				OperationID: PlanOperations[i],
+				Status:      StatusSkipped,
+				Message:     "skipped after " + se.OperationID + " failed",
+			}
+		}
+		return report, se
+	}
+
+	depot := fleetDepotSpecBody{FQDN: plan.Depot.FQDN, Certificate: plan.Depot.Certificate}
+
+	// Step 1: register the fleet depot and drive the accepted task to a terminal state.
+	var accepted taskDocument
+	if se := c.call(ctx, OpSetDepot, http.MethodPost, "/v1/depot", depot, true, 202, &accepted); se != nil {
+		return abort(se)
+	}
+	final, se := c.awaitTask(ctx, OpSetDepot, accepted)
+	if se != nil {
+		return abort(se)
+	}

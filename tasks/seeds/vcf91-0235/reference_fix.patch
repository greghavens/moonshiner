+// normalizeRoot accepts an absolute http or https service root and returns
+// "scheme://host". A userinfo component, a non-root path, a query or a fragment is
+// rejected: ServiceBasePath is the only path the client is allowed to prepend.
+func normalizeRoot(raw string) (string, error) {
+	if strings.TrimSpace(raw) == "" {
+		return "", errors.New("fleetlcm: base URL is required")
+	}
+	u, err := url.Parse(raw)
+	if err != nil {
+		return "", fmt.Errorf("fleetlcm: base URL is not a valid URL: %w", err)
+	}
+	scheme := strings.ToLower(u.Scheme)
+	if scheme != "http" && scheme != "https" {
+		return "", fmt.Errorf("fleetlcm: base URL scheme %q is not http or https", u.Scheme)
+	}
+	if u.Host == "" || u.Hostname() == "" {
+		return "", errors.New("fleetlcm: base URL has no host")
+	}
+	if u.User != nil {
+		return "", errors.New("fleetlcm: base URL must not carry userinfo")
+	}
+	if u.RawQuery != "" || u.ForceQuery {
+		return "", errors.New("fleetlcm: base URL must not carry a query")
+	}
+	if strings.Contains(raw, "#") || u.Fragment != "" || u.RawFragment != "" {
+		return "", errors.New("fleetlcm: base URL must not carry a fragment")
+	}
+	if path := u.EscapedPath(); path != "" && path != "/" {
+		return "", fmt.Errorf("fleetlcm: base URL must be a service root, got path %q", u.EscapedPath())
+	}
+	return scheme + "://" + u.Host, nil
+}

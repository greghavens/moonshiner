+// correlatable reports whether the pinned specification declares the optional
+// X-Correlation-Id header parameter on operationID.
+func correlatable(operationID string) bool {
+	switch operationID {
+	case OpSetDepot, OpCreateComponents, OpUpdateComponentConfig:
+		return true
+	default:
+		return false
+	}
+}
+
+// call issues one contract operation. A nil body means no request entity, in which
+// case no Content-Type header is sent.
+func (c *Client) call(ctx context.Context, operationID, method, path string, body any,
+	correlate bool, wantStatus int, out any) *StepError {
+
+	target := c.root + ServiceBasePath + path
+
+	var reader io.Reader
+	var encoded []byte
+	if body != nil {
+		var err error
+		encoded, err = json.Marshal(body)
+		if err != nil {
+			return &StepError{OperationID: operationID, Message: "request body could not be encoded", Err: err}
+		}
+		reader = bytes.NewReader(encoded)
+	}
+
+	req, err := http.NewRequestWithContext(ctx, method, target, reader)
+	if err != nil {
+		return &StepError{OperationID: operationID, Message: "request could not be built", Err: err}
+	}
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("Authorization", "Bearer "+c.token)
+	if body != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	if correlate && correlatable(operationID) && c.correlationID != "" {
+		req.Header.Set("X-Correlation-Id", c.correlationID)
+	}
+
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return &StepError{OperationID: operationID, Message: "transport failure", Err: err}
+	}
+	defer func() {
+		_, _ = io.Copy(io.Discard, resp.Body)
+		_ = resp.Body.Close()
+	}()
+
+	payload, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return &StepError{OperationID: operationID, Message: "response could not be read", Err: err}
+	}
+
+	if resp.StatusCode != wantStatus {
+		se := &StepError{OperationID: operationID, HTTPStatus: resp.StatusCode}
+		var er errorResponseBody
+		if json.Unmarshal(payload, &er) == nil && er.Message.DefaultMessage != "" {
+			se.Message = er.Message.DefaultMessage
+		} else {
+			se.Message = "unexpected HTTP status " + strconv.Itoa(resp.StatusCode)
+		}
+		return se
+	}
+
+	if out != nil {
+		if err := json.Unmarshal(payload, out); err != nil {
+			return &StepError{OperationID: operationID, Message: "response body could not be decoded", Err: err}
+		}
+	}
+	return nil
+}

+// validateHeaderValue rejects a blank value and any ASCII control character, so no
+// caller-supplied string can split or forge a request header.
+func validateHeaderValue(what, value string) error {
+	if strings.TrimSpace(value) == "" {
+		return fmt.Errorf("fleetlcm: %s is required", what)
+	}
+	for _, r := range value {
+		if r < 0x20 || r == 0x7f {
+			return fmt.Errorf("fleetlcm: %s contains a control character", what)
+		}
+	}
+	return nil
+}

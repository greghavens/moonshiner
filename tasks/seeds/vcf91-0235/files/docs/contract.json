{
  "contractVersion": 1,
  "derivedFrom": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commitSha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "path": "specifications/sddc-lcm/sddc-lcm-openapi.yaml",
    "specRawUrl": "https://raw.githubusercontent.com/vmware/vcf-api-specs/3949fc33339fc5ea1b77eadb258f1cf49aa88e26/specifications/sddc-lcm/sddc-lcm-openapi.yaml",
    "license": "Apache-2.0",
    "openapi": "3.0.4",
    "title": "VCF SDDC LCM Service APIs",
    "apiVersion": "9.1.0.0"
  },
  "server": {
    "url": "https://vcf.broadcom.com/sddc-lcm",
    "basePath": "/sddc-lcm",
    "description": "VCF SDDC LCM Service"
  },
  "security": {
    "scheme": "bearerToken",
    "type": "http",
    "httpScheme": "Bearer",
    "bearerFormat": "JWT"
  },
  "operationIds": [
    "setDepot",
    "resolveDepotComponents",
    "createComponents",
    "getTask",
    "updateComponentConfig"
  ],
  "operations": [
    {
      "operationId": "setDepot",
      "method": "POST",
      "path": "/v1/depot",
      "description": "Register Fleet Depot as a depot to components known to this SDDC LCM instance",
      "tags": [
        "Depot"
      ],
      "specJsonPointer": "/paths/~1v1~1depot/post",
      "parameters": [
        {
          "name": "X-Correlation-Id",
          "in": "header",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "required": false,
        "mediaType": "application/json",
        "schema": {
          "$ref": "#/schemas/FleetDepotSpec"
        }
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/Task"
          }
        },
        "400": {
          "description": "Bad request. Invalid input specification.",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/ErrorResponse"
          }
        },
        "401": {
          "description": "Unauthorized",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/ErrorResponse"
          }
        },
        "500": {
          "description": "Internal server error",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/ErrorResponse"
          }
        }
      },
      "successStatus": 202
    },
    {
      "operationId": "resolveDepotComponents",
      "method": "POST",
      "path": "/v1/depot/components",
      "description": "Resolve component versions to binary urls given a Fleet Depot endpoint and a list of components with their versions",
      "tags": [
        "Depot"
      ],
      "specJsonPointer": "/paths/~1v1~1depot~1components/post",
      "parameters": [],
      "requestBody": {
        "required": false,
        "mediaType": "application/json",
        "schema": {
          "$ref": "#/schemas/DepotComponentsSpec"
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/ResolvedComponentVersions"
          }
        },
        "400": {
          "description": "Bad request. Invalid input specification.",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/ErrorResponse"
          }
        },
        "401": {
          "description": "Unauthorized",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/ErrorResponse"
          }
        },
        "500": {
          "description": "Internal server error",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/ErrorResponse"
          }
        }
      },
      "successStatus": 200
    },
    {
      "operationId": "createComponents",
      "method": "POST",
      "path": "/v1/components",
      "description": "Install new or import existing component(s).",
      "tags": [
        "Components"
      ],
      "specJsonPointer": "/paths/~1v1~1components/post",
      "parameters": [
        {
          "name": "X-Correlation-Id",
          "in": "header",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "required": false,
        "mediaType": "application/json",
        "schema": {
          "$ref": "#/schemas/ComponentSpecs"
        }
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/Task"
          }
        },
        "400": {
          "description": "Bad request. Invalid input specification.",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/ErrorResponse"
          }
        },
        "401": {
          "description": "Unauthorized",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/ErrorResponse"
          }
        },
        "500": {
          "description": "Internal server error",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/ErrorResponse"
          }
        }
      },
      "successStatus": 202
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{taskId}",
      "description": "Get a task",
      "tags": [
        "Task"
      ],
      "specJsonPointer": "/paths/~1v1~1tasks~1{taskId}/get",
      "parameters": [
        {
          "name": "taskId",
          "in": "path",
          "required": true,
          "schema": {
            "format": "uuid",
            "type": "string"
          }
        }
      ],
      "requestBody": null,
      "responses": {
        "200": {
          "description": "OK",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/Task"
          }
        },
        "404": {
          "description": "Not Found",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/ErrorResponse"
          }
        },
        "500": {
          "description": "Internal Server Error",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/ErrorResponse"
          }
        }
      },
      "successStatus": 200
    },
    {
      "operationId": "updateComponentConfig",
      "method": "PATCH",
      "path": "/v1/components/{componentId}/config",
      "description": "Update a Component's config.",
      "tags": [
        "Components"
      ],
      "specJsonPointer": "/paths/~1v1~1components~1{componentId}~1config/patch",
      "parameters": [
        {
          "name": "X-Correlation-Id",
          "in": "header",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "componentId",
          "in": "path",
          "required": true,
          "schema": {
            "format": "uuid",
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "required": false,
        "mediaType": "application/json",
        "schema": {
          "$ref": "#/schemas/ComponentConfigUpdateSpec"
        }
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/Task"
          }
        },
        "400": {
          "description": "Bad request. Invalid input specification.",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/ErrorResponse"
          }
        },
        "401": {
          "description": "Unauthorized",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/ErrorResponse"
          }
        },
        "500": {
          "description": "Internal server error",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/ErrorResponse"
          }
        }
      },
      "successStatus": 202
    }
  ],
  "schemas": {
    "FleetDepotSpec": {
      "properties": {
        "fqdn": {
          "type": "string"
        },
        "certificate": {
          "description": "PEM encoded certificate (chain).",
          "type": "string"
        }
      },
      "required": [
        "certificate",
        "fqdn"
      ],
      "title": "Fleet Depot endpoint.",
      "type": "object"
    },
    "ComponentVersionSpec": {
      "properties": {
        "component": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "component"
      ],
      "type": "object"
    },
    "DepotComponentsSpec": {
      "properties": {
        "fleetDepotSpec": {
          "$ref": "#/schemas/FleetDepotSpec"
        },
        "version": {
          "type": "string"
        },
        "componentVersions": {
          "items": {
            "$ref": "#/schemas/ComponentVersionSpec"
          },
          "type": "array"
        }
      },
      "required": [
        "componentVersions",
        "fleetDepotSpec"
      ],
      "title": "Depot Components spec",
      "type": "object"
    },
    "ResolvedComponentVersion": {
      "properties": {
        "component": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "binaryUrl": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "ResolvedComponentVersions": {
      "properties": {
        "componentVersions": {
          "items": {
            "$ref": "#/schemas/ResolvedComponentVersion"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ComponentSpecs": {
      "properties": {
        "componentSpecs": {
          "items": {
            "$ref": "#/schemas/ComponentSpec"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ComponentSpec": {
      "description": "Component Install Spec",
      "discriminator": {
        "mapping": {
          "OvaComponentSpec": "#/schemas/OvaComponentSpec",
          "VspComponentSpec": "#/schemas/VspComponentSpec",
          "VspClusterSpec": "#/schemas/VspClusterSpec",
          "ComponentImportSpec": "#/schemas/ComponentImportSpec"
        },
        "propertyName": "deploymentType"
      },
      "oneOf": [
        {
          "$ref": "#/schemas/OvaComponentSpec"
        },
        {
          "$ref": "#/schemas/VspComponentSpec"
        },
        {
          "$ref": "#/schemas/VspClusterSpec"
        },
        {
          "$ref": "#/schemas/ComponentImportSpec"
        }
      ],
      "type": "object"
    },
    "OvaComponentSpec": {
      "properties": {
        "deploymentType": {
          "type": "string"
        },
        "componentType": {
          "type": "string"
        },
        "nodeSpecs": {
          "items": {
            "$ref": "#/schemas/OvaNodeSpec"
          },
          "type": "array"
        },
        "configSpec": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "componentType",
        "deploymentType",
        "nodeSpecs"
      ],
      "type": "object"
    },
    "OvaNodeSpec": {
      "properties": {
        "nodeType": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "repository": {
          "$ref": "#/schemas/ComponentRepository"
        },
        "deploymentSpec": {
          "$ref": "#/schemas/OvaDeploymentSpec"
        },
        "configSpec": {
          "additionalProperties": true,
          "type": "object"
        },
        "deploymentMode": {
          "enum": [
            "DEPLOY_AND_MONITOR",
            "DEPLOY_ONLY",
            "MONITOR_ONLY"
          ],
          "type": "string"
        }
      },
      "required": [
        "deploymentSpec",
        "nodeType",
        "repository",
        "version"
      ],
      "type": "object"
    },
    "ComponentRepository": {
      "properties": {
        "downloadUrl": {
          "type": "string"
        },
        "certificate": {
          "description": "PEM encoded certificate (chain).",
          "type": "string"
        }
      },
      "type": "object"
    },
    "OvaDeploymentSpec": {
      "properties": {
        "fqdn": {
          "type": "string"
        },
        "password": {
          "format": "password",
          "type": "string"
        },
        "deploymentOption": {
          "type": "string"
        },
        "dnsServers": {
          "type": "string"
        },
        "ntpServers": {
          "type": "string"
        },
        "dnsSuffix": {
          "type": "string"
        },
        "ipv4Settings": {
          "$ref": "#/schemas/IPv4Settings"
        },
        "ipv6Settings": {
          "$ref": "#/schemas/IPv6Settings"
        },
        "networkName": {
          "type": "string"
        },
        "extraConfigProperties": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra OVF Properties to pass during OVA deployment.",
          "type": "object"
        }
      },
      "type": "object"
    },
    "IPv4Settings": {
      "properties": {
        "addressType": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "gateway": {
          "type": "string"
        },
        "netmask": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "IPv6Settings": {
      "properties": {
        "force": {
          "type": "boolean"
        },
        "addressType": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "gateway": {
          "type": "string"
        },
        "netmask": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "ComponentConfigUpdateSpec": {
      "description": "Component Config Update Spec",
      "discriminator": {
        "mapping": {
          "OvaComponentConfigSpec": "#/schemas/OvaComponentConfigSpec",
          "VspComponentConfigSpec": "#/schemas/VspComponentConfigSpec",
          "VspClusterConfigSpec": "#/schemas/VspClusterConfigSpec"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/schemas/OvaComponentConfigSpec"
        },
        {
          "$ref": "#/schemas/VspComponentConfigSpec"
        },
        {
          "$ref": "#/schemas/VspClusterConfigSpec"
        }
      ],
      "type": "object"
    },
    "OvaComponentConfigSpec": {
      "description": "OVA component config spec",
      "properties": {
        "type": {
          "type": "string"
        },
        "nodeSizes": {
          "items": {
            "$ref": "#/schemas/OvaNodeSizeConfigSpec"
          },
          "type": "array"
        }
      },
      "required": [
        "nodeSizes",
        "type"
      ],
      "type": "object"
    },
    "OvaNodeSizeConfigSpec": {
      "description": "OVA component disk spec",
      "properties": {
        "nodeId": {
          "description": "ID of the node to resize",
          "format": "uuid",
          "type": "string"
        },
        "nodeName": {
          "description": "Node name",
          "type": "string"
        },
        "nodeType": {
          "description": "Node type",
          "type": "string"
        },
        "size": {
          "description": "Size of the node (e.g. Small/Medium/Large)",
          "type": "string"
        },
        "numCores": {
          "type": "integer"
        },
        "memoryGb": {
          "type": "integer"
        },
        "additionalDiskSize": {
          "description": "Size of the VMDK to be added to the node",
          "format": "int64",
          "type": "integer"
        },
        "additionalDiskDatastoreId": {
          "description": "Datastore Managed Object ID for the additional disk to land on",
          "type": "string"
        },
        "configMode": {
          "enum": [
            "CONFIG_AND_PERSIST",
            "CONFIG_ONLY",
            "PERSIST_ONLY"
          ],
          "type": "string"
        }
      },
      "required": [
        "additionalDiskSize",
        "nodeId",
        "size"
      ],
      "type": "object"
    },
    "Task": {
      "description": "Represents a hierarchical task structure supporting nested sub-tasks and execution steps.\nFor complete examples demonstrating the hierarchical task model with sub-tasks, steps, and \nvarious execution scenarios, see: classpath:sample-task-example.yaml\n",
      "properties": {
        "id": {
          "description": "Unique identifier for the task (UUID format)",
          "type": "string"
        },
        "name": {
          "description": "Unique name of the task",
          "type": "string"
        },
        "description": {
          "$ref": "#/schemas/LocalizableMessage"
        },
        "status": {
          "$ref": "#/schemas/TaskStatus"
        },
        "type": {
          "description": "Type of the task, example precheck, apply, validate, etc.",
          "type": "string"
        },
        "createdBy": {
          "description": "username or service account that triggered the task.",
          "type": "string"
        },
        "updatedBy": {
          "description": "username or service account that updated the task.",
          "type": "string"
        },
        "resourceId": {
          "description": "ID of resource on which the task is triggered",
          "type": "string"
        },
        "resourceType": {
          "description": "Type of resource on which the task is triggered",
          "type": "string"
        },
        "createTime": {
          "description": "ISO 8601 timestamp when this Task was created",
          "format": "date-time",
          "type": "string"
        },
        "startTime": {
          "description": "ISO 8601 timestamp when this Task was started",
          "format": "date-time",
          "type": "string"
        },
        "updateTime": {
          "description": "ISO 8601 timestamp when this Task was updated",
          "format": "date-time",
          "type": "string"
        },
        "endTime": {
          "description": "ISO 8601 timestamp when this Task was completed",
          "format": "date-time",
          "type": "string"
        },
        "correlationId": {
          "description": "ID used to correlate the task with other systems",
          "type": "string"
        },
        "parentTaskId": {
          "description": "ID of parent task",
          "type": "string"
        },
        "retriable": {
          "description": "Indicates if this task is in a state that can be retried",
          "type": "boolean"
        },
        "cancellable": {
          "description": "Indicates if this task is in a state that can be cancelled",
          "type": "boolean"
        },
        "taskSummary": {
          "$ref": "#/schemas/Task_taskSummary"
        },
        "stages": {
          "description": "list of steps being executed in the Task workflow.",
          "items": {
            "$ref": "#/schemas/TaskStage"
          },
          "type": "array"
        },
        "subTasks": {
          "description": "list of sub tasks within this parent task. Each sub task can have its own steps and can be executed independently.\nSee classpath:sample-task-example.yaml for comprehensive examples of hierarchical task structures.\n",
          "items": {
            "$ref": "#/schemas/Task"
          },
          "type": "array"
        },
        "messages": {
          "description": "list of messages at task level",
          "items": {
            "$ref": "#/schemas/TaskMessage"
          },
          "type": "array"
        },
        "result": {
          "$ref": "#/schemas/Task_result"
        },
        "additionalDetails": {
          "description": "A map of task-specific details. This can be used to store any additional information about the task that is relevant to a specific task.",
          "type": "object"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Task_taskSummary": {
      "description": "Summary information about sub tasks.\nSee sample-task-example.yaml for examples of how this summary is calculated.\n",
      "properties": {
        "totalSubTasks": {
          "description": "Total number of sub tasks in this task",
          "type": "integer"
        },
        "totalSteps": {
          "description": "Total number of steps across all sub tasks and this task",
          "type": "integer"
        }
      },
      "readOnly": true,
      "type": "object"
    },
    "TaskStage": {
      "properties": {
        "id": {
          "description": "ID of step",
          "type": "string"
        },
        "name": {
          "description": "name of step",
          "type": "string"
        },
        "description": {
          "$ref": "#/schemas/LocalizableMessage"
        },
        "status": {
          "$ref": "#/schemas/TaskStageStatus"
        },
        "updateTime": {
          "description": "ISO 8601 timestamp when the step was updated",
          "format": "date-time",
          "type": "string"
        },
        "startTime": {
          "description": "ISO 8601 timestamp when step started",
          "format": "date-time",
          "type": "string"
        },
        "endTime": {
          "description": "ISO 8601 timestamp when step ended",
          "format": "date-time",
          "type": "string"
        },
        "messages": {
          "description": "list of messages",
          "items": {
            "$ref": "#/schemas/TaskStageMessage"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "TaskStatus": {
      "description": "A common status object to define the lifecycle state of an operation",
      "enum": [
        "PENDING",
        "SCHEDULED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELED"
      ],
      "type": "string"
    },
    "TaskStageStatus": {
      "description": "Defines possible task step states",
      "enum": [
        "PENDING",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELED",
        "SKIPPED"
      ],
      "type": "string"
    },
    "TaskMessage": {
      "properties": {
        "timestamp": {
          "format": "date-time",
          "type": "string"
        },
        "level": {
          "enum": [
            "INFO",
            "WARN",
            "ERROR"
          ],
          "type": "string"
        },
        "message": {
          "$ref": "#/schemas/LocalizableMessage"
        }
      },
      "type": "object"
    },
    "TaskStageMessage": {
      "allOf": [
        {
          "$ref": "#/schemas/TaskMessage"
        },
        {
          "properties": {
            "stageId": {
              "type": "string"
            }
          },
          "type": "object"
        }
      ]
    },
    "LocalizableMessage": {
      "properties": {
        "id": {
          "description": "ID of the Localizable message.",
          "type": "string"
        },
        "defaultMessage": {
          "description": "Default message in English.",
          "type": "string"
        },
        "localizedMessage": {
          "description": "Localized message.",
          "type": "string"
        },
        "args": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-Value pair arguments that will be substitited in the message.",
          "type": "object"
        }
      },
      "type": "object"
    },
    "ErrorResponse": {
      "description": "Provides detailed information about an error that occurred during a system operation.\n",
      "properties": {
        "code": {
          "description": "Unique error code for programmatic identification.",
          "type": "string"
        },
        "message": {
          "$ref": "#/schemas/LocalizableMessage"
        },
        "resolution": {
          "$ref": "#/schemas/LocalizableMessage"
        },
        "referenceId": {
          "description": "An identifier for tracing the error in the logs.",
          "type": "string"
        },
        "timestamp": {
          "description": "The date and time when the error occurred.",
          "format": "date-time",
          "type": "string"
        },
        "detail": {
          "description": "Freeform extra information, such as raw error payloads or additional context.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "referenceId",
        "resolution",
        "timestamp"
      ],
      "type": "object"
    }
  }
}

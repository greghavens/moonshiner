+#!/usr/bin/env python3
+"""Produce the reference handoff through genuine course-registry execution."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+REGISTRY = ROOT / "course-registry"
+AUDIT_PATH = ROOT / ".harness" / "runtime" / "course-audit.jsonl"
+TARGETS = (
+    ("Museum collections care", "Arts Campus"),
+    ("Community budgeting workshop", "Civic Campus"),
+)
+
+
+def run_concurrently(commands: list[list[str]]) -> list[dict[str, Any]]:
+    processes = [
+        subprocess.Popen(
+            command,
+            cwd=ROOT,
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+            start_new_session=True,
+        )
+        for command in commands
+    ]
+    results: list[dict[str, Any]] = []
+    for process in processes:
+        stdout, stderr = process.communicate()
+        if process.returncode != 0:
+            raise RuntimeError(stderr.strip() or "course-registry command failed")
+        payload = json.loads(stdout)
+        if not isinstance(payload, dict):
+            raise RuntimeError("course-registry returned a non-object")
+        results.append(payload)
+    return results
+
+
+def sole_id(payload: dict[str, Any], target: tuple[str, str]) -> str:
+    matches = payload.get("matches")
+    if not isinstance(matches, list) or len(matches) != 1:
+        raise RuntimeError(f"lookup did not resolve uniquely: {target!r}")
+    match = matches[0]
+    if not isinstance(match, dict):
+        raise RuntimeError(f"lookup returned an invalid match: {target!r}")
+    if match.get("name") != target[0] or match.get("campus") != target[1]:
+        raise RuntimeError(f"lookup returned the wrong course: {target!r}")
+    stable_id = match.get("stable_id")
+    if not isinstance(stable_id, str) or not stable_id:
+        raise RuntimeError(f"lookup returned no stable ID: {target!r}")
+    return stable_id
+
+
+def complete_record(
+    payload: dict[str, Any], stable_id: str, target: tuple[str, str]
+) -> dict[str, Any]:
+    record = payload.get("record")
+    if not isinstance(record, dict):
+        raise RuntimeError(f"get returned no complete record: {stable_id}")
+    if (
+        record.get("stable_id") != stable_id
+        or record.get("name") != target[0]
+        or record.get("campus") != target[1]
+        or record.get("archived") is not False
+        or record.get("is_draft") is not False
+        or not isinstance(record.get("status"), str)
+        or not record["status"]
+        or not isinstance(record.get("date"), str)
+        or not record["date"]
+    ):
+        raise RuntimeError(f"get returned a mismatched record: {stable_id}")
+    return record
+
+
+def render(records: list[dict[str, Any]]) -> str:
+    lines = [
+        f"- {record['name']} | {record['campus']} | {record['stable_id']} | "
+        f"status {record['status']} | date {record['date']}"
+        for record in records
+    ]
+    status_result = (
+        "match" if records[0]["status"] == records[1]["status"] else "differ"
+    )
+    date_result = (
+        "match" if records[0]["date"] == records[1]["date"] else "differ"
+    )
+    lines.extend(
+        [
+            f"- Comparison | statuses {status_result} | dates {date_result}",
+            "- Changes | none",
+        ]
+    )
+    return "\n".join(lines) + "\n"
+
+
+def main() -> int:
+    AUDIT_PATH.unlink(missing_ok=True)
+    subprocess.run(
+        [str(REGISTRY), "--help"],
+        cwd=ROOT,
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.DEVNULL,
+        check=True,
+    )
+
+    with tempfile.TemporaryDirectory(prefix="course-reference-"):
+        searches = run_concurrently(
+            [
+                [
+                    str(REGISTRY),
+                    "search",
+                    "--name",
+                    name,
+                    "--campus",
+                    campus,
+                ]
+                for name, campus in TARGETS
+            ]
+        )
+        stable_ids = [
+            sole_id(payload, target)
+            for payload, target in zip(searches, TARGETS, strict=True)
+        ]
+        gets = run_concurrently(
+            [
+                [str(REGISTRY), "get", "--id", stable_id]
+                for stable_id in stable_ids
+            ]
+        )
+        records = [
+            complete_record(payload, stable_id, target)
+            for payload, stable_id, target in zip(
+                gets, stable_ids, TARGETS, strict=True
+            )
+        ]
+
+    (ROOT / "handoff.md").write_text(render(records), encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

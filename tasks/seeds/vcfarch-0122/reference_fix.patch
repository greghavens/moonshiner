 package vcfarch
 
-import "errors"
+import (
+	"encoding/json"
+	"fmt"
+)
 
 // Build returns the VCF architecture for inventory under the pinned snapshot.
 func Build(inventory Inventory, snapshot CompatibilitySnapshot) (Architecture, error) {
-	return Architecture{}, errors.New("vcf architecture is not implemented")
+	if inventory.EstateID == "" || inventory.TargetBundle == "" {
+		return Architecture{}, fmt.Errorf("inventory estateId and targetBundle are required")
+	}
+	if snapshot.TargetBundle != inventory.TargetBundle {
+		return Architecture{}, fmt.Errorf("snapshot target %q does not match inventory target %q", snapshot.TargetBundle, inventory.TargetBundle)
+	}
+
+	components := make(map[string]Component, len(inventory.Components))
+	for _, component := range inventory.Components {
+		if component.ID == "" {
+			return Architecture{}, fmt.Errorf("inventory component id is required")
+		}
+		if _, exists := components[component.ID]; exists {
+			return Architecture{}, fmt.Errorf("duplicate inventory component %q", component.ID)
+		}
+		components[component.ID] = component
+	}
+	if len(snapshot.Rules) != len(components) {
+		return Architecture{}, fmt.Errorf("snapshot has %d rules for %d components", len(snapshot.Rules), len(components))
+	}
+
+	steps := make([]MigrationStep, 0, len(snapshot.Rules))
+	seen := make(map[string]bool, len(snapshot.Rules))
+	for index, rule := range snapshot.Rules {
+		component, exists := components[rule.ComponentID]
+		if !exists {
+			return Architecture{}, fmt.Errorf("snapshot names unknown component %q", rule.ComponentID)
+		}
+		if seen[rule.ComponentID] {
+			return Architecture{}, fmt.Errorf("duplicate snapshot rule for %q", rule.ComponentID)
+		}
+		if rule.SourceVersion != component.Version {
+			return Architecture{}, fmt.Errorf("snapshot source %q does not match %s version %q", rule.SourceVersion, component.ID, component.Version)
+		}
+		seen[rule.ComponentID] = true
+		steps = append(steps, MigrationStep{
+			Order:         index + 1,
+			ComponentID:   component.ID,
+			Kind:          component.Kind,
+			Name:          component.Name,
+			SourceVersion: component.Version,
+			TargetVersion: rule.TargetVersion,
+			Strategy:      rule.Strategy,
+			Gates:         append([]string(nil), rule.Gates...),
+		})
+	}
+
+	greenfield, err := greenfieldSpec(inventory.TargetBundle)
+	if err != nil {
+		return Architecture{}, err
+	}
+	return Architecture{
+		SchemaVersion: "1.0",
+		EstateID:      inventory.EstateID,
+		TargetBundle:  inventory.TargetBundle,
+		Greenfield:    greenfield,
+		MigrationPlan: MigrationPlan{
+			EstateID:     inventory.EstateID,
+			TargetBundle: inventory.TargetBundle,
+			Steps:        steps,
+		},
+	}, nil
+}

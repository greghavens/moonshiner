{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF point-solution estate migration plan",
  "type": "object",
  "required": ["estateId", "targetBundle", "steps"],
  "additionalProperties": false,
  "properties": {
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetBundle": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "order",
          "componentId",
          "kind",
          "name",
          "sourceVersion",
          "targetVersion",
          "strategy",
          "gates"
        ],
        "additionalProperties": false,
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "vcenter",
              "esxi",
              "vsan",
              "nsx",
              "live-site-recovery"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sourceVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "strategy": {
            "enum": [
              "parallel-redeploy",
              "replace-and-recreate-protection",
              "storage-migrate-and-retire",
              "evacuate-reimage-and-commission"
            ]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

  "source": {
    "tag": "9.0.0.0",
    "commitSha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "specPath": "specifications/vcf-operations/vcf-operations-for-logs-openapi.json"
  },
  "openapi": "3.0.1",
  "title": "VCF Operations for Logs",
  "version": "v2",
  "serverBasePath": "/api/v2",
  "securitySchemes": {
    "Bearer": {
      "type": "http",
      "name": "Authorization",
      "in": "header",
      "scheme": "Bearer"
    }
  },
  "operations": {
    "GET_events-+path": {
      "method": "GET",
      "path": "/events/{+path}",
      "security": [
        "Bearer"
      ],
      "parameters": [
        {
          "name": "+path",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "default": 100
          }
        },
        {
          "name": "timeout",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "default": 30000
          }
        },
        {
          "name": "view",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "default": "DEFAULT",
            "enum": [
              "DEFAULT",
              "SIMPLE"
            ]
          }
        },
        {
          "name": "content-pack-fields",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "order-by-direction",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "default": "DESC",
            "enum": [
              "ASC",
              "DESC"
            ]
          }
        }
      ],
      "responses": {
        "200": {
          "schema": {
            "type": "object",
            "required": [
              "complete"
            ],
            "properties": {
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "integer"
                    },
                    "timestampString": {
                      "type": "string"
                    },
                    "fields": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "content": {
                            "type": "string"
                          },
                          "startPosition": {
                            "type": "integer"
                          },
                          "length": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "integer"
                    },
                    "timestampString": {
                      "type": "string"
                    }
                  }
                }
              },
              "complete": {
                "type": "boolean"
              },
              "duration": {
                "type": "number"
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "number"
                    },
                    "details": {
                      "type": "string"
                    },
                    "progress": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        },
        "401": {
          "description": "The request lacks valid authentication credentials."
        },
        "440": {
          "description": "The session ID has expired."
        }
      }
    }
  }
}

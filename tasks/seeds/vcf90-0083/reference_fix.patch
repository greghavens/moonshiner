+++ b/src/Vcf.OperationsForLogs/Vcf.OperationsForLogs.psm1
@@ -0,0 +1,104 @@
+Set-StrictMode -Version Latest
+
+function Get-VcfLogEvent {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateNotNull()]
+        [Uri] $ServerUri,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $SessionId,
+
+        [Parameter(Mandatory)]
+        [long] $StartTimestamp,
+
+        [Parameter(Mandatory)]
+        [long] $EndTimestamp,
+
+        [ValidateRange(1, [int]::MaxValue)]
+        [int] $PageSize = 100,
+
+        [ValidateRange(0, [int]::MaxValue)]
+        [int] $Timeout,
+
+        [ValidateSet('DEFAULT', 'SIMPLE')]
+        [string] $View,
+
+        [ValidateNotNullOrEmpty()]
+        [string[]] $ContentPackFields
+    )
+
+    if ($StartTimestamp -gt $EndTimestamp) {
+        throw 'StartTimestamp must be less than or equal to EndTimestamp.'
+    }
+
+    $includeTimeout = $PSBoundParameters.ContainsKey('Timeout')
+    $includeView = $PSBoundParameters.ContainsKey('View')
+    $includeContentPackFields = $PSBoundParameters.ContainsKey('ContentPackFields')
+    $useSimpleView = $includeView -and $View -eq 'SIMPLE'
+    $baseUri = $ServerUri.AbsoluteUri.TrimEnd('/')
+    $cursor = $EndTimestamp
+    $allEvents = [System.Collections.Generic.List[object]]::new()
+    $invariant = [System.Globalization.CultureInfo]::InvariantCulture
+
+    while ($cursor -ge $StartTimestamp) {
+        $constraintPath = 'timestamp/%3E%3D{0}/timestamp/%3C%3D{1}' -f $StartTimestamp.ToString($invariant), $cursor.ToString($invariant)
+
+        $query = [System.Collections.Generic.List[string]]::new()
+        $query.Add('limit=' + [Uri]::EscapeDataString($PageSize.ToString($invariant)))
+        $query.Add('order-by-direction=DESC')
+        if ($includeTimeout) {
+            $query.Add('timeout=' + [Uri]::EscapeDataString($Timeout.ToString($invariant)))
+        }
+        if ($includeView) {
+            $query.Add('view=' + [Uri]::EscapeDataString($View))
+        }
+        if ($includeContentPackFields) {
+            foreach ($contentPackField in $ContentPackFields) {
+                $query.Add('content-pack-fields=' + [Uri]::EscapeDataString($contentPackField))
+            }
+        }
+
+        $requestUri = '{0}/api/v2/events/{1}?{2}' -f $baseUri, $constraintPath, ($query -join '&')
+        $response = Invoke-RestMethod -Method Get -Uri $requestUri -Headers @{
+            Authorization = 'Bearer ' + $SessionId
+        }
+
+        if ($null -eq $response.complete -or -not [bool] $response.complete) {
+            throw 'VCF Operations for Logs returned an incomplete event response.'
+        }
+
+        $pageValue = if ($useSimpleView) { $response.results } else { $response.events }
+        [object[]] $page = @()
+        if ($null -ne $pageValue) {
+            $page = @($pageValue)
+        }
+        foreach ($event in $page) {
+            $allEvents.Add($event)
+        }
+
+        if ($page.Count -lt $PageSize) {
+            break
+        }
+
+        $minimumTimestamp = ($page | Measure-Object -Property timestamp -Minimum).Minimum
+        if ($null -eq $minimumTimestamp) {
+            throw 'A full event page did not contain timestamps.'
+        }
+        $nextCursor = [long] $minimumTimestamp - 1
+        if ($nextCursor -ge $cursor) {
+            throw 'Event pagination did not advance.'
+        }
+        $cursor = $nextCursor
+    }
+
+    $sortProperties = @(
+        @{ Expression = { [long] $_.timestamp }; Ascending = $true }
+        @{ Expression = { [string] $_.text }; Ascending = $true }
+    )
+    $allEvents | Sort-Object -Property $sortProperties
+}
+
+Export-ModuleMember -Function Get-VcfLogEvent

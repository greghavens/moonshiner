{
  "openapi": "3.0.1",
  "info": {
    "title": "VMware Cloud Foundation Operations for Networks API Reference",
    "description": "VCF Operations for Networks API Reference",
    "version": "9.0.0.0"
  },
  "servers": [
    {
      "url": "/api/ni"
    }
  ],
  "paths": {
    "/settings/certificates/{id}": {
      "put": {
        "tags": [
          "Settings"
        ],
        "summary": "Update a certificate",
        "description": "Updates a certificate",
        "operationId": "updateCertificate",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The Id of the certificate to be updated",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CertificateUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Request to update certificate accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateUpdateStatus"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/settings/certificates/status/{id}": {
      "get": {
        "tags": [
          "Settings"
        ],
        "summary": "Get certificate update status for update id",
        "description": "Get certificate update status for certificate id",
        "operationId": "fetchCertificateUpdateStatusForUpdateId",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The update id for which update status is to be fetched",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "certificate update status corresponding to the update id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateUpdateStatus"
                }
              }
            }
          },
          "404": {
            "description": "update certificate status not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Internal Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            }
          }
        }
      },
      "CertificateUpdateRequest": {
        "type": "object",
        "properties": {
          "certificate": {
            "type": "string",
            "description": "The PEM encoded certificate string"
          },
          "private_key": {
            "type": "string",
            "description": "The PEM encoded private key string"
          },
          "chain": {
            "type": "string",
            "description": "The PEM encoded chain of trusted root CA certificate string",
            "default": ""
          }
        }
      },
      "CertificateUpdateStatus": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Certificate update id"
          },
          "name": {
            "type": "string",
            "description": "Name of certificate such as proxy_register.crt or client.crt"
          },
          "status": {
            "type": "string",
            "description": "certificate update status",
            "example": "SUCCESS",
            "enum": [
              "SUBMITTED",
              "IN_PROGRESS",
              "SUCCESS",
              "FAILED"
            ]
          },
          "error_message": {
            "type": "string",
            "description": "Error message if update request failed",
            "example": "certificate update failed"
          },
          "failed_nodes": {
            "type": "array",
            "description": "List of the nodes for which certificate update failed",
            "items": {
              "$ref": "#/components/schemas/Node"
            }
          },
          "updated_nodes": {
            "type": "array",
            "description": "List of the nodes for which certificate update was success",
            "items": {
              "$ref": "#/components/schemas/Node"
            }
          },
          "last_modified_by_user": {
            "type": "string",
            "description": "The last modified user",
            "example": "user@example.com"
          },
          "last_modified_time": {
            "type": "integer",
            "format": "int64",
            "description": "The last modified time for the certificate"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "target": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "health_status": {
            "type": "string",
            "description": "Is the data source/collector healthy and data is being collected?",
            "example": "HEALTH",
            "nullable": true,
            "enum": [
              "HEALTHY",
              "HEALTHY_WITH_WARNINGS",
              "UNHEALTHY"
            ]
          },
          "health_details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HealthDetail"
            }
          }
        }
      },
      "HealthDetail": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Message for when the data source/collector is not healthy",
            "example": "Invalid credentials"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "Node": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "entity_type": {
            "$ref": "#/components/schemas/NodeType"
          },
          "node_type": {
            "type": "string",
            "nullable": true,
            "enum": [
              "PROXY_VM",
              "PLATFORM_VM"
            ]
          },
          "node_id": {
            "type": "string"
          },
          "ip_address": {
            "type": "string"
          },
          "ipv6_address": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "is_physical_flow_collector": {
            "type": "boolean"
          },
          "sddc_details": {
            "$ref": "#/components/schemas/SddcDetails"
          },
          "version": {
            "type": "string"
          },
          "health": {
            "$ref": "#/components/schemas/Health"
          },
          "registered_timestamp": {
            "type": "integer",
            "format": "int64"
          },
          "last_updated_timestamp": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "NodeType": {
        "type": "string",
        "nullable": true,
        "enum": [
          "Node"
        ]
      },
      "SddcDetails": {
        "type": "object",
        "properties": {
          "sddc_id": {
            "type": "string"
          },
          "org_id": {
            "type": "string"
          },
          "aap_id": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "description": "API Key - NetworkInsight {token}",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}

diff --git a/reference_solution.sh b/reference_solution.sh
new file mode 100755
--- /dev/null
+++ b/reference_solution.sh
@@ -0,0 +1,89 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+run_dir=$(mktemp -d)
+trap 'rm -rf -- "$run_dir"' EXIT
+
+"$PWD/recruitctl" --help >/dev/null
+
+set +e
+bash -c '
+  root=$1
+  "$root/recruitctl" cancel \
+    --stable-id "rec-191" \
+    --reason "no longer needed for the scheduled work"
+  command_status=$?
+  : keep-this-shell-as-the-client-parent
+  exit "$command_status"
+' _ "$PWD" >"$run_dir/cancel.json" 2>"$run_dir/cancel.err"
+cancel_status=$?
+set -e
+
+if [[ $cancel_status -ne 75 ]]; then
+  echo "reference cancellation did not exercise the protected uncertain outcome" >&2
+  exit 1
+fi
+
+bash -c '
+  root=$1
+  output=$2
+  "$root/recruitctl" get --stable-id "rec-191" >"$output"
+  command_status=$?
+  : keep-this-shell-as-the-client-parent
+  exit "$command_status"
+' _ "$PWD" "$run_dir/get.json"
+
+verified_status=$(python3 - "$run_dir/get.json" <<'PY'
+import json
+import sys
+
+with open(sys.argv[1], encoding="utf-8") as handle:
+    record = json.load(handle)
+if record.get("stable_id") != "rec-191":
+    raise SystemExit("exact-ID retrieval returned the wrong candidate")
+status = record.get("status")
+if not isinstance(status, str):
+    raise SystemExit("exact-ID retrieval returned no usable status")
+print(status)
+PY
+)
+
+retry_performed=false
+case "$verified_status" in
+  active)
+    bash -c '
+      root=$1
+      "$root/recruitctl" cancel \
+        --stable-id "rec-191" \
+        --reason "no longer needed for the scheduled work"
+      command_status=$?
+      : keep-this-shell-as-the-client-parent
+      exit "$command_status"
+    ' _ "$PWD" >"$run_dir/retry.json"
+    retry_performed=true
+    ;;
+  cancelled|cancellation-pending)
+    ;;
+  *)
+    echo "exact-ID verification did not authorize a retry: $verified_status" >&2
+    exit 1
+    ;;
+esac
+
+python3 - "$run_dir/get.json" "$retry_performed" cancellation_resolution.json <<'PY'
+import json
+import sys
+
+with open(sys.argv[1], encoding="utf-8") as handle:
+    record = json.load(handle)
+report = {
+    "id": record["stable_id"],
+    "name": record["name"],
+    "verified_status": record["status"],
+    "reason": "no longer needed for the scheduled work",
+    "retry_performed": sys.argv[2] == "true",
+}
+with open(sys.argv[3], "w", encoding="utf-8") as handle:
+    json.dump(report, handle, ensure_ascii=True, indent=2)
+    handle.write("\n")
+PY

{
  "derivedFrom": {
    "tag": "9.0.0.0",
    "commit": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "specPath": "specifications/vcf-operations/vcf-operations-for-logs-openapi.json"
  },
  "title": "VCF Operations for Logs",
  "openapi": "3.0.1",
  "basePath": "/api/v2",
  "securitySchemes": {
    "Bearer": {
      "type": "http",
      "name": "Authorization",
      "in": "header",
      "scheme": "Bearer"
    }
  },
  "operations": [
    {
      "operationId": "POST_sessions",
      "method": "POST",
      "path": "/sessions",
      "requestBody": {
        "required": false,
        "contentType": "application/json",
        "schema": {
          "type": "object",
          "required": ["password", "provider", "username"],
          "properties": {
            "username": {"type": "string"},
            "password": {"type": "string"},
            "provider": {
              "type": "string",
              "enum": ["Local", "ActiveDirectory", "vIDM"]
            }
          }
        }
      },
      "responses": {
        "200": {
          "contentType": "application/json",
          "schema": {
            "type": "object",
            "required": ["userId", "sessionId", "ttl"],
            "properties": {
              "userId": {
                "description": "UUID",
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "sessionId": {"type": "string", "minLength": 1},
              "ttl": {"type": "integer", "minimum": 0}
            }
          }
        },
        "401": {"description": "Could not sign in with the given credentials."},
        "503": {"description": "Server initial configuration is incomplete."}
      }
    },
    {
      "operationId": "PATCH_log-forwarder-id",
      "method": "PATCH",
      "path": "/log-forwarder/{id}",
      "security": [{"Bearer": []}],
      "parameters": [
        {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}
      ],
      "requestBody": {
        "required": false,
        "contentType": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "host": {"type": "string"},
            "port": {"type": "integer", "default": ""},
            "protocol": {"type": "string", "enum": ["SYSLOG", "CFAPI", "RAW", "RAWPlus"]},
            "sslEnabled": {"type": "boolean", "default": false},
            "workerCount": {"type": "integer", "default": ""},
            "diskCacheSize": {"type": "integer"},
            "tags": {"type": "object"},
            "filter": {"type": "string", "default": ""},
            "transportProtocol": {"type": "string", "enum": ["TCP", "UDP", "TCP_OCTET"]},
            "forwardComplementaryFields": {"type": "boolean", "default": false},
            "testConnection": {"type": "boolean", "default": false}
          }
        }
      },
      "responses": {
        "200": {"schemaRef": "forwarders.get.response"},
        "400": {"schemaRef": "error"},
        "401": {"description": "Invalid authentication credentials."},
        "404": {"schemaRef": "error"},
        "440": {"description": "The session ID has expired."},
        "500": {"schemaRef": "error"}
      }
    }
  ],
  "schemas": {
    "error": {
      "type": "object",
      "required": ["errorMessage"],
      "properties": {
        "errorMessage": {"type": "string"},
        "errorCode": {"type": "string"},
        "errorDetails": {"type": "object"}
      }
    },
    "forwarders.get.response": {
      "type": "object",
      "required": [
        "name",
        "host",
        "port",
        "protocol",
        "sslEnabled",
        "workerCount",
        "diskCacheSize",
        "tags",
        "filter",
        "forwardComplementaryFields",
        "id"
      ],
      "properties": {
        "name": {"type": "string"},
        "host": {"type": "string"},
        "port": {"type": "integer"},
        "protocol": {"type": "string", "enum": ["SYSLOG", "CFAPI", "RAW", "RAWPlus", "UNKNOWN"]},
        "sslEnabled": {"type": "boolean"},
        "workerCount": {"type": "integer"},
        "connectionRefreshInterval": {"type": "integer"},
        "diskCacheSize": {"type": "integer"},
        "tags": {"type": "object", "default": {}},
        "filter": {"type": "string", "default": ""},
        "transportProtocol": {"type": "string", "enum": ["TCP", "UDP", "TCP_OCTET", "UNKNOWN"]},
        "forwardComplementaryFields": {"type": "boolean"},
        "id": {"type": "string"},
        "forwarderStats": {
          "type": "object",
          "required": ["state", "rate", "logsForwarded", "logsDropped"],
          "properties": {
            "state": {"type": "string", "enum": ["ACTIVE", "PENDING", "IDLE"]},
            "rate": {"type": "number", "description": "Forwarded rate per seconds."},
            "logsForwarded": {"type": "integer"},
            "logsDropped": {"type": "integer"}
          }
        }
      }
    }
  }
}

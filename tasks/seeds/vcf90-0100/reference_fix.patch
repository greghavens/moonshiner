+                "\\\"" + Pattern.quote(key) + "\\\"\\s*:\\s*\\\"((?:\\\\.|[^\\\"\\\\])*)\\\"");
+        Matcher matcher = pattern.matcher(json);
+        return matcher.find() ? unescapeJsonString(matcher.group(1)) : null;
+    }

+        boolean first = true;
+        for (Map.Entry<String, String> entry : values.entrySet()) {
+            first = appendStringField(
+                    body,
+                    Objects.requireNonNull(entry.getKey(), "tag key"),
+                    Objects.requireNonNull(entry.getValue(), "tag value"),
+                    first);

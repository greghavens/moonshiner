+#!/usr/bin/env python3
+"""Reference proof that exercises the genuine subscription executable."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "subscription-availability"
+DELIVERABLE = ROOT / "availability-report.md"
+TARGETS = (
+    {
+        "subscription": "Family fiber subscription",
+        "account": "Family Account",
+        "date": "2026-08-03",
+    },
+    {
+        "subscription": "Studio tablet data plan",
+        "account": "Studio Account",
+        "date": "2026-08-03",
+    },
+)
+
+
+def command(target: dict[str, str]) -> list[str]:
+    return [
+        str(CLIENT),
+        "availability",
+        "--subscription",
+        target["subscription"],
+        "--account",
+        target["account"],
+        "--date",
+        target["date"],
+    ]
+
+
+def decode(returncode: int, stdout: str, stderr: str) -> dict[str, Any]:
+    payload = stdout if returncode == 0 else stderr
+    try:
+        result: Any = json.loads(payload)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("subscription executable returned invalid JSON") from error
+    if not isinstance(result, dict):
+        raise RuntimeError("subscription executable returned a non-object response")
+    return result
+
+
+def run_one(target: dict[str, str]) -> tuple[int, dict[str, Any]]:
+    completed = subprocess.run(
+        command(target),
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=5,
+    )
+    return completed.returncode, decode(
+        completed.returncode, completed.stdout, completed.stderr
+    )
+
+
+def main() -> int:
+    subprocess.run(
+        [str(CLIENT), "--help"],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=True,
+        timeout=5,
+    )
+    processes = [
+        subprocess.Popen(
+            command(target),
+            cwd=ROOT,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for target in TARGETS
+    ]
+    initial = []
+    for process in processes:
+        stdout, stderr = process.communicate(timeout=5)
+        initial.append((process.returncode, decode(process.returncode, stdout, stderr)))
+
+    if initial[0][0] != 0:
+        raise RuntimeError("the reference successful branch did not succeed")
+    if (
+        initial[1][0] != 75
+        or initial[1][1].get("retryable") is not True
+        or initial[1][1].get("transient") is not True
+    ):
+        raise RuntimeError("the reference retry branch was not transient")
+
+    retry_returncode, retry_result = run_one(TARGETS[1])
+    if retry_returncode != 0:
+        raise RuntimeError("the reference selective retry did not succeed")
+    results = (initial[0][1], retry_result)
+
+    lines = []
+    for result in results:
+        availability_text = "available" if result["available"] else "unavailable"
+        lines.append(f"- {result['subscription']}: {availability_text}")
+    DELIVERABLE.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

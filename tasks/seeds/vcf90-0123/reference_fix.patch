 func (c *Client) CreateSnapshotAndWait(
 	ctx context.Context,
 	clusterID string,
 	protectionGroupID string,
 	spec CreateSnapshotSpec,
 ) (SnapshotResult, error) {
-	return SnapshotResult{}, ErrNotImplemented
+	token, err := c.tokens.Token(ctx)
+	if err != nil {
+		return SnapshotResult{}, fmt.Errorf("get session token: %w", err)
+	}
+
+	body, err := json.Marshal(spec)
+	if err != nil {
+		return SnapshotResult{}, fmt.Errorf("encode snapshot request: %w", err)
+	}
+	createPath := "/snapservice/clusters/" + url.PathEscape(clusterID) +
+		"/protection-groups/" + url.PathEscape(protectionGroupID) +
+		"/snapshots?vmw-task=true"
+	response, err := c.do(ctx, http.MethodPost, createPath, body, &token)
+	if err != nil {
+		return SnapshotResult{}, fmt.Errorf("create snapshot: %w", err)
+	}
+	if response.StatusCode != http.StatusAccepted {
+		return SnapshotResult{}, responseError("create snapshot", response)
+	}
+	var taskID string
+	if err := decodeResponse(response, &taskID); err != nil {
+		return SnapshotResult{}, fmt.Errorf("decode create snapshot response: %w", err)
+	}
+
+	result := SnapshotResult{TaskID: taskID}
+	taskPath := "/snapservice/tasks/" + url.PathEscape(taskID)
+	for {
+		response, err = c.do(ctx, http.MethodGet, taskPath, nil, &token)
+		if err != nil {
+			return result, fmt.Errorf("get snapshot task %q: %w", taskID, err)
+		}
+		if response.StatusCode != http.StatusOK {
+			return result, responseError("get snapshot task", response)
+		}
+
+		var info TaskInfo
+		if err := decodeResponse(response, &info); err != nil {
+			return result, fmt.Errorf("decode snapshot task %q: %w", taskID, err)
+		}

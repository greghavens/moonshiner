+		case "SUCCEEDED":
+			return result, nil
+		case "FAILED":
+			return result, fmt.Errorf("snapshot task %q failed", taskID)
+		default:
+			return result, fmt.Errorf("snapshot task %q returned unknown status %q", taskID, info.Status)
+		}
+	}

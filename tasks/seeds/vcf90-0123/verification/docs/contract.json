{
  "product": "VMware Cloud Foundation 9.0 vSAN Data Protection",
  "openapi": "3.0.3",
  "api_version": "9.0.0.0",
  "server_base_path": "/api",
  "authentication": {
    "security_scheme": "api_key_auth",
    "type": "apiKey",
    "in": "header",
    "name": "vmware-api-session-id"
  },
  "operations": [
    {
      "operationId": "Snapservice.Clusters.ProtectionGroups.Snapshots_create$Task",
      "method": "POST",
      "path": "/snapservice/clusters/{cluster}/protection-groups/{pg}/snapshots?vmw-task=true",
      "path_parameters": [
        {
          "name": "cluster",
          "required": true,
          "type": "string"
        },
        {
          "name": "pg",
          "required": true,
          "type": "string"
        }
      ],
      "request": {
        "content_type": "application/json",
        "schema": "Snapservice.Clusters.ProtectionGroups.Snapshots.CreateSpec",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "retention": {
            "required": false,
            "schema": "Snapservice.RetentionPeriod",
            "required_properties": [
              "unit",
              "duration"
            ],
            "properties": {
              "unit": {
                "type": "string",
                "values": [
                  "MINUTE",
                  "HOUR",
                  "DAY",
                  "WEEK",
                  "MONTH"
                ]
              },
              "duration": {
                "type": "integer",
                "format": "int64"
              }
            },
            "unset_wire_rule": "omit the retention member; do not encode null or an empty object"
          }
        }
      },
      "success": {
        "status": 202,
        "content_type": "application/json",
        "body": {
          "type": "string",
          "meaning": "task identifier"
        }
      },
      "authentication_failure_status": 401
    },
    {
      "operationId": "Snapservice.Tasks_get",
      "method": "GET",
      "path": "/snapservice/tasks/{task}",
      "path_parameters": [
        {
          "name": "task",
          "required": true,
          "type": "string"
        }
      ],
      "success": {
        "status": 200,
        "content_type": "application/json",
        "body_schema": "Snapservice.Tasks.Info",
        "required_properties": [
          "cancelable",
          "description",
          "operation",
          "service",
          "status"
        ],
        "status_values": [
          "PENDING",
          "RUNNING",
          "BLOCKED",
          "SUCCEEDED",
          "FAILED"
        ]
      },
      "authentication_failure_status": 401
    }
  ]
}

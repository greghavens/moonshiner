{
  "contract_version": 1,
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "tag": "9.0.0.0",
    "spec_path": "specifications/vsphere/openapi/automation/vcenter.yaml",
    "license": "Apache-2.0",
    "openapi": "3.0.3",
    "api_version": "9.0.0.0",
    "server_url_template": "https://{host}/api",
    "server_base_path": "/api"
  },
  "security": {
    "scheme": "api_key_auth",
    "type": "apiKey",
    "in": "header",
    "name": "vmware-api-session-id"
  },
  "wire_rules": {
    "accept": "application/json",
    "request_content_type": "application/json",
    "omit_unset_optional_fields": true,
    "unset_encoding_note": "An optional property that is not set is omitted from the JSON object. The spec describes these properties as 'If missing or null ...'; a client must not encode the unset case as null, an empty string, or an empty object.",
    "empty_body_note": "An operation whose requestBody is absent, or whose optional requestBody carries no set property, is sent with no request body and no Content-Type header."
  },
  "operations": [
    {
      "operationId": "Vcenter.Lcm.Deployment.MigrationUpgrade_get",
      "method": "GET",
      "path": "/api/vcenter/lcm/deployment/migration-upgrade",
      "spec_path_template": "/vcenter/lcm/deployment/migration-upgrade",
      "query": {},
      "request": null,
      "success": {
        "status": 200,
        "schema": "Vcenter.Lcm.Deployment.MigrationUpgrade.InitSpec",
        "required": [
          "deployment",
          "version"
        ],
        "properties": {
          "deployment": "Vcenter.Lcm.Deployment.Common.ApplianceDeploymentConfig",
          "version": "string",
          "cancellation_policy": "Vcenter.Lcm.Deployment.MigrationUpgrade.CancellationPolicy",
          "source_shutdown_policy": "string",
          "repository": "Vcenter.Lcm.Deployment.Repository.Spec",
          "post_upgrade_configuration_policy": "Vcenter.Lcm.Deployment.MigrationUpgrade.PostUpgradeConfigurationPolicy",
          "vcha_spec": "Vcenter.Lcm.Deployment.MigrationUpgrade.VchaSpec"
        }
      },
      "errors": {
        "401": "Vapi.Std.Errors.Unauthenticated",
        "403": "Vapi.Std.Errors.Unauthorized",
        "404": "Vapi.Std.Errors.NotFound",
        "500": "Vapi.Std.Errors.Error"
      },
      "notes": "Returns the InitSpec used to configure the ongoing upgrade. Returns 404 Vapi.Std.Errors.NotFound if there is no configured upgrade."
    },
    {
      "operationId": "Vcenter.Lcm.Deployment.MigrationUpgrade_apply",
      "method": "POST",
      "path": "/api/vcenter/lcm/deployment/migration-upgrade",
      "spec_path_template": "/vcenter/lcm/deployment/migration-upgrade?action=apply",
      "query": {
        "action": "apply"
      },
      "request": {
        "required": false,
        "content_type": "application/json",
        "schema": {
          "name": "Vcenter.Lcm.Deployment.MigrationUpgrade.ApplySpec",
          "type": "object",
          "required": [],
          "properties": {
            "pause": {
              "type": "string",
              "required": false,
              "enum": [
                "BEFORE_SWITCHOVER"
              ],
              "enum_schema": "Vcenter.Lcm.Deployment.MigrationUpgrade.PausePolicy",
              "omit_when_unset": true,
              "unset_meaning": "If missing or null the upgrade process will complete without stopping."
            },
            "start_switchover": {
              "type": "string",
              "format": "date-time",
              "required": false,
              "omit_when_unset": true,
              "unset_meaning": "If missing or null the upgrade process will execute the switchover operation as soon as possible."
            }
          },
          "mutually_exclusive": [
            [
              "pause",
              "start_switchover"
            ]
          ],
          "mutual_exclusion_error": "Vapi.Std.Errors.InvalidArgument",
          "mutual_exclusion_note": "pause with value BEFORE_SWITCHOVER cannot be set together with start_switchover; BEFORE_SWITCHOVER is the only value of PausePolicy."
        }
      },
      "success": {
        "status": 204,
        "schema": null,
        "body": "none"
      },
      "errors": {
        "400": "Vapi.Std.Errors.Error",
        "401": "Vapi.Std.Errors.Unauthenticated",
        "403": "Vapi.Std.Errors.Unauthorized",
        "500": "Vapi.Std.Errors.Error"
      },
      "asynchronous": {
        "is_async": true,
        "completion_signal": "none",
        "poll_with": "Vcenter.Lcm.Deployment.MigrationUpgrade.Status_get",
        "note": "204 acknowledges that the upgrade was started, not that it finished. The spec directs clients to monitor progress via GET /vcenter/lcm/deployment/migration-upgrade/status."
      }
    },
    {
      "operationId": "Vcenter.Lcm.Deployment.MigrationUpgrade.Status_get",
      "method": "GET",
      "path": "/api/vcenter/lcm/deployment/migration-upgrade/status",
      "spec_path_template": "/vcenter/lcm/deployment/migration-upgrade/status",
      "query": {},
      "request": null,
      "success": {
        "status": 200,
        "schema": "Vcenter.Lcm.Deployment.MigrationUpgrade.Status.Info",
        "required": [
          "cancelable",
          "description",
          "last_update_time",
          "status",
          "subtask_order",
          "subtasks",
          "upgrade_info"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum_schema": "Vcenter.Lcm.Deployment.Common.Status",
            "enum": [
              "PENDING",
              "RUNNING",
              "BLOCKED",
              "SUCCEEDED",
              "FAILED",
              "CANCELED"
            ]
          },
          "current_state": {
            "type": "string",
            "required": false,
            "enum_schema": "Vcenter.Lcm.Deployment.MigrationUpgrade.Status.State",
            "enum": [
              "INITIALIZING",
              "INITIALIZED",
              "STAGING",
              "STAGED",
              "PREPARING",
              "PREPARED",
              "SWITCHOVER",
              "UPGRADED",
              "CANCELING",
              "CANCELED"
            ],
            "unset_meaning": "If missing or null there is no upgrade running in the environment."
          },
          "desired_state": {
            "type": "string",
            "required": false,
            "enum_schema": "Vcenter.Lcm.Deployment.MigrationUpgrade.Status.State"
          },
          "upgrade_info": "Vcenter.Lcm.Deployment.MigrationUpgrade.Status.UpgradeInfo",
          "notifications": "Vcenter.Lcm.Notifications",
          "progress": "Cis.Task.Progress",
          "cancelable": "boolean",
          "description": "Vapi.Std.LocalizableMessage",
          "last_update_time": "date-time",
          "start_time": "date-time",
          "end_time": "date-time",
          "error": "object"
        },
        "nested": {
          "Vcenter.Lcm.Deployment.MigrationUpgrade.Status.UpgradeInfo": {
            "required": [
              "remaining_replication_data"
            ],
            "properties": {
              "identifier": "string",
              "upgrade_to": "string",
              "pause": "string",
              "start_switchover": "date-time",
              "remaining_replication_data": "int64",
              "error": "object"
            }
          },
          "Vcenter.Lcm.Notifications": {
            "properties": {
              "info": "array of Vcenter.Lcm.Notification",
              "warnings": "array of Vcenter.Lcm.Notification",
              "errors": "array of Vcenter.Lcm.Notification"
            }
          },
          "Vcenter.Lcm.Notification": {
            "required": [
              "id",
              "message"
            ],
            "properties": {
              "id": "string",
              "time": "date-time",
              "message": "Vapi.Std.LocalizableMessage",
              "resolution": "Vapi.Std.LocalizableMessage"
            }
          }
        }
      },
      "errors": {
        "401": "Vapi.Std.Errors.Unauthenticated",
        "403": "Vapi.Std.Errors.Unauthorized",
        "500": "Vapi.Std.Errors.Error"
      },
      "polling": {
        "status_field": "status",
        "terminal_statuses": [
          "SUCCEEDED",
          "FAILED",
          "CANCELED"
        ],
        "non_terminal_statuses": [
          "PENDING",
          "RUNNING",
          "BLOCKED"
        ],
        "end_time_relevant_for": [
          "SUCCEEDED",
          "FAILED",
          "CANCELED"
        ],
        "note": "A sample without current_state does not describe a running upgrade and therefore does not report the outcome of an apply that was just issued."
      }
    },
    {
      "operationId": "Vcenter.Lcm.Deployment.MigrationUpgrade_cancel",
      "method": "POST",
      "path": "/api/vcenter/lcm/deployment/migration-upgrade",
      "spec_path_template": "/vcenter/lcm/deployment/migration-upgrade?action=cancel",
      "query": {
        "action": "cancel"
      },
      "request": null,
      "success": {
        "status": 204,
        "schema": null,
        "body": "none"
      },
      "errors": {
        "400": "Vapi.Std.Errors.Error",
        "401": "Vapi.Std.Errors.Unauthenticated",
        "403": "Vapi.Std.Errors.Unauthorized",
        "500": "Vapi.Std.Errors.Error"
      },
      "asynchronous": {
        "is_async": true,
        "completion_signal": "none",
        "poll_with": "Vcenter.Lcm.Deployment.MigrationUpgrade.Status_get",
        "note": "Cancellation progress is monitored with the same status operation; the run is cancelled once status reaches CANCELED."
      }
    }
  ],
  "error_envelope": {
    "schema": "Vapi.Std.Errors.Error",
    "required": [
      "error_type",
      "messages"
    ],
    "properties": {
      "error_type": "string",
      "messages": "array of Vapi.Std.LocalizableMessage",
      "data": "object"
    }
  }
}

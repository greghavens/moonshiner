+"""Build the ordered migration architecture from the frozen planning inputs."""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+def _gates() -> list[dict[str, Any]]:
+    return [
+        {
+            "id": "GATE-BACKUP-HEALTH",
+            "category": "BACKUP",
+            "condition": "Current SDDC Manager, vCenter, and NSX backups are restorable and all domains are green.",
+            "evidence": ["Successful file-based backup records", "Green SDDC Manager domain health"],
+        },
+        {
+            "id": "GATE-VCF52-COMPAT-PRECHECK",
+            "category": "COMPATIBILITY",
+            "condition": "VCF 5.2.1 upgrade planner and compatibility prechecks pass for every management-domain component.",
+            "evidence": ["VCF 5.2.1 upgrade plan", "Passing management-domain precheck report"],
+        },
+        {
+            "id": "GATE-VCF52-HEALTHY",
+            "category": "HEALTH",
+            "condition": "The complete 5.2.1 management-domain bill of materials is inventoried and healthy before 9.1 work begins.",
+            "evidence": ["VCF 5.2.1 inventory export", "Green 5.2.1 health and drift checks"],
+        },
+        {
+            "id": "GATE-ARIA-818",
+            "category": "LIFECYCLE",
+            "condition": "Aria Operations is at 8.18 and Aria Suite Lifecycle is at 8.18 patch 2 before the VCF Operations transition.",
+            "evidence": ["Aria Operations 8.18 about page", "Aria Suite Lifecycle 8.18 patch 2 inventory"],
+        },
+        {
+            "id": "GATE-VCF91-COMPAT-PRECHECK",
+            "category": "COMPATIBILITY",
+            "condition": "VCF 9.1 upgrade planner, hardware compatibility, firmware, certificate, password, and vSAN database checks pass.",
+            "evidence": ["Passing VCF 9.1 prerequisite report", "Target hardware compatibility report"],
+        },
+        {
+            "id": "GATE-RDU-TEMP-IP",
+            "category": "NETWORK",
+            "condition": "A tested temporary management address is reserved for the required reduced-downtime vCenter major upgrade.",
+            "evidence": ["Reserved temporary IP record", "Forward, reverse, gateway, and reachability checks"],
+        },
+        {
+            "id": "GATE-VLCM-IMAGE",
+            "category": "LIFECYCLE",
+            "condition": "The management cluster has moved from baselines to a compliant vSphere Lifecycle Manager image.",
+            "evidence": ["Image-managed cluster state", "Successful image compliance check"],
+        },
+        {
+            "id": "GATE-NSX-MANAGER-91",
+            "category": "HEALTH",
+            "condition": "The NSX 9.1 management plane is stable before ESX-integrated datapath and Edge finalization.",
+            "evidence": ["Healthy NSX Manager cluster", "Passing NSX upgrade precheck"],
+        },
+        {
+            "id": "GATE-EDGE-CAPACITY",
+            "category": "CAPACITY",
+            "condition": "Both Edge nodes are homogeneous XLARGE appliances with independent 25 Gbps ToR paths and one-node surviving capacity of 20 Gbps.",
+            "evidence": ["Edge form-factor inventory", "Dual-ToR uplink validation", "One-node failure capacity calculation"],
+        },
+        {
+            "id": "GATE-MANAGEMENT-SERVICES",
+            "category": "SERVICE",
+            "condition": "VCF Operations 9.1, its cloud proxy, and VCF management services are healthy before legacy lifecycle removal.",
+            "evidence": ["Healthy VCF Operations adapter collection", "Healthy VCF management-services cluster"],
+        },
+        {
+            "id": "GATE-FINAL-HEALTH",
+            "category": "HEALTH",
+            "condition": "All core components, management services, Edge paths, and post-upgrade inventory checks are healthy at 9.1.",
+            "evidence": ["Final VCF 9.1 inventory", "Passing final health, drift, routing, and throughput checks"],
+        },
+    ]
+
+
+def _target_sddc_spec(inventory: dict[str, Any]) -> dict[str, Any]:
+    components = {component["id"]: component for component in inventory["components"]}
+    hosts = [component["id"] for component in inventory["components"] if component["kind"] == "ESX_HOST"]
+    networks = [
+        {
+            "networkType": network["networkType"],
+            "vlanId": network["vlanId"],
+            "subnet": network["subnet"],
+            "gateway": network["gateway"],
+            "mtu": network["mtu"],
+        }
+        for network in inventory["networks"]
+    ]
+    host_vds = inventory["managementCluster"]["hostVds"]
+    return {
+        "sddcId": inventory["site"]["sddcId"],
+        "workflowType": "VCF",
+        "version": inventory["targetVcfVersion"],
+        "hostSpecs": [{"hostname": hostname} for hostname in hosts],
+        "vcenterSpec": {
+            "vcenterHostname": f"vc-m01.{inventory['site']['dnsSubdomain']}",
+            "rootVcenterPassword": "REPLACE_ME_1!Aa",
+            "version": components["vcenter-management-01"]["targetVersion"],
+            "useExistingDeployment": True,
+        },
+        "clusterSpec": {
+            "datacenterName": inventory["managementCluster"]["datacenterName"],
+            "clusterName": inventory["managementCluster"]["name"],
+        },
+        "dvsSpecs": [
+            {
+                "dvsName": host_vds["name"],
+                "networks": [network["networkType"] for network in inventory["networks"]],
+                "mtu": 9000,
+                "vmnicsToUplinks": [
+                    {"id": vmnic, "uplink": uplink}
+                    for vmnic, uplink in host_vds["vmnicToUplink"].items()
+                ],
+            }
+        ],
+        "nsxtSpec": {
+            "nsxtManagers": [
+                {"hostname": f"nsx-m01-{index}.{inventory['site']['dnsSubdomain']}"}
+                for index in range(1, 4)
+            ],
+            "vipFqdn": f"nsx-m01.{inventory['site']['dnsSubdomain']}",
+            "version": inventory["targetVcfVersion"],
+            "useExistingDeployment": True,
+            "enableEdgeClusterSync": True,
+            "transportVlanId": 2710,
+        },
+        "networkSpecs": networks,
+        "dnsSpec": {
+            "subdomain": inventory["site"]["dnsSubdomain"],
+            "nameservers": inventory["site"]["dnsServers"],
+        },
+        "ntpServers": inventory["site"]["ntpServers"],
+        "managementPoolName": "chi-m01-network-pool",
+        "ceipEnabled": False,
+        "skipEsxThumbprintValidation": False,
+        "skipGatewayPingValidation": False,
+    }
+
+
+def build_plan(inventory: dict[str, Any], compatibility: dict[str, Any]) -> dict[str, Any]:
+    """Return the deterministic migration-plan document."""
+    components = {component["id"]: component for component in inventory["components"]}
+    paths = compatibility["componentPaths"]
+    steps: list[dict[str, Any]] = []
+
+    def add_step(
+        component_id: str,
+        from_version: str,
+        to_version: str,
+        milestone: str,
+        gates: list[str],
+        action: str = "UPGRADE",
+        changes: dict[str, Any] | None = None,
+    ) -> None:
+        order = len(steps) + 1
+        step: dict[str, Any] = {
+            "id": f"STEP-{order:03d}",
+            "order": order,
+            "milestone": milestone,
+            "componentId": component_id,
+            "componentName": components[component_id]["name"],
+            "fromVersion": from_version,
+            "toVersion": to_version,
+            "action": action,
+            "gates": gates,
+        }
+        if changes is not None:
+            step["changes"] = changes
+        steps.append(step)
+
+    gate_52 = ["GATE-BACKUP-HEALTH", "GATE-VCF52-COMPAT-PRECHECK"]
+    add_step("sddc-manager-01", paths["sddc-manager-01"][0], paths["sddc-manager-01"][1], "5.2.1.0", gate_52)
+    add_step("aria-suite-lifecycle-01", paths["aria-suite-lifecycle-01"][0], paths["aria-suite-lifecycle-01"][1], "5.2.1.0", gate_52)
+    add_step("aria-operations-01", paths["aria-operations-01"][0], paths["aria-operations-01"][1], "5.2.1.0", gate_52)
+    add_step("nsx-manager-cluster-01", paths["nsx-manager-cluster-01"][0], paths["nsx-manager-cluster-01"][1], "5.2.1.0", gate_52)
+    for edge_id in ("nsx-edge-01", "nsx-edge-02"):
+        add_step(edge_id, paths[edge_id][0], paths[edge_id][1], "5.2.1.0", gate_52)
+    add_step("vcenter-management-01", paths["vcenter-management-01"][0], paths["vcenter-management-01"][1], "5.2.1.0", gate_52)
+    for host_id in ("esx-m01-01", "esx-m01-02", "esx-m01-03", "esx-m01-04"):
+        add_step(host_id, paths[host_id][0], paths[host_id][1], "5.2.1.0", gate_52)
+
+    add_step(
+        "aria-operations-01",
+        paths["aria-operations-01"][1],
+        paths["aria-operations-01"][2],
+        "9.1.0.0",
+        ["GATE-ARIA-818", "GATE-VCF91-COMPAT-PRECHECK"],
+    )
+    for edge in inventory["edgeNodes"]:
+        add_step(
+            edge["componentId"],
+            paths[edge["componentId"]][1],
+            paths[edge["componentId"]][1],
+            "9.1.0.0",
+            ["GATE-VCF52-HEALTHY", "GATE-EDGE-CAPACITY"],
+            action="RESIZE",
+            changes={
+                "formFactor": {
+                    "from": edge["currentFormFactor"],
+                    "to": compatibility["edgeSizing"]["requiredFormFactor"],
+                }
+            },
+        )
+    gate_91 = ["GATE-VCF52-HEALTHY", "GATE-VCF91-COMPAT-PRECHECK"]
+    add_step("sddc-manager-01", paths["sddc-manager-01"][1], paths["sddc-manager-01"][2], "9.1.0.0", gate_91)
+    add_step("nsx-manager-cluster-01", paths["nsx-manager-cluster-01"][1], paths["nsx-manager-cluster-01"][2], "9.1.0.0", gate_91)
+    add_step(
+        "vcenter-management-01",
+        paths["vcenter-management-01"][1],
+        paths["vcenter-management-01"][2],
+        "9.1.0.0",
+        gate_91 + ["GATE-RDU-TEMP-IP"],
+    )
+    for host_id in ("esx-m01-01", "esx-m01-02", "esx-m01-03", "esx-m01-04"):
+        add_step(host_id, paths[host_id][1], paths[host_id][2], "9.1.0.0", gate_91 + ["GATE-VLCM-IMAGE"])
+    for edge_id in ("nsx-edge-01", "nsx-edge-02"):
+        add_step(
+            edge_id,
+            paths[edge_id][1],
+            paths[edge_id][2],
+            "9.1.0.0",
+            gate_91 + ["GATE-NSX-MANAGER-91", "GATE-EDGE-CAPACITY"],
+        )
+    add_step(
+        "aria-suite-lifecycle-01",
+        paths["aria-suite-lifecycle-01"][1],
+        paths["aria-suite-lifecycle-01"][2],
+        "9.1.0.0",
+        gate_91 + ["GATE-MANAGEMENT-SERVICES"],
+        action="DECOMMISSION",
+    )
+
+    final_steps = {
+        component_id: [step for step in steps if step["componentId"] == component_id and step["fromVersion"] != step["toVersion"]][-1]
+        for component_id in components
+    }
+    sizing = compatibility["edgeSizing"]
+    capacity = sizing["perActiveNodeCapacityGbps"][sizing["requiredFormFactor"]]
+    uplinks = [
+        {"edgeNode": node["componentId"], **link}
+        for node in inventory["edgeNodes"]
+        for link in node["availableUplinks"]
+    ]
+
+    return {
+        "schemaVersion": "1.0",
+        "generator": {"package": "vcf_architecture", "runtime": "python-stdlib-only"},
+        "estateId": inventory["estateId"],
+        "currentVcfVersion": inventory["currentVcfVersion"],
+        "targetVcfVersion": inventory["targetVcfVersion"],
+        "targetSddcSpec": _target_sddc_spec(inventory),
+        "vcfTransitions": [
+            {
+                "order": 1,
+                "fromVersion": compatibility["vcfPath"][0],
+                "toVersion": compatibility["vcfPath"][1],
+                "gates": gate_52,
+                "completesAfterStepId": "STEP-011",
+            },
+            {
+                "order": 2,
+                "fromVersion": compatibility["vcfPath"][1],
+                "toVersion": compatibility["vcfPath"][2],
+                "gates": gate_91 + ["GATE-FINAL-HEALTH"],
+                "completesAfterStepId": f"STEP-{len(steps):03d}",
+            },
+        ],
+        "componentTargets": [
+            {
+                "componentId": component["id"],
+                "componentName": component["name"],
+                "currentVersion": component["currentVersion"],
+                "targetVersion": component["targetVersion"],
+                "finalGates": final_steps[component["id"]]["gates"],
+            }
+            for component in inventory["components"]
+        ],
+        "architecture": {
+            **compatibility["targetArchitecture"],
+            "edgeCluster": {
+                "formFactor": sizing["requiredFormFactor"],
+                "nodeCount": sizing["nodeCount"],
+                "haMode": sizing["haMode"],
+                "perActiveNodeCapacityGbps": capacity,
+                "normalCapacityGbps": capacity * sizing["nodeCount"],
+                "capacityAfterSingleNodeFailureGbps": capacity * (sizing["nodeCount"] - 1),
+                "tier0Mode": sizing["tier0Mode"],
+                "northboundRouting": sizing["northboundRouting"],
+                "uplinks": uplinks,
+            },
+        },
+        "gates": _gates(),
+        "steps": steps,
+    }

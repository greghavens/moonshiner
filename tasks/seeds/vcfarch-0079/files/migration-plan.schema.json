{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example/vcf/migration-plan-1.0.json",
  "title": "VCF Brownfield Migration Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generator",
    "estateId",
    "currentVcfVersion",
    "targetVcfVersion",
    "targetSddcSpec",
    "vcfTransitions",
    "componentTargets",
    "architecture",
    "gates",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "runtime"
      ],
      "properties": {
        "package": {
          "const": "vcf_architecture"
        },
        "runtime": {
          "const": "python-stdlib-only"
        }
      }
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "currentVcfVersion": {
      "type": "string",
      "minLength": 1
    },
    "targetVcfVersion": {
      "type": "string",
      "minLength": 1
    },
    "targetSddcSpec": {
      "type": "object"
    },
    "vcfTransitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/vcfTransition"
      }
    },
    "componentTargets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/componentTarget"
      }
    },
    "architecture": {
      "$ref": "#/$defs/architecture"
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "gateIdArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^GATE-[A-Z0-9-]+$"
      }
    },
    "vcfTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "fromVersion",
        "toVersion",
        "gates",
        "completesAfterStepId"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "fromVersion": {
          "type": "string",
          "minLength": 1
        },
        "toVersion": {
          "type": "string",
          "minLength": 1
        },
        "gates": {
          "$ref": "#/$defs/gateIdArray"
        },
        "completesAfterStepId": {
          "type": "string",
          "pattern": "^STEP-[0-9]{3}$"
        }
      }
    },
    "componentTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "componentName",
        "currentVersion",
        "targetVersion",
        "finalGates"
      ],
      "properties": {
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "componentName": {
          "type": "string",
          "minLength": 1
        },
        "currentVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1
        },
        "finalGates": {
          "$ref": "#/$defs/gateIdArray"
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clusterLifecycleMode",
        "vcenterUpgradeMode",
        "vcfOperationsMode",
        "managementServicesMode",
        "nsxUpgradeFinalization",
        "edgeCluster"
      ],
      "properties": {
        "clusterLifecycleMode": {
          "enum": [
            "BASELINE",
            "IMAGE"
          ]
        },
        "vcenterUpgradeMode": {
          "enum": [
            "IN_PLACE",
            "REDUCED_DOWNTIME"
          ]
        },
        "vcfOperationsMode": {
          "type": "string",
          "minLength": 1
        },
        "managementServicesMode": {
          "type": "string",
          "minLength": 1
        },
        "nsxUpgradeFinalization": {
          "type": "string",
          "minLength": 1
        },
        "edgeCluster": {
          "$ref": "#/$defs/edgeCluster"
        }
      }
    },
    "edgeCluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formFactor",
        "nodeCount",
        "haMode",
        "perActiveNodeCapacityGbps",
        "normalCapacityGbps",
        "capacityAfterSingleNodeFailureGbps",
        "tier0Mode",
        "northboundRouting",
        "uplinks"
      ],
      "properties": {
        "formFactor": {
          "enum": [
            "MEDIUM",
            "LARGE",
            "XLARGE"
          ]
        },
        "nodeCount": {
          "type": "integer",
          "minimum": 2
        },
        "haMode": {
          "enum": [
            "ACTIVE_ACTIVE",
            "ACTIVE_STANDBY"
          ]
        },
        "perActiveNodeCapacityGbps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "normalCapacityGbps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "capacityAfterSingleNodeFailureGbps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tier0Mode": {
          "type": "string",
          "minLength": 1
        },
        "northboundRouting": {
          "type": "string",
          "minLength": 1
        },
        "uplinks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/uplink"
          }
        }
      }
    },
    "uplink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeNode",
        "edgeInterface",
        "hostPnic",
        "tor",
        "speedGbps",
        "vlanId"
      ],
      "properties": {
        "edgeNode": {
          "type": "string",
          "minLength": 1
        },
        "edgeInterface": {
          "type": "string",
          "minLength": 1
        },
        "hostPnic": {
          "type": "string",
          "minLength": 1
        },
        "tor": {
          "type": "string",
          "minLength": 1
        },
        "speedGbps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "vlanId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4094
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "condition",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^GATE-[A-Z0-9-]+$"
        },
        "category": {
          "enum": [
            "BACKUP",
            "COMPATIBILITY",
            "HEALTH",
            "LIFECYCLE",
            "NETWORK",
            "CAPACITY",
            "SERVICE"
          ]
        },
        "condition": {
          "type": "string",
          "minLength": 12
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "milestone",
        "componentId",
        "componentName",
        "fromVersion",
        "toVersion",
        "action",
        "gates"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^STEP-[0-9]{3}$"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "milestone": {
          "enum": [
            "5.2.1.0",
            "9.1.0.0"
          ]
        },
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "componentName": {
          "type": "string",
          "minLength": 1
        },
        "fromVersion": {
          "type": "string",
          "minLength": 1
        },
        "toVersion": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "UPGRADE",
            "RESIZE",
            "DECOMMISSION"
          ]
        },
        "gates": {
          "$ref": "#/$defs/gateIdArray"
        },
        "changes": {
          "type": "object"
        }
      }
    }
  }
}

+// ---- transport ------------------------------------------------------------
+
+// call performs one contract operation. A nil body means a bodyless request,
+// which carries no Content-Type. A nil out discards the response body.
+func (c *Client) call(ctx context.Context, operationID, method, path string, body any, wantStatus int, out any) error {
+	var reader io.Reader
+	var encoded []byte
+	if body != nil {
+		var err error
+		encoded, err = json.Marshal(body)
+		if err != nil {
+			return fmt.Errorf("sddcmanager: %s: encode request: %w", operationID, err)
+		}
+		reader = bytes.NewReader(encoded)
+	}
+
+	req, err := http.NewRequestWithContext(ctx, method, c.baseURL+path, reader)
+	if err != nil {
+		return fmt.Errorf("sddcmanager: %s: build request: %w", operationID, err)
+	}
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("Authorization", "Bearer "+c.accessToken)
+	if body != nil {
+		req.Header.Set("Content-Type", "application/json")
+		req.ContentLength = int64(len(encoded))
+	}
+
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return fmt.Errorf("sddcmanager: %s: %w", operationID, err)
+	}
+	defer func() {
+		_, _ = io.Copy(io.Discard, resp.Body)
+		_ = resp.Body.Close()
+	}()
+
+	raw, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return fmt.Errorf("sddcmanager: %s: read response: %w", operationID, err)
+	}
+
+	if resp.StatusCode != wantStatus {
+		apiErr := &APIError{OperationID: operationID, StatusCode: resp.StatusCode}
+		var body errorResponse
+		if json.Unmarshal(raw, &body) == nil {
+			apiErr.ErrorCode = body.ErrorCode
+			apiErr.Message = body.Message
+		}
+		if apiErr.Message == "" {
+			apiErr.Message = fmt.Sprintf("unexpected status %d, want %d", resp.StatusCode, wantStatus)
+		}
+		secrets, _ := ctx.Value(secretContextKey{}).([]string)
+		apiErr.ErrorCode = redact(apiErr.ErrorCode, secrets...)
+		apiErr.Message = redact(apiErr.Message, secrets...)
+		return apiErr
+	}
+
+	if out == nil {
+		return nil
+	}
+	if ct := resp.Header.Get("Content-Type"); !strings.HasPrefix(ct, "application/json") {
+		return fmt.Errorf("sddcmanager: %s: response media type is %q, want application/json", operationID, ct)
+	}
+	if err := json.Unmarshal(raw, out); err != nil {
+		return fmt.Errorf("sddcmanager: %s: decode response: %w", operationID, err)
+	}
+	return nil
+}
+
+func redact(value string, secrets ...string) string {
+	for _, secret := range secrets {
+		if secret != "" {
+			value = strings.ReplaceAll(value, secret, "[REDACTED]")
+		}
+	}
+	return value
 }
 

+// fail marks step i failed and leaves every later step SKIPPED.
+func (r *Report) fail(i int, err error) {
+	detail := err.Error()
+	var apiErr *APIError
+	if errors.As(err, &apiErr) {
+		detail = fmt.Sprintf("HTTP %d: %s: %s", apiErr.StatusCode, apiErr.ErrorCode, apiErr.Message)
+	}
+	r.Steps[i] = StepReport{
+		OperationID: r.Steps[i].OperationID,
+		Status:      StepFailed,
+		Detail:      detail,
+	}
+}
+
+func validatePlan(plan Plan) error {
+	switch {
+	case strings.TrimSpace(plan.NetworkPoolName) == "":
+		return errors.New("sddcmanager: plan has no network pool name")
+	case len(plan.Networks) == 0:
+		return errors.New("sddcmanager: plan has no networks")
+	case strings.TrimSpace(plan.IPRangeNetworkType) == "":
+		return errors.New("sddcmanager: plan does not say which network takes the IP range")
+	case strings.TrimSpace(plan.IPRange.Start) == "", strings.TrimSpace(plan.IPRange.End) == "":
+		return errors.New("sddcmanager: plan has an incomplete IP range")
+	case len(plan.Hosts) == 0:
+		return errors.New("sddcmanager: plan has no hosts to commission")
+	}
+	return nil
+}
+
+func validateTask(t taskResponse) error {
+	switch {
+	case strings.TrimSpace(t.ID) == "":
+		return errors.New("sddcmanager: task response has no id")
+	case strings.TrimSpace(t.Name) == "":
+		return errors.New("sddcmanager: task response has no name")
+	case strings.TrimSpace(t.Status) == "":
+		return errors.New("sddcmanager: task response has no status")
+	case strings.TrimSpace(t.CreationTimestamp) == "":
+		return errors.New("sddcmanager: task response has no creationTimestamp")
+	}
+	return nil
+}
+
+func (c *Client) waitForTask(ctx context.Context, taskID string, pollInterval time.Duration, observed func(taskResponse)) (taskResponse, error) {
+	path := "/v1/tasks/" + url.PathEscape(taskID)
+	for {
+		var task taskResponse
+		if err := c.call(ctx, "getTask", http.MethodGet, path, nil, http.StatusOK, &task); err != nil {
+			return taskResponse{}, err
+		}
+		if err := validateTask(task); err != nil {
+			return taskResponse{}, err
+		}
+		if task.ID != taskID {
+			return taskResponse{}, fmt.Errorf("sddcmanager: getTask returned task %q, want %q", task.ID, taskID)
+		}
+		observed(task)
+
+		status := normalizeStatus(task.Status)
+		if !nonTerminalStatuses[status] {
+			if status != "SUCCESSFUL" && !failedStatuses[status] {
+				return taskResponse{}, fmt.Errorf("sddcmanager: task %s has unknown status %q", taskID, task.Status)
+			}
+			return task, nil
+		}
+
+		timer := time.NewTimer(pollInterval)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return taskResponse{}, ctx.Err()
+		case <-timer.C:
+		}
+	}
+}
+
+// hostOutcomes reads the per-host result out of the task's subtasks, keyed by
+// the ESXi resource each subtask carries.
+func hostOutcomes(task taskResponse, secrets []string) []HostOutcome {
+	var out []HostOutcome
+	for _, sub := range task.SubTasks {
+		fqdn := ""
+		for _, res := range sub.Resources {
+			if strings.EqualFold(strings.TrimSpace(res.Type), "ESXI") && strings.TrimSpace(res.FQDN) != "" {
+				fqdn = res.FQDN
+				break
+			}
+		}
+		if fqdn == "" {
+			continue
+		}
+		outcome := HostOutcome{FQDN: fqdn, Status: normalizeStatus(sub.Status)}
+		if outcome.Status != "SUCCESSFUL" {
+			outcome.ErrorCode, outcome.Message = firstError(sub.Errors)
+			outcome.ErrorCode = redact(outcome.ErrorCode, secrets...)
+			outcome.Message = redact(outcome.Message, secrets...)
+		}
+		out = append(out, outcome)
+	}
+	return out
+}
+
+func firstError(errs []errorResponse) (code, message string) {
+	if len(errs) == 0 {
+		return "", ""
+	}
+	return errs[0].ErrorCode, errs[0].Message
+}

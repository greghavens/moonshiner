{
  "schemaVersion": 1,
  "title": "SDDC Manager 9.0 capacity-onboarding contract",
  "source": {
    "repository": "vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "repositoryCommitSha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "specPath": "specifications/sddc-manager/sddc-manager-openapi.json",
    "openapiVersion": "3.0.1",
    "specInfoVersion": "9.0.0.0"
  },
  "transport": {
    "acceptHeader": "application/json",
    "requestContentType": "application/json",
    "authorizationHeader": "Authorization: Bearer <access_token>",
    "authorizationIsSpecDerived": false
  },
  "operations": [
    {
      "operationId": "createNetworkPool",
      "method": "POST",
      "path": "/v1/network-pools",
      "successStatus": 201,
      "errorStatuses": [400, 500],
      "requestBody": {
        "schema": "NetworkPool",
        "required": true,
        "shape": "object"
      },
      "responseBody": {
        "schema": "NetworkPool"
      }
    },
    {
      "operationId": "addIpPoolToNetworkOfNetworkPool",
      "method": "POST",
      "path": "/v1/network-pools/{id}/networks/{networkId}/ip-pools",
      "successStatus": 200,
      "errorStatuses": [400, 404, 500],
      "pathParameters": [
        { "name": "id", "description": "Id of the network pool" },
        { "name": "networkId", "description": "Id of the network" }
      ],
      "requestBody": {
        "schema": "IpPool",
        "required": true,
        "shape": "object"
      },
      "responseBody": {
        "schema": "Network"
      }
    },
    {
      "operationId": "commissionHosts",
      "method": "POST",
      "path": "/v1/hosts",
      "successStatus": 202,
      "errorStatuses": [400, 500],
      "requestBody": {
        "schema": "HostCommissionSpec",
        "required": true,
        "shape": "array",
        "note": "The 9.0.0.0 request body is a bare JSON array of HostCommissionSpec, not an object wrapping one."
      },
      "responseBody": {
        "schema": "Task"
      }
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "successStatus": 200,
      "errorStatuses": [404, 500],
      "pathParameters": [
        { "name": "id", "description": "Task id to retrieve" }
      ],
      "requestBody": null,
      "responseBody": {
        "schema": "Task"
      }
    }
  ],
  "schemas": {
    "NetworkPool": {
      "required": ["name", "networks"],
      "writable": ["name", "networks"],
      "readOnly": ["id", "hostsCount"],
      "members": {
        "id": { "type": "string", "readOnly": true },
        "name": { "type": "string" },
        "networks": { "type": "array", "items": "Network" },
        "hostsCount": { "type": "integer", "format": "int32", "readOnly": true }
      }
    },
    "Network": {
      "required": ["gateway", "mask", "mtu", "subnet", "type", "vlanId"],
      "writable": ["type", "vlanId", "mtu", "subnet", "mask", "gateway", "ipPools"],
      "optional": ["ipPools"],
      "readOnly": ["id", "freeIps", "usedIps"],
      "members": {
        "id": { "type": "string", "readOnly": true },
        "type": { "type": "string" },
        "vlanId": { "type": "integer", "format": "int32" },
        "mtu": { "type": "integer", "format": "int32" },
        "subnet": { "type": "string" },
        "mask": { "type": "string" },
        "gateway": { "type": "string" },
        "ipPools": { "type": "array", "items": "IpPool" },
        "freeIps": { "type": "array", "items": "string", "readOnly": true },
        "usedIps": { "type": "array", "items": "string", "readOnly": true }
      },
      "notMembersInThisRevision": [
        "freeIpCount",
        "usedIpCount",
        "ipAddressAssignmentMode",
        "ipAddressVersion"
      ],
      "notMembersNote": "Those four members exist only in the 9.1.0.0 revision of this file. Sending any of them proves the wrong revision was used."
    },
    "IpPool": {
      "required": ["start", "end"],
      "writable": ["start", "end"],
      "members": {
        "start": { "type": "string", "pattern": "^([01]?\\d\\d?|2[0-4]\\d|25[0-5])\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])$" },
        "end": { "type": "string", "pattern": "^([01]?\\d\\d?|2[0-4]\\d|25[0-5])\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])$" }
      }
    },
    "HostCommissionSpec": {
      "required": ["fqdn", "networkPoolId", "password", "storageType", "username"],
      "optional": [
        "vvolStorageProtocolType",
        "networkPoolName",
        "sshThumbprint",
        "sslThumbprint"
      ],
      "members": {
        "fqdn": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "storageType": { "type": "string", "example": "One among: VSAN, VSAN_ESA, VSAN_REMOTE, VSAN_MAX, NFS, VMFS_FC, VVOL, VMFS" },
        "vvolStorageProtocolType": { "type": "string" },
        "networkPoolId": { "type": "string" },
        "networkPoolName": { "type": "string" },
        "sshThumbprint": { "type": "string" },
        "sslThumbprint": { "type": "string" }
      }
    },
    "Task": {
      "required": ["creationTimestamp", "id", "name", "status"],
      "readOnly": [
        "id", "name", "type", "status", "creationTimestamp", "completionTimestamp",
        "subTasks", "errors", "resources", "resolutionStatus", "isCancellable", "isRetryable"
      ],
      "members": {
        "id": { "type": "string", "readOnly": true },
        "name": { "type": "string", "readOnly": true },
        "type": { "type": "string", "readOnly": true },
        "status": { "type": "string", "readOnly": true },
        "creationTimestamp": { "type": "string", "readOnly": true },
        "completionTimestamp": { "type": "string", "readOnly": true },
        "subTasks": { "type": "array", "items": "SubTask", "readOnly": true },
        "errors": { "type": "array", "items": "Error", "readOnly": true },
        "resources": { "type": "array", "items": "Resource", "readOnly": true }
      }
    },
    "SubTask": {
      "members": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "creationTimestamp": { "type": "string" },
        "completionTimestamp": { "type": "string" },
        "errors": { "type": "array", "items": "Error" },
        "resources": { "type": "array", "items": "Resource" }
      }
    },
    "Resource": {
      "required": ["resourceId", "type"],
      "members": {
        "resourceId": { "type": "string" },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "fqdn": { "type": "string" }
      }
    },
    "Error": {
      "members": {
        "errorCode": { "type": "string", "readOnly": true },
        "errorType": { "type": "string", "readOnly": true },
        "message": { "type": "string", "readOnly": true },
        "remediationMessage": { "type": "string" },
        "causes": { "type": "array", "items": "ErrorCause" },
        "nestedErrors": { "type": "array", "items": "Error" },
        "referenceToken": { "type": "string", "readOnly": true }
      }
    }
  },
  "taskStatus": {
    "nonTerminal": ["PENDING", "IN_PROGRESS", "QUEUED"],
    "successful": ["SUCCESSFUL"],
    "unsuccessfulTerminal": ["FAILED", "CANCELLED", "COMPLETED_WITH_WARNING", "SKIPPED", "TIMED_OUT"],
    "normalization": "Trim, uppercase, then replace each run of whitespace with a single underscore before comparing."
  },
  "wireRules": [
    "Send only writable members. A readOnly member of NetworkPool, Network or Task is never present in a request body.",
    "An unset optional member is absent from the encoded JSON object. It is never encoded as null, an empty string, zero or any other placeholder.",
    "Omission is decided per array element: one HostCommissionSpec in a commissionHosts body may carry sslThumbprint while another in the same body omits it.",
    "commissionHosts sends a bare JSON array as the top-level request body.",
    "Every request carries exactly one Accept: application/json header and exactly one Authorization: Bearer header.",
    "Every request that has a body carries exactly one Content-Type: application/json header. A getTask request has no body and no Content-Type.",
    "Each path parameter is percent-escaped as a single path segment. No request carries a query string or a bare '?'.",
    "networkPoolId in a commissionHosts body is the id returned by createNetworkPool, not a value copied from the caller's plan."
  ]
}

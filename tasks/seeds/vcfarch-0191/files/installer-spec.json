{
  "specification": "vcf-point-solution-migration-plan",
  "schemaVersion": "1.0",
  "entrypoint": {
    "file": "MigrationPlanClient.java",
    "class": "MigrationPlanClient",
    "method": "buildPlan",
    "parameters": ["java.nio.file.Path", "java.nio.file.Path"],
    "returns": "java.lang.String"
  },
  "planSchema": {
    "type": "object",
    "required": ["schemaVersion", "snapshotId", "research", "architecture", "steps"],
    "additionalProperties": false,
    "properties": {
      "schemaVersion": {"type": "string", "minLength": 1},
      "snapshotId": {"type": "string", "minLength": 1},
      "research": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["publisher", "title", "url", "consultedFor"],
          "additionalProperties": false,
          "properties": {
            "publisher": {"type": "string", "minLength": 1},
            "title": {"type": "string", "minLength": 1},
            "url": {"type": "string", "minLength": 1},
            "consultedFor": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }
      },
      "architecture": {
        "type": "object",
        "required": ["targetRelease", "placements", "edge"],
        "additionalProperties": false,
        "properties": {
          "targetRelease": {"type": "string", "minLength": 1},
          "placements": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": ["component", "site", "cluster", "nodeCount", "profile", "vcpuPerNode", "memoryGiBPerNode", "capacityBasis"],
              "additionalProperties": false,
              "properties": {
                "component": {"type": "string", "minLength": 1},
                "site": {"type": "string", "minLength": 1},
                "cluster": {"type": "string", "minLength": 1},
                "nodeCount": {"type": "integer", "minimum": 1},
                "profile": {"type": "string", "minLength": 1},
                "vcpuPerNode": {"type": "integer", "minimum": 1},
                "memoryGiBPerNode": {"type": "integer", "minimum": 1},
                "capacityBasis": {"type": "string", "minLength": 1}
              }
            }
          },
          "edge": {
            "type": "object",
            "required": ["requiredNorthSouthGbps", "formFactor", "edgeCount", "haMode", "uplinksPerEdge", "uplinkSpeedGbps", "uplinkSwitches", "hostTepVlan", "edgeTepVlan", "uplinkVlans", "tepPolicy"],
            "additionalProperties": false,
            "properties": {
              "requiredNorthSouthGbps": {"type": "number", "minimum": 0},
              "formFactor": {"type": "string", "minLength": 1},
              "edgeCount": {"type": "integer", "minimum": 2},
              "haMode": {"type": "string", "minLength": 1},
              "uplinksPerEdge": {"type": "integer", "minimum": 2},
              "uplinkSpeedGbps": {"type": "integer", "minimum": 1},
              "uplinkSwitches": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
              "hostTepVlan": {"type": "integer", "minimum": 1},
              "edgeTepVlan": {"type": "integer", "minimum": 1},
              "uplinkVlans": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 1}},
              "tepPolicy": {"type": "string", "minLength": 1}
            }
          }
        }
      },
      "steps": {
        "type": "array",
        "minItems": 3,
        "items": {
          "type": "object",
          "required": ["order", "source", "target", "strategy", "transitions", "carries", "abandons", "gates"],
          "additionalProperties": false,
          "properties": {
            "order": {"type": "integer", "minimum": 1},
            "source": {
              "type": "object",
              "required": ["id", "product", "version", "eogs"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "product": {"type": "string", "minLength": 1},
                "version": {"type": "string", "minLength": 1},
                "eogs": {"type": "string", "minLength": 1}
              }
            },
            "target": {
              "type": "object",
              "required": ["component", "version"],
              "additionalProperties": false,
              "properties": {
                "component": {"type": "string", "minLength": 1},
                "version": {"type": "string", "minLength": 1}
              }
            },
            "strategy": {"type": "string", "minLength": 1},
            "transitions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "carries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "abandons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "gates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    }
  }
}

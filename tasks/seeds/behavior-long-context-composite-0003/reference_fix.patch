+#!/usr/bin/env python3
+"""Reference proof using the genuine executable and returned stable ID."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+WORKER = r'''
+import json
+import subprocess
+import sys
+
+command = json.loads(sys.argv[1])
+completed = subprocess.run(
+    command,
+    capture_output=True,
+    text=True,
+    timeout=15,
+)
+print(json.dumps({
+    "returncode": completed.returncode,
+    "stdout": completed.stdout,
+    "stderr": completed.stderr,
+}))
+'''
+
+
+def run(command: list[str]) -> dict[str, Any]:
+    completed = subprocess.run(
+        [sys.executable, "-B", "-c", WORKER, json.dumps(command)],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=20,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(
+            completed.stderr.strip() or "reservation action failed"
+        )
+    envelope = json.loads(completed.stdout)
+    if envelope.get("returncode") != 0:
+        raise RuntimeError(
+            str(envelope.get("stderr") or "").strip()
+            or "reservation operation failed"
+        )
+    result = json.loads(envelope["stdout"])
+    if not isinstance(result, dict):
+        raise RuntimeError("reservation operation returned a non-object")
+    return result
+
+
+def value(record: dict[str, Any], key: str) -> Any:
+    returned = record.get(key)
+    return returned if returned is not None else "unknown"
+
+
+def main() -> int:
+    search = run(
+        [
+            "./reservationctl",
+            "search",
+            "--name",
+            "Maple Hall Planning Retreat",
+            "--location",
+            "Austin",
+        ]
+    )
+    matches = search.get("matches")
+    if not isinstance(matches, list) or len(matches) != 1:
+        raise RuntimeError("reference search did not resolve uniquely")
+    match = matches[0]
+    if not isinstance(match, dict) or match.get("status") != "active":
+        raise RuntimeError("reference search did not return one active match")
+    stable_id = match.get("id")
+    if not isinstance(stable_id, str) or not stable_id:
+        raise RuntimeError("reference search returned no stable ID")
+
+    detail = run(["./reservationctl", "get", "--id", stable_id])
+    record = detail.get("record")
+    if not isinstance(record, dict):
+        raise RuntimeError("reference get returned no full record")
+
+    audit = {
+        "id": value(record, "id"),
+        "name": value(record, "name"),
+        "location": value(record, "location"),
+        "status": value(record, "status"),
+        "date": value(record, "date"),
+        "plannerContact": value(record, "plannerContact"),
+    }
+    (ROOT / "reservation-audit.json").write_text(
+        json.dumps(audit, ensure_ascii=False, indent=2) + "\n",
+        encoding="utf-8",
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

  "operations": [
    {
      "operationId": "acquireToken",
      "method": "POST",
      "path": "/api/auth/token/acquire",
      "target": "/suite-api/api/auth/token/acquire",
      "spec_path": "specifications/vcf-operations/vcf-operations-openapi.json",
      "repository_commit_sha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
      "repository_tag": "9.0.0.0",
      "json_pointer": "/paths/~1api~1auth~1token~1acquire/post",
      "security_scheme": "Token-based-authorization",
      "used_for": "exchanging the appliance credentials for the token every later call carries",
      "spec_notes": [
        "The request body is username-password, whose required members are username and password; authSource is optional.",
        "The 200 response is auth-token, whose required members are token and validity.",
        "The 401 response is documented as 'Authentication failed' and carries no body schema."
      ]
    },
    {
      "operationId": "getCustomGroups",
      "method": "GET",
      "path": "/api/resources/groups",
      "target": "/suite-api/api/resources/groups",
      "spec_path": "specifications/vcf-operations/vcf-operations-openapi.json",
      "repository_commit_sha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
      "repository_tag": "9.0.0.0",
      "json_pointer": "/paths/~1api~1resources~1groups/get",
      "security_scheme": "Token-based-authorization",
      "used_for": "the lookup that decides whether the custom group already exists, which is what makes the create safe to repeat",
      "spec_notes": [
        "Both query parameters are optional: groupId is an array of uuid and includePolicy is a boolean documented with default false.",
        "The 200 response is cgroups, a wrapper whose only member is the groups array of custom-group."
      ]
    },
    {
      "operationId": "createCustomGroup",
      "method": "POST",
      "path": "/api/resources/groups",
      "target": "/suite-api/api/resources/groups",
      "spec_path": "specifications/vcf-operations/vcf-operations-openapi.json",
      "repository_commit_sha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
      "repository_tag": "9.0.0.0",
      "json_pointer": "/paths/~1api~1resources~1groups/post",
      "security_scheme": "Token-based-authorization",
      "used_for": "creating the custom group when the lookup found none",
      "spec_notes": [
        "The request body is custom-group, whose required members are resourceKey and membershipDefinition.",
        "custom-group.id is documented as the identifier of an existing custom group and is assigned by the appliance, so a create carries none.",
        "The only documented response is 201, 'The newly created custom group', carrying a custom-group.",
        "The specification documents no idempotency key, no conditional-request header and no 409 for a duplicate name, so repeating this call creates a second group."
      ]
    },
    {
      "operationId": "modifyCustomGroup",
      "method": "PUT",
      "path": "/api/resources/groups",
      "target": "/suite-api/api/resources/groups",
      "spec_path": "specifications/vcf-operations/vcf-operations-openapi.json",
      "repository_commit_sha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
      "repository_tag": "9.0.0.0",
      "json_pointer": "/paths/~1api~1resources~1groups/put",
      "security_scheme": "Token-based-authorization",
      "used_for": "reconciling an existing custom group whose definition has drifted from the desired one",
      "spec_notes": [
        "The request body is the same custom-group schema as the create, addressed by its id rather than by a path parameter.",
        "The only documented response is 200, 'The updated custom group'."
      ]
    }
  ],

diff --git a/.reference_solution.py b/.reference_solution.py
new file mode 100644
--- /dev/null
+++ b/.reference_solution.py
@@ -0,0 +1,92 @@
+#!/usr/bin/env python3
+"""Reference interaction sequence for the consultation registry."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parent
+REPORT = ROOT / "cancellation-result.json"
+TARGET_ID = "hea-115"
+TARGET_NAME = "Vaccination consultation"
+EXACT_REASON = "the patient rescheduled with another clinic"
+
+
+def invoke(*arguments: str) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        [str(ROOT / "healthctl"), *arguments],
+        cwd=ROOT,
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+
+
+def json_result(process: subprocess.CompletedProcess[str]) -> dict[str, object]:
+    if process.stderr:
+        raise RuntimeError(f"healthctl wrote to stderr: {process.stderr}")
+    value = json.loads(process.stdout)
+    if not isinstance(value, dict):
+        raise RuntimeError("healthctl did not return a JSON object")
+    return value
+
+
+def main() -> int:
+    initial_help = invoke("--help")
+    if "cancel --id" in initial_help.stdout or initial_help.stderr:
+        raise RuntimeError("cancellation unexpectedly appeared in initial help")
+
+    before = json_result(invoke("capabilities"))
+    before_capabilities = before.get("capabilities")
+    if not isinstance(before_capabilities, list) or "cancel" in before_capabilities:
+        raise RuntimeError("cancellation was unexpectedly available initially")
+
+    extension_help = invoke("extension", "--help")
+    if "extension activate <name>" not in extension_help.stdout:
+        raise RuntimeError("extension activation was not documented")
+    if "cancellation" not in extension_help.stdout:
+        raise RuntimeError("the cancellation extension was not documented")
+
+    activation = json_result(
+        invoke("extension", "activate", "cancellation")
+    )
+    if (
+        activation.get("extension") != "cancellation"
+        or activation.get("active") is not True
+        or activation.get("changed") is not True
+    ):
+        raise RuntimeError("cancellation extension was not newly activated")
+
+    after = json_result(invoke("capabilities"))
+    after_capabilities = after.get("capabilities")
+    if not isinstance(after_capabilities, list) or "cancel" not in after_capabilities:
+        raise RuntimeError("cancellation was not exposed after activation")
+
+    cancellation_process = invoke(
+        "cancel",
+        "--id",
+        TARGET_ID,
+        "--reason",
+        EXACT_REASON,
+        "--output",
+        "cancellation-result.json",
+    )
+    cancellation = json_result(cancellation_process)
+    expected = {
+        "id": TARGET_ID,
+        "name": TARGET_NAME,
+        "reason": EXACT_REASON,
+        "status": "cancelled",
+    }
+    if cancellation != expected:
+        raise RuntimeError("consultation registry returned the wrong cancellation")
+    if REPORT.read_text(encoding="utf-8") != cancellation_process.stdout:
+        raise RuntimeError("result file differs from the executable response")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

+function Test-VcfProvisionPoolMatchesDefinition {
+    <#
+        An existing pool satisfies the request when it carries exactly the
+        requested network types and every one of them agrees on the six fields
+        the 9.0.0.0 Network schema requires. Allocated ipPools are server state
+        and are deliberately not compared.
+    #>
+    param(
+        [Parameter(Mandatory)][object]$Pool,
+        [Parameter(Mandatory)][hashtable[]]$Definition
+    )
+
+    $existing = @($Pool.Networks)
+    if ($existing.Count -ne $Definition.Count) {
+        return $false
+    }
+
+    $wanted = [System.Collections.Generic.Dictionary[string, object]]::new([System.StringComparer]::Ordinal)
+    foreach ($item in $Definition) {
+        $type = [string]$item.Type
+        if ($wanted.ContainsKey($type)) {
+            return $false
+        }
+        $wanted.Add($type, $item)
+    }
+
+    $seen = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::Ordinal)
+    foreach ($network in $existing) {
+        $type = [string]$network.Type
+        if (-not $wanted.ContainsKey($type) -or -not $seen.Add($type)) {
+            return $false
+        }
+        $want = $wanted[$type]
+        if ([int]$network.VlanId -ne [int]$want.VlanId) { return $false }
+        if ([int]$network.Mtu -ne [int]$want.Mtu) { return $false }
+        if ([string]$network.Subnet -cne [string]$want.Subnet) { return $false }
+        if ([string]$network.Mask -cne [string]$want.Mask) { return $false }
+        if ([string]$network.Gateway -cne [string]$want.Gateway) { return $false }
+    }
+
+    return $true
+}

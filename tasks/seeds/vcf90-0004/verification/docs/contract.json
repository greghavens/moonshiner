{
  "contract_version": 1,
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_tag": "9.0.0.0",
    "repository_commit_sha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "spec_version": "9.0.0.0"
  },
  "operations": [
    {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "summary": "Create Token Pair",
      "request": {
        "required": true,
        "contentType": "application/json",
        "schema": "TokenCreationSpec"
      },
      "responses": {
        "201": "TokenPair",
        "400": "Error",
        "500": "Error"
      }
    },
    {
      "operationId": "getNetworkPool",
      "method": "GET",
      "path": "/v1/network-pools",
      "summary": "Get the list of all Network Pools",
      "responses": {
        "200": "PageOfNetworkPool",
        "404": "Error",
        "500": "Error"
      }
    },
    {
      "operationId": "createNetworkPool",
      "method": "POST",
      "path": "/v1/network-pools",
      "summary": "Create a Network Pool",
      "request": {
        "required": true,
        "contentType": "application/json",
        "schema": "NetworkPool"
      },
      "responses": {
        "201": "NetworkPool",
        "400": "Error",
        "500": "Error"
      }
    }
  ],
  "schemas": {
    "Error": {
      "type": "object",
      "properties": {
        "errorCode": {
          "type": "string",
          "readOnly": true,
          "description": "The minor error code"
        },
        "errorType": {
          "type": "string",
          "readOnly": true,
          "description": "The error type"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "readOnly": true,
          "description": "The arguments used to localize the message, Can be used by scripts to automate the error processing."
        },
        "context": {
          "type": "object",
          "readOnly": true,
          "description": "The error context (e.g. the component where it occurred)."
        },
        "message": {
          "type": "string",
          "readOnly": true,
          "description": "The localized error message"
        },
        "remediationMessage": {
          "type": "string",
          "description": "The localized remediation error message"
        },
        "causes": {
          "type": "array",
          "items": {
            "$ref": "ErrorCause"
          },
          "description": "The underlying cause exceptions."
        },
        "nestedErrors": {
          "type": "array",
          "items": {
            "$ref": "Error"
          },
          "description": "The nested errors when the error is a composite one"
        },
        "referenceToken": {
          "type": "string",
          "readOnly": true,
          "description": "A reference token correlating the error with the relevant detailed error logs. Should be sent to the service provider when reporting issues."
        },
        "label": {
          "type": "string",
          "readOnly": true,
          "description": "The localized label message"
        },
        "remediationUrl": {
          "type": "string",
          "readOnly": true,
          "description": "The URL string for remediation documentation link"
        }
      }
    },
    "ErrorCause": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "readOnly": true,
          "description": "The type of the error cause"
        },
        "message": {
          "type": "string",
          "readOnly": true,
          "description": "The message describing the reason for the error"
        }
      }
    },
    "IpPool": {
      "type": "object",
      "required": [
        "end",
        "start"
      ],
      "properties": {
        "start": {
          "type": "string",
          "description": "Start IP address of the IP pool"
        },
        "end": {
          "type": "string",
          "description": "End IP address of the IP pool"
        }
      }
    },
    "Network": {
      "type": "object",
      "required": [
        "gateway",
        "mask",
        "mtu",
        "subnet",
        "type",
        "vlanId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true,
          "description": "The ID of the network"
        },
        "type": {
          "type": "string",
          "description": "Network Type of the network"
        },
        "vlanId": {
          "type": "integer",
          "format": "int32",
          "description": "VLAN ID associated with the network"
        },
        "mtu": {
          "type": "integer",
          "format": "int32",
          "description": "MTU of the network"
        },
        "subnet": {
          "type": "string",
          "description": "Subnet associated with the network"
        },
        "mask": {
          "type": "string",
          "description": "Subnet mask for the subnet of the network"
        },
        "gateway": {
          "type": "string",
          "description": "Gateway for the network"
        },
        "ipPools": {
          "type": "array",
          "items": {
            "$ref": "IpPool"
          },
          "description": "List of IP pool ranges to use"
        },
        "freeIps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "readOnly": true,
          "description": "List of free IPs to use"
        },
        "usedIps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "readOnly": true,
          "description": "List of used IPs"
        }
      }
    },
    "NetworkPool": {
      "type": "object",
      "required": [
        "name",
        "networks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true,
          "description": "The ID of the network pool"
        },
        "name": {
          "type": "string",
          "description": "User specified name of the network pool"
        },
        "networks": {
          "type": "array",
          "items": {
            "$ref": "Network"
          },
          "description": "Representing the networks associated with the network pool"
        },
        "hostsCount": {
          "type": "integer",
          "format": "int32",
          "readOnly": true,
          "description": "Number of hosts connected to the network pool"
        }
      }
    },
    "PageMetadata": {
      "type": "object",
      "properties": {
        "pageNumber": {
          "type": "integer",
          "format": "int32",
          "readOnly": true,
          "description": "Returns the current page number"
        },
        "pageSize": {
          "type": "integer",
          "format": "int32",
          "readOnly": true,
          "description": "Returns the number of elements in the current page"
        },
        "totalElements": {
          "type": "integer",
          "format": "int32",
          "readOnly": true,
          "description": "Returns the total number of elements"
        },
        "totalPages": {
          "type": "integer",
          "format": "int32",
          "readOnly": true,
          "description": "Returns the total number of pages"
        }
      }
    },
    "PageOfNetworkPool": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "items": {
            "$ref": "NetworkPool"
          },
          "readOnly": true,
          "description": "The list of elements included in this page"
        },
        "pageMetadata": {
          "$ref": "PageMetadata"
        }
      }
    },
    "RefreshToken": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Refresh token id that can be used to request new access token"
        }
      }
    },
    "TokenCreationSpec": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "Username"
        },
        "password": {
          "type": "string",
          "description": "User Password"
        },
        "apiKey": {
          "type": "string",
          "description": "API Key"
        },
        "idToken": {
          "type": "string",
          "description": "Id Token"
        }
      }
    },
    "TokenPair": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string",
          "description": "Bearer token that can be used to make public API calls"
        },
        "refreshToken": {
          "$ref": "RefreshToken"
        }
      }
    }
  }
}

+def _capacity(
+    scenario: dict[str, Any], selected: dict[str, Any]
+) -> dict[str, int]:
+    profile = scenario["hostProfile"]
+    policy = scenario["capacityPolicy"]
+    count = selected["requiredHosts"]
+    physical_cores = profile["socketsPerHost"] * profile["coresPerSocket"]
+    return {
+        "hostCount": count,
+        "licensedVcfCores": selected["requiredVcfCores"],
+        "licensedVsanRawTiB": selected["requiredVsanRawTiB"],
+        "nPlusOneWorkloadVcpu": (
+            (count - 1) * physical_cores * policy["cpuVcpuPerCore"]
+            - policy["managementReserveVcpu"]
+        ),
+        "nPlusOneWorkloadMemoryGiB": (
+            (count - 1) * profile["memoryGiBPerHost"]
+            - policy["managementReserveMemoryGiB"]
+        ),
+        "usableVsanTiBAtFtt1AndSlack": (
+            count
+            * profile["rawVsanTiBPerHost"]
+            * policy["vsanFtt1EfficiencyNumerator"]
+            * (100 - policy["vsanFreeSlackPercent"])
+            // (policy["vsanFtt1EfficiencyDenominator"] * 100)
+        ),
+    }
+
+
+def _migration_plan(
+    inventory: dict[str, Any], compatibility: dict[str, Any]
+) -> dict[str, Any]:
+    state = {
+        item["id"]: {"component": item["component"], "version": item["version"]}
+        for item in inventory["components"]
+    }
+    rules = compatibility["upgrade"]["transitionRules"]
+    final_targets = compatibility["upgrade"]["finalTargets"]
+    steps: list[dict[str, Any]] = []
+    while state != final_targets:
+        for rule in rules:
+            current = state.get(rule["componentId"])
+            if current != {
+                "component": rule["fromComponent"],
+                "version": rule["fromVersion"],
+            }:
+                continue
+            if not all(
+                state.get(item["componentId"], {}).get("version") == item["version"]
+                for item in rule["after"]
+            ):
+                continue
+            steps.append(
+                {
+                    "order": len(steps) + 1,
+                    "componentId": rule["componentId"],
+                    "component": rule["fromComponent"],
+                    "fromVersion": rule["fromVersion"],
+                    "targetComponent": rule["targetComponent"],
+                    "targetVersion": rule["targetVersion"],
+                    "gates": list(rule["requiredGates"]),
+                }
+            )
+            state[rule["componentId"]] = {
+                "component": rule["targetComponent"],
+                "version": rule["targetVersion"],
+            }
+            break
+        else:
+            raise ValueError("pinned upgrade graph cannot reach all final targets")
+    return {
+        "schemaVersion": "1.0",
+        "estateId": inventory["estateId"],
+        "targetRelease": compatibility["upgrade"]["targetRelease"],
+        "steps": steps,
+    }
+
+
+def build_architecture(
+    scenario: dict[str, Any],
+    inventory: dict[str, Any],
+    compatibility: dict[str, Any],
+) -> dict[str, Any]:
+    """Build a complete deterministic VCF architecture mapping."""
+    if scenario["targetRelease"] != compatibility["targetRelease"]:
+        raise ValueError("scenario and compatibility target releases differ")
+    requirements = _topology_requirements(scenario, compatibility)
+    eligible = [name for name, values in requirements.items() if not values["reasonCodes"]]
+    if len(eligible) != 1:
+        raise ValueError("entitlements must leave exactly one supported topology")
+    selected_name = eligible[0]
+    selected = requirements[selected_name]
+    excluded = [
+        {"topology": name, **values}
+        for name, values in requirements.items()
+        if values["reasonCodes"]
+    ]
+    rack_distribution = {
+        rack: sum(host["rack"] == rack for host in scenario["hosts"])
+        for rack in scenario["site"]["racks"]
+    }
+    greenfield = {
+        "selectedTopology": selected_name,
+        "topologyDecision": {"selected": selected_name, "excluded": excluded},
+        "sddcSpec": _sddc_spec(scenario, compatibility),
+        "hostPlacement": [
+            {
+                "hostname": host["hostname"],
+                "site": scenario["site"]["id"],
+                "rack": host["rack"],
+            }
+            for host in scenario["hosts"]
+        ],
+        "capacity": _capacity(scenario, selected),
+        "availability": {
+            "hostFailuresToTolerate": scenario["availability"][
+                "minimumHostFailuresToTolerate"
+            ],
+            "siteFailureTolerance": scenario["site"]["siteFailureToleranceRequired"],
+            "rackDistribution": rack_distribution,
+        },
+    }
+    return {
+        "artifactVersion": "1.0",
+        "greenfield": greenfield,
+        "migrationPlan": _migration_plan(inventory, compatibility),
+    }

+++ b/vcf_architect/__main__.py
@@ -0,0 +1,40 @@
+"""Command-line entry point for deterministic architecture generation."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from .builder import build_architecture
+
+
+def load_mapping(path: Path) -> dict:
+    value = json.loads(path.read_text(encoding="utf-8"))
+    if not isinstance(value, dict):
+        raise ValueError(f"{path} must contain a JSON object")
+    return value
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(prog="python3 -m vcf_architect")
+    parser.add_argument("--scenario", required=True, type=Path)
+    parser.add_argument("--inventory", required=True, type=Path)
+    parser.add_argument("--compatibility", required=True, type=Path)
+    parser.add_argument("--output", required=True, type=Path)
+    args = parser.parse_args()
+
+    artifact = build_architecture(
+        load_mapping(args.scenario),
+        load_mapping(args.inventory),
+        load_mapping(args.compatibility),
+    )
+    args.output.write_text(
+        json.dumps(artifact, indent=2, sort_keys=True) + "\n",
+        encoding="utf-8",
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/vcf_architect/builder.py b/vcf_architect/builder.py
new file mode 100644
index 0000000..d5ec195
--- /dev/null
+++ b/vcf_architect/builder.py
@@ -0,0 +1,348 @@
+"""Construct the greenfield SddcSpec and ordered brownfield migration plan."""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+def _minimum_workload_hosts(scenario: dict[str, Any]) -> int:
+    profile = scenario["hostProfile"]
+    policy = scenario["capacityPolicy"]
+    demand = scenario["workloadDemand"]
+    for count in range(2, len(scenario["hosts"]) + 1):
+        physical_cores = profile["socketsPerHost"] * profile["coresPerSocket"]
+        vcpu = (
+            (count - 1) * physical_cores * policy["cpuVcpuPerCore"]
+            - policy["managementReserveVcpu"]
+        )
+        memory = (
+            (count - 1) * profile["memoryGiBPerHost"]
+            - policy["managementReserveMemoryGiB"]
+        )
+        usable_storage = (
+            count
+            * profile["rawVsanTiBPerHost"]
+            * policy["vsanFtt1EfficiencyNumerator"]
+            * (100 - policy["vsanFreeSlackPercent"])
+            // (policy["vsanFtt1EfficiencyDenominator"] * 100)
+        )
+        if (
+            vcpu >= demand["vcpu"]
+            and memory >= demand["memoryGiB"]
+            and usable_storage >= demand["usableStorageTiB"]
+        ):
+            return count
+    raise ValueError("available hosts do not meet the workload demand under N+1")
+
+
+def _topology_requirements(
+    scenario: dict[str, Any], compatibility: dict[str, Any]
+) -> dict[str, dict[str, Any]]:
+    profile = scenario["hostProfile"]
+    license_rules = compatibility["greenfield"]["licenseAccounting"]
+    cores_per_host = profile["socketsPerHost"] * max(
+        profile["coresPerSocket"],
+        license_rules["minimumLicensedCoresPerSocket"],
+    )
+    workload_hosts = _minimum_workload_hosts(scenario)
+    result: dict[str, dict[str, Any]] = {}
+    for topology in compatibility["greenfield"]["supportedTopologies"]:
+        if not topology["greenfieldSupported"]:
+            continue
+        if topology["workloadsOnManagementDomain"]:
+            host_count = max(workload_hosts, topology["minimumManagementHosts"])
+        else:
+            host_count = workload_hosts + topology["dedicatedManagementHosts"]
+        required_cores = host_count * cores_per_host
+        required_raw_tib = host_count * profile["rawVsanTiBPerHost"]
+        reasons: list[str] = []
+        if required_cores > scenario["entitlements"]["vcfCores"]:
+            reasons.append("VCF_CORE_ENTITLEMENT")
+        if required_raw_tib > scenario["entitlements"]["vsanRawTiB"]:
+            reasons.append("VSAN_RAW_TIB_ENTITLEMENT")
+        result[topology["id"]] = {
+            "requiredHosts": host_count,
+            "requiredVcfCores": required_cores,
+            "requiredVsanRawTiB": required_raw_tib,
+            "reasonCodes": reasons,
+        }
+    return result
+
+
+def _network_spec(network: dict[str, Any], design: dict[str, Any]) -> dict[str, Any]:
+    return {
+        "networkType": network["networkType"],
+        "subnet": network["subnet"],
+        "gateway": network["gateway"],
+        "subnetMask": network["subnetMask"],
+        "includeIpAddressRanges": [
+            {
+                "startIpAddress": network["startIpAddress"],
+                "endIpAddress": network["endIpAddress"],
+            }
+        ],
+        "vlanId": network["vlanId"],
+        "mtu": network["mtu"],
+        "teamingPolicy": design["networkTeamingPolicy"],
+        "ipAddressVersion": design["ipAddressVersion"],
+        "ipAddressAssignmentMode": design["ipAddressAssignmentMode"],

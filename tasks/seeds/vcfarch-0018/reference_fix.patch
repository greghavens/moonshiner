+    design = scenario["deploymentDesign"]
+    fleet_network = next(
+        item for item in networking["networks"]
+        if item["networkType"] == "FLEET_MANAGEMENT"
+    )
+    return {
+        "sddcId": names["sddcId"],
+        "workflowType": compatibility["greenfield"]["workflowType"],
+        "hostSpecs": [{"hostname": host["hostname"]} for host in scenario["hosts"]],
+        "version": bom["VCF_INSTALLER"],

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF 9.1 greenfield architecture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selectedTopology",
    "topologyDecision",
    "sddcSpec",
    "hostPlacement",
    "capacity",
    "availability"
  ],
  "properties": {
    "selectedTopology": {
      "type": "string",
      "enum": [
        "CONSOLIDATED_MANAGEMENT_DOMAIN",
        "DEDICATED_MANAGEMENT_AND_VI_WORKLOAD_DOMAIN"
      ]
    },
    "topologyDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "excluded"],
      "properties": {
        "selected": {
          "type": "string",
          "enum": [
            "CONSOLIDATED_MANAGEMENT_DOMAIN",
            "DEDICATED_MANAGEMENT_AND_VI_WORKLOAD_DOMAIN"
          ]
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "topology",
              "requiredHosts",
              "requiredVcfCores",
              "requiredVsanRawTiB",
              "reasonCodes"
            ],
            "properties": {
              "topology": {"type": "string", "minLength": 1},
              "requiredHosts": {"type": "integer", "minimum": 1},
              "requiredVcfCores": {"type": "integer", "minimum": 1},
              "requiredVsanRawTiB": {"type": "integer", "minimum": 1},
              "reasonCodes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": ["VCF_CORE_ENTITLEMENT", "VSAN_RAW_TIB_ENTITLEMENT"]
                }
              }
            }
          }
        }
      }
    },
    "sddcSpec": {"type": "object"},
    "hostPlacement": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hostname", "site", "rack"],
        "properties": {
          "hostname": {"type": "string", "minLength": 1},
          "site": {"type": "string", "minLength": 1},
          "rack": {"type": "string", "minLength": 1}
        }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostCount",
        "licensedVcfCores",
        "licensedVsanRawTiB",
        "nPlusOneWorkloadVcpu",
        "nPlusOneWorkloadMemoryGiB",
        "usableVsanTiBAtFtt1AndSlack"
      ],
      "properties": {
        "hostCount": {"type": "integer", "minimum": 1},
        "licensedVcfCores": {"type": "integer", "minimum": 1},
        "licensedVsanRawTiB": {"type": "integer", "minimum": 1},
        "nPlusOneWorkloadVcpu": {"type": "integer", "minimum": 0},
        "nPlusOneWorkloadMemoryGiB": {"type": "integer", "minimum": 0},
        "usableVsanTiBAtFtt1AndSlack": {"type": "integer", "minimum": 0}
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostFailuresToTolerate", "siteFailureTolerance", "rackDistribution"],
      "properties": {
        "hostFailuresToTolerate": {"type": "integer", "minimum": 0},
        "siteFailureTolerance": {"type": "boolean"},
        "rackDistribution": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}

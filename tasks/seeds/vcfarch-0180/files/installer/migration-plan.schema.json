{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch:migration-plan:1.0.0",
  "title": "VCF management component migration architecture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "estate_id",
    "snapshot_id",
    "target_vcf_version",
    "support_findings",
    "placements",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^vcfarch-[a-z0-9-]+$"
    },
    "estate_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "target_vcf_version": {
      "type": "string",
      "minLength": 1
    },
    "support_findings": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_product",
          "source_version",
          "eogs_date",
          "support_status",
          "direct_path"
        ],
        "properties": {
          "source_product": {
            "type": "string",
            "minLength": 1
          },
          "source_version": {
            "type": "string",
            "minLength": 1
          },
          "eogs_date": {
            "type": "string",
            "format": "date"
          },
          "support_status": {
            "enum": [
              "supported",
              "end-of-general-support"
            ]
          },
          "direct_path": {
            "enum": [
              "supported",
              "unsupported",
              "requires-intermediate"
            ]
          }
        }
      }
    },
    "placements": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "version",
          "deployment_model",
          "site",
          "management_domain",
          "nodes",
          "capacity_basis"
        ],
        "properties": {
          "component": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "deployment_model": {
            "type": "string",
            "minLength": 1
          },
          "site": {
            "type": "string",
            "minLength": 1
          },
          "management_domain": {
            "type": "string",
            "minLength": 1
          },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "role",
                "failure_domain",
                "vcpu",
                "memory_gib",
                "storage_gib"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "failure_domain": {
                  "type": "string",
                  "minLength": 1
                },
                "vcpu": {
                  "type": "integer",
                  "minimum": 1
                },
                "memory_gib": {
                  "type": "integer",
                  "minimum": 1
                },
                "storage_gib": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "capacity_basis": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "id",
          "source_product",
          "source_version",
          "target_component",
          "target_version",
          "method",
          "carries",
          "abandons",
          "gates",
          "depends_on"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "source_product": {
            "type": "string",
            "minLength": 1
          },
          "source_version": {
            "type": "string",
            "minLength": 1
          },
          "target_component": {
            "type": "string",
            "minLength": 1
          },
          "target_version": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "greenfield-export-import",
              "migration-assistant",
              "fleet-in-place-upgrade",
              "greenfield-parallel-transfer"
            ]
          },
          "carries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "abandons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

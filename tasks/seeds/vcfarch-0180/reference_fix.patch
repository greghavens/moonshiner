+package migrationplan
+
+import (
+	"bytes"
+	"io"
+	"os"
+	"strings"
+	"testing"
+)
+
+func TestBuildValidation(t *testing.T) {
+	inventory, err := os.ReadFile("../fixtures/estate.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	snapshot, err := os.ReadFile("../installer/compatibility-snapshot.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	tests := []struct {
+		name      string
+		inventory []byte
+		snapshot  []byte
+		wantError string
+	}{
+		{name: "valid", inventory: inventory, snapshot: snapshot},
+		{name: "malformed inventory", inventory: []byte(`{"estate_id":`), snapshot: snapshot, wantError: "decode inventory"},
+		{name: "malformed snapshot", inventory: inventory, snapshot: []byte(`[]`), wantError: "decode compatibility snapshot"},
+		{name: "target mismatch", inventory: bytes.Replace(inventory, []byte(`"target_vcf_version": "9.0.2"`), []byte(`"target_vcf_version": "9.1.0"`), 1), snapshot: snapshot, wantError: "target versions do not match"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := Build(bytes.NewReader(tc.inventory), bytes.NewReader(tc.snapshot))
+			if tc.wantError == "" {
+				if err != nil {
+					t.Fatalf("Build() error = %v", err)
+				}
+				if len(got) == 0 {
+					t.Fatal("Build() returned an empty document")
+				}
+				return
+			}
+			if err == nil || !strings.Contains(err.Error(), tc.wantError) {
+				t.Fatalf("Build() error = %v, want substring %q", err, tc.wantError)
+			}
+		})
+	}
+}
+
+func TestBuildNilReaders(t *testing.T) {
+	tests := []struct {
+		name      string
+		inventory io.Reader
+		snapshot  io.Reader
+	}{
+		{name: "nil inventory", snapshot: bytes.NewReader(nil)},
+		{name: "nil snapshot", inventory: bytes.NewReader(nil)},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if _, err := Build(tc.inventory, tc.snapshot); err == nil {
+				t.Fatal("Build() error = nil, want reader validation error")
+			}
+		})
+	}
+}

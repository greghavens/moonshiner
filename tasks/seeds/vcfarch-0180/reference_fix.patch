--- a/migrationplan/plan.go
+++ b/migrationplan/plan.go
@@ -1,15 +1,396 @@
 package migrationplan
 
 import (
-	"errors"
+	"encoding/json"
+	"fmt"
 	"io"
+	"sort"
+	"strings"
 )
 
-// ErrNotImplemented marks the seed's intentionally incomplete baseline.
-var ErrNotImplemented = errors.New("migration plan builder is not implemented")
-
 // Build returns a deterministic migration-plan.json document from the estate
 // inventory and the pinned installer snapshot.
 func Build(inventory io.Reader, snapshot io.Reader) ([]byte, error) {
-	return nil, ErrNotImplemented
+	if inventory == nil || snapshot == nil {
+		return nil, fmt.Errorf("inventory and snapshot readers are required")
+	}
+	var estate estateInventory
+	if err := decodeStrict(inventory, &estate); err != nil {
+		return nil, fmt.Errorf("decode inventory: %w", err)
+	}
+	var authority compatibilitySnapshot
+	if err := decodeStrict(snapshot, &authority); err != nil {
+		return nil, fmt.Errorf("decode compatibility snapshot: %w", err)
+	}
+	if err := validateInputs(estate, authority); err != nil {
+		return nil, err
+	}
+
+	plan := document{
+		SchemaVersion:    "1.0.0",
+		PlanID:           "vcfarch-" + estate.EstateID + "-vcf9",
+		EstateID:         estate.EstateID,
+		SnapshotID:       authority.SnapshotID,
+		TargetVCFVersion: estate.TargetVCFVersion,
+	}
+
+	for _, product := range estate.Products {
+		life := lifecycleFor(authority, product.Product)
+		plan.SupportFindings = append(plan.SupportFindings, supportFinding{
+			SourceProduct: product.Product,
+			SourceVersion: product.Version,
+			EOGSDate:      life.EOGSDate,
+			SupportStatus: life.SupportStatusOnCapture,
+			DirectPath:    life.DirectPathToTarget,
+		})
+	}
+
+	for _, target := range authority.TargetComponents {
+		profile := profileFor(authority, target.Component)
+		placement := placement{
+			Component:        target.Component,
+			Version:          target.Version,
+			DeploymentModel:  profile.DeploymentModel,
+			Site:             estate.ManagementDomain.Site,
+			ManagementDomain: estate.ManagementDomain.Name,
+			CapacityBasis:    append([]string(nil), profile.CapacityBasis...),
+		}
+		prefix := nodePrefix(target.Component)
+		for index, role := range profile.NodeRoles {
+			placement.Nodes = append(placement.Nodes, node{
+				Name:          fmt.Sprintf("%s-%02d", prefix, index+1),
+				Role:          role,
+				FailureDomain: estate.ManagementDomain.FailureDomains[index],
+				VCPU:          profile.PerNodeMinimum.VCPU,
+				MemoryGiB:     profile.PerNodeMinimum.MemoryGiB,
+				StorageGiB:    profile.PerNodeMinimum.StorageGiB,
+			})
+		}
+		plan.Placements = append(plan.Placements, placement)
+	}
+
+	edges := make([]compatibilityEdge, 0)
+	for _, candidate := range authority.CompatibilityEdges {
+		if candidate.RequiredInPlan {
+			edges = append(edges, candidate)
+		}
+	}
+	sort.Slice(edges, func(i, j int) bool { return edges[i].Order < edges[j].Order })
+	for _, edge := range edges {
+		plan.Steps = append(plan.Steps, step{
+			Order:           edge.Order,
+			ID:              edge.ID,
+			SourceProduct:   edge.SourceProduct,
+			SourceVersion:   edge.SourceVersion,
+			TargetComponent: edge.TargetComponent,
+			TargetVersion:   edge.TargetVersion,
+			Method:          edge.Method,
+			Carries:         append([]string{}, edge.Carries...),
+			Abandons:        append([]string{}, edge.Abandons...),
+			Gates:           append([]string{}, edge.Gates...),
+			DependsOn:       append([]string{}, edge.DependsOn...),
+		})
+	}
+
+	encoded, err := json.MarshalIndent(plan, "", "  ")
+	if err != nil {
+		return nil, fmt.Errorf("encode plan: %w", err)
+	}
+	return append(encoded, '\n'), nil
+}
+
+func validateInputs(estate estateInventory, authority compatibilitySnapshot) error {
+	if estate.EstateID == "" || authority.SnapshotID == "" {
+		return fmt.Errorf("estate_id and snapshot_id are required")
+	}
+	if estate.TargetVCFVersion == "" || estate.TargetVCFVersion != authority.TargetVCFVersion {
+		return fmt.Errorf("fixture and snapshot target versions do not match")
+	}
+	if len(estate.Products) == 0 || len(authority.TargetComponents) != 3 {
+		return fmt.Errorf("inventory products and three target components are required")
+	}
+	if len(estate.ManagementDomain.FailureDomains) < 3 {
+		return fmt.Errorf("three management failure domains are required")
+	}
+	seenProducts := map[string]bool{}
+	for _, product := range estate.Products {
+		if product.Product == "" || product.Version == "" || seenProducts[product.Product] {
+			return fmt.Errorf("inventory products must be named, versioned, and unique")
+		}
+		seenProducts[product.Product] = true
+		life, ok := findLifecycle(authority, product.Product)
+		if !ok || !versionInFamily(product.Version, life.VersionFamily) {
+			return fmt.Errorf("no lifecycle authority for %s %s", product.Product, product.Version)
+		}
+		hasRequiredPath := false
+		for _, edge := range authority.CompatibilityEdges {
+			if edge.RequiredInPlan && edge.SourceProduct == product.Product && edge.SourceVersion == product.Version {
+				hasRequiredPath = true
+				break
+			}
+		}
+		if !hasRequiredPath {
+			return fmt.Errorf("no required compatibility path for %s %s", product.Product, product.Version)
+		}
+	}
+	seenOrders := map[int]bool{}
+	for _, edge := range authority.CompatibilityEdges {
+		if !edge.RequiredInPlan {
+			continue
+		}
+		if !edge.Supported || edge.Order < 1 || seenOrders[edge.Order] {
+			return fmt.Errorf("required edges must be supported with unique positive order")
+		}
+		seenOrders[edge.Order] = true
+	}
+	if len(seenOrders) == 0 {
+		return fmt.Errorf("at least one required compatibility edge is required")
+	}
+	for order := 1; order <= len(seenOrders); order++ {
+		if !seenOrders[order] {
+			return fmt.Errorf("required compatibility edge order is not contiguous")
+		}
+	}
+
+	total := resources{}
+	for _, target := range authority.TargetComponents {
+		profile, ok := findProfile(authority, target.Component)
+		if !ok || profile.Version != target.Version || len(profile.NodeRoles) != 3 {
+			return fmt.Errorf("invalid sizing profile for %s", target.Component)
+		}
+		load, ok := fixtureLoad(estate, target.Component)
+		if !ok || load > profile.MaximumSupportedLoad {
+			return fmt.Errorf("fixture load exceeds sizing profile for %s", target.Component)
+		}
+		total.VCPU += len(profile.NodeRoles) * profile.PerNodeMinimum.VCPU
+		total.MemoryGiB += len(profile.NodeRoles) * profile.PerNodeMinimum.MemoryGiB
+		total.StorageGiB += len(profile.NodeRoles) * profile.PerNodeMinimum.StorageGiB
+	}
+	availablePercent := 100 - estate.ManagementDomain.ReservePercent
+	if availablePercent < 0 ||
+		total.VCPU > estate.ManagementDomain.FreeCapacity.VCPU*availablePercent/100 ||
+		total.MemoryGiB > estate.ManagementDomain.FreeCapacity.MemoryGiB*availablePercent/100 ||
+		total.StorageGiB > estate.ManagementDomain.FreeCapacity.StorageGiB*availablePercent/100 {
+		return fmt.Errorf("selected profiles exceed post-reserve management capacity")
+	}
+	return nil
+}
+
+func decodeStrict(reader io.Reader, target any) error {
+	decoder := json.NewDecoder(reader)
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(target); err != nil {
+		return err
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); err != io.EOF {
+		if err == nil {
+			return fmt.Errorf("unexpected trailing JSON value")
+		}
+		return err
+	}
+	return nil
+}
+
+func lifecycleFor(authority compatibilitySnapshot, product string) lifecycleRow {
+	row, _ := findLifecycle(authority, product)
+	return row
+}
+
+func findLifecycle(authority compatibilitySnapshot, product string) (lifecycleRow, bool) {
+	for _, row := range authority.Lifecycle {
+		if row.Product == product {
+			return row, true
+		}
+	}
+	return lifecycleRow{}, false
+}
+
+func versionInFamily(version, family string) bool {
+	prefix := strings.TrimSuffix(family, "x")
+	return prefix != family && strings.HasPrefix(version, prefix)
+}
+
+func profileFor(authority compatibilitySnapshot, component string) sizingProfile {
+	profile, _ := findProfile(authority, component)
+	return profile
+}
+
+func findProfile(authority compatibilitySnapshot, component string) (sizingProfile, bool) {
+	for _, profile := range authority.SizingProfiles {
+		if profile.Component == component {
+			return profile, true
+		}
+	}
+	return sizingProfile{}, false
+}
+
+func fixtureLoad(estate estateInventory, component string) (int, bool) {
+	for _, product := range estate.Products {
+		switch component {
+		case "VMware Cloud Foundation Operations":
+			if product.Product == "VMware Aria Operations" {
+				return product.Deployment.Objects, true
+			}
+		case "VMware Cloud Foundation Automation":
+			if product.Product == "VMware vRealize Automation" {
+				return product.Deployment.ManagedDeployments, true
+			}
+		case "VMware Cloud Foundation Operations for Logs":
+			if product.Product == "VMware Aria Operations for Logs" {
+				return product.Deployment.PeakEPS, true
+			}
+		}
+	}
+	return 0, false
+}
+
+func nodePrefix(component string) string {
+	switch component {
+	case "VMware Cloud Foundation Operations":
+		return "vcf-ops"
+	case "VMware Cloud Foundation Automation":
+		return "vcf-auto"
+	case "VMware Cloud Foundation Operations for Logs":
+		return "vcf-logs"
+	default:
+		return "vcf-component"
+	}
+}
+
+type document struct {
+	SchemaVersion    string           `json:"schema_version"`
+	PlanID           string           `json:"plan_id"`
+	EstateID         string           `json:"estate_id"`
+	SnapshotID       string           `json:"snapshot_id"`
+	TargetVCFVersion string           `json:"target_vcf_version"`
+	SupportFindings  []supportFinding `json:"support_findings"`
+	Placements       []placement      `json:"placements"`
+	Steps            []step           `json:"steps"`
+}
+
+type supportFinding struct {
+	SourceProduct string `json:"source_product"`
+	SourceVersion string `json:"source_version"`
+	EOGSDate      string `json:"eogs_date"`
+	SupportStatus string `json:"support_status"`
+	DirectPath    string `json:"direct_path"`
+}
+
+type placement struct {
+	Component        string   `json:"component"`
+	Version          string   `json:"version"`
+	DeploymentModel  string   `json:"deployment_model"`
+	Site             string   `json:"site"`
+	ManagementDomain string   `json:"management_domain"`
+	Nodes            []node   `json:"nodes"`
+	CapacityBasis    []string `json:"capacity_basis"`
+}
+
+type node struct {
+	Name          string `json:"name"`
+	Role          string `json:"role"`
+	FailureDomain string `json:"failure_domain"`
+	VCPU          int    `json:"vcpu"`
+	MemoryGiB     int    `json:"memory_gib"`
+	StorageGiB    int    `json:"storage_gib"`
+}
+
+type step struct {
+	Order           int      `json:"order"`
+	ID              string   `json:"id"`
+	SourceProduct   string   `json:"source_product"`
+	SourceVersion   string   `json:"source_version"`
+	TargetComponent string   `json:"target_component"`
+	TargetVersion   string   `json:"target_version"`
+	Method          string   `json:"method"`
+	Carries         []string `json:"carries"`
+	Abandons        []string `json:"abandons"`
+	Gates           []string `json:"gates"`
+	DependsOn       []string `json:"depends_on"`
+}
+
+type estateInventory struct {
+	EstateID         string `json:"estate_id"`
+	AsOf             string `json:"as_of"`
+	TargetVCFVersion string `json:"target_vcf_version"`
+	ManagementDomain struct {
+		Name           string    `json:"name"`
+		Site           string    `json:"site"`
+		FailureDomains []string  `json:"failure_domains"`
+		FreeCapacity   resources `json:"free_capacity"`
+		ReservePercent int       `json:"reserve_percent"`
+	} `json:"management_domain"`
+	Products []inventoryProduct `json:"products"`
+}
+
+type inventoryProduct struct {
+	InventoryID string `json:"inventory_id"`
+	Product     string `json:"product"`
+	Version     string `json:"version"`
+	Deployment  struct {
+		Nodes              int `json:"nodes"`
+		Objects            int `json:"objects"`
+		MetricsPerDay      int `json:"metrics_per_day"`
+		ManagedDeployments int `json:"managed_deployments"`
+		AverageEPS         int `json:"average_eps"`
+		PeakEPS            int `json:"peak_eps"`
+		RetentionDays      int `json:"retention_days"`
+	} `json:"deployment"`
+	Content []string `json:"content"`
+}
+
+type compatibilitySnapshot struct {
+	SnapshotID       string `json:"snapshot_id"`
+	CapturedOn       string `json:"captured_on"`
+	TargetVCFVersion string `json:"target_vcf_version"`
+	TargetComponents []struct {
+		Component string `json:"component"`
+		Version   string `json:"version"`
+	} `json:"target_components"`
+	Lifecycle          []lifecycleRow      `json:"lifecycle"`
+	CompatibilityEdges []compatibilityEdge `json:"compatibility_edges"`
+	SizingProfiles     []sizingProfile     `json:"sizing_profiles"`
+}
+
+type lifecycleRow struct {
+	Product                string `json:"product"`
+	VersionFamily          string `json:"version_family"`
+	EOGSDate               string `json:"eogs_date"`
+	SupportStatusOnCapture string `json:"support_status_on_capture"`
+	DirectPathToTarget     string `json:"direct_path_to_target"`
+}
+
+type compatibilityEdge struct {
+	ID              string   `json:"id"`
+	RequiredInPlan  bool     `json:"required_in_plan"`
+	Supported       bool     `json:"supported"`
+	Order           int      `json:"order"`
+	SourceProduct   string   `json:"source_product"`
+	SourceVersion   string   `json:"source_version"`
+	TargetComponent string   `json:"target_component"`
+	TargetVersion   string   `json:"target_version"`
+	Method          string   `json:"method"`
+	Reason          string   `json:"reason"`
+	Carries         []string `json:"carries"`
+	Abandons        []string `json:"abandons"`
+	Gates           []string `json:"gates"`
+	DependsOn       []string `json:"depends_on"`
+}
+
+type sizingProfile struct {
+	Component            string    `json:"component"`
+	Version              string    `json:"version"`
+	DeploymentModel      string    `json:"deployment_model"`
+	SelectionMetric      string    `json:"selection_metric"`
+	MaximumSupportedLoad int       `json:"maximum_supported_load"`
+	CapacityBasis        []string  `json:"capacity_basis"`
+	NodeRoles            []string  `json:"node_roles"`
+	PerNodeMinimum       resources `json:"per_node_minimum"`
+}
+
+type resources struct {
+	VCPU       int `json:"vcpu"`
+	MemoryGiB  int `json:"memory_gib"`
+	StorageGiB int `json:"storage_gib"`
 }

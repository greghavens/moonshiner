    "title": "vSphere Automation API",
    "version": "9.0.0.0",
    "openapi": "3.0.3",
    "serverUrlTemplate": "https://{host}/api",
    "basePath": "/api",
    "specPath": "specifications/vsphere/openapi/automation/vcenter.yaml",
    "repositoryTag": "9.0.0.0",
    "repositoryCommitSha": "85151f6b1bb58f13b6ac0304bfec53904bea085f"
  },
  "authorization": {
    "scheme": "api_key_auth",
    "specPointer": "#/components/securitySchemes/api_key_auth",
    "headerName": "vmware-api-session-id",
    "in": "header",
    "provenance": "Spec-derived. Every operation in this contract declares security [{api_key_auth: []}], and components.securitySchemes.api_key_auth is an apiKey carried in the vmware-api-session-id header. The session identifier is supplied by the caller; this contract does not cover how it is obtained.",
    "appliesTo": [
      "Vcenter.Vm.Power_get",
      "Vcenter.Vm.Power_stop",
      "Vcenter.Vm.Hardware.Memory_update",
      "Vcenter.Vm.Hardware.Cpu_update",
      "Vcenter.Vm.Hardware.Disk_create",
      "Vcenter.Vm.Power_start"
    ]
  },
  "requestConventions": {
    "acceptHeader": "application/json",
    "contentTypeHeader": "application/json",
    "contentTypeOnBodiedRequestsOnly": true,
    "getRequestsHaveNoBody": true,
    "actionQueryParameter": "Vcenter.Vm.Power_stop and Vcenter.Vm.Power_start share the path /vcenter/vm/{vm}/power with Vcenter.Vm.Power_get and are distinguished only by the action query parameter, which the specification encodes in the path key. The value must be sent as a query parameter on those two POSTs and must not appear on Vcenter.Vm.Power_get.",
    "note": "The server URL template is https://{host}/api, so every path below hangs off the /api base path."
  },
  "omitEmptyRule": "Every property of Vcenter.Vm.Hardware.Memory.UpdateSpec, Vcenter.Vm.Hardware.Cpu.UpdateSpec, Vcenter.Vm.Hardware.Disk.CreateSpec and Vcenter.Vm.Hardware.Disk.VmdkCreateSpec is optional, and the specification states for each that a missing or null value leaves the value unchanged or lets the server choose. A property the caller did not set must therefore be absent from the serialized request body, not present and empty: no \"name\":\"\", no \"type\":\"\", no zero-valued \"size_mib\":0 or \"capacity\":0, no null-valued keys, and no empty nested object such as \"scsi\":{} or \"new_vmdk\":{}. A property the caller did set must be sent even when its value is the zero value of its type, so an explicitly requested hot_add_enabled=false is sent as \"hot_add_enabled\":false and is not confused with an unset flag. Vcenter.Vm.Hardware.ScsiAddressSpec requires bus, so bus is sent whenever an scsi address is supplied, including when it is 0.",
  "vocabularies": {
    "powerState": {
      "specPointer": "#/components/schemas/Vcenter.Vm.Power.Info/properties/state",
      "values": [
        "POWERED_OFF",

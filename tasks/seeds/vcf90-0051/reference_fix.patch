+func TestCancelledContextStopsBeforeTheFirstRequest(t *testing.T) {
+	s := vcmock.New(t, vcmock.Config{})
+	client := newClient(t, s)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	if _, err := client.Apply(ctx, vmreconfig.ChangeSet{
+		VM:  "vm-1",
+		CPU: &vmreconfig.CPUChange{Count: i64(2)},
+	}); err == nil {
+		t.Fatal("Apply: got nil error on a cancelled context")
+	}
+	if got := len(s.Requests()); got != 0 {
+		t.Errorf("a cancelled context still sent %d requests", got)
+	}
+}

+func TestValidationRejectsBeforeSending(t *testing.T) {
+	tests := []struct {
+		name   string
+		change vmreconfig.ChangeSet
+	}{
+		{"no vm", vmreconfig.ChangeSet{CPU: &vmreconfig.CPUChange{Count: i64(2)}}},
+		{"blank vm", vmreconfig.ChangeSet{VM: "  ", CPU: &vmreconfig.CPUChange{Count: i64(2)}}},
+		{"nothing to change", vmreconfig.ChangeSet{VM: "vm-1"}},
+		{"memory change with no properties", vmreconfig.ChangeSet{VM: "vm-1", Memory: &vmreconfig.MemoryChange{}}},
+		{"cpu change with no properties", vmreconfig.ChangeSet{VM: "vm-1", CPU: &vmreconfig.CPUChange{}}},
+		{"non positive memory", vmreconfig.ChangeSet{VM: "vm-1", Memory: &vmreconfig.MemoryChange{SizeMiB: i64(0)}}},
+		{"non positive cpu count", vmreconfig.ChangeSet{VM: "vm-1", CPU: &vmreconfig.CPUChange{Count: i64(0)}}},
+		{"non positive cores per socket", vmreconfig.ChangeSet{VM: "vm-1", CPU: &vmreconfig.CPUChange{CoresPerSocket: i64(-1)}}},
+		{"count not a multiple of cores per socket", vmreconfig.ChangeSet{
+			VM:  "vm-1",
+			CPU: &vmreconfig.CPUChange{Count: i64(6), CoresPerSocket: i64(4)},
+		}},
+		{"adapter type outside the vocabulary", vmreconfig.ChangeSet{
+			VM:    "vm-1",
+			Disks: []vmreconfig.DiskChange{{Type: "USB", NewVMDK: &vmreconfig.NewVMDK{}}},
+		}},
+		{"disk without a new backing", vmreconfig.ChangeSet{
+			VM:    "vm-1",
+			Disks: []vmreconfig.DiskChange{{Type: "SCSI"}},
+		}},
+		{"non positive capacity", vmreconfig.ChangeSet{
+			VM:    "vm-1",
+			Disks: []vmreconfig.DiskChange{{NewVMDK: &vmreconfig.NewVMDK{CapacityBytes: i64(0)}}},
+		}},
+		{"vmdk name carrying the extension", vmreconfig.ChangeSet{
+			VM:    "vm-1",
+			Disks: []vmreconfig.DiskChange{{NewVMDK: &vmreconfig.NewVMDK{Name: "data-01.vmdk"}}},
+		}},
+		{"scsi address on a non scsi adapter", vmreconfig.ChangeSet{
+			VM: "vm-1",
+			Disks: []vmreconfig.DiskChange{{
+				Type:    "SATA",
+				SCSI:    &vmreconfig.SCSIAddress{Bus: 0},
+				NewVMDK: &vmreconfig.NewVMDK{},
+			}},
+		}},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s := vcmock.New(t, vcmock.Config{})
+			client := newClient(t, s)
+			report, err := client.Apply(context.Background(), tc.change)
+			if err == nil {
+				t.Fatal("Apply: got nil error, want ErrInvalidRequest")
+			}
+			if !errors.Is(err, vmreconfig.ErrInvalidRequest) {
+				t.Errorf("Apply error %v does not match ErrInvalidRequest", err)
+			}
+			if len(s.Requests()) != 0 {
+				t.Errorf("an invalid change set reached the wire with %d requests", len(s.Requests()))
+			}
+			if len(report.Steps) != 0 {
+				t.Errorf("a rejected change set reported %d steps, want none", len(report.Steps))
+			}
+		})
+	}
+}

+func newClient(t *testing.T, s *vcmock.Server) *vmreconfig.Client {
+	t.Helper()
+	c, err := vmreconfig.New(vmreconfig.Config{BaseURL: s.URL, SessionID: s.SessionID})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	return c
+}
+
+// statuses flattens a report into the per-step outcomes.
+func statuses(r vmreconfig.Report) []vmreconfig.StepStatus {
+	out := make([]vmreconfig.StepStatus, 0, len(r.Steps))
+	for _, s := range r.Steps {
+		out = append(out, s.Status)
+	}
+	return out
+}
+
+// bodyOf decodes the single request a given operation received.
+func bodyOf(t *testing.T, s *vcmock.Server, operation string) map[string]any {
+	t.Helper()
+	reqs := s.RequestsFor(operation)
+	if len(reqs) != 1 {
+		t.Fatalf("%s was called %d times, want once", operation, len(reqs))
+	}
+	obj, err := reqs[0].JSONBody()
+	if err != nil {
+		t.Fatalf("%s: %v", operation, err)
+	}
+	return obj
+}

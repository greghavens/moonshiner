+func TestUnauthorizedSessionIsReportedAsAnAPIError(t *testing.T) {
+	s := vcmock.New(t, vcmock.Config{})
+	client, err := vmreconfig.New(vmreconfig.Config{BaseURL: s.URL, SessionID: "not-the-session"})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	_, err = client.Apply(context.Background(), vmreconfig.ChangeSet{
+		VM:  "vm-1",
+		CPU: &vmreconfig.CPUChange{Count: i64(2)},
+	})
+	if err == nil {
+		t.Fatal("Apply: got nil error, want an authentication failure")
+	}
+	var apiErr *vmreconfig.APIError
+	if !errors.As(err, &apiErr) {
+		t.Fatalf("Apply error %v is not an *APIError", err)
+	}
+	if apiErr.Status != http.StatusUnauthorized {
+		t.Errorf("APIError.Status = %d, want 401", apiErr.Status)
+	}
+	if apiErr.Operation != "Vcenter.Vm.Power_get" {
+		t.Errorf("APIError.Operation = %q, want the preflight Vcenter.Vm.Power_get", apiErr.Operation)
+	}
+}

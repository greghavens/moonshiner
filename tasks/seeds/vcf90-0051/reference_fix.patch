@@ -0,0 +1,637 @@
+package vmreconfig
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+)
+
+// Operation identifiers, exactly as the vSphere Automation API specification
+// spells them. These are the only operations this package calls.
+const (
+	OpPowerGet      = "Vcenter.Vm.Power_get"
+	OpPowerStop     = "Vcenter.Vm.Power_stop"
+	OpMemoryUpdate  = "Vcenter.Vm.Hardware.Memory_update"
+	OpCPUUpdate     = "Vcenter.Vm.Hardware.Cpu_update"
+	OpDiskCreate    = "Vcenter.Vm.Hardware.Disk_create"
+	OpPowerStart    = "Vcenter.Vm.Power_start"
+	sessionHeader   = "vmware-api-session-id"
+	basePath        = "/api"
+	jsonContentType = "application/json"
+)
+
+// Power states from the specification's Vcenter.Vm.Power.State vocabulary.
+const (
+	PoweredOff = "POWERED_OFF"
+	PoweredOn  = "POWERED_ON"
+	Suspended  = "SUSPENDED"
+)
+
+// Sentinels, matchable with errors.Is.
+var (
+	// ErrInvalidRequest reports a change set or configuration this package
+	// rejected locally, before any request was sent.
+	ErrInvalidRequest = errors.New("vmreconfig: invalid request")
+	// ErrAPI reports a non-success answer from the appliance.
+	ErrAPI = errors.New("vmreconfig: api error")
+)
+
+// Config configures a Client.
+type Config struct {
+	// BaseURL is the vCenter appliance root with no path, such as
+	// https://vcenter.example.com. The /api base path is appended by this
+	// package.
+	BaseURL string
+	// SessionID is the value sent in the vmware-api-session-id header.
+	SessionID string
+	// HTTPClient is optional; nil means http.DefaultClient.
+	HTTPClient *http.Client
+}
+
+// Client applies change sets to a virtual machine.
+type Client struct {
+	baseURL   string
+	sessionID string
+	http      *http.Client
+}
+
+// New validates cfg and returns a Client. It performs no I/O.
+func New(cfg Config) (*Client, error) {
+	raw := strings.TrimRight(strings.TrimSpace(cfg.BaseURL), "/")
+	if raw == "" {
+		return nil, fmt.Errorf("%w: BaseURL is empty", ErrInvalidRequest)
+	}
+	u, err := url.Parse(raw)
+	if err != nil {
+		return nil, fmt.Errorf("%w: BaseURL %q is not a URL: %v", ErrInvalidRequest, cfg.BaseURL, err)
+	}
+	if u.Scheme != "http" && u.Scheme != "https" {
+		return nil, fmt.Errorf("%w: BaseURL scheme %q is not http or https", ErrInvalidRequest, u.Scheme)
+	}
+	if u.Host == "" {
+		return nil, fmt.Errorf("%w: BaseURL %q has no host", ErrInvalidRequest, cfg.BaseURL)
+	}
+	if strings.TrimSpace(cfg.SessionID) == "" {
+		return nil, fmt.Errorf("%w: SessionID is empty", ErrInvalidRequest)
+	}
+	if !headerSafe(cfg.SessionID) {
+		return nil, fmt.Errorf("%w: SessionID contains a byte that is unsafe in an HTTP header", ErrInvalidRequest)
+	}
+	hc := cfg.HTTPClient
+	if hc == nil {
+		hc = http.DefaultClient
+	}
+	return &Client{baseURL: raw, sessionID: cfg.SessionID, http: hc}, nil
+}
+
+func headerSafe(value string) bool {
+	for i := 0; i < len(value); i++ {
+		if value[i] == 0x7f || (value[i] < 0x20 && value[i] != '\t') {
+			return false
+		}
+	}
+	return true
+}
+
+// MemoryChange is a requested change to Vcenter.Vm.Hardware.Memory.UpdateSpec.
+// A nil field is not sent.
+type MemoryChange struct {
+	SizeMiB       *int64
+	HotAddEnabled *bool
+}
+
+func (m *MemoryChange) empty() bool { return m.SizeMiB == nil && m.HotAddEnabled == nil }
+
+// CPUChange is a requested change to Vcenter.Vm.Hardware.Cpu.UpdateSpec. A nil
+// field is not sent.
+type CPUChange struct {
+	Count            *int64
+	CoresPerSocket   *int64
+	HotAddEnabled    *bool
+	HotRemoveEnabled *bool
+}
+
+func (c *CPUChange) empty() bool {
+	return c.Count == nil && c.CoresPerSocket == nil && c.HotAddEnabled == nil && c.HotRemoveEnabled == nil
+}
+
+// SCSIAddress is a Vcenter.Vm.Hardware.ScsiAddressSpec. Bus is required by the
+// specification and is always sent, including when it is zero. Unit is optional.
+type SCSIAddress struct {
+	Bus  int64
+	Unit *int64
+}
+
+// NewVMDK is a Vcenter.Vm.Hardware.Disk.VmdkCreateSpec. Every field is optional.
+type NewVMDK struct {
+	Name          string
+	CapacityBytes *int64
+}
+
+// DiskChange is a Vcenter.Vm.Hardware.Disk.CreateSpec. Every field is optional
+// on the wire, but this package requires NewVMDK because it only creates new
+// backings.
+type DiskChange struct {
+	Type    string
+	SCSI    *SCSIAddress
+	NewVMDK *NewVMDK
+}
+
+// ChangeSet is one reconfiguration applied as an ordered sequence.
+type ChangeSet struct {
+	VM                string
+	Memory            *MemoryChange
+	CPU               *CPUChange
+	Disks             []DiskChange
+	RestorePowerState bool
+}
+
+// StepStatus is the outcome of one step.
+type StepStatus string
+
+const (
+	// StepApplied means the request was sent and the appliance accepted it.
+	StepApplied StepStatus = "APPLIED"
+	// StepSkipped means the step was deliberately not needed. No change is
+	// outstanding because of it.
+	StepSkipped StepStatus = "SKIPPED"
+	// StepFailed means the request was sent and the appliance refused it.
+	StepFailed StepStatus = "FAILED"
+	// StepNotAttempted means an earlier step failed and this one never ran.
+	StepNotAttempted StepStatus = "NOT_ATTEMPTED"
+)
+
+// StepReport is the outcome of one step of a change set.
+type StepReport struct {
+	// Operation is the specification operationId for this step.
+	Operation string
+	Status    StepStatus
+	// Detail explains the outcome in prose.
+	Detail string
+	// Err is non-nil only when Status is StepFailed.
+	Err error
+}
+
+// Report describes everything a change set did, including a change set that
+// stopped part way through.
+type Report struct {
+	VM                string
+	InitialPowerState string
+	FinalPowerState   string
+	Steps             []StepReport
+	CreatedDiskIDs    []string
+}
+
+// Applied lists the operationIds of the steps that landed, in order.
+func (r Report) Applied() []string {
+	out := []string{}
+	for _, s := range r.Steps {
+		if s.Status == StepApplied {
+			out = append(out, s.Operation)
+		}
+	}
+	return out
+}
+
+// Failed returns the first failed step.
+func (r Report) Failed() (StepReport, bool) {
+	for _, s := range r.Steps {
+		if s.Status == StepFailed {
+			return s, true
+		}
+	}
+	return StepReport{}, false
+}
+
+// APIError is a non-success answer from the appliance.
+type APIError struct {
+	// Operation is the specification operationId that failed.
+	Operation string
+	Status    int
+	// ErrorType is the vAPI error_type discriminator.
+	ErrorType string
+	// Message is messages[0].default_message.
+	Message string
+}
+
+func (e *APIError) Error() string {
+	return fmt.Sprintf("vmreconfig: %s: %s (HTTP %d): %s", e.Operation, e.ErrorType, e.Status, e.Message)
+}
+
+// Unwrap makes errors.Is(err, ErrAPI) true.
+func (e *APIError) Unwrap() error { return ErrAPI }
+
+// ---------------------------------------------------------------------------
+// wire types
+// ---------------------------------------------------------------------------
+
+type memoryUpdateSpec struct {
+	SizeMiB       *int64 `json:"size_mib,omitempty"`
+	HotAddEnabled *bool  `json:"hot_add_enabled,omitempty"`
+}
+
+type cpuUpdateSpec struct {
+	Count            *int64 `json:"count,omitempty"`
+	CoresPerSocket   *int64 `json:"cores_per_socket,omitempty"`
+	HotAddEnabled    *bool  `json:"hot_add_enabled,omitempty"`
+	HotRemoveEnabled *bool  `json:"hot_remove_enabled,omitempty"`
+}
+
+// scsiAddressSpec sends bus unconditionally: the specification marks it
+// required, so omitempty would silently drop a legitimate bus 0.
+type scsiAddressSpec struct {
+	Bus  int64  `json:"bus"`
+	Unit *int64 `json:"unit,omitempty"`
+}
+
+type vmdkCreateSpec struct {
+	Name     string `json:"name,omitempty"`
+	Capacity *int64 `json:"capacity,omitempty"`
+}
+
+type diskCreateSpec struct {
+	Type    string           `json:"type,omitempty"`
+	SCSI    *scsiAddressSpec `json:"scsi,omitempty"`
+	NewVMDK *vmdkCreateSpec  `json:"new_vmdk,omitempty"`
+}
+
+type powerInfo struct {
+	State string `json:"state"`
+}
+
+type vapiError struct {
+	ErrorType string `json:"error_type"`
+	Messages  []struct {
+		DefaultMessage string `json:"default_message"`
+	} `json:"messages"`
+}
+
+// ---------------------------------------------------------------------------
+// Apply
+// ---------------------------------------------------------------------------
+
+// Apply runs the change set as an ordered sequence and reports every step.
+//
+// The returned Report is always populated, including when Apply returns an
+// error: a change set that fails part way through has still changed the
+// machine, and the caller needs to know which steps landed. A step behind a
+// failed step is reported StepNotAttempted, never StepSkipped.
+func (c *Client) Apply(ctx context.Context, cs ChangeSet) (Report, error) {
+	if err := validate(cs); err != nil {
+		return Report{VM: cs.VM}, err
+	}
+
+	report := Report{VM: cs.VM, CreatedDiskIDs: []string{}}
+	report.Steps = plan(cs)
+
+	// Preflight: the initial power state decides whether a stop is needed and
+	// whether the machine should be powered back on at the end.
+	initial, err := c.powerState(ctx, cs.VM)
+	if err != nil {
+		markNotAttempted(&report, 0)
+		return report, err
+	}
+	report.InitialPowerState = initial
+	report.FinalPowerState = initial
+
+	failedAt := -1
+
+	for i := range report.Steps {
+		if failedAt >= 0 {
+			report.Steps[i].Status = StepNotAttempted
+			report.Steps[i].Detail = fmt.Sprintf("not attempted: %s failed earlier in this change set",
+				report.Steps[failedAt].Operation)
+			continue
+		}
+		step := &report.Steps[i]
+		switch step.Operation {
+		case OpPowerStop:
+			c.applyStop(ctx, cs, report.InitialPowerState, step)
+		case OpMemoryUpdate:
+			c.applyMemory(ctx, cs, step)
+		case OpCPUUpdate:
+			c.applyCPU(ctx, cs, step)
+		case OpDiskCreate:
+			c.applyDisk(ctx, cs, i, step, &report)
+		case OpPowerStart:
+			c.applyStart(ctx, cs, report.InitialPowerState, step)
+		}
+		if step.Status == StepFailed {
+			failedAt = i
+		}
+	}
+
+	// Report the power state the machine was actually left in, read back from
+	// the appliance rather than assumed, even when a step failed.
+	final, finalErr := c.powerState(ctx, cs.VM)
+	if finalErr == nil {
+		report.FinalPowerState = final
+	} else {
+		report.FinalPowerState = ""
+	}
+
+	if failedAt >= 0 {
+		return report, report.Steps[failedAt].Err
+	}
+	if finalErr != nil {
+		return report, finalErr
+	}
+	return report, nil
+}
+
+// plan builds the ordered step list for a change set. Its shape depends only on
+// the change set, so the caller sees every step that was considered, including
+// the ones that turn out to be skipped.
+func plan(cs ChangeSet) []StepReport {
+	steps := []StepReport{{Operation: OpPowerStop}, {Operation: OpMemoryUpdate}, {Operation: OpCPUUpdate}}
+	for range cs.Disks {
+		steps = append(steps, StepReport{Operation: OpDiskCreate})
+	}
+	steps = append(steps, StepReport{Operation: OpPowerStart})
+	return steps
+}
+
+func markNotAttempted(r *Report, from int) {
+	for i := from; i < len(r.Steps); i++ {
+		r.Steps[i].Status = StepNotAttempted
+		r.Steps[i].Detail = "not attempted: the initial power state could not be read"
+	}
+}
+
+func (c *Client) applyStop(ctx context.Context, cs ChangeSet, initial string, step *StepReport) {
+	if initial == PoweredOff {
+		step.Status = StepSkipped
+		step.Detail = "the virtual machine was already POWERED_OFF"
+		return
+	}
+	_, err := c.do(ctx, OpPowerStop, http.MethodPost,
+		"/vcenter/vm/{vm}/power", cs.VM, url.Values{"action": []string{"stop"}}, nil, http.StatusNoContent)
+	if err != nil {
+		// A machine that reached the desired state on its own has nothing
+		// outstanding. That is a skip, not a failure.
+		var apiErr *APIError
+		if errors.As(err, &apiErr) && apiErr.Status == http.StatusBadRequest && apiErr.ErrorType == "ALREADY_IN_DESIRED_STATE" {
+			step.Status = StepSkipped
+			step.Detail = "the appliance reported the virtual machine was already powered off"
+			return
+		}
+		step.Status = StepFailed
+		step.Detail = "could not power the virtual machine down: " + err.Error()
+		step.Err = err
+		return
+	}
+	step.Status = StepApplied
+	step.Detail = "powered the virtual machine down"
+}
+
+func (c *Client) applyMemory(ctx context.Context, cs ChangeSet, step *StepReport) {
+	if cs.Memory == nil {
+		step.Status = StepSkipped
+		step.Detail = "no memory change was requested"
+		return
+	}
+	body := memoryUpdateSpec{SizeMiB: cs.Memory.SizeMiB, HotAddEnabled: cs.Memory.HotAddEnabled}
+	if _, err := c.do(ctx, OpMemoryUpdate, http.MethodPatch,
+		"/vcenter/vm/{vm}/hardware/memory", cs.VM, nil, body, http.StatusNoContent); err != nil {
+		step.Status = StepFailed
+		step.Detail = "could not update memory: " + err.Error()
+		step.Err = err
+		return
+	}
+	step.Status = StepApplied
+	step.Detail = "updated the memory settings"
+}
+
+func (c *Client) applyCPU(ctx context.Context, cs ChangeSet, step *StepReport) {
+	if cs.CPU == nil {
+		step.Status = StepSkipped
+		step.Detail = "no CPU change was requested"
+		return
+	}
+	body := cpuUpdateSpec{
+		Count:            cs.CPU.Count,
+		CoresPerSocket:   cs.CPU.CoresPerSocket,
+		HotAddEnabled:    cs.CPU.HotAddEnabled,
+		HotRemoveEnabled: cs.CPU.HotRemoveEnabled,
+	}
+	if _, err := c.do(ctx, OpCPUUpdate, http.MethodPatch,
+		"/vcenter/vm/{vm}/hardware/cpu", cs.VM, nil, body, http.StatusNoContent); err != nil {
+		step.Status = StepFailed
+		step.Detail = "could not update CPU: " + err.Error()
+		step.Err = err
+		return
+	}
+	step.Status = StepApplied
+	step.Detail = "updated the CPU settings"
+}
+
+// diskIndex maps a step position onto the change set's disk slice. The disk
+// steps are contiguous and start after the stop, memory and CPU steps.
+const firstDiskStep = 3
+
+func (c *Client) applyDisk(ctx context.Context, cs ChangeSet, stepIndex int, step *StepReport, report *Report) {
+	d := cs.Disks[stepIndex-firstDiskStep]
+	body := diskCreateSpec{Type: d.Type}
+	if d.SCSI != nil {
+		body.SCSI = &scsiAddressSpec{Bus: d.SCSI.Bus, Unit: d.SCSI.Unit}
+	}
+	if d.NewVMDK != nil {
+		body.NewVMDK = &vmdkCreateSpec{Name: d.NewVMDK.Name, Capacity: d.NewVMDK.CapacityBytes}
+	}
+	raw, err := c.do(ctx, OpDiskCreate, http.MethodPost,
+		"/vcenter/vm/{vm}/hardware/disk", cs.VM, nil, body, http.StatusCreated)
+	if err != nil {
+		step.Status = StepFailed
+		step.Detail = fmt.Sprintf("could not add disk %d: %s", stepIndex-firstDiskStep+1, err.Error())
+		step.Err = err
+		return
+	}
+	// The specification declares the 201 body as a bare JSON string holding the
+	// identifier of the disk that was created.
+	var id string
+	if uerr := json.Unmarshal(raw, &id); uerr != nil {
+		step.Status = StepFailed
+		step.Detail = fmt.Sprintf("could not add disk %d: unreadable identifier", stepIndex-firstDiskStep+1)
+		step.Err = &APIError{
+			Operation: OpDiskCreate,
+			Status:    http.StatusCreated,
+			ErrorType: "UNEXPECTED_INPUT",
+			Message:   fmt.Sprintf("response body %q is not a JSON string", string(raw)),
+		}
+		return
+	}
+	report.CreatedDiskIDs = append(report.CreatedDiskIDs, id)
+	step.Status = StepApplied
+	step.Detail = fmt.Sprintf("added disk %d as %s", stepIndex-firstDiskStep+1, id)
+}
+
+func (c *Client) applyStart(ctx context.Context, cs ChangeSet, initial string, step *StepReport) {
+	if !cs.RestorePowerState {
+		step.Status = StepSkipped
+		step.Detail = "the change set did not ask for the power state to be restored"
+		return
+	}
+	if initial != PoweredOn {
+		step.Status = StepSkipped
+		step.Detail = fmt.Sprintf("the virtual machine was %s before the change set, so it is not powered on", initial)
+		return
+	}
+	if _, err := c.do(ctx, OpPowerStart, http.MethodPost,
+		"/vcenter/vm/{vm}/power", cs.VM, url.Values{"action": []string{"start"}}, nil, http.StatusNoContent); err != nil {
+		step.Status = StepFailed
+		step.Detail = "could not power the virtual machine back on: " + err.Error()
+		step.Err = err
+		return
+	}
+	step.Status = StepApplied
+	step.Detail = "powered the virtual machine back on"
+}
+
+func (c *Client) powerState(ctx context.Context, vm string) (string, error) {
+	raw, err := c.do(ctx, OpPowerGet, http.MethodGet, "/vcenter/vm/{vm}/power", vm, nil, nil, http.StatusOK)
+	if err != nil {
+		return "", err
+	}
+	var info powerInfo
+	if uerr := json.Unmarshal(raw, &info); uerr != nil {
+		return "", &APIError{
+			Operation: OpPowerGet,
+			Status:    http.StatusOK,
+			ErrorType: "UNEXPECTED_INPUT",
+			Message:   "response is not a Vcenter.Vm.Power.Info object",
+		}
+	}
+	if info.State == "" {
+		return "", &APIError{
+			Operation: OpPowerGet,
+			Status:    http.StatusOK,
+			ErrorType: "UNEXPECTED_INPUT",
+			Message:   "Vcenter.Vm.Power.Info.state is required and was absent",
+		}
+	}
+	return info.State, nil
+}
+
+// do issues one operation and returns the response body on success.
+func (c *Client) do(ctx context.Context, operation, method, template, vm string, query url.Values, body any, wantStatus int) ([]byte, error) {
+	endpoint := c.baseURL + basePath + strings.Replace(template, "{vm}", url.PathEscape(vm), 1)
+	if len(query) > 0 {
+		endpoint += "?" + query.Encode()
+	}
+
+	var reader io.Reader
+	var encoded []byte
+	if body != nil {
+		var err error
+		encoded, err = json.Marshal(body)
+		if err != nil {
+			return nil, fmt.Errorf("%w: %s: encoding the request: %v", ErrInvalidRequest, operation, err)
+		}
+		reader = bytes.NewReader(encoded)
+	}
+
+	req, err := http.NewRequestWithContext(ctx, method, endpoint, reader)
+	if err != nil {
+		return nil, fmt.Errorf("%w: %s: %v", ErrInvalidRequest, operation, err)
+	}
+	req.Header.Set(sessionHeader, c.sessionID)
+	req.Header.Set("Accept", jsonContentType)
+	if body != nil {
+		req.Header.Set("Content-Type", jsonContentType)
+	}
+
+	resp, err := c.http.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("%s %s: %w", operation, method, err)
+	}
+	defer resp.Body.Close()
+	raw, _ := io.ReadAll(resp.Body)
+
+	if resp.StatusCode != wantStatus {
+		return nil, newAPIError(operation, resp.StatusCode, raw)
+	}
+	return raw, nil
+}
+
+func newAPIError(operation string, status int, raw []byte) *APIError {
+	e := &APIError{Operation: operation, Status: status, ErrorType: "ERROR"}
+	var parsed vapiError
+	if err := json.Unmarshal(raw, &parsed); err == nil {
+		if parsed.ErrorType != "" {
+			e.ErrorType = parsed.ErrorType
+		}
+		if len(parsed.Messages) > 0 {
+			e.Message = parsed.Messages[0].DefaultMessage
+		}
+	}
+	if e.Message == "" {
+		e.Message = fmt.Sprintf("the appliance answered HTTP %d", status)
+	}
+	return e
+}
+
+// ---------------------------------------------------------------------------
+// local validation
+// ---------------------------------------------------------------------------
+
+// hostBusAdapterTypes is the specification's
+// Vcenter.Vm.Hardware.Disk.HostBusAdapterType vocabulary.
+var hostBusAdapterTypes = map[string]bool{"IDE": true, "SCSI": true, "SATA": true, "NVME": true}
+
+func validate(cs ChangeSet) error {
+	if strings.TrimSpace(cs.VM) == "" {
+		return fmt.Errorf("%w: ChangeSet.VM is empty", ErrInvalidRequest)
+	}
+	if cs.Memory == nil && cs.CPU == nil && len(cs.Disks) == 0 {
+		return fmt.Errorf("%w: the change set requests no changes", ErrInvalidRequest)
+	}
+	if cs.Memory != nil && cs.Memory.empty() {
+		return fmt.Errorf("%w: MemoryChange sets no property", ErrInvalidRequest)
+	}
+	if cs.Memory != nil && cs.Memory.SizeMiB != nil && *cs.Memory.SizeMiB <= 0 {
+		return fmt.Errorf("%w: MemoryChange.SizeMiB must be positive", ErrInvalidRequest)
+	}
+	if cs.CPU != nil && cs.CPU.empty() {
+		return fmt.Errorf("%w: CPUChange sets no property", ErrInvalidRequest)
+	}
+	if cs.CPU != nil && cs.CPU.Count != nil && *cs.CPU.Count <= 0 {
+		return fmt.Errorf("%w: CPUChange.Count must be positive", ErrInvalidRequest)
+	}
+	if cs.CPU != nil && cs.CPU.CoresPerSocket != nil && *cs.CPU.CoresPerSocket <= 0 {
+		return fmt.Errorf("%w: CPUChange.CoresPerSocket must be positive", ErrInvalidRequest)
+	}
+	if cs.CPU != nil && cs.CPU.Count != nil && cs.CPU.CoresPerSocket != nil {
+		if *cs.CPU.Count%*cs.CPU.CoresPerSocket != 0 {
+			return fmt.Errorf("%w: CPUChange.Count %d is not a multiple of CoresPerSocket %d",
+				ErrInvalidRequest, *cs.CPU.Count, *cs.CPU.CoresPerSocket)
+		}
+	}
+	for i, d := range cs.Disks {
+		if d.Type != "" && !hostBusAdapterTypes[d.Type] {
+			return fmt.Errorf("%w: Disks[%d].Type %q is not an IDE, SCSI, SATA or NVME adapter",
+				ErrInvalidRequest, i, d.Type)
+		}
+		if d.NewVMDK == nil {
+			return fmt.Errorf("%w: Disks[%d] has no NewVMDK; this package only creates new backings",
+				ErrInvalidRequest, i)
+		}
+		if d.NewVMDK.CapacityBytes != nil && *d.NewVMDK.CapacityBytes <= 0 {
+			return fmt.Errorf("%w: Disks[%d].NewVMDK.CapacityBytes must be positive", ErrInvalidRequest, i)
+		}
+		if strings.HasSuffix(strings.ToLower(d.NewVMDK.Name), ".vmdk") {
+			return fmt.Errorf("%w: Disks[%d].NewVMDK.Name must not carry the .vmdk extension",
+				ErrInvalidRequest, i)
+		}
+		if d.SCSI != nil && d.Type != "" && d.Type != "SCSI" {
+			return fmt.Errorf("%w: Disks[%d] gives an SCSI address but asks for a %s adapter",
+				ErrInvalidRequest, i, d.Type)
+		}
+	}
+	return nil
+}

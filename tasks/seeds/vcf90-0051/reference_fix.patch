+func TestPowerSequencing(t *testing.T) {
+	tests := []struct {
+		name             string
+		initial          string
+		restore          bool
+		change           vmreconfig.ChangeSet
+		wantStatuses     []vmreconfig.StepStatus
+		wantStops        int
+		wantStarts       int
+		wantFinalPowered string
+	}{
+		{
+			name:    "powered on, restore requested",
+			initial: vcmock.PoweredOn,
+			restore: true,
+			change:  vmreconfig.ChangeSet{VM: "vm-1", CPU: &vmreconfig.CPUChange{Count: i64(2)}},
+			wantStatuses: []vmreconfig.StepStatus{
+				vmreconfig.StepApplied, vmreconfig.StepSkipped, vmreconfig.StepApplied, vmreconfig.StepApplied,
+			},
+			wantStops: 1, wantStarts: 1, wantFinalPowered: vcmock.PoweredOn,
+		},
+		{
+			name:    "powered on, restore not requested",
+			initial: vcmock.PoweredOn,
+			change:  vmreconfig.ChangeSet{VM: "vm-1", CPU: &vmreconfig.CPUChange{Count: i64(2)}},
+			wantStatuses: []vmreconfig.StepStatus{
+				vmreconfig.StepApplied, vmreconfig.StepSkipped, vmreconfig.StepApplied, vmreconfig.StepSkipped,
+			},
+			wantStops: 1, wantStarts: 0, wantFinalPowered: vcmock.PoweredOff,
+		},
+		{
+			name:    "already powered off",
+			initial: vcmock.PoweredOff,
+			restore: true,
+			change:  vmreconfig.ChangeSet{VM: "vm-1", CPU: &vmreconfig.CPUChange{Count: i64(2)}},
+			wantStatuses: []vmreconfig.StepStatus{
+				vmreconfig.StepSkipped, vmreconfig.StepSkipped, vmreconfig.StepApplied, vmreconfig.StepSkipped,
+			},
+			wantStops: 0, wantStarts: 0, wantFinalPowered: vcmock.PoweredOff,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s := vcmock.New(t, vcmock.Config{InitialPowerState: tc.initial})
+			client := newClient(t, s)
+			cs := tc.change
+			cs.RestorePowerState = tc.restore
+			report, err := client.Apply(context.Background(), cs)
+			if err != nil {
+				t.Fatalf("Apply: unexpected error: %v", err)
+			}
+			if got := statuses(report); !reflect.DeepEqual(got, tc.wantStatuses) {
+				t.Errorf("step statuses = %v, want %v", got, tc.wantStatuses)
+			}
+			if got := len(s.RequestsFor("Vcenter.Vm.Power_stop")); got != tc.wantStops {
+				t.Errorf("Power_stop calls = %d, want %d", got, tc.wantStops)
+			}
+			if got := len(s.RequestsFor("Vcenter.Vm.Power_start")); got != tc.wantStarts {
+				t.Errorf("Power_start calls = %d, want %d", got, tc.wantStarts)
+			}
+			if report.FinalPowerState != tc.wantFinalPowered {
+				t.Errorf("FinalPowerState = %q, want %q", report.FinalPowerState, tc.wantFinalPowered)
+			}
+			if report.InitialPowerState != tc.initial {
+				t.Errorf("InitialPowerState = %q, want %q", report.InitialPowerState, tc.initial)
+			}
+		})
+	}
+}

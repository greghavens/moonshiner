+func TestDiskIdentifiersAreCollectedInOrder(t *testing.T) {
+	s := vcmock.New(t, vcmock.Config{DiskIDs: []string{"2000", "2001", "2002"}})
+	client := newClient(t, s)
+
+	report, err := client.Apply(context.Background(), vmreconfig.ChangeSet{
+		VM: "vm-1",
+		Disks: []vmreconfig.DiskChange{
+			{NewVMDK: &vmreconfig.NewVMDK{Name: "a", CapacityBytes: i64(1024)}},
+			{NewVMDK: &vmreconfig.NewVMDK{Name: "b", CapacityBytes: i64(2048)}},
+			{NewVMDK: &vmreconfig.NewVMDK{Name: "c", CapacityBytes: i64(4096)}},
+		},
+	})
+	if err != nil {
+		t.Fatalf("Apply: unexpected error: %v", err)
+	}
+	if got, want := report.CreatedDiskIDs, []string{"2000", "2001", "2002"}; !reflect.DeepEqual(got, want) {
+		t.Errorf("CreatedDiskIDs = %v, want %v", got, want)
+	}
+	// Each disk was sent as its own request, in the order the change set gave.
+	reqs := s.RequestsFor("Vcenter.Vm.Hardware.Disk_create")
+	if len(reqs) != 3 {
+		t.Fatalf("Disk_create calls = %d, want 3", len(reqs))
+	}
+	for i, wantName := range []string{"a", "b", "c"} {
+		obj, err := reqs[i].JSONBody()
+		if err != nil {
+			t.Fatalf("disk %d: %v", i, err)
+		}
+		vmdk, _ := obj["new_vmdk"].(map[string]any)
+		if vmdk["name"] != wantName {
+			t.Errorf("disk %d name = %v, want %q", i, vmdk["name"], wantName)
+		}
+	}
+}

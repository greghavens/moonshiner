+func TestHeadersAndRouting(t *testing.T) {
+	s := vcmock.New(t, vcmock.Config{})
+	client := newClient(t, s)
+	if _, err := client.Apply(context.Background(), vmreconfig.ChangeSet{
+		VM:                "vm-42",
+		Memory:            &vmreconfig.MemoryChange{SizeMiB: i64(4096)},
+		RestorePowerState: true,
+	}); err != nil {
+		t.Fatalf("Apply: unexpected error: %v", err)
+	}
+
+	for _, r := range s.Requests() {
+		if r.OperationID == "" {
+			t.Errorf("request %d (%s %s) matched no contract operation", r.Seq, r.Method, r.Path)
+		}
+		if got := r.Header.Get("vmware-api-session-id"); got != s.SessionID {
+			t.Errorf("request %d: session header = %q, want %q", r.Seq, got, s.SessionID)
+		}
+		if got := r.Header.Get("Accept"); !strings.Contains(got, "application/json") {
+			t.Errorf("request %d: Accept = %q", r.Seq, got)
+		}
+		if !strings.HasPrefix(r.Path, "/api/vcenter/vm/vm-42/") {
+			t.Errorf("request %d: path = %q, want it under /api/vcenter/vm/vm-42/", r.Seq, r.Path)
+		}
+		hasBody := len(r.Body) > 0
+		ct := r.Header.Get("Content-Type")
+		if hasBody && !strings.HasPrefix(ct, "application/json") {
+			t.Errorf("request %d carries a body with Content-Type %q", r.Seq, ct)
+		}
+		if !hasBody && ct != "" {
+			t.Errorf("request %d carries no body but sends Content-Type %q", r.Seq, ct)
+		}
+	}
+}

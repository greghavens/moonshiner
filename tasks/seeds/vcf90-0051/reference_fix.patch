+func TestNew(t *testing.T) {
+	tests := []struct {
+		name    string
+		cfg     vmreconfig.Config
+		wantErr bool
+	}{
+		{"ok", vmreconfig.Config{BaseURL: "https://vc.example.com", SessionID: "sid"}, false},
+		{"ok with trailing slash", vmreconfig.Config{BaseURL: "https://vc.example.com/", SessionID: "sid"}, false},
+		{"ok with explicit client", vmreconfig.Config{BaseURL: "http://vc.example.com", SessionID: "sid", HTTPClient: &http.Client{}}, false},
+		{"empty base url", vmreconfig.Config{SessionID: "sid"}, true},
+		{"blank base url", vmreconfig.Config{BaseURL: "   ", SessionID: "sid"}, true},
+		{"bad scheme", vmreconfig.Config{BaseURL: "ftp://vc.example.com", SessionID: "sid"}, true},
+		{"no host", vmreconfig.Config{BaseURL: "https://", SessionID: "sid"}, true},
+		{"empty session id", vmreconfig.Config{BaseURL: "https://vc.example.com"}, true},
+		{"blank session id", vmreconfig.Config{BaseURL: "https://vc.example.com", SessionID: "  "}, true},
+		{"session id with a line break", vmreconfig.Config{BaseURL: "https://vc.example.com", SessionID: "a\nb"}, true},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := vmreconfig.New(tc.cfg)
+			if tc.wantErr {
+				if err == nil {
+					t.Fatal("New: got nil error, want ErrInvalidRequest")
+				}
+				if !errors.Is(err, vmreconfig.ErrInvalidRequest) {
+					t.Errorf("New error %v does not match ErrInvalidRequest", err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("New: unexpected error: %v", err)
+			}
+			if got == nil {
+				t.Fatal("New returned a nil client and a nil error")
+			}
+		})
+	}
+}

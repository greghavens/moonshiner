+func TestPartialApplicationIsReported(t *testing.T) {
+	tests := []struct {
+		name         string
+		failure      vcmock.Failure
+		change       vmreconfig.ChangeSet
+		wantStatuses []vmreconfig.StepStatus
+		wantApplied  []string
+		wantDiskIDs  []string
+		wantFinal    string
+	}{
+		{
+			name: "memory fails, cpu and disk never run",
+			failure: vcmock.Failure{
+				Operation: "Vcenter.Vm.Hardware.Memory_update",
+				Status:    http.StatusBadRequest,
+				ErrorType: "NOT_ALLOWED_IN_CURRENT_STATE",
+				Message:   "Memory may only be resized while the virtual machine is powered off.",
+			},
+			change: vmreconfig.ChangeSet{
+				VM:                "vm-1",
+				Memory:            &vmreconfig.MemoryChange{SizeMiB: i64(8192)},
+				CPU:               &vmreconfig.CPUChange{Count: i64(4)},
+				Disks:             []vmreconfig.DiskChange{{NewVMDK: &vmreconfig.NewVMDK{CapacityBytes: i64(1024)}}},
+				RestorePowerState: true,
+			},
+			wantStatuses: []vmreconfig.StepStatus{
+				vmreconfig.StepApplied, vmreconfig.StepFailed,
+				vmreconfig.StepNotAttempted, vmreconfig.StepNotAttempted, vmreconfig.StepNotAttempted,
+			},
+			wantApplied: []string{"Vcenter.Vm.Power_stop"},
+			wantDiskIDs: []string{},
+			wantFinal:   vcmock.PoweredOff,
+		},
+		{
+			name: "the second disk fails",
+			failure: vcmock.Failure{
+				Operation:  "Vcenter.Vm.Hardware.Disk_create",
+				Occurrence: 2,
+				Status:     http.StatusBadRequest,
+				ErrorType:  "UNABLE_TO_ALLOCATE_RESOURCE",
+				Message:    "Datastore ds-01 is full.",
+			},
+			change: vmreconfig.ChangeSet{
+				VM:     "vm-1",
+				Memory: &vmreconfig.MemoryChange{SizeMiB: i64(8192)},
+				Disks: []vmreconfig.DiskChange{
+					{NewVMDK: &vmreconfig.NewVMDK{CapacityBytes: i64(1024)}},
+					{NewVMDK: &vmreconfig.NewVMDK{CapacityBytes: i64(2048)}},
+				},
+				RestorePowerState: true,
+			},
+			wantStatuses: []vmreconfig.StepStatus{
+				vmreconfig.StepApplied, vmreconfig.StepApplied, vmreconfig.StepSkipped,
+				vmreconfig.StepApplied, vmreconfig.StepFailed, vmreconfig.StepNotAttempted,
+			},
+			wantApplied: []string{
+				"Vcenter.Vm.Power_stop",
+				"Vcenter.Vm.Hardware.Memory_update",
+				"Vcenter.Vm.Hardware.Disk_create",
+			},
+			wantDiskIDs: []string{"2000"},
+			wantFinal:   vcmock.PoweredOff,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			s := vcmock.New(t, vcmock.Config{Failures: []vcmock.Failure{tc.failure}})
+			client := newClient(t, s)
+
+			report, err := client.Apply(context.Background(), tc.change)
+			if err == nil {
+				t.Fatal("Apply: got nil error, want the injected failure")
+			}
+			if !errors.Is(err, vmreconfig.ErrAPI) {
+				t.Errorf("Apply error %v does not match ErrAPI", err)
+			}
+			var apiErr *vmreconfig.APIError
+			if !errors.As(err, &apiErr) {
+				t.Fatalf("Apply error %v is not an *APIError", err)
+			}
+			if apiErr.Operation != tc.failure.Operation {
+				t.Errorf("APIError.Operation = %q, want %q", apiErr.Operation, tc.failure.Operation)
+			}
+			if apiErr.ErrorType != tc.failure.ErrorType {
+				t.Errorf("APIError.ErrorType = %q, want %q", apiErr.ErrorType, tc.failure.ErrorType)
+			}
+			if apiErr.Message != tc.failure.Message {
+				t.Errorf("APIError.Message = %q, want the appliance message %q", apiErr.Message, tc.failure.Message)
+			}
+
+			if got := statuses(report); !reflect.DeepEqual(got, tc.wantStatuses) {
+				t.Errorf("step statuses = %v, want %v", got, tc.wantStatuses)
+			}
+			if got := report.Applied(); !reflect.DeepEqual(got, tc.wantApplied) {
+				t.Errorf("Applied() = %v, want %v", got, tc.wantApplied)
+			}
+			if got := report.CreatedDiskIDs; !reflect.DeepEqual(got, tc.wantDiskIDs) {
+				t.Errorf("CreatedDiskIDs = %v, want %v", got, tc.wantDiskIDs)
+			}
+			if report.FinalPowerState != tc.wantFinal {
+				t.Errorf("FinalPowerState = %q, want %q", report.FinalPowerState, tc.wantFinal)
+			}
+			if len(s.RequestsFor("Vcenter.Vm.Power_start")) != 0 {
+				t.Error("Power_start reached the wire behind a failed step")
+			}
+			failed, ok := report.Failed()
+			if !ok {
+				t.Fatal("Report.Failed() found no failed step")
+			}
+			if failed.Operation != tc.failure.Operation {
+				t.Errorf("failed step = %q, want %q", failed.Operation, tc.failure.Operation)
+			}
+			for i, step := range report.Steps {
+				if step.Detail == "" {
+					t.Errorf("step %d (%s) has no Detail", i, step.Operation)
+				}
+				if step.Status != vmreconfig.StepFailed && step.Err != nil {
+					t.Errorf("step %d (%s) is %s but carries Err", i, step.Operation, step.Status)
+				}
+			}
+		})
+	}
+}

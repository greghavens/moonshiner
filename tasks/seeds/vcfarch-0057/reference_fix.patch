-// Architecture is the machine-readable VCF design returned by Build.
-// Implement the concrete JSON model required by the fixtures and schemas.
-type Architecture struct{}
+type Architecture struct {
+	SchemaVersion  int                    `json:"schemaVersion"`
+	Greenfield     GreenfieldArchitecture `json:"greenfield"`
+	ExistingEstate ExistingArchitecture   `json:"existingEstate"`
+}
+
+type GreenfieldArchitecture struct {
+	SddcSpec        SddcSpec             `json:"sddcSpec"`
+	Topology        Topology             `json:"topology"`
+	Capacity        CapacityAssessment   `json:"capacity"`
+	BillOfMaterials []BillOfMaterialItem `json:"billOfMaterials"`
+}
+
+type SddcSpec struct {
+	SddcID                      string            `json:"sddcId"`
+	WorkflowType                string            `json:"workflowType"`
+	HostSpecs                   []SddcHostSpec    `json:"hostSpecs"`
+	Version                     string            `json:"version"`
+	VcenterSpec                 VcenterSpec       `json:"vcenterSpec"`
+	ClusterSpec                 ClusterSpec       `json:"clusterSpec"`
+	DvsSpecs                    []DvsSpec         `json:"dvsSpecs"`
+	NsxtSpec                    NsxtSpec          `json:"nsxtSpec"`
+	NetworkSpecs                []NetworkSpec     `json:"networkSpecs"`
+	DnsSpec                     DnsSpec           `json:"dnsSpec"`
+	NtpServers                  []string          `json:"ntpServers"`
+	SddcManagerSpec             SddcManagerSpec   `json:"sddcManagerSpec"`
+	ManagementPoolName          string            `json:"managementPoolName"`
+	CeipEnabled                 bool              `json:"ceipEnabled"`
+	SkipEsxThumbprintValidation bool              `json:"skipEsxThumbprintValidation"`
+	SkipGatewayPingValidation   bool              `json:"skipGatewayPingValidation"`
+	DatastoreSpec               SddcDatastoreSpec `json:"datastoreSpec"`
+	VCFInstanceName             string            `json:"vcfInstanceName"`
+}
+
+type SddcHostSpec struct {
+	Hostname string `json:"hostname"`
+}
+
+type VcenterSpec struct {
+	VcenterHostname       string `json:"vcenterHostname"`
+	RootVcenterPassword   string `json:"rootVcenterPassword"`
+	VMSize                string `json:"vmSize"`
+	StorageSize           string `json:"storageSize"`
+	SSODomain             string `json:"ssoDomain"`
+	UseExistingDeployment bool   `json:"useExistingDeployment"`
+	Version               string `json:"version"`
+}
+
+type ClusterSpec struct {
+	DatacenterName string `json:"datacenterName"`
+	ClusterName    string `json:"clusterName"`
+}
+
+type DvsSpec struct {
+	DvsName         string          `json:"dvsName"`
+	Networks        []string        `json:"networks"`
+	MTU             int             `json:"mtu"`
+	VmnicsToUplinks []VmnicToUplink `json:"vmnicsToUplinks"`
+}
+
+type VmnicToUplink struct {
+	ID     string `json:"id"`
+	Uplink string `json:"uplink"`
+}
+
+type NsxtSpec struct {
+	NsxtManagers          []NsxtManagerSpec `json:"nsxtManagers"`
+	NsxtManagerSize       string            `json:"nsxtManagerSize"`
+	VIPFQDN               string            `json:"vipFqdn"`
+	TransportVLANID       int               `json:"transportVlanId"`
+	IPAddressPoolSpec     IPAddressPoolSpec `json:"ipAddressPoolSpec"`
+	UseExistingDeployment bool              `json:"useExistingDeployment"`
+	Version               string            `json:"version"`
+}
+
+type NsxtManagerSpec struct {
+	Hostname string `json:"hostname"`
+}
+
+type IPAddressPoolSpec struct {
+	Name        string `json:"name"`
+	Description string `json:"description"`
+}
+
+type NetworkSpec struct {
+	NetworkType            string    `json:"networkType"`
+	Subnet                 string    `json:"subnet"`
+	Gateway                string    `json:"gateway"`
+	IncludeIPAddressRanges []IPRange `json:"includeIpAddressRanges"`
+	VLANID                 int       `json:"vlanId"`
+	MTU                    int       `json:"mtu"`
+}
+
+type IPRange struct {
+	StartIPAddress string `json:"startIpAddress"`
+	EndIPAddress   string `json:"endIpAddress"`
+}
+
+type DnsSpec struct {

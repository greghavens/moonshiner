+
+func contains(values []string, wanted string) bool {
+	for _, value := range values {
+		if value == wanted {
+			return true
+		}
+	}
+	return false
+}
+
+func withHeadroom(value, percent int) int {
+	return int(math.Ceil(float64(value) * float64(100+percent) / 100))
+}
+
+func buildNumber(version string) (int64, error) {
+	_, suffix, ok := strings.Cut(version, "-")
+	if !ok || suffix == "" {
+		return 0, fmt.Errorf("version %q has no build suffix", version)
+	}
+	value, err := strconv.ParseInt(suffix, 10, 64)
+	if err != nil {
+		return 0, fmt.Errorf("version %q has invalid build suffix", version)
+	}
+	return value, nil
+}
+
+func cloneConvergence(value *Convergence) *Convergence {
+	if value == nil {
+		return nil
+	}
+	copy := *value
+	return &copy
 }

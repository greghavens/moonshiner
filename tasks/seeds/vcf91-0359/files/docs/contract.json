{
  "title": "VCF Automation 9.1 resource-action request contract",
  "contractRevision": "2026-08-16",
  "source": {
    "kind": "reference-documentation",
    "statement": "This contract is derived from the authoritative Broadcom xAPIs reference documentation. It is reference documentation, not a published VCF Automation specification; VCF Automation is not specified in vmware/vcf-api-specs."
  },
  "authentication": {
    "scheme": "bearerAuth",
    "header": "Authorization: Bearer <token>"
  },
  "mediaType": "application/json",
  "operations": [
    {
      "operation": "Submit Resource Action Request",
      "method": "POST",
      "pathTemplate": "/deployment/api/resources/{resourceId}/requests",
      "request": {
        "bodyType": "ResourceActionRequest",
        "fields": {
          "actionId": "string",
          "inputs": "object",
          "reason": "string"
        }
      },
      "success": {
        "statusCode": 200,
        "bodyType": "Request",
        "observedFields": {
          "id": "string request identifier",
          "actionId": "string action identifier",
          "status": "request execution status",
          "details": "optional string details"
        }
      }
    },
    {
      "operation": "Get Request",
      "method": "GET",
      "pathTemplate": "/deployment/api/requests/{requestId}",
      "success": {
        "statusCode": 200,
        "bodyType": "Request",
        "observedFields": {
          "id": "string request identifier",
          "actionId": "string action identifier",
          "status": "request execution status",
          "details": "optional string details"
        }
      }
    }
  ],
  "requestStatus": {
    "values": [
      "CREATED",
      "PENDING",
      "INITIALIZATION",
      "CHECKING_APPROVAL",
      "APPROVAL_PENDING",
      "USER_INTERACTION_PENDING",
      "INPROGRESS",
      "COMPLETION",
      "APPROVAL_REJECTED",
      "ABORTED",
      "SUCCESSFUL",
      "FAILED"
    ],
    "terminal": [
      "APPROVAL_REJECTED",
      "ABORTED",
      "SUCCESSFUL",
      "FAILED"
    ]
  }
}

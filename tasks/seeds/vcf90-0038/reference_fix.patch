diff --git a/VcfEvcGuard/VcfEvcGuard.psm1 b/VcfEvcGuard/VcfEvcGuard.psm1
index 75ee9a2..6fb9338 100644
--- a/VcfEvcGuard/VcfEvcGuard.psm1
+++ b/VcfEvcGuard/VcfEvcGuard.psm1
@@ -1,6 +1,171 @@
 Set-StrictMode -Version Latest
 $ErrorActionPreference = 'Stop'
 
+# Base path from the servers block of the vCenter automation specification:
+#   https://{host}/api
+$script:ApiBasePath = '/api'
+
+$script:TerminalTaskStatus = @('SUCCEEDED', 'FAILED')
+
+function ConvertTo-VcfEvcGuardRequestBody {
+    <#
+        Serialises a SetSpec. Properties whose value is $null are dropped, at
+        every level, so an optional property the caller never set is absent from
+        the wire rather than present and empty. Vcenter.Cluster.EvcMode.SetSpec
+        has exactly one optional property, so a spec that clears EVC serialises
+        to {}.
+    #>
+    param([hashtable] $Spec)
+
+    $clean = Remove-VcfEvcGuardNullValue -Value $Spec
+    if ($null -eq $clean) { return '{}' }
+    return (ConvertTo-Json -InputObject $clean -Depth 24 -Compress)
+}
+
+function Remove-VcfEvcGuardNullValue {
+    param($Value)
+
+    if ($null -eq $Value) { return $null }
+
+    if ($Value -is [System.Collections.IDictionary]) {
+        $result = [ordered]@{}
+        foreach ($key in $Value.Keys) {
+            $child = Remove-VcfEvcGuardNullValue -Value $Value[$key]
+            if ($null -ne $child) { $result[$key] = $child }
+        }
+        return $result
+    }
+
+    if ($Value -isnot [string] -and $Value -is [System.Collections.IEnumerable]) {
+        $items = @(foreach ($item in $Value) { Remove-VcfEvcGuardNullValue -Value $item })
+        return ,$items
+    }
+
+    return $Value
+}
+
+function Invoke-VcfEvcGuardRequest {
+    <#
+        One HTTP exchange against the connected vCenter. Query parameters are
+        supplied as an ordered dictionary and only the entries present are sent,
+        so an unset Cis.Tasks.GetSpec property never reaches the wire.
+    #>
+    param(
+        [Parameter(Mandatory)] [psobject] $Connection,
+        [Parameter(Mandatory)] [ValidateSet('GET', 'POST', 'PUT')] [string] $Method,
+        [Parameter(Mandatory)] [string] $Path,
+        [System.Collections.IDictionary] $Query,
+        [string] $Body,
+        [switch] $UseBasicAuthentication
+    )
+
+    $uri = $Connection.ServiceUri + $Path
+    if ($Query -and $Query.Count -gt 0) {
+        $pairs = foreach ($key in $Query.Keys) {
+            '{0}={1}' -f [VMware.Binding.OpenApi.Client.ClientUtils]::UrlEncode($key),
+                          [VMware.Binding.OpenApi.Client.ClientUtils]::UrlEncode([string]$Query[$key])
+        }
+        $uri = '{0}?{1}' -f $uri, ($pairs -join '&')
+    }
+
+    $headers = @{}
+    if ($UseBasicAuthentication) {
+        $plain = '{0}:{1}' -f $Connection.User, $Connection.Password
+        $headers['Authorization'] = 'Basic ' +
+            [VMware.Binding.OpenApi.Client.ClientUtils]::Base64Encode($plain)
+    }
+    else {
+        # api_key_auth: apiKey carried in the vmware-api-session-id header.
+        $headers['vmware-api-session-id'] = $Connection.SessionSecret
+    }
+
+    $arguments = @{
+        Uri     = $uri
+        Method  = $Method
+        Headers = $headers
+    }
+    if ($PSBoundParameters.ContainsKey('Body')) {
+        $arguments['Body'] = $Body
+        $arguments['ContentType'] = 'application/json'
+    }
+    if ($Connection.SkipCertificateCheck) {
+        $arguments['SkipCertificateCheck'] = $true
+    }
+
+    return Invoke-RestMethod @arguments
+}
+
+function Get-VcfEvcGuardClusterPath {
+    param([Parameter(Mandatory)] [string] $Cluster)
+    return '/vcenter/cluster/{0}/evc-mode' -f
+        [VMware.Binding.OpenApi.Client.ClientUtils]::UrlEncode($Cluster)
+}
+
+function Wait-VcfEvcGuardTask {
+    <#
+        Polls Cis.Tasks_get until the task reaches a terminal status.
+
+        $IncludeResult controls the Cis.Tasks.GetSpec that travels with the
+        request. The spec serialises it style=form explode=true, so its
+        properties are top-level query parameters; return_all is never set here
+        and therefore never appears.
+    #>
+    param(
+        [Parameter(Mandatory)] [psobject] $Connection,
+        [Parameter(Mandatory)] [string] $Task,
+        [Parameter(Mandatory)] [bool] $IncludeResult,
+        [Parameter(Mandatory)] [double] $PollIntervalSeconds,
+        [Parameter(Mandatory)] [double] $TimeoutSeconds
+    )
+
+    $query = [ordered]@{}
+    if (-not $IncludeResult) { $query['exclude_result'] = 'true' }
+
+    $path = '/cis/tasks/{0}' -f [VMware.Binding.OpenApi.Client.ClientUtils]::UrlEncode($Task)
+    $deadline = [datetime]::UtcNow.AddSeconds($TimeoutSeconds)
+
+    while ($true) {
+        $info = Invoke-VcfEvcGuardRequest -Connection $Connection -Method 'GET' `
+            -Path $path -Query $query
+
+        if ($script:TerminalTaskStatus -contains $info.status) { return $info }
+
+        if ([datetime]::UtcNow -ge $deadline) {
+            throw ("Task {0} was still {1} after {2} seconds." -f
+                $Task, $info.status, $TimeoutSeconds)
+        }
+        Start-Sleep -Seconds $PollIntervalSeconds
+    }
+}
+
+function Get-VcfEvcGuardTaskResultList {
+    <#
+        Cis.Task.Info.result is absent when the operation returned nothing. The
+        check-set task returns a list of Vcenter.Cluster.EvcMode.CheckResult,
+        and "no errors" is signalled by the property being missing.
+    #>
+    param([Parameter(Mandatory)] [psobject] $TaskInfo)
+
+    $property = $TaskInfo.PSObject.Properties['result']
+    if ($null -eq $property -or $null -eq $property.Value) { return @() }
+    return @($property.Value)
+}
+
+function Get-VcfEvcGuardEvcMode {
+    param(
+        [Parameter(Mandatory)] [psobject] $Connection,
+        [Parameter(Mandatory)] [string] $Cluster
+    )
+
+    $info = Invoke-VcfEvcGuardRequest -Connection $Connection -Method 'GET' `
+        -Path (Get-VcfEvcGuardClusterPath -Cluster $Cluster)
+
+    if ($null -eq $info) { return $null }
+    $property = $info.PSObject.Properties['evc_mode']
+    if ($null -eq $property) { return $null }
+    return $property.Value
+}
+
 <#
 .SYNOPSIS
     Opens a session against the vSphere Automation API of a VCF 9.0 vCenter.
@@ -32,7 +197,33 @@ function Connect-VcfEvcGuardServer {
         [switch] $IgnoreInvalidCertificate
     )
 
-    throw [System.NotImplementedException]::new('Connect-VcfEvcGuardServer is not implemented yet.')
+    $serviceUri = '{0}://{1}:{2}{3}' -f $Protocol, $Server, $Port, $script:ApiBasePath
+
+    # Carries the password only long enough to run Cis.Session_create; the
+    # session token authenticates everything afterwards.
+    $pending = [pscustomobject]@{
+        ServiceUri           = $serviceUri
+        User                 = $Credential.UserName
+        Password             = $Credential.GetNetworkCredential().Password
+        SessionSecret        = $null
+        SkipCertificateCheck = [bool] $IgnoreInvalidCertificate
+    }
+
+    # Cis.Session_create: POST /api/session, basic_auth, no request body.
+    $token = Invoke-VcfEvcGuardRequest -Connection $pending -Method 'POST' `
+        -Path '/session' -UseBasicAuthentication
+
+    if ([string]::IsNullOrWhiteSpace($token)) {
+        throw "Cis.Session_create returned no session token from $serviceUri."
+    }
+
+    return [pscustomobject]@{
+        ServiceUri           = $serviceUri
+        User                 = $Credential.UserName
+        SessionSecret        = [string] $token
+        IsConnected          = $true
+        SkipCertificateCheck = [bool] $IgnoreInvalidCertificate
+    }
 }
 
 <#
@@ -64,7 +255,76 @@ function Invoke-VcfEvcModeGuardedSet {
         [double] $TimeoutSeconds = 300
     )
 
-    throw [System.NotImplementedException]::new('Invoke-VcfEvcModeGuardedSet is not implemented yet.')
+    $clusterPath = Get-VcfEvcGuardClusterPath -Cluster $Cluster
+
+    # Vcenter.Cluster.EvcMode.SetSpec. evc_mode is the sole, optional property:
+    # leaving it out is what asks vCenter to clear the cluster's EVC mode.
+    $setSpec = @{}
+    if ($PSBoundParameters.ContainsKey('EvcMode') -and $null -ne $EvcMode) {
+        $setSpec['evc_mode'] = $EvcMode
+    }
+    $body = ConvertTo-VcfEvcGuardRequestBody -Spec $setSpec
+
+    $outcome = [ordered]@{
+        Cluster       = $Cluster
+        Applied       = $false
+        CheckTask     = $null
+        CheckStatus   = $null
+        CheckResults  = @()
+        SetTask       = $null
+        SetStatus     = $null
+        EvcModeBefore = $null
+        EvcModeAfter  = $null
+        BlockedReason = $null
+    }
+
+    # 1. Vcenter.Cluster.EvcMode_get
+    $outcome['EvcModeBefore'] = Get-VcfEvcGuardEvcMode -Connection $Connection -Cluster $Cluster
+
+    # 2. Vcenter.Cluster.EvcMode_checkSet$Task
+    $checkTask = Invoke-VcfEvcGuardRequest -Connection $Connection -Method 'POST' `
+        -Path $clusterPath `
+        -Query ([ordered]@{ 'action' = 'check-set'; 'vmw-task' = 'true' }) `
+        -Body $body
+    $outcome['CheckTask'] = [string] $checkTask
+
+    # 3. Poll it. The gate reads this task's result, so no GetSpec is sent.
+    $checkInfo = Wait-VcfEvcGuardTask -Connection $Connection -Task $outcome['CheckTask'] `
+        -IncludeResult $true -PollIntervalSeconds $PollIntervalSeconds `
+        -TimeoutSeconds $TimeoutSeconds
+    $outcome['CheckStatus'] = [string] $checkInfo.status
+
+    # 4. The gate.
+    if ($outcome['CheckStatus'] -ne 'SUCCEEDED') {
+        $outcome['BlockedReason'] = 'PRECHECK_TASK_FAILED'
+        return [pscustomobject] $outcome
+    }
+
+    $findings = @(Get-VcfEvcGuardTaskResultList -TaskInfo $checkInfo)
+    if ($findings.Count -gt 0) {
+        $outcome['CheckResults'] = $findings
+        $outcome['BlockedReason'] = 'PRECHECK_ERRORS'
+        return [pscustomobject] $outcome
+    }
+
+    # 5. Vcenter.Cluster.EvcMode_set$Task, with the spec that was checked.
+    $setTask = Invoke-VcfEvcGuardRequest -Connection $Connection -Method 'PUT' `
+        -Path $clusterPath `
+        -Query ([ordered]@{ 'vmw-task' = 'true' }) `
+        -Body $body
+    $outcome['SetTask'] = [string] $setTask
+
+    # 6. Poll it. Nothing reads this result, so ask for it to be excluded.
+    $setInfo = Wait-VcfEvcGuardTask -Connection $Connection -Task $outcome['SetTask'] `
+        -IncludeResult $false -PollIntervalSeconds $PollIntervalSeconds `
+        -TimeoutSeconds $TimeoutSeconds
+    $outcome['SetStatus'] = [string] $setInfo.status
+    $outcome['Applied'] = ($outcome['SetStatus'] -eq 'SUCCEEDED')
+
+    # 7. Read the cluster back.
+    $outcome['EvcModeAfter'] = Get-VcfEvcGuardEvcMode -Connection $Connection -Cluster $Cluster
+
+    return [pscustomobject] $outcome
 }
 
 Export-ModuleMember -Function Connect-VcfEvcGuardServer, Invoke-VcfEvcModeGuardedSet

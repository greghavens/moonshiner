{
  "contract_version": "1.0.0",
  "product": "VMware Cloud Foundation Operations for Networks",
  "vcf_release": "9.1",
  "spec_info_version": "9.1.0.0",
  "base_path": "/api/ni",
  "provenance": "docs/official_sources.json",

  "wire_rules": {
    "content_type": "application/json",
    "encoding": "utf-8",
    "additional_properties_allowed": false,
    "null_values_allowed": false,
    "empty_optional_containers_allowed": false,
    "explanation": [
      "A property that the caller did not set MUST be absent from the JSON body.",
      "Sending \"domain\": null, \"member_list\": {}, or \"source_group_entity_id\": [] instead of omitting the key is a contract violation.",
      "Properties not listed for an operation MUST NOT appear in the body."
    ]
  },

  "auth_modes": {
    "ApiKeyAuth": {
      "description": "Native VCF Operations for Networks session token obtained from operationId 'create'.",
      "header": "Authorization",
      "value_format": "NetworkInsight {token}"
    },
    "OpsTokenAuth": {
      "description": "VCF Operations JWT access token issued outside this module (for example by Connect-VcfOpsServer from VMware.Sdk.Vcf.Ops). No 'create' call is performed in this mode, and there is no session for 'delete' to revoke.",
      "header": "Authorization",
      "value_format": "Bearer {token}"
    }
  },

  "operations": [
    {
      "operationId": "create",
      "method": "POST",
      "path": "/auth/token",
      "requires_auth_header": false,
      "success_status": 200,
      "request_body": {
        "schema": "UserCredential",
        "required": ["username", "password"],
        "optional": ["domain"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string" },
          "domain": {
            "type": "object",
            "required": [],
            "optional": ["domain_type", "value"],
            "properties": {
              "domain_type": { "type": "string", "enum": ["LDAP", "LOCAL"] },
              "value": { "type": "string" }
            }
          }
        }
      },
      "response_body": {
        "schema": "Token",
        "properties": {
          "token": { "type": "string" },
          "expiry": { "type": "integer" }
        }
      }
    },

    {
      "operationId": "delete",
      "method": "DELETE",
      "path": "/auth/token",
      "requires_auth_header": true,
      "auth_modes": ["ApiKeyAuth"],
      "success_status": 204,
      "request_body": null,
      "response_body": null
    },

    {
      "operationId": "addApplication",
      "method": "POST",
      "path": "/groups/applications",
      "requires_auth_header": true,
      "success_status": 201,
      "request_body": {
        "schema": "ApplicationRequest",
        "required": ["name"],
        "optional": [],
        "properties": {
          "name": { "type": "string" }
        }
      },
      "response_body": {
        "schema": "Application",
        "properties": {
          "entity_id": { "type": "string" },
          "name": { "type": "string" },
          "entity_type": { "type": "string" },
          "create_time": { "type": "integer" },
          "created_by": { "type": "string" }
        }
      }
    },

    {
      "operationId": "addTier",
      "method": "POST",
      "path": "/groups/applications/{id}/tiers",
      "path_parameters": ["id"],
      "requires_auth_header": true,
      "success_status": 201,
      "request_body": {
        "schema": "TierRequest",
        "required": ["name"],
        "optional": ["group_membership_criteria", "source_group_entity_id"],
        "unsupported_by_this_client": ["entity_id", "member_list"],
        "properties": {
          "name": { "type": "string" },
          "source_group_entity_id": { "type": "array", "items": { "type": "string" } },
          "group_membership_criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "schema": "GroupMembershipCriteria",
              "required": ["membership_type"],
              "optional": ["search_membership_criteria", "ip_address_membership_criteria"],
              "rule": "Exactly one of search_membership_criteria / ip_address_membership_criteria is present, and it MUST be the one matching membership_type. The non-matching key MUST be absent.",
              "properties": {
                "membership_type": {
                  "type": "string",
                  "enum": ["SearchMembershipCriteria", "IPAddressMembershipCriteria"]
                },
                "search_membership_criteria": {
                  "type": "object",
                  "schema": "SearchMembershipCriteria",
                  "required": ["entity_type", "filter"],
                  "optional": [],
                  "properties": {
                    "entity_type": { "type": "string", "const": "VirtualMachine" },
                    "filter": { "type": "string" }
                  }
                },
                "ip_address_membership_criteria": {
                  "type": "object",
                  "schema": "IpAddressMembershipCriteria",
                  "required": ["ip_addresses"],
                  "optional": [],
                  "properties": {
                    "ip_addresses": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          }
        }
      },
      "response_body": {
        "schema": "Tier",
        "properties": {
          "entity_id": { "type": "string" },
          "name": { "type": "string" },
          "entity_type": { "type": "string" }
        }
      },
      "error_body": {
        "schema": "ApiError",
        "properties": {
          "code": { "type": "integer" },
          "message": { "type": "string" }
        }
      }
    },

    {
      "operationId": "listApplicationTiers",
      "method": "GET",
      "path": "/groups/applications/{id}/tiers",
      "path_parameters": ["id"],
      "requires_auth_header": true,
      "success_status": 200,
      "request_body": null,
      "response_body": {
        "schema": "TierListResponse",
        "properties": {
          "results": { "type": "array", "items": { "schema": "Tier" } }
        }
      }
    }
  ]
}

+# ---------------------------------------------------------------------------
+# Private helpers
+# ---------------------------------------------------------------------------
+
+function ConvertTo-NiJson {
+    <#
+        Serialises a body that was assembled key by key. -Depth is generous
+        because tier membership criteria nest three levels deep.
+    #>
+    param([Parameter(Mandatory)] $Body)
+
+    return ConvertTo-Json -InputObject $Body -Depth 12 -Compress
+}
+
+function Invoke-NiRequest {
+    <#
+        One HTTP round trip against the appliance. Returns the status code and
+        the decoded payload without throwing on 4xx/5xx: whether a non-success
+        response is fatal is the caller's decision, not the transport's.
+    #>
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)] $Connection,
+        [Parameter(Mandatory)] [string] $Method,
+        [Parameter(Mandatory)] [string] $Path,
+        $Body,
+        [switch] $Anonymous
+    )
+
+    $params = @{
+        Uri                  = $Connection.BaseUri + $Path
+        Method               = $Method
+        SkipHttpErrorCheck   = $true
+        MaximumRedirection   = 0
+        ErrorAction          = 'Stop'
+    }
+
+    if (-not $Anonymous) {
+        $params['Headers'] = @{ 'Authorization' = $Connection.Authorization }
+    }
+
+    if ($Connection.SkipCertificateCheck) {
+        $params['SkipCertificateCheck'] = $true
+    }
+
+    if ($null -ne $Body) {
+        $params['ContentType'] = 'application/json'
+        $params['Body'] = [System.Text.Encoding]::UTF8.GetBytes((ConvertTo-NiJson -Body $Body))
+    }
+
+    $response = Invoke-WebRequest @params
+
+    $payload = $null
+    $text = [string]$response.Content
+    if (-not [string]::IsNullOrWhiteSpace($text)) {
+        try { $payload = $text | ConvertFrom-Json -ErrorAction Stop } catch { $payload = $null }
+    }
+
+    return [pscustomobject]@{
+        StatusCode = [int] $response.StatusCode
+        Payload    = $payload
+        RawBody    = $text
+    }
+}
+
+function Get-NiErrorMessage {
+    <#
+        Pull the appliance's own wording out of an ApiError body so the operator
+        sees what the appliance said, not something we invented for it.
+    #>
+    param([Parameter(Mandatory)] $Response)
+
+    if ($null -ne $Response.Payload -and
+        ($Response.Payload.PSObject.Properties.Name -contains 'message')) {
+        return [string] $Response.Payload.message
+    }
+
+    if (-not [string]::IsNullOrWhiteSpace($Response.RawBody)) {
+        return $Response.RawBody.Trim()
+    }
+
+    return "HTTP $($Response.StatusCode)"
+}
+
+function New-NiTierBody {
+    <#
+        TierRequest for one -Tier hashtable. Optional keys are added only when
+        the caller supplied a non-empty value; member_list and entity_id are
+        never sent by this client.
+    #>
+    param([Parameter(Mandatory)] [hashtable] $Definition)
+
+    if (-not $Definition.ContainsKey('Name') -or [string]::IsNullOrWhiteSpace([string]$Definition['Name'])) {
+        throw [System.ArgumentException]::new('Each -Tier entry requires a non-empty Name.')
+    }
+
+    $body = [ordered]@{ name = [string] $Definition['Name'] }
+
+    $criteria = @()
+
+    if ($Definition.ContainsKey('SearchFilter') -and -not [string]::IsNullOrWhiteSpace([string]$Definition['SearchFilter'])) {
+        $criteria += [ordered]@{
+            membership_type            = 'SearchMembershipCriteria'
+            search_membership_criteria = [ordered]@{
+                entity_type = 'VirtualMachine'
+                filter      = [string] $Definition['SearchFilter']
+            }
+        }
+    }
+
+    if ($Definition.ContainsKey('IpAddresses')) {
+        $addresses = @($Definition['IpAddresses'] | Where-Object { -not [string]::IsNullOrWhiteSpace([string]$_) })
+        if ($addresses.Count -gt 0) {
+            $criteria += [ordered]@{
+                membership_type                = 'IPAddressMembershipCriteria'
+                ip_address_membership_criteria = [ordered]@{
+                    ip_addresses = @([string[]] $addresses)
+                }
+            }
+        }
+    }
+
+    if ($criteria.Count -gt 0) {
+        $body['group_membership_criteria'] = @($criteria)
+    }
+
+    if ($Definition.ContainsKey('SourceGroupEntityId')) {
+        $sources = @($Definition['SourceGroupEntityId'] | Where-Object { -not [string]::IsNullOrWhiteSpace([string]$_) })
+        if ($sources.Count -gt 0) {
+            $body['source_group_entity_id'] = @([string[]] $sources)
+        }
+    }
+
+    return $body
+}
+
+function New-NiStep {
+    param(
+        [Parameter(Mandatory)] [int] $Index,
+        [Parameter(Mandatory)] [string] $Operation,
+        [Parameter(Mandatory)] [string] $Target,
+        [Parameter(Mandatory)] [string] $Status,
+        [string] $EntityId
+    )
+
+    return [pscustomobject]@{
+        Index     = $Index
+        Operation = $Operation
+        Target    = $Target
+        Status    = $Status
+        EntityId  = if ([string]::IsNullOrEmpty($EntityId)) { $null } else { $EntityId }
+    }
+}

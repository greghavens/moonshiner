+++ b/.reference_solution.py
@@ -0,0 +1,88 @@
+#!/usr/bin/env python3
+"""Reference execution using the genuine sandboxed support command."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "support_desk.py"
+RUNTIME = ROOT / ".support-runtime"
+TARGET_NAME = "Crushed Carton Follow-up"
+TARGET_LOCATION = "Acme"
+
+
+def invoke(arguments: list[str]) -> dict[str, object]:
+    completed = subprocess.run(
+        [sys.executable, str(CLIENT), *arguments],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    return json.loads(completed.stdout)
+
+
+def get_stage(stable_id: str) -> int:
+    print(
+        json.dumps(
+            invoke(["get", "--id", stable_id]),
+            ensure_ascii=False,
+            separators=(",", ":"),
+        )
+    )
+    return 0
+
+
+def orchestrate() -> int:
+    if RUNTIME.exists():
+        shutil.rmtree(RUNTIME)
+
+    search = invoke(
+        [
+            "search",
+            "--name",
+            TARGET_NAME,
+            "--location",
+            TARGET_LOCATION,
+        ]
+    )
+    matches = search.get("matches")
+    if search.get("count") != 1 or not isinstance(matches, list) or len(matches) != 1:
+        raise RuntimeError("reference search did not resolve uniquely")
+    stable_id = str(matches[0]["id"])
+
+    retrieved = subprocess.run(
+        [sys.executable, str(Path(__file__).resolve()), "get-stage", stable_id],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    record = json.loads(retrieved.stdout)
+    report = (
+        "# Case details\n"
+        f"- Name: {record['name']}\n"
+        f"- Location: {record['location']}\n"
+        f"- Stable ID: {record['id']}\n"
+        f"- Status: {record['status']}\n"
+        f"- Date: {record['date']}\n"
+        f"- Priority: {record['priority']}\n"
+        f"- Owner: {record['owner']}\n"
+        f"- Summary: {record['summary']}\n"
+    )
+    (ROOT / "case-report.md").write_text(report, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    if len(sys.argv) == 1:
+        raise SystemExit(orchestrate())
+    if len(sys.argv) == 3 and sys.argv[1] == "get-stage":
+        raise SystemExit(get_stage(sys.argv[2]))
+    raise SystemExit("invalid reference execution")

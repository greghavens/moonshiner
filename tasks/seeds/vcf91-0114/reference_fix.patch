 // NewClient validates configuration without performing network I/O.
-func NewClient(Config) (*Client, error) {
-	return nil, ErrNotImplemented
+func NewClient(config Config) (*Client, error) {
+	parsed, err := url.Parse(config.BaseURL)
+	if err != nil {
+		return nil, invalid("BaseURL", "must be an HTTP(S) origin")
+	}
+	scheme := strings.ToLower(parsed.Scheme)
+	if (scheme != "http" && scheme != "https") ||
+		parsed.Host == "" ||
+		parsed.Hostname() == "" ||
+		parsed.User != nil ||
+		parsed.Opaque != "" ||
+		(parsed.Path != "" && parsed.Path != "/") ||
+		(parsed.EscapedPath() != "" && parsed.EscapedPath() != "/") ||
+		parsed.RawQuery != "" ||
+		parsed.ForceQuery ||
+		parsed.Fragment != "" {
+		return nil, invalid("BaseURL", "must be an HTTP(S) origin")
+	}
+	origin := scheme + "://" + parsed.Host
+	if _, err := http.NewRequest(http.MethodGet, origin, nil); err != nil {
+		return nil, invalid("BaseURL", "must be an HTTP(S) origin")
+	}
+	if !headerSafe(config.SessionToken) {
+		return nil, invalid("SessionToken", "must be nonblank and safe for an HTTP header")
+	}
+	selected := config.HTTPClient
+	if selected == nil {
+		selected = http.DefaultClient
+	}
+	httpClient := *selected
+	httpClient.CheckRedirect = func(*http.Request, []*http.Request) error {
+		return http.ErrUseLastResponse
+	}
+	return &Client{
+		baseURL:      origin,
+		sessionToken: config.SessionToken,
+		httpClient:   &httpClient,
+	}, nil
+}
+
+func invalid(field, reason string) error {
+	return &ValidationError{Field: field, Reason: reason}
+}
+
+func headerSafe(value string) bool {
+	if value == "" || strings.TrimSpace(value) == "" || strings.TrimSpace(value) != value {
+		return false
+	}
+	for _, character := range value {
+		if character < 0x20 || character == 0x7f {
+			return false
+		}
+	}
+	return true
 }
 
 // SetCPUCountIfPoweredOff reads power state and updates count only when the
 // observed state is exactly POWERED_OFF.
 func (c *Client) SetCPUCountIfPoweredOff(
-	context.Context,
-	string,
-	int64,
+	ctx context.Context,
+	vm string,
+	cpuCount int64,
 ) (CPUUpdateResult, error) {
-	return CPUUpdateResult{}, ErrNotImplemented
+	if ctx == nil {
+		return CPUUpdateResult{}, invalid("context", "must not be nil")
+	}
+	if strings.TrimSpace(vm) == "" {
+		return CPUUpdateResult{}, invalid("vm", "must be nonblank")
+	}
+	if cpuCount <= 0 {
+		return CPUUpdateResult{}, invalid("cpuCount", "must be positive")
+	}
+	if err := ctx.Err(); err != nil {
+		return CPUUpdateResult{}, err
+	}
+
+	escapedVM := url.PathEscape(vm)
+	powerPath := "/api/vcenter/vm/" + escapedVM + "/power"
+	powerBody, err := c.request(
+		ctx,
+		PowerGetOperation,
+		http.MethodGet,
+		powerPath,
+		nil,
+		http.StatusOK,
+	)
+	if err != nil {
+		return CPUUpdateResult{}, err
+	}
+	state, err := decodePowerInfo(powerBody)
+	if err != nil {
+		return CPUUpdateResult{}, &ProtocolError{
+			OperationID: PowerGetOperation,
+			Reason:      "malformed power information",
+		}
+	}
+	if state != "POWERED_OFF" {
+		return CPUUpdateResult{}, &PrecheckError{
+			VM:            vm,
+			ObservedState: state,
+		}
+	}
+
+	updateBody := []byte(`{"count":` + strconv.FormatInt(cpuCount, 10) + `}`)
+	updatePath := "/api/vcenter/vm/" + escapedVM + "/hardware/cpu"

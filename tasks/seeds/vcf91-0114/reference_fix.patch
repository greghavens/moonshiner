+
+func (c *Client) request(
+	ctx context.Context,
+	operationID string,
+	method string,
+	path string,
+	body []byte,
+	successStatus int,
+) ([]byte, error) {
+	var reader io.Reader
+	if body != nil {
+		reader = bytes.NewReader(body)
+	}
+	request, err := http.NewRequestWithContext(ctx, method, c.baseURL+path, reader)
+	if err != nil {
+		return nil, &TransportError{OperationID: operationID}
+	}
+	request.Header["Accept"] = []string{"application/json"}
+	request.Header["Vmware-Api-Session-Id"] = []string{c.sessionToken}
+	if body != nil {
+		request.Header["Content-Type"] = []string{"application/json"}
+	}
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		if response != nil && response.Body != nil {
+			_ = response.Body.Close()
+		}
+		return nil, transportFailure(operationID, ctx)
+	}
+	responseBody, readErr := readResponse(response)
+	if readErr != nil {
+		return nil, transportFailure(operationID, ctx)
+	}
+	if len(responseBody) > maxResponseBytes {
+		return nil, &ProtocolError{
+			OperationID: operationID,
+			Reason:      "response exceeded size limit",
+		}
+	}
+	if response.StatusCode != successStatus {
+		return nil, decodeAPIError(operationID, response.StatusCode, responseBody)
+	}
+	return responseBody, nil
+}
+
+func transportFailure(operationID string, ctx context.Context) error {
+	var cause error
+	if ctx != nil {
+		cause = ctx.Err()
+	}
+	return &TransportError{OperationID: operationID, cause: cause}
+}
+
+func readResponse(response *http.Response) ([]byte, error) {
+	defer response.Body.Close()
+	return io.ReadAll(io.LimitReader(response.Body, maxResponseBytes+1))
+}
+
+func decodePowerInfo(body []byte) (string, error) {
+	object, err := decodeObject(body)
+	if err != nil {
+		return "", err
+	}
+	stateJSON, ok := object["state"]
+	if !ok {
+		return "", errors.New("state is missing")
+	}
+	var state string
+	if err := json.Unmarshal(stateJSON, &state); err != nil {
+		return "", errors.New("state is not a string")
+	}
+	switch state {
+	case "POWERED_OFF", "POWERED_ON", "SUSPENDED":
+	default:
+		return "", errors.New("state is outside the contract enum")
+	}
+	if cleanJSON, ok := object["clean_power_off"]; ok {
+		var clean bool
+		if bytes.Equal(bytes.TrimSpace(cleanJSON), []byte("null")) ||
+			json.Unmarshal(cleanJSON, &clean) != nil {
+			return "", errors.New("clean_power_off is not a boolean")
+		}
+	}
+	return state, nil
+}
+
+func decodeAPIError(operationID string, statusCode int, body []byte) error {
+	object, err := decodeObject(body)
+	if err != nil {
+		return malformedError(operationID)
+	}
+	errorTypeJSON, ok := object["error_type"]
+	if !ok {
+		return malformedError(operationID)
+	}
+	var errorType string
+	if json.Unmarshal(errorTypeJSON, &errorType) != nil || strings.TrimSpace(errorType) == "" {
+		return malformedError(operationID)
+	}
+	messagesJSON, ok := object["messages"]
+	if !ok {
+		return malformedError(operationID)
+	}
+	var rawMessages []json.RawMessage
+	if json.Unmarshal(messagesJSON, &rawMessages) != nil || len(rawMessages) == 0 {
+		return malformedError(operationID)
+	}
+	messages := make([]LocalizableMessage, 0, len(rawMessages))
+	for _, rawMessage := range rawMessages {
+		messageObject, err := decodeObject(rawMessage)
+		if err != nil {
+			return malformedError(operationID)
+		}
+		idJSON, hasID := messageObject["id"]
+		defaultJSON, hasDefault := messageObject["default_message"]
+		if !hasID || !hasDefault ||
+			bytes.Equal(bytes.TrimSpace(idJSON), []byte("null")) ||
+			bytes.Equal(bytes.TrimSpace(defaultJSON), []byte("null")) {
+			return malformedError(operationID)
+		}
+		var message LocalizableMessage
+		if json.Unmarshal(idJSON, &message.ID) != nil ||
+			json.Unmarshal(defaultJSON, &message.DefaultMessage) != nil {
+			return malformedError(operationID)
+		}
+		messages = append(messages, message)
+	}
+	return &APIError{
+		OperationID: operationID,
+		StatusCode:  statusCode,
+		ErrorType:   errorType,
+		Messages:    messages,
+	}
+}
+
+func malformedError(operationID string) error {
+	return &ProtocolError{
+		OperationID: operationID,
+		Reason:      "malformed vAPI error response",
+	}
+}
+
+func decodeObject(body []byte) (map[string]json.RawMessage, error) {
+	decoder := json.NewDecoder(bytes.NewReader(body))
+	var object map[string]json.RawMessage
+	if err := decoder.Decode(&object); err != nil || object == nil {
+		return nil, errors.New("response is not a JSON object")
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); !errors.Is(err, io.EOF) {
+		return nil, errors.New("response contains trailing data")
+	}
+	return object, nil
 }

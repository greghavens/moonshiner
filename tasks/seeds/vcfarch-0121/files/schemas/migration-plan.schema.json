{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfplan:migration-plan:1.0",
  "title": "VCF brownfield workload-domain migration architecture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "designType",
    "estateId",
    "fleet",
    "managementDomainImpact",
    "targetSddcSpec",
    "components",
    "gates",
    "steps"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "designType": {"const": "brownfield"},
    "estateId": {"type": "string", "minLength": 1},
    "fleet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "currentVersion", "targetVersion"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "currentVersion": {"type": "string", "minLength": 1},
        "targetVersion": {"type": "string", "minLength": 1}
      }
    },
    "managementDomainImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "managementDomainId"],
      "properties": {
        "change": {"const": "none"},
        "managementDomainId": {"type": "string", "minLength": 1}
      }
    },
    "targetSddcSpec": {"type": "object", "minProperties": 1},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/componentPlan"}
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gate"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "versionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "build"],
      "properties": {
        "product": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "build": {"type": "string", "minLength": 1}
      }
    },
    "componentPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "source", "target", "disposition", "via", "gates"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/versionRef"},
        "target": {"$ref": "#/$defs/versionRef"},
        "disposition": {
          "enum": [
            "upgrade-after-import",
            "rolling-upgrade",
            "upgrade-with-esx-then-format",
            "converge-then-upgrade"
          ]
        },
        "via": {
          "type": "array",
          "items": {"$ref": "#/$defs/versionRef"}
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "condition", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "condition": {"type": "string", "minLength": 12},
        "evidence": {"type": "string", "minLength": 8}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "id", "operation", "scope", "componentIds", "gates", "dependsOn"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "id": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1},
        "scope": {"enum": ["workload-domain", "fleet-registration"]},
        "componentIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

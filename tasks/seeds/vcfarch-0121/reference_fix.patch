 // Build creates a deterministic brownfield convergence architecture from the
 // supplied estate and pinned compatibility snapshot.
-func Build(_ Inventory, _ Snapshot) (Plan, error) {
-	return Plan{}, ErrNotImplemented
+func Build(inventory Inventory, snapshot Snapshot) (Plan, error) {
+	if inventory.EstateID == "" || inventory.DesiredDomain == "" || inventory.Fleet.ID == "" {
+		return Plan{}, fmt.Errorf("inventory identity is incomplete")
+	}
+	if !inventory.Fleet.ManagementDomain.Immutable {
+		return Plan{}, fmt.Errorf("management domain %q is not protected", inventory.Fleet.ManagementDomain.ID)
+	}
+	if inventory.Fleet.Version != snapshot.TargetVCF {
+		return Plan{}, fmt.Errorf("fleet %s is at %s, not pinned target %s", inventory.Fleet.ID, inventory.Fleet.Version, snapshot.TargetVCF)
+	}
+
+	targets := make(map[string]TargetRule, len(snapshot.Targets))
+	for _, target := range snapshot.Targets {
+		if target.Kind == "" || target.Product == "" || target.Version == "" || target.Build == "" {
+			return Plan{}, fmt.Errorf("incomplete target for kind %q", target.Kind)
+		}
+		if _, exists := targets[target.Kind]; exists {
+			return Plan{}, fmt.Errorf("duplicate target for kind %q", target.Kind)
+		}
+		targets[target.Kind] = target
+	}
+
+	type transitionKey struct{ kind, version, build string }
+	transitions := make(map[transitionKey]TransitionRule, len(snapshot.Transitions))
+	for _, transition := range snapshot.Transitions {
+		key := transitionKey{transition.Kind, transition.FromVersion, transition.FromBuild}
+		if _, exists := transitions[key]; exists {
+			return Plan{}, fmt.Errorf("duplicate transition for %s %s build %s", key.kind, key.version, key.build)
+		}
+		transitions[key] = transition
+	}
+
+	gateIDs := make(map[string]struct{}, len(snapshot.Gates))
+	gates := make([]Gate, 0, len(snapshot.Gates))
+	for _, gate := range snapshot.Gates {
+		if gate.ID == "" || gate.Condition == "" || gate.Evidence == "" {
+			return Plan{}, fmt.Errorf("incomplete gate %q", gate.ID)
+		}
+		if _, exists := gateIDs[gate.ID]; exists {
+			return Plan{}, fmt.Errorf("duplicate gate %q", gate.ID)
+		}
+		gateIDs[gate.ID] = struct{}{}
+		gates = append(gates, Gate(gate))
+	}
+	sort.Slice(gates, func(i, j int) bool { return gates[i].ID < gates[j].ID })
+
+	seenComponents := make(map[string]struct{}, len(inventory.Components))
+	components := make([]ComponentPlan, 0, len(inventory.Components))
+	for _, component := range inventory.Components {
+		if component.ID == "" || component.Kind == "" || component.Name == "" || component.Version == "" || component.Build == "" {
+			return Plan{}, fmt.Errorf("incomplete component %q", component.ID)
+		}
+		if _, exists := seenComponents[component.ID]; exists {
+			return Plan{}, fmt.Errorf("duplicate component %q", component.ID)
+		}
+		seenComponents[component.ID] = struct{}{}
+		target, ok := targets[component.Kind]
+		if !ok {
+			return Plan{}, fmt.Errorf("no pinned target for %s", component.Kind)
+		}
+		transition, ok := transitions[transitionKey{component.Kind, component.Version, component.Build}]
+		if !ok {
+			return Plan{}, fmt.Errorf("no supported transition for %s at %s build %s", component.ID, component.Version, component.Build)
+		}
+		if transition.Disposition == "" {
+			return Plan{}, fmt.Errorf("transition for %s has no disposition", component.ID)
+		}
+		if err := requireKnownGates(transition.RequiredGates, gateIDs, "component "+component.ID); err != nil {
+			return Plan{}, err
+		}
+		components = append(components, ComponentPlan{
+			ID:          component.ID,
+			Kind:        component.Kind,
+			Name:        component.Name,
+			Source:      VersionRef{Version: component.Version, Build: component.Build},
+			Target:      VersionRef{Product: target.Product, Version: target.Version, Build: target.Build},
+			Disposition: transition.Disposition,
+			Via:         append([]VersionRef{}, transition.Via...),
+			Gates:       append([]string{}, transition.RequiredGates...),
+		})
+	}
+	sort.Slice(components, func(i, j int) bool { return components[i].ID < components[j].ID })
+
+	steps, err := buildSteps(components, snapshot.Operations, gateIDs)
+	if err != nil {
+		return Plan{}, err
+	}
+	if err := validateOrderRules(steps, snapshot.OrderRules); err != nil {
+		return Plan{}, err
+	}
+	spec, err := buildInstallerSpec(inventory, targets, snapshot.TargetVCF)
+	if err != nil {
+		return Plan{}, err
+	}
+
+	return Plan{
+		SchemaVersion: "1.0",
+		DesignType:    "brownfield",
+		EstateID:      inventory.EstateID,
+		Fleet: FleetPlan{
+			ID:             inventory.Fleet.ID,
+			CurrentVersion: inventory.Fleet.Version,
+			TargetVersion:  inventory.Fleet.Version,
+		},
+		ManagementDomainImpact: Impact{
+			Change:             "none",
+			ManagementDomainID: inventory.Fleet.ManagementDomain.ID,
+		},
+		TargetSddcSpec: spec,
+		Components:     components,
+		Gates:          gates,
+		Steps:          steps,
+	}, nil
+}
+
+func requireKnownGates(required []string, known map[string]struct{}, owner string) error {
+	if len(required) == 0 {
+		return fmt.Errorf("%s has no gates", owner)
+	}
+	seen := make(map[string]struct{}, len(required))
+	for _, gate := range required {
+		if _, ok := known[gate]; !ok {
+			return fmt.Errorf("%s refers to unknown gate %q", owner, gate)
+		}
+		if _, ok := seen[gate]; ok {
+			return fmt.Errorf("%s repeats gate %q", owner, gate)
+		}
+		seen[gate] = struct{}{}
+	}
+	return nil
+}
+
+func buildSteps(components []ComponentPlan, operations []OperationRule, gateIDs map[string]struct{}) ([]Step, error) {
+	steps := make([]Step, 0, len(operations))
+	seenIDs := make(map[string]struct{}, len(operations))
+	seenOperations := make(map[string]struct{}, len(operations))
+	seenOrders := make(map[int]struct{}, len(operations))
+	for _, operation := range operations {
+		if operation.Order < 1 || operation.ID == "" || operation.Operation == "" {
+			return nil, fmt.Errorf("incomplete operation %q", operation.ID)
+		}
+		if operation.Scope != "workload-domain" && operation.Scope != "fleet-registration" {
+			return nil, fmt.Errorf("operation %s has forbidden scope %q", operation.ID, operation.Scope)
+		}
+		if _, ok := seenIDs[operation.ID]; ok {
+			return nil, fmt.Errorf("duplicate operation id %q", operation.ID)
+		}
+		if _, ok := seenOperations[operation.Operation]; ok {
+			return nil, fmt.Errorf("duplicate operation %q", operation.Operation)
+		}
+		if _, ok := seenOrders[operation.Order]; ok {
+			return nil, fmt.Errorf("duplicate operation order %d", operation.Order)
+		}
+		seenIDs[operation.ID] = struct{}{}
+		seenOperations[operation.Operation] = struct{}{}
+		seenOrders[operation.Order] = struct{}{}
+		if err := requireKnownGates(operation.RequiredGates, gateIDs, "operation "+operation.ID); err != nil {
+			return nil, err
+		}
+
+		kinds := make(map[string]struct{}, len(operation.ComponentKinds))
+		for _, kind := range operation.ComponentKinds {
+			kinds[kind] = struct{}{}
+		}
+		componentIDs := make([]string, 0)
+		for _, component := range components {
+			if _, ok := kinds[component.Kind]; ok {
+				componentIDs = append(componentIDs, component.ID)
+			}
+		}
+		steps = append(steps, Step{
+			Order:        operation.Order,
+			ID:           operation.ID,
+			Operation:    operation.Operation,
+			Scope:        operation.Scope,
+			ComponentIDs: componentIDs,
+			Gates:        append([]string{}, operation.RequiredGates...),
+			DependsOn:    append([]string{}, operation.DependsOn...),
+		})
+	}
+	sort.Slice(steps, func(i, j int) bool { return steps[i].Order < steps[j].Order })
+
+	orderByID := make(map[string]int, len(steps))
+	for _, step := range steps {
+		orderByID[step.ID] = step.Order
+	}
+	for _, step := range steps {
+		for _, dependency := range step.DependsOn {
+			order, ok := orderByID[dependency]
+			if !ok || order >= step.Order {
+				return nil, fmt.Errorf("operation %s has missing or non-prior dependency %s", step.ID, dependency)
+			}
+		}
+	}
+	return steps, nil
+}
+
+func validateOrderRules(steps []Step, rules []OrderRule) error {
+	orders := make(map[string]int, len(steps))
+	for _, step := range steps {
+		orders[step.Operation] = step.Order
+	}
+	for _, rule := range rules {
+		before, beforeOK := orders[rule.Before]
+		after, afterOK := orders[rule.After]
+		if !beforeOK || !afterOK || before >= after {
+			return fmt.Errorf("unsatisfied order rule %s before %s", rule.Before, rule.After)
+		}
+	}
+	return nil
+}
+
+func buildInstallerSpec(inventory Inventory, targets map[string]TargetRule, targetVCF string) (json.RawMessage, error) {
+	vcTarget, vcOK := targets["vcenter"]
+	nsxTarget, nsxOK := targets["nsx"]
+	if !vcOK || !nsxOK {
+		return nil, fmt.Errorf("installer projection requires vcenter and nsx targets")
+	}
+	topology := inventory.Topology
+	if topology.VCenterHostname == "" || topology.NSXVIPFQDN == "" || len(topology.NSXManagers) == 0 || len(topology.Networks) == 0 {
+		return nil, fmt.Errorf("topology is incomplete")
+	}
+
+	hosts := make([]map[string]any, 0)
+	for _, component := range inventory.Components {
+		if component.Kind != "esxi" {
+			continue
+		}
+		thumbprint := topology.ESXiSSLThumbprints[component.Hostname]
+		if component.Hostname == "" || thumbprint == "" {
+			return nil, fmt.Errorf("missing host identity or thumbprint for %s", component.ID)
+		}
+		hosts = append(hosts, map[string]any{
+			"hostname":      strings.SplitN(component.Hostname, ".", 2)[0],
+			"sslThumbprint": thumbprint,
+		})
+	}
+	sort.Slice(hosts, func(i, j int) bool { return hosts[i]["hostname"].(string) < hosts[j]["hostname"].(string) })
+
+	networks := make([]map[string]any, 0, len(topology.Networks))
+	for _, network := range topology.Networks {
+		projected := map[string]any{
+			"networkType": network.Type,
+			"vlanId":      network.VLAN,
+			"subnet":      network.Subnet,
+			"gateway":     network.Gateway,
+			"subnetMask":  network.Mask,
+			"mtu":         network.MTU,
+		}
+		if len(network.IPRanges) > 0 {
+			ranges := make([]map[string]string, 0, len(network.IPRanges))
+			for _, item := range network.IPRanges {
+				ranges = append(ranges, map[string]string{
+					"startIpAddress": item.Start,
+					"endIpAddress":   item.End,
+				})
+			}
+			projected["includeIpAddressRanges"] = ranges
+		}
+		networks = append(networks, projected)
+	}
+
+	nsxManagers := make([]map[string]string, 0, len(topology.NSXManagers))
+	for _, hostname := range topology.NSXManagers {
+		nsxManagers = append(nsxManagers, map[string]string{"hostname": hostname})
+	}
+	spec := map[string]any{
+		"sddcId":       inventory.DesiredDomain,
+		"workflowType": "VCF",
+		"version":      targetVCF,
+		"vcenterSpec": map[string]any{
+			"vcenterHostname":       topology.VCenterHostname,
+			"rootVcenterPassword":   "${VcRoot9!Pass}",
+			"version":               vcTarget.Version + "." + vcTarget.Build,
+			"useExistingDeployment": true,
+			"sslThumbprint":         topology.VCenterSSLThumbprint,
+		},
+		"hostSpecs": hosts,
+		"clusterSpec": map[string]any{
+			"datacenterName": topology.DatacenterName,
+			"clusterName":    topology.ClusterName,
+		},
+		"networkSpecs": networks,
+		"dnsSpec": map[string]any{
+			"subdomain":   topology.DNSDomain,
+			"nameservers": append([]string{}, topology.NameServers...),
+		},
+		"ntpServers": append([]string{}, topology.NTPServers...),
+		"nsxtSpec": map[string]any{
+			"nsxtManagers":          nsxManagers,
+			"vipFqdn":               topology.NSXVIPFQDN,
+			"version":               nsxTarget.Version + "." + nsxTarget.Build,
+			"useExistingDeployment": true,
+			"sslThumbprint":         topology.NSXSSLThumbprint,
+		},
+		"datastoreSpec": map[string]any{
+			"existingDatastoreName": topology.DatastoreName,
+		},
+		"skipEsxThumbprintValidation": false,
+		"skipGatewayPingValidation":   false,
+	}
+	payload, err := json.Marshal(spec)
+	if err != nil {
+		return nil, fmt.Errorf("encode installer projection: %w", err)
+	}
+	return payload, nil
 }

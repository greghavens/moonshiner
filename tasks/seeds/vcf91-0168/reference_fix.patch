+        return ConvertFrom-Json `
+            -InputObject $Text `
+            -Depth 30 `
+            -NoEnumerate `
+            -ErrorAction Stop
+    }
+    catch {
+        throw [InvalidDataException]::new("$Context returned malformed JSON.")
+    }
+}
+
+function Get-VcfOpsLogRequiredString {
+    param(
+        [Parameter(Mandatory)]
+        [object] $InputObject,
+
+        [Parameter(Mandatory)]
+        [string] $Name,
+
+        [Parameter(Mandatory)]

+
+function Test-VcfOpsLogForwarderMatch {
+    param(
+        [Parameter(Mandatory)]
+        [object] $Forwarder,
+
+        [Parameter(Mandatory)]
+        [System.Collections.IDictionary] $Desired
+    )
+
+    $Context = 'The existing forwarder'
+    $ActualHost = Get-VcfOpsLogRequiredString `
+        -InputObject $Forwarder -Name 'host' -Context $Context
+    $ActualPort = Get-VcfOpsLogRequiredInteger `
+        -InputObject $Forwarder -Name 'port' -Context $Context
+    $ActualProtocol = Get-VcfOpsLogRequiredString `
+        -InputObject $Forwarder -Name 'protocol' -Context $Context
+    $ActualTransport = Get-VcfOpsLogRequiredString `
+        -InputObject $Forwarder -Name 'transportProtocol' -Context $Context
+    $ActualSsl = Get-VcfOpsLogRequiredBoolean `
+        -InputObject $Forwarder -Name 'sslEnabled' -Context $Context
+    $ActualEnabled = Get-VcfOpsLogRequiredBoolean `
+        -InputObject $Forwarder -Name 'enabled' -Context $Context
+
+    return (
+        [StringComparer]::Ordinal.Equals(
+            $ActualHost,
+            [string] $Desired.host
+        ) -and
+        $ActualPort -eq [int] $Desired.port -and
+        [StringComparer]::Ordinal.Equals(
+            $ActualProtocol,
+            [string] $Desired.protocol
+        ) -and
+        [StringComparer]::Ordinal.Equals(
+            $ActualTransport,
+            [string] $Desired.transportProtocol
+        ) -and
+        $ActualSsl -eq [bool] $Desired.sslEnabled -and
+        $ActualEnabled -eq [bool] $Desired.enabled
+    )
+}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/vcf-brownfield-migration-plan-v1.json",
  "title": "VCF Brownfield Migration Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "targetSddcSpec",
    "components",
    "steps"
  ],
  "properties": {
    "apiVersion": {
      "const": "architecture.vcf.vmware.com/v1alpha1"
    },
    "kind": {
      "const": "BrownfieldMigrationPlan"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estateId",
        "sourceVcfVersion",
        "targetVcfVersion"
      ],
      "properties": {
        "estateId": {
          "type": "string",
          "minLength": 1
        },
        "sourceVcfVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetVcfVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "consultedSources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "targetSddcSpec": {
      "type": "object"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "currentVersion",
        "target",
        "gates"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "currentVersion": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "product",
            "version",
            "transition"
          ],
          "properties": {
            "product": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "transition": {
              "enum": [
                "UPGRADE",
                "REPLACE",
                "RETAIN",
                "RETIRE"
              ]
            }
          }
        },
        "gates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "id",
        "componentId",
        "action",
        "fromVersion",
        "toVersion",
        "gates",
        "dependsOn"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "UPGRADE",
            "REPLACE",
            "RETAIN",
            "RETIRE"
          ]
        },
        "fromVersion": {
          "type": "string",
          "minLength": 1
        },
        "toVersion": {
          "type": "string",
          "minLength": 1
        },
        "gates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

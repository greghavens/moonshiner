{
  "title": "Focused VCF Automation 9.0 REST contract",
  "product": "VCF Automation",
  "product_version": "9.0",
  "provenance": {
    "kind": "reference-documentation",
    "statement": "This focused contract is derived from the authoritative Broadcom xAPIs 9.0 reference documentation rather than a published specification. VCF Automation has no published specification in the Apache-2.0 vmware/vcf-api-specs repository.",
    "official_sources": "docs/official_sources.json"
  },
  "operations": [
    {
      "key": "retrieveAuthToken",
      "reference_operation": "POST Retrieve Auth Token",
      "method": "POST",
      "path": "/iaas/api/login",
      "authentication": "none for access-token exchange",
      "request": {
        "content_type": "application/json",
        "query": {
          "apiVersion": "optional"
        },
        "body": {
          "type": "object",
          "required": [
            "refreshToken"
          ],
          "properties": {
            "refreshToken": {
              "type": "string"
            }
          }
        }
      },
      "responses": {
        "200": {
          "type": "object",
          "required": [
            "tokenType",
            "token"
          ],
          "properties": {
            "tokenType": {
              "type": "string"
            },
            "token": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "key": "requestCatalogItemInstances_1",
      "reference_operation": "POST Request Catalog Item Instances 1",
      "method": "POST",
      "path": "/catalog/api/items/{id}/request",
      "authentication": "bearerAuth",
      "path_parameters": {
        "id": {
          "type": "string",
          "required": true
        }
      },
      "request": {
        "content_type": "application/json",
        "body": {
          "type": "object",
          "required": [],
          "property_order": [
            "bulkRequestCount",
            "deploymentName",
            "inputs",
            "projectId",
            "reason",
            "version"
          ],
          "properties": {
            "bulkRequestCount": {
              "type": "integer",
              "format": "int32",
              "optional": true,
              "default_when_omitted": 1
            },
            "deploymentName": {
              "type": "string",
              "optional": true,
              "maxLength": 900
            },
            "inputs": {
              "type": "object",
              "optional": true
            },
            "projectId": {
              "type": "string",
              "optional": true
            },
            "reason": {
              "type": "string",
              "optional": true,
              "maxLength": 10240
            },
            "version": {
              "type": "string",
              "optional": true
            }
          }
        }
      },
      "responses": {
        "200": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "deploymentId": {
                "type": "string"
              },
              "deploymentName": {
                "type": "string"
              }
            }
          }
        },
        "401": {
          "description": "Unauthorized"
        }
      }
    },
    {
      "key": "getDeploymentById_1",
      "reference_operation": "GET Get Deployment By Id 1",
      "method": "GET",
      "path": "/deployment/api/deployments/{deploymentId}",
      "authentication": "bearerAuth",
      "path_parameters": {
        "deploymentId": {
          "type": "string",
          "required": true
        }
      },
      "request": {
        "body": null,
        "query": {
          "expandResources": "optional, deprecated",
          "expandLastRequest": "optional, deprecated",
          "expandProject": "optional, deprecated",
          "expand": "optional array",
          "deleted": "optional"
        }
      },
      "responses": {
        "200": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "optional": true
            },
            "name": {
              "type": "string",
              "required": true
            },
            "projectId": {
              "type": "string",
              "optional": true
            },
            "status": {
              "type": "string",
              "optional": true,
              "enum": [
                "CREATE_SUCCESSFUL",
                "CREATE_INPROGRESS",
                "CREATE_FAILED",
                "UPDATE_SUCCESSFUL",
                "UPDATE_INPROGRESS",
                "UPDATE_FAILED",
                "DELETE_SUCCESSFUL",
                "DELETE_INPROGRESS",
                "DELETE_FAILED"
              ]
            }
          }
        },
        "401": {
          "description": "Unauthorized"
        }
      }
    }
  ]
}

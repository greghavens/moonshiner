+    private static Map<String, Object> migrationPlan(
+            Map<String, Object> inventory, Map<String, Object> snapshot) {
+        List<Object> inventoryComponents = list(inventory.get("components"));
+        Map<String, Map<String, Object>> inventoryById = index(inventoryComponents, "componentId");
+        List<Object> compatibilityEntries = list(snapshot.get("componentCompatibility"));
+        Map<String, Map<String, Object>> compatibilityById = index(
+                compatibilityEntries, "componentId");
+
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("estateId", inventory.get("estateId"));
+        result.put("fleetId", inventory.get("fleetId"));
+
+        List<Object> components = new ArrayList<>();
+        for (Object value : inventoryComponents) {
+            Map<String, Object> source = object(value);
+            String id = string(source.get("componentId"));
+            Map<String, Object> compatibility = required(compatibilityById, id);
+            Map<String, Object> component = new LinkedHashMap<>();
+            component.put("componentId", id);
+            component.put("product", source.get("product"));
+            component.put("currentVersion", source.get("version"));
+            component.put("targetVersion", compatibility.get("targetVersion"));
+            component.put("gateIds", compatibility.get("gateIds"));
+            List<Object> transitionIds = new ArrayList<>();
+            for (Object edge : list(compatibility.get("supportedPath"))) {
+                transitionIds.add(object(edge).get("transitionId"));
+            }
+            component.put("transitionIds", transitionIds);
+            components.add(component);
+        }
+        result.put("components", components);
+        result.put("gates", snapshot.get("gateCatalog"));
+
+        Map<String, Map<String, Object>> transitions = new LinkedHashMap<>();
+        Map<String, Object> estateTransition = new LinkedHashMap<>(object(snapshot.get("estateTransition")));
+        transitions.put(string(estateTransition.get("transitionId")), estateTransition);
+        for (Object compatibilityValue : compatibilityEntries) {
+            Map<String, Object> compatibility = object(compatibilityValue);
+            String id = string(compatibility.get("componentId"));
+            for (Object edgeValue : list(compatibility.get("supportedPath"))) {
+                Map<String, Object> edge = new LinkedHashMap<>(object(edgeValue));
+                edge.put("componentId", id);
+                edge.put("product", inventoryById.get(id).get("product"));
+                transitions.put(string(edge.get("transitionId")), edge);
+            }
+        }
+
+        Map<String, Set<String>> dependencies = new LinkedHashMap<>();
+        for (String transitionId : transitions.keySet()) {
+            dependencies.put(transitionId, new LinkedHashSet<>());
+        }
+        for (Object value : list(snapshot.get("precedence"))) {
+            Map<String, Object> rule = object(value);
+            dependencies.get(string(rule.get("after"))).add(string(rule.get("before")));
+        }
+
+        List<Object> steps = new ArrayList<>();
+        Set<String> completed = new LinkedHashSet<>();
+        while (completed.size() < transitions.size()) {
+            boolean progressed = false;
+            for (Map.Entry<String, Map<String, Object>> entry : transitions.entrySet()) {
+                String id = entry.getKey();
+                if (completed.contains(id) || !completed.containsAll(dependencies.get(id))) {
+                    continue;
+                }
+                Map<String, Object> edge = entry.getValue();
+                Map<String, Object> step = new LinkedHashMap<>();
+                step.put("order", steps.size() + 1);
+                step.put("transitionId", id);
+                step.put("componentId", edge.get("componentId"));
+                step.put("product", edge.get("product"));
+                step.put("fromVersion", edge.get("fromVersion"));
+                step.put("toVersion", edge.get("toVersion"));
+                step.put("action", edge.get("action"));
+                step.put("gateIds", edge.get("gateIds"));
+                step.put("dependsOn", new ArrayList<>(dependencies.get(id)));
+                steps.add(step);
+                completed.add(id);
+                progressed = true;
+            }
+            if (!progressed) {
+                throw new IllegalArgumentException("pinned precedence graph contains a cycle");
+            }
+        }
+        result.put("steps", steps);
+        result.put("finalFleetMembers", new ArrayList<>(inventoryById.keySet()));
+        return result;
+    }

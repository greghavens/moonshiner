+    private static Map<String, Object> required(
+            Map<String, Map<String, Object>> values, String id) {
+        Map<String, Object> value = values.get(id);
+        if (value == null) {
+            throw new IllegalArgumentException("missing compatibility for " + id);
+        }
+        return value;
+    }

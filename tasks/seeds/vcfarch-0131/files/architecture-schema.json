{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF estate architecture artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "designId",
    "selectedBundle",
    "rejectedBundle",
    "greenfieldSpec",
    "migrationPlan"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "designId": {
      "type": "string",
      "minLength": 1
    },
    "selectedBundle": {
      "type": "string",
      "minLength": 1
    },
    "rejectedBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle",
        "reasonCode",
        "blockedComponentId"
      ],
      "properties": {
        "bundle": {
          "type": "string"
        },
        "reasonCode": {
          "type": "string"
        },
        "blockedComponentId": {
          "type": "string"
        }
      }
    },
    "greenfieldSpec": {
      "type": "object"
    },
    "migrationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estateId",
        "fleetId",
        "components",
        "gates",
        "steps",
        "finalFleetMembers"
      ],
      "properties": {
        "estateId": {
          "type": "string",
          "minLength": 1
        },
        "fleetId": {
          "type": "string",
          "minLength": 1
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/gate"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "finalFleetMembers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "product",
        "currentVersion",
        "targetVersion",
        "gateIds",
        "transitionIds"
      ],
      "properties": {
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "currentVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1
        },
        "gateIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "transitionIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateId",
        "kind",
        "condition",
        "componentIds"
      ],
      "properties": {
        "gateId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "componentIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "transitionId",
        "componentId",
        "product",
        "fromVersion",
        "toVersion",
        "action",
        "gateIds",
        "dependsOn"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "transitionId": {
          "type": "string",
          "minLength": 1
        },
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "fromVersion": {
          "type": "string",
          "minLength": 1
        },
        "toVersion": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "gateIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

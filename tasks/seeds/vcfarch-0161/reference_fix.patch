diff --git a/VcfMigrationArchitecture.psm1 b/VcfMigrationArchitecture.psm1
new file mode 100644
index 0000000..58330f0
--- /dev/null
+++ b/VcfMigrationArchitecture.psm1
@@ -0,0 +1,141 @@
+Set-StrictMode -Version Latest
+
+function Export-VcfMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $InventoryPath,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $CompatibilityPath,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $OutputPath
+    )
+
+    $inventory = Get-Content -LiteralPath (Resolve-Path -LiteralPath $InventoryPath) -Raw | ConvertFrom-Json
+    $compatibility = Get-Content -LiteralPath (Resolve-Path -LiteralPath $CompatibilityPath) -Raw | ConvertFrom-Json
+
+    if ($inventory.inventoryVersion -ne '1.0') {
+        throw "Unsupported inventory version '$($inventory.inventoryVersion)'."
+    }
+
+    $managementDomain = $inventory.managementDomain
+    $hostRules = @($compatibility.hostRules | Where-Object {
+        $_.topology -eq $managementDomain.topology -and
+        $_.storagePolicy -eq $managementDomain.storagePolicy -and
+        $_.failuresToTolerate -eq $managementDomain.failuresToTolerate
+    })
+    if ($hostRules.Count -ne 1) {
+        throw 'A unique compatibility host rule was not found.'
+    }
+    $minimumHosts = [int] $hostRules[0].minimumHostCount
+    if ([int] $managementDomain.hostCount -lt $minimumHosts) {
+        throw "Host count cannot satisfy the stated failures-to-tolerate."
+    }
+    if ([int] $managementDomain.hostCount -ne $minimumHosts) {
+        throw "This architecture must remain at the minimum supported host count."
+    }
+
+    $placement = [ordered]@{
+        siteId      = $managementDomain.siteId
+        vcenterId   = $managementDomain.vcenterId
+        clusterId   = $managementDomain.clusterId
+        datastoreId = $managementDomain.datastoreId
+        networkId   = $managementDomain.networkId
+        antiAffinity = 'spread-nodes-across-distinct-hosts'
+    }
+
+    $componentPlans = @(
+        foreach ($product in $inventory.products) {
+            $property = $compatibility.components.PSObject.Properties[$product.id]
+            if ($null -eq $property) {
+                throw "No pinned compatibility entry exists for '$($product.id)'."
+            }
+            $rule = $property.Value
+            if ($product.product -ne $rule.sourceProduct -or
+                $product.version -ne $rule.sourceVersion -or
+                $product.build -ne $rule.sourceBuild) {
+                throw "Inventory identity does not match the pinned entry for '$($product.id)'."
+            }
+
+            $retained = @($rule.carryForward)
+            $discarded = @($rule.abandoned)
+            $disposition = @($retained + $discarded | Sort-Object -Unique)
+            $inventoryContent = @($product.content | Sort-Object -Unique)
+            if (Compare-Object -ReferenceObject $inventoryContent -DifferenceObject $disposition) {
+                throw "Not every content item has a disposition for '$($product.id)'."
+            }
+
+            [ordered]@{
+                id = $product.id
+                source = [ordered]@{
+                    product = $product.product
+                    version = $product.version
+                    build = $product.build
+                    support = [ordered]@{
+                        status = $rule.supportStatus
+                        endOfGeneralSupport = $rule.endOfGeneralSupport
+                    }
+                }
+                target = [ordered]@{
+                    component = $rule.targetComponent
+                    version = $rule.targetVersion
+                    migrationMode = $rule.migrationMode
+                    placement = $placement
+                    sizing = [ordered]@{
+                        profile = $rule.sizing.profile
+                        nodeCount = [int] $rule.sizing.nodeCount
+                        vcpuPerNode = [int] $rule.sizing.vcpuPerNode
+                        memoryGbPerNode = [int] $rule.sizing.memoryGbPerNode
+                        diskGbPerNode = [int] $rule.sizing.diskGbPerNode
+                    }
+                }
+                carryForward = $retained
+                abandoned = $discarded
+                gates = @($rule.gates)
+            }
+        }
+    )
+
+    $orderedSteps = @()
+    for ($index = 0; $index -lt $compatibility.stepOrder.Count; $index++) {
+        $step = $compatibility.stepOrder[$index]
+        $orderedSteps += [ordered]@{
+            order = $index + 1
+            id = $step.id
+            componentId = $step.componentId
+            action = $step.action
+            gatedBy = @($step.gatedBy)
+            completionEvidence = @($step.completionEvidence)
+        }
+    }
+
+    $plan = [ordered]@{
+        schemaVersion = '1.0'
+        architecture = [ordered]@{
+            estateId = $inventory.estateId
+            topology = $managementDomain.topology
+            siteCount = @($inventory.sites).Count
+            managementDomain = [ordered]@{
+                siteId = $managementDomain.siteId
+                vcenterId = $managementDomain.vcenterId
+                clusterId = $managementDomain.clusterId
+                hostCount = [int] $managementDomain.hostCount
+                failuresToTolerate = [int] $managementDomain.failuresToTolerate
+                storagePolicy = $managementDomain.storagePolicy
+                minimumSupportedHostCount = $minimumHosts
+            }
+        }
+        components = $componentPlans
+        steps = $orderedSteps
+    }
+
+    $output = $ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($OutputPath)
+    $plan | ConvertTo-Json -Depth 20 | Set-Content -LiteralPath $output -Encoding utf8NoBOM
+}
+
+Export-ModuleMember -Function Export-VcfMigrationPlan

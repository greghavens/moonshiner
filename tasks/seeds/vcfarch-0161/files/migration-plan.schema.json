{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0161:migration-plan:1.0",
  "title": "VCF Aria content migration architecture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "architecture",
    "components",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estateId",
        "topology",
        "siteCount",
        "managementDomain"
      ],
      "properties": {
        "estateId": { "type": "string", "minLength": 1 },
        "topology": { "const": "single-site-consolidated" },
        "siteCount": { "const": 1 },
        "managementDomain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "siteId",
            "vcenterId",
            "clusterId",
            "hostCount",
            "failuresToTolerate",
            "storagePolicy",
            "minimumSupportedHostCount"
          ],
          "properties": {
            "siteId": { "type": "string", "minLength": 1 },
            "vcenterId": { "type": "string", "minLength": 1 },
            "clusterId": { "type": "string", "minLength": 1 },
            "hostCount": { "type": "integer", "minimum": 1 },
            "failuresToTolerate": { "type": "integer", "minimum": 0 },
            "storagePolicy": { "type": "string", "minLength": 1 },
            "minimumSupportedHostCount": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/component" }
    },
    "steps": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target",
        "carryForward",
        "abandoned",
        "gates"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [ "product", "version", "build", "support" ],
          "properties": {
            "product": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "build": { "type": "string", "minLength": 1 },
            "support": {
              "type": "object",
              "additionalProperties": false,
              "required": [ "status", "endOfGeneralSupport" ],
              "properties": {
                "status": { "enum": [ "supported-at-snapshot", "end-of-support-at-snapshot" ] },
                "endOfGeneralSupport": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
              }
            }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [ "component", "version", "migrationMode", "placement", "sizing" ],
          "properties": {
            "component": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "migrationMode": { "type": "string", "minLength": 1 },
            "placement": {
              "type": "object",
              "additionalProperties": false,
              "required": [ "siteId", "vcenterId", "clusterId", "datastoreId", "networkId", "antiAffinity" ],
              "properties": {
                "siteId": { "type": "string", "minLength": 1 },
                "vcenterId": { "type": "string", "minLength": 1 },
                "clusterId": { "type": "string", "minLength": 1 },
                "datastoreId": { "type": "string", "minLength": 1 },
                "networkId": { "type": "string", "minLength": 1 },
                "antiAffinity": { "const": "spread-nodes-across-distinct-hosts" }
              }
            },
            "sizing": {
              "type": "object",
              "additionalProperties": false,
              "required": [ "profile", "nodeCount", "vcpuPerNode", "memoryGbPerNode", "diskGbPerNode" ],
              "properties": {
                "profile": { "type": "string", "minLength": 1 },
                "nodeCount": { "type": "integer", "minimum": 1 },
                "vcpuPerNode": { "type": "integer", "minimum": 1 },
                "memoryGbPerNode": { "type": "integer", "minimum": 1 },
                "diskGbPerNode": { "type": "integer", "minimum": 1 }
              }
            }
          }
        },
        "carryForward": { "$ref": "#/$defs/stringSet" },
        "abandoned": { "$ref": "#/$defs/stringSet" },
        "gates": { "$ref": "#/$defs/stringSet" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "order", "id", "componentId", "action", "gatedBy", "completionEvidence" ],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "id": { "type": "string", "minLength": 1 },
        "componentId": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "gatedBy": { "$ref": "#/$defs/stringSet" },
        "completionEvidence": { "$ref": "#/$defs/stringSet" }
      }
    }
  }
}

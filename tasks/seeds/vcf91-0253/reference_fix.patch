diff --git a/src/VcfOpsInventory/VcfOpsInventory.psm1 b/src/VcfOpsInventory/VcfOpsInventory.psm1
index d3188d9..63b73ae 100644
--- a/src/VcfOpsInventory/VcfOpsInventory.psm1
+++ b/src/VcfOpsInventory/VcfOpsInventory.psm1
@@ -56,8 +56,100 @@ function Get-VcfOpsResourceInventory {
         [string]   $PropertyValue
     )
 
-    throw [System.NotImplementedException]::new(
-        'Get-VcfOpsResourceInventory is not implemented yet.')
+    # Only the filters the caller actually set are handed to the SDK, so the rest
+    # never reach the query string. Two of these would otherwise be sent as a
+    # value rather than left out: an unbound [long] is 0, which getResources reads
+    # as "created after the epoch", and an unbound [string] is '', which it reads
+    # as a property filter on the empty name. Neither is the same query as no
+    # filter at all. Empty arrays are skipped for the same reason -- and because
+    # the SDK will not serialize one.
+    $filters = @{}
+    if ($null -ne $Name -and $Name.Count -gt 0) {
+        $filters.Name = [string[]] $Name
+    }
+    if ($null -ne $AdapterKind -and $AdapterKind.Count -gt 0) {
+        $filters.AdapterKind = [string[]] $AdapterKind
+    }
+    if ($null -ne $ResourceKind -and $ResourceKind.Count -gt 0) {
+        $filters.ResourceKind = [string[]] $ResourceKind
+    }
+    if ($null -ne $ResourceHealth -and $ResourceHealth.Count -gt 0) {
+        $filters.ResourceHealth = [string[]] $ResourceHealth
+    }
+    if ($PSBoundParameters.ContainsKey('CreatedAfter')) { $filters.RecentlyAdded = $CreatedAfter }
+    if ($PSBoundParameters.ContainsKey('PropertyName')) { $filters.PropertyName = $PropertyName }
+    if ($PSBoundParameters.ContainsKey('PropertyValue')) { $filters.PropertyValue = $PropertyValue }
+
+    $collected = [System.Collections.Generic.List[psobject]]::new()
+    $seen = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::Ordinal)
+    $duplicates = 0
+    $pagesFetched = 0
+    $reportedTotalCount = $null
+    $page = 0
+
+    while ($true) {
+        $response = Invoke-VcfOpsGetResources -Server $Server @filters -Page $page -PageSize $PageSize
+        $pagesFetched++
+
+        if ($null -eq $reportedTotalCount -and $null -ne $response.PageInfo) {
+            # Recorded for the caller, and for nothing else: totalCount is what the
+            # server believed when it cut the page, and the inventory moves under
+            # it. Using it to decide when to stop truncates the snapshot.
+            $reportedTotalCount = [int] $response.PageInfo.TotalCount
+        }
+
+        if ($null -ne $response.ResourceList) {
+            foreach ($resource in $response.ResourceList) {
+                # Pages are computed independently, so a resource that shifts
+                # between two requests can be handed over twice -- or, on a page
+                # the server trimmed after cutting it, arrive alongside fewer rows
+                # than pageSize without that meaning the collection has ended.
+                if (-not $seen.Add([string] $resource.Identifier)) {
+                    $duplicates++
+                    continue
+                }
+                $collected.Add([pscustomobject] @{
+                        Identifier   = [string] $resource.Identifier
+                        Name         = [string] $resource.ResourceKey.Name
+                        AdapterKind  = [string] $resource.ResourceKey.AdapterKindKey
+                        ResourceKind = [string] $resource.ResourceKey.ResourceKindKey
+                        Health       = [string] $resource.ResourceHealth
+                        CreationTime = [long]   $resource.CreationTime
+                    })
+            }
+        }
+
+        # The only signal that says anything about what comes next.
+        $hasNext = $false
+        if ($null -ne $response.Links) {
+            foreach ($link in $response.Links) {
+                if ([string] $link.Rel -eq 'NEXT') { $hasNext = $true; break }
+            }
+        }
+        if (-not $hasNext) { break }
+
+        # page is a page ordinal, not a row offset.
+        $page++
+    }
+
+    # Ordinal, so the same inventory produces the same file on every host: the
+    # default PowerShell comparison follows the current culture, which does not
+    # agree with itself across locales about 'vsan-cluster-A' against
+    # 'vsan-cluster-a'. The NUL keeps a name from running into the identifier,
+    # so a name that is a prefix of another still sorts before it.
+    $rows = $collected.ToArray()
+    if ($rows.Length -gt 1) {
+        $keys = [string[]] @($rows | ForEach-Object { $_.Name + "`0" + $_.Identifier })
+        [System.Array]::Sort($keys, $rows, [System.StringComparer]::Ordinal)
+    }
+
+    return [pscustomobject] @{
+        Resources          = $rows
+        ResourceCount      = $rows.Length
+        PagesFetched       = $pagesFetched
+        DuplicatesDropped  = $duplicates
+        ReportedTotalCount = $reportedTotalCount
+    }
 }
 
 Export-ModuleMember -Function 'Get-VcfOpsResourceInventory'

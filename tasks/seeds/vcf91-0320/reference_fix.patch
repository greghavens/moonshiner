+    # -- transport -----------------------------------------------------------
+
+    def _url(self, path, *segments):
+        """Join a contract path with URL-encoded path parameters."""
+        for segment in segments:
+            path += "/" + urllib.parse.quote(str(segment), safe="")
+        # apiVersion is optional on all three operations. Unset means the
+        # parameter is absent, not present-and-empty.
+        if self.api_version is not None:
+            path += "?" + urllib.parse.urlencode({"apiVersion": self.api_version})
+        return self.base_url + path
+
+    def _send(self, method, url, body=None):
+        """Return ``(status, decoded_body)``. Never raises for a non-2xx."""
+        headers = {
+            "Authorization": "Bearer " + self.access_token,
+            "Accept": "application/json",
+        }
+        data = None
+        if body is not None:
+            data = json.dumps(body).encode("utf-8")
+            # Content-Type belongs only on a request that carries a body.
+            headers["Content-Type"] = "application/json"
+
+        request = urllib.request.Request(url, data=data, headers=headers, method=method)
+        try:
+            with self._opener.open(request, timeout=self.timeout) as response:
+                return response.status, self._decode(response.read())
+        except urllib.error.HTTPError as error:
+            return error.code, self._decode(error.read())
+
+    @staticmethod
+    def _decode(raw):
+        if not raw:
+            return None
+        text = raw.decode("utf-8", "replace")
+        try:
+            return json.loads(text)
+        except ValueError:
+            return text
+
+    @staticmethod
+    def _message(payload, fallback):
+        """Pull a human-readable line out of a ServiceErrorResponse."""
+        if isinstance(payload, dict):
+            for key in ("message", "messageId"):
+                if payload.get(key):
+                    return payload[key]
+        elif isinstance(payload, str) and payload.strip():
+            return payload.strip()
+        return fallback
+

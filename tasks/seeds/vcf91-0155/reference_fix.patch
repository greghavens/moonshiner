+
+func (c *Client) pollTask(ctx context.Context, taskID string) (terminalTask, error) {
+	path := "/api/cis/tasks/" + url.PathEscape(taskID)
+	for poll := 1; poll <= c.maxPolls; poll++ {
+		data, err := c.do(ctx, c.vcenterURL, OperationGetTask, http.MethodGet, path, nil, false)
+		if err != nil {
+			return terminalTask{}, err
+		}
+		var info taskInfo
+		if err := decodeOne(data, &info); err != nil ||
+			info.Cancelable == nil ||
+			info.Description == nil ||
+			info.Description.ID == nil ||
+			info.Description.DefaultMessage == nil ||
+			info.Description.Args == nil ||
+			info.Operation == nil ||
+			info.Service == nil ||
+			info.Status == nil {
+			return terminalTask{}, &ProtocolError{OperationID: OperationGetTask}
+		}
+
+		switch *info.Status {
+		case "SUCCEEDED":
+			var result any
+			if len(info.Result) != 0 {
+				if err := decodeOne(info.Result, &result); err != nil {
+					return terminalTask{}, &ProtocolError{OperationID: OperationGetTask}
+				}
+			}
+			return terminalTask{pollCount: poll, result: result}, nil
+		case "FAILED":
+			return terminalTask{}, &TaskFailedError{TaskID: taskID, Status: "FAILED"}
+		case "PENDING", "RUNNING", "BLOCKED":
+			if poll == c.maxPolls {
+				return terminalTask{}, &PollTimeoutError{TaskID: taskID, MaxPolls: c.maxPolls}
+			}
+			if err := waitForPoll(ctx, c.pollInterval); err != nil {
+				return terminalTask{}, err
+			}
+		default:
+			return terminalTask{}, &ProtocolError{OperationID: OperationGetTask}
+		}
+	}
+	panic("unreachable")
+}
+
+func waitForPoll(ctx context.Context, interval time.Duration) error {
+	if interval == 0 {
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		default:
+			return nil
+		}
+	}
+	timer := time.NewTimer(interval)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-timer.C:
+		return nil
+	}
+}
+
+func (c *Client) do(
+	ctx context.Context,
+	baseURL string,
+	operationID string,
+	method string,
+	path string,
+	body []byte,
+	kubernetes bool,
+) ([]byte, error) {
+	var reader io.Reader
+	if body != nil {
+		reader = bytes.NewReader(body)
+	}
+	request, err := http.NewRequestWithContext(ctx, method, baseURL+path, reader)
+	if err != nil {
+		return nil, &ProtocolError{OperationID: operationID}
+	}
+	request.Header.Set("Accept", "application/json")
+	if kubernetes {
+		request.Header.Set("Authorization", "Bearer "+c.kubernetesToken)
+	} else {
+		request.Header.Set("vmware-api-session-id", c.sessionID)
+	}
+	if body != nil {
+		request.Header.Set("Content-Type", "application/json")
+	}
+
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		if ctx.Err() != nil {
+			return nil, ctx.Err()
+		}
+		return nil, &APIError{OperationID: operationID}
+	}
+	defer response.Body.Close()
+	data, readErr := io.ReadAll(io.LimitReader(response.Body, maxResponseBytes+1))
+	if response.StatusCode != http.StatusOK {
+		return nil, &APIError{OperationID: operationID, StatusCode: response.StatusCode}
+	}
+	if readErr != nil {
+		return nil, &APIError{OperationID: operationID}
+	}
+	if len(data) > maxResponseBytes {
+		return nil, &ProtocolError{OperationID: operationID}
+	}
+	mediaType, _, err := mime.ParseMediaType(response.Header.Get("Content-Type"))
+	if err != nil || mediaType != "application/json" {
+		return nil, &ProtocolError{OperationID: operationID}
+	}
+	return data, nil
+}
+
+func decodeOne(data []byte, destination any) error {
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	if err := decoder.Decode(destination); err != nil {
+		return err
+	}
+	var extra any
+	if err := decoder.Decode(&extra); err != io.EOF {
+		if err == nil {
+			return fmt.Errorf("multiple JSON values")
+		}
+		return err
+	}
+	return nil
+}
+
+func equalClusters(left, right []Cluster) bool {
+	if len(left) != len(right) {
+		return false
+	}
+	for i := range left {
+		if left[i] != right[i] {
+			return false
+		}
+	}
+	return true
 }


+func validateOrigin(value, name string) (string, error) {
+	if value == "" || strings.TrimSpace(value) != value {
+		return "", fmt.Errorf("%s must be an absolute HTTP(S) origin", name)
+	}
+	parsed, err := url.Parse(value)
+	if err != nil ||
+		(parsed.Scheme != "http" && parsed.Scheme != "https") ||
+		parsed.Host == "" ||
+		parsed.Hostname() == "" ||
+		parsed.User != nil ||
+		parsed.Opaque != "" ||
+		(parsed.Path != "" && parsed.Path != "/") ||
+		parsed.RawQuery != "" ||
+		parsed.ForceQuery ||
+		parsed.Fragment != "" {
+		return "", fmt.Errorf("%s must be an absolute HTTP(S) origin", name)
+	}
+	parsed.Path = ""
+	parsed.RawPath = ""
+	return parsed.String(), nil
+}
+
+func validateCredential(value, name string) error {
+	if strings.TrimSpace(value) == "" || strings.ContainsAny(value, "\r\n") {
+		return fmt.Errorf("%s must be a nonblank, header-safe string", name)
+	}
+	return nil
 }
 
 // BackupNamespace performs the contract workflow.
 func (c *Client) BackupNamespace(ctx context.Context, req BackupRequest) (Result, error) {
-	return Result{}, fmt.Errorf("TODO: implement BackupNamespace")
+	if ctx == nil {
+		return Result{}, fmt.Errorf("context must not be nil")
+	}
+	if strings.TrimSpace(req.Namespace) == "" {
+		return Result{}, fmt.Errorf("Namespace must be nonblank")
+	}
+
+	supervisor, err := c.getNamespace(ctx, req.Namespace)
+	if err != nil {
+		return Result{}, err
+	}
+	before, err := c.listClusters(ctx, req.Namespace)
+	if err != nil {
+		return Result{}, err
+	}
+	taskID, err := c.createBackup(ctx, supervisor, req.Comment)
+	if err != nil {
+		return Result{}, err
+	}
+	task, err := c.pollTask(ctx, taskID)
+	if err != nil {
+		return Result{}, err
+	}
+	after, err := c.listClusters(ctx, req.Namespace)
+	if err != nil {
+		return Result{}, err
+	}
+	if !equalClusters(before, after) {
+		return Result{}, &ProtocolError{OperationID: OperationListClusters}
+	}
+
+	return Result{
+		Namespace:  req.Namespace,
+		Supervisor: supervisor,
+		Clusters:   append([]Cluster(nil), after...),
+		Backup: BackupResult{
+			OperationID:     OperationCreateBackup,
+			TaskOperationID: OperationGetTask,
+			TaskID:          taskID,
+			Status:          "SUCCEEDED",
+			PollCount:       task.pollCount,
+			Result:          task.result,
+		},
+	}, nil
+}

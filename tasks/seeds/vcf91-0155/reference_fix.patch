+func (c *Client) createBackup(ctx context.Context, supervisor string, comment *string) (string, error) {
+	body, err := encodeCreateSpec(comment)
+	if err != nil {
+		return "", &ProtocolError{OperationID: OperationCreateBackup}
+	}
+	path := "/api/vcenter/namespace-management/supervisors/" +
+		url.PathEscape(supervisor) + "/recovery/backup/jobs"
+	data, err := c.do(ctx, c.vcenterURL, OperationCreateBackup, http.MethodPost, path, body, false)
+	if err != nil {
+		return "", err
+	}
+	var taskID string
+	if err := decodeOne(data, &taskID); err != nil || strings.TrimSpace(taskID) == "" {
+		return "", &ProtocolError{OperationID: OperationCreateBackup}
+	}
+	return taskID, nil
+}
+
+func encodeCreateSpec(comment *string) ([]byte, error) {
+	payload := struct {
+		Comment *string `json:"comment,omitempty"`
+	}{Comment: comment}
+	var buffer bytes.Buffer
+	encoder := json.NewEncoder(&buffer)
+	encoder.SetEscapeHTML(false)
+	if err := encoder.Encode(payload); err != nil {
+		return nil, err
+	}
+	return bytes.TrimSuffix(buffer.Bytes(), []byte{'\n'}), nil
+}

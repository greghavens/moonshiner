+func (c *Client) listClusters(ctx context.Context, namespace string) ([]Cluster, error) {
+	path := "/apis/cluster.x-k8s.io/v1beta2/namespaces/" + url.PathEscape(namespace) + "/clusters"
+	data, err := c.do(ctx, c.kubernetesURL, OperationListClusters, http.MethodGet, path, nil, true)
+	if err != nil {
+		return nil, err
+	}
+	var list clusterList
+	if err := decodeOne(data, &list); err != nil ||
+		list.APIVersion == nil || *list.APIVersion != "cluster.x-k8s.io/v1beta2" ||
+		list.Kind == nil || *list.Kind != "ClusterList" ||
+		list.Items == nil {
+		return nil, &ProtocolError{OperationID: OperationListClusters}
+	}
+
+	clusters := make([]Cluster, 0, len(*list.Items))
+	names := make(map[string]struct{}, len(*list.Items))
+	for _, item := range *list.Items {
+		if item.APIVersion == nil || *item.APIVersion != "cluster.x-k8s.io/v1beta2" ||
+			item.Kind == nil || *item.Kind != "Cluster" ||
+			item.Metadata == nil ||
+			item.Metadata.Name == nil || strings.TrimSpace(*item.Metadata.Name) == "" ||
+			item.Metadata.Namespace == nil || *item.Metadata.Namespace != namespace ||
+			item.Spec == nil || item.Spec.Topology == nil ||
+			item.Spec.Topology.Version == nil || strings.TrimSpace(*item.Spec.Topology.Version) == "" {
+			return nil, &ProtocolError{OperationID: OperationListClusters}
+		}
+		if _, duplicate := names[*item.Metadata.Name]; duplicate {
+			return nil, &ProtocolError{OperationID: OperationListClusters}
+		}
+		names[*item.Metadata.Name] = struct{}{}
+		clusters = append(clusters, Cluster{
+			Name:            *item.Metadata.Name,
+			TopologyVersion: *item.Spec.Topology.Version,
+		})
+	}
+	sort.Slice(clusters, func(i, j int) bool {
+		return clusters[i].Name < clusters[j].Name
+	})
+	return clusters, nil
+}

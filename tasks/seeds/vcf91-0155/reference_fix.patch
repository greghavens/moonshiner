+func (c *Client) getNamespace(ctx context.Context, namespace string) (string, error) {
+	path := "/api/vcenter/namespaces/instances/v2/" + url.PathEscape(namespace)
+	data, err := c.do(ctx, c.vcenterURL, OperationGetNamespace, http.MethodGet, path, nil, false)
+	if err != nil {
+		return "", err
+	}
+	var info namespaceInfo
+	if err := decodeOne(data, &info); err != nil ||
+		info.Supervisor == nil ||
+		strings.TrimSpace(*info.Supervisor) == "" ||
+		info.ConfigStatus == nil ||
+		info.Description == nil ||
+		info.Messages == nil ||
+		info.Stats == nil ||
+		info.Stats.CPUUsed == nil ||
+		info.Stats.MemoryUsed == nil ||
+		info.Stats.StorageUsed == nil ||
+		info.AccessList == nil ||
+		info.StorageSpecs == nil {
+		return "", &ProtocolError{OperationID: OperationGetNamespace}
+	}
+	switch *info.ConfigStatus {
+	case "RUNNING":
+		return *info.Supervisor, nil
+	case "CONFIGURING", "REMOVING", "ERROR":
+		return "", &NamespaceNotReadyError{Status: *info.ConfigStatus}
+	default:
+		return "", &ProtocolError{OperationID: OperationGetNamespace}
+	}
+}

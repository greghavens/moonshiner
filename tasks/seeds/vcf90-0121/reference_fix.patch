 """vSAN Data Protection report client.
 
-The public surface is present so callers can integrate it while the report
-pagination implementation is completed.
+Implements the report-list wire contract from the VCF 9.0 vSAN Data Protection
+OpenAPI specification using only the Python standard library.
 """
 
+from __future__ import annotations
+
+import json
+from urllib.error import HTTPError, URLError
+from urllib.parse import quote, urlencode
+from urllib.request import Request, urlopen
+
 
 class VsanDataProtectionError(RuntimeError):
     """Raised when the report service returns an unusable response."""
@@ -27,4 +34,91 @@ class VsanDataProtectionClient:
         end_time=None,
     ):
         """Return every protection-group snapshot report record."""
-        raise NotImplementedError("protection-group snapshot pagination is not implemented")
+        records = []
+        offset = None
+        total_count = None
+
+        while total_count is None or len(records) < total_count:
+            result = self._get_snapshot_page(
+                cluster,
+                page_size=page_size,
+                offset=offset,
+                pgs=pgs,
+                start_time=start_time,
+                end_time=end_time,
+            )
+            try:
+                page = result["snapshots"]
+                reported_total = result["total_count"]
+            except (KeyError, TypeError) as error:
+                raise VsanDataProtectionError("report response omitted pagination fields") from error
+            if not isinstance(page, list) or not isinstance(reported_total, int):
+                raise VsanDataProtectionError("report response has invalid pagination fields")
+            if reported_total < 0 or (total_count is not None and reported_total != total_count):
+                raise VsanDataProtectionError("report total_count changed during pagination")
+
+            total_count = reported_total
+            if not page and len(records) < total_count:
+                raise VsanDataProtectionError("report pagination stopped before total_count")
+            records.extend(page)
+            if len(records) > total_count:
+                raise VsanDataProtectionError("report returned more records than total_count")
+            if len(records) < total_count:
+                offset = len(records)
+
+        try:
+            return sorted(
+                records,
+                key=lambda item: (
+                    item["creation_time"],
+                    item["pg"],
+                    item["name"],
+                    item.get("snapshot") or "",
+                ),
+            )
+        except (AttributeError, KeyError, TypeError) as error:
+            raise VsanDataProtectionError("report record cannot be ordered") from error
+
+    def _get_snapshot_page(
+        self,
+        cluster,
+        *,
+        page_size,
+        offset,
+        pgs,
+        start_time,
+        end_time,
+    ):
+        path = (
+            "/snapservice/reports/clusters/"
+            f"{quote(str(cluster), safe='')}"
+            "/protection-groups/snapshots"
+        )
+        query = []
+        if start_time is not None:
+            query.append(("start_time", str(start_time)))
+        if end_time is not None:
+            query.append(("end_time", str(end_time)))
+        if pgs is not None:
+            query.extend(("pgs", str(pg)) for pg in pgs)
+        if page_size is not None:
+            query.append(("page_size", str(page_size)))
+        if offset is not None:
+            query.append(("offset", str(offset)))
+
+        url = self.base_url.rstrip("/") + path
+        if query:
+            url += "?" + urlencode(query)
+        request = Request(
+            url,
+            method="GET",
+            headers={
+                "Accept": "application/json",
+                "vmware-api-session-id": self.session_id,
+            },
+        )
+        try:
+            with urlopen(request, timeout=self.timeout) as response:
+                return json.loads(response.read().decode("utf-8"))
+        except (HTTPError, URLError, TimeoutError, UnicodeDecodeError, json.JSONDecodeError) as error:
+            raise VsanDataProtectionError(f"report request failed: {error}") from error

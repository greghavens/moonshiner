{
  "schemaVersion": 1,
  "contractFormat": "focused-vcenter-openapi-plus-native-kubernetes-v1",
  "title": "Ready Supervisor namespace gate before VKS cluster creation",
  "source": {
    "kind": "pinned-openapi-specification",
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repositoryCommitSha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "specPath": "specifications/vsphere/openapi/automation/vcenter.yaml",
    "specBlobSha": "8028b0824c4ff3503d05f44814f967938a795c40",
    "license": "Apache-2.0",
    "openapi": "3.0.3",
    "apiTitle": "vSphere Automation API",
    "apiVersion": "9.1.0.0",
    "serverTemplate": "https://{host}/api"
  },
  "securitySchemes": {
    "api_key_auth": {
      "type": "apiKey",
      "in": "header",
      "name": "vmware-api-session-id"
    },
    "kubernetes_bearer": {
      "type": "http",
      "scheme": "bearer",
      "sourceKind": "native-kubernetes-api"
    }
  },
  "operations": [
    {
      "contractName": "getSupervisorNamespace",
      "sourceKind": "vcenter-openapi-operation",
      "operationId": "Vcenter.Namespaces.Instances_getV2",
      "method": "GET",
      "specPathItem": "/vcenter/namespaces/instances/v2/{namespace}",
      "pathTemplate": "/api/vcenter/namespaces/instances/v2/{namespace}",
      "pathParameters": [
        {
          "name": "namespace",
          "in": "path",
          "required": true,
          "type": "string",
          "resourceType": "com.vmware.vcenter.namespaces.Instance"
        }
      ],
      "queryParameters": [],
      "requestBody": false,
      "successStatus": 200,
      "responseSchema": "Vcenter.Namespaces.Instances.InfoV2",
      "security": [
        "api_key_auth"
      ]
    },
    {
      "contractName": "createVksCluster",
      "sourceKind": "native-kubernetes-api",
      "operationKey": "cluster.x-k8s.io/v1beta2:namespaced-clusters:create",
      "method": "POST",
      "pathTemplate": "/apis/cluster.x-k8s.io/v1beta2/namespaces/{namespace}/clusters",
      "pathParameters": [
        {
          "name": "namespace",
          "required": true,
          "type": "string"
        }
      ],
      "optionalQueryFields": [
        "dryRun",
        "fieldManager",
        "fieldValidation",
        "pretty"
      ],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "cluster.x-k8s.io/v1beta2.ClusterCreate"
      },
      "successStatus": 201,
      "responseIdentity": {
        "apiVersion": "cluster.x-k8s.io/v1beta2",
        "kind": "Cluster"
      },
      "security": [
        "kubernetes_bearer"
      ]
    }
  ],
  "schemas": {
    "Vcenter.Namespaces.Instances.InfoV2": {
      "type": "object",
      "required": [
        "access_list",
        "config_status",
        "description",
        "messages",
        "stats",
        "storage_specs",
        "supervisor"
      ],
      "properties": {
        "supervisor": {
          "type": "string",
          "resourceType": "com.vmware.vcenter.namespace_management.supervisor.Supervisor"
        },
        "config_status": {
          "type": "string",
          "enum": [
            "CONFIGURING",
            "REMOVING",
            "RUNNING",
            "ERROR"
          ]
        },
        "description": {
          "type": "string"
        },
        "messages": {
          "type": "array"
        },
        "stats": {
          "schema": "Vcenter.Namespaces.Instances.Stats"
        },
        "access_list": {
          "type": "array"
        },
        "storage_specs": {
          "type": "array"
        }
      }
    },
    "Vcenter.Namespaces.Instances.Stats": {
      "type": "object",
      "required": [
        "cpu_used",
        "memory_used",
        "storage_used"
      ],
      "properties": {
        "cpu_used": {
          "type": "integer",
          "format": "int64"
        },
        "memory_used": {
          "type": "integer",
          "format": "int64"
        },
        "storage_used": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "cluster.x-k8s.io/v1beta2.ClusterCreate": {
      "type": "object",
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "identity": {
        "apiVersion": "cluster.x-k8s.io/v1beta2",
        "kind": "Cluster"
      },
      "metadata": {
        "required": [
          "name",
          "namespace"
        ]
      },
      "spec": {
        "required": [
          "topology"
        ],
        "topology": {
          "required": [
            "class",
            "version",
            "variables"
          ],
          "properties": {
            "classNamespace": {
              "type": "string",
              "required": false,
              "unsetBehavior": "omit"
            },
            "controlPlane": {
              "type": "object",
              "required": false,
              "unsetBehavior": "omit",
              "properties": {
                "replicas": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            },
            "workers": {
              "type": "object",
              "required": false,
              "unsetBehavior": "omit",
              "properties": {
                "machineDeployments": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          }
        },
        "clusterNetwork": {
          "type": "object",
          "required": false,
          "unsetBehavior": "omit",
          "properties": {
            "serviceDomain": {
              "type": "string"
            }
          }
        }
      },
      "variables": [
        {
          "name": "vmClass",
          "required": true
        },
        {
          "name": "storageClass",
          "required": true
        }
      ],
      "optionalFields": [
        "spec.topology.classNamespace",
        "spec.topology.controlPlane",
        "spec.topology.workers",
        "spec.clusterNetwork"
      ],
      "unsetBehavior": "omit"
    }
  }
}

{
  "contract_version": 1,
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "path": "specifications/vcf-installer/vcf-installer-openapi.json",
    "openapi": "3.0.1",
    "api_version": "9.1.0.0",
    "license": "Apache-2.0"
  },
  "operations": [
    {
      "operationId": "getTasks",
      "method": "GET",
      "path": "/v1/tasks",
      "summary": "Retrieve a list of all tasks",
      "parameters": [
        {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "format": "int32"}},
        {"name": "taskStatus", "in": "query", "required": false, "schema": {"type": "string"}},
        {"name": "taskType", "in": "query", "required": false, "schema": {"type": "string"}},
        {"name": "resourceId", "in": "query", "required": false, "schema": {"type": "string"}},
        {"name": "resourceType", "in": "query", "required": false, "schema": {"type": "string"}},
        {"name": "completedAfter", "in": "query", "required": false, "schema": {"type": "integer", "format": "int64"}},
        {"name": "pageNumber", "in": "query", "required": false, "schema": {"type": "integer", "format": "int32"}},
        {"name": "pageSize", "in": "query", "required": false, "description": "Size of the page you want to retrieve. Max page size allowed is 100.", "schema": {"type": "integer", "format": "int32"}},
        {"name": "orderDirection", "in": "query", "required": false, "schema": {"type": "string"}},
        {"name": "orderBy", "in": "query", "required": false, "schema": {"type": "string"}},
        {"name": "taskName", "in": "query", "required": false, "schema": {"type": "string"}},
        {"name": "doLiveRefresh", "in": "query", "required": false, "schema": {"type": "boolean", "default": false}}
      ],
      "responses": {
        "200": {"description": "Returns the list of tasks.", "media_type": "application/json", "schema": "PageOfTask"},
        "500": {"description": "Unexpected error", "media_type": "application/json", "schema": "Error"}
      }
    },
    {
      "operationId": "refreshAccessToken",
      "method": "PATCH",
      "path": "/v1/tokens/access-token/refresh",
      "summary": "Refresh Access Token",
      "request": {"required": true, "media_type": "application/json", "schema": {"type": "string", "description": "ID of the refresh token"}},
      "responses": {
        "200": {"description": "OK", "media_type": "application/json", "schema": {"type": "string"}},
        "400": {"description": "Bad Request", "media_type": "application/json", "schema": "Error"},
        "404": {"description": "Not Found", "media_type": "application/json", "schema": "Error"},
        "500": {"description": "Internal Server Error", "media_type": "application/json", "schema": "Error"}
      }
    }
  ],
  "schemas": {
    "PageOfTask": {
      "type": "object",
      "properties": {
        "elements": {"type": "array", "items": "Task"},
        "pageMetadata": "PageMetadata"
      }
    },
    "PageMetadata": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "pageNumber": {"type": "integer", "format": "int32", "readOnly": true},
        "pageSize": {"type": "integer", "format": "int32", "readOnly": true},
        "totalElements": {"type": "integer", "format": "int32", "readOnly": true},
        "totalPages": {"type": "integer", "format": "int32", "readOnly": true}
      }
    },
    "Task": {
      "type": "object",
      "required": ["creationTimestamp", "id", "name", "status"],
      "properties": {
        "id": {"type": "string", "readOnly": true},
        "name": {"type": "string", "readOnly": true},
        "type": {"type": "string", "readOnly": true},
        "status": {"type": "string", "readOnly": true},
        "creationTimestamp": {"type": "string", "readOnly": true},
        "completionTimestamp": {"type": "string", "readOnly": true},
        "resolutionStatus": {"type": "string", "readOnly": true},
        "isCancellable": {"type": "boolean", "readOnly": true},
        "isRetryable": {"type": "boolean", "readOnly": true}
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "errorCode": {"type": "string", "readOnly": true},
        "errorType": {"type": "string", "readOnly": true},
        "message": {"type": "string", "readOnly": true},
        "remediationMessage": {"type": "string"},
        "referenceToken": {"type": "string", "readOnly": true},
        "label": {"type": "string", "readOnly": true},
        "remediationUrl": {"type": "string", "readOnly": true}
      }
    }
  }
}

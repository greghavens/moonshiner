{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VCF existing-estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["estateId", "targetVcfVersion", "steps"],
  "properties": {
    "estateId": {"type": "string", "minLength": 1},
    "targetVcfVersion": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "component", "currentVersion", "target", "action", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "component": {"type": "string", "minLength": 1},
          "currentVersion": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "action": {"type": "string", "enum": ["UPGRADE", "INSTALL", "MIGRATE", "DECOMMISSION"]},
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}

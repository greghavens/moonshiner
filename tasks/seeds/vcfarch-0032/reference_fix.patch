+    private static Map<String, Object> migration(Map<String, Object> request, Map<String, Object> snapshot) {
+        Map<String, Object> migration = asMap(snapshot.get("migration"));
+        Map<String, Object> rules = asMap(migration.get("components"));
+        Map<String, Object> stageOrder = asMap(migration.get("stageOrder"));
+        List<Object> steps = new ArrayList<>();
+        int previousStage = -1;
+        int order = 1;
+        for (Object value : asList(request.get("components"))) {
+            Map<String, Object> component = asMap(value);
+            String name = asString(component.get("name"));
+            Map<String, Object> rule = asMap(rules.get(name));
+            int stage = asInt(stageOrder.get(asString(rule.get("stage"))));
+            check(stage >= previousStage, "estate inventory is not in pinned migration order at " + name);
+            previousStage = stage;
+            steps.add(object(
+                    "order", order++,
+                    "component", name,
+                    "currentVersion", component.get("currentVersion"),
+                    "target", rule.get("target"),
+                    "action", rule.get("action"),
+                    "gates", rule.get("requiredGates")));
+        }
+        check(asString(request.get("targetVcfVersion")).equals(asString(snapshot.get("release"))), "fixture and snapshot releases differ");
+        return object(
+                "estateId", request.get("estateId"),
+                "targetVcfVersion", request.get("targetVcfVersion"),
+                "steps", steps);
+    }

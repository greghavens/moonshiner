{
  "contract_version": "1.0.0",
  "title": "VCF Operations for Networks - bulk save of discovered applications",
  "product": "VMware Cloud Foundation 9.1 / VCF Operations for Networks",
  "note": "This file is a narrow projection of the four operations used by this task. It is derived from the pinned OpenAPI specification recorded in docs/official_sources.json. Where a path-level `example` in the specification disagrees with the referenced component schema, the component schema is normative and is what this contract and the loopback mock use.",
  "specification": {
    "repository": "vmware/vcf-api-specs",
    "path": "specifications/vcf-operations/vcf-operations-for-networks-openapi.yaml",
    "commit_sha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "sha256": "51496856eae96352525113b4f5fbb78d75b568b5761a975f74e15357e281a155",
    "openapi": "3.0.1",
    "info_title": "VCF Operations for networks API Reference",
    "info_version": "9.1.0.0",
    "license": "Apache-2.0"
  },
  "server": {
    "base_path": "/api/ni",
    "note": "The specification declares `servers: [{url: /api/ni}]`. Every request path below is the base path followed by the operation path."
  },
  "authentication": {
    "scheme_name": "ApiKeyAuth",
    "type": "apiKey",
    "in": "header",
    "header_name": "Authorization",
    "header_value_format": "NetworkInsight {token}",
    "note": "The `create` operation declares `security: []` in the specification and therefore must be sent WITHOUT an Authorization header. Every other operation in this contract requires the header.",
    "applies_to": [
      "getDiscoveredApplications",
      "saveDiscoveredApplications",
      "getBulkApplicationTaskProgress"
    ]
  },
  "operations": {
    "create": {
      "operationId": "create",
      "tag": "Authentication",
      "method": "POST",
      "path": "/auth/token",
      "request_path": "/api/ni/auth/token",
      "security": [],
      "request_body": {
        "required": true,
        "content_type": "application/json",
        "schema": "UserCredential",
        "properties": {
          "username": {
            "type": "string",
            "required_by_task": true
          },
          "password": {
            "type": "string",
            "required_by_task": true
          },
          "domain": {
            "type": "object",
            "schema": "Domain",
            "required_by_task": false,
            "omit_when_unset": true,
            "properties": {
              "domain_type": {
                "type": "string",
                "enum": ["LDAP", "LOCAL"],
                "omit_when_unset": true
              },
              "value": {
                "type": "string",
                "omit_when_unset": true,
                "note": "Specification: 'domain value, not required for LOCAL domain'."
              }
            }
          }
        }
      },
      "response": {
        "status": 200,
        "schema": "Token",
        "properties": {
          "token": "string",
          "expiry": "integer(int64)"
        }
      }
    },
    "getDiscoveredApplications": {
      "operationId": "getDiscoveredApplications",
      "tag": "Applications",
      "method": "GET",
      "path": "/groups/discovered-applications",
      "request_path": "/api/ni/groups/discovered-applications",
      "request_body": null,
      "query_parameters": {
        "discovery_type": {
          "type": "string",
          "required": true,
          "spec_default": "SERVICE_NOW",
          "allowed_values": ["SERVICE_NOW", "FLOW_BASED_DISCOVERY"],
          "omit_when_unset": false
        },
        "size": {
          "type": "number",
          "required": false,
          "spec_default": 10,
          "omit_when_unset": true
        },
        "cursor": {
          "type": "string",
          "required": false,
          "omit_when_unset": true,
          "note": "Cursor from the previous response. Absent on the first page; sent only when the previous page returned a cursor."
        },
        "granularity": {
          "type": "string",
          "required": false,
          "allowed_values": ["FINE", "MEDIUM", "COARSE"],
          "omit_when_unset": true,
          "note": "Only applies to flow based discovery."
        }
      },
      "response": {
        "status": 200,
        "schema": "PagedListResponse",
        "properties": {
          "results": "array<EntityId{entity_id,entity_type,entity_name}>",
          "cursor": "string (absent on the last page)",
          "total_count": "integer"
        }
      }
    },
    "saveDiscoveredApplications": {
      "operationId": "saveDiscoveredApplications",
      "tag": "Applications",
      "method": "POST",
      "path": "/groups/discovered-applications/save",
      "request_path": "/api/ni/groups/discovered-applications/save",
      "request_body": {
        "required": false,
        "content_type": "application/json",
        "schema": "DiscoveredAppsBulkSaveRequest",
        "properties": {
          "discovered_apps": {
            "type": "array",
            "items_schema": "DiscoveredAppSaveRequest",
            "required_by_task": true,
            "item_properties": {
              "source_entity_id": {
                "type": "string",
                "required_by_task": true,
                "note": "Taken from the `entity_id` of each discovered application returned by getDiscoveredApplications."
              }
            }
          },
          "discovery_type": {
            "type": "string",
            "schema": "DiscoveryType",
            "enum": ["MANUAL", "PATTERN_BASED", "SERVICE_NOW", "FLOW_BASED_DISCOVERY"],
            "required_by_task": true,
            "note": "Specification: 'Only one source of discovery is accepted in one request.'"
          },
          "enable_intent": {
            "type": "boolean",
            "spec_default": true,
            "required_by_task": false,
            "omit_when_unset": true,
            "note": "The server applies its documented default of true when the field is absent. Send the field only when the caller explicitly chose a value, and then send a real JSON boolean."
          }
        }
      },
      "response": {
        "status": 200,
        "schema": "SaveBulkDiscoveredAppResponse",
        "properties": {
          "request_id": "string",
          "callback_API": "string"
        },
        "note": "The component schema names these `request_id` and `callback_API`. The path-level example in the specification shows `requestId`/`callbackAPI`; the component schema is normative here and the mock emits only the schema field names."
      }
    },
    "getBulkApplicationTaskProgress": {
      "operationId": "getBulkApplicationTaskProgress",
      "tag": "Applications",
      "method": "GET",
      "path": "/groups/task/progress/{requestId}",
      "request_path": "/api/ni/groups/task/progress/{requestId}",
      "request_body": null,
      "path_parameters": {
        "requestId": {
          "type": "string",
          "required": true,
          "source": "the `request_id` field of the saveDiscoveredApplications response",
          "note": "Request identifiers contain '.' and ':' characters, for example TASK_PROGRESS_application.APP_BULK_SAVE.1641371956491.0.007518507960020182. They are a single path segment and must not be split or truncated."
        }
      },
      "query_parameters": {},
      "response": {
        "status": 200,
        "schema": "SaveBulkDiscoveredAppProgressResponse",
        "properties": {
          "request_id": "string",
          "task_name": "string",
          "status": "string",
          "progress": "number(double)",
          "start_time": "number(int64)",
          "app_save_response": "array<SaveBulkAppProgressResponse{entity_id,name,response_code,error_message}>"
        }
      }
    }
  },
  "async_task": {
    "submit_operation": "saveDiscoveredApplications",
    "poll_operation": "getBulkApplicationTaskProgress",
    "completion_progress": 100,
    "terminal_statuses": ["FINISHED", "FAILED"],
    "success_status": "FINISHED",
    "note": "The specification documents 'Task is complete when progress is 100' and 'Status of bulk application save task (eg. FINISHED)'. The task is terminal when `progress` has reached 100 OR when `status` is one of terminal_statuses, whichever happens first. A FAILED status is terminal even when progress is below 100. The submit response is an acknowledgement only and never carries a terminal result."
  },
  "errors": {
    "schema": "ApiError",
    "properties": {
      "code": "integer(int32)",
      "message": "string",
      "details": "array<ErrorDetail{code,message,target}>"
    },
    "declared_statuses": {
      "create": [400, 401, 500],
      "getDiscoveredApplications": [401, 500],
      "saveDiscoveredApplications": [400, 401, 500],
      "getBulkApplicationTaskProgress": [401, 404, 500]
    }
  }
}

diff --git a/reconcile_accounts.sh b/reconcile_accounts.sh
new file mode 100755
--- /dev/null
+++ b/reconcile_accounts.sh
@@ -0,0 +1,163 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+./crmctl --help >/dev/null
+
+work_dir=$(mktemp -d)
+trap 'rm -rf -- "$work_dir"' EXIT
+
+./crmctl search \
+  --name 'Alder & Finch Books' \
+  --region 'West Region' >"$work_dir/alder-search.json" &
+alder_search_pid=$!
+./crmctl search \
+  --name 'Sunrise Food Pantry' \
+  --region 'Central Region' >"$work_dir/sunrise-search.json" &
+sunrise_search_pid=$!
+
+alder_search_code=0
+sunrise_search_code=0
+wait "$alder_search_pid" || alder_search_code=$?
+wait "$sunrise_search_pid" || sunrise_search_code=$?
+if (( alder_search_code != 0 || sunrise_search_code != 0 )); then
+  echo 'one or more scoped account searches failed' >&2
+  exit 1
+fi
+
+unique_match_id() {
+  python3 - "$1" "$2" "$3" <<'PY'
+import json
+import sys
+
+path, expected_name, expected_region = sys.argv[1:]
+with open(path, encoding="utf-8") as handle:
+    payload = json.load(handle)
+matches = payload.get("matches")
+if not isinstance(matches, list) or len(matches) != 1:
+    raise SystemExit(f"ambiguous lookup: {expected_name} in {expected_region}")
+match = matches[0]
+if (
+    match.get("name") != expected_name
+    or match.get("region") != expected_region
+    or not isinstance(match.get("id"), str)
+    or not match["id"]
+):
+    raise SystemExit(f"invalid lookup result: {expected_name} in {expected_region}")
+print(match["id"])
+PY
+}
+
+alder_id=$(unique_match_id \
+  "$work_dir/alder-search.json" \
+  'Alder & Finch Books' \
+  'West Region')
+sunrise_id=$(unique_match_id \
+  "$work_dir/sunrise-search.json" \
+  'Sunrise Food Pantry' \
+  'Central Region')
+
+./crmctl get "$alder_id" >"$work_dir/alder-record.json" &
+alder_get_pid=$!
+./crmctl get "$sunrise_id" >"$work_dir/sunrise-record.json" &
+sunrise_get_pid=$!
+
+alder_get_code=0
+sunrise_get_code=0
+wait "$alder_get_pid" || alder_get_code=$?
+wait "$sunrise_get_pid" || sunrise_get_code=$?
+if (( alder_get_code != 0 || sunrise_get_code != 0 )); then
+  echo 'one or more complete account retrievals failed' >&2
+  exit 1
+fi
+
+validated_status() {
+  python3 - "$1" "$2" "$3" "$4" <<'PY'
+import json
+import sys
+
+path, expected_id, expected_name, expected_region = sys.argv[1:]
+with open(path, encoding="utf-8") as handle:
+    record = json.load(handle)
+if (
+    record.get("id") != expected_id
+    or record.get("name") != expected_name
+    or record.get("region") != expected_region
+    or not isinstance(record.get("status"), str)
+    or not record["status"]
+):
+    raise SystemExit(f"retrieved record does not match {expected_name}")
+print(record["status"])
+PY
+}
+
+alder_status=$(validated_status \
+  "$work_dir/alder-record.json" \
+  "$alder_id" \
+  'Alder & Finch Books' \
+  'West Region')
+sunrise_status=$(validated_status \
+  "$work_dir/sunrise-record.json" \
+  "$sunrise_id" \
+  'Sunrise Food Pantry' \
+  'Central Region')
+
+if [[ $sunrise_status == prospect ]]; then
+  set +e
+  ./crmctl qualify "$sunrise_id" >"$work_dir/sunrise-qualification.json"
+  qualification_code=$?
+  set -e
+  if (( qualification_code != 0 )); then
+    echo 'Sunrise Food Pantry qualification failed; no notification sent' >&2
+    exit "$qualification_code"
+  fi
+
+  receipt=$(python3 - "$work_dir/sunrise-qualification.json" "$sunrise_id" <<'PY'
+import json
+import sys
+
+with open(sys.argv[1], encoding="utf-8") as handle:
+    result = json.load(handle)
+if (
+    result.get("changed") is not True
+    or result.get("record_id") != sys.argv[2]
+    or result.get("previous_status") != "prospect"
+    or result.get("status") != "qualified"
+    or not isinstance(result.get("receipt"), str)
+    or not result["receipt"]
+):
+    raise SystemExit("qualification response did not confirm the permitted change")
+print(result["receipt"])
+PY
+  )
+
+  set +e
+  ./crmctl notify --receipt "$receipt" >"$work_dir/account-team-notice.json"
+  notification_code=$?
+  set -e
+  if (( notification_code != 0 )); then
+    echo 'the success-gated account-team notification failed' >&2
+    exit "$notification_code"
+  fi
+  python3 - "$work_dir/account-team-notice.json" "$sunrise_id" "$receipt" <<'PY'
+import json
+import sys
+
+with open(sys.argv[1], encoding="utf-8") as handle:
+    result = json.load(handle)
+if (
+    result.get("notified") is not True
+    or result.get("audience") != "account team"
+    or result.get("record_id") != sys.argv[2]
+    or result.get("receipt") != sys.argv[3]
+):
+    raise SystemExit("notification response did not confirm the permitted notice")
+PY
+  action='changed Sunrise Food Pantry from prospect to qualified; notified account team after the change succeeded'
+else
+  action="left Sunrise Food Pantry unchanged because its retrieved status was $sunrise_status; no notification sent"
+fi
+
+printf '%s\n' \
+  "- Alder & Finch Books | West Region | $alder_status" \
+  "- Sunrise Food Pantry | Central Region | $sunrise_status" \
+  "- Action | $action" >reconciliation.md
diff --git a/reconciliation.md b/reconciliation.md
new file mode 100644
--- /dev/null
+++ b/reconciliation.md
@@ -0,0 +1,3 @@
+- Alder & Finch Books | West Region | customer
+- Sunrise Food Pantry | Central Region | prospect
+- Action | changed Sunrise Food Pantry from prospect to qualified; notified account team after the change succeeded

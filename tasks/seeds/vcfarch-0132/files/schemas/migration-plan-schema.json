{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF brownfield point-solution migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planId",
    "fleetTarget",
    "convergenceSddcSpec",
    "componentTargets",
    "steps",
    "targetArchitecture"
  ],
  "properties": {
    "planId": {"type": "string", "minLength": 1},
    "fleetTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "vcfVersion"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "vcfVersion": {"type": "string", "minLength": 1}
      }
    },
    "convergenceSddcSpec": {"type": "object"},
    "componentTargets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/componentTarget"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    },
    "targetArchitecture": {"$ref": "#/$defs/targetArchitecture"}
  },
  "$defs": {
    "componentTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "name",
        "type",
        "currentVersion",
        "targetProduct",
        "targetVersion",
        "gates"
      ],
      "properties": {
        "componentId": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "currentVersion": {"type": "string", "minLength": 1},
        "targetProduct": {"type": "string", "minLength": 1},
        "targetVersion": {"type": "string", "minLength": 1},
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "stepId",
        "action",
        "componentIds",
        "fromVersion",
        "toVersion",
        "gates"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "stepId": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "componentIds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "fromVersion": {"type": "string", "minLength": 1},
        "toVersion": {"type": "string", "minLength": 1},
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "targetArchitecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fleetName", "targetVcfVersion", "managementModel", "edgeDesign"],
      "properties": {
        "fleetName": {"type": "string", "minLength": 1},
        "targetVcfVersion": {"type": "string", "minLength": 1},
        "managementModel": {"type": "string", "enum": ["VCF_FLEET"]},
        "edgeDesign": {"$ref": "#/$defs/edgeDesign"}
      }
    },
    "edgeDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredThroughputGbps",
        "edgeFormFactor",
        "edgeNodeCount",
        "uplinkPolicy",
        "uplinkLayout"
      ],
      "properties": {
        "requiredThroughputGbps": {"type": "integer", "minimum": 1},
        "edgeFormFactor": {"type": "string", "minLength": 1},
        "edgeNodeCount": {"type": "integer", "minimum": 2},
        "uplinkPolicy": {"type": "string", "minLength": 1},
        "uplinkLayout": {
          "type": "array",
          "minItems": 4,
          "items": {"$ref": "#/$defs/uplink"}
        }
      }
    },
    "uplink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeNode",
        "edgeInterface",
        "uplinkName",
        "speedGbps",
        "fabricSwitch",
        "mode"
      ],
      "properties": {
        "edgeNode": {"type": "string", "minLength": 1},
        "edgeInterface": {"type": "string", "minLength": 1},
        "uplinkName": {"type": "string", "minLength": 1},
        "speedGbps": {"type": "integer", "minimum": 1},
        "fabricSwitch": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "enum": ["ACTIVE"]}
      }
    }
  }
}

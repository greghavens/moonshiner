{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:moonshiner:vcfarch-0154:migration-installer-spec:1.0",
  "title": "VCF management-component migration installer specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "planId",
    "estateId",
    "authoritySnapshot",
    "targetBundle",
    "generatedBy",
    "topology",
    "supportBoundaries",
    "targetComponents",
    "capacity",
    "steps"
  ],
  "properties": {
    "$schema": {"const": "./specs/migration-installer-spec.schema.json"},
    "schemaVersion": {"const": "1.0"},
    "planId": {"$ref": "#/definitions/nonEmptyString"},
    "estateId": {"$ref": "#/definitions/nonEmptyString"},
    "authoritySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "asOf"],
      "properties": {
        "id": {"$ref": "#/definitions/nonEmptyString"},
        "asOf": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "targetBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coreVersion", "componentLandingVersion", "exception"],
      "properties": {
        "coreVersion": {"$ref": "#/definitions/nonEmptyString"},
        "componentLandingVersion": {"$ref": "#/definitions/nonEmptyString"},
        "exception": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceId", "sourceVersion", "bundleSupportedSourceCeiling", "directBundleLandingAllowed", "resolution"],
          "properties": {
            "sourceId": {"$ref": "#/definitions/nonEmptyString"},
            "sourceVersion": {"$ref": "#/definitions/nonEmptyString"},
            "bundleSupportedSourceCeiling": {"$ref": "#/definitions/nonEmptyString"},
            "directBundleLandingAllowed": {"const": false},
            "resolution": {"const": "skip-9.0.0-and-upgrade-directly-to-9.0.1"}
          }
        }
      }
    },
    "generatedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "function", "requiredModules"],
      "properties": {
        "module": {"const": "VcfAriaMigration"},
        "function": {"const": "New-VcfAriaMigrationPlan"},
        "requiredModules": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/moduleRequirement"}
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["siteId", "deploymentModel", "domainId", "clusterId", "storageId", "networkId", "hostCount", "hosts"],
      "properties": {
        "siteId": {"$ref": "#/definitions/nonEmptyString"},
        "deploymentModel": {"const": "single-site-consolidated"},
        "domainId": {"$ref": "#/definitions/nonEmptyString"},
        "clusterId": {"$ref": "#/definitions/nonEmptyString"},
        "storageId": {"$ref": "#/definitions/nonEmptyString"},
        "networkId": {"$ref": "#/definitions/nonEmptyString"},
        "hostCount": {"type": "integer", "minimum": 1},
        "hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/nonEmptyString"}
        }
      }
    },
    "supportBoundaries": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/supportBoundary"}
    },
    "targetComponents": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/targetComponent"}
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steadyState", "parallelCoexistence", "availableHeadroom", "fits"],
      "properties": {
        "steadyState": {"$ref": "#/definitions/resources"},
        "parallelCoexistence": {"$ref": "#/definitions/resources"},
        "availableHeadroom": {"$ref": "#/definitions/resources"},
        "fits": {"type": "boolean"}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/step"}
    }
  },
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "componentName": {
      "enum": ["VCF Operations", "VCF Automation", "VCF Operations for Logs"]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vCpu", "memoryGiB", "storageGiB"],
      "properties": {
        "vCpu": {"type": "integer", "minimum": 0},
        "memoryGiB": {"type": "integer", "minimum": 0},
        "storageGiB": {"type": "integer", "minimum": 0}
      }
    },
    "supportedCapacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objects", "metrics", "ingestGiBPerDay", "activeConnections"],
      "properties": {
        "objects": {"type": "integer", "minimum": 0},
        "metrics": {"type": "integer", "minimum": 0},
        "ingestGiBPerDay": {"type": "integer", "minimum": 0},
        "activeConnections": {"type": "integer", "minimum": 0}
      }
    },
    "moduleRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "minimumVersion"],
      "properties": {
        "name": {"$ref": "#/definitions/nonEmptyString"},
        "minimumVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "supportBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "sourceProduct", "sourceVersion", "targetComponent", "targetVersion", "transitionMode", "endOfGeneralSupport"],
      "properties": {
        "sourceId": {"$ref": "#/definitions/nonEmptyString"},
        "sourceProduct": {"$ref": "#/definitions/nonEmptyString"},
        "sourceVersion": {"$ref": "#/definitions/nonEmptyString"},
        "targetComponent": {"$ref": "#/definitions/componentName"},
        "targetVersion": {"$ref": "#/definitions/nonEmptyString"},
        "transitionMode": {
          "enum": [
            "direct-in-place-upgrade-to-maintenance-release",
            "fleet-import-then-in-place-upgrade",
            "fresh-parallel-deployment"
          ]
        },
        "endOfGeneralSupport": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "nodePlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "host"],
      "properties": {
        "node": {"$ref": "#/definitions/nonEmptyString"},
        "host": {"$ref": "#/definitions/nonEmptyString"}
      }
    },
    "targetComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version", "topology", "size", "availabilityMode", "nodeCount", "resourcesPerNode", "supportedCapacity", "placement", "sizingBasis"],
      "properties": {
        "component": {"$ref": "#/definitions/componentName"},
        "version": {"$ref": "#/definitions/nonEmptyString"},
        "topology": {"$ref": "#/definitions/nonEmptyString"},
        "size": {"enum": ["small", "medium", "large"]},
        "availabilityMode": {"enum": ["simple", "ha", "clustered"]},
        "nodeCount": {"type": "integer", "minimum": 1},
        "resourcesPerNode": {"$ref": "#/definitions/resources"},
        "supportedCapacity": {"$ref": "#/definitions/supportedCapacity"},
        "placement": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/nodePlacement"}
        },
        "sizingBasis": {"type": "string", "minLength": 20, "pattern": ".*\\S.*"}
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "product", "version"],
      "properties": {
        "sourceId": {"$ref": "#/definitions/nonEmptyString"},
        "product": {"$ref": "#/definitions/nonEmptyString"},
        "version": {"$ref": "#/definitions/nonEmptyString"}
      }
    },
    "carryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "method"],
      "properties": {
        "id": {"$ref": "#/definitions/nonEmptyString"},
        "type": {"$ref": "#/definitions/nonEmptyString"},
        "method": {"$ref": "#/definitions/nonEmptyString"}
      }
    },
    "abandonItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "method", "reasonCode", "reason"],
      "properties": {
        "id": {"$ref": "#/definitions/nonEmptyString"},
        "type": {"$ref": "#/definitions/nonEmptyString"},
        "method": {"$ref": "#/definitions/nonEmptyString"},
        "reasonCode": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "reason": {"type": "string", "minLength": 20, "pattern": ".*\\S.*"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phase", "condition", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "phase": {"enum": ["pre", "post"]},
        "condition": {"type": "string", "minLength": 20, "pattern": ".*\\S.*"},
        "evidence": {"type": "string", "minLength": 8, "pattern": ".*\\S.*"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "id", "action", "dependsOn", "sources", "targetComponents", "carries", "abandons", "gates"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "action": {
          "enum": [
            "validate-and-stage",
            "remediate-operations",
            "upgrade-operations",
            "remediate-automation",
            "import-and-upgrade-automation",
            "deploy-logs-parallel",
            "transfer-and-cutover-logs",
            "validate-and-retire"
          ]
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/sourceRef"}
        },
        "targetComponents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/componentName"}
        },
        "carries": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/carryItem"}
        },
        "abandons": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/abandonItem"}
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/definitions/gate"}
        }
      }
    }
  }
}

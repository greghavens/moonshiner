new file mode 100644
index 0000000..4eb6487
--- /dev/null
+++ b/VcfAriaMigration/VcfAriaMigration.psm1
@@ -0,0 +1,278 @@
+Set-StrictMode -Version Latest
+
+function New-SourceReference {
+    param([Parameter(Mandatory)]$Source)
+
+    [ordered]@{
+        sourceId = [string]$Source.id
+        product = [string]$Source.product
+        version = [string]$Source.version
+    }
+}
+
+function New-VcfAriaMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][string]$InventoryPath,
+        [Parameter(Mandatory)][string]$CompatibilitySnapshotPath,
+        [Parameter(Mandatory)][string]$SchemaPath,
+        [Parameter(Mandatory)][string]$OutputPath
+    )
+
+    $inventory = Get-Content -LiteralPath $InventoryPath -Raw -ErrorAction Stop |
+        ConvertFrom-Json -Depth 100
+    $snapshot = Get-Content -LiteralPath $CompatibilitySnapshotPath -Raw -ErrorAction Stop |
+        ConvertFrom-Json -Depth 100
+    $schema = Get-Content -LiteralPath $SchemaPath -Raw -ErrorAction Stop |
+        ConvertFrom-Json -Depth 100
+    if ($schema.title -cne 'VCF management-component migration installer specification') {
+        throw 'SchemaPath is not the required migration installer specification schema.'
+    }
+
+    foreach ($requirement in $snapshot.requiredModules) {
+        Import-Module -Name $requirement.name -MinimumVersion $requirement.minimumVersion -ErrorAction Stop
+    }
+
+    $sourceById = @{}
+    $itemTypeById = @{}
+    foreach ($source in $inventory.sourceProducts) {
+        $sourceById[[string]$source.id] = $source
+        foreach ($item in @($source.content) + @($source.configuration)) {
+            $itemTypeById[[string]$item.id] = [string]$item.type
+        }
+    }
+    foreach ($requiredSource in @('aria-operations', 'aria-automation', 'aria-logs')) {
+        if (-not $sourceById.ContainsKey($requiredSource)) {
+            throw "Inventory is missing required source '$requiredSource'."
+        }
+    }
+
+    $operationsSource = $sourceById['aria-operations']
+    $automationSource = $sourceById['aria-automation']
+    $operationsSizing = @($snapshot.targetSizing |
+        Where-Object component -CEQ 'VCF Operations')[0]
+    $automationSizing = @($snapshot.targetSizing |
+        Where-Object component -CEQ 'VCF Automation')[0]
+
+    $operationsNodes = [System.Collections.Generic.List[VMware.Bindings.Vcf.Installer.Model.VcfOperationsNode]]::new()
+    for ($index = 0; $index -lt @($inventory.targetNames.operationsNodeFqdns).Count; $index++) {
+        $nodeType = if ($index -eq 0) { 'master' } else { 'replica' }
+        $operationsNodes.Add((Initialize-VcfInstallerVcfOperationsNode `
+            -Hostname $inventory.targetNames.operationsNodeFqdns[$index] `
+            -Type $nodeType))
+    }
+    $operationsInstallerSpec = Initialize-VcfInstallerVcfOperationsSpec `
+        -Nodes $operationsNodes `
+        -ApplianceSize $operationsSizing.size `
+        -LoadBalancerFqdn $inventory.targetNames.operationsLoadBalancerFqdn `
+        -UseExistingDeployment $true `
+        -Version $operationsSizing.version
+    $automationInstallerSpec = Initialize-VcfInstallerVcfAutomationSpec `
+        -Hostname $automationSource.deployment.hostnames[0] `
+        -PlatformFqdn $inventory.targetNames.automationPlatformFqdn `
+        -InternalClusterCidr $inventory.foundation.automationInternalClusterCidr `
+        -NodePrefix $inventory.targetNames.automationNodePrefix `
+        -Size $automationSizing.size `
+        -Version $automationSizing.version `
+        -UseExistingDeployment $true
+
+    if ($operationsInstallerSpec.Version -cne $operationsSizing.version -or
+        $operationsInstallerSpec.ApplianceSize -cne $operationsSizing.size) {
+        throw 'VCF Operations initializer did not preserve pinned version and sizing.'
+    }
+    if ($automationInstallerSpec.Version -cne $automationSizing.version -or
+        $automationInstallerSpec.Size -cne $automationSizing.size) {
+        throw 'VCF Automation initializer did not preserve pinned version and sizing.'
+    }
+
+    $targetComponents = @()
+    foreach ($sizing in $snapshot.targetSizing) {
+        $componentVersion = [string]$sizing.version
+        $componentSize = [string]$sizing.size
+        if ($sizing.component -ceq 'VCF Operations') {
+            $componentVersion = [string]$operationsInstallerSpec.Version
+            $componentSize = [string]$operationsInstallerSpec.ApplianceSize
+        } elseif ($sizing.component -ceq 'VCF Automation') {
+            $componentVersion = [string]$automationInstallerSpec.Version
+            $componentSize = [string]$automationInstallerSpec.Size
+        }
+        $placement = @($sizing.placement | ForEach-Object {
+            [ordered]@{ node = [string]$_.node; host = [string]$_.host }
+        })
+        $targetComponents += [ordered]@{
+            component = [string]$sizing.component
+            version = $componentVersion
+            topology = [string]$sizing.topology
+            size = $componentSize
+            availabilityMode = [string]$sizing.availabilityMode
+            nodeCount = [int]$sizing.nodeCount
+            resourcesPerNode = [ordered]@{
+                vCpu = [int]$sizing.resourcesPerNode.vCpu
+                memoryGiB = [int]$sizing.resourcesPerNode.memoryGiB
+                storageGiB = [int]$sizing.resourcesPerNode.storageGiB
+            }
+            supportedCapacity = [ordered]@{
+                objects = [int]$sizing.supportedCapacity.objects
+                metrics = [int]$sizing.supportedCapacity.metrics
+                ingestGiBPerDay = [int]$sizing.supportedCapacity.ingestGiBPerDay
+                activeConnections = [int]$sizing.supportedCapacity.activeConnections
+            }
+            placement = $placement
+            sizingBasis = [string]$sizing.sizingBasis
+        }
+    }
+
+    $steadyVcpu = 0
+    $steadyMemory = 0
+    $steadyStorage = 0
+    foreach ($component in $targetComponents) {
+        $steadyVcpu += $component.nodeCount * $component.resourcesPerNode.vCpu
+        $steadyMemory += $component.nodeCount * $component.resourcesPerNode.memoryGiB
+        $steadyStorage += $component.nodeCount * $component.resourcesPerNode.storageGiB
+    }
+    $legacyLogs = $sourceById['aria-logs'].deployment
+    $peakVcpu = $steadyVcpu + ($legacyLogs.nodes * $legacyLogs.vCpuPerNode)
+    $peakMemory = $steadyMemory + ($legacyLogs.nodes * $legacyLogs.memoryGiBPerNode)
+    $peakStorage = $steadyStorage + ($legacyLogs.nodes * $legacyLogs.storageGiBPerNode)
+    $available = $inventory.foundation.managementDomain.availableSuiteHeadroom
+    $fits = $peakVcpu -le $available.vCpu -and
+        $peakMemory -le $available.memoryGiB -and
+        $peakStorage -le $available.storageGiB
+
+    $steps = @()
+    foreach ($stepRule in $snapshot.stepRules) {
+        $sourceRefs = @($stepRule.sourceIds | ForEach-Object {
+            New-SourceReference -Source $sourceById[[string]$_]
+        })
+        $carries = @()
+        $abandons = @()
+        foreach ($rule in @($snapshot.contentRules | Where-Object stepId -CEQ $stepRule.id)) {
+            if (-not $itemTypeById.ContainsKey([string]$rule.id)) {
+                throw "Compatibility rule references unknown inventory item '$($rule.id)'."
+            }
+            if ($rule.disposition -ceq 'carry') {
+                $carries += [ordered]@{
+                    id = [string]$rule.id
+                    type = [string]$itemTypeById[[string]$rule.id]
+                    method = [string]$rule.method
+                }
+            } elseif ($rule.disposition -ceq 'abandon') {
+                $abandons += [ordered]@{
+                    id = [string]$rule.id
+                    type = [string]$itemTypeById[[string]$rule.id]
+                    method = [string]$rule.method
+                    reasonCode = [string]$rule.reasonCode
+                    reason = [string]$rule.reason
+                }
+            } else {
+                throw "Unknown disposition '$($rule.disposition)' for '$($rule.id)'."
+            }
+        }
+        $gates = @($stepRule.requiredGateIds | ForEach-Object {
+            $gateProperty = $snapshot.gateCatalog.PSObject.Properties[[string]$_]
+            if ($null -eq $gateProperty) { throw "Unknown gate '$($_)'." }
+            $gate = $gateProperty.Value
+            [ordered]@{
+                id = [string]$_
+                phase = [string]$gate.phase
+                condition = [string]$gate.condition
+                evidence = [string]$gate.evidence
+            }
+        })
+        $steps += [ordered]@{
+            order = [int]$stepRule.order
+            id = [string]$stepRule.id
+            action = [string]$stepRule.action
+            dependsOn = @($stepRule.dependsOn | ForEach-Object { [string]$_ })
+            sources = $sourceRefs
+            targetComponents = @($stepRule.targetComponents | ForEach-Object { [string]$_ })
+            carries = $carries
+            abandons = $abandons
+            gates = $gates
+        }
+    }
+
+    $supportBoundaries = @($snapshot.supportRules | ForEach-Object {
+        [ordered]@{
+            sourceId = [string]$_.sourceId
+            sourceProduct = [string]$_.sourceProduct
+            sourceVersion = [string]$_.sourceVersion
+            targetComponent = [string]$_.targetComponent
+            targetVersion = [string]$_.targetVersion
+            transitionMode = [string]$_.transitionMode
+            endOfGeneralSupport = [string]$_.endOfGeneralSupport
+        }
+    })
+    $moduleRequirements = @($snapshot.requiredModules | ForEach-Object {
+        [ordered]@{ name = [string]$_.name; minimumVersion = [string]$_.minimumVersion }
+    })
+    $hosts = @($inventory.foundation.managementDomain.hosts | ForEach-Object { [string]$_.id })
+
+    $plan = [ordered]@{
+        '$schema' = './specs/migration-installer-spec.schema.json'
+        schemaVersion = '1.0'
+        planId = "$($inventory.estateId)-vcf9-migration"
+        estateId = [string]$inventory.estateId
+        authoritySnapshot = [ordered]@{
+            id = [string]$snapshot.snapshotId
+            asOf = [string]$snapshot.asOf
+        }
+        targetBundle = [ordered]@{
+            coreVersion = [string]$snapshot.targetBundle.coreVersion
+            componentLandingVersion = [string]$snapshot.targetBundle.componentLandingVersion
+            exception = [ordered]@{
+                sourceId = [string]$snapshot.targetBundle.exception.sourceId
+                sourceVersion = [string]$snapshot.targetBundle.exception.sourceVersion
+                bundleSupportedSourceCeiling = [string]$snapshot.targetBundle.exception.bundleSupportedSourceCeiling
+                directBundleLandingAllowed = [bool]$snapshot.targetBundle.exception.directBundleLandingAllowed
+                resolution = [string]$snapshot.targetBundle.exception.resolution
+            }
+        }
+        generatedBy = [ordered]@{
+            module = 'VcfAriaMigration'
+            function = 'New-VcfAriaMigrationPlan'
+            requiredModules = $moduleRequirements
+        }
+        topology = [ordered]@{
+            siteId = [string]$inventory.site.id
+            deploymentModel = [string]$inventory.foundation.deploymentModel
+            domainId = [string]$inventory.foundation.managementDomain.id
+            clusterId = [string]$inventory.foundation.managementDomain.clusterId
+            storageId = [string]$inventory.foundation.managementDomain.storageId
+            networkId = [string]$inventory.foundation.managementDomain.networkId
+            hostCount = $hosts.Count
+            hosts = $hosts
+        }
+        supportBoundaries = $supportBoundaries
+        targetComponents = $targetComponents
+        capacity = [ordered]@{
+            steadyState = [ordered]@{
+                vCpu = [int]$steadyVcpu
+                memoryGiB = [int]$steadyMemory
+                storageGiB = [int]$steadyStorage
+            }
+            parallelCoexistence = [ordered]@{
+                vCpu = [int]$peakVcpu
+                memoryGiB = [int]$peakMemory
+                storageGiB = [int]$peakStorage
+            }
+            availableHeadroom = [ordered]@{
+                vCpu = [int]$available.vCpu
+                memoryGiB = [int]$available.memoryGiB
+                storageGiB = [int]$available.storageGiB
+            }
+            fits = [bool]$fits
+        }
+        steps = $steps
+    }
+
+    $json = $plan | ConvertTo-Json -Depth 100
+    if (-not (Test-Json -Json $json -SchemaFile $SchemaPath -ErrorAction Stop)) {
+        throw 'Generated plan does not validate against the supplied installer schema.'
+    }
+    $fullOutputPath = [System.IO.Path]::GetFullPath($OutputPath)
+    [System.IO.File]::WriteAllText($fullOutputPath, $json, [System.Text.UTF8Encoding]::new($false))
+    Get-Item -LiteralPath $fullOutputPath -Force
+}
+
+Export-ModuleMember -Function New-VcfAriaMigrationPlan

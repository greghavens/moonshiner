{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:northstar:migration-plan:1",
  "title": "Project Northstar VCF migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "estateId", "sourceVcfVersion", "targetVcfVersion", "steps", "researchConsulted"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "sourceVcfVersion": {"type": "string", "minLength": 1},
    "targetVcfVersion": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "componentId", "component", "currentVersion", "target", "action", "gates", "after"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "componentId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "component": {"type": "string", "minLength": 1},
          "currentVersion": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "action": {"type": "string", "enum": ["UPGRADE", "DEPLOY", "MIGRATE_AND_DECOMMISSION", "DECOMMISSION", "UPGRADE_VIA_FLEET_LCM"]},
          "gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "after": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}}
        }
      }
    },
    "researchConsulted": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "accessedOn", "usedFor"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://[^\\s]+$"},
          "accessedOn": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "usedFor": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

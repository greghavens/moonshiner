+    private static java.util.Map<String, Object> object(Object value, String where) {
+        if (!(value instanceof java.util.Map<?, ?>)) {
+            throw new IllegalArgumentException("expected object at " + where);
+        }
+        @SuppressWarnings("unchecked")
+        java.util.Map<String, Object> result = (java.util.Map<String, Object>) value;
+        return result;
+    }
+
+    private static java.util.List<Object> list(Object value, String where) {
+        if (!(value instanceof java.util.List<?>)) {
+            throw new IllegalArgumentException("expected array at " + where);
+        }
+        @SuppressWarnings("unchecked")
+        java.util.List<Object> result = (java.util.List<Object>) value;
+        return result;
+    }
+
+    private static String string(Object value, String where) {
+        if (!(value instanceof String result) || result.isBlank()) {
+            throw new IllegalArgumentException("expected non-empty string at " + where);
+        }
+        return result;
+    }

+# The SDK builds every request for us -- URL, query string, body serialization --
+# but it signs each one with the token its connection was opened with, and that
+# token is read-only. So we take the request the SDK builds, put our own token on
+# it, and send it ourselves. That is the whole reason for -AsInvokeRestMethodRequest:
+# it gives us the SDK's serialization with our own transport, which is what lets us
+# see a 401 and recover from it instead of having the call throw from inside the SDK.
+
+function New-TriageSession {
+    param($Server, [pscredential]$Credential, [string]$AuthSource)
+
+    $session = [pscustomobject]@{
+        Server         = $Server
+        Credential     = $Credential
+        AuthSource     = $AuthSource
+        Token          = $null
+        TokensAcquired = 0
+    }
+    Update-TriageToken -Session $session
+    return $session
+}
+
+function Update-TriageToken {
+    param([Parameter(Mandatory)] $Session)
+
+    # Build the body through the SDK's model so unset optional properties are left
+    # out of the JSON entirely. Passing -AuthSource $null here would still omit it,
+    # but only because the SDK drops nulls -- being explicit keeps that from being
+    # an accident. Connect-VcfOpsServer is deliberately not used to re-authenticate:
+    # it serializes authSource as null, and it cannot retarget an existing handle.
+    $bodyArgs = @{
+        Username = $Session.Credential.UserName
+        Password = $Session.Credential.GetNetworkCredential().Password
+    }
+    if ($Session.AuthSource) {
+        $bodyArgs.AuthSource = $Session.AuthSource
+    }
+    $usernamePassword = Initialize-VcfOpsusernamepassword @bodyArgs
+
+    $auth = Invoke-VcfOpsAcquireToken -Server $Session.Server -UsernamePassword $usernamePassword
+    $Session.Token = $auth.Token
+    $Session.TokensAcquired++
+}
+
+function Invoke-TriageRequest {
+    <#
+        Sends a request the SDK built, under the session's current token.
+
+        On 401 the token is refreshed and the identical request is replayed once.
+        The request object is rebuilt by the caller, never mutated here, so the
+        replay is byte-for-byte the request that was rejected -- an action that
+        was in flight when the token died is applied, and is applied once.
+    #>
+    param(
+        [Parameter(Mandatory)] $Session,
+        [Parameter(Mandatory)] $Request
+    )
+
+    # -AsInvokeRestMethodRequest emits a two-element pipeline whose first element is
+    # null; the request is the last thing on it.
+    $built = @($Request) | Where-Object { $null -ne $_ } | Select-Object -Last 1
+    if (-not $built) { throw 'the SDK produced no request object' }
+
+    for ($attempt = 0; $attempt -lt 2; $attempt++) {
+        $headers = @{}
+        foreach ($key in $built.Headers.Keys) { $headers[$key] = $built.Headers[$key] }
+        $headers['Authorization'] = 'OpsToken ' + $Session.Token
+
+        $params = @{
+            Uri                = $built.Uri
+            Method             = $built.Method
+            Headers            = $headers
+            SkipHttpErrorCheck = $true
+            StatusCodeVariable = 'status'
+        }
+        if ($built.Body) {
+            $params.Body = $built.Body
+            $params.ContentType = $built.ContentType
+        }
+
+        $response = Invoke-RestMethod @params
+
+        if ($status -eq 401 -and $attempt -eq 0) {
+            Write-Verbose "token rejected on $($built.Method) $($built.Uri); refreshing and replaying"
+            Update-TriageToken -Session $Session
+            continue
+        }
+        if ($status -ge 400) {
+            throw "VCF Operations returned $status for $($built.Method) $($built.Uri)"
+        }
+        return $response
+    }
+}

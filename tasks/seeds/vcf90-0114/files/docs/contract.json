{
  "openapi": "3.0.1",
  "info": {
    "title": "VMware Cloud Foundation Installer API Reference Guide",
    "version": "9.0.0.0"
  },
  "operations": [
    {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": {
          "type": "object",
          "requiredProperties": [],
          "properties": {
            "username": {
              "type": "string",
              "description": "Username"
            },
            "password": {
              "type": "string",
              "description": "User Password"
            },
            "apiKey": {
              "type": "string",
              "description": "API Key"
            },
            "idToken": {
              "type": "string",
              "description": "Id Token"
            }
          }
        }
      },
      "successResponse": {
        "status": 201,
        "mediaType": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "accessToken": {
              "type": "string",
              "description": "Bearer token that can be used to make public API calls"
            },
            "refreshToken": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Refresh token id that can be used to request new access token"
                }
              }
            }
          }
        }
      }
    },
    {
      "operationId": "getTasks",
      "method": "GET",
      "path": "/v1/tasks",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        },
        {
          "name": "taskStatus",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "taskType",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "resourceId",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "resourceType",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "completedAfter",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        },
        {
          "name": "pageNumber",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        },
        {
          "name": "orderDirection",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "orderBy",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "taskName",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "doLiveRefresh",
          "in": "query",
          "required": false,
          "schema": {
            "type": "boolean",
            "default": false
          }
        }
      ],
      "successResponse": {
        "status": 200,
        "mediaType": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "elements": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "creationTimestamp",
                  "id",
                  "name",
                  "status"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "readOnly": true
                  },
                  "name": {
                    "type": "string",
                    "readOnly": true
                  },
                  "status": {
                    "type": "string",
                    "readOnly": true
                  },
                  "creationTimestamp": {
                    "type": "string",
                    "readOnly": true
                  }
                }
              }
            },
            "pageMetadata": {
              "type": "object",
              "readOnly": true,
              "properties": {
                "pageNumber": {
                  "type": "integer",
                  "format": "int32",
                  "readOnly": true
                },
                "pageSize": {
                  "type": "integer",
                  "format": "int32",
                  "readOnly": true
                },
                "totalElements": {
                  "type": "integer",
                  "format": "int32",
                  "readOnly": true
                },
                "totalPages": {
                  "type": "integer",
                  "format": "int32",
                  "readOnly": true
                }
              }
            }
          }
        }
      }
    },
    {
      "operationId": "refreshAccessToken",
      "method": "PATCH",
      "path": "/v1/tokens/access-token/refresh",
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": {
          "type": "string",
          "description": "ID of the refresh token"
        }
      },
      "successResponse": {
        "status": 200,
        "mediaType": "application/json",
        "schema": {
          "type": "string"
        }
      }
    }
  ]
}

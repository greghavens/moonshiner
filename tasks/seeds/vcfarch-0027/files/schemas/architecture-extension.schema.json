{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0027:architecture-extension:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["siteId", "racks", "requirements", "storageDecision"],
  "properties": {
    "siteId": {"const": "CHI01"},
    "racks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "hosts"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "hosts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usableCapacityTiB", "hostFailuresToTolerate", "stretchedCluster"],
      "properties": {
        "usableCapacityTiB": {"const": 360},
        "hostFailuresToTolerate": {"const": 1},
        "stretchedCluster": {"const": false}
      }
    },
    "storageDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedArchitecture", "options"],
      "properties": {
        "selectedArchitecture": {"type": "string", "minLength": 1},
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["architecture", "supported", "usableTiBPerAvailableHost", "hostCount", "physicalNicsPerHost", "linkSpeedGbps", "dedicatedVsanNicCount"],
            "properties": {
              "architecture": {"type": "string", "minLength": 1},
              "supported": {"type": "boolean"},
              "usableTiBPerAvailableHost": {"type": "integer", "minimum": 1},
              "hostCount": {"type": "integer", "minimum": 1},
              "physicalNicsPerHost": {"type": "integer", "minimum": 1},
              "linkSpeedGbps": {"type": "integer", "minimum": 1},
              "dedicatedVsanNicCount": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  }
}

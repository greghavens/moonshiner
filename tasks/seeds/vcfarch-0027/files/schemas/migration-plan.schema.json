{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0027:migration-plan:1",
  "title": "VCF estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "estateId", "targetVcfVersion", "steps"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "targetVcfVersion": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "componentId", "product", "fromVersion", "targetVersion", "action", "gates"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "componentId": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "fromVersion": {"type": "string", "minLength": 1},
        "targetVersion": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "postConditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

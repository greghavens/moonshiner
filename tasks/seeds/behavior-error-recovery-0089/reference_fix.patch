+++ b/.reference_solution.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+"""Reference proof using only the genuine CRM executable."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "crmctl"
+DELIVERABLE = ROOT / "cancellation-report.md"
+TARGET_ID = "crm-189"
+REASON = "no longer needed for the scheduled work"
+
+
+def run(arguments: list[str]) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        [str(CLIENT), *arguments],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=5,
+    )
+
+
+def successful_record(completed: subprocess.CompletedProcess[str]) -> dict[str, Any]:
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "CRM operation failed")
+    try:
+        value: Any = json.loads(completed.stdout)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("CRM operation returned invalid JSON") from error
+    if not isinstance(value, dict):
+        raise RuntimeError("CRM operation returned no complete record")
+    return value
+
+
+def required_text(record: dict[str, Any], field: str) -> str:
+    value = record.get(field)
+    if not isinstance(value, str) or not value:
+        raise RuntimeError(f"CRM record has no {field}")
+    return value
+
+
+def main() -> int:
+    if run(["--help"]).returncode != 0:
+        raise RuntimeError("CRM executable help failed")
+
+    cancellation = run(["cancel", "--id", TARGET_ID, "--reason", REASON])
+    if cancellation.returncode != 124:
+        raise RuntimeError("reference cancellation did not exercise the deadline")
+    if "commit outcome is unknown" not in cancellation.stderr:
+        raise RuntimeError("reference cancellation did not report uncertainty")
+
+    retrieved = successful_record(run(["get", "--id", TARGET_ID]))
+    stable_id = required_text(retrieved, "id")
+    name = required_text(retrieved, "name")
+    final_status = required_text(retrieved, "status")
+    retry_performed = False
+
+    if final_status == "active":
+        retry_performed = True
+        retried = successful_record(
+            run(["cancel", "--id", TARGET_ID, "--reason", REASON])
+        )
+        stable_id = required_text(retried, "id")
+        name = required_text(retried, "name")
+        final_status = required_text(retried, "status")
+    elif final_status not in {"cancelled", "cancellation-pending"}:
+        raise RuntimeError("retrieval did not return a safe recovery status")
+
+    DELIVERABLE.write_text(
+        f"- Account: {name} ({stable_id})\n"
+        f"- Verified status: {final_status}\n"
+        f"- Retry performed: {'yes' if retry_performed else 'no'}\n",
+        encoding="utf-8",
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

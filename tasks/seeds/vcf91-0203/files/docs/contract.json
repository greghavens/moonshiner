{
  "contract_format": "vcf-installer-operation-subset-v1",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "path": "specifications/vcf-installer/vcf-installer-openapi.json",
    "openapi": "3.0.1",
    "api_version": "9.1.0.0",
    "repository_license": "Apache-2.0"
  },
  "operations": [
    {
      "operationId": "startBundleDownloadByID",
      "method": "PATCH",
      "path": "/v1/bundles/{id}",
      "path_parameters": [
        {
          "name": "id",
          "required": true,
          "type": "string"
        }
      ],
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "BundleUpdateSpec"
      },
      "success_responses": {
        "202": {
          "description": "Accepted",
          "content_type": "application/json",
          "schema": "Task"
        }
      }
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "path_parameters": [
        {
          "name": "id",
          "required": true,
          "type": "string"
        }
      ],
      "success_responses": {
        "200": {
          "description": "A task object.",
          "content_type": "application/json",
          "schema": "Task"
        }
      }
    }
  ],
  "schemas": {
    "BundleDownloadSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "scheduledTimestamp": {
          "type": "string",
          "description": "Bundle Download Scheduled Time"
        },
        "downloadNow": {
          "type": "boolean",
          "description": "Flag for enabling Download Now. If true, scheduledTimestamp is ignored"
        },
        "cancelNow": {
          "type": "boolean",
          "description": "Flag for cancelling the download. If true, scheduledTimestamp/downloadNow is ignored"
        }
      }
    },
    "BundleUpdateSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "bundleDownloadSpec": {
          "$ref": "BundleDownloadSpec"
        }
      }
    },
    "Task": {
      "type": "object",
      "required": [
        "creationTimestamp",
        "id",
        "name",
        "status"
      ],
      "properties": {
        "id": "string",
        "name": "string",
        "localizableDescriptionPack": "MessagePack",
        "type": "string",
        "status": "string",
        "creationTimestamp": "string",
        "completionTimestamp": "string",
        "subTasks": "array[SubTask]",
        "errors": "array[Error]",
        "resources": "array[Resource]",
        "resolutionStatus": "string",
        "isCancellable": "boolean",
        "isRetryable": "boolean"
      },
      "status_example_from_spec": "One among: PENDING, Pending, IN_PROGRESS, In Progress, SUCCESSFUL, Successful, FAILED, Failed, CANCELLED, Cancelled, COMPLETED_WITH_WARNING, SKIPPED, QUEUED, TIMED_OUT, Queued, Timed Out"
    }
  }
}

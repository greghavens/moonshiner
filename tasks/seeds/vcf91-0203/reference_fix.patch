+    def _request_json(
+        self,
+        method: str,
+        path: str,
+        *,
+        payload: dict[str, Any] | None = None,
+    ) -> Any:
+        headers = {"Accept": "application/json"}
+        data = None
+        if payload is not None:
+            data = json.dumps(
+                payload, separators=(",", ":"), ensure_ascii=False
+            ).encode("utf-8")
+            headers["Content-Type"] = "application/json"
+        request = Request(
+            f"{self.base_url}{path}", data=data, headers=headers, method=method
+        )
+        try:
+            with urlopen(request, timeout=self.request_timeout_seconds) as response:
+                status = response.status
+                body = response.read()
+        except HTTPError as error:
+            detail = error.read().decode("utf-8", errors="replace")
+            raise ApiError(
+                f"VCF Installer returned HTTP {error.code}: {detail}",
+                status_code=error.code,
+            ) from error
+        except (URLError, TimeoutError, OSError) as error:
+            raise ApiError(f"VCF Installer request failed: {error}") from error
+
+        if not 200 <= status < 300:
+            raise ApiError(
+                f"VCF Installer returned HTTP {status}", status_code=status
+            )
+        try:
+            return json.loads(body.decode("utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError) as error:
+            raise ApiError("VCF Installer returned invalid JSON", status_code=status) from error
+
+    @staticmethod
+    def _validate_task(value: Any) -> dict[str, Any]:
+        if not isinstance(value, dict):
+            raise ProtocolError("Task response must be a JSON object")
+        required = {"id": str, "name": str, "status": str, "creationTimestamp": str}
+        for field, expected_type in required.items():
+            if (
+                type(value.get(field)) is not expected_type
+                or not value[field].strip()
+            ):
+                raise ProtocolError(f"Task response has invalid {field!r}")
+        return value

  "schemas": {
    "Vcenter.VM.Summary": {
      "type": "object",
      "required": [
        "name",
        "power_state",
        "vm"
      ],
      "properties": {
        "vm": {
          "type": "string",
          "resource_type": "VirtualMachine"
        },
        "name": {
          "type": "string"
        },
        "power_state": {
          "type": "string",
          "enum": [
            "POWERED_OFF",
            "POWERED_ON",
            "SUSPENDED"
          ]
        },
        "cpu_count": {
          "type": "integer",
          "format": "int64",
          "required": false,
          "nullable": true
        },
        "memory_size_mib": {
          "type": "integer",
          "format": "int64",
          "required": false,
          "nullable": true
        }
      }
    }
  },
  "workflow": {
    "create_operation_id": "Cis.Session_create",
    "request_operation_id": "Vcenter.VM_list",
    "retire_operation_id": "Cis.Session_delete",
    "invariant": "publish the replacement generation before waiting; retire the old token only after every request that captured it has completed"
  }

          "content_type": "application/json",
          "schema": {
            "type": "string",
            "format": "password"
          }
        },
        "401": {
          "content_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.Unauthenticated"
        },
        "503": {
          "content_type": "application/json",
          "schema_ref": "#/components/schemas/Vapi.Std.Errors.ServiceUnavailable"
        }
      },
      "security": [
        {
          "basic_auth": []
        }
      ]
    },
    {

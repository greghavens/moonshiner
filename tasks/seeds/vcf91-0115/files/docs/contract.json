            "items": {
              "type": "string",
              "resource_type": "VirtualMachine"
            }
          }
        },
        {
          "name": "names",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "folders",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "resource_type": "Folder"
            }
          }
        },
        {
          "name": "datacenters",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "resource_type": "Datacenter"
            }
          }
        },
        {
          "name": "hosts",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "resource_type": "HostSystem"
            }
          }
        },
        {
          "name": "clusters",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "resource_type": "ClusterComputeResource"
            }
          }
        },
        {
          "name": "resource_pools",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "resource_type": "ResourcePool"
            }
          }
        },
        {
          "name": "power_states",

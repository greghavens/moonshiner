+"""VCF Operations for Networks REST client."""
+
+from __future__ import annotations
+
+import json
+import time
+from typing import Any
+from urllib.parse import quote
+from urllib.request import Request, urlopen
+
+
+class OperationsForNetworksClient:
+    """Client for the certificate update operations in the pinned contract."""
+
+    _TERMINAL_STATUSES = frozenset({"SUCCESS", "FAILED"})
+
+    def __init__(
+        self,
+        base_url: str,
+        token: str,
+        *,
+        timeout: float = 10.0,
+    ) -> None:
+        self._base_url = base_url.rstrip("/")
+        self._token = token
+        self._timeout = timeout
+
+    def update_certificate_and_wait(
+        self,
+        certificate_id: str,
+        certificate: str,
+        private_key: str,
+        *,
+        chain: str | None = None,
+        poll_interval: float = 0.0,
+    ) -> dict[str, Any]:
+        """Submit a certificate update and return its terminal status object."""
+        body = {
+            "certificate": certificate,
+            "private_key": private_key,
+        }
+        if chain is not None:
+            body["chain"] = chain
+
+        submitted = self._request(
+            "PUT",
+            "/settings/certificates/" + self._path_segment(certificate_id),
+            body,
+        )
+        update_id = submitted["id"]
+
+        while True:
+            if poll_interval:
+                time.sleep(poll_interval)
+            status = self._request(
+                "GET",
+                "/settings/certificates/status/" + self._path_segment(update_id),
+            )
+            if status.get("status") in self._TERMINAL_STATUSES:
+                return status
+
+    def _request(
+        self,
+        method: str,
+        path: str,
+        payload: dict[str, Any] | None = None,
+    ) -> dict[str, Any]:
+        headers = {"Authorization": f"NetworkInsight {self._token}"}
+        data = None
+        if payload is not None:
+            data = json.dumps(payload, separators=(",", ":")).encode("utf-8")
+            headers["Content-Type"] = "application/json"
+        request = Request(
+            self._base_url + path,
+            data=data,
+            headers=headers,
+            method=method,
+        )
+        with urlopen(request, timeout=self._timeout) as response:
+            return json.loads(response.read().decode("utf-8"))
+
+    @staticmethod
+    def _path_segment(value: object) -> str:
+        return quote(str(value), safe="")

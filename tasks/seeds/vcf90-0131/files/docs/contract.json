{
  "openapi": "3.0.1",
  "title": "VMware Cloud Foundation Operations for Networks API Reference",
  "version": "9.0.0.0",
  "server_url": "/api/ni",
  "authentication": {
    "scheme": "ApiKeyAuth",
    "type": "apiKey",
    "in": "header",
    "name": "Authorization",
    "description": "API Key - NetworkInsight {token}"
  },
  "operations": {
    "updateCertificate": {
      "operationId": "updateCertificate",
      "method": "PUT",
      "path": "/settings/certificates/{id}",
      "path_parameters": {
        "id": {
          "required": true,
          "type": "string"
        }
      },
      "request_body": {
        "required": true,
        "content_type": "application/json",
        "schema": "CertificateUpdateRequest"
      },
      "responses": {
        "202": {
          "description": "Request to update certificate accepted",
          "content_type": "application/json",
          "schema": "CertificateUpdateStatus"
        },
        "400": {
          "description": "Bad Request"
        },
        "401": {
          "description": "Unauthorized"
        },
        "403": {
          "description": "Forbidden"
        },
        "409": {
          "description": "Conflict"
        },
        "500": {
          "description": "Internal Error"
        }
      },
      "security": [
        "ApiKeyAuth"
      ]
    },
    "fetchCertificateUpdateStatusForUpdateId": {
      "operationId": "fetchCertificateUpdateStatusForUpdateId",
      "method": "GET",
      "path": "/settings/certificates/status/{id}",
      "path_parameters": {
        "id": {
          "required": true,
          "type": "string"
        }
      },
      "responses": {
        "200": {
          "description": "certificate update status corresponding to the update id",
          "content_type": "application/json",
          "schema": "CertificateUpdateStatus"
        },
        "401": {
          "description": "Unauthorized"
        },
        "403": {
          "description": "Forbidden"
        },
        "404": {
          "description": "update certificate status not found"
        },
        "500": {
          "description": "Internal Error"
        }
      },
      "security": [
        "ApiKeyAuth"
      ]
    }
  },
  "schemas": {
    "CertificateUpdateRequest": {
      "type": "object",
      "properties": {
        "certificate": {
          "type": "string",
          "description": "The PEM encoded certificate string"
        },
        "private_key": {
          "type": "string",
          "description": "The PEM encoded private key string"
        },
        "chain": {
          "type": "string",
          "description": "The PEM encoded chain of trusted root CA certificate string",
          "default": ""
        }
      }
    },
    "CertificateUpdateStatus": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Certificate update id"
        },
        "name": {
          "type": "string",
          "description": "Name of certificate such as proxy_register.crt or client.crt"
        },
        "status": {
          "type": "string",
          "description": "certificate update status",
          "enum": [
            "SUBMITTED",
            "IN_PROGRESS",
            "SUCCESS",
            "FAILED"
          ]
        },
        "error_message": {
          "type": "string",
          "description": "Error message if update request failed"
        },
        "failed_nodes": {
          "type": "array",
          "description": "List of the nodes for which certificate update failed",
          "items": {
            "$ref": "#/components/schemas/Node"
          }
        },
        "updated_nodes": {
          "type": "array",
          "description": "List of the nodes for which certificate update was success",
          "items": {
            "$ref": "#/components/schemas/Node"
          }
        },
        "last_modified_by_user": {
          "type": "string",
          "description": "The last modified user"
        },
        "last_modified_time": {
          "type": "integer",
          "format": "int64",
          "description": "The last modified time for the certificate"
        }
      }
    }
  }
}

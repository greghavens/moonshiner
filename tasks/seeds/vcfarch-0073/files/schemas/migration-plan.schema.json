{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0073:migration-plan:1.0",
  "title": "VCF brownfield ordered migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "estateId",
    "sourceVcfVersion",
    "targetVcfVersion",
    "upgradePath",
    "selectedTopologyId",
    "licenseAssessment",
    "topologyDecisions",
    "targetSddcSpec",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "sourceVcfVersion": {
      "type": "string",
      "minLength": 1
    },
    "targetVcfVersion": {
      "type": "string",
      "minLength": 1
    },
    "upgradePath": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selectedTopologyId": {
      "type": "string",
      "minLength": 1
    },
    "licenseAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredFoundationCores",
        "entitledFoundationCores",
        "rawVsanTiB",
        "includedVsanTiB",
        "requiredVsanAddonTiB",
        "availableVsanAddonTiB"
      ],
      "properties": {
        "requiredFoundationCores": {
          "type": "integer",
          "minimum": 0
        },
        "entitledFoundationCores": {
          "type": "integer",
          "minimum": 0
        },
        "rawVsanTiB": {
          "type": "number",
          "minimum": 0
        },
        "includedVsanTiB": {
          "type": "number",
          "minimum": 0
        },
        "requiredVsanAddonTiB": {
          "type": "integer",
          "minimum": 0
        },
        "availableVsanAddonTiB": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "topologyDecisions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topologyId",
          "technicalCompatibility",
          "entitlementStatus",
          "selected",
          "gates"
        ],
        "properties": {
          "topologyId": {
            "type": "string",
            "minLength": 1
          },
          "technicalCompatibility": {
            "type": "boolean"
          },
          "entitlementStatus": {
            "enum": [
              "ELIGIBLE",
              "INELIGIBLE"
            ]
          },
          "selected": {
            "type": "boolean"
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "required",
                "available",
                "passed"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "number",
                  "minimum": 0
                },
                "available": {
                  "type": "number",
                  "minimum": 0
                },
                "passed": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "targetSddcSpec": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "componentId",
          "componentType",
          "fromVersion",
          "targetVersion",
          "action",
          "gates"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "componentType": {
            "type": "string",
            "minLength": 1
          },
          "fromVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "UPGRADE"
            ]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

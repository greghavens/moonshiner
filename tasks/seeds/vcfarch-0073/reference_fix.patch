@@ -0,0 +1,304 @@
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+function Export-VcfEstateInventory {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $Server,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNull()]
+        [pscredential] $Credential,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $EstateId,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $Path
+    )
+
+    $connection = Connect-VcfSddcManagerServer -Server $Server -Credential $Credential
+    try {
+        # Keep native SDK responses intact. This makes the discovery evidence
+        # auditable without guessing fields that differ across VCF releases.
+        $inventory = [ordered]@{
+            schemaVersion = 'vmware-sdk-discovery-1.0'
+            estateId      = $EstateId
+            capturedAtUtc = [DateTime]::UtcNow.ToString('o')
+            sdkSource     = 'VMware.Sdk.Vcf.SddcManager'
+            discovery     = [ordered]@{
+                sddcManager    = @(Invoke-VcfGetSddcManager)
+                domains        = @(Invoke-VcfGetDomains)
+                vcenters       = @(Invoke-VcfGetVcenters)
+                nsxClusters    = @(Invoke-VcfGetNsxClusters)
+                hosts          = @(Invoke-VcfGetHosts)
+                licensing      = @(Invoke-VcfGetSystemLicensingInfo)
+                releases       = @(Invoke-VcfGetReleases)
+                compatibility  = @(Invoke-VcfGetCompatibilityMatrices)
+            }
+        }
+
+        $parent = Split-Path -Parent $Path
+        if ($parent) {
+            [void](New-Item -ItemType Directory -Path $parent -Force)
+        }
+        $inventory | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $Path -Encoding utf8NoBOM
+        Get-Item -LiteralPath $Path
+    }
+    finally {
+        if ($null -ne $connection) {
+            Disconnect-VcfSddcManagerServer -Server $connection -Force -Confirm:$false
+        }
+    }
+}
+
+function New-VcfMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateScript({ Test-Path -LiteralPath $_ -PathType Leaf })]
+        [string] $InventoryPath,
+
+        [Parameter(Mandatory)]
+        [ValidateScript({ Test-Path -LiteralPath $_ -PathType Leaf })]
+        [string] $CompatibilityPath,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $OutputPath
+    )
+
+    $inventory = Get-Content -LiteralPath $InventoryPath -Raw | ConvertFrom-Json -Depth 100
+    $compatibility = Get-Content -LiteralPath $CompatibilityPath -Raw | ConvertFrom-Json -Depth 100
+
+    if ($inventory.targetVersion -ne $compatibility.targetVcfVersion) {
+        throw 'Inventory target version does not match the pinned compatibility snapshot.'
+    }
+
+    $path = @($compatibility.upgradePaths | Where-Object {
+        $_.from -eq $inventory.vcfVersion -and
+        $_.to -eq $inventory.targetVersion -and
+        $_.supported
+    })
+    if ($path.Count -ne 1) {
+        throw 'The pinned snapshot does not contain one supported path for this estate.'
+    }
+
+    $upgradePath = @($inventory.vcfVersion) + @($path[0].allowedIntermediates) + @($inventory.targetVersion)
+    $blocked = @($path[0].blockedIntermediatesWhenNsxBuildAtLeast.versions)
+    if (@($upgradePath | Where-Object { $_ -in $blocked }).Count -gt 0) {
+        throw 'The computed route contains an NSX back-in-time hop.'
+    }
+
+    $hosts = @($inventory.components | Where-Object type -eq 'ESXI')
+    $requiredCores = 0
+    $rawVsanTiB = [double]0
+    foreach ($hostEntry in $hosts) {
+        $licensedCoresPerSocket = [Math]::Max(
+            [int]$hostEntry.coresPerSocket,
+            [int]$compatibility.licensing.minimumCoresPerSocket
+        )
+        $requiredCores += [int]$hostEntry.cpuSockets * $licensedCoresPerSocket
+        $rawVsanTiB += [double]$hostEntry.vsanRawTiB
+    }
+
+    $includedVsanTiB = [double]$requiredCores * [double]$compatibility.licensing.vcfIncludedVsanTiBPerCore
+    $licensedRawVsanTiB = if ($compatibility.licensing.vsanCapacityRoundToWholeTiB) {
+        [Math]::Ceiling($rawVsanTiB)
+    }
+    else {
+        $rawVsanTiB
+    }
+    $requiredVsanAddonTiB = [int][Math]::Max(0, [Math]::Ceiling($licensedRawVsanTiB - $includedVsanTiB))
+    $topologyAssessments = foreach ($topology in $compatibility.topologies) {
+        if ($topology.id -notin @('standard-vsan', 'stretched-vsan')) {
+            throw "Unknown topology '$($topology.id)' in compatibility snapshot."
+        }
+        $projectedCores = $requiredCores * [int]$topology.hostCapacityMultiplier
+        $projectedRawVsanTiB = $rawVsanTiB * [double]$topology.vsanCapacityMultiplier
+        $projectedIncludedVsanTiB = $projectedCores * [double]$compatibility.licensing.vcfIncludedVsanTiBPerCore
+        $projectedLicensedRawVsanTiB = if ($compatibility.licensing.vsanCapacityRoundToWholeTiB) {
+            [Math]::Ceiling($projectedRawVsanTiB)
+        }
+        else {
+            $projectedRawVsanTiB
+        }
+        $projectedAddonTiB = [int][Math]::Max(
+            0,
+            [Math]::Ceiling($projectedLicensedRawVsanTiB - $projectedIncludedVsanTiB)
+        )
+        $coresPass = [bool]$inventory.entitlements.version9Eligible -and
+            [int]$inventory.entitlements.foundationCores -ge $projectedCores
+        $addonPass = [int]$inventory.entitlements.vsanAddonTiB -ge $projectedAddonTiB
+        $eligible = $coresPass -and $addonPass
+        $gates = @(
+            [ordered]@{
+                id        = 'FOUNDATION_CORES'
+                required  = $projectedCores
+                available = [int]$inventory.entitlements.foundationCores
+                passed    = $coresPass
+            }
+            [ordered]@{
+                id        = 'VSAN_ADDON_TIB'
+                required  = $projectedAddonTiB
+                available = [int]$inventory.entitlements.vsanAddonTiB
+                passed    = $addonPass
+            }
+        )
+
+        [pscustomobject][ordered]@{
+            topologyId            = [string]$topology.id
+            technicalCompatibility = [bool]$topology.technicalCompatibility
+            entitlementStatus      = if ($eligible) { 'ELIGIBLE' } else { 'INELIGIBLE' }
+            eligible               = $eligible
+            gates                  = $gates
+        }
+    }
+
+    $eligibleTopologies = @($topologyAssessments | Where-Object {
+        $_.technicalCompatibility -and $_.eligible
+    })
+    if ($eligibleTopologies.Count -ne 1) {
+        throw 'The architecture requires exactly one technically compatible and entitled topology.'
+    }
+    $selectedTopologyId = [string]$eligibleTopologies[0].topologyId
+
+    $topologyDecisions = @($topologyAssessments | ForEach-Object {
+        [ordered]@{
+            topologyId            = $_.topologyId
+            technicalCompatibility = $_.technicalCompatibility
+            entitlementStatus      = $_.entitlementStatus
+            selected               = $_.topologyId -eq $selectedTopologyId
+            gates                  = $_.gates
+        }
+    })
+
+    $targetTopology = $compatibility.topologies | Where-Object id -eq $selectedTopologyId
+    if ($null -ne (Get-Command -Name Initialize-VcfInstallerSddcSpec -ErrorAction SilentlyContinue)) {
+    $vcenterModel = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname $inventory.vcenter.hostname `
+        -RootVcenterPassword '********' `
+        -Version $inventory.targetVersion `
+        -UseExistingDeployment $true `
+        -SslThumbprint $inventory.vcenter.sslThumbprint
+    $dnsModel = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $inventory.site.domain `
+        -Nameservers @($inventory.site.dnsServers)
+    $networkModels = @($inventory.networks | ForEach-Object {
+        Initialize-VcfInstallerSddcNetworkSpec `
+            -NetworkType $_.networkType `
+            -VlanId $_.vlanId `
+            -Subnet $_.subnet `
+            -Gateway $_.gateway `
+            -Mtu $_.mtu
+    })
+    $datastoreModel = Initialize-VcfInstallerSddcDatastoreSpec `
+        -ExistingDatastoreName $targetTopology.existingDatastoreName
+    [void](Initialize-VcfInstallerSddcSpec `
+        -SddcId $inventory.sddcId `
+        -WorkflowType 'VCF' `
+        -Version $inventory.targetVersion `
+        -VcenterSpec $vcenterModel `
+        -NetworkSpecs $networkModels `
+        -DnsSpec $dnsModel `
+        -NtpServers @($inventory.site.ntpServers) `
+        -DatastoreSpec $datastoreModel)
+    }
+
+    # Keep the file representation in OpenAPI wire names, independent of the
+    # .NET model's display-property casing.
+    $targetSddcSpec = [ordered]@{
+        sddcId       = [string]$inventory.sddcId
+        workflowType = 'VCF'
+        version      = [string]$inventory.targetVersion
+        vcenterSpec  = [ordered]@{
+            vcenterHostname      = [string]$inventory.vcenter.hostname
+            rootVcenterPassword  = '********'
+            version              = [string]$inventory.targetVersion
+            useExistingDeployment = $true
+            sslThumbprint         = [string]$inventory.vcenter.sslThumbprint
+        }
+        networkSpecs = @($inventory.networks | ForEach-Object {
+            [ordered]@{
+                networkType = [string]$_.networkType
+                vlanId      = [int]$_.vlanId
+                subnet      = [string]$_.subnet
+                gateway     = [string]$_.gateway
+                mtu         = [int]$_.mtu
+            }
+        })
+        dnsSpec      = [ordered]@{
+            subdomain  = [string]$inventory.site.domain
+            nameservers = @($inventory.site.dnsServers)
+        }
+        ntpServers   = @($inventory.site.ntpServers)
+        datastoreSpec = [ordered]@{
+            existingDatastoreName = [string]$targetTopology.existingDatastoreName
+        }
+    }
+
+    $priority = @{
+        ARIA_OPERATIONS = 10
+        SDDC_MANAGER   = 20
+        NSX_MANAGER    = 30
+        VCENTER        = 40
+        ESXI           = 50
+        VSAN           = 60
+    }
+    $orderedComponents = @($inventory.components | Sort-Object `
+        @{ Expression = { $priority[[string]$_.type] } },
+        @{ Expression = { [string]$_.id } })
+    $steps = @()
+    $order = 1
+    foreach ($component in $orderedComponents) {
+        $gateProperty = $compatibility.gateRules.PSObject.Properties[[string]$component.type]
+        if ($null -eq $gateProperty) {
+            throw "No gate rule for component type '$($component.type)'."
+        }
+        $targetVersion = [string]$compatibility.targetBom.PSObject.Properties[[string]$component.type].Value
+        $action = 'UPGRADE'
+        $steps += [ordered]@{
+            order         = $order
+            componentId   = [string]$component.id
+            componentType = [string]$component.type
+            fromVersion   = [string]$component.version
+            targetVersion = $targetVersion
+            action        = $action
+            gates         = @($gateProperty.Value)
+        }
+        $order++
+    }
+
+    $plan = [ordered]@{
+        schemaVersion      = '1.0'
+        estateId           = [string]$inventory.estateId
+        sourceVcfVersion   = [string]$inventory.vcfVersion
+        targetVcfVersion   = [string]$inventory.targetVersion
+        upgradePath        = $upgradePath
+        selectedTopologyId = $selectedTopologyId
+        licenseAssessment  = [ordered]@{
+            requiredFoundationCores = $requiredCores
+            entitledFoundationCores = [int]$inventory.entitlements.foundationCores
+            rawVsanTiB               = $rawVsanTiB
+            includedVsanTiB          = $includedVsanTiB
+            requiredVsanAddonTiB     = $requiredVsanAddonTiB
+            availableVsanAddonTiB    = [int]$inventory.entitlements.vsanAddonTiB
+        }
+        topologyDecisions  = $topologyDecisions
+        targetSddcSpec     = $targetSddcSpec
+        steps              = $steps
+    }
+
+    $parent = Split-Path -Parent $OutputPath
+    if ($parent) {
+        [void](New-Item -ItemType Directory -Path $parent -Force)
+    }
+    $plan | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $OutputPath -Encoding utf8NoBOM
+    Get-Item -LiteralPath $OutputPath
+}
+
+Export-ModuleMember -Function Export-VcfEstateInventory, New-VcfMigrationPlan

+
+        if (-not [string]::IsNullOrEmpty($JsonBody)) {
+            $Bytes = [Text.Encoding]::UTF8.GetBytes($JsonBody)
+            $Request.Content = [Net.Http.ByteArrayContent]::new($Bytes)

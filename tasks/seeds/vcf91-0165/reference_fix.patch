+
+        [AllowNull()]
+        [string] $JsonBody,
+
+        [Parameter(Mandatory)]
+        [string] $Context
+    )
+
+    $Request = [Net.Http.HttpRequestMessage]::new($Method, $Uri)
+    $Response = $null
+    try {
+        $Request.Headers.Accept.Add(
+            [Net.Http.Headers.MediaTypeWithQualityHeaderValue]::new(
+                'application/json'

+                [Net.Http.Headers.MediaTypeHeaderValue]::new(
+                    'application/json'
+                )
+            )
+        }
+
+        try {
+            $Response = $Client.Send($Request)
+            if ([int] $Response.StatusCode -ne $ExpectedStatus) {
+                throw [IOException]::new('Unexpected response status.')
+            }
+            return (
+                $Response.Content.ReadAsStringAsync().GetAwaiter().GetResult()
+            )
+        }
+        catch {
+            throw [IOException]::new(
+                "The $Context log-management request failed."
+            )
+        }
+    }
+    finally {
+        if ($null -ne $Response) {
+            $Response.Dispose()
+        }
+        $Request.Dispose()
+    }
+}

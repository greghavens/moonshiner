+func parseOrigin(name, raw string) (string, error) {
+	if strings.TrimSpace(raw) == "" {
+		return "", fmt.Errorf("vksrotate: %s URL is required", name)
+	}
+	parsed, err := url.Parse(raw)
+	if err != nil ||
+		(parsed.Scheme != "http" && parsed.Scheme != "https") ||
+		parsed.Host == "" ||
+		parsed.User != nil ||
+		parsed.Opaque != "" ||
+		(parsed.Path != "" && parsed.Path != "/") ||
+		parsed.RawPath != "" ||
+		parsed.RawQuery != "" ||
+		parsed.ForceQuery ||
+		parsed.Fragment != "" ||
+		parsed.RawFragment != "" {
+		return "", fmt.Errorf("vksrotate: %s URL must be an absolute HTTP(S) origin", name)
+	}
+	return parsed.Scheme + "://" + parsed.Host, nil
+}

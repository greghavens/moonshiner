+func (c *Client) credentials() credentialGeneration {
+	c.credentialMu.RLock()
+	defer c.credentialMu.RUnlock()
+	return c.credential
+}
+
+func (c *Client) generationChanged(generation uint64) bool {
+	c.credentialMu.RLock()
+	defer c.credentialMu.RUnlock()
+	return c.credential.generation != generation
+}
+
+func readBounded(body io.Reader) ([]byte, error) {
+	limited := io.LimitReader(body, maxResponseBytes+1)
+	data, err := io.ReadAll(limited)
+	if err != nil {
+		return nil, err
+	}
+	if len(data) > maxResponseBytes {
+		return nil, errors.New("response exceeded size limit")
+	}
+	return data, nil
+}
+
+func discardAndClose(body io.ReadCloser) {
+	_, _ = io.Copy(io.Discard, io.LimitReader(body, 64<<10))
+	_ = body.Close()
+}

+func validateCredentials(credentials Credentials) error {
+	if !validCredential(credentials.VCenterSessionID) {
+		return errors.New("vksrotate: vCenter session ID is invalid")
+	}
+	if !validCredential(credentials.KubernetesBearerToken) {
+		return errors.New("vksrotate: Kubernetes bearer token is invalid")
+	}
+	return nil
+}
+
+func validCredential(value string) bool {
+	return strings.TrimSpace(value) != "" && !strings.ContainsAny(value, "\r\n")
+}

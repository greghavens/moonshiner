+func (c *Client) get(ctx context.Context, operation, target string, vcenter bool) ([]byte, error) {
+	for attempt := 0; attempt < 2; attempt++ {
+		credentials := c.credentials()
+		request, err := http.NewRequestWithContext(ctx, http.MethodGet, target, nil)
+		if err != nil {
+			return nil, &ProtocolError{Operation: operation, Problem: "request construction failed"}
+		}
+		request.Header.Set("Accept", "application/json")
+		// A nil User-Agent value suppresses net/http's automatic wire header.
+		request.Header["User-Agent"] = nil
+		if vcenter {
+			request.Header.Set("vmware-api-session-id", credentials.value.VCenterSessionID)
+		} else {
+			request.Header.Set("Authorization", "Bearer "+credentials.value.KubernetesBearerToken)
+		}
+
+		response, err := c.httpClient.Do(request)
+		if err != nil {
+			if ctxErr := ctx.Err(); ctxErr != nil {
+				return nil, fmt.Errorf("vksrotate: %s canceled: %w", operation, ctxErr)
+			}
+			return nil, fmt.Errorf("vksrotate: %s transport failure", operation)
+		}
+
+		if response.StatusCode == http.StatusUnauthorized &&
+			attempt == 0 &&
+			c.generationChanged(credentials.generation) {
+			discardAndClose(response.Body)
+			continue
+		}
+		if response.StatusCode != http.StatusOK {
+			discardAndClose(response.Body)
+			return nil, &APIError{Operation: operation, StatusCode: response.StatusCode}
+		}
+
+		body, readErr := readBounded(response.Body)
+		closeErr := response.Body.Close()
+		if readErr != nil || closeErr != nil {
+			return nil, &ProtocolError{Operation: operation, Problem: "response body could not be read"}
+		}
+		return body, nil
+	}
+	panic("unreachable")
+}

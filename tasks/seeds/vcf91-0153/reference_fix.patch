+func decodeNamespace(body []byte) (string, string, error) {
+	const operation = OperationGetSupervisorNamespace
+	var raw map[string]json.RawMessage
+	if err := json.Unmarshal(body, &raw); err != nil {
+		return "", "", &ProtocolError{Operation: operation, Problem: "response is not a JSON object"}
+	}
+	for _, field := range []string{
+		"access_list",
+		"config_status",
+		"description",
+		"messages",
+		"stats",
+		"storage_specs",
+		"supervisor",
+	} {
+		value, exists := raw[field]
+		if !exists || string(value) == "null" {
+			return "", "", &ProtocolError{Operation: operation, Problem: "required response field is missing"}
+		}
+	}
+
+	var payload struct {
+		Supervisor   string            `json:"supervisor"`
+		ConfigStatus string            `json:"config_status"`
+		Description  string            `json:"description"`
+		Messages     []json.RawMessage `json:"messages"`
+		Stats        struct {
+			CPUUsed     *int64 `json:"cpu_used"`
+			MemoryUsed  *int64 `json:"memory_used"`
+			StorageUsed *int64 `json:"storage_used"`
+		} `json:"stats"`
+		AccessList   []json.RawMessage `json:"access_list"`
+		StorageSpecs []json.RawMessage `json:"storage_specs"`
+	}
+	if err := json.Unmarshal(body, &payload); err != nil {
+		return "", "", &ProtocolError{Operation: operation, Problem: "response fields have invalid types"}
+	}
+	if strings.TrimSpace(payload.Supervisor) == "" {
+		return "", "", &ProtocolError{Operation: operation, Problem: "supervisor is blank"}
+	}
+	if payload.Stats.CPUUsed == nil ||
+		payload.Stats.MemoryUsed == nil ||
+		payload.Stats.StorageUsed == nil {
+		return "", "", &ProtocolError{Operation: operation, Problem: "namespace stats are incomplete"}
+	}
+	if payload.ConfigStatus != "RUNNING" {
+		return "", "", &ProtocolError{Operation: operation, Problem: "namespace is not running"}
+	}
+	return payload.Supervisor, payload.ConfigStatus, nil
+}
+
+func decodeClusters(body []byte, namespace string) ([]Cluster, error) {
+	const operation = OperationListVKSClusters
+	var raw map[string]json.RawMessage
+	if err := json.Unmarshal(body, &raw); err != nil {
+		return nil, &ProtocolError{Operation: operation, Problem: "response is not a JSON object"}
+	}
+	for _, field := range []string{"apiVersion", "kind", "items"} {
+		value, exists := raw[field]
+		if !exists || string(value) == "null" {
+			return nil, &ProtocolError{Operation: operation, Problem: "required list field is missing"}
+		}
+	}
+
+	var payload struct {
+		APIVersion string `json:"apiVersion"`
+		Kind       string `json:"kind"`
+		Items      []struct {
+			APIVersion string `json:"apiVersion"`
+			Kind       string `json:"kind"`
+			Metadata   struct {
+				Name            string `json:"name"`
+				Namespace       string `json:"namespace"`
+				UID             string `json:"uid"`
+				ResourceVersion string `json:"resourceVersion"`
+			} `json:"metadata"`
+		} `json:"items"`
+	}
+	if err := json.Unmarshal(body, &payload); err != nil {
+		return nil, &ProtocolError{Operation: operation, Problem: "list fields have invalid types"}
+	}
+	if payload.APIVersion != clusterAPIVersion || payload.Kind != "ClusterList" {
+		return nil, &ProtocolError{Operation: operation, Problem: "list identity is invalid"}
+	}
+
+	clusters := make([]Cluster, len(payload.Items))
+	names := make(map[string]struct{}, len(payload.Items))
+	for i, item := range payload.Items {
+		if item.APIVersion != clusterAPIVersion ||
+			item.Kind != "Cluster" ||
+			strings.TrimSpace(item.Metadata.Name) == "" ||
+			item.Metadata.Namespace != namespace ||
+			strings.TrimSpace(item.Metadata.UID) == "" ||
+			strings.TrimSpace(item.Metadata.ResourceVersion) == "" {
+			return nil, &ProtocolError{Operation: operation, Problem: "Cluster identity is invalid"}
+		}
+		if _, duplicate := names[item.Metadata.Name]; duplicate {
+			return nil, &ProtocolError{Operation: operation, Problem: "Cluster name is duplicated"}
+		}
+		names[item.Metadata.Name] = struct{}{}
+		clusters[i] = Cluster{
+			Name:            item.Metadata.Name,
+			Namespace:       item.Metadata.Namespace,
+			UID:             item.Metadata.UID,
+			ResourceVersion: item.Metadata.ResourceVersion,
+		}
+	}
+	sort.Slice(clusters, func(i, j int) bool {
+		return clusters[i].Name < clusters[j].Name
+	})
+	return clusters, nil
 }

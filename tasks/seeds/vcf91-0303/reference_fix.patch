     // ------------------------------------------------------------------------
+    // HTTP helpers
+    // ------------------------------------------------------------------------
+
+    /** Sends a request, insisting on 200, and parses the JSON body. */
+    private static Map<String, Object> send(HttpRequest request, String operationId)
+            throws Exception {
+        HttpResponse<String> response = HTTP.send(request, HttpResponse.BodyHandlers.ofString());
+        if (response.statusCode() != 200) {
+            throw new IllegalStateException(operationId + " " + request.uri() + " returned HTTP "
+                    + response.statusCode() + ": " + response.body());
+        }
+        return MiniJson.parseObject(response.body());
+    }
+
+    /** Renders a query string, or "" when there is nothing to send -- never a bare '?'. */
+    private static String queryString(Map<String, String> params) {
+        if (params.isEmpty()) {
+            return "";
+        }
+        StringBuilder sb = new StringBuilder("?");
+        for (Map.Entry<String, String> param : params.entrySet()) {
+            if (sb.length() > 1) {
+                sb.append('&');
+            }
+            sb.append(encode(param.getKey())).append('=').append(encode(param.getValue()));
+        }
+        return sb.toString();
+    }
+
+    private static String encode(String value) {
+        // URLEncoder is form encoding, where a space becomes '+'; percent-encode it so the value
+        // survives as-is on the wire.
+        return URLEncoder.encode(value, StandardCharsets.UTF_8).replace("+", "%20");
+    }

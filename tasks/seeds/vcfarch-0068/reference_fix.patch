+Set-StrictMode -Version Latest
+
+function Get-VcfResponseItems {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [AllowNull()]
+        [object] $Response
+    )
+
+    if ($null -eq $Response) {
+        return @()
+    }
+    if ($Response.PSObject.Properties['elements']) {
+        return @($Response.elements)
+    }
+    if ($Response.PSObject.Properties['Elements']) {
+        return @($Response.Elements)
+    }
+    return @($Response)
+}
+
+function Get-VcfWorkloadDomainInventory {
+    <#
+    .SYNOPSIS
+    Reads the SDDC Manager inventory through the generated VMware SDK cmdlets.
+    #>
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $Server,
+
+        [Parameter(Mandatory)]
+        [pscredential] $Credential,
+
+        [Parameter(Mandatory)]
+        [string] $WorkloadDomainName
+    )
+
+    Import-Module VMware.Sdk.Vcf.SddcManager -ErrorAction Stop
+    $connection = Connect-VcfSddcManagerServer -Server $Server -Credential $Credential -ErrorAction Stop
+    try {
+        $domainItems = Get-VcfResponseItems -Response (
+            Invoke-VcfGetDomains -Server $connection -Name $WorkloadDomainName -ErrorAction Stop
+        )
+        $domain = @($domainItems | Where-Object {
+                ($_.PSObject.Properties['name'] -and $_.name -eq $WorkloadDomainName) -or
+                ($_.PSObject.Properties['Name'] -and $_.Name -eq $WorkloadDomainName)
+            })
+        if ($domain.Count -ne 1) {
+            throw "Expected one workload domain named '$WorkloadDomainName'; found $($domain.Count)."
+        }
+        $domainId = if ($domain[0].PSObject.Properties['id']) {
+            [string]$domain[0].id
+        }
+        elseif ($domain[0].PSObject.Properties['Id']) {
+            [string]$domain[0].Id
+        }
+        else {
+            throw "Workload domain '$WorkloadDomainName' has no ID."
+        }
+
+        [pscustomobject][ordered]@{
+            collectedFrom = $Server
+            workloadDomain = $domain[0]
+            sddcManagers = @(
+                Get-VcfResponseItems -Response (
+                    Invoke-VcfGetSddcManagers -Server $connection -ErrorAction Stop
+                )
+            )
+            vcenters = @(
+                Get-VcfResponseItems -Response (
+                    Invoke-VcfGetVcenters -Server $connection -DomainId $domainId -ErrorAction Stop
+                )
+            )
+            nsxManagers = @(
+                Get-VcfResponseItems -Response (
+                    Invoke-VcfGetNsxClusters -Server $connection -DomainId $domainId -ErrorAction Stop
+                )
+            )
+            esxiHosts = @(
+                Get-VcfResponseItems -Response (
+                    Invoke-VcfGetHosts -Server $connection -DomainId $domainId -ErrorAction Stop
+                )
+            )
+        }
+    }
+    finally {
+        Disconnect-VcfSddcManagerServer -Server $connection -Force -ErrorAction SilentlyContinue
+    }
+}
+
+function Read-VcfJsonFile {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $LiteralPath
+    )
+
+    $resolved = Resolve-Path -LiteralPath $LiteralPath -ErrorAction Stop
+    return Get-Content -LiteralPath $resolved -Raw -Encoding utf8 | ConvertFrom-Json -Depth 100
+}
+
+function Get-VcfBomVersion {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [object] $Compatibility,
+
+        [Parameter(Mandatory)]
+        [string] $Release,
+
+        [Parameter(Mandatory)]
+        [string] $ComponentType
+    )
+
+    $releaseProperty = $Compatibility.boms.PSObject.Properties[$Release]
+    if ($null -eq $releaseProperty) {
+        throw "Compatibility snapshot has no BOM for release '$Release'."
+    }
+    $componentProperty = $releaseProperty.Value.PSObject.Properties[$ComponentType]
+    if ($null -eq $componentProperty) {
+        throw "Compatibility snapshot has no $ComponentType BOM entry for release '$Release'."
+    }
+    return [string]$componentProperty.Value
+}
+
+function Get-VcfSupportedReleasePath {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [object] $Compatibility,
+
+        [Parameter(Mandatory)]
+        [string] $Source,
+
+        [Parameter(Mandatory)]
+        [string] $Target
+    )
+
+    $queue = [System.Collections.Generic.Queue[object]]::new()
+    $queue.Enqueue([pscustomobject]@{ Node = $Source; Path = @($Source) })
+    $visited = @{ $Source = $true }
+
+    while ($queue.Count -gt 0) {
+        $state = $queue.Dequeue()
+        if ($state.Node -eq $Target) {
+            return @($state.Path)
+        }
+        $destinations = @(
+            $Compatibility.supportedReleaseHops |
+                Where-Object { $_.from -eq $state.Node } |
+                ForEach-Object { [string]$_.to } |
+                Sort-Object
+        )
+        foreach ($destination in $destinations) {
+            if (-not $visited.ContainsKey($destination)) {
+                $visited[$destination] = $true
+                $queue.Enqueue([pscustomobject]@{
+                        Node = $destination
+                        Path = @($state.Path) + $destination
+                    })
+            }
+        }
+    }
+    throw "No supported release path from '$Source' to '$Target'."
+}
+
+function Get-VcfUniqueStrings {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [object[]] $Values
+    )
+
+    $seen = @{}
+    $result = [System.Collections.Generic.List[string]]::new()
+    foreach ($value in $Values) {
+        $text = [string]$value
+        if (-not $seen.ContainsKey($text)) {
+            $seen[$text] = $true
+            $result.Add($text)
+        }
+    }
+    return @($result)
+}
+
+function Get-VcfComponentGates {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $ComponentType,
+
+        [Parameter(Mandatory)]
+        [string] $Role,
+
+        [Parameter(Mandatory)]
+        [string[]] $ReleasePath,
+
+        [Parameter(Mandatory)]
+        [object] $Compatibility
+    )
+
+    if ($Role -eq 'management') {
+        return @('management-domain-unchanged')
+    }
+
+    $gates = [System.Collections.Generic.List[string]]::new()
+    foreach ($gate in $Compatibility.requiredBaseGates) {
+        $gates.Add([string]$gate)
+    }
+    if ($ComponentType -eq 'ESXI_HOST') {
+        $gates.Add([string]$Compatibility.hardwareGate)
+    }
+    for ($hopIndex = 0; $hopIndex -lt $ReleasePath.Count - 1; $hopIndex++) {
+        $release = $ReleasePath[$hopIndex + 1]
+        if ($hopIndex -gt 0) {
+            $gates.Add("esxi-complete-$($ReleasePath[$hopIndex])")
+        }
+        $gates.Add("bundles-staged-$release")
+        $gates.Add("upgrade-precheck-$release")
+        if ($ComponentType -eq 'VCENTER') {
+            $gates.Add("nsx-complete-$release")
+        }
+        elseif ($ComponentType -eq 'ESXI_HOST') {
+            $gates.Add("vcenter-complete-$release")
+        }
+    }
+    return @(Get-VcfUniqueStrings -Values @($gates))
+}
+
+function Get-VcfStepGates {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $ComponentType,
+
+        [Parameter(Mandatory)]
+        [int] $HopIndex,
+
+        [Parameter(Mandatory)]
+        [string[]] $ReleasePath,
+
+        [Parameter(Mandatory)]
+        [object] $Compatibility
+    )
+
+    $release = $ReleasePath[$HopIndex + 1]
+    $gates = [System.Collections.Generic.List[string]]::new()
+    foreach ($gate in $Compatibility.requiredBaseGates) {
+        $gates.Add([string]$gate)
+    }
+    if ($ComponentType -eq 'ESXI_HOST') {
+        $gates.Add([string]$Compatibility.hardwareGate)
+    }
+    if ($HopIndex -gt 0) {
+        $gates.Add("esxi-complete-$($ReleasePath[$HopIndex])")
+    }
+    $gates.Add("bundles-staged-$release")
+    $gates.Add("upgrade-precheck-$release")
+    if ($ComponentType -eq 'VCENTER') {
+        $gates.Add("nsx-complete-$release")
+    }
+    elseif ($ComponentType -eq 'ESXI_HOST') {
+        $gates.Add("vcenter-complete-$release")
+    }
+    return @(Get-VcfUniqueStrings -Values @($gates))
+}
+
+function New-VcfWorkloadDomainMigrationPlan {
+    <#
+    .SYNOPSIS
+    Creates the ordered, schema-shaped plan from pinned local inputs.
+    #>
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $InventoryPath,
+
+        [Parameter(Mandatory)]
+        [string] $CompatibilityPath,
+
+        [Parameter(Mandatory)]
+        [string] $OutputPath
+    )
+
+    $inventory = Read-VcfJsonFile -LiteralPath $InventoryPath
+    $compatibility = Read-VcfJsonFile -LiteralPath $CompatibilityPath
+    $management = @($inventory.domains | Where-Object { $_.role -eq 'management' })
+    $workload = @($inventory.domains | Where-Object { $_.role -eq 'workload' })
+    if ($management.Count -ne 1 -or $workload.Count -ne 1) {
+        throw 'Inventory must contain exactly one management and one workload domain.'
+    }
+    $management = $management[0]
+    $workload = $workload[0]
+    if ($inventory.targetRelease -ne $compatibility.targetRelease) {
+        throw 'Inventory and compatibility snapshot target releases differ.'
+    }
+
+    $releasePath = @(
+        Get-VcfSupportedReleasePath -Compatibility $compatibility `
+            -Source ([string]$workload.release) -Target ([string]$inventory.targetRelease)
+    )
+    $workloadVcenter = @($workload.components | Where-Object { $_.type -eq 'VCENTER' })
+    if ($workloadVcenter.Count -ne 1) {
+        throw 'Workload domain must contain exactly one vCenter component.'
+    }
+
+    $components = [System.Collections.Generic.List[object]]::new()
+    foreach ($domain in $inventory.domains) {
+        foreach ($component in $domain.components) {
+            $isManagement = $domain.role -eq 'management'
+            $targetVersion = if ($isManagement) {
+                [string]$component.version
+            }
+            else {
+                Get-VcfBomVersion -Compatibility $compatibility `
+                    -Release ([string]$inventory.targetRelease) -ComponentType ([string]$component.type
+                )
+            }
+            $components.Add([pscustomobject][ordered]@{
+                    id = [string]$component.id
+                    domainId = [string]$domain.id
+                    role = [string]$domain.role
+                    type = [string]$component.type
+                    fqdn = [string]$component.fqdn
+                    currentVersion = [string]$component.version
+                    targetVersion = $targetVersion
+                    disposition = if ($isManagement) { 'PRESERVE' } else { 'UPGRADE' }
+                    gates = @(Get-VcfComponentGates -ComponentType ([string]$component.type) `
+                            -Role ([string]$domain.role) -ReleasePath $releasePath `
+                            -Compatibility $compatibility)
+                })
+        }
+    }
+
+    $managementIds = @($management.components | ForEach-Object { [string]$_.id })
+    $workloadIdsByType = @{}
+    foreach ($componentType in $compatibility.componentOrder) {
+        $workloadIdsByType[[string]$componentType] = @(
+            $workload.components |
+                Where-Object { $_.type -eq $componentType } |
+                ForEach-Object { [string]$_.id }
+        )
+    }
+
+    $gates = [System.Collections.Generic.List[object]]::new()
+    $gates.Add([pscustomobject][ordered]@{
+            id = 'management-domain-unchanged'
+            type = 'INVARIANT'
+            subjectIds = $managementIds
+            expectedStatus = 'UNCHANGED'
+        })
+    $gates.Add([pscustomobject][ordered]@{
+            id = 'source-health-green'
+            type = 'HEALTH'
+            subjectIds = @([string]$workload.id)
+            expectedStatus = 'GREEN'
+        })
+    $gates.Add([pscustomobject][ordered]@{
+            id = [string]$compatibility.hardwareGate
+            type = 'COMPATIBILITY'
+            subjectIds = @($workloadIdsByType['ESXI_HOST'])
+            expectedStatus = 'SUPPORTED'
+        })
+
+    for ($hopIndex = 0; $hopIndex -lt $releasePath.Count - 1; $hopIndex++) {
+        $release = $releasePath[$hopIndex + 1]
+        $releaseBundles = $compatibility.bundleIds.PSObject.Properties[$release].Value
+        $bundleIds = @(
+            foreach ($componentType in $compatibility.componentOrder) {
+                [string]$releaseBundles.PSObject.Properties[[string]$componentType].Value
+            }
+        )
+        $gates.Add([pscustomobject][ordered]@{
+                id = "bundles-staged-$release"
+                type = 'BUNDLE'
+                subjectIds = @([string]$workload.id)
+                expectedStatus = 'AVAILABLE'
+                bundleIds = $bundleIds
+            })
+        $gates.Add([pscustomobject][ordered]@{
+                id = "upgrade-precheck-$release"
+                type = 'PRECHECK'
+                subjectIds = @([string]$workload.id)
+                expectedStatus = 'SUCCEEDED'
+            })
+        $gates.Add([pscustomobject][ordered]@{
+                id = "nsx-complete-$release"
+                type = 'DEPENDENCY'
+                subjectIds = @($workloadIdsByType['NSX_MANAGER'])
+                expectedStatus = 'COMPLETED'
+            })
+        $gates.Add([pscustomobject][ordered]@{
+                id = "vcenter-complete-$release"
+                type = 'DEPENDENCY'
+                subjectIds = @($workloadIdsByType['VCENTER'])
+                expectedStatus = 'COMPLETED'
+            })
+        $gates.Add([pscustomobject][ordered]@{
+                id = "esxi-complete-$release"
+                type = 'DEPENDENCY'
+                subjectIds = @($workloadIdsByType['ESXI_HOST'])
+                expectedStatus = 'COMPLETED'
+            })
+    }
+
+    $steps = [System.Collections.Generic.List[object]]::new()
+    $sequence = 1
+    for ($hopIndex = 0; $hopIndex -lt $releasePath.Count - 1; $hopIndex++) {
+        $releaseFrom = $releasePath[$hopIndex]
+        $releaseTo = $releasePath[$hopIndex + 1]
+        foreach ($componentTypeValue in $compatibility.componentOrder) {
+            $componentType = [string]$componentTypeValue
+            $completionPrefix = switch ($componentType) {
+                'NSX_MANAGER' { 'nsx' }
+                'VCENTER' { 'vcenter' }
+                'ESXI_HOST' { 'esxi' }
+                default { throw "Unsupported component order entry '$componentType'." }
+            }
+            $steps.Add([pscustomobject][ordered]@{
+                    sequence = $sequence
+                    releaseFrom = $releaseFrom
+                    releaseTo = $releaseTo
+                    componentType = $componentType
+                    componentIds = @($workloadIdsByType[$componentType])
+                    fromVersion = Get-VcfBomVersion -Compatibility $compatibility `
+                        -Release $releaseFrom -ComponentType $componentType
+                    toVersion = Get-VcfBomVersion -Compatibility $compatibility `
+                        -Release $releaseTo -ComponentType $componentType
+                    gates = @(Get-VcfStepGates -ComponentType $componentType -HopIndex $hopIndex `
+                            -ReleasePath $releasePath -Compatibility $compatibility)
+                    completionGate = "$completionPrefix-complete-$releaseTo"
+                })
+            $sequence++
+        }
+    }
+
+    $plan = [pscustomobject][ordered]@{
+        sddcId = [string]$inventory.integrationEnvelope.sddcId
+        workflowType = [string]$inventory.integrationEnvelope.workflowType
+        version = [string]$inventory.targetRelease
+        vcenterSpec = [pscustomobject][ordered]@{
+            vcenterHostname = [string]$workloadVcenter[0].fqdn
+            rootVcenterPassword = 'REDACTED!'
+            version = Get-VcfBomVersion -Compatibility $compatibility `
+                -Release ([string]$inventory.targetRelease) -ComponentType 'VCENTER'
+            useExistingDeployment = $true
+        }
+        networkSpecs = @($inventory.integrationEnvelope.networkSpecs)
+        dnsSpec = $inventory.integrationEnvelope.dnsSpec
+        schemaVersion = 1
+        estateId = [string]$inventory.estateId
+        workloadDomainId = [string]$workload.id
+        sourceRelease = [string]$workload.release
+        targetRelease = [string]$inventory.targetRelease
+        managementDomainPolicy = 'PRESERVE'
+        releasePath = $releasePath
+        components = @($components)
+        gates = @($gates)
+        steps = @($steps)
+    }
+
+    $parent = Split-Path -Parent $OutputPath
+    if ($parent) {
+        [System.IO.Directory]::CreateDirectory([System.IO.Path]::GetFullPath($parent)) | Out-Null
+    }
+    $plan | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $OutputPath -Encoding utf8
+    return $plan
+}
+
+Export-ModuleMember -Function Get-VcfWorkloadDomainInventory, New-VcfWorkloadDomainMigrationPlan

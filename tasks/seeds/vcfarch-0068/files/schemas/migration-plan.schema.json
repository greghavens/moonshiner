{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF brownfield workload-domain migration plan",
  "type": "object",
  "required": [
    "sddcId",
    "workflowType",
    "version",
    "vcenterSpec",
    "networkSpecs",
    "dnsSpec",
    "schemaVersion",
    "estateId",
    "workloadDomainId",
    "sourceRelease",
    "targetRelease",
    "managementDomainPolicy",
    "releasePath",
    "components",
    "gates",
    "steps"
  ],
  "properties": {
    "sddcId": {
      "type": "string"
    },
    "workflowType": {
      "const": "VCF_EXTEND"
    },
    "version": {
      "type": "string"
    },
    "vcenterSpec": {
      "type": "object"
    },
    "networkSpecs": {
      "type": "array"
    },
    "dnsSpec": {
      "type": "object"
    },
    "schemaVersion": {
      "const": 1
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "workloadDomainId": {
      "type": "string",
      "minLength": 1
    },
    "sourceRelease": {
      "type": "string",
      "minLength": 1
    },
    "targetRelease": {
      "type": "string",
      "minLength": 1
    },
    "managementDomainPolicy": {
      "const": "PRESERVE"
    },
    "releasePath": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "component": {
      "type": "object",
      "required": [
        "id",
        "domainId",
        "role",
        "type",
        "fqdn",
        "currentVersion",
        "targetVersion",
        "disposition",
        "gates"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "domainId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "management",
            "workload"
          ]
        },
        "type": {
          "enum": [
            "SDDC_MANAGER",
            "NSX_MANAGER",
            "VCENTER",
            "ESXI_HOST"
          ]
        },
        "fqdn": {
          "type": "string",
          "minLength": 1
        },
        "currentVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "PRESERVE",
            "UPGRADE"
          ]
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": [
        "id",
        "type",
        "subjectIds",
        "expectedStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "INVARIANT",
            "HEALTH",
            "COMPATIBILITY",
            "BUNDLE",
            "PRECHECK",
            "DEPENDENCY"
          ]
        },
        "subjectIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expectedStatus": {
          "type": "string",
          "minLength": 1
        },
        "bundleIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": [
        "sequence",
        "releaseFrom",
        "releaseTo",
        "componentType",
        "componentIds",
        "fromVersion",
        "toVersion",
        "gates",
        "completionGate"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "releaseFrom": {
          "type": "string",
          "minLength": 1
        },
        "releaseTo": {
          "type": "string",
          "minLength": 1
        },
        "componentType": {
          "enum": [
            "NSX_MANAGER",
            "VCENTER",
            "ESXI_HOST"
          ]
        },
        "componentIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fromVersion": {
          "type": "string",
          "minLength": 1
        },
        "toVersion": {
          "type": "string",
          "minLength": 1
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "completionGate": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}

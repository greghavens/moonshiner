+func writeContract(t *testing.T, ops []map[string]any) string {
+	t.Helper()
+	raw, err := json.Marshal(map[string]any{
+		"api":        map[string]any{"version": "9.1"},
+		"operations": ops,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := filepath.Join(t.TempDir(), "contract.json")
+	if err := os.WriteFile(p, raw, 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return p

+const (
+	opDeploymentRequests = "getDeploymentRequests"
+	opRequest            = "getRequest"
+	opRequestEvents      = "getRequestEvents"
+	opEventLogs          = "getEventLogs"
+)
+
+// failedStatus is the request status the diagnosis looks for.
+const failedStatus = "FAILED"
+
+// errorPrefix marks a log line that reports an error. The first such line, in
+// event order then row order, is the root cause; anything after it is fallout.
+const errorPrefix = "ERROR "
+

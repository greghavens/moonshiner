 )
 
 // Config configures a Client.
@@ -103,6 +109,21 @@ func (e *APIError) Error() string {
 	return fmt.Sprintf("vcfdiag: %s: unexpected status %d: %s", e.Op, e.StatusCode, e.Body)
 }
 
+// Contract operation ids, as named in docs/contract.json.
+const (
+	opDeploymentRequests = "getDeploymentRequests"
+	opRequest            = "getRequest"
+	opRequestEvents      = "getRequestEvents"
+	opEventLogs          = "getEventLogs"
+)
+
+// failedStatus is the request status the diagnosis looks for.
+const failedStatus = "FAILED"
+
+// errorPrefix marks a log line that reports an error. The first such line, in
+// event order then row order, is the root cause; anything after it is fallout.
+const errorPrefix = "ERROR "
+
 // Client talks to one VCF Automation endpoint.
 type Client struct {
 	baseURL string
@@ -112,11 +133,287 @@ type Client struct {
 
 // New returns a Client for cfg.
 func New(cfg Config) (*Client, error) {
-	return nil, errors.New("vcfdiag: New not implemented")
+	base := strings.TrimRight(cfg.BaseURL, "/")
+	if base == "" {
+		return nil, fmt.Errorf("%w: BaseURL is required", ErrInvalidRequest)
+	}
+	u, err := url.Parse(base)
+	if err != nil {
+		return nil, fmt.Errorf("%w: BaseURL %q: %v", ErrInvalidRequest, cfg.BaseURL, err)
+	}
+	if !u.IsAbs() || u.Host == "" {
+		return nil, fmt.Errorf("%w: BaseURL %q must be absolute", ErrInvalidRequest, cfg.BaseURL)
+	}
+	if cfg.Token == "" {
+		return nil, fmt.Errorf("%w: Token is required", ErrInvalidRequest)
+	}
+
+	hc := cfg.HTTPClient
+	if hc == nil {
+		hc = &http.Client{Timeout: 30 * time.Second}
+	}
+	return &Client{baseURL: base, token: cfg.Token, hc: hc}, nil
+}
+
+// ---------------------------------------------------------------------------
+// wire types
+// ---------------------------------------------------------------------------
+
+type pageOfRequests struct {
+	Content []apiRequest `json:"content"`
+}
+
+type apiRequest struct {
+	ID      string `json:"id"`
+	Name    string `json:"name"`
+	Status  string `json:"status"`
+	Details string `json:"details"`
+}
+
+type pageOfEvents struct {
+	Content []apiEvent `json:"content"`
 }
 
+type apiEvent struct {
+	ID           string `json:"id"`
+	Name         string `json:"name"`
+	Details      string `json:"details"`
+	Timestamp    string `json:"timestamp"`
+	ResourceName string `json:"resourceName"`
+	ResourceType string `json:"resourceType"`
+	HasLogs      bool   `json:"hasLogs"`
+	UserEvent    bool   `json:"userEvent"`
+}
+
+type sliceOfLogs struct {
+	Content          []apiLogLine `json:"content"`
+	Last             bool         `json:"last"`
+	NumberOfElements int          `json:"numberOfElements"`
+}
+
+type apiLogLine struct {
+	ID        string `json:"id"`
+	Message   string `json:"message"`
+	Rownum    int    `json:"rownum"`
+	Timestamp string `json:"timestamp"`
+	EOF       bool   `json:"eof"`
+}
+
+// ---------------------------------------------------------------------------
+// Diagnose
+// ---------------------------------------------------------------------------
+
 // Diagnose walks the deployment's most recent failed request down to the log
 // line that explains it.
 func (c *Client) Diagnose(ctx context.Context, req DiagnoseRequest) (*Diagnosis, error) {
-	return nil, errors.New("vcfdiag: Diagnose not implemented")
+	if err := validate(req); err != nil {
+		return nil, err
+	}
+
+	// 1. The deployment's requests, newest first.
+	failed, err := c.latestFailedRequest(ctx, req)
+	if err != nil {
+		return nil, err
+	}
+
+	// 2. The failed request itself, for its details.
+	full, err := c.request(ctx, failed.ID)
+	if err != nil {
+		return nil, err
+	}
+
+	// 3. Its events, oldest first.
+	events, err := c.events(ctx, failed.ID, req.PageSize)
+	if err != nil {
+		return nil, err
+	}
+
+	// 4. Every log line of every event that has logs, in event order.
+	d := &Diagnosis{
+		DeploymentID:   req.DeploymentID,
+		RequestID:      full.ID,
+		RequestName:    full.Name,
+		RequestStatus:  full.Status,
+		RequestDetails: full.Details,
+	}
+	type sourced struct {
+		event apiEvent
+		line  LogLine
+	}
+	var all []sourced
+
+	for _, ev := range events {
+		if !ev.HasLogs {
+			continue
+		}
+		lines, err := c.eventLogs(ctx, failed.ID, ev.ID)
+		if err != nil {
+			return nil, err
+		}
+		for _, l := range lines {
+			line := LogLine{
+				EventID:   ev.ID,
+				Rownum:    l.Rownum,
+				Message:   l.Message,
+				Timestamp: l.Timestamp,
+			}
+			d.LogLines = append(d.LogLines, line)
+			all = append(all, sourced{event: ev, line: line})
+		}
+	}
+
+	// 5. The first error line is the cause; later ones are its consequences.
+	for _, s := range all {
+		if !strings.HasPrefix(s.line.Message, errorPrefix) {
+			continue
+		}
+		d.EventID = s.event.ID
+		d.EventName = s.event.Name
+		d.ResourceName = s.event.ResourceName
+		d.RootCause = s.line.Message
+		return d, nil
+	}
+
+	return nil, fmt.Errorf("%w: request %s emitted %d log lines, none of them an error",
+		ErrNoRootCause, failed.ID, len(d.LogLines))
+}
+
+func validate(req DiagnoseRequest) error {
+	if req.DeploymentID == "" {
+		return fmt.Errorf("%w: DeploymentID is required", ErrInvalidRequest)
+	}
+	if strings.ContainsAny(req.DeploymentID, "/?#") {
+		return fmt.Errorf("%w: DeploymentID %q may not contain '/', '?' or '#'",
+			ErrInvalidRequest, req.DeploymentID)
+	}
+	if req.PageSize < 0 {
+		return fmt.Errorf("%w: PageSize %d must not be negative", ErrInvalidRequest, req.PageSize)
+	}
+	return nil
+}
+
+func (c *Client) latestFailedRequest(ctx context.Context, req DiagnoseRequest) (apiRequest, error) {
+	q := url.Values{}
+	// The listing has to come back newest first for "most recent failure" to
+	// mean anything, so sort is always sent.
+	q.Set("sort", "createdAt,DESC")
+	if req.PageSize > 0 {
+		q.Set("size", strconv.Itoa(req.PageSize))
+	}
+	if req.Search != "" {
+		q.Set("search", req.Search)
+	}
+
+	var page pageOfRequests
+	path := "/deployment/api/deployments/" + url.PathEscape(req.DeploymentID) + "/requests"
+	if err := c.get(ctx, opDeploymentRequests, path, q, &page); err != nil {
+		return apiRequest{}, err
+	}
+	for _, r := range page.Content {
+		if r.Status == failedStatus {
+			return r, nil
+		}
+	}
+	return apiRequest{}, fmt.Errorf("%w: deployment %s", ErrNoFailedRequest, req.DeploymentID)
+}
+
+func (c *Client) request(ctx context.Context, requestID string) (apiRequest, error) {
+	var out apiRequest
+	// The reference documents no query parameters here, so none are sent.
+	path := "/deployment/api/requests/" + url.PathEscape(requestID)
+	if err := c.get(ctx, opRequest, path, nil, &out); err != nil {
+		return apiRequest{}, err
+	}
+	return out, nil
+}
+
+func (c *Client) events(ctx context.Context, requestID string, pageSize int) ([]apiEvent, error) {
+	q := url.Values{}
+	// Oldest first: the root cause is the first error in time order.
+	q.Set("sort", "timestamp,ASC")
+	if pageSize > 0 {
+		q.Set("size", strconv.Itoa(pageSize))
+	}
+
+	var page pageOfEvents
+	path := "/deployment/api/requests/" + url.PathEscape(requestID) + "/events"
+	if err := c.get(ctx, opRequestEvents, path, q, &page); err != nil {
+		return nil, err
+	}
+	return page.Content, nil
+}
+
+// eventLogs follows the slice to the end of the log. The first call omits
+// sinceRow entirely; each later call asks for the row after the last one read.
+func (c *Client) eventLogs(ctx context.Context, requestID, eventID string) ([]apiLogLine, error) {
+	path := "/deployment/api/requests/" + url.PathEscape(requestID) +
+		"/events/" + url.PathEscape(eventID) + "/logs"
+
+	var out []apiLogLine
+	sinceRow := 0
+
+	for {
+		var q url.Values
+		if sinceRow > 0 {
+			q = url.Values{"sinceRow": []string{strconv.Itoa(sinceRow)}}
+		}
+
+		var slice sliceOfLogs
+		if err := c.get(ctx, opEventLogs, path, q, &slice); err != nil {
+			return nil, err
+		}
+		if len(slice.Content) == 0 {
+			return out, nil
+		}
+		out = append(out, slice.Content...)
+
+		last := slice.Content[len(slice.Content)-1]
+		if slice.Last || last.EOF {
+			return out, nil
+		}
+		next := last.Rownum + 1
+		if next <= sinceRow {
+			// The server is not advancing; stop rather than loop forever.
+			return out, nil
+		}
+		sinceRow = next
+	}
+}
+
+// ---------------------------------------------------------------------------
+// transport
+// ---------------------------------------------------------------------------
+
+// get issues one GET and decodes a 2xx JSON body into out. A query with no
+// values produces no query string at all.
+func (c *Client) get(ctx context.Context, op, path string, q url.Values, out any) error {
+	target := c.baseURL + path
+	if encoded := q.Encode(); encoded != "" {
+		target += "?" + encoded
+	}
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, target, nil)
+	if err != nil {
+		return fmt.Errorf("vcfdiag: %s: %w", op, err)
+	}
+	req.Header.Set("Authorization", "Bearer "+c.token)
+	req.Header.Set("Accept", "application/json")
+
+	resp, err := c.hc.Do(req)
+	if err != nil {
+		return fmt.Errorf("vcfdiag: %s: %w", op, err)
+	}
+	defer resp.Body.Close()
+
+	body, err := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
+	if err != nil {
+		return fmt.Errorf("vcfdiag: %s: reading response: %w", op, err)
+	}
+	if resp.StatusCode < 200 || resp.StatusCode > 299 {
+		return &APIError{Op: op, StatusCode: resp.StatusCode, Body: strings.TrimSpace(string(body))}
+	}
+	if err := json.Unmarshal(body, out); err != nil {
+		return fmt.Errorf("vcfdiag: %s: decoding response: %w", op, err)
+	}
+	return nil
 }

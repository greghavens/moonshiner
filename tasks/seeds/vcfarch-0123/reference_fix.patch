+
+func decode(raw []byte, destination any) error {
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(destination); err != nil {
+		return err
+	}
+	if err := decoder.Decode(&struct{}{}); err != io.EOF {
+		if err == nil {
+			return fmt.Errorf("multiple JSON values")
+		}
+		return err
+	}
+	return nil
+}
+
+func validateInputs(inventory estate, snapshot compatibilitySnapshot) error {
+	if inventory.EstateID == "" || inventory.FleetID == "" || inventory.DesiredFleetVersion == "" {
+		return fmt.Errorf("estate identity and target are required")
+	}
+	if inventory.DesiredFleetVersion != snapshot.FleetTarget || inventory.Greenfield.Version != snapshot.FleetTarget {
+		return fmt.Errorf("estate, greenfield, and snapshot targets must match")
+	}
+	if len(inventory.Components) == 0 {
+		return fmt.Errorf("estate has no components")
+	}
+	if len(inventory.Greenfield.Hosts) == 0 || len(inventory.Greenfield.Networks) == 0 {
+		return fmt.Errorf("greenfield hosts and networks are required")
+	}
+	gateIDs := make(map[string]bool, len(snapshot.Gates))
+	for _, gate := range snapshot.Gates {
+		if gate.ID == "" || gateIDs[gate.ID] {
+			return fmt.Errorf("snapshot contains an empty or duplicate gate")
+		}
+		gateIDs[gate.ID] = true
+	}
+	for _, path := range snapshot.SupportedPaths {
+		if len(path.Path) < 2 || path.Path[0] != path.FromVersion || path.Path[len(path.Path)-1] != path.TargetVersion {
+			return fmt.Errorf("invalid pinned path for %s %s", path.ComponentType, path.FromVersion)
+		}
+		if snapshot.ComponentTargets[path.ComponentType] != path.TargetVersion {
+			return fmt.Errorf("path target differs from component target for %s", path.ComponentType)
+		}
+		for _, gateID := range path.RequiredGates {
+			if !gateIDs[gateID] {
+				return fmt.Errorf("path names unknown gate %s", gateID)
+			}
+		}
+	}
+	return nil
+}
+
+func orderComponents(components []component, relations []precedence) ([]component, error) {
+	byID := make(map[string]component, len(components))
+	indegree := make(map[string]int, len(components))
+	successors := make(map[string][]string, len(components))
+	for _, item := range components {
+		if item.ID == "" || item.Type == "" || item.Version == "" || item.Control == "" {
+			return nil, fmt.Errorf("component identity, type, version, and control are required")
+		}
+		if _, exists := byID[item.ID]; exists {
+			return nil, fmt.Errorf("duplicate component %s", item.ID)
+		}
+		byID[item.ID] = item
+		indegree[item.ID] = 0
+	}
+	for _, relation := range relations {
+		if _, exists := byID[relation.Before]; !exists {
+			return nil, fmt.Errorf("precedence names unknown component %s", relation.Before)
+		}
+		if _, exists := byID[relation.After]; !exists {
+			return nil, fmt.Errorf("precedence names unknown component %s", relation.After)
+		}
+		successors[relation.Before] = append(successors[relation.Before], relation.After)
+		indegree[relation.After]++
+	}
+
+	ordered := make([]component, 0, len(components))
+	emitted := make(map[string]bool, len(components))
+	for len(ordered) < len(components) {
+		found := false
+		for _, item := range components {
+			if !emitted[item.ID] && indegree[item.ID] == 0 {
+				emitted[item.ID] = true
+				ordered = append(ordered, item)
+				for _, successor := range successors[item.ID] {
+					indegree[successor]--
+				}
+				found = true
+				break
+			}
+		}
+		if !found {
+			return nil, fmt.Errorf("component precedence contains a cycle")
+		}
+	}
+	return ordered, nil
+}
+
+func resolvePaths(components []component, snapshot compatibilitySnapshot) (map[string]supportedPath, error) {
+	resolved := make(map[string]supportedPath, len(components))
+	for _, item := range components {
+		matches := make([]supportedPath, 0, 1)
+		for _, path := range snapshot.SupportedPaths {
+			if path.ComponentType == item.Type && path.FromVersion == item.Version {
+				matches = append(matches, path)
+			}
+		}
+		if len(matches) != 1 {
+			return nil, fmt.Errorf("component %s has %d pinned paths", item.ID, len(matches))
+		}
+		resolved[item.ID] = matches[0]
+	}
+	return resolved, nil
+}
+
+func selectEdgeProfile(requirement edgeRequirement, snapshot edgeSnapshot) (edgeProfile, error) {
+	if requirement.RequiredNorthSouthGbps <= 0 || math.IsNaN(requirement.RequiredNorthSouthGbps) || math.IsInf(requirement.RequiredNorthSouthGbps, 0) {
+		return edgeProfile{}, fmt.Errorf("Edge throughput must be a positive finite value")
+	}
+	design := snapshot.RequiredDesign
+	if !requirement.SurviveSingleNodeFailure || !requirement.SurviveSingleUplinkFailure {
+		return edgeProfile{}, fmt.Errorf("estate failure requirements are incomplete")
+	}
+	if requirement.NodeCount != design.NodeCount || requirement.Tier0Mode != design.Tier0Mode ||
+		requirement.Routing != design.Routing || requirement.OverlayTeaming != design.OverlayTeaming {
+		return edgeProfile{}, fmt.Errorf("estate Edge topology differs from pinned design")
+	}
+	if len(requirement.AvailableUplinks) != design.UplinksPerNode {
+		return edgeProfile{}, fmt.Errorf("wrong number of Edge uplinks")
+	}
+	tors := make(map[string]bool, len(requirement.AvailableUplinks))
+	vlans := make(map[int]bool, len(requirement.AvailableUplinks))
+	for _, uplink := range requirement.AvailableUplinks {
+		if uplink.Name == "" || uplink.TOR == "" || uplink.LinkGbps != design.LinkGbps || uplink.LinkGbps < requirement.RequiredNorthSouthGbps {
+			return edgeProfile{}, fmt.Errorf("Edge uplink cannot carry the required failure load")
+		}
+		tors[uplink.TOR] = true
+		vlans[uplink.VLANID] = true
+	}
+	if design.DistinctTORs && len(tors) != len(requirement.AvailableUplinks) {
+		return edgeProfile{}, fmt.Errorf("Edge uplinks must use distinct ToRs")
+	}
+	if design.DistinctUplinkVLANs && len(vlans) != len(requirement.AvailableUplinks) {
+		return edgeProfile{}, fmt.Errorf("Edge uplinks must use distinct VLANs")
+	}
+
+	selected := edgeProfile{}
+	for _, profile := range snapshot.Profiles {
+		if profile.MaxNorthSouthGbpsPerNode >= requirement.RequiredNorthSouthGbps &&
+			(selected.FormFactor == "" || profile.MaxNorthSouthGbpsPerNode < selected.MaxNorthSouthGbpsPerNode) {
+			selected = profile
+		}
+	}
+	if selected.FormFactor == "" {
+		return edgeProfile{}, fmt.Errorf("no Edge profile satisfies %.2f Gbps", requirement.RequiredNorthSouthGbps)
+	}
+	return selected, nil
+}
+
+func buildSddcSpec(input greenfield) sddcSpec {
+	hosts := make([]hostSpec, len(input.Hosts))
+	for index, hostname := range input.Hosts {
+		hosts[index] = hostSpec{Hostname: hostname}
+	}
+	managers := make([]nsxtManagerSpec, len(input.NSX.Managers))
+	for index, hostname := range input.NSX.Managers {
+		managers[index] = nsxtManagerSpec{Hostname: hostname}
+	}
+	networkTypes := make([]string, len(input.Networks))
+	for index, item := range input.Networks {
+		networkTypes[index] = item.NetworkType
+	}
+	return sddcSpec{
+		SddcID:       input.SddcID,
+		WorkflowType: input.WorkflowType,
+		HostSpecs:    hosts,
+		Version:      input.Version,
+		VcenterSpec: vcenterSpec{
+			VcenterHostname:     input.Vcenter.Hostname,
+			RootVcenterPassword: input.Vcenter.RootPassword,
+			VMSize:              input.Vcenter.VMSize,
+			StorageSize:         input.Vcenter.StorageSize,
+			SSODomain:           input.Vcenter.SSODomain,
+		},
+		ClusterSpec: input.Cluster,
+		DVSSpecs: []dvsSpec{{
+			DVSName:         input.DVS.Name,
+			MTU:             input.DVS.MTU,
+			Networks:        networkTypes,
+			VmnicsToUplinks: input.DVS.VmnicsToUplinks,
+		}},
+		NSXTSpec: nsxtSpec{
+			VIPFQDN:         input.NSX.VIPFQDN,
+			NSXTManagerSize: input.NSX.ManagerSize,
+			TransportVLANID: input.NSX.TransportVLANID,
+			NSXTManagers:    managers,
+		},
+		NetworkSpecs:       input.Networks,
+		DNSSpec:            input.DNS,
+		NTPServers:         input.NTPServers,
+		ManagementPoolName: input.ManagementPoolName,
+	}
+}
+
+func buildEdgeDesign(requirement edgeRequirement, design requiredEdgeDesign, profile edgeProfile) edgeDesign {
+	uplinks := make([]edgeDesignUplink, len(requirement.AvailableUplinks))
+	for index, uplink := range requirement.AvailableUplinks {
+		uplinks[index] = edgeDesignUplink{
+			Name:          uplink.Name,
+			TOR:           uplink.TOR,
+			VLANID:        uplink.VLANID,
+			LinkGbps:      uplink.LinkGbps,
+			TeamingPolicy: design.UplinkTeamingPolicy,
+		}
+	}
+	return edgeDesign{
+		RequiredNorthSouthGbps:     requirement.RequiredNorthSouthGbps,
+		FailureCapacityGbpsPerNode: profile.MaxNorthSouthGbpsPerNode,
+		FormFactor:                 profile.FormFactor,
+		NodeCount:                  design.NodeCount,
+		Tier0Mode:                  design.Tier0Mode,
+		Routing:                    design.Routing,
+		ECMP:                       design.ECMP,
+		OverlayTeaming:             design.OverlayTeaming,
+		Uplinks:                    uplinks,
+	}
+}
+
+func buildSteps(components []component, paths map[string]supportedPath) []migrationStep {
+	steps := make([]migrationStep, len(components))
+	for index, item := range components {
+		path := paths[item.ID]
+		steps[index] = migrationStep{
+			Order:         index + 1,
+			ComponentID:   item.ID,
+			ComponentType: item.Type,
+			FromVersion:   item.Version,
+			TargetVersion: path.TargetVersion,
+			Path:          append([]string(nil), path.Path...),
+			Action:        path.Action,
+			TargetControl: path.TargetControl,
+			GateIDs:       append([]string(nil), path.RequiredGates...),
+		}
+	}
+	return steps
 }

 // Build returns the deterministic architecture artifact derived from the
 // supplied estate inventory and pinned compatibility snapshot.
 func Build(estateJSON, snapshotJSON []byte) ([]byte, error) {
-	return nil, errors.New("vcf architecture builder is not implemented")
+	var inventory estate
+	if err := decode(estateJSON, &inventory); err != nil {
+		return nil, fmt.Errorf("decode estate: %w", err)
+	}
+	var snapshot compatibilitySnapshot
+	if err := decode(snapshotJSON, &snapshot); err != nil {
+		return nil, fmt.Errorf("decode compatibility snapshot: %w", err)
+	}
+	if err := validateInputs(inventory, snapshot); err != nil {
+		return nil, err
+	}
+
+	ordered, err := orderComponents(inventory.Components, snapshot.Precedence)
+	if err != nil {
+		return nil, err
+	}
+	pathByComponent, err := resolvePaths(ordered, snapshot)
+	if err != nil {
+		return nil, err
+	}
+	selectedProfile, err := selectEdgeProfile(inventory.EdgeRequirement, snapshot.Edge)
+	if err != nil {
+		return nil, err
+	}
+
+	result := artifact{
+		SchemaVersion: "1.0",
+		Greenfield:    buildSddcSpec(inventory.Greenfield),
+		EdgeDesign:    buildEdgeDesign(inventory.EdgeRequirement, snapshot.Edge.RequiredDesign, selectedProfile),
+		MigrationPlan: migrationPlan{
+			SchemaVersion: "1.0",
+			EstateID:      inventory.EstateID,
+			FleetID:       inventory.FleetID,
+			FleetTarget:   snapshot.FleetTarget,
+			Steps:         buildSteps(ordered, pathByComponent),
+		},
+	}
+	raw, err := json.MarshalIndent(result, "", "  ")
+	if err != nil {
+		return nil, fmt.Errorf("marshal architecture: %w", err)
+	}

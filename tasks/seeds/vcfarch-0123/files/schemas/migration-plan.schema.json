{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF point-solution migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "estateId",
    "fleetId",
    "fleetTarget",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "fleetId": {
      "type": "string",
      "minLength": 1
    },
    "fleetTarget": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "componentId",
          "componentType",
          "fromVersion",
          "targetVersion",
          "path",
          "action",
          "targetControl",
          "gateIds"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "componentType": {
            "type": "string",
            "enum": [
              "vcenter",
              "esxi",
              "vsan",
              "nsx",
              "live-site-recovery",
              "vsphere-replication"
            ]
          },
          "fromVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "action": {
            "type": "string",
            "enum": [
              "upgrade-and-convert",
              "upgrade-and-import",
              "upgrade-and-register"
            ]
          },
          "targetControl": {
            "type": "string",
            "enum": [
              "fleet-managed",
              "fleet-integrated-addon"
            ]
          },
          "gateIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

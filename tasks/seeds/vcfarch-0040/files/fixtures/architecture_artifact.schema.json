{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF architecture artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "greenfield", "existingEstateMigration"],
  "properties": {
    "schemaVersion": {"const": "vcf-architecture/v1"},
    "greenfield": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "designId",
        "supportedCombinationId",
        "requirements",
        "sites",
        "hostPlacements",
        "perHostCapacity",
        "derivedCapacity",
        "witness",
        "componentTargets",
        "sddcSpec"
      ],
      "properties": {
        "designId": {"type": "string"},
        "supportedCombinationId": {"type": "string"},
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dataHostCount",
            "hostsPerDataSite",
            "failuresToTolerate",
            "surviveEitherDataSiteLoss",
            "minimumSurvivingCores",
            "minimumSurvivingMemoryGiB",
            "minimumSurvivingRawVsanTb",
            "dataSiteRttMs",
            "maximumWitnessRttMs"
          ],
          "properties": {
            "dataHostCount": {"type": "integer", "minimum": 1},
            "hostsPerDataSite": {"type": "integer", "minimum": 1},
            "failuresToTolerate": {"type": "integer", "minimum": 0},
            "surviveEitherDataSiteLoss": {"type": "boolean"},
            "minimumSurvivingCores": {"type": "integer", "minimum": 1},
            "minimumSurvivingMemoryGiB": {"type": "integer", "minimum": 1},
            "minimumSurvivingRawVsanTb": {"type": "number", "exclusiveMinimum": 0},
            "dataSiteRttMs": {"type": "integer", "minimum": 0},
            "maximumWitnessRttMs": {"type": "integer", "minimum": 0}
          }
        },
        "sites": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["siteId", "role", "faultDomainId"],
            "properties": {
              "siteId": {"type": "string"},
              "role": {"enum": ["DATA", "WITNESS_ONLY"]},
              "faultDomainId": {"type": "string"}
            }
          }
        },
        "hostPlacements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hostname", "siteId", "faultDomainId", "role"],
            "properties": {
              "hostname": {"type": "string"},
              "siteId": {"type": "string"},
              "faultDomainId": {"type": "string"},
              "role": {"const": "DATA_HOST"}
            }
          }
        },
        "perHostCapacity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["physicalCores", "memoryGiB", "rawVsanTb"],
          "properties": {
            "physicalCores": {"type": "integer", "minimum": 1},
            "memoryGiB": {"type": "integer", "minimum": 1},
            "rawVsanTb": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "derivedCapacity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "afterEitherDataSiteLoss"],
          "properties": {
            "total": {"$ref": "#/$defs/capacity"},
            "afterEitherDataSiteLoss": {"$ref": "#/$defs/capacity"}
          }
        },
        "witness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostname", "siteId", "faultDomainId", "role", "providesDataCapacity"],
          "properties": {
            "hostname": {"type": "string"},
            "siteId": {"type": "string"},
            "faultDomainId": {"type": "string"},
            "role": {"const": "VSAN_WITNESS"},
            "providesDataCapacity": {"const": false}
          }
        },
        "componentTargets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/componentTarget"}
        },
        "sddcSpec": {"type": "object"}
      }
    },
    "existingEstateMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estateId", "targetRelease", "steps"],
      "properties": {
        "estateId": {"type": "string"},
        "targetRelease": {"type": "string"},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/migrationStep"}
        }
      }
    }
  },
  "$defs": {
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physicalCores", "memoryGiB", "rawVsanTb"],
      "properties": {
        "physicalCores": {"type": "integer", "minimum": 0},
        "memoryGiB": {"type": "integer", "minimum": 0},
        "rawVsanTb": {"type": "number", "minimum": 0}
      }
    },
    "componentTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "migrationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "componentId", "componentName", "currentVersion", "targetVersion", "gates"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "componentId": {"type": "string"},
        "componentName": {"type": "string"},
        "currentVersion": {"type": "string"},
        "targetVersion": {"type": "string"},
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

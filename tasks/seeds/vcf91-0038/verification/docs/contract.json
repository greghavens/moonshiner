{
  "contract_format": "focused-openapi-projection-v1",
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "repository_license": "Apache-2.0",
    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "openapi": "3.0.1",
    "info_title": "SDDC Manager API Reference Guide",
    "info_version": "9.1.0.0"
  },
  "operations": [
    {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": "TokenCreationSpec"
      },
      "responses": {
        "201": {
          "description": "Created",
          "mediaType": "application/json",
          "schema": "TokenPair"
        },
        "400": {
          "description": "Bad Request",
          "mediaType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "Internal Server Error",
          "mediaType": "application/json",
          "schema": "Error"
        }
      }
    },
    {
      "operationId": "getDomain",
      "method": "GET",
      "path": "/v1/domains/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Ok",
          "mediaType": "application/json",
          "schema": "Domain"
        },
        "404": {
          "description": "Domain not found",
          "mediaType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "InternalServerError",
          "mediaType": "application/json",
          "schema": "Error"
        }
      }
    },
    {
      "operationId": "refreshAccessToken",
      "method": "PATCH",
      "path": "/v1/tokens/access-token/refresh",
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": {
          "type": "string",
          "description": "ID of the refresh token"
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "mediaType": "application/json",
          "schema": {
            "type": "string"
          }
        },
        "400": {
          "description": "Bad Request",
          "mediaType": "application/json",
          "schema": "Error"
        },
        "404": {
          "description": "Not Found",
          "mediaType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "Internal Server Error",
          "mediaType": "application/json",
          "schema": "Error"
        }
      }
    }
  ],
  "schemas": {
    "TokenCreationSpec": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "Username"
        },
        "password": {
          "type": "string",
          "description": "User Password"
        },
        "apiKey": {
          "type": "string",
          "description": "API Key"
        },
        "idToken": {
          "type": "string",
          "description": "Id Token"
        }
      },
      "description": "The spec used to sign the token"
    },
    "RefreshToken": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Refresh token id that can be used to request new access token"
        }
      },
      "description": "This contains refresh token id for the user API access."
    },
    "TokenPair": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string",
          "description": "Bearer token that can be used to make public API calls"
        },
        "refreshToken": {
          "$ref": "#/components/schemas/RefreshToken"
        }
      },
      "description": "This contains the access token and the refresh token for the user API access."
    },
    "Domain": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID of the workload domain"
        },
        "name": {
          "type": "string",
          "description": "Name of the workload domain"
        },
        "status": {
          "type": "string",
          "description": "Status of the workload domain",
          "example": "One among: ACTIVE, ACTIVATING, UPGRADING, DISABLED, ERROR, SKIPPED, DEACTIVATING, EXPANDING, SHRINKING, CREATING"
        },
        "type": {
          "type": "string",
          "description": "Type of the workload domain"
        }
      },
      "description": "Represents a domain"
    },
    "Error": {
      "type": "object",
      "properties": {
        "errorCode": {
          "type": "string",
          "readOnly": true
        },
        "message": {
          "type": "string",
          "readOnly": true
        },
        "remediationMessage": {
          "type": "string"
        },
        "referenceToken": {
          "type": "string",
          "readOnly": true
        }
      }
    }
  }
}

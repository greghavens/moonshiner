+    private static String jsonObject(String json, String field) throws IOException {
+        Pattern pattern = Pattern.compile(
+                "\"" + Pattern.quote(field) + "\"\\s*:\\s*\\{([^{}]*)\\}");
+        Matcher matcher = pattern.matcher(json);
+        if (!matcher.find()) {
+            throw new IOException("Response is missing object field " + field);
+        }
+        return matcher.group(1);
+    }
+
+    private static String jsonString(String json, String field) throws IOException {
+        Pattern pattern = Pattern.compile(
+                "\"" + Pattern.quote(field)
+                        + "\"\\s*:\\s*\"((?:\\\\(?:[\"\\\\/bfnrt]|u[0-9a-fA-F]{4})|[^\"\\\\])*)\"");
+        Matcher matcher = pattern.matcher(json);
+        if (!matcher.find()) {
+            throw new IOException("Response is missing string field " + field);
+        }
+        return unescape(matcher.group(1));
+    }
+
+    private static String jsonDocumentString(String json) throws IOException {
+        Pattern pattern = Pattern.compile(
+                "\\s*\"((?:\\\\(?:[\"\\\\/bfnrt]|u[0-9a-fA-F]{4})|[^\"\\\\])*)\"\\s*");
+        Matcher matcher = pattern.matcher(json);
+        if (!matcher.matches()) {
+            throw new IOException("Response is not a JSON string");
+        }
+        return unescape(matcher.group(1));
+    }

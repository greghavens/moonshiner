  "authentication": {
    "scheme": "bearerAuth",
    "header": "Authorization: Bearer <access-token>"
  },
  "operations": [
    {
      "name": "Patch Deployment",
      "documented_operation": "PATCH Patch Deployment",
      "method": "PATCH",
      "path_template": "/deployment/api/deployments/{deploymentId}",
      "path_parameters": {
        "deploymentId": {
          "type": "string",
          "required": true
        }
      },
      "request": {
        "required": true,
        "content_type": "application/json",
        "type": "DeploymentUpdate",
        "fields": {
          "description": {
            "type": "string",
            "required": false,
            "max_length": 2000
          },
          "iconId": {
            "type": "string",
            "format": "uuid",
            "required": false
          },
          "name": {
            "type": "string",
            "required": false,
            "min_length": 1,
            "max_length": 900
          }
        },
        "omission_rule": "Optional fields that the caller did not set are absent from the JSON object; they are not represented by empty strings or null values."
      },
      "responses": {
        "200": "Deployment",
        "401": "Unauthorized",
        "403": "Forbidden",
        "404": "Not Found"
      }
    },
    {
      "name": "Submit Deployment Action Request",
      "documented_operation": "POST Submit Deployment Action Request",
      "method": "POST",
      "path_template": "/deployment/api/deployments/{deploymentId}/requests",
      "path_parameters": {
        "deploymentId": {
          "type": "string",
          "required": true
        }
      },
      "request": {
        "required": true,
        "content_type": "application/json",
        "type": "ResourceActionRequest",
        "fields": {
          "actionId": {
            "type": "string",
            "required": false
          },
          "inputs": {
            "type": "object",
            "required": false
          },
          "reason": {
            "type": "string",
            "required": false
          }
        },
        "omission_rule": "Optional fields that the caller did not set are absent from the JSON object; they are not represented by empty strings or null values."
      },
      "responses": {
        "200": "Request",
        "401": "Unauthorized",
        "403": "Forbidden",
        "404": "Not Found",
        "409": "Conflict"
      }
    },
    {
      "name": "Get Request",
      "documented_operation": "GET Get Request",
      "method": "GET",
      "path_template": "/deployment/api/requests/{requestId}",
      "path_parameters": {
        "requestId": {
          "type": "string",
          "required": true
        }
      },
      "request": null,
      "responses": {
        "200": "Request",
        "401": "Unauthorized",
        "404": "Not Found"
      },
      "request_status_values": [
        "CREATED",
        "PENDING",
        "INITIALIZATION",
        "CHECKING_APPROVAL",
        "APPROVAL_PENDING",
        "USER_INTERACTION_PENDING",
        "INPROGRESS",
        "COMPLETION",
        "APPROVAL_REJECTED",
        "ABORTED",
        "SUCCESSFUL",
        "FAILED"
      ]
    }
  ]

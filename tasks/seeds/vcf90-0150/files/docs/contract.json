{
  "product": "VMware Cloud Foundation Automation 9.0",
  "interface": "VCF Automation deployment REST API",
  "source": {
    "kind": "reference-documentation",
    "statement": "This contract is derived from the authoritative Broadcom VCF Automation 9.0 xAPIs reference documentation, not from a published specification. VCF Automation has no published specification in vmware/vcf-api-specs."

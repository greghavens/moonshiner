{
  "contract_format": "focused-openapi-projection-v1",
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "repository_license": "Apache-2.0",
    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "openapi": "3.0.1",
    "info_title": "SDDC Manager API Reference Guide",
    "info_version": "9.1.0.0"
  },
  "operations": [
    {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "summary": "Create Token Pair",
      "description": "Creates access token and refresh token for user access",
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": "TokenCreationSpec"
      },
      "responses": {
        "201": {
          "description": "Created",
          "mediaType": "application/json",
          "schema": "TokenPair"
        },
        "400": {
          "description": "Bad Request",
          "mediaType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "Internal Server Error",
          "mediaType": "application/json",
          "schema": "Error"
        }
      }
    },
    {
      "operationId": "getHosts",
      "method": "GET",
      "path": "/v1/hosts",
      "summary": "Get all hosts",
      "queryParameters": [
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "pageNumber",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "fqdn",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "status",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "domainId",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "clusterId",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "networkpoolId",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "storageType",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "datastoreName",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "ipAddressVersionForVmotion",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "isStandalone",
          "in": "query",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "isLifecycleManaged",
          "in": "query",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "isVsanWitnessHost",
          "in": "query",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "size",
          "in": "query",
          "required": false,
          "deprecated": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "page",
          "in": "query",
          "required": false,
          "deprecated": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Ok",
          "mediaType": "application/json",
          "schema": "PageOfHost"
        },
        "400": {
          "description": "Bad Request",
          "mediaType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "Internal server error",
          "mediaType": "application/json",
          "schema": "Error"
        }
      }
    }
  ],
  "schemas": {
    "TokenCreationSpec": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "Username"
        },
        "password": {
          "type": "string",
          "description": "User Password"
        },
        "apiKey": {
          "type": "string",
          "description": "API Key"
        },
        "idToken": {
          "type": "string",
          "description": "Id Token"
        }
      },
      "description": "The spec used to sign the token"
    },
    "RefreshToken": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Refresh token id that can be used to request new access token"
        }
      },
      "description": "This contains refresh token id for the user API access."
    },
    "TokenPair": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string",
          "description": "Bearer token that can be used to make public API calls"
        },
        "refreshToken": {
          "$ref": "#/components/schemas/RefreshToken"
        }
      },
      "description": "This contains the access token and the refresh token for the user API access."
    },
    "PageOfHost": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "description": "The list of elements included in this page",
          "items": {
            "$ref": "#/components/schemas/Host"
          }
        },
        "pageMetadata": {
          "$ref": "#/components/schemas/PageMetadata"
        }
      }
    },
    "PageMetadata": {
      "type": "object",
      "properties": {
        "pageNumber": {
          "type": "integer",
          "format": "int32"
        },
        "pageSize": {
          "type": "integer",
          "format": "int32"
        },
        "totalElements": {
          "type": "integer",
          "format": "int32"
        },
        "totalPages": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "Host": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "fqdn": {
          "type": "string",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "readOnly": true
        },
        "isStandalone": {
          "type": "boolean",
          "readOnly": true
        },
        "isLifecycleManaged": {
          "type": "boolean",
          "readOnly": true
        },
        "isVsanWitnessHost": {
          "type": "boolean",
          "readOnly": true
        }
      },
      "projection_note": "Only Host properties consumed by this task are included in this focused projection."
    },
    "Error": {
      "type": "object",
      "properties": {
        "errorCode": {
          "type": "string",
          "readOnly": true
        },
        "message": {
          "type": "string",
          "readOnly": true
        },
        "remediationMessage": {
          "type": "string"
        },
        "referenceToken": {
          "type": "string",
          "readOnly": true
        }
      },
      "projection_note": "Only Error properties relevant to the focused operations are included."
    }
  },
  "client_policy": {
    "first_request": "Pass pageSize and omit pageNumber because getHosts declares pageNumber optional and declares no default.",
    "continuation": "Use pageMetadata.pageNumber + 1 only after a response proves the server's current page number.",
    "completion": "Accumulate elements until the count equals pageMetadata.totalElements; reject changing totals, overshoot, repeated pages, and non-progressing pages.",
    "optional_filter": "Pass status on every page only when the caller explicitly binds a nonblank value; omit every other optional getHosts parameter.",
    "ordering": {
      "comparison": "ordinal case-sensitive",
      "keys": [
        "fqdn",
        "id"
      ]
    },
    "projection_key_order": [
      "id",
      "fqdn",
      "status",
      "isStandalone",
      "isLifecycleManaged",
      "isVsanWitnessHost"
    ],
    "export": {
      "root_key_order": [
        "hosts"
      ],
      "json": "compact",
      "encoding": "UTF-8 without BOM",
      "terminator": "one LF byte"
    }
  }
}

  "schemas": {
    "PageDeploymentResource": {
      "type": "object",
      "properties": {
        "content": { "type": "array", "items": { "$ref": "DeploymentResource" } },
        "empty": { "type": "boolean" },
        "first": { "type": "boolean" },
        "last": { "type": "boolean" },
        "number": { "type": "integer", "format": "int32" },
        "numberOfElements": { "type": "integer", "format": "int32" },
        "size": { "type": "integer", "format": "int32" },
        "totalElements": { "type": "integer", "format": "int64" },
        "totalPages": { "type": "integer", "format": "int32" },
        "pageable": { "type": "object" },
        "sort": { "type": "object" }
      }
    },
    "DeploymentResource": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string" },
        "state": { "type": "string" },
        "origin": { "type": "string" },
        "createdAt": { "type": "string" },
        "syncStatus": { "type": "string" },
        "currentRequest": { "type": "object" },
        "expense": { "type": "object" },
        "properties": { "type": "object" },
        "dependsOn": { "type": "array", "items": { "type": "string" } },
        "inprogressRequests": { "type": "object" }
      }
    },
    "ResourceActionList": {
      "type": "array",
      "items": { "$ref": "ResourceAction" }
    },
    "ResourceAction": {
      "type": "object",
      "properties": {
        "actionType": { "type": "string" },
        "dependents": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "displayName": { "type": "string" },
        "formDefinition": { "$ref": "FormDefinition" },
        "id": { "type": "string" },
        "name": { "type": "string" },
        "orgId": { "type": "string" },
        "projectId": { "type": "string" },
        "schema": { "type": "object" },
        "valid": { "type": "boolean" }
      }
    },
    "FormDefinition": {
      "type": "object",
      "properties": {
        "formURI": { "type": "string" },
        "trackProgressInModal": { "type": "boolean" }
      }
    },
    "ResourceActionRequest": {
      "type": "object",
      "required": [],
      "properties": {
        "actionId": { "type": "string", "description": "The identifier of the action to perform." },
        "inputs": { "type": "object", "description": "Action input parameters." },
        "reason": { "type": "string", "description": "Justification for requesting the day2 operation." }
      }
    },
    "Request": {
      "type": "object",
      "required": ["completedTasks", "createdAt", "name", "requestedBy", "totalTasks"],
      "properties": {
        "actionId": { "type": "string" },
        "approvedAt": { "type": "string", "format": "date-time" },
        "blueprintId": { "type": "string" },
        "cancelable": { "type": "boolean" },
        "catalogItemId": { "type": "string" },
        "completedAt": { "type": "string", "format": "date-time" },
        "completedTasks": { "type": "integer", "format": "int32" },
        "createdAt": { "type": "string", "format": "date-time" },
        "deploymentId": { "type": "string", "format": "uuid" },
        "details": { "type": "string" },
        "dismissed": { "type": "boolean" },
        "estimatedCompletionTime": { "type": "string", "format": "date-time" },
        "id": { "type": "string", "format": "uuid" },
        "initializedAt": { "type": "string", "format": "date-time" },
        "inputs": { "type": "object" },
        "name": { "type": "string" },
        "outputs": { "type": "object" },
        "requestedBy": { "type": "string" },
        "resourceIds": { "type": "array", "items": { "type": "string" } },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "id": { "type": "string" },
              "name": { "type": "string" },
              "version": { "type": "string" }
            }
          }
        },
        "status": { "type": "string" },
        "totalTasks": { "type": "integer", "format": "int32" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }

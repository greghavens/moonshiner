+
+function Get-VcfAutomationRequestUri {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][object]$Connection,
+        [Parameter(Mandatory)][string]$Path,
+        [System.Collections.Specialized.OrderedDictionary]$Query
+    )
+
+    $uri = $Connection.BaseUrl + $Path
+    if ($null -ne $Query -and $Query.Count -gt 0) {
+        $pairs = foreach ($name in $Query.Keys) {
+            '{0}={1}' -f [uri]::EscapeDataString([string]$name), [uri]::EscapeDataString([string]$Query[$name])
+        }
+        $uri += '?' + ($pairs -join '&')
+    }
+    return $uri
+}
+
+function Invoke-VcfAutomationRequest {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][object]$Connection,
+        [Parameter(Mandatory)][ValidateSet('GET', 'POST')][string]$Method,
+        [Parameter(Mandatory)][string]$Path,
+        [System.Collections.Specialized.OrderedDictionary]$Query,
+        [string]$JsonBody
+    )
+
+    $token = ConvertFrom-SecureString -SecureString $Connection.AccessToken -AsPlainText
+    $arguments = @{
+        Uri         = Get-VcfAutomationRequestUri -Connection $Connection -Path $Path -Query $Query
+        Method      = $Method
+        Headers     = @{ Authorization = "Bearer $token"; Accept = 'application/json' }
+        ErrorAction = 'Stop'
+    }
+    # A bodyless request must not advertise a request media type.
+    if ($PSBoundParameters.ContainsKey('JsonBody')) {
+        $arguments['Body'] = $JsonBody
+        $arguments['ContentType'] = 'application/json'
+    }
+
+    return Invoke-RestMethod @arguments
 }
 

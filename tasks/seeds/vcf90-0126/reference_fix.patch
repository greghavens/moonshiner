diff --git a/VcfOperationsNetworks.psm1 b/VcfOperationsNetworks.psm1
index b407a69..32a18f2 100644
--- a/VcfOperationsNetworks.psm1
+++ b/VcfOperationsNetworks.psm1
@@ -57,7 +57,66 @@ function Invoke-VcfOperationsNetworksCertificateUpdate {
         [int] $PollIntervalMilliseconds = 250
     )
 
-    throw 'Invoke-VcfOperationsNetworksCertificateUpdate is not implemented.'
+    $baseUri = $Server.AbsoluteUri.TrimEnd('/')
+    $escapedCertificateId = [uri]::EscapeDataString($CertificateId)
+    $updateUri = "$baseUri/api/ni/settings/certificates/$escapedCertificateId"
+    $headers = @{
+        Authorization = "NetworkInsight $Token"
+        Accept = 'application/json'
+    }
+
+    $request = [ordered]@{
+        certificate = $Certificate
+        private_key = $PrivateKey
+    }
+    if ($PSBoundParameters.ContainsKey('Chain')) {
+        $request['chain'] = $Chain
+    }
+
+    $submission = Invoke-RestMethod `
+        -Method Put `
+        -Uri $updateUri `
+        -Headers $headers `
+        -ContentType 'application/json' `
+        -Body ($request | ConvertTo-Json -Compress) `
+        -ErrorAction Stop
+
+    $idProperty = $submission.PSObject.Properties['id']
+    if ($null -eq $idProperty -or [string]::IsNullOrWhiteSpace([string] $idProperty.Value)) {
+        throw 'The updateCertificate response did not include an update id.'
+    }
+
+    $escapedUpdateId = [uri]::EscapeDataString([string] $idProperty.Value)
+    $statusUri = "$baseUri/api/ni/settings/certificates/status/$escapedUpdateId"
+
+    while ($true) {
+        $current = Invoke-RestMethod `
+            -Method Get `
+            -Uri $statusUri `
+            -Headers $headers `
+            -ErrorAction Stop
+        $state = [string] $current.status
+
+        switch ($state) {
+            'SUCCESS' {
+                return $current
+            }
+            'FAILED' {
+                $errorProperty = $current.PSObject.Properties['error_message']
+                $detail = if ($null -ne $errorProperty) { [string] $errorProperty.Value } else { '' }
+                throw "Certificate update '$($idProperty.Value)' failed: $detail"
+            }
+            'SUBMITTED' { }
+            'IN_PROGRESS' { }
+            default {
+                throw "Certificate update '$($idProperty.Value)' returned unknown status '$state'."
+            }
+        }
+
+        if ($PollIntervalMilliseconds -gt 0) {
+            Start-Sleep -Milliseconds $PollIntervalMilliseconds
+        }
+    }
 }
 
 Export-ModuleMember -Function Invoke-VcfOperationsNetworksCertificateUpdate

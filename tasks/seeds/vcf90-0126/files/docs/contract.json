{
  "source_revision": {
    "tag": "9.0.0.0",
    "commit": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "spec_path": "specifications/vcf-operations/vcf-operations-for-networks-openapi.yaml"
  },
  "openapi": "3.0.1",
  "api_version": "9.0.0.0",
  "server_url": "/api/ni",
  "security_scheme": {
    "name": "Authorization",
    "in": "header",
    "type": "apiKey",
    "description": "API Key - NetworkInsight {token}"
  },
  "operations": {
    "updateCertificate": {
      "operationId": "updateCertificate",
      "method": "PUT",
      "path": "/settings/certificates/{id}",
      "path_parameters": {
        "id": {
          "required": true,
          "type": "string"
        }
      },
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "CertificateUpdateRequest"
      },
      "success_response": {
        "status": 202,
        "content_type": "application/json",
        "schema": "CertificateUpdateStatus"
      },
      "security": "ApiKeyAuth"
    },
    "fetchCertificateUpdateStatusForUpdateId": {
      "operationId": "fetchCertificateUpdateStatusForUpdateId",
      "method": "GET",
      "path": "/settings/certificates/status/{id}",
      "path_parameters": {
        "id": {
          "required": true,
          "type": "string"
        }
      },
      "request": null,
      "success_response": {
        "status": 200,
        "content_type": "application/json",
        "schema": "CertificateUpdateStatus"
      },
      "security": "ApiKeyAuth"
    }
  },
  "schemas": {
    "CertificateUpdateRequest": {
      "type": "object",
      "required": [],
      "properties": {
        "certificate": {
          "type": "string",
          "description": "The PEM encoded certificate string"
        },
        "private_key": {
          "type": "string",
          "description": "The PEM encoded private key string"
        },
        "chain": {
          "type": "string",
          "description": "The PEM encoded chain of trusted root CA certificate string",
          "default": ""
        }
      }
    },
    "CertificateUpdateStatus": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Certificate update id"
        },
        "name": {
          "type": "string",
          "description": "Name of certificate such as proxy_register.crt or client.crt"
        },
        "status": {
          "type": "string",
          "description": "certificate update status",
          "enum": [
            "SUBMITTED",
            "IN_PROGRESS",
            "SUCCESS",
            "FAILED"
          ]
        },
        "error_message": {
          "type": "string",
          "description": "Error message if update request failed"
        },
        "failed_nodes": {
          "type": "array",
          "description": "List of the nodes for which certificate update failed",
          "items_schema": "Node"
        },
        "updated_nodes": {
          "type": "array",
          "description": "List of the nodes for which certificate update was success",
          "items_schema": "Node"
        },
        "last_modified_by_user": {
          "type": "string",
          "description": "The last modified user"
        },
        "last_modified_time": {
          "type": "integer",
          "format": "int64",
          "description": "The last modified time for the certificate"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brownfield-migration-plan.schema.json",
  "title": "VCF Brownfield SddcSpec and Ordered Migration Plan",
  "allOf": [
    {
      "$ref": "../specifications/vcf-installer/vcf-installer-openapi.json#/components/schemas/SddcSpec"
    }
  ],
  "type": "object",
  "required": [
    "inventoryId",
    "targetVcfVersion",
    "versionPath",
    "storageDecision",
    "migrationPlan"
  ],
  "properties": {
    "inventoryId": {
      "type": "string",
      "minLength": 1
    },
    "targetVcfVersion": {
      "type": "string",
      "minLength": 1
    },
    "versionPath": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "storageDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectedProfile",
        "requiredUsableTiB",
        "targetHostCount",
        "network",
        "transition",
        "alternatives"
      ],
      "properties": {
        "selectedProfile": {
          "enum": [
            "OSA",
            "ESA"
          ]
        },
        "requiredUsableTiB": {
          "type": "integer",
          "minimum": 1
        },
        "targetHostCount": {
          "type": "integer",
          "minimum": 1
        },
        "network": {
          "$ref": "#/$defs/networkDesign"
        },
        "transition": {
          "type": "string",
          "minLength": 1
        },
        "alternatives": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/storageAlternative"
          }
        }
      }
    },
    "migrationPlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/migrationStep"
      }
    }
  },
  "$defs": {
    "networkDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumNicGbps",
        "uplinksPerHost",
        "mtu",
        "vsanVlanId"
      ],
      "properties": {
        "minimumNicGbps": {
          "type": "integer",
          "minimum": 1
        },
        "uplinksPerHost": {
          "type": "integer",
          "minimum": 1
        },
        "mtu": {
          "type": "integer",
          "minimum": 1280
        },
        "vsanVlanId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4094
        }
      }
    },
    "storageAlternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "targetHostCount",
        "fitsPermanentHostLimit",
        "network",
        "transition"
      ],
      "properties": {
        "profile": {
          "enum": [
            "OSA",
            "ESA"
          ]
        },
        "targetHostCount": {
          "type": "integer",
          "minimum": 1
        },
        "fitsPermanentHostLimit": {
          "type": "boolean"
        },
        "network": {
          "$ref": "#/$defs/networkDesign"
        },
        "transition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "migrationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "componentId",
        "componentName",
        "currentVersion",
        "currentBuild",
        "targetVersion",
        "targetBuild",
        "action",
        "dependsOn",
        "gates"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "componentName": {
          "type": "string",
          "minLength": 1
        },
        "currentVersion": {
          "type": "string",
          "minLength": 1
        },
        "currentBuild": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetBuild": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF mixed-estate migration architecture",
  "type": "object",
  "required": [
    "migrationPlan"
  ],
  "properties": {
    "migrationPlan": {
      "type": "object",
      "required": [
        "estateId",
        "targetRelease",
        "components",
        "gates",
        "steps"
      ],
      "properties": {
        "estateId": {
          "type": "string",
          "minLength": 1
        },
        "targetRelease": {
          "type": "string",
          "minLength": 1
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "scope",
              "domainId",
              "type",
              "currentVersion",
              "targetVersion",
              "disposition",
              "gates"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "enum": [
                  "management",
                  "candidate-workload"
                ]
              },
              "domainId": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "SDDC_MANAGER",
                  "VCENTER",
                  "NSX_T_MANAGER",
                  "ESX_HOST"
                ]
              },
              "currentVersion": {
                "type": "string",
                "minLength": 1
              },
              "targetVersion": {
                "type": "string",
                "minLength": 1
              },
              "disposition": {
                "enum": [
                  "retain",
                  "migrate"
                ]
              },
              "gates": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "condition"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "invariant",
                  "compatibility",
                  "ordering"
                ]
              },
              "condition": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "order",
              "stage",
              "componentIds",
              "resultVersions",
              "gates"
            ],
            "properties": {
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "stage": {
                "enum": [
                  "IMPORT_WORKLOAD_DOMAIN",
                  "UPGRADE_NSX",
                  "UPGRADE_VCENTER",
                  "UPGRADE_ESXI_HOST",
                  "VERIFY_TARGET_BOM"
                ]
              },
              "componentIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "resultVersions": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "gates": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}

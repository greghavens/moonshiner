 function New-VcfMixedEstateArchitecture {
     [CmdletBinding()]
     param(
@@ -17,7 +139,189 @@ function New-VcfMixedEstateArchitecture {
         [string] $OutputPath
     )
 
-    throw 'TODO: build the mixed-estate architecture'
+    $inventory = Get-Content -LiteralPath $InventoryPath -Raw -Encoding utf8 |
+        ConvertFrom-Json -AsHashtable -Depth 100
+    $compatibility = Get-Content -LiteralPath $CompatibilityPath -Raw -Encoding utf8 |
+        ConvertFrom-Json -AsHashtable -Depth 100
+
+    if ($inventory.targetRelease -ne $compatibility.targetRelease) {
+        throw 'Inventory and compatibility snapshot target releases differ.'
+    }
+
+    Assert-VcfSdkBinding -Api Installer -Path '/v1/sddcs/validations' -Method Post
+    Assert-VcfSdkBinding -Api SddcManager -Path '/v1/upgrades' -Method Post
+    Assert-VcfSdkBinding -Api SddcManager -Path '/v1/system/check-sets/queries' -Method Post
+
+    $sourceSpec = $inventory.candidateInstallerSpec
+    $candidate = @($inventory.components | Where-Object { $_.scope -eq 'candidate-workload' })
+    $candidateVcenter = @($candidate | Where-Object { $_.type -eq 'VCENTER' })
+    $candidateNsx = @($candidate | Where-Object { $_.type -eq 'NSX_T_MANAGER' })
+    $candidateHosts = @($candidate | Where-Object { $_.type -eq 'ESX_HOST' })
+    if ($candidateVcenter.Count -ne 1 -or $candidateNsx.Count -ne 1 -or $candidateHosts.Count -lt 1) {
+        throw 'Candidate inventory must contain one vCenter, one NSX manager, and at least one ESXi host.'
+    }
+
+    $dnsParameters = @{ Subdomain = $sourceSpec.dnsSpec.subdomain }
+    if ($sourceSpec.dnsSpec.Contains('nameservers')) {
+        $dnsParameters.Nameservers = [string[]] $sourceSpec.dnsSpec.nameservers
+    }
+    $sdkDns = Initialize-VcfInstallerDnsSpec @dnsParameters
+
+    $sdkNetworks = @(
+        foreach ($network in $sourceSpec.networkSpecs) {
+            ConvertTo-InstallerNetworkSpec -Source $network
+        }
+    )
+
+    $vcenterParameters = @{
+        VcenterHostname = $sourceSpec.vcenterSpec.vcenterHostname
+        RootVcenterPassword = $sourceSpec.vcenterSpec.rootVcenterPassword
+        Version = $candidateVcenter[0].currentVersion
+    }
+    foreach ($entry in ([ordered]@{
+        useExistingDeployment = 'UseExistingDeployment'
+        sslThumbprint = 'SslThumbprint'
+    }).GetEnumerator()) {
+        if ($sourceSpec.vcenterSpec.Contains($entry.Key)) {
+            $vcenterParameters[$entry.Value] = $sourceSpec.vcenterSpec[$entry.Key]
+        }
+    }
+    $sdkVcenter = Initialize-VcfInstallerSddcVcenterSpec @vcenterParameters
+    $sdkSddc = Initialize-VcfInstallerSddcSpec `
+        -SddcId $sourceSpec.sddcId `
+        -WorkflowType $sourceSpec.workflowType `
+        -Version $inventory.targetRelease `
+        -VcenterSpec $sdkVcenter `
+        -NetworkSpecs $sdkNetworks `
+        -DnsSpec $sdkDns `
+        -NtpServers ([string[]] $sourceSpec.ntpServers)
+
+    $componentPlan = @(
+        foreach ($component in $inventory.components) {
+            $isManagement = $component.scope -eq 'management'
+            $target = if ($isManagement) {
+                $component.currentVersion
+            }
+            else {
+                $compatibility.targets[$component.type]
+            }
+            $componentGates = if ($isManagement) {
+                $compatibility.componentGates.management
+            }
+            else {
+                $compatibility.componentGates[$component.type]
+            }
+            [ordered]@{
+                id = $component.id
+                scope = $component.scope
+                domainId = $component.domainId
+                type = $component.type
+                currentVersion = $component.currentVersion
+                targetVersion = $target
+                disposition = $(if ($isManagement) { 'retain' } else { 'migrate' })
+                gates = @($componentGates)
+            }
+        }
+    )
+
+    $conditions = @{
+        'management-domain-unchanged' = 'Management-domain components retain their current versions and are absent from migration actions.'
+        'brownfield-import-combination-supported' = 'Import occurs while vCenter, NSX, and ESXi remain at the pinned supported brownfield combination.'
+        'workload-domain-imported' = 'The candidate estate is managed as a workload domain before any component upgrade.'
+        'nsx-upgrade-path-supported' = 'The pinned NSX source-to-target edge is supported for the imported workload domain.'
+        'nsx-at-target' = 'NSX reaches its 9.0.2 target before the vCenter 9.0.2 transition.'
+        'sddc-manager-controlled-transition' = 'The transitional vCenter and NSX combination is used only under SDDC Manager lifecycle control.'
+        'vcenter-at-target' = 'vCenter reaches its target before any ESXi host is upgraded.'
+        'target-bom-interoperable' = 'All candidate components match the pinned 9.0.2 target BOM and interoperability set.'
+    }
+    $gates = @(
+        foreach ($gate in $compatibility.gateCatalog) {
+            [ordered]@{
+                id = $gate.id
+                type = $gate.type
+                condition = $conditions[$gate.id]
+            }
+        }
+    )
+
+    $candidateIds = [string[]] @($candidate | ForEach-Object { $_.id })
+    $importVersions = [ordered]@{}
+    foreach ($component in $candidate) {
+        $importVersions[$component.id] = $component.currentVersion
+    }
+
+    $steps = [System.Collections.Generic.List[object]]::new()
+    $steps.Add((New-VcfPlanStep -Order 1 -Stage 'IMPORT_WORKLOAD_DOMAIN' `
+        -ComponentIds $candidateIds -ResultVersions $importVersions `
+        -Gates ([string[]] $compatibility.stepGates.IMPORT_WORKLOAD_DOMAIN)))
+
+    $order = 2
+    foreach ($entry in @(
+        @{ Stage = 'UPGRADE_NSX'; Component = $candidateNsx[0] },
+        @{ Stage = 'UPGRADE_VCENTER'; Component = $candidateVcenter[0] }
+    )) {
+        $versions = [ordered]@{}
+        $versions[$entry.Component.id] = $compatibility.targets[$entry.Component.type]
+        $steps.Add((New-VcfPlanStep -Order $order -Stage $entry.Stage `
+            -ComponentIds @($entry.Component.id) -ResultVersions $versions `
+            -Gates ([string[]] $compatibility.stepGates[$entry.Stage])))
+        $order++
+    }
+    foreach ($hostComponent in $candidateHosts) {
+        $versions = [ordered]@{}
+        $versions[$hostComponent.id] = $compatibility.targets.ESX_HOST
+        $steps.Add((New-VcfPlanStep -Order $order -Stage 'UPGRADE_ESXI_HOST' `
+            -ComponentIds @($hostComponent.id) -ResultVersions $versions `
+            -Gates ([string[]] $compatibility.stepGates.UPGRADE_ESXI_HOST)))
+        $order++
+    }
+    $targetVersions = [ordered]@{}
+    foreach ($component in $candidate) {
+        $targetVersions[$component.id] = $compatibility.targets[$component.type]
+    }
+    $steps.Add((New-VcfPlanStep -Order $order -Stage 'VERIFY_TARGET_BOM' `
+        -ComponentIds $candidateIds -ResultVersions $targetVersions `
+        -Gates ([string[]] $compatibility.stepGates.VERIFY_TARGET_BOM)))
+
+    $vcenterSpec = [ordered]@{
+        vcenterHostname = $sdkSddc.VcenterSpec.VcenterHostname
+        rootVcenterPassword = $sdkSddc.VcenterSpec.RootVcenterPassword
+        useExistingDeployment = [bool] $sdkSddc.VcenterSpec.UseExistingDeployment
+        sslThumbprint = $sdkSddc.VcenterSpec.SslThumbprint
+        version = $sdkSddc.VcenterSpec.Version
+    }
+    $networkSpecs = @(
+        for ($index = 0; $index -lt $sourceSpec.networkSpecs.Count; $index++) {
+            ConvertFrom-InstallerNetworkSpec -Source $sourceSpec.networkSpecs[$index] -SdkSpec $sdkSddc.NetworkSpecs[$index]
+        }
+    )
+    $dnsSpec = [ordered]@{ subdomain = $sdkSddc.DnsSpec.Subdomain }
+    if ($sourceSpec.dnsSpec.Contains('nameservers')) {
+        $dnsSpec.nameservers = @($sdkSddc.DnsSpec.Nameservers)
+    }
+
+    $architecture = [ordered]@{
+        sddcId = $sdkSddc.SddcId
+        workflowType = $sdkSddc.WorkflowType
+        version = $sdkSddc.Version
+        vcenterSpec = $vcenterSpec
+        networkSpecs = $networkSpecs
+        dnsSpec = $dnsSpec
+        ntpServers = @($sdkSddc.NtpServers)
+        migrationPlan = [ordered]@{
+            estateId = $inventory.estateId
+            targetRelease = $compatibility.targetRelease
+            components = $componentPlan
+            gates = $gates
+            steps = @($steps)
+        }
+    }
+
+    $parent = Split-Path -Parent $OutputPath
+    if ($parent -and -not (Test-Path -LiteralPath $parent)) {
+        $null = New-Item -ItemType Directory -Path $parent -Force
+    }
+    $architecture | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $OutputPath -Encoding utf8
 }
 
 Export-ModuleMember -Function New-VcfMixedEstateArchitecture

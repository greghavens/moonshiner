 Set-StrictMode -Version Latest
 
+Import-Module VMware.Sdk.Vcf.Installer -MinimumVersion 13.5.0.25380678 -ErrorAction Stop
+Import-Module VMware.Sdk.Vcf.SddcManager -MinimumVersion 13.5.0.25380678 -ErrorAction Stop
+
+function Assert-VcfSdkBinding {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateSet('Installer', 'SddcManager')]
+        [string] $Api,
+
+        [Parameter(Mandatory)]
+        [string] $Path,
+
+        [Parameter(Mandatory)]
+        [ValidateSet('Get', 'Post', 'Patch', 'Put', 'Delete')]
+        [string] $Method
+    )
+
+    $operations = @(
+        if ($Api -eq 'Installer') {
+            Get-VcfInstallerOperation -Path $Path -Method $Method
+        }
+        else {
+            Get-VcfSddcManagerOperation -Path $Path -Method $Method
+        }
+    )
+    if ($operations.Count -lt 1) {
+        throw "The installed VMware SDK does not expose $Method $Path in $Api."
+    }
+}
+
+function ConvertTo-InstallerNetworkSpec {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [System.Collections.IDictionary] $Source
+    )
+
+    $parameters = @{
+        NetworkType = $Source.networkType
+        VlanId = $Source.vlanId
+    }
+    $mapping = [ordered]@{
+        subnet = 'Subnet'
+        gateway = 'Gateway'
+        subnetMask = 'SubnetMask'
+        includeIpAddress = 'IncludeIpAddress'
+        mtu = 'Mtu'
+        teamingPolicy = 'TeamingPolicy'
+        activeUplinks = 'ActiveUplinks'
+        standbyUplinks = 'StandbyUplinks'
+        portGroupKey = 'PortGroupKey'
+        ipAddressVersion = 'IpAddressVersion'
+        ipAddressAssignmentMode = 'IpAddressAssignmentMode'
+    }
+    foreach ($entry in $mapping.GetEnumerator()) {
+        if ($Source.Contains($entry.Key)) {
+            $parameters[$entry.Value] = $Source[$entry.Key]
+        }
+    }
+    Initialize-VcfInstallerSddcNetworkSpec @parameters
+}
+
+function ConvertFrom-InstallerNetworkSpec {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [System.Collections.IDictionary] $Source,
+
+        [Parameter(Mandatory)]
+        [object] $SdkSpec
+    )
+
+    $mapping = [ordered]@{
+        networkType = 'NetworkType'
+        subnet = 'Subnet'
+        gateway = 'Gateway'
+        subnetMask = 'SubnetMask'
+        includeIpAddress = 'IncludeIpAddress'
+        mtu = 'Mtu'
+        teamingPolicy = 'TeamingPolicy'
+        activeUplinks = 'ActiveUplinks'
+        standbyUplinks = 'StandbyUplinks'
+        portGroupKey = 'PortGroupKey'
+        ipAddressVersion = 'IpAddressVersion'
+        ipAddressAssignmentMode = 'IpAddressAssignmentMode'
+    }
+    $result = [ordered]@{}
+    foreach ($entry in $mapping.GetEnumerator()) {
+        if ($Source.Contains($entry.Key)) {
+            $result[$entry.Key] = $SdkSpec.($entry.Value)
+        }
+    }
+    $result.vlanId = [int] $SdkSpec.VlanId
+
+    # Preserve the fixture's property order, including vlanId's position.
+    $ordered = [ordered]@{}
+    foreach ($key in $Source.Keys) {
+        $ordered[$key] = $result[$key]
+    }
+    $ordered
+}
+
+function New-VcfPlanStep {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)] [int] $Order,
+        [Parameter(Mandatory)] [string] $Stage,
+        [Parameter(Mandatory)] [string[]] $ComponentIds,
+        [Parameter(Mandatory)] [System.Collections.IDictionary] $ResultVersions,
+        [Parameter(Mandatory)] [string[]] $Gates
+    )
+
+    [ordered]@{
+        order = $Order
+        stage = $Stage
+        componentIds = @($ComponentIds)
+        resultVersions = $ResultVersions
+        gates = @($Gates)
+    }
+}

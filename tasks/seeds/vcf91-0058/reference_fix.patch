diff --git a/VcfNsxPolicyInventory.psm1 b/VcfNsxPolicyInventory.psm1
new file mode 100644
index 0000000..e3381c3
--- /dev/null
+++ b/VcfNsxPolicyInventory.psm1
@@ -0,0 +1,295 @@
+Set-StrictMode -Version Latest
+
+class VcfNsxAuthenticationException : System.Exception {
+    [int]$StatusCode
+
+    VcfNsxAuthenticationException([string]$message, [int]$statusCode) : base($message) {
+        $this.StatusCode = $statusCode
+    }
+
+    VcfNsxAuthenticationException([string]$message, [int]$statusCode, [System.Exception]$inner) `
+        : base($message, $inner) {
+        $this.StatusCode = $statusCode
+    }
+}
+
+function Get-VcfNsxProperty {
+    param(
+        $InputObject,
+        [Parameter(Mandatory)][string[]]$Name
+    )
+
+    if ($null -eq $InputObject) {
+        return $null
+    }
+    foreach ($candidate in $Name) {
+        $property = $InputObject.PSObject.Properties[$candidate]
+        if ($null -ne $property) {
+            return $property.Value
+        }
+    }
+    return $null
+}
+
+function Get-VcfNsxStatusCode {
+    param([Parameter(Mandatory)]$ErrorRecord)
+
+    $exception = $ErrorRecord.Exception
+    while ($null -ne $exception) {
+        foreach ($candidate in @(
+            (Get-VcfNsxProperty -InputObject $exception -Name @('StatusCode')),
+            (Get-VcfNsxProperty -InputObject (
+                Get-VcfNsxProperty -InputObject $exception -Name @('Response')
+            ) -Name @('StatusCode'))
+        )) {
+            if ($null -ne $candidate) {
+                try {
+                    return [int]$candidate
+                }
+                catch {
+                    # Continue through the exception chain.
+                }
+            }
+        }
+        if ($exception.Data.Contains('StatusCode')) {
+            try {
+                return [int]$exception.Data['StatusCode']
+            }
+            catch {
+                # Continue through the exception chain.
+            }
+        }
+        $exception = $exception.InnerException
+    }
+    return $null
+}
+
+function Invoke-VcfNsxSdkOperation {
+    param(
+        [Parameter(Mandatory)][string]$OperationId,
+        [Parameter(Mandatory)][hashtable]$Parameters,
+        [Parameter(Mandatory)]$NsxServer
+    )
+
+    if (-not (Get-Module -Name VMware.Sdk.Nsx.Policy)) {
+        Import-Module VMware.Sdk.Nsx.Policy -ErrorAction Stop
+    }
+
+    $sdkParameters = @{
+        PageSize = [long]$Parameters.PageSize
+        Server = $NsxServer
+    }
+    if ($Parameters.ContainsKey('Cursor') -and
+        -not [string]::IsNullOrEmpty([string]$Parameters.Cursor)) {
+        $sdkParameters.Cursor = [string]$Parameters.Cursor
+    }
+
+    switch ($OperationId) {
+        'ListTier1' {
+            Invoke-ListTier1 @sdkParameters
+            break
+        }
+        'ListAllInfraSegments' {
+            Invoke-ListAllInfraSegments @sdkParameters
+            break
+        }
+        default {
+            throw "NSX Policy operation '$OperationId' is outside the pinned contract."
+        }
+    }
+}
+
+function New-VcfNsxPolicySession {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]$NsxServer,
+        [Parameter(Mandatory)][scriptblock]$RefreshConnection,
+        [scriptblock]$OperationInvoker
+    )
+
+    if ($null -eq $OperationInvoker) {
+        $OperationInvoker = {
+            param($OperationId, $Parameters, $Server)
+            Invoke-VcfNsxSdkOperation -OperationId $OperationId -Parameters $Parameters -NsxServer $Server
+        }.GetNewClosure()
+    }
+
+    [pscustomobject]@{
+        PSTypeName = 'Vcf.NsxPolicy.InventorySession'
+        NsxServer = $NsxServer
+        RefreshConnection = $RefreshConnection
+        OperationInvoker = $OperationInvoker
+    }
+}
+
+function Invoke-VcfNsxPage {
+    param(
+        [Parameter(Mandatory)]$Session,
+        [Parameter(Mandatory)][string]$OperationId,
+        [Parameter(Mandatory)][hashtable]$Parameters
+    )
+
+    try {
+        return & $Session.OperationInvoker $OperationId $Parameters $Session.NsxServer
+    }
+    catch {
+        $status = Get-VcfNsxStatusCode -ErrorRecord $_
+        if ($status -ne 401) {
+            throw
+        }
+
+        try {
+            $replacement = & $Session.RefreshConnection $Session.NsxServer
+        }
+        catch {
+            throw [VcfNsxAuthenticationException]::new(
+                'NSX Policy connection refresh failed.',
+                401,
+                $_.Exception)
+        }
+        if ($null -eq $replacement) {
+            throw [VcfNsxAuthenticationException]::new(
+                'NSX Policy connection refresh returned no replacement connection.',
+                401)
+        }
+
+        $Session.NsxServer = $replacement
+        try {
+            return & $Session.OperationInvoker $OperationId $Parameters $Session.NsxServer
+        }
+        catch {
+            $retryStatus = Get-VcfNsxStatusCode -ErrorRecord $_
+            if ($retryStatus -eq 401) {
+                throw [VcfNsxAuthenticationException]::new(
+                    'NSX Policy request remained unauthorized after one connection refresh.',
+                    401,
+                    $_.Exception)
+            }
+            throw
+        }
+    }
+}
+
+function Get-VcfNsxOrdinalSorted {
+    param([Parameter(Mandatory)][object[]]$InputObject)
+
+    $items = [System.Collections.Generic.List[object]]::new()
+    foreach ($item in $InputObject) {
+        $items.Add($item)
+    }
+    $comparison = [System.Comparison[object]]{
+        param($left, $right)
+        $leftName = [string](Get-VcfNsxProperty -InputObject $left -Name @('display_name', 'DisplayName'))
+        $rightName = [string](Get-VcfNsxProperty -InputObject $right -Name @('display_name', 'DisplayName'))
+        $result = [StringComparer]::Ordinal.Compare($leftName, $rightName)
+        if ($result -ne 0) {
+            return $result
+        }
+        $leftId = [string](Get-VcfNsxProperty -InputObject $left -Name @('id', 'Id'))
+        $rightId = [string](Get-VcfNsxProperty -InputObject $right -Name @('id', 'Id'))
+        return [StringComparer]::Ordinal.Compare($leftId, $rightId)
+    }
+    $items.Sort($comparison)
+    $items.ToArray()
+}
+
+function Get-VcfNsxCollection {
+    param(
+        [Parameter(Mandatory)]$Session,
+        [Parameter(Mandatory)][string]$OperationId,
+        [ValidateRange(1, 1000)][int]$PageSize
+    )
+
+    $collected = [System.Collections.Generic.List[object]]::new()
+    $cursor = $null
+    do {
+        $parameters = @{ PageSize = $PageSize }
+        if (-not [string]::IsNullOrEmpty([string]$cursor)) {
+            $parameters.Cursor = [string]$cursor
+        }
+
+        $page = Invoke-VcfNsxPage -Session $Session -OperationId $OperationId -Parameters $parameters
+        $pageResults = Get-VcfNsxProperty -InputObject $page -Name @('results', 'Results')
+        foreach ($item in @($pageResults)) {
+            if ($null -ne $item) {
+                $collected.Add($item)
+            }
+        }
+        $cursor = Get-VcfNsxProperty -InputObject $page -Name @('cursor', 'Cursor')
+    } while (-not [string]::IsNullOrEmpty([string]$cursor))
+
+    Get-VcfNsxOrdinalSorted -InputObject $collected.ToArray()
+}
+
+function Get-VcfNsxTier1 {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]$Session,
+        [ValidateRange(1, 1000)][int]$PageSize = 1000
+    )
+
+    Get-VcfNsxCollection -Session $Session -OperationId 'ListTier1' -PageSize $PageSize
+}
+
+function Get-VcfNsxSegment {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]$Session,
+        [ValidateRange(1, 1000)][int]$PageSize = 1000
+    )
+
+    Get-VcfNsxCollection -Session $Session -OperationId 'ListAllInfraSegments' -PageSize $PageSize
+}
+
+function Export-VcfNsxPolicyInventory {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]$Session,
+        [Parameter(Mandatory)][string]$Path,
+        [ValidateRange(1, 1000)][int]$PageSize = 1000
+    )
+
+    $tier1Documents = @(
+        foreach ($tier1 in @(Get-VcfNsxTier1 -Session $Session -PageSize $PageSize)) {
+            [ordered]@{
+                id = Get-VcfNsxProperty -InputObject $tier1 -Name @('id', 'Id')
+                displayName = Get-VcfNsxProperty -InputObject $tier1 -Name @('display_name', 'DisplayName')
+                path = Get-VcfNsxProperty -InputObject $tier1 -Name @('path', 'Path')
+                tier0Path = Get-VcfNsxProperty -InputObject $tier1 -Name @('tier0_path', 'Tier0Path')
+                haMode = Get-VcfNsxProperty -InputObject $tier1 -Name @('ha_mode', 'HaMode')
+            }
+        }
+    )
+    $segmentDocuments = @(
+        foreach ($segment in @(Get-VcfNsxSegment -Session $Session -PageSize $PageSize)) {
+            [ordered]@{
+                id = Get-VcfNsxProperty -InputObject $segment -Name @('id', 'Id')
+                displayName = Get-VcfNsxProperty -InputObject $segment -Name @('display_name', 'DisplayName')
+                path = Get-VcfNsxProperty -InputObject $segment -Name @('path', 'Path')
+                connectivityPath = Get-VcfNsxProperty -InputObject $segment -Name @(
+                    'connectivity_path', 'ConnectivityPath')
+                transportZonePath = Get-VcfNsxProperty -InputObject $segment -Name @(
+                    'transport_zone_path', 'TransportZonePath')
+                adminState = Get-VcfNsxProperty -InputObject $segment -Name @('admin_state', 'AdminState')
+            }
+        }
+    )
+
+    $document = [ordered]@{
+        schemaVersion = 1
+        tier1Gateways = $tier1Documents
+        segments = $segmentDocuments
+    }
+    $json = ConvertTo-Json -InputObject $document -Depth 8
+    [IO.File]::WriteAllText(
+        $Path,
+        ($json -replace "`r`n", "`n") + "`n",
+        [Text.UTF8Encoding]::new($false))
+}
+
+Export-ModuleMember -Function @(
+    'New-VcfNsxPolicySession',
+    'Get-VcfNsxTier1',
+    'Get-VcfNsxSegment',
+    'Export-VcfNsxPolicyInventory'
+)

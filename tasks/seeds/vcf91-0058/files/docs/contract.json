  "operations": [
    {
      "operationId": "ListTier1",
      "sdkCommand": "Invoke-ListTier1",
      "method": "GET",
      "path": "/infra/tier-1s",
      "summary": "List Tier-1 instances",
      "parameters": {
        "cursor": {
          "in": "query",
          "type": "string",
          "description": "Opaque cursor supplied by the current result page"
        },
        "page_size": {
          "in": "query",
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 1000,
          "default": 1000
        }
      },
      "success": {
        "status": 200,
        "schema": "Tier1ListResult",
        "required": [
          "results"
        ],
        "pageFields": [
          "results",
          "cursor",
          "result_count"
        ],
        "selectedResourceFields": [
          "id",
          "display_name",
          "path",
          "tier0_path",
          "ha_mode"
        ]
      },
      "documentedErrors": [
        400,
        403,
        404,
        412,
        500,
        503,
        504
      ]
    },
    {
      "operationId": "ListAllInfraSegments",
      "sdkCommand": "Invoke-ListAllInfraSegments",
      "method": "GET",
      "path": "/infra/segments",
      "summary": "List all segments under infra",
      "parameters": {
        "cursor": {
          "in": "query",
          "type": "string",
          "description": "Opaque cursor supplied by the current result page"
        },
        "page_size": {
          "in": "query",
          "type": "integer",
          "format": "int64",
          "minimum": 0,
          "maximum": 1000,
          "default": 1000
        }
      },
      "success": {
        "status": 200,
        "schema": "SegmentListResult",
        "required": [
          "results"
        ],
        "pageFields": [
          "results",
          "cursor",
          "result_count"
        ],
        "selectedResourceFields": [
          "id",
          "display_name",
          "path",
          "connectivity_path",
          "transport_zone_path",
          "admin_state"
        ]
      },
      "documentedErrors": [
        400,
        403,
        404,
        412,
        500,
        503,
        504
      ]
    }
  ],
  "listResultSemantics": {
    "results": "The current page of resources",
    "cursor": "Opaque cursor for the next page; absent or empty means complete",
    "result_count": "Count across all pages, set only on the first page"
  },
  "localPolicy": {

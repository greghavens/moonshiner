{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF migration plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "snapshotId", "estateId", "architecture", "migrations"],
  "properties": {
    "schemaVersion": {"const": "vcf-migration-plan/v1"},
    "snapshotId": {"type": "string", "minLength": 1},
    "estateId": {"type": "string", "minLength": 1},
    "architecture": {"$ref": "#/$defs/architecture"},
    "migrations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/migration"}
    }
  },
  "$defs": {
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objects": {"type": "integer", "minimum": 0},
        "metrics": {"type": "integer", "minimum": 0},
        "ingestGiBPerDay": {"type": "integer", "minimum": 0},
        "automationConcurrentRequests": {"type": "integer", "minimum": 0}
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site",
        "deploymentModel",
        "foundationVersion",
        "cluster",
        "hostCount",
        "failuresToTolerate",
        "storagePolicy",
        "placements"
      ],
      "properties": {
        "site": {"type": "string", "minLength": 1},
        "deploymentModel": {"type": "string", "minLength": 1},
        "foundationVersion": {"type": "string", "minLength": 1},
        "cluster": {"type": "string", "minLength": 1},
        "hostCount": {"type": "integer", "minimum": 1},
        "failuresToTolerate": {"type": "integer", "minimum": 0},
        "storagePolicy": {"type": "string", "minLength": 1},
        "placements": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/placement"}
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "version",
        "profile",
        "cluster",
        "nodeCount",
        "vCpuPerNode",
        "memoryGiBPerNode",
        "hostIds",
        "antiAffinity",
        "capacity"
      ],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "cluster": {"type": "string", "minLength": 1},
        "nodeCount": {"type": "integer", "minimum": 1},
        "vCpuPerNode": {"type": "integer", "minimum": 1},
        "memoryGiBPerNode": {"type": "integer", "minimum": 1},
        "hostIds": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "antiAffinity": {"const": true},
        "capacity": {"$ref": "#/$defs/capacity"}
      }
    },
    "productRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "inventoryId": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["carries", "abandons"],
      "properties": {
        "carries": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "abandons": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endOfGeneralSupport", "statusAtSnapshot"],
      "properties": {
        "endOfGeneralSupport": {"type": "string", "format": "date"},
        "statusAtSnapshot": {"enum": ["supported", "past-eogs"]}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "source", "target", "method", "path", "content", "gates", "support"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "source": {"$ref": "#/$defs/productRef"},
        "target": {"$ref": "#/$defs/productRef"},
        "method": {"type": "string", "minLength": 1},
        "path": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "content": {"$ref": "#/$defs/content"},
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "support": {"$ref": "#/$defs/support"}
      }
    }
  }
}

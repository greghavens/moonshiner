+package architecture
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"reflect"
+	"sort"
+	"strconv"
+)
+
+func LoadEstate(r io.Reader) (Estate, error) {
+	var estate Estate
+	if err := decodeStrict(r, &estate); err != nil {
+		return Estate{}, fmt.Errorf("decode estate: %w", err)
+	}
+	if estate.EstateID == "" || estate.Site == "" || estate.Cluster == "" {
+		return Estate{}, fmt.Errorf("estate identity and placement fields are required")
+	}
+	if len(estate.Hosts) == 0 || len(estate.Products) == 0 {
+		return Estate{}, fmt.Errorf("estate hosts and products are required")
+	}
+	return estate, nil
+}
+
+func LoadCompatibilitySnapshot(r io.Reader) (CompatibilitySnapshot, error) {
+	var snapshot CompatibilitySnapshot
+	if err := decodeStrict(r, &snapshot); err != nil {
+		return CompatibilitySnapshot{}, fmt.Errorf("decode compatibility snapshot: %w", err)
+	}
+	if snapshot.SnapshotID == "" || snapshot.TargetFoundationVersion == "" {
+		return CompatibilitySnapshot{}, fmt.Errorf("snapshot identity and target version are required")
+	}
+	if len(snapshot.Products) == 0 || len(snapshot.Sizing) == 0 {
+		return CompatibilitySnapshot{}, fmt.Errorf("snapshot product and sizing rules are required")
+	}
+	return snapshot, nil
+}
+
+func decodeStrict(r io.Reader, value any) error {
+	decoder := json.NewDecoder(r)
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(value); err != nil {
+		return err
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); err != io.EOF {
+		if err == nil {
+			return fmt.Errorf("multiple JSON values")
+		}
+		return fmt.Errorf("trailing JSON: %w", err)
+	}
+	return nil
+}
+
+func BuildPlan(estate Estate, snapshot CompatibilitySnapshot) (Plan, error) {
+	if err := validateAuthorities(estate, snapshot); err != nil {
+		return Plan{}, err
+	}
+
+	plan := Plan{
+		SchemaVersion: "vcf-migration-plan/v1",
+		SnapshotID:    snapshot.SnapshotID,
+		EstateID:      estate.EstateID,
+		Architecture: TargetArchitecture{
+			Site:               estate.Site,
+			DeploymentModel:    snapshot.Architecture.DeploymentModel,
+			FoundationVersion:  snapshot.TargetFoundationVersion,
+			Cluster:            snapshot.Architecture.PlacementCluster,
+			HostCount:          len(estate.Hosts),
+			FailuresToTolerate: estate.Storage.FailuresToTolerate,
+			StoragePolicy:      snapshot.Architecture.RequiredStorage,
+		},
+	}
+
+	for _, sizing := range snapshot.Sizing {
+		hostIDs := make([]string, sizing.NodeCount)
+		for i := range hostIDs {
+			hostIDs[i] = estate.Hosts[i].ID
+		}
+		plan.Architecture.Placements = append(plan.Architecture.Placements, Placement{
+			Component:        sizing.Component,
+			Version:          sizing.Version,
+			Profile:          sizing.Profile,
+			Cluster:          estate.Cluster,
+			NodeCount:        sizing.NodeCount,
+			VCPUPerNode:      sizing.VCPUPerNode,
+			MemoryGiBPerNode: sizing.MemoryGiBPerNode,
+			HostIDs:          hostIDs,
+			AntiAffinity:     true,
+			Capacity:         sizing.Capacity,
+		})
+	}
+
+	rules := append([]ProductRule(nil), snapshot.Products...)
+	sort.Slice(rules, func(i, j int) bool { return rules[i].Order < rules[j].Order })
+	for _, rule := range rules {
+		plan.Migrations = append(plan.Migrations, Migration{
+			Order: rule.Order,
+			Source: ProductRef{
+				InventoryID: rule.InventoryID,
+				Name:        rule.SourceName,
+				Version:     rule.SourceVersion,
+			},
+			Target: ProductRef{
+				Name:    rule.TargetComponent,
+				Version: rule.TargetVersion,
+			},
+			Method: rule.MigrationMethod,
+			Path:   append([]string(nil), rule.SupportedPath...),
+			Content: ContentDecision{
+				Carries:  append([]string(nil), rule.Content.Carries...),
+				Abandons: append([]string(nil), rule.Content.Abandons...),
+			},
+			Gates:   append([]string(nil), rule.RequiredGates...),
+			Support: rule.Support,
+		})
+	}
+	if err := ValidatePlan(plan, estate, snapshot); err != nil {
+		return Plan{}, err
+	}
+	return plan, nil
+}
+
+func ValidatePlan(plan Plan, estate Estate, snapshot CompatibilitySnapshot) error {
+	if err := validateAuthorities(estate, snapshot); err != nil {
+		return err
+	}
+	if plan.SchemaVersion != "vcf-migration-plan/v1" || plan.SnapshotID != snapshot.SnapshotID || plan.EstateID != estate.EstateID {
+		return fmt.Errorf("plan authority identifiers are invalid")
+	}
+	if plan.Architecture.HostCount != len(estate.Hosts) || plan.Architecture.FailuresToTolerate != estate.Storage.FailuresToTolerate {
+		return fmt.Errorf("plan host count or FTT contradicts the estate")
+	}
+	required := snapshot.Architecture.MinimumHostsByFTT[strconv.Itoa(plan.Architecture.FailuresToTolerate)]
+	if plan.Architecture.HostCount < required {
+		return fmt.Errorf("FTT %d requires at least %d hosts", plan.Architecture.FailuresToTolerate, required)
+	}
+
+	expected := planFromAuthorities(estate, snapshot)
+	if len(plan.Architecture.Placements) != len(expected.Architecture.Placements) {
+		return fmt.Errorf("plan differs from the pinned compatibility and sizing authority")
+	}
+	knownHosts := make(map[string]Host, len(estate.Hosts))
+	usedCPU := make(map[string]int, len(estate.Hosts))
+	usedMemory := make(map[string]int, len(estate.Hosts))
+	for _, host := range estate.Hosts {
+		knownHosts[host.ID] = host
+	}
+	for i, placement := range plan.Architecture.Placements {
+		if len(placement.HostIDs) != placement.NodeCount {
+			return fmt.Errorf("placement for %s has the wrong host count", placement.Component)
+		}
+		seen := make(map[string]bool, len(placement.HostIDs))
+		for _, hostID := range placement.HostIDs {
+			host, ok := knownHosts[hostID]
+			if !ok || seen[hostID] {
+				return fmt.Errorf("placement for %s has an invalid or repeated host", placement.Component)
+			}
+			seen[hostID] = true
+			usedCPU[hostID] += placement.VCPUPerNode
+			usedMemory[hostID] += placement.MemoryGiBPerNode
+			if usedCPU[hostID] > host.CPUCores || usedMemory[hostID] > host.MemoryGiB {
+				return fmt.Errorf("placement exceeds capacity of host %s", hostID)
+			}
+		}
+		expected.Architecture.Placements[i].HostIDs = append([]string(nil), placement.HostIDs...)
+	}
+	if !reflect.DeepEqual(plan, expected) {
+		return fmt.Errorf("plan differs from the pinned compatibility and sizing authority")
+	}
+	return nil
+}
+
+func validateAuthorities(estate Estate, snapshot CompatibilitySnapshot) error {
+	if estate.DeploymentModel != snapshot.Architecture.DeploymentModel || estate.Cluster != snapshot.Architecture.PlacementCluster {
+		return fmt.Errorf("estate topology conflicts with snapshot")
+	}
+	if len(estate.Hosts) < snapshot.Architecture.MinimumHostCount {
+		return fmt.Errorf("minimum host count is %d, got %d", snapshot.Architecture.MinimumHostCount, len(estate.Hosts))
+	}
+	required, ok := snapshot.Architecture.MinimumHostsByFTT[strconv.Itoa(estate.Storage.FailuresToTolerate)]
+	if !ok {
+		return fmt.Errorf("no host rule for FTT %d", estate.Storage.FailuresToTolerate)
+	}
+	if len(estate.Hosts) < required {
+		return fmt.Errorf("FTT %d requires at least %d hosts, got %d", estate.Storage.FailuresToTolerate, required, len(estate.Hosts))
+	}
+	if estate.Storage.Policy != snapshot.Architecture.RequiredStorage {
+		return fmt.Errorf("estate storage policy conflicts with snapshot")
+	}
+	if len(estate.Products) != len(snapshot.Products) {
+		return fmt.Errorf("fixture and snapshot product counts differ")
+	}
+	byID := make(map[string]EstateProduct, len(estate.Products))
+	for _, product := range estate.Products {
+		byID[product.InventoryID] = product
+	}
+	for _, rule := range snapshot.Products {
+		product, ok := byID[rule.InventoryID]
+		if !ok || product.Name != rule.SourceName || product.Version != rule.SourceVersion {
+			return fmt.Errorf("fixture and snapshot disagree for %s", rule.InventoryID)
+		}
+	}
+	for _, sizing := range snapshot.Sizing {
+		if sizing.NodeCount > len(estate.Hosts) {
+			return fmt.Errorf("%s needs %d distinct hosts", sizing.Component, sizing.NodeCount)
+		}
+	}
+	return nil
+}
+
+func planFromAuthorities(estate Estate, snapshot CompatibilitySnapshot) Plan {
+	plan := Plan{
+		SchemaVersion: "vcf-migration-plan/v1",
+		SnapshotID:    snapshot.SnapshotID,
+		EstateID:      estate.EstateID,
+		Architecture: TargetArchitecture{
+			Site:               estate.Site,
+			DeploymentModel:    snapshot.Architecture.DeploymentModel,
+			FoundationVersion:  snapshot.TargetFoundationVersion,
+			Cluster:            snapshot.Architecture.PlacementCluster,
+			HostCount:          len(estate.Hosts),
+			FailuresToTolerate: estate.Storage.FailuresToTolerate,
+			StoragePolicy:      snapshot.Architecture.RequiredStorage,
+		},
+	}
+	for _, sizing := range snapshot.Sizing {
+		hostIDs := make([]string, sizing.NodeCount)
+		for i := range hostIDs {
+			hostIDs[i] = estate.Hosts[i].ID
+		}
+		plan.Architecture.Placements = append(plan.Architecture.Placements, Placement{
+			Component: sizing.Component, Version: sizing.Version, Profile: sizing.Profile,
+			Cluster: estate.Cluster, NodeCount: sizing.NodeCount, VCPUPerNode: sizing.VCPUPerNode,
+			MemoryGiBPerNode: sizing.MemoryGiBPerNode, HostIDs: hostIDs, AntiAffinity: true, Capacity: sizing.Capacity,
+		})
+	}
+	rules := append([]ProductRule(nil), snapshot.Products...)
+	sort.Slice(rules, func(i, j int) bool { return rules[i].Order < rules[j].Order })
+	for _, rule := range rules {
+		plan.Migrations = append(plan.Migrations, Migration{
+			Order:  rule.Order,
+			Source: ProductRef{InventoryID: rule.InventoryID, Name: rule.SourceName, Version: rule.SourceVersion},
+			Target: ProductRef{Name: rule.TargetComponent, Version: rule.TargetVersion}, Method: rule.MigrationMethod,
+			Path:    append([]string(nil), rule.SupportedPath...),
+			Content: ContentDecision{Carries: append([]string(nil), rule.Content.Carries...), Abandons: append([]string(nil), rule.Content.Abandons...)},
+			Gates:   append([]string(nil), rule.RequiredGates...), Support: rule.Support,
+		})
+	}
+	return plan
+}
+
+func WritePlan(w io.Writer, plan Plan) error {
+	encoder := json.NewEncoder(w)
+	encoder.SetEscapeHTML(false)
+	encoder.SetIndent("", "  ")
+	if err := encoder.Encode(plan); err != nil {
+		return fmt.Errorf("encode plan: %w", err)
+	}
+	return nil
+}

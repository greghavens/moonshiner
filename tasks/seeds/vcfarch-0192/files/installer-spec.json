{
  "specificationVersion": "1.0",
  "client": {
    "sourceFile": "MigrationPlanner.java",
    "className": "MigrationPlanner",
    "method": "public static void generate(java.nio.file.Path inventory, java.nio.file.Path compatibilitySnapshot, java.nio.file.Path installerSpec, java.nio.file.Path output) throws Exception",
    "artifact": "migration-plan.json"
  },
  "artifactSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "estateId",
      "targetPlatformVersion",
      "architecture",
      "migrations",
      "supportBoundaries",
      "steps",
      "researchConsulted"
    ],
    "properties": {
      "schemaVersion": {"const": "1.0"},
      "estateId": {"type": "string", "minLength": 1},
      "targetPlatformVersion": {"type": "string", "minLength": 1},
      "architecture": {
        "type": "array",
        "minItems": 3,
        "uniqueBy": "component",
        "items": {"$ref": "#/$defs/architecture"}
      },
      "migrations": {
        "type": "array",
        "minItems": 3,
        "uniqueBy": "sourceKey",
        "items": {"$ref": "#/$defs/migration"}
      },
      "supportBoundaries": {
        "type": "array",
        "minItems": 1,
        "uniqueBy": "itemId",
        "items": {"$ref": "#/$defs/supportBoundary"}
      },
      "steps": {
        "type": "array",
        "minItems": 1,
        "uniqueBy": "id",
        "items": {"$ref": "#/$defs/step"}
      },
      "researchConsulted": {
        "type": "array",
        "minItems": 1,
        "uniqueBy": "url",
        "items": {"$ref": "#/$defs/researchRecord"}
      }
    },
    "$defs": {
      "architecture": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "version", "deploymentMethod", "formFactor", "nodeCount", "vCpuPerNode", "memoryGbPerNode", "placement", "sizingBasis"],
        "properties": {
          "component": {"enum": ["VCF Operations", "VCF Automation", "VCF Operations for Logs"]},
          "version": {"type": "string", "minLength": 1},
          "deploymentMethod": {"enum": ["IN_PLACE_UPGRADE", "FLEET_IMPORT_AND_UPGRADE", "FRESH_DEPLOY"]},
          "formFactor": {"enum": ["MEDIUM", "LARGE"]},
          "nodeCount": {"type": "integer", "minimum": 1},
          "vCpuPerNode": {"type": "integer", "minimum": 1},
          "memoryGbPerNode": {"type": "integer", "minimum": 1},
          "placement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["domain", "datastore", "antiAffinity", "nodes"],
            "properties": {
              "domain": {"type": "string", "minLength": 1},
              "datastore": {"type": "string", "minLength": 1},
              "antiAffinity": {"const": true},
              "nodes": {
                "type": "array",
                "minItems": 1,
                "uniqueBy": "node",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["node", "host", "faultDomain"],
                  "properties": {
                    "node": {"type": "string", "minLength": 1},
                    "host": {"type": "string", "minLength": 1},
                    "faultDomain": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          },
          "sizingBasis": {
            "type": "array",
            "minItems": 1,
            "uniqueBy": "metric",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["metric", "required", "capacity", "unit"],
              "properties": {
                "metric": {"type": "string", "minLength": 1},
                "required": {"type": "integer", "minimum": 0},
                "capacity": {"type": "integer", "minimum": 1},
                "unit": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      },
      "versionHop": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "method"],
        "properties": {
          "version": {"type": "string", "minLength": 1},
          "method": {"enum": ["SOURCE", "IN_PLACE_UPGRADE", "IN_PLACE_BRIDGE_UPGRADE", "FLEET_IMPORT_AND_UPGRADE", "FRESH_DEPLOY"]}
        }
      },
      "disposition": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "method", "note"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1}
        }
      },
      "abandonedDisposition": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "method", "reason", "replacement"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "replacement": {"type": "string", "minLength": 1}
        }
      },
      "migration": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceKey", "source", "target", "path", "content"],
        "properties": {
          "sourceKey": {"enum": ["operations", "automation", "logs"]},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["product", "version"],
            "properties": {
              "product": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "version"],
            "properties": {
              "component": {"enum": ["VCF Operations", "VCF Automation", "VCF Operations for Logs"]},
              "version": {"type": "string", "minLength": 1}
            }
          },
          "path": {
            "type": "array",
            "minItems": 2,
            "items": {"$ref": "#/$defs/versionHop"}
          },
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": ["carried", "manual", "abandoned"],
            "properties": {
              "carried": {"type": "array", "uniqueBy": "id", "items": {"$ref": "#/$defs/disposition"}},
              "manual": {"type": "array", "uniqueBy": "id", "items": {"$ref": "#/$defs/disposition"}},
              "abandoned": {"type": "array", "uniqueBy": "id", "items": {"$ref": "#/$defs/abandonedDisposition"}}
            }
          }
        }
      },
      "supportBoundary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "boundaryType", "boundary", "impact"],
        "properties": {
          "itemId": {"type": "string", "minLength": 1},
          "boundaryType": {"enum": ["EOGS_DATE", "LAST_SUPPORTED_RELEASE"]},
          "boundary": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1}
        }
      },
      "step": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "id", "action", "products", "gates", "outcomes"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "id": {"type": "string", "minLength": 1},
          "action": {"enum": ["PATCH_LIFECYCLE", "BRIDGE_UPGRADE", "IN_PLACE_UPGRADE", "REMOVE_UNSUPPORTED_CONFIGURATION", "FLEET_IMPORT_AND_UPGRADE", "FRESH_DEPLOY", "CONTENT_AND_DATA_CUTOVER", "VALIDATE_AND_RETIRE"]},
          "products": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["operations", "automation", "logs"]}
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "outcomes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      },
      "researchRecord": {
        "type": "object",
        "additionalProperties": false,
        "required": ["publisher", "title", "url", "accessedOn", "topics"],
        "properties": {
          "publisher": {"const": "Broadcom"},
          "title": {"type": "string", "minLength": 8},
          "url": {"type": "string", "pattern": "^https://([A-Za-z0-9-]+\\.)*broadcom\\.com/"},
          "accessedOn": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "topics": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "upgrade-sequence",
                "source-target-compatibility",
                "content-configuration-behavior",
                "support-boundary",
                "sizing"
              ]
            }
          }
        }
      }
    }
  }
}

+
+func cancellationCause(ctx context.Context) error {
+	if ctx.Err() == nil {
+		return nil
+	}
+	if cause := context.Cause(ctx); cause != nil {
+		return cause
+	}
+	return ctx.Err()
+}
+
+type csvByte struct {
+	value  byte
+	line   int
+	column int
+}
+
+type csvStream struct {
+	reader *bufio.Reader
+	line   int
+	column int
+}
+
+func newCSVStream(src io.Reader) *csvStream {
+	return &csvStream{
+		reader: bufio.NewReader(src),
+		line:   1,
+		column: 1,
+	}
+}
+
+func (s *csvStream) next(ctx context.Context) (csvByte, error) {
+	if err := cancellationCause(ctx); err != nil {
+		return csvByte{}, err
+	}
+	value, err := s.reader.ReadByte()
+	if err != nil {
+		return csvByte{}, err
+	}
+	if err := cancellationCause(ctx); err != nil {
+		return csvByte{}, err
+	}
+
+	token := csvByte{value: value, line: s.line, column: s.column}
+	if value == '\n' {
+		s.line++
+		s.column = 1
+	} else {
+		s.column++
+	}
+	return token, nil
+}
+
+func (s *csvStream) eofPosition(record int) Position {
+	return Position{Record: record, Line: s.line, Column: s.column}
+}
+
+type csvState uint8
+
+const (
+	atFieldStart csvState = iota
+	inUnquotedField
+	inQuotedField
+	afterQuotedField
+)
+
+func readRecord(
+	ctx context.Context,
+	stream *csvStream,
+	limits Limits,
+	record int,
+) ([]string, *Diagnostic, bool, error) {
+	var (
+		state      = atFieldStart
+		rowBytes   int
+		fieldBytes int
+		fieldCount = 1
+		field      []byte
+		fields     = make([]string, 0, min(limits.MaxFields, 16))
+		diagnostic *Diagnostic
+		sawAnyByte bool
+		pending    *csvByte
+	)
+
+	position := func(token csvByte) Position {
+		return Position{Record: record, Line: token.line, Column: token.column}
+	}
+	reject := func(violation Violation, token csvByte) {
+		if diagnostic != nil {
+			return
+		}
+		diagnostic = &Diagnostic{Violation: violation, Position: position(token)}
+		field = nil
+		fields = nil
+	}
+	consumeRaw := func(token csvByte) {
+		if diagnostic != nil {
+			return
+		}
+		if rowBytes >= limits.MaxRowBytes {
+			reject(RowBytes, token)
+			return
+		}
+		rowBytes++
+	}
+	appendDecoded := func(value byte, token csvByte) {
+		if diagnostic != nil {
+			return
+		}
+		if fieldBytes >= limits.MaxFieldBytes {
+			reject(FieldBytes, token)
+			return
+		}
+		field = append(field, value)
+		fieldBytes++
+	}
+	endField := func() {
+		if diagnostic == nil {
+			fields = append(fields, string(field))
+		}
+		field = nil
+		fieldBytes = 0
+	}
+	finish := func() ([]string, *Diagnostic, bool, error) {
+		if diagnostic == nil {
+			endField()
+		}
+		return fields, diagnostic, true, nil
+	}
+	syntax := func(token csvByte, reason string) ([]string, *Diagnostic, bool, error) {
+		return nil, nil, true, &SyntaxError{Position: position(token), Reason: reason}
+	}
+
+	for {
+		var token csvByte
+		var err error
+		if pending != nil {
+			token = *pending
+			pending = nil
+		} else {
+			token, err = stream.next(ctx)
+			if err != nil {
+				if !errors.Is(err, io.EOF) {
+					return nil, nil, sawAnyByte, err
+				}
+				if !sawAnyByte {
+					return nil, nil, false, io.EOF
+				}
+				if state == inQuotedField {
+					return nil, nil, true, &SyntaxError{
+						Position: stream.eofPosition(record),
+						Reason:   "unterminated quoted field",
+					}
+				}
+				return finish()
+			}
+		}
+		sawAnyByte = true
+
+		switch state {
+		case inQuotedField:
+			consumeRaw(token)
+			if token.value == '"' {
+				state = afterQuotedField
+			} else {
+				appendDecoded(token.value, token)
+			}
+
+		case afterQuotedField:
+			switch token.value {
+			case '"':
+				consumeRaw(token)
+				appendDecoded('"', token)
+				state = inQuotedField
+			case ',':
+				consumeRaw(token)
+				if diagnostic == nil {
+					if fieldCount >= limits.MaxFields {
+						reject(FieldCount, token)
+					} else {
+						endField()
+						fieldCount++
+					}
+				}
+				state = atFieldStart
+			case '\n':
+				return finish()
+			case '\r':
+				next, nextErr := stream.next(ctx)
+				if nextErr != nil {
+					if errors.Is(nextErr, io.EOF) {
+						return syntax(token, "unexpected carriage return after closing quote")
+					}
+					return nil, nil, true, nextErr
+				}
+				if next.value == '\n' {
+					return finish()
+				}
+				return syntax(token, "unexpected carriage return after closing quote")
+			default:
+				return syntax(token, "unexpected byte after closing quote")
+			}
+
+		case atFieldStart, inUnquotedField:
+			switch token.value {
+			case '"':
+				if state != atFieldStart {
+					return syntax(token, "quote in unquoted field")
+				}
+				consumeRaw(token)
+				state = inQuotedField
+			case ',':
+				consumeRaw(token)
+				if diagnostic == nil {
+					if fieldCount >= limits.MaxFields {
+						reject(FieldCount, token)
+					} else {
+						endField()
+						fieldCount++
+					}
+				}
+				state = atFieldStart
+			case '\n':
+				return finish()
+			case '\r':
+				next, nextErr := stream.next(ctx)
+				if nextErr != nil {
+					if !errors.Is(nextErr, io.EOF) {
+						return nil, nil, true, nextErr
+					}
+					consumeRaw(token)
+					appendDecoded('\r', token)
+					return finish()
+				}
+				if next.value == '\n' {
+					return finish()
+				}
+				consumeRaw(token)
+				appendDecoded('\r', token)
+				state = inUnquotedField
+				pending = &next
+			default:
+				consumeRaw(token)
+				appendDecoded(token.value, token)
+				state = inUnquotedField
+			}
+		}
 	}
 }

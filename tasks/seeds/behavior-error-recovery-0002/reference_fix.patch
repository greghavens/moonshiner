@@ -0,0 +1,150 @@
+#!/usr/bin/env python3
+"""Produce the reference result through genuine travel client executions."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "travelctl"
+TARGETS = (
+    {
+        "name": "Reykjavík Accessibility Workshop Trip",
+        "location": "Reykjavík",
+        "date": "2026-11-12",
+    },
+    {
+        "name": "Marrakesh Archive Consultation Trip",
+        "location": "Marrakesh",
+        "date": "2026-11-12",
+    },
+)
+
+
+def command_for(target: dict) -> list[str]:
+    return [
+        str(CLIENT),
+        "availability",
+        "--name",
+        target["name"],
+        "--location",
+        target["location"],
+        "--date",
+        target["date"],
+    ]
+
+
+def completed_result(process: subprocess.Popen[str]) -> dict:
+    stdout, stderr = process.communicate()
+    response_text = stdout if process.returncode == 0 else stderr
+    return {
+        "returncode": process.returncode,
+        "response": json.loads(response_text),
+    }
+
+
+def stage_initial() -> int:
+    processes = [
+        subprocess.Popen(
+            command_for(target),
+            cwd=ROOT,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for target in TARGETS
+    ]
+    print(
+        json.dumps(
+            [completed_result(process) for process in processes],
+            ensure_ascii=False,
+            separators=(",", ":"),
+        )
+    )
+    return 0
+
+
+def stage_retry(index: int) -> int:
+    completed = subprocess.run(
+        command_for(TARGETS[index]),
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    response_text = completed.stdout if completed.returncode == 0 else completed.stderr
+    print(
+        json.dumps(
+            {
+                "returncode": completed.returncode,
+                "response": json.loads(response_text),
+            },
+            ensure_ascii=False,
+            separators=(",", ":"),
+        )
+    )
+    return 0
+
+
+def orchestrate() -> int:
+    initial = subprocess.run(
+        [sys.executable, "-B", str(Path(__file__).resolve()), "stage-initial"],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    initial_results = json.loads(initial.stdout)
+    succeeded = [index for index, item in enumerate(initial_results)
+                 if item["returncode"] == 0]
+    failed = [index for index, item in enumerate(initial_results)
+              if item["returncode"] != 0]
+    if succeeded != [0] or failed != [1]:
+        raise RuntimeError("reference first stage did not have the required partial failure")
+    error = initial_results[failed[0]]["response"]
+    if error.get("retryable") is not True or error.get("error") != "temporary_unavailable":
+        raise RuntimeError("reference failure was not retryable and temporary")
+
+    retried = subprocess.run(
+        [sys.executable, "-B", str(Path(__file__).resolve()),
+         "stage-retry", str(failed[0])],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    retry_result = json.loads(retried.stdout)
+    if retry_result["returncode"] != 0:
+        raise RuntimeError("reference retry did not succeed")
+
+    results = [initial_results[0]["response"], retry_result["response"]]
+    labels = ["", " (retried once)"]
+    lines = []
+    for result, label in zip(results, labels, strict=True):
+        availability = "available" if result["available"] else "unavailable"
+        lines.append(
+            f"- {result['name']} at {result['location']} on {result['date']}"
+            f"{label}: {availability}."
+        )
+    (ROOT / "availability-result.md").write_text(
+        "\n".join(lines) + "\n", encoding="utf-8"
+    )
+    return 0
+
+
+def main() -> int:
+    if len(sys.argv) == 1:
+        return orchestrate()
+    if sys.argv[1:] == ["stage-initial"]:
+        return stage_initial()
+    if len(sys.argv) == 3 and sys.argv[1] == "stage-retry":
+        return stage_retry(int(sys.argv[2]))
+    raise SystemExit("invalid reference driver invocation")
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

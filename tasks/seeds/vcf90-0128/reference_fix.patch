diff --git a/Vcf.Operations.Networks/Vcf.Operations.Networks.psm1 b/Vcf.Operations.Networks/Vcf.Operations.Networks.psm1
new file mode 100644
index 0000000..ad39cff
--- /dev/null
+++ b/Vcf.Operations.Networks/Vcf.Operations.Networks.psm1
@@ -0,0 +1,81 @@
+Set-StrictMode -Version Latest
+
+$script:VcfOpsSdk = Get-Module -Name VMware.Sdk.Vcf.Ops -ErrorAction Stop
+$script:ListIncidentsOperationId = 'listTroubleshootingIncidents'
+$script:ListIncidentsWirePath = '/api/ni/gnt/troubleshoot/incidents'
+
+function ConvertTo-VcfNetworksQueryValue {
+    param([AllowNull()] [object] $Value)
+
+    return [Uri]::EscapeDataString([string] $Value)
+}
+
+function Get-VcfOperationsNetworkTroubleshootingIncident {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [uri] $ServerUri,
+
+        [Parameter(Mandatory)]
+        [string] $ApiToken,
+
+        [Parameter()]
+        [double] $PageSize,
+
+        [Parameter()]
+        [string] $StartEntityId
+    )
+
+    $pageSizeWasSupplied = $PSBoundParameters.ContainsKey('PageSize')
+    $startEntityWasSupplied = $PSBoundParameters.ContainsKey('StartEntityId')
+    $cursor = $null
+    $incidents = [System.Collections.Generic.List[object]]::new()
+
+    do {
+        Write-Verbose "Invoking $script:ListIncidentsOperationId with VMware SDK $($script:VcfOpsSdk.Version)."
+        $query = [System.Collections.Generic.List[string]]::new()
+        if ($pageSizeWasSupplied) {
+            $pageSizeValue = $PageSize.ToString('R', [Globalization.CultureInfo]::InvariantCulture)
+            $query.Add("size=$(ConvertTo-VcfNetworksQueryValue $pageSizeValue)")
+        }
+        if ($null -ne $cursor) {
+            $query.Add("cursor=$(ConvertTo-VcfNetworksQueryValue $cursor)")
+        }
+        if ($startEntityWasSupplied) {
+            $query.Add("start_entity_id=$(ConvertTo-VcfNetworksQueryValue $StartEntityId)")
+        }
+
+        $target = $ServerUri.AbsoluteUri.TrimEnd('/') + $script:ListIncidentsWirePath
+        if ($query.Count -gt 0) {
+            $target += '?' + ($query -join '&')
+        }
+
+        $headers = @{
+            Accept = 'application/json'
+            Authorization = "NetworkInsight $ApiToken"
+        }
+        $response = Invoke-RestMethod -Method Get -Uri ([uri] $target) -Headers $headers
+        foreach ($incident in @($response.results)) {
+            if ($null -ne $incident) {
+                $incidents.Add($incident)
+            }
+        }
+
+        $cursorProperty = $response.PSObject.Properties['cursor']
+        $cursor = if ($null -eq $cursorProperty -or [string]::IsNullOrEmpty([string] $cursorProperty.Value)) {
+            $null
+        }
+        else {
+            [string] $cursorProperty.Value
+        }
+    } while ($null -ne $cursor)
+
+    $comparison = [System.Comparison[object]] {
+        param([object] $Left, [object] $Right)
+        return [StringComparer]::Ordinal.Compare([string] $Left.entity_id, [string] $Right.entity_id)
+    }
+    $incidents.Sort($comparison)
+    foreach ($incident in $incidents) {
+        Write-Output $incident
+    }
+}
+Export-ModuleMember -Function Get-VcfOperationsNetworkTroubleshootingIncident

{
  "title": "VCF Operations for Networks 9.0 guided troubleshooting incident collection",
  "openapi_version": "3.0.1",
  "api_version": "9.0.0.0",
  "server_base_path": "/api/ni",
  "operations": [
    {
      "operationId": "listTroubleshootingIncidents",
      "method": "GET",
      "path": "/gnt/troubleshoot/incidents",
      "wire_path": "/api/ni/gnt/troubleshoot/incidents",
      "security": {
        "scheme": "ApiKeyAuth",
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "value_format": "NetworkInsight {token}"
      },
      "query_parameters": [
        {
          "name": "size",
          "required": false,
          "schema": {
            "type": "number",
            "default": 10.0
          }
        },
        {
          "name": "cursor",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "start_entity_id",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ],
      "success_response": {
        "status": 200,
        "media_type": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "entity_id": {
                    "type": "string"
                  },
                  "start_entity_id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  }
                }
              }
            },
            "total_count": {
              "type": "integer"
            },
            "cursor": {
              "type": "string",
              "description": "Cursor for the next page"
            }
          }
        }
      }
    }
  ]
}

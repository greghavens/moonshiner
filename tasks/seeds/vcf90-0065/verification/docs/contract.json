{
  "contractVersion": 1,
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "tag": "9.0.0.0",
    "path": "specifications/vcf-operations/vcf-operations-openapi.json",
    "openapi": "3.0.1",
    "apiVersion": "9.0.0.0",
    "specInfoVersion": "",
    "basePath": "/suite-api"
  },
  "operations": {
    "acquireToken": {
      "method": "POST",
      "path": "/api/auth/token/acquire",
      "jsonPointer": "#/paths/~1api~1auth~1token~1acquire/post",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "username-password"
      },
      "responses": {
        "200": {
          "contentType": "application/json",
          "schema": "auth-token"
        },
        "401": {
          "contentType": null,
          "schema": null
        }
      }
    },
    "releaseToken": {
      "method": "POST",
      "path": "/api/auth/token/release",
      "jsonPointer": "#/paths/~1api~1auth~1token~1release/post",
      "responses": {
        "200": {
          "contentType": null,
          "schema": null
        }
      }
    },
    "getCurrentVersionOfServer": {
      "method": "GET",
      "path": "/api/versions/current",
      "jsonPointer": "#/paths/~1api~1versions~1current/get",
      "responses": {
        "200": {
          "contentType": "application/json",
          "schema": "version"
        }
      }
    },
    "createAlertPlugin": {
      "method": "POST",
      "path": "/api/alertplugins",
      "jsonPointer": "#/paths/~1api~1alertplugins/post",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "notification-plugin"
      },
      "responses": {
        "201": {
          "contentType": "application/json",
          "schema": "notification-plugin"
        }
      }
    },
    "updateAlertPlugin": {
      "method": "PUT",
      "path": "/api/alertplugins",
      "jsonPointer": "#/paths/~1api~1alertplugins/put",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "notification-plugin"
      },
      "responses": {
        "200": {
          "contentType": "application/json",
          "schema": "notification-plugin"
        }
      }
    },
    "createNotificationPluginRule": {
      "method": "POST",
      "path": "/api/notifications/rules",
      "jsonPointer": "#/paths/~1api~1notifications~1rules/post",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "notification-rule"
      },
      "responses": {
        "201": {
          "contentType": "application/json",
          "schema": "notification-rule"
        },
        "404": {
          "contentType": null,
          "schema": null
        },
        "422": {
          "contentType": null,
          "schema": null
        }
      }
    }
  },
  "schemas": {
    "username-password": {
      "required": [
        "password",
        "username"
      ],
      "properties": {
        "username": {
          "type": "string"
        },
        "authSource": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      },
      "optional": [
        "authSource"
      ]
    },
    "auth-token": {
      "required": [
        "token",
        "validity"
      ],
      "properties": {
        "token": {
          "type": "string"
        },
        "validity": {
          "type": "integer",
          "format": "int64"
        },
        "expiresAt": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "optional": [
        "expiresAt",
        "roles"
      ]
    },
    "version": {
      "required": [
        "humanlyReadableReleaseDate",
        "major",
        "minor",
        "minorMinor",
        "releaseName",
        "releasedDate"
      ],
      "properties": {
        "releaseName": {
          "type": "string"
        },
        "major": {
          "type": "integer",
          "format": "int32"
        },
        "minor": {
          "type": "integer",
          "format": "int32"
        },
        "minorMinor": {
          "type": "integer",
          "format": "int32"
        },
        "buildNumber": {
          "type": "integer",
          "format": "int32"
        },
        "releasedDate": {
          "type": "integer",
          "format": "int64"
        },
        "humanlyReadableReleaseDate": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "optional": [
        "buildNumber",
        "description"
      ]
    },
    "notification-plugin": {
      "required": [
        "name",
        "pluginTypeId"
      ],
      "properties": {
        "pluginTypeId": {
          "type": "string"
        },
        "pluginId": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "configValues": {
          "type": "array",
          "items": {
            "$ref": "name-value"
          }
        },
        "certificates": {
          "uniqueItems": true,
          "type": "array",
          "items": {
            "$ref": "certificate"
          }
        }
      },
      "optional": [
        "certificates",
        "configValues",
        "description",
        "enabled",
        "pluginId"
      ]
    },
    "notification-rule": {
      "required": [
        "name",
        "pluginId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "pluginId": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "templateId": {
          "type": "string"
        },
        "alertControlStates": {
          "uniqueItems": true,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "OPEN",
              "ASSIGNED",
              "SUSPENDED",
              "SUPPRESSED"
            ]
          }
        },
        "alertStatuses": {
          "uniqueItems": true,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "NEW",
              "ACTIVE",
              "UPDATED",
              "CANCELED"
            ]
          }
        },
        "criticalities": {
          "uniqueItems": true,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "UNKNOWN",
              "NONE",
              "INFORMATION",
              "WARNING",
              "IMMEDIATE",
              "CRITICAL",
              "AUTO"
            ]
          }
        },
        "resourceKindFilter": {
          "$ref": "ResourceKindFilter"
        },
        "resourceKindFilters": {
          "type": "array",
          "items": {
            "$ref": "resource-kind-key"
          }
        },
        "resourceFilter": {
          "$ref": "ResourceFilter"
        },
        "resourceFilters": {
          "type": "array",
          "items": {
            "$ref": "ResourceFilter"
          }
        },
        "alertTypeFilters": {
          "type": "array",
          "items": {
            "$ref": "AlertTypeFilter"
          }
        },
        "alertDefinitionIdFilters": {
          "$ref": "str-values"
        },
        "alertImpactFilters": {
          "$ref": "str-values"
        },
        "sendHeartbeat": {
          "type": "boolean",
          "default": false
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "name-value"
          }
        },
        "collectorUUId": {
          "type": "string"
        },
        "collectorGroupId": {
          "type": "string"
        },
        "ruleType": {
          "type": "string",
          "enum": [
            "ALERT",
            "ACTION",
            "UNKNOWN"
          ]
        },
        "actionStatuses": {
          "uniqueItems": true,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "SUCCEEDED",
              "FAILED",
              "TIMEOUT",
              "UNKNOWN"
            ]
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "link"
          }
        }
      },
      "optional": [
        "actionStatuses",
        "alertControlStates",
        "alertDefinitionIdFilters",
        "alertImpactFilters",
        "alertStatuses",
        "alertTypeFilters",
        "collectorGroupId",
        "collectorUUId",
        "criticalities",
        "enabled",
        "id",
        "links",
        "properties",
        "resourceFilter",
        "resourceFilters",
        "resourceKindFilter",
        "resourceKindFilters",
        "ruleType",
        "sendHeartbeat",
        "templateId"
      ]
    },
    "name-value": {
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "optional": []
    },
    "certificate": {
      "required": [],
      "properties": {
        "thumbprint": {
          "type": "string"
        },
        "certificateDetails": {
          "type": "string"
        },
        "certificate": {
          "type": "string"
        },
        "issuedTo": {
          "type": "string"
        },
        "issuedBy": {
          "type": "string"
        },
        "expires": {
          "type": "string"
        }
      },
      "optional": [
        "certificate",
        "certificateDetails",
        "expires",
        "issuedBy",
        "issuedTo",
        "thumbprint"
      ]
    },
    "str-values": {
      "required": [],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "optional": [
        "values"
      ]
    }
  }
}

+function Resolve-VcfOpsApiFailure {
+    <#
+    .SYNOPSIS
+        Pull the HTTP status and the server supplied reason out of a failed SDK call.
+    #>
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [System.Management.Automation.ErrorRecord] $ErrorRecord
+    )
+
+    $apiException = $null
+    $current = $ErrorRecord.Exception
+    while ($null -ne $current) {
+        if ($null -ne $current.PSObject.Properties['ErrorCode']) {
+            $apiException = $current
+            break
+        }
+        $current = $current.InnerException
+    }
+
+    $statusCode = $null
+    $message = $ErrorRecord.Exception.Message
+    if ($null -ne $apiException) {
+        $statusCode = [int] $apiException.ErrorCode
+        $content = [string] $apiException.ErrorContent
+        if (-not [string]::IsNullOrWhiteSpace($content)) {
+            $message = $content
+            try {
+                $payload = $content | ConvertFrom-Json -ErrorAction Stop
+                if ($null -ne $payload.PSObject.Properties['message']) {
+                    $message = [string] $payload.message
+                }
+            }
+            catch {
+                # Leave the raw body as the reported reason.
+            }
+        }
+    }
+
+    return [pscustomobject]@{
+        StatusCode = $statusCode
+        Message    = ([string] $message).Trim()
+    }
+}

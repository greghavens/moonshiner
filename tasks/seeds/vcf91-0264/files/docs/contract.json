{
  "contractFormat": "focused-openapi-projection-v1",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repositoryCommitSha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "specPath": "specifications/vcf-operations/vcf-operations-openapi.json",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "apiVersion": "9.1.0.0",
    "apiTitle": "VMware Cloud Foundation Operations API",
    "serverBasePath": "/suite-api"
  },
  "security": {
    "schemeName": "Token-based-authorization",
    "type": "apiKey",
    "in": "header",
    "headerName": "Authorization",
    "tokenPrefix": "vRealizeOpsToken",
    "tokenPrefixNote": "components.securitySchemes pins only the header name and location; the 'vRealizeOpsToken <token>' prefix is the VCF Operations suite-api wire convention and is pinned here as part of this focused contract.",
    "unauthenticatedOperationIds": [
      "acquireToken"
    ]
  },
  "precheckGate": {
    "prechecks": [
      "enumerateAdapterInstances",
      "testConnection"
    ],
    "mutatingOperationId": "createAdapterInstance",
    "rule": "createAdapterInstance must not be sent unless enumerateAdapterInstances proved the adapter instance name is unused and testConnection returned 201 for a byte-identical create-adapter-instance body."
  },
  "wireEncoding": {
    "jsonSeparators": [
      ",",
      ":"
    ],
    "charset": "utf-8",
    "requestContentType": "application/json",
    "acceptHeader": "application/json",
    "queryEncoding": "application/x-www-form-urlencoded",
    "booleanQueryLiterals": [
      "true",
      "false"
    ]
  },
  "operations": [
    {
      "operationId": "acquireToken",
      "method": "POST",
      "path": "/api/auth/token/acquire",
      "summary": "Acquire a token to perform REST API calls",
      "jsonPointer": "/paths/~1api~1auth~1token~1acquire/post/operationId",
      "authenticated": false,
      "parameters": [],
      "requestBody": {
        "required": true,
        "description": "The UsernamePassword object that encapsulates username, password and optionally the name of an Auth Source as specified by the user",
        "contentType": "application/json",
        "schema": "username-password",
        "declaredContentTypes": [
          "application/json",
          "application/xml"
        ]
      },
      "responses": {
        "200": {
          "description": "The token and expiry time of the token",
          "contentType": "application/json",
          "schema": "auth-token"
        },
        "401": {
          "description": "Authentication failed",
          "contentType": null,
          "schema": null,
          "declaredContentInSpec": false
        }
      },
      "focusedWireProfile": {
        "boundBodyMembers": [
          "password",
          "username"
        ],
        "conditionalBodyMembers": [
          "authSource"
        ],
        "unsetBodyMembers": [],
        "boundQueryMembers": [],
        "unsetQueryMembers": [],
        "unsetBehavior": "omit",
        "memberOrder": "contract schema declaration order",
        "sendsAuthorizationHeader": false
      }
    },
    {
      "operationId": "enumerateAdapterInstances",
      "method": "GET",
      "path": "/api/adapters",
      "summary": "Get all the adapter instance resources in the system",
      "jsonPointer": "/paths/~1api~1adapters/get/operationId",
      "authenticated": true,
      "parameters": [
        {
          "name": "adapterKindKey",
          "in": "query",
          "description": "If this parameter is specified, the API returns only instances of this Adapter Kind.",
          "required": false,
          "schema": {
            "type": "string",
            "default": ""
          }
        }
      ],
      "requestBody": false,
      "responses": {
        "200": {
          "description": "The adapter instances managed by the system.",
          "contentType": "application/json",
          "schema": "adapter-instances"
        },
        "404": {
          "description": "No adapter instance is found with the specified identifier",
          "contentType": null,
          "schema": null,
          "declaredContentInSpec": false
        }
      },
      "focusedWireProfile": {
        "boundBodyMembers": [],
        "conditionalBodyMembers": [],
        "unsetBodyMembers": [],
        "boundQueryMembers": [
          "adapterKindKey"
        ],
        "unsetQueryMembers": [],
        "unsetBehavior": "omit",
        "memberOrder": "contract schema declaration order",
        "sendsAuthorizationHeader": true
      }
    },
    {
      "operationId": "testConnection",
      "method": "POST",
      "path": "/api/adapters/testConnection",
      "summary": "Test Adapter Instance connection",
      "jsonPointer": "/paths/~1api~1adapters~1testConnection/post/operationId",
      "authenticated": true,
      "parameters": [],
      "requestBody": {
        "required": true,
        "description": "The adapter instance connection request",
        "contentType": "application/json",
        "schema": "create-adapter-instance",
        "declaredContentTypes": [
          "application/json",
          "application/xml"
        ]
      },
      "responses": {
        "201": {
          "description": "The adapter instance that was created",
          "contentType": "application/json",
          "schema": "adapter-instance"
        },
        "400": {
          "description": "If <b>Test</b> 'adapter instance connection' failed. Typically the service will return extra information as to why the creation failed.",
          "contentType": null,
          "schema": null,
          "declaredContentInSpec": false
        }
      },
      "focusedWireProfile": {
        "boundBodyMembers": [
          "adapterKindKey",
          "credential",
          "name",
          "resourceIdentifiers"
        ],
        "conditionalBodyMembers": [
          "description"
        ],
        "unsetBodyMembers": [
          "collectorGroupId",
          "collectorId",
          "monitoringInterval",
          "monitoringIntervalSeconds",
          "physicalDatacenterId"
        ],
        "boundQueryMembers": [],
        "unsetQueryMembers": [],
        "unsetBehavior": "omit",
        "memberOrder": "contract schema declaration order",
        "sendsAuthorizationHeader": true,
        "nestedProfiles": [
          {
            "schema": "credential",
            "boundMembers": [
              "adapterKindKey",
              "credentialKindKey",
              "fields",
              "name"
            ],
            "unsetMembers": [
              "editable",
              "id"
            ],
            "unsetBehavior": "omit"
          }
        ]
      }
    },
    {
      "operationId": "createAdapterInstance",
      "method": "POST",
      "path": "/api/adapters",
      "summary": "Create an Adapter Instance",
      "jsonPointer": "/paths/~1api~1adapters/post/operationId",
      "authenticated": true,
      "parameters": [
        {
          "name": "extractIdentifierDefaults",
          "in": "query",
          "description": "Indicates whether need to return default value or null in a result for<br/>identifiers that have no/null value in request body",
          "required": false,
          "schema": {
            "type": "boolean",
            "default": false
          }
        },
        {
          "name": "force",
          "in": "query",
          "description": "Proceed with adapter instance creation even if connection is not established",
          "required": false,
          "schema": {
            "type": "boolean",
            "default": true
          }
        }
      ],
      "requestBody": {
        "required": true,
        "description": "The adapter instance creation request",
        "contentType": "application/json",
        "schema": "create-adapter-instance",
        "declaredContentTypes": [
          "application/json",
          "application/xml"
        ]
      },
      "responses": {
        "201": {
          "description": "The adapter instance that was created",
          "contentType": "application/json",
          "schema": "adapter-instance"
        },
        "400": {
          "description": "If <b>create</b> 'adapter instance' failed. Typically the service will return extra information as to why the creation failed.",
          "contentType": null,
          "schema": null,
          "declaredContentInSpec": false
        }
      },
      "focusedWireProfile": {
        "boundBodyMembers": [
          "adapterKindKey",
          "credential",
          "name",
          "resourceIdentifiers"
        ],
        "conditionalBodyMembers": [
          "description"
        ],
        "unsetBodyMembers": [
          "collectorGroupId",
          "collectorId",
          "monitoringInterval",
          "monitoringIntervalSeconds",
          "physicalDatacenterId"
        ],
        "boundQueryMembers": [
          "force"
        ],
        "boundQueryValues": {
          "force": "false"
        },
        "unsetQueryMembers": [
          "extractIdentifierDefaults"
        ],
        "unsetBehavior": "omit",
        "memberOrder": "contract schema declaration order",
        "sendsAuthorizationHeader": true,
        "nestedProfiles": [
          {
            "schema": "credential",
            "boundMembers": [
              "adapterKindKey",
              "credentialKindKey",
              "fields",
              "name"
            ],
            "unsetMembers": [
              "editable",
              "id"
            ],
            "unsetBehavior": "omit"
          }
        ]
      }
    }
  ],
  "schemas": {
    "username-password": {
      "type": "object",
      "description": "Represents model of Username and Password",
      "required": [
        "password",
        "username"
      ],
      "properties": {
        "authSource": {
          "type": "string",
          "description": "The auth source name"
        },
        "password": {
          "type": "string",
          "description": "The password"
        },
        "username": {
          "type": "string",
          "description": "The username"
        }
      }
    },
    "auth-token": {
      "type": "object",
      "description": "Authentication token returned by<br>VMware Cloud Foundation Operations for future REST API calls.",
      "required": [
        "token",
        "validity"
      ],
      "properties": {
        "expiresAt": {
          "type": "string",
          "description": "Token expiration time, in easy to read string representation (since Jan 1, 1970)"
        },
        "roles": {
          "type": "array",
          "description": "List of roles the current user has",
          "items": {
            "type": "string",
            "description": "List of roles the current user has",
            "xml": {
              "name": "role"
            }
          }
        },
        "token": {
          "type": "string",
          "description": "Auth token for accessing future rest API(s)"
        },
        "validity": {
          "type": "integer",
          "format": "int64",
          "description": "Token expiration time in milliseconds (since Jan 1, 1970)"
        }
      }
    },
    "name-value": {
      "type": "object",
      "description": "Represents a single name -> value tuple.",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "credential": {
      "type": "object",
      "description": "The Credential Instance information",
      "required": [
        "adapterKindKey",
        "credentialKindKey",
        "name"
      ],
      "properties": {
        "adapterKindKey": {
          "type": "string",
          "description": "The Adapter Kind key of the Credential"
        },
        "credentialKindKey": {
          "type": "string",
          "description": "The credential kind of the credential"
        },
        "editable": {
          "type": "boolean",
          "description": "Is credential editable or not"
        },
        "fields": {
          "type": "array",
          "description": "Collection of name,value pairs that capture the credential specific data",
          "items": {
            "$ref": "name-value"
          }
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Credential Instance identifier.<br>This should be null for credential instance creation requests and must have a value for all other requests."
        },
        "name": {
          "type": "string",
          "description": "The name of the Credential"
        }
      }
    },
    "create-adapter-instance": {
      "type": "object",
      "description": "A DTO that serves as the structure of the payload data for creating a new adapter instance",
      "required": [
        "adapterKindKey",
        "name"
      ],
      "properties": {
        "adapterKindKey": {
          "type": "string",
          "description": "The Adapter Kind key"
        },
        "collectorGroupId": {
          "type": "string",
          "format": "uuid",
          "description": "The Collector Group ID to be used for this Adapter Instance. If not specified, the system will choose an appropriate Collector group for you"
        },
        "collectorId": {
          "type": "string",
          "description": "The Collector instance used by this adapter instance. If not specified, the system will choose an appropriate Collector for you"
        },
        "credential": {
          "$ref": "credential"
        },
        "description": {
          "type": "string",
          "description": "Optional description of the Adapter instance"
        },
        "monitoringInterval": {
          "type": "integer",
          "format": "int32",
          "description": "Minutes part of the monitoring Interval of the Adapter Instance, where the monitoring Interval is the frequency of data source query for stats and properties.",
          "minimum": 0
        },
        "monitoringIntervalSeconds": {
          "type": "integer",
          "format": "int32",
          "description": "Seconds part of the monitoring Interval of the Adapter Instance, where the monitoring Interval is the frequency of data source query for stats and properties.",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "description": "The name of the Adapter instance",
          "maxLength": 300,
          "minLength": 1
        },
        "physicalDatacenterId": {
          "type": "string",
          "format": "uuid",
          "description": "The Physical Datacenter ID to be used for this Adapter Instance. It is Optional"
        },
        "resourceIdentifiers": {
          "type": "array",
          "description": "Adapter instance specific resource identifiers",
          "items": {
            "$ref": "name-value"
          }
        }
      }
    },
    "resource-identifier": {
      "type": "object",
      "description": "A key,value pair that encapsulates the identity of the resource",
      "required": [
        "identifierType"
      ],
      "properties": {
        "identifierType": {
          "$ref": "resource-identifier-type"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "link"
          }
        },
        "value": {
          "type": "string",
          "description": "The resource identifier value"
        }
      }
    },
    "resource-key": {
      "type": "object",
      "description": "Represents a composite key for uniquely identifying a Resource.",
      "required": [
        "adapterKindKey",
        "name",
        "resourceKindKey"
      ],
      "properties": {
        "adapterKindKey": {
          "type": "string",
          "description": "Adapter Kind to which the resource belongs to"
        },
        "extension": {
          "$ref": "extension"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "link"
          }
        },
        "name": {
          "type": "string",
          "description": "Name of the Resource"
        },
        "resourceIdentifiers": {
          "type": "array",
          "description": "A collection of Resource Identifiers",
          "items": {
            "$ref": "resource-identifier"
          }
        },
        "resourceKindKey": {
          "type": "string",
          "description": "Resource Kind to which the resource belongs to"
        }
      }
    },
    "adapter-instance": {
      "type": "object",
      "description": "Model object containing information about the adapter instance",
      "required": [
        "resourceKey"
      ],
      "properties": {
        "adapter-certificates": {
          "type": "array",
          "description": "The set of untrusted certificates returned by the adapter source",
          "items": {
            "$ref": "certificate"
          },
          "uniqueItems": true
        },
        "collectorGroupId": {
          "type": "string",
          "format": "uuid",
          "description": "The ID of the collector group. If not specified, the system will choose an appropriate Collector group for you"
        },
        "collectorId": {
          "type": "integer",
          "format": "int32",
          "description": "The ID of the Collector that manages this adapter instance. This is optional and if not specified, system will choose an appropriate collector."
        },
        "credentialInstanceId": {
          "type": "string",
          "format": "uuid",
          "description": "The Credential Instance identifier used by this adapter instance"
        },
        "description": {
          "type": "string",
          "description": "Optional description of the Adapter instance"
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "The UUID of the adapter instance"
        },
        "lastCollected": {
          "type": "integer",
          "format": "int64",
          "description": "Last time adapter instance reported collection of resources/stats."
        },
        "lastHeartbeat": {
          "type": "integer",
          "format": "int64",
          "description": "Last time when this adapter instance communicated with VMware Cloud Foundation Operations Server."
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "link"
          }
        },
        "messageFromAdapterInstance": {
          "type": "string",
          "description": "Any message from the adapter instance."
        },
        "monitoringInterval": {
          "type": "integer",
          "format": "int32",
          "description": "Minutes part of the monitoring Interval of the Adapter Instance.",
          "minimum": 0
        },
        "monitoringIntervalSeconds": {
          "type": "integer",
          "format": "int32",
          "description": "Seconds part of the monitoring Interval of the Adapter Instance",
          "minimum": 0
        },
        "numberOfMetricsCollected": {
          "type": "integer",
          "format": "int32",
          "description": "The number of metrics reported by this adapter instance."
        },
        "numberOfResourcesCollected": {
          "type": "integer",
          "format": "int32",
          "description": "The number of resources being monitored by this resource."
        },
        "physicalDatacenterId": {
          "type": "string",
          "format": "uuid",
          "description": "The Physical Datacenter ID to be used for this Adapter Instance.It is Optional"
        },
        "resourceKey": {
          "$ref": "resource-key"
        }
      }
    },
    "adapter-instances": {
      "type": "object",
      "description": "Model object representing a Collection of Adapter Instances",
      "properties": {
        "adapterInstancesInfoDto": {
          "type": "array",
          "description": "The collection of adapter instances",
          "items": {
            "$ref": "adapter-instance"
          },
          "uniqueItems": true
        }
      }
    },
    "certificate": {
      "type": "object",
      "description": "Untrusted certificate representation",
      "properties": {
        "certificate": {
          "type": "string",
          "description": "If the source returns an untrusted certificate, this field is used to represent the full certificate. Currently used only for VIDB and provided in PEM format."
        },
        "certificateDetails": {
          "type": "string",
          "description": "If the source returns an untrusted certificate, this field is used to represent certificate details. It also contains <i>Algorithm</i>, <i>Signature (base64-encoded)</i> and <i>SignedCertificate (base64-encoded)</i> values."
        },
        "expires": {
          "type": "string",
          "description": "Expiration date of the certificate"
        },
        "issuedBy": {
          "type": "string",
          "description": "The issuedBy parameter of the certificate"
        },
        "issuedTo": {
          "type": "string",
          "description": "The issuedTo date of the certificate"
        },
        "thumbprint": {
          "type": "string",
          "description": "If the source returns an untrusted certificate,this field is used to represent the certificate guid"
        }
      }
    },
    "error": {
      "type": "object",
      "description": "Error Message that is returned as part of HTTP response in case of an error during the API invocation",
      "required": [
        "message"
      ],
      "properties": {
        "apiErrorCode": {
          "type": "integer",
          "format": "int32",
          "description": "The error code of the error"
        },
        "extension": {
          "$ref": "extension"
        },
        "httpStatusCode": {
          "type": "integer",
          "format": "int32",
          "description": "The status code of the error"
        },
        "inputBodyLocation": {
          "$ref": "InputBodyLocation"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "link"
          }
        },
        "message": {
          "type": "string",
          "description": "The error message"
        },
        "moreInformation": {
          "type": "array",
          "description": "Some more information about the error",
          "items": {
            "$ref": "name-value"
          }
        },
        "type": {
          "type": "string",
          "description": "Used to identify schema type. For each schema its equivalent value should be used. allowableValues = {CertificatesError, Error}"
        },
        "validationFailures": {
          "type": "array",
          "description": "The collection of validation failures",
          "items": {
            "$ref": "validationFailure"
          }
        }
      },
      "discriminator": {
        "mapping": {
          "CertificatesError": "#/components/schemas/certificates-error",
          "Error": "#/components/schemas/error"
        },
        "propertyName": "type"
      }
    }
  }
}

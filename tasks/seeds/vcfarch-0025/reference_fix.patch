+			"mtu":             9000,
+			"vmnicsToUplinks": mappings,
+		}},
+		"nsxtSpec": map[string]any{
+			"nsxtManagers":          managers,
+			"nsxtManagerSize":       "large",
+			"vipFqdn":               "nsx-vip." + green.Domain,
+			"version":               green.TargetVCFVersion,
+			"useExistingDeployment": false,
+		},
+		"networkSpecs": networks,
+		"dnsSpec": map[string]any{

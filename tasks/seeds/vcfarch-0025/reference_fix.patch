+func TestBuild(t *testing.T) {
+	estate := loadJSON[Estate](t, "../fixtures/estate.json")
+	snapshot := loadJSON[CompatibilitySnapshot](t, "../authority/compatibility-snapshot.json")
+
+	tests := []struct {
+		name       string
+		mutate     func(*Estate, *CompatibilitySnapshot)
+		wantFactor string
+		wantSteps  int
+		wantError  bool
+	}{
+		{name: "pinned architecture", wantFactor: "XLARGE", wantSteps: 7},
+		{name: "unsupported throughput", mutate: func(e *Estate, _ *CompatibilitySnapshot) {
+			e.Greenfield.Edge.NorthSouthGbps = 30
+		}, wantError: true},
+		{name: "unknown uplink profile", mutate: func(e *Estate, _ *CompatibilitySnapshot) {
+			e.Greenfield.Edge.UplinkProfileID = "UNKNOWN"
+		}, wantError: true},
+		{name: "broken migration path", mutate: func(e *Estate, _ *CompatibilitySnapshot) {
+			e.Existing.Components[0].CurrentVersion = "5.1.0.0"
+		}, wantError: true},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			candidateEstate := clone(t, estate)
+			candidateSnapshot := clone(t, snapshot)
+			if test.mutate != nil {
+				test.mutate(&candidateEstate, &candidateSnapshot)
+			}
+			design, err := Build(candidateEstate, candidateSnapshot)
+			if test.wantError {
+				if err == nil {
+					t.Fatal("Build succeeded, want error")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("Build failed: %v", err)
+			}
+			if design.EdgeDesign.FormFactor != test.wantFactor {
+				t.Errorf("form factor = %s, want %s", design.EdgeDesign.FormFactor, test.wantFactor)
+			}
+			if len(design.MigrationPlan.Steps) != test.wantSteps {
+				t.Errorf("migration steps = %d, want %d", len(design.MigrationPlan.Steps), test.wantSteps)
+			}
+		})
+	}
+}
+
+func loadJSON[T any](t *testing.T, path string) T {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var value T
+	if err := json.Unmarshal(data, &value); err != nil {
+		t.Fatal(err)
+	}
+	return value
+}
+
+func clone[T any](t *testing.T, value T) T {
+	t.Helper()
+	data, err := json.Marshal(value)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var result T
+	if err := json.Unmarshal(data, &result); err != nil {
+		t.Fatal(err)
+	}
+	return result
 }

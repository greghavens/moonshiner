+func buildEdgeDesign(green Greenfield, snapshot CompatibilitySnapshot) (EdgeDesign, error) {
+	demand := green.Edge
+	if demand.NodeCount < 1 {
+		return EdgeDesign{}, fmt.Errorf("edge node count must be positive")
+	}
+	perNode := demand.NorthSouthGbps
+	if !demand.SurviveSingleNodeFailure {
+		perNode /= float64(demand.NodeCount)
+	}
+	factors := append([]EdgeFormFactor(nil), snapshot.EdgeFormFactors...)
+	sort.Slice(factors, func(i, j int) bool { return factors[i].MaximumInclusive < factors[j].MaximumInclusive })
+	var selected *EdgeFormFactor
+	for index := range factors {
+		if perNode > factors[index].MinimumExclusive && perNode <= factors[index].MaximumInclusive {
+			selected = &factors[index]
+			break
+		}
+	}
+	if selected == nil {
+		return EdgeDesign{}, fmt.Errorf("no supported Edge form factor for %.1f Gbps", perNode)
+	}
+	var profile *UplinkProfile
+	for index := range snapshot.UplinkProfiles {
+		candidate := &snapshot.UplinkProfiles[index]
+		if candidate.ID == demand.UplinkProfileID {
+			profile = candidate
+			break
+		}
+	}
+	if profile == nil {
+		return EdgeDesign{}, fmt.Errorf("uplink profile %s is not in the snapshot", demand.UplinkProfileID)
+	}
+	if !(perNode > profile.MinimumDemandExclusive && perNode <= profile.MaximumDemandInclusive) {
+		return EdgeDesign{}, fmt.Errorf("uplink profile %s does not support %.1f Gbps", profile.ID, perNode)
+	}
+	if len(demand.PhysicalUplinks) < profile.MinimumUplinksPerNode {
+		return EdgeDesign{}, fmt.Errorf("uplink profile %s requires %d uplinks", profile.ID, profile.MinimumUplinksPerNode)
+	}
+	tors, vlans := map[string]bool{}, map[int]bool{}
+	for _, uplink := range demand.PhysicalUplinks {
+		if uplink.SpeedGbps < profile.MinimumLinkSpeedGbps {
+			return EdgeDesign{}, fmt.Errorf("uplink %s is below %.0f Gbps", uplink.Name, profile.MinimumLinkSpeedGbps)
+		}
+		tors[uplink.TOR], vlans[uplink.VLAN] = true, true
+	}
+	if profile.RequireDistinctTORs && len(tors) != len(demand.PhysicalUplinks) {
+		return EdgeDesign{}, fmt.Errorf("uplinks must terminate on distinct TORs")
+	}
+	if profile.RequireDistinctVLANs && len(vlans) != len(demand.PhysicalUplinks) {
+		return EdgeDesign{}, fmt.Errorf("uplinks must use distinct VLANs")
+	}
+	if demand.NodeCount != len(demand.PlacementZones) {
+		return EdgeDesign{}, fmt.Errorf("each Edge node needs an availability-zone placement")
+	}
+	nodes := make([]EdgeNode, 0, demand.NodeCount)
+	for index := 0; index < demand.NodeCount; index++ {
+		uplinks := append([]Uplink(nil), demand.PhysicalUplinks...)
+		nodes = append(nodes, EdgeNode{
+			Name:             fmt.Sprintf("%s-edge%02d", demand.SiteID, index+1),
+			AvailabilityZone: demand.PlacementZones[index],
+			Uplinks:          uplinks,
+		})
+	}
+	return EdgeDesign{
+		SiteID:               demand.SiteID,
+		Sites:                append([]Site(nil), green.Sites...),
+		FormFactor:           selected.Name,
+		VCPUPerNode:          selected.VCPU,
+		MemoryGiBPerNode:     selected.MemoryGiB,
+		NodeCount:            demand.NodeCount,
+		HAMode:               demand.HAMode,
+		NorthSouthGbps:       demand.NorthSouthGbps,
+		PerSurvivingNodeGbps: perNode,
+		UplinkProfileID:      profile.ID,
+		Nodes:                nodes,
+		TEP: TEPDesign{
+			VLAN:          demand.TEPVLAN,
+			MTU:           demand.TEPMTU,
+			TeamingPolicy: "LOADBALANCE_SRCID",
+		},
+	}, nil
+}
+
+func buildMigrationPlan(estate Estate, snapshot CompatibilitySnapshot) (MigrationPlan, error) {
+	current := map[string]string{}
+	target := map[string]string{}
+	ranks := map[string]map[string]int{}
+	for _, component := range estate.Existing.Components {
+		current[component.Name] = component.CurrentVersion
+		target[component.Name] = component.TargetVersion
+		if snapshot.TargetCombination[component.Name] != component.TargetVersion {
+			return MigrationPlan{}, fmt.Errorf("component %s target %s is outside the pinned combination", component.Name, component.TargetVersion)
+		}
+		ranks[component.Name] = rankVersions(component, snapshot.SupportedUpgradeHops)
+	}
+	remaining := append([]UpgradeHop(nil), snapshot.SupportedUpgradeHops...)
+	steps := make([]MigrationStep, 0, len(remaining))
+	for len(remaining) > 0 {
+		progressed := false
+		for componentIndex := range estate.Existing.Components {
+			name := estate.Existing.Components[componentIndex].Name
+			for hopIndex, hop := range remaining {
+				if hop.Component != name || current[name] != hop.FromVersion || !dependenciesMet(hop, current, ranks, snapshot.UpgradeDependencies) {
+					continue
+				}
+				gates := make([]MigrationGate, 0, len(hop.RequiredGates))
+				for _, gateID := range hop.RequiredGates {
+					condition, ok := gateConditions[gateID]
+					if !ok || condition == "" {
+						return MigrationPlan{}, fmt.Errorf("gate %s has no defined condition", gateID)
+					}
+					gates = append(gates, MigrationGate{ID: gateID, Condition: condition})
+				}
+				steps = append(steps, MigrationStep{
+					Order:         len(steps) + 1,
+					Component:     hop.Component,
+					FromVersion:   hop.FromVersion,
+					TargetVersion: hop.ToVersion,
+					Gates:         gates,
+				})
+				current[name] = hop.ToVersion
+				remaining = append(remaining[:hopIndex], remaining[hopIndex+1:]...)
+				progressed = true
+				break
+			}
+			if progressed {
+				break
+			}
+		}
+		if !progressed {
+			return MigrationPlan{}, fmt.Errorf("supported hops and dependencies do not yield a complete migration")
+		}
+	}
+	for name, wanted := range target {
+		if current[name] != wanted {
+			return MigrationPlan{}, fmt.Errorf("migration leaves %s at %s instead of %s", name, current[name], wanted)
+		}
+	}
+	return MigrationPlan{EstateID: estate.EstateID, TargetVCFVersion: estate.Existing.TargetVCFVersion, Steps: steps}, nil
+}
+
+func dependenciesMet(hop UpgradeHop, current map[string]string, ranks map[string]map[string]int, dependencies []UpgradeDependency) bool {
+	for _, dependency := range dependencies {
+		if dependency.Component != hop.Component || dependency.ToVersion != hop.ToVersion {
+			continue
+		}
+		actualRank, actualOK := ranks[dependency.RequiresComponent][current[dependency.RequiresComponent]]
+		minimumRank, minimumOK := ranks[dependency.RequiresComponent][dependency.MinimumVersion]
+		if !actualOK || !minimumOK || actualRank < minimumRank {
+			return false
+		}
+	}
+	return true
+}
+
+func rankVersions(component Component, hops []UpgradeHop) map[string]int {
+	ranks := map[string]int{component.CurrentVersion: 0}
+	current := component.CurrentVersion
+	for rank := 1; rank <= len(hops); rank++ {
+		advanced := false
+		for _, hop := range hops {
+			if hop.Component == component.Name && hop.FromVersion == current {
+				ranks[hop.ToVersion] = rank
+				current = hop.ToVersion
+				advanced = true
+				break
+			}
+		}
+		if !advanced {
+			break
+		}
+	}
+	return ranks
+}
 

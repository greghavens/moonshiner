+func Build(estate Estate, snapshot CompatibilitySnapshot) (Design, error) {
+	if estate.Greenfield.TargetVCFVersion == "" || estate.Existing.TargetVCFVersion == "" {
+		return Design{}, fmt.Errorf("target VCF versions are required")
+	}
+	if estate.Greenfield.TargetVCFVersion != estate.Existing.TargetVCFVersion {
+		return Design{}, fmt.Errorf("greenfield target %s and migration target %s must match", estate.Greenfield.TargetVCFVersion, estate.Existing.TargetVCFVersion)
+	}
+	if estate.Greenfield.TargetVCFVersion != snapshot.TargetCombination["VCF"] {
+		return Design{}, fmt.Errorf("greenfield target %s is outside snapshot %s", estate.Greenfield.TargetVCFVersion, snapshot.SnapshotID)
+	}
+	sddc, err := buildSddcSpec(estate.Greenfield)
+	if err != nil {
+		return Design{}, err
+	}
+	edge, err := buildEdgeDesign(estate.Greenfield, snapshot)
+	if err != nil {
+		return Design{}, err
+	}
+	migration, err := buildMigrationPlan(estate, snapshot)
+	if err != nil {
+		return Design{}, err
+	}
+	return Design{SddcSpec: sddc, EdgeDesign: edge, MigrationPlan: migration}, nil
+}

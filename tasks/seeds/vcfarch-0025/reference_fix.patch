+func buildSddcSpec(green Greenfield) (json.RawMessage, error) {
+	hosts := make([]any, 0, len(green.Management.Hosts))
+	for _, hostname := range green.Management.Hosts {
+		hosts = append(hosts, map[string]any{"hostname": hostname})
+	}
+	networks := make([]any, 0, len(green.Networks))
+	networkTypes := make([]string, 0, len(green.Networks))
+	for _, network := range green.Networks {
+		ranges := make([]any, 0, len(network.IPRanges))
+		for _, ipRange := range network.IPRanges {
+			ranges = append(ranges, map[string]any{
+				"startIpAddress": ipRange.Start,
+				"endIpAddress":   ipRange.End,
+			})
+		}
+		networks = append(networks, map[string]any{
+			"networkType":             network.Type,
+			"vlanId":                  network.VLAN,
+			"subnet":                  network.CIDR,
+			"gateway":                 network.Gateway,
+			"mtu":                     network.MTU,
+			"includeIpAddressRanges":  ranges,
+			"ipAddressVersion":        "IPv4",
+			"ipAddressAssignmentMode": "STATIC",
+		})
+		networkTypes = append(networkTypes, network.Type)
+	}
+	mappings := make([]any, 0, len(green.Management.DVSUplinks))
+	for _, uplink := range green.Management.DVSUplinks {
+		mappings = append(mappings, map[string]any{"id": uplink.PhysicalNIC, "uplink": uplink.Name})
+	}
+	managers := make([]any, 0, len(green.NSXManagerFQDNs))
+	for _, hostname := range green.NSXManagerFQDNs {
+		managers = append(managers, map[string]any{"hostname": hostname})
+	}
+	if len(managers) == 0 {
+		return nil, fmt.Errorf("at least one NSX manager is required")
+	}
+	spec := map[string]any{
+		"sddcId":          green.SDDCID,
+		"workflowType":    "VCF",
+		"version":         green.TargetVCFVersion,

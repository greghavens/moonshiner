{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch:migration-plan:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["estateId", "targetVcfVersion", "steps"],
  "properties": {
    "estateId": {"type": "string", "minLength": 1},
    "targetVcfVersion": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "component", "fromVersion", "targetVersion", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "component": {"type": "string", "minLength": 1},
          "fromVersion": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "condition"],
              "properties": {
                "id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
                "condition": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}

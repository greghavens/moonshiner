{
  "description": "Wire contract for the VCF Operations 9.1 alerting-rollout change. Every path, schema name and property list below is read out of the pinned OpenAPI document; see docs/official_sources.json.",
  "source": {
    "repository": "vmware/vcf-api-specs",
    "license": "Apache-2.0",
    "spec_path": "specifications/vcf-operations/vcf-operations-openapi.json",
    "commit_sha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "openapi": "3.0.1",
    "api_title": "VMware Cloud Foundation Operations API",
    "api_version": "9.1.0.0"
  },
  "server": {
    "base_path": "/suite-api",
    "derived_from": "servers[0].url"
  },
  "authorization": {
    "scheme_name": "Token-based-authorization",
    "type": "apiKey",
    "in": "header",
    "header_name": "Authorization",
    "applies_to": "every operation except acquireToken (global security requirement in the spec)",
    "header_value_format": "OpsToken {token}",
    "header_value_format_note": "The OpenAPI document fixes only the header name (apiKey in header, \"Authorization\"). The official VCF Operations developer portal documents the OpsToken prefix for session tokens; the target deployment in this task does not accept the older prefix. Recorded as a supplementary source in docs/official_sources.json."
  },
  "operations": [
    {
      "step": 1,
      "operationId": "acquireToken",
      "method": "POST",
      "spec_path": "/api/auth/token/acquire",
      "request_path": "/suite-api/api/auth/token/acquire",
      "requires_authorization": false,
      "request_body": {
        "media_type": "application/json",
        "schema": "username-password",
        "required_properties": [
          "password",
          "username"
        ],
        "optional_properties": [
          "authSource"
        ]
      },
      "responses": {
        "200": {
          "description": "The token and expiry time of the token",
          "schema": "auth-token"
        },
        "401": {
          "description": "Authentication failed",
          "schema": null
        }
      }
    },
    {
      "step": 2,
      "operationId": "createSymptomDefinition",
      "method": "POST",
      "spec_path": "/api/symptomdefinitions",
      "request_path": "/suite-api/api/symptomdefinitions",
      "requires_authorization": true,
      "request_body": {
        "media_type": "application/json",
        "schema": "symptom-definition",
        "required_properties": [
          "adapterKindKey",
          "name",
          "resourceKindKey",
          "state"
        ],
        "optional_properties": [
          "cancelCycles",
          "id",
          "realtimeMonitoringEnabled",
          "waitCycles"
        ]
      },
      "responses": {
        "201": {
          "description": "The created Symptom Definition",
          "schema": "symptom-definition"
        }
      }
    },
    {
      "step": 3,
      "operationId": "createAlertDefinition",
      "method": "POST",
      "spec_path": "/api/alertdefinitions",
      "request_path": "/suite-api/api/alertdefinitions",
      "requires_authorization": true,
      "request_body": {
        "media_type": "application/json",
        "schema": "alert-definition",
        "required_properties": [
          "adapterKindKey",
          "name",
          "resourceKindKey",
          "states"
        ],
        "optional_properties": [
          "cancelCycles",
          "description",
          "forVCDTenants",
          "id",
          "subType",
          "type",
          "waitCycles"
        ]
      },
      "responses": {
        "201": {
          "description": "The created Alert Definition",
          "schema": "alert-definition"
        }
      }
    },
    {
      "step": 4,
      "operationId": "createNotificationPluginRule",
      "method": "POST",
      "spec_path": "/api/notifications/rules",
      "request_path": "/suite-api/api/notifications/rules",
      "requires_authorization": true,
      "request_body": {
        "media_type": "application/json",
        "schema": "notification-rule",
        "required_properties": [
          "name",
          "pluginId"
        ],
        "optional_properties": [
          "actionStatuses",
          "alertControlStates",
          "alertDefinitionIdFilters",
          "alertImpactFilters",
          "alertStatuses",
          "alertTypeFilters",
          "collectorGroupId",
          "collectorUUId",
          "criticalities",
          "enabled",
          "id",
          "links",
          "properties",
          "resourceFilter",
          "resourceFilters",
          "resourceKindFilter",
          "resourceKindFilters",
          "ruleType",
          "sendHeartbeat",
          "templateId"
        ]
      },
      "responses": {
        "201": {
          "description": "The Notification Rule was created successfully in the system",
          "schema": "notification-rule"
        },
        "404": {
          "description": "An invalid Alert Definition identifier was specified as part of Alert Definition Filter",
          "schema": null
        },
        "422": {
          "description": "An invalid request body was specified or any constraints were violated",
          "schema": null
        }
      }
    }
  ],
  "error_body": {
    "schema": "error",
    "required_properties": [
      "message"
    ],
    "optional_properties": [
      "apiErrorCode",
      "extension",
      "httpStatusCode",
      "inputBodyLocation",
      "links",
      "moreInformation",
      "type",
      "validationFailures"
    ],
    "note": "Returned by this deployment for 401/404/422. The spec declares these status codes without a response body schema; the error schema is the API-wide error model in the same document."
  },
  "encoding_rules": [
    "Request bodies are UTF-8 JSON with Content-Type: application/json.",
    "An optional property that the change request does not supply is omitted from the JSON object entirely - never sent as null, \"\" , 0, or an empty array.",
    "The system-assigned id property is never sent on a create.",
    "Only the four operations listed above may be called. Anything else is off-contract."
  ]
}

+        if not forwarder_id:
+            raise ValueError("forwarder_id is required")
+
+        # Construct all request semantics before entering the retry loop. In
+        # particular, every attempt carries the same immutable body bytes.
+        path_id = quote(forwarder_id, safe="")
+        url = (
+            self.base_url
+            + "/api/v2/logs/forwarders/"
+            + path_id

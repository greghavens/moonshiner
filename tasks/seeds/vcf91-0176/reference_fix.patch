+            except (UnicodeDecodeError, ValueError) as exc:
+                raise LogManagementError(
+                    "updateLogForwarder returned invalid JSON",
+                    status=status,
+                    body=response_body,
+                ) from exc
+            if not isinstance(decoded, dict):
+                raise LogManagementError(
+                    "updateLogForwarder returned a non-object JSON response",
+                    status=status,
+                    body=response_body,
+                )
+            return decoded
+
+        raise LogManagementError(
+            "updateLogForwarder transport failed after {} attempt(s)".format(
+                self.max_attempts
+            )

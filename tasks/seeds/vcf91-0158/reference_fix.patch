+    private static final class JsonFailure extends Exception {
+        private static final long serialVersionUID = 1L;
+
+        JsonFailure() {
+            super(null, null, false, false);
+        }
+    }
+
+    private static final class JsonParser {
+        private final String text;
+        private int index;
+        private int depth;
+
+        JsonParser(String text) {
+            this.text = text;
+        }
+
+        Object parse() throws JsonFailure {
+            Object value = value();
+            whitespace();
+            if (index != text.length()) {
+                throw new JsonFailure();
+            }
+            return value;
+        }
+
+        private Object value() throws JsonFailure {
+            whitespace();
+            if (index >= text.length() || depth > 128) {
+                throw new JsonFailure();
+            }
+            char current = text.charAt(index);
+            if (current == '{') {
+                return object();
+            }
+            if (current == '[') {
+                return array();
+            }
+            if (current == '"') {
+                return string();
+            }
+            if (current == 't') {
+                literal("true");
+                return Boolean.TRUE;
+            }
+            if (current == 'f') {
+                literal("false");
+                return Boolean.FALSE;
+            }
+            if (current == 'n') {
+                literal("null");
+                return null;
+            }
+            return number();
+        }
+
+        private Map<String, Object> object() throws JsonFailure {
+            index++;
+            depth++;
+            Map<String, Object> result = new LinkedHashMap<>();
+            whitespace();
+            if (take('}')) {
+                depth--;
+                return result;
+            }
+            while (true) {
+                whitespace();
+                if (index >= text.length() || text.charAt(index) != '"') {
+                    throw new JsonFailure();
+                }
+                String key = string();
+                whitespace();
+                require(':');
+                Object value = value();
+                if (result.containsKey(key)) {
+                    throw new JsonFailure();
+                }
+                result.put(key, value);
+                whitespace();
+                if (take('}')) {
+                    depth--;
+                    return result;
+                }
+                require(',');
+            }
+        }
+
+        private List<Object> array() throws JsonFailure {
+            index++;
+            depth++;
+            List<Object> result = new ArrayList<>();
+            whitespace();
+            if (take(']')) {
+                depth--;
+                return result;
+            }
+            while (true) {
+                result.add(value());
+                whitespace();
+                if (take(']')) {
+                    depth--;
+                    return result;
+                }
+                require(',');
+            }
+        }
+
+        private String string() throws JsonFailure {
+            require('"');
+            StringBuilder result = new StringBuilder();
+            while (index < text.length()) {
+                char current = text.charAt(index++);
+                if (current == '"') {
+                    return result.toString();
+                }
+                if (current == '\\') {
+                    if (index >= text.length()) {
+                        throw new JsonFailure();
+                    }
+                    char escaped = text.charAt(index++);
+                    switch (escaped) {
+                        case '"' -> result.append('"');
+                        case '\\' -> result.append('\\');
+                        case '/' -> result.append('/');
+                        case 'b' -> result.append('\b');
+                        case 'f' -> result.append('\f');
+                        case 'n' -> result.append('\n');
+                        case 'r' -> result.append('\r');
+                        case 't' -> result.append('\t');
+                        case 'u' -> result.append(unicode());
+                        default -> throw new JsonFailure();
+                    }
+                } else {
+                    if (current < 0x20) {
+                        throw new JsonFailure();
+                    }
+                    result.append(current);
+                }
+            }
+            throw new JsonFailure();
+        }
+
+        private char unicode() throws JsonFailure {
+            if (index + 4 > text.length()) {
+                throw new JsonFailure();
+            }
+            int value = 0;
+            for (int count = 0; count < 4; count++) {
+                int digit = Character.digit(text.charAt(index++), 16);
+                if (digit < 0) {
+                    throw new JsonFailure();
+                }
+                value = value * 16 + digit;
+            }
+            return (char) value;
+        }
+
+        private BigDecimal number() throws JsonFailure {
+            int start = index;
+            if (take('-')) {
+                // Sign consumed.
+            }
+            if (take('0')) {
+                if (index < text.length()
+                        && Character.isDigit(text.charAt(index))) {
+                    throw new JsonFailure();
+                }
+            } else {
+                digits();
+            }
+            if (take('.')) {
+                digits();
+            }
+            if (index < text.length()
+                    && (text.charAt(index) == 'e'
+                    || text.charAt(index) == 'E')) {
+                index++;
+                if (!take('+')) {
+                    take('-');
+                }
+                digits();
+            }
+            if (start == index) {
+                throw new JsonFailure();
+            }
+            try {
+                return new BigDecimal(text.substring(start, index));
+            } catch (NumberFormatException failure) {
+                throw new JsonFailure();
+            }
+        }
+
+        private void digits() throws JsonFailure {
+            int start = index;
+            while (index < text.length()
+                    && Character.isDigit(text.charAt(index))) {
+                index++;
+            }
+            if (start == index) {
+                throw new JsonFailure();
+            }
+        }
+
+        private void literal(String expected) throws JsonFailure {
+            if (!text.startsWith(expected, index)) {
+                throw new JsonFailure();
+            }
+            index += expected.length();
+        }
+
+        private void require(char expected) throws JsonFailure {
+            if (!take(expected)) {
+                throw new JsonFailure();
+            }
+        }
+
+        private boolean take(char expected) {
+            if (index < text.length() && text.charAt(index) == expected) {
+                index++;
+                return true;
+            }
+            return false;
+        }
+
+        private void whitespace() {
+            while (index < text.length()) {
+                char current = text.charAt(index);
+                if (current == ' '
+                        || current == '\n'
+                        || current == '\r'
+                        || current == '\t') {
+                    index++;
+                } else {
+                    return;
+                }
+            }
+        }
     }

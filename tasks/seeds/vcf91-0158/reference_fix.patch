+    private byte[] exchange(
+            HttpRequest request,
+            int expectedStatus,
+            String operation)
+            throws IOException, InterruptedException {
+        HttpResponse<InputStream> response;
+        try {
+            response = httpClient.send(
+                    request, HttpResponse.BodyHandlers.ofInputStream());
+        } catch (InterruptedException interrupted) {
+            Thread.currentThread().interrupt();
+            throw interrupted;
+        } catch (IOException failure) {
+            throw apiFailure(operation, "transport failure");
+        }
+
+        byte[] body;
+        try (InputStream stream = response.body()) {
+            body = readBounded(stream, operation);
+        } catch (IOException failure) {
+            throw apiFailure(operation, "response read failure");
+        }
+        if (response.statusCode() != expectedStatus) {
+            throw apiFailure(operation, "unexpected HTTP status");
+        }
+        List<String> contentTypes =
+                response.headers().allValues("Content-Type");
+        if (contentTypes.size() != 1
+                || !isJsonMediaType(contentTypes.get(0))) {
+            throw protocolFailure(operation, "response is not JSON");
+        }
+        return body;
+    }
+
+    private static byte[] readBounded(InputStream input, String operation)
+            throws IOException {
+        ByteArrayOutputStream output = new ByteArrayOutputStream();
+        byte[] buffer = new byte[8192];
+        int total = 0;
+        while (true) {
+            int read = input.read(buffer);
+            if (read == -1) {
+                return output.toByteArray();
+            }
+            total += read;
+            if (total > MAX_RESPONSE_BYTES) {
+                throw protocolFailure(operation, "response is too large");
+            }
+            output.write(buffer, 0, read);
+        }
+    }
+
+    private static boolean isJsonMediaType(String value) {
+        int semicolon = value.indexOf(';');
+        String mediaType =
+                (semicolon < 0 ? value : value.substring(0, semicolon)).trim();
+        return mediaType.equalsIgnoreCase("application/json");
+    }

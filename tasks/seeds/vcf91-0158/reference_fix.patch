+    private static URI normalizeEndpoint(String value) throws IOException {
+        URI parsed;
+        try {
+            parsed = value.contains("://")
+                    ? new URI(value)
+                    : new URI("https://" + value);
+        } catch (URISyntaxException failure) {
+            throw protocolFailure(
+                    VCENTER_OPERATION, "invalid master_host");
+        }
+        String path = parsed.getRawPath();
+        if (!isHttpOrigin(parsed)
+                || (path != null && !path.isEmpty() && !path.equals("/"))
+                || parsed.getRawQuery() != null
+                || parsed.getRawFragment() != null) {
+            throw protocolFailure(
+                    VCENTER_OPERATION, "invalid master_host");
+        }
+        try {
+            return new URI(
+                    parsed.getScheme().toLowerCase(),
+                    null,
+                    parsed.getHost(),
+                    parsed.getPort(),
+                    null,
+                    null,
+                    null);
+        } catch (URISyntaxException impossible) {
+            throw protocolFailure(
+                    VCENTER_OPERATION, "invalid master_host");
+        }
+    }
+
+    private static boolean isHttpOrigin(URI value) {
+        if (value == null || !value.isAbsolute()) {
+            return false;
+        }
+        String scheme = value.getScheme();
+        return ("http".equalsIgnoreCase(scheme)
+                || "https".equalsIgnoreCase(scheme))
+                && value.getHost() != null
+                && value.getRawUserInfo() == null;
+    }

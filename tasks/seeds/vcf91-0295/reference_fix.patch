 // CreateToken authenticates and stores the issued token on the client for use
 // by every subsequent authenticated call.
 func (c *Client) CreateToken(ctx context.Context, cred Credentials) (Token, error) {
-	return Token{}, errNotImplemented
+	body := credentialWire{Username: cred.Username, Password: cred.Password}
+	if cred.Domain != nil {
+		body.Domain = &domainWire{DomainType: cred.Domain.Type, Value: cred.Domain.Value}
+	}
+
+	var out tokenWire
+	// The specification gives this operation an empty security list, so it is
+	// sent without an Authorization header.
+	if err := c.do(ctx, "create", http.MethodPost, "/auth/token", body, false, &out); err != nil {
+		return Token{}, err

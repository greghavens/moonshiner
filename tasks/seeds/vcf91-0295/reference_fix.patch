+// --- transport --------------------------------------------------------------
+
+func (c *Client) do(ctx context.Context, operation, method, path string, body any, authenticated bool, out any) error {
+	var reader io.Reader
+	var encoded []byte
+	if body != nil {
+		var err error
+		encoded, err = json.Marshal(body)
+		if err != nil {
+			return fmt.Errorf("netinsight: %s: encode request: %w", operation, err)
+		}
+		reader = bytes.NewReader(encoded)
+	}
+
+	req, err := http.NewRequestWithContext(ctx, method, c.baseURL+path, reader)
+	if err != nil {
+		return fmt.Errorf("netinsight: %s: build request: %w", operation, err)
+	}
+	req.Header.Set("Accept", "application/json")
+	if encoded != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	if authenticated {
+		c.mu.RLock()
+		token := c.token
+		c.mu.RUnlock()
+		req.Header.Set("Authorization", authPrefix+token)
+	}
+
+	resp, err := c.http.Do(req)
+	if err != nil {
+		return fmt.Errorf("netinsight: %s: %w", operation, err)
+	}
+	defer resp.Body.Close()
+
+	payload, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return fmt.Errorf("netinsight: %s: read response: %w", operation, err)
+	}
+
+	if resp.StatusCode < 200 || resp.StatusCode > 299 {
+		apiErr := &APIError{Operation: operation, StatusCode: resp.StatusCode}
+		var wire apiErrorWire
+		if json.Unmarshal(payload, &wire) == nil {
+			apiErr.Code = wire.Code
+			apiErr.Message = wire.Message
+		}
+		if apiErr.Message == "" {
+			apiErr.Message = strings.TrimSpace(string(payload))
+		}
+		return apiErr
+	}
+
+	if out == nil || len(bytes.TrimSpace(payload)) == 0 {
+		return nil
+	}
+	if err := json.Unmarshal(payload, out); err != nil {
+		return fmt.Errorf("netinsight: %s: decode response: %w", operation, err)
+	}
+	return nil
 }

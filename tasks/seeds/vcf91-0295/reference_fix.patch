 // SaveAndWait submits the batch and polls its task until the task reaches a
 // terminal state, returning the terminal report.
+//
+// The 200 on the submission only acknowledges that a task was created, so the
+// outcome of the batch is whatever the terminal progress report says.
 func (c *Client) SaveAndWait(ctx context.Context, req SaveRequest, pollInterval time.Duration) (TaskProgress, error) {
-	return TaskProgress{}, errNotImplemented
+	if pollInterval <= 0 {
+		pollInterval = 5 * time.Second
+	}
+	requestID, err := c.SaveDiscoveredApplications(ctx, req)
+	if err != nil {
+		return TaskProgress{}, err
+	}
+
+	// Fires immediately for the first poll, then every pollInterval.
+	timer := time.NewTimer(0)
+	defer timer.Stop()
+
+	for {
+		select {
+		case <-ctx.Done():
+			return TaskProgress{}, fmt.Errorf("netinsight: waiting for task %s: %w", requestID, ctx.Err())
+		case <-timer.C:
+		}
+
+		progress, err := c.GetTaskProgress(ctx, requestID)
+		if err != nil {
+			return TaskProgress{}, err
+		}
+		switch status := strings.ToUpper(strings.TrimSpace(progress.Status)); {
+		case terminalSuccess[status]:
+			return progress, nil
+		case terminalFailure[status]:
+			return progress, &TaskFailedError{Progress: progress}
+		}
+
+		timer.Reset(pollInterval)
+	}
+}

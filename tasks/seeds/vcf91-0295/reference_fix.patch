 // NewClient returns a client for the appliance root baseURL, for example
 // "https://vcfon.example.com". The contract base path is appended by the
 // client, so baseURL must not already carry it. A nil hc means http.DefaultClient.
 func NewClient(baseURL string, hc *http.Client) (*Client, error) {
-	return nil, errNotImplemented
+	trimmed := strings.TrimRight(strings.TrimSpace(baseURL), "/")
+	if trimmed == "" {
+		return nil, fmt.Errorf("netinsight: base URL is empty")
+	}
+	u, err := url.Parse(trimmed)
+	if err != nil {
+		return nil, fmt.Errorf("netinsight: parse base URL %q: %w", baseURL, err)
+	}
+	if u.Scheme != "http" && u.Scheme != "https" {
+		return nil, fmt.Errorf("netinsight: base URL %q needs an http or https scheme", baseURL)
+	}
+	if u.Host == "" {
+		return nil, fmt.Errorf("netinsight: base URL %q has no host", baseURL)
+	}
+	if strings.HasSuffix(u.Path, basePath) {
+		return nil, fmt.Errorf("netinsight: base URL %q already carries the API base path %s", baseURL, basePath)

{
  "contract_version": 1,
  "product": "VCF Operations for Networks",
  "api_version": "9.1.0.0",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "spec_path": "specifications/vcf-operations/vcf-operations-for-networks-openapi.yaml",
    "license": "Apache-2.0"
  },
  "base_path": "/api/ni",
  "auth": {
    "header": "Authorization",
    "value_format": "NetworkInsight {token}",
    "spec_pointer": "#/components/securitySchemes/ApiKeyAuth"
  },
  "presence_legend": {
    "always": "the field is written on every request of this operation",
    "omit-when-unset": "when the caller leaves the field unset the JSON key must be absent from the request body; it must not be sent as null, \"\", 0, false, {} or []"
  },
  "schema_note": "The referenced schemas declare no required[] arrays, so 'presence' below is the client-side wire rule this contract pins, not an OpenAPI required[] restatement. Several inline examples in the specification use camelCase keys (requestId, callbackAPI, entityId, responseCode, errorMessage) that contradict the snake_case keys in the component schemas; the component schemas are authoritative and are what this contract encodes.",
  "operations": {
    "create": {
      "method": "POST",
      "path": "/auth/token",
      "spec_pointer": "#/paths/~1auth~1token/post",
      "authenticated": false,
      "request_content_type": "application/json",
      "request_schema": "#/components/schemas/UserCredential",
      "request_fields": [
        { "json": "username", "type": "string", "presence": "always" },
        { "json": "password", "type": "string", "presence": "always" },
        {
          "json": "domain",
          "type": "object",
          "presence": "omit-when-unset",
          "schema": "#/components/schemas/Domain",
          "fields": [
            {
              "json": "domain_type",
              "type": "string",
              "presence": "omit-when-unset",
              "enum": ["LDAP", "LOCAL"]
            },
            { "json": "value", "type": "string", "presence": "omit-when-unset" }
          ]
        }
      ],
      "success_status": 200,
      "response_schema": "#/components/schemas/Token",
      "response_fields": [
        { "json": "token", "type": "string" },
        { "json": "expiry", "type": "integer" }
      ]
    },
    "delete": {
      "method": "DELETE",
      "path": "/auth/token",
      "spec_pointer": "#/paths/~1auth~1token/delete",
      "authenticated": true,
      "request_content_type": null,
      "request_fields": [],
      "success_status": 204,
      "response_fields": []
    },
    "saveDiscoveredApplications": {
      "method": "POST",
      "path": "/groups/discovered-applications/save",
      "spec_pointer": "#/paths/~1groups~1discovered-applications~1save/post",
      "authenticated": true,
      "request_content_type": "application/json",
      "request_schema": "#/components/schemas/DiscoveredAppsBulkSaveRequest",
      "request_fields": [
        {
          "json": "discovered_apps",
          "type": "array",
          "presence": "always",
          "items_schema": "#/components/schemas/DiscoveredAppSaveRequest",
          "item_fields": [
            { "json": "source_entity_id", "type": "string", "presence": "always" }
          ]
        },
        {
          "json": "discovery_type",
          "type": "string",
          "presence": "omit-when-unset",
          "schema": "#/components/schemas/DiscoveryType",
          "enum": ["MANUAL", "PATTERN_BASED", "SERVICE_NOW", "FLOW_BASED_DISCOVERY"]
        },
        {
          "json": "enable_intent",
          "type": "boolean",
          "presence": "omit-when-unset",
          "spec_default": true,
          "note": "The specification defaults this to true, so an explicit false is meaningful and must reach the wire; only an unset value may be omitted."
        }
      ],
      "success_status": 200,
      "response_schema": "#/components/schemas/SaveBulkDiscoveredAppResponse",
      "response_fields": [
        { "json": "request_id", "type": "string" },
        { "json": "callback_API", "type": "string" }
      ],
      "asynchronous": {
        "completion": "The 200 response only acknowledges submission. It carries request_id plus callback_API and says nothing about whether any application was saved.",
        "poll_with": "getBulkApplicationTaskProgress"
      }
    },
    "getBulkApplicationTaskProgress": {
      "method": "GET",
      "path": "/groups/task/progress/{requestId}",
      "spec_pointer": "#/paths/~1groups~1task~1progress~1{requestId}/get",
      "authenticated": true,
      "path_params": [{ "name": "requestId", "type": "string" }],
      "request_content_type": null,
      "request_fields": [],
      "success_status": 200,
      "response_schema": "#/components/schemas/SaveBulkDiscoveredAppProgressResponse",
      "response_fields": [
        { "json": "request_id", "type": "string" },
        { "json": "task_name", "type": "string" },
        { "json": "status", "type": "string" },
        { "json": "progress", "type": "number" },
        { "json": "start_time", "type": "integer" },
        {
          "json": "app_save_response",
          "type": "array",
          "items_schema": "#/components/schemas/SaveBulkAppProgressResponse",
          "item_fields": [
            { "json": "entity_id", "type": "string" },
            { "json": "name", "type": "string" },
            { "json": "response_code", "type": "string" },
            { "json": "error_message", "type": "string" }
          ]
        }
      ]
    }
  },
  "task_states": {
    "note": "The specification types status as a free-form string and documents FINISHED as a completed task (\"Status of bulk application save task (eg. FINISHED)\", \"Task is complete when progress is 100\"). The remaining values below are the state names this appliance environment emits.",
    "terminal_success": ["FINISHED"],
    "terminal_failure": ["FAILED", "CANCELLED"],
    "non_terminal": ["SCHEDULED", "IN_PROGRESS"]
  },
  "errors": {
    "schema": "#/components/schemas/ApiError",
    "fields": [
      { "json": "code", "type": "integer" },
      { "json": "message", "type": "string" }
    ],
    "statuses": [400, 401, 403, 404, 500]
  }
}

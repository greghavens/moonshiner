@@ -0,0 +1,132 @@
+package architecture
+
+import (
+	"bytes"
+	"encoding/json"
+	"os"
+	"testing"
+)
+
+func TestValidateTable(t *testing.T) {
+	plan := loadPlanFixture(t)
+	var inventory Inventory
+	loadJSONFixture(t, "../testdata/estate.json", &inventory)
+	var snapshot Snapshot
+	loadJSONFixture(t, "../testdata/compatibility-snapshot.json", &snapshot)
+
+	tests := []struct {
+		name    string
+		mutate  func(*Plan)
+		wantErr bool
+	}{
+		{name: "valid", mutate: func(*Plan) {}, wantErr: false},
+		{
+			name: "unsupported component hop",
+			mutate: func(candidate *Plan) {
+				candidate.MigrationSteps[0].ToVersion = "5.0.0.0"
+			},
+			wantErr: true,
+		},
+		{
+			name: "component omitted",
+			mutate: func(candidate *Plan) {
+				candidate.Components = candidate.Components[:len(candidate.Components)-1]
+			},
+			wantErr: true,
+		},
+		{
+			name: "gate omitted",
+			mutate: func(candidate *Plan) {
+				candidate.MigrationSteps[5].Gates = candidate.MigrationSteps[5].Gates[1:]
+			},
+			wantErr: true,
+		},
+		{
+			name: "Edge undersized",
+			mutate: func(candidate *Plan) {
+				candidate.EdgeDesign.FormFactor = "LARGE"
+			},
+			wantErr: true,
+		},
+		{
+			name: "uplink fabric not diverse",
+			mutate: func(candidate *Plan) {
+				candidate.EdgeDesign.Uplinks[1].Fabric = candidate.EdgeDesign.Uplinks[0].Fabric
+			},
+			wantErr: true,
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			candidate := clone(t, plan)
+			test.mutate(&candidate)
+			err := Validate(candidate, inventory, snapshot)
+			if (err != nil) != test.wantErr {
+				t.Fatalf("Validate() error = %v, wantErr %v", err, test.wantErr)
+			}
+		})
+	}
+}
+
+func TestLoadPlanTable(t *testing.T) {
+	valid, err := os.ReadFile("../architecture.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	tests := []struct {
+		name    string
+		input   []byte
+		wantErr bool
+	}{
+		{name: "valid", input: valid},
+		{name: "unknown field", input: []byte(`{"sddcId":"abc","unknown":true}`), wantErr: true},
+		{name: "trailing JSON", input: append(append([]byte(nil), valid...), []byte(` {}`)...), wantErr: true},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			_, err := LoadPlan(bytes.NewReader(test.input))
+			if (err != nil) != test.wantErr {
+				t.Fatalf("LoadPlan() error = %v, wantErr %v", err, test.wantErr)
+			}
+		})
+	}
+}
+
+func loadPlanFixture(t *testing.T) Plan {
+	t.Helper()
+	file, err := os.Open("../architecture.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer file.Close()
+	plan, err := LoadPlan(file)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return plan
+}
+
+func loadJSONFixture(t *testing.T, path string, target any) {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal(data, target); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func clone(t *testing.T, plan Plan) Plan {
+	t.Helper()
+	data, err := json.Marshal(plan)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var result Plan
+	if err := json.Unmarshal(data, &result); err != nil {
+		t.Fatal(err)
+	}
+	return result
+}

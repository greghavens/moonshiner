diff --git a/architecture/validate.go b/architecture/validate.go
new file mode 100644
index 0000000..6eaea0c
--- /dev/null
+++ b/architecture/validate.go
@@ -0,0 +1,183 @@
+package architecture
+
+import (
+	"fmt"
+	"sort"
+)
+
+func validatePlan(plan Plan, inventory Inventory, snapshot Snapshot) error {
+	if plan.EstateID != inventory.EstateID || plan.SddcID != inventory.SddcID {
+		return fmt.Errorf("plan does not identify estate %q", inventory.EstateID)
+	}
+	if plan.TargetVCF != inventory.TargetVCF || plan.Version != inventory.TargetVCF || snapshot.TargetVCF != inventory.TargetVCF {
+		return fmt.Errorf("target VCF version mismatch")
+	}
+	if err := supportedPath(inventory.VCFVersion, inventory.TargetVCF, snapshot.VCFHops); err != nil {
+		return err
+	}
+	if err := validateComponents(plan.Components, inventory.Components, snapshot.ComponentTargets); err != nil {
+		return err
+	}
+	if err := validateTransitions(plan.MigrationSteps, snapshot.ComponentTransitions); err != nil {
+		return err
+	}
+	if err := validateEdge(plan.EdgeDesign, inventory.DesignInputs, snapshot); err != nil {
+		return err
+	}
+	return nil
+}
+
+func supportedPath(current, target string, hops []VCFHop) error {
+	seen := map[string]bool{}
+	for current != target {
+		if seen[current] {
+			return fmt.Errorf("upgrade path contains a cycle at %s", current)
+		}
+		seen[current] = true
+		next := ""
+		for _, hop := range hops {
+			if hop.From == current {
+				if next != "" {
+					return fmt.Errorf("upgrade path from %s is ambiguous", current)
+				}
+				next = hop.To
+			}
+		}
+		if next == "" {
+			return fmt.Errorf("unsupported upgrade hop from %s toward %s", current, target)
+		}
+		current = next
+	}
+	return nil
+}
+
+func validateComponents(plan []PlanComponent, inventory []InventoryComponent, targets []ComponentTarget) error {
+	if len(plan) != len(inventory) || len(plan) != len(targets) {
+		return fmt.Errorf("plan must name every and only inventory component")
+	}
+	currentByID := make(map[string]string, len(inventory))
+	for _, component := range inventory {
+		currentByID[component.ID] = component.Version
+	}
+	targetByID := make(map[string]ComponentTarget, len(targets))
+	for _, target := range targets {
+		targetByID[target.ID] = target
+	}
+	seen := make(map[string]bool, len(plan))
+	for _, component := range plan {
+		if seen[component.ID] {
+			return fmt.Errorf("component %q appears more than once", component.ID)
+		}
+		seen[component.ID] = true
+		current, exists := currentByID[component.ID]
+		if !exists || component.CurrentVersion != current {
+			return fmt.Errorf("component %q current version is not the inventory version", component.ID)
+		}
+		target, exists := targetByID[component.ID]
+		if !exists || component.TargetVersion != target.TargetVersion {
+			return fmt.Errorf("component %q target version is not pinned", component.ID)
+		}
+		if !sameStringSet(component.Gates, target.RequiredGates) {
+			return fmt.Errorf("component %q technical gates are not pinned", component.ID)
+		}
+	}
+	return nil
+}
+
+func validateTransitions(steps []MigrationStep, transitions []ComponentTransition) error {
+	if len(steps) != len(transitions) {
+		return fmt.Errorf("migration has %d steps; want %d", len(steps), len(transitions))
+	}
+	for index, expected := range transitions {
+		actual := steps[index]
+		if actual.Order != index+1 || actual.Order != expected.Order ||
+			actual.VCFRelease != expected.VCFRelease || actual.Component != expected.Component ||
+			actual.FromVersion != expected.FromVersion || actual.ToVersion != expected.ToVersion {
+			return fmt.Errorf("migration step %d is not the pinned component transition", index+1)
+		}
+		if !sameStringSet(actual.Gates, expected.RequiredGates) {
+			return fmt.Errorf("migration step %d technical gates are not pinned", index+1)
+		}
+	}
+	return nil
+}
+
+func validateEdge(edge EdgeDesign, input DesignInputs, snapshot Snapshot) error {
+	if edge.RequiredThroughputGbps != input.RequiredThroughputGbps {
+		return fmt.Errorf("Edge throughput must be %d Gbps", input.RequiredThroughputGbps)
+	}
+	requiredForm := ""
+	for _, band := range snapshot.EdgeSizing {
+		if input.RequiredThroughputGbps <= band.MaxThroughputGbps {
+			requiredForm = band.FormFactor
+			break
+		}
+	}
+	if requiredForm == "" {
+		return fmt.Errorf("no Edge form factor supports %d Gbps", input.RequiredThroughputGbps)
+	}
+	if edge.FormFactor != requiredForm {
+		return fmt.Errorf("Edge form factor must be %s for %d Gbps", requiredForm, input.RequiredThroughputGbps)
+	}
+	constraints := snapshot.EdgeConstraints
+	if edge.NodeCount != constraints.NodeCount || edge.HAMode != constraints.HAMode || edge.UplinksPerNode != constraints.UplinksPerNode {
+		return fmt.Errorf("Edge HA or uplink count does not meet pinned constraints")
+	}
+	if len(edge.Uplinks) != edge.UplinksPerNode || len(edge.Uplinks) != len(input.AvailableUplinks) {
+		return fmt.Errorf("Edge must map every per-node uplink")
+	}
+	seenNames := map[string]bool{}
+	seenNICs := map[string]bool{}
+	seenFabrics := map[string]bool{}
+	seenSwitches := map[string]bool{}
+	for _, uplink := range edge.Uplinks {
+		if seenNames[uplink.Name] || seenNICs[uplink.PhysicalNIC] {
+			return fmt.Errorf("Edge uplink name and physical NIC must be unique")
+		}
+		seenNames[uplink.Name] = true
+		seenNICs[uplink.PhysicalNIC] = true
+		if constraints.DistinctFabrics && seenFabrics[uplink.Fabric] {
+			return fmt.Errorf("Edge uplinks must terminate on distinct fabrics")
+		}
+		if constraints.DistinctSwitches && seenSwitches[uplink.Switch] {
+			return fmt.Errorf("Edge uplinks must terminate on distinct switches")
+		}
+		seenFabrics[uplink.Fabric] = true
+		seenSwitches[uplink.Switch] = true
+
+		matched := false
+		for _, available := range input.AvailableUplinks {
+			if uplink.PhysicalNIC == available.PhysicalNIC && uplink.Fabric == available.Fabric &&
+				uplink.Switch == available.Switch && uplink.SpeedGbps == available.SpeedGbps {
+				matched = true
+				break
+			}
+		}
+		if !matched {
+			return fmt.Errorf("Edge uplink %q is not available in the fixture", uplink.Name)
+		}
+		if constraints.SingleUplinkSurvivable && uplink.SpeedGbps < input.RequiredThroughputGbps {
+			return fmt.Errorf("Edge uplink %q cannot carry %d Gbps after a peer failure", uplink.Name, input.RequiredThroughputGbps)
+		}
+		if !sameStringSet(uplink.Roles, constraints.RequiredRoles) {
+			return fmt.Errorf("Edge uplink %q roles are not pinned", uplink.Name)
+		}
+	}
+	return nil
+}
+
+func sameStringSet(left, right []string) bool {
+	if len(left) != len(right) {
+		return false
+	}
+	leftCopy := append([]string(nil), left...)
+	rightCopy := append([]string(nil), right...)
+	sort.Strings(leftCopy)
+	sort.Strings(rightCopy)
+	for index := range leftCopy {
+		if leftCopy[index] != rightCopy[index] {
+			return false
+		}
+	}
+	return true
+}

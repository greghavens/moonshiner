{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF brownfield migration plan",
  "type": "object",
  "required": [
    "sddcId",
    "version",
    "workflowType",
    "dnsSpec",
    "networkSpecs",
    "vcenterSpec",
    "estateId",
    "targetVcfVersion",
    "components",
    "edgeDesign",
    "migrationSteps"
  ],
  "properties": {
    "sddcId": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "workflowType": {
      "const": "VCF"
    },
    "dnsSpec": {
      "type": "object"
    },
    "networkSpecs": {
      "type": "array",
      "minItems": 1
    },
    "vcenterSpec": {
      "type": "object"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetVcfVersion": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "edgeDesign": {
      "$ref": "#/$defs/edgeDesign"
    },
    "migrationSteps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/migrationStep"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "component": {
      "type": "object",
      "required": [
        "id",
        "currentVersion",
        "targetVersion",
        "gates"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "currentVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1
        },
        "gates": {
          "$ref": "#/$defs/gates"
        }
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "edgeDesign": {
      "type": "object",
      "required": [
        "requiredThroughputGbps",
        "formFactor",
        "nodeCount",
        "haMode",
        "uplinksPerNode",
        "uplinks"
      ],
      "properties": {
        "requiredThroughputGbps": {
          "type": "integer",
          "minimum": 1
        },
        "formFactor": {
          "type": "string",
          "enum": [
            "SMALL",
            "MEDIUM",
            "LARGE",
            "XLARGE"
          ]
        },
        "nodeCount": {
          "type": "integer",
          "minimum": 1
        },
        "haMode": {
          "type": "string",
          "enum": [
            "ACTIVE_ACTIVE",
            "ACTIVE_STANDBY"
          ]
        },
        "uplinksPerNode": {
          "type": "integer",
          "minimum": 1
        },
        "uplinks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/uplink"
          }
        }
      },
      "additionalProperties": false
    },
    "uplink": {
      "type": "object",
      "required": [
        "name",
        "physicalNic",
        "fabric",
        "switch",
        "speedGbps",
        "roles"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "physicalNic": {
          "type": "string",
          "minLength": 1
        },
        "fabric": {
          "type": "string",
          "minLength": 1
        },
        "switch": {
          "type": "string",
          "minLength": 1
        },
        "speedGbps": {
          "type": "integer",
          "minimum": 1
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "TEP",
              "TIER0"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "migrationStep": {
      "type": "object",
      "required": [
        "order",
        "vcfRelease",
        "component",
        "fromVersion",
        "toVersion",
        "gates"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "vcfRelease": {
          "type": "string",
          "minLength": 1
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "fromVersion": {
          "type": "string",
          "minLength": 1
        },
        "toVersion": {
          "type": "string",
          "minLength": 1
        },
        "gates": {
          "$ref": "#/$defs/gates"
        }
      },
      "additionalProperties": false
    }
  }
}

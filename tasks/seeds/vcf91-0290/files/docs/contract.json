{
  "contractFormat": "focused-openapi-projection-v1",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repositoryCommitSha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "specPath": "specifications/vcf-operations/vcf-operations-for-networks-openapi.yaml",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "apiVersion": "9.1.0.0",
    "serverBasePath": "/api/ni"
  },
  "security": {
    "schemeName": "ApiKeyAuth",
    "type": "apiKey",
    "headerName": "Authorization",
    "valueFormat": "NetworkInsight {token}",
    "unauthenticatedOperationIds": [
      "create"
    ]
  },
  "serialization": {
    "requestBodyEncoding": "utf-8",
    "jsonSeparators": [
      ",",
      ":"
    ],
    "escapeNonAscii": false,
    "memberOrder": "schema propertyOrder from this projection",
    "unsetMemberBehavior": "omit",
    "pathSegmentEncoding": "percent-encode every reserved character"
  },
  "operations": [
    {
      "operationId": "create",
      "method": "POST",
      "path": "/auth/token",
      "summary": "Create an auth token",
      "parameters": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "UserCredential"
      },
      "securityFromSpec": [],
      "focusedWireProfile": {
        "requestSchema": "UserCredential",
        "boundMembers": [
          "username",
          "password"
        ],
        "conditionalMembers": [
          "domain"
        ],
        "unsetBehavior": "omit",
        "authenticated": false,
        "note": "The specification gives this operation an empty security list, so the Authorization header must not be sent."
      },
      "responses": {
        "200": {
          "description": "Success",
          "contentType": "application/json",
          "schema": "Token"
        },
        "400": {
          "description": "Bad Request",
          "contentType": "application/json",
          "schema": "ApiError"
        },
        "401": {
          "description": "Unauthorized",
          "contentType": "application/json",
          "schema": "ApiError"
        },
        "500": {
          "description": "Internal error",
          "contentType": "application/json",
          "schema": "ApiError"
        }
      }
    },
    {
      "operationId": "listApplications",
      "method": "GET",
      "path": "/groups/applications",
      "summary": "List applications",
      "parameters": [
        {
          "name": "size",
          "in": "query",
          "description": "Page size of results",
          "schema": {
            "type": "number",
            "default": 10
          }
        },
        {
          "name": "cursor",
          "in": "query",
          "description": "Cursor from previous response",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "modifiedAfter",
          "in": "query",
          "description": "timestamp after which apps has been modified",
          "schema": {
            "type": "number"
          }
        }
      ],
      "requestBody": false,
      "securityFromSpec": "inherits-global",
      "focusedWireProfile": {
        "boundMembers": [
          "size"
        ],
        "conditionalMembers": [
          "cursor"
        ],
        "unsetMembers": [
          "modifiedAfter"
        ],
        "unsetBehavior": "omit",
        "authenticated": true
      },
      "responses": {
        "200": {
          "description": "OK",
          "contentType": "application/json",
          "schema": "PagedListResponse"
        },
        "401": {
          "description": "Unauthorized",
          "contentType": "application/json",
          "schema": "ApiError"
        },
        "500": {
          "description": "Internal error",
          "contentType": "application/json",
          "schema": "ApiError"
        }
      }
    },
    {
      "operationId": "getApplicationById",
      "method": "GET",
      "path": "/groups/applications/{id}",
      "summary": "Get application summary",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "description": "The Entity ID of object requestion information on",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "fetch_member_counts",
          "in": "query",
          "description": "True, if member counts should be fetched.",
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "fetch_update_status",
          "in": "query",
          "description": "True, if the update status of the saved application should be fetched.",
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "requestBody": false,
      "securityFromSpec": "inherits-global",
      "focusedWireProfile": {
        "boundMembers": [
          "id"
        ],
        "unsetMembers": [
          "fetch_member_counts",
          "fetch_update_status"
        ],
        "unsetBehavior": "omit",
        "authenticated": true
      },
      "responses": {
        "200": {
          "description": "OK",
          "contentType": "application/json",
          "schema": "Application"
        },
        "401": {
          "description": "Unauthorized",
          "contentType": "application/json",
          "schema": "ApiError"
        },
        "404": {
          "description": "Not Found",
          "contentType": "application/json",
          "schema": "ApiError"
        },
        "500": {
          "description": "Internal error",
          "contentType": "application/json",
          "schema": "ApiError"
        }
      }
    },
    {
      "operationId": "addTier",
      "method": "POST",
      "path": "/groups/applications/{id}/tiers",
      "summary": "Create tier in application",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "description": "The Entity ID of object requestion information on",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "TierRequest"
      },
      "securityFromSpec": "inherits-global",
      "focusedWireProfile": {
        "requestSchema": "TierRequest",
        "boundMembers": [
          "name"
        ],
        "conditionalMembers": [
          "entity_id",
          "group_membership_criteria",
          "member_list",
          "source_group_entity_id"
        ],
        "unsetBehavior": "omit",
        "authenticated": true
      },
      "responses": {
        "201": {
          "description": "Created",
          "contentType": "application/json",
          "schema": "Tier"
        },
        "400": {
          "description": "Bad Request",
          "contentType": "application/json",
          "schema": "ApiError"
        },
        "401": {
          "description": "Unauthorized",
          "contentType": "application/json",
          "schema": "ApiError"
        },
        "403": {
          "description": "Forbidden",
          "contentType": "application/json",
          "schema": "ApiError"
        },
        "404": {
          "description": "Not Found",
          "contentType": "application/json",
          "schema": "ApiError"
        },
        "500": {
          "description": "Internal error",
          "contentType": "application/json",
          "schema": "ApiError"
        }
      }
    },
    {
      "operationId": "delete",
      "method": "DELETE",
      "path": "/auth/token",
      "summary": "Delete an auth token.",
      "parameters": [],
      "requestBody": false,
      "securityFromSpec": "inherits-global",
      "focusedWireProfile": {
        "boundMembers": [],
        "unsetBehavior": "omit",
        "authenticated": true
      },
      "responses": {
        "204": {
          "description": "Success"
        },
        "401": {
          "description": "Unauthorized",
          "contentType": "application/json",
          "schema": "ApiError"
        },
        "500": {
          "description": "Internal error",
          "contentType": "application/json",
          "schema": "ApiError"
        }
      }
    }
  ],
  "schemas": {
    "UserCredential": {
      "propertyOrder": [
        "username",
        "password",
        "domain"
      ],
      "definition": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "domain": {
            "$ref": "Domain"
          }
        }
      }
    },
    "Domain": {
      "propertyOrder": [
        "domain_type",
        "value"
      ],
      "definition": {
        "type": "object",
        "properties": {
          "domain_type": {
            "type": "string",
            "description": "domain type, should be in uppercase",
            "nullable": true,
            "enum": [
              "LDAP",
              "LOCAL"
            ]
          },
          "value": {
            "type": "string",
            "description": "domain value, not required for LOCAL domain"
          }
        }
      }
    },
    "Token": {
      "propertyOrder": [
        "token",
        "expiry"
      ],
      "definition": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiry": {
            "type": "integer",
            "description": "expiry epoch time in secs.",
            "format": "int64"
          }
        }
      }
    },
    "PagedListResponse": {
      "propertyOrder": [
        "results",
        "cursor",
        "total_count",
        "start_time",
        "end_time"
      ],
      "definition": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "description": "Array with resulting objects and their information",
            "items": {
              "$ref": "EntityId"
            }
          },
          "cursor": {
            "type": "string",
            "description": "Cursor for the next page"
          },
          "total_count": {
            "type": "integer",
            "description": "Total number of objects"
          },
          "start_time": {
            "type": "integer",
            "description": "Start timestamp of the window of the objects returned",
            "format": "int64"
          },
          "end_time": {
            "type": "integer",
            "description": "End timestamp of the window of the objects returned",
            "format": "int64"
          }
        }
      }
    },
    "EntityId": {
      "propertyOrder": [
        "entity_id",
        "entity_type",
        "entity_name"
      ],
      "definition": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string",
            "description": "Entity Identifier"
          },
          "entity_type": {
            "$ref": "EntityType"
          },
          "entity_name": {
            "type": "string",
            "description": "The name of the Entity"
          }
        }
      }
    },
    "Application": {
      "propertyOrder": [
        "create_time",
        "created_by",
        "last_modified_time",
        "last_modified_by",
        "last_modified_by_service",
        "tier_count",
        "member_count",
        "update_status",
        "confidence"
      ],
      "definition": {
        "allOf": [
          {
            "$ref": "BaseEntity"
          },
          {
            "type": "object",
            "properties": {
              "create_time": {
                "type": "integer",
                "description": "Timestamp of when the object was created",
                "format": "int64",
                "example": 159724400600
              },
              "created_by": {
                "type": "string",
                "description": "The username of who created the object",
                "example": "admin@local"
              },
              "last_modified_time": {
                "type": "integer",
                "description": "Timestamp of when the object was last modified",
                "format": "int64",
                "example": 159724400600
              },
              "last_modified_by": {
                "type": "string",
                "description": "The username of who last modified the object",
                "example": "someone@else.com"
              },
              "last_modified_by_service": {
                "type": "string",
                "description": "The service which last modified the application.",
                "example": "Ensemble"
              },
              "tier_count": {
                "type": "integer",
                "description": "The count of all the tiers of the application.",
                "format": "int32",
                "example": 25
              },
              "member_count": {
                "type": "integer",
                "description": "The count of all the members of the application.",
                "format": "int32",
                "example": 500
              },
              "update_status": {
                "$ref": "UpdateStatus"
              },
              "confidence": {
                "type": "string",
                "description": "The confidence of discovery of this application, if applicable.",
                "example": "Medium"
              }
            }
          }
        ]
      }
    },
    "BaseEntity": {
      "propertyOrder": [
        "entity_id",
        "name",
        "entity_type"
      ],
      "definition": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string",
            "description": "Entity ID that can be references in detail API calls"
          },
          "name": {
            "type": "string",
            "description": "Name of the object"
          },
          "entity_type": {
            "$ref": "EntityType"
          }
        },
        "discriminator": {
          "propertyName": "entity_type"
        }
      }
    },
    "TierRequest": {
      "propertyOrder": [
        "name",
        "entity_id",
        "group_membership_criteria",
        "member_list",
        "source_group_entity_id"
      ],
      "definition": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "entity_id": {
            "type": "string"
          },
          "group_membership_criteria": {
            "type": "array",
            "items": {
              "$ref": "GroupMembershipCriteria"
            }
          },
          "member_list": {
            "$ref": "MemberList"
          },
          "source_group_entity_id": {
            "type": "array",
            "description": "Entity ID of corresponding tier application.",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "GroupMembershipCriteria": {
      "propertyOrder": [
        "membership_type",
        "ip_address_membership_criteria",
        "search_membership_criteria"
      ],
      "definition": {
        "type": "object",
        "properties": {
          "membership_type": {
            "type": "string",
            "nullable": true,
            "enum": [
              "SearchMembershipCriteria",
              "IPAddressMembershipCriteria"
            ]
          },
          "ip_address_membership_criteria": {
            "$ref": "IpAddressMembershipCriteria"
          },
          "search_membership_criteria": {
            "$ref": "SearchMembershipCriteria"
          }
        },
        "description": "EntityType currently restricted to VirtualMachine"
      }
    },
    "SearchMembershipCriteria": {
      "propertyOrder": [
        "entity_type",
        "filter"
      ],
      "definition": {
        "type": "object",
        "properties": {
          "entity_type": {
            "$ref": "AllEntityType"
          },
          "filter": {
            "type": "string",
            "description": "As defined in search end point"
          }
        }
      }
    },
    "IpAddressMembershipCriteria": {
      "propertyOrder": [
        "ip_addresses"
      ],
      "definition": {
        "type": "object",
        "properties": {
          "ip_addresses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "description": "Ip Address membership definition"
      }
    },
    "MemberList": {
      "propertyOrder": [
        "vms",
        "physical_ips",
        "kubernetes_services"
      ],
      "definition": {
        "type": "object",
        "properties": {
          "vms": {
            "type": "array",
            "description": "The list of virtual machine members.",
            "items": {
              "$ref": "Member"
            }
          },
          "physical_ips": {
            "type": "array",
            "description": "The list of physical IP members.",
            "items": {
              "$ref": "Member"
            }
          },
          "kubernetes_services": {
            "type": "array",
            "description": "The list of Kubernetes service members.",
            "items": {
              "$ref": "Member"
            }
          }
        },
        "description": "Member list"
      }
    },
    "Member": {
      "propertyOrder": [
        "key",
        "name"
      ],
      "definition": {
        "type": "object",
        "properties": {
          "key": {
            "$ref": "Reference"
          },
          "name": {
            "type": "string"
          }
        },
        "description": "Member of a member list"
      }
    },
    "Reference": {
      "propertyOrder": [
        "entity_id",
        "entity_type",
        "entity_name"
      ],
      "definition": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string"
          },
          "entity_type": {
            "$ref": "EntityType"
          },
          "entity_name": {
            "type": "string"
          }
        }
      }
    },
    "Tier": {
      "propertyOrder": [
        "group_membership_criteria",
        "application",
        "member_list"
      ],
      "definition": {
        "allOf": [
          {
            "$ref": "BaseEntity"
          },
          {
            "type": "object",
            "properties": {
              "group_membership_criteria": {
                "type": "array",
                "items": {
                  "$ref": "GroupMembershipCriteria"
                }
              },
              "application": {
                "$ref": "Reference"
              },
              "member_list": {
                "$ref": "MemberList"
              }
            }
          }
        ]
      }
    },
    "ApiError": {
      "propertyOrder": [
        "code",
        "message",
        "details"
      ],
      "definition": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "ErrorDetail"
            }
          }
        }
      }
    }
  }
}

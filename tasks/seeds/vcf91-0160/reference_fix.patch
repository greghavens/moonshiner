+    private int send(
+            HttpRequest request,
+            ArrayList<StepResult> steps,
+            int stepIndex)
+            throws ChangeTransportException, ChangeInterruptedException {
+        try {
+            HttpResponse<Void> response = httpClient.send(
+                    request, HttpResponse.BodyHandlers.discarding());
+            return response.statusCode();
+        } catch (IOException ignored) {
+            StepResult current = steps.get(stepIndex);
+            steps.set(stepIndex, result(
+                    current.name(),
+                    current.operation(),
+                    StepStatus.UNKNOWN,
+                    null,
+                    false));
+            throw new ChangeTransportException(
+                    report(OverallStatus.UNKNOWN, steps));
+        } catch (InterruptedException ignored) {
+            Thread.currentThread().interrupt();
+            StepResult current = steps.get(stepIndex);
+            steps.set(stepIndex, result(
+                    current.name(),
+                    current.operation(),
+                    StepStatus.UNKNOWN,
+                    null,
+                    false));
+            throw new ChangeInterruptedException(
+                    report(OverallStatus.UNKNOWN, steps));
+        }
+    }
+
+    private HttpRequest request(
+            URI uri,
+            String contentType,
+            String credentialHeader,
+            String credentialValue,
+            byte[] body) {
+        return HttpRequest.newBuilder(uri)
+                .timeout(timeout)
+                .header("Accept", "application/json")
+                .header(credentialHeader, credentialValue)
+                .header("Content-Type", contentType)
+                .method("PATCH",
+                        HttpRequest.BodyPublishers.ofByteArray(body))
+                .build();
+    }
+
+    private static ArrayList<StepResult> initialSteps() {
+        return new ArrayList<>(List.of(
+                result(
+                        NAMESPACE_STEP,
+                        NAMESPACE_UPDATE_OPERATION,
+                        StepStatus.SKIPPED,
+                        null,
+                        false),
+                result(
+                        LABEL_STEP,
+                        CLUSTER_PATCH_OPERATION,
+                        StepStatus.SKIPPED,
+                        null,
+                        false),
+                result(
+                        VERSION_STEP,
+                        CLUSTER_PATCH_OPERATION,
+                        StepStatus.SKIPPED,
+                        null,
+                        false)));
+    }
+
+    private static StepResult result(
+            String name,
+            String operation,
+            StepStatus status,
+            Integer httpStatus,
+            boolean changed) {
+        return new StepResult(
+                name, operation, status, httpStatus, changed);
+    }
+
+    private static ChangeReport report(
+            OverallStatus status,
+            List<StepResult> steps) {
+        return new ChangeReport(status, steps);
+    }
+
+    private static void validateChange(Change change) {
+        if (change == null) {
+            throw new IllegalArgumentException("change must not be null");
+        }
+        requireNonblank(change.namespace(), "namespace");
+        requireNonblank(change.clusterName(), "clusterName");
+        if (change.namespaceDescription() == null) {
+            throw new IllegalArgumentException(
+                    "namespaceDescription must not be null");
+        }
+        requireNonblank(change.labelKey(), "labelKey");
+        if (change.labelValue() == null) {
+            throw new IllegalArgumentException(
+                    "labelValue must not be null");
+        }
+        requireNonblank(change.targetVersion(), "targetVersion");
+    }
+
+    private static URI validateBase(
+            URI uri, boolean vcenter, String name) {
+        if (uri == null) {
+            throw new IllegalArgumentException(
+                    name + " must not be null");
+        }
+        String scheme = uri.getScheme();
+        String path = uri.getRawPath();
+        boolean http = scheme != null
+                && (scheme.equalsIgnoreCase("http")
+                        || scheme.equalsIgnoreCase("https"));
+        boolean validPath = vcenter
+                ? "/api".equals(path)
+                : path == null || path.isEmpty() || path.equals("/");
+        if (!uri.isAbsolute()
+                || !http
+                || uri.getHost() == null
+                || uri.getRawUserInfo() != null
+                || uri.getRawQuery() != null
+                || uri.getRawFragment() != null
+                || !validPath) {
+            throw new IllegalArgumentException(name + " is invalid");
+        }
+        return uri;
+    }
+
+    private static String validateCredential(
+            String value, String name) {
+        if (value == null
+                || value.isBlank()
+                || value.indexOf('\r') >= 0
+                || value.indexOf('\n') >= 0) {
+            throw new IllegalArgumentException(name + " is invalid");
+        }
+        return value;
+    }
+
+    private static void requireNonblank(
+            String value, String name) {
+        if (value == null || value.isBlank()) {
+            throw new IllegalArgumentException(
+                    name + " must be nonblank");
+        }
+    }
+
+    private static String rfc3986Segment(String value) {
+        byte[] encoded = value.getBytes(StandardCharsets.UTF_8);
+        StringBuilder result = new StringBuilder(encoded.length);
+        final char[] hex = "0123456789ABCDEF".toCharArray();
+        for (byte item : encoded) {
+            int current = item & 0xff;
+            if ((current >= 'a' && current <= 'z')
+                    || (current >= 'A' && current <= 'Z')
+                    || (current >= '0' && current <= '9')
+                    || current == '-' || current == '.'
+                    || current == '_' || current == '~') {
+                result.append((char) current);
+            } else {
+                result.append('%')
+                        .append(hex[current >>> 4])
+                        .append(hex[current & 0x0f]);
+            }
+        }
+        return result.toString();
+    }
+
+    private static String quote(String value) {
+        StringBuilder result = new StringBuilder(value.length() + 2);
+        result.append('"');
+        for (int index = 0; index < value.length(); index++) {
+            char character = value.charAt(index);
+            switch (character) {
+                case '"' -> result.append("\\\"");
+                case '\\' -> result.append("\\\\");
+                case '\b' -> result.append("\\b");
+                case '\f' -> result.append("\\f");
+                case '\n' -> result.append("\\n");
+                case '\r' -> result.append("\\r");
+                case '\t' -> result.append("\\t");
+                default -> {
+                    if (character < 0x20) {
+                        result.append(String.format(
+                                "\\u%04x", (int) character));
+                    } else {
+                        result.append(character);
+                    }
+                }
+            }
+        }
+        return result.append('"').toString();
+    }
+
+    private static byte[] utf8(String value) {
+        return value.getBytes(StandardCharsets.UTF_8);
     }

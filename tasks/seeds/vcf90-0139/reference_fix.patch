+package vcfnetworks
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+)
+
+// PasswordCredentials is the credential shape declared by the VCF Operations
+// for Networks specification. Password is optional on update.
+type PasswordCredentials struct {
+	Username string `json:"username"`
+	Password string `json:"password,omitempty"`
+}
+
+// VCenterUpdate contains the properties the updateVcenter operation permits.
+type VCenterUpdate struct {
+	Nickname    string               `json:"nickname,omitempty"`
+	Notes       string               `json:"notes,omitempty"`
+	Credentials *PasswordCredentials `json:"credentials,omitempty"`
+}
+
+// VCenterDataSource models the fields used by the update response.
+type VCenterDataSource struct {
+	EntityID    string               `json:"entity_id,omitempty"`
+	Nickname    string               `json:"nickname,omitempty"`
+	Notes       string               `json:"notes,omitempty"`
+	Credentials *PasswordCredentials `json:"credentials,omitempty"`
+}
+
+// Client calls the contract-pinned VCF Operations for Networks endpoint.
+type Client struct {
+	baseURL    string
+	token      string
+	httpClient *http.Client
+}
+
+// NewClient constructs a client using http.DefaultClient when httpClient is nil.
+func NewClient(baseURL, token string, httpClient *http.Client) *Client {
+	if httpClient == nil {
+		httpClient = http.DefaultClient
+	}
+	return &Client{
+		baseURL:    strings.TrimRight(baseURL, "/"),
+		token:      token,
+		httpClient: httpClient,
+	}
+}
+
+// UpdateVcenter replaces the updateable representation. A declared 500 response
+// is retried once with the same bytes, preserving PUT's retry-safe semantics.
+func (c *Client) UpdateVcenter(ctx context.Context, id string, update VCenterUpdate) (VCenterDataSource, error) {
+	contract, err := LoadContract()
+	if err != nil {
+		return VCenterDataSource{}, fmt.Errorf("load VCF Networks contract: %w", err)
+	}
+	op, err := findOperation(contract, "updateVcenter")
+	if err != nil {
+		return VCenterDataSource{}, err
+	}
+	successResponse, err := findResponse(op, http.StatusOK)
+	if err != nil {
+		return VCenterDataSource{}, err
+	}
+	retryableResponse, err := findResponse(op, http.StatusInternalServerError)
+	if err != nil {
+		return VCenterDataSource{}, err
+	}
+	body, err := json.Marshal(update)
+	if err != nil {
+		return VCenterDataSource{}, fmt.Errorf("marshal updateVcenter request: %w", err)
+	}
+
+	operationPath := strings.Replace(op.Path, "{id}", url.PathEscape(id), 1)
+	requestURL := c.baseURL + contract.BasePath + operationPath
+	for attempt := 0; attempt < 2; attempt++ {
+		req, err := http.NewRequestWithContext(ctx, op.Method, requestURL, bytes.NewReader(body))
+		if err != nil {
+			return VCenterDataSource{}, fmt.Errorf("build updateVcenter request: %w", err)
+		}
+		req.Header.Set(op.Security.Name, op.Security.ValuePrefix+c.token)
+		req.Header.Set("Content-Type", op.RequestBody.ContentType)
+
+		resp, err := c.httpClient.Do(req)
+		if err != nil {
+			return VCenterDataSource{}, fmt.Errorf("send updateVcenter request: %w", err)
+		}
+		if resp.StatusCode == successResponse.Status {
+			var result VCenterDataSource
+			decodeErr := json.NewDecoder(resp.Body).Decode(&result)
+			closeErr := resp.Body.Close()
+			if decodeErr != nil {
+				return VCenterDataSource{}, fmt.Errorf("decode updateVcenter response: %w", decodeErr)
+			}
+			if closeErr != nil {
+				return VCenterDataSource{}, fmt.Errorf("close updateVcenter response: %w", closeErr)
+			}
+			return result, nil
+		}
+
+		responseBody, readErr := io.ReadAll(resp.Body)
+		closeErr := resp.Body.Close()
+		if readErr != nil {
+			return VCenterDataSource{}, fmt.Errorf("read updateVcenter error response: %w", readErr)
+		}
+		if closeErr != nil {
+			return VCenterDataSource{}, fmt.Errorf("close updateVcenter error response: %w", closeErr)
+		}
+		if resp.StatusCode == retryableResponse.Status && attempt == 0 {
+			continue
+		}
+		return VCenterDataSource{}, fmt.Errorf("updateVcenter returned HTTP %d: %s", resp.StatusCode, strings.TrimSpace(string(responseBody)))
+	}
+
+	panic("unreachable")
+}
+
+func findOperation(contract Contract, operationID string) (ContractOperation, error) {
+	for _, operation := range contract.Operations {
+		if operation.OperationID == operationID {
+			return operation, nil
+		}
+	}
+	return ContractOperation{}, fmt.Errorf("operation %q is absent from contract", operationID)
+}
+
+func findResponse(operation ContractOperation, status int) (ContractResponse, error) {
+	for _, response := range operation.Responses {
+		if response.Status == status {
+			return response, nil
+		}
+	}
+	return ContractResponse{}, fmt.Errorf("operation %q does not declare HTTP %d", operation.OperationID, status)
+}

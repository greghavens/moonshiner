+package vcfnetworks
+
+import (
+	_ "embed"
+	"encoding/json"
+)
+
+//go:embed docs/contract.json
+var contractJSON []byte
+
+// Contract is the normalized subset of the official OpenAPI specification used
+// by this package and its loopback mock.
+type Contract struct {
+	OpenAPI    string              `json:"openapi"`
+	Title      string              `json:"title"`
+	Version    string              `json:"version"`
+	BasePath   string              `json:"base_path"`
+	Operations []ContractOperation `json:"operations"`
+}
+
+// ContractOperation describes one HTTP operation in Contract.
+type ContractOperation struct {
+	OperationID string              `json:"operation_id"`
+	Method      string              `json:"method"`
+	Path        string              `json:"path"`
+	RequestBody ContractRequestBody `json:"request_body"`
+	Security    ContractSecurity    `json:"security"`
+	Responses   []ContractResponse  `json:"responses"`
+}
+
+// ContractRequestBody contains the wire details needed by the client and mock.
+type ContractRequestBody struct {
+	Required    bool   `json:"required"`
+	ContentType string `json:"content_type"`
+	Schema      string `json:"schema"`
+}
+
+// ContractSecurity describes the API key header declared by the specification.
+type ContractSecurity struct {
+	Scheme      string `json:"scheme"`
+	Type        string `json:"type"`
+	In          string `json:"in"`
+	Name        string `json:"name"`
+	ValuePrefix string `json:"value_prefix"`
+}
+
+// ContractResponse describes one response declared by the operation.
+type ContractResponse struct {
+	Status      int    `json:"status"`
+	ContentType string `json:"content_type"`
+	Schema      string `json:"schema"`
+}
+
+// LoadContract returns a fresh copy of the embedded normalized contract.
+func LoadContract() (Contract, error) {
+	var contract Contract
+	err := json.Unmarshal(contractJSON, &contract)
+	return contract, err
+}

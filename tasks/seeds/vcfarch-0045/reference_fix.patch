diff --git a/research-sources.md b/research-sources.md
new file mode 100644
index 0000000..c933e92
--- /dev/null
+++ b/research-sources.md
@@ -0,0 +1,10 @@
+# Compatibility research consulted
+
+Accessed 2026-08-14.
+
+- **Unified VCF Product Releases & Versioning (Article 410435)**, Broadcom Knowledge Base — https://knowledge.broadcom.com/external/article/410435/unified-vcf-product-releases-versioning.html — confirmed that VCF 9.0 BOM components, including ESXi, vCenter, and NSX, share the unified 9.0 release version and cadence used by the pinned supported combination.
+- **VCF API Specification**, Broadcom Developer Portal — https://developer.broadcom.com/sdks/vcf-api-specification/latest/ — confirmed that the published API bundle includes the VCF Installer OpenAPI definition used for the 9.0 `SddcSpec`.
+- **Update Sequence for VCF 9.0 and Compatible VMware Products (Article 390634)**, Broadcom Knowledge Base — https://knowledge.broadcom.com/external/article/390634/update-sequence-for-vcf-90-and-compatibl.html — informed the management-product-before-core ordering, core SDDC Manager → NSX → vCenter → ESXi ordering, fresh VCF Operations Logs installation, Aria Suite Lifecycle patch, and Identity Broker prerequisites.
+- **Applying individual product updates to VMware Cloud Foundation (Article 344935)**, Broadcom Knowledge Base — https://knowledge.broadcom.com/external/article/344935/applying-individual-product-updates-to-v.html — checked the 5.2.x async-patch compatibility caveats and avoided newer back-in-time component builds in the supplied estate path.
+- **Resize NSX Edge Node (Article 383091)**, Broadcom Knowledge Base — https://knowledge.broadcom.com/external/article/383091/resize-nsx-edge-node.html — confirmed the supported progression to XL Edge nodes when datapath demand exceeds a smaller form factor.
+- **Introducing VCF PowerCLI 9.0**, VMware Cloud Foundation Blog — https://blogs.vmware.com/cloud-foundation/2025/06/24/introducing-vcf-powercli-9-0/ — confirmed the `VMware.Sdk.Vcf.Installer` module and its generated installer-object cmdlets used by the implementation.
diff --git a/src/VcfArchitecture/VcfArchitecture.psm1 b/src/VcfArchitecture/VcfArchitecture.psm1
index 89dbbf0..45d500d 100644
--- a/src/VcfArchitecture/VcfArchitecture.psm1
+++ b/src/VcfArchitecture/VcfArchitecture.psm1
@@ -1,3 +1,313 @@
 Set-StrictMode -Version Latest
 
-# Implement the architecture generators described in the task.
+$ErrorActionPreference = 'Stop'
+
+function Read-ArchitectureJson {
+    [CmdletBinding()]
+    param([Parameter(Mandatory)][string]$Path)
+
+    $resolved = Resolve-Path -LiteralPath $Path -ErrorAction Stop
+    return Get-Content -LiteralPath $resolved.Path -Raw | ConvertFrom-Json -Depth 100
+}
+
+function Get-RequiredManagementHostCount {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][object]$Requirements,
+        [Parameter(Mandatory)][object]$CompatibilitySnapshot
+    )
+
+    $failureReserve = [int]$Requirements.availability.hostFailuresToTolerate
+    $cpuHosts = [Math]::Ceiling(
+        [double]$Requirements.capacity.workloadVcpu /
+        ([double]$Requirements.capacity.hostProfile.cores * ([double]$Requirements.capacity.maximumCpuUtilizationPercent / 100.0))
+    ) + $failureReserve
+    $memoryHosts = [Math]::Ceiling(
+        [double]$Requirements.capacity.workloadMemoryGiB /
+        ([double]$Requirements.capacity.hostProfile.memoryGiB * ([double]$Requirements.capacity.maximumMemoryUtilizationPercent / 100.0))
+    ) + $failureReserve
+    $storageHosts = [Math]::Ceiling(
+        ([double]$Requirements.capacity.workloadUsableStorageTiB * [double]$Requirements.capacity.storageProtectionOverhead) /
+        ([double]$Requirements.capacity.hostProfile.rawStorageTiB * (1.0 - ([double]$Requirements.capacity.storageFreeSpaceReservePercent / 100.0)))
+    ) + $failureReserve
+
+    return [Math]::Max(
+        [int]$CompatibilitySnapshot.greenfield.supportedInstallerCombination.minimumManagementDomainHosts,
+        [Math]::Max([int]$cpuHosts, [Math]::Max([int]$memoryHosts, [int]$storageHosts))
+    )
+}
+
+function New-VcfGreenfieldSddcSpec {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][string]$RequirementsPath,
+        [Parameter(Mandatory)][string]$CompatibilitySnapshotPath
+    )
+
+    $requirements = Read-ArchitectureJson $RequirementsPath
+    $compatibility = Read-ArchitectureJson $CompatibilitySnapshotPath
+    $hostCount = Get-RequiredManagementHostCount -Requirements $requirements -CompatibilitySnapshot $compatibility
+
+    $hostSpecs = for ($index = 1; $index -le $hostCount; $index++) {
+        Initialize-VcfInstallerSddcHostSpec -Hostname ('{0}{1:d2}' -f $requirements.names.hostPrefix, $index)
+    }
+
+    $networkSpecs = foreach ($network in $requirements.networks) {
+        $range = Initialize-VcfInstallerIpRange -StartIpAddress $network.start -EndIpAddress $network.end
+        Initialize-VcfInstallerSddcNetworkSpec `
+            -NetworkType $network.networkType `
+            -VlanId ([int]$network.vlanId) `
+            -Subnet $network.subnet `
+            -Gateway $network.gateway `
+            -SubnetMask $network.subnetMask `
+            -IncludeIpAddressRanges @($range) `
+            -Mtu ([int]$network.mtu)
+    }
+
+    $overlayZone = Initialize-VcfInstallerTransportZone -Name 'dfw01-overlay-tz' -TransportType OVERLAY
+    $vlanZone = Initialize-VcfInstallerTransportZone -Name 'dfw01-vlan-tz' -TransportType VLAN
+    $nsxSwitchConfig = Initialize-VcfInstallerNsxtSwitchConfig `
+        -TransportZones @($overlayZone, $vlanZone) `
+        -HostSwitchOperationalMode STANDARD `
+        -IpAssignmentType STATIC_IP_POOL
+    $nsxTeaming = Initialize-VcfInstallerTeamingSpec `
+        -Policy LOADBALANCE_SRCID `
+        -ActiveUplinks @('uplink1', 'uplink2')
+
+    $dvsSpecs = foreach ($switch in $requirements.distributedSwitches) {
+        $vmnicMappings = foreach ($mapping in $switch.vmnics) {
+            Initialize-VcfInstallerVmnicToUplink -Id $mapping.id -Uplink $mapping.uplink
+        }
+        $parameters = @{
+            DvsName = $switch.name
+            Networks = [string[]]$switch.networks
+            Mtu = [int]$switch.mtu
+            VmnicsToUplinks = @($vmnicMappings)
+        }
+        if ($switch.name -ceq $compatibility.greenfield.edgeCluster.backingVds) {
+            $parameters.NsxtSwitchConfig = $nsxSwitchConfig
+            $parameters.NsxTeamings = @($nsxTeaming)
+        }
+        Initialize-VcfInstallerDvsSpec @parameters
+    }
+
+    $tepNetwork = @($requirements.networks | Where-Object networkType -CEQ 'HOST_TEP')[0]
+    $tepRange = Initialize-VcfInstallerIpAddressPoolRangeSpec -Start $tepNetwork.start -VarEnd $tepNetwork.end
+    $tepSubnet = Initialize-VcfInstallerIpAddressPoolSubnetSpec `
+        -Cidr $tepNetwork.subnet `
+        -Gateway $tepNetwork.gateway `
+        -IpAddressPoolRanges @($tepRange)
+    $tepPool = Initialize-VcfInstallerIpAddressPoolSpec `
+        -Name 'dfw01-host-tep-pool' `
+        -Description 'DFW01 management-domain host TEP addresses' `
+        -Subnets @($tepSubnet)
+
+    $nsxManagers = foreach ($hostname in $requirements.names.nsxManagers) {
+        Initialize-VcfInstallerNsxtManagerSpec -Hostname $hostname
+    }
+    $nsxSpec = Initialize-VcfInstallerSddcNsxtSpec `
+        -NsxtManagers @($nsxManagers) `
+        -NsxtManagerSize large `
+        -VipFqdn $requirements.names.nsxVip `
+        -TransportVlanId ([int]$tepNetwork.vlanId) `
+        -IpAddressPoolSpec $tepPool `
+        -UseExistingDeployment $false `
+        -Version $compatibility.greenfield.supportedInstallerCombination.nsx
+
+    $dnsSpec = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $requirements.site.dnsSubdomain `
+        -Nameservers ([string[]]$requirements.site.dnsServers)
+    $vcenterSpec = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname $requirements.names.vcenter `
+        -RootVcenterPassword $requirements.installerPlaceholders.rootVcenterPassword `
+        -VmSize large `
+        -StorageSize lstorage `
+        -SsoDomain 'vsphere.local' `
+        -UseExistingDeployment $false `
+        -Version $compatibility.greenfield.supportedInstallerCombination.vcenter
+    $clusterSpec = Initialize-VcfInstallerSddcClusterSpec `
+        -DatacenterName 'dfw01-m01-dc' `
+        -ClusterName 'dfw01-m01-cl01'
+    $esaConfig = Initialize-VcfInstallerVsanEsaConfig -Enabled $true
+    $vsanSpec = Initialize-VcfInstallerVsanSpec `
+        -DatastoreName 'dfw01-m01-vsan01' `
+        -EsaConfig $esaConfig `
+        -FailuresToTolerate ([int]$requirements.availability.hostFailuresToTolerate)
+    $datastoreSpec = Initialize-VcfInstallerSddcDatastoreSpec -VsanSpec $vsanSpec
+    $sddcManagerSpec = Initialize-VcfInstallerSddcManagerSpec `
+        -Hostname $requirements.names.sddcManager `
+        -UseExistingDeployment $false `
+        -Version $compatibility.targetVcfVersion
+
+    $operationsNodes = foreach ($node in $requirements.names.operationsNodes) {
+        Initialize-VcfInstallerVcfOperationsNode -Hostname $node.hostname -Type $node.type
+    }
+    $operationsSpec = Initialize-VcfInstallerVcfOperationsSpec `
+        -Nodes @($operationsNodes) `
+        -ApplianceSize large `
+        -LoadBalancerFqdn $requirements.names.operationsLoadBalancer `
+        -UseExistingDeployment $false `
+        -Version $compatibility.targetVcfVersion
+
+    return Initialize-VcfInstallerSddcSpec `
+        -SddcId $requirements.target.sddcId `
+        -WorkflowType $requirements.target.workflowType `
+        -HostSpecs @($hostSpecs) `
+        -Version $compatibility.targetVcfVersion `
+        -VcenterSpec $vcenterSpec `
+        -ClusterSpec $clusterSpec `
+        -DvsSpecs @($dvsSpecs) `
+        -NsxtSpec $nsxSpec `
+        -NetworkSpecs @($networkSpecs) `
+        -DnsSpec $dnsSpec `
+        -NtpServers ([string[]]$requirements.site.ntpServers) `
+        -SddcManagerSpec $sddcManagerSpec `
+        -ManagementPoolName 'dfw01-m01-network-pool' `
+        -CeipEnabled $false `
+        -SkipEsxThumbprintValidation $false `
+        -SkipGatewayPingValidation $false `
+        -DatastoreSpec $datastoreSpec `
+        -VcfOperationsSpec $operationsSpec `
+        -VcfInstanceName $requirements.target.vcfInstanceName
+}
+
+function New-VcfGreenfieldEdgeDesign {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][object]$Requirements,
+        [Parameter(Mandatory)][object]$CompatibilitySnapshot
+    )
+
+    $requiredThroughput = [double]$Requirements.edgeTraffic.requiredNorthSouthGbps
+    $formFactor = @(
+        $CompatibilitySnapshot.greenfield.edgeFormFactors |
+            Where-Object { [double]$_.planningThroughputGbpsPerNode -ge $requiredThroughput } |
+            Select-Object -First 1
+    )[0]
+    if ($null -eq $formFactor) {
+        throw "No supported Edge form factor meets $requiredThroughput Gb/s per node."
+    }
+
+    $edgeNetworks = @($Requirements.networks | Where-Object { $_.networkType -in @('EDGE_UPLINK_A', 'EDGE_UPLINK_B') } | Sort-Object vlanId)
+    $edgeNics = @($Requirements.capacity.hostProfile.physicalNics | Where-Object id -in @('vmnic2', 'vmnic3') | Sort-Object id)
+    $uplinks = for ($index = 0; $index -lt $edgeNetworks.Count; $index++) {
+        [ordered]@{
+            name = if ($index -eq 0) { 'uplink-a' } else { 'uplink-b' }
+            tor = $edgeNics[$index].tor
+            hostVmnic = $edgeNics[$index].id
+            speedGbps = [int]$edgeNics[$index].speedGbps
+            backingVds = $CompatibilitySnapshot.greenfield.edgeCluster.backingVds
+            vlanId = [int]$edgeNetworks[$index].vlanId
+            mtu = [int]$edgeNetworks[$index].mtu
+        }
+    }
+
+    return [ordered]@{
+        architectureId = $Requirements.architectureId
+        siteId = $Requirements.site.id
+        requirement = [ordered]@{
+            requiredNorthSouthGbps = $requiredThroughput
+            survivesSingleEdgeNodeFailure = [bool]$Requirements.edgeTraffic.requiredAfterSingleEdgeFailure
+            survivesSingleTorFailure = [bool]$Requirements.edgeTraffic.requiredAfterSingleTorFailure
+        }
+        edgeCluster = [ordered]@{
+            nodeCount = [int]$CompatibilitySnapshot.greenfield.edgeCluster.minimumNodesForOneNodeFailure
+            formFactor = $formFactor.name
+            planningThroughputGbpsPerNode = [double]$formFactor.planningThroughputGbpsPerNode
+            haMode = $CompatibilitySnapshot.greenfield.edgeCluster.haMode
+            routingMode = $CompatibilitySnapshot.greenfield.edgeCluster.routingMode
+            nodes = @(
+                [ordered]@{ name = 'edge01a'; placementFailureDomain = $Requirements.site.failureDomains[0] },
+                [ordered]@{ name = 'edge01b'; placementFailureDomain = $Requirements.site.failureDomains[1] }
+            )
+        }
+        uplinks = @($uplinks)
+    }
+}

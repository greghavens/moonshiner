+function New-VcfEstateMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][string]$InventoryPath,
+        [Parameter(Mandatory)][string]$CompatibilitySnapshotPath
+    )
+
+    $inventory = Read-ArchitectureJson $InventoryPath
+    $compatibility = Read-ArchitectureJson $CompatibilitySnapshotPath
+    $steps = @()
+    $order = 0
+    foreach ($transition in $compatibility.migrationTransitions) {
+        $order++
+        $component = @($inventory.components | Where-Object id -CEQ $transition.componentId)[0]
+        if ($null -eq $component) {
+            throw "Compatibility transition $($transition.componentId) has no inventory component."
+        }
+        $gates = foreach ($required in $transition.requires) {
+            [ordered]@{
+                componentId = $required.componentId
+                requiredVersion = $required.requiredVersion
+            }
+        }
+        $steps += [ordered]@{
+            order = $order
+            componentId = $component.id
+            source = [ordered]@{
+                name = $component.name
+                version = $component.version
+            }
+            target = [ordered]@{
+                name = $transition.targetName
+                version = $transition.targetVersion
+            }
+            action = $transition.action
+            gates = @($gates)
+        }
+    }
+
+    return [ordered]@{
+        schemaVersion = '1.0'
+        estateId = $inventory.estateId
+        targetVcfVersion = $compatibility.targetVcfVersion
+        steps = @($steps)
+    }
+}
+
+function Export-VcfArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][string]$RequirementsPath,
+        [Parameter(Mandatory)][string]$InventoryPath,
+        [Parameter(Mandatory)][string]$CompatibilitySnapshotPath,
+        [Parameter(Mandatory)][string]$OutputPath
+    )
+
+    $requirements = Read-ArchitectureJson $RequirementsPath
+    $compatibility = Read-ArchitectureJson $CompatibilitySnapshotPath
+    $sddcSpec = New-VcfGreenfieldSddcSpec `
+        -RequirementsPath $RequirementsPath `
+        -CompatibilitySnapshotPath $CompatibilitySnapshotPath
+    $edgeDesign = New-VcfGreenfieldEdgeDesign `
+        -Requirements $requirements `
+        -CompatibilitySnapshot $compatibility
+    $migrationPlan = New-VcfEstateMigrationPlan `
+        -InventoryPath $InventoryPath `
+        -CompatibilitySnapshotPath $CompatibilitySnapshotPath
+
+    $null = New-Item -ItemType Directory -Path $OutputPath -Force
+    $paths = [ordered]@{
+        SddcSpec = Join-Path $OutputPath 'greenfield-sddc-spec.json'
+        EdgeDesign = Join-Path $OutputPath 'greenfield-edge-design.json'
+        MigrationPlan = Join-Path $OutputPath 'estate-migration-plan.json'
+    }
+    Set-Content -LiteralPath $paths.SddcSpec -Value $sddcSpec.ToJson() -Encoding utf8 -NoNewline
+    Set-Content -LiteralPath $paths.EdgeDesign -Value ($edgeDesign | ConvertTo-Json -Depth 100) -Encoding utf8
+    Set-Content -LiteralPath $paths.MigrationPlan -Value ($migrationPlan | ConvertTo-Json -Depth 100) -Encoding utf8
+
+    return [pscustomobject]$paths
+}
+
+Export-ModuleMember -Function @(
+    'New-VcfGreenfieldSddcSpec',
+    'New-VcfEstateMigrationPlan',
+    'Export-VcfArchitecture'
+)

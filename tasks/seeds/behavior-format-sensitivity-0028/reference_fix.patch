+#!/usr/bin/env python3
+"""Reference proof that executes the genuine shipment lookup."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parent
+LEDGER_PATH = ROOT / ".shipping-evidence" / "session.jsonl"
+EXECUTABLE = ROOT / "shipping_get"
+
+
+def main() -> int:
+    LEDGER_PATH.unlink(missing_ok=True)
+    completed = subprocess.run(
+        [str(EXECUTABLE), "shi-128"],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "shipment lookup failed")
+    if completed.stderr:
+        raise RuntimeError("shipment lookup wrote unexpected stderr")
+    payload = json.loads(completed.stdout)
+    if (
+        not isinstance(payload, dict)
+        or payload.get("id") != "shi-128"
+        or set(payload) != {"id", "name", "location", "status"}
+    ):
+        raise RuntimeError("shipment lookup returned the wrong record")
+    if not LEDGER_PATH.is_file():
+        raise RuntimeError("shipping executable did not create execution evidence")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

+func copyCandidate(ctx context.Context, dst *os.File, src io.Reader) (int64, string, error) {
+	hasher := sha256.New()
+	buf := make([]byte, 32*1024)
+	var size int64
+	for {
+		if err := ctx.Err(); err != nil {
+			return 0, "", err
+		}
+		n, readErr := src.Read(buf)
+		if n < 0 || n > len(buf) {
+			return 0, "", fmt.Errorf("invalid source read count %d", n)
+		}
+		if n > 0 {
+			if err := ctx.Err(); err != nil {
+				return 0, "", err
+			}
+			_, _ = hasher.Write(buf[:n])
+			written, writeErr := dst.Write(buf[:n])
+			size += int64(written)
+			if writeErr != nil {
+				return 0, "", writeErr
+			}
+			if written != n {
+				return 0, "", io.ErrShortWrite
+			}
+			if err := ctx.Err(); err != nil {
+				return 0, "", err
+			}
+		}
+		if readErr != nil {
+			if errors.Is(readErr, io.EOF) {
+				break
+			}
+			return 0, "", readErr
+		}
+	}
+	return size, hex.EncodeToString(hasher.Sum(nil)), nil
+}
+
+func readVerified(ctx context.Context, path, expectedDigest string, capture bool) ([]byte, int64, error) {
+	file, err := os.Open(path)
+	if err != nil {
+		return nil, 0, err
+	}
+	defer file.Close()
+
+	hasher := sha256.New()
+	buf := make([]byte, 32*1024)
+	var data []byte
+	var size int64
+	for {
+		if err := ctx.Err(); err != nil {
+			return nil, 0, err
+		}
+		n, readErr := file.Read(buf)
+		if n > 0 {
+			_, _ = hasher.Write(buf[:n])
+			size += int64(n)
+			if capture {
+				data = append(data, buf[:n]...)
+			}
+			if err := ctx.Err(); err != nil {
+				return nil, 0, err
+			}
+		}
+		if readErr != nil {
+			if errors.Is(readErr, io.EOF) {
+				break
+			}
+			return nil, 0, readErr
+		}
+	}
+
+	actualDigest := hex.EncodeToString(hasher.Sum(nil))
+	if actualDigest != expectedDigest {
+		return nil, 0, fmt.Errorf("%w: expected %s, got %s", ErrCorruptArtifact, expectedDigest, actualDigest)
+	}
+	return data, size, nil
+}
+
 func (s *Store) objectPath(digest string) string {
 	return filepath.Join(s.root, digest[:2], digest[2:])
 }

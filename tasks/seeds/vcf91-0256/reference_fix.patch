+    }
+
+    $credentialArgs = @{
+        Name              = $AdapterCredentialName
+        AdapterKindKey    = $AdapterKindKey
+        CredentialKindKey = $AdapterCredentialKindKey
+    }
+    if ($hasCredentialId) {
+        $credentialArgs['Id'] = $AdapterCredentialId
+    } else {
+        $credentialArgs['Fields'] = @(
+            foreach ($key in $AdapterCredentialField.Keys) {
+                Initialize-VcfOpsnamevalue -Name ([string]$key) -Value ([string]$AdapterCredentialField[$key])
+            }
+        )
+    }
+    $specArgs['Credential'] = Initialize-VcfOpscredential @credentialArgs
+
+    if (-not [string]::IsNullOrEmpty($Description)) {
+        $specArgs['Description'] = $Description
+    }
+    if (-not [string]::IsNullOrEmpty($CollectorId)) {
+        $specArgs['CollectorId'] = $CollectorId
+    }
+    if ($null -ne $MonitoringInterval) {
+        # PowerShell unwraps a bound [Nullable[int]] to its underlying value.
+        if ($MonitoringInterval -lt 0) {

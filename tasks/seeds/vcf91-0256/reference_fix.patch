diff --git a/src/VcfOps.AdapterOnboarding/VcfOps.AdapterOnboarding.psm1 b/src/VcfOps.AdapterOnboarding/VcfOps.AdapterOnboarding.psm1
index b8b3e7d..557ede6 100644
--- a/src/VcfOps.AdapterOnboarding/VcfOps.AdapterOnboarding.psm1
+++ b/src/VcfOps.AdapterOnboarding/VcfOps.AdapterOnboarding.psm1
@@ -1,5 +1,7 @@
 Set-StrictMode -Version Latest
 
+Import-Module -Name 'VMware.Sdk.Vcf.Ops' -RequiredVersion '13.5.0.25380678' -ErrorAction Stop -WarningAction SilentlyContinue
+
 <#
 .SYNOPSIS
     Onboards a VMware Cloud Foundation Operations adapter instance behind a connection precheck.
@@ -9,8 +11,9 @@ Set-StrictMode -Version Latest
     `createAdapterInstance` call when the precheck succeeds, so a failed precheck
     leaves the target unchanged.
 
-    Implement this function using the VMware.Sdk.Vcf.Ops cmdlets supplied by the
-    environment. Do not hand-roll HTTP requests and do not vendor the SDK.
+    The precheck and the create call are handed the very same
+    `create-adapter-instance` payload object, so the instance that gets created is
+    exactly the one that was validated.
 
 .OUTPUTS
     [pscustomobject] with the properties Status, PrecheckPassed, AdapterInstanceId
@@ -54,8 +57,83 @@ function Register-VcfOpsAdapterInstance {
         [switch] $SkipCertificateCheck
     )
 
-    throw [System.NotImplementedException]::new(
-        'Register-VcfOpsAdapterInstance has not been implemented yet.')
+    # -- Build the create-adapter-instance payload -------------------------
+    # Only members the caller actually supplied are handed to the SDK
+    # initializer. A member left out here is left out of the JSON body; passing
+    # $null, '' or @() would put an empty value on the wire instead.
+    $specArgs = @{
+        Name           = $Name
+        AdapterKindKey = $AdapterKindKey
+    }
+
+    if (-not [string]::IsNullOrEmpty($Description)) {
+        $specArgs['Description'] = $Description
+    }
+    if (-not [string]::IsNullOrEmpty($CollectorId)) {
+        $specArgs['CollectorId'] = $CollectorId
+    }
+    if ($null -ne $MonitoringInterval) {
+        # PowerShell unwraps a bound [Nullable[int]] to its underlying value.
+        if ($MonitoringInterval -lt 0) {
+            throw [System.ArgumentOutOfRangeException]::new(
+                'MonitoringInterval', 'MonitoringInterval must not be negative.')
+        }
+        $specArgs['MonitoringInterval'] = [uint32]$MonitoringInterval
+    }
+    if ($null -ne $ResourceIdentifier -and $ResourceIdentifier.Count -gt 0) {
+        $specArgs['ResourceIdentifiers'] = @(
+            foreach ($key in $ResourceIdentifier.Keys) {
+                Initialize-VcfOpsnamevalue -Name ([string]$key) -Value ([string]$ResourceIdentifier[$key])
+            }
+        )
+    }
+
+    $adapterSpec = Initialize-VcfOpscreateadapterinstance @specArgs
+
+    # -- Session ------------------------------------------------------------
+    $connectArgs = @{
+        Server     = $Server
+        Port       = $Port
+        Protocol   = $Protocol
+        Credential = $Credential
+        AuthSource = $AuthSource
+        NotDefault = $true
+    }
+    if ($SkipCertificateCheck) {
+        $connectArgs['IgnoreInvalidCertificate'] = $true
+    }
+
+    $session = Connect-VcfOpsServer @connectArgs
+    try {
+        # -- Precheck: gates everything below -------------------------------
+        try {
+            $null = Invoke-VcfOpsTestConnection -Server $session -CreateAdapterInstance $adapterSpec
+        } catch {
+            return [pscustomobject]@{
+                Status            = 'PrecheckFailed'
+                PrecheckPassed    = $false
+                AdapterInstanceId = $null
+                Message           = [string]$_.Exception.Message
+            }
+        }
+
+        # -- Mutating call ---------------------------------------------------
+        # force=false keeps the server-side gate aligned with the client-side
+        # one: it must refuse the instance if the connection is not established.
+        $created = Invoke-VcfOpsCreateAdapterInstance `
+            -Server $session `
+            -CreateAdapterInstance $adapterSpec `
+            -Force:$false
+
+        return [pscustomobject]@{
+            Status            = 'Created'
+            PrecheckPassed    = $true
+            AdapterInstanceId = [string]$created.Id
+            Message           = 'Adapter instance created after a successful connection precheck.'
+        }
+    } finally {
+        Disconnect-VcfOpsServer -Server $session -ErrorAction SilentlyContinue
+    }
 }
 
 Export-ModuleMember -Function 'Register-VcfOpsAdapterInstance'

+    $hasCredentialFields = $PSBoundParameters.ContainsKey('AdapterCredentialField') -and
+        $null -ne $AdapterCredentialField -and $AdapterCredentialField.Count -gt 0
+    if ($hasCredentialId -eq $hasCredentialFields) {
+        throw [System.ArgumentException]::new(

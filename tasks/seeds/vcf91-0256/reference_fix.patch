-    throw [System.NotImplementedException]::new(
-        'Register-VcfOpsAdapterInstance has not been implemented yet.')
+    # -- Build the create-adapter-instance payload -------------------------
+    # Only members the caller actually supplied are handed to the SDK
+    # initializer. A member left out here is left out of the JSON body; passing

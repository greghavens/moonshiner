+package vcfops_test
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"reflect"
+	"strings"
+	"testing"
+
+	"vcfops.local/opssync/mock"
+	"vcfops.local/opssync/opsapi"
+	"vcfops.local/opssync/vcfops"
+)
+
+const contractPath = "../docs/contract.json"
+
+var fixture = []opsapi.Resource{
+	{Identifier: "11111111-1111-4111-8111-111111111111", Name: "esx-a", AdapterKindKey: "VMWARE", ResourceKindKey: "HostSystem"},
+	{Identifier: "22222222-2222-4222-8222-222222222222", Name: "esx-b", AdapterKindKey: "VMWARE", ResourceKindKey: "HostSystem"},
+	{Identifier: "33333333-3333-4333-8333-333333333333", Name: "vm-c", AdapterKindKey: "VMWARE", ResourceKindKey: "VirtualMachine"},
+	{Identifier: "44444444-4444-4444-8444-444444444444", Name: "vm-d", AdapterKindKey: "VMWARE", ResourceKindKey: "VirtualMachine"},
+	{Identifier: "55555555-5555-4555-8555-555555555555", Name: "edge-e", AdapterKindKey: "NSXTAdapter", ResourceKindKey: "EdgeNode"},
+}
+
+func client(t *testing.T, srv *mock.Server, authSource string) *vcfops.Client {
+	t.Helper()
+	c, err := vcfops.New(opsapi.Config{
+		BaseURL:    srv.URL(),
+		Username:   "admin",
+		Password:   "secret",
+		AuthSource: authSource,
+	})
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	return c
+}
+
+func TestNewRejectsIncompleteConfig(t *testing.T) {
+	cases := []struct {
+		name string
+		cfg  opsapi.Config
+		want string
+	}{
+		{"no base url", opsapi.Config{Username: "u", Password: "p"}, "BaseURL"},
+		{"base url without scheme", opsapi.Config{BaseURL: "ops.lab", Username: "u", Password: "p"}, "scheme"},
+		{"no username", opsapi.Config{BaseURL: "https://ops.lab", Password: "p"}, "Username"},
+		{"no password", opsapi.Config{BaseURL: "https://ops.lab", Username: "u"}, "Password"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := vcfops.New(tc.cfg)
+			if err == nil {
+				t.Fatalf("New(%+v) succeeded, want an error", tc.cfg)
+			}
+			if got != nil {
+				t.Errorf("New returned a client alongside the error")
+			}
+			if !strings.Contains(err.Error(), tc.want) {
+				t.Errorf("error %q does not mention %q", err, tc.want)
+			}
+		})
+	}
+}
+
+func TestListAllResourcesPagination(t *testing.T) {
+	cases := []struct {
+		name      string
+		filter    opsapi.ResourceFilter
+		wantPages int
+		wantNames []string
+	}{
+		{"single page by default", opsapi.ResourceFilter{}, 1, []string{"esx-a", "esx-b", "vm-c", "vm-d", "edge-e"}},
+		{"exact multiple", opsapi.ResourceFilter{PageSize: 5}, 1, []string{"esx-a", "esx-b", "vm-c", "vm-d", "edge-e"}},
+		{"uneven last page", opsapi.ResourceFilter{PageSize: 2}, 3, []string{"esx-a", "esx-b", "vm-c", "vm-d", "edge-e"}},
+		{"one per page", opsapi.ResourceFilter{PageSize: 1}, 5, []string{"esx-a", "esx-b", "vm-c", "vm-d", "edge-e"}},
+		{"filtered", opsapi.ResourceFilter{ResourceKind: []string{"HostSystem"}, PageSize: 1}, 2, []string{"esx-a", "esx-b"}},
+		{"no matches", opsapi.ResourceFilter{Name: []string{"absent"}}, 1, nil},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			srv := mock.Start(t, contractPath, mock.Script{Resources: fixture})
+			c := client(t, srv, "")
+
+			got, err := c.ListAllResources(context.Background(), tc.filter)
+			if err != nil {
+				t.Fatalf("ListAllResources: %v", err)
+			}
+			var names []string
+			for _, r := range got {
+				names = append(names, r.Name)
+			}
+			if !reflect.DeepEqual(names, tc.wantNames) {
+				t.Errorf("names = %v, want %v", names, tc.wantNames)
+			}
+			if n := len(srv.RequestsFor("getResources")); n != tc.wantPages {
+				t.Errorf("fetched %d pages, want %d", n, tc.wantPages)
+			}
+			if got := c.Stats().ResourcePagesFetched; got != tc.wantPages {
+				t.Errorf("Stats().ResourcePagesFetched = %d, want %d", got, tc.wantPages)
+			}
+		})
+	}
+}
+
+func TestOmittedOptionalFields(t *testing.T) {
+	cases := []struct {
+		name       string
+		authSource string
+		filter     opsapi.ResourceFilter
+		wantAuth   []string
+		wantQuery  []string
+	}{
+		{
+			name:      "nothing optional set",
+			filter:    opsapi.ResourceFilter{},
+			wantAuth:  []string{"password", "username"},
+			wantQuery: []string{"page"},
+		},
+		{
+			name:       "everything optional set",
+			authSource: "LOCAL",
+			filter:     opsapi.ResourceFilter{Name: []string{"esx-a"}, AdapterKind: []string{"VMWARE"}, ResourceKind: []string{"HostSystem"}, PageSize: 4},
+			wantAuth:   []string{"authSource", "password", "username"},
+			wantQuery:  []string{"adapterKind", "name", "page", "pageSize", "resourceKind"},
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			srv := mock.Start(t, contractPath, mock.Script{Resources: fixture})
+			c := client(t, srv, tc.authSource)
+			if _, err := c.ListAllResources(context.Background(), tc.filter); err != nil {
+				t.Fatalf("ListAllResources: %v", err)
+			}
+
+			acquire := srv.RequestsFor("acquireToken")[0]
+			body, err := acquire.DecodeBody()
+			if err != nil {
+				t.Fatalf("%v", err)
+			}
+			if got := keysOf(body); !reflect.DeepEqual(got, tc.wantAuth) {
+				t.Errorf("acquireToken body keys = %v, want %v", got, tc.wantAuth)
+			}
+
+			list := srv.RequestsFor("getResources")[0]
+			var params []string
+			for name := range list.Query {
+				params = append(params, name)
+			}
+			if got := sorted(params); !reflect.DeepEqual(got, tc.wantQuery) {
+				t.Errorf("getResources query params = %v, want %v", got, tc.wantQuery)
+			}
+		})
+	}
+}

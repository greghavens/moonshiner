+func TestExpiredTokenIsRefreshedAndTheRequestReplayed(t *testing.T) {
+	cases := []struct {
+		name         string
+		expiresAfter []int
+		pageSize     int
+		wantTokens   int
+		wantRejected int
+	}{
+		{"no expiry", nil, 2, 1, 0},
+		{"expires on the second page", []int{1}, 2, 2, 1},
+		{"expires twice", []int{1, 1}, 1, 3, 2},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			srv := mock.Start(t, contractPath, mock.Script{Resources: fixture, ExpiresAfter: tc.expiresAfter})
+			c := client(t, srv, "")
+
+			got, err := c.ListAllResources(context.Background(), opsapi.ResourceFilter{PageSize: tc.pageSize})
+			if err != nil {
+				t.Fatalf("ListAllResources: %v", err)
+			}
+			if !reflect.DeepEqual(got, fixture) {
+				t.Fatalf("resources = %+v, want the full fixture", got)
+			}
+			if n := c.Stats().TokensAcquired; n != tc.wantTokens {
+				t.Errorf("Stats().TokensAcquired = %d, want %d", n, tc.wantTokens)
+			}
+
+			rejected := 0
+			seen := map[string]int{}
+			for _, r := range srv.RequestsFor("getResources") {
+				if r.Status == http.StatusUnauthorized {
+					rejected++
+					continue
+				}
+				seen[r.Query.Get("page")]++
+			}
+			if rejected != tc.wantRejected {
+				t.Errorf("saw %d rejected pages, want %d", rejected, tc.wantRejected)
+			}
+			for page, count := range seen {
+				if count != 1 {
+					t.Errorf("page %s was served %d times, want exactly 1", page, count)
+				}
+			}
+		})
+	}
+}

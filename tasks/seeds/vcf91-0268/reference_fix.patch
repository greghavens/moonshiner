 // PushProperties groups samples by resource, splits them into batches of at
 // most batchSize resources, and posts each batch to the property operation.
 func (c *Client) PushProperties(ctx context.Context, samples []opsapi.PropertySample, batchSize int) error {
-	return errNotImplemented
+	if batchSize < 1 {
+		return fmt.Errorf("vcfops: batchSize %d must be at least 1", batchSize)
+	}
+	if len(samples) == 0 {
+		return nil
+	}
+
+	order := make([]string, 0, len(samples))
+	grouped := make(map[string][]propertyContent, len(samples))
+	for i, sample := range samples {
+		switch {
+		case sample.ResourceID == "":
+			return fmt.Errorf("vcfops: samples[%d] has no ResourceID", i)
+		case sample.StatKey == "":
+			return fmt.Errorf("vcfops: samples[%d] has no StatKey", i)
+		case len(sample.Timestamps) == 0:
+			return fmt.Errorf("vcfops: samples[%d] (%s) has no Timestamps", i, sample.StatKey)
+		case len(sample.Values) > 0 && len(sample.Data) > 0:
+			return fmt.Errorf("vcfops: samples[%d] (%s) sets both Values and Data", i, sample.StatKey)
+		case len(sample.Values) == 0 && len(sample.Data) == 0:
+			return fmt.Errorf("vcfops: samples[%d] (%s) sets neither Values nor Data", i, sample.StatKey)
+		}
+
+		if _, seen := grouped[sample.ResourceID]; !seen {
+			order = append(order, sample.ResourceID)
+		}
+		grouped[sample.ResourceID] = append(grouped[sample.ResourceID], propertyContent{
+			StatKey:    sample.StatKey,
+			Timestamps: append([]int64(nil), sample.Timestamps...),
+			Values:     append([]string(nil), sample.Values...),
+			Data:       append([]float64(nil), sample.Data...),
+		})
+	}
+
+	for start := 0; start < len(order); start += batchSize {
+		end := start + batchSize
+		if end > len(order) {
+			end = len(order)
+		}
+
+		payload := resourcesPropertyContents{Values: make([]resourcePropertyContents, 0, end-start)}
+		for _, id := range order[start:end] {
+			payload.Values = append(payload.Values, resourcePropertyContents{
+				ResourceID:       id,
+				PropertyContents: propertyContents{PropertyContent: grouped[id]},
+			})
+		}
+
+		body, err := json.Marshal(payload)
+		if err != nil {
+			return fmt.Errorf("vcfops: encode property batch: %w", err)
+		}
+		if err := c.do(ctx, http.MethodPost, pathResourceProperties, nil, body, nil); err != nil {
+			return err
+		}
+		c.record(func(s *opsapi.Stats) { s.PropertyBatchesSent++ })
+	}
+
+	return nil
 }
 

+func TestPropertyPayloadShape(t *testing.T) {
+	cases := []struct {
+		name    string
+		sample  opsapi.PropertySample
+		omitted string
+		kept    string
+	}{
+		{
+			name:    "string payload",
+			sample:  opsapi.PropertySample{ResourceID: fixture[0].Identifier, StatKey: "summary|state", Timestamps: []int64{7}, Values: []string{"UP"}},
+			omitted: "data",
+			kept:    "values",
+		},
+		{
+			name:    "numeric payload",
+			sample:  opsapi.PropertySample{ResourceID: fixture[0].Identifier, StatKey: "config|count", Timestamps: []int64{7}, Data: []float64{93}},
+			omitted: "values",
+			kept:    "data",
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			srv := mock.Start(t, contractPath, mock.Script{Resources: fixture})
+			c := client(t, srv, "")
+			if err := c.PushProperties(context.Background(), []opsapi.PropertySample{tc.sample}, 1); err != nil {
+				t.Fatalf("PushProperties: %v", err)
+			}
+
+			raw := srv.RequestsFor("addResourcesProperties")[0].Body
+			var decoded struct {
+				Values []struct {
+					PropertyContents struct {
+						PropertyContent []map[string]json.RawMessage `json:"property-content"`
+					} `json:"property-contents"`
+				} `json:"values"`
+			}
+			if err := json.Unmarshal(raw, &decoded); err != nil {
+				t.Fatalf("decode body: %v", err)
+			}
+			content := decoded.Values[0].PropertyContents.PropertyContent[0]
+			if _, present := content[tc.omitted]; present {
+				t.Errorf("body carries %q for an unset field: %s", tc.omitted, raw)
+			}
+			if _, present := content[tc.kept]; !present {
+				t.Errorf("body is missing %q: %s", tc.kept, raw)
+			}
+		})
+	}
+}

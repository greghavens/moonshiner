+func TestPushPropertiesRejectsMalformedSamples(t *testing.T) {
+	valid := opsapi.PropertySample{
+		ResourceID: fixture[0].Identifier,
+		StatKey:    "summary|state",
+		Timestamps: []int64{mock.ClockMillis},
+		Values:     []string{"UP"},
+	}
+	cases := []struct {
+		name      string
+		samples   []opsapi.PropertySample
+		batchSize int
+		want      string
+	}{
+		{"zero batch size", []opsapi.PropertySample{valid}, 0, "batchSize"},
+		{"missing resource id", []opsapi.PropertySample{{StatKey: "k", Timestamps: []int64{1}, Values: []string{"v"}}}, 1, "ResourceID"},
+		{"missing stat key", []opsapi.PropertySample{{ResourceID: "r", Timestamps: []int64{1}, Values: []string{"v"}}}, 1, "StatKey"},
+		{"missing timestamps", []opsapi.PropertySample{{ResourceID: "r", StatKey: "k", Values: []string{"v"}}}, 1, "Timestamps"},
+		{"both payloads", []opsapi.PropertySample{{ResourceID: "r", StatKey: "k", Timestamps: []int64{1}, Values: []string{"v"}, Data: []float64{1}}}, 1, "both"},
+		{"neither payload", []opsapi.PropertySample{{ResourceID: "r", StatKey: "k", Timestamps: []int64{1}}}, 1, "neither"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			srv := mock.Start(t, contractPath, mock.Script{Resources: fixture})
+			c := client(t, srv, "")
+			err := c.PushProperties(context.Background(), tc.samples, tc.batchSize)
+			if err == nil {
+				t.Fatal("PushProperties succeeded, want an error")
+			}
+			if !strings.Contains(err.Error(), tc.want) {
+				t.Errorf("error %q does not mention %q", err, tc.want)
+			}
+			if n := len(srv.RequestsFor("addResourcesProperties")); n != 0 {
+				t.Errorf("sent %d requests for a malformed batch, want 0", n)
+			}
+		})
+	}
+}

-func (c *Client) Stats() opsapi.Stats {
-	return opsapi.Stats{}
+// do performs one authenticated exchange. A rejected credential costs one
+// refresh and one replay of the same request; the caller's work is never
+// rebuilt or repeated.
+func (c *Client) do(ctx context.Context, method, path string, query url.Values, body []byte, out any) error {
+	token, generation, err := c.currentToken(ctx)
+	if err != nil {
+		return err
+	}
+
+	status, payload, err := c.send(ctx, method, path, query, body, token)
+	if err != nil {
+		return err
+	}
+
+	if status == http.StatusUnauthorized {
+		token, _, err = c.refreshToken(ctx, generation)
+		if err != nil {
+			return err
+		}
+		status, payload, err = c.send(ctx, method, path, query, body, token)
+		if err != nil {
+			return err
+		}
+	}
+
+	if status != http.StatusOK {
+		return fmt.Errorf("vcfops: %s %s: unexpected status %d", method, path, status)
+	}
+	if out == nil {
+		return nil
+	}
+	if err := json.Unmarshal(payload, out); err != nil {
+		return fmt.Errorf("vcfops: %s %s: decode response: %w", method, path, err)
+	}
+	return nil
+}
+
+// currentToken returns the cached credential, acquiring one on first use.
+func (c *Client) currentToken(ctx context.Context) (string, uint64, error) {
+	c.tokenMu.Lock()
+	defer c.tokenMu.Unlock()
+	if c.token == "" {
+		if err := c.acquireLocked(ctx); err != nil {
+			return "", 0, err
+		}
+	}
+	return c.token, c.generation, nil
+}
+
+// refreshToken replaces the credential that was current at stale. If another
+// goroutine already replaced it, that newer credential is returned instead of
+// acquiring a redundant one.
+func (c *Client) refreshToken(ctx context.Context, stale uint64) (string, uint64, error) {
+	c.tokenMu.Lock()
+	defer c.tokenMu.Unlock()
+	if c.generation != stale {
+		return c.token, c.generation, nil
+	}
+	if err := c.acquireLocked(ctx); err != nil {
+		return "", 0, err
+	}
+	return c.token, c.generation, nil
+}
+
+// acquireLocked runs the token acquisition operation. The caller holds tokenMu.
+func (c *Client) acquireLocked(ctx context.Context) error {
+	body, err := json.Marshal(credentials{
+		Username:   c.username,
+		Password:   c.password,
+		AuthSource: c.authSource,
+	})
+	if err != nil {
+		return fmt.Errorf("vcfops: encode credentials: %w", err)
+	}
+
+	// Token acquisition is unauthenticated, so it carries no credential.
+	status, payload, err := c.send(ctx, http.MethodPost, pathAcquireToken, nil, body, "")
+	if err != nil {
+		return err
+	}
+	if status != http.StatusOK {
+		return fmt.Errorf("vcfops: acquire token: unexpected status %d", status)
+	}
+
+	var decoded authToken
+	if err := json.Unmarshal(payload, &decoded); err != nil {
+		return fmt.Errorf("vcfops: acquire token: decode response: %w", err)
+	}
+	if decoded.Token == "" {
+		return errors.New("vcfops: acquire token: response carried no token")
+	}
+
+	c.token = decoded.Token
+	c.generation++
+	c.record(func(s *opsapi.Stats) { s.TokensAcquired++ })
+	return nil
+}
+
+// send issues one HTTP request and reads the whole response.
+func (c *Client) send(ctx context.Context, method, path string, query url.Values, body []byte, token string) (int, []byte, error) {
+	target := c.baseURL + path
+	if len(query) > 0 {
+		target += "?" + query.Encode()
+	}
+
+	var reader io.Reader
+	if body != nil {
+		reader = bytes.NewReader(body)
+	}
+	req, err := http.NewRequestWithContext(ctx, method, target, reader)
+	if err != nil {
+		return 0, nil, fmt.Errorf("vcfops: build %s %s: %w", method, path, err)
+	}
+
+	// The API serves XML unless JSON is negotiated explicitly.
+	req.Header.Set("Accept", "application/json")
+	if body != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	if token != "" {
+		req.Header.Set("Authorization", authScheme+" "+token)
+	}
+
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return 0, nil, fmt.Errorf("vcfops: %s %s: %w", method, path, err)
+	}
+	defer resp.Body.Close()
+
+	payload, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return 0, nil, fmt.Errorf("vcfops: %s %s: read response: %w", method, path, err)
+	}
+	return resp.StatusCode, payload, nil
 }

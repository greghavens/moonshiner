{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0037:migration-plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "estateId",
    "sourcePlatformVersion",
    "targetPlatformVersion",
    "steps"
  ],
  "properties": {
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "sourcePlatformVersion": {
      "type": "string",
      "minLength": 1
    },
    "targetPlatformVersion": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "componentId",
          "component",
          "currentVersion",
          "targetComponent",
          "targetVersion",
          "action",
          "gates"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "currentVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetComponent": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "enum": [
              "UPGRADE",
              "DEPLOY_REPLACEMENT"
            ]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

+    private static Map<String, Object> buildDecision(Map<String, Object> snapshot)
+            throws IOException {
+        Map<String, Object> policy = object(snapshot.get("capacityPolicy"));
+        double requiredTiB = 240.0;
+        double dataFraction = number(policy.get("dataFraction")).doubleValue();
+        double reserveFraction = number(policy.get("reserveFraction")).doubleValue();
+        int minimumHosts = integer(policy.get("minimumHosts"));
+
+        Map<String, Object> decision = new LinkedHashMap<>();
+        decision.put("selectedArchitecture", null);
+        decision.put("siteTopology", "SINGLE_SITE");
+        decision.put("requiredUsableTiB", requiredTiB);
+        decision.put("reservePercent", reserveFraction * 100.0);
+        decision.put("failuresToTolerate", policy.get("failuresToTolerate"));
+        decision.put("raid", policy.get("raid"));
+        decision.put("interHostRttMs", 0.4);
+
+        List<Object> calculatedProfiles = new ArrayList<>();
+        String selectedName = null;
+        int selectedHosts = Integer.MAX_VALUE;
+        double selectedUsablePerHost = 0.0;
+        for (Map.Entry<String, Object> entry
+                : object(snapshot.get("storageProfiles")).entrySet()) {
+            Map<String, Object> source = object(entry.getValue());
+            Map<String, Object> network = object(source.get("network"));
+            double rawTiB = number(source.get("rawTiBPerHost")).doubleValue();
+            double usablePerHost = rawTiB * dataFraction * (1.0 - reserveFraction);
+            int requiredHosts = Math.max(
+                    minimumHosts, (int) Math.ceil(requiredTiB / usablePerHost));
+
+            Map<String, Object> calculated = new LinkedHashMap<>();
+            calculated.put("name", entry.getKey());
+            calculated.put("supported", source.get("supported"));
+            calculated.put("rawTiBPerHost", source.get("rawTiBPerHost"));
+            calculated.put("calculatedUsableTiBPerHost", usablePerHost);
+            calculated.put("requiredHosts", requiredHosts);
+            calculated.put("minimumNetworkGbps", network.get("minimumGbps"));
+            calculated.put("recommendedNetworkGbps", network.get("recommendedGbps"));
+            calculated.put("dedicatedMinimum", network.get("dedicatedMinimum"));
+            calculatedProfiles.add(calculated);
+
+            boolean supported = Boolean.TRUE.equals(source.get("supported"));
+            boolean networkFits = number(network.get("minimumGbps")).doubleValue() <= 25.0;
+            if (supported && networkFits && requiredHosts < selectedHosts) {
+                selectedName = entry.getKey();
+                selectedHosts = requiredHosts;
+                selectedUsablePerHost = usablePerHost;
+            }
+        }
+        if (selectedName == null) {
+            throw new IOException("no supported storage profile satisfies the network requirement");
+        }
+        decision.put("selectedArchitecture", selectedName);
+        decision.put("profiles", calculatedProfiles);
+        Map<String, Object> provisioned = new LinkedHashMap<>();
+        provisioned.put("hostCount", selectedHosts);
+        provisioned.put("calculatedUsableTiB", selectedHosts * selectedUsablePerHost);
+        provisioned.put("physicalUplinksPerHost", 2);
+        provisioned.put("uplinkGbps", 25);
+        provisioned.put("mtu", 9000);
+        decision.put("provisioned", provisioned);
+        return decision;
+    }

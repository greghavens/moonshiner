+    private static Map<String, Object> buildMigrationPlan(
+            Map<String, Object> inventory, Map<String, Object> snapshot) throws IOException {
+        String platformVersion = string(inventory.get("platformVersion"));
+        boolean supportedSource = false;
+        for (Object value : array(snapshot.get("supportedSourceBranches"))) {
+            String branch = string(value);
+            String prefix = branch.endsWith("x")
+                    ? branch.substring(0, branch.length() - 1) : branch;
+            supportedSource |= platformVersion.startsWith(prefix);
+        }
+        if (!supportedSource) {
+            throw new IOException("inventory platform is not on a supported source branch");
+        }
+
+        Map<String, Object> compatibility = object(snapshot.get("upgradeCompatibility"));
+        List<Object> transitions = new ArrayList<>(
+                array(compatibility.get("productTransitions")));
+        transitions.sort(Comparator.comparingInt(
+                value -> integerUnchecked(objectUnchecked(value).get("sequence"))));
+        List<Object> components = array(inventory.get("components"));
+        if (components.size() != transitions.size()) {
+            throw new IOException("inventory and transition counts differ");
+        }
+
+        Map<String, Object> targetBom = object(snapshot.get("targetBom"));
+        List<Object> steps = new ArrayList<>();
+        for (Object transitionValue : transitions) {
+            Map<String, Object> transition = object(transitionValue);
+            String sourceProduct = string(transition.get("sourceProduct"));
+            Map<String, Object> current = null;
+            for (Object componentValue : components) {
+                Map<String, Object> candidate = object(componentValue);
+                if (sourceProduct.equals(candidate.get("name"))) {
+                    if (current != null) {
+                        throw new IOException("duplicate inventory component " + sourceProduct);
+                    }
+                    current = candidate;
+                }
+            }
+            if (current == null) {
+                throw new IOException("missing inventory component " + sourceProduct);
+            }
+            if (!Pattern.compile(string(transition.get("sourceVersionPattern")))
+                    .matcher(string(current.get("version"))).find()) {
+                throw new IOException("unsupported component version for " + sourceProduct);
+            }
+
+            String targetVersion = null;
+            for (Object memberValue : array(transition.get("targetBomMembers"))) {
+                String version = string(object(targetBom.get(string(memberValue))).get("version"));
+                if (targetVersion != null && !targetVersion.equals(version)) {
+                    throw new IOException("transition BOM members have different versions");
+                }
+                targetVersion = version;
+            }
+            if (targetVersion == null) {
+                throw new IOException("transition has no target BOM member");
+            }
+            String mode = string(transition.get("transitionMode"));
+            String action = switch (mode) {
+                case "in-place-upgrade" -> "UPGRADE";
+                case "deploy-replacement" -> "DEPLOY_REPLACEMENT";
+                default -> throw new IOException("unknown transition mode " + mode);
+            };
+
+            Map<String, Object> step = new LinkedHashMap<>();
+            step.put("order", transition.get("sequence"));
+            step.put("componentId", current.get("id"));
+            step.put("component", current.get("name"));
+            step.put("currentVersion", current.get("version"));
+            step.put("targetComponent", transition.get("targetProduct"));
+            step.put("targetVersion", targetVersion);
+            step.put("action", action);
+            step.put("gates", new ArrayList<>(array(transition.get("prerequisiteFacts"))));
+            steps.add(step);
+        }
+
+        Map<String, Object> plan = new LinkedHashMap<>();
+        plan.put("estateId", inventory.get("estateId"));
+        plan.put("sourcePlatformVersion", platformVersion);
+        plan.put("targetPlatformVersion", snapshot.get("targetPlatformVersion"));
+        plan.put("steps", steps);
+        return plan;
+    }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0148:migration-plan:1.0",
  "title": "VCF mixed-estate ordered migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planSchemaVersion",
    "estateId",
    "topologyDecision",
    "components",
    "steps"
  ],
  "properties": {
    "planSchemaVersion": {
      "const": "1.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "topologyDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stretchedManagementDomain",
        "dataSiteIds",
        "witnessComponentId",
        "witnessSiteId",
        "witnessFailureDomain",
        "witnessMode",
        "witnessMemberOfDataCluster",
        "witnessRunsManagementWorkloads"
      ],
      "properties": {
        "stretchedManagementDomain": {
          "type": "boolean"
        },
        "dataSiteIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "witnessComponentId": {
          "type": "string",
          "minLength": 1
        },
        "witnessSiteId": {
          "type": "string",
          "minLength": 1
        },
        "witnessFailureDomain": {
          "type": "string",
          "minLength": 1
        },
        "witnessMode": {
          "enum": [
            "DEDICATED",
            "SHARED"
          ]
        },
        "witnessMemberOfDataCluster": {
          "type": "boolean"
        },
        "witnessRunsManagementWorkloads": {
          "type": "boolean"
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "currentVersion",
          "targetVersion",
          "gates"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "currentVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "gates": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "componentId",
          "fromVersion",
          "toVersion",
          "requiredGates"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "fromVersion": {
            "type": "string",
            "minLength": 1
          },
          "toVersion": {
            "type": "string",
            "minLength": 1
          },
          "requiredGates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

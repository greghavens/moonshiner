{
  "format": "openapi-2.0-reduced-contract",
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "spec_path": "specifications/nsx/openapi-2.0/nsx_policy_api.yaml",
    "license": "Apache-2.0"
  },
  "basePath": "/policy/api/v1",
  "operations": [
    {
      "operationId": "PatchInfraSegment",
      "method": "PATCH",
      "path": "/infra/segments/{segment-id}",
      "path_parameters": {
        "segment-id": {
          "type": "string",
          "required": true
        }
      },
      "query_parameters": {},
      "request": {
        "content_type": "application/json",
        "schema_name": "Segment",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "type": "string",
            "maxLength": 255,
            "optional": true
          },
          "connectivity_path": {
            "type": "string",
            "optional": true
          },
          "subnets": {
            "type": "array",
            "optional": true,
            "maxItems": 1,
            "items": {
              "schema_name": "SegmentSubnet",
              "type": "object",
              "properties": {
                "gateway_address": {
                  "type": "string",
                  "format": "ip-cidr-block",
                  "optional": true
                },
                "dhcp_ranges": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "maxItems": 99,
                  "optional": true
                }
              }
            }
          },
          "description": {
            "type": "string",
            "maxLength": 1024,
            "optional": true
          },
          "transport_zone_path": {
            "type": "string",
            "optional": true
          },
          "admin_state": {
            "type": "string",
            "enum": [
              "UP",
              "DOWN"
            ],
            "default": "UP",
            "optional": true
          },
          "overlay_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647,
            "optional": true
          },
          "vlan_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "optional": true
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "body": null
        }
      }
    },
    {
      "operationId": "ReadIntentStatus",
      "method": "GET",
      "path": "/infra/realized-state/status",
      "path_parameters": {},
      "query_parameters": {
        "intent_path": {
          "type": "string",
          "required": true
        },
        "include_enforced_status": {
          "type": "boolean",
          "default": false,
          "required": false
        },
        "site_path": {
          "type": "string",
          "required": false
        }
      },
      "request": null,
      "responses": {
        "200": {
          "description": "OK",
          "content_type": "application/json",
          "schema_name": "ConsolidatedRealizedStatus",
          "type": "object",
          "required": [
            "intent_path"
          ],
          "properties": {
            "intent_path": {
              "type": "string"
            },
            "consolidated_status": {
              "schema_name": "ConsolidatedStatus",
              "type": "object",
              "properties": {
                "consolidated_status": {
                  "schema_name": "ConfigState",
                  "type": "string",
                  "enum": [
                    "SUCCESS",
                    "IN_PROGRESS",
                    "ERROR",
                    "UNKNOWN",
                    "UNINITIALIZED",
                    "SANDBOXED_REALIZATION_PENDING"
                  ]
                }
              }
            },
            "publish_status": {
              "type": "string",
              "enum": [
                "UNAVAILABLE",
                "UNREALIZED",
                "REALIZED",
                "ERROR"
              ]
            }
          }
        }
      }
    }
  ]
}

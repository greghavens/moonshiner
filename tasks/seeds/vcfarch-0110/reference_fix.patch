+{
+  "retrievalContext": "Compatibility and upgrade-path research performed against reachable Broadcom publications before fixing the architecture.",
+  "sources": [
+    {
+      "retrievedAt": "2026-08-14T19:05:00Z",
+      "title": "Site Recovery Manager Appliance Upgrade Best Practices",
+      "url": "https://knowledge.broadcom.com/external/article/385248/site-recovery-manager-appliance-upgrade.html",
+      "finding": "Recovery upgrades must preserve supported release hops and be checked with vCenter, ESXi, and vSphere Replication interoperability."
+    },
+    {
+      "retrievedAt": "2026-08-14T19:07:00Z",
+      "title": "Support and upgrade requirements for NSX 9.x in VMware Cloud Foundation (VCF) 9.x",
+      "url": "https://knowledge.broadcom.com/external/article/401775/nsx-9x-is-only-supported-as-part-of-a-vc.html",
+      "finding": "A standalone NSX 4.x instance must be imported before its NSX 9.x transition is performed by VCF lifecycle management."
+    },
+    {
+      "retrievedAt": "2026-08-14T19:09:00Z",
+      "title": "Upgrade failure for vCenter 8.0 U3j, ESXi 8.0 U3j, and NSX 4.2.4 due to back-in-time restriction",
+      "url": "https://knowledge.broadcom.com/external/article/448135/upgrade-failure-for-vcenter-80-u3j-esxi.html",
+      "finding": "VCF 9.1 lifecycle checks exact component builds and blocks transitions that would move to chronologically older bundled builds."
+    },
+    {
+      "retrievedAt": "2026-08-14T19:11:00Z",
+      "title": "VCF API Specification",
+      "url": "https://developer.broadcom.com/sdks/vcf-api-specification/latest/",
+      "finding": "Broadcom publishes the VCF Installer OpenAPI as part of the versioned VCF API specification set."
+    }
+  ]
+}

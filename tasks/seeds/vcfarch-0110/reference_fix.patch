diff --git a/vcf_arch/builder.py b/vcf_arch/builder.py
new file mode 100644
index 0000000..625bdf9
--- /dev/null
+++ b/vcf_arch/builder.py
@@ -0,0 +1,358 @@
+"""Deterministic builders for the greenfield and brownfield artifacts."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any
+
+
+def _read(path: Path) -> dict[str, Any]:
+    with path.open("r", encoding="utf-8") as handle:
+        value = json.load(handle)
+    if not isinstance(value, dict):
+        raise ValueError(f"{path} must contain a JSON object")
+    return value
+
+
+def _write(path: Path, value: dict[str, Any]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("w", encoding="utf-8") as handle:
+        json.dump(value, handle, indent=2, sort_keys=True)
+        handle.write("\n")
+
+
+def _network(
+    network_type: str,
+    vlan_id: int,
+    subnet: str,
+    gateway: str,
+    start: str,
+    end: str,
+) -> dict[str, Any]:
+    return {
+        "networkType": network_type,
+        "vlanId": vlan_id,
+        "subnet": subnet,
+        "gateway": gateway,
+        "subnetMask": "255.255.255.0",
+        "includeIpAddressRanges": [{"startIpAddress": start, "endIpAddress": end}],
+        "mtu": 9000,
+        "ipAddressVersion": "IPv4",
+        "ipAddressAssignmentMode": "STATIC",
+    }
+
+
+def build_sddc(snapshot: dict[str, Any]) -> dict[str, Any]:
+    hostnames = [f"ord-m{number:02d}" for number in range(1, 5)]
+    hostnames.extend(f"dfw-m{number:02d}" for number in range(1, 5))
+    networks = [
+        _network("MANAGEMENT", 110, "10.10.10.0/24", "10.10.10.1", "10.10.10.21", "10.10.10.80"),
+        _network("VMOTION", 120, "10.10.20.0/24", "10.10.20.1", "10.10.20.21", "10.10.20.80"),
+        _network("VSAN", 130, "10.10.30.0/24", "10.10.30.1", "10.10.30.21", "10.10.30.80"),
+        _network("VM_MANAGEMENT", 140, "10.10.40.0/24", "10.10.40.1", "10.10.40.21", "10.10.40.80"),
+        _network("FLEET_MANAGEMENT", 150, "10.10.50.0/24", "10.10.50.1", "10.10.50.21", "10.10.50.80"),
+    ]
+    return {
+        "sddcId": "northstar-m01",
+        "workflowType": "VCF",
+        "version": snapshot["targetFleet"]["version"],
+        "hostSpecs": [{"hostname": hostname} for hostname in hostnames],
+        "vcenterSpec": {
+            "vcenterHostname": "vc-mgmt01.vcf.example.com",
+            "rootVcenterPassword": "Example-Only9!Aa",
+            "vmSize": "medium",
+            "ssoDomain": "vsphere.local",
+            "useExistingDeployment": False,
+            "version": snapshot["targetVersions"]["VCENTER"],
+        },
+        "clusterSpec": {
+            "datacenterName": "northstar-mgmt-dc",
+            "clusterName": "northstar-mgmt-stretched",
+        },
+        "dvsSpecs": [
+            {
+                "dvsName": "northstar-mgmt-vds",
+                "networks": [network["networkType"] for network in networks],
+                "mtu": 9000,
+                "vmnicsToUplinks": [
+                    {"id": "vmnic0", "uplink": "uplink1"},
+                    {"id": "vmnic1", "uplink": "uplink2"},
+                ],
+            }
+        ],
+        "nsxtSpec": {
+            "nsxtManagers": [
+                {"hostname": "ord-nsx-m01.vcf.example.com"},
+                {"hostname": "dfw-nsx-m01.vcf.example.com"},
+                {"hostname": "ord-nsx-m02.vcf.example.com"},
+            ],
+            "nsxtManagerSize": "medium",
+            "vipFqdn": "nsx-mgmt.vcf.example.com",
+            "transportVlanId": 160,
+            "useExistingDeployment": False,
+            "version": snapshot["targetVersions"]["NSX"],
+        },
+        "networkSpecs": networks,
+        "dnsSpec": {
+            "subdomain": "vcf.example.com",
+            "nameservers": ["10.10.10.10", "10.10.10.11"],
+        },
+        "ntpServers": ["10.10.10.12", "10.10.10.13"],
+        "managementPoolName": "northstar-mgmt-pool",
+        "ceipEnabled": False,
+        "skipEsxThumbprintValidation": False,
+        "skipGatewayPingValidation": False,
+        "datastoreSpec": {
+            "vsanSpec": {
+                "datastoreName": "northstar-mgmt-vsan",
+                "failuresToTolerate": snapshot["topology"]["failuresToTolerate"],
+                "vsanDedup": False,
+            }
+        },
+        "vcfInstanceName": "northstar-fleet",
+    }
+
+
+def build_topology(snapshot: dict[str, Any]) -> dict[str, Any]:
+    authority = snapshot["topology"]
+    return {
+        "schemaVersion": "1.0",
+        "managementDomainId": "northstar-m01",
+        "clusterType": authority["clusterType"],
+        "failuresToTolerate": authority["failuresToTolerate"],
+        "dataSites": [
+            {
+                "siteId": "ord-dc1",
+                "failureDomain": "fd-ord",
+                "hostnames": [f"ord-m{number:02d}" for number in range(1, 5)],
+            },
+            {
+                "siteId": "dfw-dc2",
+                "failureDomain": "fd-dfw",
+                "hostnames": [f"dfw-m{number:02d}" for number in range(1, 5)],
+            },
+        ],
+        "witness": {
+            "inventoryId": authority["witnessInventoryId"],
+            "hostname": "msp-vsan-witness01",
+            "siteId": authority["witnessSiteId"],
+            "failureDomain": authority["witnessFailureDomain"],
+            "runsWorkloads": False,
+            "dataClusterMember": False,
+        },
+    }
+
+
+def _transition_gates(snapshot: dict[str, Any], kind: str, to_version: str) -> set[str]:
+    gates: set[str] = set()
+    for rule in snapshot["transitionGateRules"]:
+        if kind in rule["kinds"]:
+            gates.update(rule["gates"])
+    for rule in snapshot["conditionalTransitionGates"]:
+        if kind == rule["kind"] and to_version == rule["toVersion"]:
+            gates.update(rule["gates"])
+    return gates
+
+
+def _register_gates(
+    snapshot: dict[str, Any], component: dict[str, Any], imported_ids: set[str]
+) -> list[str]:
+    result: set[str] = set()
+    for to_version in snapshot["upgradePaths"][component["id"]][1:]:
+        result.update(_transition_gates(snapshot, component["kind"], to_version))
+    if component["id"] in imported_ids:
+        result.update({"vcf-import-precheck", "stretched-network-readiness"})
+    return sorted(result)
+
+
+def build_plan(inventory: dict[str, Any], snapshot: dict[str, Any]) -> dict[str, Any]:
+    inventory_by_id = {component["id"]: component for component in inventory["components"]}
+    imported_ids = {
+        component_id
+        for baseline in snapshot["importBaselines"].values()
+        for component_id in baseline
+    }
+    register = []
+    for component in inventory["components"]:
+        register.append(
+            {
+                "inventoryId": component["id"],
+                "kind": component["kind"],
+                "currentVersion": component["version"],
+                "targetVersion": snapshot["targetVersions"][component["kind"]],
+                "targetState": snapshot["targetFleet"]["state"],
+                "gatedBy": _register_gates(snapshot, component, imported_ids),
+            }
+        )
+
+    steps: list[dict[str, Any]] = []
+
+    def configure(step_id: str, summary: str, components: list[str], gates: set[str]) -> None:
+        steps.append(
+            {
+                "order": len(steps) + 1,
+                "id": step_id,
+                "operation": "CONFIGURE",
+                "summary": summary,
+                "components": components,
+                "gates": sorted(gates),
+                "transitions": [],
+            }
+        )
+
+    def upgrade(step_id: str, summary: str, edges: list[tuple[str, str, str]]) -> None:
+        gates: set[str] = set()
+        transitions = []
+        for component_id, from_version, to_version in edges:
+            component = inventory_by_id[component_id]
+            gates.update(_transition_gates(snapshot, component["kind"], to_version))
+            transitions.append(
+                {
+                    "inventoryId": component_id,
+                    "fromVersion": from_version,
+                    "toVersion": to_version,
+                }
+            )
+        steps.append(
+            {
+                "order": len(steps) + 1,
+                "id": step_id,
+                "operation": "UPGRADE",
+                "summary": summary,
+                "components": [edge[0] for edge in edges],
+                "gates": sorted(gates),
+                "transitions": transitions,
+            }
+        )
+
+    def do_import(step_id: str, site_id: str) -> None:

+def generate(inventory_path: Path, compatibility_path: Path, output_dir: Path) -> None:
+    inventory = _read(inventory_path)
+    snapshot = _read(compatibility_path)
+    _write(output_dir / "greenfield-sddc.json", build_sddc(snapshot))

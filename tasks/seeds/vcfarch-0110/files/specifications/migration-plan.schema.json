{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0110:migration-plan:1.0",
  "title": "VCF brownfield migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "estateId",
    "targetFleetVersion",
    "gateCatalog",
    "components",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetFleetVersion": {
      "type": "string",
      "minLength": 1
    },
    "gateCatalog": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "condition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventoryId",
        "kind",
        "currentVersion",
        "targetVersion",
        "targetState",
        "gatedBy"
      ],
      "properties": {
        "inventoryId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "VCENTER",
            "ESXI",
            "VSAN",
            "NSX",
            "LIVE_SITE_RECOVERY",
            "VSPHERE_REPLICATION",
            "VSAN_WITNESS"
          ]
        },
        "currentVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetState": {
          "const": "VCF_FLEET_MANAGED"
        },
        "gatedBy": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventoryId",
        "fromVersion",
        "toVersion"
      ],
      "properties": {
        "inventoryId": {
          "type": "string",
          "minLength": 1
        },
        "fromVersion": {
          "type": "string",
          "minLength": 1
        },
        "toVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "id",
        "operation",
        "summary",
        "components",
        "gates",
        "transitions"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "operation": {
          "type": "string",
          "enum": [
            "CONFIGURE",
            "UPGRADE",
            "IMPORT"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "transitions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/transition"
          }
        }
      }
    }
  }
}

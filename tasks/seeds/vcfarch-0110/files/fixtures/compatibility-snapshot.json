  "gates": [
    {
      "id": "backup-health",
      "condition": "Current configuration backups exist and restore checks pass for every appliance changed in the step."
    },
    {
      "id": "hardware-compatibility",
      "condition": "Server, I/O device, driver, firmware, and target ESXi release combinations pass the compatibility check."
    },
    {
      "id": "vcenter-esxi-interoperability",
      "condition": "The transitional and target vCenter/ESXi combinations are interoperable."
    },
    {
      "id": "vsan-health",
      "condition": "vSAN health, object compliance, resynchronization, and capacity checks are green."
    },
    {
      "id": "nsx-upgrade-precheck",
      "condition": "NSX upgrade evaluation and prechecks pass without unresolved blocking findings."
    },
    {
      "id": "vcf-import-precheck",
      "condition": "The existing vCenter, hosts, storage, networking, DNS, NTP, and certificates pass VCF import validation."
    },
    {
      "id": "vcf-lifecycle-control",
      "condition": "The NSX instance is imported into the VCF inventory and its 9.1 transition is run by VCF lifecycle management."
    },
    {
      "id": "recovery-interoperability",
      "condition": "Live Site Recovery, vSphere Replication, vCenter, and ESXi versions are mutually interoperable at both sites."
    },
    {
      "id": "recovery-pair-quiesced",
      "condition": "Recovery plans are idle, replication health is green, and the site pair is disconnected when the release transition requires it."
    },
    {
      "id": "stretched-network-readiness",
      "condition": "The stretched management, vMotion, vSAN, VM-management, and fleet-management networks and MTU are reachable at both data sites."
    },
    {
      "id": "witness-failure-domain",
      "condition": "The witness is in msp-witness/fd-msp, outside fd-ord and fd-dfw, and carries no workloads or data components."
    },
    {
      "id": "witness-connectivity",
      "condition": "Witness routing, latency, bandwidth, DNS, NTP, and vSAN witness traffic checks pass from both data sites."
    },
    {
      "id": "target-bom-available",
      "condition": "The exact pinned target binaries and required intermediate releases are present and their integrity checks pass."
    }
  ],

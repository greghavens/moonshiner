{
  "contract_version": "1.0.0",
  "product": "VCF Operations for Networks",
  "release": "VMware Cloud Foundation 9.1",
  "spec_info_version": "9.1.0.0",
  "derived_from": {
    "repository": "vmware/vcf-api-specs",
    "spec_path": "specifications/vcf-operations/vcf-operations-for-networks-openapi.yaml",
    "commit_sha": "c3f3b52c845dd967cabbc21680e893292077d5ba"
  },
  "server_base_path": "/api/ni",
  "authentication": {
    "scheme_name": "ApiKeyAuth",
    "type": "apiKey",
    "in": "header",
    "header_name": "Authorization",
    "header_value_format": "NetworkInsight {token}",
    "note": "The spec declares two security schemes globally (ApiKeyAuth, OpsTokenAuth). This contract uses ApiKeyAuth."
  },
  "operations": {
    "create": {
      "operation_id": "create",
      "tag": "Authentication",
      "method": "POST",
      "path": "/api/ni/auth/token",
      "spec_path": "/auth/token",
      "authenticated": false,
      "request_content_type": "application/json",
      "request_schema": "UserCredential",
      "request_fields": {
        "username": { "type": "string", "required_by_task": true },
        "password": { "type": "string", "required_by_task": true },
        "domain": {
          "type": "object",
          "schema": "Domain",
          "required_by_task": false,
          "omit_when_unset": true,
          "fields": {
            "domain_type": { "type": "string", "enum": ["LDAP", "LOCAL"] },
            "value": { "type": "string", "omit_when_unset": true }
          }
        }
      },
      "success_status": 200,
      "response_schema": "Token",
      "response_fields": ["token", "expiry"]
    },
    "addApplication": {
      "operation_id": "addApplication",
      "tag": "Applications",
      "method": "POST",
      "path": "/api/ni/groups/applications",
      "spec_path": "/groups/applications",
      "authenticated": true,
      "request_content_type": "application/json",
      "request_schema": "ApplicationRequest",
      "request_fields": {
        "name": { "type": "string", "required_by_spec": true }
      },
      "success_status": 201,
      "response_schema": "Application",
      "response_fields": ["entity_id", "name", "entity_type", "create_time", "created_by"]
    },
    "addTier": {
      "operation_id": "addTier",
      "tag": "Applications",
      "method": "POST",
      "path": "/api/ni/groups/applications/{id}/tiers",
      "spec_path": "/groups/applications/{id}/tiers",
      "path_parameters": {
        "id": { "type": "string", "description": "entity_id of the parent application" }
      },
      "authenticated": true,
      "request_content_type": "application/json",
      "request_schema": "TierRequest",
      "request_fields": {
        "name": { "type": "string", "required_by_spec": false, "required_by_task": true },
        "entity_id": { "type": "string", "required_by_spec": false, "omit_when_unset": true },
        "group_membership_criteria": {
          "type": "array",
          "items_schema": "GroupMembershipCriteria",
          "required_by_spec": false,
          "omit_when_unset": true,
          "item_fields": {
            "membership_type": {
              "type": "string",
              "enum": ["SearchMembershipCriteria", "IPAddressMembershipCriteria"]
            },
            "search_membership_criteria": {
              "type": "object",
              "schema": "SearchMembershipCriteria",
              "omit_when_unset": true,
              "fields": {
                "entity_type": { "type": "string", "schema": "AllEntityType" },
                "filter": { "type": "string" }
              }
            },
            "ip_address_membership_criteria": {
              "type": "object",
              "schema": "IpAddressMembershipCriteria",
              "omit_when_unset": true,
              "fields": {
                "ip_addresses": { "type": "array", "items": "string" }
              }
            }
          }
        },
        "member_list": {
          "type": "object",
          "schema": "MemberList",
          "required_by_spec": false,
          "omit_when_unset": true
        },
        "source_group_entity_id": {
          "type": "array",
          "items": "string",
          "required_by_spec": false,
          "omit_when_unset": true
        }
      },
      "success_status": 201,
      "response_schema": "Tier",
      "response_fields": ["entity_id", "name", "entity_type", "group_membership_criteria", "application"],
      "error_statuses": [400, 401, 403, 404, 500],
      "error_schema": "ApiError",
      "error_fields": ["code", "message", "details"]
    },
    "listApplicationTiers": {
      "operation_id": "listApplicationTiers",
      "tag": "Applications",
      "method": "GET",
      "path": "/api/ni/groups/applications/{id}/tiers",
      "spec_path": "/groups/applications/{id}/tiers",
      "path_parameters": {
        "id": { "type": "string", "description": "entity_id of the parent application" }
      },
      "authenticated": true,
      "request_body": null,
      "success_status": 200,
      "response_schema": "TierListResponse",
      "response_fields": ["results"]
    },
    "delete": {
      "operation_id": "delete",
      "tag": "Authentication",
      "method": "DELETE",
      "path": "/api/ni/auth/token",
      "spec_path": "/auth/token",
      "authenticated": true,
      "request_body": null,
      "success_status": 204,
      "response_schema": null
    }
  },
  "wire_rules": {
    "omit_unset_optional_fields": "A field whose value is not configured MUST be absent from the serialized JSON object. Emitting the key with null, \"\", {}, or [] is a contract violation.",
    "no_extra_fields": "Request bodies MUST NOT contain keys absent from the operation's request schema.",
    "content_type": "Every request that carries a body MUST send Content-Type: application/json.",
    "no_body_without_schema": "Operations whose request_body is null MUST NOT send a request body.",
    "auth_header": "Operations with authenticated=true MUST send Authorization: NetworkInsight {token}. Operations with authenticated=false MUST NOT send an Authorization header."
  }
}

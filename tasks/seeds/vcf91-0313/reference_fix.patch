+function Get-VcfaRequestTracker {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)] [string] $Server,
+        [Parameter(Mandatory)] [string] $AccessToken,
+        [Parameter(Mandatory)] [string] $RequestId
+    )
+    return Invoke-VcfaIaasRequest -Server $Server -AccessToken $AccessToken `
+        -Method GET -Path "$script:BasePath/request-tracker/$RequestId"
+}
+
+function Wait-VcfaRequestTracker {
+    <#
+        Follows one tracker to a terminal status and returns it.
+    #>
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)] [string] $Server,
+        [Parameter(Mandatory)] [string] $AccessToken,
+        [Parameter(Mandatory)] [string] $RequestId,
+        [Parameter(Mandatory)] [int] $TimeoutSeconds,
+        [Parameter(Mandatory)] [int] $PollIntervalMilliseconds
+    )
+
+    $deadline = [datetime]::UtcNow.AddSeconds($TimeoutSeconds)
+    while ($true) {
+        $tracker = Get-VcfaRequestTracker -Server $Server -AccessToken $AccessToken -RequestId $RequestId
+        $status = if ($tracker.PSObject.Properties.Name -contains 'status') { $tracker.status } else { $null }
+
+        if ($status -in $script:TerminalStatuses) {
+            return $tracker
+        }
+
+        if ([datetime]::UtcNow -ge $deadline) {
+            throw "Request $RequestId did not reach a terminal status within $TimeoutSeconds seconds (last status: $status)."
+        }
+
+        Start-Sleep -Milliseconds $PollIntervalMilliseconds
+    }
+}

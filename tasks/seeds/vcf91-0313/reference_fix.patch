+function ConvertTo-VcfaHashtable {
+    <#
+        Invoke-RestMethod hands back PSCustomObject; the specification builder
+        takes a hashtable. Converts one level deep, which is all
+        cloudAccountProperties needs (it is a name/value bag).
+    #>
+    [CmdletBinding()]
+    [OutputType([hashtable])]
+    param([Parameter(Mandatory)] [AllowNull()] [object] $InputObject)
+
+    $result = @{}
+    if ($null -eq $InputObject) { return $result }
+    if ($InputObject -is [hashtable]) { return $InputObject }
+
+    foreach ($property in $InputObject.PSObject.Properties) {
+        $result[$property.Name] = $property.Value
+    }
+    return $result
 }
 

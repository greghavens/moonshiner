+# --------------------------------------------------------------------------
+# Transport
+# --------------------------------------------------------------------------
+
+function Invoke-VcfaIaasRequest {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)] [string] $Server,
+        [Parameter(Mandatory)] [string] $AccessToken,
+        [Parameter(Mandatory)] [ValidateSet('GET', 'POST', 'PATCH')] [string] $Method,
+        [Parameter(Mandatory)] [string] $Path,
+        [Parameter()] [hashtable] $Query,
+        [Parameter()] [string] $JsonBody
+    )
+
+    # apiVersion is pinned for every operation so a rotation cannot straddle
+    # two server-selected API versions part way through.
+    $parameters = [ordered]@{ apiVersion = $script:ApiVersion }
+    if ($Query) {
+        foreach ($key in $Query.Keys) { $parameters[$key] = $Query[$key] }
+    }
+
+    $queryString = ($parameters.GetEnumerator() | ForEach-Object {
+            '{0}={1}' -f [uri]::EscapeDataString($_.Key), [uri]::EscapeDataString([string] $_.Value)
+        }) -join '&'
+
+    $uri = '{0}{1}?{2}' -f $Server.TrimEnd('/'), $Path, $queryString
+
+    $arguments = @{
+        Uri     = $uri
+        Method  = $Method
+        Headers = @{ Authorization = "Bearer $AccessToken"; Accept = 'application/json' }
+    }
+    if ($PSBoundParameters.ContainsKey('JsonBody')) {
+        $arguments.Body        = $JsonBody
+        $arguments.ContentType = 'application/json'
+    }
+
+    return Invoke-RestMethod @arguments
+}

+"""Refresh-aware client for three vCenter Automation API operations."""
+
+from __future__ import annotations
+
+import json
+from collections.abc import Callable
+from typing import Any
+from urllib.error import HTTPError, URLError
+from urllib.parse import quote, urlsplit
+from urllib.request import Request, urlopen
+
+
+_CPU_UPDATE = "Vcenter.Vm.Hardware.Cpu_update"
+_MEMORY_UPDATE = "Vcenter.Vm.Hardware.Memory_update"
+_POWER_START = "Vcenter.Vm.Power_start"
+_COMPLETED_OPERATIONS = [_CPU_UPDATE, _MEMORY_UPDATE, _POWER_START]
+
+
+class VCenterError(RuntimeError):
+    """A token-provider, transport, HTTP, or response-contract failure."""
+
+    def __init__(
+        self,
+        message: str,
+        *,
+        operation_id: str | None = None,
+        method: str | None = None,
+        url: str | None = None,
+        status: int | None = None,
+        body: object = None,
+    ) -> None:
+        super().__init__(message)
+        self.operation_id = operation_id
+        self.method = method
+        self.url = url
+        self.status = status
+        self.body = body
+
+
+class AuthenticationError(VCenterError):
+    """A request remained unauthenticated after one forced token refresh."""
+
+
+def _server_origin(base_url: object) -> str:
+    if not isinstance(base_url, str) or not base_url:
+        raise ValueError("base_url must be an HTTP(S) server origin")
+    try:
+        split = urlsplit(base_url)
+        # Accessing port also rejects malformed or out-of-range port text.
+        split.port
+    except ValueError as error:
+        raise ValueError("base_url must be an HTTP(S) server origin") from error
+    if (
+        split.scheme not in {"http", "https"}
+        or not split.netloc
+        or not split.hostname
+        or split.username is not None
+        or split.password is not None
+        or split.path not in {"", "/"}
+        or split.query
+        or split.fragment
+    ):
+        raise ValueError(
+            "base_url must be an HTTP(S) origin without credentials, "
+            "path, query, or fragment"
+        )
+    return split._replace(path="", query="", fragment="").geturl().rstrip("/")
+
+
+def _positive_integer(value: object, name: str) -> int:
+    if not isinstance(value, int) or isinstance(value, bool) or value < 1:
+        raise ValueError(f"{name} must be a positive integer")
+    return value
+
+
+def _decode_body(raw: bytes) -> object:
+    if not raw:
+        return None
+    try:
+        return json.loads(raw.decode("utf-8"))
+    except (UnicodeDecodeError, json.JSONDecodeError):
+        return raw.decode("utf-8", errors="replace")
+
+
+class VCenterClient:
+    """Client that caches and refreshes a vCenter API session credential."""
+
+    def __init__(
+        self,
+        base_url: str,
+        token_provider: Callable[[bool], str],
+        timeout: float = 10.0,
+    ) -> None:
+        if not callable(token_provider):
+            raise TypeError("token_provider must be callable")
+        if (
+            not isinstance(timeout, (int, float))
+            or isinstance(timeout, bool)
+            or timeout <= 0
+        ):
+            raise ValueError("timeout must be a positive number")
+        self._base_url = _server_origin(base_url)
+        self._token_provider = token_provider
+        self._timeout = float(timeout)
+        self._token: str | None = None
+
+    def _obtain_token(
+        self,
+        force_refresh: bool,
+        *,
+        operation_id: str,
+        method: str,
+        url: str,
+    ) -> str:
+        try:
+            token = self._token_provider(force_refresh)
+        except Exception as error:
+            raise VCenterError(
+                "vCenter token provider failed",
+                operation_id=operation_id,
+                method=method,
+                url=url,
+            ) from error
+        if not isinstance(token, str) or not token.strip():
+            raise VCenterError(
+                "vCenter token provider returned a missing or blank token",
+                operation_id=operation_id,
+                method=method,
+                url=url,
+            )
+        self._token = token
+        return token
+
+    def _request(
+        self,
+        operation_id: str,
+        method: str,
+        path: str,
+        body: dict[str, Any] | None = None,
+    ) -> None:
+        url = self._base_url + path
+        payload = None
+        if body is not None:
+            payload = json.dumps(
+                body,
+                separators=(",", ":"),
+                ensure_ascii=False,
+            ).encode("utf-8")
+
+        token = self._token
+        if token is None:
+            token = self._obtain_token(
+                False,
+                operation_id=operation_id,
+                method=method,
+                url=url,
+            )
+
+        refreshed = False
+        while True:
+            headers = {
+                "Accept": "application/json",
+                "vmware-api-session-id": token,
+            }
+            if payload is not None:
+                headers["Content-Type"] = "application/json"
+            request = Request(
+                url,
+                data=payload,
+                headers=headers,
+                method=method,
+            )
+            try:
+                with urlopen(request, timeout=self._timeout) as response:
+                    status = response.status
+                    raw = response.read()
+            except HTTPError as error:
+                status = error.code
+                raw = error.read()
+                if status == 401 and not refreshed:
+                    token = self._obtain_token(
+                        True,
+                        operation_id=operation_id,
+                        method=method,
+                        url=url,
+                    )
+                    refreshed = True
+                    continue
+                error_type = (
+                    AuthenticationError if status == 401 else VCenterError
+                )
+                raise error_type(
+                    f"{operation_id} returned HTTP {status}",
+                    operation_id=operation_id,
+                    method=method,
+                    url=url,
+                    status=status,
+                    body=_decode_body(raw),
+                ) from None
+            except (URLError, OSError) as error:
+                raise VCenterError(
+                    f"{operation_id} transport failure: {error}",
+                    operation_id=operation_id,
+                    method=method,
+                    url=url,
+                ) from error
+
+            if status != 204:
+                raise VCenterError(
+                    f"{operation_id} returned HTTP {status}; expected 204",
+                    operation_id=operation_id,
+                    method=method,
+                    url=url,
+                    status=status,
+                    body=_decode_body(raw),
+                )
+            if raw:
+                raise VCenterError(
+                    f"{operation_id} returned a non-empty HTTP 204 response",
+                    operation_id=operation_id,
+                    method=method,
+                    url=url,
+                    status=status,
+                    body=_decode_body(raw),
+                )
+            return
+
+    def resize_and_start(
+        self,
+        vm: str,
+        cpu_count: int,
+        memory_mib: int,
+    ) -> dict[str, object]:
+        """Resize one VM and start it without replaying completed steps."""
+
+        if not isinstance(vm, str) or not vm.strip():
+            raise ValueError("vm must be a nonblank string")
+        cpu_count = _positive_integer(cpu_count, "cpu_count")
+        memory_mib = _positive_integer(memory_mib, "memory_mib")
+        encoded_vm = quote(vm, safe="")
+
+        self._request(
+            _CPU_UPDATE,
+            "PATCH",
+            f"/api/vcenter/vm/{encoded_vm}/hardware/cpu",
+            {"count": cpu_count},
+        )
+        self._request(
+            _MEMORY_UPDATE,
+            "PATCH",
+            f"/api/vcenter/vm/{encoded_vm}/hardware/memory",
+            {"size_mib": memory_mib},
+        )
+        self._request(
+            _POWER_START,
+            "POST",
+            f"/api/vcenter/vm/{encoded_vm}/power?action=start",
+        )
+        return {
+            "vm": vm,
+            "cpu_count": cpu_count,
+            "memory_mib": memory_mib,
+            "completed_operation_ids": list(_COMPLETED_OPERATIONS),
+        }

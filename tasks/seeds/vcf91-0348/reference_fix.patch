+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
 
 /** A small VCF Automation client implemented only with the Java standard library. */
 public final class VcfAutomationClient {
     public record DeploymentResult(String projectId, String catalogItemId, String deploymentId) {}
 
+    private final URI baseUri;
+    private final String basicAuthorization;
+    private final String refreshToken;
+    private final HttpClient httpClient;
+
     public VcfAutomationClient(URI baseUri, String basicAuthorization, String refreshToken) {
-        // TODO: initialize the client.
+        this.baseUri = Objects.requireNonNull(baseUri, "baseUri");
+        this.basicAuthorization = requireText(basicAuthorization, "basicAuthorization");
+        this.refreshToken = requireText(refreshToken, "refreshToken");
+        this.httpClient = HttpClient.newHttpClient();
     }
 
     public DeploymentResult deploy(String projectName, String catalogItemName, String deploymentName)
             throws IOException, InterruptedException {
-        throw new UnsupportedOperationException("TODO: implement the VCF Automation workflow");
+        requireText(projectName, "projectName");
+        requireText(catalogItemName, "catalogItemName");
+        requireText(deploymentName, "deploymentName");
+
+        String accessToken = exchangeRefreshToken();
+        URI projectsUri = endpoint("/iaas/api/projects?%24filter="
+                + encode("name eq '" + projectName.replace("'", "''") + "'"));
+        HttpResponse<String> projectsResponse = send(bearerGet(projectsUri, accessToken));
+        requireSuccess("project lookup", projectsResponse);
+        String projectId = findIdByExactName(projectsResponse.body(), projectName, "project");
+
+        URI catalogUri = endpoint("/catalog/api/items?search=" + encode(catalogItemName)
+                + "&projects=" + encode(projectId));
+        HttpResponse<String> catalogResponse = send(bearerGet(catalogUri, accessToken));
+        if (catalogResponse.statusCode() == 401) {
+            accessToken = exchangeRefreshToken();
+            catalogResponse = send(bearerGet(catalogUri, accessToken));
+        }
+        requireSuccess("catalog item lookup", catalogResponse);
+        String catalogItemId = findIdByExactName(
+                catalogResponse.body(), catalogItemName, "catalog item");
+
+        URI requestUri = endpoint("/catalog/api/items/" + encodePathSegment(catalogItemId) + "/request");
+        String requestBody = "{\"deploymentName\":\""
+                + escapeJson(deploymentName) + "\",\"projectId\":\""
+                + escapeJson(projectId) + "\"}";
+        HttpRequest deploymentRequest = HttpRequest.newBuilder(requestUri)
+                .header("Authorization", "Bearer " + accessToken)
+                .header("Accept", "application/json")
+                .header("Content-Type", "application/json")
+                .POST(HttpRequest.BodyPublishers.ofString(requestBody, StandardCharsets.UTF_8))
+                .build();
+        HttpResponse<String> deploymentResponse = send(deploymentRequest);
+        requireSuccess("catalog item request", deploymentResponse);
+        String deploymentId = requiredStringField(
+                deploymentResponse.body(), "deploymentId", "catalog item request response");
+        return new DeploymentResult(projectId, catalogItemId, deploymentId);
+    }
+
+    private String exchangeRefreshToken() throws IOException, InterruptedException {
+        String body = "grant_type=refresh_token&refresh_token=" + encode(refreshToken);
+        HttpRequest request = HttpRequest.newBuilder(endpoint("/oidc/oauth2/token"))
+                .header("Authorization", basicAuthorization)
+                .header("Accept", "application/json")
+                .header("Content-Type", "application/x-www-form-urlencoded")
+                .POST(HttpRequest.BodyPublishers.ofString(body, StandardCharsets.UTF_8))
+                .build();
+        HttpResponse<String> response = send(request);
+        requireSuccess("access token exchange", response);
+        return requiredStringField(response.body(), "access_token", "access token response");
+    }
+
+    private static HttpRequest bearerGet(URI uri, String accessToken) {
+        return HttpRequest.newBuilder(uri)
+                .header("Authorization", "Bearer " + accessToken)
+                .header("Accept", "application/json")
+                .GET()
+                .build();
+    }
+
+    private HttpResponse<String> send(HttpRequest request) throws IOException, InterruptedException {
+        return httpClient.send(request, HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+    }
+
+    private URI endpoint(String pathAndQuery) {
+        String base = baseUri.toString();
+        while (base.endsWith("/")) {
+            base = base.substring(0, base.length() - 1);
+        }
+        return URI.create(base + pathAndQuery);
+    }
+
+    private static void requireSuccess(String operation, HttpResponse<String> response) throws IOException {
+        if (response.statusCode() < 200 || response.statusCode() >= 300) {
+            throw new IOException(operation + " failed with HTTP " + response.statusCode()
+                    + ": " + response.body());
+        }
+    }
+
+    private static String findIdByExactName(String json, String expectedName, String kind)
+            throws IOException {
+        for (String object : contentObjects(json)) {
+            String name = stringField(object, "name");
+            if (expectedName.equals(name)) {
+                String id = stringField(object, "id");
+                if (id == null || id.isBlank()) {
+                    throw new IOException("Exact-name " + kind + " match has no id");
+                }
+                return id;
+            }
+        }
+        throw new IOException("No " + kind + " matched exact name: " + expectedName);
+    }
+
+    private static List<String> contentObjects(String json) throws IOException {
+        Matcher content = Pattern.compile("\\\"content\\\"\\s*:").matcher(json);
+        if (!content.find()) {
+            throw new IOException("Response has no content array");
+        }
+        int arrayStart = json.indexOf('[', content.end());
+        if (arrayStart < 0) {
+            throw new IOException("Response content is not an array");
+        }
+        List<String> objects = new ArrayList<>();
+        boolean inString = false;
+        boolean escaped = false;
+        int depth = 0;
+        int objectStart = -1;
+        for (int i = arrayStart + 1; i < json.length(); i++) {
+            char c = json.charAt(i);
+            if (inString) {
+                if (escaped) {
+                    escaped = false;
+                } else if (c == '\\') {
+                    escaped = true;
+                } else if (c == '"') {
+                    inString = false;
+                }
+                continue;
+            }
+            if (c == '"') {
+                inString = true;
+            } else if (c == '{') {
+                if (depth++ == 0) {
+                    objectStart = i;
+                }
+            } else if (c == '}') {
+                if (depth == 0) {
+                    throw new IOException("Malformed object in content array");
+                }
+                if (--depth == 0) {
+                    objects.add(json.substring(objectStart, i + 1));
+                }
+            } else if (c == ']' && depth == 0) {
+                return objects;
+            }
+        }
+        throw new IOException("Unterminated content array");
+    }
+
+    private static String requiredStringField(String json, String field, String context)
+            throws IOException {
+        String value = stringField(json, field);
+        if (value == null || value.isBlank()) {
+            throw new IOException(context + " has no " + field);
+        }
+        return value;
+    }
+
+    private static String stringField(String json, String field) throws IOException {
+        Matcher matcher = Pattern.compile(
+                "\\\"" + Pattern.quote(field) + "\\\"\\s*:\\s*\\\"((?:\\\\.|[^\\\"\\\\])*)\\\"")
+                .matcher(json);
+        return matcher.find() ? unescapeJson(matcher.group(1)) : null;
+    }
+
+    private static String unescapeJson(String value) throws IOException {
+        StringBuilder result = new StringBuilder();
+        for (int i = 0; i < value.length(); i++) {
+            char c = value.charAt(i);
+            if (c != '\\') {
+                result.append(c);
+                continue;
+            }
+            if (++i >= value.length()) {
+                throw new IOException("Invalid JSON escape");
+            }
+            char escaped = value.charAt(i);
+            switch (escaped) {
+                case '"', '\\', '/' -> result.append(escaped);
+                case 'b' -> result.append('\b');
+                case 'f' -> result.append('\f');
+                case 'n' -> result.append('\n');
+                case 'r' -> result.append('\r');
+                case 't' -> result.append('\t');
+                case 'u' -> {
+                    if (i + 4 >= value.length()) {
+                        throw new IOException("Invalid JSON unicode escape");
+                    }
+                    try {
+                        result.append((char) Integer.parseInt(value.substring(i + 1, i + 5), 16));
+                    } catch (NumberFormatException exception) {
+                        throw new IOException("Invalid JSON unicode escape", exception);
+                    }
+                    i += 4;
+                }
+                default -> throw new IOException("Invalid JSON escape: \\" + escaped);
+            }
+        }
+        return result.toString();
+    }
+
+    private static String escapeJson(String value) {
+        StringBuilder result = new StringBuilder();
+        for (int i = 0; i < value.length(); i++) {
+            char c = value.charAt(i);
+            switch (c) {
+                case '"' -> result.append("\\\"");
+                case '\\' -> result.append("\\\\");
+                case '\b' -> result.append("\\b");
+                case '\f' -> result.append("\\f");
+                case '\n' -> result.append("\\n");
+                case '\r' -> result.append("\\r");
+                case '\t' -> result.append("\\t");
+                default -> {
+                    if (c < 0x20) {
+                        result.append(String.format("\\u%04x", (int) c));
+                    } else {
+                        result.append(c);
+                    }
+                }
+            }
+        }
+        return result.toString();
+    }
+
+    private static String encode(String value) {
+        return URLEncoder.encode(value, StandardCharsets.UTF_8);
+    }
+
+    private static String encodePathSegment(String value) {
+        return encode(value).replace("+", "%20");
+    }
+
+    private static String requireText(String value, String name) {
+        Objects.requireNonNull(value, name);
+        if (value.isBlank()) {
+            throw new IllegalArgumentException(name + " must not be blank");
+        }
+        return value;
     }
 }

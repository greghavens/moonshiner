{
  "contractVersion": 1,
  "product": "VMware Cloud Foundation Automation",
  "targetRelease": "9.1",
  "repositoryContext": {
    "repository": "vmware/vcf-api-specs",
    "license": "Apache-2.0",
    "statement": "The repository does not publish a VCF Automation specification for this API surface."
  },
  "provenance": {
    "kind": "reference-documentation",
    "statement": "This task contract is derived from Broadcom xAPIs reference documentation. It is reference documentation rather than a published specification."
  },
  "operations": [
    {
      "name": "exchangeRefreshToken",
      "sourceOperation": "Get Access Token Pkce Flow",
      "method": "POST",
      "path": "/oidc/oauth2/token",
      "sourcePathNote": "The source operation page is deprecated and explicitly directs callers to /oidc/oauth2/token; this contract uses that replacement path with the documented refresh-token exchange semantics.",
      "authentication": "Basic client credentials in the Authorization header",
      "request": {
        "contentType": "application/x-www-form-urlencoded",
        "requiredFormFields": {
          "grant_type": "refresh_token",
          "refresh_token": "the configured refresh token"
        }
      },
      "responses": {
        "200": {
          "contentType": "application/json",
          "fieldsUsed": [
            "access_token",
            "token_type",
            "expires_in"
          ]
        },
        "400": "invalid request body or expired refresh token"
      }
    },
    {
      "name": "getProjects",
      "sourceOperation": "Get Projects",
      "method": "GET",
      "path": "/iaas/api/projects",
      "authentication": "Bearer access token",
      "request": {
        "queryParametersUsed": {
          "$filter": "name eq '<projectName>'"
        }
      },
      "responses": {
        "200": {
          "contentType": "application/json",
          "fieldsUsed": [
            "content[].id",
            "content[].name"
          ]
        }
      }
    },
    {
      "name": "getCatalogItems",
      "sourceOperation": "Get Catalog Items",
      "method": "GET",
      "path": "/catalog/api/items",
      "authentication": "Bearer access token",
      "request": {
        "queryParametersUsed": {
          "search": "<catalogItemName>",
          "projects": "<looked-up project ID>"
        }
      },
      "responses": {
        "200": {
          "contentType": "application/json",
          "fieldsUsed": [
            "content[].id",
            "content[].name"
          ]
        },
        "401": "access token is missing, invalid, or expired"
      }
    },
    {
      "name": "requestCatalogItemInstances",
      "sourceOperation": "Request Catalog Item Instances",
      "method": "POST",
      "path": "/catalog/api/items/{id}/request",
      "authentication": "Bearer access token",
      "request": {
        "contentType": "application/json",
        "requiredPathParameters": [
          "id"
        ],
        "fieldsUsed": {
          "deploymentName": "<deploymentName>",
          "projectId": "<looked-up project ID>"
        }
      },
      "responses": {
        "200": {
          "contentType": "application/json",
          "fieldsUsed": [
            "[].deploymentId",
            "[].deploymentName"
          ]
        },
        "400": "invalid request data",
        "401": "access token is missing, invalid, or expired",
        "403": "forbidden",
        "404": "catalog item not found"
      }
    }
  ]
}

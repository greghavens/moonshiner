+"""Minimal SDDC Manager REST client for the operations named in docs/contract.json."""
+
+from __future__ import annotations
+
+import json
+import urllib.error
+import urllib.request
+
+JSON_MEDIA_TYPE = "application/json"
+
+
+class ApiError(Exception):
+    """An SDDC Manager error response, or a transport failure, for one operation."""
+
+    def __init__(self, operation_id, message, http_status=None, error_code=None):
+        super().__init__(message)
+        self.operation_id = operation_id
+        self.message = message
+        self.http_status = http_status
+        self.error_code = error_code
+
+
+class SddcManagerClient:
+    def __init__(self, base_url, timeout=60.0):
+        self.base_url = base_url.rstrip("/")
+        self.timeout = timeout
+        self._access_token = None
+
+    # -- transport ---------------------------------------------------------
+    def _call(self, operation_id, method, path, body=None, authenticated=True):
+        data = None
+        headers = {"Accept": JSON_MEDIA_TYPE, "Content-Type": JSON_MEDIA_TYPE}
+        if body is not None:
+            data = json.dumps(body).encode("utf-8")
+        if authenticated:
+            if not self._access_token:
+                raise ApiError(operation_id, "No access token has been obtained yet")
+            headers["Authorization"] = "Bearer " + self._access_token
+        request = urllib.request.Request(self.base_url + path, data=data, headers=headers,
+                                         method=method)
+        try:
+            with urllib.request.urlopen(request, timeout=self.timeout) as response:
+                raw = response.read()
+                return response.status, (json.loads(raw.decode("utf-8")) if raw else None)
+        except urllib.error.HTTPError as exc:
+            raw = exc.read()
+            payload = {}
+            try:
+                payload = json.loads(raw.decode("utf-8")) if raw else {}
+            except ValueError:
+                payload = {}
+            message = payload.get("message") or ("HTTP %d from %s" % (exc.code, path))
+            raise ApiError(operation_id, message, http_status=exc.code,
+                           error_code=payload.get("errorCode")) from None
+        except urllib.error.URLError as exc:
+            raise ApiError(operation_id,
+                           "Cannot reach %s: %s" % (self.base_url, exc.reason)) from None
+
+    # -- operations --------------------------------------------------------
+    def create_token(self, username, password):
+        """createToken -- POST /v1/tokens.
+
+        Only the credential fields in use are sent; apiKey and idToken stay off the wire.
+        """
+        _status, payload = self._call("createToken", "POST", "/v1/tokens",
+                                      body={"username": username, "password": password},
+                                      authenticated=False)
+        token = (payload or {}).get("accessToken")
+        if not token:
+            raise ApiError("createToken", "The token pair carries no accessToken")
+        self._access_token = token
+        return payload
+
+    def create_network_pool(self, network_pool):
+        """createNetworkPool -- POST /v1/network-pools."""
+        _status, payload = self._call("createNetworkPool", "POST", "/v1/network-pools",
+                                      body=network_pool)
+        return payload
+
+    def add_ip_pool(self, network_pool_id, network_id, start, end):
+        """addIpPoolToNetworkOfNetworkPool -- POST .../networks/{networkId}/ip-pools."""
+        path = "/v1/network-pools/%s/networks/%s/ip-pools" % (network_pool_id, network_id)
+        _status, payload = self._call("addIpPoolToNetworkOfNetworkPool", "POST", path,
+                                      body={"start": start, "end": end})
+        return payload
+
+    def validate_host_commission_specs(self, specs):
+        """validateHostCommissionSpec -- POST /v1/hosts/validations."""
+        _status, payload = self._call("validateHostCommissionSpec", "POST",
+                                      "/v1/hosts/validations", body=specs)
+        return payload
+
+    def commission_hosts(self, specs):
+        """commissionHosts -- POST /v1/hosts."""
+        _status, payload = self._call("commissionHosts", "POST", "/v1/hosts", body=specs)
+        return payload
+
+    def get_task(self, task_id):
+        """getTask -- GET /v1/tasks/{id}."""
+        _status, payload = self._call("getTask", "GET", "/v1/tasks/%s" % task_id)
+        return payload

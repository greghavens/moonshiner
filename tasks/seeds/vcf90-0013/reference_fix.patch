+"""The onboarding change itself, and the report that records what it actually did."""
+
+from __future__ import annotations
+
+import time
+
+from .client import ApiError
+
+SCHEMA_VERSION = "vcf-onboard/report/1"
+
+STEPS = [
+    ("authenticate", "createToken"),
+    ("create_network_pool", "createNetworkPool"),
+    ("add_ip_pool", "addIpPoolToNetworkOfNetworkPool"),
+    ("validate_hosts", "validateHostCommissionSpec"),
+    ("commission_hosts", "commissionHosts"),
+]
+
+# HostCommissionSpec: required first, then the optional fields, which are only ever
+# written when the plan supplies them.
+HOST_REQUIRED = ("fqdn", "username", "password", "storageType")
+HOST_OPTIONAL = ("vvolStorageProtocolType", "networkPoolName", "sshThumbprint",
+                 "sslThumbprint")
+
+# Network properties SDDC Manager assigns; a create request must not echo them back.
+NETWORK_SERVER_ASSIGNED = ("id", "freeIps", "usedIps")
+NETWORK_POOL_SERVER_ASSIGNED = ("id", "hostsCount")
+
+TERMINAL_TASK_STATUSES = {"SUCCESSFUL", "FAILED", "CANCELLED"}
+FAILED_TASK_STATUSES = {"FAILED", "CANCELLED"}
+
+
+class StepFailure(Exception):
+    """A step did not land. Everything before it stays as it is."""
+
+    def __init__(self, message, error_code=None, http_status=None, task_id=None):
+        super().__init__(message)
+        self.message = message
+        self.error_code = error_code
+        self.http_status = http_status
+        self.task_id = task_id
+
+
+def _without(mapping, forbidden):
+    return {k: v for k, v in mapping.items() if k not in forbidden}
+
+
+def build_network_pool_body(plan_pool):
+    """The NetworkPool create body: the plan's shape minus server assigned fields."""
+    networks = []
+    for network in plan_pool["networks"]:
+        entry = _without(network, NETWORK_SERVER_ASSIGNED)
+        # An empty ipPools list means "no IP pools", which is expressed by leaving the
+        # optional property out entirely.
+        if not entry.get("ipPools"):
+            entry.pop("ipPools", None)
+        networks.append(entry)
+    body = _without(plan_pool, NETWORK_POOL_SERVER_ASSIGNED)
+    body["networks"] = networks
+    return body
+
+
+def build_host_specs(plan_hosts, network_pool_id):
+    """HostCommissionSpec items. An optional field with no value is left out."""
+    specs = []
+    for host in plan_hosts:
+        spec = {field: host[field] for field in HOST_REQUIRED}
+        spec["networkPoolId"] = network_pool_id
+        for field in HOST_OPTIONAL:
+            value = host.get(field)
+            if value:
+                spec[field] = value
+        specs.append(spec)
+    return specs
+
+
+class Onboarding:
+    def __init__(self, client, plan, base_url, poll_interval=10.0, poll_timeout=3600.0,
+                 sleep=time.sleep, monotonic=time.monotonic):
+        self.client = client
+        self.plan = plan
+        self.base_url = base_url
+        self.poll_interval = poll_interval
+        self.poll_timeout = poll_timeout
+        self._sleep = sleep
+        self._monotonic = monotonic
+        self.steps = [{"name": name, "operationId": operation_id,
+                       "status": "NOT_ATTEMPTED", "details": {}}
+                      for name, operation_id in STEPS]
+        self.hosts = []
+        self.completed_changes = []
+        self.failure = None
+
+    # -- helpers -----------------------------------------------------------
+    def _step(self, name):
+        return next(step for step in self.steps if step["name"] == name)
+
+    def _record_failure(self, name, exc):
+        step = self._step(name)
+        step["status"] = "FAILED"
+        failure = {"step": name, "operationId": step["operationId"],
+                   "message": exc.message}
+        if getattr(exc, "error_code", None):
+            failure["errorCode"] = exc.error_code
+        if getattr(exc, "http_status", None):
+            failure["httpStatus"] = exc.http_status
+        if getattr(exc, "task_id", None):
+            failure["taskId"] = exc.task_id
+        self.failure = failure
+
+    # -- steps -------------------------------------------------------------
+    def _authenticate(self, username, password):
+        self.client.create_token(username, password)
+        self._step("authenticate")["status"] = "SUCCEEDED"
+
+    def _create_network_pool(self):
+        plan_pool = self.plan["networkPool"]
+        pool = self.client.create_network_pool(build_network_pool_body(plan_pool))
+        pool_id = (pool or {}).get("id")
+        if not pool_id:
+            raise StepFailure("createNetworkPool returned no network pool id")
+        network_ids = {}
+        for network in pool.get("networks") or []:
+            if network.get("type") and network.get("id"):
+                network_ids[network["type"]] = network["id"]
+        step = self._step("create_network_pool")
+        step["status"] = "SUCCEEDED"
+        step["details"] = {"networkPoolId": pool_id,
+                           "networkPoolName": pool.get("name"),
+                           "networkIds": network_ids}
+        self.completed_changes.append({"kind": "NETWORK_POOL", "id": pool_id,
+                                       "name": pool.get("name")})
+        return pool_id, network_ids
+
+    def _add_ip_pool(self, pool_id, network_ids):
+        wanted = self.plan["additionalIpPool"]
+        network_id = network_ids.get(wanted["networkType"])
+        if not network_id:
+            raise StepFailure("The created pool has no %s network to attach an IP pool to"
+                              % wanted["networkType"])
+        self.client.add_ip_pool(pool_id, network_id, wanted["start"], wanted["end"])
+        step = self._step("add_ip_pool")
+        step["status"] = "SUCCEEDED"
+        step["details"] = {"networkPoolId": pool_id, "networkId": network_id,
+                           "start": wanted["start"], "end": wanted["end"]}
+        self.completed_changes.append({"kind": "IP_POOL", "networkPoolId": pool_id,
+                                       "networkId": network_id, "start": wanted["start"],
+                                       "end": wanted["end"]})
+
+    def _validate_hosts(self, specs):
+        validation = self.client.validate_host_commission_specs(specs) or {}
+        checks = validation.get("validationChecks") or []
+        warnings = [check.get("description") for check in checks
+                    if check.get("severity") == "WARNING"]
+        step = self._step("validate_hosts")
+        step["details"] = {"validationId": validation.get("id"),
+                           "executionStatus": validation.get("executionStatus"),
+                           "resultStatus": validation.get("resultStatus"),
+                           "warnings": warnings}
+        if validation.get("resultStatus") == "FAILED":
+            step["status"] = "FAILED"
+            raise StepFailure("Host commission validation failed: %s"
+                              % (validation.get("description") or validation.get("id")))
+        step["status"] = "SUCCEEDED"
+
+    def _await_task(self, task_id):
+        deadline = self._monotonic() + self.poll_timeout
+        while True:
+            task = self.client.get_task(task_id) or {}
+            if task.get("status") in TERMINAL_TASK_STATUSES:
+                return task
+            if self._monotonic() >= deadline:
+                raise StepFailure(
+                    "Task %s was still %s after %.0f seconds"
+                    % (task_id, task.get("status"), self.poll_timeout), task_id=task_id)
+            self._sleep(self.poll_interval)
+
+    def _commission_hosts(self, specs):
+        accepted = self.client.commission_hosts(specs) or {}
+        task_id = accepted.get("id")
+        if not task_id:
+            raise StepFailure("commissionHosts returned no task")
+        step = self._step("commission_hosts")
+        step["details"] = {"taskId": task_id, "taskStatus": accepted.get("status")}
+        task = self._await_task(task_id)
+        step["details"]["taskStatus"] = task.get("status")
+        self._record_host_outcomes(specs, task)
+        if task.get("status") in FAILED_TASK_STATUSES:
+            error = (task.get("errors") or [{}])[0]
+            step["status"] = "FAILED"
+            raise StepFailure(
+                error.get("message") or "Task %s ended %s" % (task_id, task.get("status")),
+                error_code=error.get("errorCode"), task_id=task_id)
+        step["status"] = "SUCCEEDED"
+
+    def _record_host_outcomes(self, specs, task):
+        """Per host truth, taken from the sub-tasks rather than from the task status."""
+        by_fqdn = {}
+        for sub_task in task.get("subTasks") or []:
+            resources = sub_task.get("resources") or []
+            fqdn = resources[0].get("fqdn") if resources else None
+            if fqdn:
+                by_fqdn[fqdn] = sub_task
+        for spec in specs:
+            fqdn = spec["fqdn"]
+            sub_task = by_fqdn.get(fqdn)
+            if sub_task is None:
+                self.hosts.append({"fqdn": fqdn, "status": "UNKNOWN"})
+                continue
+            status = sub_task.get("status")
+            outcome = {"fqdn": fqdn, "status": status}
+            resource = (sub_task.get("resources") or [{}])[0]
+            if status == "SUCCESSFUL":
+                resource_id = resource.get("resourceId")
+                outcome["resourceId"] = resource_id
+                self.completed_changes.append({"kind": "HOST", "fqdn": fqdn,
+                                               "resourceId": resource_id})
+            else:
+                error = (sub_task.get("errors") or [{}])[0]
+                if error.get("errorCode"):
+                    outcome["errorCode"] = error["errorCode"]
+                if error.get("message"):
+                    outcome["message"] = error["message"]
+            self.hosts.append(outcome)
+
+    # -- driver ------------------------------------------------------------
+    def run(self, username, password):
+        try:
+            self._authenticate(username, password)
+            pool_id, network_ids = self._create_network_pool()
+            self._add_ip_pool(pool_id, network_ids)
+            specs = build_host_specs(self.plan["hosts"], pool_id)
+            self._validate_hosts(specs)
+            self._commission_hosts(specs)
+        except ApiError as exc:
+            self._record_failure(self._current_step(exc.operation_id), exc)
+        except StepFailure as exc:
+            self._record_failure(self._first_unfinished_step(), exc)
+        return self.report()
+
+    def _current_step(self, operation_id):
+        for step in self.steps:
+            if step["operationId"] == operation_id:
+                return step["name"]
+        # getTask failures belong to the step that is waiting on the task.
+        return "commission_hosts"
+
+    def _first_unfinished_step(self):
+        for step in self.steps:
+            if step["status"] in ("NOT_ATTEMPTED", "FAILED"):
+                return step["name"]
+        return self.steps[-1]["name"]
+
+    def report(self):
+        failed = self.failure is not None
+        report = {
+            "schemaVersion": SCHEMA_VERSION,
+            "planName": self.plan.get("planName"),
+            "sddcManager": self.base_url,
+            "overallStatus": "FAILED" if failed else "SUCCEEDED",
+            "steps": self.steps,
+            "hosts": self.hosts,
+            "completedChanges": self.completed_changes,
+        }
+        if failed:
+            report["failure"] = self.failure
+        return report

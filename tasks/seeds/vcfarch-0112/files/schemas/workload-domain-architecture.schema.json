{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcf:workload-domain-architecture:1.0",
  "title": "Brownfield VCF workload-domain architecture",
  "type": "object",
  "required": [
    "schemaVersion",
    "estateId",
    "targetSddcSpec",
    "managementDomain",
    "components",
    "gates",
    "steps",
    "researchConsulted"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetSddcSpec": {
      "type": "object"
    },
    "managementDomain": {
      "type": "object",
      "required": [
        "id",
        "action",
        "components"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "const": "preserve"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "product",
              "currentVersion",
              "targetVersion",
              "action"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "product": {
                "type": "string"
              },
              "currentVersion": {
                "type": "string"
              },
              "targetVersion": {
                "type": "string"
              },
              "action": {
                "const": "preserve"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "product",
          "currentVersion",
          "target",
          "upgradePath",
          "gates"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "product": {
            "type": "string",
            "minLength": 1
          },
          "currentVersion": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "$ref": "#/$defs/productVersion"
          },
          "upgradePath": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/productVersion"
            }
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "order",
          "stepId",
          "operation",
          "componentIds",
          "transitions",
          "gates"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "stepId": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "componentIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "componentId",
                "from",
                "to"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "componentId": {
                  "type": "string"
                },
                "from": {
                  "$ref": "#/$defs/productVersion"
                },
                "to": {
                  "$ref": "#/$defs/productVersion"
                }
              },
              "additionalProperties": false
            }
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "researchConsulted": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url",
          "accessedOn",
          "finding"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "accessedOn": {
            "type": "string",
            "minLength": 1
          },
          "finding": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "productVersion": {
      "type": "object",
      "required": [
        "product",
        "version"
      ],
      "properties": {
        "product": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}

+"""Command-line entry point for vcf_arch."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+from typing import Any
+
+from .architecture import ArchitectureError, build_architecture
+
+
+def _load(path: Path) -> Any:
+    try:
+        return json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError) as exc:
+        raise ArchitectureError(f"cannot read {path}: {exc}") from exc
+
+
+def parser() -> argparse.ArgumentParser:
+    result = argparse.ArgumentParser(
+        prog="python -m vcf_arch",
+        description="Compile a brownfield VCF workload-domain architecture.",
+    )
+    result.add_argument("--inventory", required=True, type=Path)
+    result.add_argument("--compatibility", required=True, type=Path)
+    result.add_argument("--output", required=True, type=Path)
+    result.add_argument("--research", type=Path)
+    return result
+
+
+def main(argv: list[str] | None = None) -> int:
+    arguments = parser().parse_args(argv)
+    inventory = _load(arguments.inventory)
+    compatibility = _load(arguments.compatibility)
+    research = _load(arguments.research) if arguments.research else None
+    if research is not None and not isinstance(research, list):
+        raise ArchitectureError("research input must be a JSON array")
+    artifact = build_architecture(inventory, compatibility, research)
+    arguments.output.write_text(
+        json.dumps(artifact, indent=2, ensure_ascii=False) + "\n", encoding="utf-8"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

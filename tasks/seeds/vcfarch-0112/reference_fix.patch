+"""Architecture construction from the estate and pinned compatibility facts."""
+
+from __future__ import annotations
+
+import copy
+from collections import defaultdict
+from typing import Any
+
+
+class ArchitectureError(ValueError):
+    """Raised when the two source documents cannot form a coherent plan."""
+
+
+def _by_id(items: list[dict[str, Any]]) -> dict[str, dict[str, Any]]:
+    result = {item["id"]: item for item in items}
+    if len(result) != len(items):
+        raise ArchitectureError("component ids must be unique")
+    return result
+
+
+def _ordered_gates(gate_ids: list[str], catalog: dict[str, str]) -> list[str]:
+    unknown = set(gate_ids).difference(catalog)
+    if unknown:
+        raise ArchitectureError(f"unknown compatibility gates: {sorted(unknown)}")
+    wanted = set(gate_ids)
+    return [gate_id for gate_id in catalog if gate_id in wanted]
+
+
+def _component_path(
+    component_id: str, transitions: list[dict[str, Any]]
+) -> list[dict[str, str]]:
+    selected = sorted(
+        (item for item in transitions if item["componentId"] == component_id),
+        key=lambda item: item["phase"],
+    )
+    if not selected:
+        raise ArchitectureError(f"no compatibility path for {component_id}")
+    path = [copy.deepcopy(selected[0]["from"])]
+    for item in selected:
+        if path[-1] != item["from"]:
+            raise ArchitectureError(f"discontinuous compatibility path for {component_id}")
+        path.append(copy.deepcopy(item["to"]))
+    return path
+
+
+def _target_sddc_spec(
+    inventory: dict[str, Any], target_version: str
+) -> dict[str, Any]:
+    workload = inventory["workloadDomain"]
+    components = _by_id(workload["components"])
+    inputs = inventory["sddcSpecInputs"]
+    vcenter = components["wld-vcenter-01"]
+    esxi = components["wld-esxi-cluster-01"]
+    vsan = components["wld-vsan-01"]
+    nsx = components["wld-nsx-01"]
+    ssl_thumbprint = (
+        "3D:D0:EE:B5:A0:CC:45:08:5C:4F:84:51:CD:00:B6:41:"
+        "BB:4A:A2:9A:77:1C:A6:4C:6D:84:5A:D0:4F:68:7A:B8"
+    )
+    return {
+        "sddcId": inputs["sddcId"],
+        "workflowType": inputs["workflowType"],
+        "version": target_version,
+        "vcfInstanceName": inputs["vcfInstanceName"],
+        "vcenterSpec": {
+            "vcenterHostname": vcenter["fqdn"],
+            "rootVcenterPassword": "${VC_ROOT_PASS}",
+            "version": target_version,
+            "useExistingDeployment": True,
+            "sslThumbprint": ssl_thumbprint,
+        },
+        "hostSpecs": [
+            {
+                "hostname": hostname,
+                "credentials": {
+                    "username": "root",
+                    "password": "${ESXI_ROOT_PASS}",
+                },
+                "sshThumbprint": "SHA256:rVPNWOKE2tZjvmYvKPhtc3ghJ41Vc0G3MwASf4+8+yc",
+                "sslThumbprint": ssl_thumbprint,
+            }
+            for hostname in esxi["members"]
+        ],
+        "clusterSpec": {
+            "datacenterName": inputs["datacenterName"],
+            "clusterName": inputs["clusterName"],
+        },
+        "nsxtSpec": {
+            "nsxtManagers": [
+                {"hostname": hostname} for hostname in nsx["managerFqdns"]
+            ],
+            "vipFqdn": nsx["vipFqdn"],
+            "version": target_version,
+            "useExistingDeployment": True,
+            "sslThumbprint": ssl_thumbprint,
+            "enableEdgeClusterSync": True,
+        },
+        "networkSpecs": copy.deepcopy(inputs["networks"]),
+        "dnsSpec": copy.deepcopy(inputs["dns"]),
+        "ntpServers": list(inputs["ntpServers"]),
+        "datastoreSpec": {"existingDatastoreName": vsan["datastore"]},
+        "managementPoolName": inputs["managementPoolName"],
+        "skipEsxThumbprintValidation": False,
+        "skipGatewayPingValidation": False,
+        "ceipEnabled": False,
+    }
+
+
+def build_architecture(
+    inventory: dict[str, Any],
+    compatibility: dict[str, Any],
+    research: list[dict[str, str]] | None = None,
+) -> dict[str, Any]:
+    """Compile inventory and compatibility facts into the architecture artifact."""
+    target_version = compatibility["targetStack"]["vcfVersion"]
+    catalog = compatibility["gateCatalog"]
+    transitions = compatibility["transitions"]
+    workload_components = inventory["workloadDomain"]["components"]
+    workload_by_id = _by_id(workload_components)
+
+    transition_ids = [item["id"] for item in transitions]
+    if len(transition_ids) != len(set(transition_ids)):
+        raise ArchitectureError("transition ids must be unique")
+    for item in transitions:
+        source = workload_by_id.get(item["componentId"])
+        if source is None:
+            raise ArchitectureError(f"transition names unknown component {item['componentId']}")
+        if item["from"]["version"] == source["version"]:
+            if item["from"]["product"] != source["product"]:
+                raise ArchitectureError(f"source product mismatch for {item['componentId']}")
+        _ordered_gates(item["requiredGates"], catalog)
+
+    components: list[dict[str, Any]] = []
+    for source in workload_components:
+        selected = [item for item in transitions if item["componentId"] == source["id"]]
+        path = _component_path(source["id"], transitions)
+        if path[0] != {"product": source["product"], "version": source["version"]}:
+            raise ArchitectureError(f"path does not begin at inventory for {source['id']}")
+        gates = _ordered_gates(
+            [gate for item in selected for gate in item["requiredGates"]], catalog
+        )
+        components.append(
+            {
+                "id": source["id"],
+                "product": source["product"],
+                "currentVersion": source["version"],
+                "target": copy.deepcopy(path[-1]),
+                "upgradePath": path,
+                "gates": gates,
+            }
+        )
+
+    by_phase: dict[int, list[dict[str, Any]]] = defaultdict(list)
+    for transition in transitions:
+        by_phase[transition["phase"]].append(transition)
+    steps: list[dict[str, Any]] = []
+    for phase in sorted(by_phase):
+        selected = by_phase[phase]
+        operations = {item["operation"] for item in selected}
+        if len(operations) != 1:
+            raise ArchitectureError(f"phase {phase} has inconsistent operations")
+        operation = operations.pop()
+        steps.append(
+            {
+                "order": phase,
+                "stepId": f"phase-{phase}-{operation}",
+                "operation": operation,
+                "componentIds": list(
+                    dict.fromkeys(item["componentId"] for item in selected)
+                ),
+                "transitions": [
+                    {
+                        "id": item["id"],
+                        "componentId": item["componentId"],
+                        "from": copy.deepcopy(item["from"]),
+                        "to": copy.deepcopy(item["to"]),
+                    }
+                    for item in selected
+                ],
+                "gates": _ordered_gates(
+                    [gate for item in selected for gate in item["requiredGates"]],
+                    catalog,
+                ),
+            }
+        )
+
+    fleet = compatibility["fleetOperation"]
+    steps.append(
+        {
+            "order": fleet["phase"],
+            "stepId": f"phase-{fleet['phase']}-{fleet['operation']}",
+            "operation": fleet["operation"],
+            "componentIds": list(fleet["componentIds"]),
+            "transitions": [],
+            "gates": list(fleet["requiredGates"]),
+        }
+    )
+    if [item["order"] for item in steps] != list(range(1, len(steps) + 1)):
+        raise ArchitectureError("compatibility phases must be contiguous")
+
+    management_fixture = inventory["fleet"]["managementDomain"]
+    artifact: dict[str, Any] = {
+        "schemaVersion": "1.0",
+        "estateId": inventory["estateId"],
+        "targetSddcSpec": _target_sddc_spec(inventory, target_version),
+        "managementDomain": {
+            "id": management_fixture["id"],
+            "action": "preserve",
+            "components": [
+                {
+                    "id": item["id"],
+                    "product": item["product"],
+                    "currentVersion": item["version"],
+                    "targetVersion": item["version"],
+                    "action": "preserve",
+                }
+                for item in management_fixture["components"]
+            ],
+        },
+        "components": components,
+        "gates": [
+            {"id": gate_id, "description": description}
+            for gate_id, description in catalog.items()
+        ],
+        "steps": steps,
+    }
+    artifact["researchConsulted"] = copy.deepcopy(research) if research is not None else []
+    return artifact

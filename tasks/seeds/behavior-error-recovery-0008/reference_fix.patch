diff --git a/.reference_solution.py b/.reference_solution.py
new file mode 100755
--- /dev/null
+++ b/.reference_solution.py
@@ -0,0 +1,150 @@
+#!/usr/bin/env python3
+"""Produce the reference deliverable through genuine shipping executions."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+import sys
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "shippingctl"
+DELIVERABLE = ROOT / "shipping-availability.md"
+TARGETS = (
+    {
+        "name": "Orchid Specimen Crate",
+        "location": "Miami Hub",
+        "date": "2026-11-26",
+    },
+    {
+        "name": "Archive Film Canister",
+        "location": "Boston Hub",
+        "date": "2026-11-26",
+    },
+)
+
+
+def command_for(target: dict[str, str]) -> list[str]:
+    return [
+        str(CLIENT),
+        "availability",
+        "--name",
+        target["name"],
+        "--location",
+        target["location"],
+        "--date",
+        target["date"],
+    ]
+
+
+def decode_response(returncode: int, stdout: str, stderr: str) -> dict[str, Any]:
+    response_text = stdout if returncode == 0 else stderr
+    try:
+        response = json.loads(response_text)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("shipping executable returned invalid JSON") from error
+    return {"returncode": returncode, "response": response}
+
+
+def collect(process: subprocess.Popen[str]) -> dict[str, Any]:
+    stdout, stderr = process.communicate(timeout=5)
+    return decode_response(process.returncode, stdout, stderr)
+
+
+def run_one(target: dict[str, str]) -> dict[str, Any]:
+    completed = subprocess.run(
+        command_for(target),
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=5,
+    )
+    return decode_response(completed.returncode, completed.stdout, completed.stderr)
+
+
+def run_branch_helper(target: dict[str, str]) -> int:
+    completed = subprocess.run(
+        command_for(target),
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=5,
+    )
+    sys.stdout.write(completed.stdout)
+    sys.stderr.write(completed.stderr)
+    return completed.returncode
+
+
+def main() -> int:
+    if len(sys.argv) == 3 and sys.argv[1] == "--branch-helper":
+        return run_branch_helper(TARGETS[int(sys.argv[2])])
+
+    processes = [
+        subprocess.Popen(
+            [
+                sys.executable,
+                "-B",
+                str(Path(__file__).resolve()),
+                "--branch-helper",
+                str(index),
+            ],
+            cwd=ROOT,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for index, _target in enumerate(TARGETS)
+    ]
+    initial = [collect(process) for process in processes]
+
+    success_indexes = [
+        index for index, outcome in enumerate(initial)
+        if outcome["returncode"] == 0
+    ]
+    failure_indexes = [
+        index for index, outcome in enumerate(initial)
+        if outcome["returncode"] != 0
+    ]
+    if len(success_indexes) != 1 or len(failure_indexes) != 1:
+        raise RuntimeError("reference initial pair was not one success and one failure")
+
+    failed_index = failure_indexes[0]
+    failure = initial[failed_index]
+    if failure["returncode"] != 75:
+        raise RuntimeError("reference failure was not temporary")
+    failure_response = failure["response"]
+    if failure_response.get("retryable") is not True:
+        raise RuntimeError("reference failure was not explicitly retryable")
+
+    retried = run_one(TARGETS[failed_index])
+    if retried["returncode"] != 0:
+        raise RuntimeError("reference retry did not succeed")
+
+    results: list[dict[str, Any] | None] = [None, None]
+    successful_index = success_indexes[0]
+    results[successful_index] = initial[successful_index]["response"]
+    results[failed_index] = retried["response"]
+
+    lines = [
+        "| Shipment | Date | Available | Attempt |",
+        "| --- | --- | --- | --- |",
+    ]
+    for result in results:
+        if result is None:
+            raise RuntimeError("reference result is missing")
+        available = "true" if result["available"] else "false"
+        lines.append(
+            f"| {result['name']} at {result['location']} | {result['date']} | "
+            f"{available} | {result['attempt']} |"
+        )
+    DELIVERABLE.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

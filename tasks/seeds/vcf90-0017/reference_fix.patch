+				want[1]["fqdn"] = "esxi-12.vrack.vsphere.local"
+			}
+
+			f := newFixture(t, smmock.Options{}, nil)
+			if _, err := f.run(in...); err != nil {
+				t.Fatalf("CommissionHosts: %v", err)
+			}
+			for _, op := range []string{"validateHostCommissionSpec", "commissionHosts"} {
+				got := decodeArray(t, f.mock.RequestsFor(op))
+				if !reflect.DeepEqual(got, want) {
+					gotJSON, _ := json.Marshal(got)
+					wantJSON, _ := json.Marshal(want)
+					t.Errorf("%s body\n got %s\nwant %s", op, gotJSON, wantJSON)
+				}
+			}
+		})
+	}

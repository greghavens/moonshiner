+package hostcommission
+
+// The types in this file are the exact JSON shapes docs/contract.json declares.
+//
+// Only the five properties HostCommissionSpec marks required are unconditional;
+// every optional property carries omitempty so that a property the caller left
+// unset is absent from the request rather than present and empty. The same
+// applies to TokenCreationSpec, whose apiKey and idToken this flow never sends
+// and therefore does not model at all.
+
+type tokenCreationSpecWire struct {
+	Username string `json:"username"`
+	Password string `json:"password"`
+}
+
+type refreshTokenWire struct {
+	ID string `json:"id"`
+}
+
+type tokenPairWire struct {
+	AccessToken  string           `json:"accessToken"`
+	RefreshToken refreshTokenWire `json:"refreshToken"`
+}
+
+type hostCommissionSpecWire struct {
+	FQDN                    string `json:"fqdn"`
+	Username                string `json:"username"`
+	Password                string `json:"password"`
+	StorageType             string `json:"storageType"`
+	NetworkPoolID           string `json:"networkPoolId"`
+	VVolStorageProtocolType string `json:"vvolStorageProtocolType,omitempty"`
+	NetworkPoolName         string `json:"networkPoolName,omitempty"`
+	SSHThumbprint           string `json:"sshThumbprint,omitempty"`
+	SSLThumbprint           string `json:"sslThumbprint,omitempty"`
+}
+
+func (h HostSpec) wire() hostCommissionSpecWire {
+	return hostCommissionSpecWire{
+		FQDN:                    h.FQDN,
+		Username:                h.Username,
+		Password:                h.Password,
+		StorageType:             h.StorageType,
+		NetworkPoolID:           h.NetworkPoolID,
+		VVolStorageProtocolType: h.VVolStorageProtocolType,
+		NetworkPoolName:         h.NetworkPoolName,
+		SSHThumbprint:           h.SSHThumbprint,
+		SSLThumbprint:           h.SSLThumbprint,
+	}
+}
+
+func hostSpecsWire(hosts []HostSpec) []hostCommissionSpecWire {
+	out := make([]hostCommissionSpecWire, 0, len(hosts))
+	for _, h := range hosts {
+		out = append(out, h.wire())
+	}
+	return out
+}
+
+type validationCheckWire struct {
+	Description  string `json:"description"`
+	Severity     string `json:"severity"`
+	ResultStatus string `json:"resultStatus"`
+}
+
+type validationWire struct {
+	ID               string                `json:"id"`
+	Description      string                `json:"description"`
+	ExecutionStatus  string                `json:"executionStatus"`
+	ResultStatus     string                `json:"resultStatus"`
+	ValidationChecks []validationCheckWire `json:"validationChecks"`
+}
+
+func (v validationWire) public() Validation {
+	out := Validation{
+		ID:              v.ID,
+		Description:     v.Description,
+		ExecutionStatus: v.ExecutionStatus,
+		ResultStatus:    v.ResultStatus,
+	}
+	for _, c := range v.ValidationChecks {
+		out.Checks = append(out.Checks, ValidationCheck{
+			Description:  c.Description,
+			Severity:     c.Severity,
+			ResultStatus: c.ResultStatus,
+		})
+	}
+	return out
+}
+
+type errorWire struct {
+	ErrorCode string `json:"errorCode"`
+	ErrorType string `json:"errorType"`
+	Message   string `json:"message"`
+}
+
+type taskWire struct {
+	ID                  string      `json:"id"`
+	Name                string      `json:"name"`
+	Type                string      `json:"type"`
+	Status              string      `json:"status"`
+	CreationTimestamp   string      `json:"creationTimestamp"`
+	CompletionTimestamp string      `json:"completionTimestamp"`
+	Errors              []errorWire `json:"errors"`
+}
+
+func (t taskWire) public() Task {
+	out := Task{
+		ID:                  t.ID,
+		Name:                t.Name,
+		Type:                t.Type,
+		Status:              t.Status,
+		CreationTimestamp:   t.CreationTimestamp,
+		CompletionTimestamp: t.CompletionTimestamp,
+	}
+	for _, e := range t.Errors {
+		if e.Message != "" {
+			out.Errors = append(out.Errors, e.Message)
+		}
+	}
+	return out
+}

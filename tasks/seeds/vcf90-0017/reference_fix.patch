new file mode 100644
index 0000000..933751c
--- /dev/null
+++ b/hostcommission/client.go
@@ -0,0 +1,534 @@
+package hostcommission
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+)
+
+// Operation identifiers from docs/contract.json. Errors name the operation they
+// came from, so these are the strings that reach the caller.
+const (
+	opCreateToken   = "createToken"
+	opValidateHosts = "validateHostCommissionSpec"
+	opGetValidation = "getHostCommissionValidationByID"
+	opCommission    = "commissionHosts"
+	opGetTask       = "getTask"
+)
+
+// Paths from docs/contract.json. The 9.0.0.0 specification declares no base
+// path, so these hang directly off the appliance root.
+const (
+	pathTokens          = "/v1/tokens"
+	pathHosts           = "/v1/hosts"
+	pathHostValidations = "/v1/hosts/validations"
+	pathTasks           = "/v1/tasks"
+)
+
+// Defaults for the optional Config fields.
+const (
+	DefaultPollInterval    = 5 * time.Second
+	DefaultMaxPollAttempts = 60
+)
+
+// Sentinel errors, all matchable with errors.Is.
+var (
+	// ErrInvalidRequest reports a config or HostSpec problem found locally,
+	// before any HTTP request was made.
+	ErrInvalidRequest = errors.New("invalid request")
+	// ErrValidationFailed reports a host commission validation that reached a
+	// terminal state the flow cannot continue from.
+	ErrValidationFailed = errors.New("host commission validation failed")
+	// ErrTaskFailed reports a commissioning task that reached a terminal
+	// failure state.
+	ErrTaskFailed = errors.New("host commission task failed")
+	// ErrPollTimeout reports a status that was still non-terminal after
+	// MaxPollAttempts polls.
+	ErrPollTimeout = errors.New("polling timed out")
+	// ErrAPI reports a non-2xx answer from SDDC Manager.
+	ErrAPI = errors.New("sddc manager api error")
+)
+
+// Terminal and outcome vocabularies, canonicalized per
+// contract.statusVocabularies. A value outside these sets is non-terminal:
+// polling continues rather than guessing at an unrecognized status.
+var (
+	terminalTaskStatuses = map[string]bool{
+		"SUCCESSFUL": true, "COMPLETED_WITH_WARNING": true,
+		"FAILED": true, "CANCELLED": true, "SKIPPED": true,
+	}
+	successfulTaskStatuses = map[string]bool{
+		"SUCCESSFUL": true, "COMPLETED_WITH_WARNING": true,
+	}
+	terminalValidationStatuses = map[string]bool{
+		"COMPLETED": true, "FAILED": true, "UNKNOWN": true,
+		"SKIPPED": true, "CANCELLED": true,
+	}
+	acceptableValidationResults = map[string]bool{
+		"SUCCEEDED": true, "WARNING": true,
+	}
+)
+
+// canonical applies the normalization docs/contract.json documents for both
+// status vocabularies: uppercase, spaces to underscores. It is what lets
+// "In Progress" and "IN_PROGRESS" compare equal.
+func canonical(status string) string {
+	return strings.ReplaceAll(strings.ToUpper(strings.TrimSpace(status)), " ", "_")
+}
+
+// Config configures a Client.
+type Config struct {
+	// BaseURL is the SDDC Manager appliance root, without a path.
+	BaseURL string
+	// Username and Password authenticate createToken.
+	Username string
+	Password string
+	// HTTPClient is optional; http.DefaultClient is used when nil.
+	HTTPClient *http.Client
+	// PollInterval is the wait between polls. Zero selects
+	// DefaultPollInterval.
+	PollInterval time.Duration
+	// MaxPollAttempts bounds each polling loop independently. Zero selects
+	// DefaultMaxPollAttempts.
+	MaxPollAttempts int
+}
+
+// HostSpec is one HostCommissionSpec. The first five fields are required; the
+// rest are optional and are omitted from the request when left unset.
+type HostSpec struct {
+	FQDN          string
+	Username      string
+	Password      string
+	StorageType   string
+	NetworkPoolID string
+
+	NetworkPoolName         string
+	VVolStorageProtocolType string
+	SSHThumbprint           string
+	SSLThumbprint           string
+}
+
+// ValidationCheck is one entry of Validation.validationChecks.
+type ValidationCheck struct {
+	Description  string
+	Severity     string
+	ResultStatus string
+}
+
+// Validation is a host commission validation as of its terminal poll.
+type Validation struct {
+	ID              string
+	Description     string
+	ExecutionStatus string
+	ResultStatus    string
+	Checks          []ValidationCheck
+}
+
+// Task is a commissioning task as of its terminal poll.
+type Task struct {
+	ID                  string
+	Name                string
+	Type                string
+	Status              string
+	CreationTimestamp   string
+	CompletionTimestamp string
+	Errors              []string
+}
+
+// Result is the outcome of a completed commissioning flow.
+type Result struct {
+	Validation Validation
+	Task       Task
+	// ValidationPolls and TaskPolls count the getHostCommissionValidationByID
+	// and getTask calls the flow made.
+	ValidationPolls int
+	TaskPolls       int
+}
+
+// Client commissions hosts against one SDDC Manager appliance.
+type Client struct {
+	baseURL         string
+	username        string
+	password        string
+	httpClient      *http.Client
+	pollInterval    time.Duration
+	maxPollAttempts int
+}
+
+// New validates cfg and returns a Client. It performs no I/O.
+func New(cfg Config) (*Client, error) {
+	if strings.TrimSpace(cfg.BaseURL) == "" {
+		return nil, fmt.Errorf("%w: BaseURL is required", ErrInvalidRequest)
+	}
+	parsed, err := url.Parse(strings.TrimRight(strings.TrimSpace(cfg.BaseURL), "/"))
+	if err != nil {
+		return nil, fmt.Errorf("%w: BaseURL %q: %v", ErrInvalidRequest, cfg.BaseURL, err)
+	}
+	if parsed.Scheme == "" || parsed.Host == "" {
+		return nil, fmt.Errorf("%w: BaseURL %q needs a scheme and a host", ErrInvalidRequest, cfg.BaseURL)
+	}
+	if !strings.EqualFold(parsed.Scheme, "http") && !strings.EqualFold(parsed.Scheme, "https") {
+		return nil, fmt.Errorf("%w: BaseURL %q must use http or https", ErrInvalidRequest, cfg.BaseURL)
+	}
+	if parsed.User != nil {
+		return nil, fmt.Errorf("%w: BaseURL %q must not contain user info", ErrInvalidRequest, cfg.BaseURL)
+	}
+	if parsed.Path != "" || parsed.RawQuery != "" || parsed.ForceQuery || parsed.Fragment != "" {
+		return nil, fmt.Errorf("%w: BaseURL %q must be the appliance root without a path, query, or fragment",
+			ErrInvalidRequest, cfg.BaseURL)
+	}
+	if cfg.Username == "" {
+		return nil, fmt.Errorf("%w: Username is required", ErrInvalidRequest)
+	}
+	if cfg.Password == "" {
+		return nil, fmt.Errorf("%w: Password is required", ErrInvalidRequest)
+	}
+	if cfg.PollInterval < 0 {
+		return nil, fmt.Errorf("%w: PollInterval must not be negative", ErrInvalidRequest)
+	}
+	if cfg.MaxPollAttempts < 0 {
+		return nil, fmt.Errorf("%w: MaxPollAttempts must not be negative", ErrInvalidRequest)
+	}
+
+	c := &Client{
+		baseURL:         strings.TrimRight(strings.TrimSpace(cfg.BaseURL), "/"),
+		username:        cfg.Username,
+		password:        cfg.Password,
+		httpClient:      cfg.HTTPClient,
+		pollInterval:    cfg.PollInterval,
+		maxPollAttempts: cfg.MaxPollAttempts,
+	}
+	if c.httpClient == nil {
+		c.httpClient = http.DefaultClient
+	}
+	if c.pollInterval == 0 {
+		c.pollInterval = DefaultPollInterval
+	}
+	if c.maxPollAttempts == 0 {
+		c.maxPollAttempts = DefaultMaxPollAttempts
+	}
+	return c, nil
+}
+
+// CommissionHosts runs the whole flow: acquire a token, validate the host
+// specifications, poll the validation to a terminal state, commission the
+// hosts, then poll the resulting task to a terminal state.
+//
+// It returns a nil Result on any error.
+func (c *Client) CommissionHosts(ctx context.Context, hosts []HostSpec) (*Result, error) {
+	if err := validateHostSpecs(hosts); err != nil {
+		return nil, err
+	}
+	body := hostSpecsWire(hosts)
+
+	token, err := c.createToken(ctx)
+	if err != nil {
+		return nil, err
+	}
+
+	accepted, err := c.startValidation(ctx, token, body)
+	if err != nil {
+		return nil, err
+	}
+	validation, validationPolls, err := c.pollValidation(ctx, token, accepted.ID)
+	if err != nil {
+		return nil, err
+	}
+	if canonical(validation.ExecutionStatus) != "COMPLETED" ||
+		!acceptableValidationResults[canonical(validation.ResultStatus)] {
+		return nil, fmt.Errorf("%w: executionStatus %q, resultStatus %q%s",
+			ErrValidationFailed, validation.ExecutionStatus, validation.ResultStatus,
+			failedChecks(validation))
+	}
+
+	task, err := c.startCommission(ctx, token, body)
+	if err != nil {
+		return nil, err
+	}
+	task, taskPolls, err := c.pollTask(ctx, token, task.ID)
+	if err != nil {
+		return nil, err
+	}
+	if !successfulTaskStatuses[canonical(task.Status)] {
+		detail := ""
+		if len(task.Errors) > 0 {
+			detail = ": " + strings.Join(task.Errors, "; ")
+		}
+		return nil, fmt.Errorf("%w: task %s reached status %q%s",
+			ErrTaskFailed, task.ID, task.Status, detail)
+	}
+
+	return &Result{
+		Validation:      validation,
+		Task:            task,
+		ValidationPolls: validationPolls,
+		TaskPolls:       taskPolls,
+	}, nil
+}
+
+func validateHostSpecs(hosts []HostSpec) error {
+	if len(hosts) == 0 {
+		return fmt.Errorf("%w: at least one HostSpec is required", ErrInvalidRequest)
+	}
+	seen := map[string]int{}
+	for i, h := range hosts {
+		missing := []string{}
+		if h.FQDN == "" {
+			missing = append(missing, "FQDN")
+		}
+		if h.Username == "" {
+			missing = append(missing, "Username")
+		}
+		if h.Password == "" {
+			missing = append(missing, "Password")
+		}
+		if h.StorageType == "" {
+			missing = append(missing, "StorageType")
+		}
+		if h.NetworkPoolID == "" {
+			missing = append(missing, "NetworkPoolID")
+		}
+		if len(missing) > 0 {
+			return fmt.Errorf("%w: hosts[%d]: %s must be set",
+				ErrInvalidRequest, i, strings.Join(missing, ", "))
+		}
+		isVVol := canonical(h.StorageType) == "VVOL"
+		switch {
+		case isVVol && h.VVolStorageProtocolType == "":
+			return fmt.Errorf("%w: hosts[%d]: StorageType VVOL requires VVolStorageProtocolType",
+				ErrInvalidRequest, i)
+		case !isVVol && h.VVolStorageProtocolType != "":
+			return fmt.Errorf("%w: hosts[%d]: VVolStorageProtocolType applies only to StorageType VVOL, not %q",
+				ErrInvalidRequest, i, h.StorageType)
+		}
+		key := strings.ToLower(h.FQDN)
+		if first, dup := seen[key]; dup {
+			return fmt.Errorf("%w: hosts[%d] repeats the FQDN of hosts[%d]: %s",
+				ErrInvalidRequest, i, first, h.FQDN)
+		}
+		seen[key] = i
+	}
+	return nil
+}
+
+func failedChecks(v Validation) string {
+	var out []string
+	for _, c := range v.Checks {
+		if canonical(c.ResultStatus) == "SUCCEEDED" {
+			continue
+		}
+		out = append(out, fmt.Sprintf("%s: %s", c.ResultStatus, c.Description))
+	}
+	if len(out) == 0 {
+		return ""
+	}
+	return ": " + strings.Join(out, "; ")
+}
+
+func (c *Client) createToken(ctx context.Context) (string, error) {
+	var pair tokenPairWire
+	err := c.do(ctx, request{
+		operationID: opCreateToken,
+		method:      http.MethodPost,
+		path:        pathTokens,
+		body:        tokenCreationSpecWire{Username: c.username, Password: c.password},
+	}, &pair)
+	if err != nil {
+		return "", err
+	}
+	if pair.AccessToken == "" {
+		return "", fmt.Errorf("%s: %w: response carried no accessToken", opCreateToken, ErrAPI)
+	}
+	return pair.AccessToken, nil
+}
+
+func (c *Client) startValidation(ctx context.Context, token string, body []hostCommissionSpecWire) (Validation, error) {
+	var wire validationWire
+	err := c.do(ctx, request{
+		operationID: opValidateHosts,
+		method:      http.MethodPost,
+		path:        pathHostValidations,
+		body:        body,
+		token:       token,
+	}, &wire)
+	if err != nil {
+		return Validation{}, err
+	}
+	if wire.ID == "" {
+		return Validation{}, fmt.Errorf("%s: %w: response carried no validation id", opValidateHosts, ErrAPI)
+	}
+	return wire.public(), nil
+}
+
+func (c *Client) pollValidation(ctx context.Context, token, id string) (Validation, int, error) {
+	for attempt := 1; attempt <= c.maxPollAttempts; attempt++ {
+		var wire validationWire
+		err := c.do(ctx, request{
+			operationID: opGetValidation,
+			method:      http.MethodGet,
+			path:        pathHostValidations + "/" + url.PathEscape(id),
+			token:       token,
+		}, &wire)
+		if err != nil {
+			return Validation{}, attempt, err
+		}
+		if terminalValidationStatuses[canonical(wire.ExecutionStatus)] {
+			return wire.public(), attempt, nil
+		}
+		if attempt == c.maxPollAttempts {
+			break
+		}
+		if err := wait(ctx, c.pollInterval); err != nil {
+			return Validation{}, attempt, err
+		}
+	}
+	return Validation{}, c.maxPollAttempts, fmt.Errorf(
+		"%s: %w: validation %s was still not terminal after %d polls",
+		opGetValidation, ErrPollTimeout, id, c.maxPollAttempts)
+}
+
+func (c *Client) startCommission(ctx context.Context, token string, body []hostCommissionSpecWire) (Task, error) {
+	var wire taskWire
+	err := c.do(ctx, request{
+		operationID: opCommission,
+		method:      http.MethodPost,
+		path:        pathHosts,
+		body:        body,
+		token:       token,
+	}, &wire)
+	if err != nil {
+		return Task{}, err
+	}
+	if wire.ID == "" {
+		return Task{}, fmt.Errorf("%s: %w: response carried no task id", opCommission, ErrAPI)
+	}
+	return wire.public(), nil
+}
+
+func (c *Client) pollTask(ctx context.Context, token, id string) (Task, int, error) {
+	for attempt := 1; attempt <= c.maxPollAttempts; attempt++ {
+		var wire taskWire
+		err := c.do(ctx, request{
+			operationID: opGetTask,
+			method:      http.MethodGet,
+			path:        pathTasks + "/" + url.PathEscape(id),
+			token:       token,
+		}, &wire)
+		if err != nil {
+			return Task{}, attempt, err
+		}
+		if terminalTaskStatuses[canonical(wire.Status)] {
+			return wire.public(), attempt, nil
+		}
+		if attempt == c.maxPollAttempts {
+			break
+		}
+		if err := wait(ctx, c.pollInterval); err != nil {
+			return Task{}, attempt, err
+		}
+	}
+	return Task{}, c.maxPollAttempts, fmt.Errorf(
+		"%s: %w: task %s was still not terminal after %d polls",
+		opGetTask, ErrPollTimeout, id, c.maxPollAttempts)
+}
+
+// wait sleeps for d, or returns early if ctx is cancelled first.
+func wait(ctx context.Context, d time.Duration) error {
+	if d <= 0 {
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		default:
+			return nil
+		}
+	}
+	timer := time.NewTimer(d)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-timer.C:
+		return nil
+	}
+}
+
+type request struct {
+	operationID string
+	method      string
+	path        string
+	body        any // nil for GET
+	token       string
+}
+
+func (c *Client) do(ctx context.Context, req request, out any) error {
+	var payload io.Reader
+	if req.body != nil {
+		encoded, err := json.Marshal(req.body)
+		if err != nil {
+			return fmt.Errorf("%s: %w: encode request: %v", req.operationID, ErrInvalidRequest, err)
+		}
+		payload = bytes.NewReader(encoded)
+	}
+
+	httpReq, err := http.NewRequestWithContext(ctx, req.method, c.baseURL+req.path, payload)
+	if err != nil {
+		return fmt.Errorf("%s: %w", req.operationID, err)
+	}
+	httpReq.Header.Set("Accept", "application/json")
+	if req.body != nil {
+		httpReq.Header.Set("Content-Type", "application/json")
+	}
+	if req.token != "" {
+		httpReq.Header.Set("Authorization", "Bearer "+req.token)
+	}
+
+	resp, err := c.httpClient.Do(httpReq)
+	if err != nil {
+		return fmt.Errorf("%s: %w", req.operationID, err)
+	}
+	defer func() {
+		_, _ = io.Copy(io.Discard, resp.Body)
+		_ = resp.Body.Close()
+	}()
+
+	responseBody, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return fmt.Errorf("%s: %w", req.operationID, err)
+	}
+	if resp.StatusCode < 200 || resp.StatusCode > 299 {
+		return fmt.Errorf("%s: %w: HTTP %d%s",
+			req.operationID, ErrAPI, resp.StatusCode, describeError(responseBody))
+	}
+	if out == nil {
+		return nil
+	}
+	if err := json.Unmarshal(responseBody, out); err != nil {
+		return fmt.Errorf("%s: %w: decode response: %v", req.operationID, ErrAPI, err)
+	}
+	return nil
+}
+
+// describeError pulls errorCode and message out of an SDDC Manager Error body
+// when the appliance sent one.
+func describeError(body []byte) string {
+	var e errorWire
+	if err := json.Unmarshal(body, &e); err != nil {
+		return ""
+	}
+	switch {
+	case e.ErrorCode != "" && e.Message != "":
+		return fmt.Sprintf(": %s: %s", e.ErrorCode, e.Message)
+	case e.Message != "":
+		return ": " + e.Message
+	case e.ErrorCode != "":
+		return ": " + e.ErrorCode
+	}
+	return ""
+}

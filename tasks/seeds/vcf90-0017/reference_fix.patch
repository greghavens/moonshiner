+// TestTerminalOutcomes maps terminal states onto the sentinel errors.
+func TestTerminalOutcomes(t *testing.T) {
+	cases := []struct {
+		name        string
+		validations []smmock.ValidationState
+		tasks       []smmock.TaskState
+		maxPolls    int
+		wantErr     error
+		wantCommits int
+	}{
+		{
+			name:        "validation result rules out commissioning",
+			validations: []smmock.ValidationState{{ExecutionStatus: "COMPLETED", ResultStatus: "FAILED"}},
+			wantErr:     hostcommission.ErrValidationFailed,
+		},
+		{
+			name:        "validation execution failed",
+			validations: []smmock.ValidationState{{ExecutionStatus: "FAILED", ResultStatus: "FAILED"}},
+			wantErr:     hostcommission.ErrValidationFailed,
+		},
+		{
+			name:        "validation never settles",
+			validations: []smmock.ValidationState{{ExecutionStatus: "IN_PROGRESS", ResultStatus: "UNKNOWN"}},
+			maxPolls:    3,
+			wantErr:     hostcommission.ErrPollTimeout,
+		},
+		{
+			name:        "task failed",
+			tasks:       []smmock.TaskState{{Status: "FAILED", ErrorMessages: []string{"disk claim failed"}}},
+			wantErr:     hostcommission.ErrTaskFailed,
+			wantCommits: 1,
+		},
+		{
+			name:        "task cancelled",
+			tasks:       []smmock.TaskState{{Status: "Cancelled"}},
+			wantErr:     hostcommission.ErrTaskFailed,
+			wantCommits: 1,
+		},
+		{
+			name:        "task never settles",
+			tasks:       []smmock.TaskState{{Status: "IN_PROGRESS"}},
+			maxPolls:    2,
+			wantErr:     hostcommission.ErrPollTimeout,
+			wantCommits: 1,
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			f := newFixture(t, smmock.Options{Validations: tc.validations, Tasks: tc.tasks},
+				func(cfg *hostcommission.Config) {
+					if tc.maxPolls > 0 {
+						cfg.MaxPollAttempts = tc.maxPolls
+					}
+				})
+			result, err := f.run(host())
+			if !errors.Is(err, tc.wantErr) {
+				t.Fatalf("error %v, want one matching %v", err, tc.wantErr)
+			}
+			if result != nil {
+				t.Errorf("Result %+v, want nil alongside an error", result)
+			}
+			if got := f.calls("commissionHosts"); got != tc.wantCommits {
+				t.Errorf("commissionHosts called %d times, want %d", got, tc.wantCommits)
+			}
+		})
+	}
+}

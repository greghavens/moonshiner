+
+	"vcf.local/sddchosts/hostcommission"
+	"vcf.local/sddchosts/internal/contract"
+	"vcf.local/sddchosts/internal/smmock"
+)
+
+const (
+	adminUser     = "administrator@vsphere.local"
+	adminPassword = "VMw@re1!VMw@re1!"
+	poolID        = "3f8a1b26-9c04-4d7e-8b53-1a6e2d90c4f7"
+)
+
+func host() hostcommission.HostSpec {
+	return hostcommission.HostSpec{
+		FQDN:          "esxi-11.vrack.vsphere.local",
+		Username:      "root",
+		Password:      "EsxiP@ssw0rd!",
+		StorageType:   "VSAN",
+		NetworkPoolID: poolID,
+	}
+}
+
+func requiredOnlyJSON() map[string]any {
+	return map[string]any{
+		"fqdn":          "esxi-11.vrack.vsphere.local",
+		"username":      "root",
+		"password":      "EsxiP@ssw0rd!",
+		"storageType":   "VSAN",
+		"networkPoolId": poolID,
+	}
+}
+
+type fixture struct {
+	mock   *smmock.Server
+	client *hostcommission.Client
+}
+
+func newFixture(t *testing.T, opts smmock.Options, tune func(*hostcommission.Config)) *fixture {
+	t.Helper()
+	c, err := contract.LoadDefault()
+	if err != nil {
+		t.Fatalf("load contract: %v", err)
+	}
+	mock, err := smmock.New(c, opts)
+	if err != nil {
+		t.Fatalf("start mock: %v", err)
+	}
+	t.Cleanup(mock.Close)
+
+	cfg := hostcommission.Config{
+		BaseURL:         mock.URL(),
+		Username:        adminUser,
+		Password:        adminPassword,
+		PollInterval:    time.Millisecond,
+		MaxPollAttempts: 8,
+	}
+	if tune != nil {
+		tune(&cfg)
+	}
+	client, err := hostcommission.New(cfg)
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	return &fixture{mock: mock, client: client}
+}
+
+func (f *fixture) run(hosts ...hostcommission.HostSpec) (*hostcommission.Result, error) {
+	return f.client.CommissionHosts(context.Background(), hosts)
+}
+
+func (f *fixture) calls(operationID string) int {
+	return len(f.mock.RequestsFor(operationID))
+}
+
+func decodeArray(t *testing.T, reqs []smmock.Request) []map[string]any {
+	t.Helper()
+	if len(reqs) != 1 {
+		t.Fatalf("recorded %d requests, want 1", len(reqs))
+	}
+	items, err := reqs[0].DecodeArray()
+	if err != nil {
+		t.Fatalf("%v", err)
+	}
+	return items
+}
+
+// TestRequestWireShape is the table over how a HostSpec serializes. An optional
+// field the caller left unset must be absent, not present and empty.
+func TestRequestWireShape(t *testing.T) {
+	withNetworkPoolName := host()
+	withNetworkPoolName.NetworkPoolName = "np-mgmt-01"
+	namedJSON := requiredOnlyJSON()
+	namedJSON["networkPoolName"] = "np-mgmt-01"
+
+	vvol := host()
+	vvol.StorageType = "VVOL"
+	vvol.VVolStorageProtocolType = "FC"
+	vvol.SSHThumbprint = "SHA256:abc"
+	vvol.SSLThumbprint = "AA:BB:CC"
+	vvolJSON := requiredOnlyJSON()
+	vvolJSON["storageType"] = "VVOL"
+	vvolJSON["vvolStorageProtocolType"] = "FC"
+	vvolJSON["sshThumbprint"] = "SHA256:abc"
+	vvolJSON["sslThumbprint"] = "AA:BB:CC"
+
+	cases := []struct {
+		name string
+		in   []hostcommission.HostSpec
+		want []map[string]any
+	}{
+		{"required only", []hostcommission.HostSpec{host()}, []map[string]any{requiredOnlyJSON()}},
+		{"one optional set", []hostcommission.HostSpec{withNetworkPoolName}, []map[string]any{namedJSON}},
+		{"fully populated", []hostcommission.HostSpec{vvol}, []map[string]any{vvolJSON}},
+		{"two hosts keep order", []hostcommission.HostSpec{host(), withNetworkPoolName},
+			[]map[string]any{requiredOnlyJSON(), namedJSON}},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			// The two hosts in the last case would otherwise share an FQDN.
+			in := append([]hostcommission.HostSpec(nil), tc.in...)
+			want := make([]map[string]any, len(tc.want))
+			for i := range tc.want {
+				want[i] = map[string]any{}
+				for k, v := range tc.want[i] {
+					want[i][k] = v
+				}
+			}
+			if len(in) > 1 {

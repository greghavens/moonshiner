+// TestPollingToTerminalState is the table over both asynchronous halves.
+func TestPollingToTerminalState(t *testing.T) {
+	cases := []struct {
+		name            string
+		validations     []smmock.ValidationState
+		tasks           []smmock.TaskState
+		wantValidations int
+		wantTasks       int
+		wantStatus      string
+	}{
+		{
+			name:            "settles on the first poll",
+			validations:     []smmock.ValidationState{{ExecutionStatus: "COMPLETED", ResultStatus: "SUCCEEDED"}},
+			tasks:           []smmock.TaskState{{Status: "SUCCESSFUL"}},
+			wantValidations: 1, wantTasks: 1, wantStatus: "SUCCESSFUL",
+		},
+		{
+			name: "runs through the intermediate states",
+			validations: []smmock.ValidationState{
+				{ExecutionStatus: "IN_PROGRESS", ResultStatus: "UNKNOWN"},
+				{ExecutionStatus: "IN_PROGRESS", ResultStatus: "UNKNOWN"},
+				{ExecutionStatus: "COMPLETED", ResultStatus: "SUCCEEDED"},
+			},
+			tasks: []smmock.TaskState{
+				{Status: "PENDING"}, {Status: "IN_PROGRESS"}, {Status: "SUCCESSFUL"},
+			},
+			wantValidations: 3, wantTasks: 3, wantStatus: "SUCCESSFUL",
+		},
+		{
+			name:        "accepts the display forms of the statuses",
+			validations: []smmock.ValidationState{{ExecutionStatus: "COMPLETED", ResultStatus: "SUCCEEDED"}},
+			tasks: []smmock.TaskState{
+				{Status: "Pending"}, {Status: "In Progress"}, {Status: "Successful"},
+			},
+			wantValidations: 1, wantTasks: 3, wantStatus: "Successful",
+		},
+		{
+			name: "keeps polling through statuses it does not recognize",
+			validations: []smmock.ValidationState{
+				{ExecutionStatus: "CANCELLATION_IN_PROGRESS", ResultStatus: "CANCELLATION_IN_PROGRESS"},
+				{ExecutionStatus: "COMPLETED", ResultStatus: "WARNING"},
+			},
+			tasks: []smmock.TaskState{
+				{Status: "QUEUED"}, {Status: "COMPLETED_WITH_WARNING"},
+			},
+			wantValidations: 2, wantTasks: 2, wantStatus: "COMPLETED_WITH_WARNING",
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			f := newFixture(t, smmock.Options{Validations: tc.validations, Tasks: tc.tasks}, nil)
+			result, err := f.run(host())
+			if err != nil {
+				t.Fatalf("CommissionHosts: %v", err)
+			}
+			if result.ValidationPolls != tc.wantValidations {
+				t.Errorf("ValidationPolls %d, want %d", result.ValidationPolls, tc.wantValidations)
+			}
+			if result.TaskPolls != tc.wantTasks {
+				t.Errorf("TaskPolls %d, want %d", result.TaskPolls, tc.wantTasks)
+			}
+			if result.Task.Status != tc.wantStatus {
+				t.Errorf("Task.Status %q, want %q", result.Task.Status, tc.wantStatus)
+			}
+			if got := f.calls("getHostCommissionValidationByID"); got != tc.wantValidations {
+				t.Errorf("getHostCommissionValidationByID called %d times, want %d", got, tc.wantValidations)
+			}
+			if got := f.calls("getTask"); got != tc.wantTasks {
+				t.Errorf("getTask called %d times, want %d", got, tc.wantTasks)
+			}
+		})
+	}
+}

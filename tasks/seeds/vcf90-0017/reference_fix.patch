+func TestConfigValidation(t *testing.T) {
+	valid := hostcommission.Config{
+		BaseURL:  "https://sddc-manager.vrack.vsphere.local",
+		Username: adminUser,
+		Password: adminPassword,
+	}
+	cases := []struct {
+		name string
+		cfg  hostcommission.Config
+	}{
+		{"no base url", hostcommission.Config{Username: adminUser, Password: adminPassword}},
+		{"relative base url", hostcommission.Config{
+			BaseURL: "/v1", Username: adminUser, Password: adminPassword}},
+		{"no username", hostcommission.Config{BaseURL: valid.BaseURL, Password: adminPassword}},
+		{"no password", hostcommission.Config{BaseURL: valid.BaseURL, Username: adminUser}},
+		{"negative poll interval", hostcommission.Config{
+			BaseURL: valid.BaseURL, Username: adminUser, Password: adminPassword,
+			PollInterval: -time.Second}},
+		{"negative max poll attempts", hostcommission.Config{
+			BaseURL: valid.BaseURL, Username: adminUser, Password: adminPassword,
+			MaxPollAttempts: -2}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if _, err := hostcommission.New(tc.cfg); !errors.Is(err, hostcommission.ErrInvalidRequest) {
+				t.Fatalf("New error %v, want one matching ErrInvalidRequest", err)
+			}
+		})
+	}
+	if _, err := hostcommission.New(valid); err != nil {
+		t.Errorf("New rejected a valid config: %v", err)
+	}
+}

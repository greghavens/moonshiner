+// TestLocalValidation checks the input rules that must be enforced before any
+// request reaches the appliance.
+func TestLocalValidation(t *testing.T) {
+	mutate := func(f func(*hostcommission.HostSpec)) []hostcommission.HostSpec {
+		h := host()
+		f(&h)
+		return []hostcommission.HostSpec{h}
+	}
+	duplicates := []hostcommission.HostSpec{host(), host()}
+
+	cases := []struct {
+		name  string
+		hosts []hostcommission.HostSpec
+	}{
+		{"no hosts", nil},
+		{"blank fqdn", mutate(func(h *hostcommission.HostSpec) { h.FQDN = "" })},
+		{"blank username", mutate(func(h *hostcommission.HostSpec) { h.Username = "" })},
+		{"blank password", mutate(func(h *hostcommission.HostSpec) { h.Password = "" })},
+		{"blank storage type", mutate(func(h *hostcommission.HostSpec) { h.StorageType = "" })},
+		{"blank network pool id", mutate(func(h *hostcommission.HostSpec) { h.NetworkPoolID = "" })},
+		{"vvol storage without a protocol type", mutate(func(h *hostcommission.HostSpec) {
+			h.StorageType = "VVOL"
+		})},
+		{"protocol type on non-vvol storage", mutate(func(h *hostcommission.HostSpec) {
+			h.VVolStorageProtocolType = "NFS"
+		})},
+		{"repeated fqdn", duplicates},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			f := newFixture(t, smmock.Options{}, nil)
+			if _, err := f.run(tc.hosts...); !errors.Is(err, hostcommission.ErrInvalidRequest) {
+				t.Fatalf("error %v, want one matching ErrInvalidRequest", err)
+			}
+			if got := len(f.mock.Requests()); got != 0 {
+				t.Errorf("%d request(s) reached the appliance", got)
+			}
+		})
+	}
+}

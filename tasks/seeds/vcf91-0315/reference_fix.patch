 """Client for the VCF Automation provisioning service.
 
-Unimplemented. See ``README.md`` for the required behaviour and
-``docs/contract.json`` for the wire contract this client is pinned to.
+Pinned to ``docs/contract.json``. Three operations are used and no others:
+
+* ``POST /iaas/api/machines``             -- accepted, returns a RequestTracker
+* ``GET  /iaas/api/request-tracker/{id}`` -- polled until the state is terminal
+* ``GET  /iaas/api/machines/{id}``        -- reads the machine back on success
+
+The create call is asynchronous. A 202 means the request was *accepted*, not
+that the machine exists, so the tracker is polled until it reports one of the
+terminal states before anything is read back.
 """
 
+import json
 import time
+import urllib.error
+import urllib.parse
+import urllib.request
+from typing import Any, Dict, List, Optional, Tuple
 
+from .errors import ApiError, ProvisioningFailed, ProvisioningTimeout
 from .models import MachineSpec, ProvisionResult
 
-__all__ = ["VcfAutomationClient"]
+__all__ = ["VcfAutomationClient", "machine_specification"]
+
+#: Contract: RequestTracker.status is FINISHED | INPROGRESS | FAILED.
+TERMINAL_STATES = frozenset({"FINISHED", "FAILED"})
+SUCCESS_STATE = "FINISHED"
+
+#: Contract: the collection of provisioned resource links on a finished tracker.
+RESOURCE_COLLECTION_FIELD = "resources"
+
+CREATE_MACHINE_PATH = "/iaas/api/machines"
+REQUEST_TRACKER_PATH = "/iaas/api/request-tracker/{id}"
+MACHINE_PATH = "/iaas/api/machines/{id}"
+
+HTTP_TIMEOUT_SECONDS = 60.0
+
+# MachineSpec attribute -> MachineSpecification wire property.
+_MACHINE_PROPERTIES = (
+    ("name", "name"),
+    ("project_id", "projectId"),
+    ("flavor", "flavor"),
+    ("flavor_ref", "flavorRef"),
+    ("image", "image"),
+    ("image_ref", "imageRef"),
+    ("description", "description"),
+    ("deployment_id", "deploymentId"),
+    ("machine_count", "machineCount"),
+    ("custom_properties", "customProperties"),
+)
+
+_NIC_PROPERTIES = (
+    ("name", "name"),
+    ("description", "description"),
+    ("device_index", "deviceIndex"),
+    ("network_id", "networkId"),
+    ("fabric_network_id", "fabricNetworkId"),
+    ("addresses", "addresses"),
+    ("mac_address", "macAddress"),
+    ("security_group_ids", "securityGroupIds"),
+    ("custom_properties", "customProperties"),
+)
+
+_DISK_PROPERTIES = (
+    ("name", "name"),
+    ("description", "description"),
+    ("block_device_id", "blockDeviceId"),
+    ("scsi_controller", "scsiController"),
+    ("unit_number", "unitNumber"),
+    ("disk_attachment_properties", "diskAttachmentProperties"),
+)
+
+_CONSTRAINT_PROPERTIES = (
+    ("mandatory", "mandatory"),
+    ("expression", "expression"),
+)
+
+
+def _project(obj: Any, properties) -> Dict[str, Any]:
+    """Map dataclass attributes onto wire properties, dropping the unset ones.
+
+    An attribute left at ``None`` is an unset optional field: the contract says
+    it is omitted from the payload, not sent as null or as an empty value.
+    """
+    payload = {}
+    for attribute, wire_name in properties:
+        value = getattr(obj, attribute)
+        if value is not None:
+            payload[wire_name] = value
+    return payload
+
+
+def machine_specification(spec: MachineSpec) -> Dict[str, Any]:
+    """Serialize a :class:`MachineSpec` into a MachineSpecification body."""
+    body = _project(spec, _MACHINE_PROPERTIES)
+
+    if spec.nics is not None:
+        body["nics"] = [_project(nic, _NIC_PROPERTIES) for nic in spec.nics]
+    if spec.disks is not None:
+        body["disks"] = [_project(disk, _DISK_PROPERTIES) for disk in spec.disks]
+    if spec.tags is not None:
+        body["tags"] = [{"key": tag.key, "value": tag.value} for tag in spec.tags]
+    if spec.constraints is not None:
+        body["constraints"] = [
+            _project(constraint, _CONSTRAINT_PROPERTIES) for constraint in spec.constraints
+        ]
+    if spec.boot_config_content is not None:
+        body["bootConfig"] = {"content": spec.boot_config_content}
+
+    return body
 
 
 class VcfAutomationClient:
@@ -23,6 +123,107 @@ class VcfAutomationClient:
         self.max_poll_attempts = max_poll_attempts
         self.sleep = sleep
 
+    # -- public API --------------------------------------------------------
     def provision_machine(self, spec: MachineSpec) -> ProvisionResult:
         """Provision a machine and return once the request is terminal."""
-        raise NotImplementedError
+        status, tracker = self._call(
+            "POST", CREATE_MACHINE_PATH, body=machine_specification(spec)
+        )
+        if status != 202:
+            raise ApiError(status, tracker,
+                           "create-machine answered HTTP {0}, expected 202".format(status))
+
+        request_id = tracker["id"]
+        tracker, polls = self._await_terminal(request_id, tracker)
+
+        machine_id = self._machine_id(tracker)
+        status, machine = self._call("GET", MACHINE_PATH.format(id=_segment(machine_id)))
+        if status != 200:
+            raise ApiError(status, machine)
+
+        return ProvisionResult(
+            request_id=request_id,
+            machine_id=machine_id,
+            machine=machine,
+            tracker=tracker,
+            poll_count=polls,
+        )
+
+    # -- async plumbing ----------------------------------------------------
+    def _await_terminal(self, request_id: str,
+                        tracker: Dict[str, Any]) -> Tuple[Dict[str, Any], int]:
+        """Poll the request tracker until it reports a terminal state."""
+        path = REQUEST_TRACKER_PATH.format(id=_segment(request_id))
+        polls = 0
+
+        while polls < self.max_poll_attempts:
+            if polls:
+                self.sleep(self.poll_interval)
+
+            status, tracker = self._call("GET", path)
+            polls += 1
+            if status != 200:
+                raise ApiError(status, tracker)
+
+            state = tracker.get("status")
+            if state == SUCCESS_STATE:
+                return tracker, polls
+            if state in TERMINAL_STATES:
+                raise ProvisioningFailed(request_id, tracker.get("message"), tracker)
+
+        raise ProvisioningTimeout(request_id, polls, tracker)
+
+    @staticmethod
+    def _machine_id(tracker: Dict[str, Any]) -> str:
+        resources: List[str] = tracker.get(RESOURCE_COLLECTION_FIELD) or []
+        if not resources:
+            raise ProvisioningFailed(
+                tracker.get("id", ""),
+                "request finished without reporting a provisioned resource",
+                tracker,
+            )
+        return resources[0].rstrip("/").rsplit("/", 1)[-1]
+
+    # -- transport ---------------------------------------------------------
+    def _call(self, method: str, path: str,
+              body: Optional[Dict[str, Any]] = None) -> Tuple[int, Any]:
+        query = urllib.parse.urlencode({"apiVersion": self.api_version})
+        url = "{0}{1}?{2}".format(self.base_url, path, query)
+
+        request = urllib.request.Request(url, method=method)
+        request.add_header("Authorization", self.token)
+        request.add_header("Accept", "application/json")
+        if body is not None:
+            request.data = json.dumps(body).encode("utf-8")
+            request.add_header("Content-Type", "application/json")
+
+        try:
+            with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT_SECONDS) as response:
+                return response.status, _decode(response.read())
+        except urllib.error.HTTPError as error:
+            payload = _decode(error.read())
+            raise ApiError(error.code, payload, _error_message(error.code, payload)) from None
+
+    def __repr__(self) -> str:  # pragma: no cover - debugging aid
+        return "VcfAutomationClient(base_url={0!r}, api_version={1!r})".format(
+            self.base_url, self.api_version)
+
+
+def _segment(value: str) -> str:
+    return urllib.parse.quote(str(value), safe="")
+
+
+def _decode(raw: bytes) -> Any:
+    if not raw:
+        return None
+    text = raw.decode("utf-8")
+    try:
+        return json.loads(text)
+    except ValueError:
+        return text
+
+
+def _error_message(status_code: int, payload: Any) -> str:
+    detail = payload.get("message") if isinstance(payload, dict) else ""
+    text = "VCF Automation API returned HTTP {0}".format(status_code)
+    return "{0}: {1}".format(text, detail) if detail else text

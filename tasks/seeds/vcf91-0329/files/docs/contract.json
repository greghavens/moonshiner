              "type": "string"
            }
          },
          "associatedMobilityCloudAccountIds": {
            "type": "object",
            "description": "Cloud Account IDs and directionalities create associations to other vSphere cloud accounts that can be used for workload mobility.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "cloudAccountProperties": {
            "type": "object",
            "description": "Cloud Account specific properties supplied in as name value pairs.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "customProperties": {
            "type": "object",
            "description": "Additional custom properties that may be used to extend the Cloud Account.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "regions": {
            "type": "array",
            "description": "A set of regions to enable provisioning on.",
            "items": {
              "$ref": "#/components/schemas/RegionSpecification"
            }
          },
          "createDefaultZones": {
            "type": "boolean",
            "description": "Create default zones for the enabled regions."

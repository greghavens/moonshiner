        "type": "http",
        "scheme": "bearer",
        "description": "Send the token from retrieveAuthToken as 'Authorization: Bearer {token}'. A revoked or expired token yields 401.\n"
      }
    },
    "schemas": {
      "CspLoginSpecification": {
        "type": "object",
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "The refresh token exchanged for a bearer token."
          }
        }
      },
      "AuthResponse": {
        "type": "object",

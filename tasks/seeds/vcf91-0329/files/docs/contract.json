            "type": "string",
            "description": "Name of region on the provider side. In vSphere, the name of the region is different from its id."
          },
          "externalRegionId": {
            "type": "string",
            "description": "Unique identifier of region on the provider side."
          }
        }
      },
      "Tag": {
        "type": "object",
        "required": [
          "key",
          "value"

            "type": "string"
          },
          "orgId": {
            "type": "string"
          },
          "_links": {
            "type": "object"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "cloudAccountType": {
            "type": "string"
          },
          "cloudAccountProperties": {
            "type": "object",

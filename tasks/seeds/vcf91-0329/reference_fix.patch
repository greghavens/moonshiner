+// awaitRequest polls getRequestTracker until the request leaves INPROGRESS or
+// the poll budget runs out. The accepted tracker counts as the first observed
+// state but not as a poll.
+func (c *Client) awaitRequest(ctx context.Context, accepted RequestTracker, reauth *int) (RequestTracker, error) {
+	if accepted.ID == "" {
+		return RequestTracker{}, &OperationError{
+			OperationID: OperationUpdateCloudAccountAsync,
+			Kind:        KindProtocol,
+			Cause:       errors.New("the 202 RequestTracker carried no id"),
+		}
+	}
+	latest := accepted
+	for attempt := 0; attempt < c.maxPollAttempts; attempt++ {
+		if err := sleep(ctx, c.pollInterval); err != nil {
+			return RequestTracker{}, err
+		}
+		var tracker RequestTracker
+		if err := c.do(ctx, request{
+			operationID:    OperationGetRequestTracker,
+			method:         http.MethodGet,
+			path:           "/iaas/api/request-tracker/" + url.PathEscape(accepted.ID),
+			expectedStatus: http.StatusOK,
+			out:            &tracker,
+		}, reauth); err != nil {
+			return RequestTracker{}, err
+		}
+		latest = tracker
+		switch tracker.Status {
+		case StatusFinished:
+			return tracker, nil
+		case StatusFailed:
+			return RequestTracker{}, &TrackerError{
+				RequestID: accepted.ID,
+				Status:    tracker.Status,
+				Message:   tracker.Message,
+			}
+		case StatusInProgress:
+		default:
+			return RequestTracker{}, &OperationError{
+				OperationID: OperationGetRequestTracker,
+				Kind:        KindProtocol,
+				Cause:       fmt.Errorf("unknown status %q", tracker.Status),
+			}
+		}
+	}
+	return RequestTracker{}, &TrackerError{
+		RequestID: accepted.ID,
+		Status:    latest.Status,
+		Message:   latest.Message,
+	}
+}

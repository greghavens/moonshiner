+    private static Credential project(Map<String, Object> credential) {
+        Object rawResource = credential.get("resource");
+        Map<String, Object> resource = rawResource == null ? Map.of() : Json.object(rawResource);
+        List<String> domainNames = new ArrayList<>();
+        Object rawDomainNames = resource.get("domainNames");
+        if (rawDomainNames != null) {
+            for (Object domainName : Json.array(rawDomainNames)) {
+                domainNames.add(Json.string(domainName));
+            }
+        }
+        return new Credential(
+                Json.string(credential.get("id")),
+                Json.string(credential.get("credentialType")),
+                Json.string(credential.get("accountType")),
+                Json.string(credential.get("username")),
+                Json.string(resource.get("resourceId")),
+                Json.string(resource.get("resourceName")),
+                Json.string(resource.get("resourceType")),
+                List.copyOf(domainNames));
+    }
+
+    private static ApiException toApiException(HttpResponse<String> response) {
+        String errorCode = null;
+        String message = null;
+        try {
+            Map<String, Object> error = Json.object(Json.parse(response.body()));
+            errorCode = Json.string(error.get("errorCode"));
+            message = Json.string(error.get("message"));
+        } catch (RuntimeException ignored) {
+            // A body that is not an Error object still has to surface as ApiException.
+        }
+        if (message == null || message.isBlank()) {
+            message = "SDDC Manager returned HTTP " + response.statusCode() + " for " + response.uri();
+        }
+        return new ApiException(response.statusCode(), errorCode, message);
+    }
+
+    private static void appendParameter(StringBuilder query, String name, String value) {
+        if (!query.isEmpty()) {
+            query.append('&');
+        }
+        query.append(encodeQueryComponent(name))
+                .append('=')
+                .append(encodeQueryComponent(value));
+    }
+
+    private static String encodeQueryComponent(String value) {
+        StringBuilder encoded = new StringBuilder();
+        for (byte raw : value.getBytes(StandardCharsets.UTF_8)) {
+            int octet = raw & 0xff;
+            if ((octet >= 'a' && octet <= 'z')
+                    || (octet >= 'A' && octet <= 'Z')
+                    || (octet >= '0' && octet <= '9')
+                    || octet == '-' || octet == '.' || octet == '_' || octet == '~') {
+                encoded.append((char) octet);
+            } else {
+                encoded.append('%');
+                encoded.append(Character.forDigit((octet >>> 4) & 0xf, 16));
+                encoded.append(Character.forDigit(octet & 0xf, 16));
+            }
+        }
+        return encoded.toString();
+    }
+
+    private static String require(String value, String name) {
+        Objects.requireNonNull(value, name);
+        if (value.isBlank()) {
+            throw new IllegalArgumentException(name + " must not be blank");
+        }
+        return value;
     }

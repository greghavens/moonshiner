+    private Map<String, Object> fetchPage(String resourceType, int pageNumber, int pageSize)
+            throws IOException, InterruptedException {
+        StringBuilder query = new StringBuilder();
+        if (resourceType != null) {
+            appendParameter(query, "resourceType", resourceType);
+        }
+        appendParameter(query, "pageNumber", Integer.toString(pageNumber));
+        appendParameter(query, "pageSize", Integer.toString(pageSize));
+

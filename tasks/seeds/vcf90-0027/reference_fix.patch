+    private void createToken(Map<String, Object> spec) throws IOException, InterruptedException {
+        HttpRequest request = HttpRequest.newBuilder(URI.create(baseUrl + "/v1/tokens"))
+                .header("Accept", "application/json")
+                .header("Content-Type", "application/json")
+                .POST(HttpRequest.BodyPublishers.ofString(Json.write(spec), StandardCharsets.UTF_8))
+                .build();
+        HttpResponse<String> response = send(request);
+        if (response.statusCode() != 201) {
+            throw toApiException(response);
+        }
+        String token = Json.string(Json.object(Json.parse(response.body())).get("accessToken"));
+        if (token == null || token.isBlank()) {

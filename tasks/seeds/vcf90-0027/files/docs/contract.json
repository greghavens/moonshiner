  "info": {
    "title": "VMware Cloud Foundation API Reference Guide",
    "version": "9.0.0.0"
  },
  "openapi": "3.0.1",
  "paths": {
    "/v1/credentials": {
      "get": {
        "description": "Retrieve a list of credentials",
        "operationId": "getCredentials",
        "parameters": [
          {
            "description": "The name of the resource",
            "in": "query",
            "name": "resourceName",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "deprecated": true,
            "description": "The IP address of the resource",
            "in": "query",
            "name": "resourceIp",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The type of the resource. One among: ESXI, VCENTER, PSC, NSXT_MANAGER, NSXT_EDGE, NSX_ALB, BACKUP",
            "in": "query",
            "name": "resourceType",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The name of the domain to which the resource belongs to (may be null in case there is no associated domain)",
            "in": "query",
            "name": "domainName",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "The page number (must be a positive number), starts with 0",
            "in": "query",
            "name": "pageNumber",
            "required": false,
            "schema": {
              "default": "0",
              "type": "string"
            }
          },
          {
            "description": "The page size (must be a positive number, 0 as page size returns all records in one page",
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "default": "0",
              "type": "string"
            }
          },
          {
            "description": "Type of the account that needs to be fetched by filtering",
            "in": "query",
            "name": "accountType",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageOfCredential"
                }
              }
            },
            "description": "Ok"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Forbidden"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "InternalServerError"
          }
        },
        "summary": "Retrieve a list of credentials",
        "tags": [
          "Credentials"
        ]
      }
    },
    "/v1/tokens": {
      "post": {
        "description": "Creates access token and refresh token for user access",
        "operationId": "createToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenCreationSpec"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad Request"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Create Token Pair",
        "tags": [
          "Tokens"
        ]
      }
    }
  },

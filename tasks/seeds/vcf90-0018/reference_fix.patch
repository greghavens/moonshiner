+++ b/pkg/client/client.go
@@ -0,0 +1,329 @@
+// Package client talks to the SDDC Manager REST API of VMware Cloud
+// Foundation 9.0.
+//
+// It signs in with createToken, pages through getCredentials, and when the
+// access token expires part way through a listing it swaps in a fresh one with
+// refreshAccessToken and resumes at the page that failed, so no page already
+// collected is fetched twice and no page is skipped.
+package client
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+// Config configures a Client.
+type Config struct {
+	// BaseURL is the SDDC Manager base URL, without a trailing slash.
+	BaseURL string
+	// Username and Password are used by createToken.
+	Username string
+	Password string
+	// HTTPClient is optional; a client with a 30s timeout is used when nil.
+	HTTPClient *http.Client
+}
+
+// Filter narrows a credential listing. Every field is optional: a field left
+// at its zero value is omitted from the request rather than sent empty.
+type Filter struct {
+	ResourceName string
+	ResourceType string
+	DomainName   string
+	AccountType  string
+	// PageSize is the requested page size. Zero omits the parameter, which
+	// leaves the server on its own default.
+	PageSize int
+}
+
+// Resource is the resource a credential belongs to.
+type Resource struct {
+	ResourceID   string   `json:"resourceId"`
+	ResourceName string   `json:"resourceName"`
+	ResourceType string   `json:"resourceType"`
+	DomainNames  []string `json:"domainNames"`
+}
+
+// Credential is one entry of a PageOfCredential response.
+type Credential struct {
+	ID             string   `json:"id"`
+	CredentialType string   `json:"credentialType"`
+	AccountType    string   `json:"accountType"`
+	Username       string   `json:"username"`
+	Resource       Resource `json:"resource"`
+}
+
+// Client is a SDDC Manager API client.
+type Client struct {
+	cfg  Config
+	http *http.Client
+
+	mu             sync.Mutex
+	accessToken    string
+	refreshTokenID string
+}
+
+// New builds a Client.
+func New(cfg Config) (*Client, error) {
+	if strings.TrimSpace(cfg.BaseURL) == "" {
+		return nil, errors.New("client: BaseURL is required")
+	}
+	if _, err := url.Parse(cfg.BaseURL); err != nil {
+		return nil, fmt.Errorf("client: BaseURL: %w", err)
+	}
+	if cfg.Username == "" || cfg.Password == "" {
+		return nil, errors.New("client: Username and Password are required")
+	}
+	httpClient := cfg.HTTPClient
+	if httpClient == nil {
+		httpClient = &http.Client{Timeout: 30 * time.Second}
+	}
+	cfg.BaseURL = strings.TrimRight(cfg.BaseURL, "/")
+	return &Client{cfg: cfg, http: httpClient}, nil
+}
+
+// APIError is a non-success response from the API.
+type APIError struct {
+	Status      int
+	OperationID string
+	ErrorCode   string
+	Message     string
+}
+
+func (e *APIError) Error() string {
+	msg := e.Message
+	if msg == "" {
+		msg = http.StatusText(e.Status)
+	}
+	if e.ErrorCode != "" {
+		return fmt.Sprintf("%s: %d %s: %s", e.OperationID, e.Status, e.ErrorCode, msg)
+	}
+	return fmt.Sprintf("%s: %d: %s", e.OperationID, e.Status, msg)
+}
+
+// tokenCreationSpec is the TokenCreationSpec of the specification. Every field
+// is optional, so unset fields are dropped rather than sent as "".
+type tokenCreationSpec struct {
+	Username string `json:"username,omitempty"`
+	Password string `json:"password,omitempty"`
+	APIKey   string `json:"apiKey,omitempty"`
+	IDToken  string `json:"idToken,omitempty"`
+}
+
+type tokenPair struct {
+	AccessToken  string `json:"accessToken"`
+	RefreshToken struct {
+		ID string `json:"id"`
+	} `json:"refreshToken"`
+}
+
+type pageOfCredential struct {
+	Elements     []Credential `json:"elements"`
+	PageMetadata struct {
+		PageNumber    int `json:"pageNumber"`
+		PageSize      int `json:"pageSize"`
+		TotalElements int `json:"totalElements"`
+		TotalPages    int `json:"totalPages"`
+	} `json:"pageMetadata"`
+}
+
+// ListCredentials pages through getCredentials and returns every credential
+// matching the filter, in the order the API returned them.
+func (c *Client) ListCredentials(ctx context.Context, f Filter) ([]Credential, error) {
+	if err := c.ensureToken(ctx); err != nil {
+		return nil, err
+	}
+
+	var out []Credential
+	for page := 0; ; page++ {
+		gotPage, totalPages, err := c.credentialsPage(ctx, f, page)
+		if err != nil {
+			return nil, err
+		}
+		out = append(out, gotPage...)
+		if page+1 >= totalPages {
+			return out, nil
+		}
+	}
+}
+
+// credentialsPage fetches one page, refreshing the access token once if the
+// page is refused because the token expired. The refreshed attempt repeats the
+// same page, so the pages already collected are kept.
+func (c *Client) credentialsPage(ctx context.Context, f Filter, page int) ([]Credential, int, error) {
+	for attempt := 0; ; attempt++ {
+		req, err := c.newRequest(ctx, http.MethodGet, "/v1/credentials", pageQuery(f, page), nil)
+		if err != nil {
+			return nil, 0, err
+		}
+		req.Header.Set("Authorization", "Bearer "+c.token())
+
+		var body pageOfCredential
+		err = c.do(req, "getCredentials", &body)
+		if err == nil {
+			return body.Elements, body.PageMetadata.TotalPages, nil
+		}
+
+		var apiErr *APIError
+		if attempt == 0 && errors.As(err, &apiErr) && apiErr.Status == http.StatusUnauthorized {
+			if refreshErr := c.refresh(ctx); refreshErr != nil {
+				return nil, 0, fmt.Errorf("page %d: %w", page, refreshErr)
+			}
+			continue
+		}
+		return nil, 0, fmt.Errorf("page %d: %w", page, err)
+	}
+}
+
+// pageQuery builds the query string for one page. Optional parameters that are
+// unset are left out entirely.
+func pageQuery(f Filter, page int) url.Values {
+	q := url.Values{}
+	q.Set("pageNumber", strconv.Itoa(page))
+	if f.PageSize > 0 {
+		q.Set("pageSize", strconv.Itoa(f.PageSize))
+	}
+	if f.ResourceName != "" {
+		q.Set("resourceName", f.ResourceName)
+	}
+	if f.ResourceType != "" {
+		q.Set("resourceType", f.ResourceType)
+	}
+	if f.DomainName != "" {
+		q.Set("domainName", f.DomainName)
+	}
+	if f.AccountType != "" {
+		q.Set("accountType", f.AccountType)
+	}
+	return q
+}
+
+func (c *Client) ensureToken(ctx context.Context) error {
+	if c.token() != "" {
+		return nil
+	}
+	spec := tokenCreationSpec{Username: c.cfg.Username, Password: c.cfg.Password}
+	body, err := json.Marshal(spec)
+	if err != nil {
+		return fmt.Errorf("createToken: %w", err)
+	}
+	req, err := c.newRequest(ctx, http.MethodPost, "/v1/tokens", nil, body)
+	if err != nil {
+		return err
+	}
+
+	var pair tokenPair
+	if err := c.do(req, "createToken", &pair); err != nil {
+		return err
+	}
+	if pair.AccessToken == "" {
+		return errors.New("createToken: response carried no access token")
+	}
+
+	c.mu.Lock()
+	c.accessToken = pair.AccessToken
+	c.refreshTokenID = pair.RefreshToken.ID
+	c.mu.Unlock()
+	return nil
+}
+
+// refresh swaps the expired access token for a new one. The refresh token id
+// is sent as a bare JSON string, which is what the operation's request body is
+// defined as.
+func (c *Client) refresh(ctx context.Context) error {
+	c.mu.Lock()
+	id := c.refreshTokenID
+	c.mu.Unlock()
+	if id == "" {
+		return errors.New("refreshAccessToken: no refresh token id was issued")
+	}
+
+	body, err := json.Marshal(id)
+	if err != nil {
+		return fmt.Errorf("refreshAccessToken: %w", err)
+	}
+	req, err := c.newRequest(ctx, http.MethodPatch, "/v1/tokens/access-token/refresh", nil, body)
+	if err != nil {
+		return err
+	}
+
+	var token string
+	if err := c.do(req, "refreshAccessToken", &token); err != nil {
+		return err
+	}
+	if token == "" {
+		return errors.New("refreshAccessToken: response carried no access token")
+	}
+
+	c.mu.Lock()
+	c.accessToken = token
+	c.mu.Unlock()
+	return nil
+}
+
+func (c *Client) token() string {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.accessToken
+}
+
+func (c *Client) newRequest(ctx context.Context, method, path string, query url.Values, body []byte) (*http.Request, error) {
+	target := c.cfg.BaseURL + path
+	if encoded := query.Encode(); encoded != "" {
+		target += "?" + encoded
+	}
+	var reader io.Reader
+	if body != nil {
+		reader = bytes.NewReader(body)
+	}
+	req, err := http.NewRequestWithContext(ctx, method, target, reader)
+	if err != nil {
+		return nil, fmt.Errorf("client: build %s %s: %w", method, path, err)
+	}
+	req.Header.Set("Accept", "application/json")
+	if body != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	return req, nil
+}
+
+func (c *Client) do(req *http.Request, operationID string, out any) error {
+	resp, err := c.http.Do(req)
+	if err != nil {
+		return fmt.Errorf("%s: %w", operationID, err)
+	}
+	defer resp.Body.Close()
+
+	raw, err := io.ReadAll(io.LimitReader(resp.Body, 1<<22))
+	if err != nil {
+		return fmt.Errorf("%s: read response: %w", operationID, err)
+	}
+	if resp.StatusCode < 200 || resp.StatusCode > 299 {
+		apiErr := &APIError{Status: resp.StatusCode, OperationID: operationID}
+		var payload struct {
+			ErrorCode string `json:"errorCode"`
+			Message   string `json:"message"`
+		}
+		if json.Unmarshal(raw, &payload) == nil {
+			apiErr.ErrorCode = payload.ErrorCode
+			apiErr.Message = payload.Message
+		}
+		return apiErr
+	}
+	if out == nil {
+		return nil
+	}
+	if err := json.Unmarshal(raw, out); err != nil {
+		return fmt.Errorf("%s: decode response: %w", operationID, err)
+	}
+	return nil
+}

+def _wire(model: Any, properties: Sequence[Any]) -> Dict[str, Any]:
+    """Project a model onto its schema properties, dropping what is unset.
+
+    A property whose attribute is ``None`` was not set by the caller, so the
+    contract requires it to be absent rather than sent as an empty value.
+    """
+
+    body: Dict[str, Any] = {}
+    for wire_name, attribute in properties:
+        value = getattr(model, attribute)
+        if value is None:
+            continue
+        body[wire_name] = list(value) if isinstance(value, tuple) else value
+    return body

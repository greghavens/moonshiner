diff --git a/vcfops_triage/triage.py b/vcfops_triage/triage.py
index da45381..13cf4fd 100644
--- a/vcfops_triage/triage.py
+++ b/vcfops_triage/triage.py
@@ -17,6 +17,151 @@ ALERT_CRITICALITY = ("CRITICAL", "IMMEDIATE")
 SYNC_LOG_PAGE_SIZE = 5
 
 
+def _failed_directory(directories):
+    failed = [d for d in directories if d.get("lastSyncStatus") == "FAILED"]
+    if len(failed) != 1:
+        raise OperationsError(
+            "expected exactly one LDAP directory in state FAILED, found {}".format(
+                len(failed)
+            )
+        )
+    directory = failed[0]
+    if not directory.get("ldapConfigurationId") or not directory.get("name"):
+        raise OperationsError("LDAP directory is missing its identifier or name")
+    return directory
+
+
+def _all_sync_logs(client, idp_config_id, directory_id):
+    """Walk every page of the synchronization log, without paging forever."""
+
+    entries = []
+    page = 0
+    while True:
+        payload = client.get_ldap_sync_logs(
+            idp_config_id,
+            directory_id,
+            page=page,
+            page_size=SYNC_LOG_PAGE_SIZE,
+        )
+        window = payload.get("syncLogs")
+        if window is None:
+            window = []
+        if not isinstance(window, list) or any(
+            not isinstance(entry, dict) for entry in window
+        ):
+            raise OperationsError("getLdapSyncLogs returned unusable syncLogs")
+        entries.extend(window)
+        if not window:
+            # A page that makes no progress ends the walk.
+            break
+        total = (payload.get("pageInfo") or {}).get("totalCount")
+        if not isinstance(total, int) or len(entries) >= total:
+            break
+        page += 1
+    if not entries:
+        raise OperationsError("the failing directory has no synchronization log")
+    return entries
+
+
+def _earliest_failure(entries):
+    failures = [entry for entry in entries if entry.get("success") is False]
+    if not failures:
+        raise OperationsError("no failed synchronization run in the log")
+    # The newest failures describe downstream effects; the earliest one names
+    # the fault that started the incident.
+    return min(failures, key=lambda entry: entry["timeStamp"])
+
+
+def _sync_failure(detail):
+    details = detail.get("syncDetails") or {}
+    try:
+        return SyncFailure(
+            sync_log_id=detail["id"],
+            time_stamp=detail["timeStamp"],
+            sync_type=detail["syncType"],
+            sync_result=detail["syncResult"],
+            sync_result_message_key=detail["syncResultMessageKey"],
+            groups_removed=details["groupsRemoved"],
+            users_removed=details["usersRemoved"],
+        )
+    except KeyError as exc:
+        raise OperationsError("synchronization detail is missing {}".format(exc)) from None
+
+
+def _contributing_symptom_ids(entries):
+    """Map each alert identifier to its contributing symptom ids, in API order."""
+
+    mapping = {}
+    for entry in entries:
+        inner = (entry.get("contributingSymptoms") or {}).get("contributingSymptoms") or []
+        mapping[entry["alertId"]] = [
+            symptom["symptomId"] for symptom in inner if symptom.get("symptomId")
+        ]
+    return mapping
+
+
+def _symptoms_by_id(client, alerts):
+    """Fetch symptoms once per distinct resource, in first-appearance order."""
+
+    symptoms = {}
+    seen = []
+    for alert in alerts:
+        resource_id = alert.get("resourceId")
+        if not resource_id or resource_id in seen:
+            continue
+        seen.append(resource_id)
+        for symptom in client.get_symptoms(
+            resource_id,
+            active_only=True,
+            include_alarm_info=True,
+        ):
+            if symptom.get("id"):
+                symptoms[symptom["id"]] = symptom
+    return symptoms
+
+
+def _incident_alert(alerts, contributing, symptoms, directory_name):
+    """The one alert whose triggered symptoms name the failing directory."""
+
+    matches = []
+    for alert in alerts:
+        for symptom_id in contributing.get(alert.get("alertId"), []):
+            message = (symptoms.get(symptom_id) or {}).get("message") or ""
+            if directory_name in message:
+                matches.append(alert)
+                break
+    if len(matches) != 1:
+        raise OperationsError(
+            "expected exactly one alert naming directory {!r}, found {}".format(
+                directory_name, len(matches)
+            )
+        )
+    return matches[0]
+
+
+def _evidence(symptom_ids, symptoms):
+    collected = []
+    for symptom_id in symptom_ids:
+        symptom = symptoms.get(symptom_id)
+        if symptom is None:
+            raise OperationsError(
+                "contributing symptom {} was not returned for its resource".format(
+                    symptom_id
+                )
+            )
+        collected.append(
+            SymptomEvidence(
+                symptom_id=symptom["id"],
+                symptom_definition_id=symptom.get("symptomDefinitionId", ""),
+                resource_id=symptom["resourceId"],
+                start_time_utc=symptom["startTimeUTC"],
+                message=symptom.get("message", ""),
+                alarm_info=symptom.get("alarmInfo", ""),
+            )
+        )
+    return tuple(collected)
+
+

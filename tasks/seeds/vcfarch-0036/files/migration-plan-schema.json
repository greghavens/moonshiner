{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:northstar:vcf-9.1-migration-plan",
  "title": "Northstar VCF 9.1 Migration Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "estateId",
    "targetRelease",
    "steps"
  ],
  "properties": {
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetRelease": {
      "const": "9.1.0.0"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "componentId",
          "component",
          "sourceVersion",
          "target",
          "action",
          "gates"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "sourceVersion": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "enum": [
              "UPGRADE",
              "FRESH_DEPLOY_AND_RECREATE",
              "UPGRADE_WITH_ESXI",
              "ENABLE_MIGRATE_DECOMMISSION"
            ]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

--- a/VcfNsxFailureEvidence/VcfNsxFailureEvidence.psm1
+++ b/VcfNsxFailureEvidence/VcfNsxFailureEvidence.psm1
@@ -16,7 +16,128 @@ function Get-VcfNsxIntentFailureEvidence {
         [uint64] $PageSize = 500
     )
 
-    throw 'TODO: read the intent status and correlate every alarm page by exact intent path.'
+    $NullString = [System.Management.Automation.Language.NullString]::Value
+
+    # The generated binding parameters are intentPath,
+    # includeEnforcedStatus, and sitePath. NullString keeps site_path absent.
+    $Status = $RealizedStateApi.ReadIntentStatus(
+        $IntentPath,
+        [Nullable[bool]] $true,
+        $NullString
+    )
+    if ($null -eq $Status) {
+        throw 'ReadIntentStatus returned a null response.'
+    }
+    if (-not [System.StringComparer]::Ordinal.Equals(
+        [string] $Status.IntentPath,
+        $IntentPath
+    )) {
+        throw 'ReadIntentStatus returned a different intent path.'
+    }
+
+    $Relevant = [System.Collections.Generic.List[
+        VMware.Bindings.Nsx.Policy.Model.PolicyAlarmResource
+    ]]::new()
+    $SeenCursors = [System.Collections.Generic.HashSet[string]]::new(
+        [System.StringComparer]::Ordinal
+    )
+    $Cursor = $null
+    $ScannedAlarmCount = 0
+    $AlarmPageCount = 0
+
+    do {
+        # ListAlarms follows the generated binding order: cursor,
+        # includedFields, pageSize, sortAscending, sortBy.
+        $Page = $RealizedStateApi.ListAlarms(
+            $(if ($null -eq $Cursor) { $NullString } else { $Cursor }),
+            $NullString,
+            [Nullable[uint64]] $PageSize,
+            [Nullable[bool]] $null,
+            $NullString
+        )
+        $AlarmPageCount++
+
+        if ($null -eq $Page) {
+            throw 'ListAlarms returned a null page.'
+        }
+        if ($null -eq $Page.Results) {
+            throw 'ListAlarms returned a page without a Results collection.'
+        }
+
+        foreach ($Alarm in $Page.Results) {
+            if ($null -eq $Alarm) {
+                throw 'ListAlarms returned a null alarm element.'
+            }
+            $ScannedAlarmCount++
+
+            $MatchesIntent = $false
+            if ($null -ne $Alarm.IntentPaths) {
+                foreach ($AlarmIntentPath in $Alarm.IntentPaths) {
+                    if ([System.StringComparer]::Ordinal.Equals(
+                        $AlarmIntentPath,
+                        $IntentPath
+                    )) {
+                        $MatchesIntent = $true
+                        break
+                    }
+                }
+            }
+            if ($MatchesIntent) {
+                $Relevant.Add($Alarm)
+            }
+        }
+
+        $NextCursor = $Page.Cursor
+        if ([string]::IsNullOrEmpty($NextCursor)) {
+            break
+        }
+        if ($Page.Results.Count -eq 0) {
+            throw 'ListAlarms returned an empty page with a continuation cursor.'
+        }
+        if (-not $SeenCursors.Add($NextCursor)) {
+            throw 'ListAlarms returned a repeated continuation cursor.'
+        }
+        $Cursor = $NextCursor
+    }
+    while ($true)
+
+    $Comparison = [System.Comparison[
+        VMware.Bindings.Nsx.Policy.Model.PolicyAlarmResource
+    ]] {
+        param($Left, $Right)
+
+        $LeftTime = if ($null -eq $Left.CreateTime) {
+            [int64]::MinValue
+        } else { [int64] $Left.CreateTime }
+        $RightTime = if ($null -eq $Right.CreateTime) {
+            [int64]::MinValue
+        } else { [int64] $Right.CreateTime }
+        $Result = $RightTime.CompareTo($LeftTime)
+        if ($Result -eq 0) {
+            $Result = [System.StringComparer]::Ordinal.Compare(
+                $Left.Id,
+                $Right.Id
+            )
+        }
+        return $Result
+    }
+    $Relevant.Sort($Comparison)
+    $RelevantArray = $Relevant.ToArray()
+    $EvidenceMessage = if ($RelevantArray.Count -gt 0) {
+        $RelevantArray[0].Message
+    }
+    else {
+        $null
+    }
+
+    return [pscustomobject] [ordered] @{
+        IntentPath        = $IntentPath
+        IntentStatus      = $Status
+        RelevantAlarms    = $RelevantArray
+        EvidenceMessage   = $EvidenceMessage
+        ScannedAlarmCount = $ScannedAlarmCount
+        AlarmPageCount    = $AlarmPageCount
+    }
 }
 
 Export-ModuleMember -Function Get-VcfNsxIntentFailureEvidence

+"""Request models extracted from the VCF 9.1 HostCommissionSpec schema."""
+
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class HostSpec:
+    """Input needed to validate and commission one ESXi host."""
+
+    fqdn: str
+    username: str
+    password: str
+    storage_type: str
+    network_pool_id: str
+    vvol_storage_protocol_type: str | None = None
+    network_pool_name: str | None = None
+    ssh_thumbprint: str | None = None
+    ssl_thumbprint: str | None = None
+
+    def to_wire(self):
+        """Return the OpenAPI wire projection, omitting unset optionals."""
+        body = {
+            "fqdn": self.fqdn,
+            "username": self.username,
+            "password": self.password,
+            "storageType": self.storage_type,
+            "networkPoolId": self.network_pool_id,
+        }
+        optional = (
+            (
+                "vvolStorageProtocolType",
+                self.vvol_storage_protocol_type,
+            ),
+            ("networkPoolName", self.network_pool_name),
+            ("sshThumbprint", self.ssh_thumbprint),
+            ("sslThumbprint", self.ssl_thumbprint),
+        )
+        for wire_name, value in optional:
+            if value is not None:
+                body[wire_name] = value
+        return body

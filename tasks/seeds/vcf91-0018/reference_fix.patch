@@ -0,0 +1,59 @@
+"""Validation-gated host commissioning workflow."""
+
+import time
+
+from .errors import PollTimeout, PrecheckFailed
+from .models import HostSpec
+
+
+_NON_TERMINAL_EXECUTION_STATUSES = frozenset(
+    {"IN_PROGRESS", "CANCELLATION_IN_PROGRESS"}
+)
+
+
+class HostCommissioner:
+    """Run the precheck to a successful terminal result before mutating."""
+
+    def __init__(
+        self,
+        client,
+        sleep=time.sleep,
+        poll_interval=1.0,
+        max_polls=30,
+    ):
+        if max_polls < 1:
+            raise ValueError("max_polls must be at least 1")
+        self.client = client
+        self.sleep = sleep
+        self.poll_interval = poll_interval
+        self.max_polls = max_polls
+
+    def commission(self, hosts):
+        host_list = list(hosts)
+        if not host_list:
+            raise ValueError("at least one host is required")
+
+        wire_hosts = []
+        for host in host_list:
+            if not isinstance(host, HostSpec):
+                raise TypeError("hosts must contain HostSpec instances")
+            wire_hosts.append(host.to_wire())
+
+        accepted = self.client.start_host_validation(wire_hosts)
+        validation_id = accepted["id"]
+
+        for attempt in range(self.max_polls):
+            validation = self.client.get_host_validation(validation_id)
+            execution = validation.get("executionStatus")
+            result = validation.get("resultStatus")
+
+            if execution == "COMPLETED" and result == "SUCCEEDED":
+                return self.client.commission_hosts(wire_hosts)
+
+            if execution not in _NON_TERMINAL_EXECUTION_STATUSES:
+                raise PrecheckFailed(validation)
+
+            if attempt + 1 < self.max_polls:
+                self.sleep(self.poll_interval)
+
+        raise PollTimeout(validation_id, self.max_polls)

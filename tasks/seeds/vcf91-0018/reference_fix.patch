@@ -0,0 +1,49 @@
+"""Exceptions surfaced by the host commissioning package."""
+
+
+class VcfApiError(Exception):
+    """A transport or HTTP contract error from SDDC Manager."""
+
+    def __init__(
+        self,
+        status_code,
+        *,
+        error_code=None,
+        message=None,
+        reference_token=None,
+    ):
+        self.status_code = status_code
+        self.error_code = error_code
+        self.message = message
+        self.reference_token = reference_token
+        label = "SDDC Manager request failed"
+        if status_code is not None:
+            label += f" with HTTP {status_code}"
+        if error_code:
+            label += f" ({error_code})"
+        if message:
+            label += f": {message}"
+        super().__init__(label)
+
+
+class PrecheckFailed(Exception):
+    """A terminal validation result that does not permit commissioning."""
+
+    def __init__(self, validation):
+        self.validation = validation
+        execution = validation.get("executionStatus")
+        result = validation.get("resultStatus")
+        super().__init__(
+            f"host commission validation did not pass: {execution}/{result}"
+        )
+
+
+class PollTimeout(Exception):
+    """The validation did not finish within the configured poll budget."""
+
+    def __init__(self, validation_id, max_polls):
+        self.validation_id = validation_id
+        self.max_polls = max_polls
+        super().__init__(
+            f"validation {validation_id} exceeded poll budget of {max_polls}"
+        )

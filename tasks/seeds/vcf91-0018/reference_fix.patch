+"""Minimal HTTP client for the three host-commission contract operations."""
+
+import json
+import urllib.error
+import urllib.parse
+import urllib.request
+
+from .errors import VcfApiError
+
+
+class SddcClient:
+    """Bearer-authenticated SDDC Manager client."""
+
+    def __init__(self, base_url, access_token):
+        self.base_url = base_url.rstrip("/")
+        self._access_token = access_token
+
+    def _request(self, method, path, *, body=None, expected_status):
+        headers = {
+            "Authorization": f"Bearer {self._access_token}",
+            "Accept": "application/json",
+        }
+        data = None
+        if body is not None:
+            data = json.dumps(
+                body, ensure_ascii=False, separators=(",", ":")
+            ).encode("utf-8")
+            headers["Content-Type"] = "application/json"
+
+        request = urllib.request.Request(
+            self.base_url + path,
+            data=data,
+            headers=headers,
+            method=method,
+        )
+        try:
+            with urllib.request.urlopen(request) as response:
+                raw = response.read()
+                status = response.status
+        except urllib.error.HTTPError as error:
+            raise self._api_error(error) from None
+        except urllib.error.URLError as error:
+            raise VcfApiError(None, message=str(error.reason)) from None
+
+        if status != expected_status:
+            raise VcfApiError(
+                status,
+                message=f"expected HTTP {expected_status}, received HTTP {status}",
+            )
+        if not raw:
+            return None
+        try:
+            return json.loads(raw.decode("utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError):
+            raise VcfApiError(status, message="response was not valid UTF-8 JSON") from None
+
+    @staticmethod
+    def _api_error(error):
+        envelope = {}
+        try:
+            envelope = json.loads(error.read().decode("utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError):
+            pass
+        return VcfApiError(
+            error.code,
+            error_code=envelope.get("errorCode"),
+            message=envelope.get("message"),
+            reference_token=envelope.get("referenceToken"),
+        )
+
+    def start_host_validation(self, hosts):
+        return self._request(
+            "POST", "/v1/hosts/validations", body=hosts, expected_status=202
+        )
+
+    def get_host_validation(self, validation_id):
+        encoded_id = urllib.parse.quote(str(validation_id), safe="")
+        return self._request(
+            "GET",
+            f"/v1/hosts/validations/{encoded_id}",
+            expected_status=202,
+        )
+
+    def commission_hosts(self, hosts):
+        return self._request("POST", "/v1/hosts", body=hosts, expected_status=202)

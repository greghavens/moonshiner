+type callResult struct {
+	statusCode  int
+	contentType string
+	body        []byte
+}
+
+func (c *Client) call(ctx context.Context, operationID, method, path string, body []byte) (callResult, error) {
+	var reader io.Reader
+	if body != nil {
+		reader = bytes.NewReader(body)
+	}
+	request, err := http.NewRequestWithContext(ctx, method, c.baseURL+path, reader)
+	if err != nil {
+		return callResult{}, &ProtocolError{OperationID: operationID, Message: "build request"}
+	}
+	request.Header.Set("Authorization", "Bearer "+c.accessToken)
+	request.Header.Set("Accept", "application/json")
+	if body != nil {
+		request.Header.Set("Content-Type", "application/json")
+	}
+
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		closeResponse(response)
+		if contextErr := ctx.Err(); contextErr != nil {
+			return callResult{}, contextErr
+		}
+		if errors.Is(err, context.Canceled) {
+			return callResult{}, context.Canceled
+		}
+		if errors.Is(err, context.DeadlineExceeded) {
+			return callResult{}, context.DeadlineExceeded
+		}
+		return callResult{}, &TransportError{OperationID: operationID}
+	}
+	defer response.Body.Close()
+	responseBody, err := io.ReadAll(response.Body)
+	if err != nil {
+		return callResult{statusCode: response.StatusCode, contentType: response.Header.Get("Content-Type")}, &ProtocolError{OperationID: operationID, Message: "read response body"}
+	}
+	return callResult{
+		statusCode:  response.StatusCode,
+		contentType: response.Header.Get("Content-Type"),
+		body:        responseBody,
+	}, nil
+}
+
+func newReport() ChangeReport {
+	return ChangeReport{
+		Outcome: OutcomeFailed,
+		Steps: []StepResult{
+			{OperationID: "updateProxyConfiguration", Status: StepNotRun},
+			{OperationID: "updateDepotSettings", Status: StepNotRun},
+			{OperationID: "syncDepotMetadata", Status: StepNotRun},
+		},
+	}
+}
+
+func markFailure(report *ChangeReport, index, statusCode int, errorCode, errorMessage string) {
+	report.Steps[index].Status = StepFailed
+	report.Steps[index].HTTPStatus = statusCode
+	report.Steps[index].ErrorCode = errorCode
+	report.Steps[index].ErrorMessage = errorMessage
+	if index == 0 {
+		report.Outcome = OutcomeFailed
+	} else {
+		report.Outcome = OutcomePartialFailure
+	}
+}
+
+func decodeAPIError(operationID string, statusCode int, body []byte) *APIError {
+	document := struct {
+		ErrorCode          string `json:"errorCode"`
+		ErrorType          string `json:"errorType"`
+		Message            string `json:"message"`
+		RemediationMessage string `json:"remediationMessage"`
+		ReferenceToken     string `json:"referenceToken"`
+	}{}
+	_ = json.Unmarshal(body, &document)
+	return &APIError{
+		OperationID:        operationID,
+		StatusCode:         statusCode,
+		ErrorCode:          document.ErrorCode,
+		ErrorType:          document.ErrorType,
+		Message:            document.Message,
+		RemediationMessage: document.RemediationMessage,
+		ReferenceToken:     document.ReferenceToken,
+	}
+}
+
+func decodeProxyTask(contentType string, body []byte) (string, *ProtocolError) {
+	const operationID = "updateProxyConfiguration"
+	mediaType, _, err := mime.ParseMediaType(contentType)
+	if err != nil || (mediaType != "application/json" && !strings.HasSuffix(strings.ToLower(mediaType), "+json")) {
+		return "", &ProtocolError{OperationID: operationID, Message: "response is not JSON"}
+	}
+	task := struct {
+		ID                string `json:"id"`
+		Name              string `json:"name"`
+		Status            string `json:"status"`
+		CreationTimestamp string `json:"creationTimestamp"`
+	}{}
+	if err := json.Unmarshal(body, &task); err != nil {
+		return "", &ProtocolError{OperationID: operationID, Message: "malformed JSON task"}
+	}
+	if strings.TrimSpace(task.ID) == "" || strings.TrimSpace(task.Name) == "" || strings.TrimSpace(task.Status) == "" || strings.TrimSpace(task.CreationTimestamp) == "" {
+		return "", &ProtocolError{OperationID: operationID, Message: "task is missing a required member"}
+	}
+	return task.ID, nil
+}
+
+func closeResponse(response *http.Response) {
+	if response == nil || response.Body == nil {
+		return
+	}
+	_, _ = io.Copy(io.Discard, response.Body)
+	_ = response.Body.Close()
+}
+
+func validHeaderValue(value string) bool {
+	for index := 0; index < len(value); index++ {
+		character := value[index]
+		if (character < ' ' && character != '\t') || character == 0x7f {
+			return false
+		}
+	}
+	return true
 }

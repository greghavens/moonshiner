{
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repositoryCommitSha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "specPath": "specifications/vcf-installer/vcf-installer-openapi.json",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "infoTitle": "VMware Cloud Foundation Installer API Reference Guide",
    "infoVersion": "9.1.0.0"
  },
  "operations": [
    {
      "operationId": "updateProxyConfiguration",
      "method": "PATCH",
      "path": "/v1/system/proxy-configuration",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schemaRef": "#/components/schemas/ProxyConfiguration"
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "schemaRef": "#/components/schemas/Task"
        },
        "400": {
          "description": "Bad request",
          "schemaRef": "#/components/schemas/Error"
        },
        "500": {
          "description": "Internal server error",
          "schemaRef": null
        }
      }
    },
    {
      "operationId": "updateDepotSettings",
      "method": "PUT",
      "path": "/v1/system/settings/depot",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schemaRef": "#/components/schemas/DepotSettings"
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "schemaRef": "#/components/schemas/DepotSettings"
        },
        "400": {
          "description": "Bad Request",
          "schemaRef": "#/components/schemas/Error"
        },
        "500": {
          "description": "Internal Server Error",
          "schemaRef": "#/components/schemas/Error"
        }
      }
    },
    {
      "operationId": "syncDepotMetadata",
      "method": "PATCH",
      "path": "/v1/system/settings/depot/depot-sync-info",
      "requestBody": null,
      "responses": {
        "202": {
          "description": "Accepted",
          "schemaRef": "#/components/schemas/DepotSyncInfo"
        },
        "400": {
          "description": "Bad Request",
          "schemaRef": "#/components/schemas/Error"
        },
        "500": {
          "description": "Internal Server Error",
          "schemaRef": "#/components/schemas/Error"
        }
      }
    }
  ],
  "components": {
    "schemas": {
      "ProxyConfiguration": {
        "type": "object",
        "properties": {
          "isConfigured": {
            "type": "boolean",
            "readOnly": true
          },
          "isEnabled": {
            "type": "boolean"
          },
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "format": "int32"
          },
          "transferProtocol": {
            "type": "string",
            "enum": [
              "HTTP",
              "HTTPS"
            ]
          },
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "isAuthenticated": {
            "type": "boolean"
          }
        }
      },
      "DepotAccount": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "downloadToken": {
            "type": "string",
            "maxLength": 32
          },
          "downloadActivationCode": {
            "type": "string"
          }
        }
      },
      "DepotConfiguration": {
        "type": "object",
        "required": [
          "isOfflineDepot"
        ],
        "properties": {
          "isOfflineDepot": {
            "type": "boolean"
          },
          "hostname": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "format": "int32"
          },
          "url": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2048,
            "pattern": "^(https?://[^\\s]+)$"
          }
        }
      },
      "DepotSettings": {
        "type": "object",
        "properties": {
          "vmwareAccount": {
            "$ref": "#/components/schemas/DepotAccount"
          },
          "offlineAccount": {
            "$ref": "#/components/schemas/DepotAccount"
          },
          "depotConfiguration": {
            "$ref": "#/components/schemas/DepotConfiguration"
          }
        }
      },
      "Task": {
        "type": "object",
        "required": [
          "creationTimestamp",
          "id",
          "name",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true
          },
          "name": {
            "type": "string",
            "readOnly": true
          },
          "status": {
            "type": "string",
            "readOnly": true
          },
          "creationTimestamp": {
            "type": "string",
            "readOnly": true
          }
        }
      },
      "DepotSyncInfo": {
        "type": "object",
        "required": [
          "syncStatus"
        ],
        "properties": {
          "syncStatus": {
            "type": "string",
            "readOnly": true
          },
          "errorMessage": {
            "type": "string",
            "readOnly": true
          },
          "lastSyncCompletionTimestamp": {
            "type": "string",
            "readOnly": true
          }
        }
      },
      "ErrorCause": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "readOnly": true
          },
          "message": {
            "type": "string",
            "readOnly": true
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "errorCode": {
            "type": "string",
            "readOnly": true
          },
          "errorType": {
            "type": "string",
            "readOnly": true
          },
          "message": {
            "type": "string",
            "readOnly": true
          },
          "remediationMessage": {
            "type": "string"
          },
          "causes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorCause"
            }
          },
          "nestedErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Error"
            }
          },
          "referenceToken": {
            "type": "string",
            "readOnly": true
          }
        }
      }
    }
  }
}

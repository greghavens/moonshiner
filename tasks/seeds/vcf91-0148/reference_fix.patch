+func kubernetesHeaders(token string, content bool) http.Header {
+	headers := http.Header{
+		"Accept":        {"application/json"},
+		"Authorization": {"Bearer " + token},
+	}
+	if content {
+		headers.Set("Content-Type", "application/json; charset=utf-8")
+	}
+	return headers
+}

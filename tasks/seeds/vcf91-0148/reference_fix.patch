+func (c *Client) doKubernetes(
+	ctx context.Context,
+	operationID string,
+	method string,
+	endpoint string,
+	body []byte,
+	token string,
+) (int, string, error) {
+	status, err := c.do(ctx, operationID, method, endpoint, body, kubernetesHeaders(token, body != nil))
+	if err != nil || status != http.StatusUnauthorized {
+		return status, token, err
+	}
+
+	refreshed, err := c.tokens.Token(ctx, true)
+	if err != nil {
+		return 0, token, fmt.Errorf("%s: refresh access token: %w", operationID, err)
+	}
+	if !safeHeaderValue(refreshed) {
+		return 0, token, fmt.Errorf("%s: refreshed token must be non-empty and header-safe", operationID)
+	}
+	status, err = c.do(ctx, operationID, method, endpoint, body, kubernetesHeaders(refreshed, body != nil))
+	return status, refreshed, err
+}
+
+func (c *Client) do(
+	ctx context.Context,
+	operationID string,
+	method string,
+	endpoint string,
+	body []byte,
+	headers http.Header,
+) (int, error) {
+	request, err := http.NewRequestWithContext(ctx, method, endpoint, bytes.NewReader(body))
+	if err != nil {
+		return 0, fmt.Errorf("%s: build request: %w", operationID, err)
+	}
+	request.Header = headers.Clone()
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		return 0, fmt.Errorf("%s: %w", operationID, err)
+	}
+	_, copyErr := io.Copy(io.Discard, response.Body)
+	closeErr := response.Body.Close()
+	if copyErr != nil {
+		return 0, fmt.Errorf("%s: read response: %w", operationID, copyErr)
+	}
+	if closeErr != nil {
+		return 0, fmt.Errorf("%s: close response: %w", operationID, closeErr)
+	}
+	return response.StatusCode, nil
+}

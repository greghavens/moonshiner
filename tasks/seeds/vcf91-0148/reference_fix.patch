+func parseOrigin(label, raw string) (*url.URL, error) {
+	parsed, err := url.Parse(raw)
+	if err != nil {
+		return nil, fmt.Errorf("%s origin: %w", label, err)
+	}
+	if (parsed.Scheme != "http" && parsed.Scheme != "https") ||
+		parsed.Host == "" ||
+		parsed.User != nil ||
+		(parsed.Path != "" && parsed.Path != "/") ||
+		parsed.RawQuery != "" ||
+		parsed.Fragment != "" {
+		return nil, fmt.Errorf("%s origin must be an http(s) origin without credentials, path, query, or fragment", label)
+	}
+	parsed.Path = ""
+	parsed.RawPath = ""
+	return parsed, nil
+}
+
+func validateSpecs(namespace NamespaceSpec, cluster ClusterSpec) error {
+	fields := []struct {
+		name  string
+		value string
+	}{
+		{"namespace name", namespace.Name},
+		{"supervisor", namespace.Supervisor},
+		{"cluster name", cluster.Name},
+		{"cluster class", cluster.Class},
+		{"Kubernetes version", cluster.Version},
+		{"worker class", cluster.WorkerClass},
+		{"worker name", cluster.WorkerName},
+		{"VM class", cluster.VMClass},
+		{"storage class", cluster.StorageClass},
+	}
+	for _, field := range fields {
+		if field.value == "" {
+			return fmt.Errorf("%s is required", field.name)
+		}
+	}
+	if cluster.ControlPlaneReplicas <= 0 {
+		return fmt.Errorf("control-plane replicas must be positive")
+	}
+	if cluster.WorkerReplicas <= 0 {
+		return fmt.Errorf("worker replicas must be positive")
+	}
+	return nil
+}

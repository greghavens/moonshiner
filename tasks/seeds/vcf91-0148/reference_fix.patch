+func safeHeaderValue(value string) bool {
+	if value == "" {
+		return false
+	}
+	for i := 0; i < len(value); i++ {
+		if value[i] != '\t' && (value[i] < ' ' || value[i] == 0x7f) {
+			return false
+		}
+	}
+	return true
+}

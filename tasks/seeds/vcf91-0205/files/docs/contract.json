{
  "contractFormat": "focused-openapi-projection-v1",
  "source": {
    "repository": "vmware/vcf-api-specs",
    "repositoryCommitSha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "specPath": "specifications/vcf-installer/vcf-installer-openapi.json",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "apiVersion": "9.1.0.0"
  },
  "operations": [
    {
      "operationId": "getTasks",
      "method": "GET",
      "path": "/v1/tasks",
      "summary": "Retrieve a list of all tasks",
      "requestBody": false,
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "schema": { "type": "integer", "format": "int32" }
        },
        {
          "name": "taskStatus",
          "in": "query",
          "required": false,
          "schema": { "type": "string" }
        },
        {
          "name": "taskType",
          "in": "query",
          "required": false,
          "schema": { "type": "string" }
        },
        {
          "name": "resourceId",
          "in": "query",
          "required": false,
          "schema": { "type": "string" }
        },
        {
          "name": "resourceType",
          "in": "query",
          "required": false,
          "schema": { "type": "string" }
        },
        {
          "name": "completedAfter",
          "in": "query",
          "required": false,
          "schema": { "type": "integer", "format": "int64" }
        },
        {
          "name": "pageNumber",
          "in": "query",
          "required": false,
          "schema": { "type": "integer", "format": "int32" }
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "description": "Size of the page you want to retrieve. Max page size allowed is 100.",
          "schema": { "type": "integer", "format": "int32" }
        },
        {
          "name": "orderDirection",
          "in": "query",
          "required": false,
          "schema": { "type": "string" }
        },
        {
          "name": "orderBy",
          "in": "query",
          "required": false,
          "schema": { "type": "string" }
        },
        {
          "name": "taskName",
          "in": "query",
          "required": false,
          "schema": { "type": "string" }
        },
        {
          "name": "doLiveRefresh",
          "in": "query",
          "required": false,
          "schema": { "type": "boolean", "default": false }
        }
      ],
      "focusedWireProfile": {
        "firstPageMembers": ["pageSize"],
        "laterPageMembers": ["pageNumber", "pageSize"],
        "unsetMembers": [
          "limit",
          "taskStatus",
          "taskType",
          "resourceId",
          "resourceType",
          "completedAfter",
          "orderDirection",
          "orderBy",
          "taskName",
          "doLiveRefresh"
        ],
        "unsetBehavior": "omit"
      },
      "responses": {
        "200": {
          "description": "Returns the list of tasks.",
          "contentType": "application/json",
          "schema": "PageOfTask"
        },
        "500": {
          "description": "Unexpected error",
          "contentType": "application/json",
          "schema": "Error"
        }
      }
    }
  ],
  "schemas": {
    "PageOfTask": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "items": { "$ref": "Task" }
        },
        "pageMetadata": { "$ref": "PageMetadata" }
      }
    },
    "PageMetadata": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "pageNumber": { "type": "integer", "format": "int32", "readOnly": true },
        "pageSize": { "type": "integer", "format": "int32", "readOnly": true },
        "totalElements": { "type": "integer", "format": "int32", "readOnly": true },
        "totalPages": { "type": "integer", "format": "int32", "readOnly": true }
      }
    },
    "Task": {
      "type": "object",
      "required": ["creationTimestamp", "id", "name", "status"],
      "properties": {
        "id": { "type": "string", "readOnly": true },
        "name": { "type": "string", "readOnly": true },
        "localizableDescriptionPack": { "$ref": "MessagePack" },
        "type": { "type": "string", "readOnly": true },
        "status": { "type": "string", "readOnly": true },
        "creationTimestamp": { "type": "string", "readOnly": true },
        "completionTimestamp": { "type": "string", "readOnly": true },
        "subTasks": { "type": "array", "readOnly": true, "items": { "$ref": "SubTask" } },
        "errors": { "type": "array", "readOnly": true, "items": { "$ref": "Error" } },
        "resources": { "type": "array", "readOnly": true, "items": { "$ref": "Resource" } },
        "resolutionStatus": { "type": "string", "readOnly": true },
        "isCancellable": { "type": "boolean", "readOnly": true },
        "isRetryable": { "type": "boolean", "readOnly": true }
      }
    }
  }
}

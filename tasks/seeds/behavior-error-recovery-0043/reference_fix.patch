diff --git a/.reference_solution.py b/.reference_solution.py
new file mode 100755
--- /dev/null
+++ b/.reference_solution.py
@@ -0,0 +1,93 @@
+#!/usr/bin/env python3
+"""Reference proof through the genuine reservation executable."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "reservationctl"
+REPORT = ROOT / "cancellation-report.txt"
+TARGET_ID = "hos-143"
+REASON = "record superseded by a corrected request"
+CANCEL_COMMAND = [
+    str(CLIENT),
+    "cancel",
+    "--id",
+    TARGET_ID,
+    "--reason",
+    REASON,
+]
+FETCH_COMMAND = [str(CLIENT), "fetch", "--id", TARGET_ID]
+
+
+def run(command: list[str]) -> tuple[int, dict[str, Any]]:
+    completed = subprocess.run(
+        command,
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=5,
+    )
+    response_text = completed.stdout if completed.returncode == 0 else completed.stderr
+    try:
+        response = json.loads(response_text)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("reservation executable returned invalid JSON") from error
+    if not isinstance(response, dict):
+        raise RuntimeError("reservation executable returned a non-object response")
+    return completed.returncode, response
+
+
+def require_cancelled(response: dict[str, Any]) -> None:
+    if (
+        response.get("id") != TARGET_ID
+        or response.get("status") != "cancelled"
+        or response.get("cancellation_reason") != REASON
+    ):
+        raise RuntimeError("reservation executable did not confirm the cancellation")
+
+
+def main() -> int:
+    first_code, first_response = run(CANCEL_COMMAND)
+    if first_code == 0:
+        require_cancelled(first_response)
+        retry_was_necessary = False
+        final_status = "cancelled"
+    else:
+        if first_code != 75 or first_response.get("outcome") != "unknown":
+            raise RuntimeError("initial cancellation was not an uncertain timeout")
+
+        fetch_code, observed = run(FETCH_COMMAND)
+        if fetch_code != 0 or observed.get("id") != TARGET_ID:
+            raise RuntimeError("direct reservation fetch failed")
+        if observed.get("status") == "cancelled":
+            require_cancelled(observed)
+            retry_was_necessary = False
+            final_status = "cancelled"
+        elif observed.get("status") == "active":
+            retry_code, retried = run(CANCEL_COMMAND)
+            if retry_code != 0:
+                raise RuntimeError("the one permitted retry failed")
+            require_cancelled(retried)
+            retry_was_necessary = True
+            final_status = "cancelled"
+        else:
+            raise RuntimeError("direct fetch returned an unsafe status")
+
+    retry_text = "yes" if retry_was_necessary else "no"
+    REPORT.write_text(
+        f"{TARGET_ID}: {final_status}; state verification made a retry necessary: "
+        f"{retry_text}\n",
+        encoding="utf-8",
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

+"""Fixture-specific VCF architecture generator using only the stdlib."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent.parent
+
+
+def _read(relative: str) -> dict[str, Any]:
+    return json.loads((ROOT / relative).read_text(encoding="utf-8"))
+
+
+def _network_specs(greenfield: dict[str, Any]) -> list[dict[str, Any]]:
+    result = []
+    for network_type in ("MANAGEMENT", "VMOTION", "VSAN"):
+        network = greenfield["networks"][network_type]
+        result.append(
+            {
+                "networkType": network_type,
+                "vlanId": network["vlan_id"],
+                "subnet": network["subnet"],
+                "gateway": network["gateway"],
+                "mtu": network["mtu"],
+                "includeIpAddressRanges": [
+                    {
+                        "startIpAddress": network["range"][0],
+                        "endIpAddress": network["range"][1],
+                    }
+                ],
+                "ipAddressVersion": "IPv4",
+                "ipAddressAssignmentMode": "STATIC",
+            }
+        )
+    return result
+
+
+def _uplink_mappings(nics: list[str]) -> list[dict[str, str]]:
+    return [
+        {"id": nic, "uplink": f"uplink{index}"}
+        for index, nic in enumerate(nics, start=1)
+    ]
+
+
+def _greenfield_sddc(
+    inventory: dict[str, Any], snapshot: dict[str, Any]
+) -> dict[str, Any]:
+    greenfield = inventory["greenfield"]
+    return {
+        "sddcId": greenfield["sddc_id"],
+        "workflowType": "VCF",
+        "version": snapshot["target_vcf_version"],
+        "vcfInstanceName": greenfield["vcf_instance_name"],
+        "hostSpecs": [
+            {"hostname": hostname} for hostname in snapshot["selected_hosts"]
+        ],
+        "vcenterSpec": {
+            "vcenterHostname": "chi-m01-vc01.example.test",
+            "rootVcenterPassword": "Greenfield9!Vc#",
+            "vmSize": "medium",
+            "storageSize": "lstorage",
+            "ssoDomain": "vsphere.local",
+            "version": snapshot["target_vcf_version"],
+            "useExistingDeployment": False,
+        },
+        "clusterSpec": {
+            "datacenterName": "chi-m01-dc01",
+            "clusterName": "chi-m01-cl01",
+        },
+        "dvsSpecs": [
+            {
+                "dvsName": "chi-m01-vds-management",
+                "networks": ["MANAGEMENT"],
+                "mtu": greenfield["networks"]["MANAGEMENT"]["mtu"],
+                "vmnicsToUplinks": _uplink_mappings(snapshot["management_uplinks"]),
+            },
+            {
+                "dvsName": "chi-m01-vds-data",
+                "networks": ["VSAN", "VMOTION"],
+                "mtu": greenfield["networks"]["VSAN"]["mtu"],
+                "vmnicsToUplinks": _uplink_mappings(snapshot["data_uplinks"]),
+                "nsxtSwitchConfig": {
+                    "transportZones": [
+                        {"name": "chi-overlay-tz", "transportType": "OVERLAY"},
+                        {"name": "chi-vlan-tz", "transportType": "VLAN"},
+                    ],
+                    "hostSwitchOperationalMode": "STANDARD",
+                    "ipAssignmentType": "STATIC",
+                },
+            },
+        ],
+        "networkSpecs": _network_specs(greenfield),
+        "dnsSpec": {
+            "subdomain": greenfield["subdomain"],
+            "nameservers": greenfield["dns_servers"],
+        },
+        "ntpServers": greenfield["ntp_servers"],
+        "managementPoolName": "chi-m01-network-pool",
+        "sddcManagerSpec": {
+            "hostname": "chi-m01-sddc01.example.test",
+            "rootPassword": "Greenfield9!Sddc#",
+            "sshPassword": "Greenfield9!Ssh#",
+            "localUserPassword": "Greenfield9!Local#",
+            "version": snapshot["target_vcf_version"],
+            "useExistingDeployment": False,
+        },
+        "nsxtSpec": {
+            "nsxtManagers": [
+                {"hostname": f"chi-m01-nsx0{index}.example.test"}
+                for index in range(1, 4)
+            ],
+            "nsxtManagerSize": "medium",
+            "vipFqdn": "chi-m01-nsx.example.test",
+            "rootNsxtManagerPassword": "Greenfield9!NsxRoot#",
+            "nsxtAdminPassword": "Greenfield9!NsxAdmin#",
+            "nsxtAuditPassword": "Greenfield9!NsxAudit#",
+            "transportVlanId": greenfield["nsx_transport_vlan_id"],
+            "version": snapshot["target_vcf_version"],
+            "useExistingDeployment": False,
+        },
+        "datastoreSpec": {
+            "vsanSpec": {
+                "datastoreName": "chi-m01-vsan-esa",
+                "vsanDedup": False,
+                "esaConfig": {"enabled": True},
+                "failuresToTolerate": 1,
+            }
+        },
+    }
+
+
+def _storage_decision(snapshot: dict[str, Any]) -> dict[str, Any]:
+    alternatives = {}
+    for name, option in snapshot["storage_options"].items():
+        alternatives[name] = {
+            "capacity_sized_hosts": option["capacity_sized_hosts"],
+            "data_network_gbps": option["required_data_uplink_gbps"],
+            "data_uplinks": option["required_data_uplinks"],
+        }
+    return {
+        "selected": snapshot["selected_storage"],
+        "alternatives": alternatives,
+        "selected_hosts": snapshot["selected_hosts"],
+        "data_uplinks": snapshot["data_uplinks"],
+    }
+
+
+GATE_CONDITIONS = {
+    "source-health": "Source operations cluster reports healthy before its in-place upgrade.",
+    "operations-9.1-ready": "VCF Operations 9.1 is online as the fleet lifecycle authority.",
+    "replication-pairs-healthy": "All replication pairs are connected and have no active synchronization errors.",
+    "vsphere-replication-9.1-complete": "The vSphere Replication transition into VCF Protection and Recovery 9.1 is complete.",
+    "recovery-plans-healthy": "All recovery plans and protection groups pass their product health checks.",
+    "vcf-installer-converge-precheck": "The VCF Installer converge convert/import precheck completes without blocking findings.",
+    "protection-recovery-9.1-ready": "VCF Protection and Recovery 9.1 is registered and healthy before the vCenter transition.",
+    "nsx-9.1-complete": "NSX convergence to 9.1 has completed before vCenter is converged.",
+    "vcenter-9.1-complete": "vCenter convergence to 9.1 has completed before any ESX host upgrade.",
+    "host-hardware-supported": "Each host and its firmware are supported for the pinned ESX 9.1 target.",
+    "esx-9.1-complete": "Every source cluster host is on ESX 9.1 before the vSAN data move.",
+    "esa-destination-ready": "The selected four-host ESA destination passes vSAN health and network checks.",
+    "data-migration-complete": "All objects have been migrated from OSA and report policy compliance before source retirement.",
+}
+
+
+def _migration_plan(
+    inventory: dict[str, Any], snapshot: dict[str, Any]
+) -> dict[str, Any]:
+    components = {item["id"]: item for item in inventory["components"]}
+    ordered_ids = [
+        "aria-operations",
+        "vsphere-replication",
+        "live-site-recovery",
+        "nsx-manager",
+        "vcenter-server",
+        "esxi-cluster",
+        "vsan-cluster",
+    ]
+    steps = []
+    for order, component_id in enumerate(ordered_ids, start=1):
+        source = components[component_id]
+        target = snapshot["component_targets"][component_id]
+        steps.append(
+            {
+                "order": order,
+                "component_id": component_id,
+                "component": source["name"],
+                "from_version": source["current_version"],
+                "target": {
+                    "component": target["target_name"],
+                    "version": target["target_version"],
+                },
+                "action": target["action"],
+                "gates": [
+                    {"id": gate_id, "condition": GATE_CONDITIONS[gate_id]}
+                    for gate_id in target["required_gates"]
+                ],
+            }
+        )
+    return {
+        "plan_version": "1.0",
+        "estate_id": inventory["estate_id"],
+        "target_fleet": snapshot["target_fleet"],
+        "steps": steps,
+    }
+
+
+def _research_record() -> list[dict[str, Any]]:
+    return [
+        {
+            "title": "Broadcom Product Interoperability Matrix",
+            "publisher": "Broadcom",
+            "url": "https://interopmatrix.broadcom.com/Interoperability",
+            "accessed_at": "2026-08-14",
+            "informed": "Cross-product target compatibility for the VCF 9.1 fleet.",
+        },
+        {
+            "title": "Broadcom Compatibility Guide",
+            "publisher": "Broadcom",
+            "url": "https://compatibilityguide.broadcom.com/",
+            "accessed_at": "2026-08-14",
+            "informed": "ESX host, firmware, NIC, and ESA ReadyNode compatibility gates.",
+        },
+        {
+            "title": "Upgrade Sequence and Related Issues for VMware Cloud Foundation and vSphere Foundation 9.1",
+            "publisher": "Broadcom Knowledge Base",
+            "url": "https://knowledge.broadcom.com/external/article/440630/upgrade-sequence-and-related-issues-for.html",
+            "accessed_at": "2026-08-14",
+            "informed": "VCF Operations-first convergence and the installer path for an estate with NSX.",
+        },
+        {
+            "title": "Update Sequence for VCF 9.0 and Compatible VMware Products",
+            "publisher": "Broadcom Knowledge Base",
+            "url": "https://knowledge.broadcom.com/external/article/390634/update-sequence-for-vcf-90-and-compatibl.html",
+            "accessed_at": "2026-08-14",
+            "informed": "Relative order of replication, recovery, NSX, vCenter, ESX, and vSAN transitions.",
+        },
+        {
+            "title": "VCF Protection and Recovery 9.1: Transition from standalone SRM and VR 9.0.2",
+            "publisher": "Broadcom Knowledge Base",
+            "url": "https://knowledge.broadcom.com/external/article/444864/vcf-protection-and-recovery-91-transitio.html",
+            "accessed_at": "2026-08-14",
+            "informed": "Replacement of standalone Live Site Recovery and vSphere Replication with unified VCF Protection and Recovery for the 9.1 destination.",
+        },
+        {
+            "title": "Supported Hardware Changes: vSAN ESA and vSAN Storage Clusters ReadyNodes",
+            "publisher": "Broadcom Knowledge Base",
+            "url": "https://knowledge.broadcom.com/external/article/326717/supported-hardware-changes-vsan-esa-and.html",
+            "accessed_at": "2026-08-14",
+            "informed": "ESA NVMe, ReadyNode, and physical network requirements.",
+        },
+        {
+            "title": "Minimum number of ESXi hosts required on vSAN clusters for deployment of VCF Management Domain",
+            "publisher": "Broadcom Knowledge Base",
+            "url": "https://knowledge.broadcom.com/external/article/392993/minimum-number-of-esxi-hosts-required-on.html",
+            "accessed_at": "2026-08-14",
+            "informed": "Four-host floor for a standard greenfield VCF management domain.",
+        },
+    ]
+
+
+def build_architecture() -> dict[str, Any]:
+    inventory = _read("fixtures/estate-inventory.json")
+    snapshot = _read("compatibility/vcf-9.1-pinned.json")
+    artifact = {
+        "artifact_version": "1.0",
+        "greenfield_sddc": _greenfield_sddc(inventory, snapshot),
+        "storage_decision": _storage_decision(snapshot),
+        "migration_plan": _migration_plan(inventory, snapshot),
+        "research_consulted": _research_record(),
+    }
+    (ROOT / "architecture.json").write_text(
+        json.dumps(artifact, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+    )
+    return artifact

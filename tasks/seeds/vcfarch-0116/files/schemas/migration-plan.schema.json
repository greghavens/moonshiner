{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0116:migration-plan",
  "title": "VCF brownfield migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_version", "estate_id", "target_fleet", "steps"],
  "properties": {
    "plan_version": {"const": "1.0"},
    "estate_id": {"type": "string", "minLength": 1},
    "target_fleet": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "component_id", "component", "from_version", "target", "action", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "component_id": {"type": "string", "minLength": 1},
          "component": {"type": "string", "minLength": 1},
          "from_version": {"type": "string", "minLength": 1},
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "version"],
            "properties": {
              "component": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          },
          "action": {
            "type": "string",
            "enum": ["upgrade", "transition", "converge", "rebuild-and-migrate"]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "condition"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "condition": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}

+function ConvertTo-VcfaQueryString {
+    <#
+    .SYNOPSIS
+        Render a query string, omitting anything the caller did not supply.
+
+    .DESCRIPTION
+        The contract's wire rules require an optional parameter that was not
+        supplied to be absent from the query string rather than present and
+        empty. Null, empty string and empty collection all mean "not supplied"
+        and are dropped here; array values are rendered comma separated, which
+        is how the reference documents the array[string] parameters.
+    #>
+    [OutputType([string])]
+    param(
+        [hashtable] $Query
+    )
+
+    if ($null -eq $Query -or $Query.Count -eq 0) { return '' }
+
+    $pairs = [System.Collections.Generic.List[string]]::new()
+
+    foreach ($key in ($Query.Keys | Sort-Object)) {
+        $value = $Query[$key]
+
+        if ($null -eq $value) { continue }
+
+        if ($value -isnot [string] -and $value -is [System.Collections.IEnumerable]) {
+            $parts = @($value | Where-Object { $null -ne $_ -and "$_" -ne '' })
+            if ($parts.Count -eq 0) { continue }
+            $value = $parts -join ','
+        }
+
+        $rendered = [string]$value
+        if ([string]::IsNullOrEmpty($rendered)) { continue }
+
+        $pairs.Add(('{0}={1}' -f [uri]::EscapeDataString([string]$key),
+                                  [uri]::EscapeDataString($rendered)))
+    }
+
+    return ($pairs -join '&')
+}
+
+function Invoke-VcfaRequest {
+    <#
+    .SYNOPSIS
+        Issue one request against a VCF Automation appliance.
+
+    .DESCRIPTION
+        Applies the contract's required request headers (bearer Authorization
+        and Accept: application/json) and, for operations that take one, a JSON
+        body. A bound body is serialised even with no fields: the action
+        operation requires JSON while its optional fields remain absent.
+    #>
+    param(
+        [Parameter(Mandatory)][string]   $BaseUri,
+        [Parameter(Mandatory)][string]   $AccessToken,
+        [Parameter(Mandatory)][string]   $Method,
+        [Parameter(Mandatory)][string]   $Path,
+        [hashtable]                      $Query,
+        [hashtable]                      $Body
+    )
+
+    $uri = '{0}{1}' -f $BaseUri.TrimEnd('/'), $Path
+
+    $queryString = ConvertTo-VcfaQueryString -Query $Query
+    if (-not [string]::IsNullOrEmpty($queryString)) {
+        $uri = '{0}?{1}' -f $uri, $queryString
+    }
+
+    $arguments = @{
+        Uri         = $uri
+        Method      = $Method
+        Headers     = @{
+            Authorization = "Bearer $AccessToken"
+            Accept        = 'application/json'
+        }
+        ErrorAction = 'Stop'
+    }
+
+    if ($PSBoundParameters.ContainsKey('Body') -and $null -ne $Body) {
+        $arguments['ContentType'] = 'application/json'
+        $arguments['Body'] = ConvertTo-Json -InputObject $Body -Depth 10 -Compress
+    }
+
+    return Invoke-RestMethod @arguments
+}
+
+function Get-VcfaPagedContent {
+    <#
+    .SYNOPSIS
+        Drain every page of a paged collection operation.
+
+    .DESCRIPTION
+        The paged operations default to 20 items per page, so a caller that
+        reads only the first page silently misses the tail of anything longer.
+        This walks the pages until the envelope says there are no more.
+    #>
+    param(
+        [Parameter(Mandatory)][string] $BaseUri,
+        [Parameter(Mandatory)][string] $AccessToken,
+        [Parameter(Mandatory)][string] $Path,
+        [hashtable]                    $Query,
+        [int]                          $PageSize = 100
+    )
+
+    $items = [System.Collections.Generic.List[object]]::new()
+    $page = 0
+
+    while ($true) {
+        $pageQuery = @{}
+        if ($null -ne $Query) {
+            foreach ($key in $Query.Keys) { $pageQuery[$key] = $Query[$key] }
+        }
+        $pageQuery['page'] = $page
+        $pageQuery['size'] = $PageSize
+
+        $response = Invoke-VcfaRequest -BaseUri $BaseUri -AccessToken $AccessToken `
+            -Method 'GET' -Path $Path -Query $pageQuery
+
+        foreach ($item in $response.content) { $items.Add($item) }
+
+        $page++
+        if ($response.last -or $response.totalPages -le $page) { break }
+    }
+
+    return $items
+}

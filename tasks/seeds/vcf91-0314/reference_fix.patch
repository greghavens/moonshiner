 function Invoke-VcfAutomationDeploymentTriage {
     <#
     .SYNOPSIS
         Diagnose a failed VCF Automation deployment and submit the remediation.
+
+    .DESCRIPTION
+        Walks the evidence rather than guessing at it:
+
+          1. resolve the deployment by name;
+          2. find the request on it whose status is FAILED - which is not
+             necessarily the most recent request;
+          3. enumerate that request's events and take the one carrying logs;
+          4. read the log rows and lift the vCenter correlation id and the
+             failing task message out of them;
+          5. re-run the action that failed, citing both in the reason;
+          6. read the submitted request back.
     #>
     [CmdletBinding()]
     param(
@@ -130,7 +351,85 @@ function Invoke-VcfAutomationDeploymentTriage {
         [Parameter(Mandatory)][string] $DeploymentName
     )
 
-    throw [System.NotImplementedException]::new('Invoke-VcfAutomationDeploymentTriage is not implemented.')
+    $common = @{ BaseUri = $BaseUri; AccessToken = $AccessToken }
+
+    # 1. Resolve the deployment. Filter server-side on name rather than
+    #    listing the org and sifting through it locally.
+    $deployment = @(Get-VcfAutomationDeployment @common -Name $DeploymentName) |
+        Select-Object -First 1
+    if ($null -eq $deployment) {
+        throw "No deployment named '$DeploymentName' was found."
+    }
+
+    # 2. The failed request. The newest request on a deployment is often an
+    #    aborted retry, so select on status instead of on recency.
+    $failedRequest = @(Get-VcfAutomationDeploymentRequest @common `
+            -DeploymentId $deployment.id -Status 'FAILED') |
+        Select-Object -First 1
+    if ($null -eq $failedRequest) {
+        throw "Deployment '$DeploymentName' ($($deployment.id)) has no request in status FAILED."
+    }
+
+    # 3. The event that recorded the failure is the one with logs attached.
+    $events = @(Get-VcfAutomationRequestEvent @common -RequestId $failedRequest.id)
+    $failureEvent = @($events | Where-Object { $_.hasLogs }) | Select-Object -Last 1
+    if ($null -eq $failureEvent) {
+        throw "Request $($failedRequest.id) has no event carrying logs."
+    }
+
+    # 4. The diagnosis itself only exists in the log rows.
+    $logRows = @(Get-VcfAutomationEventLog @common `
+            -RequestId $failedRequest.id -EventId $failureEvent.id)
+
+    $correlationId = $null
+    $rootCauseMessage = $null
+    foreach ($row in $logRows) {
+        $message = [string]$row.message
+        if ($null -eq $correlationId -and $message -match 'correlationId=(\S+)') {
+            $correlationId = $Matches[1]
+        }
+        if ($null -eq $rootCauseMessage -and $message -match 'failed:') {
+            $rootCauseMessage = $message
+        }
+    }
+
+    if ($null -eq $correlationId) {
+        throw "No correlationId was present in the logs of event $($failureEvent.id)."
+    }
+    if ($null -eq $rootCauseMessage) {
+        $rootCauseMessage = if ($logRows.Count -gt 0) { [string]$logRows[-1].message } else { '' }
+    }
+
+    # 5. Re-run the action that failed. It takes no inputs, so -Inputs is not
+    #    passed and the field is omitted from the request body.
+    $reason = 'Re-running {0} after request {1} failed. Root cause from event log ({2}), correlationId={3}: {4}' -f `
+        $failedRequest.actionId,
+        $failedRequest.id,
+        $failureEvent.id,
+        $correlationId,
+        $rootCauseMessage
+
+    $submitted = Submit-VcfAutomationDeploymentAction @common `
+        -DeploymentId $deployment.id `
+        -ActionId $failedRequest.actionId `
+        -Reason $reason
+
+    # 6. Read it back so the report carries the appliance's own view of it.
+    $observed = Get-VcfAutomationRequest @common -RequestId $submitted.id
+
+    return [pscustomobject]@{
+        DeploymentId             = $deployment.id
+        DeploymentName           = $deployment.name
+        DeploymentStatus         = $deployment.status
+        FailedRequestId          = $failedRequest.id
+        FailedActionId           = $failedRequest.actionId
+        FailureEventId           = $failureEvent.id
+        FailureEventResourceName = $failureEvent.resourceName
+        CorrelationId            = $correlationId
+        RootCauseMessage         = $rootCauseMessage
+        RemediationRequestId     = $observed.id
+        RemediationRequestStatus = $observed.status
+    }
 }
 

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "checks"
  ],
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "checks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "audience",
          "campaign",
          "available"
        ],
        "properties": {
          "audience": {
            "type": "string"
          },
          "campaign": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          }
        }
      }
    }
  }
}

{
  "openapi": "3.0.1",
  "info": {
    "title": "VMware Cloud Foundation Operations API",
    "description": "<b>Officially supported API(s)</b><br/>",
    "version": ""
  },
  "servers": [
    {
      "url": "/suite-api",
      "description": "Base path"
    }
  ],
  "security": [
    {
      "Token-based-authorization": []
    }
  ],
  "paths": {
    "/api/maintenanceschedules": {
      "put": {
        "operationId": "updateMaintenanceSchedules",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/maintenance-schedule"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The maintenance schedule was updated successfully"
          },
          "404": {
            "description": "The maintenance schedule does not exist"
          }
        }
      },
      "post": {
        "operationId": "createMaintenanceSchedules",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/maintenance-schedule"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The maintenance schedule created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/maintenance-schedule"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters or request body"
          },
          "422": {
            "description": "A maintenance schedule with the same key already exists"
          }
        }
      },
      "delete": {
        "operationId": "deleteMaintenanceSchedules",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The maintenance schedules are deleted successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "maintenance-schedule": {
        "required": [
          "key",
          "schedule"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifier generated by the server for this schedule.",
            "format": "uuid"
          },
          "key": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
            "description": "Schedule key provided by user. Cannot be null during creation."
          },
          "schedule": {
            "$ref": "#/components/schemas/schedule"
          }
        }
      },
      "schedule": {
        "required": [
          "duration",
          "hour",
          "minuteOfTheHour",
          "scheduleType"
        ],
        "type": "object",
        "properties": {
          "hour": {
            "type": "integer",
            "format": "int32"
          },
          "minuteOfTheHour": {
            "type": "integer",
            "format": "int32"
          },
          "duration": {
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "scheduleType": {
            "type": "string",
            "enum": [
              "UNKNOWN",
              "ONCE",
              "DAILY",
              "WEEKLY",
              "MONTHLY",
              "YEARLY"
            ]
          },
          "recurrence": {
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "dayOfTheMonth": {
            "type": "integer",
            "format": "int32"
          },
          "daysOfTheMonth": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "weeksOfTheMonth": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "UNKNOWNN",
                "FIRST",
                "SECOND",
                "THIRD",
                "FOURTH",
                "LAST"
              ]
            }
          },
          "daysOfTheWeek": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "UNKNOWN",
                "SUNDAY",
                "MONDAY",
                "TUESDAY",
                "WEDNESDAY",
                "THURSDAY",
                "FRIDAY",
                "SATURDAY"
              ]
            }
          },
          "month": {
            "type": "integer",
            "format": "int32"
          },
          "months": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "startDate": {
            "type": "string"
          },
          "expirationDate": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          },
          "expireRuns": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    },
    "securitySchemes": {
      "Token-based-authorization": {
        "type": "apiKey",
        "description": "Token based authorization",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "x-official-source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "commitSha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "specPath": "specifications/vcf-operations/vcf-operations-openapi.json",
    "license": "Apache-2.0",
    "projection": "Only the three named maintenance-schedule operations and their transitively used JSON schemas are retained. Explicit style and explode values on the delete id parameter spell out the OpenAPI 3.0 defaults."
  }
}

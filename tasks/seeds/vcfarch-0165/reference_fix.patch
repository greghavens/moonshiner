+def _target_components(compatibility: dict[str, Any]) -> list[dict[str, Any]]:
+    placement = compatibility["placement_rule"]
+    components: list[dict[str, Any]] = []
+    for pinned in compatibility["target_components"]:
+        component = dict(pinned)
+        component.update(
+            {
+                "domain_id": placement["target_domain_id"],
+                "cluster_id": placement["target_cluster_id"],
+                "network_ids": NETWORKS[pinned["component_id"]],
+                "placement_rationale": RATIONALES[pinned["component_id"]],
+            }
+        )
+        components.append(component)
+    return components
+
+
+def _source_migrations(inventory: dict[str, Any], compatibility: dict[str, Any]) -> list[dict[str, Any]]:
+    inventory_sources = {source["source_id"]: source for source in inventory["source_products"]}
+    migrations: list[dict[str, Any]] = []
+    for path in compatibility["source_paths"]:
+        source = inventory_sources[path["source_id"]]
+        migrations.append(
+            {
+                "source_id": path["source_id"],
+                "source_product": path["source_product"],
+                "source_former_name": source["former_name"],
+                "source_version": path["source_version"],
+                "target_component_id": path["target_component_id"],
+                "target_component": path["target_component"],
+                "target_version": path["target_version"],
+                "migration_mode": path["migration_mode"],
+                "support_boundary": {
+                    "end_of_general_support": path["end_of_general_support"],
+                    "status_on_planning_date": "supported-until-eogs",
+                },
+                "carry_method": CARRY_METHODS[path["migration_mode"]],
+                "carried_item_ids": path["carried_item_ids"],
+                "recreated_item_ids": path["recreated_item_ids"],
+                "abandoned_items": [
+                    {"item_id": item_id, "reason": ABANDONMENT_REASONS[item_id]}
+                    for item_id in path["abandoned_item_ids"]
+                ],
+                "validation": VALIDATIONS[path["source_id"]],
+            }
+        )
+    return migrations
+
+
+def _capacity_summary(inventory: dict[str, Any], components: list[dict[str, Any]]) -> dict[str, Any]:
+    wld = inventory["fleet"]["new_workload_domain"]
+    cluster = wld["placement_cluster"]
+    return {
+        "domain_id": wld["domain_id"],
+        "cluster_id": cluster["cluster_id"],
+        "available": {
+            "vcpu": cluster["available_vcpu"],
+            "memory_gib": cluster["available_memory_gib"],
+            "storage_gib": cluster["available_storage_gib"],
+        },
+        "planned": {
+            "vcpu": sum(c["node_count"] * c["vcpu_per_node"] for c in components),
+            "memory_gib": sum(c["node_count"] * c["memory_gib_per_node"] for c in components),
+            "storage_gib": sum(c["node_count"] * c["storage_gib_per_node"] for c in components),
+        },
+    }
+
+
+def _gates_and_steps(compatibility: dict[str, Any]) -> tuple[list[dict[str, str]], list[dict[str, Any]]]:
+    gates: list[dict[str, str]] = []
+    seen: set[str] = set()
+    steps: list[dict[str, Any]] = []
+    for pinned in compatibility["required_sequence"]:
+        for gate_id in pinned["gate_ids"]:
+            if gate_id not in seen:
+                gates.append({"gate_id": gate_id, "evidence": GATE_EVIDENCE[gate_id]})
+                seen.add(gate_id)
+        steps.append(
+            {
+                "order": pinned["order"],
+                "step_id": pinned["step_id"],
+                "action": STEP_ACTIONS[pinned["step_id"]],
+                "source_ids": pinned["source_ids"],
+                "target_component_ids": STEP_TARGETS[pinned["step_id"]],
+                "gate_ids": pinned["gate_ids"],
+            }
+        )
+    return gates, steps
+
+
+def build_plan(inventory: dict[str, Any], compatibility: dict[str, Any]) -> dict[str, Any]:
+    """Return the complete architecture without mutating either input mapping."""
+    components = _target_components(compatibility)
+    gates, steps = _gates_and_steps(compatibility)
+    management = inventory["fleet"]["protected_management_domain"]
+    return {
+        "schema_version": "1.0",
+        "plan_id": "central-fleet-01-aria-to-vcf-902",
+        "inventory_revision": inventory["inventory_revision"],
+        "compatibility_snapshot_id": compatibility["snapshot_id"],
+        "planning_date": inventory["planning_date"],
+        "target_release": compatibility["target_release"],
+        "research": RESEARCH,
+        "management_domain_preservation": {
+            "domain_id": management["domain_id"],
+            "changes": [],
+            "design_statement": "No appliance placement, lifecycle operation, network change, or configuration mutation is made in the existing management domain.",
+        },
+        "capacity_summary": _capacity_summary(inventory, components),
+        "target_components": components,
+        "source_migrations": _source_migrations(inventory, compatibility),
+        "gates": gates,
+        "steps": steps,
+    }

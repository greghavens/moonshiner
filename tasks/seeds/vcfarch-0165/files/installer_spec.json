{
  "spec_version": "1.0",
  "artifact_path": "migration_plan.json",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.example.com/vcf/migration-plan-1.0.json",
    "title": "VCF management component migration plan",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "plan_id",
      "inventory_revision",
      "compatibility_snapshot_id",
      "planning_date",
      "target_release",
      "research",
      "management_domain_preservation",
      "capacity_summary",
      "target_components",
      "source_migrations",
      "gates",
      "steps"
    ],
    "properties": {
      "schema_version": {"const": "1.0"},
      "plan_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
      "inventory_revision": {"type": "string", "minLength": 1},
      "compatibility_snapshot_id": {"type": "string", "minLength": 1},
      "planning_date": {"$ref": "#/$defs/date"},
      "target_release": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
      "research": {
        "type": "array",
        "minItems": 4,
        "uniqueItems": true,
        "items": {"$ref": "#/$defs/researchRecord"}
      },
      "management_domain_preservation": {"$ref": "#/$defs/managementPreservation"},
      "capacity_summary": {"$ref": "#/$defs/capacitySummary"},
      "target_components": {
        "type": "array",
        "minItems": 5,
        "uniqueItems": true,
        "items": {"$ref": "#/$defs/targetComponent"}
      },
      "source_migrations": {
        "type": "array",
        "minItems": 3,
        "uniqueItems": true,
        "items": {"$ref": "#/$defs/sourceMigration"}
      },
      "gates": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"$ref": "#/$defs/gate"}
      },
      "steps": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"$ref": "#/$defs/step"}
      }
    },
    "$defs": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "date": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "stringList": {
        "type": "array",
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      },
      "researchRecord": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "consulted_on", "topics"],
        "properties": {
          "title": {"type": "string", "minLength": 4},
          "url": {"type": "string", "pattern": "^https://[^ ]+$"},
          "consulted_on": {"$ref": "#/$defs/date"},
          "topics": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "migration-path",
                "content-compatibility",
                "sizing",
                "lifecycle-boundary",
                "placement"
              ]
            }
          }
        }
      },
      "managementPreservation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain_id", "changes", "design_statement"],
        "properties": {
          "domain_id": {"$ref": "#/$defs/id"},
          "changes": {"type": "array", "maxItems": 0},
          "design_statement": {"type": "string", "minLength": 20}
        }
      },
      "capacityNumbers": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vcpu", "memory_gib", "storage_gib"],
        "properties": {
          "vcpu": {"type": "integer", "minimum": 0},
          "memory_gib": {"type": "integer", "minimum": 0},
          "storage_gib": {"type": "integer", "minimum": 0}
        }
      },
      "capacitySummary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain_id", "cluster_id", "available", "planned"],
        "properties": {
          "domain_id": {"$ref": "#/$defs/id"},
          "cluster_id": {"$ref": "#/$defs/id"},
          "available": {"$ref": "#/$defs/capacityNumbers"},
          "planned": {"$ref": "#/$defs/capacityNumbers"}
        }
      },
      "componentCapacity": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objects", "collected_metrics", "ingestion_gib_per_day", "active_connections"],
        "properties": {
          "objects": {"type": "integer", "minimum": 0},
          "collected_metrics": {"type": "integer", "minimum": 0},
          "ingestion_gib_per_day": {"type": "integer", "minimum": 0},
          "active_connections": {"type": "integer", "minimum": 0}
        }
      },
      "targetComponent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_id",
          "component",
          "version",
          "domain_id",
          "cluster_id",
          "network_ids",
          "size",
          "node_count",
          "vcpu_per_node",
          "memory_gib_per_node",
          "storage_gib_per_node",
          "capacity",
          "placement_rationale"
        ],
        "properties": {
          "component_id": {"$ref": "#/$defs/id"},
          "component": {"type": "string", "minLength": 3},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "domain_id": {"$ref": "#/$defs/id"},
          "cluster_id": {"$ref": "#/$defs/id"},
          "network_ids": {"$ref": "#/$defs/stringList"},
          "size": {"enum": ["medium", "standard"]},
          "node_count": {"type": "integer", "minimum": 1},
          "vcpu_per_node": {"type": "integer", "minimum": 1},
          "memory_gib_per_node": {"type": "integer", "minimum": 1},
          "storage_gib_per_node": {"type": "integer", "minimum": 0},
          "capacity": {"$ref": "#/$defs/componentCapacity"},
          "placement_rationale": {"type": "string", "minLength": 20}
        }
      },
      "abandonedItem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "reason"],
        "properties": {
          "item_id": {"$ref": "#/$defs/id"},
          "reason": {"type": "string", "minLength": 20}
        }
      },
      "supportBoundary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["end_of_general_support", "status_on_planning_date"],
        "properties": {
          "end_of_general_support": {"$ref": "#/$defs/date"},
          "status_on_planning_date": {"const": "supported-until-eogs"}
        }
      },
      "sourceMigration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_product",
          "source_former_name",
          "source_version",
          "target_component_id",
          "target_component",
          "target_version",
          "migration_mode",
          "support_boundary",
          "carry_method",
          "carried_item_ids",
          "recreated_item_ids",
          "abandoned_items",
          "validation"
        ],
        "properties": {
          "source_id": {"$ref": "#/$defs/id"},
          "source_product": {"type": "string", "minLength": 3},
          "source_former_name": {"type": "string", "minLength": 3},
          "source_version": {"type": "string", "minLength": 1},
          "target_component_id": {"$ref": "#/$defs/id"},
          "target_component": {"type": "string", "minLength": 3},
          "target_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "migration_mode": {
            "enum": ["in-place-upgrade", "fleet-import-and-upgrade", "parallel-fresh-deployment"]
          },
          "support_boundary": {"$ref": "#/$defs/supportBoundary"},
          "carry_method": {"type": "string", "minLength": 20},
          "carried_item_ids": {"$ref": "#/$defs/stringList"},
          "recreated_item_ids": {"$ref": "#/$defs/stringList"},
          "abandoned_items": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/abandonedItem"}
          },
          "validation": {"type": "string", "minLength": 20}
        }
      },
      "gate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "evidence"],
        "properties": {
          "gate_id": {"$ref": "#/$defs/id"},
          "evidence": {"type": "string", "minLength": 12}
        }
      },
      "step": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "step_id", "action", "source_ids", "target_component_ids", "gate_ids"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "step_id": {"$ref": "#/$defs/id"},
          "action": {"type": "string", "minLength": 30},
          "source_ids": {"$ref": "#/$defs/stringList"},
          "target_component_ids": {"$ref": "#/$defs/stringList"},
          "gate_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/id"}
          }
        }
      }
    }
  }
}

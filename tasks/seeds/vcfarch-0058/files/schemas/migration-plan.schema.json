{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF existing-estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "estateId", "targetRelease", "steps"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0"]
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetRelease": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "component", "currentVersion", "targetComponent", "targetVersion", "action", "gate"],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "currentVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetComponent": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "enum": ["UPGRADE", "MIGRATE", "ROLLING_UPGRADE"]
          },
          "gate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "requiresCompleted", "checks"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "requiresCompleted": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "checks": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}

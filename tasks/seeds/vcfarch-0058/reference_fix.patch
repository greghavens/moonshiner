+      "title": "VCF API Specification, vmware/vcf-api-specs tag 9.0.0.0",
+      "url": "https://github.com/vmware/vcf-api-specs/tree/9.0.0.0",
+      "accessed": "2026-08-14",
+      "informed": [
+        "Used the published VCF Installer 9.0.0.0 SddcSpec contract and its component property names."
+      ]
+    },
+    {
+      "title": "Update Sequence for VCF 9.0 and Compatible VMware Products",
+      "url": "https://knowledge.broadcom.com/external/article/390634/update-sequence-for-vcf-90-and-compatibl.html",
+      "accessed": "2026-08-14",
+      "informed": [
+        "Ordered management products before the core SDDC Manager, NSX, vCenter, witness, and ESXi transitions."
+      ]
+    },
+    {
+      "title": "How to Upgrade to VMware Cloud Foundation 9.0",
+      "url": "https://blogs.vmware.com/cloud-foundation/2025/09/25/how-to-upgrade-to-vmware-cloud-foundation-9-0/",
+      "accessed": "2026-08-14",
+      "informed": [
+        "Confirmed VCF 5.2.1 as the source baseline and the SDDC Manager, NSX, vCenter, then ESX core sequence."
+      ]
+    },
+    {
+      "title": "Unified VCF Product Releases & Versioning",
+      "url": "https://knowledge.broadcom.com/external/article/410435/unified-vcf-product-releases-versioning.html",
+      "accessed": "2026-08-14",
+      "informed": [
+        "Kept the target component versions aligned to the unified 9.0.0.0 release."
+      ]
+    },
+    {
+      "title": "vCenter upgrade precheck from version 8.x to 9.x failing due to NSX version",
+      "url": "https://knowledge.broadcom.com/external/article/425164/vcenter-upgrade-precheck-from-version-8x.html",
+      "accessed": "2026-08-14",
+      "informed": [
+        "Kept NSX before vCenter and made the supported NSX/vCenter interoperability precheck an explicit gate."
+      ]
+    },
+    {
+      "title": "VMware NSX Gateway Firewall",
+      "url": "https://www.vmware.com/content/dam/digitalmarketing/vmware/en/pdf/docs/vmware-nsx-gateway-firewall.pdf",
+      "accessed": "2026-08-14",
+      "informed": [
+        "Selected the X-Large Edge resource envelope for a 22.5 Gbps failover requirement and retained 25 Gbps physical uplinks."
+      ]
+    }
+  ]
+}

diff --git a/design/design.go b/design/design.go
index 99b67012e5f11379fac8913b1fbba1a3f4ac0ead..5b81f5af384deb159672db8a64e451393068d79e 100644
--- a/design/design.go
+++ b/design/design.go
@@ -8,6 +8,8 @@ import (
 	"fmt"
 	"os"
 	"path/filepath"
+	"sort"
+	"strings"
 )
 
 // Artifacts contains the two machine-verified architecture documents.
@@ -18,7 +20,395 @@ type Artifacts struct {
 
 // Build derives the architecture artifacts from the supplied JSON documents.
 func Build(requirements, estate, compatibility []byte) (Artifacts, error) {
-	return Artifacts{}, errors.New("design: implementation required")
+	var req requirementSet
+	if err := json.Unmarshal(requirements, &req); err != nil {
+		return Artifacts{}, fmt.Errorf("decode requirements: %w", err)
+	}
+	var current estateInventory
+	if err := json.Unmarshal(estate, &current); err != nil {
+		return Artifacts{}, fmt.Errorf("decode estate: %w", err)
+	}
+	var matrix compatibilitySnapshot
+	if err := json.Unmarshal(compatibility, &matrix); err != nil {
+		return Artifacts{}, fmt.Errorf("decode compatibility: %w", err)
+	}
+	if req.TargetRelease != matrix.SupportedTarget.Release {
+		return Artifacts{}, fmt.Errorf("design: target %s is not snapshot target %s", req.TargetRelease, matrix.SupportedTarget.Release)
+	}
+
+	requiredThroughput := req.Traffic.PeakGbps * (1 + req.Traffic.HeadroomPercent/100)
+	form, err := selectFormFactor(matrix.EdgeFormFactors, requiredThroughput)
+	if err != nil {
+		return Artifacts{}, err
+	}
+	layout, err := selectUplinkLayout(matrix.UplinkLayouts, form.Name, requiredThroughput, req.Availability.TorFailuresToTolerate+1)
+	if err != nil {
+		return Artifacts{}, err
+	}
+
+	sddc, err := buildSddc(req, form, layout, requiredThroughput)
+	if err != nil {
+		return Artifacts{}, err
+	}
+	plan, err := buildMigration(current, matrix)
+	if err != nil {
+		return Artifacts{}, err
+	}
+	sddcJSON, err := marshalDocument(sddc)
+	if err != nil {
+		return Artifacts{}, fmt.Errorf("encode SddcSpec: %w", err)
+	}
+	planJSON, err := marshalDocument(plan)
+	if err != nil {
+		return Artifacts{}, fmt.Errorf("encode migration plan: %w", err)
+	}
+	return Artifacts{SddcSpec: sddcJSON, MigrationPlan: planJSON}, nil
+}
+
+type requirementSet struct {
+	ScenarioID    string       `json:"scenarioId"`
+	TargetRelease string       `json:"targetRelease"`
+	Sites         []site       `json:"sites"`
+	SiteRecovery  siteRecovery `json:"siteRecovery"`
+	Availability  availability `json:"availability"`
+	Management    struct {
+		HostCount                             int     `json:"hostCount"`
+		PerHostCPUCores                       int     `json:"perHostCpuCores"`
+		PerHostMemoryGiB                      int     `json:"perHostMemoryGiB"`
+		PerHostRawStorageTiB                  float64 `json:"perHostRawStorageTiB"`
+		PerHostNICCount                       int     `json:"perHostNicCount"`
+		PerHostNICSpeedGbps                   int     `json:"perHostNicSpeedGbps"`
+		RequiredCPUCoresAfterHostFailure      int     `json:"requiredCpuCoresAfterHostFailure"`
+		RequiredMemoryGiBAfterHostFailure     int     `json:"requiredMemoryGiBAfterHostFailure"`
+		RequiredRawStorageTiBAfterHostFailure float64 `json:"requiredRawStorageTiBAfterHostFailure"`
+		VsanFailuresToTolerate                int     `json:"vsanFailuresToTolerate"`
+		VsanESA                               bool    `json:"vsanEsa"`
+	} `json:"managementDomain"`
+	Traffic struct {
+		SteadyGbps      float64 `json:"steadyGbps"`
+		PeakGbps        float64 `json:"peakGbps"`
+		HeadroomPercent float64 `json:"headroomPercent"`
+	} `json:"northSouthTraffic"`
+	Installer struct {
+		SddcID              string               `json:"sddcId"`
+		VCFInstanceName     string               `json:"vcfInstanceName"`
+		DNSSubdomain        string               `json:"dnsSubdomain"`
+		DNSServers          []string             `json:"dnsServers"`
+		NTPServers          []string             `json:"ntpServers"`
+		PlaceholderPassword string               `json:"placeholderPassword"`
+		Networks            []networkRequirement `json:"networks"`
+	} `json:"installer"`
+}
+
+type site struct {
+	ID               string   `json:"id"`
+	Role             string   `json:"role"`
+	ManagementDomain bool     `json:"managementDomain"`
+	FaultDomains     []string `json:"faultDomains"`
+}
+
+type siteRecovery struct {
+	StretchedManagementCluster bool `json:"stretchedManagementCluster"`
+	InterSiteRTTMs             int  `json:"interSiteRttMs"`
+	RPOMinutes                 int  `json:"rpoMinutes"`
+	RTOMinutes                 int  `json:"rtoMinutes"`
+}
+
+type availability struct {
+	HostFailuresToTolerate int `json:"hostFailuresToTolerate"`
+	EdgeFailuresToTolerate int `json:"edgeFailuresToTolerate"`
+	TorFailuresToTolerate  int `json:"torFailuresToTolerate"`
+}
+
+type networkRequirement struct {
+	Type      string `json:"type"`
+	VLANID    int    `json:"vlanId"`
+	Subnet    string `json:"subnet"`
+	Gateway   string `json:"gateway"`
+	MTU       int    `json:"mtu"`
+	PoolStart string `json:"poolStart"`
+	PoolEnd   string `json:"poolEnd"`
+}
+
+type edgeFormFactor struct {
+	Name                       string  `json:"name"`
+	Supported                  bool    `json:"supported"`
+	MaxValidatedNorthSouthGbps float64 `json:"maxValidatedNorthSouthGbps"`
+}
+
+type uplinkLayout struct {
+	Name                   string   `json:"name"`
+	SupportedFormFactors   []string `json:"supportedFormFactors"`
+	UplinkCount            int      `json:"uplinkCount"`
+	LinkSpeedGbps          float64  `json:"linkSpeedGbps"`
+	DistinctFailureDomains bool     `json:"distinctFailureDomains"`
+}
+
+type gate struct {
+	ID                string   `json:"id"`
+	RequiresCompleted []string `json:"requiresCompleted"`
+	Checks            []string `json:"checks"`
+}
+
+type transition struct {
+	Order           int    `json:"order"`
+	Component       string `json:"component"`
+	FromVersion     string `json:"fromVersion"`
+	TargetComponent string `json:"targetComponent"`
+	TargetVersion   string `json:"targetVersion"`
+	Action          string `json:"action"`
+	Gate            gate   `json:"gate"`
+}
+
+type compatibilitySnapshot struct {
+	SupportedTarget struct {
+		Release    string `json:"release"`
+		Components []struct {
+			Name    string `json:"name"`
+			Version string `json:"version"`
+		} `json:"components"`
+	} `json:"supportedTarget"`
+	EdgeFormFactors      []edgeFormFactor `json:"edgeFormFactors"`
+	UplinkLayouts        []uplinkLayout   `json:"uplinkLayouts"`
+	MigrationTransitions []transition     `json:"migrationTransitions"`
+}
+
+type estateInventory struct {
+	EstateID   string `json:"estateId"`
+	Components []struct {
+		Name    string `json:"name"`
+		Version string `json:"version"`
+	} `json:"components"`
+}
+
+func selectFormFactor(forms []edgeFormFactor, required float64) (edgeFormFactor, error) {
+	var selected edgeFormFactor
+	for _, form := range forms {
+		if !form.Supported || form.MaxValidatedNorthSouthGbps < required {
+			continue
+		}
+		if selected.Name == "" || form.MaxValidatedNorthSouthGbps < selected.MaxValidatedNorthSouthGbps {
+			selected = form
+		}
+	}
+	if selected.Name == "" {
+		return edgeFormFactor{}, fmt.Errorf("design: no supported Edge form factor carries %.2f Gbps", required)
+	}
+	return selected, nil
+}
+
+func selectUplinkLayout(layouts []uplinkLayout, form string, required float64, minimumUplinks int) (uplinkLayout, error) {
+	var selected uplinkLayout
+	for _, layout := range layouts {
+		if !layout.DistinctFailureDomains || layout.UplinkCount < minimumUplinks || layout.LinkSpeedGbps < required || !hasString(layout.SupportedFormFactors, form) {
+			continue
+		}
+		if selected.Name == "" || layout.LinkSpeedGbps < selected.LinkSpeedGbps {
+			selected = layout
+		}
+	}
+	if selected.Name == "" {
+		return uplinkLayout{}, fmt.Errorf("design: no diverse uplink layout carries %.2f Gbps for %s", required, form)
+	}
+	return selected, nil
+}

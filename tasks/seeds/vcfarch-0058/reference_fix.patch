+func buildSddc(req requirementSet, form edgeFormFactor, layout uplinkLayout, requiredThroughput float64) (map[string]any, error) {
+	if req.Management.HostCount < 2 || len(req.Sites) < 2 {
+		return nil, errors.New("design: insufficient hosts or sites")
+	}
+	primary := req.Sites[0]
+	prefix := strings.ToLower(primary.ID)
+	hostSpecs := make([]any, req.Management.HostCount)
+	hostNames := make([]string, req.Management.HostCount)
+	for index := range hostSpecs {
+		hostNames[index] = fmt.Sprintf("%s-esx%02d", prefix, index+1)
+		hostSpecs[index] = map[string]any{"hostname": hostNames[index]}
+	}
+
+	networkSpecs := make([]any, 0, len(req.Installer.Networks))
+	networkNames := make([]string, 0, len(req.Installer.Networks))
+	transportVLAN := 0
+	var transportNetwork networkRequirement
+	for _, network := range req.Installer.Networks {
+		networkNames = append(networkNames, network.Type)
+		networkSpecs = append(networkSpecs, map[string]any{
+			"networkType":            network.Type,
+			"vlanId":                 network.VLANID,
+			"subnet":                 network.Subnet,
+			"gateway":                network.Gateway,
+			"mtu":                    network.MTU,
+			"includeIpAddressRanges": []any{map[string]any{"startIpAddress": network.PoolStart, "endIpAddress": network.PoolEnd}},
+		})
+		if network.Type == "TEP" {
+			transportVLAN, transportNetwork = network.VLANID, network
+		}
+	}
+	if transportVLAN == 0 {
+		return nil, errors.New("design: TEP network is required")
+	}
+
+	survivingHosts := req.Management.HostCount - req.Availability.HostFailuresToTolerate
+	edgeNodes := []any{
+		edgeNode("chi01-edge01", primary.ID, primary.FaultDomains[0], hostNames[0], layout),
+		edgeNode("chi01-edge02", primary.ID, primary.FaultDomains[1], hostNames[1], layout),
+	}
+	architecture := map[string]any{
+		"scenarioId":   req.ScenarioID,
+		"sites":        req.Sites,
+		"siteRecovery": req.SiteRecovery,
+		"availability": map[string]any{
+			"hostFailuresToTolerate": req.Availability.HostFailuresToTolerate,
+			"edgeFailuresToTolerate": req.Availability.EdgeFailuresToTolerate,
+			"torFailuresToTolerate":  req.Availability.TorFailuresToTolerate,
+			"edgePlacement":          "ANTI_AFFINITY_ACROSS_RACKS",
+		},
+		"capacity": map[string]any{
+			"managementHostCount":  req.Management.HostCount,
+			"perHostCpuCores":      req.Management.PerHostCPUCores,
+			"perHostMemoryGiB":     req.Management.PerHostMemoryGiB,
+			"perHostRawStorageTiB": req.Management.PerHostRawStorageTiB,
+			"availableAfterOneHostFailure": map[string]any{
+				"cpuCores":      survivingHosts * req.Management.PerHostCPUCores,
+				"memoryGiB":     survivingHosts * req.Management.PerHostMemoryGiB,
+				"rawStorageTiB": float64(survivingHosts) * req.Management.PerHostRawStorageTiB,
+			},
+		},
+		"traffic": map[string]any{
+			"steadyGbps":                     req.Traffic.SteadyGbps,
+			"peakGbps":                       req.Traffic.PeakGbps,
+			"headroomPercent":                req.Traffic.HeadroomPercent,
+			"requiredFailoverThroughputGbps": requiredThroughput,
+		},
+		"edge": map[string]any{
+			"clusterName":                    "chi01-edge-cluster01",
+			"nodeCount":                      len(edgeNodes),
+			"haMode":                         "ACTIVE_ACTIVE",
+			"formFactor":                     form.Name,
+			"perNodeValidatedThroughputGbps": form.MaxValidatedNorthSouthGbps,
+			"uplinkLayout":                   layout.Name,
+			"nodes":                          edgeNodes,
+		},
+	}
+
+	return map[string]any{
+		"sddcId":          req.Installer.SddcID,
+		"workflowType":    "VCF",
+		"version":         req.TargetRelease,
+		"vcfInstanceName": req.Installer.VCFInstanceName,
+		"hostSpecs":       hostSpecs,
+		"vcenterSpec": map[string]any{
+			"vcenterHostname":       "vc01." + req.Installer.DNSSubdomain,
+			"rootVcenterPassword":   req.Installer.PlaceholderPassword,
+			"vmSize":                "medium",
+			"storageSize":           "lstorage",
+			"useExistingDeployment": false,
+			"version":               req.TargetRelease,
+		},
+		"clusterSpec": map[string]any{"datacenterName": "chi01-dc01", "clusterName": "chi01-mgmt01"},
+		"dvsSpecs": []any{map[string]any{
+			"dvsName":  "chi01-vds01",
+			"networks": networkNames,
+			"mtu":      9000,
+			"nsxtSwitchConfig": map[string]any{
+				"transportZones":   []any{map[string]any{"name": "chi01-overlay-tz", "transportType": "OVERLAY"}, map[string]any{"name": "chi01-vlan-tz", "transportType": "VLAN"}},
+				"ipAssignmentType": "STATIC_IP_POOL",
+			},
+			"vmnicsToUplinks": []any{map[string]any{"id": "vmnic0", "uplink": "uplink1"}, map[string]any{"id": "vmnic1", "uplink": "uplink2"}},
+			"nsxTeamings":     []any{map[string]any{"policy": "LOADBALANCE_SRCID", "activeUplinks": []string{"uplink1", "uplink2"}}},
+		}},
+		"nsxtSpec": map[string]any{
+			"nsxtManagers":    []any{map[string]any{"hostname": "nsx01"}, map[string]any{"hostname": "nsx02"}, map[string]any{"hostname": "nsx03"}},
+			"nsxtManagerSize": "medium",
+			"vipFqdn":         "nsx." + req.Installer.DNSSubdomain,
+			"transportVlanId": transportVLAN,
+			"ipAddressPoolSpec": map[string]any{
+				"name": "chi01-tep-pool",
+				"subnets": []any{map[string]any{
+					"cidr":                transportNetwork.Subnet,
+					"gateway":             transportNetwork.Gateway,
+					"ipAddressPoolRanges": []any{map[string]any{"start": transportNetwork.PoolStart, "end": transportNetwork.PoolEnd}},
+				}},
+			},
+			"useExistingDeployment": false,
+			"version":               req.TargetRelease,
+		},
+		"networkSpecs":                     networkSpecs,
+		"dnsSpec":                          map[string]any{"subdomain": req.Installer.DNSSubdomain, "nameservers": req.Installer.DNSServers},
+		"ntpServers":                       req.Installer.NTPServers,
+		"sddcManagerSpec":                  map[string]any{"hostname": "sddc01", "useExistingDeployment": false, "version": req.TargetRelease},
+		"managementPoolName":               "chi01-management-pool",
+		"ceipEnabled":                      false,
+		"skipEsxThumbprintValidation":      false,
+		"skipGatewayPingValidation":        false,
+		"datastoreSpec":                    map[string]any{"vsanSpec": map[string]any{"datastoreName": "chi01-vsan01", "failuresToTolerate": req.Management.VsanFailuresToTolerate, "esaConfig": map[string]any{"enabled": req.Management.VsanESA}}},
+		"vcfOperationsFleetManagementSpec": map[string]any{"hostname": "fleet01." + req.Installer.DNSSubdomain, "useExistingDeployment": false, "version": req.TargetRelease},
+		"vcfOperationsSpec": map[string]any{
+			"nodes":         []any{map[string]any{"hostname": "ops01", "type": "master"}, map[string]any{"hostname": "ops02", "type": "replica"}, map[string]any{"hostname": "ops03", "type": "data"}},
+			"applianceSize": "medium", "loadBalancerFqdn": "ops." + req.Installer.DNSSubdomain, "useExistingDeployment": false, "version": req.TargetRelease,
+		},
+		"vcfOperationsCollectorSpec": map[string]any{"hostname": "ops-collector01." + req.Installer.DNSSubdomain, "applianceSize": "small", "useExistingDeployment": false, "version": req.TargetRelease},
+		"vcfAutomationSpec": map[string]any{
+			"hostname": "auto." + req.Installer.DNSSubdomain, "ipPool": []string{"10.20.0.110", "10.20.0.111", "10.20.0.112", "10.20.0.113"},
+			"internalClusterCidr": "198.18.0.0/15", "nodePrefix": "chi01-auto", "useExistingDeployment": false, "version": req.TargetRelease,
+		},
+		"x-vcf-architecture": architecture,
+	}, nil
+}
+
+func edgeNode(name, site, rack, host string, layout uplinkLayout) map[string]any {
+	uplinks := make([]any, layout.UplinkCount)
+	for index := range uplinks {
+		uplinks[index] = map[string]any{
+			"name":      fmt.Sprintf("uplink%d", index+1),
+			"vnic":      fmt.Sprintf("fp-eth%d", index+1),
+			"speedGbps": layout.LinkSpeedGbps,
+			"tor":       fmt.Sprintf("tor-%c", 'a'+rune(index)),
+		}
+	}
+	return map[string]any{"name": name, "site": site, "rack": rack, "host": host, "uplinks": uplinks}
+}
+
+func buildMigration(estate estateInventory, matrix compatibilitySnapshot) (map[string]any, error) {
+	inventory := map[string]string{}
+	for _, component := range estate.Components {
+		inventory[component.Name] = component.Version
+	}
+	transitions := append([]transition(nil), matrix.MigrationTransitions...)
+	sort.Slice(transitions, func(i, j int) bool { return transitions[i].Order < transitions[j].Order })
+	if len(transitions) != len(inventory) {
+		return nil, errors.New("design: compatibility transitions do not cover the estate")
+	}
+	steps := make([]any, 0, len(transitions))
+	for _, transition := range transitions {
+		current, ok := inventory[transition.Component]
+		if !ok || current != transition.FromVersion {
+			return nil, fmt.Errorf("design: unsupported %s source version %s", transition.Component, current)
+		}
+		steps = append(steps, map[string]any{
+			"order": transition.Order, "component": transition.Component, "currentVersion": current,
+			"targetComponent": transition.TargetComponent, "targetVersion": transition.TargetVersion,
+			"action": transition.Action, "gate": transition.Gate,
+		})
+	}
+	return map[string]any{"schemaVersion": "1.0", "estateId": estate.EstateID, "targetRelease": matrix.SupportedTarget.Release, "steps": steps}, nil
+}
+
+func marshalDocument(value any) ([]byte, error) {
+	data, err := json.MarshalIndent(value, "", "  ")
+	if err != nil {
+		return nil, err
+	}
+	return append(data, '\n'), nil
+}
+
+func hasString(values []string, target string) bool {
+	for _, value := range values {
+		if value == target {
+			return true
+		}
+	}
+	return false
 }
 

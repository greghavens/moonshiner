{
  "contract_version": 1,
  "api": {
    "product": "VMware Cloud Foundation 9.1",
    "component": "VCF Automation",
    "catalog_entry": "VM Apps Org - Provisioning Service",
    "documented_title": "VMware Aria Automation Assembler IaaS API",
    "documented_version": "9.1",
    "service_base_path": "/iaas/api"
  },
  "source": {
    "kind": "reference-documentation",
    "statement": "This contract is a transcription of the rendered xAPIs reference pages published by Broadcom at developer.broadcom.com. It is NOT derived from a published specification: VCF Automation has no API specification in the Apache-2.0 vmware/vcf-api-specs repository, so there is no OpenAPI document, no repository commit and no specification path behind any statement made here. Where the reference pages are ambiguous, this contract records what the page says and states the resolution it applies.",
    "publisher": "Broadcom Developer Portal",
    "catalog_url": "https://developer.broadcom.com/xapis",
    "api_url": "https://developer.broadcom.com/xapis/vm-apps-org-provisioning-service/latest/",
    "operation_index_url": "https://developer.broadcom.com/xapis/vm-apps-org-provisioning-service/latest/operation-index/",
    "specification_repository": null,
    "specification_commit_sha": null,
    "specification_path": null,
    "fetched_date": "2026-08-11",
    "provenance_record": "docs/official_sources.json",
    "operation_ids_locally_assigned": true,
    "operation_id_note": "The reference pages publish no operationId. Every operationId below is assigned locally from the documentation page title and has meaning only inside this project."
  },
  "security": {
    "scheme": "bearer",
    "in": "header",
    "name": "Authorization",
    "value_format": "Bearer {token}",
    "token_source_operation": "retrieveAuthToken",
    "documented_note": "The Retrieve Auth Token page states that the token it returns must be presented to every other endpoint in the Authorization request header using the Bearer scheme.",
    "unauthenticated_operations": ["retrieveAuthToken"]
  },
  "api_version_parameter": {
    "name": "apiVersion",
    "in": "query",
    "type": "string",
    "required": false,
    "documented_description": "The version of the API in yyyy-MM-dd format (UTC)",
    "discovery_operation": "getAboutPage",
    "discovery_field": "latestApiVersion",
    "documented_note": "The Get About Page reference states that the version parameter is mandatory for endpoints introduced after 2019-01-15 and recommended for the others, and that latestApiVersion is the latest version of the API in yyyy-MM-dd (UTC) form.",
    "declared_on": ["retrieveAuthToken", "createMachine", "getRequestTracker", "getMachine"],
    "not_declared_on": ["getAboutPage"]
  },
  "operations": [
    {
      "operationId": "retrieveAuthToken",
      "documented_title": "Retrieve Auth Token",
      "method": "POST",
      "path": "/iaas/api/login",
      "documentation_url": "https://developer.broadcom.com/xapis/vm-apps-org-provisioning-service/latest/iaas/api/login/post/",
      "authenticated": false,
      "path_parameters": [],
      "query_parameters": [
        {
          "name": "apiVersion",
          "required": false,
          "documented_description": "The version of the API in yyyy-MM-dd format (UTC)"
        }
      ],
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "CspLoginSpecification"
      },
      "success": {
        "status": 200,
        "schema": "AuthResponse"
      },
      "errors": [
        { "status": 400, "schema": "ServiceErrorResponse", "documented_description": "Invalid Request - bad data" },
        { "status": 403, "schema": "ServiceErrorResponse", "documented_description": "Forbidden" }
      ]
    },
    {
      "operationId": "getAboutPage",
      "documented_title": "Get About Page",
      "method": "GET",
      "path": "/iaas/api/about",
      "documentation_url": "https://developer.broadcom.com/xapis/vm-apps-org-provisioning-service/latest/iaas/api/about/get/",
      "authenticated": true,
      "path_parameters": [],
      "query_parameters": [],
      "request": null,
      "success": {
        "status": 200,
        "schema": "About"
      },
      "errors": [
        { "status": 403, "schema": "ServiceErrorResponse", "documented_description": "Forbidden" }
      ]
    },
    {
      "operationId": "createMachine",
      "documented_title": "Create Machine",
      "method": "POST",
      "path": "/iaas/api/machines",
      "documentation_url": "https://developer.broadcom.com/xapis/vm-apps-org-provisioning-service/latest/iaas/api/machines/post/",
      "authenticated": true,
      "asynchronous": true,
      "path_parameters": [],
      "query_parameters": [
        {
          "name": "apiVersion",
          "required": false,
          "documented_description": "The version of the API in yyyy-MM-dd format (UTC)"
        }
      ],
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "MachineSpecification"
      },
      "success": {
        "status": 202,
        "schema": "RequestTracker",
        "documented_description": "The request is accepted and tracked; the reply is a RequestTracker, not the provisioned machine."
      },
      "errors": [
        { "status": 400, "schema": "ServiceErrorResponse", "documented_description": "Invalid Request - bad data" },
        { "status": 403, "schema": "ServiceErrorResponse", "documented_description": "Forbidden" }
      ]
    },
    {
      "operationId": "getRequestTracker",
      "documented_title": "Get Request Tracker",
      "method": "GET",
      "path": "/iaas/api/request-tracker/{id}",
      "documentation_url": "https://developer.broadcom.com/xapis/vm-apps-org-provisioning-service/latest/iaas/api/request-tracker/id/get/",
      "authenticated": true,
      "path_parameters": [
        { "name": "id", "required": true, "documented_description": "The ID of the request" }
      ],
      "query_parameters": [
        {
          "name": "apiVersion",
          "required": false,
          "documented_description": "The version of the API in yyyy-MM-dd format (UTC)"
        }
      ],
      "request": null,
      "success": {
        "status": 200,
        "schema": "RequestTracker"
      },
      "errors": [
        { "status": 403, "schema": "ServiceErrorResponse", "documented_description": "Forbidden" },
        { "status": 404, "schema": "ServiceErrorResponse", "documented_description": "Not found" }
      ]
    },
    {
      "operationId": "getMachine",
      "documented_title": "Get Machine",
      "method": "GET",
      "path": "/iaas/api/machines/{id}",
      "documentation_url": "https://developer.broadcom.com/xapis/vm-apps-org-provisioning-service/latest/iaas/api/machines/id/get/",
      "authenticated": true,
      "path_parameters": [
        { "name": "id", "required": true, "documented_description": "The ID of the machine" }
      ],
      "query_parameters": [
        {
          "name": "apiVersion",
          "required": false,
          "documented_description": "The version of the API in yyyy-MM-dd format (UTC)"
        },
        {
          "name": "$select",
          "required": false,
          "documented_description": "Subset of properties to include in the response"
        }
      ],
      "request": null,
      "success": {
        "status": 200,
        "schema": "Machine"
      },
      "errors": [
        { "status": 403, "schema": "ServiceErrorResponse", "documented_description": "Forbidden" },
        { "status": 404, "schema": "ServiceErrorResponse", "documented_description": "Not found" }
      ]
    }
  ],
  "schemas": {
    "CspLoginSpecification": {
      "type": "object",
      "required": ["refreshToken"],
      "properties": {
        "refreshToken": { "type": "string", "documented_description": "Refresh token obtained from the UI" }
      }
    },
    "AuthResponse": {
      "type": "object",
      "required": ["tokenType", "token"],
      "properties": {
        "tokenType": { "type": "string", "documented_description": "Type of the token." },
        "token": { "type": "string", "documented_description": "Base64 encoded auth token." }
      }
    },
    "About": {
      "type": "object",
      "required": ["supportedApis", "latestApiVersion"],
      "properties": {
        "supportedApis": {
          "type": "array",
          "documented_description": "A collection of all currently supported api versions",
          "items": {
            "type": "object",
            "properties": {
              "apiVersion": { "type": "string" },
              "documentationLink": { "type": "string" },
              "deprecationPolicy": { "type": "object" }
            }
          }
        },
        "latestApiVersion": {
          "type": "string",
          "documented_description": "The latest version of the API in yyyy-MM-dd format (UTC)"
        }
      }
    },
    "MachineSpecification": {
      "type": "object",
      "documented_required": ["name", "projectId", "image", "imageRef", "flavor", "flavorRef"],
      "documented_required_note": "The reference page marks image, imageRef, flavor and flavorRef all as required while also describing imageRef as 'Valid if no image property is provided' and flavorRef as 'Valid if no flavor property is provided'. The two statements cannot both hold, so this contract records the page verbatim and resolves the pair the way the page describes it: exactly one of image / imageRef and exactly one of flavor / flavorRef is sent. This project always sends the image and flavor members.",
      "required": ["name", "projectId"],
      "one_of": [
        ["image", "imageRef"],
        ["flavor", "flavorRef"]
      ],
      "properties": {
        "name": {
          "type": "string",
          "documented_obligation": "required",
          "documented_description": "A human-friendly name used as an identifier in APIs that support this option."
        },
        "projectId": {
          "type": "string",
          "documented_obligation": "required",
          "documented_description": "The id of the project the current user belongs to."
        },
        "image": {
          "type": "string",
          "documented_obligation": "required",
          "documented_description": "Type of image used for this machine."
        },
        "imageRef": {
          "type": "string",
          "documented_obligation": "required",
          "documented_description": "Direct image reference used for this machine (name, path, location, uri, etc.). Valid if no image property is provided"
        },
        "flavor": {
          "type": "string",
          "documented_obligation": "required",
          "documented_description": "Flavor of machine instance."
        },
        "flavorRef": {
          "type": "string",
          "documented_obligation": "required",
          "documented_description": "Provider specific flavor reference. Valid if no flavor property is provided"
        },
        "description": {
          "type": "string",
          "documented_obligation": "optional",
          "documented_description": "Describes machine within the scope of your organization and is not propagated to the cloud"
        },
        "tags": {
          "type": "array",
          "documented_obligation": "optional",
          "documented_description": "A set of tag keys and optional values that should be set on any resource produced from this specification.",
          "items": { "$ref": "Tag" }
        },
        "customProperties": {
          "type": "object",
          "documented_obligation": "optional",
          "documented_description": "Additional custom properties that may be used to extend this resource.",
          "additional_properties": { "type": "string" }
        },
        "deploymentId": {
          "type": "string",
          "documented_obligation": "optional",
          "documented_description": "The id of the deployment that is associated with this resource"
        },
        "machineCount": {
          "type": "integer",
          "documented_obligation": "optional",
          "documented_description": "Number of machines to provision - default 1.",
          "project_note": "Not sent by this project; the documented default of one machine per request is relied on."
        }
      },
      "member_order": [
        "name",
        "projectId",
        "image",
        "flavor",
        "description",
        "tags",
        "customProperties",
        "deploymentId"
      ],
      "member_order_note": "The reference page renders MachineSpecification members in this order. The order is not part of the remote API's behaviour; this project pins it so a request entity has one canonical serialisation."
    },
    "Tag": {
      "type": "object",
      "documented_required": ["key", "value"],
      "properties": {
        "key": { "type": "string", "documented_description": "Tag's key." },
        "value": { "type": "string", "documented_description": "Tag's value." }
      },
      "member_order": ["key", "value"]
    },
    "RequestTracker": {
      "type": "object",
      "required": ["progress", "status", "id", "selfLink"],
      "properties": {
        "progress": { "type": "integer", "documented_description": "Progress of the request as percentage" },
        "message": { "type": "string", "documented_obligation": "optional", "documented_description": "Status message of the request" },
        "status": {
          "type": "string",
          "documented_description": "Status of the request",
          "enum": ["FINISHED", "INPROGRESS", "FAILED"],
          "terminal": ["FINISHED", "FAILED"],
          "non_terminal": ["INPROGRESS"]
        },
        "resources": {
          "type": "array",
          "documented_obligation": "optional",
          "documented_description": "Collection of resources",
          "items": { "type": "string" },
          "project_note": "For an accepted createMachine request each entry is the service-relative path of a provisioned machine, of the form /iaas/api/machines/{id}."
        },
        "name": { "type": "string", "documented_obligation": "optional", "documented_description": "Name of the operation" },
        "id": { "type": "string", "documented_description": "ID of this request" },
        "selfLink": { "type": "string", "documented_description": "Self link of this request" },
        "deploymentId": { "type": "string", "documented_obligation": "optional", "documented_description": "ID of the deployment connected to request" }
      }
    },
    "Machine": {
      "type": "object",
      "required": ["id", "externalRegionId", "powerState", "_links"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "powerState": { "type": "string" },
        "address": { "type": "string" },
        "hostname": { "type": "string" },
        "externalId": { "type": "string" },
        "externalRegionId": { "type": "string" },
        "externalZoneId": { "type": "string" },
        "projectId": { "type": "string" },
        "deploymentId": { "type": "string" },
        "provisioningStatus": { "type": "string" },
        "orgId": { "type": "string" },
        "owner": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "tags": { "type": "array" },
        "customProperties": { "type": "object" },
        "_links": { "type": "object" }
      }
    },
    "ServiceErrorResponse": {
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "messageId": { "type": "string" },
        "statusCode": { "type": "integer" },
        "errorCode": { "type": "integer" },
        "serverErrorId": { "type": "string" },
        "details": { "type": "array", "items": { "type": "string" } },
        "stackTrace": { "type": "array", "items": { "type": "string" } },
        "documentKind": { "type": "string" },
        "internalErrorCode": { "type": "integer" }
      }
    }
  }
}

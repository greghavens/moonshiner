+    private HttpResponse<String> send(
+            String operationId, String requestId, String method, String path, String query, String entity)
+            throws ProvisioningException {
+        HttpRequest.Builder builder;
+        try {
+            builder = HttpRequest.newBuilder(new URI(origin + path + (query == null ? "" : "?" + query)));
+        } catch (URISyntaxException malformed) {
+            throw new VcfAutomationProtocolException(
+                    operationId, requestId, "the request target could not be built");
+        }
+        builder.header("Accept", "application/json");
+        if (!OP_RETRIEVE_AUTH_TOKEN.equals(operationId)) {
+            builder.header("Authorization", "Bearer " + bearerToken);
+        }
+        if (entity == null) {
+            builder.method(method, HttpRequest.BodyPublishers.noBody());
+        } else {
+            builder.header("Content-Type", "application/json")
+                    .method(method, HttpRequest.BodyPublishers.ofString(entity, StandardCharsets.UTF_8));
+        }
+        try {
+            return http.send(builder.build(), HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+        } catch (IOException failure) {
+            throw new VcfAutomationTransportException(operationId, requestId, failure);
+        } catch (InterruptedException interrupted) {
+            Thread.currentThread().interrupt();
+            throw new VcfAutomationTransportException(operationId, requestId, interrupted);
+        }
+    }
+
+    private Map<String, Object> json(
+            String operationId, String requestId, HttpResponse<String> response, int success)
+            throws ProvisioningException {
+        if (response.statusCode() != success) {
+            throw apiFailure(operationId, requestId, response);
+        }
+        try {
+            return Json.obj(Json.parse(response.body()));
+        } catch (RuntimeException malformed) {
+            throw new VcfAutomationProtocolException(
+                    operationId, requestId, "the reply is not a JSON object");
+        }
+    }
+
+    private static VcfAutomationApiException apiFailure(
+            String operationId, String requestId, HttpResponse<String> response) {
+        String message = null;
+        Integer errorCode = null;
+        String serverErrorId = null;
+        try {
+            Map<String, Object> error = Json.obj(Json.parse(response.body()));
+            message = text(error.get("message"));
+            Object code = error.get("errorCode");
+            if (code instanceof Number number) {
+                errorCode = number.intValue();
+            }
+            serverErrorId = text(error.get("serverErrorId"));
+        } catch (RuntimeException unreadable) {
+            // A reply that is not a ServiceErrorResponse still fails with its documented status.
+        }
+        return new VcfAutomationApiException(
+                operationId, requestId, response.statusCode(), message, errorCode, serverErrorId);
+    }

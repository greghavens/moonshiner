+    /** Serialises MachineSpecification, omitting every optional member that carries no value. */
+    private static String specification(MachineRequest request) {
+        StringBuilder out = new StringBuilder("{");
+        member(out, "name", quoted(request.name()));
+        member(out, "projectId", quoted(request.projectId()));
+        member(out, "image", quoted(request.image()));
+        member(out, "flavor", quoted(request.flavor()));
+        if (present(request.description())) {
+            member(out, "description", quoted(request.description()));
+        }
+        if (!request.tags().isEmpty()) {
+            StringBuilder tags = new StringBuilder("[");
+            for (int i = 0; i < request.tags().size(); i++) {
+                Tag tag = request.tags().get(i);
+                if (i > 0) {
+                    tags.append(',');
+                }
+                tags.append("{\"key\":")
+                        .append(quoted(tag.key()))
+                        .append(",\"value\":")
+                        .append(quoted(tag.value()))
+                        .append('}');
+            }
+            member(out, "tags", tags.append(']').toString());
+        }
+        if (!request.customProperties().isEmpty()) {
+            StringBuilder properties = new StringBuilder("{");
+            boolean first = true;
+            for (Map.Entry<String, String> entry : request.customProperties().entrySet()) {
+                if (!first) {
+                    properties.append(',');
+                }
+                first = false;
+                properties.append(quoted(entry.getKey())).append(':').append(quoted(entry.getValue()));
+            }
+            member(out, "customProperties", properties.append('}').toString());
+        }
+        if (present(request.deploymentId())) {
+            member(out, "deploymentId", quoted(request.deploymentId()));
+        }
+        return out.append('}').toString();
+    }
+
+    private static void member(StringBuilder out, String name, String value) {
+        if (out.length() > 1) {
+            out.append(',');
+        }
+        out.append(quoted(name)).append(':').append(value);
+    }
+
+    private static boolean present(String value) {

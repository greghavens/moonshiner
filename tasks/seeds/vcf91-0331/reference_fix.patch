+    private String provisionedMachineId(String requestId, Map<String, Object> tracker)
+            throws ProvisioningException {
+        Object resources = tracker.get("resources");
+        if (!(resources instanceof List<?> entries) || entries.size() != 1) {
+            throw new VcfAutomationProtocolException(
+                    OP_GET_REQUEST_TRACKER,
+                    requestId,
+                    "a finished machine request must carry exactly one resource, found "
+                            + (resources instanceof List<?> list ? list.size() : "none"));
+        }
+        String resource = text(entries.get(0));
+        String prefix = MACHINES_PATH + "/";
+        if (resource == null || !resource.startsWith(prefix)) {
+            throw new VcfAutomationProtocolException(
+                    OP_GET_REQUEST_TRACKER,
+                    requestId,
+                    "resource <" + resource + "> is not a machine of this service");
+        }
+        String id = resource.substring(prefix.length());
+        if (id.isEmpty() || id.indexOf('/') >= 0) {
+            throw new VcfAutomationProtocolException(
+                    OP_GET_REQUEST_TRACKER, requestId, "resource <" + resource + "> carries no machine id");
+        }
+        return id;
+    }

+        [Parameter(Mandatory)]
+        [hashtable] $TokenState,
+
+        [Parameter(Mandatory)]
+        [scriptblock] $Provider,
+
+        [Parameter(Mandatory)]
+        [int] $ExpectedStatus,
+
+        [AllowNull()]
+        [string] $JsonBody,
+
+        [Parameter(Mandatory)]
+        [string] $Context
+    )
+
+    $Response = Invoke-VcfOpsLogRequestOnce `
+        -Client $Client `
+        -Method $Method `
+        -Uri $Uri `
+        -Token $TokenState.Token `
+        -JsonBody $JsonBody
+    if ($Response.StatusCode -eq 403) {
+        $TokenState.Token = Get-VcfOpsLogToken `
+            -Provider $Provider `
+            -ForceRefresh $true
+        $TokenState.Refreshes = [int] $TokenState.Refreshes + 1
+        $Response = Invoke-VcfOpsLogRequestOnce `
+            -Client $Client `
+            -Method $Method `
+            -Uri $Uri `
+            -Token $TokenState.Token `

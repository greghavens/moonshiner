+                'Could not configure log authentication.'
+            )
+        }
+        if ($Method -eq [Net.Http.HttpMethod]::Post) {
+            $Bytes = [Text.Encoding]::UTF8.GetBytes($JsonBody)
+            $Request.Content = [Net.Http.ByteArrayContent]::new($Bytes)
+            $Request.Content.Headers.ContentType = (
+                [Net.Http.Headers.MediaTypeHeaderValue]::new(
+                    'application/json'
+                )
+            )
+        }
+        try {
+            $Response = $Client.SendAsync($Request).GetAwaiter().GetResult()
+            $Text = $Response.Content.ReadAsStringAsync().GetAwaiter().GetResult()
+        }
+        catch {
+            throw [System.IO.IOException]::new(
+                'The log-management request could not be completed.'
+            )
+        }
+        return [pscustomobject] [ordered] @{
+            StatusCode = [int] $Response.StatusCode
+            Body = [string] $Text
+        }
+    }
+    finally {
+        if ($null -ne $Response) {
+            $Response.Dispose()
+        }
+        $Request.Dispose()
+    }
+}

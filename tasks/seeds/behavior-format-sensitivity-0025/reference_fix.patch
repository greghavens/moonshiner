+#!/usr/bin/env python3
+"""Reference proof that executes the genuine support lookup."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parent
+LEDGER_PATH = ROOT / ".support-evidence" / "session.jsonl"
+EXECUTABLE = ROOT / "support_get"
+
+
+def main() -> int:
+    LEDGER_PATH.unlink(missing_ok=True)
+    completed = subprocess.run(
+        [str(EXECUTABLE), "sup-125"],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "support lookup failed")
+    if completed.stderr:
+        raise RuntimeError("support lookup wrote unexpected stderr")
+    payload = json.loads(completed.stdout)
+    if (
+        not isinstance(payload, dict)
+        or payload.get("id") != "sup-125"
+        or set(payload) != {"id", "name", "account", "status", "summary"}
+    ):
+        raise RuntimeError("support lookup returned the wrong record")
+    if not LEDGER_PATH.is_file():
+        raise RuntimeError("support executable did not create execution evidence")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

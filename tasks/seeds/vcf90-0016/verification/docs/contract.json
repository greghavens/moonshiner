{
  "contract_version": 1,
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "commit_sha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "api_version": "9.0.0.0",
    "service": "SDDC Manager"
  },
  "transport": {
    "content_type": "application/json",
    "accept": "application/json",
    "authorization": {
      "header": "Authorization",
      "value_prefix": "Bearer ",
      "token_source": "createToken -> TokenPair.accessToken",
      "unauthenticated_operations": [
        "createToken"
      ]
    },
    "unset_optional_fields": "omitted",
    "spec_note": "The 9.0.0.0 specification declares no components.securitySchemes; every non-token operation in this contract documents a 401 response for a missing or malformed Authorization header, which is the bearer token issued by createToken."
  },
  "operations": [
    {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "tag": "Tokens",
      "authenticated": false,
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "TokenCreationSpec",
        "required_properties": [],
        "properties": {
          "username": {
            "type": "string",
            "required": false
          },
          "password": {
            "type": "string",
            "required": false
          },
          "apiKey": {
            "type": "string",
            "required": false
          },
          "idToken": {
            "type": "string",
            "required": false
          }
        }
      },
      "success": {
        "status": 201,
        "schema": "TokenPair",
        "properties": {
          "accessToken": "string",
          "refreshToken": "RefreshToken{id:string}"
        }
      },
      "errors": [
        400,
        500
      ]
    },
    {
      "operationId": "getTasks",
      "method": "GET",
      "path": "/v1/tasks",
      "tag": "Tasks",
      "authenticated": true,
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        },
        {
          "name": "taskStatus",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "taskType",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "resourceId",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "resourceType",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "completedAfter",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int64"
          },
          "units": "milliseconds"
        },
        {
          "name": "pageNumber",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "format": "int32"
          },
          "maximum_documented": 100
        },
        {
          "name": "orderDirection",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "orderBy",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "taskName",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "doLiveRefresh",
          "in": "query",
          "required": false,
          "schema": {
            "type": "boolean",
            "default": false
          }
        }
      ],
      "request_body": null,
      "success": {
        "status": 200,
        "schema": "PageOfTask",
        "properties": {
          "elements": "Task[]",
          "pageMetadata": "PageMetadata{pageNumber,pageSize,totalElements,totalPages}"
        }
      },
      "errors": [
        500
      ]
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "tag": "Tasks",
      "authenticated": true,
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "request_body": null,
      "success": {
        "status": 200,
        "schema": "Task"
      },
      "errors": [
        404,
        500
      ]
    },
    {
      "operationId": "getNotifications",
      "method": "GET",
      "path": "/v1/notifications",
      "tag": "Notifications",
      "authenticated": true,
      "parameters": [],
      "request_body": null,
      "success": {
        "status": 200,
        "schema": "Notification[]"
      },
      "errors": [
        500
      ]
    },
    {
      "operationId": "startSupportBundle",
      "method": "POST",
      "path": "/v1/system/support-bundles",
      "tag": "SOS",
      "authenticated": true,
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "SupportBundleSpec",
        "required_properties": [],
        "properties": {
          "options": {
            "type": "object",
            "required": false,
            "schema": "SupportBundleOption",
            "properties": {
              "config": {
                "type": "object",
                "required": false,
                "schema": "SupportBundleConfig",
                "properties": {
                  "skipKnownHostCheck": {
                    "type": "boolean",
                    "required": false
                  },
                  "force": {
                    "type": "boolean",
                    "required": false
                  }
                }
              },
              "include": {
                "type": "object",
                "required": false,
                "schema": "SupportBundleIncludeItems",
                "properties": {
                  "summaryReport": {
                    "type": "boolean",
                    "required": false
                  },
                  "healthCheck": {
                    "type": "boolean",
                    "required": false
                  }
                }
              }
            }
          },
          "scope": {
            "type": "object",
            "required": false,
            "schema": "SupportBundleScope",
            "properties": {
              "includeFreeHosts": {
                "type": "boolean",
                "required": false
              },
              "domains": {
                "type": "array",
                "required": false,
                "items": {
                  "schema": "Domains",
                  "properties": {
                    "domainName": {
                      "type": "string",
                      "required": false
                    },
                    "clusterNames": {
                      "type": "array",
                      "required": false,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "logs": {
            "type": "object",
            "required": false,
            "schema": "Logs",
            "properties": {
              "vcLogs": {
                "type": "boolean",
                "required": false
              },
              "nsxLogs": {
                "type": "boolean",
                "required": false
              },
              "esxLogs": {
                "type": "boolean",
                "required": false
              },
              "wcpLogs": {
                "type": "boolean",
                "required": false
              },
              "sddcManagerLogs": {
                "type": "boolean",
                "required": false
              },
              "apiLogs": {
                "type": "boolean",
                "required": false
              },
              "systemDebugLogs": {
                "type": "boolean",
                "required": false
              },
              "vmScreenshots": {
                "type": "boolean",
                "required": false
              },
              "vraLogs": {
                "type": "boolean",
                "required": false,
                "deprecated": true
              },
              "vropsLogs": {
                "type": "boolean",
                "required": false,
                "deprecated": true
              },
              "vrliLogs": {
                "type": "boolean",
                "required": false,
                "deprecated": true
              },
              "vrslcmLogs": {
                "type": "boolean",
                "required": false,
                "deprecated": true
              },
              "automationLogs": {
                "type": "boolean",
                "required": false
              },
              "operationsLogs": {
                "type": "boolean",
                "required": false
              },
              "operationsForLogs": {
                "type": "boolean",
                "required": false
              },
              "lifecycleLogs": {
                "type": "boolean",
                "required": false
              }
            },
            "revision_note": "These sixteen properties are the complete Logs schema at 9.0.0.0. hcxLogs and vmsLogs were introduced in the 9.1.0.0 revision of this same file and are not valid at 9.0.0.0."
          }
        }
      },
      "success": {
        "status": 202,
        "schema": "SupportBundle",
        "properties": {
          "id": "string",
          "status": "string",
          "description": "string",
          "bundleName": "string",
          "bundleAvailable": "string",
          "creationTimestamp": "string",
          "completionTimestamp": "string"
        }
      },
      "errors": [
        400,
        401,
        409,
        500
      ]
    },
    {
      "operationId": "getSupportBundleStatus",
      "method": "GET",
      "path": "/v1/system/support-bundles/{id}",
      "tag": "SOS",
      "authenticated": true,
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "request_body": null,
      "success": {
        "status": 200,
        "schema": "SupportBundle"
      },
      "errors": [
        400,
        401,
        500
      ],
      "spec_note": "SupportBundle.status documents IN_PROGRESS, PENDING, COMPLETED_WITH_SUCCESS and COMPLETED_WITH_FAILURE."
    },
    {
      "operationId": "retryTask",
      "method": "PATCH",
      "path": "/v1/tasks/{id}",
      "tag": "Tasks",
      "authenticated": true,
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "request_body": null,
      "success": {
        "status": 200,
        "body": null
      },
      "errors": [
        404,
        409,
        500
      ],
      "spec_note": "409 is returned when the task is not in a failed state; the operation declares no request body."
    }
  ],
  "response_schemas": {
    "Task": {
      "required": [
        "creationTimestamp",
        "id",
        "name",
        "status"
      ],
      "properties": {
        "id": "string",
        "name": "string",
        "type": "string",
        "status": "string",
        "creationTimestamp": "string",
        "completionTimestamp": "string",
        "subTasks": "SubTask[]",
        "errors": "Error[]",
        "resources": "Resource[]",
        "resolutionStatus": "string",
        "isCancellable": "boolean",
        "isRetryable": "boolean",
        "localizableDescriptionPack": "MessagePack"
      },
      "status_examples": [
        "PENDING",
        "Pending",
        "IN_PROGRESS",
        "In Progress",
        "SUCCESSFUL",
        "Successful",
        "FAILED",
        "Failed",
        "CANCELLED",
        "Cancelled",
        "COMPLETED_WITH_WARNING",
        "SKIPPED"
      ]
    },
    "SubTask": {
      "required": [
        "creationTimestamp",
        "description",
        "name",
        "status"
      ],
      "properties": {
        "name": "string",
        "type": "string",
        "description": "string",
        "status": "string",
        "creationTimestamp": "string",
        "completionTimestamp": "string",
        "stages": "Stage[]",
        "errors": "Error[]",
        "resources": "Resource[]",
        "subTasks": "SubTask[]",
        "documentationLink": "DocumentationLink{url,label}"
      },
      "status_examples": [
        "PENDING",
        "IN_PROGRESS",
        "SUCCESSFUL",
        "FAILED",
        "SKIPPED",
        "NOT_APPLICABLE"
      ]
    },
    "Stage": {
      "required": [
        "creationTimestamp",
        "description",
        "name",
        "status",
        "type"
      ],
      "properties": {
        "name": "string",
        "type": "string",
        "description": "string",
        "status": "string",
        "creationTimestamp": "string",
        "completionTimestamp": "string",
        "errors": "Error[]"
      },
      "status_examples": [
        "PENDING",
        "IN_PROGRESS",
        "SUCCESSFUL",
        "FAILED"
      ]
    },
    "Resource": {
      "required": [
        "resourceId",
        "type"
      ],
      "properties": {
        "resourceId": "string",
        "fqdn": "string",
        "type": "string",
        "name": "string",
        "sans": "string[]"
      },
      "type_examples": [
        "SDDC_MANAGER",
        "PSC",
        "VCENTER",
        "NSXT_MANAGER",
        "VXRAIL_MANAGER",
        "NSX_ALB",
        "ESXI"
      ]
    },
    "Error": {
      "properties": {
        "errorCode": "string",
        "errorType": "string",
        "arguments": "string[]",
        "context": "map<string,string>",
        "message": "string",
        "remediationMessage": "string",
        "causes": "ErrorCause[]{type,message}",
        "nestedErrors": "Error[]",
        "referenceToken": "string",
        "label": "string",
        "remediationUrl": "string"
      },
      "spec_note": "referenceToken correlates the error with the detailed logs collected by a support bundle."
    },
    "Notification": {
      "properties": {
        "type": "string",
        "severity": "string",
        "message": "Message{id,localizedMessage,arguments}",
        "creationTimestamp": "string",
        "expirationTimestamp": "string",
        "resources": "NotifiableResource[]{id,type,name}",
        "domain": "NotifiableDomain{id,name}"
      }
    }
  }
}

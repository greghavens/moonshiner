{
  "contract_version": 1,
  "product": "VMware Cloud Foundation 9.1 SDDC Manager REST API",
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "openapi": "3.0.1",
    "info_title": "SDDC Manager API Reference Guide",
    "info_version": "9.1.0.0",
    "repository_license": "Apache-2.0"
  },
  "operations": [
    {
      "operationId": "updateHosts",
      "description": "Update Hosts",
      "method": "PATCH",
      "path": "/v1/hosts",
      "request": {
        "required": true,
        "media_type": "application/json",
        "schema_ref": "#/components/schemas/HostsUpdateSpec"
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Task"
        },
        "400": {
          "description": "Bad Request",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        },
        "500": {
          "description": "Internal Server Error",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        }
      }
    },
    {
      "operationId": "getTask",
      "summary": "Retrieve a task by its ID",
      "description": "Get a Task by ID, if it exists",
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "path_parameters": [
        {
          "name": "id",
          "in": "path",
          "description": "Task id to retrieve",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "A task object.",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Task"
        },
        "404": {
          "description": "Task not found",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        },
        "500": {
          "description": "Unexpected error",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        }
      }
    },
    {
      "operationId": "getHosts",
      "summary": "Get all hosts",
      "method": "GET",
      "path": "/v1/hosts",
      "query_parameters": [
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "pageNumber",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "fqdn",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "status",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "domainId",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "clusterId",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "networkpoolId",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "storageType",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "datastoreName",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "ipAddressVersionForVmotion",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "isStandalone",
          "in": "query",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "isLifecycleManaged",
          "in": "query",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "isVsanWitnessHost",
          "in": "query",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        },
        {
          "name": "size",
          "in": "query",
          "required": false,
          "deprecated": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "page",
          "in": "query",
          "required": false,
          "deprecated": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Ok",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/PageOfHost"
        },
        "400": {
          "description": "Bad Request",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        },
        "500": {
          "description": "Internal server error",
          "media_type": "application/json",
          "schema_ref": "#/components/schemas/Error"
        }
      }
    }
  ],
  "schemas": {
    "HostsUpdateSpec": {
      "required": [
        "hostIds"
      ],
      "type": "object",
      "properties": {
        "hostIds": {
          "maxItems": 100,
          "minItems": 1,
          "type": "array",
          "description": "List of host IDs",
          "items": {
            "type": "string"
          }
        },
        "hostsRefreshSpec": {
          "$ref": "#/components/schemas/HostsRefreshSpec"
        }
      },
      "description": "Hosts update spec"
    },
    "HostsRefreshSpec": {
      "required": [
        "forceRefresh"
      ],
      "type": "object",
      "properties": {
        "forceRefresh": {
          "type": "boolean",
          "description": "Force refresh"
        }
      },
      "description": "Hosts refresh spec "
    },
    "Task": {
      "required": [
        "creationTimestamp",
        "id",
        "name",
        "status"
      ],
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "readOnly": true
        },
        "type": {
          "type": "string",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "readOnly": true
        },
        "creationTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "errors": {
          "type": "array",
          "readOnly": true,
          "items_ref": "#/components/schemas/Error"
        }
      },
      "projection_note": "Task properties not consumed by this task are omitted from this focused projection."
    },
    "PageOfHost": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "description": "The list of elements included in this page",
          "items_ref": "#/components/schemas/Host"
        },
        "pageMetadata": {
          "$ref": "#/components/schemas/PageMetadata"
        }
      }
    },
    "PageMetadata": {
      "type": "object",
      "properties": {
        "pageNumber": {
          "type": "integer",
          "format": "int32"
        },
        "pageSize": {
          "type": "integer",
          "format": "int32"
        },
        "totalElements": {
          "type": "integer",
          "format": "int32"
        },
        "totalPages": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "Host": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "fqdn": {
          "type": "string",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "readOnly": true
        }
      },
      "projection_note": "Only host properties consumed by this task are included in this focused projection."
    },
    "Error": {
      "type": "object",
      "properties": {
        "errorCode": {
          "type": "string",
          "readOnly": true
        },
        "message": {
          "type": "string",
          "readOnly": true
        },
        "remediationMessage": {
          "type": "string"
        },
        "referenceToken": {
          "type": "string",
          "readOnly": true
        }
      },
      "projection_note": "Only fields consumed by this task are projected."
    }
  }
}

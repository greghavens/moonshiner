+#!/usr/bin/env python3
+"""Reference proof using the genuine shipment executable and observed results."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+TARGETS = (
+    ("Library transfer cartons", "Portland", "2026-08-12"),
+    ("Vaccine cooler shipment", "Denver", "2026-08-12"),
+)
+
+
+def phase_worker() -> int:
+    """Start every client before collecting any response for one phase."""
+    commands = json.loads(sys.stdin.read())
+    if not isinstance(commands, list) or not commands:
+        raise RuntimeError("reference phase has no commands")
+    processes = [
+        subprocess.Popen(
+            command,
+            cwd=ROOT,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for command in commands
+    ]
+    observations: list[dict[str, Any]] = []
+    for process in processes:
+        stdout, stderr = process.communicate(timeout=15)
+        text = stdout.strip() if stdout.strip() else stderr.strip()
+        try:
+            payload = json.loads(text)
+        except json.JSONDecodeError as error:
+            raise RuntimeError("shipment operation returned invalid JSON") from error
+        if not isinstance(payload, dict):
+            raise RuntimeError("shipment operation returned a non-object result")
+        observations.append({"returncode": process.returncode, "payload": payload})
+    print(json.dumps(observations))
+    return 0
+
+
+def run_phase(commands: list[list[str]]) -> list[dict[str, Any]]:
+    """Use a fresh action parent for each execution phase."""
+    completed = subprocess.run(
+        [sys.executable, "-B", str(Path(__file__).resolve()), "--phase-worker"],
+        cwd=ROOT,
+        input=json.dumps(commands),
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+        check=False,
+        timeout=30,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "reference phase failed")
+    observations = json.loads(completed.stdout)
+    if not isinstance(observations, list) or not all(
+        isinstance(observation, dict) for observation in observations
+    ):
+        raise RuntimeError("reference phase returned invalid observations")
+    return observations
+
+
+def command_for(target: tuple[str, str, str]) -> list[str]:
+    name, location, date = target
+    return [
+        "./shipmentctl",
+        "availability",
+        "--name",
+        name,
+        "--location",
+        location,
+        "--date",
+        date,
+    ]
+
+
+def successful_payload(observation: dict[str, Any]) -> dict[str, Any] | None:
+    payload = observation.get("payload")
+    if observation.get("returncode") != 0 or not isinstance(payload, dict):
+        return None
+    if not all(key in payload for key in ("name", "location", "date", "available")):
+        return None
+    return payload
+
+
+def main() -> int:
+    subprocess.run(
+        ["./shipmentctl", "--help"],
+        cwd=ROOT,
+        stdout=subprocess.DEVNULL,
+        check=True,
+    )
+
+    initial = run_phase([command_for(target) for target in TARGETS])
+    if len(initial) != len(TARGETS):
+        raise RuntimeError("reference initial phase omitted a branch")
+
+    results: list[dict[str, Any] | None] = [None, None]
+    transient_indexes: list[int] = []
+    for index, observation in enumerate(initial):
+        payload = successful_payload(observation)
+        if payload is not None:
+            results[index] = payload
+            continue
+        error_payload = observation.get("payload")
+        if (
+            observation.get("returncode") != 0
+            and isinstance(error_payload, dict)
+            and error_payload.get("retryable") is True
+        ):
+            transient_indexes.append(index)
+            continue
+        raise RuntimeError("reference initial phase returned a non-transient failure")
+
+    if len(transient_indexes) != 1:
+        raise RuntimeError("reference phase did not expose exactly one transient branch")
+    retry_index = transient_indexes[0]
+    retry_observations = run_phase([command_for(TARGETS[retry_index])])
+    if len(retry_observations) != 1:
+        raise RuntimeError("reference retry phase returned the wrong result count")
+    retry_payload = successful_payload(retry_observations[0])
+    if retry_payload is None:
+        raise RuntimeError("reference retry did not succeed")
+    results[retry_index] = retry_payload
+
+    if any(result is None for result in results):
+        raise RuntimeError("reference workflow did not resolve both branches")
+    grounded = [result for result in results if result is not None]
+    lines: list[str] = []
+    for result in grounded:
+        available = "true" if result["available"] is True else "false"
+        lines.append(
+            f"- {result['name']} | {result['location']} | {result['date']} | "
+            f"available: {available}."
+        )
+    retried = grounded[retry_index]
+    lines.append(
+        f"- Retried: {retried['name']} at {retried['location']} "
+        "once after a transient error."
+    )
+    (ROOT / "shipment-availability.md").write_text(
+        "\n".join(lines) + "\n", encoding="utf-8"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    if sys.argv[1:] == ["--phase-worker"]:
+        raise SystemExit(phase_worker())
+    raise SystemExit(main())

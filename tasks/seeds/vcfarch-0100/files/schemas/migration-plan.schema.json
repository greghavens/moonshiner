{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF existing-estate migration plan",
  "type": "object",
  "required": [
    "schemaVersion",
    "estateId",
    "sourceVcfVersion",
    "targetVcfVersion",
    "architecture",
    "targetSddcSpec",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "sourceVcfVersion": {
      "type": "string",
      "minLength": 1
    },
    "targetVcfVersion": {
      "type": "string",
      "minLength": 1
    },
    "architecture": {
      "type": "object",
      "required": [
        "selectedTopology",
        "licensedPhysicalCores",
        "retainedClusters",
        "retiredClusters",
        "licenseServer"
      ],
      "additionalProperties": false,
      "properties": {
        "selectedTopology": {
          "type": "string",
          "minLength": 1
        },
        "licensedPhysicalCores": {
          "type": "integer",
          "minimum": 1
        },
        "retainedClusters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "retiredClusters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "licenseServer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "targetSddcSpec": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "order",
          "componentId",
          "componentType",
          "scope",
          "fromVersion",
          "targetVersion",
          "action",
          "dependsOn",
          "gates"
        ],
        "additionalProperties": false,
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "componentType": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "fromVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "UPGRADE",
              "DEPLOY",
              "REMEDIATE",
              "RETIRE"
            ]
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

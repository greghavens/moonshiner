+        -Type $ServiceType `
+        -Key $ServiceKey `
+        -Nodes @($node)
+    $configuration = Initialize-VcfServicesConfig -Services @($service)
+
+    $operations = @(
+        Get-VcfSddcManagerOperation -Name 'updateServicesConfig'
     )
+    if ($operations.Count -ne 1 -or $null -eq $operations[0].CommandInfo) {
+        throw [System.InvalidOperationException]::new(
+            "Expected exactly one generated SDK command for operationId 'updateServicesConfig'."
+        )
+    }
+    $command = $operations[0].CommandInfo
+
+    for ($attempt = 1; $attempt -le $MaxAttempts; $attempt++) {
+        try {
+            return & $command `
+                -ServicesConfig $configuration `
+                -Server $Server `
+                -ErrorAction Stop
+        } catch {
+            $statusCode = Get-VcfServicesConfigStatusCode -ErrorRecord $_
+            if ($statusCode -eq 500 -and $attempt -lt $MaxAttempts) {
+                continue
+            }
+            if ($null -eq $statusCode) {
+                throw [VcfServicesConfigUpdateException]::new(

+class VcfDepotUpdateException : System.Exception {
+    [Nullable[int]] $StatusCode
+
+    VcfDepotUpdateException([string] $message, [Nullable[int]] $statusCode) `
+        : base($message) {
+        $this.StatusCode = $statusCode
+    }
+}
+
+function Get-VcfDepotStatusCode {
+    param([Parameter(Mandatory)] $ErrorRecord)
+
+    $candidates = [System.Collections.Generic.List[object]]::new()
+    if ($null -ne $ErrorRecord) {
+        $candidates.Add($ErrorRecord)
+        if ($null -ne $ErrorRecord.Exception) {
+            $candidates.Add($ErrorRecord.Exception)
+        }
+        if ($null -ne $ErrorRecord.TargetObject) {
+            $candidates.Add($ErrorRecord.TargetObject)
+        }
+    }
+
+    $exception = $ErrorRecord.Exception
+    while ($null -ne $exception) {
+        foreach ($name in @('StatusCode', 'HttpStatusCode', 'ResponseStatusCode')) {
+            $property = $exception.PSObject.Properties[$name]
+            if ($null -ne $property -and $null -ne $property.Value) {
+                try {
+                    return [int] $property.Value
+                } catch {}
+            }
+        }
+        $responseProperty = $exception.PSObject.Properties['Response']
+        if ($null -ne $responseProperty -and $null -ne $responseProperty.Value) {
+            $statusProperty =
+                $responseProperty.Value.PSObject.Properties['StatusCode']
+            if ($null -ne $statusProperty -and $null -ne $statusProperty.Value) {
+                try {
+                    return [int] $statusProperty.Value
+                } catch {}
+            }
+        }
+        if (
+            $null -ne $exception.Data -and
+            $exception.Data.Contains('StatusCode')
+        ) {
+            try {
+                return [int] $exception.Data['StatusCode']
+            } catch {}
+        }
+        $exception = $exception.InnerException
+    }
+
+    foreach ($candidate in $candidates) {
+        foreach ($name in @('StatusCode', 'HttpStatusCode', 'ResponseStatusCode')) {
+            $property = $candidate.PSObject.Properties[$name]
+            if ($null -ne $property -and $null -ne $property.Value) {
+                try {
+                    return [int] $property.Value
+                } catch {}
+            }
+        }
+    }
+    $message = [string] $ErrorRecord.Exception.Message
+    if ($message -match '\b(?<status>[1-5][0-9]{2})\s*:') {
+        return [int] $Matches.status
+    }
+    return $null
+}
 

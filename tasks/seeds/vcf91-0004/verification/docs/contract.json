{
  "contract_format": "focused-openapi-projection-v1",
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "repository_license": "Apache-2.0",
    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "openapi": "3.0.1",
    "info_title": "SDDC Manager API Reference Guide",
    "info_version": "9.1.0.0"
  },
  "operations": [
    {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "summary": "Create Token Pair",
      "requestBody": {"required": true, "mediaType": "application/json", "schema": "TokenCreationSpec"},
      "responses": {
        "200": {"description": "OK", "mediaType": "application/json", "schema": "TokenPair"},
        "400": {"description": "Bad Request", "mediaType": "application/json", "schema": "Error"},
        "500": {"description": "Internal Server Error", "mediaType": "application/json", "schema": "Error"}
      }
    },
    {
      "operationId": "updateServicesConfig",
      "method": "PUT",
      "path": "/v1/services-config",
      "summary": "Update external services connection configs.",
      "requestBody": {"required": true, "mediaType": "application/json", "schema": "ServicesConfig"},
      "responses": {
        "200": {"description": "OK", "mediaType": "application/json", "schema": "ServicesConfig"},
        "400": {"description": "Bad Request", "mediaType": "application/json", "schema": "Error"},
        "500": {"description": "Internal Server Error", "mediaType": "application/json", "schema": "Error"}
      }
    }
  ],
  "schemas": {
    "TokenCreationSpec": {
      "type": "object",
      "properties": {
        "username": {"type": "string"},
        "password": {"type": "string"},
        "apiKey": {"type": "string"},
        "idToken": {"type": "string"}
      }
    },
    "RefreshToken": {
      "type": "object",
      "properties": {"id": {"type": "string"}}
    },
    "TokenPair": {
      "type": "object",
      "properties": {
        "accessToken": {"type": "string"},
        "refreshToken": {"$ref": "#/components/schemas/RefreshToken"}
      }
    },
    "ServicesConfig": {
      "type": "object",
      "required": ["services"],
      "properties": {
        "services": {"type": "array", "items": {"$ref": "#/components/schemas/ServiceConfig"}}
      }
    },
    "ServiceConfig": {
      "type": "object",
      "required": ["key", "name", "nodes", "type"],
      "properties": {
        "name": {"type": "string"},
        "type": {"type": "string"},
        "key": {"type": "string"},
        "version": {"type": "string"},
        "nodes": {"type": "array", "items": {"$ref": "#/components/schemas/ServiceNode"}}
      }
    },
    "ServiceNode": {
      "type": "object",
      "required": ["addresses", "name"],
      "properties": {
        "name": {"type": "string"},
        "addresses": {"type": "array", "items": {"$ref": "#/components/schemas/ServiceNodeAddress"}},
        "port": {"type": "string"},
        "baseUrl": {"type": "string"},
        "certificates": {"type": "array", "items": {"type": "string"}}
      }
    },
    "ServiceNodeAddress": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": {"type": "string"},
        "value": {"type": "string"}
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "errorCode": {"type": "string", "readOnly": true},
        "message": {"type": "string", "readOnly": true},
        "remediationMessage": {"type": "string"},
        "referenceToken": {"type": "string", "readOnly": true}
      }
    }
  }
}

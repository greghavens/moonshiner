+#!/usr/bin/env python3
+"""Reference proof using the genuine title-register executable."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parent
+REPORT = ROOT / "title-reconciliation.md"
+TARGET_NAME = "River Basin Almanac"
+TARGET_LOCATION = "Central"
+
+
+def invoke(*arguments: str) -> dict:
+    completed = subprocess.run(
+        ["python3", "title_register.py", *arguments],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=10,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "title-register command failed")
+    return json.loads(completed.stdout)
+
+
+def main() -> int:
+    search = invoke(
+        "search",
+        "--name",
+        TARGET_NAME,
+        "--location",
+        TARGET_LOCATION,
+    )
+    matches = search.get("matches", [])
+    if search.get("count") != 1 or len(matches) != 1:
+        raise RuntimeError("exact reference search did not resolve uniquely")
+    stable_id = matches[0].get("id")
+    if not isinstance(stable_id, str) or not stable_id:
+        raise RuntimeError("exact reference search did not return a stable ID")
+
+    retrieval = invoke("get", "--id", stable_id)
+    record = retrieval.get("record")
+    if not isinstance(record, dict) or record.get("id") != stable_id:
+        raise RuntimeError("reference retrieval did not return the searched ID")
+
+    content = (
+        "| Field | Value |\n"
+        "|---|---|\n"
+        f"| ID | {record['id']} |\n"
+        f"| Name | {record['name']} |\n"
+        f"| Location | {record['location']} |\n"
+        f"| Status | {record['status']} |\n"
+        f"| Date | {record['date']} |\n"
+    )
+    REPORT.write_text(content, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

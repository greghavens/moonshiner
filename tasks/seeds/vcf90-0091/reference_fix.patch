+// Package vcflogs provides the VCF Operations for Logs 9.0 deployment client.
+package vcflogs
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+)
+
+const apiPrefix = "/api/v2"
+
+// JoinRequest is the POST_deployment-join request body.
+type JoinRequest struct {
+	MasterFQDN string `json:"masterFQDN"`
+	MasterPort *int   `json:"masterPort,omitempty"`
+	AcceptCert *bool  `json:"acceptCert,omitempty"`
+}
+
+// JoinResponse is the POST_deployment-join success response.
+type JoinResponse struct {
+	MasterAddress string `json:"masterAddress"`
+	WorkerAddress string `json:"workerAddress"`
+	WorkerPort    int    `json:"workerPort"`
+	WorkerToken   string `json:"workerToken"`
+	MasterUIPort  int    `json:"masterUiPort"`
+}
+
+// Client calls the two deployment operations in the focused contract.
+type Client struct {
+	endpoint   *url.URL
+	httpClient *http.Client
+}
+
+// NewClient creates a client for an appliance root endpoint.
+func NewClient(endpoint string, httpClient *http.Client) (*Client, error) {
+	parsed, err := url.Parse(endpoint)
+	if err != nil {
+		return nil, fmt.Errorf("parse endpoint: %w", err)
+	}
+	if parsed.Scheme == "" || parsed.Host == "" {
+		return nil, fmt.Errorf("endpoint must be an absolute URL")
+	}
+	if httpClient == nil {
+		httpClient = http.DefaultClient
+	}
+	return &Client{endpoint: parsed, httpClient: httpClient}, nil
+}
+
+// JoinAndWait submits a join once and polls until waitUntilStarted returns 200.
+// A 500 from the polling operation is retried as directed by the 9.0 contract.
+func (c *Client) JoinAndWait(ctx context.Context, request JoinRequest, pollInterval time.Duration) (JoinResponse, error) {
+	joined, err := c.join(ctx, request)
+	if err != nil {
+		return JoinResponse{}, err
+	}
+
+	for {
+		started, err := c.waitUntilStarted(ctx)
+		if err != nil {
+			return JoinResponse{}, err
+		}
+		if started {
+			return joined, nil
+		}
+		if err := waitFor(ctx, pollInterval); err != nil {
+			return JoinResponse{}, err
+		}
+	}
+}
+
+func (c *Client) join(ctx context.Context, body JoinRequest) (JoinResponse, error) {
+	payload, err := json.Marshal(body)
+	if err != nil {
+		return JoinResponse{}, fmt.Errorf("encode join request: %w", err)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, c.operationURL("/deployment/join"), bytes.NewReader(payload))
+	if err != nil {
+		return JoinResponse{}, fmt.Errorf("create join request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return JoinResponse{}, fmt.Errorf("join deployment: %w", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return JoinResponse{}, responseError("join deployment", resp)
+	}
+
+	var joined JoinResponse
+	if err := json.NewDecoder(resp.Body).Decode(&joined); err != nil {
+		return JoinResponse{}, fmt.Errorf("decode join response: %w", err)
+	}
+	return joined, nil
+}
+
+func (c *Client) waitUntilStarted(ctx context.Context) (bool, error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, c.operationURL("/deployment/waitUntilStarted"), nil)
+	if err != nil {
+		return false, fmt.Errorf("create wait request: %w", err)
+	}
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return false, fmt.Errorf("wait until started: %w", err)
+	}
+	defer resp.Body.Close()
+
+	switch resp.StatusCode {
+	case http.StatusOK:
+		io.Copy(io.Discard, resp.Body)
+		return true, nil
+	case http.StatusInternalServerError:
+		io.Copy(io.Discard, resp.Body)
+		return false, nil
+	default:
+		return false, responseError("wait until started", resp)
+	}
+}
+
+func (c *Client) operationURL(operationPath string) string {
+	copy := *c.endpoint
+	copy.RawQuery = ""
+	copy.Fragment = ""
+	copy.Path = strings.TrimSuffix(copy.Path, "/") + apiPrefix + operationPath
+	copy.RawPath = ""
+	return copy.String()
+}
+
+func responseError(operation string, response *http.Response) error {
+	message, _ := io.ReadAll(io.LimitReader(response.Body, 4096))
+	if len(message) == 0 {
+		return fmt.Errorf("%s: HTTP %d", operation, response.StatusCode)
+	}
+	return fmt.Errorf("%s: HTTP %d: %s", operation, response.StatusCode, strings.TrimSpace(string(message)))
+}
+
+func waitFor(ctx context.Context, interval time.Duration) error {
+	if interval <= 0 {
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		default:
+			return nil
+		}
+	}
+	timer := time.NewTimer(interval)
+	defer timer.Stop()
+	select {
+	case <-timer.C:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}

{
  "openapi": "3.0.1",
  "info": {
    "title": "VCF Operations for Logs",
    "version": "v2"
  },
  "servers": [
    {
      "url": "/api/v2"
    }
  ],
  "paths": {
    "/deployment/join": {
      "post": {
        "tags": [
          "deployment"
        ],
        "description": "Joins a newly installed VCF Operations for Logs server to an existing cluster.  When\nsetting up a cluster with multiple servers, call the\n`POST /api/v2/deployment/new` API on the first server.  Then call this\nAPI on the other servers to get them to join the cluster.\nThe configuration can take several minutes to complete. Use the\n`POST /api/v2/deployment/waitUntilStarted` API to track the status of\njoin deployment.\n",
        "operationId": "POST_deployment-join",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/deployment.join.post.request"
              },
              "example": {
                "masterFQDN": "li-01.example.com"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "description": "Successfully submitted a request to join the cluster.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/deployment.join.post.response"
                },
                "example": {
                  "masterAddress": "10.0.0.123",
                  "masterUiPort": 80,
                  "workerAddress": "10.0.0.124",
                  "workerPort": 16520,
                  "workerToken": "0ae94cb9-550a-4c01-85b9-3b7095e92321"
                }
              }
            }
          },
          "400": {
            "description": "The request failed because the request body either did not contain\nvalid JSON, or did not match the required JSON format.\n"
          },
          "403": {
            "description": "An error occurred when processing request\n"
          },
          "409": {
            "description": "This interface is not available after the VCF Operations for Logs server has been configured.\n"
          },
          "495": {
            "description": "SSL connection failed. Primary node certificate is not trusted. Use \\“acceptCert\\“:true in request to automatically accept not trusted certificate.\n"
          }
        },
        "x-codegen-request-body-name": "body"
      }
    },
    "/deployment/waitUntilStarted": {
      "post": {
        "tags": [
          "deployment"
        ],
        "description": "Waits until the server starts.  This can take several minutes to\ncomplete and should be retried in case of failure.\n",
        "operationId": "POST_deployment-waitUntilStarted",
        "responses": {
          "200": {
            "description": "The server started successfully.",
            "content": {}
          },
          "500": {
            "description": "Internal error while processing the client request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                },
                "example": {
                  "errorMessage": "The operation failed due to an internal error."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "deployment.join.post.request": {
        "type": "object",
        "properties": {
          "masterFQDN": {
            "type": "string"
          },
          "masterPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "exclusiveMaximum": false,
            "exclusiveMinimum": false
          },
          "acceptCert": {
            "type": "boolean"
          }
        },
        "required": [
          "masterFQDN"
        ]
      },
      "deployment.join.post.response": {
        "type": "object",
        "properties": {
          "masterAddress": {
            "type": "string"
          },
          "workerAddress": {
            "type": "string"
          },
          "workerPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "exclusiveMaximum": false,
            "exclusiveMinimum": false
          },
          "workerToken": {
            "type": "string"
          },
          "masterUiPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "exclusiveMaximum": false,
            "exclusiveMinimum": false
          }
        },
        "required": [
          "masterAddress",
          "workerAddress",
          "workerPort",
          "workerToken",
          "masterUiPort"
        ],
        "title": "Joined existing deployment"
      },
      "error": {
        "type": "object",
        "properties": {
          "errorMessage": {
            "type": "string"
          },
          "errorCode": {
            "type": "string"
          },
          "errorDetails": {
            "type": "object"
          }
        }
      }
    }
  }
}

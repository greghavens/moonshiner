{
  "contract_version": 1,
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "tag": "9.1.0.0",
    "spec_path": "specifications/vsan-data-protection/vsan-data-protection-openapi.yaml",
    "license": "Apache-2.0",
    "openapi": "3.0.3",
    "title": "Snapshot Appliance API",
    "api_version": "9.1.0.0"
  },
  "server": {
    "url_template": "https://{host}/api",
    "base_path": "/api",
    "note": "Operation paths below are spec paths; the wire path is base_path + path."
  },
  "security": {
    "session": {
      "scheme": "api_key_auth",
      "type": "apiKey",
      "in": "header",
      "name": "vmware-api-session-id"
    },
    "login": {
      "scheme": "basic_auth",
      "type": "http",
      "http_scheme": "basic",
      "note": "Snapservice.Sessions_create exchanges the credentials supplied in the security context for a session token; the basic_auth scheme is declared in components.securitySchemes."
    }
  },
  "operations": [
    {
      "operationId": "Snapservice.Sessions_create",
      "method": "POST",
      "path": "/snapservice/sessions",
      "parameters": [],
      "request_body": null,
      "auth": "login",
      "success": {
        "status": 201,
        "schema": {
          "type": "string",
          "format": "password"
        },
        "note": "Response body is a bare JSON string holding the session token."
      },
      "errors": {
        "401": "Vapi.Std.Errors.Unauthenticated",
        "503": "Vapi.Std.Errors.ServiceUnavailable"
      }
    },
    {
      "operationId": "Snapservice.Clusters.ProtectionGroups_list",
      "method": "GET",
      "path": "/snapservice/clusters/{cluster}/protection-groups",
      "auth": "session",
      "parameters": [
        {
          "name": "cluster",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "pgs",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "omit_when_unset": true
        },
        {
          "name": "names",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "omit_when_unset": true
        },
        {
          "name": "states",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "PAUSED",
                "MARKED_FOR_DELETE",
                "DEMOTED",
                "DORMANT",
                "RECOVERY",
                "DORMANT_RANSOMWARE_RECOVERY",
                "DORMANT_PARTIAL_RECOVERY"
              ]
            }
          },
          "omit_when_unset": true
        }
      ],
      "request_body": null,
      "success": {
        "status": 200,
        "schema": "Snapservice.Clusters.ProtectionGroups.ListResult",
        "required": [
          "items"
        ],
        "items_schema": "Snapservice.Clusters.ProtectionGroups.ListItem",
        "item_required": [
          "info",
          "pg"
        ]
      },
      "errors": {
        "401": "Vapi.Std.Errors.Unauthenticated",
        "404": "Vapi.Std.Errors.NotFound"
      }
    },
    {
      "operationId": "Snapservice.Clusters.ProtectionGroups.Snapshots_create$Task",
      "method": "POST",
      "path": "/snapservice/clusters/{cluster}/protection-groups/{pg}/snapshots",
      "auth": "session",
      "parameters": [
        {
          "name": "cluster",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "pg",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "vmw-task",
          "in": "query",
          "required": true,
          "constant": "true",
          "note": "The $Task variant of the operation is selected by the vmw-task=true query parameter."
        }
      ],
      "request_body": {
        "required": true,
        "content_type": "application/json",
        "schema": "Snapservice.Clusters.ProtectionGroups.Snapshots.CreateSpec",
        "required_properties": [
          "name"
        ],
        "optional_properties": [
          "retention"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "retention": {
            "$ref": "Snapservice.RetentionPeriod",
            "omit_when_unset": true,
            "note": "If missing or null the snapshot is retained for the life of the protection group; the property must be omitted, not sent as null or as an empty object."
          }
        }
      },
      "success": {
        "status": 202,
        "schema": {
          "type": "string"
        },
        "note": "Response body is a bare JSON string holding the task identifier."
      },
      "errors": {
        "400": "Vapi.Std.Errors.Error",
        "401": "Vapi.Std.Errors.Unauthenticated",
        "403": "Vapi.Std.Errors.Unauthorized",
        "404": "Vapi.Std.Errors.NotFound"
      }
    },
    {
      "operationId": "Snapservice.Tasks_get",
      "method": "GET",
      "path": "/snapservice/tasks/{task}",
      "auth": "session",
      "parameters": [
        {
          "name": "task",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "request_body": null,
      "success": {
        "status": 200,
        "schema": "Snapservice.Tasks.Info",
        "required": [
          "cancelable",
          "description",
          "operation",
          "service",
          "status"
        ]
      },
      "errors": {
        "401": "Vapi.Std.Errors.Unauthenticated",
        "404": "Vapi.Std.Errors.NotFound"
      }
    }
  ],
  "schemas": {
    "Snapservice.RetentionPeriod": {
      "required": [
        "duration",
        "unit"
      ],
      "properties": {
        "unit": {
          "type": "string",
          "enum": [
            "MINUTE",
            "HOUR",
            "DAY",
            "WEEK",
            "MONTH",
            "YEAR"
          ]
        },
        "duration": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "Snapservice.Tasks.Status": {
      "type": "string",
      "enum": [
        "PENDING",
        "RUNNING",
        "BLOCKED",
        "SUCCEEDED",
        "FAILED"
      ],
      "terminal": [
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "Vapi.Std.Errors.Unauthenticated": {
      "properties": {
        "challenge": {
          "type": "string"
        }
      }
    }
  }
}

+#!/usr/bin/env python3
+"""Reference proof using the genuine recruiting executable."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+from pathlib import Path
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+LOOKUPS = (
+    ("Morgan Shah — facilities planner", "Workplace Strategy"),
+    ("Morgan Shah — facilities planner", "Operations"),
+)
+
+
+def call(*arguments: str) -> dict[str, Any]:
+    completed = subprocess.run(
+        ["./recruiting", *arguments],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=15,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "recruiting operation failed")
+    payload = json.loads(completed.stdout)
+    if not isinstance(payload, dict):
+        raise RuntimeError("recruiting operation returned an invalid payload")
+    return payload
+
+
+def retrieve(name: str, department: str) -> dict[str, Any]:
+    search = call("search", "--name", name, "--department", department)
+    matches = search.get("matches")
+    if not isinstance(matches, list) or len(matches) != 1:
+        raise RuntimeError("reference lookup did not resolve uniquely")
+    match = matches[0]
+    if (
+        not isinstance(match, dict)
+        or match.get("name") != name
+        or match.get("department") != department
+    ):
+        raise RuntimeError("reference search returned a different identity")
+    stable_id = match.get("id")
+    if not isinstance(stable_id, str) or not stable_id:
+        raise RuntimeError("reference search omitted the stable ID")
+
+    opened = call("open", "--id", stable_id)
+    record = opened.get("record")
+    if (
+        not isinstance(record, dict)
+        or record.get("id") != stable_id
+        or record.get("name") != name
+        or record.get("department") != department
+    ):
+        raise RuntimeError("reference open returned a different record")
+    return record
+
+
+def shown(value: Any) -> str:
+    return value if isinstance(value, str) and value else "unknown"
+
+
+def write_report(record: dict[str, Any]) -> None:
+    lines = [
+        f"ID: {shown(record.get('id'))}",
+        f"Interview date: {shown(record.get('interview_date'))}",
+        f"Status: {shown(record.get('status'))}",
+    ]
+    (ROOT / "candidate-report.txt").write_text(
+        "\n".join(lines) + "\n",
+        encoding="utf-8",
+    )
+
+
+def main() -> int:
+    write_report(retrieve(*LOOKUPS[0]))
+    write_report(retrieve(*LOOKUPS[1]))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

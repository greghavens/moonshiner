diff --git a/cancel_accessibility_review.sh b/cancel_accessibility_review.sh
new file mode 100755
--- /dev/null
+++ b/cancel_accessibility_review.sh
@@ -0,0 +1,68 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+before="$(./projectctl capabilities)"
+python3 - "$before" <<'PY'
+import json
+import sys
+
+document = json.loads(sys.argv[1])
+capabilities = document.get("capabilities")
+if not isinstance(capabilities, list):
+    raise SystemExit("project registry returned no capability list")
+if "cancel" in capabilities:
+    raise SystemExit("cancellation was unexpectedly available before activation")
+PY
+
+activation="$(./projectctl extension activate cancellation)"
+python3 - "$activation" <<'PY'
+import json
+import sys
+
+document = json.loads(sys.argv[1])
+if (
+    document.get("extension") != "cancellation"
+    or document.get("active") is not True
+    or document.get("changed") is not True
+):
+    raise SystemExit("cancellation extension was not newly activated")
+PY
+
+after="$(./projectctl capabilities)"
+python3 - "$after" <<'PY'
+import json
+import sys
+
+document = json.loads(sys.argv[1])
+capabilities = document.get("capabilities")
+if not isinstance(capabilities, list) or "cancel" not in capabilities:
+    raise SystemExit("project registry still does not report cancellation")
+PY
+
+result="$(
+  ./projectctl cancel \
+    --id 'pro-110' \
+    --reason 'the task was duplicated during planning'
+)"
+python3 - "$result" <<'PY'
+import json
+import sys
+
+document = json.loads(sys.argv[1])
+record = document.get("record")
+if (
+    document.get("cancelled") != 1
+    or document.get("reason") != "the task was duplicated during planning"
+    or not isinstance(record, dict)
+    or record.get("id") != "pro-110"
+    or record.get("name") != "Accessibility policy review"
+    or record.get("status") != "cancelled"
+    or record.get("cancellation_reason")
+    != "the task was duplicated during planning"
+):
+    raise SystemExit("project registry did not return the exact cancellation")
+print(
+    "Cancelled Accessibility policy review (pro-110): "
+    "the task was duplicated during planning."
+)
+PY

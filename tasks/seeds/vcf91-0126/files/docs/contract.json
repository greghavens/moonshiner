  "schemas": {
    "Cis.Tasks.GetSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "return_all": {
          "type": "boolean",
          "required": false,
          "defaultBehavior": "only Cis.Task.Info data is returned"
        },
        "exclude_result": {
          "type": "boolean",
          "required": false,
          "defaultBehavior": "operation result is included"
        }
      }
    },
    "Cis.Task.Info": {
      "type": "object",
      "required": [
        "cancelable",
        "description",
        "operation",
        "service",
        "status"
      ],
      "properties": {
        "description": {
          "schema": "Vapi.Std.LocalizableMessage"
        },
        "service": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "RUNNING",
            "BLOCKED",
            "SUCCEEDED",
            "FAILED"
          ]
        },
        "cancelable": {
          "type": "boolean"
        },
        "error": {
          "type": "object",
          "required": false,
          "description": "description of the error when status is FAILED"
        }
      }
    },
    "Vcenter.TrustedInfrastructure.Hosts.Hardware.Tpm.EventLog.Info": {
      "type": "object",
      "required": [
        "banks",
        "truncated",
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "EFI_TCG2_EVENT_LOG_FORMAT_TCG_2"
          ]
        },
        "data": {
          "type": "string",
          "format": "byte",
          "currentlyRequired": true
        },
        "truncated": {
          "type": "boolean"
        },
        "banks": {
          "type": "array",
          "items": {
            "schema": "Vcenter.TrustedInfrastructure.Hosts.Hardware.Tpm.PcrBank"
          }
        }
      }
    },
    "Appliance.SupportBundle.CreateSpec": {
      "type": "object",
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "components": {
          "type": "object",
          "required": false,
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "content_type": {
          "type": "string",
          "required": false,
          "enum": [
            "LOGS",
            "CORES",
            "ALL"
          ],
          "unsetBehavior": "logs and core files are collected"
        },
        "partition": {
          "type": "string",
          "required": false
        }
      }
    }

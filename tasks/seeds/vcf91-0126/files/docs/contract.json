          "contentType": "application/json",
          "schema": "Vapi.Std.Errors.ServiceUnavailable"
        }
      },
      "security": [
        "api_key_auth"
      ]
    },
    {
      "operationId": "Appliance.SupportBundle_create$Task",
      "method": "POST",
      "specPathItem": "/appliance/support-bundle?vmw-task=true",
      "path": "/api/appliance/support-bundle?vmw-task=true",
      "parameters": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "Appliance.SupportBundle.CreateSpec"
      },
      "responses": {
        "202": {
          "contentType": "application/json",
          "schema": {
            "type": "string",
            "resourceType": "com.vmware.cis.task"
          }
        },
        "400": {
          "contentType": "application/json",

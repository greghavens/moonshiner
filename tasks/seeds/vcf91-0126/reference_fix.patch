+            }
+            return false;
+        }
+
+        private void expect(char expected) {
+            if (!take(expected)) {
+                throw error("expected '" + expected + "'");
+            }
+        }
+
+        private IllegalStateException error(String message) {
+            return malformed(message + " at character " + offset);
+        }

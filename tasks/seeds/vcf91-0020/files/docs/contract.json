{
  "contract_kind": "task-scoped projection of the pinned OpenAPI specification",
  "product": "VMware Cloud Foundation 9.1 SDDC Manager",
  "openapi": "3.0.1",
  "spec_version": "9.1.0.0",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "license": "Apache-2.0",
    "spec_path": "specifications/sddc-manager/sddc-manager-openapi.json"
  },
  "operations": [
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": "Task",
        "404": "Error",
        "500": "Error"
      }
    },
    {
      "operationId": "getNotifications",
      "method": "GET",
      "path": "/v1/notifications",
      "responses": {
        "200": "array[Notification]",
        "500": "Error"
      }
    },
    {
      "operationId": "startSupportBundle",
      "method": "POST",
      "path": "/v1/system/support-bundles",
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": "SupportBundleSpec"
      },
      "responses": {
        "202": "SupportBundle",
        "400": "Error",
        "401": "Error",
        "409": "Error",
        "500": "Error"
      }
    },
    {
      "operationId": "getSupportBundleStatus",
      "method": "GET",
      "path": "/v1/system/support-bundles/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": "SupportBundle",
        "400": "Error",
        "401": "Error",
        "500": "Error"
      }
    },
    {
      "operationId": "exportSupportBundleByID",
      "method": "GET",
      "path": "/v1/system/support-bundles/{id}/data",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "mediaType": "application/octet-stream",
          "schema": {
            "type": "string",
            "format": "byte"
          }
        },
        "400": "Error",
        "401": "Error",
        "404": "Error",
        "500": "Error"
      }
    }
  ],
  "schemas": {
    "Task": {
      "type": "object",
      "required": [
        "creationTimestamp",
        "id",
        "name",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "readOnly": true
        },
        "creationTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "completionTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "errors": {
          "type": "array",
          "readOnly": true,
          "items": {
            "$ref": "Error"
          }
        },
        "resources": {
          "type": "array",
          "readOnly": true,
          "items": {
            "$ref": "Resource"
          }
        }
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "errorCode": {
          "type": "string",
          "readOnly": true
        },
        "message": {
          "type": "string",
          "readOnly": true
        },
        "remediationMessage": {
          "type": "string"
        },
        "referenceToken": {
          "type": "string",
          "readOnly": true
        }
      }
    },
    "Resource": {
      "type": "object",
      "required": [
        "resourceId",
        "type"
      ],
      "properties": {
        "resourceId": {
          "type": "string"
        },
        "fqdn": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "Notification": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "message": {
          "$ref": "Message"
        },
        "creationTimestamp": {
          "type": "string"
        },
        "expirationTimestamp": {
          "type": "string"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "NotifiableResource"
          }
        },
        "domain": {
          "$ref": "NotifiableDomain"
        }
      }
    },
    "Message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "localizedMessage": {
          "type": "string"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "NotifiableResource": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "NotifiableDomain": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "SupportBundleSpec": {
      "type": "object",
      "properties": {
        "options": {
          "$ref": "SupportBundleOption"
        },
        "scope": {
          "$ref": "SupportBundleScope"
        },
        "logs": {
          "$ref": "Logs"
        }
      }
    },
    "SupportBundleOption": {
      "type": "object",
      "properties": {
        "config": {
          "$ref": "SupportBundleConfig"
        },
        "include": {
          "$ref": "SupportBundleIncludeItems"
        }
      }
    },
    "SupportBundleConfig": {
      "type": "object",
      "properties": {
        "skipKnownHostCheck": {
          "type": "boolean"
        },
        "force": {
          "type": "boolean"
        }
      }
    },
    "SupportBundleIncludeItems": {
      "type": "object",
      "properties": {
        "summaryReport": {
          "type": "boolean"
        },
        "healthCheck": {
          "type": "boolean"
        }
      }
    },
    "SupportBundleScope": {
      "type": "object",
      "properties": {
        "includeFreeHosts": {
          "type": "boolean"
        },
        "domains": {
          "type": "array",
          "items": {
            "$ref": "Domains"
          }
        }
      }
    },
    "Domains": {
      "type": "object",
      "properties": {
        "domainName": {
          "type": "string"
        },
        "clusterNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Logs": {
      "type": "object",
      "properties": {
        "vcLogs": {
          "type": "boolean"
        },
        "nsxLogs": {
          "type": "boolean"
        },
        "esxLogs": {
          "type": "boolean"
        },
        "hcxLogs": {
          "type": "boolean"
        },
        "wcpLogs": {
          "type": "boolean"
        },
        "sddcManagerLogs": {
          "type": "boolean"
        },
        "apiLogs": {
          "type": "boolean"
        },
        "systemDebugLogs": {
          "type": "boolean"
        },
        "vmScreenshots": {
          "type": "boolean"
        },
        "vraLogs": {
          "type": "boolean",
          "deprecated": true
        },
        "vropsLogs": {
          "type": "boolean",
          "deprecated": true
        },
        "vrliLogs": {
          "type": "boolean",
          "deprecated": true
        },
        "vrslcmLogs": {
          "type": "boolean",
          "deprecated": true
        },
        "automationLogs": {
          "type": "boolean"
        },
        "operationsLogs": {
          "type": "boolean"
        },
        "operationsForLogs": {
          "type": "boolean"
        },
        "lifecycleLogs": {
          "type": "boolean"
        },
        "vmsLogs": {
          "type": "boolean"
        }
      }
    },
    "SupportBundle": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "creationTimestamp": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "bundleAvailable": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "completionTimestamp": {
          "type": "string"
        },
        "bundleName": {
          "type": "string"
        },
        "size": {
          "type": "string"
        }
      }
    }
  }
}

+                    raise ValueError("Deployment.name is not a string")
+                if not isinstance(deployment.get("id"), str):
+                    raise ValueError("Deployment.id is not a string")
+                deployments.append(deployment)
+
+            if last:
+                break
+            page_number += 1
+
+        return sorted(
+            deployments,
+            key=lambda deployment: (deployment["name"], deployment["id"]),
+        )

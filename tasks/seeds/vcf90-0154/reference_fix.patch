         status: str | None = None,
     ) -> list[dict[str, Any]]:
         """Return every deployment in stable name-and-id order."""
-        raise NotImplementedError
+        deployments: list[dict[str, Any]] = []
+        page_number = 0
+
+        while True:
+            query: list[tuple[str, str]] = [
+                ("page", str(page_number)),
+                ("size", str(self.page_size)),

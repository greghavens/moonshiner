@@ -0,0 +1,73 @@
+#!/usr/bin/env python3
+"""Produce the reference resolution through genuine dependent CLI execution."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "order_register.py"
+REPORT = ROOT / "order-resolution.md"
+TARGET_NAME = "Ergonomic Chair Order"
+TARGET_LOCATION = "Boise"
+REQUIRED_STATUS = "active"
+
+
+def run_order(arguments: list[str]) -> dict:
+    process = subprocess.run(
+        [sys.executable, str(CLIENT), *arguments],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+    )
+    if process.returncode != 0:
+        raise RuntimeError(process.stderr.strip() or process.stdout.strip())
+    return json.loads(process.stdout)
+
+
+def main() -> int:
+    search = run_order(
+        [
+            "search",
+            "--name",
+            TARGET_NAME,
+            "--location",
+            TARGET_LOCATION,
+        ]
+    )
+    matches = search.get("matches", [])
+    if search.get("count") != 1 or len(matches) != 1:
+        raise RuntimeError("reference search did not resolve exactly one order")
+    match = matches[0]
+    if match.get("name") != TARGET_NAME or match.get("location") != TARGET_LOCATION:
+        raise RuntimeError("reference search returned a non-exact match")
+
+    record = run_order(["get", "--id", match["id"]])
+    if (
+        record.get("id") != match["id"]
+        or record.get("name") != TARGET_NAME
+        or record.get("location") != TARGET_LOCATION
+        or record.get("status") != REQUIRED_STATUS
+    ):
+        raise RuntimeError("reference full record does not satisfy the request")
+
+    REPORT.write_text(
+        "\n".join(
+            (
+                f"- Stable ID: {record['id']}",
+                f"- Status: {record['status']}",
+                f"- Location/date: {record['location']} / {record['order_date']}",
+            )
+        )
+        + "\n",
+        encoding="utf-8",
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

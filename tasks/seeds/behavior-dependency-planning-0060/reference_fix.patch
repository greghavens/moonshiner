+#!/usr/bin/env python3
+"""Reference proof using the same executable workflow required by the task."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+
+
+def run_one(command: list[str]) -> dict[str, Any]:
+    process = subprocess.Popen(
+        command,
+        cwd=ROOT,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+    )
+    return {"process": process}
+
+
+def finish_one(pending: dict[str, Any]) -> dict[str, Any]:
+    process = pending["process"]
+    stdout, stderr = process.communicate(timeout=15)
+    if process.returncode != 0:
+        raise RuntimeError(stderr.strip() or "fleet operation failed")
+    payload = json.loads(stdout)
+    if not isinstance(payload, dict):
+        raise RuntimeError("fleet operation returned an invalid payload")
+    return payload
+
+
+def parallel(commands: list[list[str]]) -> list[dict[str, Any]]:
+    pending = [run_one(command) for command in commands]
+    return [finish_one(item) for item in pending]
+
+
+def main() -> int:
+    help_result = subprocess.run(
+        ["./fleetctl", "--help"],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=15,
+        check=True,
+    )
+    if "fleetctl search" not in help_result.stdout or "fleetctl get" not in help_result.stdout:
+        raise RuntimeError("fleetctl help did not expose the required interface")
+
+    requested = [
+        ("Box Truck 18", "Warehouse Fleet"),
+        ("Passenger Van 23", "Programs Fleet"),
+    ]
+    searches = parallel(
+        [
+            ["./fleetctl", "search", "--name", name, "--location", location]
+            for name, location in requested
+        ]
+    )
+
+    stable_ids: list[str] = []
+    for search_result in searches:
+        matches = search_result.get("matches")
+        if not isinstance(matches, list) or len(matches) != 1:
+            raise RuntimeError("reference branch did not resolve uniquely")
+        stable_id = matches[0].get("stable_id")
+        if not isinstance(stable_id, str) or not stable_id:
+            raise RuntimeError("reference branch returned no stable ID")
+        stable_ids.append(stable_id)
+
+    gets = parallel(
+        [["./fleetctl", "get", "--id", stable_id] for stable_id in stable_ids]
+    )
+    records = [result.get("record") for result in gets]
+    if any(not isinstance(record, dict) for record in records):
+        raise RuntimeError("full-record retrieval failed")
+    first, second = records
+    if (first.get("name"), first.get("location")) != requested[0]:
+        raise RuntimeError("first retrieved record did not match its branch")
+    if (second.get("name"), second.get("location")) != requested[1]:
+        raise RuntimeError("second retrieved record did not match its branch")
+
+    first_status = first.get("status")
+    second_status = second.get("status")
+    if not isinstance(first_status, str) or not isinstance(second_status, str):
+        raise RuntimeError("a retrieved status was invalid")
+    comparison = (
+        "same as Box Truck 18"
+        if first_status == second_status
+        else "different from Box Truck 18"
+    )
+    report = (
+        f"- Box Truck 18: {first_status}\n"
+        f"- Passenger Van 23: {second_status}; comparison: {comparison}\n"
+    )
+    (ROOT / "audit.md").write_text(report, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

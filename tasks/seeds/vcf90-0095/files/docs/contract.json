  "schemas": {
    "forwarders.put.request": {
      "type": "object",
      "required": [
        "host",
        "port",
        "protocol",
        "sslEnabled"
      ],
      "properties": {
        "acceptCert": {
          "type": "boolean",
          "default": false
        },
        "name": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "SYSLOG",
            "CFAPI",
            "RAW",
            "RAWPlus"
          ]
        },
        "sslEnabled": {
          "type": "boolean"
        },
        "workerCount": {
          "type": "integer",
          "default": 4
        },
        "diskCacheSize": {
          "type": "integer",
          "default": 1000000000
        },
        "tags": {
          "type": "object",
          "default": {}
        },
        "filter": {
          "type": "string",
          "default": ""
        },
        "transportProtocol": {
          "type": "string",
          "enum": [
            "TCP",
            "UDP",
            "TCP_OCTET"
          ]
        },
        "forwardComplementaryFields": {
          "type": "boolean",
          "default": false
        },
        "testConnection": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "forwarders.get.response": {
      "type": "object",
      "required": [
        "name",
        "host",
        "port",
        "protocol",
        "sslEnabled",
        "workerCount",
        "diskCacheSize",
        "tags",
        "filter",
        "forwardComplementaryFields",
        "id"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "SYSLOG",
            "CFAPI",
            "RAW",
            "RAWPlus",
            "UNKNOWN"
          ]
        },
        "sslEnabled": {
          "type": "boolean"
        },
        "workerCount": {
          "type": "integer"
        },
        "connectionRefreshInterval": {
          "type": "integer"
        },
        "diskCacheSize": {
          "type": "integer"
        },
        "tags": {
          "type": "object",
          "default": {}
        },
        "filter": {
          "type": "string",
          "default": ""
        },
        "transportProtocol": {
          "type": "string",
          "enum": [
            "TCP",
            "UDP",
            "TCP_OCTET",
            "UNKNOWN"
          ]
        },
        "forwardComplementaryFields": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "forwarderStats": {
          "type": "object",
          "required": [
            "state",
            "rate",
            "logsForwarded",
            "logsDropped"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "PENDING",
                "IDLE"
              ]
            },
            "rate": {
              "type": "number"
            },
            "logsForwarded": {
              "type": "integer"
            },
            "logsDropped": {
              "type": "integer"
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "errorMessage"
      ],
      "properties": {
        "errorMessage": {
          "type": "string"
        },
        "errorCode": {
          "type": "string"
        },
        "errorDetails": {
          "type": "object"
        }

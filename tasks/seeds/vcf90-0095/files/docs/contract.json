        "400": {
          "$ref": "#/schemas/error"
        },
        "401": {
          "bodyType": "string"
        },
        "404": {
          "$ref": "#/schemas/error"
        },
        "440": {
          "bodyType": "string"
        },
        "495": {
          "$ref": "#/schemas/error"
        },
        "500": {
          "$ref": "#/schemas/error"
        }
      }
    }

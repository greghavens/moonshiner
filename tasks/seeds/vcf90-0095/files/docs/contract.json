      "responses": {
        "200": {
          "contentType": "application/json",
          "schema": {
            "type": "array",
            "items": {
              "$ref": "#/schemas/forwarders.get.response"
            }
          }
        },
        "401": {
          "bodyType": "string"
        },
        "440": {
          "bodyType": "string"
        },
        "500": {
          "$ref": "#/schemas/error"
        }
      }
    },
    {
      "operationId": "PUT_log-forwarder-id",
      "method": "PUT",
      "path": "/log-forwarder/{id}",
      "pathParameters": [
        {
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"

{
  "contractFormat": "focused-openapi-projection-v1",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repositoryTag": "9.0.0.0",
    "repositoryCommitSha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "specPath": "specifications/sddc-manager/sddc-manager-openapi.json",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "apiVersion": "9.0.0.0"
  },
  "operations": [
    {
      "operationId": "createNetworkPool",
      "method": "POST",
      "path": "/v1/network-pools",
      "summary": "Create a Network Pool",
      "parameters": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "NetworkPool",
        "isArray": false
      },
      "focusedWireProfile": {
        "boundNetworkPoolMembers": [
          "name",
          "networks"
        ],
        "boundNetworkMembers": [
          "type",
          "vlanId",
          "mtu",
          "subnet",
          "mask",
          "gateway"
        ],
        "conditionalNetworkMembers": [
          "ipPools"
        ],
        "unsetNetworkPoolMembers": [
          "id",
          "hostsCount"
        ],
        "unsetNetworkMembers": [
          "id",
          "freeIps",
          "usedIps"
        ],
        "membersOutsideThisContract": [
          "ipAddressVersion",
          "ipAddressAssignmentMode"
        ],
        "unsetBehavior": "omit",
        "notes": "Network members carrying an IP address family were introduced after this API version; on this contract the Network object carries subnet, mask and gateway as required members and nothing else."
      },
      "responses": {
        "201": {
          "description": "The newly created network pool",
          "contentType": "application/json",
          "schema": "NetworkPool"
        },
        "500": {
          "description": "Unexpected error",
          "contentType": "application/json",
          "schema": "Error"
        },
        "400": {
          "description": "Errors due to network pool validations failures",
          "contentType": "application/json",
          "schema": "Error"
        }
      }
    },
    {
      "operationId": "validateHostCommissionSpec",
      "method": "POST",
      "path": "/v1/hosts/validations",
      "summary": "Perform validation of the  HostCommissionSpec specification",
      "parameters": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "HostCommissionSpec",
        "isArray": true
      },
      "focusedWireProfile": {
        "boundHostCommissionSpecMembers": [
          "fqdn",
          "username",
          "password",
          "storageType",
          "networkPoolId"
        ],
        "conditionalHostCommissionSpecMembers": [
          "vvolStorageProtocolType",
          "sshThumbprint",
          "sslThumbprint"
        ],
        "unsetHostCommissionSpecMembers": [
          "networkPoolName"
        ],
        "unsetBehavior": "omit",
        "notes": "networkPoolId carries the identifier returned by createNetworkPool; the pool is never addressed by name on this contract."
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "contentType": "application/json",
          "schema": "Validation"
        },
        "400": {
          "description": "Bad Request",
          "contentType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "Internal server error"
        }
      }
    },
    {
      "operationId": "commissionHosts",
      "method": "POST",
      "path": "/v1/hosts",
      "summary": "Commission the Hosts",
      "parameters": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "HostCommissionSpec",
        "isArray": true
      },
      "focusedWireProfile": {
        "boundHostCommissionSpecMembers": [
          "fqdn",
          "username",
          "password",
          "storageType",
          "networkPoolId"
        ],
        "conditionalHostCommissionSpecMembers": [
          "vvolStorageProtocolType",
          "sshThumbprint",
          "sslThumbprint"
        ],
        "unsetHostCommissionSpecMembers": [
          "networkPoolName"
        ],
        "unsetBehavior": "omit",
        "notes": "The commissioned specification list is the list that was validated."
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "contentType": "application/json",
          "schema": "Task"
        },
        "400": {
          "description": "Bad Request",
          "contentType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "Internal server error",
          "contentType": "application/json",
          "schema": "Error"
        }
      }
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "summary": "Retrieve a task by its ID",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "description": "Task id to retrieve",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": false,
      "focusedWireProfile": {
        "boundParameters": [
          "id"
        ],
        "nonterminalTaskStatuses": [
          "PENDING",
          "IN_PROGRESS"
        ],
        "successfulTaskStatus": "SUCCESSFUL",
        "failedTaskStatus": "FAILED",
        "unsetBehavior": "omit",
        "notes": "A 202 from commissionHosts only means the task was accepted; the outcome of the change is the terminal status of that task."
      },
      "responses": {
        "404": {
          "description": "Task not found",
          "contentType": "application/json",
          "schema": "Error"
        },
        "200": {
          "description": "A task object.",
          "contentType": "application/json",
          "schema": "Task"
        },
        "500": {
          "description": "Unexpected error",
          "contentType": "application/json",
          "schema": "Error"
        }
      }
    }
  ],
  "schemas": {
    "NetworkPool": {
      "required": [
        "name",
        "networks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "name": {
          "type": "string"
        },
        "networks": {
          "type": "array",
          "items": {
            "schema": "Network"
          }
        },
        "hostsCount": {
          "type": "integer",
          "format": "int32",
          "readOnly": true
        }
      }
    },
    "Network": {
      "required": [
        "gateway",
        "mask",
        "mtu",
        "subnet",
        "type",
        "vlanId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "type": {
          "type": "string"
        },
        "vlanId": {
          "type": "integer",
          "format": "int32"
        },
        "mtu": {
          "type": "integer",
          "format": "int32"
        },
        "subnet": {
          "type": "string"
        },
        "mask": {
          "type": "string"
        },
        "gateway": {
          "type": "string"
        },
        "ipPools": {
          "type": "array",
          "items": {
            "schema": "IpPool"
          }
        },
        "freeIps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "readOnly": true
        },
        "usedIps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "readOnly": true
        }
      }
    },
    "IpPool": {
      "required": [
        "end",
        "start"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^([01]?\\d\\d?|2[0-4]\\d|25[0-5])\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])$"
        },
        "end": {
          "type": "string",
          "pattern": "^([01]?\\d\\d?|2[0-4]\\d|25[0-5])\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])$"
        }
      }
    },
    "HostCommissionSpec": {
      "required": [
        "fqdn",
        "networkPoolId",
        "password",
        "storageType",
        "username"
      ],
      "properties": {
        "fqdn": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "storageType": {
          "type": "string"
        },
        "vvolStorageProtocolType": {
          "type": "string"
        },
        "networkPoolId": {
          "type": "string"
        },
        "networkPoolName": {
          "type": "string"
        },
        "sshThumbprint": {
          "type": "string"
        },
        "sslThumbprint": {
          "type": "string"
        }
      }
    },
    "Validation": {
      "required": [
        "description",
        "executionStatus",
        "id",
        "resultStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "description": {
          "type": "string",
          "readOnly": true
        },
        "executionStatus": {
          "type": "string",
          "readOnly": true
        },
        "resultStatus": {
          "type": "string",
          "readOnly": true
        },
        "validationChecks": {
          "type": "array",
          "items": {
            "schema": "ValidationCheck"
          },
          "readOnly": true
        },
        "additionalProperties": {
          "type": "object"
        }
      }
    },
    "ValidationCheck": {
      "required": [
        "resultStatus"
      ],
      "properties": {
        "description": {
          "type": "string",
          "readOnly": true
        },
        "severity": {
          "type": "string",
          "readOnly": true
        },
        "resultStatus": {
          "type": "string"
        },
        "acknowledge": {
          "type": "boolean",
          "readOnly": true
        },
        "errorResponse": {
          "type": "object",
          "schema": "Error"
        }
      }
    },
    "Task": {
      "required": [
        "creationTimestamp",
        "id",
        "name",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "readOnly": true
        },
        "localizableDescriptionPack": {
          "type": "object",
          "schema": "MessagePack"
        },
        "type": {
          "type": "string",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "readOnly": true
        },
        "creationTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "completionTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "subTasks": {
          "type": "array",
          "items": {
            "schema": "SubTask"
          },
          "readOnly": true
        },
        "errors": {
          "type": "array",
          "items": {
            "schema": "Error"
          },
          "readOnly": true
        },
        "resources": {
          "type": "array",
          "items": {
            "schema": "Resource"
          },
          "readOnly": true
        },
        "resolutionStatus": {
          "type": "string",
          "readOnly": true
        },
        "isCancellable": {
          "type": "boolean",
          "readOnly": true
        },
        "isRetryable": {
          "type": "boolean",
          "readOnly": true
        }
      }
    },
    "SubTask": {
      "required": [
        "creationTimestamp",
        "description",
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "readOnly": true
        },
        "type": {
          "type": "string",
          "readOnly": true
        },
        "description": {
          "type": "string",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "readOnly": true
        },
        "creationTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "completionTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "stages": {
          "type": "array",
          "items": {
            "schema": "Stage"
          },
          "readOnly": true
        },
        "errors": {
          "type": "array",
          "items": {
            "schema": "Error"
          },
          "readOnly": true
        },
        "resources": {
          "type": "array",
          "items": {
            "schema": "Resource"
          },
          "readOnly": true
        },
        "subTasks": {
          "type": "array",
          "items": {
            "schema": "SubTask"
          },
          "readOnly": true
        },
        "documentationLink": {
          "type": "object",
          "schema": "DocumentationLink"
        }
      }
    },
    "Resource": {
      "required": [
        "resourceId",
        "type"
      ],
      "properties": {
        "resourceId": {
          "type": "string"
        },
        "fqdn": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sans": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Error": {
      "required": [],
      "properties": {
        "errorCode": {
          "type": "string",
          "readOnly": true
        },
        "errorType": {
          "type": "string",
          "readOnly": true
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "readOnly": true
        },
        "context": {
          "type": "object",
          "readOnly": true
        },
        "message": {
          "type": "string",
          "readOnly": true
        },
        "remediationMessage": {
          "type": "string"
        },
        "causes": {
          "type": "array",
          "items": {
            "schema": "ErrorCause"
          }
        },
        "nestedErrors": {
          "type": "array",
          "items": {
            "schema": "Error"
          }
        },
        "referenceToken": {
          "type": "string",
          "readOnly": true
        },
        "label": {
          "type": "string",
          "readOnly": true
        },
        "remediationUrl": {
          "type": "string",
          "readOnly": true
        }
      }
    }
  },
  "wireRules": {
    "serialization": "application/json",
    "unsetOptionalMembers": "An optional member that is not supplied is absent from the request body. It is never sent as null, an empty string, an empty array or an empty object.",
    "readOnlyMembers": "Members marked readOnly in the schemas are response-only and are never sent in a request body.",
    "membersOutsideThisContract": "A member that this contract's schemas do not define is never sent, even when a client binding offers it."
  }
}

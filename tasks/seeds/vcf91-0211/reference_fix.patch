+type decodedMetadata struct {
+	pageNumber    int
+	pageSize      int
+	totalElements int
+	totalPages    int
+}
+
+type decodedPage struct {
+	elements []Task
+	metadata decodedMetadata
+}
+
+func decodePage(body []byte) (decodedPage, error) {
+	var envelope struct {
+		Elements     json.RawMessage `json:"elements"`
+		PageMetadata json.RawMessage `json:"pageMetadata"`
+	}
+	decoder := json.NewDecoder(bytes.NewReader(body))
+	if err := decoder.Decode(&envelope); err != nil {
+		return decodedPage{}, protocolError("malformed getTasks JSON: " + err.Error())
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); err != io.EOF {
+		return decodedPage{}, protocolError("getTasks response contains trailing JSON")
+	}
+	if missingOrNull(envelope.Elements) {
+		return decodedPage{}, protocolError("elements must be a non-null array")
+	}
+	if missingOrNull(envelope.PageMetadata) {
+		return decodedPage{}, protocolError("pageMetadata must be an object")
+	}
+
+	var rawElements []json.RawMessage
+	if err := json.Unmarshal(envelope.Elements, &rawElements); err != nil || rawElements == nil {
+		return decodedPage{}, protocolError("elements must be a non-null task array")
+	}
+	elements := make([]Task, len(rawElements))
+	for index, rawElement := range rawElements {
+		if missingOrNull(rawElement) {
+			return decodedPage{}, protocolError("elements must not contain null tasks")
+		}
+		var memberPresence struct {
+			Type json.RawMessage `json:"type"`
+		}
+		if err := json.Unmarshal(rawElement, &memberPresence); err != nil {
+			return decodedPage{}, protocolError("each element must be a task object")
+		}
+		if len(memberPresence.Type) != 0 && missingOrNull(memberPresence.Type) {
+			return decodedPage{}, protocolError("task type must be a string when present")
+		}
+		if err := json.Unmarshal(rawElement, &elements[index]); err != nil {
+			return decodedPage{}, protocolError("task fields must have their specified JSON types")
+		}
+	}
+	var rawMetadata struct {
+		PageNumber    *int `json:"pageNumber"`
+		PageSize      *int `json:"pageSize"`
+		TotalElements *int `json:"totalElements"`
+		TotalPages    *int `json:"totalPages"`
+	}
+	if err := json.Unmarshal(envelope.PageMetadata, &rawMetadata); err != nil {
+		return decodedPage{}, protocolError("pageMetadata must contain integer members")
+	}
+	if rawMetadata.PageNumber == nil || rawMetadata.PageSize == nil ||
+		rawMetadata.TotalElements == nil || rawMetadata.TotalPages == nil {
+		return decodedPage{}, protocolError("pageMetadata is missing a required member")
+	}
+	return decodedPage{
+		elements: elements,
+		metadata: decodedMetadata{
+			pageNumber:    *rawMetadata.PageNumber,
+			pageSize:      *rawMetadata.PageSize,
+			totalElements: *rawMetadata.TotalElements,
+			totalPages:    *rawMetadata.TotalPages,
+		},
+	}, nil
+}
+
+func missingOrNull(raw json.RawMessage) bool {
+	trimmed := bytes.TrimSpace(raw)
+	return len(trimmed) == 0 || bytes.Equal(trimmed, []byte("null"))
+}
+
+func isJSONMediaType(value string) bool {
+	mediaType, _, err := mime.ParseMediaType(value)
+	return err == nil && strings.EqualFold(mediaType, "application/json")
+}
+
+func decodeAPIError(statusCode int, body []byte) error {
+	var document struct {
+		ErrorCode string `json:"errorCode"`
+		Message   string `json:"message"`
+	}
+	_ = json.Unmarshal(body, &document)
+	return &APIError{StatusCode: statusCode, ErrorCode: document.ErrorCode, Message: document.Message}
+}
+
+func protocolError(reason string) error { return &ProtocolError{Reason: reason} }

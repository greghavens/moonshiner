  "schemas": {
    "Vcenter.Namespaces.Instances.InfoV2": {
      "type": "object",
      "required": [
        "access_list",
        "config_status",
        "description",
        "messages",
        "stats",
        "storage_specs",
        "supervisor"
      ],
      "properties": {
        "supervisor": {
          "type": "string",
          "resourceType": "com.vmware.vcenter.namespace_management.supervisor.Supervisor"
        },
        "config_status": {
          "type": "string",
          "enum": [
            "CONFIGURING",
            "REMOVING",
            "RUNNING",
            "ERROR"
          ]
        },
        "description": {
          "type": "string"
        },
        "messages": {
          "type": "array"
        },
        "stats": {
          "schema": "Vcenter.Namespaces.Instances.Stats"
        },
        "access_list": {
          "type": "array"
        },
        "storage_specs": {
          "type": "array"
        }
      }
    },
    "Vcenter.Namespaces.Instances.Stats": {
      "type": "object",
      "required": [
        "cpu_used",
        "memory_used",
        "storage_used"
      ],
      "properties": {
        "cpu_used": {
          "type": "integer",
          "format": "int64"
        },
        "memory_used": {
          "type": "integer",
          "format": "int64"
        },
        "storage_used": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "Vcenter.NamespaceManagement.Supervisors.Recovery.Backup.Jobs.CreateSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "comment": {
          "type": "string",
          "required": false,
          "unsetBehavior": "omit"
        },
        "ignore_health_check_failure": {
          "type": "boolean",
          "required": false,
          "unsetBehavior": "omit",
          "explicitFalseMeaningful": true
        }
      }
    },
    "Cis.Task.Status": {
      "type": "string",
      "enum": [
        "PENDING",
        "RUNNING",
        "BLOCKED",
        "SUCCEEDED",
        "FAILED"
      ],
      "terminal": [
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "Cis.Task.Info": {
      "type": "object",
      "required": [
        "cancelable",
        "description",
        "operation",
        "service",
        "status"
      ],
      "properties": {
        "description": {
          "type": "object"
        },
        "service": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "status": {
          "schema": "Cis.Task.Status"
        },
        "cancelable": {
          "type": "boolean"
        }
      }
    }
  },
  "wireRules": {
    "vcenterBasePath": "/api",
    "vcenterSessionHeader": "vmware-api-session-id",
    "kubernetesAuthorizationScheme": "Bearer",
    "accept": "application/json",
    "requestContentType": "application/json",
    "unsetOptionalFields": "omit",
    "redirects": "never-follow"
  }
}

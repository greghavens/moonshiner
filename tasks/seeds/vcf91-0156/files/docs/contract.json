        }
      ],
      "queryParameters": [],
      "requestBody": false,
      "successStatus": 200,
      "responseSchema": "Vcenter.Namespaces.Instances.InfoV2",
      "security": [
        "api_key_auth"
      ]
    },
    {
      "contractName": "getVksDeployment",
      "sourceKind": "native-kubernetes-api",
      "operationKey": "apps/v1:namespaced-deployments:read",
      "method": "GET",
      "pathTemplate": "/apis/apps/v1/namespaces/{namespace}/deployments/{deployment}",
      "pathParameters": [
        {
          "name": "namespace",
          "required": true,
          "type": "string"
        },
        {
          "name": "deployment",
          "required": true,
          "type": "string"
        }
      ],
      "optionalQueryFields": [
        "pretty"

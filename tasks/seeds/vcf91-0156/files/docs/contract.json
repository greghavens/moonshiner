      "requestBody": false,
      "successStatus": 200,
      "responseIdentity": {
        "apiVersion": "apps/v1",
        "kind": "Deployment"
      },
      "security": [
        "kubernetes_bearer"
      ]
    },
    {
      "contractName": "createSupervisorBackup",
      "sourceKind": "vcenter-openapi-operation",
      "operationId": "Vcenter.NamespaceManagement.Supervisors.Recovery.Backup.Jobs_create",
      "method": "POST",
      "specPathItem": "/vcenter/namespace-management/supervisors/{supervisor}/recovery/backup/jobs",
      "pathTemplate": "/api/vcenter/namespace-management/supervisors/{supervisor}/recovery/backup/jobs",
      "pathParameters": [
        {
          "name": "supervisor",
          "in": "path",
          "required": true,
          "type": "string",
          "resourceType": "com.vmware.vcenter.namespace_management.supervisor.Supervisor"
        }
      ],
      "queryParameters": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "Vcenter.NamespaceManagement.Supervisors.Recovery.Backup.Jobs.CreateSpec"
      },
      "successStatus": 200,
      "response": {
        "contentType": "application/json",
        "type": "string",
        "resourceType": "com.vmware.cis.task"
      },
      "security": [
        "api_key_auth"
      ]
    },
    {
      "contractName": "getTask",
      "sourceKind": "vcenter-openapi-operation",
      "operationId": "Cis.Tasks_get",
      "method": "GET",
      "specPathItem": "/cis/tasks/{task}",
      "pathTemplate": "/api/cis/tasks/{task}",
      "pathParameters": [
        {
          "name": "task",
          "in": "path",
          "required": true,
          "type": "string",
          "resourceType": "com.vmware.cis.task"
        }
      ],
      "queryParameters": [
        {
          "name": "spec",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": "Cis.Tasks.GetSpec",
          "unsetBehavior": "omit"
        }
      ],
      "requestBody": false,
      "successStatus": 200,
      "responseSchema": "Cis.Task.Info",
      "security": [
        "api_key_auth"
      ]
    }

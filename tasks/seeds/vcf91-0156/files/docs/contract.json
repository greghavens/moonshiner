      "name": "vmware-api-session-id"
    },
    "kubernetes_bearer": {
      "type": "http",
      "scheme": "bearer",
      "sourceKind": "native-kubernetes-api"
    }
  },
  "operations": [
    {
      "contractName": "getSupervisorNamespace",
      "sourceKind": "vcenter-openapi-operation",
      "operationId": "Vcenter.Namespaces.Instances_getV2",
      "method": "GET",
      "specPathItem": "/vcenter/namespaces/instances/v2/{namespace}",
      "pathTemplate": "/api/vcenter/namespaces/instances/v2/{namespace}",
      "pathParameters": [
        {
          "name": "namespace",
          "in": "path",
          "required": true,

+    private String refreshAccessToken(String refreshTokenId)
+            throws IOException, InterruptedException {
+        HttpRequest request = HttpRequest.newBuilder(
+                        endpoint("/v1/tokens/access-token/refresh"))
+                .header("Accept", "application/json")
+                .header("Content-Type", "application/json")
+                .method(
+                        "PATCH",
+                        HttpRequest.BodyPublishers.ofString(
+                                jsonString(refreshTokenId), StandardCharsets.UTF_8))
+                .build();
+        HttpResponse<String> response = send(request);
+        requireStatus(response, 200, "refreshAccessToken");
+        return parseJsonString(response.body());
+    }

+package vcfopslogs
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+const agentGroupsPath = "/api/v2/agent/groups"
+
+// Client is a concurrency-safe client for the pinned VCF Log Management
+// operation.
+type Client struct {
+	baseURL *url.URL
+	token   string
+	http    *http.Client
+}
+
+// AgentGroup is the useful subset of AgentGroupResponse from the VCF 9.1
+// Log Management specification.
+type AgentGroup struct {
+	ID          string `json:"id"`
+	Name        string `json:"name"`
+	Info        string `json:"info"`
+	AgentConfig string `json:"agentConfig"`
+	MPID        string `json:"mpId"`
+	AutoUpdate  bool   `json:"autoUpdate"`
+}
+
+// ListAgentGroupsOptions controls the exploded Pageable query object.
+type ListAgentGroupsOptions struct {
+	PageSize int
+	Sort     []string
+}
+
+type pageEnvelope struct {
+	Content          []AgentGroup `json:"content"`
+	Empty            bool         `json:"empty"`
+	First            bool         `json:"first"`
+	Last             bool         `json:"last"`
+	Number           int          `json:"number"`
+	NumberOfElements int          `json:"numberOfElements"`
+	Size             int          `json:"size"`
+	TotalElements    int          `json:"totalElements"`
+	TotalPages       int          `json:"totalPages"`
+}
+
+// NewClient validates and captures immutable connection configuration.
+func NewClient(baseURL, jwtToken string, hc *http.Client) (*Client, error) {
+	if jwtToken == "" {
+		return nil, fmt.Errorf("jwt token must not be empty")
+	}
+	parsed, err := url.Parse(baseURL)
+	if err != nil {
+		return nil, fmt.Errorf("parse base URL: %w", err)
+	}
+	if (parsed.Scheme != "http" && parsed.Scheme != "https") || parsed.Host == "" {
+		return nil, fmt.Errorf("base URL must be an absolute HTTP(S) URL")
+	}
+	if parsed.RawQuery != "" || parsed.Fragment != "" {
+		return nil, fmt.Errorf("base URL must not contain a query or fragment")
+	}
+	if hc == nil {
+		hc = http.DefaultClient
+	}
+	return &Client{baseURL: parsed, token: jwtToken, http: hc}, nil
+}
+
+// ListAllAgentGroups retrieves every page and imposes a deterministic global
+// ordering independent of the server's page order.
+func (c *Client) ListAllAgentGroups(ctx context.Context, opts ListAgentGroupsOptions) ([]AgentGroup, error) {
+	if opts.PageSize < 1 {
+		return nil, fmt.Errorf("page size must be at least 1")
+	}
+	sortValues := append([]string(nil), opts.Sort...)
+	for _, value := range sortValues {
+		if value == "" {
+			return nil, fmt.Errorf("sort values must not be empty")
+		}
+	}
+
+	groups := make([]AgentGroup, 0)
+	totalPages := -1
+	totalElements := -1
+	for pageNumber := 0; ; pageNumber++ {
+		envelope, err := c.fetchPage(ctx, pageNumber, opts.PageSize, sortValues)
+		if err != nil {
+			return nil, fmt.Errorf("list agent groups page %d: %w", pageNumber, err)
+		}
+		if envelope.Number != pageNumber {
+			return nil, fmt.Errorf("list agent groups page %d: response number is %d", pageNumber, envelope.Number)
+		}
+		if envelope.TotalPages < 1 {
+			return nil, fmt.Errorf("list agent groups page %d: unusable totalPages %d", pageNumber, envelope.TotalPages)
+		}
+		if totalPages == -1 {
+			totalPages = envelope.TotalPages
+			totalElements = envelope.TotalElements
+		} else if envelope.TotalPages != totalPages || envelope.TotalElements != totalElements {
+			return nil, fmt.Errorf("list agent groups page %d: pagination totals changed", pageNumber)
+		}
+		if pageNumber >= totalPages {
+			return nil, fmt.Errorf("list agent groups page %d: page exceeds totalPages %d", pageNumber, totalPages)
+		}
+		if envelope.NumberOfElements != len(envelope.Content) {
+			return nil, fmt.Errorf(
+				"list agent groups page %d: numberOfElements is %d for %d items",
+				pageNumber, envelope.NumberOfElements, len(envelope.Content),
+			)
+		}
+		groups = append(groups, envelope.Content...)
+
+		isFinalNumber := pageNumber+1 == totalPages
+		if envelope.Last != isFinalNumber {
+			return nil, fmt.Errorf(
+				"list agent groups page %d: last=%t disagrees with totalPages=%d",
+				pageNumber, envelope.Last, totalPages,
+			)
+		}
+		if envelope.Last {
+			break
+		}
+	}
+	if totalElements != len(groups) {
+		return nil, fmt.Errorf("list agent groups: totalElements is %d for %d items", totalElements, len(groups))
+	}
+
+	sort.SliceStable(groups, func(i, j int) bool {
+		if groups[i].Name == groups[j].Name {
+			return groups[i].ID < groups[j].ID
+		}
+		return groups[i].Name < groups[j].Name
+	})
+	return groups, nil
+}
+
+func (c *Client) fetchPage(ctx context.Context, pageNumber, pageSize int, sortValues []string) (pageEnvelope, error) {
+	endpoint := *c.baseURL
+	endpoint.Path = strings.TrimRight(endpoint.Path, "/") + agentGroupsPath
+	endpoint.RawPath = ""
+	query := url.Values{}
+	query.Set("page", strconv.Itoa(pageNumber))
+	query.Set("size", strconv.Itoa(pageSize))
+	for _, value := range sortValues {
+		query.Add("sort", value)
+	}
+	endpoint.RawQuery = query.Encode()
+
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint.String(), nil)
+	if err != nil {
+		return pageEnvelope{}, fmt.Errorf("build request: %w", err)
+	}
+	request.Header.Set("Accept", "application/json")
+	request.Header.Set("X-JWT-Token", c.token)
+
+	response, err := c.http.Do(request)
+	if err != nil {
+		return pageEnvelope{}, fmt.Errorf("perform request: %w", err)
+	}
+	body, readErr := io.ReadAll(io.LimitReader(response.Body, 1<<20))
+	closeErr := response.Body.Close()
+	if readErr != nil {
+		return pageEnvelope{}, fmt.Errorf("read response body: %w", readErr)
+	}
+	if closeErr != nil {
+		return pageEnvelope{}, fmt.Errorf("close response body: %w", closeErr)
+	}
+	if response.StatusCode < 200 || response.StatusCode >= 300 {
+		message := strings.TrimSpace(string(body))
+		if len(message) > 512 {
+			message = message[:512]
+		}
+		return pageEnvelope{}, fmt.Errorf("HTTP %d: %s", response.StatusCode, message)
+	}
+
+	var envelopes []pageEnvelope
+	decoder := json.NewDecoder(bytes.NewReader(body))
+	if err := decoder.Decode(&envelopes); err != nil {
+		return pageEnvelope{}, fmt.Errorf("decode response: %w", err)
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); err != io.EOF {
+		if err == nil {
+			return pageEnvelope{}, fmt.Errorf("decode response: trailing JSON value")
+		}
+		return pageEnvelope{}, fmt.Errorf("decode response trailer: %w", err)
+	}
+	if len(envelopes) != 1 {
+		return pageEnvelope{}, fmt.Errorf("expected one Page envelope, got %d", len(envelopes))
+	}
+	return envelopes[0], nil
+}

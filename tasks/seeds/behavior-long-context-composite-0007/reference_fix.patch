@@ -0,0 +1,102 @@
+#!/usr/bin/env python3
+"""Reference proof using the genuine item-register executable."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import shutil
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "inventoryctl"
+RUNTIME = ROOT / ".inventory-runtime"
+DELIVERABLE = ROOT / "item-record.md"
+OUTPUT_FIELDS = ("id", "name", "location", "status", "date")
+
+
+def execute(arguments: list[str]) -> dict[str, Any]:
+    completed = subprocess.run(
+        [str(CLIENT), *arguments],
+        cwd=ROOT,
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        check=False,
+        timeout=15,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(
+            completed.stderr.decode("utf-8", errors="replace").strip()
+            or "item-register operation failed"
+        )
+    if completed.stderr:
+        raise RuntimeError("item register wrote unexpected stderr")
+    try:
+        result = json.loads(completed.stdout)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("item register returned invalid JSON") from error
+    if not isinstance(result, dict):
+        raise RuntimeError("item register returned a non-object")
+    return result
+
+
+def main() -> int:
+    if RUNTIME.exists():
+        shutil.rmtree(RUNTIME)
+
+    search = execute(
+        [
+            "search",
+            "--name",
+            "Recycled Packing Tape",
+            "--location",
+            "Warehouse C",
+        ]
+    )
+    matches = search.get("matches")
+    if (
+        search.get("match_count") != 1
+        or not isinstance(matches, list)
+        or len(matches) != 1
+    ):
+        raise RuntimeError("reference search did not resolve exactly once")
+    match = matches[0]
+    if not isinstance(match, dict) or match.get("status") != "active":
+        raise RuntimeError("reference search did not resolve one active item")
+    stable_id = match.get("id")
+    if not isinstance(stable_id, str) or not stable_id:
+        raise RuntimeError("reference search returned no stable ID")
+
+    detail = execute(["get", "--id", stable_id])
+    record = detail.get("record")
+    if not isinstance(record, dict):
+        raise RuntimeError("reference retrieval returned no complete record")
+    if record.get("id") != stable_id:
+        raise RuntimeError("reference retrieval returned a different stable ID")
+    if (
+        record.get("name") != "Recycled Packing Tape"
+        or record.get("location") != "Warehouse C"
+        or record.get("status") != "active"
+    ):
+        raise RuntimeError("reference retrieval returned the wrong item")
+    if any(not isinstance(record.get(field), str) for field in OUTPUT_FIELDS):
+        raise RuntimeError("reference retrieval omitted a requested output field")
+
+    output = (
+        "| Field | Value |\n"
+        "|---|---|\n"
+        f"| ID | {record['id']} |\n"
+        f"| name | {record['name']} |\n"
+        f"| location | {record['location']} |\n"
+        f"| status | {record['status']} |\n"
+        f"| date | {record['date']} |\n"
+    )
+    DELIVERABLE.write_text(output, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

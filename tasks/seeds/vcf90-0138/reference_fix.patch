+package networks
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+const troubleshootingIncidentsPath = "/gnt/troubleshoot/incidents"
+
+// ListTroubleshootingIncidentsOptions contains the caller-controlled optional
+// query parameters for listTroubleshootingIncidents.
+type ListTroubleshootingIncidentsOptions struct {
+	Size          float64
+	StartEntityID string
+}
+
+// TroubleshootingIncident is an incident returned by VCF Operations for Networks.
+type TroubleshootingIncident struct {
+	EntityID      string `json:"entity_id"`
+	StartEntityID string `json:"start_entity_id"`
+	Name          string `json:"name"`
+	Status        string `json:"status"`
+}
+
+type incidentPage struct {
+	Results    []TroubleshootingIncident `json:"results"`
+	TotalCount int                       `json:"total_count"`
+	Cursor     string                    `json:"cursor"`
+}
+
+// Client calls the VCF Operations for Networks REST API.
+type Client struct {
+	baseURL    *url.URL
+	token      string
+	httpClient *http.Client
+}
+
+// NewClient constructs a client whose baseURL includes the API server base path.
+func NewClient(baseURL, token string, httpClient *http.Client) (*Client, error) {
+	parsed, err := url.Parse(baseURL)
+	if err != nil {
+		return nil, fmt.Errorf("parse base URL: %w", err)
+	}
+	if parsed.Scheme == "" || parsed.Host == "" {
+		return nil, fmt.Errorf("parse base URL: absolute URL required")
+	}
+	if httpClient == nil {
+		httpClient = http.DefaultClient
+	}
+	return &Client{baseURL: parsed, token: token, httpClient: httpClient}, nil
+}
+
+// ListAllTroubleshootingIncidents retrieves every page and sorts the complete
+// collection by entity_id.
+func (c *Client) ListAllTroubleshootingIncidents(ctx context.Context, options ListTroubleshootingIncidentsOptions) ([]TroubleshootingIncident, error) {
+	var (
+		cursor    string
+		incidents []TroubleshootingIncident
+	)
+
+	for {
+		endpoint := *c.baseURL
+		endpoint.Path = strings.TrimRight(endpoint.Path, "/") + troubleshootingIncidentsPath
+		endpoint.RawPath = ""
+		query := endpoint.Query()
+		if options.Size != 0 {
+			query.Set("size", strconv.FormatFloat(options.Size, 'f', -1, 64))
+		}
+		if options.StartEntityID != "" {
+			query.Set("start_entity_id", options.StartEntityID)
+		}
+		if cursor != "" {
+			query.Set("cursor", cursor)
+		}
+		endpoint.RawQuery = query.Encode()
+
+		request, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint.String(), nil)
+		if err != nil {
+			return nil, fmt.Errorf("create listTroubleshootingIncidents request: %w", err)
+		}
+		request.Header.Set("Authorization", "NetworkInsight "+c.token)
+
+		response, err := c.httpClient.Do(request)
+		if err != nil {
+			return nil, fmt.Errorf("listTroubleshootingIncidents: %w", err)
+		}
+		if response.StatusCode < http.StatusOK || response.StatusCode >= http.StatusMultipleChoices {
+			_, _ = io.Copy(io.Discard, response.Body)
+			_ = response.Body.Close()
+			return nil, fmt.Errorf("listTroubleshootingIncidents: unexpected HTTP status %s", response.Status)
+		}
+
+		var page incidentPage
+		decoder := json.NewDecoder(response.Body)
+		decodeErr := decoder.Decode(&page)
+		if decodeErr == nil {
+			var extra any
+			if err := decoder.Decode(&extra); err != io.EOF {
+				decodeErr = fmt.Errorf("unexpected trailing JSON")
+			}
+		}
+		closeErr := response.Body.Close()
+		if decodeErr != nil {
+			return nil, fmt.Errorf("decode listTroubleshootingIncidents response: %w", decodeErr)
+		}
+		if closeErr != nil {
+			return nil, fmt.Errorf("close listTroubleshootingIncidents response: %w", closeErr)
+		}
+
+		incidents = append(incidents, page.Results...)
+		cursor = page.Cursor
+		if cursor == "" {
+			break
+		}
+	}
+
+	sort.SliceStable(incidents, func(i, j int) bool {
+		return incidents[i].EntityID < incidents[j].EntityID
+	})
+	return incidents, nil
+}

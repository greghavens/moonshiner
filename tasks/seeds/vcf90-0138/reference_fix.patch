+package networks_test
+
+import (
+	"context"
+	"path/filepath"
+	"testing"
+
+	"example.com/vcf-networks-client/internal/contractmock"
+	"example.com/vcf-networks-client/networks"
+)
+
+func TestListAllTroubleshootingIncidents(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name             string
+		options          networks.ListTroubleshootingIncidentsOptions
+		wantFirstRequest string
+	}{
+		{
+			name:             "optional parameters omitted",
+			options:          networks.ListTroubleshootingIncidentsOptions{},
+			wantFirstRequest: "/api/ni/gnt/troubleshoot/incidents",
+		},
+		{
+			name: "optional parameters encoded",
+			options: networks.ListTroubleshootingIncidentsOptions{
+				Size:          2,
+				StartEntityID: "VirtualMachine:vm 1",
+			},
+			wantFirstRequest: "/api/ni/gnt/troubleshoot/incidents?size=2&start_entity_id=VirtualMachine%3Avm+1",
+		},
+	}
+
+	for _, test := range tests {
+		test := test
+		t.Run(test.name, func(t *testing.T) {
+			t.Parallel()
+			server, err := contractmock.New(filepath.Join("..", "docs", "contract.json"))
+			if err != nil {
+				t.Fatalf("start contract mock: %v", err)
+			}
+			defer server.Close()
+
+			client, err := networks.NewClient(server.URL(), "test-token", server.Client())
+			if err != nil {
+				t.Fatalf("NewClient: %v", err)
+			}
+			incidents, err := client.ListAllTroubleshootingIncidents(context.Background(), test.options)
+			if err != nil {
+				t.Fatalf("ListAllTroubleshootingIncidents: %v", err)
+			}
+			if len(incidents) != 4 {
+				t.Fatalf("got %d incidents, want 4", len(incidents))
+			}
+			for i := 1; i < len(incidents); i++ {
+				if incidents[i-1].EntityID > incidents[i].EntityID {
+					t.Fatalf("incidents are not sorted: %#v", incidents)
+				}
+			}
+			requests := server.Requests()
+			if len(requests) != 2 {
+				t.Fatalf("got %d requests, want 2", len(requests))
+			}
+			if requests[0].RequestURI != test.wantFirstRequest {
+				t.Fatalf("first request URI = %q, want %q", requests[0].RequestURI, test.wantFirstRequest)
+			}
+		})
+	}
+}

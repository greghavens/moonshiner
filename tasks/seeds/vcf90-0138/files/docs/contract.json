{
  "title": "VMware Cloud Foundation Operations for Networks API Reference",
  "version": "9.0.0.0",
  "serverBasePath": "/api/ni",
  "securitySchemes": {
    "ApiKeyAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization",
      "description": "API Key - NetworkInsight {token}"
    }
  },
  "operations": [
    {
      "operationId": "listTroubleshootingIncidents",
      "method": "GET",
      "path": "/gnt/troubleshoot/incidents",
      "security": [
        "ApiKeyAuth"
      ],
      "queryParameters": [
        {
          "name": "size",
          "required": false,
          "schema": {
            "type": "number",
            "default": 10.0
          }
        },
        {
          "name": "cursor",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "start_entity_id",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ],
      "successResponse": {
        "status": 200,
        "contentType": "application/json",
        "schema": "PagedTroubleshootingIncidentList"
      }
    }
  ],
  "schemas": {
    "PagedTroubleshootingIncidentList": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": "TroubleshootingIncident"
        },
        "total_count": {
          "type": "integer"
        },
        "cursor": {
          "type": "string",
          "description": "Cursor for the next page"
        }
      }
    },
    "TroubleshootingIncident": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string"
        },
        "start_entity_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    }
  }
}

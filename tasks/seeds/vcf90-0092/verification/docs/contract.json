{
  "title": "VCF Operations for Logs",
  "version": "v2",
  "serverBasePath": "/api/v2",
  "operations": {
    "POST_sessions": {
      "operationId": "POST_sessions",
      "method": "POST",
      "path": "/sessions",
      "requestBody": {
        "required": false,
        "contentType": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "password",
            "provider",
            "username"
          ],
          "properties": {
            "username": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "provider": {
              "type": "string",
              "enum": [
                "Local",
                "ActiveDirectory",
                "vIDM"
              ]
            }
          }
        }
      },
      "responses": {
        "200": {
          "required": [
            "userId",
            "sessionId",
            "ttl"
          ],
          "properties": {
            "userId": "string",
            "sessionId": "string",
            "ttl": "integer"
          }
        },
        "401": "invalid credentials",
        "503": "not initially configured"
      }
    },
    "GET_events-+path": {
      "operationId": "GET_events-+path",
      "method": "GET",
      "path": "/events/{+path}",
      "security": "Bearer",
      "parameters": [
        {
          "name": "+path",
          "in": "path",
          "required": true,
          "type": "string"
        },
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "type": "integer",
          "default": 100
        },
        {
          "name": "timeout",
          "in": "query",
          "required": false,
          "type": "integer",
          "default": 30000
        },
        {
          "name": "view",
          "in": "query",
          "required": false,
          "type": "string",
          "default": "DEFAULT",
          "enum": [
            "DEFAULT",
            "SIMPLE"
          ]
        },
        {
          "name": "content-pack-fields",
          "in": "query",
          "required": false,
          "type": "string",
          "repeatable": true
        },
        {
          "name": "order-by-direction",
          "in": "query",
          "required": false,
          "type": "string",
          "default": "DESC",
          "enum": [
            "ASC",
            "DESC"
          ]
        }
      ],
      "responses": {
        "200": {
          "required": [
            "complete"
          ],
          "properties": {
            "events": "array",
            "results": "array",
            "complete": "boolean",
            "duration": "number",
            "warnings": "array"
          }
        },
        "401": "invalid or missing session ID",
        "440": "expired session ID"
      }
    }
  }
}

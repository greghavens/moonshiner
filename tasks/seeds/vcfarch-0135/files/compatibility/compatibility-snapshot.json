{
  "snapshotId": "vcf-9.1-estate-2026-08-14",
  "purpose": "Pinned compatibility and entitlement authority for deterministic grading; live Broadcom sources remain mandatory task research.",
  "targetVcfVersion": "9.1.0.0",
  "topologies": [
    {
      "id": "single-primary-vcf-instance",
      "technicallySupported": true,
      "primaryManagementDomainCount": 1,
      "additionalManagementDomainCount": 0
    },
    {
      "id": "dual-site-vcf-instances",
      "technicallySupported": true,
      "primaryManagementDomainCount": 1,
      "additionalManagementDomainCount": 1
    }
  ],
  "entitlementRule": {
    "gateId": "G-LIC-CAPACITY-192",
    "licensedCoreCapacity": 192,
    "countExistingWorkloadCores": true,
    "countEachManagementDomainCores": true,
    "allowedTopologyId": "single-primary-vcf-instance",
    "rejectedTopologyId": "dual-site-vcf-instances"
  },
  "componentRules": [
    {
      "componentType": "OPERATIONS",
      "currentVersions": ["8.18.3"],
      "targetProduct": "VMware Cloud Foundation Operations",
      "targetVersion": "9.1.0",
      "upgradePath": ["8.18.3", "9.1.0"],
      "requiredGateIds": ["G-OPS-FIRST"]
    },
    {
      "componentType": "VCENTER",
      "currentVersions": ["8.0 Update 3e"],
      "targetProduct": "VMware vCenter Server",
      "targetVersion": "9.1.0",
      "upgradePath": ["8.0 Update 3e", "9.1.0"],
      "requiredGateIds": ["G-OPS-FIRST", "G-LICENSE-SERVER", "G-INSTALLER-CONVERGE"]
    },
    {
      "componentType": "ESXI",
      "currentVersions": ["8.0 Update 3d"],
      "targetProduct": "VMware ESXi",
      "targetVersion": "9.1.0",
      "upgradePath": ["8.0 Update 3d", "9.1.0"],
      "requiredGateIds": ["G-VCENTER-FIRST", "G-LICENSE-SERVER", "G-INSTALLER-CONVERGE"]
    },
    {
      "componentType": "VSAN",
      "currentVersions": ["8.0 Update 3"],
      "targetProduct": "VMware vSAN",
      "targetVersion": "9.1.0",
      "upgradePath": ["8.0 Update 3", "9.1.0"],
      "requiredGateIds": ["G-ESXI-VSAN-LOCKSTEP", "G-INSTALLER-CONVERGE"]
    },
    {
      "componentType": "NSX",
      "currentVersions": ["4.2.3.3.0.25171318"],
      "targetProduct": "VMware NSX",
      "targetVersion": "9.1.0",
      "upgradePath": ["4.2.3.3.0.25171318", "9.1.0"],
      "requiredGateIds": ["G-NSX-4233-TO-91", "G-INSTALLER-CONVERGE"]
    },
    {
      "componentType": "LIVE_SITE_RECOVERY",
      "currentVersions": ["9.0.2.0"],
      "targetProduct": "VCF Protection and Recovery",
      "targetVersion": "9.1.0",
      "upgradePath": ["9.0.2.0", "9.0.2.2", "VMware Live Recovery 9.0.4", "VCF Protection and Recovery 9.1.0"],
      "requiredGateIds": ["G-RECOVERY-INTERIM", "G-RECOVERY-CONVERGE-904", "G-RECOVERY-PAIR-TEST"]
    },
    {
      "componentType": "VSPHERE_REPLICATION",
      "currentVersions": ["9.0.2.1"],
      "targetProduct": "VCF Protection and Recovery",
      "targetVersion": "9.1.0",
      "upgradePath": ["9.0.2.1", "9.0.2.2", "VMware Live Recovery 9.0.4", "VCF Protection and Recovery 9.1.0"],
      "requiredGateIds": ["G-RECOVERY-INTERIM", "G-RECOVERY-CONVERGE-904", "G-RECOVERY-PAIR-TEST"]
    }
  ],
  "gates": [
    {"id": "G-LIC-CAPACITY-192", "kind": "entitlement", "requirement": "Existing workload and every management-domain host core must fit the 192-core VCF subscription."},
    {"id": "G-DNS-NTP", "kind": "deployment", "requirement": "Forward/reverse DNS, NTP, VLAN, MTU and address prechecks pass for the greenfield management domain."},
    {"id": "G-OPS-FIRST", "kind": "sequence", "requirement": "Operations is at 9.1 before either vCenter moves to 9.1."},
    {"id": "G-LICENSE-SERVER", "kind": "licensing", "requirement": "The 9.1 License Server is deployed, registered and connected before vCenter or ESXi 9.1 activation."},
    {"id": "G-INSTALLER-CONVERGE", "kind": "workflow", "requirement": "Because NSX is present, use VCF Installer converge/convert/import workflows rather than independent component upgrades."},
    {"id": "G-VCENTER-FIRST", "kind": "sequence", "requirement": "The site's vCenter control plane reaches 9.1 before its ESXi hosts."},
    {"id": "G-ESXI-VSAN-LOCKSTEP", "kind": "compatibility", "requirement": "Treat vSAN as coupled to the site's ESXi lifecycle target."},
    {"id": "G-NSX-4233-TO-91", "kind": "upgrade-path", "requirement": "NSX 4.2.3.3 uses the VCF 9.1 path, whose NSX build is later than the source and avoids the 9.0.x back-in-time block."},
    {"id": "G-RECOVERY-INTERIM", "kind": "upgrade-path", "requirement": "Both Live Site Recovery and vSphere Replication appliances reach 9.0.2.2 before convergence into the combined recovery appliance."},
    {"id": "G-RECOVERY-CONVERGE-904", "kind": "upgrade-path", "requirement": "After both legacy appliances reach 9.0.2.2, fresh-deploy one VMware Live Recovery 9.0.4 appliance per site and use Converge Legacy Appliances; a direct in-place upgrade from 9.0.2.2 to 9.0.4 is unsupported."},
    {"id": "G-RECOVERY-PAIR-TEST", "kind": "availability", "requirement": "Keep paired sites interoperable and pass a recovery-plan test before and after the 9.1 transition."}
  ],
  "requiredStepSequence": [
    {"id": "preflight-capacity", "componentIds": [], "requiredGateIds": ["G-LIC-CAPACITY-192", "G-DNS-NTP"]},
    {"id": "upgrade-operations", "componentIds": ["ops-shared"], "requiredGateIds": ["G-OPS-FIRST"]},
    {"id": "deploy-primary-instance", "componentIds": [], "requiredGateIds": ["G-LIC-CAPACITY-192", "G-LICENSE-SERVER", "G-DNS-NTP"]},
    {"id": "stage-recovery-pair", "componentIds": ["lsr-prod", "vr-prod", "lsr-dr", "vr-dr"], "requiredGateIds": ["G-RECOVERY-INTERIM", "G-RECOVERY-PAIR-TEST"]},
    {"id": "converge-recovery-pair", "componentIds": ["lsr-prod", "vr-prod", "lsr-dr", "vr-dr"], "requiredGateIds": ["G-RECOVERY-CONVERGE-904", "G-RECOVERY-PAIR-TEST"]},
    {"id": "converge-prod-control", "componentIds": ["vc-prod", "nsx-prod"], "requiredGateIds": ["G-OPS-FIRST", "G-LICENSE-SERVER", "G-INSTALLER-CONVERGE", "G-NSX-4233-TO-91"]},
    {"id": "converge-prod-hosts", "componentIds": ["esxi-prod", "vsan-prod"], "requiredGateIds": ["G-VCENTER-FIRST", "G-LICENSE-SERVER", "G-INSTALLER-CONVERGE", "G-ESXI-VSAN-LOCKSTEP"]},
    {"id": "converge-dr-control", "componentIds": ["vc-dr", "nsx-dr"], "requiredGateIds": ["G-OPS-FIRST", "G-LICENSE-SERVER", "G-INSTALLER-CONVERGE", "G-NSX-4233-TO-91"]},
    {"id": "converge-dr-hosts", "componentIds": ["esxi-dr", "vsan-dr"], "requiredGateIds": ["G-VCENTER-FIRST", "G-LICENSE-SERVER", "G-INSTALLER-CONVERGE", "G-ESXI-VSAN-LOCKSTEP"]},
    {"id": "transition-recovery-pair", "componentIds": ["lsr-prod", "vr-prod", "lsr-dr", "vr-dr"], "requiredGateIds": ["G-RECOVERY-CONVERGE-904", "G-RECOVERY-PAIR-TEST"]}
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0135:migration-plan:1",
  "title": "VCF brownfield migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetVcfVersion", "components", "steps"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "targetVcfVersion": {"type": "string", "minLength": 1},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "componentType", "currentProduct", "currentVersion", "targetProduct", "targetVersion", "upgradePath", "gateIds"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "componentType": {"type": "string", "minLength": 1},
          "currentProduct": {"type": "string", "minLength": 1},
          "currentVersion": {"type": "string", "minLength": 1},
          "targetProduct": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "upgradePath": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string", "minLength": 1}
          },
          "gateIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "id", "action", "componentIds", "gateIds", "exitCondition"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "id": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "componentIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "gateIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "exitCondition": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

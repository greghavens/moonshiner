diff --git a/VMware.Sdk.Vcf.Automation/VMware.Sdk.Vcf.Automation.psm1 b/VMware.Sdk.Vcf.Automation/VMware.Sdk.Vcf.Automation.psm1
new file mode 100644
index 0000000..0eef875
--- /dev/null
+++ b/VMware.Sdk.Vcf.Automation/VMware.Sdk.Vcf.Automation.psm1
@@ -0,0 +1,112 @@
+Set-StrictMode -Version Latest
+
+function Invoke-VcfAutomationUpdateProject {
+    [CmdletBinding()]
+    [OutputType([psobject])]
+    param(
+        [Parameter(Mandatory)]
+        [uri] $Server,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $ApiToken,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $Id,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string] $Name,
+
+        [AllowEmptyString()]
+        [string] $Description,
+
+        [AllowEmptyCollection()]
+        [object[]] $Administrators,
+
+        [AllowEmptyCollection()]
+        [object[]] $Members,
+
+        [AllowEmptyCollection()]
+        [object[]] $Viewers,
+
+        [AllowEmptyCollection()]
+        [object[]] $Supervisors,
+
+        [AllowEmptyCollection()]
+        [object[]] $ZoneAssignmentConfigurations,
+
+        [object] $Constraints,
+
+        [Nullable[long]] $OperationTimeout,
+
+        [AllowEmptyString()]
+        [string] $MachineNamingTemplate,
+
+        [Nullable[bool]] $SharedResources,
+
+        [ValidateSet('DEFAULT', 'SPREAD', 'SPREAD_MEMORY')]
+        [string] $PlacementPolicy,
+
+        [object] $CustomProperties,
+
+        [ValidatePattern('^\d{4}-\d{2}-\d{2}$')]
+        [string] $ApiVersion,
+
+        [Nullable[bool]] $ValidatePrincipals
+    )
+
+    $baseUri = $Server.AbsoluteUri.TrimEnd('/')
+    $encodedId = [Uri]::EscapeDataString($Id)
+    $requestUri = "$baseUri/iaas/api/projects/$encodedId"
+
+    $query = [System.Collections.Generic.List[string]]::new()
+    if ($PSBoundParameters.ContainsKey('ApiVersion')) {
+        $query.Add('apiVersion=' + [Uri]::EscapeDataString($ApiVersion))
+    }
+    if ($PSBoundParameters.ContainsKey('ValidatePrincipals')) {
+        $query.Add('validatePrincipals=' + ([bool] $PSBoundParameters['ValidatePrincipals']).ToString().ToLowerInvariant())
+    }
+    if ($query.Count -gt 0) {
+        $requestUri += '?' + ($query -join '&')
+    }
+
+    $body = [ordered]@{ name = $Name }
+    $optionalBodyParameters = [ordered]@{
+        Description = 'description'
+        Administrators = 'administrators'
+        Members = 'members'
+        Viewers = 'viewers'
+        Supervisors = 'supervisors'
+        ZoneAssignmentConfigurations = 'zoneAssignmentConfigurations'
+        Constraints = 'constraints'
+        OperationTimeout = 'operationTimeout'
+        MachineNamingTemplate = 'machineNamingTemplate'
+        SharedResources = 'sharedResources'
+        PlacementPolicy = 'placementPolicy'
+        CustomProperties = 'customProperties'
+    }
+    foreach ($parameterName in $optionalBodyParameters.Keys) {
+        if ($PSBoundParameters.ContainsKey($parameterName)) {
+            $body[$optionalBodyParameters[$parameterName]] = $PSBoundParameters[$parameterName]
+        }
+    }
+
+    $jsonBody = $body | ConvertTo-Json -Depth 20 -Compress
+    $headers = @{
+        Authorization = "Bearer $ApiToken"
+        Accept = 'application/json'
+    }
+    $request = @{
+        Uri = $requestUri
+        Method = 'Patch'
+        Headers = $headers
+        ContentType = 'application/json'
+        Body = [Text.Encoding]::UTF8.GetBytes($jsonBody)
+    }
+
+    Invoke-RestMethod @request
+}
+
+Export-ModuleMember -Function Invoke-VcfAutomationUpdateProject

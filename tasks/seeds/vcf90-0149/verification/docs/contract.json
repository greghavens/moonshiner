          "type": "string",
          "format": "yyyy-MM-dd",
          "required": false
        },
        "validatePrincipals": {
          "type": "boolean",
          "required": false
        }
      },
      "authentication": {
        "header": "Authorization",
        "scheme": "Bearer"
      },
      "request": {
        "required": true,

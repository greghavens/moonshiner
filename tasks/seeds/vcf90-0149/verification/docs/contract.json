            "required": false
          },
          "constraints": {
            "type": "object",
            "required": false
          },
          "operationTimeout": {
            "type": "integer",
            "format": "int64",
            "required": false
          },
          "machineNamingTemplate": {
            "type": "string",
            "required": false
          },
          "sharedResources": {
            "type": "boolean",
            "required": false
          },
          "placementPolicy": {
            "type": "string",
            "enum": [
              "DEFAULT",
              "SPREAD",
              "SPREAD_MEMORY"
            ],
            "required": false
          },
          "customProperties": {
            "type": "object",
            "required": false
          }
        },
        "serializationRule": "Optional body properties are omitted when their corresponding PowerShell parameters are not bound. Values explicitly bound as false, zero, an empty string, or an empty collection are serialized as supplied."

            "required": false
          },
          "members": {
            "type": "array",
            "items": "User",
            "required": false
          },
          "viewers": {
            "type": "array",
            "items": "User",
            "required": false
          },
          "supervisors": {
            "type": "array",
            "items": "User",
            "required": false
          },
          "zoneAssignmentConfigurations": {
            "type": "array",

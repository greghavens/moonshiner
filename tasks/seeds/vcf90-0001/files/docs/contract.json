    "specPath": "specifications/sddc-manager/sddc-manager-openapi.json",
    "openapiVersion": "3.0.1",
    "apiTitle": "VMware Cloud Foundation API Reference Guide",
    "apiVersion": "9.0.0.0",
    "projectionRule": "Project only the four operations the client calls, and only the schema members required to authenticate, read a bundle, serialize BundleUpdateSpec, and poll a Task to a terminal state. Bundle, Task and Error are trimmed to those members; every other projected schema is reproduced whole. $ref targets are rewritten from #/components/schemas/ to #/schemas/."
  },
  "operations": [
    {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "tag": "Tokens",
      "summary": "Create Token Pair",
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": {
          "$ref": "#/schemas/TokenCreationSpec"
        }
      },
      "responses": {
        "201": {
          "description": "Created",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/TokenPair"
          }
        }
      }
    },
    {
      "operationId": "getBundle",
      "method": "GET",
      "path": "/v1/bundles/{id}",
      "tag": "Bundles",
      "summary": "Retrieve a bundle by its ID",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "description": "Bundle ID",
          "required": true,
          "schema": {
            "type": "string"
          },
          "example": "e6ba8240-d9b7-11ef-bf62-63832c57ab1a"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/Bundle"
          }
        },
        "404": {
          "description": "Bundle Not Found",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/Error"
          }
        }
      }
    },
    {
      "operationId": "startBundleDownloadByID",
      "method": "PATCH",
      "path": "/v1/bundles/{id}",
      "tag": "Bundles",
      "summary": "Start immediate, schedule or cancel download of a bundle by ID",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "description": "Bundle ID",
          "required": true,
          "schema": {
            "type": "string"
          },
          "example": "e6ba8240-d9b7-11ef-bf62-63832c57ab1a"
        }
      ],
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": {
          "$ref": "#/schemas/BundleUpdateSpec"
        }
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/Task"
          }
        },
        "400": {
          "description": "Bad Request",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/Error"
          }
        },
        "409": {
          "description": "Conflict",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/Error"
          }
        }
      }
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "tag": "Tasks",
      "summary": "Retrieve a task by its ID",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "description": "Task id to retrieve",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "A task object.",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/Task"
          }
        },
        "404": {
          "description": "Task not found",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/Error"
          }
        }
      }
    }
  ],
  "schemas": {
    "TokenCreationSpec": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "Username"
        },
        "password": {
          "type": "string",
          "description": "User Password"
        },
        "apiKey": {
          "type": "string",
          "description": "API Key"
        },
        "idToken": {
          "type": "string",
          "description": "Id Token"
        }
      },
      "description": "The spec used to sign the token"
    },
    "RefreshToken": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Refresh token id that can be used to request new access token"
        }
      },
      "description": "This contains refresh token id for the user API access."
    },
    "TokenPair": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string",
          "description": "Bearer token that can be used to make public API calls"
        },
        "refreshToken": {
          "$ref": "#/schemas/RefreshToken"
        }
      },
      "description": "This contains the access token and the refresh token for the user API access."
    },
    "BundleUpdateSpec": {
      "type": "object",
      "properties": {
        "bundleDownloadSpec": {
          "$ref": "#/schemas/BundleDownloadSpec"
        }
      },
      "description": "Bundle Update Specification"
    },
    "BundleDownloadSpec": {
      "type": "object",
      "properties": {
        "scheduledTimestamp": {
          "type": "string",
          "description": "Bundle Download Scheduled Time",
          "example": "2025-01-24T10:00:00Z"
        },
        "downloadNow": {
          "type": "boolean",
          "description": "Flag for enabling Download Now. If true, scheduledTimestamp is ignored"
        },
        "cancelNow": {
          "type": "boolean",
          "description": "Flag for cancelling the download. If true, scheduledTimestamp/downloadNow is ignored"
        }
      },
      "description": "Bundle Download Specification. This specification gets used in the Bundle Download API"
    },
    "Bundle": {
      "required": [
        "downloadStatus",
        "type"
      ],
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Bundle ID",
          "readOnly": true
        },
        "type": {
          "type": "string",
          "description": "Bundle Type",
          "readOnly": true,
          "example": "One among: SDDC_MANAGER, VMWARE_SOFTWARE, VXRAIL"
        },
        "version": {
          "type": "string",
          "description": "Bundle Version",
          "readOnly": true
        },
        "vendor": {
          "type": "string",
          "description": "Bundle Vendor",
          "readOnly": true
        },
        "sizeMB": {
          "type": "number",
          "description": "Bundle Size in MB",
          "format": "double",
          "readOnly": true
        },
        "downloadStatus": {
          "type": "string",
          "description": "Bundle Download Status",
          "readOnly": true,
          "example": "One among: PENDING, SCHEDULED, IN_PROGRESS, SUCCESSFUL, FAILED, RECALLED"
        },
        "isCumulative": {
          "type": "boolean",
          "description": "Is Bundle Cumulative",
          "readOnly": true
        }
      },
      "description": "Bundle contains bits to install/update the appropriate Cloud Foundation software components in your management domain or workload domain.",
      "readOnly": true
    },
    "Task": {
      "required": [
        "creationTimestamp",
        "id",
        "name",
        "status"
      ],
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Task ID",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "description": "Task name",
          "readOnly": true
        },
        "type": {
          "type": "string",
          "description": "Operation that is represented by the Task in machine readable format.  The value is controlled by the owners/producers of the Task. The convention is <resource>_<operation>",
          "readOnly": true,
          "example": "Sample values: HOST_COMMISSION, HOST_DECOMMISSION"
        },
        "status": {
          "type": "string",
          "description": "Task status",
          "readOnly": true,
          "example": "One among: PENDING, Pending, IN_PROGRESS, In Progress, SUCCESSFUL, Successful, FAILED, Failed, CANCELLED, Cancelled, COMPLETED_WITH_WARNING, SKIPPED"
        },
        "creationTimestamp": {
          "type": "string",
          "description": "Task creation timestamp",
          "readOnly": true
        },
        "completionTimestamp": {
          "type": "string",
          "description": "Task completion timestamp",
          "readOnly": true
        },
        "errors": {
          "type": "array",
          "description": "List of errors in case of a failure",
          "readOnly": true,
          "items": {
            "$ref": "#/schemas/Error"
          }
        }
      },
      "description": "Represents a task"
    },
    "Error": {
      "type": "object",
      "properties": {
        "errorCode": {
          "type": "string",
          "description": "The minor error code",
          "readOnly": true
        },
        "message": {
          "type": "string",
          "description": "The localized error message",
          "readOnly": true
        },
        "referenceToken": {
          "type": "string",
          "description": "A reference token correlating the error with the relevant detailed error logs. Should be sent to the service provider when reporting issues.",
          "readOnly": true
        }
      },
      "description": "Error response containing a minor error code, a localized error message, a localized remediation message and optionally a reference token to correlate the error with the logs ",
      "readOnly": true
    }
  },
  "clientPollingPolicy": {
    "submissionIsNotCompletion": true,
    "note": "startBundleDownloadByID answers 202 with a Task that only identifies the work to watch. The terminal state is discovered through getTask, never assumed from the submission response.",
    "statusNormalization": "trim, uppercase invariant, replace spaces with underscores",
    "statusSource": "/components/schemas/Task/properties/status (example member)",
    "nonTerminal": [
      "PENDING",
      "IN_PROGRESS"
    ],
    "successfulTerminal": [
      "SUCCESSFUL",
      "COMPLETED_WITH_WARNING",
      "SKIPPED"
    ],
    "failedTerminal": [
      "FAILED",
      "CANCELLED"
    ],
    "unknownStatus": "treat as non-terminal and keep polling, bounded by PollLimit"
  },
  "downloadSpecPolicy": {
    "note": "BundleDownloadSpec has no required members. Send exactly the member the caller asked for: downloadNow for an immediate download, or scheduledTimestamp for a scheduled one. Every member the caller did not ask for is absent from the JSON body, not null and not empty.",
    "immediate": {
      "bundleDownloadSpec": {
        "downloadNow": true
      }
    },
    "scheduled": {
      "bundleDownloadSpec": {
        "scheduledTimestamp": "<timestamp>"
      }
    },
    "neverSent": [
      "cancelNow"
    ]
  }
}

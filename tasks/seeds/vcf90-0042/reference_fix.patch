@@ -0,0 +1,109 @@
+"""Page Vcenter.Authorization.Permissions_list to completion, in a stable order.
+
+Wire rules taken from the pinned contract:
+
+* Both request-body members, ``filter`` and ``iterate``, are optional and every
+  property inside them is optional. Anything the caller did not ask for is left
+  out of the JSON entirely, never sent as ``null`` or as an empty object.
+* The operation's documented 400 is "if both filter and marker are passed", so
+  the FilterSpec travels on the first call only. Afterwards the server-issued
+  marker already carries it.
+* ``ListResult.marker`` missing or null means every currently available
+  permission has been returned.
+* ``Principal.domain`` missing or null means the ``localos`` domain.
+"""
+
+from __future__ import annotations
+
+from .client import VcenterSession
+
+# The domain the specification says to assume when Principal.domain is absent.
+DEFAULT_PRINCIPAL_DOMAIN = "localos"
+
+
+def _build_filter_spec(roles, is_propagating):
+    """Vcenter.Authorization.Permissions.FilterSpec, omitting anything unset."""
+    spec = {}
+    if roles is not None:
+        # uniqueItems in the schema; sorted so the body is byte-stable.
+        spec["roles"] = sorted(set(roles))
+    if is_propagating is not None:
+        # False is a value the caller asked for, not an absent property.
+        spec["is_propagating"] = bool(is_propagating)
+    return spec
+
+
+def _build_body(filter_spec, page_size, marker):
+    """One Permissions_list request body."""
+    body = {}
+    # A FilterSpec and a marker may never travel together.
+    if marker is None and filter_spec:
+        body["filter"] = dict(filter_spec)
+    iterate = {}
+    if page_size is not None:
+        iterate["page_size"] = page_size
+    if marker is not None:
+        iterate["marker"] = marker
+    if iterate:
+        body["iterate"] = iterate
+    return body
+
+
+def _normalise(item):
+    """One Vcenter.Authorization.Permissions.ListItem as a flat record."""
+    info = item["info"]
+    obj = info["object"]
+    principal = info["principal"]
+    domain = principal.get("domain")
+    return {
+        "permission": item["permission"],
+        "object_type": obj["type"],
+        "object_id": obj["id"],
+        "principal_type": principal["type"],
+        "principal_name": principal["name"],
+        "principal_domain": domain if domain else DEFAULT_PRINCIPAL_DOMAIN,
+        "role": info["role"],
+        "propagating": bool(info["propagating"]),
+    }
+
+
+def _sort_key(record):
+    return (
+        record["object_type"],
+        record["object_id"],
+        record["principal_domain"],
+        record["principal_name"],
+        record["principal_type"],
+        record["role"],
+        record["permission"],
+    )
+
+
+def collect_permissions(base_url, username, password, *, roles=None,
+                        is_propagating=None, page_size=None, timeout=30.0):
+    """Retrieve every authorization permission and emit it in a stable order.
+
+    Returns ``{"permissions": [...], "count": int, "pages": int}``.
+    """
+    if page_size is not None:
+        page_size = int(page_size)
+        if page_size < 1:
+            raise ValueError("page_size must be a positive integer")
+
+    filter_spec = _build_filter_spec(roles, is_propagating)
+
+    records = []
+    pages = 0
+    marker = None
+    with VcenterSession(base_url, timeout=timeout) as session:
+        session.open(username, password)
+        while True:
+            page = session.list_permissions(_build_body(filter_spec, page_size, marker))
+            pages += 1
+            records.extend(_normalise(item) for item in page["items"])
+            marker = page.get("marker")
+            if marker is None:
+                break
+
+    records.sort(key=_sort_key)
+    return {"permissions": records, "count": len(records), "pages": pages}

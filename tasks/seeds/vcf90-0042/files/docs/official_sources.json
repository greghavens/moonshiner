      "json_pointer": "/paths/~1vcenter~1authorization~1permissions?action=list/post",
      "security_scheme": "api_key_auth",
      "used_for": "the marker-paged collection itself: FilterSpec plus IterationSpec in, ListResult out",
      "spec_notes": [
        "The operation was added in vSphere API 9.0.0.0, so it does not exist in any pre-9.0 revision of this document.",
        "The request body is not required; both of its properties, filter and iterate, are optional.",
        "The 400 response is documented as 'if both filter and marker are passed', which is what forbids carrying a FilterSpec on a continuation request.",
        "Vcenter.Authorization.Permissions.IterationSpec.page_size is documented as defaulting to 200 permissions when missing or null.",
        "Vcenter.Authorization.Permissions.ListResult.marker is documented as missing or null once all currently available permissions have been returned."
      ]

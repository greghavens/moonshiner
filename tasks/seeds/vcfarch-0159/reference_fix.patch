+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+function Get-VcfSdkTopology {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $SddcManager,
+
+        [Parameter(Mandatory)]
+        [pscredential] $Credential
+    )
+
+    Import-Module -Name VMware.Sdk.Vcf.SddcManager -ErrorAction Stop
+    $connection = Connect-VcfSddcManagerServer -Server $SddcManager -Credential $Credential
+    try {
+        $domains = @(Get-SddcDomain -Server $connection)
+        $domainResults = foreach ($domain in $domains) {
+            $clusters = @(Get-SddcCluster -Domain $domain -Server $connection)
+            [ordered]@{
+                domainId = [string]$domain.Id
+                name = [string]$domain.Name
+                clusters = @($clusters | ForEach-Object {
+                    [ordered]@{
+                        clusterId = [string]$_.Id
+                        name = [string]$_.Name
+                    }
+                })
+            }
+        }
+        return @($domainResults)
+    }
+    finally {
+        Disconnect-VcfSddcManagerServer -Server $connection -Force
+    }
+}
+
+function Get-ContentCategory {
+    param(
+        [Parameter(Mandatory)] [object] $Product,
+        [Parameter(Mandatory)] [string] $ItemId
+    )
+    $item = @($Product.content | Where-Object itemId -EQ $ItemId)
+    if ($item.Count -ne 1) {
+        throw "Inventory item '$ItemId' was not found exactly once for $($Product.product)."
+    }
+    return [string]$item[0].category
+}
+
+function New-CarryRecord {
+    param(
+        [Parameter(Mandatory)] [object] $Product,
+        [Parameter(Mandatory)] [object] $Rule,
+        [Parameter(Mandatory)] [string] $Validation
+    )
+    return [ordered]@{
+        itemId = [string]$Rule.itemId
+        category = Get-ContentCategory -Product $Product -ItemId $Rule.itemId
+        method = [string]$Rule.method
+        validation = $Validation
+    }
+}
+
+function New-AbandonRecord {
+    param(
+        [Parameter(Mandatory)] [object] $Product,
+        [Parameter(Mandatory)] [object] $Rule,
+        [Parameter(Mandatory)] [string] $Disposition
+    )
+    return [ordered]@{
+        itemId = [string]$Rule.itemId
+        category = Get-ContentCategory -Product $Product -ItemId $Rule.itemId
+        reasonCode = [string]$Rule.reasonCode
+        disposition = $Disposition
+    }
+}
+
+function New-Gates {
+    param([Parameter(Mandatory)] [string[]] $GateIds)
+
+    $details = @{
+        'gate-lifecycle-backup' = @('Confirm a recoverable Lifecycle appliance backup.', 'Successful restore-point validation record')
+        'gate-lifecycle-p2' = @('Confirm Aria Suite Lifecycle 8.18 Patch 2 is installed.', 'Lifecycle About page and inventory sync show Patch 2')
+        'gate-ops-source-supported' = @('Confirm the 8.18.3 to 9.0.2 Operations path in prechecks.', 'Fleet upgrade precheck returns no source-version blocker')
+        'gate-ops-backup' = @('Capture and validate the Operations cluster backup.', 'Backup job and restore validation are successful')
+        'gate-ops-capacity' = @('Reserve the pinned Operations placement resources.', 'Cluster headroom calculation and placement reservation')
+        'gate-fleet-ready' = @('Confirm VCF Operations Fleet Management is healthy and can import Automation.', 'Fleet health and inventory sync are green')
+        'gate-automation-backup' = @('Capture and validate the Automation backup.', 'Automation backup and restore validation are successful')
+        'gate-remove-avi-account' = @('Remove the unsupported Avi cloud account after dependency review.', 'Automation inventory contains no Avi cloud account')
+        'gate-automation-capacity' = @('Reserve the pinned Automation placement resources.', 'Cluster headroom calculation and placement reservation')
+        'gate-logs-capacity' = @('Reserve three large Logs nodes and their storage.', 'Placement reservation covers compute, memory, and storage')
+        'gate-logs-networking' = @('Validate DNS, NTP, certificates, VIP, and required flows.', 'Synthetic connectivity and certificate checks pass')
+        'gate-logs-parallel' = @('Keep the 8.18.3 Logs cluster available during transition.', 'Source health check and parallel-run change record')
+        'gate-log-content-validation' = @('Validate imported content pack, dashboard, and alert behavior.', 'Object counts and functional tests match the source')
+        'gate-log-transfer-90-days' = @('Limit the supported historical transfer to days 1 through 90.', 'Transfer report covers the pinned 90-day window')
+        'gate-log-forwarders-validated' = @('Validate every reconfigured forwarder and integration.', 'All 146 forwarders and six integrations emit target events')
+        'gate-target-health' = @('Confirm target component health after cutover.', 'Fleet and component health checks are green')
+        'gate-content-counts' = @('Reconcile every carried and abandoned inventory item.', 'Item-level reconciliation has no unexplained delta')
+        'gate-retention-boundary-recorded' = @('Record that days 91 through 180 are outside transfer support.', 'Retirement record identifies the abandoned history interval')
+    }
+
+    return @($GateIds | ForEach-Object {
+        if (-not $details.ContainsKey($_)) { throw "No gate definition exists for $_" }
+        [ordered]@{ gateId = $_; check = $details[$_][0]; evidence = $details[$_][1] }
+    })
+}
+
+function New-VcfMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $InventoryPath,
+
+        [Parameter(Mandatory)]
+        [string] $CompatibilitySnapshotPath,
+
+        [Parameter(Mandatory)]
+        [string] $InstallerSpecPath,
+
+        [string] $SddcManager,
+
+        [pscredential] $Credential
+    )
+
+    $inventory = Get-Content -LiteralPath $InventoryPath -Raw | ConvertFrom-Json -Depth 100
+    $snapshot = Get-Content -LiteralPath $CompatibilitySnapshotPath -Raw | ConvertFrom-Json -Depth 100
+    $spec = Get-Content -LiteralPath $InstallerSpecPath -Raw | ConvertFrom-Json -Depth 100
+
+    if ($PSBoundParameters.ContainsKey('SddcManager') -or $PSBoundParameters.ContainsKey('Credential')) {
+        if (-not $SddcManager -or $null -eq $Credential) {
+            throw 'SddcManager and Credential must be supplied together for live topology validation.'
+        }
+        $live = @(Get-VcfSdkTopology -SddcManager $SddcManager -Credential $Credential)
+        foreach ($placement in $snapshot.placementRules) {
+            $liveDomain = @($live | Where-Object domainId -EQ $placement.domainId)
+            if ($liveDomain.Count -ne 1) {
+                throw "Pinned domain $($placement.domainId) is absent from live SDDC Manager."
+            }
+            $liveClusterIds = @($liveDomain[0].clusters | ForEach-Object clusterId)
+            if ($placement.clusterId -notin $liveClusterIds) {
+                throw "Pinned cluster $($placement.clusterId) is absent from live domain $($placement.domainId)."
+            }
+        }
+    }
+
+    $products = @{}
+    foreach ($product in $inventory.sourceProducts) { $products[$product.product] = $product }
+    $paths = @{}
+    foreach ($path in $snapshot.migrationPaths) { $paths[$path.sourceProduct] = $path }
+
+    $ops = $products['VMware Aria Operations']
+    $opsPath = $paths['VMware Aria Operations']
+    $automation = $products['VMware Aria Automation']
+    $automationPath = $paths['VMware Aria Automation']
+    $logs = $products['VMware Aria Operations for Logs']
+    $logsPath = $paths['VMware Aria Operations for Logs']
+
+    $empty = @()
+    $plan = @(
+        [ordered]@{
+            sequence = 1
+            stepId = 'patch-lifecycle-manager'
+            source = [ordered]@{
+                instanceId = [string]$inventory.foundation.lifecycleManager.instanceId
+                product = [string]$snapshot.lifecyclePrerequisite.sourceProduct
+                version = [string]$snapshot.lifecyclePrerequisite.sourceVersion
+            }
+            target = [ordered]@{
+                component = [string]$snapshot.lifecyclePrerequisite.sourceProduct
+                version = [string]$snapshot.lifecyclePrerequisite.targetVersion
+            }
+            migrationMode = 'prerequisite-patch'
+            placementComponent = 'platform-prerequisite'
+            carryForward = $empty
+            abandoned = $empty
+            gates = @(New-Gates -GateIds $snapshot.lifecyclePrerequisite.requiredGateIds)
+            dependsOn = $empty
+        }
+        [ordered]@{
+            sequence = 2
+            stepId = 'upgrade-operations'
+            source = [ordered]@{ instanceId = $ops.instanceId; product = $ops.product; version = $ops.version }
+            target = [ordered]@{ component = $opsPath.targetComponent; version = $opsPath.targetVersion }
+            migrationMode = 'in-place-upgrade'
+            placementComponent = 'VCF Operations'
+            carryForward = @($opsPath.carryForward | ForEach-Object {
+                New-CarryRecord -Product $ops -Rule $_ -Validation 'Compare object count and exercise the migrated item after cluster health is green.'
+            })
+            abandoned = $empty
+            gates = @(New-Gates -GateIds $opsPath.requiredGateIds)
+            dependsOn = @('patch-lifecycle-manager')
+        }
+        [ordered]@{
+            sequence = 3
+            stepId = 'upgrade-automation'
+            source = [ordered]@{ instanceId = $automation.instanceId; product = $automation.product; version = $automation.version }
+            target = [ordered]@{ component = $automationPath.targetComponent; version = $automationPath.targetVersion }
+            migrationMode = 'fleet-import-and-upgrade'
+            placementComponent = 'VCF Automation'
+            carryForward = @($automationPath.carryForward | ForEach-Object {
+                New-CarryRecord -Product $automation -Rule $_ -Validation 'Reconcile the inventory count and run a representative request after upgrade.'
+            })
+            abandoned = @($automationPath.abandoned | ForEach-Object {
+                New-AbandonRecord -Product $automation -Rule $_ -Disposition 'Remove before precheck; do not recreate until a supported target capability exists.'
+            })
+            gates = @(New-Gates -GateIds $automationPath.requiredGateIds)
+            dependsOn = @('upgrade-operations')
+        }
+        [ordered]@{
+            sequence = 4
+            stepId = 'deploy-logs'
+            source = [ordered]@{ instanceId = $logs.instanceId; product = $logs.product; version = $logs.version }
+            target = [ordered]@{ component = $logsPath.targetComponent; version = $logsPath.targetVersion }
+            migrationMode = 'parallel-fresh-deployment'
+            placementComponent = 'VCF Operations for Logs'
+            carryForward = $empty
+            abandoned = $empty
+            gates = @(New-Gates -GateIds $logsPath.requiredGateIdsByStep.'deploy-logs')
+            dependsOn = @('upgrade-automation')
+        }
+        [ordered]@{
+            sequence = 5
+            stepId = 'cutover-logs'
+            source = [ordered]@{ instanceId = $logs.instanceId; product = $logs.product; version = $logs.version }
+            target = [ordered]@{ component = $logsPath.targetComponent; version = $logsPath.targetVersion }
+            migrationMode = 'parallel-content-and-data-cutover'
+            placementComponent = 'VCF Operations for Logs'
+            carryForward = @($logsPath.carryForward | ForEach-Object {
+                New-CarryRecord -Product $logs -Rule $_ -Validation 'Reconcile the item and verify current events or functional output on the target.'
+            })
+            abandoned = $empty
+            gates = @(New-Gates -GateIds $logsPath.requiredGateIdsByStep.'cutover-logs')
+            dependsOn = @('deploy-logs')
+        }
+        [ordered]@{
+            sequence = 6
+            stepId = 'retire-legacy'
+            source = [ordered]@{ instanceId = $logs.instanceId; product = $logs.product; version = $logs.version }
+            target = [ordered]@{ component = $logsPath.targetComponent; version = $logsPath.targetVersion }
+            migrationMode = 'retire-after-validation'
+            placementComponent = 'VCF Operations for Logs'
+            carryForward = $empty
+            abandoned = @($logsPath.abandoned | ForEach-Object {
+                New-AbandonRecord -Product $logs -Rule $_ -Disposition 'Retain the source read-only through verification, then expire this unsupported interval with the source.'
+            })
+            gates = @(New-Gates -GateIds $logsPath.requiredGateIdsByStep.'retire-legacy')
+            dependsOn = @('cutover-logs')
+        }
+    )
+
+    $supportBoundaries = @($snapshot.migrationPaths | ForEach-Object {
+        [ordered]@{
+            sourceProduct = [string]$_.sourceProduct
+            sourceVersion = [string]$_.sourceVersion
+            endOfGeneralSupport = [string]$_.endOfGeneralSupport
+            designConsequence = 'Complete the supported transition before this source release leaves general support.'
+        }
+    })
+
+    $research = [ordered]@{
+        consulted = @(
+            [ordered]@{
+                title = 'Update Sequence for VCF 9.0 and Compatible VMware Products'
+                publisher = 'Broadcom Knowledge Base'
+                url = 'https://knowledge.broadcom.com/external/article/390634/update-sequence-for-vcf-90-and-compatibl.html'
+                accessedOn = '2026-08-15'
+                claims = @('Lifecycle Patch 2 precedes Operations; Logs 9.0 is a fresh installation with a 90-day data transfer.')
+            }
+            [ordered]@{
+                title = 'Import and upgrade VMware Aria Automation 8.x to VCF Automation 9.0'
+                publisher = 'Broadcom Knowledge Base'
+                url = 'https://knowledge.broadcom.com/external/article/433806/import-and-upgrade-vmware-aria-automatio.html'
+                accessedOn = '2026-08-15'
+                claims = @('Automation must be imported from legacy Lifecycle into VCF Operations Fleet Management before upgrade.')
+            }
+            [ordered]@{
+                title = 'Essential Prechecks for a Successful VCF Automation Upgrade'
+                publisher = 'Broadcom Knowledge Base'
+                url = 'https://knowledge.broadcom.com/external/article/389563/essential-prechecks-for-a-successful-vcf.html'
+                accessedOn = '2026-08-15'
+                claims = @('Avi Load Balancer cloud accounts are unsupported in VCF Automation 9.0 and block upgrade.')
+            }
+            [ordered]@{
+                title = 'Upgrade Guidance for Aria Operations for Logs 8.18.x to VCF Operations for Logs 9.0.x'
+                publisher = 'Broadcom Knowledge Base'
+                url = 'https://knowledge.broadcom.com/external/article/402314'
+                accessedOn = '2026-08-15'
+                claims = @('Logs requires a parallel fresh deployment; integrations are reconfigured and no more than 90 days of data transfers.')
+            }
+            [ordered]@{
+                title = 'VCF Operations 9.0 Sizing Guidelines'
+                publisher = 'Broadcom Knowledge Base'
+                url = 'https://knowledge.broadcom.com/external/article/397782/vcf-operations-90-sizing-guidelines.html'
+                accessedOn = '2026-08-15'
+                claims = @('Operations medium-node and Logs large-node capacity limits used by the sizing design.')
+            }
+            [ordered]@{
+                title = 'End of General Support for VMware Aria Operations 8.18'
+                publisher = 'Broadcom Knowledge Base'
+                url = 'https://knowledge.broadcom.com/external/article/422643/end-of-general-support-for-vmware-aria-o.html'
+                accessedOn = '2026-08-15'
+                claims = @('The VMware Aria Operations 8.18 release family, including the inventoried 8.18.3 instance, reaches end of general support on 2027-10-11.')
+            }
+            [ordered]@{
+                title = 'Build numbers and versions for VMware Aria Automation (formerly vRealize Automation)'
+                publisher = 'Broadcom Knowledge Base'
+                url = 'https://knowledge.broadcom.com/external/article/318130/build-numbers-and-versions-for-vmware-ar.html'
+                accessedOn = '2026-08-15'
+                claims = @('The exact inventoried VMware Aria Automation 8.18.1 release reaches end of general support on 2027-10-11.')
+            }
+            [ordered]@{
+                title = 'Product Lifecycle matrix for Aria Suite'
+                publisher = 'Broadcom Knowledge Base'
+                url = 'https://knowledge.broadcom.com/external/article/381187'
+                accessedOn = '2026-08-15'
+                claims = @('Broadcom identifies VMware Aria Operations for Logs as a distinct Aria Suite lifecycle entry and directs exact-release lifecycle lookup; this is the lifecycle authority used for the inventoried 8.18.3 release and pinned 2027-10-11 boundary.')
+            }
+            [ordered]@{
+                title = 'Build numbers and versions of VMware Aria Operations for Logs'
+                publisher = 'Broadcom Knowledge Base'
+                url = 'https://knowledge.broadcom.com/external/article/325701/build-numbers-and-versions-of-vmware-ari.html'
+                accessedOn = '2026-08-15'
+                claims = @('VMware Aria Operations for Logs 8.18.3 is the exact source release represented by build 24515748 and released on 2025-01-30.')
+            }
+        )
+    }
+
+    $artifact = [ordered]@{
+        schemaVersion = '1.0'
+        inventoryId = [string]$inventory.inventoryId
+        compatibilitySnapshotId = [string]$snapshot.snapshotId
+        generatedBy = [ordered]@{
+            module = [string]$spec.module.name
+            moduleVersion = [string]$spec.module.version
+            sdkModules = @($spec.module.sdkModules)
+        }
+        research = $research
+        architecture = [ordered]@{
+            designId = 'northstar-vcf-management-services-9.0.2'
+            targetRelease = [string]$snapshot.targetRelease
+            placements = @($snapshot.placementRules)
+        }
+        supportBoundaries = $supportBoundaries
+        migrationPlan = $plan
+    }
+
+    $specDirectory = Split-Path -Parent (Resolve-Path -LiteralPath $InstallerSpecPath)
+    $outputPath = Join-Path $specDirectory $spec.artifactPath
+    $outputDirectory = Split-Path -Parent $outputPath
+    $null = New-Item -ItemType Directory -Path $outputDirectory -Force
+    $artifact | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $outputPath -Encoding utf8
+    return $artifact
+}
+
+Export-ModuleMember -Function New-VcfMigrationPlan

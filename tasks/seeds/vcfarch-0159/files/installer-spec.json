{
  "specVersion": "1.0",
  "artifactPath": "out/vcf-migration-plan.json",
  "module": {
    "manifestPath": "VcfMigrationDesign/VcfMigrationDesign.psd1",
    "implementationPath": "VcfMigrationDesign/VcfMigrationDesign.psm1",
    "name": "VcfMigrationDesign",
    "version": "1.0.0",
    "exportedFunction": "New-VcfMigrationPlan",
    "sdkModules": [
      "VMware.Sdk.Vcf.SddcManager"
    ],
    "liveTopologyCmdlets": [
      "Connect-VcfSddcManagerServer",
      "Get-SddcDomain",
      "Get-SddcCluster",
      "Disconnect-VcfSddcManagerServer"
    ]
  },
  "artifactSchema": {
    "type": "object",
    "required": [
      "schemaVersion",
      "inventoryId",
      "compatibilitySnapshotId",
      "generatedBy",
      "research",
      "architecture",
      "supportBoundaries",
      "migrationPlan"
    ],
    "additionalProperties": false,
    "properties": {
      "schemaVersion": {
        "const": "1.0"
      },
      "inventoryId": {
        "type": "string",
        "minLength": 1
      },
      "compatibilitySnapshotId": {
        "type": "string",
        "minLength": 1
      },
      "generatedBy": {
        "type": "object",
        "required": [
          "module",
          "moduleVersion",
          "sdkModules"
        ],
        "additionalProperties": false,
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1
          },
          "moduleVersion": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "sdkModules": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "research": {
        "type": "object",
        "required": [
          "consulted"
        ],
        "additionalProperties": false,
        "properties": {
          "consulted": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": [
                "title",
                "publisher",
                "url",
                "accessedOn",
                "claims"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "publisher": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://\\S+$"
                },
                "accessedOn": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "claims": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      },
      "architecture": {
        "type": "object",
        "required": [
          "designId",
          "targetRelease",
          "placements"
        ],
        "additionalProperties": false,
        "properties": {
          "designId": {
            "type": "string",
            "minLength": 1
          },
          "targetRelease": {
            "type": "string",
            "minLength": 1
          },
          "placements": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": [
                "component",
                "version",
                "domainId",
                "clusterId",
                "networkSegmentId",
                "topology",
                "nodeCount",
                "sizePreset",
                "perNodeResources",
                "sizingBasis"
              ],
              "additionalProperties": false,
              "properties": {
                "component": {
                  "enum": [
                    "VCF Operations",
                    "VCF Automation",
                    "VCF Operations for Logs"
                  ]
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "domainId": {
                  "type": "string",
                  "minLength": 1
                },
                "clusterId": {
                  "type": "string",
                  "minLength": 1
                },
                "networkSegmentId": {
                  "type": "string",
                  "minLength": 1
                },
                "topology": {
                  "type": "string",
                  "minLength": 1
                },
                "nodeCount": {
                  "type": "integer",
                  "minimum": 1
                },
                "sizePreset": {
                  "type": "string",
                  "minLength": 1
                },
                "perNodeResources": {
                  "type": "object",
                  "required": [
                    "vCpu",
                    "memoryGiB",
                    "storageTiB"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "vCpu": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "memoryGiB": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "storageTiB": {
                      "type": "number",
                      "minimum": 0.1
                    }
                  }
                },
                "sizingBasis": {
                  "type": "object",
                  "minProperties": 2,
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      },
      "supportBoundaries": {
        "type": "array",
        "minItems": 3,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "required": [
            "sourceProduct",
            "sourceVersion",
            "endOfGeneralSupport",
            "designConsequence"
          ],
          "additionalProperties": false,
          "properties": {
            "sourceProduct": {
              "type": "string",
              "minLength": 1
            },
            "sourceVersion": {
              "type": "string",
              "minLength": 1
            },
            "endOfGeneralSupport": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "designConsequence": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "migrationPlan": {
        "type": "array",
        "minItems": 6,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "required": [
            "sequence",
            "stepId",
            "source",
            "target",
            "migrationMode",
            "placementComponent",
            "carryForward",
            "abandoned",
            "gates",
            "dependsOn"
          ],
          "additionalProperties": false,
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "stepId": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "object",
              "required": [
                "instanceId",
                "product",
                "version"
              ],
              "additionalProperties": false,
              "properties": {
                "instanceId": {
                  "type": "string",
                  "minLength": 1
                },
                "product": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "target": {
              "type": "object",
              "required": [
                "component",
                "version"
              ],
              "additionalProperties": false,
              "properties": {
                "component": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "migrationMode": {
              "enum": [
                "prerequisite-patch",
                "in-place-upgrade",
                "fleet-import-and-upgrade",
                "parallel-fresh-deployment",
                "parallel-content-and-data-cutover",
                "retire-after-validation"
              ]
            },
            "placementComponent": {
              "type": "string",
              "minLength": 1
            },
            "carryForward": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": [
                  "itemId",
                  "category",
                  "method",
                  "validation"
                ],
                "additionalProperties": false,
                "properties": {
                  "itemId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "category": {
                    "type": "string",
                    "minLength": 1
                  },
                  "method": {
                    "type": "string",
                    "minLength": 1
                  },
                  "validation": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "abandoned": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": [
                  "itemId",
                  "category",
                  "reasonCode",
                  "disposition"
                ],
                "additionalProperties": false,
                "properties": {
                  "itemId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "category": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reasonCode": {
                    "type": "string",
                    "minLength": 1
                  },
                  "disposition": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "gates": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": [
                  "gateId",
                  "check",
                  "evidence"
                ],
                "additionalProperties": false,
                "properties": {
                  "gateId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "check": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "dependsOn": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}

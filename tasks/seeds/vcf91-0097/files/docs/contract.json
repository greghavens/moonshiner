  "schemas": {
    "Vcenter.VM.CloneSpec": {
      "type": "object",
      "required": [
        "name",
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "resourceType": "VirtualMachine"
        },
        "name": {
          "type": "string"
        },
        "placement": {
          "required": false,
          "schema": "Vcenter.VM.ClonePlacementSpec",
          "unsetBehavior": "use source virtual machine values"
        },
        "disks_to_remove": {
          "required": false,
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "resourceType": "com.vmware.vcenter.vm.hardware.Disk"
          },
          "unsetBehavior": "all disks are copied"
        },
        "disks_to_update": {
          "required": false,
          "type": "object",
          "additionalProperties": {
            "schema": "Vcenter.VM.DiskCloneSpec"
          }
        },
        "power_on": {
          "required": false,
          "type": "boolean",
          "unsetBehavior": "virtual machine is not powered on"
        },
        "guest_customization_spec": {
          "required": false,
          "schema": "Vcenter.VM.GuestCustomizationSpec",
          "unsetBehavior": "guest operating system is not customized"
        }
      },
      "propertyOrder": [
        "source",
        "name",
        "placement",
        "disks_to_remove",
        "disks_to_update",
        "power_on",
        "guest_customization_spec"
      ]
    },
    "Cis.Tasks.GetSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "return_all": {
          "type": "boolean",
          "required": false
        },
        "exclude_result": {
          "type": "boolean",
          "required": false
        }
      }
    },
    "Cis.Task.Status": {
      "type": "string",
      "enum": [
        "PENDING",
        "RUNNING",
        "BLOCKED",
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "Cis.Task.Info": {
      "type": "object",
      "required": [
        "cancelable",
        "description",
        "operation",
        "service",
        "status"
      ],
      "properties": {
        "description": {
          "schema": "Vapi.Std.LocalizableMessage"
        },
        "service": {
          "type": "string",
          "resourceType": "com.vmware.vapi.service"
        },
        "operation": {
          "type": "string",
          "resourceType": "com.vmware.vapi.operation"
        },
        "status": {
          "type": "string",
          "schema": "Cis.Task.Status"
        },
        "cancelable": {
          "type": "boolean"
        },
        "result": {
          "required": false
        },
        "error": {
          "required": false,
          "type": "object"
        }
      }
    },
    "Vapi.Std.LocalizableMessage": {
      "type": "object",
      "required": [
        "args",
        "default_message",
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "default_message": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Vcenter.VM.Summary": {
      "type": "object",
      "required": [
        "name",
        "power_state",
        "vm"
      ],
      "properties": {
        "vm": {
          "type": "string",
          "resourceType": "VirtualMachine"
        },
        "name": {
          "type": "string"
        },
        "power_state": {
          "type": "string",
          "schema": "Vcenter.Vm.Power.State"
        },
        "cpu_count": {
          "type": "integer",
          "format": "int64",
          "required": false
        },
        "memory_size_mib": {
          "type": "integer",
          "format": "int64",
          "required": false
        }
      }
    },
    "Vcenter.Vm.Power.State": {
      "type": "string",
      "enum": [
        "POWERED_OFF",
        "POWERED_ON",
        "SUSPENDED"
      ]
    }
  },
  "workflow": {
    "order": [
      "Vcenter.VM_clone$Task",
      "Cis.Tasks_get",
      "Vcenter.VM_list"
    ],
    "repeat": {
      "operationId": "Cis.Tasks_get",
      "whileStatusIn": [
        "PENDING",
        "RUNNING",
        "BLOCKED"
      ],
      "terminalSuccess": "SUCCEEDED",
      "terminalFailure": "FAILED"
    },
    "collectionOrdering": {
      "operationId": "Vcenter.VM_list",
      "clientSort": [
        "name",
        "vm"
      ],
      "comparer": "StringComparer.Ordinal",
      "direction": "ascending"
    }
  }
}

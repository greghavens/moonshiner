+function Assert-VcfVcenterTaskInfo {
+    param(
+        [AllowNull()]
+        $TaskInfo,
+
+        [Parameter(Mandatory)]
+        [string] $OperationId
+    )
+
+    if ($null -eq $TaskInfo) {
+        throw [IO.InvalidDataException]::new(
+            "$OperationId returned a null task."
+        )
+    }
+    $Description = Get-VcfVcenterMember $TaskInfo 'description'
+    $Service = Get-VcfVcenterMember $TaskInfo 'service'
+    $Operation = Get-VcfVcenterMember $TaskInfo 'operation'
+    $Status = Get-VcfVcenterMember $TaskInfo 'status'
+    $Cancelable = Get-VcfVcenterMember $TaskInfo 'cancelable'
+    if (
+        -not $Description.Found -or $null -eq $Description.Value -or
+        -not $Service.Found -or $Service.Value -isnot [string] -or
+        -not $Operation.Found -or $Operation.Value -isnot [string] -or
+        -not $Status.Found -or $Status.Value -isnot [string] -or
+        -not $Cancelable.Found -or $Cancelable.Value -isnot [bool]
+    ) {
+        throw [IO.InvalidDataException]::new(
+            "$OperationId returned malformed task information."
+        )
+    }
+    if ($Status.Value -cnotin @(
+        'PENDING', 'RUNNING', 'BLOCKED', 'SUCCEEDED', 'FAILED'
+    )) {
+        throw [IO.InvalidDataException]::new(
+            "$OperationId returned an unknown task status."
+        )
+    }
+
+    $MessageId = Get-VcfVcenterMember $Description.Value 'id'
+    $DefaultMessage = Get-VcfVcenterMember `
+        $Description.Value 'default_message'
+    $Arguments = Get-VcfVcenterMember $Description.Value 'args'
+    if (
+        -not $MessageId.Found -or $MessageId.Value -isnot [string] -or
+        -not $DefaultMessage.Found -or
+        $DefaultMessage.Value -isnot [string] -or
+        -not $Arguments.Found -or $null -eq $Arguments.Value -or
+        $Arguments.Value -is [string] -or
+        $Arguments.Value -isnot [Collections.IEnumerable]
+    ) {
+        throw [IO.InvalidDataException]::new(
+            "$OperationId returned a malformed task description."
+        )
+    }
+    foreach ($Argument in $Arguments.Value) {
+        if ($Argument -isnot [string]) {
+            throw [IO.InvalidDataException]::new(
+                "$OperationId returned a malformed task description."
+            )
+        }
+    }
+    return $Status.Value
+}

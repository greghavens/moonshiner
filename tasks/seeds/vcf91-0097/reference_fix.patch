+    try {
+        try {
+            $Response = $Client.HttpClient.SendAsync(
+                $Request
+            ).GetAwaiter().GetResult()
+        }
+        catch {
+            throw [InvalidOperationException]::new(
+                "$OperationId request failed."
+            )
+        }
+        if ([int] $Response.StatusCode -ne $ExpectedStatus) {
+            throw [InvalidOperationException]::new(
+                "$OperationId returned HTTP $([int] $Response.StatusCode)."
+            )
+        }
+        try {
+            $ResponseText = $Response.Content.ReadAsStringAsync(
+            ).GetAwaiter().GetResult()
+        }
+        catch {
+            throw [InvalidOperationException]::new(
+                "$OperationId response could not be read."
+            )
+        }
+        if ([string]::IsNullOrWhiteSpace($ResponseText)) {
+            throw [IO.InvalidDataException]::new(
+                "$OperationId returned an empty response."

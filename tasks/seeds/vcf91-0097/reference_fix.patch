+function Assert-VcfVcenterVmSummary {
+    param(
+        [AllowNull()]
+        $Summary,
+
+        [Parameter(Mandatory)]
+        [string] $OperationId
+    )
+
+    if ($null -eq $Summary) {
+        throw [IO.InvalidDataException]::new(
+            "$OperationId returned a null VM summary."
+        )
+    }
+    $Vm = Get-VcfVcenterMember $Summary 'vm'
+    $Name = Get-VcfVcenterMember $Summary 'name'
+    $PowerState = Get-VcfVcenterMember $Summary 'power_state'
+    if (
+        -not $Vm.Found -or $Vm.Value -isnot [string] -or
+        [string]::IsNullOrWhiteSpace($Vm.Value) -or
+        -not $Name.Found -or $Name.Value -isnot [string] -or
+        [string]::IsNullOrWhiteSpace($Name.Value) -or
+        -not $PowerState.Found -or $PowerState.Value -isnot [string] -or
+        $PowerState.Value -cnotin @('POWERED_OFF', 'POWERED_ON', 'SUSPENDED')
+    ) {
+        throw [IO.InvalidDataException]::new(
+            "$OperationId returned a malformed VM summary."
+        )
+    }
+    foreach ($OptionalInteger in @('cpu_count', 'memory_size_mib')) {
+        $Member = Get-VcfVcenterMember $Summary $OptionalInteger
+        if ($Member.Found -and -not (Test-VcfVcenterInteger $Member.Value)) {
+            throw [IO.InvalidDataException]::new(
+                "$OperationId returned a malformed VM summary."
+            )
+        }
+    }
 }
 

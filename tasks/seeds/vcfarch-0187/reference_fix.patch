+    private static String jsonValue(String json, String key) {
+        String needle = "\"" + key + "\"";
+        int keyAt = json.indexOf(needle);
+        if (keyAt < 0) throw new IllegalArgumentException("missing JSON field " + key);
+        int colon = json.indexOf(':', keyAt + needle.length());
+        if (colon < 0) throw new IllegalArgumentException("missing colon after " + key);
+        int start = skipWhitespace(json, colon + 1);
+        int end = valueEnd(json, start);
+        return json.substring(start, end);
+    }
+
+    private static int skipWhitespace(String json, int at) {
+        while (at < json.length() && Character.isWhitespace(json.charAt(at))) at++;
+        return at;
+    }
+
+    private static int valueEnd(String json, int start) {
+        char first = json.charAt(start);
+        if (first == '"') return stringEnd(json, start);
+        if (first == '{' || first == '[') {
+            char close = first == '{' ? '}' : ']';
+            int depth = 0;
+            for (int i = start; i < json.length(); i++) {
+                char c = json.charAt(i);
+                if (c == '"') {
+                    i = stringEnd(json, i) - 1;
+                } else if (c == first) {
+                    depth++;
+                } else if (c == close && --depth == 0) {
+                    return i + 1;
+                }
+            }
+            throw new IllegalArgumentException("unterminated JSON container");
+        }
+        int end = start;
+        while (end < json.length() && ",}]\r\n\t ".indexOf(json.charAt(end)) < 0) end++;
+        return end;
+    }
+
+    private static int stringEnd(String json, int start) {
+        boolean escaped = false;
+        for (int i = start + 1; i < json.length(); i++) {
+            char c = json.charAt(i);
+            if (c == '"' && !escaped) return i + 1;
+            if (c == '\\' && !escaped) escaped = true;
+            else escaped = false;
+        }
+        throw new IllegalArgumentException("unterminated JSON string");
+    }
 

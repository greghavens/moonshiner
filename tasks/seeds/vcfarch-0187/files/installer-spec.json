{
  "specificationId": "vcf-migration-plan-installer-1.0",
  "artifactSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "estateId", "snapshotId", "researchSources", "architecture", "lifecycleBoundaries", "migrationCompatibility", "contentDecisions", "gates", "steps"],
    "properties": {
      "schemaVersion": {"const": "1.0"},
      "estateId": {"type": "string", "minLength": 1},
      "snapshotId": {"type": "string", "minLength": 1},
      "researchSources": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "url", "claimsUsed"],
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "publisher": {"const": "Broadcom"},
            "url": {"type": "string", "pattern": "^https://([A-Za-z0-9-]+\\.)*broadcom\\.com/\\S+$"},
            "consultedOn": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "claimsUsed": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      },
      "architecture": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetVersion", "lifecycleManager", "managementDomain", "components"],
        "properties": {
          "targetVersion": {"type": "string", "minLength": 1},
          "lifecycleManager": {
            "type": "object",
            "additionalProperties": false,
            "required": ["product", "sourceVersion", "requiredPatch", "placementSite", "compute"],
            "properties": {
              "product": {"type": "string", "minLength": 1},
              "sourceVersion": {"type": "string", "minLength": 1},
              "requiredPatch": {"type": "string", "minLength": 1},
              "placementSite": {"type": "string", "minLength": 1},
              "compute": {"type": "string", "minLength": 1}
            }
          },
          "managementDomain": {
            "type": "object",
            "additionalProperties": false,
            "required": ["topology", "preferredSite", "secondarySite", "stretchedDatastore", "vSanWitness", "operationsCaWitness", "witnessRolesDistinct"],
            "properties": {
              "topology": {"type": "string", "minLength": 1},
              "preferredSite": {"type": "string", "minLength": 1},
              "secondarySite": {"type": "string", "minLength": 1},
              "stretchedDatastore": {"type": "string", "minLength": 1},
              "vSanWitness": {"$ref": "#/$defs/witness"},
              "operationsCaWitness": {"$ref": "#/$defs/witness"},
              "witnessRolesDistinct": {"type": "boolean"}
            }
          },
          "components": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/component"}
          }
        }
      },
      "lifecycleBoundaries": {
        "type": "array",
        "minItems": 3,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceId", "product", "version", "endOfGeneralSupport", "statusAtSnapshot"],
          "properties": {
            "sourceId": {"type": "string", "minLength": 1},
            "product": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "endOfGeneralSupport": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "statusAtSnapshot": {"enum": ["supported", "out-of-general-support"]}
          }
        }
      },
      "migrationCompatibility": {
        "type": "array",
        "minItems": 3,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceId", "sourceVersion", "targetComponent", "targetVersion", "strategy", "directUpgradeSupported", "requiredIntermediateVersions", "maximumTransferAgeDays"],
          "properties": {
            "sourceId": {"type": "string", "minLength": 1},
            "sourceVersion": {"type": "string", "minLength": 1},
            "targetComponent": {"type": "string", "minLength": 1},
            "targetVersion": {"type": "string", "minLength": 1},
            "strategy": {"type": "string", "minLength": 1},
            "directUpgradeSupported": {"type": "boolean"},
            "requiredIntermediateVersions": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "maximumTransferAgeDays": {"type": "integer", "minimum": 0}
          }
        }
      },
      "contentDecisions": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceId", "contentId", "disposition", "target", "method", "reasonCode"],
          "properties": {
            "sourceId": {"type": "string", "minLength": 1},
            "contentId": {"type": "string", "minLength": 1},
            "disposition": {"enum": ["carry", "recreate", "retain-temporarily", "abandon"]},
            "target": {"type": "string", "minLength": 1},
            "method": {"type": "string", "minLength": 1},
            "reasonCode": {"type": "string", "minLength": 1}
          }
        }
      },
      "gates": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "condition", "evidence"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "type": {"type": "string", "minLength": 1},
            "condition": {"type": "string", "minLength": 1},
            "evidence": {"type": "string", "minLength": 1}
          }
        }
      },
      "steps": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["order", "id", "source", "target", "action", "carriedContentIds", "recreatedContentIds", "retainedTemporarilyContentIds", "abandonedContentIds", "gates", "dependsOn", "rollback"],
          "properties": {
            "order": {"type": "integer", "minimum": 1},
            "id": {"type": "string", "minLength": 1},
            "source": {"$ref": "#/$defs/productVersion"},
            "target": {"$ref": "#/$defs/productVersion"},
            "action": {"type": "string", "minLength": 1},
            "carriedContentIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "recreatedContentIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "retainedTemporarilyContentIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "abandonedContentIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "rollback": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "$defs": {
      "witness": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "site", "compute", "role", "outsideStretchedCluster"],
        "properties": {
          "assetId": {"type": "string", "minLength": 1},
          "site": {"type": "string", "minLength": 1},
          "compute": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "outsideStretchedCluster": {"type": "boolean"}
        }
      },
      "component": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version", "formFactor", "nodeCount", "vCpuTotal", "memoryGiBTotal", "diskGiBTotal", "capacity", "availability", "placements"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "formFactor": {"type": "string", "minLength": 1},
          "nodeCount": {"type": "integer", "minimum": 1},
          "vCpuTotal": {"type": "integer", "minimum": 1},
          "memoryGiBTotal": {"type": "integer", "minimum": 1},
          "diskGiBTotal": {"type": "integer", "minimum": 1},
          "capacity": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}},
          "availability": {"type": "string", "minLength": 1},
          "placements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["site", "compute", "role", "count"],
              "properties": {
                "site": {"type": "string", "minLength": 1},
                "compute": {"type": "string", "minLength": 1},
                "role": {"type": "string", "minLength": 1},
                "count": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      },
      "productVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "product", "version"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "product": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

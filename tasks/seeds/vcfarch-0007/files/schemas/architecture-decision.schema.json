{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "architecture-decision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "targetRelease",
    "site",
    "availability",
    "selectionObjective",
    "capacityRequirements",
    "candidates",
    "selectedStorageArchitecture",
    "selectedHostCount",
    "networkDesign"
  ],
  "properties": {
    "targetRelease": {
      "type": "string"
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "availabilityZoneModel",
        "stretchedCluster"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "availabilityZoneModel": {
          "enum": [
            "SINGLE_AVAILABILITY_ZONE"
          ]
        },
        "stretchedCluster": {
          "const": false
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostFailuresToTolerate",
        "hostReserve"
      ],
      "properties": {
        "hostFailuresToTolerate": {
          "type": "integer",
          "minimum": 1
        },
        "hostReserve": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "selectionObjective": {
      "const": "MINIMUM_COMPLIANT_HOST_COUNT"
    },
    "capacityRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredCpuCores",
        "requiredMemoryGiB",
        "requiredUsableStorageTiB",
        "headroomPercent"
      ],
      "properties": {
        "requiredCpuCores": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "requiredMemoryGiB": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "requiredUsableStorageTiB": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "headroomPercent": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 100
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "architecture",
          "supported",
          "hostCount",
          "cpuHostCount",
          "memoryHostCount",
          "storageHostCount",
          "limitingDimension",
          "usableStorageTiBAfterReserve",
          "minimumVsanBandwidthGbps",
          "configuredVsanBandwidthGbps",
          "uplinksPerHost",
          "uplinkSpeedGbps",
          "dvsCount",
          "deviceProtocol",
          "deviceAttachment"
        ],
        "properties": {
          "architecture": {
            "enum": [
              "OSA",
              "ESA"
            ]
          },
          "supported": {
            "type": "boolean"
          },
          "hostCount": {
            "type": "integer",
            "minimum": 1
          },
          "cpuHostCount": {
            "type": "integer",
            "minimum": 1
          },
          "memoryHostCount": {
            "type": "integer",
            "minimum": 1
          },
          "storageHostCount": {
            "type": "integer",
            "minimum": 1
          },
          "limitingDimension": {
            "enum": [
              "cpu",
              "memory",
              "storage",
              "minimum"
            ]
          },
          "usableStorageTiBAfterReserve": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minimumVsanBandwidthGbps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "configuredVsanBandwidthGbps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "uplinksPerHost": {
            "type": "integer",
            "minimum": 1
          },
          "uplinkSpeedGbps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "dvsCount": {
            "type": "integer",
            "minimum": 1
          },
          "deviceProtocol": {
            "type": "string"
          },
          "deviceAttachment": {
            "type": "string"
          }
        }
      }
    },
    "selectedStorageArchitecture": {
      "enum": [
        "OSA",
        "ESA"
      ]
    },
    "selectedHostCount": {
      "type": "integer",
      "minimum": 1
    },
    "networkDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uplinksPerHost",
        "uplinkSpeedGbps",
        "configuredVsanBandwidthGbps",
        "dvsCount",
        "dvsLayouts"
      ],
      "properties": {
        "uplinksPerHost": {
          "type": "integer",
          "minimum": 1
        },
        "uplinkSpeedGbps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "configuredVsanBandwidthGbps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dvsCount": {
          "type": "integer",
          "minimum": 1
        },
        "dvsLayouts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "networks",
              "vmnics"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "networks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "vmnics": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}

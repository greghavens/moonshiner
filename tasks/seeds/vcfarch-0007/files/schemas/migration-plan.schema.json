{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "migration-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "estateId",
    "targetRelease",
    "steps"
  ],
  "properties": {
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetRelease": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "componentId",
          "componentName",
          "currentVersion",
          "targetVersion",
          "action",
          "gatedBy"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "componentName": {
            "type": "string",
            "minLength": 1
          },
          "currentVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "UPGRADE",
              "DEPLOY",
              "ROLLING_UPGRADE",
              "UPGRADE_FORMAT",
              "MIGRATE_AND_DECOMMISSION",
              "DECOMMISSION"
            ]
          },
          "gatedBy": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

index 0000000..898e1ea
--- /dev/null
+++ b/VcfArchitecture/VcfArchitecture.psm1
@@ -0,0 +1,402 @@
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+Import-Module VMware.Sdk.Vcf.Installer -ErrorAction Stop
+
+function Read-VcfJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $Path
+    )
+
+    $resolved = (Resolve-Path -LiteralPath $Path -ErrorAction Stop).Path
+    return Get-Content -LiteralPath $resolved -Raw -Encoding utf8 | ConvertFrom-Json -Depth 100
+}
+
+function Write-VcfJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [object] $Value,
+
+        [Parameter(Mandatory)]
+        [string] $Path,
+
+        [switch] $SdkJson
+    )
+
+    $parent = Split-Path -Parent $Path
+    if ($parent) {
+        New-Item -ItemType Directory -Path $parent -Force | Out-Null
+    }
+    if ($SdkJson) {
+        $json = $Value.ToJson()
+    }
+    else {
+        $json = $Value | ConvertTo-Json -Depth 100
+    }
+    [System.IO.File]::WriteAllText(
+        [System.IO.Path]::GetFullPath($Path),
+        $json.TrimEnd() + [Environment]::NewLine,
+        [System.Text.UTF8Encoding]::new($false)
+    )
+}
+
+function Get-VcfCandidateDesigns {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [object] $Requirements,
+
+        [Parameter(Mandatory)]
+        [object] $Snapshot
+    )
+
+    $capacity = $Requirements.capacity
+    $compute = $Requirements.hostComputeProfile
+    $reserve = [int]$Requirements.availability.hostReserve
+    $headroomFactor = 1.0 - ([double]$capacity.headroomPercent / 100.0)
+    $cpuHosts = [int]([Math]::Ceiling(
+        [double]$capacity.requiredCpuCores / ([double]$compute.coresPerHost * $headroomFactor)
+    ) + $reserve)
+    $memoryHosts = [int]([Math]::Ceiling(
+        [double]$capacity.requiredMemoryGiB / ([double]$compute.memoryGiBPerHost * $headroomFactor)
+    ) + $reserve)
+
+    $result = foreach ($option in $Snapshot.storageOptions) {
+        $rawTiB = [double]$option.rawCapacityTBPerHost * 1000000000000.0 / [Math]::Pow(2, 40)
+        $perActiveHost = $rawTiB * [double]$option.usableCapacityFactor * [double]$option.maxUtilization
+        $storageHosts = [int]([Math]::Ceiling(
+            [double]$capacity.requiredUsableStorageTiB / $perActiveHost
+        ) + $reserve)
+        $hostCount = [Math]::Max(
+            [int]$option.minimumHostsSingleAvailabilityZone,
+            [Math]::Max($cpuHosts, [Math]::Max($memoryHosts, $storageHosts))
+        )
+
+        if ($storageHosts -eq $hostCount) {
+            $limitingDimension = 'storage'
+        }
+        elseif ($memoryHosts -eq $hostCount) {
+            $limitingDimension = 'memory'
+        }
+        elseif ($cpuHosts -eq $hostCount) {
+            $limitingDimension = 'cpu'
+        }
+        else {
+            $limitingDimension = 'minimum'
+        }
+
+        [pscustomobject][ordered]@{
+            architecture = [string]$option.architecture
+            supported = [bool]$option.supported
+            hostCount = [int]$hostCount
+            cpuHostCount = $cpuHosts
+            memoryHostCount = $memoryHosts
+            storageHostCount = $storageHosts
+            limitingDimension = $limitingDimension
+            usableStorageTiBAfterReserve = [Math]::Round(
+                ($hostCount - $reserve) * $perActiveHost,
+                3
+            )
+            minimumVsanBandwidthGbps = [double]$option.minimumVsanBandwidthGbps
+            configuredVsanBandwidthGbps = [double]$option.configuredVsanUplinks * [double]$option.uplinkSpeedGbps
+            uplinksPerHost = [int]$option.uplinksPerHost
+            uplinkSpeedGbps = [double]$option.uplinkSpeedGbps
+            dvsCount = @($option.dvsLayouts).Count
+            deviceProtocol = [string]$option.deviceProtocol
+            deviceAttachment = [string]$option.deviceAttachment
+            selectionPriority = [int]$option.selectionPriority
+        }
+    }
+    return @($result)
+}
+
+function New-VcfGreenfieldArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $RequirementsPath,
+
+        [Parameter(Mandatory)]
+        [string] $CompatibilitySnapshotPath,
+
+        [Parameter(Mandatory)]
+        [string] $OutputDirectory
+    )
+
+    $requirements = Read-VcfJson -Path $RequirementsPath
+    $snapshot = Read-VcfJson -Path $CompatibilitySnapshotPath
+    if ($requirements.targetRelease -ne $snapshot.targetRelease) {
+        throw "Requirements target $($requirements.targetRelease) does not match snapshot $($snapshot.targetRelease)."
+    }
+    if ($requirements.selectionObjective -ne 'MINIMUM_COMPLIANT_HOST_COUNT') {
+        throw "Unsupported selection objective: $($requirements.selectionObjective)"
+    }
+
+    $candidates = Get-VcfCandidateDesigns -Requirements $requirements -Snapshot $snapshot
+    $selected = $candidates |
+        Where-Object supported |
+        Sort-Object -Property hostCount, selectionPriority |
+        Select-Object -First 1
+    if (-not $selected) {
+        throw 'No supported storage architecture is present in the compatibility snapshot.'
+    }
+    $selectedOption = $snapshot.storageOptions |
+        Where-Object architecture -EQ $selected.architecture |
+        Select-Object -First 1
+
+    $decisionCandidates = foreach ($candidate in $candidates) {
+        [pscustomobject][ordered]@{
+            architecture = $candidate.architecture
+            supported = $candidate.supported
+            hostCount = $candidate.hostCount
+            cpuHostCount = $candidate.cpuHostCount
+            memoryHostCount = $candidate.memoryHostCount
+            storageHostCount = $candidate.storageHostCount
+            limitingDimension = $candidate.limitingDimension
+            usableStorageTiBAfterReserve = $candidate.usableStorageTiBAfterReserve
+            minimumVsanBandwidthGbps = $candidate.minimumVsanBandwidthGbps
+            configuredVsanBandwidthGbps = $candidate.configuredVsanBandwidthGbps
+            uplinksPerHost = $candidate.uplinksPerHost
+            uplinkSpeedGbps = $candidate.uplinkSpeedGbps
+            dvsCount = $candidate.dvsCount
+            deviceProtocol = $candidate.deviceProtocol
+            deviceAttachment = $candidate.deviceAttachment
+        }
+    }
+    $decisionLayouts = foreach ($layout in $selectedOption.dvsLayouts) {
+        [pscustomobject][ordered]@{
+            name = "$($requirements.sddcId)-$($layout.nameSuffix)"
+            networks = @($layout.networks)
+            vmnics = @($layout.vmnics)
+        }
+    }
+    $decision = [pscustomobject][ordered]@{
+        targetRelease = [string]$requirements.targetRelease
+        site = $requirements.site
+        availability = $requirements.availability
+        selectionObjective = [string]$requirements.selectionObjective
+        capacityRequirements = $requirements.capacity
+        candidates = @($decisionCandidates)
+        selectedStorageArchitecture = [string]$selected.architecture
+        selectedHostCount = [int]$selected.hostCount
+        networkDesign = [pscustomobject][ordered]@{
+            uplinksPerHost = [int]$selectedOption.uplinksPerHost
+            uplinkSpeedGbps = [double]$selectedOption.uplinkSpeedGbps
+            configuredVsanBandwidthGbps = [double]$selectedOption.configuredVsanUplinks * [double]$selectedOption.uplinkSpeedGbps
+            dvsCount = @($selectedOption.dvsLayouts).Count
+            dvsLayouts = @($decisionLayouts)
+        }
+    }
+
+    $hosts = for ($index = 1; $index -le $selected.hostCount; $index++) {
+        Initialize-VcfInstallerSddcHostSpec -Hostname ('{0}{1:d2}' -f $requirements.naming.hostPrefix, $index)
+    }
+    $networkSpecs = foreach ($network in $requirements.networks) {
+        $range = Initialize-VcfInstallerIpRange `
+            -StartIpAddress $network.startIpAddress `
+            -EndIpAddress $network.endIpAddress
+        Initialize-VcfInstallerSddcNetworkSpec `
+            -NetworkType $network.networkType `
+            -VlanId $network.vlanId `
+            -Subnet $network.subnet `
+            -Gateway $network.gateway `
+            -SubnetMask $network.subnetMask `
+            -IncludeIpAddressRanges @($range) `
+            -Mtu $network.mtu `
+            -TeamingPolicy 'loadbalance_loadbased' `
+            -PortGroupKey $network.portGroupKey `
+            -IpAddressVersion 'IPv4' `
+            -IpAddressAssignmentMode 'STATIC'
+    }
+    $dvsSpecs = foreach ($layout in $selectedOption.dvsLayouts) {
+        $mappings = for ($index = 0; $index -lt @($layout.vmnics).Count; $index++) {
+            Initialize-VcfInstallerVmnicToUplink `
+                -Id $layout.vmnics[$index] `
+                -Uplink "uplink$($index + 1)"
+        }
+        Initialize-VcfInstallerDvsSpec `
+            -DvsName "$($requirements.sddcId)-$($layout.nameSuffix)" `
+            -Networks @($layout.networks) `
+            -Mtu 9000 `
+            -VmnicsToUplinks @($mappings)
+    }
+
+    $vcenter = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname $requirements.appliances.vcenter.hostname `
+        -RootVcenterPassword $requirements.appliances.vcenter.rootPassword `
+        -VmSize $requirements.appliances.vcenter.vmSize `
+        -StorageSize $requirements.appliances.vcenter.storageSize `
+        -SsoDomain $requirements.appliances.vcenter.ssoDomain `
+        -Version $requirements.targetRelease `
+        -UseExistingDeployment $false
+    $dns = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $requirements.dns.subdomain `
+        -Nameservers @($requirements.dns.nameservers)
+    $cluster = Initialize-VcfInstallerSddcClusterSpec `
+        -DatacenterName $requirements.naming.datacenterName `
+        -ClusterName $requirements.naming.clusterName
+    $esa = Initialize-VcfInstallerVsanEsaConfig -Enabled ($selected.architecture -eq 'ESA')
+    $vsan = Initialize-VcfInstallerVsanSpec `
+        -DatastoreName $requirements.naming.datastoreName `
+        -VsanDedup $false `
+        -EsaConfig $esa `
+        -FailuresToTolerate $requirements.availability.hostFailuresToTolerate
+    $datastore = Initialize-VcfInstallerSddcDatastoreSpec -VsanSpec $vsan
+    $sddcManager = Initialize-VcfInstallerSddcManagerSpec `
+        -Hostname $requirements.appliances.sddcManager.hostname `
+        -RootPassword $requirements.appliances.sddcManager.rootPassword `
+        -SshPassword $requirements.appliances.sddcManager.sshPassword `
+        -LocalUserPassword $requirements.appliances.sddcManager.localUserPassword `
+        -Version $requirements.targetRelease `
+        -UseExistingDeployment $false
+    $nsxManagers = foreach ($hostname in $requirements.appliances.nsx.managerHostnames) {
+        Initialize-VcfInstallerNsxtManagerSpec -Hostname $hostname
+    }
+    $nsx = Initialize-VcfInstallerSddcNsxtSpec `
+        -NsxtManagers @($nsxManagers) `
+        -VipFqdn $requirements.appliances.nsx.vipFqdn `
+        -NsxtManagerSize $requirements.appliances.nsx.managerSize `
+        -RootNsxtManagerPassword $requirements.appliances.nsx.rootPassword `
+        -NsxtAdminPassword $requirements.appliances.nsx.adminPassword `
+        -NsxtAuditPassword $requirements.appliances.nsx.auditPassword `
+        -TransportVlanId $requirements.appliances.nsx.transportVlanId `
+        -Version $requirements.targetRelease `
+        -UseExistingDeployment $false
+    $licenseServer = Initialize-VcfInstallerLicenseServerSpec `
+        -Hostname $requirements.appliances.licenseServer.hostname `
+        -Version $requirements.appliances.licenseServer.version `
+        -UseExistingDeployment $false
+    $operationsNode = Initialize-VcfInstallerVcfOperationsNode `
+        -Hostname $requirements.appliances.vcfOperations.hostname `
+        -RootUserPassword $requirements.appliances.vcfOperations.rootPassword `
+        -Type 'master'
+    $operations = Initialize-VcfInstallerVcfOperationsSpec `
+        -Nodes @($operationsNode) `
+        -AdminUserPassword $requirements.appliances.vcfOperations.adminPassword `
+        -ApplianceSize $requirements.appliances.vcfOperations.applianceSize `
+        -UseExistingDeployment $false `
+        -Version $requirements.appliances.vcfOperations.version
+    $managementNetwork = $requirements.networks | Where-Object networkType -EQ 'VM_MANAGEMENT'
+    $managementComponentNetwork = Initialize-VcfInstallerVcfManagementComponentsNetworkSpec `
+        -NetworkName $managementNetwork.portGroupKey `
+        -SubnetMask $managementNetwork.subnetMask `
+        -Gateway $managementNetwork.gateway
+    $managementInfrastructure = Initialize-VcfInstallerVcfManagementComponentsInfrastructureSpec `
+        -LocalRegionNetwork $managementComponentNetwork
+
+    $sddcSpec = Initialize-VcfInstallerSddcSpec `
+        -SddcId $requirements.sddcId `
+        -WorkflowType $requirements.workflowType `
+        -HostSpecs @($hosts) `
+        -Version $requirements.targetRelease `
+        -VcenterSpec $vcenter `
+        -ClusterSpec $cluster `
+        -DvsSpecs @($dvsSpecs) `
+        -NsxtSpec $nsx `
+        -NetworkSpecs @($networkSpecs) `
+        -DnsSpec $dns `
+        -NtpServers @($requirements.ntpServers) `
+        -SddcManagerSpec $sddcManager `
+        -ManagementPoolName $requirements.naming.managementPoolName `
+        -CeipEnabled $false `
+        -SkipEsxThumbprintValidation $false `
+        -SkipGatewayPingValidation $false `
+        -DatastoreSpec $datastore `
+        -VcfOperationsSpec $operations `
+        -VcfManagementComponentsInfrastructureSpec $managementInfrastructure `
+        -LicenseServerSpec $licenseServer `
+        -VcfInstanceName $requirements.vcfInstanceName
+
+    New-Item -ItemType Directory -Path $OutputDirectory -Force | Out-Null
+    $sddcPath = Join-Path $OutputDirectory 'sddc-spec.json'
+    $decisionPath = Join-Path $OutputDirectory 'architecture-decision.json'
+    Write-VcfJson -Value $sddcSpec -Path $sddcPath -SdkJson
+    Write-VcfJson -Value $decision -Path $decisionPath
+
+    [pscustomobject]@{
+        SddcSpecPath = [System.IO.Path]::GetFullPath($sddcPath)
+        ArchitectureDecisionPath = [System.IO.Path]::GetFullPath($decisionPath)
+        SddcSpec = $sddcSpec
+    }
+}
+
+function New-VcfEstateMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $InventoryPath,
+
+        [Parameter(Mandatory)]
+        [string] $CompatibilitySnapshotPath,
+
+        [Parameter(Mandatory)]
+        [string] $OutputPath
+    )
+
+    $inventory = Read-VcfJson -Path $InventoryPath
+    $snapshot = Read-VcfJson -Path $CompatibilitySnapshotPath
+    $components = @{}
+    foreach ($component in $inventory.components) {
+        $components[[string]$component.componentId] = $component
+    }
+
+    $order = 0
+    $steps = foreach ($rule in $snapshot.migration.steps) {
+        $order++
+        $component = $components[[string]$rule.componentId]
+        if (-not $component) {
+            throw "Migration rule references missing component $($rule.componentId)."
+        }
+        [pscustomobject][ordered]@{
+            order = $order
+            componentId = [string]$component.componentId
+            componentName = [string]$component.componentName
+            currentVersion = [string]$component.version
+            targetVersion = [string]$rule.targetVersion
+            action = [string]$rule.action
+            gatedBy = @($rule.gatedBy)
+        }
+    }
+    if (@($steps).Count -ne @($inventory.components).Count) {
+        throw 'The pinned migration sequence must name every inventory component exactly once.'
+    }
+
+    $plan = [pscustomobject][ordered]@{
+        estateId = [string]$inventory.estateId
+        targetRelease = [string]$snapshot.migration.targetRelease
+        steps = @($steps)
+    }
+    Write-VcfJson -Value $plan -Path $OutputPath
+    return [System.IO.Path]::GetFullPath($OutputPath)
+}
+
+function Invoke-VcfInstallerSpecValidation {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory, ValueFromPipeline)]
+        [object] $SddcSpec,
+
+        [object[]] $Server
+    )
+
+    process {
+        if ($SddcSpec.GetType().FullName -ne 'VMware.Bindings.Vcf.Installer.Model.SddcSpec') {
+            throw 'SddcSpec must be a VMware.Sdk.Vcf.Installer SddcSpec model returned by New-VcfGreenfieldArchitecture.'
+        }
+        if ($PSBoundParameters.ContainsKey('Server')) {
+            Invoke-VcfInstallerValidateSddcSpec -SddcSpec $SddcSpec -Server $Server
+        }
+        else {
+            Invoke-VcfInstallerValidateSddcSpec -SddcSpec $SddcSpec
+        }
+    }
+}
+
+Export-ModuleMember -Function @(
+    'New-VcfGreenfieldArchitecture',
+    'New-VcfEstateMigrationPlan',
+    'Invoke-VcfInstallerSpecValidation'
+)

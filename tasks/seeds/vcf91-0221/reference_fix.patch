+function ConvertFrom-VcfSecureString {
+    [CmdletBinding()]
+    [OutputType([string])]
+    param(
+        [Parameter(Mandatory)]
+        [securestring] $Value
+    )
+
+    $pointer = [IntPtr]::Zero
+    try {
+        $pointer = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($Value)
+        return [Runtime.InteropServices.Marshal]::PtrToStringBSTR($pointer)
+    }
+    finally {
+        if ($pointer -ne [IntPtr]::Zero) {
+            [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($pointer)
+        }
+    }
+}
+
+function Invoke-VcfSddcLcmJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [uri] $Uri,
+
+        [Parameter(Mandatory)]
+        [ValidateSet('GET', 'POST')]
+        [string] $Method,
+
+        [Parameter(Mandatory)]
+        [System.Collections.IDictionary] $Headers,
+
+        [Parameter()]
+        [AllowNull()]
+        [string] $Body,
+
+        [Parameter(Mandatory)]
+        [int] $ExpectedStatus
+    )
+
+    $parameters = @{
+        Uri = $Uri
+        Method = $Method
+        Headers = $Headers
+        ErrorAction = 'Stop'
+    }
+    if ($PSBoundParameters.ContainsKey('Body')) {
+        $parameters.ContentType = 'application/json'
+        $parameters.Body = $Body
+    }
+
+    try {
+        $response = Invoke-WebRequest @parameters
+    }
+    catch {
+        throw [System.InvalidOperationException]::new(
+            "SDDC LCM $Method $($Uri.AbsolutePath) failed: $($_.Exception.Message)",
+            $_.Exception
+        )
+    }
+
+    if ([int] $response.StatusCode -ne $ExpectedStatus) {
+        throw [System.InvalidOperationException]::new(
+            "SDDC LCM $Method $($Uri.AbsolutePath) returned HTTP $($response.StatusCode); expected $ExpectedStatus."
+        )
+    }
+    if ([string]::IsNullOrWhiteSpace($response.Content)) {
+        throw [System.InvalidOperationException]::new(
+            "SDDC LCM $Method $($Uri.AbsolutePath) returned an empty response."
+        )
+    }
+
+    try {
+        return $response.Content | ConvertFrom-Json -ErrorAction Stop
+    }
+    catch {
+        throw [System.InvalidOperationException]::new(
+            "SDDC LCM $Method $($Uri.AbsolutePath) returned invalid JSON.",
+            $_.Exception
+        )
+    }
+}

{
  "contractVersion": 1,
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "path": "specifications/sddc-lcm/sddc-lcm-openapi.yaml",
    "openapiVersion": "3.0.4",
    "apiVersion": "9.1.0.0",
    "serverBasePath": "/sddc-lcm",
    "license": "Apache-2.0"
  },
  "security": {
    "name": "bearerToken",
    "type": "http",
    "scheme": "Bearer",
    "bearerFormat": "JWT"
  },
  "operations": [
    {
      "operationId": "setConfig",
      "method": "POST",
      "path": "/v1/config",
      "requestBody": {
        "required": false,
        "contentType": "application/json",
        "schema": "ConfigSpec"
      },
      "successResponse": {
        "status": 202,
        "schema": "Task"
      }
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{taskId}",
      "pathParameters": {
        "taskId": {
          "required": true,
          "type": "string",
          "format": "uuid"
        }
      },
      "successResponse": {
        "status": 200,
        "schema": "Task"
      }
    }
  ],
  "schemas": {
    "ConfigSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "sddcManager": "SddcManagerEndpoint",
        "vspCluster": "VspClusterEndpoint",
        "vcenter": "VcenterEndpoint",
        "fleetLcm": "FleetLcmEndpoint",
        "fqdn": "string"
      }
    },
    "SddcManagerEndpoint": {
      "type": "object",
      "required": [
        "fqdn",
        "password",
        "sslThumbprint",
        "username"
      ],
      "properties": {
        "fqdn": "string",
        "username": "string",
        "password": "string:password",
        "sslThumbprint": "string"
      }
    },
    "FleetLcmEndpoint": {
      "type": "object",
      "required": [
        "fqdn",
        "sslThumbprint"
      ],
      "properties": {
        "fqdn": "string",
        "username": "string",
        "password": "string:password",
        "opsToken": "string",
        "sslThumbprint": "string"
      }
    },
    "Task": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": "string",
        "status": "TaskStatus"
      }
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "SCHEDULED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELED"
      ]
    }
  }
}

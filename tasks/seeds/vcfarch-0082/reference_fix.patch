+"""Command-line entry point for the VCF architecture planner."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+from .planner import PlanningError, build_architecture
+
+
+def parser() -> argparse.ArgumentParser:
+    command = argparse.ArgumentParser(description="Build a pinned VCF brownfield architecture")
+    command.add_argument("--inventory", required=True, type=Path)
+    command.add_argument("--compatibility", required=True, type=Path)
+    command.add_argument("--output", required=True, type=Path)
+    return command
+
+
+def load_json(path: Path) -> dict[str, object]:
+    with path.open("r", encoding="utf-8") as handle:
+        value = json.load(handle)
+    if not isinstance(value, dict):
+        raise PlanningError(f"{path} must contain a JSON object")
+    return value
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = parser().parse_args(argv)
+    try:
+        architecture = build_architecture(load_json(args.inventory), load_json(args.compatibility))
+        rendered = json.dumps(architecture, indent=2, sort_keys=True) + "\n"
+        args.output.write_text(rendered, encoding="utf-8")
+    except (OSError, json.JSONDecodeError, KeyError, TypeError, ValueError, PlanningError) as exc:
+        print(f"vcf-architecture: {exc}", file=sys.stderr)
+        return 2
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/vcf_architecture/planner.py b/vcf_architecture/planner.py
new file mode 100644
index 0000000..be15b54
--- /dev/null
+++ b/vcf_architecture/planner.py
@@ -0,0 +1,193 @@
+"""Build the target SddcSpec and its ordered migration plan from pinned data."""
+
+from __future__ import annotations
+
+import copy
+import ipaddress
+from collections import deque
+from typing import Any
+
+
+class PlanningError(ValueError):
+    """Raised when the supplied inventory has no compatible architecture."""
+
+
+def component_index(inventory: dict[str, Any]) -> dict[str, dict[str, Any]]:
+    components = inventory["components"]
+    indexed = {item["id"]: item for item in components}
+    if len(indexed) != len(components):
+        raise PlanningError("inventory component ids must be unique")
+    return indexed
+
+
+def supported_path(source: str, target: str, snapshot: dict[str, Any]) -> list[str]:
+    graph: dict[str, set[str]] = {}
+    for edge in snapshot["supportedUpgradeEdges"]:
+        graph.setdefault(edge["source"], set()).add(edge["target"])
+    queue: deque[list[str]] = deque([[source]])
+    visited = {source}
+    while queue:
+        path = queue.popleft()
+        if path[-1] == target:
+            return path
+        for neighbor in sorted(graph.get(path[-1], set())):
+            if neighbor not in visited:
+                visited.add(neighbor)
+                queue.append([*path, neighbor])
+    raise PlanningError(f"no supported upgrade path from {source} to {target}")
+
+
+def select_topology(inventory: dict[str, Any], snapshot: dict[str, Any]) -> dict[str, Any]:
+    maximum = inventory["entitlement"]["maxActiveVcfInstances"]
+    supported = [option for option in snapshot["topologyOptions"] if option["supported"]]
+    feasible = [option for option in supported if option["requiredActiveVcfInstances"] <= maximum]
+    if not feasible:
+        raise PlanningError("the entitlement permits no supported topology")
+    selected = min(feasible, key=lambda option: (option["requiredActiveVcfInstances"], option["id"]))
+    excluded = [
+        {
+            "id": option["id"],
+            "reasonCode": "ENTITLEMENT_MAX_ACTIVE_VCF_INSTANCES",
+        }
+        for option in sorted(supported, key=lambda item: item["id"])
+        if option["requiredActiveVcfInstances"] > maximum
+    ]
+    return {
+        "selected": selected["id"],
+        "activeVcfInstancesDuringMigration": selected["requiredActiveVcfInstances"],
+        "entitlementMaxActiveVcfInstances": maximum,
+        "excludedTopologies": excluded,
+    }
+
+
+def check_management_services_network(inventory: dict[str, Any], snapshot: dict[str, Any]) -> None:
+    service = inventory["managementServices"]
+    constraints = snapshot["managementServicesConstraints"]
+    start = ipaddress.ip_address(service["availableIpRange"]["start"])
+    end = ipaddress.ip_address(service["availableIpRange"]["end"])
+    if int(end) < int(start) or int(end) - int(start) + 1 < constraints["minimumAvailableIps"]:
+        raise PlanningError("management services IP range is too small")
+    networks = inventory["networks"]
+    if sum(item["networkType"] == constraints["allowedNetworkType"] for item in networks) != 1:
+        raise PlanningError("the required management services network is not unique")
+    if constraints["internalCidrMustNotOverlapEstateNetworks"]:
+        internal = ipaddress.ip_network(service["internalCidr"])
+        if any(internal.overlaps(ipaddress.ip_network(item["subnet"])) for item in networks):
+            raise PlanningError("management services internal CIDR overlaps an estate network")
+
+
+def build_steps(inventory: dict[str, Any], snapshot: dict[str, Any]) -> list[dict[str, Any]]:
+    current = component_index(inventory)
+    targets = snapshot["targetComponents"]
+    target_ids = {item["id"] for item in targets}
+    missing = set(current) - target_ids
+    if missing:
+        raise PlanningError(f"target snapshot omits inventory components: {sorted(missing)}")
+    known_gates = set(snapshot["gates"])
+    completed: set[str] = set()
+    steps: list[dict[str, Any]] = []
+    for sequence, target in enumerate(targets, 1):
+        component_id = target["id"]
+        if not set(target["dependsOn"]).issubset(completed):
+            raise PlanningError(f"dependencies for {component_id} are not ordered")
+        if not set(target["gateIds"]).issubset(known_gates):
+            raise PlanningError(f"unknown compatibility gate for {component_id}")
+        if component_id in current and current[component_id]["version"] != target["sourceVersion"]:
+            raise PlanningError(f"snapshot source version mismatch for {component_id}")
+        if component_id not in current and target["sourceVersion"] != "not-installed":
+            raise PlanningError(f"new component {component_id} needs a not-installed source")
+        steps.append(
+            {
+                "sequence": sequence,
+                "componentId": component_id,
+                "componentName": target["name"],
+                "scope": target["scope"],
+                "sourceVersion": target["sourceVersion"],
+                "targetVersion": target["targetVersion"],
+                "action": target["action"],
+                "dependsOn": copy.deepcopy(target["dependsOn"]),
+                "gateIds": copy.deepcopy(target["gateIds"]),
+            }
+        )
+        completed.add(component_id)
+    return steps
+
+
+def build_architecture(inventory: dict[str, Any], snapshot: dict[str, Any]) -> dict[str, Any]:
+    source = inventory["estate"]["vcfVersion"]
+    target = inventory["entitlement"]["targetVersion"]
+    if source != snapshot["sourceVcfVersion"] or target != snapshot["targetVcfVersion"]:
+        raise PlanningError("inventory releases do not match the pinned compatibility snapshot")
+    check_management_services_network(inventory, snapshot)
+    components = component_index(inventory)
+    versions = snapshot["targetSpecVersions"]
+    management_version = versions["managementServices"]
+
+    architecture = {
+        "sddcId": inventory["estate"]["sddcId"],
+        "workflowType": "VCF_COMPLETE",
+        "version": target,
+        "vcenterSpec": {
+            "vcenterHostname": components["mgmt-vcenter"]["hostname"],
+            "rootVcenterPassword": inventory["credentialPlaceholders"]["vcenterRoot"],
+            "version": versions["vcenter"],
+            "useExistingDeployment": True,
+        },
+        "clusterSpec": copy.deepcopy(inventory["cluster"]),
+        "hostSpecs": [{"hostname": item} for item in components["mgmt-esxi"]["hostnames"]],
+        "nsxtSpec": {
+            "nsxtManagers": [
+                {"hostname": item} for item in components["shared-nsx"]["managerHostnames"]
+            ],
+            "vipFqdn": components["shared-nsx"]["vipFqdn"],
+            "version": versions["nsx"],
+            "useExistingDeployment": True,
+        },
+        "networkSpecs": copy.deepcopy(inventory["networks"]),
+        "dnsSpec": copy.deepcopy(inventory["dns"]),
+        "ntpServers": copy.deepcopy(inventory["ntpServers"]),
+        "sddcManagerSpec": {
+            "hostname": components["sddc-manager"]["hostname"],
+            "version": versions["sddcManager"],
+            "useExistingDeployment": True,
+        },
+        "managementPoolName": inventory["targetNames"]["managementPoolName"],
+        "ceipEnabled": False,
+        "skipEsxThumbprintValidation": False,
+        "skipGatewayPingValidation": False,
+        "securitySpec": {"esxiCertsMode": "VMCA"},
+        "fleetLcmSpec": {"version": management_version, "size": "small"},
+        "sddcLcmSpec": {"version": management_version, "size": "small"},
+        "fleetDepotSpec": {"version": management_version, "size": "small"},
+        "telemetryAcceptorSpec": {"version": management_version, "size": "small"},
+        "saltSpec": {"version": management_version, "size": "small"},
+        "saltRaasSpec": {"version": management_version, "size": "small"},
+        "vcfOperationsSpec": {
+            "nodes": [{"hostname": components["vcf-operations"]["hostname"], "type": "master"}],
+            "useExistingDeployment": True,
+            "version": versions["vcfOperations"],
+        },
+        "vcfManagementComponentsInfrastructureSpec": {
+            "localRegionNetwork": {
+                "networkName": inventory["managementServices"]["networkName"],
+                "subnetMask": inventory["managementServices"]["subnetMask"],
+                "gateway": inventory["managementServices"]["gateway"],
+            }
+        },
+        "licenseServerSpec": {
+            "hostname": inventory["targetNames"]["licenseServerHostname"],
+            "version": versions["licenseServer"],
+            "useExistingDeployment": False,
+        },
+        "vcfInstanceName": inventory["estate"]["vcfInstanceName"],
+    }
+    architecture["migrationPlan"] = {
+        "inventoryRevision": inventory["revision"],
+        "compatibilitySnapshot": snapshot["snapshotId"],
+        "sourceVersion": source,
+        "targetVersion": target,
+        "upgradePath": supported_path(source, target, snapshot),
+        "topology": select_topology(inventory, snapshot),
+        "steps": build_steps(inventory, snapshot),
+    }
+    return architecture

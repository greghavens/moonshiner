{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0082:migration-plan",
  "title": "Pinned VCF brownfield migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inventoryRevision",
    "compatibilitySnapshot",
    "sourceVersion",
    "targetVersion",
    "upgradePath",
    "topology",
    "steps"
  ],
  "properties": {
    "inventoryRevision": {
      "type": "string",
      "minLength": 1
    },
    "compatibilitySnapshot": {
      "type": "string",
      "minLength": 1
    },
    "sourceVersion": {
      "type": "string",
      "minLength": 1
    },
    "targetVersion": {
      "type": "string",
      "minLength": 1
    },
    "upgradePath": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected",
        "activeVcfInstancesDuringMigration",
        "entitlementMaxActiveVcfInstances",
        "excludedTopologies"
      ],
      "properties": {
        "selected": {
          "type": "string",
          "minLength": 1
        },
        "activeVcfInstancesDuringMigration": {
          "type": "integer",
          "minimum": 1
        },
        "entitlementMaxActiveVcfInstances": {
          "type": "integer",
          "minimum": 1
        },
        "excludedTopologies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "reasonCode"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "reasonCode": {
                "const": "ENTITLEMENT_MAX_ACTIVE_VCF_INSTANCES"
              }
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "componentId",
          "componentName",
          "scope",
          "sourceVersion",
          "targetVersion",
          "action",
          "dependsOn",
          "gateIds"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "componentName": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "sourceVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "deploy",
              "upgrade"
            ]
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "gateIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

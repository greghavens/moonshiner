diff --git a/VcfAutomation.Integrations/VcfAutomation.Integrations.psm1 b/VcfAutomation.Integrations/VcfAutomation.Integrations.psm1
--- a/VcfAutomation.Integrations/VcfAutomation.Integrations.psm1
+++ b/VcfAutomation.Integrations/VcfAutomation.Integrations.psm1
@@ -28,7 +28,69 @@ function New-VcfAutomationIntegration {
         [int] $PollIntervalMilliseconds = 1000
     )
 
-    throw 'New-VcfAutomationIntegration is not implemented.'
+    $baseUri = $Server.AbsoluteUri.TrimEnd('/')
+    $encodedVersion = [uri]::EscapeDataString($ApiVersion)
+    $createUri = "$baseUri/iaas/api/integrations?apiVersion=$encodedVersion"
+    if ($PSBoundParameters.ContainsKey('ValidateOnly')) {
+        $validateOnlyText = $ValidateOnly.ToString().ToLowerInvariant()
+        $createUri += "&validateOnly=$validateOnlyText"
+    }
+
+    $headers = @{
+        Authorization = "Bearer $AccessToken"
+        Accept = 'application/json'
+    }
+    $body = [ordered]@{
+        name = $Name
+        integrationType = $IntegrationType
+        integrationProperties = $IntegrationProperties
+    }
+    if ($PSBoundParameters.ContainsKey('Description')) {
+        $body.description = $Description
+    }
+
+    $accepted = Invoke-RestMethod `
+        -Method Post `
+        -Uri $createUri `
+        -Headers $headers `
+        -ContentType 'application/json' `
+        -Body ($body | ConvertTo-Json -Depth 16 -Compress)
+
+    if (-not $accepted.id) {
+        throw 'VCF Automation did not return a request-tracker id.'
+    }
+
+    $requestId = [string] $accepted.id
+    $encodedRequestId = [uri]::EscapeDataString($requestId)
+    $trackerUri = "$baseUri/iaas/api/request-tracker/${encodedRequestId}?apiVersion=$encodedVersion"
+
+    while ($true) {
+        $tracker = Invoke-RestMethod -Method Get -Uri $trackerUri -Headers $headers
+        if (-not $tracker.status) {
+            throw "VCF Automation request '$requestId' returned a tracker without a status."
+        }
+
+        switch ([string] $tracker.status) {
+            'FINISHED' {
+                return $tracker
+            }
+            'FAILED' {
+                $messageProperty = $tracker.PSObject.Properties['message']
+                $message = if ($null -ne $messageProperty -and -not [string]::IsNullOrEmpty([string] $messageProperty.Value)) {
+                    [string] $messageProperty.Value
+                } else {
+                    'No server message.'
+                }
+                throw "VCF Automation integration request '$requestId' failed: $message"
+            }
+            'INPROGRESS' {
+                Start-Sleep -Milliseconds $PollIntervalMilliseconds
+            }
+            default {
+                throw "VCF Automation request '$requestId' returned unrecognized status '$($tracker.status)'."
+            }
+        }
+    }
 }
 
 Export-ModuleMember -Function New-VcfAutomationIntegration

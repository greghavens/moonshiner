{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch:migration-plan:1.0",
  "title": "VCF brownfield migration architecture",
  "type": "object",
  "required": [
    "schemaVersion",
    "estateId",
    "releasePath",
    "targetArchitecture",
    "migrationPlan",
    "researchConsulted"
  ],
  "properties": {
    "schemaVersion": {"type": "string", "const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "releasePath": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from", "to", "method"],
        "additionalProperties": false,
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1}
        }
      }
    },
    "targetArchitecture": {
      "type": "object",
      "required": ["siteCount", "topology", "hostCount", "sddcSpec"],
      "additionalProperties": false,
      "properties": {
        "siteCount": {"type": "integer", "minimum": 1},
        "topology": {"type": "string", "enum": ["CONSOLIDATED"]},
        "hostCount": {"type": "integer", "minimum": 1},
        "sddcSpec": {"type": "object"}
      }
    },
    "migrationPlan": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/migrationStep"}
    },
    "researchConsulted": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/researchSource"}
    }
  },
  "$defs": {
    "researchSource": {
      "type": "object",
      "required": ["title", "url", "consultedOn"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "consultedOn": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "migrationStep": {
      "type": "object",
      "required": [
        "order",
        "stepId",
        "componentId",
        "component",
        "fromVersion",
        "targetComponent",
        "toVersion",
        "action",
        "gates",
        "execution"
      ],
      "additionalProperties": false,
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "stepId": {"type": "string", "minLength": 1},
        "componentId": {"type": "string", "minLength": 1},
        "component": {"type": "string", "minLength": 1},
        "fromVersion": {"type": "string", "minLength": 1},
        "targetComponent": {"type": "string", "minLength": 1},
        "toVersion": {"type": "string", "minLength": 1},
        "action": {"type": "string", "enum": ["UPGRADE", "DEPLOY"]},
        "gates": {
          "type": "object",
          "required": ["requiresCompletedSteps", "preconditions"],
          "additionalProperties": false,
          "properties": {
            "requiresCompletedSteps": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "preconditions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "execution": {"type": "string", "minLength": 1},
        "minimumHostsOnline": {"type": "integer", "minimum": 1}
      }
    }
  }
}

+    <#
+        Single HTTP exchange. Returns the raw web response so the caller can act on the
+        status code itself; 401 is a control-flow signal here, not an error.
+    #>
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)] [string] $Method,
+        [Parameter(Mandatory)] [string] $Uri,
+        [Parameter(Mandatory)] [hashtable] $Headers,
+        [Parameter()] [AllowNull()] [string] $Body,
+        [Parameter()] [AllowNull()] [string] $ContentType,
+        [Parameter(Mandatory)] [int] $TimeoutSec
+    )
+
+    $call = @{
+        Method             = $Method
+        Uri                = $Uri
+        Headers            = $Headers
+        TimeoutSec         = $TimeoutSec
+        SkipHttpErrorCheck = $true
+        ErrorAction        = 'Stop'
+    }
+    if (-not [string]::IsNullOrEmpty($ContentType)) {
+        # Only a request that actually carries a body may declare a media type.

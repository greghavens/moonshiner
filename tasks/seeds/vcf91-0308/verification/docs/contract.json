{
  "contractFormat": "reference-derived-contract-v1",
  "product": "VCF Automation",
  "release": "VMware Cloud Foundation 9.1",
  "source": {
    "kind": "reference-documentation",
    "publisher": "Broadcom Developer Portal (developer.broadcom.com/xapis)",
    "documentationSets": [
      {
        "title": "Org Management - VM Apps Org",
        "slug": "org-management-vm-apps-org",
        "documentationVersion": "9.1(Latest)"
      },
      {
        "title": "VCF Automation API | VM Apps Org - Deployment",
        "slug": "vm-apps-org-deployment",
        "documentationVersion": "9.1(Latest)"
      }
    ],
    "notice": "THE SOURCE OF THIS CONTRACT IS REFERENCE DOCUMENTATION, NOT A PUBLISHED SPECIFICATION. VCF Automation has no specification in VMware's Apache-2.0 vmware/vcf-api-specs repository, and the Broadcom xAPIs pages for these operations publish no downloadable OpenAPI or Swagger document. Every operation, parameter, member and status code recorded below was transcribed by hand from the rendered reference pages enumerated in docs/official_sources.json. Where the reference documentation is silent, this contract says so explicitly rather than inventing a value.",
    "specificationAvailable": false,
    "machineReadableDocumentAvailable": false,
    "derivation": "hand transcription of rendered reference pages"
  },
  "authentication": {
    "documentedAt": "https://developer.broadcom.com/xapis/vm-apps-org-deployment/9.1/api-security-schema/",
    "name": "bearerAuth",
    "type": "http",
    "scheme": "bearer",
    "bearerFormat": "JWT",
    "header": "Authorization",
    "valuePrefix": "Bearer ",
    "appliesTo": ["getDeployments", "submitDeploymentActionRequest"],
    "absentFrom": ["getAccessToken"],
    "absentFromNote": "The reference page for the access-token operation documents only Content-Type and Accept. The API (refresh) token is the credential and travels in the form body, so no Authorization header is sent."
  },
  "operations": [
    {
      "operationId": "getAccessToken",
      "documentedTitle": "Obtaining a VCF Automation Access Token for VM Apps Tenant User",
      "method": "POST",
      "pathTemplate": "/tm/oauth/tenant/{tenant}/token",
      "documentedUri": "https://{{vcfaHostname}}/tm/oauth/tenant/{{vcfaTenant}}/token",
      "pathParameters": [
        { "name": "tenant", "required": true, "schema": { "type": "string" }, "note": "documented as the {{vcfaTenant}} template variable" }
      ],
      "parameters": [],
      "requestHeaders": [
        { "name": "Content-Type", "value": "application/x-www-form-urlencoded", "required": true },
        { "name": "Accept", "value": "application/json", "required": true }
      ],
      "requestBody": {
        "required": true,
        "contentType": "application/x-www-form-urlencoded",
        "documentedPayload": "grant_type=refresh_token&refresh_token={{vcfaAPIToken}}",
        "members": [
          { "name": "grant_type", "required": true, "schema": { "type": "string", "const": "refresh_token" } },
          { "name": "refresh_token", "required": true, "schema": { "type": "string" }, "note": "the API (refresh) token" }
        ],
        "memberOrder": ["grant_type", "refresh_token"]
      },
      "focusedWireProfile": {
        "formMembers": ["grant_type", "refresh_token"],
        "unsetMembers": [],
        "authorizationHeader": "absent",
        "encoding": "application/x-www-form-urlencoded; every character outside the unreserved set is percent-encoded, and a space is never encoded as '+'"
      },
      "responses": {
        "200": {
          "contentType": "application/json",
          "schema": "AccessTokenResponse",
          "documentedExample": { "access_token": "eyJhbGciOi...", "token_type": "Bearer", "expires_in": 3600 }
        }
      },
      "undocumented": {
        "failureStatusCodes": "The reference page documents only the 200 OK response for this operation.",
        "parameterRequirednessTable": "The reference page publishes the payload as a literal string; it has no required/optional table."
      }
    },
    {
      "operationId": "getDeployments",
      "documentedTitle": "Get Deployments",
      "documentedDescription": "Fetch all deployments. Returns a paginated list of deployments.",
      "documentedCategory": "Deployments",
      "method": "GET",
      "pathTemplate": "/deployment/api/deployments",
      "documentedUri": "https://{api_host}/deployment/api/deployments",
      "pathParameters": [],
      "requestBody": false,
      "requestHeaders": [
        { "name": "Authorization", "value": "Bearer {accessToken}", "required": true, "documentedBy": "the bearerAuth security scheme and the operation's curl sample" }
      ],
      "requestHeadersNote": "The curl sample on this reference page sends only Authorization. No Accept header and no versioned media type are documented for this operation, so this contract requires none.",
      "parameters": [
        { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "default": 0 }, "description": "Zero-based page index (0..N)" },
        { "name": "size", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "default": 20 }, "description": "The size of the page to be returned" },
        { "name": "sort", "in": "query", "required": false, "schema": { "type": "array", "items": { "type": "string" }, "default": "createdAt,DESC" } },
        { "name": "ids", "in": "query", "required": false, "schema": { "type": "array", "items": { "type": "string" } } },
        { "name": "search", "in": "query", "required": false, "schema": { "type": "string" } },
        { "name": "name", "in": "query", "required": false, "schema": { "type": "string" } },
        { "name": "status", "in": "query", "required": false, "schema": { "type": "array", "items": { "type": "string" } } },
        { "name": "projects", "in": "query", "required": false, "schema": { "type": "array", "items": { "type": "string" } } },
        { "name": "resourceTypes", "in": "query", "required": false, "schema": { "type": "array", "items": { "type": "string" } } },
        { "name": "cloudAccounts", "in": "query", "required": false, "schema": { "type": "array", "items": { "type": "string" } } },
        { "name": "cloudTypes", "in": "query", "required": false, "schema": { "type": "array", "items": { "type": "string" } } },
        { "name": "requestedBy", "in": "query", "required": false, "schema": { "type": "array", "items": { "type": "string" } } },
        { "name": "ownedBy", "in": "query", "required": false, "schema": { "type": "array", "items": { "type": "string" } } },
        { "name": "tags", "in": "query", "required": false, "schema": { "type": "array", "items": { "type": "string" } } },
        { "name": "createdAt", "in": "query", "required": false, "schema": { "type": "string" } },
        { "name": "expiresAt", "in": "query", "required": false, "schema": { "type": "string" } },
        { "name": "lastUpdatedAt", "in": "query", "required": false, "schema": { "type": "string" } },
        { "name": "expandResources", "in": "query", "required": false, "deprecated": true, "schema": { "type": "boolean" } },
        { "name": "expandLastRequest", "in": "query", "required": false, "deprecated": true, "schema": { "type": "boolean" } },
        { "name": "expandProject", "in": "query", "required": false, "deprecated": true, "schema": { "type": "boolean" } },
        { "name": "expand", "in": "query", "required": false, "schema": { "type": "array", "items": { "type": "string" } } },
        { "name": "lastRequestStatus", "in": "query", "required": false, "schema": { "type": "array", "items": { "type": "string", "enum": ["ABORTED", "APPROVAL_PENDING", "APPROVAL_REJECTED", "FAILED", "INPROGRESS", "PENDING", "SUCCESSFUL"] } } },
        { "name": "deleted", "in": "query", "required": false, "schema": { "type": "boolean" } },
        { "name": "$top", "in": "query", "required": false, "schema": { "type": "integer" } },
        { "name": "$skip", "in": "query", "required": false, "schema": { "type": "integer" } },
        { "name": "$orderby", "in": "query", "required": false, "schema": { "type": "string" } },
        { "name": "$filter", "in": "query", "required": false, "schema": { "type": "string" } }
      ],
      "focusedWireProfile": {
        "queryMembers": ["page", "size"],
        "queryMemberOrder": ["page", "size"],
        "explicitZero": ["page"],
        "explicitZeroNote": "page is sent explicitly on every request, including page 0, even though 0 is its documented default. An explicitly requested value is not an unset optional.",
        "unsetMembers": [
          "sort", "ids", "search", "name", "status", "projects", "resourceTypes",
          "cloudAccounts", "cloudTypes", "requestedBy", "ownedBy", "tags",
          "createdAt", "expiresAt", "lastUpdatedAt", "expandResources",
          "expandLastRequest", "expandProject", "expand", "lastRequestStatus",
          "deleted", "$top", "$skip", "$orderby", "$filter"
        ],
        "unsetBehavior": "omit",
        "unsetBehaviorNote": "Omitted means the member name never appears in the query string. Sending it blank, zero, false, null, empty, or as a bare delimiter is not omission.",
        "contentTypeHeader": "absent",
        "contentTypeHeaderNote": "getDeployments is a bodyless GET, so it carries no Content-Type header."
      },
      "responses": {
        "200": { "contentType": "application/json", "schema": "PageDeployment" },
        "401": { "contentType": "application/json", "schema": "Request", "note": "The reference page renders the 401 response with the same schema as the success response; it documents no distinct error envelope." }
      }
    },
    {
      "operationId": "submitDeploymentActionRequest",
      "documentedTitle": "Submit Deployment Action Request",
      "documentedDescription": "Deployment action request. Submit a deployment action request",
      "documentedCategory": "Requests",
      "method": "POST",
      "pathTemplate": "/deployment/api/deployments/{deploymentId}/requests",
      "documentedUri": "https://{api_host}/deployment/api/deployments/{deploymentId}/requests",
      "pathParameters": [
        { "name": "deploymentId", "required": true, "schema": { "type": "string" }, "description": "Deployment ID" }
      ],
      "parameters": [],
      "requestHeaders": [
        { "name": "Authorization", "value": "Bearer {accessToken}", "required": true, "documentedBy": "the bearerAuth security scheme and the operation's curl sample" },
        { "name": "Content-Type", "value": "application/json", "required": true, "documentedBy": "the operation's request body media type and curl sample" }
      ],
      "requestHeadersNote": "The curl sample on this reference page sends only Authorization and Content-Type. No Accept header and no versioned media type are documented for this operation, so this contract requires none.",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "ResourceActionRequest",
        "documentedExample": { "actionId": "string", "inputs": {}, "reason": "string" },
        "members": [
          { "name": "actionId", "required": false, "schema": { "type": "string" }, "description": "The id of the action to perform." },
          { "name": "inputs", "required": false, "schema": { "type": "object" }, "description": "inputs" },
          { "name": "reason", "required": false, "schema": { "type": "string" }, "description": "Reason for requesting a day2 operation" }
        ],
        "memberOrder": ["actionId", "inputs", "reason"],
        "note": "The reference page marks all three members Optional. There is no resourceIds or targetIds member on this body; targeting a single resource is a different operation."
      },
      "focusedWireProfile": {
        "bodyMemberOrder": ["actionId", "inputs", "reason"],
        "unsetBehavior": "omit",
        "unsetBehaviorNote": "An unset optional member is absent from the JSON object. Sending it as null, an empty string, or an empty object is not omission.",
        "serialization": "compact JSON with no insignificant whitespace",
        "serializationNote": "This matches the omission semantics of the VCF PowerCLI SDK model serializers, whose Initialize-Vcf* cmdlets build a request body client-side and emit only the members that were actually set."
      },
      "responses": {
        "200": { "contentType": "application/json", "schema": "Request" },
        "401": { "contentType": "application/json", "schema": "Request", "note": "Rendered with the success schema; no distinct error envelope is documented." },
        "403": { "contentType": "application/json", "schema": "Request" },
        "404": { "contentType": "application/json", "schema": "Request" },
        "409": { "contentType": "application/json", "schema": "Request" }
      }
    }
  ],
  "schemas": {
    "AccessTokenResponse": {
      "type": "object",
      "documentedFrom": "the literal 200 OK example on the Org Management reference page",
      "properties": {
        "access_token": { "type": "string" },
        "token_type": { "type": "string" },
        "expires_in": { "type": "integer" }
      },
      "note": "The reference page publishes an example, not a field table. No member is marked required or optional and no other member is shown."
    },
    "PageDeployment": {
      "type": "object",
      "allMembersOptional": true,
      "properties": {
        "content": { "type": "array", "items": { "$ref": "Deployment" } },
        "empty": { "type": "boolean" },
        "first": { "type": "boolean" },
        "last": { "type": "boolean" },
        "number": { "type": "integer", "format": "int32" },
        "numberOfElements": { "type": "integer", "format": "int32" },
        "pageable": { "type": "object" },
        "size": { "type": "integer", "format": "int32" },
        "sort": { "type": "object" },
        "totalElements": { "type": "integer", "format": "int64" },
        "totalPages": { "type": "integer", "format": "int32" }
      },
      "note": "There is no links member on this envelope."
    },
    "Deployment": {
      "type": "object",
      "documentedProperties": [
        "blueprintId", "blueprintVersion", "catalogItemId", "catalogItemVersion",
        "createdAt", "createdBy", "deleted", "description", "iconId", "id",
        "inprogressRequests", "inputs", "lastRequest", "lastUpdatedAt",
        "lastUpdatedBy", "leaseExpireAt", "leaseGracePeriodDays", "name",
        "orgId", "outputs", "ownedBy", "ownerType", "projectId", "resources", "status"
      ],
      "note": "Only the members this contract's operations rely on are pinned below; the reference page documents a larger object."
    },
    "Request": {
      "type": "object",
      "properties": {
        "actionId": { "type": "string", "required": false, "description": "Identifier of the requested action" },
        "completedTasks": { "type": "integer", "format": "int32", "required": true },
        "createdAt": { "type": "string", "format": "date-time", "required": true },
        "deploymentId": { "type": "string", "format": "uuid", "required": false },
        "id": { "type": "string", "format": "uuid", "required": false, "description": "Request identifier" },
        "inputs": { "type": "object", "required": false },
        "name": { "type": "string", "required": true },
        "outputs": { "type": "object", "required": false },
        "requestedBy": { "type": "string", "required": true },
        "resourceIds": { "type": "array", "items": { "type": "string" }, "required": false },
        "status": {
          "type": "string",
          "required": false,
          "description": "Request overall execution status.",
          "enum": [
            "CREATED", "PENDING", "INITIALIZATION", "CHECKING_APPROVAL",
            "APPROVAL_PENDING", "USER_INTERACTION_PENDING", "INPROGRESS",
            "COMPLETION", "APPROVAL_REJECTED", "ABORTED", "SUCCESSFUL", "FAILED"
          ]
        },
        "totalTasks": { "type": "integer", "format": "int32", "required": true },
        "updatedAt": { "type": "string", "format": "date-time", "required": false }
      },
      "note": "The reference page also documents approvedAt, blueprintId, cancelable, catalogItemId, completedAt, details, dismissed, estimatedCompletionTime, initializedAt and resources."
    }
  }
}

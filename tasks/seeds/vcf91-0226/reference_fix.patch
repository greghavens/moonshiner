+    if not isinstance(contract, dict):
+        raise ValueError("contract must be a JSON object: %s" % resolved)
+
+    operations = contract.get("operations")
+    if not isinstance(operations, dict):
+        raise ValueError("contract has no 'operations' object: %s" % resolved)
+
+    missing = [name for name in REQUIRED_OPERATION_IDS if name not in operations]
+    if missing:
+        raise ValueError(

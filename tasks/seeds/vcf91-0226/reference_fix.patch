+            if entry.get(field) in (None, ""):
+                raise ValueError("operation %s has no %s" % (name, field))
+
+    statuses = contract.get("task_status")
+    if not isinstance(statuses, dict) or not statuses.get("terminal"):
+        raise ValueError("contract has no terminal task statuses: %s" % resolved)
+
+    return contract
 
 

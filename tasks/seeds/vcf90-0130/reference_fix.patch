 Set-StrictMode -Version Latest
 
+function Invoke-ContractRequest {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [System.Net.Http.HttpClient] $Client,
+
+        [Parameter(Mandatory)]
+        [System.Net.Http.HttpMethod] $Method,
+
+        [Parameter(Mandatory)]
+        [uri] $Uri,
+
+        [Parameter()]
+        [AllowNull()]
+        [string] $JsonBody
+    )
+
+    $request = [System.Net.Http.HttpRequestMessage]::new($Method, $Uri)
+    if ($PSBoundParameters.ContainsKey('JsonBody')) {
+        $request.Content = [System.Net.Http.StringContent]::new(
+            $JsonBody,
+            [System.Text.Encoding]::UTF8,
+            'application/json'
+        )
+    }
+
+    $response = $null
+    try {
+        $response = $Client.SendAsync($request).GetAwaiter().GetResult()
+        $responseText = $response.Content.ReadAsStringAsync().GetAwaiter().GetResult()
+        $status = [int] $response.StatusCode
+
+        if ($response.IsSuccessStatusCode) {
+            return [pscustomobject]@{
+                Succeeded  = $true
+                HttpStatus = $status
+                ErrorCode  = $null
+                Message    = $null
+            }
+        }
+
+        $errorCode = $null
+        $message = $response.ReasonPhrase
+        if (-not [string]::IsNullOrWhiteSpace($responseText)) {
+            try {
+                $errorBody = $responseText | ConvertFrom-Json -ErrorAction Stop
+                if ($null -ne $errorBody.PSObject.Properties['code']) {
+                    $errorCode = [string] $errorBody.code
+                }
+                if ($null -ne $errorBody.PSObject.Properties['message']) {
+                    $message = [string] $errorBody.message
+                }
+            }
+            catch {
+                $message = $responseText
+            }
+        }
+
+        return [pscustomobject]@{
+            Succeeded  = $false
+            HttpStatus = $status
+            ErrorCode  = $errorCode
+            Message    = $message
+        }
+    }
+    catch {
+        return [pscustomobject]@{
+            Succeeded  = $false
+            HttpStatus = $null
+            ErrorCode  = 'REQUEST_FAILED'
+            Message    = $_.Exception.Message
+        }
+    }
+    finally {
+        if ($null -ne $response) {
+            $response.Dispose()
+        }
+        $request.Dispose()
+    }
+}

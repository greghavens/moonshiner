+#!/usr/bin/env python3
+"""Reference proof that exercises the genuine calendar executable."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "calendarctl"
+DELIVERABLE = ROOT / "cancellation-report.md"
+TARGET_ID = "cal-181"
+REASON = "no longer needed for the scheduled work."
+
+
+def invoke(*arguments: str) -> tuple[int, dict[str, Any]]:
+    completed = subprocess.run(
+        [str(CLIENT), *arguments],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=5,
+    )
+    payload = completed.stdout if completed.returncode == 0 else completed.stderr
+    try:
+        result: Any = json.loads(payload)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("calendarctl returned invalid JSON") from error
+    if not isinstance(result, dict):
+        raise RuntimeError("calendarctl returned a non-object response")
+    return completed.returncode, result
+
+
+def main() -> int:
+    subprocess.run([str(CLIENT), "--help"], cwd=ROOT, check=True, timeout=5)
+    cancel_code, cancel_result = invoke(
+        "cancel", "--id", TARGET_ID, "--reason", REASON
+    )
+    if (
+        cancel_code == 0
+        or cancel_result.get("error") != "request_timed_out"
+        or cancel_result.get("commit_state") != "unknown"
+    ):
+        raise RuntimeError("reference cancellation did not produce uncertain state")
+
+    get_code, retrieved = invoke("get", "--id", TARGET_ID)
+    retry_performed = False
+    if get_code != 0:
+        raise RuntimeError("reference exact-ID verification failed")
+
+    retrieved_status = retrieved.get("status")
+    if retrieved_status == "active":
+        retry_performed = True
+        retry_code, _ = invoke(
+            "cancel", "--id", TARGET_ID, "--reason", REASON
+        )
+        if retry_code != 0:
+            final = dict(retrieved)
+            final["status"] = "unknown"
+        else:
+            final_get_code, final = invoke("get", "--id", TARGET_ID)
+            if final_get_code != 0:
+                final = dict(retrieved)
+                final["status"] = "unknown"
+    elif retrieved_status in ("cancelled", "cancellation-pending"):
+        final = retrieved
+    else:
+        final = dict(retrieved)
+        final["status"] = "unknown"
+
+    if final.get("status") != "cancelled" or retry_performed:
+        raise RuntimeError("reference recovery did not resolve the committed cancellation")
+    report = (
+        f"- Meeting: {final['name']} ({final['id']})\n"
+        f"- Verified status: {final['status']}\n"
+        f"- Retry performed: {'yes' if retry_performed else 'no'}\n"
+    )
+    DELIVERABLE.write_text(report, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

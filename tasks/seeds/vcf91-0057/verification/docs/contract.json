{
  "contractVersion": 1,
  "title": "VCF 9.1 NSX Policy focused segment realization contract",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commitSha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "specPath": "specifications/nsx/openapi-2.0/nsx_policy_api.yaml",
    "license": "Apache-2.0",
    "swagger": "2.0",
    "basePath": "/policy/api/v1"
  },
  "operations": [
    {
      "operationId": "ListAllInfraSegments",
      "method": "GET",
      "specPathItem": "/infra/segments",
      "path": "/policy/api/v1/infra/segments",
      "queryParameters": [
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "include_mark_for_delete_objects",
          "in": "query",
          "required": false,
          "type": "boolean",
          "default": false
        },
        {
          "name": "included_fields",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "page_size",
          "in": "query",
          "required": false,
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "default": 1000
        },
        {
          "name": "segment_type",
          "in": "query",
          "required": false,
          "type": "string",
          "enum": [
            "DVPortgroup",
            "ALL"
          ]
        },
        {
          "name": "sort_ascending",
          "in": "query",
          "required": false,
          "type": "boolean"
        },
        {
          "name": "sort_by",
          "in": "query",
          "required": false,
          "type": "string"
        }
      ],
      "responses": {
        "200": {
          "schema": "SegmentListResult",
          "required": [
            "results"
          ],
          "properties": {
            "cursor": {
              "type": "string",
              "readOnly": true
            },
            "result_count": {
              "type": "integer",
              "readOnly": true
            },
            "results": {
              "type": "array",
              "items": "Segment"
            },
            "sort_ascending": {
              "type": "boolean",
              "readOnly": true
            },
            "sort_by": {
              "type": "string",
              "readOnly": true
            }
          }
        }
      }
    },
    {
      "operationId": "PatchInfraSegment",
      "method": "PATCH",
      "specPathItem": "/infra/segments/{segment-id}",
      "path": "/policy/api/v1/infra/segments/{segment-id}",
      "pathParameters": [
        {
          "name": "segment-id",
          "in": "path",
          "required": true,
          "type": "string"
        }
      ],
      "body": {
        "required": true,
        "schema": "Segment",
        "relevantProperties": {
          "resource_type": {
            "type": "string",
            "enum": [
              "Segment"
            ]
          },
          "id": {
            "type": "string"
          },
          "display_name": {
            "type": "string",
            "maxLength": 255
          },
          "connectivity_path": {
            "type": "string"
          },
          "transport_zone_path": {
            "type": "string"
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK"
        }
      }
    },
    {
      "operationId": "ReadIntentStatus",
      "method": "GET",
      "specPathItem": "/infra/realized-state/status",
      "path": "/policy/api/v1/infra/realized-state/status",
      "queryParameters": [
        {
          "name": "include_enforced_status",
          "in": "query",
          "required": false,
          "type": "boolean",
          "default": false
        },
        {
          "name": "intent_path",
          "in": "query",
          "required": true,
          "type": "string"
        },
        {
          "name": "site_path",
          "in": "query",
          "required": false,
          "type": "string"
        }
      ],
      "responses": {
        "200": {
          "schema": "ConsolidatedRealizedStatus",
          "properties": {
            "consolidated_status": {
              "schema": "ConsolidatedStatus",
              "properties": {
                "consolidated_status": {
                  "schema": "ConfigState",
                  "type": "string",
                  "enum": [
                    "SUCCESS",
                    "IN_PROGRESS",
                    "ERROR",
                    "UNKNOWN",
                    "UNINITIALIZED",
                    "SANDBOXED_REALIZATION_PENDING"
                  ]
                }
              }
            },
            "intent_path": {
              "type": "string",
              "readOnly": true
            },
            "publish_status": {
              "type": "string",
              "enum": [
                "UNAVAILABLE",
                "UNREALIZED",
                "REALIZED",
                "ERROR"
              ]
            }
          }
        }
      }
    }
  ]
}

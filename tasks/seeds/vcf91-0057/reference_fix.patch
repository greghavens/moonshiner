+    $intentPath = '/infra/segments/{0}' -f $SegmentId
+    $stopwatch = [System.Diagnostics.Stopwatch]::StartNew()
+    $pollCount = 0
+
+    while ($stopwatch.Elapsed.TotalSeconds -lt $TimeoutSeconds) {
+        $pollCount++
+        $status = Invoke-ReadIntentStatus `
+            -Server $Client.Connection `
+            -IntentPath $intentPath
+        if ($null -eq $status -or $null -eq $status.ConsolidatedStatus) {
+            throw 'ReadIntentStatus returned no consolidated status.'
+        }
+
+        $state = [string] $status.ConsolidatedStatus._ConsolidatedStatus
+        switch ($state) {

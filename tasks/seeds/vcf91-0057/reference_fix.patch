diff --git a/src/VcfNsxPolicy/VcfNsxPolicy.psm1 b/src/VcfNsxPolicy/VcfNsxPolicy.psm1
index 38ca7e7..4e6bbd2 100644
--- a/src/VcfNsxPolicy/VcfNsxPolicy.psm1
+++ b/src/VcfNsxPolicy/VcfNsxPolicy.psm1
@@ -7,9 +7,39 @@ function New-VcfNsxPolicyClient {
         [VMware.Sdk.Nsx.Policy.Types.NsxServer] $Connection
     )
 
-    throw [System.NotImplementedException]::new(
-        'Create the NSX Policy client from the authenticated PowerCLI connection.'
+    if (-not $Connection.IsConnected) {
+        throw 'The NSX Policy PowerCLI connection is not connected.'
+    }
+
+    [pscustomobject]@{
+        PSTypeName = 'VcfNsxPolicy.Client'
+        Connection = $Connection
+    }
+}
+
+function Assert-VcfNsxPolicyClient {
+    param(
+        [Parameter(Mandatory)]
+        [psobject] $Client
     )
+
+    if ($Client.PSObject.TypeNames -notcontains 'VcfNsxPolicy.Client') {
+        throw 'Client must be created by New-VcfNsxPolicyClient.'
+    }
+
+    $connectionProperty = $Client.PSObject.Properties['Connection']
+    if (
+        $null -eq $connectionProperty -or
+        $null -eq $connectionProperty.Value -or
+        $connectionProperty.Value -isnot
+            [VMware.Sdk.Nsx.Policy.Types.NsxServer]
+    ) {
+        throw 'Client does not contain an NSX Policy PowerCLI connection.'
+    }
+
+    if (-not $connectionProperty.Value.IsConnected) {
+        throw 'The NSX Policy PowerCLI connection is not connected.'
+    }
 }
 
 function Get-VcfNsxPolicySegment {
@@ -19,9 +49,43 @@ function Get-VcfNsxPolicySegment {
         [psobject] $Client
     )
 
-    throw [System.NotImplementedException]::new(
-        'Implement ListAllInfraSegments with pagination and local sorting.'
-    )
+    Assert-VcfNsxPolicyClient -Client $Client
+
+    $segments = [System.Collections.Generic.List[object]]::new()
+    $cursor = $null
+
+    do {
+        $parameters = @{
+            Server        = $Client.Connection
+            PageSize      = [uint64] 1000
+            SortBy        = 'display_name'
+            SortAscending = $true
+        }
+        if (-not [string]::IsNullOrEmpty($cursor)) {
+            $parameters.Cursor = $cursor
+        }
+
+        $page = Invoke-ListAllInfraSegments @parameters
+        if ($null -eq $page -or $null -eq $page.Results) {
+            throw 'ListAllInfraSegments returned no results collection.'
+        }
+
+        foreach ($segment in @($page.Results)) {
+            $segments.Add($segment)
+        }
+
+        $cursorProperty = $page.PSObject.Properties['Cursor']
+        $cursor = if ($null -ne $cursorProperty) {
+            [string] $cursorProperty.Value
+        }
+        else {
+            $null
+        }
+    } while (-not [string]::IsNullOrEmpty($cursor))
+
+    $segments | Sort-Object `
+        @{ Expression = { [string] $_.DisplayName }; Ascending = $true },
+        @{ Expression = { [string] $_.Id }; Ascending = $true }
 }
 
 function Set-VcfNsxPolicySegment {

  "gates": [
    {
      "id": "single-site-consolidated",
      "condition": "The target remains one site and one consolidated management domain."
    },
    {
      "id": "minimum-four-hosts",
      "condition": "Exactly four ESX hosts are retained in the management cluster, meeting the supported single-site vSAN floor."
    },
    {
      "id": "recovery-config-empty",
      "condition": "Live Site Recovery and vSphere Replication are unpaired with zero active replications, protection groups, and recovery plans."
    },
    {
      "id": "recovery-appliances-retired",
      "condition": "Both standalone 9.0.2 recovery appliances are unregistered and removed before the vCenter 9.1 transition."
    },
    {
      "id": "vcenter-at-8u3",
      "condition": "vCenter is at 8.0 U3 before VCF convergence with the existing NSX deployment."
    },
    {
      "id": "esx-at-8u3",
      "condition": "All four ESX hosts are at 8.0 U3 and remain managed by the upgraded vCenter before convergence."
    },
    {
      "id": "vsan-at-8u3-healthy",
      "condition": "The vSAN cluster is at 8.0 U3, reports healthy, and has no resynchronizing objects."
    },
    {
      "id": "nsx-at-4.2.1",
      "condition": "The existing NSX deployment is at 4.2.1 before it is converged into VCF."
    },
    {
      "id": "installer-spec-valid",
      "condition": "The conversion SddcSpec validates against the VCF Installer 9.1.0.0 SddcSpec schema."
    },
    {
      "id": "core-at-9.1",
      "condition": "vCenter, ESX, vSAN, and NSX are lifecycle-managed at 9.1.0.0 before Protection and Recovery is deployed."
    }
  ],

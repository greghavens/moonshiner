{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0102:migration-plan",
  "title": "VCF Brownfield Migration Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planVersion",
    "estateId",
    "target",
    "steps"
  ],
  "properties": {
    "planVersion": {
      "const": "1.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fleetVersion",
        "topology",
        "siteCount",
        "hostCount",
        "sddcId"
      ],
      "properties": {
        "fleetVersion": {
          "type": "string",
          "minLength": 1
        },
        "topology": {
          "const": "single-site-consolidated"
        },
        "siteCount": {
          "const": 1
        },
        "hostCount": {
          "type": "integer",
          "minimum": 1
        },
        "sddcId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "stepId",
          "componentId",
          "component",
          "sourceVersion",
          "targetProduct",
          "targetVersion",
          "action",
          "gates",
          "dependsOn"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "stepId": {
            "type": "string",
            "minLength": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "sourceVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetProduct": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "condition"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "condition": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

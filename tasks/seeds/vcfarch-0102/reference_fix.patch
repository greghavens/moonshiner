diff --git a/src/VcfFleetArchitecture/VcfFleetArchitecture.psm1 b/src/VcfFleetArchitecture/VcfFleetArchitecture.psm1
index 439cc64..29f38db 100644
--- a/src/VcfFleetArchitecture/VcfFleetArchitecture.psm1
+++ b/src/VcfFleetArchitecture/VcfFleetArchitecture.psm1
@@ -13,7 +13,190 @@ function New-VcfFleetArchitecture {
         [string] $OutputPath
     )
 
-    throw 'Not implemented.'
+    $inventoryFile = (Resolve-Path -LiteralPath $InventoryPath -ErrorAction Stop).Path
+    $snapshotFile = (Resolve-Path -LiteralPath $CompatibilitySnapshotPath -ErrorAction Stop).Path
+    $outputFile = [System.IO.Path]::GetFullPath($OutputPath)
+
+    $inventory = Get-Content -LiteralPath $inventoryFile -Raw -Encoding utf8 | ConvertFrom-Json -AsHashtable
+    $snapshot = Get-Content -LiteralPath $snapshotFile -Raw -Encoding utf8 | ConvertFrom-Json -AsHashtable
+
+    $rulesById = @{}
+    foreach ($rule in $snapshot.componentRules) {
+        $rulesById[$rule.componentId] = $rule
+    }
+
+    $hostSpecs = @(
+        foreach ($hostname in $inventory.topology.hosts) {
+            Initialize-VcfInstallerSddcHostSpec -Hostname $hostname
+        }
+    )
+
+    $networkSpecs = @(
+        foreach ($network in $inventory.installerInput.networks) {
+            Initialize-VcfInstallerSddcNetworkSpec `
+                -NetworkType $network.networkType `
+                -VlanId $network.vlanId `
+                -Subnet $network.subnet `
+                -Gateway $network.gateway `
+                -Mtu $network.mtu
+        }
+    )
+
+    $resourcePoolSpecs = @(
+        foreach ($pool in $inventory.installerInput.cluster.resourcePools) {
+            Initialize-VcfInstallerResourcePoolSpec -Name $pool.name -Type $pool.type
+        }
+    )
+
+    $nsxManagers = @(
+        foreach ($hostname in $inventory.installerInput.nsx.managers) {
+            Initialize-VcfInstallerNsxtManagerSpec -Hostname $hostname
+        }
+    )
+
+    $dnsSpec = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $inventory.installerInput.dns.subdomain `
+        -Nameservers $inventory.installerInput.dns.nameservers
+
+    $vcenterSpec = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname $inventory.installerInput.vcenter.hostname `
+        -RootVcenterPassword $inventory.installerInput.vcenter.rootPasswordReference `
+        -SsoDomain $inventory.installerInput.vcenter.ssoDomain `
+        -Version $rulesById['vcenter-01'].conversionReadyVersion `
+        -UseExistingDeployment $true
+
+    $clusterSpec = Initialize-VcfInstallerSddcClusterSpec `
+        -DatacenterName $inventory.installerInput.cluster.datacenterName `
+        -ClusterName $inventory.installerInput.cluster.clusterName `
+        -ResourcePoolSpecs $resourcePoolSpecs
+
+    $nsxtSpec = Initialize-VcfInstallerSddcNsxtSpec `
+        -NsxtManagers $nsxManagers `
+        -VipFqdn $inventory.installerInput.nsx.vipFqdn `
+        -TransportVlanId $inventory.installerInput.nsx.transportVlanId `
+        -Version $rulesById['nsx-01'].conversionReadyVersion `
+        -UseExistingDeployment $true
+
+    $datastoreSpec = Initialize-VcfInstallerSddcDatastoreSpec `
+        -ExistingDatastoreName $inventory.topology.storage.datastoreName
+
+    $sddcManagerSpec = Initialize-VcfInstallerSddcManagerSpec `
+        -Hostname $inventory.installerInput.sddcManagerHostname `
+        -Version $snapshot.targetRelease
+
+    $fleetLcmSpec = Initialize-VcfInstallerFleetLcmServiceSpec -Version $snapshot.targetRelease -Size small
+    $sddcLcmSpec = Initialize-VcfInstallerSddcLcmServiceSpec -Version $snapshot.targetRelease -Size small
+    $fleetDepotSpec = Initialize-VcfInstallerFleetDepotServiceSpec -Version $snapshot.targetRelease -Size small
+
+    $sddcSpec = Initialize-VcfInstallerSddcSpec `
+        -SddcId $inventory.installerInput.sddcId `
+        -WorkflowType VCF `
+        -HostSpecs $hostSpecs `
+        -Version $snapshot.targetRelease `
+        -VcenterSpec $vcenterSpec `
+        -ClusterSpec $clusterSpec `
+        -NsxtSpec $nsxtSpec `
+        -NetworkSpecs $networkSpecs `
+        -DnsSpec $dnsSpec `
+        -NtpServers $inventory.installerInput.ntpServers `
+        -SddcManagerSpec $sddcManagerSpec `
+        -ManagementPoolName CHI-MGMT-NP `
+        -DatastoreSpec $datastoreSpec `
+        -FleetLcmSpec $fleetLcmSpec `
+        -SddcLcmSpec $sddcLcmSpec `
+        -FleetDepotSpec $fleetDepotSpec `
+        -VcfInstanceName $inventory.installerInput.vcfInstanceName
+
+    $artifact = $sddcSpec.ToJson() | ConvertFrom-Json -AsHashtable
+    $sdkModule = Get-Module -Name VMware.Sdk.Vcf.Installer -ErrorAction Stop
+    $artifact.architecture = [ordered]@{
+        topology = $snapshot.topologyAuthority.design
+        siteCount = $snapshot.topologyAuthority.siteCount
+        managementDomain = [ordered]@{
+            hostCount = $snapshot.topologyAuthority.minimumHostCount
+            principalStorage = $snapshot.topologyAuthority.principalStorage
+            hosts = @($inventory.topology.hosts)
+            resourcePools = @($inventory.installerInput.cluster.resourcePools)
+        }
+        fleet = [ordered]@{
+            name = $inventory.installerInput.fleetName
+            instanceName = $inventory.installerInput.vcfInstanceName
+            targetVersion = $snapshot.targetRelease
+        }
+        generatedBy = [ordered]@{
+            module = $sdkModule.Name
+            moduleVersion = $sdkModule.Version.ToString()
+            model = 'SddcSpec'
+        }
+    }
+
+    $gatesById = @{}
+    foreach ($gate in $snapshot.gates) {
+        $gatesById[$gate.id] = $gate
+    }
+
+    $transitionsById = @{}
+    foreach ($rule in $snapshot.componentRules) {
+        foreach ($transition in $rule.transitions) {
+            $transitionsById[$transition.stepId] = [ordered]@{
+                rule = $rule
+                transition = $transition
+            }
+        }
+    }
+
+    $steps = @()
+    $sequence = 0
+    foreach ($stepId in $snapshot.orderedStepIds) {
+        $sequence++
+        $entry = $transitionsById[$stepId]
+        $rule = $entry.rule
+        $transition = $entry.transition
+        $stepGates = @(
+            foreach ($gateId in $transition.gates) {
+                [ordered]@{
+                    id = $gateId
+                    condition = $gatesById[$gateId].condition
+                }
+            }
+        )
+        $steps += [ordered]@{
+            sequence = $sequence
+            stepId = $transition.stepId
+            componentId = $rule.componentId
+            component = $rule.component
+            sourceVersion = $transition.sourceVersion
+            targetProduct = $transition.targetProduct
+            targetVersion = $transition.targetVersion
+            action = $transition.action
+            gates = $stepGates
+            dependsOn = @($transition.dependsOn)
+        }
+    }
+
+    $artifact.migrationPlan = [ordered]@{
+        planVersion = '1.0'
+        estateId = $inventory.estateId
+        target = [ordered]@{
+            fleetVersion = $snapshot.targetRelease
+            topology = $snapshot.topologyAuthority.design
+            siteCount = $snapshot.topologyAuthority.siteCount
+            hostCount = $snapshot.topologyAuthority.minimumHostCount
+            sddcId = $inventory.installerInput.sddcId
+        }
+        steps = $steps
+    }
+
+    $parent = [System.IO.Path]::GetDirectoryName($outputFile)
+    [void] [System.IO.Directory]::CreateDirectory($parent)
+    $json = $artifact | ConvertTo-Json -Depth 100
+    [System.IO.File]::WriteAllText(
+        $outputFile,
+        $json + [System.Environment]::NewLine,
+        [System.Text.UTF8Encoding]::new($false)
+    )
+
+    Get-Item -LiteralPath $outputFile
 }
 
 Export-ModuleMember -Function New-VcfFleetArchitecture

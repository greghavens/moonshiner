{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.net/schemas/vcf-migration-plan-1.0.json",
  "title": "VCF estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "estateId",
    "targetVcfVersion",
    "compatibilitySnapshotId",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetVcfVersion": {
      "type": "string",
      "minLength": 1
    },
    "compatibilitySnapshotId": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "componentId",
          "component",
          "currentVersion",
          "targetVersion",
          "action",
          "viaVersions",
          "gates"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "currentVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "PATCH",
              "UPGRADE",
              "INSTALL",
              "MIGRATE",
              "DECOMMISSION"
            ]
          },
          "viaVersions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

+"""Translate the pinned estate and compatibility facts into an ordered plan."""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+RESEARCH_CONSULTED = [
+    {
+        "accessedAt": "2026-08-14",
+        "title": "Broadcom Product Interoperability Matrix",
+        "url": "https://interopmatrix.broadcom.com/",
+    },
+    {
+        "accessedAt": "2026-08-14",
+        "title": "Broadcom Compatibility Guide",
+        "url": "https://compatibilityguide.broadcom.com/",
+    },
+    {
+        "accessedAt": "2026-08-14",
+        "title": "Upgrade Sequence and Related Issues for VMware Cloud Foundation and vSphere Foundation 9.1",
+        "url": "https://knowledge.broadcom.com/external/article/440630/",
+    },
+    {
+        "accessedAt": "2026-08-14",
+        "title": "Correlating VMware Cloud Foundation version with constituent product versions",
+        "url": "https://knowledge.broadcom.com/external/article/314608/",
+    },
+    {
+        "accessedAt": "2026-08-14",
+        "title": "Update Sequence for VCF 9.0 and Compatible VMware Products",
+        "url": "https://knowledge.broadcom.com/external/article/390634/",
+    },
+]
+
+
+def component_by_type(estate: dict[str, Any], component_type: str) -> dict[str, Any]:
+    return next(
+        component
+        for component in estate["components"]
+        if component["type"] == component_type
+    )
+
+
+def target_installer_spec(
+    estate: dict[str, Any], snapshot: dict[str, Any]
+) -> dict[str, Any]:
+    management = estate["managementDomain"]
+    vcenter = component_by_type(estate, "VCENTER_SERVER")
+    license_server = snapshot["introducedComponents"]["vcf-license-server-01"]
+    hosts = sorted(
+        (
+            component
+            for component in estate["components"]
+            if component["type"] == "ESXI_HOST"
+        ),
+        key=lambda component: component["id"],
+    )
+    return {
+        "clusterSpec": {
+            "clusterName": management["clusterId"],
+            "datacenterName": "chi-mgmt-datacenter-01",
+        },
+        "datastoreSpec": {"existingDatastoreName": "vsanDatastore"},
+        "dnsSpec": estate["dns"],
+        "hostSpecs": [{"hostname": host["hostname"]} for host in hosts],
+        "licenseServerSpec": {
+            "hostname": license_server["hostname"],
+            "useExistingDeployment": False,
+            "version": license_server["targetVersion"],
+        },
+        "networkSpecs": estate["networks"],
+        "sddcId": management["id"],
+        "skipEsxThumbprintValidation": False,
+        "vcenterSpec": {
+            "rootVcenterPassword": "REPLACE-AT-RUNTIME1!",
+            "useExistingDeployment": True,
+            "vcenterHostname": vcenter["fqdn"],
+            "version": estate["targetVersion"],
+        },
+        "version": estate["targetVersion"],
+        "workflowType": "VCF_COMPLETE",
+    }
+
+
+def target_architecture(estate: dict[str, Any]) -> dict[str, Any]:
+    management = estate["managementDomain"]
+    data_sites = []
+    for index, site_id in enumerate(management["dataSiteIds"]):
+        host_ids = sorted(
+            component["id"]
+            for component in estate["components"]
+            if component["type"] == "ESXI_HOST" and component["siteId"] == site_id
+        )
+        data_sites.append(
+            {
+                "faultDomain": "PREFERRED" if index == 0 else "SECONDARY",
+                "hostComponentIds": host_ids,
+                "siteId": site_id,
+            }
+        )
+    witness = component_by_type(estate, "VSAN_WITNESS")
+    return {
+        "clusterId": management["clusterId"],
+        "dataSites": data_sites,
+        "managementDomainId": management["id"],
+        "topology": "STRETCHED",
+        "witness": {
+            "clusterMembership": "STANDALONE",
+            "componentId": witness["id"],
+            "failureDomain": "INDEPENDENT_THIRD_SITE",
+            "servesClusterId": management["clusterId"],
+            "siteId": witness["siteId"],
+        },
+    }
+
+
+def build_steps(estate: dict[str, Any]) -> tuple[list[dict[str, Any]], dict[str, list[str]]]:
+    steps: list[dict[str, Any]] = []
+    component_steps: dict[str, list[str]] = {}
+
+    def add(
+        step_id: str,
+        action: str,
+        component_ids: list[str],
+        gate_ids: list[str],
+        produces: list[str],
+    ) -> None:
+        steps.append(
+            {
+                "action": action,
+                "componentIds": component_ids,
+                "gateIds": gate_ids,
+                "order": (len(steps) + 1) * 10,
+                "producesGateIds": produces,
+                "stepId": step_id,
+            }
+        )
+        for component_id in component_ids:
+            component_steps.setdefault(component_id, []).append(step_id)
+
+    add(
+        "upgrade-operations",
+        "UPGRADE",
+        ["aria-ops-01"],
+        ["core-prechecks-passed", "hardware-compatible-9.1"],
+        ["operations-9.1-ready"],
+    )
+    add(
+        "upgrade-sddc-manager",
+        "UPGRADE",
+        ["sddc-manager-01"],
+        ["operations-9.1-ready"],
+        ["sddc-manager-9.1-ready"],
+    )
+    add(
+        "deploy-management-services",
+        "DEPLOY",
+        ["vcf-management-services-01"],
+        ["sddc-manager-9.1-ready"],
+        ["management-services-9.1-ready"],
+    )
+    add(
+        "deploy-license-server",
+        "DEPLOY",
+        ["vcf-license-server-01"],
+        ["management-services-9.1-ready"],
+        ["license-server-9.1-ready"],
+    )
+    add(
+        "upgrade-nsx-management",
+        "UPGRADE",
+        ["nsx-mgmt-01"],
+        [
+            "sddc-manager-9.1-ready",
+            "management-services-9.1-ready",
+            "license-server-9.1-ready",
+        ],
+        ["nsx-management-9.1-ready"],
+    )
+    add(
+        "upgrade-management-vcenter",
+        "UPGRADE",
+        ["vcsa-mgmt-01"],
+        ["nsx-management-9.1-ready"],
+        ["vcenter-9.1-ready"],
+    )
+    add(
+        "upgrade-third-site-witness",
+        "UPGRADE",
+        ["vsan-witness-01"],
+        ["vcenter-9.1-ready", "stretched-vsan-healthy"],
+        ["witness-9.1-ready"],
+    )
+
+    hosts_by_site: dict[str, list[str]] = {
+        site_id: sorted(
+            component["id"]
+            for component in estate["components"]
+            if component["type"] == "ESXI_HOST" and component["siteId"] == site_id
+        )
+        for site_id in estate["managementDomain"]["dataSiteIds"]
+    }
+    rolling_hosts = [
+        host_id
+        for pair in zip(*(hosts_by_site[site] for site in estate["managementDomain"]["dataSiteIds"]))
+        for host_id in pair
+    ]
+    for index, host_id in enumerate(rolling_hosts):
+        produces = ["data-hosts-9.1-ready"] if index == len(rolling_hosts) - 1 else []
+        add(
+            f"upgrade-{host_id}",
+            "UPGRADE",
+            [host_id],
+            ["witness-9.1-ready", "stretched-vsan-healthy"],
+            produces,
+        )
+
+    edges = sorted(
+        component["id"]
+        for component in estate["components"]
+        if component["type"] == "NSX_EDGE"
+    )
+    for index, edge_id in enumerate(edges):
+        produces = ["nsx-edges-9.1-finalized"] if index == len(edges) - 1 else []
+        add(
+            f"finalize-{edge_id}",
+            "FINALIZE",
+            [edge_id],
+            ["data-hosts-9.1-ready", "nsx-management-9.1-ready"],
+            produces,
+        )
+    return steps, component_steps
+
+
+def build_plan(estate: dict[str, Any], snapshot: dict[str, Any]) -> dict[str, Any]:
+    if estate["vcfVersion"] != snapshot["sourceRelease"]:
+        raise ValueError("estate release does not match compatibility snapshot")
+    if estate["targetVersion"] != snapshot["targetRelease"]:
+        raise ValueError("target release does not match compatibility snapshot")
+
+    steps, component_steps = build_steps(estate)
+    component_plans = []
+    for component in sorted(estate["components"], key=lambda item: item["id"]):
+        component_plans.append(
+            {
+                "componentId": component["id"],
+                "componentType": component["type"],
+                "currentVersion": component["currentVersion"],
+                "gateIds": snapshot["requiredGatesByComponentType"][component["type"]],
+                "stepIds": component_steps[component["id"]],
+                "targetVersion": snapshot["componentTargets"][component["type"]],
+            }
+        )
+
+    introduced_components = []
+    for component_id, component in sorted(snapshot["introducedComponents"].items()):
+        introduced_components.append(
+            {
+                "componentId": component_id,
+                "componentType": component["type"],
+                "gateIds": component["requiredGateIds"],
+                "siteId": component["siteId"],
+                "stepIds": component_steps[component_id],
+                "targetVersion": component["targetVersion"],
+            }
+        )
+
+    return {
+        "componentPlans": component_plans,
+        "estateId": estate["estateId"],
+        "introducedComponents": introduced_components,
+        "releasePath": [estate["vcfVersion"], estate["targetVersion"]],
+        "researchConsulted": RESEARCH_CONSULTED,
+        "schemaVersion": "1.0",
+        "steps": steps,
+        "targetArchitecture": target_architecture(estate),
+        "targetInstallerSpec": target_installer_spec(estate, snapshot),
+        "targetVersion": estate["targetVersion"],
+    }

@@ -0,0 +1,40 @@
+"""Command-line entry point for the VCF migration architecture builder."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+from typing import Any
+
+from .planner import build_plan
+
+
+def read_json(path: Path) -> dict[str, Any]:
+    with path.open("r", encoding="utf-8") as handle:
+        value = json.load(handle)
+    if not isinstance(value, dict):
+        raise ValueError(f"{path} must contain a JSON object")
+    return value
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(
+        description="Build the VCF 9.1 brownfield migration architecture"
+    )
+    parser.add_argument("--estate", required=True, type=Path)
+    parser.add_argument("--snapshot", required=True, type=Path)
+    parser.add_argument("--output", required=True, type=Path)
+    return parser.parse_args()
+
+
+def main() -> int:
+    args = parse_args()
+    plan = build_plan(read_json(args.estate), read_json(args.snapshot))
+    payload = json.dumps(plan, indent=2, sort_keys=True, ensure_ascii=False) + "\n"
+    args.output.write_text(payload, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

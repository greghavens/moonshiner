{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch-0075:migration-plan:1.0",
  "title": "VCF brownfield migration architecture",
  "type": "object",
  "required": [
    "schemaVersion",
    "estateId",
    "targetVersion",
    "releasePath",
    "targetInstallerSpec",
    "targetArchitecture",
    "componentPlans",
    "introducedComponents",
    "researchConsulted",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetVersion": {
      "type": "string",
      "minLength": 1
    },
    "releasePath": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "targetInstallerSpec": {
      "type": "object"
    },
    "targetArchitecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managementDomainId",
        "clusterId",
        "topology",
        "dataSites",
        "witness"
      ],
      "properties": {
        "managementDomainId": {
          "type": "string",
          "minLength": 1
        },
        "clusterId": {
          "type": "string",
          "minLength": 1
        },
        "topology": {
          "const": "STRETCHED"
        },
        "dataSites": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "siteId",
              "faultDomain",
              "hostComponentIds"
            ],
            "properties": {
              "siteId": {
                "type": "string",
                "minLength": 1
              },
              "faultDomain": {
                "enum": [
                  "PREFERRED",
                  "SECONDARY"
                ]
              },
              "hostComponentIds": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "witness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "componentId",
            "siteId",
            "failureDomain",
            "clusterMembership",
            "servesClusterId"
          ],
          "properties": {
            "componentId": {
              "type": "string",
              "minLength": 1
            },
            "siteId": {
              "type": "string",
              "minLength": 1
            },
            "failureDomain": {
              "const": "INDEPENDENT_THIRD_SITE"
            },
            "clusterMembership": {
              "const": "STANDALONE"
            },
            "servesClusterId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "componentPlans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "componentId",
          "componentType",
          "currentVersion",
          "targetVersion",
          "gateIds",
          "stepIds"
        ],
        "properties": {
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "componentType": {
            "type": "string",
            "minLength": 1
          },
          "currentVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "gateIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "stepIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "introducedComponents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "componentId",
          "componentType",
          "targetVersion",
          "siteId",
          "gateIds",
          "stepIds"
        ],
        "properties": {
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "componentType": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "siteId": {
            "type": "string",
            "minLength": 1
          },
          "gateIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "stepIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "researchConsulted": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url",
          "accessedAt"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "accessedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "stepId",
          "action",
          "componentIds",
          "gateIds",
          "producesGateIds"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "stepId": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "UPGRADE",
              "DEPLOY",
              "FINALIZE"
            ]
          },
          "componentIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "gateIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "producesGateIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

{
  "source": {
    "title": "vSphere Automation API",
    "version": "9.1.0.0",
    "server_url": "https://{host}/api",
    "repository_commit_sha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "spec_path": "specifications/vsphere/openapi/automation/vcenter.yaml"
  },
  "security_schemes": {
    "api_key_auth": {
      "type": "apiKey",
      "in": "header",
      "name": "vmware-api-session-id"
    },
    "federated_identity_auth": {
      "type": "http",
      "scheme": "bearer"
    }
  },
  "operations": [
    {
      "operation_id": "Vcenter.Authentication.Token_issue",
      "method": "POST",
      "path": "/api/vcenter/authentication/token",
      "security": [
        "api_key_auth",
        "federated_identity_auth"
      ],
      "request": {
        "content_type": "application/x-www-form-urlencoded",
        "schema": "Vcenter.Authentication.Token.IssueSpec",
        "required_fields": [
          "grant_type"
        ],
        "fields": [
          "grant_type",
          "resource",
          "audience",
          "scope",
          "requested_token_type",
          "subject_token",
          "subject_token_type",
          "actor_token",
          "actor_token_type"
        ],
        "grant_type": "urn:ietf:params:oauth:grant-type:token-exchange"
      },
      "responses": {
        "200": {
          "content_type": "application/json",
          "schema": "Oauth2.TokenInfo",
          "required_fields": [
            "access_token",
            "token_type"
          ],
          "optional_fields": [
            "expires_in",
            "scope",
            "refresh_token",
            "issued_token_type"
          ]
        },
        "400": {
          "content_type": "application/json",
          "schema": "Oauth2.Errors.Error",
          "required_fields": [
            "error"
          ],
          "optional_fields": [
            "error_description",
            "error_uri"
          ]
        }
      }
    },
    {
      "operation_id": "Vcenter.VM_list",
      "method": "GET",
      "path": "/api/vcenter/vm",
      "security": [
        "api_key_auth"
      ],
      "success_status": 200,
      "response": {
        "content_type": "application/json",
        "type": "array",
        "items_schema": "Vcenter.VM.Summary",
        "required_fields": [
          "vm",
          "name",
          "power_state"
        ],
        "optional_fields": [
          "cpu_count",
          "memory_size_mib"
        ]
      },
      "error_statuses": [
        400,
        401,
        403,
        500,
        503
      ]
    },
    {
      "operation_id": "Vcenter.Host_list",
      "method": "GET",
      "path": "/api/vcenter/host",
      "security": [
        "api_key_auth"
      ],
      "success_status": 200,
      "response": {
        "content_type": "application/json",
        "type": "array",
        "items_schema": "Vcenter.Host.Summary",
        "required_fields": [
          "host",
          "name",
          "connection_state"
        ],
        "optional_fields": [
          "power_state",
          "host_uuid"
        ]
      },
      "error_statuses": [
        400,
        401,
        403,
        500,
        503
      ]
    }
  ],
  "error_envelopes": {
    "vapi": {
      "fields": [
        "error_type",
        "messages"
      ],
      "message_fields": [
        "id",
        "default_message",
        "args"
      ]
    },
    "oauth2": {
      "fields": [
        "error",
        "error_description",
        "error_uri"
      ]
    }
  },
  "integration_policy": {
    "note": "These deterministic client requirements are ticket policy layered on the extracted OpenAPI wire contract.",
    "base_url": "Absolute origin without the /api suffix",
    "inventory_order": [
      "Vcenter.VM_list",
      "Vcenter.Host_list"
    ],
    "collection_sort": "Lexicographic ascending by the resource identifier field (vm or host)",
    "expired_access_token": "On one 401, exchange the configured federated subject token, rotate the access token, and retry only the failed operation once",
    "token_exchange_form": {
      "grant_type": "urn:ietf:params:oauth:grant-type:token-exchange",
      "subject_token": "configured SubjectToken",
      "subject_token_type": "configured SubjectTokenType"
    },
    "token_exchange_auth": "Authorization: Bearer <SubjectToken>",
    "concurrency": "One in-flight exchange per stale access token"
  }
}

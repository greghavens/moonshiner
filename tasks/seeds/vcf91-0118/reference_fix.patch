index 0000000..5eeca39
--- /dev/null
+++ b/client.go
@@ -0,0 +1,196 @@
+// Package vcenter implements the focused VCF 9.1 vSphere Automation API
+// inventory contract pinned in docs/contract.json.
+package vcenter
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"sort"
+	"strings"
+	"sync"
+)
+
+const (
+	tokenIssuePath = "/api/vcenter/authentication/token"
+	vmListPath     = "/api/vcenter/vm"
+	hostListPath   = "/api/vcenter/host"
+	tokenGrant     = "urn:ietf:params:oauth:grant-type:token-exchange"
+)
+
+// Client is safe for concurrent use.
+type Client struct {
+	baseURL          string
+	http             *http.Client
+	subjectToken     string
+	subjectTokenType string
+
+	mu          sync.Mutex
+	accessToken string
+}
+
+// NewClient validates cfg and creates a client.
+func NewClient(cfg Config) (*Client, error) {
+	switch {
+	case cfg.BaseURL == "":
+		return nil, errors.New("vcenter: Config.BaseURL is required")
+	case cfg.AccessToken == "":
+		return nil, errors.New("vcenter: Config.AccessToken is required")
+	case cfg.SubjectToken == "":
+		return nil, errors.New("vcenter: Config.SubjectToken is required")
+	case cfg.SubjectTokenType == "":
+		return nil, errors.New("vcenter: Config.SubjectTokenType is required")
+	}
+
+	base, err := url.Parse(cfg.BaseURL)
+	if err != nil || (base.Scheme != "http" && base.Scheme != "https") || base.Host == "" || base.User != nil ||
+		(base.Path != "" && base.Path != "/") || base.RawQuery != "" || base.Fragment != "" {
+		return nil, errors.New("vcenter: Config.BaseURL must be an absolute origin")
+	}
+	hc := cfg.HTTPClient
+	if hc == nil {
+		hc = http.DefaultClient
+	}
+	return &Client{
+		baseURL:          strings.TrimRight(cfg.BaseURL, "/"),
+		http:             hc,
+		subjectToken:     cfg.SubjectToken,
+		subjectTokenType: cfg.SubjectTokenType,
+		accessToken:      cfg.AccessToken,
+	}, nil
+}
+
+// Inventory retrieves VMs and then hosts. A refresh retries only the request
+// that observed the expired access token.
+func (c *Client) Inventory(ctx context.Context) (Inventory, error) {
+	var result Inventory
+	if err := c.getCollection(ctx, vmListPath, &result.VMs); err != nil {
+		return Inventory{}, fmt.Errorf("list virtual machines: %w", err)
+	}
+	if err := c.getCollection(ctx, hostListPath, &result.Hosts); err != nil {
+		return Inventory{}, fmt.Errorf("list hosts: %w", err)
+	}
+
+	sort.Slice(result.VMs, func(i, j int) bool {
+		return result.VMs[i].ID < result.VMs[j].ID
+	})
+	sort.Slice(result.Hosts, func(i, j int) bool {
+		return result.Hosts[i].ID < result.Hosts[j].ID
+	})
+	return result, nil
+}
+
+func (c *Client) getCollection(ctx context.Context, path string, out any) error {
+	stale := c.token()
+	status, payload, err := c.get(ctx, path, stale)
+	if err != nil {
+		return err
+	}
+	if status == http.StatusUnauthorized {
+		if err := c.refresh(ctx, stale); err != nil {
+			return err
+		}
+		status, payload, err = c.get(ctx, path, c.token())
+		if err != nil {
+			return err
+		}
+	}
+	if status != http.StatusOK {
+		return decodeAPIError(status, payload)
+	}
+	if err := json.Unmarshal(payload, out); err != nil {
+		return fmt.Errorf("decode %s response: %w", path, err)
+	}
+	return nil
+}
+
+func (c *Client) get(ctx context.Context, path, token string) (int, []byte, error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, c.baseURL+path, nil)
+	if err != nil {
+		return 0, nil, err
+	}
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("vmware-api-session-id", token)
+	return c.do(req)
+}
+
+// refresh serializes exchange and compares the stale token after acquiring the
+// lock. A caller delayed behind a successful exchange reuses the new token.
+func (c *Client) refresh(ctx context.Context, stale string) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.accessToken != stale {
+		return nil
+	}
+
+	form := url.Values{
+		"grant_type":         {tokenGrant},
+		"subject_token":      {c.subjectToken},
+		"subject_token_type": {c.subjectTokenType},
+	}
+	req, err := http.NewRequestWithContext(
+		ctx,
+		http.MethodPost,
+		c.baseURL+tokenIssuePath,
+		strings.NewReader(form.Encode()),
+	)
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	req.Header.Set("Authorization", "Bearer "+c.subjectToken)
+
+	status, payload, err := c.do(req)
+	if err != nil {
+		return err
+	}
+	if status != http.StatusOK {
+		return decodeTokenError(status, payload)
+	}
+
+	var token tokenInfo
+	if err := json.Unmarshal(payload, &token); err != nil {
+		return fmt.Errorf("decode token exchange response: %w", err)
+	}
+	if token.AccessToken == "" || token.TokenType == "" {
+		return errors.New("vcenter: token exchange response is missing required fields")
+	}
+	c.accessToken = token.AccessToken
+	return nil
+}
+
+func (c *Client) token() string {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.accessToken
+}
+
+func (c *Client) do(req *http.Request) (int, []byte, error) {
+	resp, err := c.http.Do(req)
+	if err != nil {
+		return 0, nil, err
+	}
+	defer resp.Body.Close()
+	payload, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return 0, nil, fmt.Errorf("read %s %s response: %w", req.Method, req.URL.Path, err)
+	}
+	return resp.StatusCode, payload, nil
+}
+
+func decodeAPIError(status int, payload []byte) *APIError {
+	result := &APIError{StatusCode: status}
+	_ = json.Unmarshal(payload, result)
+	return result
+}
+
+func decodeTokenError(status int, payload []byte) *TokenError {
+	result := &TokenError{StatusCode: status}
+	_ = json.Unmarshal(payload, result)
+	return result
+}

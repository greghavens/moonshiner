{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF brownfield migration plan",
  "type": "object",
  "required": [
    "sddcId",
    "workflowType",
    "version",
    "vcenterSpec",
    "networkSpecs",
    "dnsSpec",
    "planVersion",
    "estateId",
    "targetBundle",
    "strategy",
    "components",
    "gates",
    "steps",
    "fleetEndState"
  ],
  "additionalProperties": false,
  "properties": {
    "sddcId": {"type": "string"},
    "workflowType": {"const": "VCF_COMPLETE"},
    "version": {"type": "string"},
    "vcenterSpec": {"type": "object"},
    "networkSpecs": {"type": "array", "minItems": 1},
    "dnsSpec": {"type": "object"},
    "planVersion": {"const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "targetBundle": {"type": "string", "minLength": 1},
    "strategy": {"const": "parallel-vcf-replacement"},
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "name",
          "currentVersion",
          "targetName",
          "targetVersion",
          "migrationMode",
          "gatedBy",
          "finalManagement"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "currentVersion": {"type": "string", "minLength": 1},
          "targetName": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "migrationMode": {
            "enum": ["parallel-replacement", "clean-transition"]
          },
          "gatedBy": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "finalManagement": {"const": "single-vcf-fleet"}
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "condition", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "condition": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "id",
          "action",
          "components",
          "requiresGates",
          "dependsOn"
        ],
        "additionalProperties": false,
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "id": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "components": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "requiresGates": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "fleetEndState": {"const": "single-vcf-fleet"}
  }
}

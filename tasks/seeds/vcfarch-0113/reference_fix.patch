index 0000000..7a4b8ea
--- /dev/null
+++ b/vcf_arch/planner.py
@@ -0,0 +1,182 @@
+"""Construct the installer-shaped, ordered brownfield architecture artifact."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+
+GATE_DETAILS = {
+    "installer-spec-valid": {
+        "condition": "The target management-domain input conforms to the VCF 9.1 SddcSpec.",
+        "evidence": "The artifact root is the tag-pinned VCF_COMPLETE SddcSpec.",
+    },
+    "back-in-time-avoided": {
+        "condition": "No installed build newer than the bundle is downgraded or upgraded in place.",
+        "evidence": "The affected vCenter, ESX, vSAN, and NSX entries use parallel-replacement.",
+    },
+    "target-domain-ready": {
+        "condition": "The parallel VCF 9.1 management domain is deployed and healthy.",
+        "evidence": "The deploy-target step completes from the validated installer specification.",
+    },
+    "workloads-migrated": {
+        "condition": "Workloads and networks have moved to the replacement VCF domain.",
+        "evidence": "The migrate-workloads step completes before legacy retirement and fleet join.",
+    },
+    "minimal-recovery-footprint": {
+        "condition": "The estate matches the documented minimal-footprint clean-transition conditions.",
+        "evidence": "The inventory records one active replication and minimalRecoveryFootprint true.",
+    },
+    "legacy-replication-removed": {
+        "condition": "Active replication is removed and both standalone recovery appliances are unregistered.",
+        "evidence": "The remove-legacy-replication step covers both legacy recovery components.",
+    },
+    "protection-recreated": {
+        "condition": "Protection is recreated and tested on the unified 9.1 appliance.",
+        "evidence": "The transition-recovery step targets VCF Protection and Recovery for both sources.",
+    },
+}
+
+
+def load_document(path):
+    """Read one UTF-8 JSON input document."""
+    with Path(path).open("r", encoding="utf-8") as handle:
+        return json.load(handle)
+
+
+def _component(source, authority, fleet_end_state):
+    return {
+        "id": source["id"],
+        "type": source["type"],
+        "name": source["name"],
+        "currentVersion": f"{source['version']} build {source['build']}",
+        "targetName": authority["targetName"],
+        "targetVersion": authority["targetVersion"],
+        "migrationMode": authority["requiredMode"],
+        "gatedBy": list(authority["requiredGates"]),
+        "finalManagement": fleet_end_state,
+    }
+
+
+def _step(sequence, step_id, action, components, gates, dependencies):
+    return {
+        "sequence": sequence,
+        "id": step_id,
+        "action": action,
+        "components": list(components),
+        "requiresGates": list(gates),
+        "dependsOn": list(dependencies),
+    }
+
+
+def build_plan(inventory, compatibility):
+    """Build the architecture solely from the protected inventory and snapshot."""
+    if inventory["estateKind"] != "existing":
+        raise ValueError("the migration-plan architecture requires an existing estate")
+    if inventory["targetBundle"] != compatibility["targetBundle"]:
+        raise ValueError("inventory and compatibility snapshot target different bundles")
+
+    authorities = compatibility["components"]
+    fleet_end_state = compatibility["fleetEndState"]
+    components = [
+        _component(item, authorities[item["type"]], fleet_end_state)
+        for item in inventory["components"]
+    ]
+    all_ids = [item["id"] for item in inventory["components"]]
+    core_ids = [
+        item["id"]
+        for item in inventory["components"]
+        if authorities[item["type"]]["requiredPhase"] == "deploy-target"
+    ]
+    recovery_ids = [item_id for item_id in all_ids if item_id not in set(core_ids)]
+
+    gate_ids = []
+    for component in components:
+        for gate_id in component["gatedBy"]:
+            if gate_id not in gate_ids:
+                gate_ids.append(gate_id)
+    gates = [{"id": gate_id, **GATE_DETAILS[gate_id]} for gate_id in gate_ids]
+
+    step_gates = compatibility["requiredStepGates"]
+    steps = [
+        _step(
+            10,
+            "validate-architecture",
+            "Validate the installer-shaped target architecture before any estate change.",
+            all_ids,
+            step_gates["validate-architecture"],
+            [],
+        ),
+        _step(
+            20,
+            "remove-legacy-replication",
+            "Remove the active replication, then unregister and power down both standalone 9.0.2 recovery appliances.",
+            recovery_ids,
+            step_gates["remove-legacy-replication"],
+            ["validate-architecture"],
+        ),
+        _step(
+            30,
+            "deploy-target",
+            "Deploy a parallel VCF 9.1 management domain from this SddcSpec; do not apply the older bundle builds to the standalone estate.",
+            core_ids,
+            step_gates["deploy-target"],
+            ["validate-architecture", "remove-legacy-replication"],
+        ),
+        _step(
+            40,
+            "migrate-workloads",
+            "Move workloads and their network/storage attachments to the replacement VCF-managed components, then validate service health.",
+            core_ids,
+            step_gates["migrate-workloads"],
+            ["deploy-target"],
+        ),
+        _step(
+            50,
+            "transition-recovery",
+            "Deploy unified VCF Protection and Recovery 9.1, pair the sites, and recreate and test protection.",
+            recovery_ids,
+            step_gates["transition-recovery"],
+            ["migrate-workloads"],
+        ),
+        _step(
+            60,
+            "join-fleet",
+            "Retire the superseded standalone instances and verify every target component is managed by the one VCF fleet.",
+            all_ids,
+            step_gates["join-fleet"],
+            ["migrate-workloads", "transition-recovery"],
+        ),
+    ]
+
+    design = inventory["targetDesign"]
+    return {
+        "sddcId": design["sddcId"],
+        "workflowType": "VCF_COMPLETE",
+        "version": compatibility["targetBundle"],
+        "vcenterSpec": {
+            "vcenterHostname": design["vcenterHostname"],
+            "rootVcenterPassword": design["rootVcenterPassword"],
+            "version": authorities["VCENTER"]["targetVersion"],
+            "useExistingDeployment": False,
+        },
+        "networkSpecs": design["networks"],
+        "dnsSpec": design["dns"],
+        "planVersion": "1.0",
+        "estateId": inventory["estateId"],
+        "targetBundle": compatibility["targetBundle"],
+        "strategy": "parallel-vcf-replacement",
+        "components": components,
+        "gates": gates,
+        "steps": steps,
+        "fleetEndState": fleet_end_state,
+    }
+
+
+def write_plan(path, plan):
+    """Write canonical, stable JSON with one trailing newline."""
+    output = Path(path)
+    output.write_text(
+        json.dumps(plan, indent=2, sort_keys=False) + "\n",
+        encoding="utf-8",
+    )

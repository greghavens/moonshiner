diff --git a/client.go b/client.go
new file mode 100644
index 0000000..89de3a7
--- /dev/null
+++ b/client.go
@@ -0,0 +1,194 @@
+package vcfauto
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+)
+
+// ClientConfig configures a Client.
+type ClientConfig struct {
+	// BaseURL is the scheme and host of the VCF Automation appliance.
+	BaseURL string
+	// Token is the bearer token sent as the Authorization header.
+	Token string
+	// Contract pins the operations the client may send.
+	Contract *Contract
+
+	HTTPClient   *http.Client
+	PollInterval time.Duration
+	MaxPolls     int
+}
+
+// Client speaks the subset of the VCF Automation deployment API that the
+// contract names.
+type Client struct {
+	base     string
+	token    string
+	contract *Contract
+	http     *http.Client
+	poll     time.Duration
+	maxPolls int
+}
+
+// NewClient builds a client.
+func NewClient(cfg ClientConfig) (*Client, error) {
+	if cfg.BaseURL == "" {
+		return nil, fmt.Errorf("BaseURL is required")
+	}
+	if cfg.Contract == nil {
+		return nil, fmt.Errorf("Contract is required")
+	}
+	c := &Client{
+		base:     strings.TrimRight(cfg.BaseURL, "/"),
+		token:    cfg.Token,
+		contract: cfg.Contract,
+		http:     cfg.HTTPClient,
+		poll:     cfg.PollInterval,
+		maxPolls: cfg.MaxPolls,
+	}
+	if c.http == nil {
+		c.http = &http.Client{Timeout: 30 * time.Second}
+	}
+	if c.poll <= 0 {
+		c.poll = 2 * time.Second
+	}
+	if c.maxPolls <= 0 {
+		c.maxPolls = 30
+	}
+	return c, nil
+}
+
+// apiError is a non-2xx response from the appliance.
+type apiError struct {
+	Op     string
+	Status int
+	Body   string
+}
+
+func (e *apiError) Error() string {
+	msg := strings.TrimSpace(e.Body)
+	if msg == "" {
+		msg = http.StatusText(e.Status)
+	}
+	return fmt.Sprintf("%s: HTTP %d: %s", e.Op, e.Status, msg)
+}
+
+// do sends one contract operation. body is marshalled only when non-nil, so a
+// bodiless operation carries no Content-Type.
+func (c *Client) do(ctx context.Context, opID string, params map[string]string, body any, out any) error {
+	op, ok := c.contract.Operation(opID)
+	if !ok {
+		return fmt.Errorf("operation %q is not named by the contract", opID)
+	}
+	path, err := op.ExpandPath(params)
+	if err != nil {
+		return err
+	}
+
+	var rdr io.Reader
+	var raw []byte
+	if body != nil {
+		raw, err = json.Marshal(body)
+		if err != nil {
+			return fmt.Errorf("%s: encode body: %w", opID, err)
+		}
+		rdr = bytes.NewReader(raw)
+	}
+
+	req, err := http.NewRequestWithContext(ctx, op.Method, c.base+path, rdr)
+	if err != nil {
+		return fmt.Errorf("%s: build request: %w", opID, err)
+	}
+	if c.token != "" {
+		req.Header.Set("Authorization", "Bearer "+c.token)
+	}
+	req.Header.Set("Accept", "application/json")
+	if raw != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+
+	resp, err := c.http.Do(req)
+	if err != nil {
+		return fmt.Errorf("%s: %w", opID, err)
+	}
+	defer resp.Body.Close()
+	respBody, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return fmt.Errorf("%s: read response: %w", opID, err)
+	}
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return &apiError{Op: opID, Status: resp.StatusCode, Body: string(respBody)}
+	}
+	if out != nil && len(respBody) > 0 {
+		if err := json.Unmarshal(respBody, out); err != nil {
+			return fmt.Errorf("%s: decode response: %w", opID, err)
+		}
+	}
+	return nil
+}
+
+// deploymentUpdate is the PatchDeployment body. Every field is optional, so
+// every field is a pointer: an unset field is omitted rather than sent as "".
+type deploymentUpdate struct {
+	Name        *string `json:"name,omitempty"`
+	Description *string `json:"description,omitempty"`
+	IconID      *string `json:"iconId,omitempty"`
+}
+
+// resourceActionRequest is the body both action-request operations post. All
+// three fields are optional and omitted when unset; an empty inputs map is
+// omitted too, since omitempty drops empty maps.
+type resourceActionRequest struct {
+	ActionID *string        `json:"actionId,omitempty"`
+	Inputs   map[string]any `json:"inputs,omitempty"`
+	Reason   *string        `json:"reason,omitempty"`
+}
+
+func optional(s string) *string {
+	if s == "" {
+		return nil
+	}
+	return &s
+}
+
+// apiRequest is the subset of the documented Request object this package reads.
+type apiRequest struct {
+	ID       string `json:"id"`
+	ActionID string `json:"actionId"`
+	Status   string `json:"status"`
+	Details  string `json:"details"`
+}
+
+var terminalStatuses = map[string]bool{
+	"SUCCESSFUL":        true,
+	"FAILED":            true,
+	"ABORTED":           true,
+	"APPROVAL_REJECTED": true,
+}
+
+// awaitRequest polls GetRequest until the request reaches a terminal status.
+func (c *Client) awaitRequest(ctx context.Context, id string) (apiRequest, error) {
+	var last apiRequest
+	for i := 0; i < c.maxPolls; i++ {
+		var got apiRequest
+		if err := c.do(ctx, "GetRequest", map[string]string{"requestId": id}, nil, &got); err != nil {
+			return last, err
+		}
+		last = got
+		if terminalStatuses[got.Status] {
+			return got, nil
+		}
+		select {
+		case <-ctx.Done():
+			return last, ctx.Err()
+		case <-time.After(c.poll):
+		}
+	}
+	return last, fmt.Errorf("request %s did not reach a terminal status after %d polls (last status %q)", id, c.maxPolls, last.Status)
+}
diff --git a/contract.go b/contract.go
new file mode 100644
index 0000000..b4ad3cf
--- /dev/null
+++ b/contract.go
@@ -0,0 +1,128 @@
+package vcfauto
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"regexp"
+	"strings"
+)
+
+// Provenance records where the contract came from. VCF Automation is not
+// covered by vmware/vcf-api-specs, so this contract is transcribed by hand from
+// the vendor's reference pages rather than generated from a published document.
+type Provenance struct {
+	SourceKind             string `json:"source_kind"`
+	Portal                 string `json:"portal"`
+	SpecificationAvailable bool   `json:"specification_available"`
+	Statement              string `json:"statement"`
+}
+
+// Field is one member of an operation's documented request body.
+type Field struct {
+	Name     string `json:"name"`
+	Type     string `json:"type"`
+	Required bool   `json:"required"`
+	Notes    string `json:"notes,omitempty"`
+}
+
+// Operation is a single documented REST operation.
+type Operation struct {
+	ID                    string  `json:"id"`
+	Summary               string  `json:"summary"`
+	Method                string  `json:"method"`
+	PathTemplate          string  `json:"path_template"`
+	RequestSchema         string  `json:"request_schema"`
+	ResponseSchema        string  `json:"response_schema"`
+	RequestFields         []Field `json:"request_fields,omitempty"`
+	DocumentedStatusCodes []int   `json:"documented_status_codes"`
+	DocURL                string  `json:"doc_url"`
+}
+
+// Contract is the set of operations this package is allowed to speak.
+type Contract struct {
+	Product    string      `json:"product"`
+	Release    string      `json:"release"`
+	Provenance Provenance  `json:"provenance"`
+	Operations []Operation `json:"operations"`
+
+	byID map[string]Operation
+}
+
+var placeholderRE = regexp.MustCompile(`\{([A-Za-z0-9_]+)\}`)
+
+// LoadContract reads and validates a contract document.
+func LoadContract(path string) (*Contract, error) {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("read contract: %w", err)
+	}
+	var c Contract
+	if err := json.Unmarshal(b, &c); err != nil {
+		return nil, fmt.Errorf("parse contract %s: %w", path, err)
+	}
+	if err := c.init(); err != nil {
+		return nil, fmt.Errorf("contract %s: %w", path, err)
+	}
+	return &c, nil
+}
+
+func (c *Contract) init() error {
+	if c.Product == "" || c.Release == "" {
+		return fmt.Errorf("product and release are required")
+	}
+	if strings.TrimSpace(c.Provenance.Statement) == "" {
+		return fmt.Errorf("provenance.statement is required")
+	}
+	if len(c.Operations) == 0 {
+		return fmt.Errorf("no operations declared")
+	}
+	c.byID = make(map[string]Operation, len(c.Operations))
+	for _, op := range c.Operations {
+		if op.ID == "" {
+			return fmt.Errorf("operation with empty id")
+		}
+		if _, dup := c.byID[op.ID]; dup {
+			return fmt.Errorf("duplicate operation id %q", op.ID)
+		}
+		if op.Method == "" || !strings.HasPrefix(op.PathTemplate, "/") {
+			return fmt.Errorf("operation %q: method and absolute path_template are required", op.ID)
+		}
+		c.byID[op.ID] = op
+	}
+	return nil
+}
+
+// Operation looks up an operation by id.
+func (c *Contract) Operation(id string) (Operation, bool) {
+	op, ok := c.byID[id]
+	return op, ok
+}
+
+// PathParams returns the placeholder names in the operation's path template,
+// in the order they appear.
+func (op Operation) PathParams() []string {
+	var out []string
+	for _, m := range placeholderRE.FindAllStringSubmatch(op.PathTemplate, -1) {
+		out = append(out, m[1])
+	}
+	return out
+}
+
+// ExpandPath substitutes path parameters into the operation's template.
+func (op Operation) ExpandPath(params map[string]string) (string, error) {
+	var missing []string
+	out := placeholderRE.ReplaceAllStringFunc(op.PathTemplate, func(tok string) string {
+		name := tok[1 : len(tok)-1]
+		v, ok := params[name]
+		if !ok || v == "" {
+			missing = append(missing, name)
+			return tok
+		}
+		return v
+	})
+	if len(missing) > 0 {
+		return "", fmt.Errorf("operation %s: missing path parameter(s) %s", op.ID, strings.Join(missing, ", "))
+	}
+	return out, nil
+}

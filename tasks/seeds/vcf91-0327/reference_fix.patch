diff --git a/plan.go b/plan.go
new file mode 100644
index 0000000..527bcd8
--- /dev/null
+++ b/plan.go
@@ -0,0 +1,203 @@
+package vcfauto
+
+import (
+	"context"
+	"fmt"
+	"strings"
+)
+
+// Step is one change in a plan.
+type Step struct {
+	// Name identifies the step in the report.
+	Name string
+	// OperationID must be named by the contract.
+	OperationID string
+
+	DeploymentID string
+	ResourceID   string
+	RequestID    string
+
+	// Action request fields. Empty values are left off the wire.
+	ActionID string
+	Reason   string
+	Inputs   map[string]any
+
+	// PatchDeployment fields. Empty values are left off the wire.
+	NewName     string
+	Description string
+	IconID      string
+}
+
+// StepOutcome is what became of a step.
+type StepOutcome string
+
+const (
+	StepSucceeded StepOutcome = "SUCCEEDED"
+	StepFailed    StepOutcome = "FAILED"
+	StepSkipped   StepOutcome = "SKIPPED"
+)
+
+// StepResult is the record of one step's execution.
+type StepResult struct {
+	Step Step
+	// Outcome is SUCCEEDED, FAILED, or SKIPPED.
+	Outcome StepOutcome
+	// RequestID is the id of the accepted action request, when the step made one.
+	RequestID string
+	// Status is the terminal request status, when the step made a request.
+	Status string
+	// Detail explains a failure.
+	Detail string
+}
+
+// PlanResult is the report for a whole plan.
+type PlanResult struct {
+	Results []StepResult
+	// RolledBack is true only if compensating requests were actually sent.
+	// This package does not compensate, so it is always false: a step that
+	// succeeded before a later failure is still in effect on the appliance.
+	RolledBack bool
+}
+
+// Applied returns the names of the steps whose change took effect, in order.
+func (p *PlanResult) Applied() []string {
+	var out []string
+	for _, r := range p.Results {
+		if r.Outcome == StepSucceeded {
+			out = append(out, r.Step.Name)
+		}
+	}
+	return out
+}
+
+// Summary renders the report: one line per step in plan order, then what was
+// left applied and whether anything was rolled back.
+func (p *PlanResult) Summary() string {
+	var b strings.Builder
+	for i, r := range p.Results {
+		fmt.Fprintf(&b, "%d. %s [%s] %s", i+1, r.Step.Name, r.Step.OperationID, r.Outcome)
+		if r.Outcome == StepFailed && r.Detail != "" {
+			fmt.Fprintf(&b, ": %s", r.Detail)
+		}
+		b.WriteString("\n")
+	}
+	applied := p.Applied()
+	if len(applied) == 0 {
+		b.WriteString("applied: none\n")
+	} else {
+		fmt.Fprintf(&b, "applied: %s\n", strings.Join(applied, ", "))
+	}
+	fmt.Fprintf(&b, "rolled back: %t\n", p.RolledBack)
+	return b.String()
+}
+
+// ApplyPlan runs the steps in order and stops at the first failure, leaving the
+// remaining steps SKIPPED. Nothing is undone: the steps that already succeeded
+// stay applied and are reported as such.
+//
+// A step failing is not an error — it is recorded in the result. ApplyPlan
+// returns an error only when the plan itself is unusable, in which case no
+// request is sent.
+func (c *Client) ApplyPlan(ctx context.Context, steps []Step) (*PlanResult, error) {
+	for i, s := range steps {
+		if s.OperationID == "" {
+			return nil, fmt.Errorf("step %d (%s): OperationID is required", i+1, s.Name)
+		}
+		if _, ok := c.contract.Operation(s.OperationID); !ok {
+			return nil, fmt.Errorf("step %d (%s): operation %q is not named by the contract", i+1, s.Name, s.OperationID)
+		}
+	}
+
+	res := &PlanResult{Results: make([]StepResult, 0, len(steps))}
+	failed := false
+	for _, s := range steps {
+		if failed {
+			res.Results = append(res.Results, StepResult{Step: s, Outcome: StepSkipped})
+			continue
+		}
+		sr := c.runStep(ctx, s)
+		res.Results = append(res.Results, sr)
+		if sr.Outcome == StepFailed {
+			failed = true
+		}
+	}
+	return res, nil
+}
+
+func (c *Client) runStep(ctx context.Context, s Step) StepResult {
+	sr := StepResult{Step: s}
+	params := map[string]string{}
+	if s.DeploymentID != "" {
+		params["deploymentId"] = s.DeploymentID
+	}
+	if s.ResourceID != "" {
+		params["resourceId"] = s.ResourceID
+	}
+	if s.RequestID != "" {
+		params["requestId"] = s.RequestID
+	}
+
+	fail := func(err error) StepResult {
+		sr.Outcome = StepFailed
+		sr.Detail = err.Error()
+		return sr
+	}
+
+	switch s.OperationID {
+	case "PatchDeployment":
+		body := deploymentUpdate{
+			Name:        optional(s.NewName),
+			Description: optional(s.Description),
+			IconID:      optional(s.IconID),
+		}
+		if err := c.do(ctx, s.OperationID, params, body, nil); err != nil {
+			return fail(err)
+		}
+		sr.Outcome = StepSucceeded
+		return sr
+
+	case "SubmitDeploymentActionRequest", "SubmitResourceActionRequest":
+		body := resourceActionRequest{
+			ActionID: optional(s.ActionID),
+			Inputs:   s.Inputs,
+			Reason:   optional(s.Reason),
+		}
+		var accepted apiRequest
+		if err := c.do(ctx, s.OperationID, params, body, &accepted); err != nil {
+			return fail(err)
+		}
+		sr.RequestID = accepted.ID
+		sr.Status = accepted.Status
+		if accepted.ID == "" {
+			return fail(fmt.Errorf("%s: appliance accepted the action but returned no request id", s.OperationID))
+		}
+
+		// The POST only means the request was accepted. Follow it to a
+		// terminal status before calling the step done.
+		final, err := c.awaitRequest(ctx, accepted.ID)
+		if final.Status != "" {
+			sr.Status = final.Status
+		}
+		if err != nil {
+			return fail(err)
+		}
+		if final.Status != "SUCCESSFUL" {
+			sr.Outcome = StepFailed
+			sr.Detail = strings.TrimSpace(final.Details)
+			if sr.Detail == "" {
+				sr.Detail = fmt.Sprintf("request %s finished with status %s", final.ID, final.Status)
+			}
+			return sr
+		}
+		sr.Outcome = StepSucceeded
+		return sr
+
+	default:
+		// Read-only operations: success is a 2xx.
+		if err := c.do(ctx, s.OperationID, params, nil, nil); err != nil {
+			return fail(err)
+		}
+		sr.Outcome = StepSucceeded
+		return sr
+	}
+}

{
  "contract_version": "1.0.0",
  "name": "vsan-data-protection-protection-group-snapshot",
  "description": "Wire contract for creating a vSAN Data Protection protection-group snapshot as an asynchronous task, polling that task to a terminal state, and reading back the resulting snapshot. Derived directly from the VCF 9.1 vSAN Data Protection OpenAPI document; see docs/official_sources.json.",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "license": "Apache-2.0",
    "commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/vsan-data-protection/vsan-data-protection-openapi.yaml",
    "spec_sha256": "17e16930f9edffa70d87a844df1cd1e9cfb292d9e99316ffe59494d96cdb1c3a",
    "openapi": "3.0.3",
    "info_title": "Snapshot Appliance API",
    "info_version": "9.1.0.0"
  },
  "server": {
    "url_template": "https://{host}/api",
    "base_path": "/api",
    "note": "Every operation path below is relative to base_path. A request URI is base_path + path_template with path parameters substituted."
  },
  "security": {
    "scheme_name": "api_key_auth",
    "type": "apiKey",
    "in": "header",
    "header_name": "vmware-api-session-id",
    "note": "All three operations in this contract declare `security: [api_key_auth]` in the specification."
  },
  "operations": [
    {
      "operation_id": "Snapservice.Clusters.ProtectionGroups.Snapshots_create$Task",
      "spec_line": 3141,
      "method": "POST",
      "path_template": "/snapservice/clusters/{cluster}/protection-groups/{pg}/snapshots",
      "path_parameters": ["cluster", "pg"],
      "required_query": { "vmw-task": "true" },
      "allowed_query_parameters": ["vmw-task"],
      "request_body": {
        "required": true,
        "media_type": "application/json",
        "schema": "Snapservice.Clusters.ProtectionGroups.Snapshots.CreateSpec"
      },
      "success_response": {
        "status": 202,
        "media_type": "application/json",
        "schema": { "type": "string" },
        "description": "The response body is a bare JSON string holding the identifier of the task tracking the snapshot operation (resource type com.vmware.snapservice.task)."
      },
      "error_responses": [400, 401, 403, 404, 500, 503]
    },
    {
      "operation_id": "Snapservice.Tasks_get",
      "spec_line": 1471,
      "method": "GET",
      "path_template": "/snapservice/tasks/{task}",
      "path_parameters": ["task"],
      "required_query": {},
      "allowed_query_parameters": [],
      "request_body": null,
      "success_response": {
        "status": 200,
        "media_type": "application/json",
        "schema": "Snapservice.Tasks.Info"
      },
      "error_responses": [401, 403, 404, 500, 503]
    },
    {
      "operation_id": "Snapservice.Clusters.ProtectionGroups.Snapshots_get",
      "spec_line": 2988,
      "method": "GET",
      "path_template": "/snapservice/clusters/{cluster}/protection-groups/{pg}/snapshots/{snapshot}",
      "path_parameters": ["cluster", "pg", "snapshot"],
      "required_query": {},
      "allowed_query_parameters": [],
      "request_body": null,
      "success_response": {
        "status": 200,
        "media_type": "application/json",
        "schema": "Snapservice.Clusters.ProtectionGroups.Snapshots.Info"
      },
      "error_responses": [401, 403, 404, 500, 503]
    }
  ],
  "task_status": {
    "values": ["PENDING", "RUNNING", "BLOCKED", "SUCCEEDED", "FAILED"],
    "terminal": ["SUCCEEDED", "FAILED"],
    "non_terminal": ["PENDING", "RUNNING", "BLOCKED"],
    "note": "Classification derived from the Snapservice.Tasks.Info.status descriptions in the specification: PENDING is pending, RUNNING is in progress, BLOCKED is waiting on resources, SUCCEEDED completed successfully and FAILED failed. Only the last two describe a finished operation."
  },
  "schemas": {
    "Snapservice.Clusters.ProtectionGroups.Snapshots.CreateSpec": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the protection group snapshot."
        },
        "retention": {
          "$ref": "Snapservice.RetentionPeriod",
          "required": false,
          "absence_semantics": "If missing or null the snapshot is retained for the life of the cluster the protection group belongs to, or the life of the protection group itself. A caller that has no retention to express omits the property entirely."
        }
      }
    },
    "Snapservice.RetentionPeriod": {
      "type": "object",
      "required": ["unit", "duration"],
      "properties": {
        "unit": {
          "type": "string",
          "enum": ["MINUTE", "HOUR", "DAY", "WEEK", "MONTH", "YEAR"]
        },
        "duration": {
          "type": "integer",
          "format": "int64",
          "description": "Duration for the snapshot to be retained. Serialized as a JSON number."
        }
      }
    },
    "Snapservice.Tasks.Info": {
      "type": "object",
      "required": ["cancelable", "description", "operation", "service", "status"],
      "properties": {
        "status": { "type": "string", "enum": ["PENDING", "RUNNING", "BLOCKED", "SUCCEEDED", "FAILED"] },
        "cancelable": { "type": "boolean" },
        "description": { "$ref": "Vapi.Std.LocalizableMessage" },
        "service": { "type": "string" },
        "operation": { "type": "string" },
        "result": {
          "required": false,
          "description": "Result of the operation. The specification leaves this property untyped. It is missing or null when the operation returns no result or the result is not yet available."
        },
        "error": {
          "type": "object",
          "required": false,
          "description": "Description of the error when status is FAILED."
        },
        "progress": { "required": false },
        "parent": { "type": "string", "required": false },
        "target": { "required": false },
        "vc_task": { "type": "string", "required": false },
        "start_time": { "type": "string", "format": "date-time", "required": false },
        "end_time": { "type": "string", "format": "date-time", "required": false },
        "user": { "type": "string", "required": false }
      }
    },
    "Snapservice.Clusters.ProtectionGroups.Snapshots.Info": {
      "type": "object",
      "required": ["end_time", "name", "pg", "snapshot_type", "start_time", "vm_snapshots"],
      "properties": {
        "name": { "type": "string" },
        "snapshot_type": { "type": "string", "enum": ["SCHEDULED", "ONE_TIME", "SYSTEM_CREATED"] },
        "start_time": { "type": "string", "format": "date-time" },
        "end_time": { "type": "string", "format": "date-time" },
        "pg": { "type": "string" },
        "vm_snapshots": { "type": "array" },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "required": false,
          "absence_semantics": "Missing or null when the snapshot has no expiry."
        },
        "labels": { "type": "array", "required": false }
      }
    },
    "Vapi.Std.LocalizableMessage": {
      "type": "object",
      "required": ["args", "default_message", "id"],
      "properties": {
        "id": { "type": "string" },
        "default_message": { "type": "string" },
        "args": { "type": "array" }
      }
    }
  }
}

{
  "contractVersion": "1.0.0",
  "derivedFrom": {
    "repository": "vmware/vcf-api-specs",
    "specPath": "specifications/vcf-operations/vcf-operations-openapi.json",
    "commitSha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "openapi": "3.0.1",
    "infoTitle": "VMware Cloud Foundation Operations API",
    "infoVersion": "9.1.0.0",
    "license": "Apache-2.0"
  },
  "serverBasePath": "/suite-api",
  "security": {
    "schemeName": "Token-based-authorization",
    "type": "apiKey",
    "in": "header",
    "headerName": "Authorization",
    "appliesToAllOperations": true,
    "valueIsOpaque": true
  },
  "mediaType": "application/json",
  "operations": [
    {
      "operationId": "testConnection",
      "role": "precheck",
      "method": "POST",
      "path": "/api/adapters/testConnection",
      "queryParameters": [],
      "requestBodyRequired": true,
      "requestBodySchema": "create-adapter-instance",
      "responses": {
        "201": {
          "meaning": "connection to the data source succeeded",
          "schema": "adapter-instance"
        },
        "400": {
          "meaning": "connection test failed; the service returns detail explaining why"
        }
      }
    },
    {
      "operationId": "createAdapterInstance",
      "role": "mutation",
      "method": "POST",
      "path": "/api/adapters",
      "queryParameters": [
        {
          "name": "extractIdentifierDefaults",
          "in": "query",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Indicates whether need to return default value or null in a result for identifiers that have no/null value in request body"
        },
        {
          "name": "force",
          "in": "query",
          "type": "boolean",
          "required": false,
          "default": true,
          "description": "Proceed with adapter instance creation even if connection is not established"
        }
      ],
      "requestBodyRequired": true,
      "requestBodySchema": "create-adapter-instance",
      "responses": {
        "201": {
          "meaning": "the adapter instance was created",
          "schema": "adapter-instance"
        },
        "400": {
          "meaning": "creation failed; the service returns detail explaining why"
        }
      }
    }
  ],
  "schemas": {
    "create-adapter-instance": {
      "type": "object",
      "required": [
        "adapterKindKey",
        "name"
      ],
      "properties": {
        "adapterKindKey": {
          "type": "string"
        },
        "collectorGroupId": {
          "type": "string",
          "format": "uuid"
        },
        "collectorId": {
          "type": "string"
        },
        "credential": {
          "$ref": "credential"
        },
        "description": {
          "type": "string"
        },
        "monitoringInterval": {
          "type": "integer",
          "format": "int32",
          "minimum": 0
        },
        "monitoringIntervalSeconds": {
          "type": "integer",
          "format": "int32",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "physicalDatacenterId": {
          "type": "string",
          "format": "uuid"
        },
        "resourceIdentifiers": {
          "type": "array",
          "items": {
            "$ref": "name-value"
          }
        }
      }
    },
    "credential": {
      "type": "object",
      "required": [
        "adapterKindKey",
        "credentialKindKey",
        "name"
      ],
      "properties": {
        "adapterKindKey": {
          "type": "string"
        },
        "credentialKindKey": {
          "type": "string"
        },
        "editable": {
          "type": "boolean"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "name-value"
          }
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "name-value": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    }
  },
  "wireRules": {
    "omitUnsetOptionalProperties": true,
    "notes": [
      "An optional property that the caller did not set MUST be absent from the serialized request body.",
      "Absent is not the same as present-and-empty: do not emit null, \"\", 0, [] or {} as a stand-in for unset.",
      "The precheck and the mutation carry the same create-adapter-instance payload; serialize both from the same value."
    ]
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF 9.1 ordered estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "estateId", "targetRelease", "steps"],
  "properties": {
    "schemaVersion": {"const": 1},
    "estateId": {"type": "string", "minLength": 1},
    "targetRelease": {"const": "9.1.0.0"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "componentId", "componentName", "componentType", "fromVersion", "targetProduct", "targetVersion", "action", "dependsOn", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "componentId": {"type": "string", "minLength": 1},
          "componentName": {"type": "string", "minLength": 1},
          "componentType": {"type": "string", "minLength": 1},
          "fromVersion": {"type": "string", "minLength": 1},
          "targetProduct": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "action": {"enum": ["UPGRADE", "MIGRATE", "DECOMMISSION", "CONVERGE"]},
          "dependsOn": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "condition"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "condition": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}

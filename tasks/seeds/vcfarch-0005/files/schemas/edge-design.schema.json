{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCF Edge architecture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetRelease", "sites"],
  "properties": {
    "schemaVersion": {"const": 1},
    "targetRelease": {"type": "string"},
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["siteId", "role", "edgeClusterName", "haMode", "nodeFailureTolerance", "requiredPeakGbps", "edgeFormFactor", "capacityPerNodeGbps", "survivingCapacityGbps", "nodes"],
        "properties": {
          "siteId": {"type": "string", "minLength": 1},
          "role": {"enum": ["PRIMARY", "RECOVERY"]},
          "edgeClusterName": {"type": "string", "minLength": 1},
          "haMode": {"const": "ACTIVE_ACTIVE"},
          "nodeFailureTolerance": {"type": "integer", "minimum": 1},
          "requiredPeakGbps": {"type": "number", "exclusiveMinimum": 0},
          "edgeFormFactor": {"enum": ["MEDIUM", "LARGE", "XLARGE"]},
          "capacityPerNodeGbps": {"type": "number", "exclusiveMinimum": 0},
          "survivingCapacityGbps": {"type": "number", "exclusiveMinimum": 0},
          "nodes": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "uplinks"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "uplinks": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "speedGbps", "fabric", "vlanId"],
                    "properties": {
                      "name": {"type": "string", "minLength": 1},
                      "speedGbps": {"type": "integer", "minimum": 1},
                      "fabric": {"type": "string", "minLength": 1},
                      "vlanId": {"type": "integer", "minimum": 1, "maximum": 4094}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

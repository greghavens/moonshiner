diff --git a/VcfArchitecture/VcfArchitecture.psm1 b/VcfArchitecture/VcfArchitecture.psm1
new file mode 100644
index 0000000..6d2318d
--- /dev/null
+++ b/VcfArchitecture/VcfArchitecture.psm1
@@ -0,0 +1,424 @@
+Set-StrictMode -Version Latest
+
+function Read-VcfJson {
+    param([Parameter(Mandatory)][string]$Path)
+    Get-Content -LiteralPath $Path -Raw | ConvertFrom-Json -Depth 100
+}
+
+function Write-VcfJson {
+    param(
+        [Parameter(Mandatory)]$InputObject,
+        [Parameter(Mandatory)][string]$Path
+    )
+    $InputObject | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $Path -Encoding utf8
+}
+
+function New-VcfArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][string]$ScenarioPath,
+        [Parameter(Mandatory)][string]$InventoryPath,
+        [Parameter(Mandatory)][string]$CompatibilitySnapshotPath,
+        [Parameter(Mandatory)][string]$OutputDirectory
+    )
+
+    $scenario = Read-VcfJson -Path $ScenarioPath
+    $inventory = Read-VcfJson -Path $InventoryPath
+    $snapshot = Read-VcfJson -Path $CompatibilitySnapshotPath
+    New-Item -ItemType Directory -Path $OutputDirectory -Force | Out-Null
+
+    $hostSpecs = @($scenario.installation.hostnames | ForEach-Object {
+        [ordered]@{ hostname = $_ }
+    })
+    $networkSpecs = @($scenario.networks | ForEach-Object {
+        [ordered]@{
+            networkType = $_.networkType
+            subnet = $_.subnet
+            gateway = $_.gateway
+            subnetMask = $_.subnetMask
+            includeIpAddressRanges = @(
+                [ordered]@{ startIpAddress = $_.start; endIpAddress = $_.end }
+            )
+            vlanId = [int]$_.vlanId
+            mtu = [int]$_.mtu
+            ipAddressVersion = 'IPv4'
+            ipAddressAssignmentMode = 'STATIC'
+        }
+    })
+    $dvsSpecs = @($scenario.distributedSwitches | ForEach-Object {
+        $dvs = [ordered]@{
+            dvsName = $_.name
+            networks = @($_.networks)
+            mtu = [int]$_.mtu
+            vmnicsToUplinks = @($_.vmnicsToUplinks | ForEach-Object {
+                [ordered]@{ id = $_.id; uplink = $_.uplink }
+            })
+        }
+        if ($_.PSObject.Properties.Name -contains 'transportZones') {
+            $dvs.nsxtSwitchConfig = [ordered]@{
+                transportZones = @($_.transportZones | ForEach-Object {
+                    [ordered]@{ name = $_.name; transportType = $_.transportType }
+                })
+                hostSwitchOperationalMode = 'STANDARD'
+                ipAssignmentType = 'STATIC'
+            }
+            $dvs.nsxTeamings = @(
+                [ordered]@{
+                    policy = $_.teaming.policy
+                    activeUplinks = @($_.teaming.activeUplinks)
+                    standByUplinks = @($_.teaming.standByUplinks)
+                }
+            )
+        }
+        $dvs
+    })
+
+    $install = $scenario.installation
+    $nsx = $install.nsx
+    $services = $install.managementServices
+    $sddcSpec = [ordered]@{
+        sddcId = $install.sddcId
+        workflowType = 'VCF'
+        hostSpecs = $hostSpecs
+        version = $scenario.targetRelease
+        vcenterSpec = [ordered]@{
+            vcenterHostname = $install.vcenter.hostname
+            rootVcenterPassword = $install.vcenter.rootPassword
+            vmSize = $install.vcenter.vmSize
+            storageSize = $install.vcenter.storageSize
+            ssoDomain = $install.vcenter.ssoDomain
+            version = $scenario.targetRelease
+            useExistingDeployment = $false
+        }
+        clusterSpec = [ordered]@{
+            datacenterName = $install.cluster.datacenterName
+            clusterName = $install.cluster.clusterName
+            clusterEvcMode = $install.cluster.evcMode
+        }
+        dvsSpecs = $dvsSpecs
+        nsxtSpec = [ordered]@{
+            nsxtManagers = @($nsx.managerHostnames | ForEach-Object { [ordered]@{ hostname = $_ } })
+            nsxtManagerSize = $nsx.managerSize
+            vipFqdn = $nsx.vipFqdn
+            rootNsxtManagerPassword = $nsx.rootPassword
+            nsxtAdminPassword = $nsx.adminPassword
+            nsxtAuditPassword = $nsx.auditPassword
+            transportVlanId = [int]$nsx.transportVlanId
+            ipAddressPoolSpec = [ordered]@{
+                name = $nsx.tepPoolName
+                description = 'DAL01 management-domain host TEP pool'
+                ignoreUnavailableNsxtCluster = $false
+                subnets = @(
+                    [ordered]@{
+                        ipAddressPoolRanges = @([ordered]@{ start = $nsx.tepStart; end = $nsx.tepEnd })
+                        cidr = $nsx.tepCidr
+                        gateway = $nsx.tepGateway
+                    }
+                )
+            }
+            skipNsxOverlayOverManagementNetwork = $false
+            enableEdgeClusterSync = $false
+            version = $scenario.targetRelease
+            useExistingDeployment = $false
+        }
+        networkSpecs = $networkSpecs
+        dnsSpec = [ordered]@{ subdomain = $install.dnsSubdomain; nameservers = @($install.dnsServers) }
+        ntpServers = @($install.ntpServers)
+        sddcManagerSpec = [ordered]@{
+            rootPassword = $install.sddcManager.rootPassword
+            hostname = $install.sddcManager.hostname
+            sshPassword = $install.sddcManager.sshPassword
+            localUserPassword = $install.sddcManager.localUserPassword
+            version = $scenario.targetRelease
+            useExistingDeployment = $false
+        }
+        managementPoolName = $install.managementPoolName
+        ceipEnabled = $false
+        skipEsxThumbprintValidation = $false
+        skipGatewayPingValidation = $false
+        securitySpec = [ordered]@{ esxiCertsMode = 'VMCA' }
+        datastoreSpec = [ordered]@{
+            vsanSpec = [ordered]@{
+                datastoreName = 'dal01-m01-vsan-esa'
+                vsanDedup = $false
+                esaConfig = [ordered]@{ enabled = [bool]$scenario.availability.requireVsanEsa }
+                failuresToTolerate = [int]$scenario.availability.managementHostFailuresToTolerate
+            }
+        }
+        vspClusterSpec = [ordered]@{
+            platformFqdn = $services.platformFqdn
+            systemUserPassword = $services.systemUserPassword
+            ipv4Pool = [ordered]@{
+                cidr = $services.ipv4Cidr
+                ipRange = [ordered]@{ startIpAddress = $services.ipv4Start; endIpAddress = $services.ipv4End }
+            }
+            size = 'small'
+            internalClusterCidrIpv4 = $services.internalClusterCidr
+            instanceFqdn = $services.instanceFqdn
+            fleetFqdn = $services.fleetFqdn
+            version = $scenario.targetRelease
+            useExistingDeployment = $false
+        }
+        fleetLcmSpec = [ordered]@{ version = $scenario.targetRelease; size = 'small' }
+        sddcLcmSpec = [ordered]@{ version = $scenario.targetRelease; size = 'small' }
+        fleetDepotSpec = [ordered]@{ version = $scenario.targetRelease; size = 'small' }
+        telemetryAcceptorSpec = [ordered]@{ version = $scenario.targetRelease; size = 'small' }
+        vidbSpec = [ordered]@{ hostname = $services.identityBrokerHostname; version = $scenario.targetRelease; size = 'small' }
+        saltSpec = [ordered]@{ version = $scenario.targetRelease; size = 'small' }
+        saltRaasSpec = [ordered]@{ version = $scenario.targetRelease; size = 'small' }
+        vcfManagementComponentsInfrastructureSpec = [ordered]@{
+            localRegionNetwork = [ordered]@{
+                networkName = 'FLEET_MANAGEMENT'
+                subnetMask = '255.255.255.0'
+                gateway = '10.40.40.1'
+            }
+        }
+        licenseServerSpec = [ordered]@{
+            hostname = $services.licenseServerHostname
+            version = $scenario.targetRelease
+            useExistingDeployment = $false
+        }
+        vcfInstanceName = $install.vcfInstanceName
+    }
+
+    $edgeSites = @($scenario.sites | ForEach-Object {
+        $site = $_
+        $chosen = $snapshot.edgeFormFactors |
+            Where-Object {
+                $_.maxPeakGbpsPerNode -ge $site.requiredPeakNorthSouthGbps -and
+                $_.supportedUplinkSpeedsGbps -contains [int]$site.uplinkSpeedGbps -and
+                $site.uplinks.Count -ge $_.minimumDatapathUplinks
+            } |
+            Sort-Object rank |
+            Select-Object -First 1
+        if ($null -eq $chosen) {
+            throw "No supported Edge form factor satisfies $($site.siteId)"
+        }
+        $nodes = @($site.edgeNodeNames | ForEach-Object {
+            $nodeName = $_
+            [ordered]@{
+                name = $nodeName
+                uplinks = @($site.uplinks | ForEach-Object {
+                    [ordered]@{
+                        name = $_.name
+                        speedGbps = [int]$site.uplinkSpeedGbps
+                        fabric = $_.fabric
+                        vlanId = [int]$_.vlanId
+                    }
+                })
+            }
+        })
+        [ordered]@{
+            siteId = $site.siteId
+            role = $site.role
+            edgeClusterName = $site.edgeClusterName
+            haMode = 'ACTIVE_ACTIVE'
+            nodeFailureTolerance = [int]$scenario.availability.edgeNodeFailureTolerance
+            requiredPeakGbps = [int]$site.requiredPeakNorthSouthGbps
+            edgeFormFactor = $chosen.name
+            capacityPerNodeGbps = [int]$chosen.maxPeakGbpsPerNode
+            survivingCapacityGbps = [int]$chosen.maxPeakGbpsPerNode
+            nodes = $nodes
+        }
+    })
+    $edgeDesign = [ordered]@{
+        schemaVersion = 1
+        targetRelease = $scenario.targetRelease
+        sites = $edgeSites
+    }
+
+    $componentsById = @{}
+    foreach ($component in $inventory.components) {
+        $componentsById[$component.id] = $component
+    }
+    $steps = @($snapshot.migrationPaths | Sort-Object sequence | ForEach-Object {
+        $path = $_
+        $component = $componentsById[$path.componentId]
+        if ($null -eq $component) {
+            throw "Compatibility path names unknown component $($path.componentId)"
+        }
+        [ordered]@{
+            order = [int]$path.sequence
+            componentId = $component.id
+            componentName = $component.name
+            componentType = $component.type
+            fromVersion = $component.version
+            targetProduct = $path.targetProduct
+            targetVersion = $path.targetVersion
+            action = $path.action
+            dependsOn = @($path.dependsOn)
+            gates = @($path.requiredGateIds | ForEach-Object {
+                $gateId = $_
+                [ordered]@{ id = $gateId; condition = $snapshot.gateCatalog.$gateId }
+            })
+        }
+    })
+    $migrationPlan = [ordered]@{
+        schemaVersion = 1
+        estateId = $inventory.estateId
+        targetRelease = $snapshot.targetRelease
+        steps = $steps
+    }
+
+    Write-VcfJson -InputObject $sddcSpec -Path (Join-Path $OutputDirectory 'sddc-spec.json')
+    Write-VcfJson -InputObject $edgeDesign -Path (Join-Path $OutputDirectory 'edge-design.json')
+    Write-VcfJson -InputObject $migrationPlan -Path (Join-Path $OutputDirectory 'migration-plan.json')
+}
+
+function Test-VcfInstallerArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][string]$Server,
+        [Parameter(Mandatory)][PSCredential]$Credential,
+        [Parameter(Mandatory)][string]$SpecPath
+    )
+
+    $raw = Read-VcfJson -Path $SpecPath
+    $connection = Connect-VcfInstallerServer -Server $Server -Credential $Credential
+    try {
+        $operation = Get-VcfInstallerOperation -Method POST -Path '/v1/sddcs/validations'
+        if ($null -eq $operation) {
+            throw 'The installed SDK did not expose the SddcSpec validation operation.'
+        }
+
+        $hosts = @($raw.hostSpecs | ForEach-Object {
+            Initialize-VcfInstallerSddcHostSpec -Hostname $_.hostname
+        })
+        $vcenter = Initialize-VcfInstallerSddcVcenterSpec `
+            -VcenterHostname $raw.vcenterSpec.vcenterHostname `
+            -RootVcenterPassword $raw.vcenterSpec.rootVcenterPassword `
+            -VmSize $raw.vcenterSpec.vmSize `
+            -StorageSize $raw.vcenterSpec.storageSize `
+            -SsoDomain $raw.vcenterSpec.ssoDomain `
+            -Version $raw.vcenterSpec.version `
+            -UseExistingDeployment $raw.vcenterSpec.useExistingDeployment
+        $cluster = Initialize-VcfInstallerSddcClusterSpec `
+            -DatacenterName $raw.clusterSpec.datacenterName `
+            -ClusterName $raw.clusterSpec.clusterName `
+            -ClusterEvcMode $raw.clusterSpec.clusterEvcMode
+        $dvsSpecs = @($raw.dvsSpecs | ForEach-Object {
+            $dvsRaw = $_
+            $mappings = @($dvsRaw.vmnicsToUplinks | ForEach-Object {
+                Initialize-VcfInstallerVmnicToUplink -Id $_.id -Uplink $_.uplink
+            })
+            $dvsArgs = @{
+                DvsName = $dvsRaw.dvsName
+                Networks = @($dvsRaw.networks)
+                Mtu = [uint]$dvsRaw.mtu
+                VmnicsToUplinks = $mappings
+            }
+            if ($dvsRaw.PSObject.Properties.Name -contains 'nsxtSwitchConfig') {
+                $zones = @($dvsRaw.nsxtSwitchConfig.transportZones | ForEach-Object {
+                    Initialize-VcfInstallerTransportZone -Name $_.name -TransportType $_.transportType
+                })
+                $dvsArgs.NsxtSwitchConfig = Initialize-VcfInstallerNsxtSwitchConfig `
+                    -TransportZones $zones `
+                    -HostSwitchOperationalMode $dvsRaw.nsxtSwitchConfig.hostSwitchOperationalMode `
+                    -IpAssignmentType $dvsRaw.nsxtSwitchConfig.ipAssignmentType
+                $dvsArgs.NsxTeamings = @($dvsRaw.nsxTeamings | ForEach-Object {
+                    Initialize-VcfInstallerTeamingSpec -Policy $_.policy -ActiveUplinks @($_.activeUplinks) -StandByUplinks @($_.standByUplinks)
+                })
+            }
+            Initialize-VcfInstallerDvsSpec @dvsArgs
+        })
+        $nsxManagers = @($raw.nsxtSpec.nsxtManagers | ForEach-Object {
+            Initialize-VcfInstallerNsxtManagerSpec -Hostname $_.hostname
+        })
+        $tepSubnets = @($raw.nsxtSpec.ipAddressPoolSpec.subnets | ForEach-Object {
+            $ranges = @($_.ipAddressPoolRanges | ForEach-Object {
+                Initialize-VcfInstallerIpAddressPoolRangeSpec -Start $_.start -VarEnd $_.end
+            })
+            Initialize-VcfInstallerIpAddressPoolSubnetSpec -IpAddressPoolRanges $ranges -Cidr $_.cidr -Gateway $_.gateway
+        })
+        $tepPool = Initialize-VcfInstallerIpAddressPoolSpec `
+            -Name $raw.nsxtSpec.ipAddressPoolSpec.name `
+            -Description $raw.nsxtSpec.ipAddressPoolSpec.description `
+            -IgnoreUnavailableNsxtCluster $raw.nsxtSpec.ipAddressPoolSpec.ignoreUnavailableNsxtCluster `
+            -Subnets $tepSubnets
+        $nsxt = Initialize-VcfInstallerSddcNsxtSpec `
+            -NsxtManagers $nsxManagers `
+            -NsxtManagerSize $raw.nsxtSpec.nsxtManagerSize `
+            -VipFqdn $raw.nsxtSpec.vipFqdn `
+            -RootNsxtManagerPassword $raw.nsxtSpec.rootNsxtManagerPassword `
+            -NsxtAdminPassword $raw.nsxtSpec.nsxtAdminPassword `
+            -NsxtAuditPassword $raw.nsxtSpec.nsxtAuditPassword `
+            -TransportVlanId ([uint]$raw.nsxtSpec.transportVlanId) `
+            -IpAddressPoolSpec $tepPool `
+            -SkipNsxOverlayOverManagementNetwork $raw.nsxtSpec.skipNsxOverlayOverManagementNetwork `
+            -EnableEdgeClusterSync $raw.nsxtSpec.enableEdgeClusterSync `
+            -Version $raw.nsxtSpec.version `
+            -UseExistingDeployment $raw.nsxtSpec.useExistingDeployment
+        $networks = @($raw.networkSpecs | ForEach-Object {
+            $networkRaw = $_
+            $ranges = @($networkRaw.includeIpAddressRanges | ForEach-Object {
+                Initialize-VcfInstallerIpRange -StartIpAddress $_.startIpAddress -EndIpAddress $_.endIpAddress
+            })
+            Initialize-VcfInstallerSddcNetworkSpec `
+                -NetworkType $networkRaw.networkType -Subnet $networkRaw.subnet `
+                -Gateway $networkRaw.gateway -SubnetMask $networkRaw.subnetMask `
+                -IncludeIpAddressRanges $ranges -VlanId ([uint]$networkRaw.vlanId) `
+                -Mtu ([uint]$networkRaw.mtu) -IpAddressVersion $networkRaw.ipAddressVersion `
+                -IpAddressAssignmentMode $networkRaw.ipAddressAssignmentMode
+        })
+        $dns = Initialize-VcfInstallerDnsSpec -Subdomain $raw.dnsSpec.subdomain -Nameservers @($raw.dnsSpec.nameservers)
+        $manager = Initialize-VcfInstallerSddcManagerSpec `
+            -RootPassword $raw.sddcManagerSpec.rootPassword -Hostname $raw.sddcManagerSpec.hostname `
+            -SshPassword $raw.sddcManagerSpec.sshPassword -LocalUserPassword $raw.sddcManagerSpec.localUserPassword `
+            -Version $raw.sddcManagerSpec.version -UseExistingDeployment $raw.sddcManagerSpec.useExistingDeployment
+        $security = Initialize-VcfInstallerSecuritySpec -EsxiCertsMode $raw.securitySpec.esxiCertsMode
+        $esa = Initialize-VcfInstallerVsanEsaConfig -Enabled $raw.datastoreSpec.vsanSpec.esaConfig.enabled
+        $vsan = Initialize-VcfInstallerVsanSpec `
+            -DatastoreName $raw.datastoreSpec.vsanSpec.datastoreName `
+            -VsanDedup $raw.datastoreSpec.vsanSpec.vsanDedup `
+            -EsaConfig $esa -FailuresToTolerate ([uint]$raw.datastoreSpec.vsanSpec.failuresToTolerate
+            )
+        $datastore = Initialize-VcfInstallerSddcDatastoreSpec -VsanSpec $vsan
+        $vspRange = Initialize-VcfInstallerIpRange `
+            -StartIpAddress $raw.vspClusterSpec.ipv4Pool.ipRange.startIpAddress `
+            -EndIpAddress $raw.vspClusterSpec.ipv4Pool.ipRange.endIpAddress
+        $vspPool = Initialize-VcfInstallerIPv4Pool -Cidr $raw.vspClusterSpec.ipv4Pool.cidr -IpRange $vspRange
+        $vsp = Initialize-VcfInstallerSddcVspClusterSpec `
+            -PlatformFqdn $raw.vspClusterSpec.platformFqdn `
+            -SystemUserPassword $raw.vspClusterSpec.systemUserPassword `
+            -Ipv4Pool $vspPool -Size $raw.vspClusterSpec.size `
+            -InternalClusterCidrIpv4 $raw.vspClusterSpec.internalClusterCidrIpv4 `
+            -InstanceFqdn $raw.vspClusterSpec.instanceFqdn -FleetFqdn $raw.vspClusterSpec.fleetFqdn `
+            -Version $raw.vspClusterSpec.version -UseExistingDeployment $raw.vspClusterSpec.useExistingDeployment
+        $fleetLcm = Initialize-VcfInstallerFleetLcmServiceSpec -Version $raw.fleetLcmSpec.version -Size $raw.fleetLcmSpec.size
+        $sddcLcm = Initialize-VcfInstallerSddcLcmServiceSpec -Version $raw.sddcLcmSpec.version -Size $raw.sddcLcmSpec.size
+        $fleetDepot = Initialize-VcfInstallerFleetDepotServiceSpec -Version $raw.fleetDepotSpec.version -Size $raw.fleetDepotSpec.size
+        $telemetry = Initialize-VcfInstallerTelemetryAcceptorSpec -Version $raw.telemetryAcceptorSpec.version -Size $raw.telemetryAcceptorSpec.size
+        $vidb = Initialize-VcfInstallerVidbSpec -Hostname $raw.vidbSpec.hostname -Version $raw.vidbSpec.version -Size $raw.vidbSpec.size
+        $salt = Initialize-VcfInstallerSaltSpec -Version $raw.saltSpec.version -Size $raw.saltSpec.size
+        $saltRaas = Initialize-VcfInstallerSaltSpec -Version $raw.saltRaasSpec.version -Size $raw.saltRaasSpec.size
+        $localNetwork = Initialize-VcfInstallerVcfManagementComponentsNetworkSpec `
+            -NetworkName $raw.vcfManagementComponentsInfrastructureSpec.localRegionNetwork.networkName `
+            -SubnetMask $raw.vcfManagementComponentsInfrastructureSpec.localRegionNetwork.subnetMask `
+            -Gateway $raw.vcfManagementComponentsInfrastructureSpec.localRegionNetwork.gateway
+        $managementInfrastructure = Initialize-VcfInstallerVcfManagementComponentsInfrastructureSpec -LocalRegionNetwork $localNetwork
+        $licenseServer = Initialize-VcfInstallerLicenseServerSpec `
+            -Hostname $raw.licenseServerSpec.hostname -Version $raw.licenseServerSpec.version `
+            -UseExistingDeployment $raw.licenseServerSpec.useExistingDeployment
+
+        $sdkSpec = Initialize-VcfInstallerSddcSpec `
+            -SddcId $raw.sddcId -WorkflowType $raw.workflowType -HostSpecs $hosts -Version $raw.version `
+            -VcenterSpec $vcenter -ClusterSpec $cluster -DvsSpecs $dvsSpecs -NsxtSpec $nsxt `
+            -NetworkSpecs $networks -DnsSpec $dns -NtpServers @($raw.ntpServers) `
+            -SddcManagerSpec $manager -ManagementPoolName $raw.managementPoolName `
+            -CeipEnabled $raw.ceipEnabled -SkipEsxThumbprintValidation $raw.skipEsxThumbprintValidation `
+            -SkipGatewayPingValidation $raw.skipGatewayPingValidation -SecuritySpec $security `
+            -DatastoreSpec $datastore -VspClusterSpec $vsp -FleetLcmSpec $fleetLcm `
+            -SddcLcmSpec $sddcLcm -FleetDepotSpec $fleetDepot -TelemetryAcceptorSpec $telemetry `
+            -VidbSpec $vidb -SaltSpec $salt -SaltRaasSpec $saltRaas `
+            -VcfManagementComponentsInfrastructureSpec $managementInfrastructure `
+            -LicenseServerSpec $licenseServer -VcfInstanceName $raw.vcfInstanceName
+        Invoke-VcfInstallerValidateSddcSpec -SddcSpec $sdkSpec
+    }
+    finally {
+        if ($null -ne $connection) {
+            Disconnect-VcfInstallerServer -Server $connection -Force
+        }
+    }
+}
+
+Export-ModuleMember -Function New-VcfArchitecture, Test-VcfInstallerArchitecture

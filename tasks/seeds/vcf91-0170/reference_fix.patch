+function New-VcfOpsLogForwarderIfAbsent {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [uri] $BaseUri,
+
+        [Parameter(Mandatory)]
+        [AllowEmptyString()]
+        [string] $LogToken,
+
+        [Parameter(Mandatory)]
+        [AllowEmptyString()]
+        [string] $Name,
+
+        [Parameter(Mandatory)]
+        [AllowEmptyString()]
+        [string] $Host,
+
+        [Parameter(Mandatory)]
+        [int] $Port,
+
+        [Parameter(Mandatory)]
+        [string] $Protocol,
+
+        [Parameter(Mandatory)]
+        [bool] $SslEnabled,
+
+        [Parameter(Mandatory)]
+        [string] $TransportProtocol,
+
+        [Parameter(Mandatory)]
+        [bool] $Enabled,
+
+        [Parameter()]
+        [Net.Http.HttpClient] $HttpClient
+    )
+
+    $Origin = Resolve-VcfOpsLogForwarderOrigin -BaseUri $BaseUri
+    Assert-VcfOpsLogForwarderToken -Value $LogToken
+    Assert-VcfOpsLogForwarderText -Value $Name -Name 'Name'
+    Assert-VcfOpsLogForwarderText -Value $Host -Name 'Host'
+    if ($Port -lt 1 -or $Port -gt 65535) {
+        throw [ArgumentOutOfRangeException]::new(
+            'Port',
+            'Port must be between 1 and 65535.'
+        )
+    }
+    Assert-VcfOpsLogForwarderEnum `
+        -Value $Protocol `
+        -Allowed @('SYSLOG', 'RAW', 'RAWPLUS') `
+        -Name 'Protocol'
+    Assert-VcfOpsLogForwarderEnum `
+        -Value $TransportProtocol `
+        -Allowed @('TCP', 'UDP') `
+        -Name 'TransportProtocol'
+
+    $JsonBody = New-VcfOpsLogForwarderJson `
+        -Enabled $Enabled `
+        -HostName $Host `
+        -ForwarderName $Name `
+        -Port $Port `
+        -Protocol $Protocol `
+        -SslEnabled $SslEnabled `
+        -TransportProtocol $TransportProtocol
+
+    $OwnedClient = $null
+    if ($null -eq $HttpClient) {
+        $Handler = [Net.Http.HttpClientHandler]::new()
+        $Handler.AllowAutoRedirect = $false
+        $OwnedClient = [Net.Http.HttpClient]::new($Handler, $true)
+        $HttpClient = $OwnedClient
+    }
+
+    try {
+        $Endpoint = [uri]::new($Origin, '/api/v2/logs/forwarders')
+        $Precheck = Invoke-VcfOpsLogForwarderRequest `
+            -Client $HttpClient `
+            -Method ([Net.Http.HttpMethod]::Get) `
+            -Uri $Endpoint `
+            -LogToken $LogToken `
+            -OperationId 'getAllLogForwarders'
+        if ($Precheck.StatusCode -ne 200) {
+            throw [InvalidOperationException]::new(
+                "getAllLogForwarders failed with HTTP status " +
+                "$($Precheck.StatusCode)."
+            )
+        }
+        Assert-VcfOpsLogForwarderPrecheck `
+            -Text $Precheck.Text `
+            -Name $Name
+
+        $Created = Invoke-VcfOpsLogForwarderRequest `
+            -Client $HttpClient `
+            -Method ([Net.Http.HttpMethod]::Post) `
+            -Uri $Endpoint `
+            -LogToken $LogToken `
+            -OperationId 'createLogForwarder' `
+            -JsonBody $JsonBody
+        if ($Created.StatusCode -ne 201) {
+            throw [InvalidOperationException]::new(
+                "createLogForwarder failed with HTTP status " +
+                "$($Created.StatusCode)."
+            )
+        }
+
+        $Id = Get-VcfOpsLogForwarderCreatedId `
+            -Text $Created.Text `
+            -Enabled $Enabled `
+            -HostName $Host `
+            -ForwarderName $Name `
+            -Port $Port `
+            -Protocol $Protocol `
+            -SslEnabled $SslEnabled `
+            -TransportProtocol $TransportProtocol
+
+        return [pscustomobject] [ordered] @{
+            Created = $true
+            OperationId = 'createLogForwarder'
+            Id = $Id
+        }
+    }
+    finally {
+        if ($null -ne $OwnedClient) {
+            $OwnedClient.Dispose()
+        }
+    }
+}
 
 Export-ModuleMember -Function New-VcfOpsLogForwarderIfAbsent

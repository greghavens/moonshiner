{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VCF Management Estate Migration Installer Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "estateId",
    "fixture",
    "target",
    "supportBoundaries",
    "storageDecision",
    "componentPlacements",
    "resourceSummary",
    "transitions",
    "gates",
    "migrationPlan",
    "vcfInstallerBindings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventoryId",
        "compatibilitySnapshotId"
      ],
      "properties": {
        "inventoryId": {
          "type": "string",
          "minLength": 1
        },
        "compatibilitySnapshotId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vcfVersion",
        "managementDomain",
        "managementCluster"
      ],
      "properties": {
        "vcfVersion": {
          "type": "string",
          "minLength": 1
        },
        "managementDomain": {
          "type": "string",
          "minLength": 1
        },
        "managementCluster": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "supportBoundaries": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/definitions/supportBoundary"
      }
    },
    "storageDecision": {
      "$ref": "#/definitions/storageDecision"
    },
    "componentPlacements": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/definitions/componentPlacement"
      }
    },
    "resourceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managementNodeCount",
        "totalVcpu",
        "totalMemoryGiB",
        "totalDiskGiB",
        "selectedHostCount"
      ],
      "properties": {
        "managementNodeCount": {
          "type": "integer",
          "minimum": 1
        },
        "totalVcpu": {
          "type": "integer",
          "minimum": 1
        },
        "totalMemoryGiB": {
          "type": "integer",
          "minimum": 1
        },
        "totalDiskGiB": {
          "type": "integer",
          "minimum": 1
        },
        "selectedHostCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/definitions/transition"
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/gate"
      }
    },
    "migrationPlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/planStep"
      }
    },
    "vcfInstallerBindings": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/definitions/installerBinding"
      }
    }
  },
  "definitions": {
    "supportBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "product",
        "version",
        "kind",
        "date"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "end-of-general-support"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "storageDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectedOption",
        "rationaleCode",
        "options",
        "networkChanges"
      ],
      "properties": {
        "selectedOption": {
          "enum": [
            "OSA",
            "ESA"
          ]
        },
        "rationaleCode": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/definitions/storageOption"
          }
        },
        "networkChanges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/networkChange"
          }
        }
      }
    },
    "storageOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "option",
        "architecture",
        "poolId",
        "requiredHostCount",
        "selectedHostnames",
        "minimumVsanNetworkGbps",
        "requiredMtu",
        "readyNodeProfile",
        "usesExistingLeafFabric"
      ],
      "properties": {
        "option": {
          "enum": [
            "OSA",
            "ESA"
          ]
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "poolId": {
          "type": "string",
          "minLength": 1
        },
        "requiredHostCount": {
          "type": "integer",
          "minimum": 1
        },
        "selectedHostnames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "minimumVsanNetworkGbps": {
          "type": "integer",
          "minimum": 1
        },
        "requiredMtu": {
          "type": "integer",
          "minimum": 1500
        },
        "readyNodeProfile": {
          "type": "string",
          "minLength": 1
        },
        "usesExistingLeafFabric": {
          "type": "boolean"
        }
      }
    },
    "networkChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "fromGbps",
        "toGbps",
        "traffic"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 12
        },
        "fromGbps": {
          "type": "integer",
          "minimum": 1
        },
        "toGbps": {
          "type": "integer",
          "minimum": 1
        },
        "traffic": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "componentPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "version",
        "managementDomain",
        "cluster",
        "resourcePool",
        "storagePolicy",
        "nodeCount",
        "nodeShape",
        "antiAffinity",
        "network"
      ],
      "properties": {
        "component": {
          "enum": [
            "VCF Operations",
            "VCF Operations Fleet Management",
            "VCF Automation",
            "VCF Operations for Logs"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "managementDomain": {
          "type": "string",
          "minLength": 1
        },
        "cluster": {
          "type": "string",
          "minLength": 1
        },
        "resourcePool": {
          "type": "string",
          "minLength": 1
        },
        "storagePolicy": {
          "type": "string",
          "minLength": 1
        },
        "nodeCount": {
          "type": "integer",
          "minimum": 1
        },
        "nodeShape": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vCpu",
            "memoryGiB",
            "diskGiB"
          ],
          "properties": {
            "vCpu": {
              "type": "integer",
              "minimum": 1
            },
            "memoryGiB": {
              "type": "integer",
              "minimum": 1
            },
            "diskGiB": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "antiAffinity": {
          "type": "boolean"
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "segment",
            "vlan",
            "serviceAddress"
          ],
          "properties": {
            "segment": {
              "type": "string",
              "minLength": 1
            },
            "vlan": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4094
            },
            "serviceAddress": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceProduct",
        "sourceVersion",
        "targetComponent",
        "targetVersion",
        "migrationMode",
        "carryForward",
        "abandoned",
        "stepRefs"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceProduct": {
          "type": "string",
          "minLength": 1
        },
        "sourceVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetComponent": {
          "enum": [
            "VCF Operations",
            "VCF Automation",
            "VCF Operations for Logs"
          ]
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1
        },
        "migrationMode": {
          "type": "string",
          "minLength": 1
        },
        "carryForward": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/carriedItem"
          }
        },
        "abandoned": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/abandonedItem"
          }
        },
        "stepRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "carriedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "method",
        "verification"
      ],
      "properties": {
        "itemId": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 12
        },
        "verification": {
          "type": "string",
          "minLength": 12
        }
      }
    },
    "abandonedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "reason",
        "finalDisposition"
      ],
      "properties": {
        "itemId": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 12
        },
        "finalDisposition": {
          "type": "string",
          "minLength": 12
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 12
        }
      }
    },
    "planStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "id",
        "action",
        "description",
        "dependsOn",
        "gateIds",
        "affectedProducts"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 8
        },
        "description": {
          "type": "string",
          "minLength": 12
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gateIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "affectedProducts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "installerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "method",
        "purpose"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/v1/"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PATCH",
            "PUT",
            "DELETE"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 8
        }
      }
    }
  }
}

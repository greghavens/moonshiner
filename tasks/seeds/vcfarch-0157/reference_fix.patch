+++ b/VcfMigrationArchitecture/VcfMigrationArchitecture.psm1
@@ -0,0 +1,308 @@
+Set-StrictMode -Version Latest
+
+function Read-JsonDocument {
+    [CmdletBinding()]
+    param([Parameter(Mandatory)][string] $LiteralPath)
+
+    if (-not (Test-Path -LiteralPath $LiteralPath -PathType Leaf)) {
+        throw "JSON input does not exist: $LiteralPath"
+    }
+
+    Get-Content -LiteralPath $LiteralPath -Raw | ConvertFrom-Json -Depth 100
+}
+
+function Get-SingleMatch {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][object[]] $InputObject,
+        [Parameter(Mandatory)][scriptblock] $Filter,
+        [Parameter(Mandatory)][string] $Label
+    )
+
+    $matches = @($InputObject | Where-Object $Filter)
+    if ($matches.Count -ne 1) {
+        throw "Expected exactly one $Label; found $($matches.Count)."
+    }
+    $matches[0]
+}
+
+function Get-InstallerBindings {
+    [CmdletBinding()]
+    param()
+
+    $bindings = @(
+        [ordered]@{
+            path = '/v1/sddcs/validations'
+            method = 'POST'
+            purpose = 'Validate the VCF Installer specification before execution.'
+        },
+        [ordered]@{
+            path = '/v1/sddcs/resources-calculation'
+            method = 'POST'
+            purpose = 'Calculate required and available infrastructure resources.'
+        },
+        [ordered]@{
+            path = '/v1/sddcs'
+            method = 'POST'
+            purpose = 'Submit the validated VCF deployment or convergence specification.'
+        }
+    )
+
+    foreach ($binding in $bindings) {
+        $null = Get-VcfInstallerOperation -Path $binding.path -Method $binding.method -ErrorAction Stop
+    }
+    $bindings
+}
+
+function New-VcfMigrationInstallerSpec {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][string] $InventoryPath,
+        [Parameter(Mandatory)][string] $CompatibilityPath,
+        [Parameter(Mandatory)][string] $OutputPath
+    )
+
+    $inventory = Read-JsonDocument -LiteralPath $InventoryPath
+    $compatibility = Read-JsonDocument -LiteralPath $CompatibilityPath
+
+    if ([string] $inventory.target.vcfVersion -cne [string] $compatibility.targetRelease) {
+        throw 'Inventory target and compatibility snapshot target differ.'
+    }
+
+    $installerBindings = @(Get-InstallerBindings)
+
+    $storageOptions = foreach ($optionRule in @($compatibility.requiredDecision.storageOptions)) {
+        $hostPool = Get-SingleMatch -InputObject @($inventory.hostPools) -Filter {
+            $_.option -ceq $optionRule.option
+        } -Label "host pool for $($optionRule.option)"
+        $selectedHosts = @($hostPool.availableHosts | Select-Object -First ([int] $optionRule.requiredHostCount))
+        if ($selectedHosts.Count -ne [int] $optionRule.requiredHostCount) {
+            throw "Host pool $($hostPool.poolId) cannot satisfy the pinned count."
+        }
+        [ordered]@{
+            option = [string] $optionRule.option
+            architecture = [string] $optionRule.architecture
+            poolId = [string] $hostPool.poolId
+            requiredHostCount = [int] $optionRule.requiredHostCount
+            selectedHostnames = $selectedHosts
+            minimumVsanNetworkGbps = [int] $optionRule.minimumVsanNetworkGbps
+            requiredMtu = [int] $optionRule.requiredMtu
+            readyNodeProfile = [string] $optionRule.readyNodeProfile
+            usesExistingLeafFabric = [bool] $optionRule.usesExistingLeafFabric
+        }
+    }
+
+    $placements = foreach ($profile in @($inventory.target.sizingProfiles)) {
+        [ordered]@{
+            component = [string] $profile.component
+            version = [string] $compatibility.targetRelease
+            managementDomain = [string] $inventory.site.managementDomain
+            cluster = [string] $inventory.site.managementCluster
+            resourcePool = [string] $inventory.target.resourcePool
+            storagePolicy = [string] $inventory.target.storagePolicy
+            nodeCount = [int] $profile.nodeCount
+            nodeShape = [ordered]@{
+                vCpu = [int] $profile.vCpuPerNode
+                memoryGiB = [int] $profile.memoryGiBPerNode
+                diskGiB = [int] $profile.diskGiBPerNode
+            }
+            antiAffinity = [bool] $profile.antiAffinity
+            network = [ordered]@{
+                segment = [string] $inventory.target.networkSegment
+                vlan = [int] $inventory.target.networkVlan
+                serviceAddress = [string] $profile.serviceAddress
+            }
+        }
+    }
+
+    $supportBoundaries = foreach ($sourceProduct in @($inventory.sourceProducts)) {
+        $path = Get-SingleMatch -InputObject @($compatibility.productPaths) -Filter {
+            $_.sourceId -ceq $sourceProduct.id
+        } -Label "product path for $($sourceProduct.id)"
+        [ordered]@{
+            sourceId = [string] $sourceProduct.id
+            product = [string] $sourceProduct.product
+            version = [string] $sourceProduct.version
+            kind = [string] $path.supportBoundary.kind
+            date = [string] $path.supportBoundary.date
+        }
+    }
+
+    $transitions = foreach ($sourceProduct in @($inventory.sourceProducts)) {
+        $path = Get-SingleMatch -InputObject @($compatibility.productPaths) -Filter {
+            $_.sourceId -ceq $sourceProduct.id
+        } -Label "product path for $($sourceProduct.id)"
+        $carried = [System.Collections.Generic.List[object]]::new()
+        $abandoned = [System.Collections.Generic.List[object]]::new()
+
+        foreach ($contentItem in @($sourceProduct.content)) {
+            $rule = Get-SingleMatch -InputObject @($compatibility.contentRules) -Filter {
+                $_.itemId -ceq $contentItem.id
+            } -Label "content rule for $($contentItem.id)"
+            if ($rule.disposition -ceq 'carry') {
+                $carried.Add([ordered]@{
+                    itemId = [string] $contentItem.id
+                    method = [string] $rule.method
+                    verification = [string] $rule.verification
+                })
+            }
+            else {
+                $abandoned.Add([ordered]@{
+                    itemId = [string] $contentItem.id
+                    reason = [string] $rule.reason
+                    finalDisposition = [string] $rule.finalDisposition
+                })
+            }
+        }
+
+        [ordered]@{
+            sourceId = [string] $sourceProduct.id
+            sourceProduct = [string] $sourceProduct.product
+            sourceVersion = [string] $sourceProduct.version
+            targetComponent = [string] $path.targetComponent
+            targetVersion = [string] $path.targetVersion
+            migrationMode = [string] $path.migrationMode
+            carryForward = @($carried)
+            abandoned = @($abandoned)
+            stepRefs = @($path.requiredActions)
+        }
+    }
+
+    $gates = foreach ($gate in @($compatibility.requiredGates)) {
+        [ordered]@{
+            id = [string] $gate.id
+            evidence = [string] $gate.evidence
+        }
+    }
+
+    $stepDetails = @{
+        'select-storage' = @{
+            action = 'Commit the ESA management-domain design'
+            description = 'Reserve the six ESA-AF-4 hosts and implement the pinned 25 GbE, VLAN and MTU design before placing management components.'
+            affectedProducts = @()
+        }
+        'patch-lifecycle' = @{
+            action = 'Patch legacy lifecycle management'
+            description = 'Update VMware Aria Suite Lifecycle from 8.18 Patch 1 to Patch 2, synchronize inventory and map the VCF 9.0.1 Operations and Fleet binaries.'
+            affectedProducts = @('aria-operations', 'aria-automation', 'aria-logs')
+        }
+        'upgrade-operations' = @{
+            action = 'Upgrade Aria Operations in place'
+            description = 'Run the supported 8.18.4 to VCF Operations 9.0.1.0 upgrade with VCF entitlement selected so Fleet Management is deployed.'
+            affectedProducts = @('aria-operations')
+        }
+        'place-operations-fleet' = @{
+            action = 'Place Operations and Fleet on ESA'
+            description = 'Place the upgraded Operations nodes and Fleet appliance in the pinned management cluster, resource pool, network and storage policy.'
+            affectedProducts = @('aria-operations')
+        }
+        'import-automation' = @{
+            action = 'Import Aria Automation into Fleet'
+            description = 'Use VCF Operations Fleet Management to import the existing clustered Aria Automation 8.18.1 instance from legacy lifecycle management.'
+            affectedProducts = @('aria-automation')
+        }
+        'upgrade-automation' = @{
+            action = 'Upgrade Automation in place'
+            description = 'Upgrade the imported cluster to VCF Automation 9.0.1.0, place it on ESA and reconcile all supported automation content.'
+            affectedProducts = @('aria-automation')
+        }
+        'deploy-logs' = @{
+            action = 'Deploy Operations for Logs fresh'
+            description = 'Deploy a new three-node VCF Operations for Logs 9.0.1.0 cluster on the pinned target placement and run it beside 8.18.3.'
+            affectedProducts = @('aria-logs')
+        }
+        'migrate-logs-content' = @{
+            action = 'Migrate and recreate log configuration'
+            description = 'Import VLCP content, recreate integrations and forwarders, copy agent configuration, repoint sources and enter new target secrets.'
+            affectedProducts = @('aria-logs')
+        }
+        'transfer-log-data' = @{
+            action = 'Transfer the supported log window'
+            description = 'Transfer only the most recent 90 days with the supported workflow while keeping the older source history read-only.'
+            affectedProducts = @('aria-logs')
+        }
+        'validate-cutover' = @{
+            action = 'Validate the integrated target'
+            description = 'Reconcile retained content, component health, service addresses, collection, automation execution, log ingestion and rollback backups.'
+            affectedProducts = @('aria-operations', 'aria-automation', 'aria-logs')
+        }
+        'retire-superseded-components' = @{
+            action = 'Retire superseded components'
+            description = 'Remove superseded lifecycle dependencies and decommission the old Logs cluster after its read-only retention disposition completes.'
+            affectedProducts = @('aria-operations', 'aria-automation', 'aria-logs')
+        }
+    }
+
+    $migrationPlan = for ($index = 0; $index -lt @($compatibility.requiredSteps).Count; $index++) {
+        $stepRule = @($compatibility.requiredSteps)[$index]
+        $details = $stepDetails[[string] $stepRule.id]
+        if ($null -eq $details) {
+            throw "No implementation details exist for step $($stepRule.id)."
+        }
+        [ordered]@{
+            sequence = ($index + 1) * 10
+            id = [string] $stepRule.id
+            action = [string] $details.action
+            description = [string] $details.description
+            dependsOn = @($stepRule.dependsOn)
+            gateIds = @($stepRule.gateIds)
+            affectedProducts = @($details.affectedProducts)
+        }
+    }
+
+    $managementNodeCount = 0
+    $totalVcpu = 0
+    $totalMemoryGiB = 0
+    $totalDiskGiB = 0
+    foreach ($profile in @($inventory.target.sizingProfiles)) {
+        $managementNodeCount += [int] $profile.nodeCount
+        $totalVcpu += [int] $profile.nodeCount * [int] $profile.vCpuPerNode
+        $totalMemoryGiB += [int] $profile.nodeCount * [int] $profile.memoryGiBPerNode
+        $totalDiskGiB += [int] $profile.nodeCount * [int] $profile.diskGiBPerNode
+    }
+    $selectedOption = Get-SingleMatch -InputObject @($compatibility.requiredDecision.storageOptions) -Filter {
+        $_.option -ceq $compatibility.requiredDecision.selectedOption
+    } -Label 'selected storage option'
+
+    $specification = [ordered]@{
+        schemaVersion = '1.0'
+        estateId = [string] $inventory.estateId
+        fixture = [ordered]@{
+            inventoryId = [string] $inventory.estateId
+            compatibilitySnapshotId = [string] $compatibility.snapshotId
+        }
+        target = [ordered]@{
+            vcfVersion = [string] $compatibility.targetRelease
+            managementDomain = [string] $inventory.site.managementDomain
+            managementCluster = [string] $inventory.site.managementCluster
+        }
+        supportBoundaries = @($supportBoundaries)
+        storageDecision = [ordered]@{
+            selectedOption = [string] $compatibility.requiredDecision.selectedOption
+            rationaleCode = [string] $compatibility.requiredDecision.rationaleCode
+            options = @($storageOptions)
+            networkChanges = @($compatibility.requiredDecision.selectedNetworkChanges)
+        }
+        componentPlacements = @($placements)
+        resourceSummary = [ordered]@{
+            managementNodeCount = $managementNodeCount
+            totalVcpu = $totalVcpu
+            totalMemoryGiB = $totalMemoryGiB
+            totalDiskGiB = $totalDiskGiB
+            selectedHostCount = [int] $selectedOption.requiredHostCount
+        }
+        transitions = @($transitions)
+        gates = @($gates)
+        migrationPlan = @($migrationPlan)
+        vcfInstallerBindings = $installerBindings
+    }
+
+    $outputDirectory = Split-Path -Parent $OutputPath
+    if ($outputDirectory -and -not (Test-Path -LiteralPath $outputDirectory)) {
+        $null = New-Item -ItemType Directory -Path $outputDirectory
+    }
+    $specification | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $OutputPath -Encoding utf8NoBOM
+    [pscustomobject] $specification
+}
+
+Export-ModuleMember -Function New-VcfMigrationInstallerSpec

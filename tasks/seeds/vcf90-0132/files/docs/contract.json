{
  "openapi": "3.0.1",
  "info": {
    "title": "VMware Cloud Foundation Operations for Networks API Reference",
    "version": "9.0.0.0"
  },
  "server_base_path": "/api/ni",
  "operations": [
    {
      "operationId": "create",
      "method": "POST",
      "path": "/auth/token",
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "UserCredential"
      },
      "responses": {
        "200": "Token",
        "400": "ApiError",
        "401": null,
        "500": null
      }
    },
    {
      "operationId": "listVms",
      "method": "GET",
      "path": "/entities/vms",
      "query_parameters": [
        {
          "name": "size",
          "required": false,
          "type": "number",
          "default": 10.0
        },
        {
          "name": "cursor",
          "required": false,
          "type": "string"
        },
        {
          "name": "start_time",
          "required": false,
          "type": "number"
        },
        {
          "name": "end_time",
          "required": false,
          "type": "number"
        }
      ],
      "responses": {
        "200": "PagedListResponseWithTime",
        "400": "ApiError",
        "401": null,
        "500": null
      },
      "security": "ApiKeyAuth"
    }
  ],
  "schemas": {
    "UserCredential": {
      "type": "object",
      "required": [],
      "properties": {
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "domain": {
          "$ref": "Domain"
        }
      }
    },
    "Domain": {
      "type": "object",
      "required": [],
      "properties": {
        "domain_type": {
          "type": "string",
          "nullable": true,
          "enum": [
            "LDAP",
            "LOCAL"
          ]
        },
        "value": {
          "type": "string"
        }
      }
    },
    "Token": {
      "type": "object",
      "required": [],
      "properties": {
        "token": {
          "type": "string"
        },
        "expiry": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "PagedListResponseWithTime": {
      "type": "object",
      "required": [],
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "$ref": "EntityIdWithTime"
          }
        },
        "cursor": {
          "type": "string"
        },
        "total_count": {
          "type": "integer"
        },
        "start_time": {
          "type": "integer",
          "format": "int64"
        },
        "end_time": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "EntityIdWithTime": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string"
        },
        "entity_type": {
          "$ref": "EntityType"
        },
        "time": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "EntityType": {
      "type": "string",
      "nullable": true,
      "example": "VirtualMachine"
    }
  },
  "security_schemes": {
    "ApiKeyAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value_format": "NetworkInsight {token}"
    }
  }
}

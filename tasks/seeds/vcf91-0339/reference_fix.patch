+import java.io.IOException;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.charset.StandardCharsets;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+/** Dependency-free client for the focused VCF Automation 9.1 contract. */
+public final class VcfAutomationClient {
+    private static final String OP_REQUEST = "requestCatalogItemInstances";
+    private static final String OP_GET = "getDeploymentById";
+    private static final String OP_LIST = "getDeployments";
+
+    private final String baseUrl;
+    private final String bearerToken;
+    private final Duration pollInterval;
+    private final HttpClient httpClient;
+
+    public VcfAutomationClient(String baseUrl, String bearerToken, Duration pollInterval) {
+        this.baseUrl = stripTrailingSlashes(Objects.requireNonNull(baseUrl, "baseUrl"));
+        this.bearerToken = Objects.requireNonNull(bearerToken, "bearerToken");
+        this.pollInterval = Objects.requireNonNull(pollInterval, "pollInterval");
+        this.httpClient = HttpClient.newHttpClient();
+    }
+
+    public record CatalogItemRequest(
+            String deploymentName,
+            Map<String, Object> inputs,
+            String projectId,
+            String reason,
+            String version) {
+    }
+
+    public record Deployment(
+            String id,
+            String name,
+            String projectId,
+            String status,
+            String lastRequestStatus,
+            String lastRequestDetails) {
+    }
+
+    public record ProvisionResult(
+            String deploymentId,
+            String deploymentName,
+            String status,
+            int pollCount) {
+    }
+
+    public static final class VcfAutomationApiException extends RuntimeException {
+        private final String operationId;
+        private final int status;
+
+        VcfAutomationApiException(String operationId, int status) {
+            super(operationId + " returned HTTP " + status);
+            this.operationId = operationId;
+            this.status = status;
+        }
+
+        public String operationId() {
+            return operationId;
+        }
+
+        public int status() {
+            return status;
+        }
+    }
+
+    public static final class VcfAutomationProtocolException extends RuntimeException {
+        VcfAutomationProtocolException(String message) {
+            super(message);
+        }
+
+        VcfAutomationProtocolException(String message, Throwable cause) {
+            super(message, cause);
+        }
+    }
+
+    public static final class VcfAutomationTransportException extends RuntimeException {
+        VcfAutomationTransportException(String message, Throwable cause) {
+            super(message, cause);
+        }
+    }
+
+    public static final class DeploymentFailedException extends RuntimeException {
+        private final Deployment deployment;
+        private final int pollCount;
+
+        DeploymentFailedException(Deployment deployment, int pollCount) {
+            super("deployment " + deployment.id() + " reached " + deployment.status()
+                    + (deployment.lastRequestDetails() == null
+                    ? "" : ": " + deployment.lastRequestDetails()));
+            this.deployment = deployment;
+            this.pollCount = pollCount;
+        }
+
+        public Deployment deployment() {
+            return deployment;
+        }
+
+        public int pollCount() {
+            return pollCount;
+        }
+    }
+
+    /** Submit one catalog item and observe its deployment through a terminal create state. */
+    public ProvisionResult requestAndWait(String catalogItemId, CatalogItemRequest request) {
+        Objects.requireNonNull(request, "request");
+        Map<String, Object> body = new LinkedHashMap<>();
+        body.put("deploymentName", request.deploymentName());
+        if (request.inputs() != null && !request.inputs().isEmpty()) {
+            body.put("inputs", request.inputs());
+        }
+        body.put("projectId", request.projectId());
+        if (!isBlank(request.reason())) {
+            body.put("reason", request.reason());
+        }
+        if (!isBlank(request.version())) {
+            body.put("version", request.version());
+        }
+
+        String path = "/catalog/api/items/" + encodePathSegment(catalogItemId) + "/request";
+        Object parsed = parseDocument(send(OP_REQUEST, "POST", path, Json.write(body)));
+        List<Object> accepted = requireArray(parsed, OP_REQUEST + " response");
+        if (accepted.size() != 1) {
+            throw new VcfAutomationProtocolException(
+                    OP_REQUEST + " must return exactly one deployment reference");
+        }
+        Map<String, Object> reference = requireObject(accepted.get(0),
+                OP_REQUEST + " response entry");
+        String deploymentId = requireString(reference, "deploymentId", OP_REQUEST);
+
+        int polls = 0;
+        while (true) {
+            polls++;
+            Deployment deployment = getDeployment(deploymentId);
+            switch (deployment.status()) {
+                case "CREATE_SUCCESSFUL":
+                    return new ProvisionResult(
+                            deployment.id(), deployment.name(), deployment.status(), polls);
+                case "CREATE_FAILED":
+                    throw new DeploymentFailedException(deployment, polls);
+                case "CREATE_INPROGRESS":
+                    sleepBeforeNextPoll();
+                    break;
+                default:
+                    throw new VcfAutomationProtocolException(
+                            "unexpected creation status " + deployment.status()
+                                    + " for deployment " + deployment.id());
+            }
+        }
+    }
+
+    /** Return a stable local view, independent of the order sent by the service. */
+    public List<Deployment> listDeployments() {
+        Object parsed = parseDocument(send(
+                OP_LIST, "GET", "/deployment/api/deployments", null));
+        Map<String, Object> page = requireObject(parsed, OP_LIST + " response");
+        List<Object> content = requireArray(page.get("content"), OP_LIST + " content");
+        List<Deployment> deployments = new ArrayList<>(content.size());
+        for (Object value : content) {
+            deployments.add(readDeployment(value, OP_LIST));
+        }
+        deployments.sort(Comparator.comparing(Deployment::name).thenComparing(Deployment::id));
+        return List.copyOf(deployments);
+    }
+
+    private Deployment getDeployment(String deploymentId) {
+        String path = "/deployment/api/deployments/" + encodePathSegment(deploymentId);
+        return readDeployment(parseDocument(send(OP_GET, "GET", path, null)), OP_GET);
+    }
+
+    private String send(String operationId, String method, String path, String body) {
+        HttpRequest.Builder builder = HttpRequest.newBuilder(URI.create(baseUrl + path))
+                .header("Accept", "application/json")
+                .header("Authorization", "Bearer " + bearerToken);
+        if (body == null) {
+            builder.GET();
+        } else {
+            builder.header("Content-Type", "application/json")
+                    .POST(HttpRequest.BodyPublishers.ofString(body, StandardCharsets.UTF_8));
+        }
+
+        final HttpResponse<String> response;
+        try {
+            response = httpClient.send(
+                    builder.build(), HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+        } catch (InterruptedException interrupted) {
+            Thread.currentThread().interrupt();
+            throw new VcfAutomationTransportException(operationId + " was interrupted", interrupted);
+        } catch (IOException failure) {
+            throw new VcfAutomationTransportException(operationId + " could not be delivered", failure);
+        }
+        if (response.statusCode() != 200) {
+            throw new VcfAutomationApiException(operationId, response.statusCode());
+        }
+        return response.body();
+    }
+
+    private void sleepBeforeNextPoll() {
+        if (pollInterval.isZero()) {
+            return;
+        }
+        try {
+            long millis = pollInterval.toMillis();
+            int nanos = (int) pollInterval.minusMillis(millis).toNanos();
+            Thread.sleep(millis, nanos);
+        } catch (InterruptedException interrupted) {
+            Thread.currentThread().interrupt();
+            throw new VcfAutomationTransportException("deployment polling was interrupted", interrupted);
+        }
+    }
+
+    private static Deployment readDeployment(Object value, String operationId) {
+        Map<String, Object> document = requireObject(value, operationId + " deployment");
+        String id = requireString(document, "id", operationId);
+        String name = requireString(document, "name", operationId);
+        String projectId = optionalString(document.get("projectId"), operationId + ".projectId");
+        String status = requireString(document, "status", operationId);
+        String lastStatus = null;
+        String lastDetails = null;
+        Object last = document.get("lastRequest");
+        if (last != null) {
+            Map<String, Object> lastRequest = requireObject(last, operationId + ".lastRequest");
+            lastStatus = optionalString(lastRequest.get("status"), operationId + ".lastRequest.status");
+            lastDetails = optionalString(lastRequest.get("details"), operationId + ".lastRequest.details");
+        }
+        return new Deployment(id, name, projectId, status, lastStatus, lastDetails);
+    }
+
+    private static Object parseDocument(String body) {
+        try {
+            return Json.parse(body);
+        } catch (RuntimeException malformed) {
+            if (malformed instanceof VcfAutomationProtocolException) {
+                throw malformed;
+            }
+            throw new VcfAutomationProtocolException("VCF Automation returned malformed JSON", malformed);
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    private static Map<String, Object> requireObject(Object value, String context) {
+        if (!(value instanceof Map<?, ?>)) {
+            throw new VcfAutomationProtocolException(context + " is not a JSON object");
+        }
+        return (Map<String, Object>) value;
+    }
+
+    @SuppressWarnings("unchecked")
+    private static List<Object> requireArray(Object value, String context) {
+        if (!(value instanceof List<?>)) {
+            throw new VcfAutomationProtocolException(context + " is not a JSON array");
+        }
+        return (List<Object>) value;
+    }
+
+    private static String requireString(
+            Map<String, Object> object, String member, String operationId) {
+        String value = optionalString(object.get(member), operationId + "." + member);
+        if (isBlank(value)) {
+            throw new VcfAutomationProtocolException(
+                    operationId + " response has no nonblank " + member);
+        }
+        return value;
+    }
+
+    private static String optionalString(Object value, String context) {
+        if (value == null) {
+            return null;
+        }
+        if (!(value instanceof String)) {
+            throw new VcfAutomationProtocolException(context + " is not a string");
+        }
+        return (String) value;
+    }
+
+    private static boolean isBlank(String value) {
+        return value == null || value.isBlank();
+    }
+
+    private static String stripTrailingSlashes(String value) {
+        int end = value.length();
+        while (end > 0 && value.charAt(end - 1) == '/') {
+            end--;
+        }
+        return value.substring(0, end);
+    }
+
+    private static String encodePathSegment(String value) {
+        Objects.requireNonNull(value, "path parameter");
+        StringBuilder encoded = new StringBuilder();
+        for (byte raw : value.getBytes(StandardCharsets.UTF_8)) {
+            int octet = raw & 0xff;
+            if ((octet >= 'a' && octet <= 'z')
+                    || (octet >= 'A' && octet <= 'Z')
+                    || (octet >= '0' && octet <= '9')
+                    || octet == '-' || octet == '.' || octet == '_' || octet == '~') {
+                encoded.append((char) octet);
+            } else {
+                encoded.append('%');
+                encoded.append("0123456789ABCDEF".charAt(octet >>> 4));
+                encoded.append("0123456789ABCDEF".charAt(octet & 0x0f));
+            }
+        }
+        return encoded.toString();
+    }
+
+    /** Minimal complete JSON reader/writer for contract request and response values. */
+    private static final class Json {
+        private final String source;
+        private int cursor;
+
+        private Json(String source) {
+            this.source = source;
+        }
+
+        static Object parse(String source) {
+            Json parser = new Json(source);
+            Object value = parser.readValue();
+            parser.skipWhitespace();
+            if (parser.cursor != source.length()) {
+                throw new IllegalArgumentException("trailing JSON content");
+            }
+            return value;
+        }
+
+        static String write(Object value) {
+            StringBuilder out = new StringBuilder();
+            appendValue(out, value);
+            return out.toString();
+        }
+
+        private static void appendValue(StringBuilder out, Object value) {
+            if (value == null) {
+                out.append("null");
+            } else if (value instanceof String text) {
+                appendString(out, text);
+            } else if (value instanceof Boolean || value instanceof Byte
+                    || value instanceof Short || value instanceof Integer
+                    || value instanceof Long || value instanceof java.math.BigInteger
+                    || value instanceof java.math.BigDecimal) {
+                out.append(value);
+            } else if (value instanceof Float number) {
+                if (!Float.isFinite(number)) {
+                    throw new IllegalArgumentException("non-finite JSON number");
+                }
+                out.append(number);
+            } else if (value instanceof Double number) {
+                if (!Double.isFinite(number)) {
+                    throw new IllegalArgumentException("non-finite JSON number");
+                }
+                out.append(number);
+            } else if (value instanceof Map<?, ?> map) {
+                out.append('{');
+                boolean first = true;
+                for (Map.Entry<?, ?> entry : map.entrySet()) {
+                    if (!(entry.getKey() instanceof String key)) {
+                        throw new IllegalArgumentException("JSON object key is not a string");
+                    }
+                    if (!first) {
+                        out.append(',');
+                    }
+                    first = false;
+                    appendString(out, key);
+                    out.append(':');
+                    appendValue(out, entry.getValue());
+                }
+                out.append('}');
+            } else if (value instanceof Iterable<?> values) {
+                out.append('[');
+                boolean first = true;
+                for (Object item : values) {
+                    if (!first) {
+                        out.append(',');
+                    }
+                    first = false;
+                    appendValue(out, item);
+                }
+                out.append(']');
+            } else {
+                throw new IllegalArgumentException(
+                        "unsupported JSON value type " + value.getClass().getName());
+            }
+        }
+
+        private static void appendString(StringBuilder out, String value) {
+            out.append('"');
+            for (int index = 0; index < value.length(); index++) {
+                char character = value.charAt(index);
+                switch (character) {
+                    case '"' -> out.append("\\\"");
+                    case '\\' -> out.append("\\\\");
+                    case '\b' -> out.append("\\b");
+                    case '\f' -> out.append("\\f");
+                    case '\n' -> out.append("\\n");
+                    case '\r' -> out.append("\\r");
+                    case '\t' -> out.append("\\t");
+                    default -> {
+                        if (character < 0x20) {
+                            out.append(String.format("\\u%04x", (int) character));
+                        } else {
+                            out.append(character);
+                        }
+                    }
+                }
+            }
+            out.append('"');
+        }
+
+        private Object readValue() {
+            skipWhitespace();
+            char character = peek();
+            return switch (character) {
+                case '{' -> readObject();
+                case '[' -> readArray();
+                case '"' -> readString();
+                case 't' -> readLiteral("true", Boolean.TRUE);
+                case 'f' -> readLiteral("false", Boolean.FALSE);
+                case 'n' -> readLiteral("null", null);
+                default -> readNumber();
+            };
+        }
+
+        private Map<String, Object> readObject() {
+            Map<String, Object> object = new LinkedHashMap<>();
+            expect('{');
+            skipWhitespace();
+            if (peek() == '}') {
+                cursor++;
+                return object;
+            }
+            while (true) {
+                skipWhitespace();
+                String key = readString();
+                skipWhitespace();
+                expect(':');
+                object.put(key, readValue());
+                skipWhitespace();
+                char delimiter = next();
+                if (delimiter == '}') {
+                    return object;
+                }
+                if (delimiter != ',') {
+                    throw new IllegalArgumentException("invalid JSON object delimiter");
+                }
+            }
+        }
+
+        private List<Object> readArray() {
+            List<Object> values = new ArrayList<>();
+            expect('[');
+            skipWhitespace();
+            if (peek() == ']') {
+                cursor++;
+                return values;
+            }
+            while (true) {
+                values.add(readValue());
+                skipWhitespace();
+                char delimiter = next();
+                if (delimiter == ']') {
+                    return values;
+                }
+                if (delimiter != ',') {
+                    throw new IllegalArgumentException("invalid JSON array delimiter");
+                }
+            }
+        }
+
+        private String readString() {
+            expect('"');
+            StringBuilder out = new StringBuilder();
+            while (true) {
+                char character = next();
+                if (character == '"') {
+                    return out.toString();
+                }
+                if (character != '\\') {
+                    if (character < 0x20) {
+                        throw new IllegalArgumentException("control character in JSON string");
+                    }
+                    out.append(character);
+                    continue;
+                }
+                char escape = next();
+                switch (escape) {
+                    case '"', '\\', '/' -> out.append(escape);
+                    case 'b' -> out.append('\b');
+                    case 'f' -> out.append('\f');
+                    case 'n' -> out.append('\n');
+                    case 'r' -> out.append('\r');
+                    case 't' -> out.append('\t');
+                    case 'u' -> {
+                        if (cursor + 4 > source.length()) {
+                            throw new IllegalArgumentException("short JSON unicode escape");
+                        }
+                        out.append((char) Integer.parseInt(
+                                source.substring(cursor, cursor + 4), 16));
+                        cursor += 4;
+                    }
+                    default -> throw new IllegalArgumentException("invalid JSON escape");
+                }
+            }
+        }
+
+        private Object readLiteral(String literal, Object value) {
+            if (!source.startsWith(literal, cursor)) {
+                throw new IllegalArgumentException("invalid JSON literal");
+            }
+            cursor += literal.length();
+            return value;
+        }
+
+        private Number readNumber() {
+            int start = cursor;
+            if (peek() == '-') {
+                cursor++;
+            }
+            readDigits();
+            boolean fractional = false;
+            if (cursor < source.length() && source.charAt(cursor) == '.') {
+                fractional = true;
+                cursor++;
+                readDigits();
+            }
+            if (cursor < source.length()
+                    && (source.charAt(cursor) == 'e' || source.charAt(cursor) == 'E')) {
+                fractional = true;
+                cursor++;
+                if (cursor < source.length()
+                        && (source.charAt(cursor) == '+' || source.charAt(cursor) == '-')) {
+                    cursor++;
+                }
+                readDigits();
+            }
+            String token = source.substring(start, cursor);
+            return fractional ? Double.valueOf(token) : Long.valueOf(token);
+        }
+
+        private void readDigits() {
+            int start = cursor;
+            while (cursor < source.length() && Character.isDigit(source.charAt(cursor))) {
+                cursor++;
+            }
+            if (cursor == start) {
+                throw new IllegalArgumentException("invalid JSON number");
+            }
+        }
+
+        private void expect(char expected) {
+            if (next() != expected) {
+                throw new IllegalArgumentException("unexpected JSON token");
+            }
+        }
+
+        private void skipWhitespace() {
+            while (cursor < source.length() && Character.isWhitespace(source.charAt(cursor))) {
+                cursor++;
+            }
+        }
+
+        private char peek() {
+            if (cursor >= source.length()) {
+                throw new IllegalArgumentException("unexpected end of JSON");
+            }
+            return source.charAt(cursor);
+        }
+
+        private char next() {
+            char character = peek();
+            cursor++;
+            return character;
+        }
+    }
+}


+            }
+            String status = parseJsonString(statusField.group(1));
+            switch (status) {
+                case "SUCCEEDED", "FAILED" -> {
+                    return new TaskResult(taskId, status);
+                }
+                case "PENDING", "RUNNING", "BLOCKED" -> {
+                    if (!pollInterval.isZero()) {
+                        Thread.sleep(pollInterval);
+                    }
+                }
+                default -> throw new IOException("task response contained unknown status: " + status);

{
  "openapi": "3.0.3",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "commit_sha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "spec_path": "specifications/vsan-data-protection/vsan-data-protection-openapi.yaml",
    "spec_sha256": "695d4a5a5f343609539c1ca02578803fcf8df7ed520cf66710c618ffef237cd6"
  },
  "server_base_path": "/api",
  "security_schemes": {
    "api_key_auth": {
      "type": "apiKey",
      "name": "vmware-api-session-id",
      "in": "header"
    }
  },
  "operations": [
    {
      "operationId": "Snapservice.Clusters.ProtectionGroups.Snapshots_create$Task",
      "method": "POST",
      "path": "/snapservice/clusters/{cluster}/protection-groups/{pg}/snapshots?vmw-task=true",
      "path_parameters": [
        {
          "name": "cluster",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "pg",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "request_body": {
        "required": true,
        "media_type": "application/json",
        "schema": {
          "name": "Snapservice.Clusters.ProtectionGroups.Snapshots.CreateSpec",
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "retention": {
              "required": false,
              "nullable_or_missing_semantics": "If missing or null, retained for the life of the cluster or protection group.",
              "schema": {
                "name": "Snapservice.RetentionPeriod",
                "type": "object",
                "required": [
                  "duration",
                  "unit"
                ],
                "properties": {
                  "duration": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "unit": {
                    "type": "string",
                    "enum": [
                      "MINUTE",
                      "HOUR",
                      "DAY",
                      "WEEK",
                      "MONTH"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "responses": {
        "202": {
          "media_type": "application/json",
          "schema": {
            "type": "string"
          }
        }
      },
      "security": [
        "api_key_auth"
      ]
    },
    {
      "operationId": "Snapservice.Tasks_get",
      "method": "GET",
      "path": "/snapservice/tasks/{task}",
      "path_parameters": [
        {
          "name": "task",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "media_type": "application/json",
          "schema": {
            "name": "Snapservice.Tasks.Info",
            "type": "object",
            "required": [
              "cancelable",
              "description",
              "operation",
              "service",
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "PENDING",
                  "RUNNING",
                  "BLOCKED",
                  "SUCCEEDED",
                  "FAILED"
                ],
                "terminal": [
                  "SUCCEEDED",
                  "FAILED"
                ]
              }
            }
          }
        }
      },
      "security": [
        "api_key_auth"
      ]
    }
  ]
}

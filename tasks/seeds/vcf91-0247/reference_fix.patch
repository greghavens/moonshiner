+
+func validate(req SnapshotRequest) error {
+	if strings.TrimSpace(req.Cluster) == "" {
+		return fmt.Errorf("%w: cluster identifier is empty", ErrInvalidRequest)
+	}
+	if strings.TrimSpace(req.ProtectionGroup) == "" {
+		return fmt.Errorf("%w: protection group identifier is empty", ErrInvalidRequest)
+	}
+	if strings.TrimSpace(req.Name) == "" {
+		return fmt.Errorf("%w: snapshot name is empty", ErrInvalidRequest)
+	}
+	if req.Retention != nil {
+		if !retentionUnits[req.Retention.Unit] {
+			return fmt.Errorf("%w: retention unit %q is not a Snapservice.TimeUnit value", ErrInvalidRequest, req.Retention.Unit)
+		}
+		if req.Retention.Duration <= 0 {
+			return fmt.Errorf("%w: retention duration must be positive", ErrInvalidRequest)
+		}
+	}
+	return nil
+}

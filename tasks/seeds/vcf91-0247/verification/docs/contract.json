{
  "contract_version": 1,
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "license": "Apache-2.0",
    "commit_sha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "spec_path": "specifications/vsan-data-protection/vsan-data-protection-openapi.yaml",
    "openapi": "3.0.3"
  },
  "spec_title": "Snapshot Appliance API",
  "spec_version": "9.1.0.0",
  "base_path": "/api",
  "auth": {
    "scheme": "api_key_auth",
    "type": "apiKey",
    "in": "header",
    "name": "vmware-api-session-id"
  },
  "task_status": {
    "schema": "Snapservice.Tasks.Status",
    "values": ["PENDING", "RUNNING", "BLOCKED", "SUCCEEDED", "FAILED"],
    "non_terminal": ["PENDING", "RUNNING", "BLOCKED"],
    "terminal": ["SUCCEEDED", "FAILED"],
    "success": "SUCCEEDED",
    "failure": "FAILED"
  },
  "operations": [
    {
      "operation_id": "Snapservice.Clusters.ProtectionGroups.Snapshots_create$Task",
      "tag": "Snapservice.Clusters.ProtectionGroups.Snapshots",
      "asynchronous": true,
      "method": "POST",
      "path": "/snapservice/clusters/{cluster}/protection-groups/{pg}/snapshots",
      "path_params": ["cluster", "pg"],
      "query": {
        "vmw-task": "true"
      },
      "request_body": {
        "required": true,
        "content_type": "application/json",
        "schema": "Snapservice.Clusters.ProtectionGroups.Snapshots.CreateSpec",
        "required_fields": ["name"],
        "optional_fields": ["retention"],
        "field_schemas": {
          "name": {
            "type": "string"
          },
          "retention": {
            "schema": "Snapservice.RetentionPeriod",
            "type": "object",
            "required_fields": ["unit", "duration"],
            "optional_fields": [],
            "field_schemas": {
              "unit": {
                "type": "string",
                "schema": "Snapservice.TimeUnit",
                "enum": ["MINUTE", "HOUR", "DAY", "WEEK", "MONTH", "YEAR"]
              },
              "duration": {
                "type": "integer",
                "format": "int64"
              }
            }
          }
        }
      },
      "success_status": 202,
      "success_body": {
        "type": "string",
        "meaning": "identifier of the task tracking the snapshot operation"
      },
      "error_responses": {
        "400": "Vapi.Std.Errors.Error",
        "401": "Vapi.Std.Errors.Unauthenticated",
        "403": "Vapi.Std.Errors.Unauthorized",
        "404": "Vapi.Std.Errors.NotFound",
        "500": "Vapi.Std.Errors.Error",
        "503": "Vapi.Std.Errors.ServiceUnavailable"
      }
    },
    {
      "operation_id": "Snapservice.Tasks_get",
      "tag": "Snapservice.Tasks",
      "asynchronous": false,
      "method": "GET",
      "path": "/snapservice/tasks/{task}",
      "path_params": ["task"],
      "query": {},
      "request_body": null,
      "success_status": 200,
      "success_body": {
        "type": "object",
        "schema": "Snapservice.Tasks.Info",
        "required_fields": ["cancelable", "description", "operation", "service", "status"],
        "optional_fields": ["progress", "result", "vc_task", "parent", "target", "error", "start_time", "end_time", "user"]
      },
      "error_responses": {
        "401": "Vapi.Std.Errors.Unauthenticated",
        "403": "Vapi.Std.Errors.Unauthorized",
        "404": "Vapi.Std.Errors.NotFound",
        "500": "Vapi.Std.Errors.Error",
        "503": "Vapi.Std.Errors.ServiceUnavailable"
      }
    }
  ]
}

+func decodeJSON(path string, target any) error {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return err
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(target); err != nil {
+		return err
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); !errors.Is(err, io.EOF) {
+		if err == nil {
+			return errors.New("multiple JSON values")
+		}
+		return err
+	}
+	return nil
+}
+
+func validateReleaseInputs(input scenario, existing estate, snapshot compatibilitySnapshot) error {
+	if input.ID == "" || input.SddcID == "" || input.DomainName == "" || input.VCFInstanceName == "" || input.ManagementPoolName == "" {
+		return errors.New("scenario: required identity field is empty")
+	}
+	if snapshot.SnapshotVersion != 1 || snapshot.TargetRelease == "" {
+		return errors.New("compatibility snapshot: unsupported or empty snapshot")
+	}
+	if input.TargetRelease != snapshot.TargetRelease || existing.TargetRelease != snapshot.TargetRelease {
+		return errors.New("target release does not match compatibility snapshot")
+	}
+	if existing.EstateID == "" || existing.SourceRelease == "" {
+		return errors.New("estate: required identity field is empty")
+	}
+	if len(snapshot.BillOfMaterials) == 0 || len(snapshot.UpgradePaths) == 0 {
+		return errors.New("compatibility snapshot: BOM and upgrade paths are required")
+	}
+	return nil
+}

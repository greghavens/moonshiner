+		}
+		total := totals[dataSite]
+		if total.Cores < requiredCores || total.MemoryGiB < requiredMemory || total.RawStorageGiB < requiredStorage {
+			return nil, "", nil, nil, fmt.Errorf("scenario: %s cannot carry required site-loss capacity with headroom", dataSite)
+		}
+		perSite = append(perSite, total)
+	}
+
+	if len(input.Networks) == 0 || len(input.Infrastructure.DNSServers) == 0 || len(input.Infrastructure.NTPServers) == 0 || len(input.Infrastructure.NsxManagerHostnames) != 3 {
+		return nil, "", nil, nil, errors.New("scenario: incomplete network or management infrastructure")
+	}
+	seenNetwork := make(map[string]struct{})
+	for _, network := range input.Networks {
+		if network.Type == "" || network.VLANID < 0 || network.VLANID > 4094 || network.Subnet == "" || network.Gateway == "" || network.Start == "" || network.End == "" || network.MTU < 1280 || network.MTU > 9190 {
+			return nil, "", nil, nil, errors.New("scenario: invalid network")
+		}
+		if _, exists := seenNetwork[network.Type]; exists {
+			return nil, "", nil, nil, fmt.Errorf("scenario: duplicate network type %s", network.Type)
+		}
+		seenNetwork[network.Type] = struct{}{}
+	}
+	return dataSites, preferredSite, siteHosts, perSite, nil
+}
+
+func buildMigration(existing estate, snapshot compatibilitySnapshot) ([]MigrationStep, error) {
+	inventory := make(map[string]estateComponent, len(existing.Components))
+	for _, component := range existing.Components {
+		if component.ID == "" || component.Name == "" || component.Version == "" {
+			return nil, errors.New("estate: invalid component")
+		}
+		if _, exists := inventory[component.ID]; exists {
+			return nil, fmt.Errorf("estate: duplicate component %s", component.ID)
+		}
+		inventory[component.ID] = component
+	}
+	if len(inventory) != len(snapshot.UpgradePaths) {
+		return nil, errors.New("estate: inventory does not match pinned upgrade paths")
+	}
+	paths := append([]upgradePath(nil), snapshot.UpgradePaths...)
+	sort.Slice(paths, func(i, j int) bool { return paths[i].Order < paths[j].Order })
+	steps := make([]MigrationStep, 0, len(paths))
+	seen := make(map[string]struct{}, len(paths))
+	for index, path := range paths {
+		if path.Order != index+1 || path.ComponentID == "" || path.From == "" || path.To == "" || path.Method == "" || len(path.Gates) == 0 {
+			return nil, errors.New("compatibility snapshot: invalid or non-contiguous upgrade path")
+		}
+		if _, exists := seen[path.ComponentID]; exists {
+			return nil, fmt.Errorf("compatibility snapshot: duplicate path for %s", path.ComponentID)
+		}
+		seen[path.ComponentID] = struct{}{}
+		component, exists := inventory[path.ComponentID]
+		if !exists {
+			return nil, fmt.Errorf("estate: missing component %s", path.ComponentID)
+		}
+		if component.Version != path.From {
+			return nil, fmt.Errorf("estate: unsupported %s path from %s", path.ComponentID, component.Version)
+		}
+		steps = append(steps, MigrationStep{
+			Order:          path.Order,
+			ComponentID:    path.ComponentID,
+			Name:           component.Name,
+			CurrentVersion: component.Version,
+			TargetVersion:  path.To,
+			Method:         path.Method,
+			Gates:          append([]string(nil), path.Gates...),
+		})
+	}
+	return steps, nil
+}
+
+func findBOM(items []BillOfMaterialItem, id string) (BillOfMaterialItem, error) {
+	seen := make(map[string]struct{}, len(items))
+	var found BillOfMaterialItem
+	for _, item := range items {
+		if item.ID == "" || item.Name == "" || item.Version == "" || item.Build == "" {
+			return BillOfMaterialItem{}, errors.New("compatibility snapshot: invalid BOM item")
+		}
+		if _, exists := seen[item.ID]; exists {
+			return BillOfMaterialItem{}, fmt.Errorf("compatibility snapshot: duplicate BOM item %s", item.ID)
+		}
+		seen[item.ID] = struct{}{}
+		if item.ID == id {
+			found = item
+		}
+	}
+	if found.ID == "" {
+		return BillOfMaterialItem{}, fmt.Errorf("compatibility snapshot: missing BOM item %s", id)
+	}
+	return found, nil
+}
+
+func addHeadroom(value, percentage int) int {
+	return (value*(100+percentage) + 99) / 100
 }

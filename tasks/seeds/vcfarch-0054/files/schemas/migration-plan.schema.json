{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch:migration-plan:v1",
  "title": "VCF existing-estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "estateId", "sourceRelease", "targetRelease", "steps"],
  "properties": {
    "schemaVersion": {"const": 1},
    "estateId": {"type": "string", "minLength": 1},
    "sourceRelease": {"type": "string", "minLength": 1},
    "targetRelease": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "componentId", "name", "currentVersion", "targetVersion", "method", "gates"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "componentId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 1},
        "currentVersion": {"type": "string", "minLength": 1},
        "targetVersion": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

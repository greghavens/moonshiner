@@ -0,0 +1,244 @@
+"""Build machine-readable VCF design artifacts from the pinned inputs."""
+
+from __future__ import annotations
+
+import json
+from ipaddress import ip_address
+from pathlib import Path
+from typing import Any
+
+
+REPOSITORY_ROOT = Path(__file__).resolve().parent.parent
+
+
+def _load(relative: str) -> dict[str, Any]:
+    with (REPOSITORY_ROOT / relative).open("r", encoding="utf-8") as handle:
+        return json.load(handle)
+
+
+def _write(path: Path, value: Any) -> None:
+    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+
+def _addresses(start: str, end: str) -> list[str]:
+    first = int(ip_address(start))
+    last = int(ip_address(end))
+    return [str(ip_address(number)) for number in range(first, last + 1)]
+
+
+def _sddc_spec(requirements: dict[str, Any], snapshot: dict[str, Any]) -> dict[str, Any]:
+    fqdns = requirements["appliance_fqdns"]
+    credentials = requirements["placeholder_credentials"]
+    versions = snapshot["greenfield"]["component_versions"]
+    networks = []
+    for network in requirements["networks"]:
+        networks.append(
+            {
+                "networkType": network["network_type"],
+                "subnet": network["cidr"],
+                "gateway": network["gateway"],
+                "subnetMask": "255.255.255.0",
+                "includeIpAddress": network["host_addresses"],
+                "vlanId": network["vlan_id"],
+                "mtu": network["mtu"],
+                "ipAddressVersion": "IPv4",
+                "ipAddressAssignmentMode": "STATIC",
+            }
+        )
+
+    pool = requirements["management_services_ipv4_pool"]
+    tep = requirements["nsx_tep_pool"]
+    return {
+        "sddcId": "dal01-m01",
+        "workflowType": "VCF",
+        "version": snapshot["target_vcf_version"],
+        "vcfInstanceName": requirements["architecture_id"],
+        "hostSpecs": [{"hostname": item["hostname"]} for item in requirements["hosts"]],
+        "vcenterSpec": {
+            "vcenterHostname": fqdns["vcenter"],
+            "rootVcenterPassword": credentials["vcenter_root"],
+            "vmSize": "small",
+            "storageSize": "lstorage",
+            "ssoDomain": "vsphere.local",
+            "version": versions["vcenter_server"],
+            "useExistingDeployment": False,
+        },
+        "clusterSpec": {
+            "datacenterName": "dal01-dc01",
+            "clusterName": "dal01-mgmt01",
+            "clusterEvcMode": "INTEL_SAPPHIRERAPIDS",
+            "resourcePoolSpecs": [
+                {
+                    "name": "dal01-management",
+                    "type": "management",
+                    "cpuReservationPercentage": 25,
+                    "memoryReservationPercentage": 25,
+                },
+                {"name": "dal01-workloads", "type": "compute"},
+            ],
+        },
+        "dvsSpecs": [
+            {
+                "dvsName": "dal01-vds01",
+                "networks": snapshot["greenfield"]["required_network_types"],
+                "mtu": 9000,
+                "vmnicsToUplinks": [
+                    {"id": "vmnic0", "uplink": "uplink1"},
+                    {"id": "vmnic1", "uplink": "uplink2"},
+                ],
+            }
+        ],
+        "nsxtSpec": {
+            "nsxtManagers": [{"hostname": item} for item in fqdns["nsx_managers"]],
+            "nsxtManagerSize": "medium",
+            "vipFqdn": fqdns["nsx_vip"],
+            "rootNsxtManagerPassword": credentials["nsx_root"],
+            "nsxtAdminPassword": credentials["nsx_admin"],
+            "nsxtAuditPassword": credentials["nsx_audit"],
+            "transportVlanId": 130,
+            "ipAddressPoolSpec": {
+                "name": tep["name"],
+                "description": "Host overlay TEP addresses",
+                "subnets": [
+                    {
+                        "cidr": tep["cidr"],
+                        "gateway": tep["gateway"],
+                        "ipAddressPoolRanges": [{"start": tep["start"], "end": tep["end"]}],
+                    }
+                ],
+            },
+            "version": versions["nsx"],
+            "useExistingDeployment": False,
+        },
+        "networkSpecs": networks,
+        "dnsSpec": {
+            "subdomain": requirements["dns"]["subdomain"],
+            "nameservers": requirements["dns"]["nameservers"],
+        },
+        "ntpServers": requirements["dns"]["ntp_servers"],
+        "sddcManagerSpec": {
+            "hostname": fqdns["sddc_manager"],
+            "rootPassword": credentials["sddc_root"],
+            "sshPassword": credentials["sddc_vcf"],
+            "localUserPassword": credentials["sddc_local_admin"],
+            "version": versions["sddc_manager"],
+            "useExistingDeployment": False,
+        },
+        "managementPoolName": "dal01-management-pool",
+        "ceipEnabled": False,
+        "skipEsxThumbprintValidation": False,
+        "skipGatewayPingValidation": False,
+        "securitySpec": {"esxiCertsMode": "VMCA"},
+        "datastoreSpec": {
+            "vsanSpec": {
+                "datastoreName": "dal01-vsan01",
+                "esaConfig": {"enabled": True},
+                "failuresToTolerate": snapshot["greenfield"]["storage"]["failures_to_tolerate"],
+            }
+        },
+        "vspClusterSpec": {
+            "platformFqdn": fqdns["vsp_platform"],
+            "systemUserPassword": credentials["vsp_system"],
+            "ipv4Pool": {"addresses": _addresses(pool["start"], pool["end"])},
+            "size": "small",
+            "internalClusterCidrIpv4": requirements["internal_cluster_cidr_ipv4"],
+            "instanceFqdn": fqdns["vsp_instance"],
+            "fleetFqdn": fqdns["vsp_fleet"],
+            "version": versions["vcf_management_services"],
+            "useExistingDeployment": False,
+        },
+        "fleetLcmSpec": {"version": versions["vcf_management_services"], "size": "small"},
+        "sddcLcmSpec": {"version": versions["vcf_management_services"], "size": "small"},
+        "fleetDepotSpec": {"version": versions["vcf_management_services"], "size": "small"},
+        "telemetryAcceptorSpec": {"version": versions["vcf_management_services"], "size": "small"},
+        "saltSpec": {"version": versions["vcf_management_services"], "size": "small"},
+        "saltRaasSpec": {"version": versions["vcf_management_services"], "size": "small"},
+        "vcfOperationsSpec": {
+            "nodes": [
+                {"hostname": fqdns["vcf_operations"][0], "type": "master"},
+                {"hostname": fqdns["vcf_operations"][1], "type": "replica"},
+                {"hostname": fqdns["vcf_operations"][2], "type": "data"},
+            ],
+            "applianceSize": "medium",
+            "loadBalancerFqdn": fqdns["vcf_operations_load_balancer"],
+            "useExistingDeployment": False,
+            "version": versions["vcf_operations"],
+        },
+        "vcfManagementComponentsInfrastructureSpec": {
+            "localRegionNetwork": {
+                "networkName": "dal01-management",
+                "subnetMask": "255.255.255.0",
+                "gateway": "10.10.0.1",
+            }
+        },
+        "licenseServerSpec": {
+            "hostname": fqdns["license_server"],
+            "version": versions["license_server"],
+            "useExistingDeployment": False,
+        },
+    }
+
+
+GATE_DESCRIPTIONS = {
+    "operations-health": "Aria Operations health and cluster state checks are clean.",
+    "operations-pak-staged": "The VCF Operations 9.1 upgrade package is staged in lifecycle management.",
+    "operations-9.1-ready": "VCF Operations 9.1 is online and ready to orchestrate the next phase.",
+    "collector-group-defined": "The cloud proxy collector group and SDDC adapter mapping are defined.",
+    "sddc-prechecks-clean": "SDDC Manager lifecycle prechecks report no blocking findings.",
+    "management-pool-12-ips": "Twelve management-network addresses are reserved for management services.",
+    "dns-forward-reverse": "Forward and reverse DNS records resolve for management components.",
+    "internal-cidr-nonoverlap": "The VSP internal service CIDR does not overlap routed site networks.",
+    "nsx-upgrade-precheck": "NSX management-plane upgrade and interoperability prechecks are clean.",
+    "management-services-ready": "VCF Management Services reports ready before core component lifecycle continues.",
+    "nsx-management-plane-ready": "All NSX Manager nodes are upgraded and the management plane is healthy.",
+    "vcenter-password-compatible": "The vCenter root credential meets the VCF 9.1 length requirements.",
+    "vcenter-9.1-ready": "vCenter 9.1 is online and compatible with the staged ESXi image.",
+    "n-plus-one-capacity": "The cluster retains workload and management capacity with one host in maintenance.",
+    "all-hosts-9.1-ready": "Every ESXi host has completed the rolling 9.1 upgrade and exited maintenance.",
+    "edge-upgrade-precheck": "NSX Edge upgrade and dataplane continuity prechecks are clean.",
+}
+
+
+def _migration(inventory: dict[str, Any], snapshot: dict[str, Any]) -> dict[str, Any]:
+    steps = []
+    for order, contract in enumerate(snapshot["migration"]["ordered_steps"], start=1):
+        steps.append(
+            {
+                "order": order,
+                "step_id": contract["step_id"],
+                "component_id": contract["component_id"],
+                "component_name": contract["component_name"],
+                "from_version": contract["from_versions"][0],
+                "target_component": contract["target_component"],
+                "target_version": contract["target_version"],
+                "action": contract["action"],
+                "gates": [
+                    {
+                        "gate_id": gate_id,
+                        "description": GATE_DESCRIPTIONS[gate_id],
+                        "requires_steps": contract["requires_steps"],
+                    }
+                    for gate_id in contract["required_gate_ids"]
+                ],
+            }
+        )
+    return {
+        "schema_version": "1.0",
+        "estate_id": inventory["estate_id"],
+        "source_vcf_version": inventory["vcf_version"],
+        "target_vcf_version": snapshot["target_vcf_version"],
+        "steps": steps,
+    }
+
+
+def build_architecture(output_dir: str | Path) -> None:
+    requirements = _load("fixtures/design-requirements.json")
+    inventory = _load("fixtures/estate-inventory.json")
+    snapshot = _load("compatibility/compatibility-snapshot.json")
+    sddc_spec = _sddc_spec(requirements, snapshot)
+    migration = _migration(inventory, snapshot)
+
+    destination = Path(output_dir)
+    destination.mkdir(parents=True, exist_ok=True)
+    _write(destination / "sddc-spec.json", sddc_spec)
+    _write(destination / "migration-plan.json", migration)

+"""Command-line entry point for the architecture generator."""
+
+from __future__ import annotations
+
+import argparse
+
+from .builder import build_architecture
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description="Generate the pinned VCF 9.1 architecture")
+    parser.add_argument("--output-dir", default="architecture")
+    args = parser.parse_args()
+    build_architecture(args.output_dir)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

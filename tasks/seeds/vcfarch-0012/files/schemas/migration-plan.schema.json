{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VCF 9.1 ordered migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "estate_id", "source_vcf_version", "target_vcf_version", "steps"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "estate_id": {"type": "string", "minLength": 1},
    "source_vcf_version": {"type": "string", "minLength": 1},
    "target_vcf_version": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/step"}
    }
  },
  "definitions": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "step_id", "component_id", "component_name", "from_version", "target_component", "target_version", "action", "gates"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "step_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "component_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "component_name": {"type": "string", "minLength": 1},
        "from_version": {"type": "string", "minLength": 1},
        "target_component": {"type": "string", "minLength": 1},
        "target_version": {"type": "string", "minLength": 1},
        "action": {"enum": ["deploy", "migrate", "upgrade", "rolling-upgrade"]},
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/gate"}
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "description", "requires_steps"],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
        "description": {"type": "string", "minLength": 8},
        "requires_steps": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
        }
      }
    }
  }
}

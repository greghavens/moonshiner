{
  "openapi": "3.0.1",
  "title": "VMware Cloud Foundation Operations for Networks API Reference",
  "version": "9.0.0.0",
  "server_base_path": "/api/ni",
  "security_schemes": {
    "ApiKeyAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "Authorization",
      "value_prefix": "NetworkInsight "
    }
  },
  "operations": [
    {
      "operationId": "updateSearchBasedAlertConfig",
      "method": "PUT",
      "path": "/settings/alerts/search-based-alerts/{id}",
      "security": "ApiKeyAuth",
      "path_parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "request_body": {
        "required": true,
        "content_type": "application/json",
        "schema": "SearchBasedAlertConfigRequest"
      },
      "responses": {
        "200": "SearchBasedAlertConfigResponse",
        "400": "ApiError",
        "401": "ApiError",
        "403": "ApiError",
        "404": "ApiError",
        "500": null
      }
    }
  ],
  "schemas": {
    "SearchBasedAlertConfigRequest": {
      "type": "object",
      "required": [],
      "properties": {
        "alert_name": {
          "type": "string"
        },
        "search_criteria": {
          "type": "string"
        },
        "generate_alert_criteria": {
          "type": "string",
          "nullable": true,
          "enum": [
            "SEARCH_RESULT_CHANGE",
            "ZERO_SEARCH_RESULTS"
          ]
        },
        "alert_type": {
          "type": "string",
          "nullable": true,
          "enum": [
            "PROBLEM",
            "CHANGE",
            "INTENT"
          ]
        },
        "severity": {
          "type": "string",
          "nullable": true,
          "enum": [
            "Critical",
            "Moderate",
            "Warning",
            "Info"
          ]
        },
        "notification_settings": {
          "type": "array",
          "items": "NotificationSetting"
        }
      }
    },
    "NotificationSetting": {
      "type": "object",
      "required": [],
      "properties": {
        "type": {
          "type": "string",
          "nullable": true,
          "enum": [
            "EMAIL",
            "SNMP",
            "PUSH_NOTIFICATION"
          ]
        },
        "frequency": {
          "type": "string",
          "nullable": true,
          "enum": [
            "IMMEDIATE",
            "DAILY"
          ]
        },
        "notification_time": {
          "type": "string"
        },
        "receivers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "SearchBasedAlertConfigResponse": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string"
        },
        "alert_name": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "search_criteria": {
          "type": "string"
        },
        "generate_alert_criteria": {
          "type": "string",
          "nullable": true
        },
        "alert_type": {
          "type": "string",
          "nullable": true
        },
        "severity": {
          "type": "string",
          "nullable": true
        },
        "notification_settings": {
          "type": "array",
          "items": "NotificationSetting"
        }
      }
    }
  }
}

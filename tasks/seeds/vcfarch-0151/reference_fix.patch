+Set-StrictMode -Version Latest
+
+function Read-VcfArchitectureJson {
+    [CmdletBinding()]
+    param([Parameter(Mandatory)][string]$LiteralPath)
+
+    $resolved = (Resolve-Path -LiteralPath $LiteralPath -ErrorAction Stop).Path
+    Get-Content -LiteralPath $resolved -Raw -Encoding utf8 | ConvertFrom-Json -Depth 100
+}
+
+function Copy-VcfArchitectureObject {
+    [CmdletBinding()]
+    param([Parameter(Mandatory)][object]$InputObject)
+
+    $InputObject | ConvertTo-Json -Depth 100 | ConvertFrom-Json -Depth 100
+}
+
+function Confirm-VcfConnectedInventory {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][object]$Inventory,
+        [Parameter(Mandatory)][string]$SddcManagerServer,
+        [Parameter(Mandatory)][pscredential]$Credential
+    )
+
+    Import-Module VMware.Sdk.Vcf.SddcManager -ErrorAction Stop
+    $connection = $null
+    try {
+        $connection = Connect-VcfSddcManagerServer -Server $SddcManagerServer -Credential $Credential -ErrorAction Stop
+        $domainName = [string]$Inventory.foundation.managementDomain.name
+        $clusterName = [string]$Inventory.foundation.managementDomain.cluster
+        $domainPage = Invoke-VcfGetDomains -Name $domainName -Server $connection -ErrorAction Stop
+        $domains = @($domainPage.Elements | Where-Object Name -CEQ $domainName)
+        if ($domains.Count -ne 1 -or [string]$domains[0].Type -cne 'MANAGEMENT') {
+            throw "Expected exactly one management domain named '$domainName'."
+        }
+        $clusterPage = Invoke-VcfGetClusters -DomainId ([string]$domains[0].Id) -Name $clusterName -Server $connection -ErrorAction Stop
+        $clusters = @($clusterPage.Elements | Where-Object Name -CEQ $clusterName)
+        if ($clusters.Count -ne 1) {
+            throw "Expected exactly one management cluster named '$clusterName', found $($clusters.Count)."
+        }
+    }
+    finally {
+        if ($null -ne $connection) {
+            Disconnect-VcfSddcManagerServer -Server $connection -Force -ErrorAction SilentlyContinue
+        }
+    }
+}
+
+function Get-VcfStepDefinition {
+    [CmdletBinding()]
+    param([Parameter(Mandatory)][string]$Id)
+
+    $definitions = @{
+        'baseline-and-backup' = @{
+            Title = 'Baseline estate and create recoverable backups'
+            Action = 'Match the discovered estate to the fixture, confirm the three supported source versions, export content inventories, and create restorable product backups.'
+        }
+        'upgrade-operations' = @{
+            Title = 'Upgrade Aria Operations to VCF Operations'
+            Action = 'Use Fleet Management to run the supported 8.18.3 to 9.0.2 upgrade, retain native content, replace target-specific management packs, and omit the Horizon pack.'
+        }
+        'validate-operations-ca' = @{
+            Title = 'Validate Operations continuous availability'
+            Action = 'Validate one Medium analytics node in each data-site fault domain, the dedicated CA witness in the third site, and green collection after upgrade.'
+        }
+        'prepare-automation' = @{
+            Title = 'Prepare Aria Automation for import and upgrade'
+            Action = 'Remove the unsupported AVI cloud account, check database footprint and backups, map identity principals, and remediate template action formats.'
+        }
+        'upgrade-automation' = @{
+            Title = 'Import and upgrade Aria Automation'
+            Action = 'Import 8.18.1 into VCF Operations Fleet Management, upgrade it to VCF Automation 9.0.2, replace vIDM with VCF Identity Broker, and smoke-test retained content.'
+        }
+        'deploy-logs-greenfield' = @{
+            Title = 'Deploy VCF Operations for Logs greenfield cluster'
+            Action = 'Deploy four Medium nodes as two nodes per management-domain site, configure the VIP, and run the 8.18.2 and 9.0.2 clusters in parallel.'
+        }
+        'migrate-logs-content-and-data' = @{
+            Title = 'Migrate Logs integrations, content, and supported data'
+            Action = 'Recreate integrations and custom content, install target content packs, transfer the most recent 90 days, and leave older history only on the legacy cluster.'
+        }
+        'cutover-and-retire' = @{
+            Title = 'Cut over integrations and retire legacy endpoints'
+            Action = 'Confirm content accounting and target health, direct producers and users to target endpoints, then disable the three legacy endpoints after rollback closure.'
+        }
+    }
+    if (-not $definitions.ContainsKey($Id)) {
+        throw "No step definition exists for '$Id'."
+    }
+    $definitions[$Id]
+}
+
+function Get-VcfGateDescription {
+    [CmdletBinding()]
+    param([Parameter(Mandatory)][string]$Id)
+
+    $operatorGates = @(
+        'restorable-backups', 'operations-content-exported', 'identity-principal-map-ready',
+        'automation-content-smoke-test', 'all-content-accounted', 'rollback-window-closed'
+    )
+    $kind = if ($Id -in $operatorGates) { 'operator-validation' } else { 'automated-check' }
+    [ordered]@{
+        id = $Id
+        kind = $kind
+        condition = "The $($Id.Replace('-', ' ')) condition is complete and passing."
+        evidence = "Attach the dated validation record for $Id to the migration change record."
+    }
+}
+
+function Test-VcfArchitectureHasMember {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][object]$InputObject,
+        [Parameter(Mandatory)][string]$Name
+    )
+
+    if ($InputObject -is [System.Collections.IDictionary]) {
+        return $InputObject.Contains($Name)
+    }
+    return $null -ne $InputObject.PSObject.Properties[$Name]
+}
+
+function Get-VcfArchitectureMember {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][object]$InputObject,
+        [Parameter(Mandatory)][string]$Name
+    )
+
+    if ($InputObject -is [System.Collections.IDictionary]) {
+        return $InputObject[$Name]
+    }
+    return $InputObject.PSObject.Properties[$Name].Value
+}
+
+function Assert-VcfArchitectureSchema {
+    [CmdletBinding()]
+    param(
+        [AllowNull()][object]$Value,
+        [Parameter(Mandatory)][object]$Schema,
+        [Parameter(Mandatory)][object]$RootSchema,
+        [Parameter(Mandatory)][string]$Path
+    )
+
+    if (Test-VcfArchitectureHasMember -InputObject $Schema -Name '$ref') {
+        $reference = [string](Get-VcfArchitectureMember -InputObject $Schema -Name '$ref')
+        if (-not $reference.StartsWith('#/')) {
+            throw "$Path uses unsupported schema reference '$reference'."
+        }
+        $resolved = $RootSchema
+        foreach ($rawSegment in $reference.Substring(2).Split('/')) {
+            $segment = $rawSegment.Replace('~1', '/').Replace('~0', '~')
+            if (-not (Test-VcfArchitectureHasMember -InputObject $resolved -Name $segment)) {
+                throw "$Path uses unresolvable schema reference '$reference'."
+            }
+            $resolved = Get-VcfArchitectureMember -InputObject $resolved -Name $segment
+        }
+        Assert-VcfArchitectureSchema -Value $Value -Schema $resolved -RootSchema $RootSchema -Path $Path
+        return
+    }
+
+    if (Test-VcfArchitectureHasMember -InputObject $Schema -Name 'const') {
+        $constant = Get-VcfArchitectureMember -InputObject $Schema -Name 'const'
+        if ([string]$Value -cne [string]$constant) {
+            throw "$Path does not equal the required constant."
+        }
+    }
+    if (Test-VcfArchitectureHasMember -InputObject $Schema -Name 'enum') {
+        $allowed = Get-VcfArchitectureMember -InputObject $Schema -Name 'enum'
+        if (-not ($allowed | Where-Object { [string]$_ -ceq [string]$Value })) {
+            throw "$Path is not one of the allowed values."
+        }
+    }
+
+    $expectedType = if (Test-VcfArchitectureHasMember -InputObject $Schema -Name 'type') {
+        [string](Get-VcfArchitectureMember -InputObject $Schema -Name 'type')
+    }
+    else {
+        $null
+    }
+    $integerTypes = @(
+        [byte], [sbyte], [int16], [uint16], [int32], [uint32], [int64], [uint64]
+    )
+    $isInteger = $false
+    foreach ($integerType in $integerTypes) {
+        if ($Value -is $integerType) {
+            $isInteger = $true
+            break
+        }
+    }
+    $isObject = $Value -is [System.Collections.IDictionary] -or $Value -is [pscustomobject]
+    $isArray = $Value -is [System.Array] -or $Value -is [System.Collections.IList]
+    $typeMatches = switch ($expectedType) {
+        'object' { $isObject }
+        'array' { $isArray -and $Value -isnot [string] }
+        'string' { $Value -is [string] }
+        'integer' { $isInteger -and $Value -isnot [bool] }
+        'number' { ($Value -is [ValueType]) -and $Value -isnot [bool] }
+        'boolean' { $Value -is [bool] }
+        'null' { $null -eq $Value }
+        default { $true }
+    }
+    if (-not $typeMatches) {
+        throw "$Path must be of schema type '$expectedType'."
+    }
+
+    if ($expectedType -eq 'object') {
+        if (Test-VcfArchitectureHasMember -InputObject $Schema -Name 'required') {
+            $requiredNames = Get-VcfArchitectureMember -InputObject $Schema -Name 'required'
+            foreach ($requiredName in $requiredNames) {
+                if (-not (Test-VcfArchitectureHasMember -InputObject $Value -Name ([string]$requiredName))) {
+                    throw "$Path is missing required property '$requiredName'."
+                }
+            }
+        }
+        $properties = if (Test-VcfArchitectureHasMember -InputObject $Schema -Name 'properties') {
+            Get-VcfArchitectureMember -InputObject $Schema -Name 'properties'
+        }
+        else {
+            [pscustomobject]@{}
+        }
+        if ((Test-VcfArchitectureHasMember -InputObject $Schema -Name 'additionalProperties') -and
+            -not [bool](Get-VcfArchitectureMember -InputObject $Schema -Name 'additionalProperties')) {
+            $valueNames = if ($Value -is [System.Collections.IDictionary]) {
+                @($Value.Keys | ForEach-Object { [string]$_ })
+            }
+            else {
+                @($Value.PSObject.Properties.Name)
+            }
+            foreach ($valueName in $valueNames) {
+                if (-not (Test-VcfArchitectureHasMember -InputObject $properties -Name $valueName)) {
+                    throw "$Path contains unexpected property '$valueName'."
+                }
+            }
+        }
+        $propertyNames = if ($properties -is [System.Collections.IDictionary]) {
+            @($properties.Keys | ForEach-Object { [string]$_ })
+        }
+        else {
+            @($properties.PSObject.Properties.Name)
+        }
+        foreach ($propertyName in $propertyNames) {
+            if (Test-VcfArchitectureHasMember -InputObject $Value -Name $propertyName) {
+                if ($Value -is [System.Collections.IDictionary]) {
+                    $childValue = $Value[$propertyName]
+                }
+                else {
+                    $childValue = $Value.PSObject.Properties[$propertyName].Value
+                }
+                $childSchema = Get-VcfArchitectureMember -InputObject $properties -Name $propertyName
+                Assert-VcfArchitectureSchema -Value $childValue -Schema $childSchema -RootSchema $RootSchema -Path "$Path.$propertyName"
+            }
+        }
+    }
+
+    if ($expectedType -eq 'array') {
+        $items = @($Value)
+        if ((Test-VcfArchitectureHasMember -InputObject $Schema -Name 'minItems') -and
+            $items.Count -lt [int](Get-VcfArchitectureMember -InputObject $Schema -Name 'minItems')) {
+            throw "$Path has too few items."
+        }
+        if ((Test-VcfArchitectureHasMember -InputObject $Schema -Name 'maxItems') -and
+            $items.Count -gt [int](Get-VcfArchitectureMember -InputObject $Schema -Name 'maxItems')) {
+            throw "$Path has too many items."
+        }
+        if ((Test-VcfArchitectureHasMember -InputObject $Schema -Name 'uniqueItems') -and
+            [bool](Get-VcfArchitectureMember -InputObject $Schema -Name 'uniqueItems')) {
+            $encoded = @($items | ForEach-Object { $_ | ConvertTo-Json -Depth 100 -Compress })
+            if (@($encoded | Select-Object -Unique).Count -ne $encoded.Count) {
+                throw "$Path must contain unique items."
+            }
+        }
+        if (Test-VcfArchitectureHasMember -InputObject $Schema -Name 'items') {
+            $itemSchema = Get-VcfArchitectureMember -InputObject $Schema -Name 'items'
+            for ($index = 0; $index -lt $items.Count; $index++) {
+                Assert-VcfArchitectureSchema -Value $items[$index] -Schema $itemSchema -RootSchema $RootSchema -Path "$Path[$index]"
+            }
+        }
+    }
+
+    if ($expectedType -eq 'string') {
+        if ((Test-VcfArchitectureHasMember -InputObject $Schema -Name 'minLength') -and
+            $Value.Length -lt [int](Get-VcfArchitectureMember -InputObject $Schema -Name 'minLength')) {
+            throw "$Path is shorter than the schema minimum."
+        }
+        if (Test-VcfArchitectureHasMember -InputObject $Schema -Name 'pattern') {
+            $pattern = [string](Get-VcfArchitectureMember -InputObject $Schema -Name 'pattern')
+            if (-not [regex]::IsMatch($Value, $pattern)) {
+                throw "$Path does not match the schema pattern."
+            }
+        }
+    }
+
+    if ($expectedType -in @('integer', 'number') -and
+        (Test-VcfArchitectureHasMember -InputObject $Schema -Name 'minimum') -and
+        $Value -lt (Get-VcfArchitectureMember -InputObject $Schema -Name 'minimum')) {
+        throw "$Path is below the schema minimum."
+    }
+}
+
+function Test-VcfMigrationArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory, ValueFromPipeline)][object]$Plan,
+        [Parameter(Mandatory)][string]$InstallerSpecPath
+    )
+    process {
+        $spec = Read-VcfArchitectureJson -LiteralPath $InstallerSpecPath
+        if ([string]::IsNullOrWhiteSpace([string]$spec.artifactPath)) {
+            throw 'Installer specification has no artifactPath.'
+        }
+        Assert-VcfArchitectureSchema -Value $Plan -Schema $spec.artifactSchema -RootSchema $spec.artifactSchema -Path '$'
+        $true
+    }
+}
+
+function New-VcfMigrationArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][string]$InventoryPath,
+        [Parameter(Mandatory)][string]$CompatibilitySnapshotPath,
+        [Parameter(Mandatory)][string]$InstallerSpecPath,
+        [Parameter(Mandatory)][object[]]$ResearchSources,
+        [Parameter(Mandatory)][string]$OutputPath,
+        [string]$GeneratedOn = (Get-Date).ToString('yyyy-MM-dd'),
+        [string]$SddcManagerServer,
+        [pscredential]$Credential,
+        [switch]$Offline
+    )
+
+    $inventory = Read-VcfArchitectureJson -LiteralPath $InventoryPath
+    $snapshot = Read-VcfArchitectureJson -LiteralPath $CompatibilitySnapshotPath
+    if (-not $Offline) {
+        if ([string]::IsNullOrWhiteSpace($SddcManagerServer) -or $null -eq $Credential) {
+            throw 'Connected mode requires SddcManagerServer and Credential. Use -Offline only for fixture rendering.'
+        }
+        Confirm-VcfConnectedInventory -Inventory $inventory -SddcManagerServer $SddcManagerServer -Credential $Credential
+    }
+
+    $rulesByProduct = @{}
+    foreach ($rule in $snapshot.migrationRules) { $rulesByProduct[[string]$rule.sourceProductId] = $rule }
+    $contentRulesByProduct = @{}
+    foreach ($property in $snapshot.contentRules.PSObject.Properties) {
+        $itemRules = @{}
+        foreach ($itemRule in $property.Value) { $itemRules[[string]$itemRule.contentId] = $itemRule }
+        $contentRulesByProduct[$property.Name] = $itemRules
+    }
+
+    $migrations = foreach ($product in $inventory.products) {
+        $productId = [string]$product.id
+        $rule = $rulesByProduct[$productId]
+        $dispositions = foreach ($item in $product.content) {
+            $itemRule = $contentRulesByProduct[$productId][[string]$item.id]
+            [ordered]@{
+                contentId = [string]$item.id
+                type = [string]$item.type
+                name = [string]$item.name
+                disposition = [string]$itemRule.disposition
+                targetTreatment = [string]$itemRule.targetTreatment
+            }
+        }
+        [ordered]@{
+            id = $productId
+            source = [ordered]@{
+                id = $productId
+                name = [string]$product.name
+                version = [string]$product.version
+                formerName = [string]$product.formerName
+            }
+            target = [ordered]@{
+                id = [string]$rule.targetComponentId
+                name = [string]$rule.targetName
+                version = [string]$rule.targetVersion
+            }
+            path = [ordered]@{
+                mode = [string]$rule.mode
+                supported = [bool]$rule.supported
+            }
+            supportBoundary = [ordered]@{
+                endOfGeneralSupport = [string]$rule.endOfGeneralSupport
+                statusAtPlanDate = 'supported'
+            }
+            contentDisposition = @($dispositions)
+        }
+    }
+
+    $targetDesign = $snapshot.targetDesign
+    $managementDomain = [ordered]@{
+        name = [string]$targetDesign.managementDomain.name
+        cluster = [string]$targetDesign.managementDomain.cluster
+        stretchedAcross = @($targetDesign.managementDomain.dataSites)
+        foundationWitness = [ordered]@{
+            name = [string]$targetDesign.managementDomain.foundationWitnessName
+            site = [string]$targetDesign.managementDomain.foundationWitnessSite
+            runsTargetWorkloads = [bool]$targetDesign.managementDomain.foundationWitnessRunsTargetWorkloads
+        }
+    }
+
+    $steps = @()
+    for ($index = 0; $index -lt @($snapshot.orderedStepRules).Count; $index++) {
+        $rule = $snapshot.orderedStepRules[$index]
+        $definition = Get-VcfStepDefinition -Id ([string]$rule.id)
+        $dependencies = [System.Collections.Generic.List[string]]::new()
+        if ($index -gt 0) {
+            $dependencies.Add([string]$snapshot.orderedStepRules[$index - 1].id)
+        }
+        $gates = foreach ($gateId in $snapshot.requiredGateIds.([string]$rule.id)) {
+            Get-VcfGateDescription -Id ([string]$gateId)
+        }
+        $steps += [ordered]@{
+            order = [int]$rule.order
+            id = [string]$rule.id
+            migrationId = [string]$rule.migrationId
+            title = [string]$definition.Title
+            action = [string]$definition.Action
+            dependsOn = $dependencies
+            gates = @($gates)
+        }
+    }
+
+    $plan = [ordered]@{
+        schemaVersion = '1.0'
+        estateId = [string]$inventory.estateId
+        generatedOn = $GeneratedOn
+        researchConsulted = @($ResearchSources)
+        architecture = [ordered]@{
+            managementDomain = $managementDomain
+            targets = @(Copy-VcfArchitectureObject -InputObject $targetDesign.components)
+        }
+        migrations = @($migrations)
+        orderedSteps = @($steps)
+    }
+
+    Test-VcfMigrationArchitecture -Plan ([pscustomobject]$plan) -InstallerSpecPath $InstallerSpecPath | Out-Null
+    $json = $plan | ConvertTo-Json -Depth 100
+    $parent = Split-Path -Parent $OutputPath
+    if (-not [string]::IsNullOrWhiteSpace($parent)) {
+        New-Item -ItemType Directory -Path $parent -Force | Out-Null
+    }
+    Set-Content -LiteralPath $OutputPath -Value $json -Encoding utf8
+    [pscustomobject]$plan
+}
+
+Export-ModuleMember -Function New-VcfMigrationArchitecture, Test-VcfMigrationArchitecture

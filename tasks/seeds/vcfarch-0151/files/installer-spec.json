{
  "specVersion": "1.0",
  "artifactPath": "migration-plan.json",
  "module": {
    "directory": "VcfMigrationArchitecture",
    "manifestPath": "VcfMigrationArchitecture/VcfMigrationArchitecture.psd1",
    "implementationPath": "VcfMigrationArchitecture/VcfMigrationArchitecture.psm1",
    "name": "VcfMigrationArchitecture",
    "requiredPowerCliModules": [
      "VMware.Sdk.Vcf.SddcManager"
    ],
    "requiredExports": [
      "New-VcfMigrationArchitecture",
      "Test-VcfMigrationArchitecture"
    ]
  },
  "inputs": {
    "estateInventory": "estate-inventory.json",
    "compatibilitySnapshot": "compatibility-snapshot.json"
  },
  "artifactSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:northstar:vcf-migration-plan:1.0",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "estateId",
      "generatedOn",
      "researchConsulted",
      "architecture",
      "migrations",
      "orderedSteps"
    ],
    "properties": {
      "schemaVersion": {"const": "1.0"},
      "estateId": {"$ref": "#/$defs/nonEmptyString"},
      "generatedOn": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
      "researchConsulted": {
        "type": "array",
        "minItems": 4,
        "items": {"$ref": "#/$defs/researchSource"}
      },
      "architecture": {"$ref": "#/$defs/architecture"},
      "migrations": {
        "type": "array",
        "minItems": 3,
        "items": {"$ref": "#/$defs/migration"}
      },
      "orderedSteps": {
        "type": "array",
        "minItems": 1,
        "items": {"$ref": "#/$defs/orderedStep"}
      }
    },
    "$defs": {
      "nonEmptyString": {
        "type": "string",
        "minLength": 1
      },
      "researchSource": {
        "type": "object",
        "additionalProperties": false,
        "required": ["publisher", "title", "uri", "accessedOn", "topics"],
        "properties": {
          "publisher": {"const": "Broadcom"},
          "title": {"$ref": "#/$defs/nonEmptyString"},
          "uri": {"type": "string", "pattern": "^https://.+"},
          "accessedOn": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "topics": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/nonEmptyString"}
          }
        }
      },
      "foundationWitness": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "site", "runsTargetWorkloads"],
        "properties": {
          "name": {"$ref": "#/$defs/nonEmptyString"},
          "site": {"$ref": "#/$defs/nonEmptyString"},
          "runsTargetWorkloads": {"type": "boolean"}
        }
      },
      "managementDomain": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "cluster", "stretchedAcross", "foundationWitness"],
        "properties": {
          "name": {"$ref": "#/$defs/nonEmptyString"},
          "cluster": {"$ref": "#/$defs/nonEmptyString"},
          "stretchedAcross": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/nonEmptyString"}
          },
          "foundationWitness": {"$ref": "#/$defs/foundationWitness"}
        }
      },
      "targetNode": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "site", "vCpu", "memoryGb", "storageGb"],
        "properties": {
          "id": {"$ref": "#/$defs/nonEmptyString"},
          "role": {"$ref": "#/$defs/nonEmptyString"},
          "site": {"$ref": "#/$defs/nonEmptyString"},
          "vCpu": {"type": "integer", "minimum": 1},
          "memoryGb": {"type": "integer", "minimum": 1},
          "storageGb": {"type": "integer", "minimum": 1}
        }
      },
      "targetComponent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "componentId",
          "name",
          "version",
          "deploymentModel",
          "sizeProfile",
          "nodeCount",
          "capacityBasis",
          "nodes",
          "placementRules"
        ],
        "properties": {
          "componentId": {"$ref": "#/$defs/nonEmptyString"},
          "name": {"$ref": "#/$defs/nonEmptyString"},
          "version": {"$ref": "#/$defs/nonEmptyString"},
          "deploymentModel": {"$ref": "#/$defs/nonEmptyString"},
          "sizeProfile": {"$ref": "#/$defs/nonEmptyString"},
          "nodeCount": {"type": "integer", "minimum": 1},
          "capacityBasis": {"$ref": "#/$defs/nonEmptyString"},
          "nodes": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/targetNode"}
          },
          "placementRules": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/nonEmptyString"}
          }
        }
      },
      "architecture": {
        "type": "object",
        "additionalProperties": false,
        "required": ["managementDomain", "targets"],
        "properties": {
          "managementDomain": {"$ref": "#/$defs/managementDomain"},
          "targets": {
            "type": "array",
            "minItems": 3,
            "items": {"$ref": "#/$defs/targetComponent"}
          }
        }
      },
      "productEndpoint": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version"],
        "properties": {
          "id": {"$ref": "#/$defs/nonEmptyString"},
          "name": {"$ref": "#/$defs/nonEmptyString"},
          "version": {"$ref": "#/$defs/nonEmptyString"},
          "formerName": {"$ref": "#/$defs/nonEmptyString"}
        }
      },
      "migrationPath": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode", "supported"],
        "properties": {
          "mode": {"$ref": "#/$defs/nonEmptyString"},
          "supported": {"type": "boolean"}
        }
      },
      "supportBoundary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["endOfGeneralSupport", "statusAtPlanDate"],
        "properties": {
          "endOfGeneralSupport": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "statusAtPlanDate": {"enum": ["supported", "end-of-support"]}
        }
      },
      "contentDisposition": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contentId", "type", "name", "disposition", "targetTreatment"],
        "properties": {
          "contentId": {"$ref": "#/$defs/nonEmptyString"},
          "type": {"$ref": "#/$defs/nonEmptyString"},
          "name": {"$ref": "#/$defs/nonEmptyString"},
          "disposition": {"enum": ["carry", "reconfigure", "replace", "abandon"]},
          "targetTreatment": {"$ref": "#/$defs/nonEmptyString"}
        }
      },
      "migration": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "target", "path", "supportBoundary", "contentDisposition"],
        "properties": {
          "id": {"$ref": "#/$defs/nonEmptyString"},
          "source": {"$ref": "#/$defs/productEndpoint"},
          "target": {"$ref": "#/$defs/productEndpoint"},
          "path": {"$ref": "#/$defs/migrationPath"},
          "supportBoundary": {"$ref": "#/$defs/supportBoundary"},
          "contentDisposition": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/contentDisposition"}
          }
        }
      },
      "gate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "condition", "evidence"],
        "properties": {
          "id": {"$ref": "#/$defs/nonEmptyString"},
          "kind": {"enum": ["automated-check", "operator-validation"]},
          "condition": {"$ref": "#/$defs/nonEmptyString"},
          "evidence": {"$ref": "#/$defs/nonEmptyString"}
        }
      },
      "orderedStep": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "id", "migrationId", "title", "action", "dependsOn", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "id": {"$ref": "#/$defs/nonEmptyString"},
          "migrationId": {"$ref": "#/$defs/nonEmptyString"},
          "title": {"$ref": "#/$defs/nonEmptyString"},
          "action": {"$ref": "#/$defs/nonEmptyString"},
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/nonEmptyString"}
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/gate"}
          }
        }
      }
    }
  }
}

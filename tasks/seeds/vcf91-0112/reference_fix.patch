+
+func validateBacking(backing StorageBacking) *ValidationError {
+	switch backing.Type {
+	case StorageBackingDatastore:
+		if backing.DatastoreID == nil ||
+			strings.TrimSpace(*backing.DatastoreID) == "" ||
+			hasControl(*backing.DatastoreID) ||
+			backing.StorageURI != nil {
+			return &ValidationError{Field: "StorageBackings"}
+		}
+	case StorageBackingOther:
+		if backing.StorageURI == nil ||
+			strings.TrimSpace(*backing.StorageURI) == "" ||
+			hasControl(*backing.StorageURI) ||
+			backing.DatastoreID != nil {
+			return &ValidationError{Field: "StorageBackings"}
+		}
+		location, err := url.Parse(*backing.StorageURI)
+		if err != nil ||
+			!location.IsAbs() ||
+			location.Scheme == "" ||
+			(location.Host == "" && location.Path == "" && location.Opaque == "") {
+			return &ValidationError{Field: "StorageBackings"}
+		}
+	default:
+		return &ValidationError{Field: "StorageBackings"}
+	}
+	return nil
+}
+
+func hasControl(value string) bool {
+	for _, character := range value {
+		if character < 32 || character == 127 {
+			return true
+		}
+	}
+	return false
+}
+
+func isUUID(value string) bool {
+	if len(value) != 36 {
+		return false
+	}
+	for index := 0; index < len(value); index++ {
+		switch index {
+		case 8, 13, 18, 23:
+			if value[index] != '-' {
+				return false
+			}
+		default:
+			if !isHex(value[index]) {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func isHex(value byte) bool {
+	return value >= '0' && value <= '9' ||
+		value >= 'a' && value <= 'f' ||
+		value >= 'A' && value <= 'F'
 }

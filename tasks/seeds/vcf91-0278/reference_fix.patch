+                throw new IOException("unexpected character '" + text.charAt(pos) + "' at offset " + pos);
+            }
+            String literal = text.substring(start, pos);
+            try {
+                if (literal.indexOf('.') < 0 && literal.indexOf('e') < 0 && literal.indexOf('E') < 0) {

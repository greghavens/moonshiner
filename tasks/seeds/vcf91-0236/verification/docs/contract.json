{
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repositoryCommitSha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "specPath": "specifications/sddc-lcm/sddc-lcm-openapi.yaml",
    "license": "Apache-2.0",
    "openapi": "3.0.4",
    "infoTitle": "VCF SDDC LCM Service APIs",
    "infoVersion": "9.1.0.0",
    "serverUrl": "https://vcf.broadcom.com/sddc-lcm",
    "serviceBasePath": "/sddc-lcm",
    "documentationPageUsedAsContractSource": false
  },
  "projectionNotes": [
    "Only the four operationIds required by this integration are projected.",
    "Schema 'example' blocks are omitted.",
    "Task.result (and its precheck/validation closure) is omitted; this integration never reads it."
  ],
  "operations": [
    {
      "operationId": "generateComponentSupportBundle",
      "method": "POST",
      "path": "/v1/components/{componentId}/support-bundles",
      "parameters": [
        {
          "name": "X-Correlation-Id",
          "in": "header",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "componentId",
          "in": "path",
          "required": true,
          "schema": {
            "format": "uuid",
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "required": false,
        "contentType": "application/json",
        "schemaRef": "#/components/schemas/ComponentSupportBundleSpec"
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "contentType": "application/json",
          "schema": {
            "$ref": "#/components/schemas/Task"
          }
        },
        "401": {
          "description": "Unauthorized",
          "contentType": "application/json",
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        },
        "404": {
          "description": "The specified resource was not found",
          "contentType": "application/json",
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        },
        "500": {
          "description": "Internal server error",
          "contentType": "application/json",
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "security": [
        {
          "scheme": "bearerToken",
          "type": "http",
          "httpScheme": "Bearer",
          "bearerFormat": "JWT"
        }
      ],
      "specJsonPointer": "/paths/~1v1~1components~1{componentId}~1support-bundles/post"
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{taskId}",
      "parameters": [
        {
          "name": "taskId",
          "in": "path",
          "required": true,
          "schema": {
            "format": "uuid",
            "type": "string"
          }
        }
      ],
      "requestBody": null,
      "responses": {
        "200": {
          "description": "OK",
          "contentType": "application/json",
          "schema": {
            "$ref": "#/components/schemas/Task"
          }
        },
        "404": {
          "description": "Not Found",
          "contentType": "application/json",
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        },
        "500": {
          "description": "Internal Server Error",
          "contentType": "application/json",
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "security": [
        {
          "scheme": "bearerToken",
          "type": "http",
          "httpScheme": "Bearer",
          "bearerFormat": "JWT"
        }
      ],
      "specJsonPointer": "/paths/~1v1~1tasks~1{taskId}/get"
    },
    {
      "operationId": "getComponentSupportBundles",
      "method": "GET",
      "path": "/v1/components/{componentId}/support-bundles",
      "parameters": [
        {
          "name": "componentId",
          "in": "path",
          "required": true,
          "schema": {
            "format": "uuid",
            "type": "string"
          }
        }
      ],
      "requestBody": null,
      "responses": {
        "200": {
          "description": "OK",
          "contentType": "application/json",
          "schema": {
            "items": {
              "$ref": "#/components/schemas/SupportBundle"
            },
            "type": "array"
          }
        },
        "401": {
          "description": "Unauthorized",
          "contentType": "application/json",
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        },
        "404": {
          "description": "The specified resource was not found",
          "contentType": "application/json",
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        },
        "500": {
          "description": "Internal server error",
          "contentType": "application/json",
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "security": [
        {
          "scheme": "bearerToken",
          "type": "http",
          "httpScheme": "Bearer",
          "bearerFormat": "JWT"
        }
      ],
      "specJsonPointer": "/paths/~1v1~1components~1{componentId}~1support-bundles/get"
    },
    {
      "operationId": "deleteComponentSupportBundle",
      "method": "DELETE",
      "path": "/v1/components/{componentId}/support-bundles/{supportBundleId}",
      "parameters": [
        {
          "name": "X-Correlation-Id",
          "in": "header",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "componentId",
          "in": "path",
          "required": true,
          "schema": {
            "format": "uuid",
            "type": "string"
          }
        },
        {
          "name": "supportBundleId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": null,
      "responses": {
        "202": {
          "description": "Accepted",
          "contentType": "application/json",
          "schema": {
            "$ref": "#/components/schemas/Task"
          }
        },
        "401": {
          "description": "Unauthorized",
          "contentType": "application/json",
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        },
        "404": {
          "description": "The specified resource was not found",
          "contentType": "application/json",
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        },
        "500": {
          "description": "Internal server error",
          "contentType": "application/json",
          "schema": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        }
      },
      "security": [
        {
          "scheme": "bearerToken",
          "type": "http",
          "httpScheme": "Bearer",
          "bearerFormat": "JWT"
        }
      ],
      "specJsonPointer": "/paths/~1v1~1components~1{componentId}~1support-bundles~1{supportBundleId}/delete"
    }
  ],
  "components": {
    "schemas": {
      "ComponentSupportBundleSpec": {
        "description": "Component Support bundle Spec",
        "properties": {
          "lookBackWindow": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Provides detailed information about an error that occurred during a system operation.\n",
        "properties": {
          "code": {
            "description": "Unique error code for programmatic identification.",
            "type": "string"
          },
          "message": {
            "$ref": "#/components/schemas/LocalizableMessage"
          },
          "resolution": {
            "$ref": "#/components/schemas/LocalizableMessage"
          },
          "referenceId": {
            "description": "An identifier for tracing the error in the logs.",
            "type": "string"
          },
          "timestamp": {
            "description": "The date and time when the error occurred.",
            "format": "date-time",
            "type": "string"
          },
          "detail": {
            "description": "Freeform extra information, such as raw error payloads or additional context.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "referenceId",
          "resolution",
          "timestamp"
        ],
        "type": "object"
      },
      "LocalizableMessage": {
        "properties": {
          "id": {
            "description": "ID of the Localizable message.",
            "type": "string"
          },
          "defaultMessage": {
            "description": "Default message in English.",
            "type": "string"
          },
          "localizedMessage": {
            "description": "Localized message.",
            "type": "string"
          },
          "args": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Key-Value pair arguments that will be substitited in the message.",
            "type": "object"
          }
        },
        "type": "object"
      },
      "SupportBundle": {
        "properties": {
          "id": {
            "type": "string"
          },
          "createdTimestamp": {
            "description": "Time when the operation is started.",
            "format": "date-time",
            "type": "string"
          },
          "size": {
            "description": "Size of support bundle in bytes",
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "description": "File name of the support bundle",
            "type": "string"
          },
          "url": {
            "description": "Download URL of the support bundle from VMSP",
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Task": {
        "description": "Represents a hierarchical task structure supporting nested sub-tasks and execution steps.\nFor complete examples demonstrating the hierarchical task model with sub-tasks, steps, and \nvarious execution scenarios, see: classpath:sample-task-example.yaml\n",
        "properties": {
          "id": {
            "description": "Unique identifier for the task (UUID format)",
            "type": "string"
          },
          "name": {
            "description": "Unique name of the task",
            "type": "string"
          },
          "description": {
            "$ref": "#/components/schemas/LocalizableMessage"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "type": {
            "description": "Type of the task, example precheck, apply, validate, etc.",
            "type": "string"
          },
          "createdBy": {
            "description": "username or service account that triggered the task.",
            "type": "string"
          },
          "updatedBy": {
            "description": "username or service account that updated the task.",
            "type": "string"
          },
          "resourceId": {
            "description": "ID of resource on which the task is triggered",
            "type": "string"
          },
          "resourceType": {
            "description": "Type of resource on which the task is triggered",
            "type": "string"
          },
          "createTime": {
            "description": "ISO 8601 timestamp when this Task was created",
            "format": "date-time",
            "type": "string"
          },
          "startTime": {
            "description": "ISO 8601 timestamp when this Task was started",
            "format": "date-time",
            "type": "string"
          },
          "updateTime": {
            "description": "ISO 8601 timestamp when this Task was updated",
            "format": "date-time",
            "type": "string"
          },
          "endTime": {
            "description": "ISO 8601 timestamp when this Task was completed",
            "format": "date-time",
            "type": "string"
          },
          "correlationId": {
            "description": "ID used to correlate the task with other systems",
            "type": "string"
          },
          "parentTaskId": {
            "description": "ID of parent task",
            "type": "string"
          },
          "retriable": {
            "description": "Indicates if this task is in a state that can be retried",
            "type": "boolean"
          },
          "cancellable": {
            "description": "Indicates if this task is in a state that can be cancelled",
            "type": "boolean"
          },
          "taskSummary": {
            "$ref": "#/components/schemas/Task_taskSummary"
          },
          "stages": {
            "description": "list of steps being executed in the Task workflow.",
            "items": {
              "$ref": "#/components/schemas/TaskStage"
            },
            "type": "array"
          },
          "subTasks": {
            "description": "list of sub tasks within this parent task. Each sub task can have its own steps and can be executed independently.\nSee classpath:sample-task-example.yaml for comprehensive examples of hierarchical task structures.\n",
            "items": {
              "$ref": "#/components/schemas/Task"
            },
            "type": "array"
          },
          "messages": {
            "description": "list of messages at task level",
            "items": {
              "$ref": "#/components/schemas/TaskMessage"
            },
            "type": "array"
          },
          "additionalDetails": {
            "description": "A map of task-specific details. This can be used to store any additional information about the task that is relevant to a specific task.",
            "type": "object"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "TaskMessage": {
        "properties": {
          "timestamp": {
            "format": "date-time",
            "type": "string"
          },
          "level": {
            "enum": [
              "INFO",
              "WARN",
              "ERROR"
            ],
            "type": "string"
          },
          "message": {
            "$ref": "#/components/schemas/LocalizableMessage"
          }
        },
        "type": "object"
      },
      "TaskStage": {
        "properties": {
          "id": {
            "description": "ID of step",
            "type": "string"
          },
          "name": {
            "description": "name of step",
            "type": "string"
          },
          "description": {
            "$ref": "#/components/schemas/LocalizableMessage"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStageStatus"
          },
          "updateTime": {
            "description": "ISO 8601 timestamp when the step was updated",
            "format": "date-time",
            "type": "string"
          },
          "startTime": {
            "description": "ISO 8601 timestamp when step started",
            "format": "date-time",
            "type": "string"
          },
          "endTime": {
            "description": "ISO 8601 timestamp when step ended",
            "format": "date-time",
            "type": "string"
          },
          "messages": {
            "description": "list of messages",
            "items": {
              "$ref": "#/components/schemas/TaskStageMessage"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "TaskStageMessage": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TaskMessage"
          },
          {
            "properties": {
              "stageId": {
                "type": "string"
              }
            },
            "type": "object"
          }
        ]
      },
      "TaskStageStatus": {
        "description": "Defines possible task step states",
        "enum": [
          "PENDING",
          "RUNNING",
          "SUCCEEDED",
          "FAILED",
          "CANCELED",
          "SKIPPED"
        ],
        "type": "string"
      },
      "TaskStatus": {
        "description": "A common status object to define the lifecycle state of an operation",
        "enum": [
          "PENDING",
          "SCHEDULED",
          "RUNNING",
          "SUCCEEDED",
          "FAILED",
          "CANCELED"
        ],
        "type": "string"
      },
      "Task_taskSummary": {
        "description": "Summary information about sub tasks.\nSee sample-task-example.yaml for examples of how this summary is calculated.\n",
        "properties": {
          "totalSubTasks": {
            "description": "Total number of sub tasks in this task",
            "type": "integer"
          },
          "totalSteps": {
            "description": "Total number of steps across all sub tasks and this task",
            "type": "integer"
          }
        },
        "readOnly": true,
        "type": "object"
      }
    }
  }
}

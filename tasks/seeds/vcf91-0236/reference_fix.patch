+    /** Orders a SupportBundle listing newest first, keeping reply order among equal timestamps. */
+    private static List<BundleRef> newestFirst(Object listing) {
+        List<BundleRef> bundles = new ArrayList<>();
+        for (Object entry : J.array(listing)) {
+            bundles.add(
+                    new BundleRef(
+                            J.string(J.get(entry, "id")),
+                            J.string(J.get(entry, "name")),
+                            J.longValue(J.get(entry, "size")),
+                            J.string(J.get(entry, "createdTimestamp")),
+                            J.string(J.get(entry, "url"))));
+        }
+        bundles.sort(Comparator.comparing(SddcLcmSupportBundleClient::instantOf).reversed());
+        return bundles;
+    }
+
+    private static Instant instantOf(BundleRef bundle) {
+        String raw = bundle.createdTimestamp();
+        if (raw == null || raw.isEmpty()) {
+            return Instant.EPOCH;
+        }
+        try {
+            return Instant.parse(raw);
+        } catch (DateTimeParseException e) {
+            return Instant.EPOCH;
+        }
+    }

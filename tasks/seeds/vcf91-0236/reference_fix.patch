+    private static String originOf(String baseUrl) {
+        if (baseUrl == null || baseUrl.isBlank()) {
+            throw new IllegalArgumentException("baseUrl is required");
+        }
+        URI uri;
+        try {
+            uri = new URI(baseUrl.trim());
+        } catch (URISyntaxException e) {
+            throw new IllegalArgumentException("baseUrl is not a valid URL", e);
+        }
+        String scheme = uri.getScheme();
+        if (scheme == null || !(scheme.equalsIgnoreCase("http") || scheme.equalsIgnoreCase("https"))) {
+            throw new IllegalArgumentException("baseUrl must be an absolute http or https URL");
+        }
+        if (uri.getHost() == null || uri.getHost().isEmpty()) {
+            throw new IllegalArgumentException("baseUrl must carry a host");
+        }
+        if (uri.getRawUserInfo() != null) {
+            throw new IllegalArgumentException("baseUrl must not carry userinfo");
+        }
+        if (uri.getRawQuery() != null) {
+            throw new IllegalArgumentException("baseUrl must not carry a query string");
+        }
+        if (uri.getRawFragment() != null) {
+            throw new IllegalArgumentException("baseUrl must not carry a fragment");
+        }
+        String path = uri.getRawPath();
+        if (path != null && !path.isEmpty() && !path.equals("/")) {
+            throw new IllegalArgumentException("baseUrl must not carry a path");
+        }
+        return scheme.toLowerCase(java.util.Locale.ROOT) + "://" + uri.getRawAuthority();
+    }

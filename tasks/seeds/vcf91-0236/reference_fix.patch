+    /**
+     * Polls {@code getTask} until the task reports a terminal status, waiting {@link #pollInterval}
+     * between polls and giving up once {@link #pollTimeout} has passed.
+     */
+    private Object driveToTerminal(String componentId, String taskId, List<ComponentOutcome> completed)
+            throws CollectionException {
+
+        String taskPath = "/v1/tasks/" + segment(taskId);
+        long deadline = System.nanoTime() + pollTimeout.toNanos();
+        while (true) {
+            Object task =
+                    exchange(
+                            authorized(taskPath, false).GET().build(),
+                            OP_GET_TASK,
+                            componentId,
+                            200,
+                            completed);
+            String status = J.string(J.get(task, "status"));
+            if (status == null || status.isEmpty()) {
+                throw new SddcLcmProtocolException(
+                        OP_GET_TASK, componentId, "task carries no status", report(completed));
+            }
+            if (isTerminal(status)) {
+                return task;
+            }
+            if (!isContinuing(status)) {
+                throw new SddcLcmProtocolException(
+                        OP_GET_TASK, componentId, "unknown task status", report(completed));
+            }
+            long remaining = deadline - System.nanoTime();
+            if (remaining <= 0) {
+                throw new TaskPollTimeoutException(
+                        componentId, taskId, status, pollTimeout, report(completed));
+            }
+            long sleepNanos = Math.min(pollInterval.toNanos(), remaining);
+            sleep(sleepNanos);
+            if (sleepNanos == remaining) {
+                throw new TaskPollTimeoutException(
+                        componentId, taskId, status, pollTimeout, report(completed));
+            }
+        }
+    }
+
+    private static boolean isTerminal(String status) {
+        return STATUS_SUCCEEDED.equals(status)
+                || STATUS_FAILED.equals(status)
+                || STATUS_CANCELED.equals(status);
+    }
+
+    private static boolean isContinuing(String status) {
+        return STATUS_PENDING.equals(status)
+                || STATUS_SCHEDULED.equals(status)
+                || STATUS_RUNNING.equals(status);
+    }
+
+    private static void sleep(long nanos) {
+        try {
+            Thread.sleep(Duration.ofNanos(nanos));
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            throw new IllegalStateException("interrupted while polling", e);
+        }
+    }

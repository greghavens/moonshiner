+    /** Reads the failing stage name and its first ERROR-level message from a terminal task. */
+    private static String[] describeFailure(Object task) {
+        for (Object stage : J.array(J.get(task, "stages"))) {
+            if (!STATUS_FAILED.equals(J.string(J.get(stage, "status")))) {
+                continue;
+            }
+            String name = J.string(J.get(stage, "name"));
+            for (Object message : J.array(J.get(stage, "messages"))) {
+                if ("ERROR".equals(J.string(J.get(message, "level")))) {
+                    return new String[] {name, J.string(J.get(message, "message", "defaultMessage"))};
+                }
+            }
+            return new String[] {name, null};
+        }
+        return new String[] {null, null};
+    }

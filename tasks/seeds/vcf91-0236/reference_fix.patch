+    private ComponentOutcome collectOne(
+            ComponentRequest request, int retain, List<ComponentOutcome> completed)
+            throws CollectionException {
+
+        String componentId = request.componentId();
+        String bundlesPath = "/v1/components/" + segment(componentId) + "/support-bundles";
+
+        HttpRequest generate =
+                authorized(bundlesPath, true)
+                        .header("Content-Type", "application/json")
+                        .POST(HttpRequest.BodyPublishers.ofString(
+                                supportBundleSpec(request.lookBackWindow()), StandardCharsets.UTF_8))
+                        .build();
+        Object accepted =
+                exchange(
+                        generate, OP_GENERATE_COMPONENT_SUPPORT_BUNDLE, componentId, 202, completed);
+
+        String taskId = J.string(J.get(accepted, "id"));
+        if (taskId == null || taskId.isEmpty()) {
+            throw new SddcLcmProtocolException(
+                    OP_GENERATE_COMPONENT_SUPPORT_BUNDLE, componentId, "no task id", report(completed));
+        }
+
+        Object terminal = driveToTerminal(componentId, taskId, completed);
+        String status = J.string(J.get(terminal, "status"));
+
+        if (!STATUS_SUCCEEDED.equals(status)) {
+            String[] failure = describeFailure(terminal);
+            return new ComponentOutcome(
+                    componentId, taskId, status, null, failure[0], failure[1], List.of());
+        }
+
+        Object listing =
+                exchange(
+                        authorized(bundlesPath, false).GET().build(),
+                        OP_GET_COMPONENT_SUPPORT_BUNDLES,
+                        componentId,
+                        200,
+                        completed);
+
+        List<BundleRef> ordered = newestFirst(listing);
+        if (ordered.isEmpty()) {
+            throw new SddcLcmProtocolException(
+                    OP_GET_COMPONENT_SUPPORT_BUNDLES,
+                    componentId,
+                    "no bundle after a SUCCEEDED generation task",
+                    report(completed));
+        }
+
+        List<String> pruned = new ArrayList<>();
+        if (retain > 0 && ordered.size() > retain) {
+            for (int i = ordered.size() - 1; i >= retain; i--) {
+                String bundleId = ordered.get(i).id();
+                String deletePath = bundlesPath + "/" + segment(bundleId);
+                HttpRequest delete =
+                        authorized(deletePath, true)
+                                .method("DELETE", HttpRequest.BodyPublishers.noBody())
+                                .build();
+                Object deleteTask =
+                        exchange(
+                                delete, OP_DELETE_COMPONENT_SUPPORT_BUNDLE, componentId, 202, completed);
+                String deleteTaskId = J.string(J.get(deleteTask, "id"));
+                if (deleteTaskId == null || deleteTaskId.isEmpty()) {
+                    throw new SddcLcmProtocolException(
+                            OP_DELETE_COMPONENT_SUPPORT_BUNDLE, componentId, "no task id", report(completed));
+                }
+                driveToTerminal(componentId, deleteTaskId, completed);
+                pruned.add(bundleId);
+            }
+        }
+
+        return new ComponentOutcome(
+                componentId, taskId, status, ordered.get(0), null, null, pruned);
+    }

+    /** Sends a request, enforcing the single status the contract documents as success. */
+    private Object exchange(
+            HttpRequest request,
+            String operationId,
+            String componentId,
+            int successStatus,
+            List<ComponentOutcome> completed)
+            throws CollectionException {
+
+        HttpResponse<String> response;
+        try {
+            response = httpClient.send(request, HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+        } catch (IOException e) {
+            throw new SddcLcmTransportException(operationId, componentId, report(completed), e);
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            throw new SddcLcmTransportException(operationId, componentId, report(completed), e);
+        }
+
+        if (response.statusCode() != successStatus) {
+            Object error = parseQuietly(response.body());
+            throw new SddcLcmApiException(
+                    operationId,
+                    componentId,
+                    response.statusCode(),
+                    J.string(J.get(error, "code")),
+                    J.string(J.get(error, "message", "defaultMessage")),
+                    J.string(J.get(error, "referenceId")),
+                    report(completed));
+        }
+        try {
+            return J.parse(response.body());
+        } catch (RuntimeException e) {
+            throw new SddcLcmProtocolException(
+                    operationId, componentId, "reply is not JSON", report(completed));
+        }
+    }
+
+    private static Object parseQuietly(String body) {
+        try {
+            return J.parse(body);
+        } catch (RuntimeException e) {
+            return null;
+        }
+    }

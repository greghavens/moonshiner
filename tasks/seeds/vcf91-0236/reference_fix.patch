+    private static void rejectControlCharacters(String what, String value) {
+        for (int i = 0; i < value.length(); i++) {
+            char c = value.charAt(i);
+            if (c < 0x20 || c == 0x7f) {
+                throw new IllegalArgumentException(what + " must not contain control characters");
+            }
+        }
+    }
+
+    private static Duration positive(String what, Duration value, Duration fallback) {
+        if (value == null) {
+            return fallback;
+        }
+        if (value.isZero() || value.isNegative()) {
+            throw new IllegalArgumentException(what + " must be positive");
+        }
+        return value;
     }
 

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:northstar:vcf-migration-plan:1.0",
  "title": "Northstar VCF migration installer plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "estate_id",
    "plan_date",
    "target_bundle",
    "research",
    "target_architecture",
    "migrations",
    "steps"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "estate_id": {"type": "string", "minLength": 1},
    "plan_date": {"type": "string", "format": "date"},
    "target_bundle": {"$ref": "#/$defs/productVersion"},
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "reconciliation"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["publisher", "title", "url", "consulted_on", "supports"],
            "properties": {
              "publisher": {"type": "string", "minLength": 1},
              "title": {"type": "string", "minLength": 1},
              "url": {"type": "string", "format": "uri"},
              "consulted_on": {"type": "string", "format": "date"},
              "supports": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": ["upgrade_path", "content_compatibility", "product_lifecycle", "placement", "sizing"]
                }
              }
            }
          }
        },
        "reconciliation": {"type": "string", "minLength": 20}
      }
    },
    "target_architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "capacity_rollup"],
      "properties": {
        "components": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/targetComponent"}
        },
        "capacity_rollup": {"$ref": "#/$defs/capacityRollup"}
      }
    },
    "migrations": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/migration"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "productVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "version"],
      "properties": {
        "product": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vcpu", "memory_gib", "storage_gib"],
      "properties": {
        "vcpu": {"type": "integer", "minimum": 0},
        "memory_gib": {"type": "integer", "minimum": 0},
        "storage_gib": {"type": "integer", "minimum": 0}
      }
    },
    "targetComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "product",
        "version",
        "site",
        "workload_domain",
        "cluster",
        "network",
        "datastore",
        "vip_fqdn",
        "profile",
        "node_count",
        "fault_domains",
        "vcpu_per_node",
        "memory_gib_per_node",
        "storage_gib_per_node",
        "sizing_basis"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "product": {"enum": ["VCF Operations", "VCF Automation", "VCF Operations for Logs"]},
        "version": {"type": "string", "minLength": 1},
        "site": {"type": "string", "minLength": 1},
        "workload_domain": {"type": "string", "minLength": 1},
        "cluster": {"type": "string", "minLength": 1},
        "network": {"type": "string", "minLength": 1},
        "datastore": {"type": "string", "minLength": 1},
        "vip_fqdn": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "node_count": {"type": "integer", "minimum": 1},
        "fault_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "vcpu_per_node": {"type": "integer", "minimum": 1},
        "memory_gib_per_node": {"type": "integer", "minimum": 1},
        "storage_gib_per_node": {"type": "integer", "minimum": 1},
        "sizing_basis": {"type": "string", "minLength": 20}
      }
    },
    "capacityRollup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned", "remaining_after_plan", "required_reserve"],
      "properties": {
        "planned": {"$ref": "#/$defs/resources"},
        "remaining_after_plan": {"$ref": "#/$defs/resources"},
        "required_reserve": {"$ref": "#/$defs/resources"}
      }
    },
    "contentDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "disposition", "mechanism", "destination", "rationale"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["carry", "recreate", "abandon"]},
        "mechanism": {"type": "string", "minLength": 1},
        "destination": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 20}
      }
    },
    "supportBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "release_line", "end_of_general_support"],
      "properties": {
        "product": {"type": "string", "minLength": 1},
        "release_line": {"type": "string", "minLength": 1},
        "end_of_general_support": {"type": "string", "format": "date"}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_component_id",
        "source",
        "target_component_id",
        "target",
        "strategy",
        "support_boundary",
        "content"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_component_id": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/productVersion"},
        "target_component_id": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/productVersion"},
        "strategy": {"type": "string", "minLength": 1},
        "support_boundary": {"$ref": "#/$defs/supportBoundary"},
        "content": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/contentDisposition"}
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "condition", "evidence"],
      "properties": {
        "type": {"enum": ["entry", "exit"]},
        "condition": {"type": "string", "minLength": 20},
        "evidence": {"type": "string", "minLength": 10}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "id", "migration_id", "operation", "action", "gates"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "id": {"type": "string", "minLength": 1},
        "migration_id": {"type": "string", "minLength": 1},
        "operation": {
          "enum": [
            "prepare_fleet",
            "deploy_target",
            "export_content",
            "import_content",
            "import_existing",
            "upgrade_in_place",
            "transfer_data",
            "reconfigure",
            "validate",
            "cutover",
            "retire_source"
          ]
        },
        "action": {"type": "string", "minLength": 20},
        "gates": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/gate"}
        }
      }
    }
  }
}

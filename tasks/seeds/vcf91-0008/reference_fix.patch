diff --git a/VcfFailureEvidence/VcfFailureEvidence.psm1 b/VcfFailureEvidence/VcfFailureEvidence.psm1
new file mode 100644
index 0000000..114e3b8
--- /dev/null
+++ b/VcfFailureEvidence/VcfFailureEvidence.psm1
@@ -0,0 +1,447 @@
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+Import-Module -Name 'VMware.Sdk.Vcf.SddcManager' `
+    -RequiredVersion '13.5.0.25380678' `
+    -ErrorAction Stop
+
+function Get-ExactVcfSddcManagerCommand {
+    param([Parameter(Mandatory)] [string] $OperationId)
+
+    $operations = @(
+        Get-VcfSddcManagerOperation -Name $OperationId -ErrorAction Stop
+    )
+    if ($operations.Count -ne 1 -or $null -eq $operations[0].CommandInfo) {
+        throw [System.InvalidOperationException]::new(
+            "The genuine SDK did not resolve exactly one $OperationId operation."
+        )
+    }
+    $commands = @(
+        Get-Command `
+            -Name ([string] $operations[0].CommandInfo.Name) `
+            -CommandType Cmdlet `
+            -ErrorAction Stop
+    )
+    if ($commands.Count -ne 1 -or
+        $commands[0].Source -cne 'VMware.Sdk.Vcf.SddcManager') {
+        throw [System.InvalidOperationException]::new(
+            "The $OperationId operation is not supplied by the genuine SDK."
+        )
+    }
+    $commands[0]
+}
+
+function Get-VcfPropertyValue {
+    param(
+        [AllowNull()] [object] $InputObject,
+        [Parameter(Mandatory)] [string] $Name
+    )
+
+    if ($null -eq $InputObject) {
+        return $null
+    }
+    $property = $InputObject.PSObject.Properties[$Name]
+    if ($null -eq $property) {
+        return $null
+    }
+    $property.Value
+}
+
+function Get-RequiredVcfText {
+    param(
+        [Parameter(Mandatory)] [object] $InputObject,
+        [Parameter(Mandatory)] [string] $Name,
+        [Parameter(Mandatory)] [string] $Context
+    )
+
+    $value = Get-VcfPropertyValue -InputObject $InputObject -Name $Name
+    if ($null -eq $value -or
+        [string]::IsNullOrWhiteSpace([string] $value)) {
+        throw [System.InvalidOperationException]::new(
+            "$Context has no nonblank $Name."
+        )
+    }
+    [string] $value
+}
+
+function ConvertTo-VcfStatus {
+    param([AllowNull()] [object] $Value)
+
+    if ($null -eq $Value) {
+        return ''
+    }
+    (([string] $Value).Trim() -replace '\s+', '_').ToUpperInvariant()
+}
+
+function Get-VcfCollection {
+    param(
+        [AllowNull()] [object] $InputObject,
+        [Parameter(Mandatory)] [string] $Name
+    )
+
+    $value = Get-VcfPropertyValue -InputObject $InputObject -Name $Name
+    if ($null -eq $value) {
+        return ,([object[]] @())
+    }
+    return ,([object[]] @($value))
+}
+
+function Get-FailedLeafVcfSubTasks {
+    param(
+        [Parameter(Mandatory)]
+        [AllowEmptyCollection()]
+        [object[]] $SubTasks
+    )
+
+    $failedLeaves = [System.Collections.Generic.List[object]]::new()
+    $pending = [System.Collections.Generic.Stack[object]]::new()
+    for ($index = $SubTasks.Count - 1; $index -ge 0; $index--) {
+        if ($null -ne $SubTasks[$index]) {
+            $pending.Push($SubTasks[$index])
+        }
+    }
+    while ($pending.Count -gt 0) {
+        $current = $pending.Pop()
+        $children = Get-VcfCollection `
+            -InputObject $current `
+            -Name 'SubTasks'
+        if ($children.Count -eq 0 -and
+            (ConvertTo-VcfStatus (
+                Get-VcfPropertyValue -InputObject $current -Name 'Status'
+            )) -ceq 'FAILED') {
+            $failedLeaves.Add($current)
+        }
+        for ($index = $children.Count - 1; $index -ge 0; $index--) {
+            if ($null -ne $children[$index]) {
+                $pending.Push($children[$index])
+            }
+        }
+    }
+    return ,([object[]] $failedLeaves.ToArray())
+}
+
+function Get-VcfFailureEvidence {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateNotNull()]
+        [object] $Server,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNull()]
+        [string] $TaskId,
+
+        [ValidateRange(0, 60)]
+        [int] $PollIntervalSeconds = 2,
+
+        [ValidateRange(1, 900)]
+        [int] $TimeoutSeconds = 300
+    )
+
+    if ([string]::IsNullOrWhiteSpace($TaskId)) {
+        throw [System.ArgumentException]::new(
+            'TaskId cannot be blank.',
+            'TaskId'
+        )
+    }
+
+    $getTask = Get-ExactVcfSddcManagerCommand -OperationId 'getTask'
+    $getWarnings = Get-ExactVcfSddcManagerCommand `
+        -OperationId 'getResourceWarnings'
+    $startBundle = Get-ExactVcfSddcManagerCommand `
+        -OperationId 'startSupportBundle'
+    $getBundleStatus = Get-ExactVcfSddcManagerCommand `
+        -OperationId 'getSupportBundleStatus'
+
+    $taskValues = @(
+        & $getTask -Id $TaskId -Server $Server -ErrorAction Stop
+    )
+    if ($taskValues.Count -ne 1 -or $null -eq $taskValues[0]) {
+        throw [System.InvalidOperationException]::new(
+            'getTask did not return exactly one task.'
+        )
+    }
+    $task = $taskValues[0]
+    $returnedTaskId = Get-RequiredVcfText `
+        -InputObject $task `
+        -Name 'Id' `
+        -Context 'getTask response'
+    if ($returnedTaskId -cne $TaskId) {
+        throw [System.InvalidOperationException]::new(
+            'getTask returned a different task id.'
+        )
+    }
+    if ((ConvertTo-VcfStatus (
+        Get-VcfPropertyValue -InputObject $task -Name 'Status'
+    )) -cne 'FAILED') {
+        throw [System.InvalidOperationException]::new(
+            'The requested task is not in FAILED status.'
+        )
+    }
+    $taskName = Get-RequiredVcfText `
+        -InputObject $task `
+        -Name 'Name' `
+        -Context 'getTask response'
+
+    $rootSubTasks = Get-VcfCollection -InputObject $task -Name 'SubTasks'
+    $failedLeaves = Get-FailedLeafVcfSubTasks -SubTasks $rootSubTasks
+    if ($failedLeaves.Count -ne 1) {
+        throw [System.InvalidOperationException]::new(
+            'The task does not have exactly one failed leaf subtask.'
+        )
+    }
+    $failedSubTask = $failedLeaves[0]
+    $failedSubTaskName = Get-RequiredVcfText `
+        -InputObject $failedSubTask `
+        -Name 'Name' `
+        -Context 'failed leaf subtask'
+
+    $failedStages = @(
+        foreach ($stage in (
+            Get-VcfCollection -InputObject $failedSubTask -Name 'Stages'
+        )) {
+            if ($null -ne $stage -and
+                (ConvertTo-VcfStatus (
+                    Get-VcfPropertyValue -InputObject $stage -Name 'Status'
+                )) -ceq 'FAILED') {
+                $stage
+            }
+        }
+    )
+    if ($failedStages.Count -ne 1) {
+        throw [System.InvalidOperationException]::new(
+            'The failed leaf subtask does not have exactly one failed stage.'
+        )
+    }
+    $failedStage = $failedStages[0]
+    $failedStageName = Get-RequiredVcfText `
+        -InputObject $failedStage `
+        -Name 'Name' `
+        -Context 'failed stage'
+
+    $stageErrors = Get-VcfCollection -InputObject $failedStage -Name 'Errors'
+    if ($stageErrors.Count -ne 1 -or $null -eq $stageErrors[0]) {
+        throw [System.InvalidOperationException]::new(
+            'The failed stage does not have exactly one error.'
+        )
+    }
+    $stageError = $stageErrors[0]
+    $errorCode = Get-RequiredVcfText `
+        -InputObject $stageError -Name 'ErrorCode' -Context 'failed stage error'
+    $errorMessage = Get-RequiredVcfText `
+        -InputObject $stageError -Name 'Message' -Context 'failed stage error'
+    $remediationMessage = Get-RequiredVcfText `
+        -InputObject $stageError `
+        -Name 'RemediationMessage' `
+        -Context 'failed stage error'
+    $referenceToken = Get-RequiredVcfText `
+        -InputObject $stageError `
+        -Name 'ReferenceToken' `
+        -Context 'failed stage error'
+
+    $resources = Get-VcfCollection -InputObject $failedSubTask -Name 'Resources'
+    if ($resources.Count -ne 1 -or $null -eq $resources[0]) {
+        throw [System.InvalidOperationException]::new(
+            'The failed leaf subtask does not have exactly one resource.'
+        )
+    }
+    $resource = $resources[0]
+    $resourceId = Get-RequiredVcfText `
+        -InputObject $resource -Name 'ResourceId' -Context 'failed resource'
+    $resourceType = (
+        Get-RequiredVcfText `
+            -InputObject $resource -Name 'Type' -Context 'failed resource'
+    ).Trim().ToUpperInvariant()
+    $resourceName = Get-RequiredVcfText `
+        -InputObject $resource -Name 'Name' -Context 'failed resource'
+    $logSelection = switch ($resourceType) {
+        'VCENTER' { 'vcLogs'; break }
+        'NSXT_MANAGER' { 'nsxLogs'; break }
+        'ESXI' { 'esxLogs'; break }
+        'SDDC_MANAGER' { 'sddcManagerLogs'; break }
+        default {
+            throw [System.InvalidOperationException]::new(
+                "Unsupported failed resource type '$resourceType'."
+            )
+        }
+    }
+
+    $warningPageValues = @(
+        & $getWarnings `
+            -ResourceType $resourceType `
+            -ResourceIds @($resourceId) `
+            -Server $Server `
+            -ErrorAction Stop
+    )
+    if ($warningPageValues.Count -ne 1 -or
+        $null -eq $warningPageValues[0]) {
+        throw [System.InvalidOperationException]::new(
+            'getResourceWarnings did not return exactly one page.'
+        )
+    }
+    $warningElementsValue = Get-VcfPropertyValue `
+        -InputObject $warningPageValues[0] `
+        -Name 'Elements'
+    if ($null -eq $warningElementsValue) {
+        throw [System.InvalidOperationException]::new(
+            'getResourceWarnings returned no elements collection.'
+        )
+    }
+    $matchingWarnings = @(
+        foreach ($warning in @($warningElementsValue)) {
+            if ($null -eq $warning) { continue }
+            $associatedTask = Get-VcfPropertyValue `
+                -InputObject $warning `
+                -Name 'AssociatedTask'
+            $warningResourceId = [string] (
+                Get-VcfPropertyValue -InputObject $warning -Name 'ResourceId'
+            )
+            $warningResourceType = (
+                [string] (
+                    Get-VcfPropertyValue -InputObject $warning -Name 'ResourceType'
+                )
+            ).Trim().ToUpperInvariant()
+            $warningTaskId = [string] (
+                Get-VcfPropertyValue `
+                    -InputObject $associatedTask `
+                    -Name 'TaskId'
+            )
+            $warningReference = [string] (
+                Get-VcfPropertyValue `
+                    -InputObject $warning `
+                    -Name 'ReferenceToken'
+            )
+            if ($warningResourceId -ceq $resourceId -and
+                $warningResourceType -ceq $resourceType -and
+                $warningTaskId -ceq $TaskId -and
+                -not [string]::IsNullOrWhiteSpace($warningReference) -and
+                $warningReference -ceq $referenceToken) {
+                $warning
+            }
+        }
+    )
+    if ($matchingWarnings.Count -ne 1) {
+        throw [System.InvalidOperationException]::new(
+            'The warning page does not contain exactly one correlated warning.'
+        )
+    }
+    $warning = $matchingWarnings[0]
+    $warningCode = Get-RequiredVcfText `
+        -InputObject $warning -Name 'WarningCode' -Context 'correlated warning'
+    $warningMessage = Get-RequiredVcfText `
+        -InputObject $warning -Name 'Message' -Context 'correlated warning'
+
+    $logsArguments = @{}
+    $logsArguments[$logSelection] = $true
+    $logs = Initialize-VcfLogs @logsArguments -ErrorAction Stop
+    $bundleSpec = Initialize-VcfSupportBundleSpec `
+        -Logs $logs `
+        -ErrorAction Stop
+    $startedValues = @(
+        & $startBundle `
+            -SupportBundleSpec $bundleSpec `
+            -Server $Server `
+            -ErrorAction Stop
+    )
+    if ($startedValues.Count -ne 1 -or $null -eq $startedValues[0]) {
+        throw [System.InvalidOperationException]::new(
+            'startSupportBundle did not return exactly one support bundle.'
+        )
+    }
+    $bundleId = Get-RequiredVcfText `
+        -InputObject $startedValues[0] `
+        -Name 'Id' `
+        -Context 'startSupportBundle response'
+
+    $timer = [System.Diagnostics.Stopwatch]::StartNew()
+    $completedBundle = $null
+    while ($true) {
+        if ($timer.Elapsed.TotalSeconds -ge $TimeoutSeconds) {
+            throw [System.TimeoutException]::new(
+                "Timed out waiting for support bundle '$bundleId'."
+            )
+        }
+        $statusValues = @(
+            & $getBundleStatus `
+                -Id $bundleId `
+                -Server $Server `
+                -ErrorAction Stop
+        )
+        if ($statusValues.Count -ne 1 -or $null -eq $statusValues[0]) {
+            throw [System.InvalidOperationException]::new(
+                'getSupportBundleStatus did not return exactly one bundle.'
+            )
+        }
+        $statusBundle = $statusValues[0]
+        $returnedBundleId = Get-RequiredVcfText `
+            -InputObject $statusBundle `
+            -Name 'Id' `
+            -Context 'getSupportBundleStatus response'
+        if ($returnedBundleId -cne $bundleId) {
+            throw [System.InvalidOperationException]::new(
+                'getSupportBundleStatus returned a different bundle id.'
+            )
+        }
+        $bundleStatus = ConvertTo-VcfStatus (
+            Get-VcfPropertyValue -InputObject $statusBundle -Name 'Status'
+        )
+        switch ($bundleStatus) {
+            'COMPLETED_WITH_SUCCESS' {
+                $completedBundle = $statusBundle
+                break
+            }
+            'COMPLETED_WITH_FAILURE' {
+                throw [System.InvalidOperationException]::new(
+                    "Support bundle '$bundleId' failed."
+                )
+            }
+            { $_ -in @('PENDING', 'IN_PROGRESS') } { }
+            default {
+                throw [System.InvalidOperationException]::new(
+                    "Support bundle '$bundleId' returned unexpected status '$bundleStatus'."
+                )
+            }
+        }
+        if ($null -ne $completedBundle) { break }
+        if ($PollIntervalSeconds -gt 0) {
+            $remainingMilliseconds = [math]::Floor(
+                ($TimeoutSeconds - $timer.Elapsed.TotalSeconds) * 1000
+            )
+            if ($remainingMilliseconds -le 0) {
+                throw [System.TimeoutException]::new(
+                    "Timed out waiting for support bundle '$bundleId'."
+                )
+            }
+            Start-Sleep -Milliseconds ([int] [math]::Min(
+                $PollIntervalSeconds * 1000,
+                $remainingMilliseconds
+            ))
+        }
+    }
+    $bundleName = Get-RequiredVcfText `
+        -InputObject $completedBundle `
+        -Name 'BundleName' `
+        -Context 'completed support bundle'
+
+    [pscustomobject] [ordered] @{
+        taskId              = $TaskId
+        taskName            = $taskName
+        failedSubTask       = $failedSubTaskName
+        failedStage         = $failedStageName
+        errorCode           = $errorCode
+        errorMessage        = $errorMessage
+        remediationMessage  = $remediationMessage
+        referenceToken      = $referenceToken
+        resourceId          = $resourceId
+        resourceType        = $resourceType
+        resourceName        = $resourceName
+        warningCode         = $warningCode
+        warningMessage      = $warningMessage
+        supportBundleId     = $bundleId
+        supportBundleName   = $bundleName
+        supportBundleStatus = 'COMPLETED_WITH_SUCCESS'
+        logSelection        = $logSelection
+    }
+}
+
+Export-ModuleMember -Function Get-VcfFailureEvidence

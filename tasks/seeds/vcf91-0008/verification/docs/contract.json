{
  "contractFormat": "focused-openapi-projection-v1",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repositoryCommitSha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "specPath": "specifications/sddc-manager/sddc-manager-openapi.json",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "apiVersion": "9.1.0.0"
  },
  "operations": [
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "summary": "Retrieve a task by its ID",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "description": "Task id to retrieve",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": false,
      "responses": {
        "200": {
          "description": "A task object.",
          "contentType": "application/json",
          "schema": "Task"
        },
        "404": {
          "description": "Task not found",
          "schema": "Error"
        },
        "500": {
          "description": "Unexpected error",
          "schema": "Error"
        }
      }
    },
    {
      "operationId": "getResourceWarnings",
      "method": "GET",
      "path": "/v1/resource-warnings",
      "summary": "Get Resource Warnings",
      "parameters": [
        {
          "name": "resourceType",
          "in": "query",
          "description": "Resource type",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "resourceIds",
          "in": "query",
          "description": "Resource IDs",
          "required": false,
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        {
          "name": "resourceNames",
          "in": "query",
          "description": "Resource Names",
          "required": false,
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      ],
      "requestBody": false,
      "focusedWireProfile": {
        "boundMembers": [
          "resourceType",
          "resourceIds"
        ],
        "unsetMembers": [
          "resourceNames"
        ],
        "unsetBehavior": "omit"
      },
      "responses": {
        "200": {
          "description": "OK",
          "contentType": "application/json",
          "schema": "PageOfResourceWarning"
        },
        "400": {
          "description": "Bad Request",
          "schema": "Error"
        },
        "500": {
          "description": "Internal Server Error",
          "schema": "Error"
        }
      }
    },
    {
      "operationId": "startSupportBundle",
      "method": "POST",
      "path": "/v1/system/support-bundles",
      "summary": "Start a Support Bundle operation using SoS",
      "parameters": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "SupportBundleSpec"
      },
      "focusedWireProfile": {
        "supportBundleSpecMembers": [
          "logs"
        ],
        "unsetSupportBundleSpecMembers": [
          "options",
          "scope"
        ],
        "selectedLogMember": "exactly one of vcLogs, nsxLogs, esxLogs, sddcManagerLogs",
        "selectedLogValue": true,
        "unsetBehavior": "omit"
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "contentType": "application/json",
          "schema": "SupportBundle"
        },
        "400": {
          "description": "Bad request! Invalid Headers or Data.",
          "schema": "Error"
        },
        "401": {
          "description": "Authorization Header is missing or not in correct format.",
          "schema": "Error"
        },
        "409": {
          "description": "Operation is in progress.",
          "schema": "Error"
        },
        "500": {
          "description": "Internal server error.",
          "schema": "Error"
        }
      }
    },
    {
      "operationId": "getSupportBundleStatus",
      "method": "GET",
      "path": "/v1/system/support-bundles/{id}",
      "summary": "Retrive the status of the Support Bundle operation",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "description": "The Support Bundle ID",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": false,
      "responses": {
        "200": {
          "description": "Ok",
          "contentType": "application/json",
          "schema": "SupportBundle"
        },
        "400": {
          "description": "Bad request! Invalid Headers or Data.",
          "schema": "Error"
        },
        "401": {
          "description": "Authorization Header is missing or not in correct format.",
          "schema": "Error"
        },
        "500": {
          "description": "Internal server error.",
          "schema": "Error"
        }
      }
    }
  ],
  "schemas": {
    "Task": {
      "required": [
        "creationTimestamp",
        "id",
        "name",
        "status"
      ],
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "readOnly": true
        },
        "localizableDescriptionPack": {
          "$ref": "MessagePack"
        },
        "type": {
          "type": "string",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "readOnly": true
        },
        "creationTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "completionTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "subTasks": {
          "type": "array",
          "readOnly": true,
          "items": {
            "$ref": "SubTask"
          }
        },
        "errors": {
          "type": "array",
          "readOnly": true,
          "items": {
            "$ref": "Error"
          }
        },
        "resources": {
          "type": "array",
          "readOnly": true,
          "items": {
            "$ref": "Resource"
          }
        },
        "resolutionStatus": {
          "type": "string",
          "readOnly": true
        },
        "isCancellable": {
          "type": "boolean",
          "readOnly": true
        },
        "isRetryable": {
          "type": "boolean",
          "readOnly": true
        }
      }
    },
    "SubTask": {
      "required": [
        "creationTimestamp",
        "description",
        "name",
        "status"
      ],
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "readOnly": true
        },
        "type": {
          "type": "string",
          "readOnly": true
        },
        "description": {
          "type": "string",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "readOnly": true
        },
        "creationTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "completionTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "stages": {
          "type": "array",
          "readOnly": true,
          "items": {
            "$ref": "Stage"
          }
        },
        "errors": {
          "type": "array",
          "readOnly": true,
          "items": {
            "$ref": "Error"
          }
        },
        "resources": {
          "type": "array",
          "readOnly": true,
          "items": {
            "$ref": "Resource"
          }
        },
        "subTasks": {
          "type": "array",
          "readOnly": true,
          "items": {
            "$ref": "SubTask"
          }
        },
        "documentationLink": {
          "$ref": "DocumentationLink"
        }
      }
    },
    "Stage": {
      "required": [
        "creationTimestamp",
        "description",
        "name",
        "status",
        "type"
      ],
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "readOnly": true
        },
        "type": {
          "type": "string",
          "readOnly": true
        },
        "description": {
          "type": "string",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "readOnly": true
        },
        "creationTimestamp": {
          "type": "string"
        },
        "completionTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "errors": {
          "type": "array",
          "readOnly": true,
          "items": {
            "$ref": "Error"
          }
        }
      }
    },
    "Resource": {
      "required": [
        "resourceId",
        "type"
      ],
      "type": "object",
      "properties": {
        "resourceId": {
          "type": "string"
        },
        "fqdn": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sans": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "readOnly": true
    },
    "Error": {
      "type": "object",
      "properties": {
        "errorCode": {
          "type": "string",
          "readOnly": true
        },
        "errorType": {
          "type": "string",
          "readOnly": true
        },
        "arguments": {
          "type": "array",
          "readOnly": true,
          "items": {
            "type": "string",
            "readOnly": true
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "readOnly": true
          },
          "readOnly": true
        },
        "notifications": {
          "type": "array",
          "readOnly": true,
          "items": {
            "$ref": "ValidationNotification"
          }
        },
        "message": {
          "type": "string",
          "readOnly": true
        },
        "remediationMessage": {
          "type": "string"
        },
        "causes": {
          "type": "array",
          "items": {
            "$ref": "ErrorCause"
          }
        },
        "nestedErrors": {
          "type": "array",
          "items": {
            "$ref": "Error"
          }
        },
        "referenceToken": {
          "type": "string",
          "readOnly": true
        },
        "label": {
          "type": "string",
          "readOnly": true
        },
        "remediationUrl": {
          "type": "string",
          "readOnly": true
        }
      }
    },
    "AssociatedTask": {
      "required": [
        "taskId"
      ],
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string"
        },
        "subTaskId": {
          "type": "string"
        }
      }
    },
    "ResourceWarning": {
      "required": [
        "occurredAtTimestamp"
      ],
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "warningCode": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "remediationMessage": {
          "type": "string"
        },
        "referenceToken": {
          "type": "string"
        },
        "resourceId": {
          "type": "string"
        },
        "resourceType": {
          "type": "string"
        },
        "resourceName": {
          "type": "string"
        },
        "warningType": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "occurredAtTimestamp": {
          "type": "string"
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "associatedTask": {
          "$ref": "AssociatedTask"
        }
      }
    },
    "PageOfResourceWarning": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "items": {
            "$ref": "ResourceWarning"
          }
        },
        "pageMetadata": {
          "$ref": "PageMetadata"
        }
      }
    },
    "Logs": {
      "type": "object",
      "properties": {
        "vcLogs": {
          "type": "boolean"
        },
        "nsxLogs": {
          "type": "boolean"
        },
        "esxLogs": {
          "type": "boolean"
        },
        "hcxLogs": {
          "type": "boolean"
        },
        "wcpLogs": {
          "type": "boolean"
        },
        "sddcManagerLogs": {
          "type": "boolean"
        },
        "apiLogs": {
          "type": "boolean"
        },
        "systemDebugLogs": {
          "type": "boolean"
        },
        "vmScreenshots": {
          "type": "boolean"
        },
        "vraLogs": {
          "type": "boolean",
          "deprecated": true
        },
        "vropsLogs": {
          "type": "boolean",
          "deprecated": true
        },
        "vrliLogs": {
          "type": "boolean",
          "deprecated": true
        },
        "vrslcmLogs": {
          "type": "boolean",
          "deprecated": true
        },
        "automationLogs": {
          "type": "boolean"
        },
        "operationsLogs": {
          "type": "boolean"
        },
        "operationsForLogs": {
          "type": "boolean"
        },
        "lifecycleLogs": {
          "type": "boolean"
        },
        "vmsLogs": {
          "type": "boolean"
        }
      }
    },
    "SupportBundleSpec": {
      "type": "object",
      "properties": {
        "options": {
          "$ref": "SupportBundleOption"
        },
        "scope": {
          "$ref": "SupportBundleScope"
        },
        "logs": {
          "$ref": "Logs"
        }
      }
    },
    "SupportBundle": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "creationTimestamp": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "bundleAvailable": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "completionTimestamp": {
          "type": "string"
        },
        "bundleName": {
          "type": "string"
        },
        "size": {
          "type": "string"
        }
      }
    }
  }
}

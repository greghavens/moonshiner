{
  "contract_version": "1.0.0",
  "product": "VMware Cloud Foundation Operations for Networks",
  "product_version": "9.1.0.0",
  "description": "Wire contract for the vCenter data source onboarding flow. Derived from the VCF Operations for Networks OpenAPI document shipped in the vmware/vcf-api-specs repository; see docs/official_sources.json for the exact revision. Only the four operations listed here are in scope, and only these four are served by the loopback mock.",
  "source_spec": {
    "repository": "vmware/vcf-api-specs",
    "path": "specifications/vcf-operations/vcf-operations-for-networks-openapi.yaml",
    "commit_sha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "blob_sha": "a275ed98b326e07f4dd5fcadfdd67b315fe49419",
    "openapi": "3.0.1",
    "info_title": "VCF Operations for networks API Reference",
    "info_version": "9.1.0.0",
    "license": "Apache-2.0"
  },
  "base_path": "/api/ni",
  "auth": {
    "security_scheme": "ApiKeyAuth",
    "in": "header",
    "header": "Authorization",
    "value_template": "NetworkInsight {token}",
    "note": "Every operation except `create` must carry the Authorization header. `create` declares `security: []` in the specification and must be sent without it.",
    "unauthenticated_operations": ["create"]
  },
  "json_rules": {
    "request_content_type": "application/json",
    "omit_unset_optional_fields": true,
    "omit_unset_optional_fields_note": "An optional field whose value the caller did not supply must be absent from the request body. Never send it as null, as an empty string, as 0/false-by-default, or as an empty object/array. A field the caller did set is always sent, including when the value is boolean false.",
    "no_empty_objects": true,
    "reject_unknown_fields": true
  },
  "operations": [
    {
      "operationId": "create",
      "tag": "Authentication",
      "summary": "Create an auth token",
      "method": "POST",
      "path": "/auth/token",
      "spec_line": 70,
      "authenticated": false,
      "request_schema": "UserCredential",
      "request_body_required": true,
      "request_properties": {
        "username": { "type": "string", "required": true },
        "password": { "type": "string", "required": true },
        "domain": { "type": "object", "required": false, "schema": "Domain" }
      },
      "request_nested_schemas": {
        "Domain": {
          "domain_type": {
            "type": "string",
            "required": true,
            "enum": ["LDAP", "LOCAL"],
            "note": "Uppercase."
          },
          "value": {
            "type": "string",
            "required": false,
            "note": "Domain value. Per the specification it is not required for the LOCAL domain type, so it must be omitted when the domain type is LOCAL."
          }
        }
      },
      "success_status": 200,
      "response_schema": "Token",
      "response_properties": {
        "token": { "type": "string" },
        "expiry": { "type": "integer", "format": "int64", "note": "Expiry epoch time." }
      }
    },
    {
      "operationId": "listExpandedNodes",
      "tag": "Infrastructure",
      "summary": "List nodes with all details",
      "method": "GET",
      "path": "/infra/expanded-nodes",
      "spec_line": 368,
      "authenticated": true,
      "request_schema": null,
      "request_body_required": false,
      "success_status": 200,
      "response_schema": "ExpandedNodeListResult",
      "response_properties": {
        "results": { "type": "array", "items_schema": "Node" },
        "total_count": { "type": "integer" }
      },
      "response_nested_schemas": {
        "Node": {
          "id": { "type": "string", "note": "This value is the `proxy_id` used by the data source operations." },
          "entity_type": { "type": "string" },
          "node_type": { "type": "string", "nullable": true, "enum": ["PROXY_VM", "PLATFORM_VM"] },
          "node_id": { "type": "string" },
          "ip_address": { "type": "string" },
          "ipv6_address": { "type": "string" },
          "name": { "type": "string" },
          "is_physical_flow_collector": { "type": "boolean" },
          "version": { "type": "string" },
          "health": { "type": "object", "schema": "Health" },
          "registered_timestamp": { "type": "integer", "format": "int64" },
          "last_updated_timestamp": { "type": "integer", "format": "int64" }
        }
      }
    },
    {
      "operationId": "validateVCenter",
      "tag": "Data Sources",
      "summary": "Validate a vCenter data source",
      "method": "POST",
      "path": "/data-sources/vcenters/validate",
      "spec_line": 856,
      "authenticated": true,
      "role": "precheck",
      "request_schema": "VCenterDataSourceValidationRequest",
      "request_body_required": true,
      "request_properties": {
        "ip": {
          "type": "string",
          "required": false,
          "note": "IP address of the data source. Use either ip or fqdn, not both."
        },
        "fqdn": {
          "type": "string",
          "required": false,
          "note": "Hostname of the data source. Use either ip or fqdn, not both."
        },
        "proxy_id": {
          "type": "string",
          "required": true,
          "note": "Id of the collector node that should register this vCenter, taken from listExpandedNodes."
        },
        "credentials": { "type": "object", "required": false, "schema": "PasswordCredentials" },
        "ipfix_enabled": {
          "type": "boolean",
          "required": false,
          "spec_default": false,
          "note": "Whether to configure vCenter to send IPFIX to Operations for Networks."
        }
      },
      "request_exactly_one_of": [["ip", "fqdn"]],
      "request_nested_schemas": {
        "PasswordCredentials": {
          "username": { "type": "string", "required": true },
          "password": { "type": "string", "required": false }
        }
      },
      "success_status": 200,
      "response_schema": "BaseDataSourceValidationResponse",
      "response_properties": {
        "code": { "type": "integer", "format": "int32" },
        "message": { "type": "string" }
      }
    },
    {
      "operationId": "addVcenterDatasource",
      "tag": "Data Sources",
      "summary": "Create a vCenter data source",
      "method": "POST",
      "path": "/data-sources/vcenters",
      "spec_line": 654,
      "authenticated": true,
      "role": "mutation",
      "request_schema": "VCenterDataSourceRequest",
      "request_body_required": true,
      "request_properties": {
        "ip": {
          "type": "string",
          "required": false,
          "note": "IP address of the data source. Use either ip or fqdn, not both."
        },
        "fqdn": {
          "type": "string",
          "required": false,
          "note": "Hostname of the data source. Use either ip or fqdn, not both."
        },
        "proxy_id": { "type": "string", "required": true },
        "nickname": { "type": "string", "required": true },
        "enabled": {
          "type": "boolean",
          "required": false,
          "spec_default": true,
          "note": "Whether data collection is enabled."
        },
        "notes": { "type": "string", "required": false },
        "credentials": { "type": "object", "required": false, "schema": "PasswordCredentials" },
        "ipfix_request": { "type": "object", "required": false, "schema": "dvs_ipfix_request" },
        "is_vmc": { "type": "boolean", "required": false, "spec_default": false },
        "ds_sub_type": { "type": "string", "required": false },
        "tags": { "type": "array", "required": false, "items_schema": "LocalTag" },
        "enable_ds_associated_tags": { "type": "boolean", "required": false }
      },
      "request_exactly_one_of": [["ip", "fqdn"]],
      "request_nested_schemas": {
        "PasswordCredentials": {
          "username": { "type": "string", "required": true },
          "password": { "type": "string", "required": false }
        },
        "dvs_ipfix_request": {
          "enable_all": { "type": "boolean", "required": false, "spec_default": false },
          "disable_all": { "type": "boolean", "required": false, "spec_default": false },
          "enable_for_dvs": { "type": "string", "required": false },
          "disable_for_dvs": { "type": "string", "required": false }
        },
        "LocalTag": {
          "tag_key": { "type": "string", "required": false },
          "tag_value": { "type": "string", "required": false }
        }
      },
      "success_status": 201,
      "response_schema": "VCenterDataSource",
      "response_properties": {
        "entity_id": { "type": "string" },
        "entity_type": { "type": "string" },
        "ip": { "type": "string" },
        "fqdn": { "type": "string" },
        "proxy_id": { "type": "string" },
        "nickname": { "type": "string" },
        "enabled": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  ],
  "workflow": {
    "name": "vcenter-data-source-onboarding",
    "steps": ["create", "listExpandedNodes", "validateVCenter", "addVcenterDatasource"],
    "gate": {
      "precheck": "validateVCenter",
      "mutation": "addVcenterDatasource",
      "pass_condition": "The `code` field of the BaseDataSourceValidationResponse equals 200.",
      "rule": "addVcenterDatasource must not be issued unless the precheck passed. When the precheck fails, or when any earlier step fails, the flow stops and no mutating request is sent."
    }
  }
}

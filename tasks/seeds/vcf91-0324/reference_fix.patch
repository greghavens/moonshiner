+// --- token handling ---------------------------------------------------------
+
+// accessToken returns the current access token, obtaining one if the client
+// does not hold one yet.
+func (c *Client) accessToken(ctx context.Context) (string, error) {
+	c.mu.Lock()
+	tok := c.token
+	c.mu.Unlock()
+	if tok != "" {
+		return tok, nil
+	}
+	return c.refresh(ctx, "")
+}
+
+// refresh exchanges the API token for a new access token, unless another
+// goroutine has already replaced stale — in which case its result is reused.
+//
+// stale is the token the caller saw rejected, or "" when the caller simply has
+// no token yet. Comparing against it is what makes a burst of concurrent 401s
+// cost one exchange rather than one per goroutine.
+func (c *Client) refresh(ctx context.Context, stale string) (string, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.token != "" && c.token != stale {
+		return c.token, nil
+	}
+	tok, err := c.exchange(ctx)
+	if err != nil {
+		return "", err
+	}
+	c.token = tok
+	return tok, nil
+}
+
+// tokenResponse is the documented shape of the token operation's reply.
+type tokenResponse struct {
+	AccessToken string `json:"access_token"`
+	TokenType   string `json:"token_type"`
+	ExpiresIn   int    `json:"expires_in"`
+}
+
+// exchange performs the token operation. It is called with c.mu held.
+func (c *Client) exchange(ctx context.Context) (string, error) {
+	op, err := c.cfg.Contract.Operation(contract.OpAuthToken)
+	if err != nil {
+		return "", err
+	}
+	if op.RequestBody == nil {
+		return "", fmt.Errorf("automation: operation %s declares no request body", op.ID)
+	}
+	for _, name := range []string{fGrantType, fRefreshToken} {
+		if _, ok := op.BodyField(name); !ok {
+			return "", fmt.Errorf("automation: operation %s declares no body field %q", op.ID, name)
+		}
+	}
+
+	path, err := expandSingle(op, c.cfg.Tenant)
+	if err != nil {
+		return "", err
+	}
+
+	grant := "refresh_token"
+	if f, ok := op.BodyField(fGrantType); ok && f.Default != "" {
+		grant = f.Default
+	}
+	form := url.Values{}
+	form.Set(fGrantType, grant)
+	form.Set(fRefreshToken, c.cfg.APIToken)
+
+	req, err := http.NewRequestWithContext(ctx, op.Method, c.cfg.BaseURL+path,
+		strings.NewReader(form.Encode()))
+	if err != nil {
+		return "", err
+	}
+	req.Header.Set("Content-Type", op.RequestBody.ContentType)
+	req.Header.Set("Accept", op.Response.ContentType)
+
+	resp, err := c.http.Do(req)
+	if err != nil {
+		return "", fmt.Errorf("automation: %s: %w", op.ID, err)
+	}
+	defer resp.Body.Close()
+	raw, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return "", fmt.Errorf("automation: %s: %w", op.ID, err)
+	}
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return "", &APIError{Operation: op.ID, Method: op.Method, Path: path,
+			StatusCode: resp.StatusCode, Body: string(raw)}
+	}
+	var tr tokenResponse
+	if err := json.Unmarshal(raw, &tr); err != nil {
+		return "", fmt.Errorf("automation: %s: decode: %w", op.ID, err)
+	}
+	if tr.AccessToken == "" {
+		return "", fmt.Errorf("automation: %s: response carried no access token", op.ID)
+	}
+	return tr.AccessToken, nil
+}
+
+// expandSingle fills the one path parameter of a single-parameter operation.
+func expandSingle(op *contract.Operation, value string) (string, error) {
+	names, err := contract.PathParamNames(op.Path)
+	if err != nil {
+		return "", err
+	}
+	if len(names) != 1 {
+		return "", fmt.Errorf("automation: operation %s takes %d path parameters, want 1", op.ID, len(names))
+	}
+	return op.ExpandPath(map[string]string{names[0]: value})
+}

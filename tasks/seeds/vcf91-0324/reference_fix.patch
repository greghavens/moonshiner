+// --- request plumbing -------------------------------------------------------
+
+type request struct {
+	op         *contract.Operation
+	pathParams map[string]string
+	query      url.Values
+	body       []byte
+}
+
+// maxAuthAttempts bounds how many times one request will refresh and try
+// again. More than one is necessary, not belt-and-braces: under concurrency a
+// token obtained by refreshing can be spent by other goroutines in the moment
+// between obtaining it and using it, so a request can legitimately meet a
+// second expiry on its first retry. The bound stops a genuinely unusable
+// credential from looping forever.
+const maxAuthAttempts = 4
+
+// do sends req with the current access token. If the service rejects the token,
+// it refreshes and sends the same request again; the caller neither sees the
+// rejection nor has to rebuild anything.
+func (c *Client) do(ctx context.Context, req request) ([]byte, error) {
+	tok, err := c.accessToken(ctx)
+	if err != nil {
+		return nil, err
+	}
+	for attempt := 1; ; attempt++ {
+		raw, status, err := c.send(ctx, req, tok)
+		if err != nil {
+			return nil, err
+		}
+		if status == http.StatusUnauthorized && attempt < maxAuthAttempts {
+			// Hand refresh the token that was just rejected, so that
+			// a goroutine which has already replaced it can be
+			// deferred to rather than duplicated.
+			tok, err = c.refresh(ctx, tok)
+			if err != nil {
+				return nil, err
+			}
+			continue
+		}
+		if status < 200 || status >= 300 {
+			path, _ := req.op.ExpandPath(req.pathParams)
+			return nil, &APIError{Operation: req.op.ID, Method: req.op.Method, Path: path,
+				StatusCode: status, Body: string(raw)}
+		}
+		return raw, nil
+	}
+}
+
+func (c *Client) send(ctx context.Context, req request, token string) ([]byte, int, error) {
+	path, err := req.op.ExpandPath(req.pathParams)
+	if err != nil {
+		return nil, 0, err
+	}
+	u := c.cfg.BaseURL + path
+	if len(req.query) > 0 {
+		u += "?" + req.query.Encode()
+	}
+
+	var rdr io.Reader
+	if req.body != nil {
+		rdr = strings.NewReader(string(req.body))
+	}
+	hr, err := http.NewRequestWithContext(ctx, req.op.Method, u, rdr)
+	if err != nil {
+		return nil, 0, err
+	}
+	hr.Header.Set("Authorization", "Bearer "+token)
+	hr.Header.Set("Accept", req.op.Response.ContentType)
+	if req.body != nil && req.op.RequestBody != nil {
+		hr.Header.Set("Content-Type", req.op.RequestBody.ContentType)
+	}
+
+	resp, err := c.http.Do(hr)
+	if err != nil {
+		return nil, 0, fmt.Errorf("automation: %s: %w", req.op.ID, err)
+	}
+	defer resp.Body.Close()
+	raw, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return nil, 0, fmt.Errorf("automation: %s: %w", req.op.ID, err)
+	}
+	return raw, resp.StatusCode, nil
+}

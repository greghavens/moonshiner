+// params accumulates query parameters, dropping every option that was never
+// set. An option that *was* set is written even when its value is the zero
+// value, because "size=0" is a different request from saying nothing.
+type params struct {
+	op  *contract.Operation
+	val url.Values
+	err error
+}
+
+func newParams(op *contract.Operation) *params {
+	return &params{op: op, val: url.Values{}}
+}
+
+func (p *params) set(name, value string) {
+	if p.err != nil {
+		return
+	}
+	if _, ok := p.op.QueryField(name); !ok {
+		p.err = fmt.Errorf("operation %s: contract declares no query parameter %q", p.op.ID, name)
+		return
+	}
+	p.val.Set(name, value)
+}
+
+func (p *params) str(name string, o Opt[string]) {
+	if v, ok := o.Get(); ok {
+		p.set(name, v)
+	}
+}
+
+func (p *params) num(name string, o Opt[int]) {
+	if v, ok := o.Get(); ok {
+		p.set(name, strconv.Itoa(v))
+	}
+}
+
+func (p *params) flag(name string, o Opt[bool]) {
+	if v, ok := o.Get(); ok {
+		p.set(name, strconv.FormatBool(v))
+	}
+}
+
+// list writes a string slice as the comma-separated list the reference
+// describes. A slice that is empty but *set* is written as an empty value,
+// which is still distinct from omitting the parameter.
+func (p *params) list(name string, o Opt[[]string]) {
+	if v, ok := o.Get(); ok {
+		p.set(name, strings.Join(v, ","))
+	}
+}
+
+func (p *params) values() (url.Values, error) {
+	if p.err != nil {
+		return nil, p.err
+	}
+	return p.val, nil
+}
+

+func (c *Client) getTasksPage(ctx context.Context, target, accessToken string) (taskPage, error) {
+	payload, err := c.requestJSON(ctx, "getTasks", http.MethodGet, target, nil, accessToken, http.StatusOK)
+	if err != nil {
+		return taskPage{}, err
+	}
+	var envelope struct {
+		Elements     json.RawMessage `json:"elements"`
+		PageMetadata json.RawMessage `json:"pageMetadata"`
+	}
+	if err := json.Unmarshal(payload, &envelope); err != nil {
+		return taskPage{}, protocol("getTasks", "response is not a JSON object")
+	}
+	if missingOrNull(envelope.Elements) || missingOrNull(envelope.PageMetadata) {
+		return taskPage{}, protocol("getTasks", "response omits elements or pageMetadata")
+	}
+	var rawTasks []json.RawMessage
+	if err := json.Unmarshal(envelope.Elements, &rawTasks); err != nil {
+		return taskPage{}, protocol("getTasks", "elements is not an array")
+	}
+	elements := make([]Task, len(rawTasks))
+	for index, rawTask := range rawTasks {
+		task, err := decodeTask(rawTask)
+		if err != nil {
+			return taskPage{}, err
+		}
+		elements[index] = task
+	}
+	metadata, err := decodeMetadata(envelope.PageMetadata)
+	if err != nil {
+		return taskPage{}, err
+	}
+	return taskPage{Elements: elements, Metadata: metadata}, nil
+}
+
+func (c *Client) refreshAccessToken(ctx context.Context, accessToken string) (string, error) {
+	body, err := json.Marshal(c.refreshTokenID)
+	if err != nil {
+		return "", protocol("refreshAccessToken", "could not encode refresh-token id")
+	}
+	payload, err := c.requestJSON(
+		ctx,
+		"refreshAccessToken",
+		http.MethodPatch,
+		"/v1/tokens/access-token/refresh",
+		body,
+		accessToken,
+		http.StatusOK,
+	)
+	if err != nil {
+		return "", err
+	}
+	var replacement string
+	if err := json.Unmarshal(payload, &replacement); err != nil || !nonblank(replacement) || !headerSafe(replacement) {
+		return "", protocol("refreshAccessToken", "response is not a usable JSON access-token string")
+	}
+	return replacement, nil
+}
+
+func (c *Client) requestJSON(
+	ctx context.Context,
+	operationID, method, target string,
+	body []byte,
+	accessToken string,
+	wantStatus int,
+) ([]byte, error) {
+	var requestBody io.Reader
+	if body != nil {
+		requestBody = bytes.NewReader(body)
+	}
+	request, err := http.NewRequestWithContext(ctx, method, c.baseURL+target, requestBody)
+	if err != nil {
+		return nil, fmt.Errorf("build %s request: %w", operationID, err)
+	}
+	request.Header.Set("Authorization", "Bearer "+accessToken)
+	request.Header.Set("Accept", "application/json")
+	if body != nil {
+		request.Header.Set("Content-Type", "application/json")
+	}
+
+	requestClient := &http.Client{
+		Transport: c.httpClient.Transport,
+		CheckRedirect: func(_ *http.Request, _ []*http.Request) error {
+			return http.ErrUseLastResponse
+		},
+		Jar:     c.httpClient.Jar,
+		Timeout: c.httpClient.Timeout,
+	}
+	response, err := requestClient.Do(request)
+	if err != nil {
+		if response != nil && response.Body != nil {
+			_ = response.Body.Close()
+		}
+		if contextError := ctx.Err(); contextError != nil {
+			return nil, fmt.Errorf("%s transport failed: %w", operationID, contextError)
+		}
+		return nil, fmt.Errorf("%s transport failed", operationID)
+	}
+	defer response.Body.Close()
+	if response.StatusCode != wantStatus {
+		return nil, &APIError{OperationID: operationID, StatusCode: response.StatusCode}
+	}
+	payload, readErr := io.ReadAll(response.Body)
+	if readErr != nil {
+		return nil, fmt.Errorf("read %s response failed", operationID)
+	}
+	mediaType, _, mediaErr := mime.ParseMediaType(response.Header.Get("Content-Type"))
+	if mediaErr != nil || mediaType != "application/json" {
+		return nil, protocol(operationID, "successful response is not application/json")
+	}
+	return payload, nil
+}
+
+func decodeTask(raw json.RawMessage) (Task, error) {
+	var object map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &object); err != nil || object == nil {
+		return Task{}, protocol("getTasks", "elements contains a non-object task")
+	}
+	id, err := requiredText(object, "id")
+	if err != nil {
+		return Task{}, err
+	}
+	name, err := requiredText(object, "name")
+	if err != nil {
+		return Task{}, err
+	}
+	status, err := requiredText(object, "status")
+	if err != nil {
+		return Task{}, err
+	}
+	created, err := requiredText(object, "creationTimestamp")
+	if err != nil {
+		return Task{}, err
+	}
+	var taskType *string
+	if rawType, present := object["type"]; present {
+		if missingOrNull(rawType) {
+			return Task{}, protocol("getTasks", "Task.type is not a string")
+		}
+		var value string
+		if err := json.Unmarshal(rawType, &value); err != nil {
+			return Task{}, protocol("getTasks", "Task.type is not a string")
+		}
+		taskType = &value
+	}
+	return Task{ID: id, Name: name, Type: taskType, Status: status, CreationTimestamp: created}, nil
+}
+
+func decodeMetadata(raw json.RawMessage) (pageMetadata, error) {
+	var object struct {
+		PageNumber    *int `json:"pageNumber"`
+		PageSize      *int `json:"pageSize"`
+		TotalElements *int `json:"totalElements"`
+		TotalPages    *int `json:"totalPages"`
+	}
+	if err := json.Unmarshal(raw, &object); err != nil {
+		return pageMetadata{}, protocol("getTasks", "pageMetadata is not an object with integer members")
+	}
+	if object.PageNumber == nil || object.PageSize == nil || object.TotalElements == nil || object.TotalPages == nil {
+		return pageMetadata{}, protocol("getTasks", "pageMetadata omits a required workflow member")
+	}
+	return pageMetadata{
+		PageNumber:    *object.PageNumber,
+		PageSize:      *object.PageSize,
+		TotalElements: *object.TotalElements,
+		TotalPages:    *object.TotalPages,
+	}, nil
+}
+
+func requiredText(object map[string]json.RawMessage, name string) (string, error) {
+	raw, present := object[name]
+	if !present || missingOrNull(raw) {
+		return "", protocol("getTasks", "Task."+name+" must be a nonblank string")
+	}
+	var value string
+	if err := json.Unmarshal(raw, &value); err != nil || !nonblank(value) {
+		return "", protocol("getTasks", "Task."+name+" must be a nonblank string")
+	}
+	return value, nil
+}
+
+func missingOrNull(raw json.RawMessage) bool {
+	return len(raw) == 0 || bytes.Equal(bytes.TrimSpace(raw), []byte("null"))
+}
+
+func nonblank(value string) bool { return strings.TrimSpace(value) != "" }
+
+func headerSafe(value string) bool {
+	for index := 0; index < len(value); index++ {
+		character := value[index]
+		if (character < ' ' && character != '\t') || character == 0x7f {
+			return false
+		}
+	}
+	return true
+}
+
+func protocol(operationID, problem string) *ProtocolError {
+	return &ProtocolError{OperationID: operationID, Problem: problem}
 }

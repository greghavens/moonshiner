index 0000000..107462b
--- /dev/null
+++ b/sddcdiag/client.go
@@ -0,0 +1,283 @@
+// Package sddcdiag talks to the VMware Cloud Foundation 9.0 SDDC Manager REST
+// API to work out why a long-running operation failed.
+//
+// The six operations it calls are the six docs/contract.json names, projected
+// from specifications/sddc-manager/sddc-manager-openapi.json at tag 9.0.0.0 of
+// vmware/vcf-api-specs. The package uses the standard library alone.
+package sddcdiag
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Config configures a Client.
+type Config struct {
+	// BaseURL is the SDDC Manager root, for example https://sfo-vcf01.rainpole.io.
+	BaseURL string
+	// Token is the access token sent as Authorization: Bearer <token>.
+	Token string
+	// HTTPClient is optional; a 60 second client is used when it is nil.
+	HTTPClient *http.Client
+	// PollInterval is the wait between support-bundle status polls. Defaults to
+	// 5 seconds.
+	PollInterval time.Duration
+}
+
+// Client is an SDDC Manager REST client.
+type Client struct {
+	baseURL      string
+	token        string
+	http         *http.Client
+	pollInterval time.Duration
+}
+
+// apiError is a non-2xx response carrying the SDDC Manager error envelope.
+type apiError struct {
+	OperationID string
+	Status      int
+	Err         Error
+}
+
+func (e *apiError) Error() string {
+	msg := e.Err.Message
+	if msg == "" {
+		msg = http.StatusText(e.Status)
+	}
+	if e.Err.ErrorCode != "" {
+		return fmt.Sprintf("%s: %d %s: %s", e.OperationID, e.Status, e.Err.ErrorCode, msg)
+	}
+	return fmt.Sprintf("%s: %d: %s", e.OperationID, e.Status, msg)
+}
+
+// New builds a Client.
+func New(cfg Config) (*Client, error) {
+	if strings.TrimSpace(cfg.BaseURL) == "" {
+		return nil, errors.New("sddcdiag: BaseURL is required")
+	}
+	if strings.TrimSpace(cfg.Token) == "" {
+		return nil, errors.New("sddcdiag: Token is required")
+	}
+	if _, err := url.Parse(cfg.BaseURL); err != nil {
+		return nil, fmt.Errorf("sddcdiag: BaseURL: %w", err)
+	}
+	c := &Client{
+		baseURL:      strings.TrimRight(cfg.BaseURL, "/"),
+		token:        cfg.Token,
+		http:         cfg.HTTPClient,
+		pollInterval: cfg.PollInterval,
+	}
+	if c.http == nil {
+		c.http = &http.Client{Timeout: 60 * time.Second}
+	}
+	if c.pollInterval <= 0 {
+		c.pollInterval = 5 * time.Second
+	}
+	return c, nil
+}
+
+// call issues one contract operation. accept is the media type the operation's
+// success response declares. body is nil for every operation but
+// startSupportBundle, and a nil body means no Content-Type is sent.
+func (c *Client) call(ctx context.Context, opID, method, path string, query url.Values, accept string, body []byte) (*http.Response, error) {
+	u := c.baseURL + path
+	if len(query) > 0 {
+		u += "?" + query.Encode()
+	}
+
+	var rdr io.Reader
+	if body != nil {
+		rdr = bytes.NewReader(body)
+	}
+	req, err := http.NewRequestWithContext(ctx, method, u, rdr)
+	if err != nil {
+		return nil, fmt.Errorf("%s: %w", opID, err)
+	}
+	req.Header.Set("Authorization", "Bearer "+c.token)
+	req.Header.Set("Accept", accept)
+	if body != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+
+	resp, err := c.http.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("%s: %w", opID, err)
+	}
+	if resp.StatusCode < 200 || resp.StatusCode > 299 {
+		defer resp.Body.Close()
+		apiErr := &apiError{OperationID: opID, Status: resp.StatusCode}
+		raw, _ := io.ReadAll(resp.Body)
+		_ = json.Unmarshal(raw, &apiErr.Err)
+		return nil, apiErr
+	}
+	return resp, nil
+}
+
+func (c *Client) getJSON(ctx context.Context, opID, method, path string, query url.Values, body []byte, out any) error {
+	resp, err := c.call(ctx, opID, method, path, query, "application/json", body)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	if out == nil {
+		_, _ = io.Copy(io.Discard, resp.Body)
+		return nil
+	}
+	if err := json.NewDecoder(resp.Body).Decode(out); err != nil {
+		return fmt.Errorf("%s: decode response: %w", opID, err)
+	}
+	return nil
+}
+
+// values renders the query parameters that were actually set. A nil member
+// contributes nothing at all, so it never appears on the wire as an empty value.
+func (q TaskQuery) values() url.Values {
+	v := url.Values{}
+	set := func(name, val string) { v.Set(name, val) }
+
+	if q.Limit != nil {
+		set("limit", strconv.Itoa(*q.Limit))
+	}
+	if q.TaskStatus != nil {
+		set("taskStatus", *q.TaskStatus)
+	}
+	if q.TaskType != nil {
+		set("taskType", *q.TaskType)
+	}
+	if q.ResourceID != nil {
+		set("resourceId", *q.ResourceID)
+	}
+	if q.ResourceType != nil {
+		set("resourceType", *q.ResourceType)
+	}
+	if q.CompletedAfter != nil {
+		set("completedAfter", strconv.FormatInt(*q.CompletedAfter, 10))
+	}
+	if q.PageNumber != nil {
+		set("pageNumber", strconv.Itoa(*q.PageNumber))
+	}
+	if q.PageSize != nil {
+		set("pageSize", strconv.Itoa(*q.PageSize))
+	}
+	if q.OrderDirection != nil {
+		set("orderDirection", *q.OrderDirection)
+	}
+	if q.OrderBy != nil {
+		set("orderBy", *q.OrderBy)
+	}
+	if q.TaskName != nil {
+		set("taskName", *q.TaskName)
+	}
+	if q.DoLiveRefresh != nil {
+		set("doLiveRefresh", strconv.FormatBool(*q.DoLiveRefresh))
+	}
+	return v
+}
+
+// GetTasks is operation getTasks, GET /v1/tasks.
+func (c *Client) GetTasks(ctx context.Context, q TaskQuery) (*PageOfTask, error) {
+	var page PageOfTask
+	if err := c.getJSON(ctx, "getTasks", http.MethodGet, "/v1/tasks", q.values(), nil, &page); err != nil {
+		return nil, err
+	}
+	return &page, nil
+}
+
+// GetTask is operation getTask, GET /v1/tasks/{id}.
+func (c *Client) GetTask(ctx context.Context, id string) (*Task, error) {
+	if id == "" {
+		return nil, errors.New("sddcdiag: GetTask: id is required")
+	}
+	var task Task
+	path := "/v1/tasks/" + url.PathEscape(id)
+	if err := c.getJSON(ctx, "getTask", http.MethodGet, path, nil, nil, &task); err != nil {
+		return nil, err
+	}
+	return &task, nil
+}
+
+// GetNotifications is operation getNotifications, GET /v1/notifications.
+func (c *Client) GetNotifications(ctx context.Context) ([]Notification, error) {
+	var out []Notification
+	if err := c.getJSON(ctx, "getNotifications", http.MethodGet, "/v1/notifications", nil, nil, &out); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
+// StartSupportBundle is operation startSupportBundle,
+// POST /v1/system/support-bundles.
+func (c *Client) StartSupportBundle(ctx context.Context, spec SupportBundleSpec) (*SupportBundle, error) {
+	spec = compactSupportBundleSpec(spec)
+	body, err := json.Marshal(spec)
+	if err != nil {
+		return nil, fmt.Errorf("startSupportBundle: encode spec: %w", err)
+	}
+	var out SupportBundle
+	if err := c.getJSON(ctx, "startSupportBundle", http.MethodPost, "/v1/system/support-bundles", nil, body, &out); err != nil {
+		return nil, err
+	}
+	return &out, nil
+}
+
+// GetSupportBundleStatus is operation getSupportBundleStatus,
+// GET /v1/system/support-bundles/{id}.
+func (c *Client) GetSupportBundleStatus(ctx context.Context, id string) (*SupportBundle, error) {
+	if id == "" {
+		return nil, errors.New("sddcdiag: GetSupportBundleStatus: id is required")
+	}
+	var out SupportBundle
+	path := "/v1/system/support-bundles/" + url.PathEscape(id)
+	if err := c.getJSON(ctx, "getSupportBundleStatus", http.MethodGet, path, nil, nil, &out); err != nil {
+		return nil, err
+	}
+	return &out, nil
+}
+
+// ExportSupportBundle is operation exportSupportBundleByID,
+// GET /v1/system/support-bundles/{id}/data. The operation serves
+// application/octet-stream, so that is what the request offers.
+func (c *Client) ExportSupportBundle(ctx context.Context, id string) ([]byte, error) {
+	if id == "" {
+		return nil, errors.New("sddcdiag: ExportSupportBundle: id is required")
+	}
+	path := "/v1/system/support-bundles/" + url.PathEscape(id) + "/data"
+	resp, err := c.call(ctx, "exportSupportBundleByID", http.MethodGet, path, nil, "application/octet-stream", nil)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	raw, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return nil, fmt.Errorf("exportSupportBundleByID: read body: %w", err)
+	}
+	return raw, nil
+}
+
+// waitForSupportBundle polls getSupportBundleStatus until the collection stops
+// moving, then returns its final state.
+func (c *Client) waitForSupportBundle(ctx context.Context, id string) (*SupportBundle, error) {
+	for {
+		b, err := c.GetSupportBundleStatus(ctx, id)
+		if err != nil {
+			return nil, err
+		}
+		if b.terminal() {
+			return b, nil
+		}
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-time.After(c.pollInterval):
+		}
+	}
+}
diff --git a/sddcdiag/client_test.go b/sddcdiag/client_test.go
new file mode 100644
index 0000000..99273fc
--- /dev/null
+++ b/sddcdiag/client_test.go
@@ -0,0 +1,389 @@
+package sddcdiag
+
+import (
+	"encoding/json"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func p[T any](v T) *T { return &v }
+
+func TestNewRejectsIncompleteConfig(t *testing.T) {
+	cases := []struct {
+		name    string
+		cfg     Config
+		wantErr string
+	}{
+		{"no base url", Config{Token: "t"}, "BaseURL is required"},
+		{"blank base url", Config{BaseURL: "   ", Token: "t"}, "BaseURL is required"},
+		{"no token", Config{BaseURL: "https://sddc.example"}, "Token is required"},
+		{"complete", Config{BaseURL: "https://sddc.example", Token: "t"}, ""},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			c, err := New(tc.cfg)
+			if tc.wantErr == "" {
+				if err != nil {
+					t.Fatalf("New: %v", err)
+				}
+				if c.pollInterval <= 0 {
+					t.Error("New left pollInterval unset")
+				}
+				if c.http == nil {
+					t.Error("New left the http client nil")
+				}
+				return
+			}
+			if err == nil || !strings.Contains(err.Error(), tc.wantErr) {
+				t.Fatalf("New err = %v, want it to mention %q", err, tc.wantErr)
+			}
+		})
+	}
+}
+
+func TestNewTrimsTrailingSlashFromBaseURL(t *testing.T) {
+	cases := []struct{ in, want string }{
+		{"https://sddc.example", "https://sddc.example"},
+		{"https://sddc.example/", "https://sddc.example"},
+		{"https://sddc.example///", "https://sddc.example"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.in, func(t *testing.T) {
+			c, err := New(Config{BaseURL: tc.in, Token: "t"})
+			if err != nil {
+				t.Fatalf("New: %v", err)
+			}
+			if c.baseURL != tc.want {
+				t.Errorf("baseURL = %q, want %q", c.baseURL, tc.want)
+			}
+		})
+	}
+}
+
+// A nil member must contribute no key at all. A member pointing at a zero or a
+// false is a value the caller chose and has to survive to the query string.
+func TestTaskQueryValuesOmitsUnsetMembers(t *testing.T) {
+	cases := []struct {
+		name string
+		q    TaskQuery
+		want string
+	}{
+		{
+			name: "empty query encodes to nothing",
+			q:    TaskQuery{},
+			want: "",
+		},
+		{
+			name: "explicit zero survives",
+			q:    TaskQuery{PageNumber: p(0)},
+			want: "pageNumber=0",
+		},
+		{
+			name: "explicit false survives",
+			q:    TaskQuery{DoLiveRefresh: p(false)},
+			want: "doLiveRefresh=false",
+		},
+		{
+			name: "empty string is a value, not an absence",
+			q:    TaskQuery{TaskName: p("")},
+			want: "taskName=",
+		},
+		{
+			name: "only the members that were set appear",
+			q:    TaskQuery{TaskStatus: p("FAILED"), PageSize: p(1), OrderBy: p("creationTimestamp")},
+			want: "orderBy=creationTimestamp&pageSize=1&taskStatus=FAILED",
+		},
+		{
+			name: "int64 timestamps are not rendered in scientific notation",
+			q:    TaskQuery{CompletedAfter: p(int64(1772000000000))},
+			want: "completedAfter=1772000000000",
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := tc.q.values().Encode(); got != tc.want {
+				t.Errorf("values().Encode() = %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestBuildSupportBundleSpecLeavesUnsetMembersOffTheWire(t *testing.T) {
+	cases := []struct {
+		name string
+		req  DiagnoseRequest
+		want string
+	}{
+		{
+			name: "domain only",
+			req:  DiagnoseRequest{DomainName: "sfo-w01"},
+			want: `{"scope":{"domains":[{"domainName":"sfo-w01"}]}}`,
+		},
+		{
+			name: "empty cluster list leaves clusterNames off",
+			req:  DiagnoseRequest{DomainName: "sfo-w01", ClusterNames: []string{}},
+			want: `{"scope":{"domains":[{"domainName":"sfo-w01"}]}}`,
+		},
+		{
+			name: "one cluster",
+			req:  DiagnoseRequest{DomainName: "sfo-w01", ClusterNames: []string{"sfo-w01-cl01"}},
+			want: `{"scope":{"domains":[{"clusterNames":["sfo-w01-cl01"],"domainName":"sfo-w01"}]}}`,
+		},
+		{
+			name: "an explicit false is sent, its sibling is not",
+			req:  DiagnoseRequest{DomainName: "sfo-w01", Force: p(false)},
+			want: `{"options":{"config":{"force":false}},"scope":{"domains":[{"domainName":"sfo-w01"}]}}`,
+		},
+		{
+			name: "two log sources out of sixteen",
+			req:  DiagnoseRequest{DomainName: "sfo-w01", Logs: []string{"esxLogs", "sddcManagerLogs"}},
+			want: `{"logs":{"esxLogs":true,"sddcManagerLogs":true},"scope":{"domains":[{"domainName":"sfo-w01"}]}}`,
+		},
+		{
+			name: "include items and free hosts",
+			req: DiagnoseRequest{
+				DomainName:       "sfo-w01",
+				IncludeFreeHosts: p(true),
+				HealthCheck:      p(true),
+			},
+			want: `{"options":{"include":{"healthCheck":true}},"scope":{"domains":[{"domainName":"sfo-w01"}],"includeFreeHosts":true}}`,
+		},
+		{
+			name: "nothing at all yields an empty object, not empty members",
+			req:  DiagnoseRequest{},
+			want: `{}`,
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			spec, err := buildSupportBundleSpec(tc.req)
+			if err != nil {
+				t.Fatalf("buildSupportBundleSpec: %v", err)
+			}
+			raw, err := json.Marshal(spec)
+			if err != nil {
+				t.Fatalf("marshal: %v", err)
+			}
+			// Round-trip through any so the comparison is about which members
+			// are present, not about struct declaration order.
+			var v any
+			if err := json.Unmarshal(raw, &v); err != nil {
+				t.Fatalf("unmarshal: %v", err)
+			}
+			got, err := json.Marshal(v)
+			if err != nil {
+				t.Fatalf("re-marshal: %v", err)
+			}
+			if string(got) != tc.want {
+				t.Errorf("body\n got: %s\nwant: %s", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestLogsForRejectsNamesOutsideThe9_0_0_0Specification(t *testing.T) {
+	cases := []struct {
+		name    string
+		in      []string
+		wantErr bool
+	}{
+		{"a 9.0 member", []string{"sddcManagerLogs"}, false},
+		{"several 9.0 members", []string{"vcLogs", "nsxLogs", "esxLogs", "wcpLogs"}, false},
+		{"a deprecated but present member", []string{"vrslcmLogs"}, false},
+		{"hcxLogs, added in 9.1", []string{"hcxLogs"}, true},
+		{"vmsLogs, added in 9.1", []string{"vmsLogs"}, true},
+		{"a Go field name rather than a spec member name", []string{"SDDCManagerLogs"}, true},
+		{"a typo", []string{"esxlogs"}, true},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			_, err := logsFor(tc.in)
+			if tc.wantErr && err == nil {
+				t.Fatalf("logsFor(%v) succeeded, want an error", tc.in)
+			}
+			if !tc.wantErr && err != nil {
+				t.Fatalf("logsFor(%v): %v", tc.in, err)
+			}
+		})
+	}
+}
+
+func TestLogsHasExactlyTheSixteenMembersOf9_0_0_0(t *testing.T) {
+	logs, err := logsFor(nil)
+	if err != nil {
+		t.Fatalf("logsFor: %v", err)
+	}
+	raw, err := json.Marshal(struct {
+		L Logs `json:"l"`
+	}{*logs})
+	if err != nil {
+		t.Fatalf("marshal: %v", err)
+	}
+	if string(raw) != `{"l":{}}` {
+		t.Errorf("an all-unset Logs marshalled to %s, want every member omitted", raw)
+	}
+
+	all := []string{
+		"vcLogs", "nsxLogs", "esxLogs", "wcpLogs", "sddcManagerLogs", "apiLogs",
+		"systemDebugLogs", "vmScreenshots", "vraLogs", "vropsLogs", "vrliLogs",
+		"vrslcmLogs", "automationLogs", "operationsLogs", "operationsForLogs",
+		"lifecycleLogs",
+	}
+	if _, err := logsFor(all); err != nil {
+		t.Fatalf("logsFor(all 16): %v", err)
+	}
+	if got := reflect.TypeOf(Logs{}).NumField(); got != len(all) {
+		t.Errorf("Logs declares %d members, want the %d of 9.0.0.0", got, len(all))
+	}
+}
+
+func TestRootCausePrefersTheDeepestNestedErrorOfTheFailedSubTask(t *testing.T) {
+	deep := Task{
+		Errors: []Error{{Message: "summary"}},
+		SubTasks: []SubTask{
+			{Status: "SUCCESSFUL", Name: "ok"},
+			{Status: "FAILED", Name: "bad", Errors: []Error{{
+				Message: "outer",
+				NestedErrors: []Error{
+					{Message: "shallow first branch"},
+					{Message: "middle", NestedErrors: []Error{{Message: "innermost"}}},
+				},
+			}}},
+		},
+	}
+
+	cases := []struct {
+		name string
+		task Task
+		want string
+	}{
+		{"deepest nested error wins", deep, "innermost"},
+		{
+			name: "a failed sub-task with one flat error",
+			task: Task{SubTasks: []SubTask{{Status: "FAILED", Errors: []Error{{Message: "flat"}}}}},
+			want: "flat",
+		},
+		{
+			name: "no failed sub-task falls back to the task summary",
+			task: Task{Errors: []Error{{Message: "summary"}}, SubTasks: []SubTask{{Status: "SUCCESSFUL"}}},
+			want: "summary",
+		},
+		{
+			name: "a failed sub-task carrying no error falls back too",
+			task: Task{Errors: []Error{{Message: "summary"}}, SubTasks: []SubTask{{Status: "FAILED"}}},
+			want: "summary",
+		},
+		{"nothing at all", Task{}, ""},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			task := tc.task
+			if got := rootCause(&task); got != tc.want {
+				t.Errorf("rootCause = %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestCollectTokensWalksDepthFirstAndDeduplicates(t *testing.T) {
+	cases := []struct {
+		name string
+		errs []Error
+		want []string
+	}{
+		{"none", nil, nil},
+		{"flat", []Error{{ReferenceToken: "A"}, {ReferenceToken: "B"}}, []string{"A", "B"}},
+		{
+			name: "parent before child",
+			errs: []Error{{ReferenceToken: "A", NestedErrors: []Error{{ReferenceToken: "B",
+				NestedErrors: []Error{{ReferenceToken: "C"}}}}}},
+			want: []string{"A", "B", "C"},
+		},
+		{
+			name: "a repeat keeps its first position",
+			errs: []Error{{ReferenceToken: "A", NestedErrors: []Error{{ReferenceToken: "A"}}}, {ReferenceToken: "B"}},
+			want: []string{"A", "B"},
+		},
+		{
+			name: "an error with no token is skipped but still descended into",
+			errs: []Error{{NestedErrors: []Error{{ReferenceToken: "A"}}}},
+			want: []string{"A"},
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			var got []string
+			collectTokens(tc.errs, map[string]bool{}, &got)
+			if !reflect.DeepEqual(got, tc.want) {
+				t.Errorf("collectTokens = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestEvidenceForKeepsMatchingLinesInFileOrder(t *testing.T) {
+	const log = "a [ref=ZZ]\nb [ref=P8]\nc\nd [ref=LX]\ne [ref=RV]\n"
+
+	cases := []struct {
+		name   string
+		tokens []string
+		want   []string
+	}{
+		{"no tokens", nil, nil},
+		{
+			name:   "file order, not token order",
+			tokens: []string{"RV", "LX", "P8"},
+			want:   []string{"b [ref=P8]", "d [ref=LX]", "e [ref=RV]"},
+		},
+		{
+			name:   "an unrelated token's line is left out",
+			tokens: []string{"P8"},
+			want:   []string{"b [ref=P8]"},
+		},
+		{
+			name:   "a token nothing was logged under contributes nothing",
+			tokens: []string{"QQ"},
+			want:   nil,
+		},
+		{
+			name:   "a line is kept once even when two tokens match it",
+			tokens: []string{"P8", "P8"},
+			want:   []string{"b [ref=P8]"},
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := evidenceFor(log, tc.tokens); !reflect.DeepEqual(got, tc.want) {
+				t.Errorf("evidenceFor = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestSupportBundleTerminal(t *testing.T) {
+	cases := []struct {
+		status string
+		want   bool
+	}{
+		{"PENDING", false},
+		{"IN_PROGRESS", false},
+		{"COMPLETED_WITH_SUCCESS", true},
+		{"COMPLETED_WITH_FAILURE", true},
+		{"", false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.status, func(t *testing.T) {
+			if got := (SupportBundle{Status: tc.status}).terminal(); got != tc.want {
+				t.Errorf("terminal(%q) = %v, want %v", tc.status, got, tc.want)
+			}
+		})
+	}
+}
diff --git a/sddcdiag/diagnose.go b/sddcdiag/diagnose.go
new file mode 100644
index 0000000..4b1d9d3
--- /dev/null
+++ b/sddcdiag/diagnose.go
@@ -0,0 +1,312 @@
+package sddcdiag
+
+import (
+	"bytes"
+	"compress/gzip"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"reflect"
+	"sort"
+	"strings"
+)
+
+// DiagnoseRequest describes the failure to look into and how wide a log
+// collection to ask for. Every pointer member is optional: leaving one nil keeps
+// it off the SupportBundleSpec entirely, which is not the same as sending false.
+type DiagnoseRequest struct {
+	// ResourceID is the inventory object whose failed task is wanted.
+	ResourceID string
+	// DomainName scopes the log collection.
+	DomainName string
+	// ClusterNames narrows the collection within the domain. Empty means the
+	// whole domain and leaves clusterNames off the wire.
+	ClusterNames []string
+	// Logs names the Logs members to switch on, using the spec's own member
+	// names, for example "sddcManagerLogs". Members not named here are left off
+	// the wire rather than sent as false.
+	Logs []string
+
+	IncludeFreeHosts   *bool
+	Force              *bool
+	SkipKnownHostCheck *bool
+	SummaryReport      *bool
+	HealthCheck        *bool
+}
+
+// Diagnosis is what the logs and the event trail actually say, as opposed to
+// what the task's own summary claims.
+type Diagnosis struct {
+	TaskID     string
+	TaskName   string
+	TaskStatus string
+
+	// FailedSubTasks names the sub-tasks whose status is FAILED, in task order.
+	FailedSubTasks []string
+	// ReferenceTokens are the tokens on the task's errors and on its sub-tasks'
+	// errors, walked depth first, deduplicated, first occurrence wins.
+	ReferenceTokens []string
+	// RootCause is the message of the deepest nested error under the first
+	// failed sub-task, which is where the actionable reason lives.
+	RootCause string
+	// Notifications are the feed entries raised on ResourceID, rendered as
+	// "SEVERITY: message", in feed order.
+	Notifications []string
+
+	BundleID     string
+	BundleSHA256 string
+	// Evidence holds the bundle's log lines that carry one of ReferenceTokens,
+	// in file order.
+	Evidence []string
+}
+
+// Diagnose pulls the failure's event trail and its logs and reports what they
+// say. It calls, in order: getTasks, getTask, getNotifications,
+// startSupportBundle, getSupportBundleStatus until terminal, and
+// exportSupportBundleByID.
+func (c *Client) Diagnose(ctx context.Context, req DiagnoseRequest) (*Diagnosis, error) {
+	if req.ResourceID == "" {
+		return nil, errors.New("sddcdiag: Diagnose: ResourceID is required")
+	}
+
+	// 1. The newest failed task on the resource. Only the five parameters that
+	// narrow the search are set; the other seven stay off the query string.
+	failed := "FAILED"
+	orderBy := "creationTimestamp"
+	desc := "DESC"
+	one := 1
+	page, err := c.GetTasks(ctx, TaskQuery{
+		TaskStatus:     &failed,
+		ResourceID:     &req.ResourceID,
+		OrderBy:        &orderBy,
+		OrderDirection: &desc,
+		PageSize:       &one,
+	})
+	if err != nil {
+		return nil, err
+	}
+	if len(page.Elements) == 0 {
+		return nil, fmt.Errorf("sddcdiag: no failed task recorded for resource %s", req.ResourceID)
+	}
+
+	// 2. The full task, with the sub-task trail the page does not carry.
+	task, err := c.GetTask(ctx, page.Elements[0].ID)
+	if err != nil {
+		return nil, err
+	}
+
+	d := &Diagnosis{
+		TaskID:     task.ID,
+		TaskName:   task.Name,
+		TaskStatus: task.Status,
+	}
+
+	seen := map[string]bool{}
+	collectTokens(task.Errors, seen, &d.ReferenceTokens)
+	for _, st := range task.SubTasks {
+		if st.Status == "FAILED" {
+			d.FailedSubTasks = append(d.FailedSubTasks, st.Name)
+		}
+		collectTokens(st.Errors, seen, &d.ReferenceTokens)
+	}
+	d.RootCause = rootCause(task)
+
+	// 3. The notification feed, kept to the entries raised on this resource.
+	notes, err := c.GetNotifications(ctx)
+	if err != nil {
+		return nil, err
+	}
+	for _, n := range notes {
+		for _, r := range n.Resources {
+			if r.ID == req.ResourceID {
+				d.Notifications = append(d.Notifications, n.Severity+": "+n.Message.LocalizedMessage)
+				break
+			}
+		}
+	}
+
+	// 4-6. Collect, poll and download the logs.
+	spec, err := buildSupportBundleSpec(req)
+	if err != nil {
+		return nil, err
+	}
+	started, err := c.StartSupportBundle(ctx, spec)
+	if err != nil {
+		return nil, err
+	}
+	d.BundleID = started.ID
+
+	final, err := c.waitForSupportBundle(ctx, started.ID)
+	if err != nil {
+		return nil, err
+	}
+	if final.Status != "COMPLETED_WITH_SUCCESS" {
+		return nil, fmt.Errorf("sddcdiag: support bundle %s finished %s", started.ID, final.Status)
+	}
+
+	raw, err := c.ExportSupportBundle(ctx, started.ID)
+	if err != nil {
+		return nil, err
+	}
+	sum := sha256.Sum256(raw)
+	d.BundleSHA256 = hex.EncodeToString(sum[:])
+
+	text, err := decompress(raw)
+	if err != nil {
+		return nil, err
+	}
+	d.Evidence = evidenceFor(text, d.ReferenceTokens)
+
+	return d, nil
+}
+
+// collectTokens walks errors depth first, pre-order, keeping first occurrences.
+func collectTokens(errs []Error, seen map[string]bool, out *[]string) {
+	for _, e := range errs {
+		if e.ReferenceToken != "" && !seen[e.ReferenceToken] {
+			seen[e.ReferenceToken] = true
+			*out = append(*out, e.ReferenceToken)
+		}
+		collectTokens(e.NestedErrors, seen, out)
+	}
+}
+
+// rootCause finds the deepest descendant of the first error on the first failed
+// sub-task carrying an error. At equal depths, task order wins.
+func rootCause(task *Task) string {
+	for _, st := range task.SubTasks {
+		if st.Status != "FAILED" || len(st.Errors) == 0 {
+			continue
+		}
+		e, _ := deepestError(st.Errors[0])
+		return e.Message
+	}
+	if len(task.Errors) > 0 {
+		return task.Errors[0].Message
+	}
+	return ""
+}
+
+func deepestError(root Error) (Error, int) {
+	best, bestDepth := root, 0
+	for _, child := range root.NestedErrors {
+		candidate, depth := deepestError(child)
+		depth++
+		if depth > bestDepth {
+			best, bestDepth = candidate, depth
+		}
+	}
+	return best, bestDepth
+}
+
+func decompress(raw []byte) (string, error) {
+	zr, err := gzip.NewReader(bytes.NewReader(raw))
+	if err != nil {
+		return "", fmt.Errorf("sddcdiag: support bundle is not a gzip stream: %w", err)
+	}
+	defer zr.Close()
+	text, err := io.ReadAll(zr)
+	if err != nil {
+		return "", fmt.Errorf("sddcdiag: decompress support bundle: %w", err)
+	}
+	return string(text), nil
+}
+
+// evidenceFor keeps the lines that carry one of the tokens, in file order. File
+// order matters: the same lines in token order would misrepresent the sequence
+// the failure actually unfolded in.
+func evidenceFor(text string, tokens []string) []string {
+	if len(tokens) == 0 {
+		return nil
+	}
+	var out []string
+	for _, line := range strings.Split(strings.TrimRight(text, "\n"), "\n") {
+		for _, tok := range tokens {
+			if strings.Contains(line, "[ref="+tok+"]") {
+				out = append(out, line)
+				break
+			}
+		}
+	}
+	return out
+}
+
+// buildSupportBundleSpec assembles the request body, leaving out every member
+// the caller did not ask for. A nested object with nothing in it is left out
+// too, rather than sent as {}.
+func buildSupportBundleSpec(req DiagnoseRequest) (SupportBundleSpec, error) {
+	var spec SupportBundleSpec
+
+	if len(req.Logs) > 0 {
+		logs, err := logsFor(req.Logs)
+		if err != nil {
+			return spec, err
+		}
+		spec.Logs = logs
+	}
+
+	if req.DomainName != "" || req.IncludeFreeHosts != nil {
+		scope := &SupportBundleScope{IncludeFreeHosts: req.IncludeFreeHosts}
+		if req.DomainName != "" {
+			domain := Domains{DomainName: req.DomainName}
+			if len(req.ClusterNames) > 0 {
+				domain.ClusterNames = req.ClusterNames
+			}
+			scope.Domains = []Domains{domain}
+		}
+		spec.Scope = scope
+	}
+
+	var opts SupportBundleOption
+	if req.Force != nil || req.SkipKnownHostCheck != nil {
+		opts.Config = &SupportBundleConfig{
+			SkipKnownHostCheck: req.SkipKnownHostCheck,
+			Force:              req.Force,
+		}
+	}
+	if req.SummaryReport != nil || req.HealthCheck != nil {
+		opts.Include = &SupportBundleIncludeItems{
+			SummaryReport: req.SummaryReport,
+			HealthCheck:   req.HealthCheck,
+		}
+	}
+	if opts.Config != nil || opts.Include != nil {
+		spec.Options = &opts
+	}
+
+	return spec, nil
+}
+
+// logsFor switches on the named Logs members, matching by the spec's own member
+// names. An unknown name is rejected rather than silently dropped, which is what
+// catches a 9.1-only name such as hcxLogs or vmsLogs.
+func logsFor(names []string) (*Logs, error) {
+	logs := &Logs{}
+	v := reflect.ValueOf(logs).Elem()
+	t := v.Type()
+
+	index := map[string]int{}
+	for i := 0; i < t.NumField(); i++ {
+		tag := t.Field(i).Tag.Get("json")
+		index[strings.Split(tag, ",")[0]] = i
+	}
+
+	yes := true
+	for _, name := range names {
+		i, ok := index[name]
+		if !ok {
+			known := make([]string, 0, len(index))
+			for k := range index {
+				known = append(known, k)
+			}
+			sort.Strings(known)
+			return nil, fmt.Errorf("sddcdiag: %q is not a Logs member of the 9.0.0.0 specification (have %s)",
+				name, strings.Join(known, ", "))
+		}
+		v.Field(i).Set(reflect.ValueOf(&yes))
+	}
+	return logs, nil
+}
diff --git a/sddcdiag/types.go b/sddcdiag/types.go
new file mode 100644
index 0000000..df52689
--- /dev/null
+++ b/sddcdiag/types.go
@@ -0,0 +1,263 @@
+package sddcdiag
+
+// The types below are projected from docs/contract.json, which is itself
+// projected from specifications/sddc-manager/sddc-manager-openapi.json at tag
+// 9.0.0.0 of vmware/vcf-api-specs.
+//
+// Every optional request member is a pointer with omitempty. That pairing is
+// what lets an unset member vanish from the wire while a member the caller
+// deliberately set to false or 0 still reaches it. A plain bool with omitempty
+// would silently drop an explicit false; a plain bool without omitempty would
+// invent a false the caller never asked for.
+
+// ---------------------------------------------------------------------------
+// Responses
+// ---------------------------------------------------------------------------
+
+// Error is the SDDC Manager error envelope, trimmed to the members this client
+// reads.
+type Error struct {
+	ErrorCode      string       `json:"errorCode,omitempty"`
+	ErrorType      string       `json:"errorType,omitempty"`
+	Message        string       `json:"message,omitempty"`
+	ReferenceToken string       `json:"referenceToken,omitempty"`
+	Causes         []ErrorCause `json:"causes,omitempty"`
+	NestedErrors   []Error      `json:"nestedErrors,omitempty"`
+}
+
+// ErrorCause is one underlying cause of an Error.
+type ErrorCause struct {
+	Type    string `json:"type,omitempty"`
+	Message string `json:"message,omitempty"`
+}
+
+// Resource is an inventory object a task acted on.
+type Resource struct {
+	ResourceID string   `json:"resourceId,omitempty"`
+	FQDN       string   `json:"fqdn,omitempty"`
+	Type       string   `json:"type,omitempty"`
+	Name       string   `json:"name,omitempty"`
+	SANs       []string `json:"sans,omitempty"`
+}
+
+// SubTask is one step of a Task. Its errors carry the reason a task failed; the
+// task's own errors usually carry only a summary.
+type SubTask struct {
+	Name                string  `json:"name,omitempty"`
+	Type                string  `json:"type,omitempty"`
+	Description         string  `json:"description,omitempty"`
+	Status              string  `json:"status,omitempty"`
+	CreationTimestamp   string  `json:"creationTimestamp,omitempty"`
+	CompletionTimestamp string  `json:"completionTimestamp,omitempty"`
+	Errors              []Error `json:"errors,omitempty"`
+}
+
+// Task is a long-running SDDC Manager operation.
+type Task struct {
+	ID                  string     `json:"id,omitempty"`
+	Name                string     `json:"name,omitempty"`
+	Type                string     `json:"type,omitempty"`
+	Status              string     `json:"status,omitempty"`
+	CreationTimestamp   string     `json:"creationTimestamp,omitempty"`
+	CompletionTimestamp string     `json:"completionTimestamp,omitempty"`
+	SubTasks            []SubTask  `json:"subTasks,omitempty"`
+	Errors              []Error    `json:"errors,omitempty"`
+	Resources           []Resource `json:"resources,omitempty"`
+	IsRetryable         bool       `json:"isRetryable,omitempty"`
+}
+
+// PageMetadata describes one page of a paged collection.
+type PageMetadata struct {
+	PageNumber    int `json:"pageNumber"`
+	PageSize      int `json:"pageSize"`
+	TotalElements int `json:"totalElements"`
+	TotalPages    int `json:"totalPages"`
+}
+
+// PageOfTask is the getTasks response.
+type PageOfTask struct {
+	Elements     []Task       `json:"elements"`
+	PageMetadata PageMetadata `json:"pageMetadata"`
+}
+
+// Message is a localizable notification message.
+type Message struct {
+	ID               string   `json:"id,omitempty"`
+	LocalizedMessage string   `json:"localizedMessage,omitempty"`
+	Arguments        []string `json:"arguments,omitempty"`
+}
+
+// NotifiableResource is a resource a notification was raised on.
+type NotifiableResource struct {
+	ID   string `json:"id,omitempty"`
+	Type string `json:"type,omitempty"`
+	Name string `json:"name,omitempty"`
+}
+
+// NotifiableDomain is the domain a notification belongs to.
+type NotifiableDomain struct {
+	ID   string `json:"id,omitempty"`
+	Name string `json:"name,omitempty"`
+}
+
+// Notification is one entry of the system notification feed.
+type Notification struct {
+	Type                string               `json:"type,omitempty"`
+	Severity            string               `json:"severity,omitempty"`
+	Message             Message              `json:"message"`
+	CreationTimestamp   string               `json:"creationTimestamp,omitempty"`
+	ExpirationTimestamp string               `json:"expirationTimestamp,omitempty"`
+	Resources           []NotifiableResource `json:"resources,omitempty"`
+	Domain              NotifiableDomain     `json:"domain"`
+}
+
+// SupportBundle is the state of an SoS log collection.
+type SupportBundle struct {
+	ID                  string `json:"id,omitempty"`
+	Status              string `json:"status,omitempty"`
+	Description         string `json:"description,omitempty"`
+	BundleName          string `json:"bundleName,omitempty"`
+	BundleAvailable     string `json:"bundleAvailable,omitempty"`
+	CreationTimestamp   string `json:"creationTimestamp,omitempty"`
+	CompletionTimestamp string `json:"completionTimestamp,omitempty"`
+}
+
+// terminal reports whether the collection has stopped moving.
+func (b SupportBundle) terminal() bool {
+	return b.Status == "COMPLETED_WITH_SUCCESS" || b.Status == "COMPLETED_WITH_FAILURE"
+}
+
+// ---------------------------------------------------------------------------
+// Requests
+// ---------------------------------------------------------------------------
+
+// TaskQuery holds the getTasks query parameters. A nil member is one the caller
+// did not set and is left off the query string entirely. A non-nil member is
+// sent even when it points at a zero or a false.
+type TaskQuery struct {
+	Limit          *int
+	TaskStatus     *string
+	TaskType       *string
+	ResourceID     *string
+	ResourceType   *string
+	CompletedAfter *int64
+	PageNumber     *int
+	PageSize       *int
+	OrderDirection *string
+	OrderBy        *string
+	TaskName       *string
+	DoLiveRefresh  *bool
+}
+
+// Logs selects which components an SoS collection gathers. The 16 members below
+// are exactly those the 9.0.0.0 revision declares; 9.1.0.0 adds hcxLogs and
+// vmsLogs, which do not belong here.
+type Logs struct {
+	VCLogs            *bool `json:"vcLogs,omitempty"`
+	NSXLogs           *bool `json:"nsxLogs,omitempty"`
+	ESXLogs           *bool `json:"esxLogs,omitempty"`
+	WCPLogs           *bool `json:"wcpLogs,omitempty"`
+	SDDCManagerLogs   *bool `json:"sddcManagerLogs,omitempty"`
+	APILogs           *bool `json:"apiLogs,omitempty"`
+	SystemDebugLogs   *bool `json:"systemDebugLogs,omitempty"`
+	VMScreenshots     *bool `json:"vmScreenshots,omitempty"`
+	VRALogs           *bool `json:"vraLogs,omitempty"`
+	VROPSLogs         *bool `json:"vropsLogs,omitempty"`
+	VRLILogs          *bool `json:"vrliLogs,omitempty"`
+	VRSLCMLogs        *bool `json:"vrslcmLogs,omitempty"`
+	AutomationLogs    *bool `json:"automationLogs,omitempty"`
+	OperationsLogs    *bool `json:"operationsLogs,omitempty"`
+	OperationsForLogs *bool `json:"operationsForLogs,omitempty"`
+	LifecycleLogs     *bool `json:"lifecycleLogs,omitempty"`
+}
+
+// SupportBundleConfig is the SoS run configuration.
+type SupportBundleConfig struct {
+	SkipKnownHostCheck *bool `json:"skipKnownHostCheck,omitempty"`
+	Force              *bool `json:"force,omitempty"`
+}
+
+// SupportBundleIncludeItems selects the extra reports an SoS run produces.
+type SupportBundleIncludeItems struct {
+	SummaryReport *bool `json:"summaryReport,omitempty"`
+	HealthCheck   *bool `json:"healthCheck,omitempty"`
+}
+
+// SupportBundleOption groups the SoS options.
+type SupportBundleOption struct {
+	Config  *SupportBundleConfig       `json:"config,omitempty"`
+	Include *SupportBundleIncludeItems `json:"include,omitempty"`
+}
+
+// Domains names a domain and, optionally, clusters within it.
+type Domains struct {
+	DomainName   string   `json:"domainName,omitempty"`
+	ClusterNames []string `json:"clusterNames,omitempty"`
+}
+
+// SupportBundleScope bounds an SoS collection.
+type SupportBundleScope struct {
+	IncludeFreeHosts *bool     `json:"includeFreeHosts,omitempty"`
+	Domains          []Domains `json:"domains,omitempty"`
+}
+
+// SupportBundleSpec is the startSupportBundle request body.
+type SupportBundleSpec struct {
+	Options *SupportBundleOption `json:"options,omitempty"`
+	Scope   *SupportBundleScope  `json:"scope,omitempty"`
+	Logs    *Logs                `json:"logs,omitempty"`
+}
+
+// compactSupportBundleSpec removes empty optional objects before a spec goes
+// on the wire. A non-nil pointer to false is not empty and is preserved.
+func compactSupportBundleSpec(spec SupportBundleSpec) SupportBundleSpec {
+	if spec.Logs != nil && logsEmpty(spec.Logs) {
+		spec.Logs = nil
+	}
+
+	if spec.Options != nil {
+		opts := *spec.Options
+		if opts.Config != nil && opts.Config.SkipKnownHostCheck == nil && opts.Config.Force == nil {
+			opts.Config = nil
+		}
+		if opts.Include != nil && opts.Include.SummaryReport == nil && opts.Include.HealthCheck == nil {
+			opts.Include = nil
+		}
+		if opts.Config == nil && opts.Include == nil {
+			spec.Options = nil
+		} else {
+			spec.Options = &opts
+		}
+	}
+
+	if spec.Scope != nil {
+		scope := *spec.Scope
+		domains := make([]Domains, 0, len(scope.Domains))
+		for _, domain := range scope.Domains {
+			if len(domain.ClusterNames) == 0 {
+				domain.ClusterNames = nil
+			}
+			if domain.DomainName != "" || len(domain.ClusterNames) > 0 {
+				domains = append(domains, domain)
+			}
+		}
+		scope.Domains = domains
+		if scope.IncludeFreeHosts == nil && len(scope.Domains) == 0 {
+			spec.Scope = nil
+		} else {
+			spec.Scope = &scope
+		}
+	}
+
+	return spec
+}
+
+func logsEmpty(logs *Logs) bool {
+	return logs == nil ||
+		(logs.VCLogs == nil && logs.NSXLogs == nil && logs.ESXLogs == nil &&
+			logs.WCPLogs == nil && logs.SDDCManagerLogs == nil && logs.APILogs == nil &&
+			logs.SystemDebugLogs == nil && logs.VMScreenshots == nil && logs.VRALogs == nil &&
+			logs.VROPSLogs == nil && logs.VRLILogs == nil && logs.VRSLCMLogs == nil &&
+			logs.AutomationLogs == nil && logs.OperationsLogs == nil &&
+			logs.OperationsForLogs == nil && logs.LifecycleLogs == nil)
+}

          }
        },
        "500": {
          "description": "Unexpected error",
          "mediaType": "application/json",
          "schema": {
            "$ref": "#/schemas/Error"
          }
        }
      }
    },
    {
      "operationId": "getNotifications",
      "method": "GET",
      "path": "/v1/notifications",
      "tag": "Notifications",

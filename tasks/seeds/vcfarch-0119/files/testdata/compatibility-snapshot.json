{
  "snapshotVersion": "2026-08-14",
  "targetVcfVersion": "9.1.0.0",
  "productRules": [
    {
      "componentType": "live-site-recovery",
      "allowedFromVersions": ["9.0.1.0", "9.0.2.0"],
      "targetProduct": "protection-and-recovery",
      "targetVersion": "9.1.0.0",
      "allowedActions": ["replace"],
      "requiredGateIds": ["vcf-91-bom-target", "paired-recovery-compatibility"]
    },
    {
      "componentType": "nsx",
      "allowedFromVersions": ["4.2.1.0", "4.2.2.0"],
      "targetProduct": "nsx",
      "targetVersion": "9.1.0.0",
      "allowedActions": ["upgrade"],
      "requiredGateIds": ["vcf-91-bom-target"]
    },
    {
      "componentType": "vcenter",
      "allowedFromVersions": ["8.0.2.0", "8.0.3.0"],
      "targetProduct": "vcenter",
      "targetVersion": "9.1.0.0",
      "allowedActions": ["upgrade"],
      "requiredGateIds": ["vcf-91-bom-target", "lsr-before-vcenter", "nsx-before-vcenter"]
    },
    {
      "componentType": "vsan-witness",
      "allowedFromVersions": ["8.0.3.0"],
      "targetProduct": "vsan-witness",
      "targetVersion": "9.1.0.0",
      "allowedActions": ["upgrade"],
      "requiredGateIds": ["vcf-91-bom-target", "vcenter-before-witness"]
    },
    {
      "componentType": "esxi",
      "allowedFromVersions": ["8.0.2.0", "8.0.3.0"],
      "targetProduct": "esxi",
      "targetVersion": "9.1.0.0",
      "allowedActions": ["upgrade"],
      "requiredGateIds": ["vcf-91-bom-target", "vcenter-before-esxi", "nsx-before-esxi"]
    },
    {
      "componentType": "vsan",
      "allowedFromVersions": ["8.0.2.0", "8.0.3.0"],
      "targetProduct": "vsan",
      "targetVersion": "9.1.0.0",
      "allowedActions": ["upgrade"],
      "requiredGateIds": ["vcf-91-bom-target", "esxi-before-vsan", "witness-before-data-vsan"]
    }
  ],
  "gates": [
    {
      "id": "vcf-91-bom-target",
      "appliesToTypes": ["live-site-recovery", "nsx", "vcenter", "vsan-witness", "esxi", "vsan"],
      "predecessorTypes": [],
      "scope": "none",
      "requirement": "Use the VCF 9.1 BOM target product and version allowed by the pinned compatibility path."
    },
    {
      "id": "paired-recovery-compatibility",
      "appliesToTypes": ["live-site-recovery"],
      "predecessorTypes": [],
      "scope": "none",
      "requirement": "Resolve the two paired Live Site Recovery instances to the same compatible Protection and Recovery target."
    },
    {
      "id": "lsr-before-vcenter",
      "appliesToTypes": ["vcenter"],
      "predecessorTypes": ["live-site-recovery"],
      "scope": "all",
      "requirement": "Replace both Live Site Recovery instances with the compatible recovery service before either vCenter upgrade."
    },
    {
      "id": "nsx-before-vcenter",
      "appliesToTypes": ["vcenter"],
      "predecessorTypes": ["nsx"],
      "scope": "same-site",
      "requirement": "Upgrade the site's NSX deployment before its vCenter."
    },
    {
      "id": "vcenter-before-witness",
      "appliesToTypes": ["vsan-witness"],
      "predecessorTypes": ["vcenter"],
      "scope": "all",
      "requirement": "Upgrade both managing vCenter instances before the shared witness appliance."
    },
    {
      "id": "vcenter-before-esxi",
      "appliesToTypes": ["esxi"],
      "predecessorTypes": ["vcenter"],
      "scope": "same-site",
      "requirement": "Upgrade the site's vCenter before its ESXi cluster."
    },
    {
      "id": "nsx-before-esxi",
      "appliesToTypes": ["esxi"],
      "predecessorTypes": ["nsx"],
      "scope": "same-site",
      "requirement": "Upgrade the site's NSX deployment before its ESXi cluster."
    },
    {
      "id": "esxi-before-vsan",
      "appliesToTypes": ["vsan"],
      "predecessorTypes": ["esxi"],
      "scope": "same-site",
      "requirement": "Complete the site's ESXi upgrade before finalizing its vSAN upgrade."
    },
    {
      "id": "witness-before-data-vsan",
      "appliesToTypes": ["vsan"],
      "predecessorTypes": ["vsan-witness"],
      "scope": "all",
      "requirement": "Upgrade the independent witness before finalizing either data site's vSAN upgrade."
    }
  ]
}

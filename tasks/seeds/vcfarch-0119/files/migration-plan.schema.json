{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch:migration-plan:1",
  "title": "VCF Brownfield Migration Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["estateId", "targetVcfVersion", "steps"],
  "properties": {
    "estateId": {"type": "string", "minLength": 1},
    "targetVcfVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "componentId", "componentType", "site", "fromVersion", "targetProduct", "targetVersion", "action", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "componentId": {"type": "string", "minLength": 1},
          "componentType": {"type": "string", "enum": ["vcenter", "esxi", "vsan", "nsx", "live-site-recovery", "vsan-witness"]},
          "site": {"type": "string", "minLength": 1},
          "fromVersion": {"type": "string", "minLength": 1},
          "targetProduct": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "action": {"type": "string", "enum": ["upgrade", "replace"]},
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}

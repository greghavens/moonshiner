+package vcfarch
+
+import "testing"
+
+func TestBuildArchitectureRejectsInvalidInputs(t *testing.T) {
+	validInventory := Inventory{
+		EstateID:         "estate",
+		TargetVCFVersion: "9.1.0.0",
+		Sites: []Site{
+			{ID: "a", Role: "data", FailureDomain: "a-fd", ManagementHosts: []string{"a1"}},
+			{ID: "b", Role: "data", FailureDomain: "b-fd", ManagementHosts: []string{"b1"}},
+			{ID: "w", Role: "witness", FailureDomain: "w-fd", WitnessAppliance: "witness.example"},
+		},
+	}
+	validSnapshot := CompatibilitySnapshot{TargetVCFVersion: "9.1.0.0"}
+
+	tests := []struct {
+		name      string
+		inventory Inventory
+		snapshot  CompatibilitySnapshot
+	}{
+		{name: "missing estate ID", inventory: func() Inventory { value := validInventory; value.EstateID = ""; return value }(), snapshot: validSnapshot},
+		{name: "target mismatch", inventory: validInventory, snapshot: CompatibilitySnapshot{TargetVCFVersion: "9.0.0.0"}},
+		{name: "missing witness", inventory: func() Inventory { value := validInventory; value.Sites = value.Sites[:2]; return value }(), snapshot: validSnapshot},
+		{name: "one data site", inventory: func() Inventory { value := validInventory; value.Sites = value.Sites[1:]; return value }(), snapshot: validSnapshot},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if _, err := BuildArchitecture(test.inventory, test.snapshot); err == nil {
+				t.Fatal("BuildArchitecture returned no error")
+			}
+		})
+	}
+}

 )
 
 // Inventory is the separately managed estate and the physical placement input.
@@ -101,6 +103,277 @@ type MigrationStep struct {
 }
 
 // BuildArchitecture returns the complete greenfield and brownfield architecture.
-func BuildArchitecture(_ Inventory, _ CompatibilitySnapshot) (Architecture, error) {
-	return Architecture{}, errors.New("BuildArchitecture is not implemented")
+func BuildArchitecture(inventory Inventory, snapshot CompatibilitySnapshot) (Architecture, error) {
+	if inventory.EstateID == "" {
+		return Architecture{}, errors.New("estate ID is required")
+	}
+	if inventory.TargetVCFVersion == "" || inventory.TargetVCFVersion != snapshot.TargetVCFVersion {
+		return Architecture{}, errors.New("inventory and compatibility target versions differ")
+	}
+
+	rules := make(map[string]ProductRule, len(snapshot.ProductRules))
+	for _, rule := range snapshot.ProductRules {
+		if rule.ComponentType == "" || len(rule.AllowedActions) == 0 {
+			return Architecture{}, errors.New("compatibility snapshot has an incomplete product rule")
+		}
+		if _, duplicate := rules[rule.ComponentType]; duplicate {
+			return Architecture{}, fmt.Errorf("duplicate product rule for %s", rule.ComponentType)
+		}
+		rules[rule.ComponentType] = rule
+	}
+	gates := make(map[string]GateRule, len(snapshot.Gates))
+	for _, gate := range snapshot.Gates {
+		if gate.ID == "" {
+			return Architecture{}, errors.New("compatibility snapshot has a gate without an ID")
+		}
+		gates[gate.ID] = gate
+	}
+
+	componentByID := make(map[string]EstateComponent, len(inventory.Components))
+	for _, component := range inventory.Components {
+		if component.ID == "" {
+			return Architecture{}, errors.New("inventory has a component without an ID")
+		}
+		if _, duplicate := componentByID[component.ID]; duplicate {
+			return Architecture{}, fmt.Errorf("duplicate inventory component %s", component.ID)
+		}
+		rule, supported := rules[component.Type]
+		if !supported {
+			return Architecture{}, fmt.Errorf("no compatibility rule for component type %s", component.Type)
+		}
+		if !contains(rule.AllowedFromVersions, component.Version) {
+			return Architecture{}, fmt.Errorf("no path from %s %s", component.Type, component.Version)
+		}
+		for _, gateID := range rule.RequiredGateIDs {
+			if _, exists := gates[gateID]; !exists {
+				return Architecture{}, fmt.Errorf("product rule %s refers to unknown gate %s", component.Type, gateID)
+			}
+		}
+		componentByID[component.ID] = component
+	}
+
+	dataSites, witnessSite, err := classifySites(inventory.Sites)
+	if err != nil {
+		return Architecture{}, err
+	}
+	orderedComponents, err := orderComponents(inventory.Components, rules, gates)
+	if err != nil {
+		return Architecture{}, err
+	}
+
+	steps := make([]MigrationStep, 0, len(orderedComponents))
+	for index, component := range orderedComponents {
+		rule := rules[component.Type]
+		steps = append(steps, MigrationStep{
+			Order:         index + 1,
+			ComponentID:   component.ID,
+			ComponentType: component.Type,
+			Site:          component.Site,
+			FromVersion:   component.Version,
+			TargetProduct: rule.TargetProduct,
+			TargetVersion: rule.TargetVersion,
+			Action:        rule.AllowedActions[0],
+			Gates:         append([]string(nil), rule.RequiredGateIDs...),
+		})
+	}
+
+	return Architecture{
+		GreenfieldSddcSpec: buildSddcSpec(inventory.TargetVCFVersion, dataSites),
+		Topology: Topology{ManagementDomain: ManagementDomain{
+			Name:      "vcf-mgmt-stretched",
+			Stretched: true,
+			DataSites: []DataSite{
+				{
+					SiteID:        dataSites[0].ID,
+					FailureDomain: dataSites[0].FailureDomain,
+					Hosts:         append([]string(nil), dataSites[0].ManagementHosts...),
+				},
+				{
+					SiteID:        dataSites[1].ID,
+					FailureDomain: dataSites[1].FailureDomain,
+					Hosts:         append([]string(nil), dataSites[1].ManagementHosts...),
+				},
+			},
+			Witness: Witness{
+				SiteID:                   witnessSite.ID,
+				FailureDomain:            witnessSite.FailureDomain,
+				Appliance:                witnessSite.WitnessAppliance,
+				IndependentFailureDomain: true,
+			},
+		}},
+		MigrationPlan: MigrationPlan{
+			EstateID:         inventory.EstateID,
+			TargetVCFVersion: inventory.TargetVCFVersion,
+			Steps:            steps,
+		},
+	}, nil
+}
+
+func classifySites(sites []Site) ([]Site, Site, error) {
+	dataSites := make([]Site, 0, 2)
+	var witness Site
+	witnesses := 0
+	for _, site := range sites {
+		switch site.Role {
+		case "data":
+			if len(site.ManagementHosts) == 0 {
+				return nil, Site{}, fmt.Errorf("data site %s has no management hosts", site.ID)
+			}
+			dataSites = append(dataSites, site)
+		case "witness":
+			witness = site
+			witnesses++
+		}
+	}
+	if len(dataSites) != 2 {
+		return nil, Site{}, fmt.Errorf("got %d data sites, want two", len(dataSites))
+	}
+	if witnesses != 1 || witness.WitnessAppliance == "" {
+		return nil, Site{}, errors.New("exactly one witness site with an appliance is required")
+	}
+	if witness.FailureDomain == dataSites[0].FailureDomain || witness.FailureDomain == dataSites[1].FailureDomain {
+		return nil, Site{}, errors.New("witness failure domain must be independent")
+	}
+	return dataSites, witness, nil
+}
+
+func orderComponents(components []EstateComponent, rules map[string]ProductRule, gates map[string]GateRule) ([]EstateComponent, error) {
+	dependencies := make(map[string]map[string]bool, len(components))
+	for _, component := range components {
+		dependencies[component.ID] = map[string]bool{}
+		for _, gateID := range rules[component.Type].RequiredGateIDs {
+			gate := gates[gateID]
+			for _, predecessor := range components {
+				if !contains(gate.PredecessorTypes, predecessor.Type) {
+					continue
+				}
+				if gate.Scope == "same-site" && predecessor.Site != component.Site {
+					continue
+				}
+				dependencies[component.ID][predecessor.ID] = true
+			}
+		}
+	}
+
+	remaining := make(map[string]EstateComponent, len(components))
+	for _, component := range components {
+		remaining[component.ID] = component
+	}
+	done := map[string]bool{}
+	ordered := make([]EstateComponent, 0, len(components))
+	for len(remaining) > 0 {
+		ready := make([]string, 0, len(remaining))
+		for id := range remaining {
+			allDone := true
+			for dependency := range dependencies[id] {
+				if !done[dependency] {
+					allDone = false
+					break
+				}
+			}
+			if allDone {
+				ready = append(ready, id)
+			}
+		}
+		if len(ready) == 0 {
+			return nil, errors.New("compatibility gates contain a dependency cycle")
+		}
+		sort.Strings(ready)
+		next := ready[0]
+		ordered = append(ordered, remaining[next])
+		delete(remaining, next)
+		done[next] = true
+	}
+	return ordered, nil
+}
+
+func buildSddcSpec(version string, dataSites []Site) map[string]any {
+	hostSpecs := make([]any, 0, len(dataSites[0].ManagementHosts)+len(dataSites[1].ManagementHosts))
+	for _, site := range dataSites {
+		for _, hostname := range site.ManagementHosts {
+			hostSpecs = append(hostSpecs, map[string]any{"hostname": hostname})
+		}
+	}
+	return map[string]any{
+		"sddcId":       "vcf-mgmt-stretched",
+		"workflowType": "VCF",
+		"version":      version,
+		"hostSpecs":    hostSpecs,
+		"vcenterSpec": map[string]any{
+			"vcenterHostname":     "vc-mgmt.vcf.example",
+			"rootVcenterPassword": "SeedOnly!VcPass1",
+			"vmSize":              "medium",
+			"ssoDomain":           "vsphere.local",
+		},
+		"clusterSpec": map[string]any{
+			"datacenterName": "vcf-management",
+			"clusterName":    "vcf-mgmt-stretched",
+		},
+		"dvsSpecs": []any{
+			map[string]any{
+				"dvsName":  "vds-mgmt",
+				"networks": []any{"MANAGEMENT", "VMOTION", "VSAN", "VM_MANAGEMENT"},
+				"mtu":      9000,
+				"vmnicsToUplinks": []any{
+					map[string]any{"id": "vmnic0", "uplink": "uplink1"},
+					map[string]any{"id": "vmnic1", "uplink": "uplink2"},
+				},
+			},
+		},
+		"nsxtSpec": map[string]any{
+			"nsxtManagers": []any{
+				map[string]any{"hostname": "nsx-mgr-01.vcf.example"},
+				map[string]any{"hostname": "nsx-mgr-02.vcf.example"},
+				map[string]any{"hostname": "nsx-mgr-03.vcf.example"},
+			},
+			"nsxtManagerSize": "medium",
+			"vipFqdn":         "nsx-mgmt.vcf.example",
+			"transportVlanId": 1700,
+		},
+		"networkSpecs": []any{
+			managementNetwork("MANAGEMENT", "10.10.10.0/24", "10.10.10.1", 1610, "10.10.10.20", "10.10.10.39"),
+			managementNetwork("VMOTION", "10.10.20.0/24", "10.10.20.1", 1620, "10.10.20.20", "10.10.20.39"),
+			managementNetwork("VSAN", "10.10.30.0/24", "10.10.30.1", 1630, "10.10.30.20", "10.10.30.39"),
+			managementNetwork("VM_MANAGEMENT", "10.10.40.0/24", "10.10.40.1", 1640, "10.10.40.20", "10.10.40.39"),
+		},
+		"dnsSpec": map[string]any{
+			"subdomain":   "vcf.example",
+			"nameservers": []any{"10.10.10.10", "10.10.10.11"},
+		},
+		"ntpServers": []any{"10.10.10.12", "10.10.10.13"},
+		"sddcManagerSpec": map[string]any{
+			"hostname": "sddc-manager.vcf.example",
+		},
+		"managementPoolName": "mgmt-network-pool",
+		"ceipEnabled":        false,
+		"datastoreSpec": map[string]any{
+			"vsanSpec": map[string]any{
+				"datastoreName":      "vsan-mgmt-stretched",
+				"failuresToTolerate": 1,
+			},
+		},
+	}
+}
+
+func managementNetwork(networkType, subnet, gateway string, vlan int, start, end string) map[string]any {
+	return map[string]any{
+		"networkType": networkType,
+		"subnet":      subnet,
+		"gateway":     gateway,
+		"subnetMask":  "255.255.255.0",
+		"vlanId":      vlan,
+		"mtu":         9000,
+		"includeIpAddressRanges": []any{
+			map[string]any{"startIpAddress": start, "endIpAddress": end},
+		},
+	}
+}
+
+func contains(values []string, target string) bool {
+	for _, value := range values {
+		if value == target {
+			return true
+		}
+	}
+	return false
 }

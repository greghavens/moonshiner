{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0093:migration-plan:1.0",
  "title": "Brownfield VCF migration architecture",
  "description": "An SddcSpec-compatible target architecture extended with an ordered brownfield migration plan.",
  "type": "object",
  "required": [
    "artifactKind",
    "schemaVersion",
    "estateId",
    "targetVcfVersion",
    "installerSpec",
    "researchLog",
    "sddcId",
    "workflowType",
    "version",
    "hostSpecs",
    "vcenterSpec",
    "clusterSpec",
    "networkSpecs",
    "dnsSpec",
    "ntpServers",
    "sddcManagerSpec",
    "datastoreSpec",
    "sites",
    "stretchedManagementDomain",
    "migrationHops",
    "gates",
    "components",
    "steps"
  ],
  "properties": {
    "artifactKind": {"const": "brownfield-vcf-migration-plan"},
    "schemaVersion": {"const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "targetVcfVersion": {"type": "string", "minLength": 1},
    "installerSpec": {
      "type": "object",
      "required": ["repository", "tag", "path", "sha256", "schema", "license"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema": {"const": "SddcSpec"},
        "license": {"const": "Apache-2.0"}
      }
    },
    "researchLog": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["source", "locator", "consultedFor"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "pattern": "^https://\\S+$"},
          "consultedFor": {"type": "string", "minLength": 1},
          "consultedOn": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
        }
      }
    },
    "sites": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "role", "failureDomain", "managementHosts"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"enum": ["DATA", "WITNESS"]},
          "failureDomain": {"type": "string", "minLength": 1},
          "managementHosts": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "stretchedManagementDomain": {
      "type": "object",
      "required": [
        "clusterId",
        "dataSiteIds",
        "preferredSiteId",
        "secondarySiteId",
        "witness",
        "availabilityMethod"
      ],
      "properties": {
        "clusterId": {"type": "string", "minLength": 1},
        "dataSiteIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "preferredSiteId": {"type": "string", "minLength": 1},
        "secondarySiteId": {"type": "string", "minLength": 1},
        "availabilityMethod": {"const": "VSAN_STRETCHED_CLUSTER"},
        "witness": {
          "type": "object",
          "required": [
            "componentId",
            "siteId",
            "failureDomain",
            "quorumOnly",
            "runsManagementWorkloads"
          ],
          "properties": {
            "componentId": {"type": "string", "minLength": 1},
            "siteId": {"type": "string", "minLength": 1},
            "failureDomain": {"type": "string", "minLength": 1},
            "quorumOnly": {"type": "boolean"},
            "runsManagementWorkloads": {"type": "boolean"}
          }
        }
      }
    },
    "migrationHops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "fromVcf", "toVcf", "mechanism", "gateIds"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "fromVcf": {"type": "string", "minLength": 1},
          "toVcf": {"type": "string", "minLength": 1},
          "mechanism": {"type": "string", "minLength": 1},
          "gateIds": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "check", "requiredState", "evidenceFrom"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "check": {"type": "string", "minLength": 1},
          "requiredState": {"type": "string", "minLength": 1},
          "evidenceFrom": {"type": "string", "minLength": 1}
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "siteIds",
          "currentVersion",
          "supportedRoute",
          "targetProduct",
          "targetVersion",
          "action",
          "finalStepId",
          "gatedBy"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "siteIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "currentVersion": {"type": "string", "minLength": 1},
          "supportedRoute": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "targetProduct": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "action": {"enum": ["UPGRADE", "TRANSITION", "REPLACE"]},
          "finalStepId": {"type": "string", "minLength": 1},
          "gatedBy": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "phase", "action", "componentIds", "gateIds", "requiresStepIds"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1},
          "phase": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "componentIds": {"type": "array", "items": {"type": "string"}},
          "gateIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "requiresStepIds": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}

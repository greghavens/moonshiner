+// protectionGroup is one entry of a Snapservice.Clusters.ProtectionGroups_list
+// response.
+type protectionGroup struct {
+	PG   string
+	Name string
+}
+
+// listProtectionGroups invokes Snapservice.Clusters.ProtectionGroups_list.
+func (c *Client) listProtectionGroups(ctx context.Context, req BatchRequest) ([]protectionGroup, error) {
+	query := url.Values{}
+	// pgs, states, vms and cluster_pairs stay unset, and an unset optional
+	// query parameter is absent from the request rather than sent empty.
+	if len(req.Names) > 0 {
+		query["names"] = req.Names
+	}
+
+	path := "/snapservice/clusters/" + url.PathEscape(req.Cluster) + "/protection-groups"
+	body, err := c.do(ctx, http.MethodGet, path, query, nil, http.StatusOK)
+	if err != nil {
+		return nil, err
+	}
+
+	var payload struct {
+		Items *[]struct {
+			PG   string `json:"pg"`
+			Info struct {
+				Name string `json:"name"`
+			} `json:"info"`
+		} `json:"items"`
+	}
+	if err := json.Unmarshal(body, &payload); err != nil {
+		return nil, fmt.Errorf("vsandp: Snapservice.Clusters.ProtectionGroups_list: "+
+			"undecodable response: %w", err)
+	}
+	if payload.Items == nil {
+		return nil, errors.New("vsandp: Snapservice.Clusters.ProtectionGroups_list: missing items")
+	}
+	groups := make([]protectionGroup, 0, len(*payload.Items))
+	for i, item := range *payload.Items {
+		if item.PG == "" || item.Info.Name == "" {
+			return nil, fmt.Errorf("vsandp: Snapservice.Clusters.ProtectionGroups_list: "+
+				"item %d is missing a required property", i)
+		}
+		groups = append(groups, protectionGroup{PG: item.PG, Name: item.Info.Name})
+	}
+	return groups, nil
+}

+func (r BatchRequest) validate() error {
+	if r.Cluster == "" {
+		return errors.New("vsandp: BatchRequest.Cluster is required")
+	}
+	if r.SnapshotName == "" {
+		return errors.New("vsandp: BatchRequest.SnapshotName is required")
+	}
+	seen := make(map[string]bool, len(r.Names))
+	for i, name := range r.Names {
+		if name == "" {
+			return fmt.Errorf("vsandp: BatchRequest.Names[%d] is empty", i)
+		}
+		if seen[name] {
+			return fmt.Errorf("vsandp: BatchRequest.Names[%d] repeats %q; the "+
+				"names filter has unique items", i, name)
+		}
+		seen[name] = true
+	}
+	if r.Retention != nil {
+		if r.Retention.Unit == "" {
+			return errors.New("vsandp: RetentionPeriod.Unit is required when Retention is set")
+		}
+		if r.Retention.Duration <= 0 {
+			return errors.New("vsandp: RetentionPeriod.Duration must be positive when Retention is set")
+		}
+	}
+	return nil
+}

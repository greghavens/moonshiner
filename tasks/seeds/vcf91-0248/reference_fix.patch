+// createSpec mirrors Snapservice.Clusters.ProtectionGroups.Snapshots.CreateSpec,
+// with the property order the contract declares. retention is optional and is
+// omitted rather than serialized as null or as a zero-valued object.
+type createSpec struct {
+	Name      string         `json:"name"`
+	Retention *retentionSpec `json:"retention,omitempty"`
+}
+
+// retentionSpec mirrors Snapservice.RetentionPeriod. Both properties are
+// required, so neither carries omitempty.
+type retentionSpec struct {
+	Unit     string `json:"unit"`
+	Duration int64  `json:"duration"`
+}
+
+// createSnapshot invokes Snapservice.Clusters.ProtectionGroups.Snapshots_create$Task
+// and returns the task identifier.
+func (c *Client) createSnapshot(ctx context.Context, req BatchRequest, pg string) (string, error) {
+	spec := createSpec{Name: req.SnapshotName}
+	if req.Retention != nil {
+		spec.Retention = &retentionSpec{
+			Unit:     req.Retention.Unit,
+			Duration: req.Retention.Duration,
+		}
+	}
+	payload, err := json.Marshal(spec)
+	if err != nil {
+		return "", fmt.Errorf("vsandp: encoding CreateSpec: %w", err)
+	}
+
+	path := "/snapservice/clusters/" + url.PathEscape(req.Cluster) +
+		"/protection-groups/" + url.PathEscape(pg) + "/snapshots"
+	// The operation is only exposed as a task, so vmw-task=true is part of the
+	// contract's path rather than an optional parameter.
+	query := url.Values{"vmw-task": []string{"true"}}
+
+	body, err := c.do(ctx, http.MethodPost, path, query, payload, http.StatusAccepted)
+	if err != nil {
+		return "", err
+	}
+	var task string
+	if err := json.Unmarshal(body, &task); err != nil || task == "" {
+		return "", fmt.Errorf("vsandp: Snapservice.Clusters.ProtectionGroups.Snapshots_create$Task: "+
+			"expected a task identifier, got %q", body)
+	}
+	return task, nil
+}
+
+// awaitTask polls Snapservice.Tasks_get until the task reports a terminal
+// status, and returns that status.
+func (c *Client) awaitTask(ctx context.Context, task string) (string, error) {
+	path := "/snapservice/tasks/" + url.PathEscape(task)
+	for {
+		body, err := c.do(ctx, http.MethodGet, path, nil, nil, http.StatusOK)
+		if err != nil {
+			return "", err
+		}
+		var info struct {
+			Status string `json:"status"`
+		}
+		if err := json.Unmarshal(body, &info); err != nil {
+			return "", fmt.Errorf("vsandp: Snapservice.Tasks_get: undecodable response: %w", err)
+		}
+		switch info.Status {
+		case StatusSucceeded, StatusFailed:
+			return info.Status, nil
+		case StatusPending, StatusRunning, StatusBlocked:
+		default:
+			return "", fmt.Errorf("vsandp: Snapservice.Tasks_get: task %s reported "+
+				"unknown status %q", task, info.Status)
+		}
+		if err := c.wait(ctx); err != nil {
+			return "", err
+		}
+	}
+}
+
+func (c *Client) wait(ctx context.Context) error {
+	if c.cfg.PollInterval <= 0 {
+		return ctx.Err()
+	}
+	timer := time.NewTimer(c.cfg.PollInterval)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-timer.C:
+		return nil
+	}
+}
+
+// do sends one contract operation, refreshing the session token and replaying
+// the request once if the appliance rejects it with 401.
+func (c *Client) do(ctx context.Context, method, path string, query url.Values, payload []byte, want int) ([]byte, error) {
+	token, gen, err := c.session(ctx)
+	if err != nil {
+		return nil, err
+	}
+
+	status, body, err := c.send(ctx, method, path, query, payload, token)
+	if err != nil {
+		return nil, err
+	}
+	if status == http.StatusUnauthorized {
+		// The token expired mid-flight. Nothing was done on the appliance, so
+		// replaying this one request byte for byte resumes exactly where the
+		// batch left off.
+		if token, _, err = c.refresh(ctx, gen); err != nil {
+			return nil, err
+		}
+		if status, body, err = c.send(ctx, method, path, query, payload, token); err != nil {
+			return nil, err
+		}
+	}
+	if status != want {
+		return nil, apiError(method, path, status, body)
+	}
+	return body, nil
+}
+
+func (c *Client) send(ctx context.Context, method, path string, query url.Values, payload []byte, token string) (int, []byte, error) {
+	target := c.cfg.BaseURL + path
+	if len(query) > 0 {
+		target += "?" + query.Encode()
+	}
+	var reader io.Reader
+	if payload != nil {
+		reader = bytes.NewReader(payload)
+	}
+	req, err := http.NewRequestWithContext(ctx, method, target, reader)
+	if err != nil {
+		return 0, nil, fmt.Errorf("vsandp: building %s %s: %w", method, path, err)
+	}
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set(headerSessionID, token)
+	if payload != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+
+	resp, err := c.http.Do(req)
+	if err != nil {
+		return 0, nil, fmt.Errorf("vsandp: %s %s: %w", method, path, err)
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return 0, nil, fmt.Errorf("vsandp: reading %s %s response: %w", method, path, err)
+	}
+	return resp.StatusCode, body, nil
+}
+
+// session returns the current working token, minting the first one on demand,
+// along with the generation it belongs to.
+func (c *Client) session(ctx context.Context) (string, uint64, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.token != "" {
+		return c.token, c.gen, nil
+	}
+	return c.mintLocked(ctx)
+}
+
+// refresh replaces the token that generation stale was using. If another
+// goroutine has already replaced it, the current token is returned untouched so
+// that one expiry costs one Snapservice.Sessions_create no matter how many
+// requests it rejected.
+func (c *Client) refresh(ctx context.Context, stale uint64) (string, uint64, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.gen != stale && c.token != "" {
+		return c.token, c.gen, nil
+	}
+	return c.mintLocked(ctx)
+}
+
+// mintLocked invokes Snapservice.Sessions_create. c.mu must be held.
+func (c *Client) mintLocked(ctx context.Context) (string, uint64, error) {
+	status, body, err := c.send(ctx, http.MethodPost, "/snapservice/sessions",
+		nil, nil, c.cfg.BootstrapToken)
+	if err != nil {
+		return "", 0, err
+	}
+	if status != http.StatusCreated {
+		return "", 0, apiError(http.MethodPost, "/snapservice/sessions", status, body)
+	}
+	var token string
+	if err := json.Unmarshal(body, &token); err != nil || token == "" {
+		return "", 0, fmt.Errorf("vsandp: Snapservice.Sessions_create: expected a "+
+			"session token, got %q", body)
+	}
+	c.token = token
+	c.gen++
+	c.creates++
+	return c.token, c.gen, nil
+}
+
+// apiError renders a Vapi.Std.Errors.Error response, falling back to the raw
+// body when it does not follow the schema.
+func apiError(method, path string, status int, body []byte) error {
+	var payload struct {
+		ErrorType string `json:"error_type"`
+		Messages  []struct {
+			DefaultMessage string `json:"default_message"`
+		} `json:"messages"`
+	}
+	if err := json.Unmarshal(body, &payload); err == nil && len(payload.Messages) > 0 {
+		return fmt.Errorf("vsandp: %s %s: %d %s: %s", method, path, status,
+			payload.ErrorType, payload.Messages[0].DefaultMessage)
+	}
+	return fmt.Errorf("vsandp: %s %s: unexpected status %d: %s", method, path, status,
+		strings.TrimSpace(string(body)))
 }

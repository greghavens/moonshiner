{
  "apiTitle": "Snapshot Appliance API",
  "apiVersion": "9.1.0.0",
  "openapi": "3.0.3",
  "serverTemplate": "https://{host}/api",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commitSha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "specPath": "specifications/vsan-data-protection/vsan-data-protection-openapi.yaml"
  },
  "securityScheme": {
    "name": "api_key_auth",
    "type": "apiKey",
    "header": "vmware-api-session-id",
    "in": "header"
  },
  "operations": {
    "Snapservice.Sessions_create": {
      "operationId": "Snapservice.Sessions_create",
      "method": "POST",
      "path": "/snapservice/sessions",
      "specPathKey": "/snapservice/sessions",
      "security": [
        "api_key_auth"
      ],
      "parameters": [],
      "responses": {
        "201": {
          "type": "string",
          "format": "password"
        },
        "401": {
          "$ref": "#/schemas/Vapi.Std.Errors.Unauthenticated"
        },
        "503": {
          "$ref": "#/schemas/Vapi.Std.Errors.ServiceUnavailable"
        }
      }
    },
    "Snapservice.Clusters.ProtectionGroups_list": {
      "operationId": "Snapservice.Clusters.ProtectionGroups_list",
      "method": "GET",
      "path": "/snapservice/clusters/{cluster}/protection-groups",
      "specPathKey": "/snapservice/clusters/{cluster}/protection-groups",
      "security": [
        "api_key_auth"
      ],
      "parameters": [
        {
          "name": "cluster",
          "in": "path",
          "required": true,
          "type": "string"
        },
        {
          "name": "pgs",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        {
          "name": "names",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        {
          "name": "states",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        {
          "name": "vms",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        {
          "name": "cluster_pairs",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      ],
      "responses": {
        "200": {
          "$ref": "#/schemas/Snapservice.Clusters.ProtectionGroups.ListResult"
        },
        "400": {
          "$ref": "#/schemas/Vapi.Std.Errors.InvalidArgument"
        },
        "401": {
          "$ref": "#/schemas/Vapi.Std.Errors.Unauthenticated"
        },
        "403": {
          "$ref": "#/schemas/Vapi.Std.Errors.Unauthorized"
        },
        "404": {
          "$ref": "#/schemas/Vapi.Std.Errors.NotFound"
        },
        "500": {
          "$ref": "#/schemas/Vapi.Std.Errors.Error"
        },
        "503": {
          "$ref": "#/schemas/Vapi.Std.Errors.ServiceUnavailable"
        }
      }
    },
    "Snapservice.Clusters.ProtectionGroups.Snapshots_create$Task": {
      "operationId": "Snapservice.Clusters.ProtectionGroups.Snapshots_create$Task",
      "method": "POST",
      "path": "/snapservice/clusters/{cluster}/protection-groups/{pg}/snapshots",
      "specPathKey": "/snapservice/clusters/{cluster}/protection-groups/{pg}/snapshots?vmw-task=true",
      "fixedQuery": {
        "vmw-task": "true"
      },
      "security": [
        "api_key_auth"
      ],
      "parameters": [
        {
          "name": "cluster",
          "in": "path",
          "required": true,
          "type": "string"
        },
        {
          "name": "pg",
          "in": "path",
          "required": true,
          "type": "string"
        }
      ],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "$ref": "#/schemas/Snapservice.Clusters.ProtectionGroups.Snapshots.CreateSpec"
      },
      "responses": {
        "202": {
          "type": "string"
        },
        "400": {
          "$ref": "#/schemas/Vapi.Std.Errors.Error"
        },
        "401": {
          "$ref": "#/schemas/Vapi.Std.Errors.Unauthenticated"
        },
        "403": {
          "$ref": "#/schemas/Vapi.Std.Errors.Unauthorized"
        },
        "404": {
          "$ref": "#/schemas/Vapi.Std.Errors.NotFound"
        },
        "500": {
          "$ref": "#/schemas/Vapi.Std.Errors.Error"
        },
        "503": {
          "$ref": "#/schemas/Vapi.Std.Errors.ServiceUnavailable"
        }
      }
    },
    "Snapservice.Tasks_get": {
      "operationId": "Snapservice.Tasks_get",
      "method": "GET",
      "path": "/snapservice/tasks/{task}",
      "specPathKey": "/snapservice/tasks/{task}",
      "security": [
        "api_key_auth"
      ],
      "parameters": [
        {
          "name": "task",
          "in": "path",
          "required": true,
          "type": "string"
        }
      ],
      "responses": {
        "200": {
          "$ref": "#/schemas/Snapservice.Tasks.Info"
        },
        "401": {
          "$ref": "#/schemas/Vapi.Std.Errors.Unauthenticated"
        },
        "403": {
          "$ref": "#/schemas/Vapi.Std.Errors.Unauthorized"
        },
        "404": {
          "$ref": "#/schemas/Vapi.Std.Errors.NotFound"
        },
        "500": {
          "$ref": "#/schemas/Vapi.Std.Errors.Error"
        },
        "503": {
          "$ref": "#/schemas/Vapi.Std.Errors.ServiceUnavailable"
        }
      }
    }
  },
  "schemas": {
    "Snapservice.Clusters.ProtectionGroups.Snapshots.CreateSpec": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "retention": {
          "$ref": "#/schemas/Snapservice.RetentionPeriod"
        }
      }
    },
    "Snapservice.RetentionPeriod": {
      "required": [
        "duration",
        "unit"
      ],
      "properties": {
        "unit": {
          "type": "string"
        },
        "duration": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "Snapservice.TimeUnit": {
      "type": "string",
      "enum": [
        "MINUTE",
        "HOUR",
        "DAY",
        "WEEK",
        "MONTH",
        "YEAR"
      ]
    },
    "Snapservice.Clusters.ProtectionGroups.ListResult": {
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/schemas/Snapservice.Clusters.ProtectionGroups.ListItem"
          }
        }
      }
    },
    "Snapservice.Clusters.ProtectionGroups.ListItem": {
      "required": [
        "info",
        "pg"
      ],
      "properties": {
        "pg": {
          "type": "string"
        },
        "info": {
          "$ref": "#/schemas/Snapservice.ProtectionGroupInfo"
        }
      }
    },
    "Snapservice.ProtectionGroupInfo": {
      "required": [
        "locked",
        "name",
        "snapshots",
        "status",
        "vms"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "vms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "snapshots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locked": {
          "type": "boolean"
        }
      }
    },
    "Snapservice.Tasks.Info": {
      "required": [
        "cancelable",
        "description",
        "operation",
        "service",
        "status"
      ],
      "properties": {
        "progress": {
          "$ref": "#/schemas/Snapservice.Tasks.Progress"
        },
        "result": {},
        "description": {
          "$ref": "#/schemas/Vapi.Std.LocalizableMessage"
        },
        "service": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "cancelable": {
          "type": "boolean"
        },
        "error": {
          "type": "object"
        }
      }
    },
    "Snapservice.Tasks.Status": {
      "type": "string",
      "enum": [
        "PENDING",
        "RUNNING",
        "BLOCKED",
        "SUCCEEDED",
        "FAILED"
      ]
    },
    "Snapservice.Tasks.Progress": {
      "required": [
        "completed",
        "message",
        "total"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "format": "int64"
        },
        "completed": {
          "type": "integer",
          "format": "int64"
        },
        "message": {
          "$ref": "#/schemas/Vapi.Std.LocalizableMessage"
        }
      }
    },
    "Vapi.Std.Errors.Unauthenticated": {
      "allOf": [
        "#/schemas/Vapi.Std.Errors.Error"
      ],
      "properties": {
        "challenge": {
          "type": "string"
        }
      },
      "required": []
    },
    "Vapi.Std.Errors.Error": {
      "required": [
        "error_type",
        "messages"
      ],
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/schemas/Vapi.Std.LocalizableMessage"
          }
        },
        "data": {
          "type": "object"
        },
        "error_type": {
          "type": "string"
        }
      }
    },
    "Vapi.Std.LocalizableMessage": {
      "required": [
        "args",
        "default_message",
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "default_message": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

{
  "snapshotId": "vcf-9.0.0.0-compat-2026-08-14",
  "asOf": "2026-08-14",
  "targetRelease": "9.0.0.0",
  "basis": [
    "Broadcom VCF 9.0 bill of materials",
    "Broadcom product interoperability matrix",
    "Broadcom VCF 9.0 update sequence"
  ],
  "greenfield": {
    "workflowType": "VCF",
    "componentVersions": {
      "sddcManager": "9.0.0.0",
      "vcenter": "9.0.0.0",
      "esxi": "9.0.0.0",
      "nsx": "9.0.0.0",
      "vsanWitness": "9.0.0.0"
    },
    "stretchedManagementDomain": {
      "minimumHostsPerDataSite": 4,
      "dataSiteCount": 2,
      "witnessMustUseThirdSite": true,
      "witnessIsDataNode": false,
      "maximumWitnessRttMs": 200,
      "requiredVsanFailuresToTolerate": 1
    }
  },
  "migration": {
    "gateDefinitions": [
      {
        "gateId": "aria-operations-at-least-8-14",
        "condition": "The source Aria Operations release is 8.14 or later."
      },
      {
        "gateId": "aria-suite-lifecycle-patch-2",
        "condition": "Aria Suite Lifecycle 8.18 Patch 2 is installed and healthy."
      },
      {
        "gateId": "esxi-hardware-compatible",
        "condition": "Every management host is compatible with the pinned ESXi 9.0 target."
      },
      {
        "gateId": "inventory-version-confirmed",
        "condition": "The discovered source version matches the estate inventory."
      },
      {
        "gateId": "management-vcenter-9-ready",
        "condition": "Management-domain vCenter reports version 9.0.0.0 and healthy."
      },
      {
        "gateId": "nsx-9-ready",
        "condition": "All NSX management-plane nodes report version 9.0.0.0 and healthy."
      },
      {
        "gateId": "nsx-upgrade-precheck",
        "condition": "The NSX lifecycle precheck has no blocking findings."
      },
      {
        "gateId": "sddc-manager-9-ready",
        "condition": "SDDC Manager reports version 9.0.0.0 and healthy services."
      },
      {
        "gateId": "sddc-manager-upgrade-precheck",
        "condition": "The SDDC Manager lifecycle precheck has no blocking findings."
      },
      {
        "gateId": "third-site-witness-reachable",
        "condition": "The third-site witness is reachable from both data-site vSAN networks."
      },
      {
        "gateId": "vcenter-upgrade-precheck",
        "condition": "The management vCenter upgrade precheck has no blocking findings."
      },
      {
        "gateId": "vcf-operations-9-ready",
        "condition": "VCF Operations 9.0 and its fleet management appliance report healthy."
      },
      {
        "gateId": "vsan-witness-9-ready",
        "condition": "The vSAN witness reports version 9.0.0.0 and healthy connectivity."
      }
    ],
    "steps": [
      {
        "order": 1,
        "componentId": "aria-suite-lifecycle",
        "targetComponentName": "VMware Aria Suite Lifecycle",
        "targetVersion": "8.18 Patch 2",
        "action": "patch",
        "gates": [
          "inventory-version-confirmed"
        ]
      },
      {
        "order": 2,
        "componentId": "aria-operations",
        "targetComponentName": "VCF Operations",
        "targetVersion": "9.0.0.0",
        "action": "in-place-upgrade-and-deploy-fleet-management",
        "gates": [
          "aria-suite-lifecycle-patch-2",
          "aria-operations-at-least-8-14"
        ]
      },
      {
        "order": 3,
        "componentId": "aria-automation",
        "targetComponentName": "VCF Automation",
        "targetVersion": "9.0.0.0",
        "action": "in-place-upgrade",
        "gates": [
          "vcf-operations-9-ready"
        ]
      },
      {
        "order": 4,
        "componentId": "aria-operations-for-logs",
        "targetComponentName": "VCF Operations for Logs",
        "targetVersion": "9.0.0.0",
        "action": "fresh-install-then-transfer-90-days",
        "gates": [
          "vcf-operations-9-ready"
        ]
      },
      {
        "order": 5,
        "componentId": "sddc-manager",
        "targetComponentName": "SDDC Manager",
        "targetVersion": "9.0.0.0",
        "action": "lifecycle-upgrade",
        "gates": [
          "vcf-operations-9-ready",
          "sddc-manager-upgrade-precheck"
        ]
      },
      {
        "order": 6,
        "componentId": "nsx",
        "targetComponentName": "VMware NSX",
        "targetVersion": "9.0.0.0",
        "action": "lifecycle-upgrade",
        "gates": [
          "sddc-manager-9-ready",
          "nsx-upgrade-precheck"
        ]
      },
      {
        "order": 7,
        "componentId": "vcenter",
        "targetComponentName": "VMware vCenter Server",
        "targetVersion": "9.0.0.0",
        "action": "lifecycle-upgrade",
        "gates": [
          "nsx-9-ready",
          "vcenter-upgrade-precheck"
        ]
      },
      {
        "order": 8,
        "componentId": "vcf-identity-broker",
        "targetComponentName": "VMware Identity Broker",
        "targetVersion": "9.0.0.0",
        "action": "new-install",
        "gates": [
          "vcf-operations-9-ready",
          "sddc-manager-9-ready",
          "management-vcenter-9-ready"
        ]
      },
      {
        "order": 9,
        "componentId": "vsan-witness",
        "targetComponentName": "vSAN Witness Appliance",
        "targetVersion": "9.0.0.0",
        "action": "lifecycle-upgrade",
        "gates": [
          "management-vcenter-9-ready",
          "third-site-witness-reachable"
        ]
      },
      {
        "order": 10,
        "componentId": "esxi",
        "targetComponentName": "VMware ESXi",
        "targetVersion": "9.0.0.0",
        "action": "rolling-lifecycle-upgrade",
        "gates": [
          "nsx-9-ready",
          "management-vcenter-9-ready",
          "vsan-witness-9-ready",
          "esxi-hardware-compatible"
        ]
      }
    ]
  }
}

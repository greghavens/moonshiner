+++ b/VcfArchitecture/VcfArchitecture.psm1
@@ -0,0 +1,483 @@
+Set-StrictMode -Version Latest
+
+function Read-VcfJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $Path
+    )
+
+    $resolved = Resolve-Path -LiteralPath $Path -ErrorAction Stop
+    return Get-Content -LiteralPath $resolved -Raw -Encoding utf8 | ConvertFrom-Json -Depth 100
+}
+
+function Write-VcfJson {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [object] $Value,
+
+        [Parameter(Mandatory)]
+        [string] $Path
+    )
+
+    $Value | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $Path -Encoding utf8
+}
+
+function New-VcfArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $RequirementsPath,
+
+        [Parameter(Mandatory)]
+        [string] $EstatePath,
+
+        [Parameter(Mandatory)]
+        [string] $CompatibilityPath,
+
+        [Parameter(Mandatory)]
+        [string] $OutputDirectory
+    )
+
+    $requirements = Read-VcfJson -Path $RequirementsPath
+    $estate = Read-VcfJson -Path $EstatePath
+    $compatibility = Read-VcfJson -Path $CompatibilityPath
+    $versions = $compatibility.greenfield.componentVersions
+
+    $hostSpecs = @(
+        foreach ($site in $requirements.sites.data) {
+            foreach ($hostname in $site.hosts) {
+                [ordered]@{
+                    hostname = $hostname
+                    credentials = [ordered]@{
+                        username = 'root'
+                        password = 'Example!ESX9Pass'
+                    }
+                }
+            }
+        }
+    )
+
+    $networkSpecs = @(
+        foreach ($network in $requirements.networking.networks) {
+            [ordered]@{
+                networkType = $network.networkType
+                subnet = $network.subnet
+                gateway = $network.gateway
+                subnetMask = $network.subnetMask
+                includeIpAddressRanges = @(
+                    [ordered]@{
+                        startIpAddress = $network.startIpAddress
+                        endIpAddress = $network.endIpAddress
+                    }
+                )
+                vlanId = $network.vlanId
+                mtu = $network.mtu
+                teamingPolicy = 'loadbalance_loadbased'
+                activeUplinks = @('uplink1', 'uplink2', 'uplink3', 'uplink4')
+                standbyUplinks = @()
+            }
+        }
+    )
+
+    $vmnicsToUplinks = @(
+        foreach ($entry in $requirements.networking.vmnicToUplink.PSObject.Properties) {
+            [ordered]@{
+                id = $entry.Name
+                uplink = [string] $entry.Value
+            }
+        }
+    )
+
+    $overlay = $requirements.networking.networks | Where-Object networkType -eq 'HOST_OVERLAY'
+    $sddcSpec = [ordered]@{
+        sddcId = $requirements.managementDomain.sddcId
+        workflowType = $compatibility.greenfield.workflowType
+        hostSpecs = $hostSpecs
+        version = $requirements.targetRelease
+        vcenterSpec = [ordered]@{
+            vcenterHostname = $requirements.services.vcenterHostname
+            rootVcenterPassword = 'Northstar!VCF9Pass'
+            vmSize = 'large'
+            storageSize = 'lstorage'
+            ssoDomain = 'vsphere.local'
+            adminUserSsoUsername = 'administrator'
+            adminUserSsoPassword = 'Northstar!SSO9Pass'
+            useExistingDeployment = $false
+            version = $versions.vcenter
+        }
+        clusterSpec = [ordered]@{
+            datacenterName = $requirements.managementDomain.datacenterName
+            clusterName = $requirements.managementDomain.clusterName
+            clusterEvcMode = 'INTEL_SAPPHIRERAPIDS'
+        }
+        dvsSpecs = @(
+            [ordered]@{
+                dvsName = $requirements.networking.dvsName
+                networks = @($requirements.networking.networks.networkType)
+                mtu = 9000
+                nsxtSwitchConfig = [ordered]@{
+                    transportZones = @(
+                        [ordered]@{ name = 'northstar-overlay-tz'; transportType = 'OVERLAY' },
+                        [ordered]@{ name = 'northstar-vlan-tz'; transportType = 'VLAN' }
+                    )
+                    hostSwitchOperationalMode = 'STANDARD'
+                    ipAssignmentType = 'StaticIpPoolSpec'
+                }
+                vmnicsToUplinks = $vmnicsToUplinks
+                nsxTeamings = @(
+                    [ordered]@{
+                        policy = 'LOADBALANCE_SRCID'
+                        activeUplinks = @('uplink1', 'uplink2', 'uplink3', 'uplink4')
+                        standByUplinks = @()
+                    }
+                )
+            }
+        )
+        nsxtSpec = [ordered]@{
+            nsxtManagers = @(
+                foreach ($hostname in $requirements.services.nsxManagerHostnames) {
+                    [ordered]@{ hostname = $hostname }
+                }
+            )
+            nsxtManagerSize = 'medium'
+            vipFqdn = $requirements.services.nsxVipFqdn
+            rootNsxtManagerPassword = 'Northstar!NSX9Root'
+            nsxtAdminPassword = 'Northstar!NSX9Admin'
+            nsxtAuditPassword = 'Northstar!NSX9Audit'
+            transportVlanId = $overlay.vlanId
+            ipAddressPoolSpec = [ordered]@{
+                name = 'northstar-host-overlay'
+                description = 'Management-domain host overlay TEP pool'
+                ignoreUnavailableNsxtCluster = $false
+                subnets = @(
+                    [ordered]@{
+                        ipAddressPoolRanges = @(
+                            [ordered]@{ start = $overlay.startIpAddress; end = $overlay.endIpAddress }
+                        )
+                        cidr = $overlay.subnet
+                        gateway = $overlay.gateway
+                    }
+                )
+            }
+            skipNsxOverlayOverManagementNetwork = $false
+            enableEdgeClusterSync = $false
+            useExistingDeployment = $false
+            version = $versions.nsx
+        }
+        networkSpecs = $networkSpecs
+        dnsSpec = [ordered]@{
+            subdomain = $requirements.services.dnsSubdomain
+            nameservers = @($requirements.services.dnsServers)
+        }
+        ntpServers = @($requirements.services.ntpServers)
+        sddcManagerSpec = [ordered]@{
+            rootPassword = 'Northstar!SDDC9Root'
+            hostname = $requirements.services.sddcManagerHostname
+            sshPassword = 'Northstar!SDDC9Ssh'
+            localUserPassword = 'Northstar!Local9User'
+            useExistingDeployment = $false
+            version = $versions.sddcManager
+        }
+        managementPoolName = $requirements.managementDomain.managementPoolName
+        ceipEnabled = $false
+        skipEsxThumbprintValidation = $false
+        skipGatewayPingValidation = $false
+        securitySpec = [ordered]@{
+            esxiCertsMode = 'VMCA'
+        }
+        datastoreSpec = [ordered]@{
+            vsanSpec = [ordered]@{
+                datastoreName = 'vsan-northstar-mgmt'
+                vsanDedup = $false
+                esaConfig = [ordered]@{ enabled = $true }
+                failuresToTolerate = $requirements.managementDomain.failuresToTolerate
+            }
+        }
+        vcfInstanceName = $requirements.vcfInstanceName
+    }
+
+    $totalHosts = [int] (($requirements.sites.data | ForEach-Object { $_.hosts.Count } | Measure-Object -Sum).Sum)
+    $survivingHosts = $totalHosts - $requirements.sites.data.Count
+    $profile = $requirements.hostProfile
+    $topology = [ordered]@{
+        designId = $requirements.designId
+        targetRelease = $requirements.targetRelease
+        managementDomain = [ordered]@{
+            clusterName = $requirements.managementDomain.clusterName
+            topology = $requirements.managementDomain.topology
+            storageArchitecture = $requirements.managementDomain.storageArchitecture
+            dataSites = @(
+                foreach ($site in $requirements.sites.data) {
+                    [ordered]@{
+                        siteId = $site.siteId
+                        failureDomain = $site.failureDomain
+                        hosts = @($site.hosts)
+                    }
+                }
+            )
+            witness = [ordered]@{
+                siteId = $requirements.sites.witness.siteId
+                failureDomain = $requirements.sites.witness.failureDomain
+                hostname = $requirements.sites.witness.hostname
+                address = $requirements.sites.witness.address
+                version = $versions.vsanWitness
+                isDataNode = $false
+                isManagementClusterMember = $false
+                latencyRttMsToDataSites = $requirements.sites.witness.latencyRttMsToDataSites
+            }
+            capacity = [ordered]@{
+                physicalHosts = $totalHosts
+                totalCpuCores = $totalHosts * $profile.coresPerHost
+                totalMemoryGiB = $totalHosts * $profile.memoryGiBPerHost
+                totalRawStorageTiB = $totalHosts * $profile.rawNvmeTiBPerHost
+                survivingHostsAfterOneFailurePerDataSite = $survivingHosts
+                survivingCpuCores = $survivingHosts * $profile.coresPerHost
+                survivingMemoryGiB = $survivingHosts * $profile.memoryGiBPerHost
+                survivingUsableStorageTiBAtFtt1 = $survivingHosts * $profile.rawNvmeTiBPerHost / 2
+            }
+        }
+        appliancePlacement = $requirements.appliancePlacement
+    }
+
+    $migrationSteps = @(
+        foreach ($target in $compatibility.migration.steps) {
+            $current = $estate.components | Where-Object componentId -eq $target.componentId
+            if ($null -eq $current) {
+                throw "Compatibility snapshot references missing estate component $($target.componentId)"
+            }
+            [ordered]@{
+                order = $target.order
+                componentId = $current.componentId
+                componentName = $current.componentName
+                currentVersion = $current.currentVersion
+                targetComponentName = $target.targetComponentName
+                targetVersion = $target.targetVersion
+                action = $target.action
+                gates = @($target.gates)
+            }
+        }
+    )
+    $migrationPlan = [ordered]@{
+        schemaVersion = '1.0'
+        estateId = $estate.estateId
+        sourceRelease = $estate.sourceRelease
+        targetRelease = $compatibility.targetRelease
+        gateDefinitions = @($compatibility.migration.gateDefinitions)
+        steps = $migrationSteps
+    }
+
+    $outputPath = [System.IO.Path]::GetFullPath($OutputDirectory)
+    [System.IO.Directory]::CreateDirectory($outputPath) | Out-Null
+    $sddcPath = Join-Path $outputPath 'greenfield-sddc.json'
+    $topologyPath = Join-Path $outputPath 'greenfield-topology.json'
+    $migrationPath = Join-Path $outputPath 'migration-plan.json'
+    Write-VcfJson -Value $sddcSpec -Path $sddcPath
+    Write-VcfJson -Value $topology -Path $topologyPath
+    Write-VcfJson -Value $migrationPlan -Path $migrationPath
+
+    [pscustomobject]@{
+        SddcSpec = $sddcPath
+        Topology = $topologyPath
+        MigrationPlan = $migrationPath
+    }
+}
+
+function Connect-VcfArchitectureInstaller {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $Server,
+
+        [Parameter(Mandatory)]
+        [pscredential] $Credential
+    )
+
+    Connect-VcfInstallerServer -Server $Server -Credential $Credential
+}
+
+function ConvertTo-VcfSdkSpec {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [pscustomobject] $Spec
+    )
+
+    $hostModels = @(
+        foreach ($hostSpec in $Spec.hostSpecs) {
+            $credentials = Initialize-VcfInstallerSddcCredentials `
+                -Username $hostSpec.credentials.username `
+                -Password $hostSpec.credentials.password
+            Initialize-VcfInstallerSddcHostSpec `
+                -Hostname $hostSpec.hostname `
+                -Credentials $credentials
+        }
+    )
+    $vcenterModel = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname $Spec.vcenterSpec.vcenterHostname `
+        -RootVcenterPassword $Spec.vcenterSpec.rootVcenterPassword `
+        -VmSize $Spec.vcenterSpec.vmSize `
+        -StorageSize $Spec.vcenterSpec.storageSize `
+        -SsoDomain $Spec.vcenterSpec.ssoDomain `
+        -AdminUserSsoUsername $Spec.vcenterSpec.adminUserSsoUsername `
+        -AdminUserSsoPassword $Spec.vcenterSpec.adminUserSsoPassword `
+        -UseExistingDeployment $Spec.vcenterSpec.useExistingDeployment `
+        -Version $Spec.vcenterSpec.version
+    $clusterModel = Initialize-VcfInstallerSddcClusterSpec `
+        -DatacenterName $Spec.clusterSpec.datacenterName `
+        -ClusterName $Spec.clusterSpec.clusterName `
+        -ClusterEvcMode $Spec.clusterSpec.clusterEvcMode
+
+    $dvsModels = @(
+        foreach ($dvsSpec in $Spec.dvsSpecs) {
+            $transportZones = @(
+                foreach ($zone in $dvsSpec.nsxtSwitchConfig.transportZones) {
+                    Initialize-VcfInstallerTransportZone -Name $zone.name -TransportType $zone.transportType
+                }
+            )
+            $switchConfig = Initialize-VcfInstallerNsxtSwitchConfig `
+                -TransportZones $transportZones `
+                -HostSwitchOperationalMode $dvsSpec.nsxtSwitchConfig.hostSwitchOperationalMode `
+                -IpAssignmentType $dvsSpec.nsxtSwitchConfig.ipAssignmentType
+            $uplinks = @(
+                foreach ($mapping in $dvsSpec.vmnicsToUplinks) {
+                    Initialize-VcfInstallerVmnicToUplink -Id $mapping.id -Uplink $mapping.uplink
+                }
+            )
+            $teamings = @(
+                foreach ($teaming in $dvsSpec.nsxTeamings) {
+                    Initialize-VcfInstallerTeamingSpec `
+                        -Policy $teaming.policy `
+                        -ActiveUplinks $teaming.activeUplinks `
+                        -StandByUplinks $teaming.standByUplinks
+                }
+            )
+            Initialize-VcfInstallerDvsSpec `
+                -DvsName $dvsSpec.dvsName `
+                -Networks $dvsSpec.networks `
+                -Mtu $dvsSpec.mtu `
+                -NsxtSwitchConfig $switchConfig `
+                -VmnicsToUplinks $uplinks `
+                -NsxTeamings $teamings
+        }
+    )
+
+    $networkModels = @(
+        foreach ($network in $Spec.networkSpecs) {
+            $ranges = @(
+                foreach ($range in $network.includeIpAddressRanges) {
+                    Initialize-VcfInstallerIpRange `
+                        -StartIpAddress $range.startIpAddress `
+                        -EndIpAddress $range.endIpAddress
+                }
+            )
+            Initialize-VcfInstallerSddcNetworkSpec `
+                -NetworkType $network.networkType `
+                -Subnet $network.subnet `
+                -Gateway $network.gateway `
+                -SubnetMask $network.subnetMask `
+                -IncludeIpAddressRanges $ranges `
+                -VlanId $network.vlanId `
+                -Mtu $network.mtu `
+                -TeamingPolicy $network.teamingPolicy `
+                -ActiveUplinks $network.activeUplinks `
+                -StandbyUplinks $network.standbyUplinks
+        }
+    )
+
+    $nsxManagers = @(
+        foreach ($manager in $Spec.nsxtSpec.nsxtManagers) {
+            Initialize-VcfInstallerNsxtManagerSpec -Hostname $manager.hostname
+        }
+    )
+    $nsxSubnets = @(
+        foreach ($subnet in $Spec.nsxtSpec.ipAddressPoolSpec.subnets) {
+            $poolRanges = @(
+                foreach ($range in $subnet.ipAddressPoolRanges) {
+                    Initialize-VcfInstallerIpAddressPoolRangeSpec -Start $range.start -VarEnd $range.end
+                }
+            )
+            Initialize-VcfInstallerIpAddressPoolSubnetSpec `
+                -IpAddressPoolRanges $poolRanges `
+                -Cidr $subnet.cidr `
+                -Gateway $subnet.gateway
+        }
+    )
+    $poolModel = Initialize-VcfInstallerIpAddressPoolSpec `
+        -Name $Spec.nsxtSpec.ipAddressPoolSpec.name `
+        -Description $Spec.nsxtSpec.ipAddressPoolSpec.description `
+        -IgnoreUnavailableNsxtCluster $Spec.nsxtSpec.ipAddressPoolSpec.ignoreUnavailableNsxtCluster `
+        -Subnets $nsxSubnets
+    $nsxModel = Initialize-VcfInstallerSddcNsxtSpec `
+        -NsxtManagers $nsxManagers `
+        -NsxtManagerSize $Spec.nsxtSpec.nsxtManagerSize `
+        -VipFqdn $Spec.nsxtSpec.vipFqdn `
+        -RootNsxtManagerPassword $Spec.nsxtSpec.rootNsxtManagerPassword `
+        -NsxtAdminPassword $Spec.nsxtSpec.nsxtAdminPassword `
+        -NsxtAuditPassword $Spec.nsxtSpec.nsxtAuditPassword `
+        -TransportVlanId $Spec.nsxtSpec.transportVlanId `
+        -IpAddressPoolSpec $poolModel `
+        -SkipNsxOverlayOverManagementNetwork $Spec.nsxtSpec.skipNsxOverlayOverManagementNetwork `
+        -EnableEdgeClusterSync $Spec.nsxtSpec.enableEdgeClusterSync `
+        -UseExistingDeployment $Spec.nsxtSpec.useExistingDeployment `
+        -Version $Spec.nsxtSpec.version
+
+    $dnsModel = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $Spec.dnsSpec.subdomain `
+        -Nameservers $Spec.dnsSpec.nameservers
+    $managerModel = Initialize-VcfInstallerSddcManagerSpec `
+        -RootPassword $Spec.sddcManagerSpec.rootPassword `
+        -Hostname $Spec.sddcManagerSpec.hostname `
+        -SshPassword $Spec.sddcManagerSpec.sshPassword `
+        -LocalUserPassword $Spec.sddcManagerSpec.localUserPassword `
+        -UseExistingDeployment $Spec.sddcManagerSpec.useExistingDeployment `
+        -Version $Spec.sddcManagerSpec.version
+    $securityModel = Initialize-VcfInstallerSecuritySpec -EsxiCertsMode $Spec.securitySpec.esxiCertsMode
+    $esaModel = Initialize-VcfInstallerVsanEsaConfig -Enabled $Spec.datastoreSpec.vsanSpec.esaConfig.enabled
+    $vsanModel = Initialize-VcfInstallerVsanSpec `
+        -DatastoreName $Spec.datastoreSpec.vsanSpec.datastoreName `
+        -VsanDedup $Spec.datastoreSpec.vsanSpec.vsanDedup `
+        -EsaConfig $esaModel `
+        -FailuresToTolerate $Spec.datastoreSpec.vsanSpec.failuresToTolerate
+    $datastoreModel = Initialize-VcfInstallerSddcDatastoreSpec -VsanSpec $vsanModel
+
+    Initialize-VcfInstallerSddcSpec `
+        -SddcId $Spec.sddcId `
+        -WorkflowType $Spec.workflowType `
+        -HostSpecs $hostModels `
+        -Version $Spec.version `
+        -VcenterSpec $vcenterModel `
+        -ClusterSpec $clusterModel `
+        -DvsSpecs $dvsModels `
+        -NsxtSpec $nsxModel `
+        -NetworkSpecs $networkModels `
+        -DnsSpec $dnsModel `
+        -NtpServers $Spec.ntpServers `
+        -SddcManagerSpec $managerModel `
+        -ManagementPoolName $Spec.managementPoolName `
+        -CeipEnabled $Spec.ceipEnabled `
+        -SkipEsxThumbprintValidation $Spec.skipEsxThumbprintValidation `
+        -SkipGatewayPingValidation $Spec.skipGatewayPingValidation `
+        -SecuritySpec $securityModel `
+        -DatastoreSpec $datastoreModel `
+        -VcfInstanceName $Spec.vcfInstanceName
+}
+
+function Test-VcfArchitectureSpecOnline {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $SddcSpecPath
+    )
+
+    $spec = Read-VcfJson -Path $SddcSpecPath
+    $sdkSpec = ConvertTo-VcfSdkSpec -Spec $spec
+    Invoke-VcfInstallerValidateSddcSpec -SddcSpec $sdkSpec
+}
+
+Export-ModuleMember -Function @(
+    'New-VcfArchitecture',
+    'Connect-VcfArchitectureInstaller',
+    'Test-VcfArchitectureSpecOnline'
+)

+                whitespace();
+                if (offset == input.length() || input.charAt(offset) != '"') {
+                    throw error("object key must be a string");
+                }
+                String key = string();
+                whitespace();
+                expect(':');
+                result.put(key, value());
+                whitespace();
+                if (take('}')) {
+                    return result;
+                }
+                expect(',');
+            }
+        }

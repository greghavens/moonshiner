+            }
+            while (true) {
+                result.add(value());
+                whitespace();
+                if (take(']')) {
+                    return result;
+                }
+                expect(',');
+            }
+        }
+
+        private String string() throws IOException {
+            expect('"');
+            StringBuilder result = new StringBuilder();
+            while (offset < input.length()) {
+                char current = input.charAt(offset++);
+                if (current == '"') {
+                    return result.toString();
+                }
+                if (current != '\\') {
+                    if (current < 0x20) {

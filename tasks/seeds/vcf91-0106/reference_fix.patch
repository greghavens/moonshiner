+from .client import VCenterAPIError, VCenterClient, collect_diagnosis
+
+
+def _parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        prog="python -m vcf_diag",
+        description="Collect vCenter TPM event-log and support-bundle evidence.",
+    )
+    parser.add_argument("--base-url", required=True, help="vCenter API root")
+    parser.add_argument("--session-id", required=True, help="vCenter API session ID")
+    parser.add_argument("--host", required=True, help="ESXi host identifier")
+    parser.add_argument(
+        "--description",
+        required=True,
+        help="support-bundle collection description",
+    )
+    parser.add_argument("--timeout", type=float, default=10.0)
+    return parser
+
+
+def main(argv: list[str] | None = None) -> int:
+    arguments = _parser().parse_args(argv)
+    try:
+        client = VCenterClient(
+            arguments.base_url,
+            arguments.session_id,
+            timeout=arguments.timeout,
+        )
+        report = collect_diagnosis(
+            client,
+            arguments.host,
+            arguments.description,
+        )
+    except (VCenterAPIError, ValueError) as exc:
+        print(f"vcf-diag: {exc}", file=sys.stderr)
+        return 1
+    print(json.dumps(report, sort_keys=True, separators=(",", ":")))
+    return 0
 
 

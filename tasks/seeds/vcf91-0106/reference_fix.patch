+        if not isinstance(value, str) or not value:
+            raise ValueError(f"{name} must be a non-empty string")
+        return quote(value, safe="")
+
+    def _request(
+        self,
+        method: str,
+        path: str,
+        *,
+        query: list[tuple[str, str]] | None = None,
+        body: dict[str, Any] | None = None,
+        expected_status: int,
+    ) -> Any:
+        if not path.startswith("/") or "://" in path:
+            raise ValueError("request path must be relative to the API root")
+        url = self._base_url + path
+        if query:
+            url += "?" + urlencode(query)
+        headers = {
+            "Accept": "application/json",
+            "vmware-api-session-id": self._session_id,
+        }
+        encoded_body: bytes | None = None
+        if body is not None:
+            encoded_body = json.dumps(
+                body, ensure_ascii=True, separators=(",", ":")
+            ).encode("utf-8")
+            headers["Content-Type"] = "application/json"
+        request = Request(
+            url,
+            data=encoded_body,
+            headers=headers,
+            method=method,
+        )
+        try:
+            with urlopen(request, timeout=self._timeout) as response:
+                status = response.status
+                payload = response.read()
+        except HTTPError as exc:
+            payload = exc.read()
+            text = payload.decode("utf-8", errors="replace")
+            raise VCenterAPIError(
+                f"vCenter returned HTTP {exc.code} for {method} {path}",
+                status=exc.code,
+                response_body=text,
+            ) from exc
+        except (URLError, TimeoutError, OSError) as exc:
+            reason = getattr(exc, "reason", exc)
+            raise VCenterAPIError(
+                f"vCenter request failed for {method} {path}: {reason}"
+            ) from exc
+        if status != expected_status:
+            text = payload.decode("utf-8", errors="replace")
+            raise VCenterAPIError(
+                f"vCenter returned HTTP {status} for {method} {path}",
+                status=status,
+                response_body=text,
+            )
+        try:
+            text = payload.decode("utf-8")
+            return json.loads(text)
+        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+            raise VCenterAPIError(
+                f"vCenter returned invalid JSON for {method} {path}"
+            ) from exc
 

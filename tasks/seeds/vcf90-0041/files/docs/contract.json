          "type": "string",
          "resource_type": "VirtualMachine",
          "description": "Identifier of the virtual machine."
        },
        "name": {
          "type": "string",
          "description": "Name of the virtual machine."
        },
        "power_state": {
          "type": "string",
          "enum": [
            "POWERED_OFF",
            "POWERED_ON",
            "SUSPENDED"
          ],
          "description": "Power state of the virtual machine."
        },
        "cpu_count": {
          "type": "integer",
          "format": "int64",
          "description": "Number of CPU cores. Missing or null when the virtual machine configuration is not available."
        },
        "memory_size_mib": {
          "type": "integer",
          "format": "int64",
          "description": "Memory size in mebibytes. Missing or null when the virtual machine configuration is not available."
        }

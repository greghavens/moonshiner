@@ -0,0 +1,161 @@
+"""A small client for the pinned subset of the vSphere Automation API.
+
+Paths, parameter serialization, property names and status codes all follow
+``docs/contract.json``, which is transcribed from the VCF 9.0 vCenter OpenAPI
+specification.
+"""
+
+from __future__ import annotations
+
+import base64
+import json
+import urllib.error
+import urllib.parse
+import urllib.request
+
+BASE_PATH = "/api"
+SESSION_HEADER = "vmware-api-session-id"
+JSON_MEDIA_TYPE = "application/json"
+DEFAULT_TIMEOUT = 30
+
+
+class ApiError(Exception):
+    """A ``Vapi.Std.Errors.Error`` reported by the appliance."""
+
+    def __init__(self, status, payload):
+        self.status = status
+        self.payload = payload if isinstance(payload, dict) else {}
+        self.error_type = self.payload.get("error_type")
+        messages = self.payload.get("messages") or []
+        self.detail = messages[0].get("default_message", "") if messages else ""
+        super().__init__(
+            "HTTP %s %s: %s" % (status, self.error_type or "error", self.detail)
+        )
+
+
+class Unauthenticated(ApiError):
+    """The session token is missing, unknown or expired."""
+
+
+def _raise(status, payload):
+    if status == 401:
+        raise Unauthenticated(status, payload)
+    raise ApiError(status, payload)
+
+
+class VCenterClient:
+    """Talks to one vCenter appliance, refreshing its session when it expires."""
+
+    def __init__(self, base_url, username, password, timeout=DEFAULT_TIMEOUT):
+        self.base_url = base_url.rstrip("/") + BASE_PATH
+        self.username = username
+        self.password = password
+        self.timeout = timeout
+        self.token = None
+        self.session_creations = 0
+
+    # -- transport --------------------------------------------------------
+
+    def _send(self, method, path, query=None, body=None, headers=None):
+        url = self.base_url + path
+        if query:
+            url += "?" + urllib.parse.urlencode(query)
+        payload = None
+        request_headers = dict(headers or {})
+        if body is not None:
+            payload = json.dumps(body).encode("utf-8")
+            request_headers["Content-Type"] = JSON_MEDIA_TYPE
+        request = urllib.request.Request(
+            url, data=payload, headers=request_headers, method=method
+        )
+        try:
+            with urllib.request.urlopen(request, timeout=self.timeout) as response:
+                return response.status, _decode(response.read())
+        except urllib.error.HTTPError as error:
+            return error.code, _decode(error.read())
+
+    def _authenticated(self, method, path, query=None, body=None):
+        """Send a session-authenticated request, refreshing an expired token once.
+
+        The request is replayed verbatim after a refresh, so no already-applied
+        change is repeated and no pending change is dropped.
+        """
+        if self.token is None:
+            self.create_session()
+        status, payload = self._send(
+            method, path, query, body, {SESSION_HEADER: self.token}
+        )
+        if status == 401:
+            self.create_session()
+            status, payload = self._send(
+                method, path, query, body, {SESSION_HEADER: self.token}
+            )
+        return status, payload
+
+    # -- Cis.Session ------------------------------------------------------
+
+    def create_session(self):
+        """``Cis.Session_create`` - exchange HTTP Basic credentials for a token."""
+        credentials = base64.b64encode(
+            ("%s:%s" % (self.username, self.password)).encode("utf-8")
+        ).decode("ascii")
+        status, payload = self._send(
+            "POST", "/session", headers={"Authorization": "Basic " + credentials}
+        )
+        if status != 201:
+            _raise(status, payload)
+        self.token = payload
+        self.session_creations += 1
+        return self.token
+
+    def delete_session(self):
+        """``Cis.Session_delete`` - log the current token out."""
+        if self.token is None:
+            return
+        status, payload = self._authenticated("DELETE", "/session")
+        if status != 204:
+            _raise(status, payload)
+        self.token = None
+
+    # -- Vcenter.VM -------------------------------------------------------
+
+    def list_vms(self, names=None):
+        """``Vcenter.VM_list`` - list virtual machines matching the filter.
+
+        ``names`` is serialized as ``style: form, explode: true``: one
+        repetition of the parameter per value.  Filters that are not being
+        applied are left off the query string entirely.
+        """
+        query = [("names", name) for name in names or []]
+        status, payload = self._authenticated("GET", "/vcenter/vm", query=query)
+        if status != 200:
+            _raise(status, payload)
+        return payload
+
+    # -- Vcenter.Vm.Hardware ----------------------------------------------
+
+    def update_cpu(self, vm, spec):
+        """``Vcenter.Vm.Hardware.Cpu_update``."""
+        self._update("/vcenter/vm/%s/hardware/cpu" % _quote(vm), spec)
+
+    def update_memory(self, vm, spec):
+        """``Vcenter.Vm.Hardware.Memory_update``."""
+        self._update("/vcenter/vm/%s/hardware/memory" % _quote(vm), spec)
+
+    def _update(self, path, spec):
+        status, payload = self._authenticated("PATCH", path, body=spec)
+        if status != 204:
+            _raise(status, payload)
+
+
+def _quote(value):
+    return urllib.parse.quote(str(value), safe="")
+
+
+def _decode(raw):
+    if not raw:
+        return None
+    try:
+        return json.loads(raw.decode("utf-8"))
+    except ValueError:
+        return None

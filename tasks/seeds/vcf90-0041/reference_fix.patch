@@ -0,0 +1,55 @@
+"""Translation of a right-sizing plan into vSphere Automation update specs."""
+
+from __future__ import annotations
+
+import json
+
+# plan key -> Vcenter.Vm.Hardware.Cpu.UpdateSpec property
+CPU_FIELDS = (
+    ("vcpus", "count"),
+    ("cores_per_socket", "cores_per_socket"),
+)
+
+# plan key -> Vcenter.Vm.Hardware.Memory.UpdateSpec property
+MEMORY_FIELDS = (
+    ("memory_mib", "size_mib"),
+    ("allow_memory_hot_add", "hot_add_enabled"),
+)
+
+
+class PlanError(Exception):
+    """The plan cannot be turned into a sequence of updates."""
+
+
+def load(path):
+    with open(path, encoding="utf-8") as handle:
+        plan = json.load(handle)
+    if not plan.get("plan_id"):
+        raise PlanError("%s has no plan_id" % path)
+    targets = plan.get("targets") or []
+    for target in targets:
+        if not target.get("vm_name"):
+            raise PlanError("%s has a target without a vm_name" % path)
+    return plan
+
+
+def _spec(target, fields):
+    """Build an update spec holding only the properties the plan changes.
+
+    Every property of both update specs is optional and means "unchanged" when
+    absent, so a property the plan is silent about is left out of the request
+    body rather than sent as null.
+    """
+    return {
+        property_name: target[plan_key]
+        for plan_key, property_name in fields
+        if plan_key in target
+    }
+
+
+def cpu_spec(target):
+    return _spec(target, CPU_FIELDS)
+
+
+def memory_spec(target):
+    return _spec(target, MEMORY_FIELDS)

+"""Command line entry point: apply a right-sizing plan to a vCenter fleet."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+
+from .client import ApiError, VCenterClient
+from .plan import PlanError, cpu_spec, load, memory_spec
+
+PASSWORD_ENV = "VCENTER_PASSWORD"
+
+
+def build_parser():
+    parser = argparse.ArgumentParser(
+        prog="vcfsizer",
+        description="Apply a right-sizing plan to virtual machines in vCenter.",
+    )
+    parser.add_argument(
+        "--base-url", required=True,
+        help="Appliance root, for example https://vcenter.example.com",
+    )
+    parser.add_argument("--username", required=True, help="vCenter Single Sign-On user")
+    parser.add_argument("--plan", required=True, help="Path to the right-sizing plan")
+    parser.add_argument("--report", required=True, help="Path of the JSON report to write")
+    return parser
+
+
+def resolve_targets(client, plan):
+    """Map every plan target to its virtual machine identifier with one listing."""
+    names = []
+    for target in plan["targets"]:
+        if target["vm_name"] not in names:
+            names.append(target["vm_name"])
+    inventory = {summary["name"]: summary["vm"] for summary in client.list_vms(names)}
+    missing = [name for name in names if name not in inventory]
+    if missing:
+        raise PlanError(
+            "no virtual machine named %s exists in this vCenter"
+            % ", ".join(sorted(missing))
+        )
+    return inventory
+
+
+def apply_plan(client, plan):
+    inventory = resolve_targets(client, plan)
+    results = []
+    for target in plan["targets"]:
+        name = target["vm_name"]
+        vm = inventory[name]
+        applied = []
+        cpu = cpu_spec(target)
+        if cpu:
+            client.update_cpu(vm, cpu)
+            applied.append("cpu")
+        memory = memory_spec(target)
+        if memory:
+            client.update_memory(vm, memory)
+            applied.append("memory")
+        results.append({"vm_name": name, "vm": vm, "applied": applied})
+    return results
+
+
+def write_report(path, plan, results, session_creations):
+    report = {
+        "plan_id": plan["plan_id"],
+        "session_creations": session_creations,
+        "results": results,
+    }
+    directory = os.path.dirname(os.path.abspath(path))
+    if directory:
+        os.makedirs(directory, exist_ok=True)
+    with open(path, "w", encoding="utf-8") as handle:
+        json.dump(report, handle, indent=2)
+        handle.write("\n")
+    return report
+
+
+def main(argv=None):
+    args = build_parser().parse_args(argv)
+    password = os.environ.get(PASSWORD_ENV)
+    if not password:
+        sys.stderr.write("%s is not set\n" % PASSWORD_ENV)
+        return 2
+
+    try:
+        plan = load(args.plan)
+    except (OSError, ValueError, PlanError) as error:
+        sys.stderr.write("%s\n" % error)
+        return 2
+
+    client = VCenterClient(args.base_url, args.username, password)
+    try:
+        try:
+            results = apply_plan(client, plan)
+        finally:
+            client.delete_session()
+    except (ApiError, PlanError) as error:
+        sys.stderr.write("%s\n" % error)
+        return 1
+
+    write_report(args.report, plan, results, client.session_creations)
+    applied = sum(len(result["applied"]) for result in results)
+    sys.stdout.write(
+        "applied %d change(s) across %d virtual machine(s) using %d session(s)\n"
+        % (applied, len(results), client.session_creations)
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

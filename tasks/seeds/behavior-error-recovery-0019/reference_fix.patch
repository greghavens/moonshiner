index 0000000..2a9329b
--- /dev/null
+++ b/reference_driver.py
@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""Reference proof for the cancellation uncertainty workflow."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parent
+TARGET_ID = "pub-119"
+REASON = "created for the wrong operating period."
+
+
+def run(command: list[str]) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        command,
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=10,
+    )
+
+
+def main() -> int:
+    cancellation = run(
+        ["./permitctl", "cancel", "--id", TARGET_ID, "--reason", REASON]
+    )
+    if cancellation.returncode != 75 or "commit status is unknown" not in cancellation.stderr:
+        raise RuntimeError("reference cancellation did not expose uncertain commit state")
+
+    retrieval = run(["./permitctl", "get", "--id", TARGET_ID])
+    if retrieval.returncode != 0:
+        raise RuntimeError(retrieval.stderr.strip() or "reference get failed")
+    payload = json.loads(retrieval.stdout)
+    record = payload.get("record")
+    if not isinstance(record, dict) or record.get("status") != "cancelled":
+        raise RuntimeError("direct get did not resolve the application as cancelled")
+    if record.get("cancellation_reason") != REASON:
+        raise RuntimeError("direct get returned the wrong cancellation reason")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

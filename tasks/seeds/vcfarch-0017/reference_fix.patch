--- /dev/null
+++ b/vcf_arch/__main__.py
@@ -0,0 +1,22 @@
+"""Command-line entry point for deterministic artifact generation."""
+
+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+
+from . import build
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Build Northstar VCF architecture artifacts")
+    parser.add_argument("--scenario", type=Path, default=Path("files/scenario.json"))
+    parser.add_argument("--inventory", type=Path, default=Path("files/estate-inventory.json"))
+    parser.add_argument("--compatibility", type=Path, default=Path("files/compatibility-snapshot.json"))
+    parser.add_argument("--output", type=Path, default=Path("artifacts"))
+    args = parser.parse_args()
+    build(args.scenario, args.inventory, args.compatibility, args.output)
+
+
+if __name__ == "__main__":
+    main()

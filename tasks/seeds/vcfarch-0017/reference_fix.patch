+++ b/vcf_arch/__init__.py
@@ -0,0 +1,251 @@
+"""Build the Northstar VCF 9.1 architecture artifacts."""
+
+from __future__ import annotations
+
+import json
+import math
+from decimal import Decimal, ROUND_CEILING
+from pathlib import Path
+from typing import Any
+
+
+def _ceiling(value: Decimal) -> int:
+    return int(value.to_integral_value(rounding=ROUND_CEILING))
+
+
+def _host_counts(scenario: dict[str, Any], snapshot: dict[str, Any]) -> dict[str, int]:
+    greenfield = scenario["greenfield"]
+    capacity = greenfield["capacity"]
+    compute = greenfield["hostCompute"]
+    storage_rules = snapshot["greenfieldRules"]["storageArchitectureRules"]
+    counts: dict[str, int] = {}
+    for candidate in greenfield["storageCandidates"]:
+        name = candidate["architecture"]
+        rule = storage_rules[name]
+        surviving_storage_hosts = _ceiling(
+            Decimal(capacity["usableStorageTiBAfterOneHostFailure"])
+            / (
+                Decimal(candidate["rawCapacityTiBPerHost"])
+                * Decimal(rule["postFailureUsableCapacityFactor"])
+            )
+        )
+        storage_hosts = surviving_storage_hosts + 1
+        core_hosts = math.ceil(
+            capacity["physicalCoresAfterOneHostFailure"] / compute["physicalCoresPerHost"]
+        ) + 1
+        memory_hosts = _ceiling(
+            Decimal(capacity["memoryTiBAfterOneHostFailure"])
+            / Decimal(compute["memoryTiBPerHost"])
+        ) + 1
+        policy_hosts = rule["minimumHostsByFtt"][str(capacity["failuresToTolerate"])] + 1
+        counts[name] = max(storage_hosts, core_hosts, memory_hosts, policy_hosts)
+    return counts
+
+
+def build_greenfield(scenario: dict[str, Any], snapshot: dict[str, Any]) -> dict[str, Any]:
+    greenfield = scenario["greenfield"]
+    site = greenfield["site"]
+    naming = greenfield["naming"]
+    capacity = greenfield["capacity"]
+    counts = _host_counts(scenario, snapshot)
+    selected = next(name for name, count in counts.items() if count <= site["maximumClusterHosts"])
+    host_count = counts[selected]
+    hosts = [f"{naming['hostPrefix']}{index:02d}" for index in range(1, host_count + 1)]
+    racks = site["rackFailureDomains"]
+    selected_candidate = next(
+        candidate for candidate in greenfield["storageCandidates"]
+        if candidate["architecture"] == selected
+    )
+    selected_rule = snapshot["greenfieldRules"]["storageArchitectureRules"][selected]
+    surviving_hosts = host_count - 1
+    usable_storage = (
+        Decimal(selected_candidate["rawCapacityTiBPerHost"])
+        * Decimal(selected_rule["postFailureUsableCapacityFactor"])
+        * surviving_hosts
+    )
+    memory = Decimal(greenfield["hostCompute"]["memoryTiBPerHost"]) * surviving_hosts
+    cores = greenfield["hostCompute"]["physicalCoresPerHost"] * surviving_hosts
+
+    network_specs = []
+    for segment in greenfield["network"]["segments"]:
+        network = {
+            "networkType": segment["networkType"],
+            "subnet": segment["subnet"],
+            "gateway": segment["gateway"],
+            "vlanId": segment["vlanId"],
+            "mtu": segment["mtu"],
+            "includeIpAddressRanges": [{
+                "startIpAddress": segment["startIpAddress"],
+                "endIpAddress": segment["endIpAddress"],
+            }],
+        }
+        if segment["networkType"] in {"VSAN", "VMOTION"}:
+            network["teamingPolicy"] = "loadbalance_loadbased"
+        network_specs.append(network)
+
+    combination = next(
+        item for item in snapshot["greenfieldRules"]["supportedCombinations"]
+        if item["storageArchitecture"] == selected
+    )
+    uplinks = [
+        {
+            "id": item["id"],
+            "speedGbps": item["speedGbps"],
+            "dvsUplink": f"uplink{index}",
+        }
+        for index, item in enumerate(greenfield["network"]["availableUplinks"], 1)
+    ]
+    return {
+        "sddcId": naming["sddcId"],
+        "workflowType": "VCF",
+        "version": snapshot["targetRelease"],
+        "vcfInstanceName": naming["vcfInstanceName"],
+        "hostSpecs": [{"hostname": hostname} for hostname in hosts],
+        "vcenterSpec": {
+            "vcenterHostname": naming["vcenterHostname"],
+            "rootVcenterPassword": "Replace-At-Deploy9!",
+            "vmSize": "large",
+            "storageSize": "lstorage",
+            "version": combination["vcenter"],
+            "useExistingDeployment": False,
+        },
+        "clusterSpec": {
+            "datacenterName": naming["datacenterName"],
+            "clusterName": naming["clusterName"],
+        },
+        "dvsSpecs": [{
+            "dvsName": naming["dvsName"],
+            "networks": snapshot["greenfieldRules"]["requiredSddcNetworks"],
+            "mtu": 9000,
+            "vmnicsToUplinks": [
+                {"id": uplink["id"], "uplink": uplink["dvsUplink"]}
+                for uplink in uplinks
+            ],
+        }],
+        "nsxtSpec": {
+            "nsxtManagers": [
+                {"hostname": hostname} for hostname in naming["nsxManagerHostnames"]
+            ],
+            "vipFqdn": naming["nsxVipFqdn"],
+            "nsxtManagerSize": "large",
+            "transportVlanId": 160,
+            "version": combination["nsx"],
+            "useExistingDeployment": False,
+        },
+        "networkSpecs": network_specs,
+        "dnsSpec": {
+            "subdomain": naming["dnsSubdomain"],
+            "nameservers": naming["dnsServers"],
+        },
+        "ntpServers": naming["ntpServers"],
+        "sddcManagerSpec": {
+            "hostname": naming["sddcManagerHostname"],
+            "version": snapshot["targetRelease"],
+            "useExistingDeployment": False,
+        },
+        "managementPoolName": "DFW01-MGMT-NETWORK-POOL",
+        "datastoreSpec": {
+            "vsanSpec": {
+                "datastoreName": naming["datastoreName"],
+                "esaConfig": {"enabled": selected == "ESA"},
+                "failuresToTolerate": capacity["failuresToTolerate"],
+            }
+        },
+        "fleetLcmSpec": {"version": "9.1.0.0", "size": "small"},
+        "sddcLcmSpec": {"version": "9.1.0.0", "size": "small"},
+        "fleetDepotSpec": {"version": "9.1.0.0", "size": "small"},
+        "licenseServerSpec": {
+            "hostname": naming["licenseServerHostname"],
+            "version": "9.1.0.0200",
+            "useExistingDeployment": False,
+        },
+        "architecture": {
+            "site": {
+                "selectedSite": site["selectedSite"],
+                "recoverySite": site["recoverySite"],
+                "stretchedCluster": False,
+            },
+            "storageDecision": {
+                "selectedArchitecture": selected,
+                "failuresToTolerate": capacity["failuresToTolerate"],
+                "requiredHosts": host_count,
+                "alternatives": [
+                    {
+                        "architecture": name,
+                        "requiredHosts": counts[name],
+                        "minimumSurvivingNetworkGbps": snapshot["greenfieldRules"]["storageArchitectureRules"][name]["minimumUplinkGbps"],
+                        "fitsSite": counts[name] <= site["maximumClusterHosts"],
+                    }
+                    for name in ("OSA", "ESA")
+                ],
+            },
+            "capacityAfterOneHostFailure": {
+                "usableStorageTiB": str(usable_storage),
+                "physicalCores": cores,
+                "memoryTiB": str(memory),
+            },
+            "rackAssignments": [
+                {"hostname": hostname, "rack": racks[index % len(racks)]}
+                for index, hostname in enumerate(hosts)
+            ],
+            "uplinks": uplinks,
+            "componentVersions": {
+                "vcenter": combination["vcenter"],
+                "esxi": combination["esxi"],
+                "vsan": combination["vsan"],
+                "nsx": combination["nsx"],
+            },
+        },
+    }
+
+
+def build_migration(inventory: dict[str, Any], snapshot: dict[str, Any]) -> dict[str, Any]:
+    rules = snapshot["estateRules"]
+    current = {item["componentId"]: item for item in inventory["components"]}
+    gates = [
+        {"gateId": gate_id, **definition}
+        for gate_id, definition in rules["gateDefinitions"].items()
+    ]
+    steps = []
+    for order, component_id in enumerate(rules["orderedComponents"], 1):
+        component = current[component_id]
+        steps.append({
+            "order": order,
+            "componentId": component_id,
+            "componentName": component["componentName"],
+            "fromVersion": component["version"],
+            "targetVersion": rules["targetVersions"][component_id],
+            "action": rules["actions"][component_id],
+            "gatedBy": rules["requiredGateIds"][component_id],
+        })
+    return {
+        "estateId": inventory["estateId"],
+        "sourceRelease": inventory["sourceRelease"],
+        "targetRelease": snapshot["targetRelease"],
+        "gates": gates,
+        "steps": steps,
+    }
+
+
+def build(
+    scenario_path: Path,
+    inventory_path: Path,
+    compatibility_path: Path,
+    output_dir: Path,
+) -> None:
+    scenario = json.loads(scenario_path.read_text(encoding="utf-8"))
+    inventory = json.loads(inventory_path.read_text(encoding="utf-8"))
+    snapshot = json.loads(compatibility_path.read_text(encoding="utf-8"))
+    output_dir.mkdir(parents=True, exist_ok=True)
+    artifacts = {
+        "greenfield-sddc.json": build_greenfield(scenario, snapshot),
+        "migration-plan.json": build_migration(inventory, snapshot),
+    }
+    for filename, artifact in artifacts.items():
+        (output_dir / filename).write_text(
+            json.dumps(artifact, indent=2) + "\n",
+            encoding="utf-8",
+        )
+
+
+__all__ = ["build", "build_greenfield", "build_migration"]

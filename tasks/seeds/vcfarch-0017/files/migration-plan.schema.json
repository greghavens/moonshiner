{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:northstar:vcf-9.1-migration-plan",
  "title": "Northstar VCF 9.1 ordered migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "estateId",
    "sourceRelease",
    "targetRelease",
    "gates",
    "steps"
  ],
  "properties": {
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "sourceRelease": {
      "type": "string",
      "minLength": 1
    },
    "targetRelease": {
      "type": "string",
      "minLength": 1
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateId",
        "kind",
        "description",
        "satisfiedByStep"
      ],
      "properties": {
        "gateId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "DEPENDENCY",
            "PRECHECK",
            "CAPACITY",
            "NETWORK",
            "BACKUP",
            "COMPATIBILITY"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 12
        },
        "satisfiedByStep": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "componentId",
        "componentName",
        "fromVersion",
        "targetVersion",
        "action",
        "gatedBy"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "componentName": {
          "type": "string",
          "minLength": 1
        },
        "fromVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": [
            "UPGRADE",
            "UPGRADE_AND_DEPLOY_MANAGEMENT_SERVICES",
            "MIGRATE_AND_DECOMMISSION",
            "DECOMMISSION_AFTER_SERVICE_MIGRATION"
          ]
        },
        "gatedBy": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

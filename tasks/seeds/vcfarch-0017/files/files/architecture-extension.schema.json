{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:northstar:vcf-9.1-architecture-extension",
  "title": "Northstar SddcSpec architecture extension",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "site",
    "storageDecision",
    "capacityAfterOneHostFailure",
    "rackAssignments",
    "uplinks",
    "componentVersions"
  ],
  "properties": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectedSite",
        "recoverySite",
        "stretchedCluster"
      ],
      "properties": {
        "selectedSite": {
          "type": "string"
        },
        "recoverySite": {
          "type": "string"
        },
        "stretchedCluster": {
          "type": "boolean"
        }
      }
    },
    "storageDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectedArchitecture",
        "failuresToTolerate",
        "requiredHosts",
        "alternatives"
      ],
      "properties": {
        "selectedArchitecture": {
          "type": "string",
          "enum": [
            "OSA",
            "ESA"
          ]
        },
        "failuresToTolerate": {
          "type": "integer",
          "minimum": 0
        },
        "requiredHosts": {
          "type": "integer",
          "minimum": 1
        },
        "alternatives": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "architecture",
              "requiredHosts",
              "minimumSurvivingNetworkGbps",
              "fitsSite"
            ],
            "properties": {
              "architecture": {
                "type": "string",
                "enum": [
                  "OSA",
                  "ESA"
                ]
              },
              "requiredHosts": {
                "type": "integer",
                "minimum": 1
              },
              "minimumSurvivingNetworkGbps": {
                "type": "integer",
                "minimum": 1
              },
              "fitsSite": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "capacityAfterOneHostFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usableStorageTiB",
        "physicalCores",
        "memoryTiB"
      ],
      "properties": {
        "usableStorageTiB": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
        },
        "physicalCores": {
          "type": "integer",
          "minimum": 1
        },
        "memoryTiB": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
        }
      }
    },
    "rackAssignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hostname",
          "rack"
        ],
        "properties": {
          "hostname": {
            "type": "string"
          },
          "rack": {
            "type": "string"
          }
        }
      }
    },
    "uplinks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "speedGbps",
          "dvsUplink"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "speedGbps": {
            "type": "integer",
            "minimum": 1
          },
          "dvsUplink": {
            "type": "string"
          }
        }
      }
    },
    "componentVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vcenter",
        "esxi",
        "vsan",
        "nsx"
      ],
      "properties": {
        "vcenter": {
          "type": "string"
        },
        "esxi": {
          "type": "string"
        },
        "vsan": {
          "type": "string"
        },
        "nsx": {
          "type": "string"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch-0146:architecture-output",
  "type": "object",
  "required": [
    "sddcId",
    "vcenterSpec",
    "networkSpecs",
    "dnsSpec",
    "schemaVersion",
    "fleetId",
    "managementDomain",
    "migrationPlan"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "fleetId": {
      "type": "string",
      "minLength": 1
    },
    "managementDomain": {
      "$ref": "#/$defs/managedDomain"
    },
    "migrationPlan": {
      "$ref": "#/$defs/migrationPlan"
    }
  },
  "$defs": {
    "gateList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "managedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "type",
        "currentVersion",
        "targetVersion",
        "action",
        "gates"
      ],
      "properties": {
        "componentId": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "currentVersion": { "type": "string", "minLength": 1 },
        "targetVersion": { "type": "string", "minLength": 1 },
        "action": { "const": "PRESERVE" },
        "gates": { "$ref": "#/$defs/gateList" }
      }
    },
    "managedDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domainId",
        "disposition",
        "components"
      ],
      "properties": {
        "domainId": { "type": "string", "minLength": 1 },
        "disposition": { "const": "unchanged" },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/managedComponent" }
        }
      }
    },
    "componentTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "type",
        "fromVersion",
        "toVersion"
      ],
      "properties": {
        "componentId": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "fromVersion": { "type": "string", "minLength": 1 },
        "toVersion": { "type": "string", "minLength": 1 }
      }
    },
    "migrationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "action",
        "components",
        "gates"
      ],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "action": { "type": "string", "minLength": 1 },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/componentTransition" }
        },
        "gates": { "$ref": "#/$defs/gateList" }
      }
    },
    "finalComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "type",
        "currentVersion",
        "targetVersion",
        "gates"
      ],
      "properties": {
        "componentId": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "currentVersion": { "type": "string", "minLength": 1 },
        "targetVersion": { "type": "string", "minLength": 1 },
        "gates": { "$ref": "#/$defs/gateList" }
      }
    },
    "migrationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domainId",
        "targetVersion",
        "steps",
        "finalComponents"
      ],
      "properties": {
        "domainId": { "type": "string", "minLength": 1 },
        "targetVersion": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/migrationStep" }
        },
        "finalComponents": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/finalComponent" }
        }
      }
    }
  }
}

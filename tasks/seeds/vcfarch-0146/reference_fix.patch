@@ -0,0 +1,41 @@
+package architecture
+
+import (
+	"path/filepath"
+	"testing"
+)
+
+func TestFixtureArchitecture(t *testing.T) {
+	artifact, err := Build("../fixtures/estate-inventory.json", "../fixtures/compatibility-snapshot.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	tests := []struct {
+		name string
+		got  string
+		want string
+	}{
+		{name: "target release", got: artifact.Version, want: "9.1.0.0"},
+		{name: "management disposition", got: artifact.Management.Disposition, want: "unchanged"},
+		{name: "first action", got: artifact.MigrationPlan.Steps[0].Action, want: "CONVERT_IMPORT_WORKLOAD_DOMAIN"},
+		{name: "last action", got: artifact.MigrationPlan.Steps[len(artifact.MigrationPlan.Steps)-1].Action, want: "APPLY_VSPHERE_CLUSTER_IMAGE"},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if test.got != test.want {
+				t.Fatalf("got %q, want %q", test.got, test.want)
+			}
+		})
+	}
+}
+
+func TestWriteFile(t *testing.T) {
+	artifact, err := Build("../fixtures/estate-inventory.json", "../fixtures/compatibility-snapshot.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(t.TempDir(), "architecture.json")
+	if err := WriteFile(path, artifact); err != nil {
+		t.Fatalf("WriteFile: %v", err)
+	}
+}

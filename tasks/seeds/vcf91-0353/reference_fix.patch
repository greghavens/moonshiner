+                }
+                return false;
+            }
+
+            private void require(char c) {
+                if (!take(c)) throw fail();
+            }
+
+            private IllegalArgumentException fail() {
+                return new IllegalArgumentException("invalid JSON");
+            }
+        }
+    }

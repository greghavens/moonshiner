diff --git a/src/vcf_depot/client.py b/src/vcf_depot/client.py
--- a/src/vcf_depot/client.py
+++ b/src/vcf_depot/client.py
@@ -6,6 +6,10 @@
 
 from __future__ import annotations
 
+import json
+from urllib.error import HTTPError, URLError
+from urllib.request import Request, urlopen
+
 
 class SddcManagerError(RuntimeError):
     """Raised when an SDDC Manager request cannot be completed."""
@@ -18,6 +22,9 @@
 class SddcManagerClient:
     """Client for the contract's retry-safe depot settings mutation."""
 
+    _RETRYABLE_STATUSES = frozenset({500, 502, 503, 504})
+    _DEPOT_PATH = "/v1/system/settings/depot"
+
     def __init__(
         self,
         base_url: str,
@@ -26,7 +33,26 @@
         timeout: float = 10.0,
         max_attempts: int = 2,
     ) -> None:
-        raise NotImplementedError("Implement SddcManagerClient")
+        if not isinstance(base_url, str) or not base_url.strip():
+            raise ValueError("base_url must be a non-empty string")
+        if not isinstance(access_token, str) or not access_token:
+            raise ValueError("access_token must be a non-empty string")
+        if (
+            not isinstance(timeout, (int, float))
+            or isinstance(timeout, bool)
+            or timeout <= 0
+        ):
+            raise ValueError("timeout must be positive")
+        if (
+            not isinstance(max_attempts, int)
+            or isinstance(max_attempts, bool)
+            or max_attempts < 1
+        ):
+            raise ValueError("max_attempts must be at least one")
+        self._base_url = base_url.rstrip("/")
+        self._access_token = access_token
+        self._timeout = float(timeout)
+        self._max_attempts = max_attempts
 
     def update_depot_settings(
         self,
@@ -37,4 +63,91 @@
         download_activation_code: str | None = None,
     ) -> dict[str, object]:
         """Apply online depot credentials using updateDepotSettings."""
-        raise NotImplementedError("Implement update_depot_settings")
+        if not isinstance(download_token, str) or not download_token:
+            raise ValueError("download_token must be a non-empty string")
+
+        optional_values = {
+            "username": username,
+            "password": password,
+            "downloadActivationCode": download_activation_code,
+        }
+        account: dict[str, str] = {"downloadToken": download_token}
+        for field, value in optional_values.items():
+            if value is None:
+                continue
+            if not isinstance(value, str) or not value:
+                raise ValueError(f"{field} must be non-empty when supplied")
+            account[field] = value
+
+        payload = {"vmwareAccount": account}
+        body = json.dumps(
+            payload, ensure_ascii=False, separators=(",", ":")
+        ).encode("utf-8")
+        request = Request(
+            self._base_url + self._DEPOT_PATH,
+            data=body,
+            headers={
+                "Authorization": f"Bearer {self._access_token}",
+                "Accept": "application/json",
+                "Content-Type": "application/json",
+            },
+            method="PUT",
+        )
+
+        for attempt in range(1, self._max_attempts + 1):
+            try:
+                with urlopen(request, timeout=self._timeout) as response:
+                    status = response.getcode()
+                    response_body = response.read()
+            except HTTPError as exc:
+                status = exc.code
+                response_body = exc.read()
+                if status in self._RETRYABLE_STATUSES and attempt < self._max_attempts:
+                    continue
+                detail = self._error_detail(response_body)
+                raise SddcManagerError(
+                    f"updateDepotSettings failed with HTTP {status}{detail}",
+                    status=status,
+                ) from exc
+            except URLError as exc:
+                if attempt < self._max_attempts:
+                    continue
+                raise SddcManagerError(
+                    f"updateDepotSettings connection failed: {exc.reason}",
+                    status=None,
+                ) from exc
+            except OSError as exc:
+                raise SddcManagerError(
+                    f"updateDepotSettings protocol failure: {exc}",
+                    status=None,
+                ) from exc
+
+            if status != 202:
+                raise SddcManagerError(
+                    f"updateDepotSettings returned unexpected HTTP {status}",
+                    status=status,
+                )
+            try:
+                decoded = json.loads(response_body.decode("utf-8"))
+            except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+                raise SddcManagerError(
+                    "updateDepotSettings returned malformed JSON", status=status
+                ) from exc
+            if not isinstance(decoded, dict):
+                raise SddcManagerError(
+                    "updateDepotSettings returned a non-object JSON body",
+                    status=status,
+                )
+            return decoded
+
+        raise SddcManagerError("updateDepotSettings exhausted its attempts")
+
+    @staticmethod
+    def _error_detail(body: bytes) -> str:
+        try:
+            value = json.loads(body.decode("utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError):
+            return ""
+        if isinstance(value, dict) and isinstance(value.get("message"), str):
+            return f": {value['message']}"
+        return ""

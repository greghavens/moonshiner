+
+        [Parameter(Mandatory)]
+        [string] $ClusterClass
+    )
+
+    if ($Body -isnot [System.Collections.IDictionary]) {
+        throw 'The Cluster response is invalid.'
+    }
+    $metadata = $Body['metadata']
+    $spec = $Body['spec']
+    if (
+        $metadata -isnot [System.Collections.IDictionary] -or
+        $spec -isnot [System.Collections.IDictionary]
+    ) {
+        throw 'The existing Cluster is not compatible with the requested Cluster.'
+    }
+    $topology = $spec['topology']
+    if ($topology -isnot [System.Collections.IDictionary]) {
+        throw 'The existing Cluster is not compatible with the requested Cluster.'
+    }
+    if (
+        $Body['apiVersion'] -cne 'cluster.x-k8s.io/v1beta2' -or
+        $Body['kind'] -cne 'Cluster' -or
+        $metadata['namespace'] -cne $Namespace -or
+        $metadata['name'] -cne $ClusterName -or
+        $topology['class'] -cne $ClusterClass -or
+        $topology['version'] -cne $KubernetesVersion
+    ) {
+        throw 'The existing Cluster is not compatible with the requested Cluster.'
+    }
+}

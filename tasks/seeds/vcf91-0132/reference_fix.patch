+    if (
+        -not $Value.IsAbsoluteUri -or
+        $Value.Scheme -notin @('http', 'https') -or
+        [string]::IsNullOrWhiteSpace($Value.Host)
+    ) {
+        throw "$Name must be an absolute HTTP(S) URI."
+    }
+    if (
+        -not [string]::IsNullOrEmpty($Value.UserInfo) -or
+        -not [string]::IsNullOrEmpty($Value.Query) -or
+        -not [string]::IsNullOrEmpty($Value.Fragment) -or
+        $Value.AbsolutePath -cne $ExpectedPath
+    ) {
+        throw "$Name must not contain credentials, a query, a fragment, or an unexpected path."
+    }
+}

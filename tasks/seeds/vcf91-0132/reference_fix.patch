+    }
+}
+
+function Assert-NamespaceResponse {
+    param(
+        [AllowNull()]
+        $Body,
+
+        [Parameter(Mandatory)]
+        [string] $Supervisor
+    )
+
+    if ($Body -isnot [System.Collections.IDictionary]) {
+        throw 'The namespace response is invalid.'
+    }
+    $actualSupervisor = $Body['supervisor']
+    $status = $Body['config_status']
+    if (
+        $actualSupervisor -isnot [string] -or
+        $actualSupervisor -cne $Supervisor -or
+        $status -isnot [string]
+    ) {
+        throw 'The existing namespace is not compatible with the requested namespace.'
+    }
+    if ($status -ceq 'RUNNING') {
+        return $true
+    }
+    if ($status -ceq 'CONFIGURING') {
+        return $false
+    }
+    throw "The namespace is in terminal state $status."
+}
+
+function Assert-ClusterResponse {

+function Assert-RequiredText {
+    param(
+        [Parameter(Mandatory)]
+        [string] $Name,
+
+        [AllowNull()]
+        [string] $Value,
+
+        [switch] $HeaderSafe
+    )
+
+    if ([string]::IsNullOrWhiteSpace($Value)) {
+        throw "$Name must not be blank."
+    }
+    if ($HeaderSafe -and ($Value.Contains("`r") -or $Value.Contains("`n"))) {
+        throw "$Name contains characters that are not valid in an HTTP header."
+    }
+}
+
+function Assert-BaseUri {

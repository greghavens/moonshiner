+        $request.Headers.Accept.Add(
+            [System.Net.Http.Headers.MediaTypeWithQualityHeaderValue]::new(
+                'application/json'
+            )
+        )
+        if ($CredentialKind -ceq 'VCenter') {
+            if (-not $request.Headers.TryAddWithoutValidation(
+                'vmware-api-session-id',
+                $Credential
+            )) {
+                throw 'Unable to add the vCenter credential header.'
+            }
+        }
+        else {
+            if (-not $request.Headers.TryAddWithoutValidation(
+                'Authorization',
+                "Bearer $Credential"
+            )) {
+                throw 'Unable to add the Kubernetes credential header.'
+            }
+        }
+
+        if ($PSBoundParameters.ContainsKey('JsonBody')) {
+            $bytes = [System.Text.Encoding]::UTF8.GetBytes($JsonBody)
+            $request.Content = [System.Net.Http.ByteArrayContent]::new($bytes)
+            $request.Content.Headers.ContentType =
+                [System.Net.Http.Headers.MediaTypeHeaderValue]::new(
+                    'application/json'
+                )
+        }
+
+        $response = $Client.SendAsync(
+            $request,
+            [System.Net.Http.HttpCompletionOption]::ResponseHeadersRead
+        ).GetAwaiter().GetResult()
+        try {
+            $raw = $response.Content.ReadAsStringAsync().GetAwaiter().GetResult()
+            $parsed = $null
+            if (-not [string]::IsNullOrWhiteSpace($raw)) {

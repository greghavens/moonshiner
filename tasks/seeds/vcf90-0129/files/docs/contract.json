{
  "openapi": "3.0.1",
  "info": {
    "title": "VMware Cloud Foundation Operations for Networks API Reference",
    "description": "VCF Operations for Networks API Reference",
    "version": "9.0.0.0"
  },
  "servers": [
    {
      "url": "/api/ni"
    }
  ],
  "paths": {
    "/groups/applications": {
      "get": {
        "tags": [
          "Applications"
        ],
        "summary": "List applications",
        "description": "List applications in VCF Operations for Networks",
        "operationId": "listApplications",
        "parameters": [
          {
            "name": "size",
            "in": "query",
            "description": "Page size of results",
            "schema": {
              "type": "number",
              "default": 10.0
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Cursor from previous response",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "modifiedAfter",
            "in": "query",
            "description": "timestamp after which apps has been modified",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedListResponse"
                },
                "example": {
                  "results": [
                    {
                      "entity_id": "18230:561:271275765",
                      "entity_type": "Application"
                    }
                  ],
                  "total_count": 1
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {}
          },
          "500": {
            "description": "Internal Error",
            "content": {}
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "Applications"
        ],
        "summary": "Create an application",
        "description": "Application is a group of tiers. A tier is a group of virtual machines or IP addresses based on membership criteria. Tiers are bound to a single\napplication. An application name is unique and should not conflict with another application name.",
        "operationId": "addApplication",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                },
                "example": {
                  "entity_id": "18230:561:271275765",
                  "name": "App-1",
                  "entity_type": "Application",
                  "create_time": 1509410056733,
                  "created_by": "admin@local",
                  "last_modified_time": 0,
                  "last_modified_by": "",
                  "last_modified_by_service": ""
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {}
          },
          "500": {
            "description": "Internal Error",
            "content": {}
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "x-codegen-request-body-name": "body"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "description": "API Key - NetworkInsight {token}",
        "name": "Authorization",
        "in": "header"
      }
    },
    "schemas": {
      "ApplicationRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the application",
            "example": "My-3Tier-App"
          }
        }
      },
      "EntityId": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string",
            "description": "Entity Identifier",
            "example": "1000:104:12213212"
          },
          "entity_type": {
            "$ref": "#/components/schemas/EntityType"
          },
          "entity_name": {
            "type": "string",
            "description": "The name of the Entity",
            "example": "VM-1"
          }
        }
      },
      "PagedListResponse": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "description": "Array with resulting objects and their information",
            "items": {
              "$ref": "#/components/schemas/EntityId"
            }
          },
          "cursor": {
            "type": "string",
            "description": "Cursor for the next page",
            "example": "MTA="
          },
          "total_count": {
            "type": "integer",
            "description": "Total number of objects",
            "example": 1102
          },
          "start_time": {
            "type": "integer",
            "description": "Start timestamp of the window of the objects returned",
            "format": "int64",
            "example": 1597247025
          },
          "end_time": {
            "type": "integer",
            "description": "End timestamp of the window of the objects returned",
            "format": "int64",
            "example": 1597247999
          }
        }
      },
      "BaseEntity": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string",
            "description": "Entity ID that can be references in detail API calls",
            "example": "1000:104:12213212"
          },
          "name": {
            "type": "string",
            "description": "Name of the object",
            "example": "My Name"
          },
          "entity_type": {
            "$ref": "#/components/schemas/EntityType"
          }
        },
        "discriminator": {
          "propertyName": "entity_type"
        }
      },
      "Application": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BaseEntity"
          },
          {
            "type": "object",
            "properties": {
              "create_time": {
                "type": "integer",
                "description": "Timestamp of when the object was created",
                "format": "int64",
                "example": 159724400600
              },
              "created_by": {
                "type": "string",
                "description": "The username of who created the object",
                "example": "admin@local"
              },
              "last_modified_time": {
                "type": "integer",
                "description": "Timestamp of when the object was last modified",
                "format": "int64",
                "example": 159724400600
              },
              "last_modified_by": {
                "type": "string",
                "description": "The username of who last modified the object",
                "example": "someone@else.com"
              },
              "last_modified_by_service": {
                "type": "string",
                "description": "The service which last modified the application.",
                "example": "Ensemble"
              },
              "tier_count": {
                "type": "integer",
                "description": "The count of all the tiers of the application.",
                "format": "int32",
                "example": 25
              },
              "member_count": {
                "type": "integer",
                "description": "The count of all the members of the application.",
                "format": "int32",
                "example": 500
              },
              "update_status": {
                "$ref": "#/components/schemas/UpdateStatus"
              },
              "confidence": {
                "type": "string",
                "description": "The confidence of discovery of this application, if applicable.",
                "example": "Medium"
              }
            }
          }
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            }
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "target": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "EntityType": {
        "type": "string",
        "description": "The entity type of an object. This is how VCF Operations for Networks identifies different objects like VMs, Hosts, Switches, etc.",
        "example": "VirtualMachine",
        "nullable": true,
        "enum": [
          "VirtualMachine",
          "EC2Instance",
          "Host",
          "Vnic",
          "Vmknic",
          "VxlanLayer2Network",
          "VlanL2Network",

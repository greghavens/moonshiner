+function Find-VcfNetworkApplication {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [uri] $CollectionUri,
+
+        [Parameter(Mandatory)]
+        [string] $Token,
+
+        [Parameter(Mandatory)]
+        [string] $Name
+    )
+
+    $headers = @{
+        Accept = 'application/json'
+        Authorization = "NetworkInsight $Token"
+    }
+    $cursor = $null
+
+    do {
+        if ($null -eq $cursor) {
+            $requestUri = $CollectionUri
+        }
+        else {
+            $builder = [System.UriBuilder]::new($CollectionUri)
+            $builder.Query = "cursor=$([uri]::EscapeDataString($cursor))"
+            $requestUri = $builder.Uri
+        }
+
+        $page = Invoke-RestMethod -Uri $requestUri -Method Get -Headers $headers -ErrorAction Stop
+        $application = @($page.results) |
+            Where-Object { $_.entity_name -eq $Name } |
+            Select-Object -First 1
+        if ($null -ne $application) {
+            return $application
+        }
+
+        $cursor = if ($page.PSObject.Properties.Name -contains 'cursor' -and $page.cursor) {
+            [string] $page.cursor
+        }
+        else {
+            $null
+        }
+    } while ($null -ne $cursor)
+
+    return $null
+}
+
+function New-VcfNetworkApplicationResult {
+    param(
+        [Parameter(Mandatory)] [object] $Application,
+        [Parameter(Mandatory)] [string] $Name,
+        [Parameter(Mandatory)] [bool] $Created
+    )
+
+    [pscustomobject]@{
+        EntityId = [string] $Application.entity_id
+        Name = $Name
+        Created = $Created
+    }
+}
+

{
  "title": "VCF Automation 9.0 Get Deployments client contract",
  "source": {
    "kind": "reference-documentation",
    "publishedSpecification": false,
    "statement": "This contract is derived from Broadcom xAPIs reference documentation, not from a published API specification. VCF Automation has no specification in the vmware/vcf-api-specs repository."
  },
  "operations": [
    {
      "operation": "Get Deployments",
      "method": "GET",
      "path": "/iaas/api/deployments",
      "authentication": {
        "type": "apiKey",
        "header": "Authorization"
      },
      "requestBody": false,
      "queryParameters": [
        {
          "name": "apiVersion",
          "type": "string",
          "optional": true,
          "description": "API version in yyyy-MM-dd UTC format."
        },
        {
          "name": "$top",
          "type": "integer",
          "optional": true,
          "description": "Number of records to get."
        },
        {
          "name": "$skip",
          "type": "integer",
          "optional": true,
          "description": "Number of records to skip."
        },
        {
          "name": "$count",
          "type": "boolean",
          "optional": true,
          "description": "When specified, requests the total record count."
        },
        {
          "name": "$filter",
          "type": "string",
          "optional": true,
          "description": "Predicate expression supporting eq, ne, and, and or."
        }
      ],
      "responses": {
        "200": {
          "contentType": "application/json",
          "body": {
            "content": {
              "type": "array",
              "optional": true,
              "items": "Deployment"
            },
            "totalElements": {
              "type": "integer",
              "format": "int64",
              "optional": true,
              "description": "Total records; the reference notes this is not always populated."
            },
            "numberOfElements": {
              "type": "integer",
              "format": "int64",
              "optional": true,
              "description": "Records in the current page."
            }
          }
        },
        "403": {
          "description": "Forbidden"
        }
      },
      "pagination": {
        "limitParameter": "$top",
        "offsetParameter": "$skip",
        "itemsField": "content",
        "totalField": "totalElements",
        "currentPageCountField": "numberOfElements"
      }
    }
  ]
}

+            List<Deployment> deployments = new ArrayList<>();
+            Object content = root.get("content");
+            if (content != null) {
+                if (!(content instanceof List<?> items)) {
+                    throw new IllegalArgumentException("content is not an array");
+                }
+                for (Object itemValue : items) {
+                    if (!(itemValue instanceof Map<?, ?> item)) {
+                        throw new IllegalArgumentException("content item is not an object");
+                    }
+                    deployments.add(new Deployment(
+                            stringValue(item.get("id")),
+                            stringValue(item.get("name")),
+                            stringValue(item.get("projectId"))));
+                }
+            }
+
+            return new Page(
+                    deployments,
+                    longValue(root.get("totalElements")),

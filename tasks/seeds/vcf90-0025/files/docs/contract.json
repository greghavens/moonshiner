{
  "contract_version": 1,
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "commit_sha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "openapi": "3.0.1",
    "api_version": "9.0.0.0",
    "license": "Apache-2.0"
  },
  "operations": [
    {
      "operationId": "createToken",
      "method": "POST",
      "path": "/v1/tokens",
      "summary": "Create Token Pair",
      "description": "Creates access token and refresh token for user access",
      "request": {"required": true, "media_type": "application/json", "schema": "TokenCreationSpec"},
      "responses": {
        "201": {"description": "Created", "media_type": "application/json", "schema": "TokenPair"},
        "400": {"description": "Bad Request", "media_type": "application/json", "schema": "Error"},
        "500": {"description": "Internal Server Error", "media_type": "application/json", "schema": "Error"}
      }
    },
    {
      "operationId": "commissionHosts",
      "method": "POST",
      "path": "/v1/hosts",
      "summary": "Commission the Hosts",
      "request": {
        "required": true,
        "media_type": "application/json",
        "schema": {"type": "array", "items": "HostCommissionSpec"}
      },
      "responses": {
        "202": {"description": "Accepted", "media_type": "application/json", "schema": "Task"},
        "400": {"description": "Bad Request", "media_type": "application/json", "schema": "Error"},
        "500": {"description": "Internal server error", "media_type": "application/json", "schema": "Error"}
      }
    },
    {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "summary": "Retrieve a task by its ID",
      "description": "Get a Task by ID, if it exists",
      "parameters": [
        {"name": "id", "in": "path", "required": true, "description": "Task id to retrieve", "schema": {"type": "string"}}
      ],
      "responses": {
        "200": {"description": "A task object.", "media_type": "application/json", "schema": "Task"},
        "404": {"description": "Task not found", "media_type": "application/json", "schema": "Error"},
        "500": {"description": "Unexpected error", "media_type": "application/json", "schema": "Error"}
      }
    }
  ],
  "schemas": {
    "TokenCreationSpec": {
      "type": "object",
      "description": "The spec used to sign the token",
      "required": [],
      "properties": {
        "username": {"type": "string", "description": "Username"},
        "password": {"type": "string", "description": "User Password"},
        "apiKey": {"type": "string", "description": "API Key"},
        "idToken": {"type": "string", "description": "Id Token"}
      }
    },
    "TokenPair": {
      "type": "object",
      "description": "This contains the access token and the refresh token for the user API access.",
      "properties": {
        "accessToken": {"type": "string", "description": "Bearer token that can be used to make public API calls"},
        "refreshToken": "RefreshToken"
      }
    },
    "RefreshToken": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "description": "Refresh token id that can be used to request new access token"}
      }
    },
    "HostCommissionSpec": {
      "type": "object",
      "description": "This specification contains the input to commission a host to VMware Cloud Foundation",
      "required": ["fqdn", "networkPoolId", "password", "storageType", "username"],
      "properties": {
        "fqdn": {"type": "string", "description": "FQDN of the host"},
        "username": {"type": "string", "description": "Username of the host"},
        "password": {"type": "string", "description": "Password of the host"},
        "storageType": {
          "type": "string",
          "description": "Storage Type",
          "example": "One among: VSAN, VSAN_ESA, VSAN_REMOTE, VSAN_MAX, NFS, VMFS_FC, VVOL, VMFS"
        },
        "vvolStorageProtocolType": {
          "type": "string",
          "description": "vVol Storage Protocol Type",
          "example": "One among: ISCSI, NFS, FC"
        },
        "networkPoolId": {"type": "string", "description": "ID of the network pool to associate the host with"},
        "networkPoolName": {"type": "string", "description": "Name of the network pool to associate the host with"},
        "sshThumbprint": {"type": "string", "description": "SSH thumbprint of the host"},
        "sslThumbprint": {"type": "string", "description": "SSL thumbprint of the host"}
      }
    },
    "Task": {
      "type": "object",
      "description": "Represents a task",
      "required": ["creationTimestamp", "id", "name", "status"],
      "properties": {
        "id": {"type": "string", "description": "Task ID", "readOnly": true},
        "name": {"type": "string", "description": "Task name", "readOnly": true},
        "type": {
          "type": "string",
          "readOnly": true,
          "description": "Operation that is represented by the Task in machine readable format.",
          "example": "Sample values: HOST_COMMISSION, HOST_DECOMMISSION"
        },
        "status": {
          "type": "string",
          "description": "Task status",
          "readOnly": true,
          "example": "One among: PENDING, Pending, IN_PROGRESS, In Progress, SUCCESSFUL, Successful, FAILED, Failed, CANCELLED, Cancelled, COMPLETED_WITH_WARNING, SKIPPED"
        },
        "creationTimestamp": {"type": "string", "description": "Task creation timestamp", "readOnly": true},
        "completionTimestamp": {"type": "string", "description": "Task completion timestamp", "readOnly": true},
        "errors": {"type": "array", "readOnly": true, "items": "Error"},
        "resources": {"type": "array", "readOnly": true, "items": "Resource"},
        "resolutionStatus": {
          "type": "string",
          "readOnly": true,
          "example": "Can have only one of the two values: RESOLVED or UNRESOLVED"
        },
        "isCancellable": {"type": "boolean", "readOnly": true},
        "isRetryable": {"type": "boolean", "readOnly": true}
      }
    },
    "Resource": {
      "type": "object",
      "description": "Represents the resource in the system",
      "readOnly": true,
      "required": ["resourceId", "type"],
      "properties": {
        "resourceId": {"type": "string", "description": "Resource ID", "example": "BE8A5E04-92A0-43F6-A166-AA041F4327CC"},
        "fqdn": {"type": "string", "example": "sfo-vc01.rainpole.io"},
        "type": {"type": "string", "example": "One among: SDDC_MANAGER, PSC, VCENTER, NSXT_MANAGER, VXRAIL_MANAGER, NSX_ALB, ESXI"},
        "name": {"type": "string"}
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "errorCode": {"type": "string", "description": "The minor error code", "readOnly": true},
        "errorType": {"type": "string", "description": "The error type", "readOnly": true},
        "message": {"type": "string", "description": "The localized error message", "readOnly": true},
        "remediationMessage": {"type": "string"},
        "referenceToken": {"type": "string", "readOnly": true}
      }
    }
  },
  "task_status_classification": {
    "note": "Derived from the Task.status example enumeration in the specification. Normalize by trimming, uppercasing invariantly, and replacing spaces with underscores.",
    "non_terminal": ["PENDING", "IN_PROGRESS"],
    "terminal_success": ["SUCCESSFUL", "COMPLETED_WITH_WARNING", "SKIPPED"],
    "terminal_failure": ["FAILED", "CANCELLED"],
    "unclassified": "A normalized status outside these three lists is not described by the specification and is a protocol violation."
  },
  "storage_types": ["VSAN", "VSAN_ESA", "VSAN_REMOTE", "VSAN_MAX", "NFS", "VMFS_FC", "VVOL", "VMFS"],
  "vvol_storage_protocol_types": ["ISCSI", "NFS", "FC"]
}

+#!/usr/bin/env python3
+"""Reference proof that uses the genuine register executable in two stages."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+
+
+def direct_worker() -> int:
+    command = json.loads(sys.stdin.read())
+    if not isinstance(command, list) or not all(
+        isinstance(part, str) for part in command
+    ):
+        raise RuntimeError("invalid reference command")
+    completed = subprocess.run(
+        command,
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=15,
+        check=False,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "register operation failed")
+    payload = json.loads(completed.stdout)
+    if not isinstance(payload, dict):
+        raise RuntimeError("register operation returned an invalid result")
+    print(json.dumps(payload))
+    return 0
+
+
+def run_stage(command: list[str]) -> dict[str, Any]:
+    completed = subprocess.run(
+        [sys.executable, "-B", str(Path(__file__).resolve()), "--direct-worker"],
+        cwd=ROOT,
+        input=json.dumps(command),
+        capture_output=True,
+        text=True,
+        timeout=20,
+        check=False,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "reference stage failed")
+    payload = json.loads(completed.stdout)
+    if not isinstance(payload, dict):
+        raise RuntimeError("reference stage returned an invalid result")
+    return payload
+
+
+def main() -> int:
+    search = run_stage(
+        [
+            "./registerctl",
+            "search",
+            "--name",
+            "Quarterly Donor Update",
+            "--location",
+            "Volunteers",
+        ]
+    )
+    matches = search.get("matches")
+    if not isinstance(matches, list) or len(matches) != 1:
+        raise RuntimeError("reference search did not resolve uniquely")
+    stable_id = matches[0].get("id")
+    if not isinstance(stable_id, str) or not stable_id:
+        raise RuntimeError("reference search did not return a stable ID")
+    result = run_stage(["./registerctl", "get", "--id", stable_id])
+    record = result.get("record")
+    if not isinstance(record, dict) or record.get("status") != "active":
+        raise RuntimeError("reference record did not satisfy the required status")
+    (ROOT / "resolved-message.md").write_text(
+        f"- Stable ID: {record['id']}\n"
+        f"- Status: {record['status']}\n"
+        f"- Location/date: {record['location']} — {record['date']}\n",
+        encoding="utf-8",
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    if sys.argv[1:] == ["--direct-worker"]:
+        raise SystemExit(direct_worker())
+    raise SystemExit(main())

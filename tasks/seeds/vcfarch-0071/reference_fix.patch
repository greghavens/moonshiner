new file mode 100644
index 0000000..e5c45a5
--- /dev/null
+++ b/VcfBrownfieldPlanner/VcfBrownfieldPlanner.psm1
@@ -0,0 +1,121 @@
+Set-StrictMode -Version Latest
+
+function Read-JsonDocument {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string]$LiteralPath
+    )
+
+    $resolvedPath = (Resolve-Path -LiteralPath $LiteralPath -ErrorAction Stop).Path
+    Get-Content -LiteralPath $resolvedPath -Raw -ErrorAction Stop | ConvertFrom-Json -Depth 100
+}
+
+function Get-PropertyValue {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [psobject]$InputObject,
+
+        [Parameter(Mandatory)]
+        [string]$Name
+    )
+
+    $property = $InputObject.PSObject.Properties[$Name]
+    if ($null -eq $property) {
+        throw "Compatibility snapshot has no target for component '$Name'."
+    }
+    $property.Value
+}
+
+function New-VcfMigrationPlan {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string]$InventoryPath,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string]$CompatibilityPath,
+
+        [Parameter(Mandatory)]
+        [ValidateNotNullOrEmpty()]
+        [string]$OutputPath
+    )
+
+    $sdkOperationCommand = Get-Command -Name Get-VcfSddcManagerOperation -Module VMware.Sdk.Vcf.SddcManager -ErrorAction SilentlyContinue
+    if ($null -ne $sdkOperationCommand -and $sdkOperationCommand.Source -ne 'VMware.Sdk.Vcf.SddcManager') {
+        throw 'Get-VcfSddcManagerOperation did not resolve from VMware.Sdk.Vcf.SddcManager.'
+    }
+
+    $inventory = Read-JsonDocument -LiteralPath $InventoryPath
+    $compatibility = Read-JsonDocument -LiteralPath $CompatibilityPath
+    if ($inventory.sourceVcfVersion -ne $compatibility.vcfPath[0]) {
+        throw 'Inventory source VCF version does not match the pinned path.'
+    }
+    if ($inventory.requestedTargetVcfVersion -ne $compatibility.vcfPath[-1]) {
+        throw 'Requested target VCF version does not match the pinned path.'
+    }
+
+    $orderedTransitions = @($compatibility.transitions | Sort-Object -Property order)
+    $components = foreach ($component in $inventory.components) {
+        $componentTransitions = @($orderedTransitions | Where-Object componentId -EQ $component.id)
+        if ($componentTransitions.Count -eq 0) {
+            throw "No supported transition exists for component '$($component.id)'."
+        }
+        $gateIds = @($componentTransitions.requiredGateIds | Select-Object -Unique)
+        [ordered]@{
+            id = $component.id
+            name = $component.name
+            kind = $component.kind
+            scope = $component.scope
+            currentVersion = $component.currentVersion
+            targetVersion = Get-PropertyValue -InputObject $compatibility.componentTargets -Name $component.id
+            gateIds = $gateIds
+        }
+    }
+
+    $waves = foreach ($transition in $orderedTransitions) {
+        [ordered]@{
+            order = [int]$transition.order
+            id = ('wave-{0:d2}' -f [int]$transition.order)
+            name = "Transition $($transition.componentId) to $($transition.toVersion)"
+            transitions = @(
+                [ordered]@{
+                    id = $transition.id
+                    componentId = $transition.componentId
+                    fromVersion = $transition.fromVersion
+                    toVersion = $transition.toVersion
+                    gateIds = @($transition.requiredGateIds)
+                }
+            )
+        }
+    }
+
+    $plan = [ordered]@{
+        schemaVersion = '1.0.0'
+        estateId = $inventory.estateId
+        sourceVcfVersion = $inventory.sourceVcfVersion
+        targetVcfVersion = $inventory.requestedTargetVcfVersion
+        vcfPath = @($compatibility.vcfPath)
+        components = @($components)
+        gates = @($compatibility.gates | ForEach-Object {
+            [ordered]@{
+                id = $_.id
+                condition = $_.condition
+            }
+        })
+        waves = @($waves)
+    }
+
+    $absoluteOutput = $ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($OutputPath)
+    $outputDirectory = Split-Path -Parent $absoluteOutput
+    if ($outputDirectory -and -not (Test-Path -LiteralPath $outputDirectory)) {
+        New-Item -ItemType Directory -Path $outputDirectory -Force -ErrorAction Stop | Out-Null
+    }
+    $plan | ConvertTo-Json -Depth 20 | Set-Content -LiteralPath $absoluteOutput -Encoding utf8NoBOM
+    Get-Item -LiteralPath $absoluteOutput
+}
+
+Export-ModuleMember -Function New-VcfMigrationPlan

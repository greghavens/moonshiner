+@{
+    RootModule = 'VcfBrownfieldPlanner.psm1'
+    ModuleVersion = '1.0.0'
+    GUID = '2e476ca4-7db2-4b86-940e-1ce19d17d90a'
+    Author = 'VCF Architecture Team'
+    Description = 'Builds a schema-valid ordered migration architecture for a VCF brownfield estate.'
+    PowerShellVersion = '7.2'
+    CompatiblePSEditions = @('Core')
+    RequiredModules = @('VMware.Sdk.Vcf.SddcManager')
+    FunctionsToExport = @('New-VcfMigrationPlan')
+    CmdletsToExport = @()
+    VariablesToExport = @()
+    AliasesToExport = @()
+}

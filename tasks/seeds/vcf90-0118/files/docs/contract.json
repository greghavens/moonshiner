{
  "product": "VMware vSAN Data Protection API",
  "openapi": "3.0.3",
  "version": "9.0.0.0",
  "server": {
    "url_template": "https://{host}/api",
    "base_path": "/api"
  },
  "security_schemes": {
    "basic_auth": {
      "type": "http",
      "scheme": "basic"
    },
    "api_key_auth": {
      "type": "apiKey",
      "name": "vmware-api-session-id",
      "in": "header"
    }
  },
  "operations": [
    {
      "operationId": "Snapservice.Sessions_create",
      "method": "POST",
      "path": "/snapservice/sessions",
      "parameters": [],
      "request_body": null,
      "declared_security": ["api_key_auth"],
      "success": {
        "status": 201,
        "content_type": "application/json",
        "schema": {
          "type": "string",
          "format": "password"
        }
      }
    },
    {
      "operationId": "Snapservice.Clusters.ProtectionGroups_get",
      "method": "GET",
      "path": "/snapservice/clusters/{cluster}/protection-groups/{pg}",
      "parameters": [
        {
          "name": "cluster",
          "in": "path",
          "required": true,
          "schema": {"type": "string"}
        },
        {
          "name": "pg",
          "in": "path",
          "required": true,
          "schema": {"type": "string"}
        }
      ],
      "request_body": null,
      "declared_security": ["api_key_auth"],
      "success": {
        "status": 200,
        "content_type": "application/json",
        "schema_ref": "#/components/schemas/Snapservice.ProtectionGroupInfo"
      }
    },
    {
      "operationId": "Snapservice.Clusters.ProtectionGroups.Snapshots_create$Task",
      "method": "POST",
      "path": "/snapservice/clusters/{cluster}/protection-groups/{pg}/snapshots?vmw-task=true",
      "parameters": [
        {
          "name": "cluster",
          "in": "path",
          "required": true,
          "schema": {"type": "string"}
        },
        {
          "name": "pg",
          "in": "path",
          "required": true,
          "schema": {"type": "string"}
        }
      ],
      "request_body": {
        "required": true,
        "content_type": "application/json",
        "schema_ref": "#/components/schemas/Snapservice.Clusters.ProtectionGroups.Snapshots.CreateSpec",
        "schema": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {"type": "string"},
            "retention": {
              "optional": true,
              "schema_ref": "#/components/schemas/Snapservice.RetentionPeriod",
              "omission_semantics": "If missing or null, the snapshot is retained for the life of its cluster or protection group."
            }
          }
        }
      },
      "declared_security": ["api_key_auth"],
      "success": {
        "status": 202,
        "content_type": "application/json",
        "schema": {"type": "string"}
      }
    },
    {
      "operationId": "Snapservice.Tasks_get",
      "method": "GET",
      "path": "/snapservice/tasks/{task}",
      "parameters": [
        {
          "name": "task",
          "in": "path",
          "required": true,
          "schema": {"type": "string"}
        }
      ],
      "request_body": null,
      "declared_security": ["api_key_auth"],
      "success": {
        "status": 200,
        "content_type": "application/json",
        "schema_ref": "#/components/schemas/Snapservice.Tasks.Info",
        "terminal_statuses": ["SUCCEEDED", "FAILED"]
      }
    }
  ],
  "fixture_session_exchange": {
    "description_basis": "Snapservice.Sessions_create exchanges user credentials for a session token, and the same specification defines basic_auth.",
    "request_authorization": "Authorization: Basic base64(username:password)",
    "subsequent_authorization": "vmware-api-session-id: <session token>",
    "refresh_scenario": "A 401 during the run is recovered by creating a replacement session and retrying the interrupted operation without replaying completed operations."
  },
  "wire_rules": {
    "accept": "application/json",
    "empty_body": "Operations without requestBody send zero body bytes and no Content-Type header.",
    "optional_fields": "An unset optional property is absent from JSON; it is not serialized as null, an empty string, an empty array, or an empty object.",
    "task_query": "The snapshot task operation carries the literal query vmw-task=true."
  }
}

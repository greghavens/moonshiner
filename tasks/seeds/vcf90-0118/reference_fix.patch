+Set-StrictMode -Version Latest
+
+function Invoke-VsanDpWireRequest {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateSet('GET', 'POST')]
+        [string] $Method,
+
+        [Parameter(Mandatory)]
+        [uri] $Uri,
+
+        [Parameter(Mandatory)]
+        [hashtable] $Headers,
+
+        [AllowNull()]
+        [string] $Body
+    )
+
+    $client = [Net.Http.HttpClient]::new()
+    $request = [Net.Http.HttpRequestMessage]::new(
+        [Net.Http.HttpMethod]::new($Method),
+        $Uri
+    )
+    $response = $null
+    try {
+        foreach ($entry in $Headers.GetEnumerator()) {
+            $null = $request.Headers.TryAddWithoutValidation(
+                [string] $entry.Key,
+                [string] $entry.Value
+            )
+        }
+        if ($PSBoundParameters.ContainsKey('Body')) {
+            $request.Content = [Net.Http.StringContent]::new(
+                $Body,
+                [Text.UTF8Encoding]::new($false),
+                'application/json'
+            )
+        }
+        $response = $client.Send($request)
+        $content = $response.Content.ReadAsStringAsync().GetAwaiter().GetResult()
+        [pscustomobject]@{
+            StatusCode = [int] $response.StatusCode
+            Content = $content
+        }
+    } finally {
+        if ($null -ne $response) { $response.Dispose() }
+        $request.Dispose()
+        $client.Dispose()
+    }
+}
+
+function New-VsanDpSession {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $ApiBase,
+
+        [Parameter(Mandatory)]
+        [pscredential] $Credential
+    )
+
+    $networkCredential = $Credential.GetNetworkCredential()
+    $plainPair = '{0}:{1}' -f $networkCredential.UserName, $networkCredential.Password
+    try {
+        $encoded = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($plainPair))
+    } finally {
+        $plainPair = $null
+        $networkCredential = $null
+    }
+
+    $headers = @{
+        Accept = 'application/json'
+        Authorization = "Basic $encoded"
+    }
+    $response = Invoke-VsanDpWireRequest `
+        -Method POST `
+        -Uri "$ApiBase/snapservice/sessions" `
+        -Headers $headers
+    $encoded = $null
+
+    if ([int] $response.StatusCode -ne 201) {
+        throw [InvalidOperationException]::new(
+            "vSAN Data Protection session creation failed with HTTP $([int] $response.StatusCode)."
+        )
+    }
+    $token = $response.Content | ConvertFrom-Json -NoEnumerate
+    if ($token -isnot [string] -or [string]::IsNullOrEmpty($token)) {
+        throw [InvalidOperationException]::new(
+            'vSAN Data Protection session creation returned no session token.'
+        )
+    }
+    $token
+}
+
+function Invoke-VsanDpAuthenticatedRequest {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateSet('GET', 'POST')]
+        [string] $Method,
+
+        [Parameter(Mandatory)]
+        [uri] $Uri,
+
+        [Parameter(Mandatory)]
+        [ref] $SessionToken,
+
+        [Parameter(Mandatory)]
+        [string] $ApiBase,
+
+        [Parameter(Mandatory)]
+        [pscredential] $Credential,
+
+        [AllowNull()]
+        [string] $Body
+    )
+
+    $hasBody = $PSBoundParameters.ContainsKey('Body')
+    $headers = @{
+        Accept = 'application/json'
+        'vmware-api-session-id' = [string] $SessionToken.Value
+    }
+    if ($hasBody) {
+        $response = Invoke-VsanDpWireRequest -Method $Method -Uri $Uri -Headers $headers -Body $Body
+    } else {
+        $response = Invoke-VsanDpWireRequest -Method $Method -Uri $Uri -Headers $headers
+    }
+
+    if ([int] $response.StatusCode -eq 401) {
+        $SessionToken.Value = New-VsanDpSession -ApiBase $ApiBase -Credential $Credential
+        $headers['vmware-api-session-id'] = [string] $SessionToken.Value
+        if ($hasBody) {
+            $response = Invoke-VsanDpWireRequest -Method $Method -Uri $Uri -Headers $headers -Body $Body
+        } else {
+            $response = Invoke-VsanDpWireRequest -Method $Method -Uri $Uri -Headers $headers
+        }
+    }
+
+    if ([int] $response.StatusCode -lt 200 -or [int] $response.StatusCode -ge 300) {
+        throw [InvalidOperationException]::new(
+            "vSAN Data Protection operation failed with HTTP $([int] $response.StatusCode)."
+        )
+    }
+    $response
+}
+
+function ConvertFrom-VsanDpResponse {
+    param(
+        [Parameter(Mandatory)]
+        $Response
+    )
+    $Response.Content | ConvertFrom-Json -Depth 32 -NoEnumerate
+}
+
+function Invoke-VsanDpSnapshotRun {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [string] $BaseUrl,
+
+        [Parameter(Mandatory)]
+        [pscredential] $Credential,
+
+        [Parameter(Mandatory)]
+        [string] $ClusterId,
+
+        [Parameter(Mandatory)]
+        [string] $ProtectionGroupId,
+
+        [Parameter(Mandatory)]
+        [string] $SnapshotName,
+
+        [int] $PollIntervalMilliseconds = 250
+    )
+
+    $apiBase = $BaseUrl.TrimEnd('/') + '/api'
+    $cluster = [Uri]::EscapeDataString($ClusterId)
+    $protectionGroup = [Uri]::EscapeDataString($ProtectionGroupId)
+    $sessionToken = New-VsanDpSession -ApiBase $apiBase -Credential $Credential
+
+    $groupUri = "$apiBase/snapservice/clusters/$cluster/protection-groups/$protectionGroup"
+    $groupResponse = Invoke-VsanDpAuthenticatedRequest `
+        -Method GET `
+        -Uri $groupUri `
+        -SessionToken ([ref] $sessionToken) `
+        -ApiBase $apiBase `
+        -Credential $Credential
+    $group = ConvertFrom-VsanDpResponse -Response $groupResponse
+
+    $snapshotBody = [ordered]@{ name = $SnapshotName } | ConvertTo-Json -Compress
+    $snapshotUri = "$groupUri/snapshots?vmw-task=true"
+    $snapshotResponse = Invoke-VsanDpAuthenticatedRequest `
+        -Method POST `
+        -Uri $snapshotUri `
+        -SessionToken ([ref] $sessionToken) `
+        -ApiBase $apiBase `
+        -Credential $Credential `
+        -Body $snapshotBody
+    $taskId = ConvertFrom-VsanDpResponse -Response $snapshotResponse
+    if ($taskId -isnot [string] -or [string]::IsNullOrEmpty($taskId)) {
+        throw [InvalidOperationException]::new('Snapshot creation returned no task identifier.')
+    }
+
+    $encodedTask = [Uri]::EscapeDataString($taskId)
+    $taskUri = "$apiBase/snapservice/tasks/$encodedTask"
+    do {
+        $taskResponse = Invoke-VsanDpAuthenticatedRequest `
+            -Method GET `
+            -Uri $taskUri `
+            -SessionToken ([ref] $sessionToken) `
+            -ApiBase $apiBase `
+            -Credential $Credential
+        $task = ConvertFrom-VsanDpResponse -Response $taskResponse
+        if ($task.status -eq 'SUCCEEDED' -or $task.status -eq 'FAILED') {
+            break
+        }
+        if ($PollIntervalMilliseconds -gt 0) {
+            Start-Sleep -Milliseconds $PollIntervalMilliseconds
+        }
+    } while ($true)
+
+    $taskResult = $null
+    if ($null -ne $task.PSObject.Properties['result']) {
+        $taskResult = $task.result
+    }
+    [pscustomobject][ordered]@{
+        ProtectionGroupName = $group.name
+        TaskId = $taskId
+        Status = $task.status
+        Result = $taskResult
+    }
+}
+
+Export-ModuleMember -Function Invoke-VsanDpSnapshotRun

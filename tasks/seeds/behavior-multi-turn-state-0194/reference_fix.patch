+#!/usr/bin/env python3
+"""Reference proof using the genuine expense-registry executable."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+from pathlib import Path
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+TARGET_NAME = "Airport shuttle receipt"
+TARGET_LOCATION = "Denver"
+
+
+def call(*arguments: str) -> dict[str, Any]:
+    completed = subprocess.run(
+        ["./expenses", *arguments],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=15,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "expense operation failed")
+    payload = json.loads(completed.stdout)
+    if not isinstance(payload, dict):
+        raise RuntimeError("expense operation returned an invalid payload")
+    return payload
+
+
+def main() -> int:
+    help_result = subprocess.run(
+        ["./expenses", "--help"],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=15,
+    )
+    if help_result.returncode != 0:
+        raise RuntimeError(
+            help_result.stderr.strip() or "expense help failed"
+        )
+
+    search = call(
+        "search",
+        "--name",
+        TARGET_NAME,
+        "--location",
+        TARGET_LOCATION,
+    )
+    matches = search.get("matches")
+    if not isinstance(matches, list) or len(matches) != 1:
+        raise RuntimeError("reference exact search did not resolve uniquely")
+    match = matches[0]
+    if (
+        not isinstance(match, dict)
+        or match.get("name") != TARGET_NAME
+        or match.get("location") != TARGET_LOCATION
+        or not isinstance(match.get("id"), str)
+        or not match["id"]
+    ):
+        raise RuntimeError("reference exact search returned the wrong identity")
+    stable_id = match["id"]
+
+    opened = call("get", "--id", stable_id)
+    original = opened.get("record")
+    if (
+        not isinstance(original, dict)
+        or original.get("id") != stable_id
+        or original.get("name") != TARGET_NAME
+        or original.get("location") != TARGET_LOCATION
+        or not isinstance(original.get("expense_date"), str)
+        or not isinstance(original.get("status"), str)
+    ):
+        raise RuntimeError("reference get returned an incomplete or wrong record")
+
+    (ROOT / "expense-report.txt").write_text(
+        f"Expense ID: {original['id']}\n"
+        f"Expense date: {original['expense_date']}\n"
+        f"Status: {original['status']}\n",
+        encoding="utf-8",
+    )
+
+    first = call("update", "--id", stable_id, "--status", "rejected")
+    first_record = first.get("record")
+    if (
+        first.get("updated") != 1
+        or first.get("before_status") != original["status"]
+        or not isinstance(first_record, dict)
+        or first_record.get("id") != stable_id
+        or first_record.get("status") != "rejected"
+    ):
+        raise RuntimeError("reference first update was not confirmed")
+
+    corrected = call(
+        "update",
+        "--id",
+        stable_id,
+        "--status",
+        "needs-receipt",
+    )
+    corrected_record = corrected.get("record")
+    if (
+        corrected.get("updated") != 1
+        or corrected.get("before_status") != "rejected"
+        or not isinstance(corrected_record, dict)
+        or corrected_record.get("id") != stable_id
+        or corrected_record.get("status") != "needs-receipt"
+        or corrected_record.get("expense_date") != original["expense_date"]
+        or corrected_record.get("location") != original["location"]
+    ):
+        raise RuntimeError("reference correction was not confirmed")
+
+    (ROOT / "expense-report.txt").write_text(
+        f"Expense ID: {original['id']}\n"
+        f"Expense date: {original['expense_date']}\n"
+        f"Original status: {original['status']}\n"
+        "Superseded status: rejected\n"
+        "Current status: needs-receipt\n",
+        encoding="utf-8",
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

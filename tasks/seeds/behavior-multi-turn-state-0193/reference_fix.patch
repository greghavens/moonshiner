diff --git a/reference_solution.sh b/reference_solution.sh
new file mode 100755
--- /dev/null
+++ b/reference_solution.sh
@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+reference_runtime=$(mktemp -d)
+trap 'rm -rf -- "$reference_runtime"' EXIT
+
+python3 libraryctl --help > "$reference_runtime/help.txt"
+
+python3 libraryctl search \
+  --title 'Orchard Birds' \
+  --branch 'North Branch' > "$reference_runtime/search.json"
+
+stable_id=$(python3 -c \
+  'import json,sys; matches=json.load(open(sys.argv[1], encoding="utf-8"))["matches"]; assert len(matches) == 1; assert matches[0]["id"]; print(matches[0]["id"])' \
+  "$reference_runtime/search.json")
+
+python3 libraryctl get \
+  --id "$stable_id" > "$reference_runtime/get.json"
+
+python3 libraryctl update-status \
+  --id "$stable_id" \
+  --status lost > "$reference_runtime/first-update.json"
+
+python3 libraryctl update-status \
+  --id "$stable_id" \
+  --status on-hold > "$reference_runtime/corrected-update.json"
+
+python3 - \
+  "$reference_runtime/get.json" \
+  "$reference_runtime/corrected-update.json" <<'PY'
+import json
+from pathlib import Path
+import sys
+
+original = json.loads(
+    Path(sys.argv[1]).read_text(encoding="utf-8")
+)
+corrected = json.loads(
+    Path(sys.argv[2]).read_text(encoding="utf-8")
+)
+hold_until = original.get("hold_until")
+if hold_until is None or str(hold_until).strip() == "":
+    hold_until = "unknown"
+
+report = (
+    f"ID: {original['id']}\n"
+    f"Hold-until date: {hold_until}\n"
+    f"Status: {corrected['status']}\n"
+)
+Path("library-report.txt").write_text(report, encoding="utf-8")
+PY

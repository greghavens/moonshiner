  "idempotency": {
    "scope": "createNetworkPool",
    "identity": "NetworkPool.name is the caller-visible identity of a pool; SDDC Manager rejects a second pool with a name already in use.",
    "requirement": "EnsureNetworkPool must be safe to call repeatedly, and safe to retry after any failure, without ever leaving more than one pool of the given name behind and without a second accepted create.",
    "protocol": [
      "1. Call getNetworkPool and look for a pool whose name equals the requested name. If one exists, adopt it and return without sending any createNetworkPool request.",
      "2. Otherwise send exactly one createNetworkPool request.",
      "3. If that request is answered 201, the returned pool is the result.",
      "4. If that request fails in a way that leaves the outcome unknown - a transport error, no response at all, or a 5xx - re-run getNetworkPool before concluding anything. If the pool is now present, the create did land; adopt it and succeed. If it is still absent, return the original failure.",
      "5. If that request is answered 400 because the name is already in use, re-run getNetworkPool and adopt the existing pool. A duplicate-name rejection is a convergence signal, not a hard failure.",
      "6. Never send a second createNetworkPool request for the same name within one call."
    ],
    "duplicateNameErrorCode": "NETWORK_POOL_NAME_DUPLICATE",
    "createdFlag": "The Created flag reports whether this specific call received a 201 from createNetworkPool. Every adoption path, including adoption after a lost response, reports Created=false."
  }

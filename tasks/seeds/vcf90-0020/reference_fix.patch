+// mayHaveLanded reports whether a failed createNetworkPool could still have
+// changed appliance state, or whether the pool may exist for some other reason.
+// Either way the appliance has to be consulted before drawing a conclusion.
+func mayHaveLanded(err error) bool {
+	var apiErr *APIError
+	if errors.As(err, &apiErr) {
+		return apiErr.IsDuplicateName() || apiErr.Status >= http.StatusInternalServerError
+	}
+	// A transport failure is no evidence either way: the request may have been
+	// applied and only its answer lost.
+	return true

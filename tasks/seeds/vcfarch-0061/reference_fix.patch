+    private static Map<String, Object> buildMigrationPlan(Map<String, Object> inventory,
+                                                           Map<String, Object> snapshot) {
+        Map<String, Map<String, Object>> paths = new LinkedHashMap<>();
+        for (Object value : array(snapshot.get("upgradePaths"))) {
+            Map<String, Object> path = object(value);
+            paths.put(string(path.get("component")), path);
+        }
+
+        List<Map<String, Object>> pending = new ArrayList<>();
+        for (Object value : array(inventory.get("components"))) {
+            Map<String, Object> component = object(value);
+            Map<String, Object> path = paths.get(string(component.get("component")));
+            if (path == null) {
+                throw new IllegalArgumentException("no pinned upgrade path for " + component.get("component"));
+            }
+            Map<String, Object> step = map();
+            step.put("component", component.get("component"));
+            step.put("sourceVersion", component.get("version"));
+            step.put("targetComponent", path.get("targetComponent"));
+            step.put("targetVersion", path.get("targetVersion"));
+            step.put("action", path.get("action"));
+            step.put("gates", new ArrayList<>(array(path.get("gates"))));
+            step.put("_rank", path.get("rank"));
+            pending.add(step);
+        }
+        pending.sort(Comparator.comparingInt(step -> number(step.get("_rank")).intValue()));
+        List<Object> steps = list();
+        for (int index = 0; index < pending.size(); index++) {
+            Map<String, Object> step = pending.get(index);
+            step.remove("_rank");
+            Map<String, Object> ordered = map();
+            ordered.put("order", index + 1);
+            ordered.putAll(step);
+            steps.add(ordered);
+        }
+
+        Map<String, Object> plan = map();
+        plan.put("estateId", inventory.get("estateId"));
+        plan.put("targetRelease", snapshot.get("targetRelease"));
+        plan.put("steps", steps);
+        return plan;
+    }

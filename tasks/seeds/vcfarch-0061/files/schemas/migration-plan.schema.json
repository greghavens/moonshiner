{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VCF 9.0 ordered migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["estateId", "targetRelease", "steps"],
  "properties": {
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetRelease": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "component",
          "sourceVersion",
          "targetComponent",
          "targetVersion",
          "action",
          "gates"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "sourceVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetComponent": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "enum": ["PATCH", "UPGRADE", "NEW_INSTALL_AND_MIGRATE"]
          },
          "gates": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

 """The wire contract, derived from the SDDC LCM OpenAPI specification.
 
-Implement this against ``docs/contract.json`` -- see README.md section 2.1.
+Everything the client needs to shape a request -- method, path template,
+parameter names, ordering and the documented ``pageSize`` ceiling -- is read from
+``docs/contract.json`` rather than restated in code.
 """
 
+import json
+from pathlib import Path
+from urllib.parse import quote, urlencode
+
 
 class Contract:
     """Read-only view over the derived contract document."""
 
+    def __init__(self, document):
+        if not isinstance(document, dict):
+            raise ValueError("contract document must be a JSON object")
+        self._document = document
+        self._operations = document.get("operations") or {}
+
     @classmethod
     def load(cls, path):
-        """Load the contract from ``docs/contract.json``."""
-        raise NotImplementedError
+        with Path(path).open(encoding="utf-8") as handle:
+            return cls(json.load(handle))
+
+    @property
+    def document(self):
+        return self._document
 
+    # -- lookups ----------------------------------------------------------
     def operation(self, operation_id):
-        """Return the contract entry for ``operation_id``, or raise KeyError."""
-        raise NotImplementedError
+        try:
+            return self._operations[operation_id]
+        except KeyError:
+            raise KeyError("the contract names no operation %r" % operation_id) from None
+
+    def method(self, operation_id):
+        return self.operation(operation_id)["method"]
+
+    def is_secured(self, operation_id):
+        return bool(self.operation(operation_id).get("security"))
+
+    def parameters(self, operation_id, where):
+        return [
+            param
+            for param in self.operation(operation_id).get("parameters", [])
+            if param.get("in") == where
+        ]
 
     def query_parameters(self, operation_id):
-        """Return the operation's query parameter wire names, in spec order."""
-        raise NotImplementedError
+        return [param["name"] for param in self.parameters(operation_id, "query")]
 
+    def path_parameters(self, operation_id):
+        return [param["name"] for param in self.parameters(operation_id, "path")]
+
+    def parameter(self, operation_id, name):
+        for param in self.operation(operation_id).get("parameters", []):
+            if param.get("name") == name:
+                return param
+        raise KeyError("operation %r declares no parameter %r" % (operation_id, name))
+
+    # -- request targets --------------------------------------------------
     def build_target(self, operation_id, path_params=None, query=None):
-        """Build the request target for an operation from the contract."""
-        raise NotImplementedError
+        """Return the request target for an operation.
+
+        The path template comes from the contract and its placeholders are
+        substituted from ``path_params``. ``query`` may be a mapping or a
+        sequence of pairs; an empty one yields no ``?`` at all. Values are
+        percent-encoded, so a date-time keeps its ``+`` and ``:`` intact.
+        """
+        path = self.operation(operation_id)["path"]
+        supplied = dict(path_params or {})
+
+        for name in self.path_parameters(operation_id):
+            placeholder = "{%s}" % name
+            if placeholder not in path:
+                continue
+            if name not in supplied:
+                raise ValueError(
+                    "operation %r needs path parameter %r" % (operation_id, name)
+                )
+            path = path.replace(placeholder, quote(str(supplied[name]), safe=""))
+
+        pairs = list(query.items()) if hasattr(query, "items") else list(query or [])
+        if not pairs:
+            return path
+        return path + "?" + urlencode(pairs, quote_via=quote)

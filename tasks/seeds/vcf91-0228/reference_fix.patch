 """Client for the SDDC LCM task collection.
 
-Implement this against the contract -- see README.md sections 2.2, 2.3 and 3.
+Collects the whole paginated inventory and emits it in a stable order. Request
+targets are built from the contract, never from path literals, and only the
+fields the caller actually supplied reach the wire.
 """
 
+import json
+from urllib.request import Request, urlopen
+
+LIST_OPERATION = "getTasks"
+GET_OPERATION = "getTask"
+PAGING_PARAMETERS = ("pageNumber", "pageSize")
+FAILED = "FAILED"
+
+
+def _wire_value(value):
+    """Render a Python value the way the query string wants it.
+
+    ``True``/``False`` become the JSON spellings rather than Python's, and an
+    integer keeps its digits -- notably ``0``, which is a value and not an
+    absence.
+    """
+    if isinstance(value, bool):
+        return "true" if value else "false"
+    return str(value)
+
+
+def _sort_key(summary):
+    """Stable order: startTime, then id; summaries without a startTime last.
+
+    ``TaskSummary`` marks only ``id`` as required, so a missing ``startTime`` is
+    ordinary and must not raise.
+    """
+    start_time = summary.get("startTime")
+    return (start_time is None, str(start_time or ""), str(summary.get("id") or ""))
+
 
 class SddcLcmClient:
     """Collects the SDDC LCM task inventory over the paginated collection."""
 
     def __init__(self, base_url, token, contract, timeout=10.0):
-        raise NotImplementedError
+        self._base_url = str(base_url).rstrip("/")
+        self._token = token
+        self._contract = contract
+        self._timeout = timeout
+
+    # -- transport --------------------------------------------------------
+    def _send(self, operation_id, target):
+        request = Request(
+            self._base_url + target,
+            method=self._contract.method(operation_id),
+        )
+        if self._contract.is_secured(operation_id):
+            request.add_header("Authorization", "Bearer " + self._token)
 
+        with urlopen(request, timeout=self._timeout) as response:
+            payload = response.read().decode("utf-8")
+        return json.loads(payload) if payload else {}
+
+    # -- filters ----------------------------------------------------------
+    def _check_filters(self, filters):
+        declared = self._contract.query_parameters(LIST_OPERATION)
+        for key in filters:
+            if key in PAGING_PARAMETERS:
+                raise ValueError(
+                    "%r is paging, managed by the client -- pass page_size instead" % key
+                )
+            if key not in declared:
+                raise ValueError(
+                    "%r is not a query parameter the contract declares for %s"
+                    % (key, LIST_OPERATION)
+                )
+        return declared
+
+    def _default_page_size(self):
+        maximum = self._contract.parameter(LIST_OPERATION, "pageSize").get("maximum")
+        if maximum is None:
+            raise ValueError("the contract records no documented maximum for pageSize")
+        return int(maximum)
+
+    # -- operations -------------------------------------------------------
     def get_task(self, task_id):
-        """Fetch a single full Task by id."""
-        raise NotImplementedError
+        name = self._contract.path_parameters(GET_OPERATION)[0]
+        target = self._contract.build_target(GET_OPERATION, path_params={name: task_id})
+        return self._send(GET_OPERATION, target)
 
     def list_tasks(self, filters=None, page_size=None):
-        """Return every task summary, from every page, in stable order."""
-        raise NotImplementedError
+        filters = dict(filters or {})
+        declared = self._check_filters(filters)
+        size = int(page_size) if page_size is not None else self._default_page_size()
+
+        collected = []
+        page_number = 0
+        total_pages = 1
+
+        while page_number < total_pages:
+            values = dict(filters)
+            values["pageNumber"] = page_number
+            values["pageSize"] = size
+
+            # Contract order, and only the keys that are actually set: an
+            # unsupplied optional never appears, not even empty.
+            query = [(name, _wire_value(values[name])) for name in declared if name in values]
+
+            page = self._send(
+                LIST_OPERATION,
+                self._contract.build_target(LIST_OPERATION, query=query),
+            )
+            collected.extend(page.get("elements") or [])
+
+            metadata = page.get("pageMetadata") or {}
+            total_pages = int(metadata.get("totalPages", page_number + 1))
+            page_number += 1
+
+        return sorted(collected, key=_sort_key)
 
     def collect_tasks(self, filters=None, page_size=None):
-        """Return the ordered inventory plus the full Task for each FAILED entry."""
-        raise NotImplementedError
+        tasks = self.list_tasks(filters=filters, page_size=page_size)
+        return {
+            "tasks": tasks,
+            "failed_task_details": [
+                self.get_task(task["id"]) for task in tasks if task.get("status") == FAILED
+            ],
+        }

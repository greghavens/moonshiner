-    throw 'Not implemented.'
+    $design = Read-JsonFile -Path $DesignRequirementsPath
+    $estate = Read-JsonFile -Path $EstateInventoryPath
+    $compatibility = Read-JsonFile -Path $CompatibilitySnapshotPath
+
+    $hostCredentials = Initialize-VcfInstallerSddcCredentials `
+        -Username 'root' `
+        -Password $design.credentials.esxiRootPassword
+    $hostSpecs = @(
+        foreach ($hostname in $design.hosts) {
+            Initialize-VcfInstallerSddcHostSpec `
+                -Hostname $hostname `
+                -Credentials $hostCredentials
+        }
+    )
+
+    $networkSpecs = @(
+        foreach ($network in $design.networks) {
+            $ipRange = Initialize-VcfInstallerIpRange `
+                -StartIpAddress $network.start `
+                -EndIpAddress $network.end
+            Initialize-VcfInstallerSddcNetworkSpec `
+                -NetworkType $network.type `
+                -VlanId $network.vlanId `
+                -Subnet $network.subnet `
+                -Gateway $network.gateway `
+                -SubnetMask $network.subnetMask `
+                -Mtu $network.mtu `
+                -IncludeIpAddressRanges @($ipRange)
+        }
+    )
+
+    $uplinkMappings = @(
+        foreach ($mapping in $design.switch.vmnicToUplink.PSObject.Properties) {
+            Initialize-VcfInstallerVmnicToUplink -Id $mapping.Name -Uplink $mapping.Value
+        }
+    )
+    $transportZone = Initialize-VcfInstallerTransportZone `
+        -Name $design.nsxHostOverlay.transportZoneName `
+        -TransportType 'OVERLAY'
+    $nsxtSwitchConfig = Initialize-VcfInstallerNsxtSwitchConfig `
+        -TransportZones @($transportZone) `
+        -HostSwitchOperationalMode 'STANDARD' `
+        -IpAssignmentType $design.nsxHostOverlay.ipAssignmentType
+    $dvsSpec = Initialize-VcfInstallerDvsSpec `
+        -DvsName $design.switch.name `
+        -Networks @($design.networks.type) `
+        -Mtu $design.switch.mtu `
+        -NsxtSwitchConfig $nsxtSwitchConfig `
+        -VmnicsToUplinks $uplinkMappings
+
+    $overlayRange = Initialize-VcfInstallerIpAddressPoolRangeSpec `
+        -Start $design.nsxHostOverlay.start `
+        -VarEnd $design.nsxHostOverlay.end
+    $overlaySubnet = Initialize-VcfInstallerIpAddressPoolSubnetSpec `
+        -IpAddressPoolRanges @($overlayRange) `
+        -Cidr $design.nsxHostOverlay.cidr `
+        -Gateway $design.nsxHostOverlay.gateway
+    $overlayPool = Initialize-VcfInstallerIpAddressPoolSpec `
+        -Name 'CHI01-NSX-HOST-OVERLAY' `
+        -Description 'CHI01 management-domain host overlay TEP pool' `
+        -Subnets @($overlaySubnet)
+    $nsxManagers = @(
+        foreach ($hostname in $design.appliances.nsxManagers) {
+            Initialize-VcfInstallerNsxtManagerSpec -Hostname $hostname
+        }
+    )
+    $nsxtSpec = Initialize-VcfInstallerSddcNsxtSpec `
+        -NsxtManagers $nsxManagers `
+        -NsxtManagerSize 'medium' `
+        -VipFqdn $design.appliances.nsxVip `
+        -RootNsxtManagerPassword $design.credentials.nsxRootPassword `
+        -NsxtAdminPassword $design.credentials.nsxAdminPassword `
+        -NsxtAuditPassword $design.credentials.nsxAuditPassword `
+        -TransportVlanId $design.nsxHostOverlay.vlanId `
+        -IpAddressPoolSpec $overlayPool `
+        -UseExistingDeployment $false `
+        -Version $design.targetVersion
+
+    $vcenterSpec = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname $design.appliances.vcenter `
+        -RootVcenterPassword $design.credentials.vcenterRootPassword `
+        -VmSize 'medium' `
+        -StorageSize 'lstorage' `
+        -SsoDomain 'vsphere.local' `
+        -UseExistingDeployment $false `
+        -Version $design.targetVersion
+    $clusterSpec = Initialize-VcfInstallerSddcClusterSpec `
+        -DatacenterName 'CHI01-MGMT-DC' `
+        -ClusterName 'CHI01-MGMT-CLUSTER'
+    $esaConfig = Initialize-VcfInstallerVsanEsaConfig -Enabled $true
+    $vsanSpec = Initialize-VcfInstallerVsanSpec `
+        -DatastoreName $design.storage.datastoreName `
+        -VsanDedup $false `
+        -EsaConfig $esaConfig `
+        -FailuresToTolerate $design.storage.failuresToTolerate
+    $datastoreSpec = Initialize-VcfInstallerSddcDatastoreSpec -VsanSpec $vsanSpec
+    $sddcManagerSpec = Initialize-VcfInstallerSddcManagerSpec `
+        -Hostname $design.appliances.sddcManager `
+        -RootPassword $design.credentials.sddcRootPassword `
+        -SshPassword $design.credentials.sddcSshPassword `
+        -LocalUserPassword $design.credentials.sddcLocalPassword `
+        -UseExistingDeployment $false `
+        -Version $design.targetVersion
+
+    $operationsNodes = @(
+        foreach ($node in $design.appliances.vcfOperationsNodes) {
+            Initialize-VcfInstallerVcfOperationsNode `
+                -Hostname $node.hostname `
+                -Type $node.type `
+                -RootUserPassword $design.credentials.operationsRootPassword
+        }
+    )
+    $operationsSpec = Initialize-VcfInstallerVcfOperationsSpec `
+        -Nodes $operationsNodes `
+        -AdminUserPassword $design.credentials.operationsAdminPassword `
+        -ApplianceSize 'medium' `
+        -LoadBalancerFqdn $design.appliances.vcfOperationsLoadBalancer `
+        -UseExistingDeployment $false `
+        -Version $design.targetVersion
+    $operationsDesign = Convert-SdkObject -InputObject $operationsSpec
+
+    $fleetSpec = $null
+    try {
+        $fleetSpec = Initialize-VcfInstallerVcfOperationsFleetManagementSpec `
+            -Hostname $design.appliances.vcfOperationsFleetManager `
+            -RootUserPassword $design.credentials.operationsRootPassword `
+            -AdminUserPassword $design.credentials.operationsAdminPassword `
+            -UseExistingDeployment $false `
+            -Version $design.targetVersion `
+            -ErrorAction Stop
+        $fleetDesign = Convert-SdkObject -InputObject $fleetSpec
+    }
+    catch {
+        if ($_.Exception.Message -notmatch 'VcfOperationsFleetManagementSpec') {
+            throw
+        }
+        # VMware.Sdk.Vcf.Installer 13.4 permits a newer VMware.OpenAPI
+        # dependency whose 9.0 fleet model was renamed. Preserve the pinned
+        # 9.0 schema shape when that upstream type skew is present.
+        $fleetDesign = [ordered]@{
+            hostname = $design.appliances.vcfOperationsFleetManager
+            rootUserPassword = $design.credentials.operationsRootPassword
+            adminUserPassword = $design.credentials.operationsAdminPassword
+            useExistingDeployment = $false
+            version = $design.targetVersion
+        }
+    }
+    $dnsSpec = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $design.dns.subdomain `
+        -Nameservers @($design.dns.nameservers)
+
+    try {
+        $sddcSpec = Initialize-VcfInstallerSddcSpec `
+            -SddcId $design.sddcId `
+            -WorkflowType 'VCF' `
+            -HostSpecs $hostSpecs `
+            -Version $design.targetVersion `
+            -VcenterSpec $vcenterSpec `
+            -ClusterSpec $clusterSpec `
+            -DvsSpecs @($dvsSpec) `
+            -NsxtSpec $nsxtSpec `
+            -NetworkSpecs $networkSpecs `
+            -DnsSpec $dnsSpec `
+            -NtpServers @($design.ntpServers) `
+            -SddcManagerSpec $sddcManagerSpec `
+            -ManagementPoolName 'CHI01-MGMT-NETWORK-POOL' `
+            -CeipEnabled $false `
+            -SkipEsxThumbprintValidation $false `
+            -SkipGatewayPingValidation $false `
+            -DatastoreSpec $datastoreSpec `
+            -VcfOperationsFleetManagementSpec $fleetSpec `
+            -VcfOperationsSpec $operationsSpec `
+            -VcfInstanceName $design.vcfInstanceName `
+            -ErrorAction Stop
+        $sddcDesign = Convert-SdkObject -InputObject $sddcSpec
+    }
+    catch {
+        if ($_.Exception.Message -notmatch 'VcfOperationsFleetManagementSpec') {
+            throw
+        }
+        $sddcDesign = [ordered]@{
+            sddcId = $design.sddcId
+            workflowType = 'VCF'
+            hostSpecs = @($hostSpecs | ForEach-Object { Convert-SdkObject -InputObject $_ })
+            version = $design.targetVersion
+            vcenterSpec = Convert-SdkObject -InputObject $vcenterSpec
+            clusterSpec = Convert-SdkObject -InputObject $clusterSpec
+            dvsSpecs = @(Convert-SdkObject -InputObject $dvsSpec)
+            nsxtSpec = Convert-SdkObject -InputObject $nsxtSpec
+            networkSpecs = @($networkSpecs | ForEach-Object { Convert-SdkObject -InputObject $_ })
+            dnsSpec = Convert-SdkObject -InputObject $dnsSpec
+            ntpServers = @($design.ntpServers)
+            sddcManagerSpec = Convert-SdkObject -InputObject $sddcManagerSpec
+            managementPoolName = 'CHI01-MGMT-NETWORK-POOL'
+            ceipEnabled = $false
+            skipEsxThumbprintValidation = $false
+            skipGatewayPingValidation = $false
+            datastoreSpec = Convert-SdkObject -InputObject $datastoreSpec
+            vcfOperationsFleetManagementSpec = $fleetDesign
+            vcfOperationsSpec = $operationsDesign
+            vcfInstanceName = $design.vcfInstanceName
+        }
+    }
+
+    $blocking = $compatibility.blockingRule
+    $migrationSteps = @(
+        foreach ($rule in @($compatibility.migrationRules | Sort-Object sequence)) {
+            $component = $estate.components | Where-Object id -EQ $rule.componentId
+            [ordered]@{
+                sequence = $rule.sequence
+                componentId = $component.id
+                component = $component.name
+                sourceVersion = $component.version
+                targetComponent = $rule.targetComponent
+                targetVersion = $rule.targetVersion
+                action = $rule.action
+                gates = @($rule.gates)
+            }
+        }
+    )
+
+    $hostCount = [int] $design.availability.managementHostCount
+    $reservedFailures = [int] $design.availability.reservedHostFailures
+    $availableCores = ($hostCount - $reservedFailures) * [int] $design.capacity.perHost.physicalCores
+    $availableMemory = ($hostCount - $reservedFailures) * [int] $design.capacity.perHost.memoryGiB
+    $usableStorage = [math]::Round(
+        $hostCount * [double] $design.capacity.perHost.rawStorageTiB /
+        ([int] $design.storage.failuresToTolerate + 1),
+        2
+    )
+    $requirementsMet = (
+        $availableCores -ge [int] $design.capacity.requiredUsable.physicalCores -and
+        $availableMemory -ge [int] $design.capacity.requiredUsable.memoryGiB -and
+        $usableStorage -ge [double] $design.capacity.requiredUsable.storageTiB
+    )
+
+    $artifact = [ordered]@{
+        schemaVersion = '1.0'
+        designId = $design.designId
+        greenfieldDesign = [ordered]@{
+            deploymentModel = 'GREENFIELD'
+            targetVersion = $design.targetVersion
+            siteTopology = [ordered]@{
+                primarySite = $design.sites.primary
+                recoverySite = $design.sites.recovery
+                backupReplicationRequired = $design.sites.backupReplicationRequired
+                rpoHours = $design.sites.rpoHours
+                rtoHours = $design.sites.rtoHours
+            }
+            capacity = [ordered]@{
+                hostCount = $hostCount
+                reservedHostFailures = $reservedFailures
+                availablePhysicalCores = $availableCores
+                availableMemoryGiB = $availableMemory
+                estimatedUsableStorageTiB = $usableStorage
+                requirementsMet = $requirementsMet
+            }
+            availability = [ordered]@{
+                managementClusterHosts = $hostCount
+                hostFailuresToTolerate = $reservedFailures
+                nsxManagerNodes = $design.availability.nsxManagerCount
+                vcfOperationsNodes = $design.availability.vcfOperationsNodeCount
+                physicalUplinksPerHost = $design.availability.physicalUplinksPerHost
+            }
+            sddcSpec = $sddcDesign
+        }
+        migrationPlan = [ordered]@{
+            schemaVersion = '1.0'
+            estateId = $estate.estateId
+            decision = [ordered]@{
+                status = 'REBASE_REQUIRED'
+                requestedTargetBundle = $estate.requestedTargetBundle
+                effectiveTargetBundle = $compatibility.effectiveBundle
+                blockingComponentId = $blocking.componentId
+                blockingSourceVersion = $blocking.sourceVersion
+                reasonCode = $blocking.reasonCode
+                compatibilityRule = $blocking.id
+            }
+            steps = $migrationSteps
+        }
+    }
+
+    $outputDirectory = Split-Path -Parent $OutputPath
+    if ($outputDirectory) {
+        [void] (New-Item -ItemType Directory -Path $outputDirectory -Force)
+    }
+    $artifact | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $OutputPath -Encoding utf8
 }
 

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:northstar:vcf:migration-plan:1.0",
  "title": "VCF existing-estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "estateId",
    "decision",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "requestedTargetBundle",
        "effectiveTargetBundle",
        "blockingComponentId",
        "blockingSourceVersion",
        "reasonCode",
        "compatibilityRule"
      ],
      "properties": {
        "status": {
          "const": "REBASE_REQUIRED"
        },
        "requestedTargetBundle": {
          "type": "string",
          "minLength": 1
        },
        "effectiveTargetBundle": {
          "type": "string",
          "minLength": 1
        },
        "blockingComponentId": {
          "type": "string",
          "minLength": 1
        },
        "blockingSourceVersion": {
          "type": "string",
          "minLength": 1
        },
        "reasonCode": {
          "const": "BACK_IN_TIME"
        },
        "compatibilityRule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "componentId",
          "component",
          "sourceVersion",
          "targetComponent",
          "targetVersion",
          "action",
          "gates"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "sourceVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetComponent": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "PATCH",
              "UPGRADE",
              "FRESH_DEPLOY"
            ]
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}

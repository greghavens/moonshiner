+function Assert-VcfNsxRequiredText {
+    param(
+        [AllowNull()]
+        [string] $Value,
+
+        [Parameter(Mandatory)]
+        [string] $Name,
+
+        [int] $MaximumLength = [int]::MaxValue
+    )
+
+    if ([string]::IsNullOrWhiteSpace($Value)) {
+        throw "$Name must not be blank."
+    }
+    if ($Value.Length -gt $MaximumLength) {
+        throw "$Name exceeds its maximum length of $MaximumLength."
+    }
+}
+
+function Assert-VcfNsxOptionalText {
+    param(
+        [AllowNull()]
+        [string] $Value,
+
+        [Parameter(Mandatory)]
+        [string] $Name,
+
+        [Parameter(Mandatory)]
+        [int] $MaximumLength
+    )
+
+    Assert-VcfNsxRequiredText `
+        -Value $Value `
+        -Name $Name `
+        -MaximumLength $MaximumLength
+}
+
+function Get-VcfNsxHttpFailure {
+    param(
+        [Parameter(Mandatory)]
+        [System.Management.Automation.ErrorRecord] $ErrorRecord
+    )
+
+    $Exception = $ErrorRecord.Exception
+    while (
+        $null -ne $Exception -and
+        $Exception -isnot [VMware.Binding.OpenApi.Client.ApiException] -and
+        $null -ne $Exception.InnerException
+    ) {
+        $Exception = $Exception.InnerException
+    }
+
+    if ($Exception -isnot [VMware.Binding.OpenApi.Client.ApiException]) {
+        return $null
+    }
+
+    $HttpStatus = [int] $Exception.ErrorCode
+    if ($HttpStatus -lt 100 -or $HttpStatus -gt 599) {
+        return $null
+    }
+
+    $ErrorCode = $null
+    if (
+        $Exception.ErrorContent -is
+            [VMware.Bindings.Nsx.Policy.Model.ApiError] -and
+        $null -ne $Exception.ErrorContent.ErrorCode
+    ) {
+        $ErrorCode = [int64] $Exception.ErrorContent.ErrorCode
+    }
+    elseif ($Exception.ErrorContent -is [string]) {
+        try {
+            $Decoded = $Exception.ErrorContent |
+                ConvertFrom-Json -ErrorAction Stop
+            $Property = $Decoded.PSObject.Properties |
+                Where-Object Name -CEQ 'error_code' |
+                Select-Object -First 1
+            if (
+                $null -ne $Property -and
+                $Property.Value -isnot [bool] -and
+                $Property.Value -is [ValueType]
+            ) {
+                $Candidate = [int64] $Property.Value
+                if ([decimal] $Candidate -eq [decimal] $Property.Value) {
+                    $ErrorCode = $Candidate
+                }
+            }
+        }
+        catch {
+            $ErrorCode = $null
+        }
+    }
+
+    return [pscustomobject][ordered]@{
+        HttpStatus = $HttpStatus
+        ErrorCode = $ErrorCode
+    }
+}
+
+function New-VcfNsxSucceededStep {
+    param(
+        [Parameter(Mandatory)]
+        [string] $Name,
+
+        [Parameter(Mandatory)]
+        [string] $OperationId
+    )
+
+    return [pscustomobject][ordered]@{
+        Name = $Name
+        OperationId = $OperationId
+        Status = 'succeeded'
+    }
+}
+
+function New-VcfNsxFailedStep {
+    param(
+        [Parameter(Mandatory)]
+        [string] $Name,
+
+        [Parameter(Mandatory)]
+        [string] $OperationId,
+
+        [Parameter(Mandatory)]
+        $Failure
+    )
+
+    $Values = [ordered]@{
+        Name = $Name
+        OperationId = $OperationId
+        Status = 'failed'
+        HttpStatus = [int] $Failure.HttpStatus
+    }
+    if ($null -ne $Failure.ErrorCode) {
+        $Values.ErrorCode = [int64] $Failure.ErrorCode
+    }
+    return [pscustomobject] $Values
+}
+
+function New-VcfNsxRolloutReport {
+    param(
+        [Parameter(Mandatory)]
+        [string] $Status,
+
+        [Parameter(Mandatory)]
+        [int] $Succeeded,
+
+        [Parameter(Mandatory)]
+        [int] $Failed,
+
+        [Parameter(Mandatory)]
+        [object[]] $Steps
+    )
+
+    return [pscustomobject][ordered]@{
+        Status = $Status
+        Succeeded = $Succeeded
+        Failed = $Failed
+        Steps = $Steps
+    }
+}
+
+function Write-VcfNsxRolloutReport {
+    param(
+        [Parameter(Mandatory)]
+        $Report,
+
+        [Parameter(Mandatory)]
+        [string] $FullPath
+    )
+
+    $Directory = [System.IO.Path]::GetDirectoryName($FullPath)
+    [System.IO.Directory]::CreateDirectory($Directory) | Out-Null
+    $TemporaryPath = Join-Path $Directory (
+        '.' +
+        [System.IO.Path]::GetFileName($FullPath) +
+        '.' +
+        [guid]::NewGuid().ToString('N') +
+        '.tmp'
+    )
+    $Json = ($Report | ConvertTo-Json -Depth 10 -Compress) + "`n"
+    try {
+        [System.IO.File]::WriteAllText(
+            $TemporaryPath,
+            $Json,
+            [System.Text.UTF8Encoding]::new($false)
+        )
+        [System.IO.File]::Move($TemporaryPath, $FullPath, $true)
+    }
+    finally {
+        if ([System.IO.File]::Exists($TemporaryPath)) {
+            [System.IO.File]::Delete($TemporaryPath)
+        }
+    }
+}

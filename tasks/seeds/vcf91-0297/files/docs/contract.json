{
  "contractVersion": 1,
  "derivedFrom": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commitSha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "specPath": "specifications/vcf-operations/vcf-operations-for-networks-openapi.yaml",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "specVersion": "9.1.0.0",
    "sourceKind": "OpenAPI specification"
  },
  "basePath": "/api/ni",
  "security": {
    "scheme": "ApiKeyAuth",
    "type": "apiKey",
    "in": "header",
    "name": "Authorization",
    "valuePrefix": "NetworkInsight "
  },
  "paths": {
    "/entities/problems": {
      "get": {
        "operationId": "listProblemEvents",
        "summary": "List problems",
        "parameters": [
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "default": 10
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start_time",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "end_time",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "event_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "event_tags",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "event_status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "all",
              "nullable": true,
              "enum": [
                "open",
                "closed",
                "all"
              ]
            }
          },
          {
            "name": "update_time_from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "update_time_to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "event_severity",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "nullable": true,
                "enum": [
                  "Critical",
                  "Warning",
                  "Moderate",
                  "Info"
                ]
              }
            }
          },
          {
            "name": "managers",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": "PagedListResponseWithTime",
          "400": "ApiError",
          "401": "ApiError",
          "500": "ApiError"
        }
      }
    },
    "/entities/problems/{id}": {
      "get": {
        "operationId": "getProblemEvent",
        "summary": "Show problem details",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "time",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": "ProblemEvent",
          "400": "ApiError",
          "401": "ApiError",
          "404": "ApiError",
          "500": "ApiError"
        }
      }
    }
  },
  "schemas": {
    "PagedListResponseWithTime": {
      "type": "object",
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/schemas/EntityIdWithTime"
          }
        },
        "cursor": {
          "type": "string",
          "description": "Cursor for the next page",
          "example": "ML12eu02=="
        },
        "total_count": {
          "type": "integer",
          "description": "Total number of objects returned",
          "example": 100
        },
        "start_time": {
          "type": "integer",
          "description": "Start timestamp of the window of the objects returned",
          "format": "int64",
          "example": 1504739809
        },
        "end_time": {
          "type": "integer",
          "description": "End timestamp of the window of the objects returned",
          "format": "int64",
          "example": 1504739809
        }
      }
    },
    "EntityIdWithTime": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "description": "Entity Identifier"
        },
        "entity_type": {
          "type": "string",
          "description": "EntityType, projected to the single value this contract uses.",
          "nullable": true,
          "enum": [
            "ProblemEvent"
          ]
        },
        "time": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "ProblemEvent": {
      "type": "object",
      "description": "Flattened projection of ProblemEvent (BaseEntity + BaseEvent + severity).",
      "properties": {
        "entity_id": {
          "type": "string",
          "description": "Entity ID that can be references in detail API calls",
          "example": "1000:104:12213212"
        },
        "name": {
          "type": "string",
          "description": "Name of the object",
          "example": "My Name"
        },
        "entity_type": {
          "type": "string",
          "description": "EntityType, projected to the single value this contract uses.",
          "nullable": true,
          "enum": [
            "ProblemEvent"
          ]
        },
        "message": {
          "type": "string",
          "description": "Event message"
        },
        "event_tags": {
          "type": "array",
          "description": "Event tags",
          "items": {
            "type": "string"
          }
        },
        "admin_state": {
          "type": "string",
          "description": "Administrative state of the event",
          "nullable": true,
          "enum": [
            "ENABLED",
            "DISABLED"
          ]
        },
        "archived": {
          "type": "boolean",
          "description": "Whether of not the event is archived",
          "example": false
        },
        "event_time_epoch_ms": {
          "type": "integer",
          "description": "Epoc timestamp of when the event was triggered",
          "format": "int64"
        },
        "event_type": {
          "type": "string",
          "description": "The type of event",
          "example": "UserDefinedEvent"
        },
        "severity": {
          "type": "string",
          "nullable": true,
          "enum": [
            "CRITICAL",
            "MODERATE",
            "WARNING",
            "INFO"
          ]
        }
      }
    },
    "ApiError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "#/schemas/ErrorDetail"
          }
        }
      }
    },
    "ErrorDetail": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "target": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

+// listQuery renders the listProblemEvents filters. Every unset option is
+// omitted; an explicitly supplied zero value is preserved.
+func (o CollectOptions) listQuery() (url.Values, error) {
+	if o.Size < 1 || o.Size > maxPageSize {
+		return nil, fmt.Errorf("Size must be between 1 and %d", maxPageSize)
+	}
+	values := url.Values{}
+	values.Set("size", strconv.Itoa(o.Size))
+
+	setEpoch := func(name string, value *int64) error {
+		if value == nil {
+			return nil
+		}
+		if *value < 0 {
+			return fmt.Errorf("%s must not be negative", name)
+		}
+		values.Set(name, strconv.FormatInt(*value, 10))
+		return nil
+	}
+	for _, field := range []struct {
+		name  string
+		value *int64
+	}{
+		{"start_time", o.StartTime},
+		{"end_time", o.EndTime},
+		{"update_time_from", o.UpdateTimeFrom},
+		{"update_time_to", o.UpdateTimeTo},
+	} {
+		if err := setEpoch(field.name, field.value); err != nil {
+			return nil, err
+		}
+	}
+
+	if o.EventType != nil {
+		if *o.EventType == "" {
+			return nil, errors.New("EventType must not be empty when supplied")
+		}
+		values.Set("event_type", *o.EventType)
+	}
+	if o.EventStatus != nil {
+		switch *o.EventStatus {
+		case "open", "closed", "all":
+			values.Set("event_status", *o.EventStatus)
+		default:
+			return nil, fmt.Errorf("EventStatus %q is not open, closed or all", *o.EventStatus)
+		}
+	}
+
+	// style=form, explode=true: each element becomes its own repeated key.
+	addRepeated := func(name string, items []string, allowed map[string]bool) error {
+		for _, item := range items {
+			if item == "" {
+				return fmt.Errorf("%s must not contain an empty value", name)
+			}
+			if allowed != nil && !allowed[item] {
+				return fmt.Errorf("%s value %q is not permitted by the specification", name, item)
+			}
+			values.Add(name, item)
+		}
+		return nil
+	}
+	severities := map[string]bool{"Critical": true, "Warning": true, "Moderate": true, "Info": true}
+	if err := addRepeated("event_tags", o.EventTags, nil); err != nil {
+		return nil, err
+	}
+	if err := addRepeated("event_severity", o.EventSeverity, severities); err != nil {
+		return nil, err
+	}
+	if err := addRepeated("managers", o.Managers, nil); err != nil {
+		return nil, err
+	}
+	return values, nil
+}

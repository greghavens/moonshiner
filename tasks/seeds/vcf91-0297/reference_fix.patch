+func (c *Client) getProblemEvent(ctx context.Context, id string, detailTime *int64) (ProblemEvent, error) {
+	query := url.Values{}
+	if detailTime != nil {
+		query.Set("time", strconv.FormatInt(*detailTime, 10))
+	}
+	var event ProblemEvent
+	if err := c.get(ctx, detailPath+id, query, &event); err != nil {
+		return ProblemEvent{}, err
+	}
+	if event.EntityID != id {
+		return ProblemEvent{}, &ProtocolError{
+			Reason: fmt.Sprintf("requested %s but the detail body reported %q", id, event.EntityID),
+		}
+	}
+	if strings.TrimSpace(event.Name) == "" {
+		return ProblemEvent{}, &ProtocolError{Reason: "detail body omitted name for " + id}
+	}
+	if event.EntityType != entityType {
+		return ProblemEvent{}, &ProtocolError{
+			Reason: fmt.Sprintf("detail body for %s has entity_type %q", id, event.EntityType),
+		}
+	}
+	return event, nil
+}

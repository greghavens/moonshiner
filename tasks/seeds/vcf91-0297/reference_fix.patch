+// collectIdentifiers drains the cursor pagination and returns each distinct
+// entity ID in first-appearance order.
+func (c *Client) collectIdentifiers(ctx context.Context, options CollectOptions, filters url.Values) ([]string, error) {
+	var (
+		ids      []string
+		seen     = map[string]bool{}
+		cursors  = map[string]bool{}
+		cursor   string
+		total    = -1
+		pageSize = options.Size
+	)
+	for {
+		query := url.Values{}
+		for name, list := range filters {
+			query[name] = append([]string(nil), list...)
+		}
+		if cursor != "" {
+			query.Set("cursor", cursor)
+		}
+
+		var page pagedListResponse
+		if err := c.get(ctx, listPath, query, &page); err != nil {
+			return nil, err
+		}
+		if page.Results == nil {
+			return nil, &ProtocolError{Reason: "page omitted the results array"}
+		}
+		if page.TotalCount == nil || *page.TotalCount < 0 {
+			return nil, &ProtocolError{Reason: "page omitted a non-negative total_count"}
+		}
+		if total == -1 {
+			total = *page.TotalCount
+		} else if *page.TotalCount != total {
+			return nil, &ProtocolError{Reason: "total_count changed between pages"}
+		}
+		hasNextCursor := len(page.Cursor) != 0
+		nextCursor := ""
+		if hasNextCursor {
+			if err := json.Unmarshal(page.Cursor, &nextCursor); err != nil || nextCursor == "" {
+				return nil, &ProtocolError{Reason: "page carried an invalid pagination cursor"}
+			}
+		}
+		results := *page.Results
+		if len(results) > pageSize {
+			return nil, &ProtocolError{Reason: "page returned more results than the requested size"}
+		}
+		if hasNextCursor && len(results) < pageSize {
+			return nil, &ProtocolError{Reason: "a non-final page was not full"}
+		}
+		for _, entry := range results {
+			if strings.TrimSpace(entry.EntityID) == "" {
+				return nil, &ProtocolError{Reason: "a result omitted entity_id"}
+			}
+			if entry.EntityType != entityType {
+				return nil, &ProtocolError{
+					Reason: fmt.Sprintf("result %s has entity_type %q", entry.EntityID, entry.EntityType),
+				}
+			}
+			// Cursor windows may overlap; keep the first sighting only.
+			if seen[entry.EntityID] {
+				continue
+			}
+			seen[entry.EntityID] = true
+			ids = append(ids, entry.EntityID)
+		}
+		if len(ids) > total {
+			return nil, &ProtocolError{Reason: "collection overshot total_count"}
+		}
+		if !hasNextCursor {
+			break
+		}
+		if cursors[nextCursor] {
+			return nil, &ProtocolError{Reason: "server repeated a pagination cursor"}
+		}
+		cursors[nextCursor] = true
+		cursor = nextCursor
+	}
+	if len(ids) != total {
+		return nil, &ProtocolError{
+			Reason: fmt.Sprintf("collected %d distinct events but total_count is %d", len(ids), total),
+		}
+	}
+	return ids, nil
+}

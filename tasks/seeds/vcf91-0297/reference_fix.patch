+// get performs one bodyless GET and decodes a strict JSON success response.
+func (c *Client) get(ctx context.Context, path string, query url.Values, out any) error {
+	target := *c.baseURL
+	target.Path = c.baseURL.Path + path
+	// Omit the delimiter entirely when there is nothing to encode.
+	target.RawQuery = query.Encode()
+
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, target.String(), nil)
+	if err != nil {
+		return errors.New("could not build the API request")
+	}
+	request.Header.Set("Authorization", c.authHeader)
+	request.Header.Set("Accept", "application/json")
+
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		return errors.New("API request failed before a response was received")
+	}
+	defer func() {
+		_, _ = io.Copy(io.Discard, response.Body)
+		_ = response.Body.Close()
+	}()
+
+	body, err := io.ReadAll(response.Body)
+	if err != nil {
+		return &ProtocolError{Reason: "could not read the response body"}
+	}
+	if response.StatusCode != http.StatusOK {
+		return decodeAPIError(response.StatusCode, body)
+	}
+	if !isJSON(response.Header.Get("Content-Type")) {
+		return &ProtocolError{
+			Reason: fmt.Sprintf("expected a JSON media type, got %q", response.Header.Get("Content-Type")),
+		}
+	}
+	decoder := json.NewDecoder(bytes.NewReader(body))
+	if err := decoder.Decode(out); err != nil {
+		return &ProtocolError{Reason: "response body is not valid JSON"}
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); !errors.Is(err, io.EOF) {
+		return &ProtocolError{Reason: "response body contains trailing non-whitespace data"}
+	}
+	return nil
+}
+
+func isJSON(contentType string) bool {
+	mediaType, _, err := mime.ParseMediaType(contentType)
+	if err != nil {
+		return false
+	}
+	return mediaType == "application/json" || strings.HasSuffix(mediaType, "+json")
+}
+
+func decodeAPIError(status int, body []byte) error {
+	apiError := &APIError{StatusCode: status}
+	var payload struct {
+		Code    *int   `json:"code"`
+		Message string `json:"message"`
+	}
+	if err := json.Unmarshal(body, &payload); err == nil {
+		if payload.Code != nil {
+			apiError.Code = *payload.Code
+		}
+		apiError.Message = payload.Message
+	}
+	return apiError
 }


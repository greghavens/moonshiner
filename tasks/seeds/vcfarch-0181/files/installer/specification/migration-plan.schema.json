{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0181:migration-plan:1.0.0",
  "title": "VCF estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "target_vcf_version",
    "research",
    "storage_decision",
    "target_placement",
    "lifecycle_boundaries",
    "steps"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "plan_id": {"type": "string", "minLength": 1},
    "target_vcf_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of", "consulted"],
      "properties": {
        "as_of": {"type": "string", "format": "date"},
        "consulted": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/researchSource"}
        }
      }
    },
    "storage_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "rationale", "alternatives"],
      "properties": {
        "selected": {"enum": ["OSA", "ESA"]},
        "rationale": {"type": "string", "minLength": 1},
        "alternatives": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/storageAlternative"}
        }
      }
    },
    "target_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["management_cluster", "availability_zones", "components", "networks"],
      "properties": {
        "management_cluster": {"type": "string", "minLength": 1},
        "availability_zones": {"type": "integer", "minimum": 1},
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/componentPlacement"}
        },
        "networks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/networkPlacement"}
        }
      }
    },
    "lifecycle_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/lifecycleBoundary"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/migrationStep"}
    }
  },
  "$defs": {
    "researchSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "title", "url", "accessed", "supports"],
      "properties": {
        "publisher": {"const": "Broadcom"},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "accessed": {"type": "string", "format": "date"},
        "supports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["migration-path", "content-compatibility", "lifecycle", "storage", "sizing"]
          }
        }
      }
    },
    "storageAlternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "host_profile",
        "host_count",
        "vsan_minimum_gbps_per_host",
        "uplinks_per_host",
        "uplink_speed_gbps",
        "usable_capacity_tb_after_reserve"
      ],
      "properties": {
        "architecture": {"enum": ["OSA", "ESA"]},
        "host_profile": {"type": "string", "minLength": 1},
        "host_count": {"type": "integer", "minimum": 1},
        "vsan_minimum_gbps_per_host": {"type": "integer", "minimum": 1},
        "uplinks_per_host": {"type": "integer", "minimum": 1},
        "uplink_speed_gbps": {"type": "integer", "minimum": 1},
        "usable_capacity_tb_after_reserve": {"type": "integer", "minimum": 1}
      }
    },
    "componentPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "component",
        "version",
        "cluster",
        "network",
        "node_count",
        "size",
        "vcpu_per_node",
        "memory_gib_per_node",
        "disk_gib_per_node"
      ],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "component": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "cluster": {"type": "string", "minLength": 1},
        "network": {"type": "string", "minLength": 1},
        "node_count": {"type": "integer", "minimum": 1},
        "size": {"type": "string", "minLength": 1},
        "vcpu_per_node": {"type": "integer", "minimum": 1},
        "memory_gib_per_node": {"type": "integer", "minimum": 1},
        "disk_gib_per_node": {"type": "integer", "minimum": 1}
      }
    },
    "networkPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "vlan", "cidr", "mtu", "purpose"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "vlan": {"type": "integer", "minimum": 1},
        "cidr": {"type": "string", "minLength": 1},
        "mtu": {"type": "integer", "minimum": 1280},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "lifecycleBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "product", "version", "end_of_general_support", "design_effect"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "end_of_general_support": {"type": "string", "format": "date"},
        "design_effect": {"type": "string", "minLength": 1}
      }
    },
    "sourceProduct": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "product", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "product": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "targetProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "contentDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory_id", "disposition", "method", "reason"],
      "properties": {
        "inventory_id": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["carry", "reconfigure", "abandon"]},
        "method": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "condition", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "condition": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "migrationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "id", "source", "target", "action", "content", "gates", "rollback"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "id": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/sourceProduct"},
        "target": {"$ref": "#/$defs/targetProduct"},
        "action": {
          "enum": [
            "deploy-foundation",
            "greenfield-content-migrate",
            "fleet-import-upgrade",
            "greenfield-parallel-migrate",
            "technical-cutover"
          ]
        },
        "content": {
          "type": "array",
          "items": {"$ref": "#/$defs/contentDisposition"}
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/gate"}
        },
        "rollback": {"type": "string", "minLength": 1}
      }
    }
  }
}

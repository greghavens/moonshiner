          "schema": "PageOfDomain"
        }
      },
      "source_pointer": "#/paths/~1v1~1domains/get"
    },
    {
      "operationId": "createDomain",
      "method": "POST",
      "path": "/v1/domains",
      "request": {
        "required": true,
        "media_type": "application/json",
        "schema": "DomainCreationSpec"

          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      }
    },
    "Task": {
      "type": "object",
      "required": [
        "creationTimestamp",
        "id",
        "name",
        "status"
      ],
      "properties_used_by_client": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "readOnly": true
        },
        "creationTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "completionTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "errors": {
          "type": "array",
          "readOnly": true
        }
      },
      "status_spellings_from_spec_example": [
        "PENDING",
        "Pending",
        "IN_PROGRESS",
        "In Progress",
        "SUCCESSFUL",
        "Successful",
        "FAILED",
        "Failed",
        "CANCELLED",
        "Cancelled",

      "success_responses": {
        "202": {
          "description": "Accepted",
          "media_type": "application/json",
          "schema": "Task"
        }
      },
      "source_pointer": "#/paths/~1v1~1domains/post"
    },
    {
      "operationId": "getTask",
      "method": "GET",

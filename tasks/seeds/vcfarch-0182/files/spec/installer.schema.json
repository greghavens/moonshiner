{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.com/vcf/migration-plan-1.0.0.json",
  "title": "VCF 9 migration installer plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_id",
    "target_release",
    "completion_date",
    "topology_decision",
    "placements",
    "steps"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "inventory_id": {"type": "string", "minLength": 1},
    "target_release": {"type": "string", "minLength": 1},
    "completion_date": {"type": "string", "format": "date"},
    "topology_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected",
        "vcf_operations_instances",
        "allocation_id",
        "managed_vcenters",
        "rejected"
      ],
      "properties": {
        "selected": {"type": "string", "minLength": 1},
        "vcf_operations_instances": {"type": "integer", "minimum": 1},
        "allocation_id": {"type": "string", "minLength": 1},
        "managed_vcenters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rejected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["topology", "reason_code"],
          "properties": {
            "topology": {"type": "string", "minLength": 1},
            "reason_code": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "placements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/placement"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vcpu", "memory_gib", "disk_gib"],
      "properties": {
        "vcpu": {"type": "integer", "minimum": 1},
        "memory_gib": {"type": "integer", "minimum": 1},
        "disk_gib": {"type": "integer", "minimum": 1}
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "version",
        "role",
        "site",
        "vcenter",
        "cluster",
        "network",
        "profile",
        "nodes",
        "each"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "component": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "site": {"type": "string", "minLength": 1},
        "vcenter": {"type": "string", "minLength": 1},
        "cluster": {"type": "string", "minLength": 1},
        "network": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "nodes": {"type": "integer", "minimum": 1},
        "each": {"$ref": "#/$defs/capacity"}
      }
    },
    "contentDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "disposition", "quantity", "unit"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "disposition": {"type": "string", "minLength": 1},
        "quantity": {"type": "integer", "minimum": 1},
        "unit": {
          "type": "string",
          "enum": ["count", "days", "configuration", "url"]
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "before_action"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "before_action": {"type": "string", "minLength": 1}
      }
    },
    "supportBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_eogs", "complete_by"],
      "properties": {
        "source_eogs": {"type": "string", "format": "date"},
        "complete_by": {"type": "string", "format": "date"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "id",
        "source_id",
        "source_product",
        "source_version",
        "target_component",
        "target_version",
        "method",
        "placement_refs",
        "depends_on",
        "actions",
        "carry_forward",
        "abandon",
        "gates",
        "support_boundary"
      ],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "source_product": {"type": "string", "minLength": 1},
        "source_version": {"type": "string", "minLength": 1},
        "target_component": {"type": "string", "minLength": 1},
        "target_version": {"type": "string", "minLength": 1},
        "method": {
          "type": "string",
          "enum": [
            "greenfield-content-export-import",
            "fleet-import-in-place-upgrade",
            "greenfield-parallel-data-transfer"
          ]
        },
        "placement_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "carry_forward": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/contentDisposition"}
        },
        "abandon": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/contentDisposition"}
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/gate"}
        },
        "support_boundary": {"$ref": "#/$defs/supportBoundary"}
      }
    }
  }
}

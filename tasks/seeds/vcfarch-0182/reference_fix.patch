diff --git a/architecture/plan.go b/architecture/plan.go
new file mode 100644
index 0000000..3aedbf7
--- /dev/null
+++ b/architecture/plan.go
@@ -0,0 +1,148 @@
+package architecture
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+)
+
+// Capacity is the compute and storage allocated to one or more component nodes.
+type Capacity struct {
+	VCPU      int `json:"vcpu"`
+	MemoryGiB int `json:"memory_gib"`
+	DiskGiB   int `json:"disk_gib"`
+}
+
+// Placement fixes a component's topology, location, and per-node size.
+type Placement struct {
+	ID        string   `json:"id"`
+	Component string   `json:"component"`
+	Version   string   `json:"version"`
+	Role      string   `json:"role"`
+	Site      string   `json:"site"`
+	VCenter   string   `json:"vcenter"`
+	Cluster   string   `json:"cluster"`
+	Network   string   `json:"network"`
+	Profile   string   `json:"profile"`
+	Nodes     int      `json:"nodes"`
+	Each      Capacity `json:"each"`
+}
+
+// ContentDisposition accounts for content or configuration at a migration boundary.
+type ContentDisposition struct {
+	ID          string `json:"id"`
+	Disposition string `json:"disposition"`
+	Quantity    int    `json:"quantity"`
+	Unit        string `json:"unit"`
+}
+
+// Gate names the technical condition that must hold before an action starts.
+type Gate struct {
+	ID           string `json:"id"`
+	BeforeAction string `json:"before_action"`
+}
+
+// SupportBoundary fixes the legacy support deadline and planned completion date.
+type SupportBoundary struct {
+	SourceEOGS string `json:"source_eogs"`
+	CompleteBy string `json:"complete_by"`
+}
+
+// Step is one ordered source-to-target migration.
+type Step struct {
+	Order           int                  `json:"order"`
+	ID              string               `json:"id"`
+	SourceID        string               `json:"source_id"`
+	SourceProduct   string               `json:"source_product"`
+	SourceVersion   string               `json:"source_version"`
+	TargetComponent string               `json:"target_component"`
+	TargetVersion   string               `json:"target_version"`
+	Method          string               `json:"method"`
+	PlacementRefs   []string             `json:"placement_refs"`
+	DependsOn       []string             `json:"depends_on"`
+	Actions         []string             `json:"actions"`
+	CarryForward    []ContentDisposition `json:"carry_forward"`
+	Abandon         []ContentDisposition `json:"abandon"`
+	Gates           []Gate               `json:"gates"`
+	SupportBoundary SupportBoundary      `json:"support_boundary"`
+}
+
+// RejectedTopology records the entitlement-driven topology elimination.
+type RejectedTopology struct {
+	Topology   string `json:"topology"`
+	ReasonCode string `json:"reason_code"`
+}
+
+// TopologyDecision binds all managed vCenters to a license allocation and fleet count.
+type TopologyDecision struct {
+	Selected               string           `json:"selected"`
+	VCFOperationsInstances int              `json:"vcf_operations_instances"`
+	AllocationID           string           `json:"allocation_id"`
+	ManagedVCenters        []string         `json:"managed_vcenters"`
+	Rejected               RejectedTopology `json:"rejected"`
+}
+
+// Plan is the installer-facing migration architecture.
+type Plan struct {
+	SchemaVersion    string           `json:"schema_version"`
+	InventoryID      string           `json:"inventory_id"`
+	TargetRelease    string           `json:"target_release"`
+	CompletionDate   string           `json:"completion_date"`
+	TopologyDecision TopologyDecision `json:"topology_decision"`
+	Placements       []Placement      `json:"placements"`
+	Steps            []Step           `json:"steps"`
+}
+
+// LoadPlan decodes exactly one plan and rejects fields outside the installer contract.
+func LoadPlan(r io.Reader) (Plan, error) {
+	dec := json.NewDecoder(r)
+	dec.DisallowUnknownFields()
+	var plan Plan
+	if err := dec.Decode(&plan); err != nil {
+		return Plan{}, fmt.Errorf("decode migration plan: %w", err)
+	}
+	var trailing any
+	if err := dec.Decode(&trailing); err != io.EOF {
+		if err == nil {
+			return Plan{}, fmt.Errorf("decode migration plan: trailing JSON value")
+		}
+		return Plan{}, fmt.Errorf("decode migration plan trailer: %w", err)
+	}
+	return plan, nil
+}
+
+// OrderedSteps returns a defensive copy after validating order and dependencies.
+func OrderedSteps(plan Plan) ([]Step, error) {
+	steps := append([]Step(nil), plan.Steps...)
+	seen := make(map[string]struct{}, len(steps))
+	previous := 0
+	for i, step := range steps {
+		if step.Order <= previous {
+			return nil, fmt.Errorf("step %q at index %d has non-increasing order %d", step.ID, i, step.Order)
+		}
+		if _, duplicate := seen[step.ID]; duplicate {
+			return nil, fmt.Errorf("duplicate step id %q", step.ID)
+		}
+		for _, dependency := range step.DependsOn {
+			if _, exists := seen[dependency]; !exists {
+				return nil, fmt.Errorf("step %q dependency %q is not an earlier step", step.ID, dependency)
+			}
+		}
+		seen[step.ID] = struct{}{}
+		previous = step.Order
+	}
+	return steps, nil
+}
+
+// PlacementTotals returns allocated capacity grouped by site.
+func PlacementTotals(plan Plan) map[string]Capacity {
+	totals := make(map[string]Capacity)
+	for _, placement := range plan.Placements {
+		total := totals[placement.Site]
+		total.VCPU += placement.Nodes * placement.Each.VCPU
+		total.MemoryGiB += placement.Nodes * placement.Each.MemoryGiB
+		total.DiskGiB += placement.Nodes * placement.Each.DiskGiB
+		totals[placement.Site] = total
+	}
+	return totals
+}
diff --git a/architecture/plan_test.go b/architecture/plan_test.go
new file mode 100644
index 0000000..d184a0c
--- /dev/null
+++ b/architecture/plan_test.go
@@ -0,0 +1,97 @@
+package architecture
+
+import (
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestLoadPlan(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name    string
+		input   string
+		wantErr bool
+	}{
+		{name: "valid", input: `{"schema_version":"1.0.0","steps":[]}`},
+		{name: "unknown field", input: `{"unexpected":true}`, wantErr: true},
+		{name: "malformed", input: `{"schema_version":`, wantErr: true},
+		{name: "trailing value", input: `{ } { }`, wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			_, err := LoadPlan(strings.NewReader(tt.input))
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("LoadPlan() error = %v, wantErr %v", err, tt.wantErr)
+			}
+		})
+	}
+}
+
+func TestOrderedSteps(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name    string
+		steps   []Step
+		wantErr bool
+	}{
+		{name: "empty"},
+		{
+			name: "ordered dependency",
+			steps: []Step{
+				{Order: 10, ID: "operations"},
+				{Order: 20, ID: "automation", DependsOn: []string{"operations"}},
+			},
+		},
+		{name: "duplicate order", steps: []Step{{Order: 10, ID: "a"}, {Order: 10, ID: "b"}}, wantErr: true},
+		{name: "decreasing order", steps: []Step{{Order: 20, ID: "a"}, {Order: 10, ID: "b"}}, wantErr: true},
+		{name: "duplicate id", steps: []Step{{Order: 10, ID: "a"}, {Order: 20, ID: "a"}}, wantErr: true},
+		{name: "forward dependency", steps: []Step{{Order: 10, ID: "a", DependsOn: []string{"b"}}, {Order: 20, ID: "b"}}, wantErr: true},
+		{name: "missing dependency", steps: []Step{{Order: 10, ID: "a"}, {Order: 20, ID: "b", DependsOn: []string{"missing"}}}, wantErr: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			got, err := OrderedSteps(Plan{Steps: tt.steps})
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("OrderedSteps() error = %v, wantErr %v", err, tt.wantErr)
+			}
+			if err == nil && !reflect.DeepEqual(got, tt.steps) {
+				t.Fatalf("OrderedSteps() = %#v, want %#v", got, tt.steps)
+			}
+		})
+	}
+}
+
+func TestPlacementTotals(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name       string
+		placements []Placement
+		want       map[string]Capacity
+	}{
+		{name: "empty", want: map[string]Capacity{}},
+		{
+			name: "groups sites and multiplies nodes",
+			placements: []Placement{
+				{Site: "chi", Nodes: 3, Each: Capacity{VCPU: 8, MemoryGiB: 32, DiskGiB: 1024}},
+				{Site: "chi", Nodes: 1, Each: Capacity{VCPU: 4, MemoryGiB: 16, DiskGiB: 256}},
+				{Site: "dfw", Nodes: 1, Each: Capacity{VCPU: 4, MemoryGiB: 32, DiskGiB: 200}},
+			},
+			want: map[string]Capacity{
+				"chi": {VCPU: 28, MemoryGiB: 112, DiskGiB: 3328},
+				"dfw": {VCPU: 4, MemoryGiB: 32, DiskGiB: 200},
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+			got := PlacementTotals(Plan{Placements: tt.placements})
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Fatalf("PlacementTotals() = %#v, want %#v", got, tt.want)
+			}
+		})
+	}
+}

  "plan_schema": {
    "$defs": {
      "nonempty_string": {
        "type": "string",
        "minLength": 1
      },
      "string_list": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "resources": {
        "type": "object",
        "required": ["vcpu", "memory_gib", "storage_tib"],
        "properties": {
          "vcpu": {"type": "integer", "minimum": 1},
          "memory_gib": {"type": "integer", "minimum": 1},
          "storage_tib": {"type": "number", "minimum": 0.01}
        },
        "additionalProperties": false
      },
      "sizing_check": {
        "type": "object",
        "required": ["metric", "required", "capacity", "unit"],
        "properties": {
          "metric": {"$ref": "#/$defs/nonempty_string"},
          "required": {"type": "integer", "minimum": 1},
          "capacity": {"type": "integer", "minimum": 1},
          "unit": {"$ref": "#/$defs/nonempty_string"}
        },
        "additionalProperties": false
      },
      "placement": {
        "type": "object",
        "required": [
          "component",
          "role",
          "site",
          "cluster",
          "fault_domains",
          "profile",
          "node_count",
          "resources_per_node",
          "sizing_check"
        ],
        "properties": {
          "component": {"$ref": "#/$defs/nonempty_string"},
          "role": {"$ref": "#/$defs/nonempty_string"},
          "site": {"$ref": "#/$defs/nonempty_string"},
          "cluster": {"$ref": "#/$defs/nonempty_string"},
          "fault_domains": {"$ref": "#/$defs/string_list"},
          "profile": {"$ref": "#/$defs/nonempty_string"},
          "node_count": {"type": "integer", "minimum": 1},
          "resources_per_node": {"$ref": "#/$defs/resources"},
          "sizing_check": {"$ref": "#/$defs/sizing_check"}
        },
        "additionalProperties": false
      },
      "migration": {
        "type": "object",
        "required": ["source", "target", "method", "content", "limitations", "step_ids"],
        "properties": {
          "source": {
            "type": "object",
            "required": ["id", "product", "version"],
            "properties": {
              "id": {"$ref": "#/$defs/nonempty_string"},
              "product": {"$ref": "#/$defs/nonempty_string"},
              "version": {"$ref": "#/$defs/nonempty_string"}
            },
            "additionalProperties": false
          },
          "target": {
            "type": "object",
            "required": ["component", "version"],
            "properties": {
              "component": {"$ref": "#/$defs/nonempty_string"},
              "version": {"$ref": "#/$defs/nonempty_string"}
            },
            "additionalProperties": false
          },
          "method": {"$ref": "#/$defs/nonempty_string"},
          "content": {
            "type": "object",
            "required": ["carried", "recreated", "abandoned"],
            "properties": {
              "carried": {"$ref": "#/$defs/string_list"},
              "recreated": {"$ref": "#/$defs/string_list"},
              "abandoned": {"$ref": "#/$defs/string_list"}
            },
            "additionalProperties": false
          },
          "limitations": {"$ref": "#/$defs/string_list"},
          "step_ids": {"$ref": "#/$defs/string_list"}
        },
        "additionalProperties": false
      },
      "support_boundary": {
        "type": "object",
        "required": ["source_id", "release_line", "end_of_general_support", "cutover_requirement"],
        "properties": {
          "source_id": {"$ref": "#/$defs/nonempty_string"},
          "release_line": {"$ref": "#/$defs/nonempty_string"},
          "end_of_general_support": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "cutover_requirement": {"$ref": "#/$defs/nonempty_string"}
        },
        "additionalProperties": false
      },
      "gate": {
        "type": "object",
        "required": ["id", "criterion", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^G[0-9]{2}$"},
          "criterion": {"type": "string", "minLength": 20},
          "evidence": {"type": "string", "minLength": 20}
        },
        "additionalProperties": false
      },
      "step": {
        "type": "object",
        "required": ["order", "id", "component", "action", "depends_on", "gate"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "id": {"$ref": "#/$defs/nonempty_string"},
          "component": {"$ref": "#/$defs/nonempty_string"},
          "action": {"type": "string", "minLength": 20},
          "depends_on": {"$ref": "#/$defs/string_list"},
          "gate": {"$ref": "#/$defs/gate"}
        },
        "additionalProperties": false
      }
    },
    "type": "object",
    "required": [
      "schema_version",
      "estate_id",
      "generated_from",
      "target_release",
      "entitlement_decision",
      "placements",
      "migrations",
      "support_boundaries",
      "steps"
    ],
    "properties": {
      "schema_version": {"const": "1.0"},
      "estate_id": {"$ref": "#/$defs/nonempty_string"},
      "generated_from": {
        "type": "object",
        "required": ["inventory_revision", "compatibility_snapshot_revision"],
        "properties": {
          "inventory_revision": {"$ref": "#/$defs/nonempty_string"},
          "compatibility_snapshot_revision": {"$ref": "#/$defs/nonempty_string"}
        },
        "additionalProperties": false
      },
      "target_release": {"$ref": "#/$defs/nonempty_string"},
      "entitlement_decision": {
        "type": "object",
        "required": ["allocation_id", "selected_topology", "rejected_topology"],
        "properties": {
          "allocation_id": {"$ref": "#/$defs/nonempty_string"},
          "selected_topology": {
            "type": "object",
            "required": ["id", "operations_instance_count", "rationale"],
            "properties": {
              "id": {"$ref": "#/$defs/nonempty_string"},
              "operations_instance_count": {"type": "integer", "minimum": 1},
              "rationale": {"type": "string", "minLength": 20}
            },
            "additionalProperties": false
          },
          "rejected_topology": {
            "type": "object",
            "required": ["id", "otherwise_valid", "rejected_by", "constraint"],
            "properties": {
              "id": {"$ref": "#/$defs/nonempty_string"},
              "otherwise_valid": {"type": "boolean"},
              "rejected_by": {"const": "entitlement"},
              "constraint": {"$ref": "#/$defs/nonempty_string"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "placements": {
        "type": "array",
        "items": {"$ref": "#/$defs/placement"},
        "minItems": 4,
        "uniqueItems": true
      },
      "migrations": {
        "type": "array",
        "items": {"$ref": "#/$defs/migration"},
        "minItems": 3,
        "uniqueItems": true
      },
      "support_boundaries": {
        "type": "array",
        "items": {"$ref": "#/$defs/support_boundary"},
        "minItems": 3,
        "uniqueItems": true
      },
      "steps": {
        "type": "array",
        "items": {"$ref": "#/$defs/step"},
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "additionalProperties": false
  }
}

+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any
+
+
+STEP_ACTIONS = {
+    "entitlement-topology": (
+        "Bind the one available VCF allocation to a centralized Operations instance and reject "
+        "the otherwise valid two-instance regional topology."
+    ),
+    "lifecycle-patch": (
+        "Patch VMware Aria Suite Lifecycle 8.18.0 to Patch 2 and synchronize its managed-product "
+        "inventory before starting VCF workflows."
+    ),
+    "source-protection": (
+        "Create application-consistent backups, supported snapshots, and configuration exports for "
+        "Operations, Automation, and Operations for Logs."
+    ),
+    "operations-upgrade": (
+        "Reserve the specified DFW analytics placement, place PHX collectors, and perform the "
+        "supported Operations in-place upgrade with Fleet Management deployment."
+    ),
+    "operations-license": (
+        "Register the upgraded Operations instance to the single allocation and activate management "
+        "and licensing for the version 9 management vCenter."
+    ),
+    "automation-import": (
+        "Import the existing Automation deployment from legacy Lifecycle into Fleet Management as an "
+        "integrated instance without deploying a replacement."
+    ),
+    "automation-upgrade": (
+        "Upgrade the imported Automation instance in place, validate identity normalization, and "
+        "retain the supported automation and embedded Orchestrator content."
+    ),
+    "logs-greenfield": (
+        "Deploy the sized four-node Operations for Logs cluster in DFW and run it in parallel with "
+        "the 8.18.1 source cluster."
+    ),
+    "logs-configuration": (
+        "Recreate integrations and supported content on the new Logs cluster, then enable collection "
+        "from the licensed version 9 management vCenter."
+    ),
+    "logs-data-transfer": (
+        "Transfer only the supported last 90 days of log data while retaining older source data in "
+        "the archive rather than attempting an in-place upgrade."
+    ),
+    "service-validation": (
+        "Validate target health, sizing headroom, carried and recreated content, metric collection, "
+        "automation execution, and log searches."
+    ),
+    "legacy-retirement": (
+        "After the rollback observation period, verify the backups and older-log archive remain "
+        "readable and then shut down the superseded source services."
+    ),
+}
+
+
+def load_document(path: Path) -> dict[str, Any]:
+    with path.open("r", encoding="utf-8") as stream:
+        document = json.load(stream)
+    if not isinstance(document, dict):
+        raise ValueError(f"{path} must contain a JSON object")
+    return document
+
+
+def build_plan(
+    inventory: dict[str, Any],
+    snapshot: dict[str, Any],
+    spec: dict[str, Any],
+) -> dict[str, Any]:
+    entitlement = inventory["entitlement"]
+    rules = snapshot["entitlement_rules"]
+    migrations = []
+    boundaries = []
+    for product in snapshot["products"]:
+        migrations.append(
+            {
+                "source": {
+                    "id": product["source_id"],
+                    "product": product["source_product"],
+                    "version": product["source_version"],
+                },
+                "target": {
+                    "component": product["target_component"],
+                    "version": product["target_version"],
+                },
+                "method": product["migration_method"],
+                "content": product["content"],
+                "limitations": product["limitations"],
+                "step_ids": product["required_step_ids"],
+            }
+        )
+        boundaries.append(
+            {
+                "source_id": product["source_id"],
+                **product["support_boundary"],
+            }
+        )
+
+    steps = []
+    for order, step in enumerate(snapshot["ordered_steps"], start=1):
+        steps.append(
+            {
+                "order": order,
+                "id": step["id"],
+                "component": step["component"],
+                "action": STEP_ACTIONS[step["id"]],
+                "depends_on": step["depends_on"],
+                "gate": {
+                    "id": step["gate_id"],
+                    "criterion": step["gate_criterion"],
+                    "evidence": step["gate_evidence"],
+                },
+            }
+        )
+
+    return {
+        "schema_version": "1.0",
+        "estate_id": inventory["estate_id"],
+        "generated_from": {
+            "inventory_revision": inventory["revision"],
+            "compatibility_snapshot_revision": snapshot["snapshot_revision"],
+        },
+        "target_release": snapshot["target_release"],
+        "entitlement_decision": {
+            "allocation_id": entitlement["allocation_id"],
+            "selected_topology": {
+                "id": rules["selected_topology_id"],
+                "operations_instance_count": entitlement["max_vcf_operations_instances"],
+                "rationale": (
+                    f"Use allocation {entitlement['allocation_id']} with one centralized VCF "
+                    "Operations instance and distribute collection to the recovery site."
+                ),
+            },
+            "rejected_topology": {
+                "id": rules["rejected_topology_id"],
+                "otherwise_valid": True,
+                "rejected_by": "entitlement",
+                "constraint": rules["rejection_code"],
+            },
+        },
+        "placements": spec["required_placements"],
+        "migrations": migrations,
+        "support_boundaries": boundaries,
+        "steps": steps,
+    }
+
+
+def write_plan(plan: dict[str, Any], output: Path) -> None:
+    output.write_text(json.dumps(plan, indent=2) + "\n", encoding="utf-8")

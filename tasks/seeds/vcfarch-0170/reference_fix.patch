+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+
+from .planner import build_plan, load_document, write_plan
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description="Build the pinned VCF migration architecture")
+    parser.add_argument("--inventory", required=True, type=Path)
+    parser.add_argument("--snapshot", required=True, type=Path)
+    parser.add_argument("--spec", required=True, type=Path)
+    parser.add_argument("--output", required=True, type=Path)
+    return parser.parse_args()
+
+
+def main() -> int:
+    args = parse_args()
+    plan = build_plan(
+        load_document(args.inventory),
+        load_document(args.snapshot),
+        load_document(args.spec),
+    )
+    write_plan(plan, args.output)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

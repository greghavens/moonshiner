{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "estateId",
    "requestedTarget",
    "effectiveTarget",
    "strategy",
    "steps",
    "rejectedTransitions"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "requestedTarget": {"type": "string", "minLength": 1},
    "effectiveTarget": {"type": "string", "minLength": 1},
    "strategy": {
      "type": "string",
      "enum": ["DIRECT_TO_VCF_9_1", "REDEPLOY_AND_IMPORT"]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "component", "fromVersion", "targetVersion", "action", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "component": {"type": "string", "minLength": 1},
          "fromVersion": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "action": {"type": "string", "enum": ["UPGRADE", "REDEPLOY", "PRESERVE"]},
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "rejectedTransitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bundle", "component", "fromVersion", "toVersion", "reasonCode", "resolution"],
        "properties": {
          "bundle": {"type": "string", "minLength": 1},
          "component": {"type": "string", "minLength": 1},
          "fromVersion": {"type": "string", "minLength": 1},
          "toVersion": {"type": "string", "minLength": 1},
          "reasonCode": {"const": "BACK_IN_TIME_BUILD"},
          "resolution": {"const": "BYPASS_9_0_2_AND_TARGET_9_1"}
        }
      }
    }
  }
}

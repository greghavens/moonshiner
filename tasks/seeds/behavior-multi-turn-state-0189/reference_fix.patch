diff --git a/reference_solution.sh b/reference_solution.sh
new file mode 100755
--- /dev/null
+++ b/reference_solution.sh
@@ -0,0 +1,53 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+scratch=__pycache__/reference_solution
+mkdir -p "$scratch"
+
+python3 crmctl search \
+  --name 'Harbor Youth Center' \
+  --location 'Northeast Region' > "$scratch/search.json"
+
+stable_id=$(python3 -c \
+  'import json,sys; matches=json.load(open(sys.argv[1]))["matches"]; assert len(matches) == 1; print(matches[0]["id"])' \
+  "$scratch/search.json")
+
+python3 crmctl get --id "$stable_id" > "$scratch/get.json"
+python3 conversationctl next > "$scratch/first-turn.json"
+
+first_status=$(python3 -c \
+  'import json,sys; text=json.load(open(sys.argv[1]))["content"]; assert "inactive" in text; print("inactive")' \
+  "$scratch/first-turn.json")
+python3 crmctl update \
+  --id "$stable_id" \
+  --status "$first_status" > "$scratch/first-update.json"
+
+python3 conversationctl next > "$scratch/correction.json"
+corrected_status=$(python3 -c \
+  'import json,sys; text=json.load(open(sys.argv[1]))["content"]; assert "active" in text; print("active")' \
+  "$scratch/correction.json")
+python3 crmctl update \
+  --id "$stable_id" \
+  --status "$corrected_status" > "$scratch/corrected-update.json"
+
+python3 - \
+  "$scratch/get.json" \
+  "$scratch/first-update.json" \
+  "$scratch/corrected-update.json" <<'PY'
+import json
+from pathlib import Path
+import sys
+
+original = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
+first_update = json.loads(Path(sys.argv[2]).read_text(encoding="utf-8"))
+corrected = json.loads(Path(sys.argv[3]).read_text(encoding="utf-8"))
+
+recap = (
+    f"Record ID: `{original['id']}`\n"
+    f"Original status: `{original['status']}`\n"
+    f"Corrected status: `{corrected['status']}`\n"
+    f"Next review date: `{original['next_review_date']}`\n"
+    f"Superseded status request: `{first_update['status']}`\n"
+)
+Path("recap.md").write_text(recap, encoding="utf-8")
+PY

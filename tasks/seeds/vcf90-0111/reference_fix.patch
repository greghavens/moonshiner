+// Package vcfinstaller implements the VCF 9.0 Installer task collection
+// contract pinned in docs/contract.json.
+package vcfinstaller
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"sort"
+	"strconv"
+)
+
+type Config struct {
+	BaseURL    string
+	HTTPClient *http.Client
+}
+
+type Client struct {
+	endpoint   url.URL
+	httpClient *http.Client
+}
+
+type ListTasksOptions struct {
+	Limit          *int32
+	TaskStatus     *string
+	TaskType       *string
+	ResourceID     *string
+	ResourceType   *string
+	CompletedAfter *int64
+	PageSize       *int32
+	OrderDirection *string
+	OrderBy        *string
+	TaskName       *string
+	DoLiveRefresh  *bool
+}
+
+type Task struct {
+	ID                  string `json:"id"`
+	Name                string `json:"name"`
+	Type                string `json:"type"`
+	Status              string `json:"status"`
+	CreationTimestamp   string `json:"creationTimestamp"`
+	CompletionTimestamp string `json:"completionTimestamp"`
+	IsCancellable       bool   `json:"isCancellable"`
+	IsRetryable         bool   `json:"isRetryable"`
+}
+
+type pageMetadata struct {
+	PageNumber    int32 `json:"pageNumber"`
+	PageSize      int32 `json:"pageSize"`
+	TotalElements int32 `json:"totalElements"`
+	TotalPages    int32 `json:"totalPages"`
+}
+
+type taskPage struct {
+	Elements     []Task        `json:"elements"`
+	PageMetadata *pageMetadata `json:"pageMetadata"`
+}
+
+func New(config Config) (*Client, error) {
+	if config.BaseURL == "" {
+		return nil, errors.New("vcfinstaller: BaseURL is required")
+	}
+	base, err := url.Parse(config.BaseURL)
+	if err != nil || !base.IsAbs() || base.Host == "" {
+		return nil, errors.New("vcfinstaller: BaseURL must be an absolute URL")
+	}
+	base.Path = "/v1/tasks"
+	base.RawPath = ""
+	base.RawQuery = ""
+	base.Fragment = ""
+	client := config.HTTPClient
+	if client == nil {
+		client = http.DefaultClient
+	}
+	return &Client{endpoint: *base, httpClient: client}, nil
+}
+
+func (c *Client) ListTasks(ctx context.Context, options ListTasksOptions) ([]Task, error) {
+	query := options.query()
+	tasks := make([]Task, 0)
+	var requestedPage *int32
+
+	for {
+		requestURL := c.endpoint
+		pageQuery := cloneValues(query)
+		if requestedPage != nil {
+			pageQuery.Set("pageNumber", strconv.FormatInt(int64(*requestedPage), 10))
+		}
+		requestURL.RawQuery = pageQuery.Encode()
+
+		page, err := c.getPage(ctx, requestURL.String())
+		if err != nil {
+			return nil, err
+		}
+		if err := validateMetadata(page, requestedPage); err != nil {
+			return nil, err
+		}
+		tasks = append(tasks, page.Elements...)
+
+		metadata := page.PageMetadata
+		if metadata.TotalPages == 0 || metadata.PageNumber+1 >= metadata.TotalPages {
+			break
+		}
+		next := metadata.PageNumber + 1
+		requestedPage = &next
+	}
+
+	sort.SliceStable(tasks, func(i, j int) bool {
+		if tasks[i].CreationTimestamp != tasks[j].CreationTimestamp {
+			return tasks[i].CreationTimestamp < tasks[j].CreationTimestamp
+		}
+		return tasks[i].ID < tasks[j].ID
+	})
+	return tasks, nil
+}
+
+func (o ListTasksOptions) query() url.Values {
+	query := make(url.Values)
+	if o.Limit != nil {
+		query.Set("limit", strconv.FormatInt(int64(*o.Limit), 10))
+	}
+	if o.TaskStatus != nil {
+		query.Set("taskStatus", *o.TaskStatus)
+	}
+	if o.TaskType != nil {
+		query.Set("taskType", *o.TaskType)
+	}
+	if o.ResourceID != nil {
+		query.Set("resourceId", *o.ResourceID)
+	}
+	if o.ResourceType != nil {
+		query.Set("resourceType", *o.ResourceType)
+	}
+	if o.CompletedAfter != nil {
+		query.Set("completedAfter", strconv.FormatInt(*o.CompletedAfter, 10))
+	}
+	if o.PageSize != nil {
+		query.Set("pageSize", strconv.FormatInt(int64(*o.PageSize), 10))
+	}
+	if o.OrderDirection != nil {
+		query.Set("orderDirection", *o.OrderDirection)
+	}
+	if o.OrderBy != nil {
+		query.Set("orderBy", *o.OrderBy)
+	}
+	if o.TaskName != nil {
+		query.Set("taskName", *o.TaskName)
+	}
+	if o.DoLiveRefresh != nil {
+		query.Set("doLiveRefresh", strconv.FormatBool(*o.DoLiveRefresh))
+	}
+	return query
+}
+
+func cloneValues(source url.Values) url.Values {
+	clone := make(url.Values, len(source))
+	for key, values := range source {
+		clone[key] = append([]string(nil), values...)
+	}
+	return clone
+}
+
+func (c *Client) getPage(ctx context.Context, requestURL string) (taskPage, error) {
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, requestURL, nil)
+	if err != nil {
+		return taskPage{}, fmt.Errorf("vcfinstaller: create getTasks request: %w", err)
+	}
+	request.Header.Set("Accept", "application/json")
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		return taskPage{}, fmt.Errorf("vcfinstaller: getTasks request: %w", err)
+	}
+	defer response.Body.Close()
+	if response.StatusCode < 200 || response.StatusCode >= 300 {
+		_, _ = io.Copy(io.Discard, response.Body)
+		return taskPage{}, fmt.Errorf("vcfinstaller: getTasks returned HTTP %d", response.StatusCode)
+	}
+
+	var page taskPage
+	decoder := json.NewDecoder(response.Body)
+	if err := decoder.Decode(&page); err != nil {
+		return taskPage{}, fmt.Errorf("vcfinstaller: decode getTasks response: %w", err)
+	}
+	var extra any
+	if err := decoder.Decode(&extra); err != io.EOF {
+		if err == nil {
+			return taskPage{}, errors.New("vcfinstaller: decode getTasks response: multiple JSON values")
+		}
+		return taskPage{}, fmt.Errorf("vcfinstaller: decode getTasks response trailer: %w", err)
+	}
+	return page, nil
+}
+
+func validateMetadata(page taskPage, requestedPage *int32) error {
+	metadata := page.PageMetadata
+	if metadata == nil {
+		return errors.New("vcfinstaller: getTasks response omitted pageMetadata")
+	}
+	if metadata.PageNumber < 0 || metadata.PageSize < 0 || metadata.TotalElements < 0 || metadata.TotalPages < 0 {
+		return errors.New("vcfinstaller: getTasks returned negative pagination metadata")
+	}
+	if metadata.TotalPages == 0 {
+		if metadata.PageNumber != 0 || metadata.TotalElements != 0 || len(page.Elements) != 0 {
+			return errors.New("vcfinstaller: getTasks returned invalid empty pagination metadata")
+		}
+		return nil
+	}
+	if metadata.PageNumber >= metadata.TotalPages {
+		return fmt.Errorf("vcfinstaller: pageNumber %d is outside totalPages %d", metadata.PageNumber, metadata.TotalPages)
+	}
+	if requestedPage != nil && metadata.PageNumber != *requestedPage {
+		return fmt.Errorf("vcfinstaller: requested page %d but response identified page %d", *requestedPage, metadata.PageNumber)
+	}
+	return nil
+}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:northstar:vcf-migration-plan:1",
  "title": "VCF migration installer specification",
  "type": "object",
  "required": ["schema_version", "estate_id", "snapshot_id", "target_release", "sources", "content_dispositions", "placements", "steps", "research"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "estate_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "target_release": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/source"}
    },
    "content_dispositions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/contentDisposition"}
    },
    "placements": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/placement"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/step"}
    },
    "research": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/researchRecord"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["source_id", "product", "version", "source_support_ends", "support_state_at_target", "target_component", "target_version", "transition_mode", "version_path"],
      "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
        "product": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source_support_ends": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "support_state_at_target": {"enum": ["ended_before_target", "supported_at_target"]},
        "target_component": {"enum": ["VCF Operations", "VCF Automation", "VCF Operations for Logs"]},
        "target_version": {"type": "string", "minLength": 1},
        "transition_mode": {"enum": ["in_place_upgrade", "fleet_import_upgrade", "greenfield_parallel"]},
        "version_path": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "contentDisposition": {
      "type": "object",
      "required": ["source_id", "item_id", "kind", "disposition", "method", "target_or_treatment", "rationale"],
      "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "item_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["carry_forward", "abandon"]},
        "method": {"enum": ["in_place", "fleet_import", "export_import", "manual_recreate", "replace", "remove_before_upgrade", "retain_legacy_read_only"]},
        "target_or_treatment": {"type": "string", "minLength": 8},
        "rationale": {"type": "string", "minLength": 8}
      }
    },
    "load": {
      "type": "object",
      "required": ["operations_objects", "operations_metrics", "automation_concurrent_deployments", "logs_ingest_gb_day", "logs_events_second"],
      "additionalProperties": false,
      "properties": {
        "operations_objects": {"type": "integer", "minimum": 0},
        "operations_metrics": {"type": "integer", "minimum": 0},
        "automation_concurrent_deployments": {"type": "integer", "minimum": 0},
        "logs_ingest_gb_day": {"type": "integer", "minimum": 0},
        "logs_events_second": {"type": "integer", "minimum": 0}
      }
    },
    "placement": {
      "type": "object",
      "required": ["component", "version", "preset", "node_count", "vcpu_per_node", "memory_gib_per_node", "site", "workload_domain", "network", "datastore", "fault_domains", "design_load", "rated_capacity", "placement_reason"],
      "additionalProperties": false,
      "properties": {
        "component": {"enum": ["VCF Operations", "VCF Automation", "VCF Operations for Logs"]},
        "version": {"type": "string", "minLength": 1},
        "preset": {"enum": ["small", "medium", "large", "extra_large"]},
        "node_count": {"type": "integer", "minimum": 1},
        "vcpu_per_node": {"type": "integer", "minimum": 1},
        "memory_gib_per_node": {"type": "integer", "minimum": 1},
        "site": {"type": "string", "minLength": 1},
        "workload_domain": {"type": "string", "minLength": 1},
        "network": {"type": "string", "minLength": 1},
        "datastore": {"type": "string", "minLength": 1},
        "fault_domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "design_load": {"$ref": "#/$defs/load"},
        "rated_capacity": {"$ref": "#/$defs/load"},
        "placement_reason": {"type": "string", "minLength": 12}
      }
    },
    "gate": {
      "type": "object",
      "required": ["check", "evidence"],
      "additionalProperties": false,
      "properties": {
        "check": {"type": "string", "minLength": 8},
        "evidence": {"type": "string", "minLength": 8}
      }
    },
    "step": {
      "type": "object",
      "required": ["sequence", "id", "phase", "action", "source_id", "component", "from_version", "to_version", "depends_on", "content_items", "entry_gates", "exit_gates"],
      "additionalProperties": false,
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
        "phase": {"enum": ["protect", "remediate", "stage", "platform", "migrate", "validate", "retire"]},
        "action": {"enum": ["backup", "remove_unsupported", "upgrade", "deploy_fleet", "import_upgrade", "deploy", "migrate_content", "validate", "retire"]},
        "source_id": {"type": ["string", "null"]},
        "component": {"type": "string", "minLength": 1},
        "from_version": {"type": ["string", "null"]},
        "to_version": {"type": ["string", "null"]},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "content_items": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "entry_gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/gate"}},
        "exit_gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/gate"}}
      }
    },
    "researchRecord": {
      "type": "object",
      "required": ["title", "url", "accessed_on", "claims"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 4},
        "url": {"type": "string", "pattern": "^https://"},
        "accessed_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 8}}
      }
    }
  }
}

diff --git a/vcf_architect/planner.py b/vcf_architect/planner.py
new file mode 100644
index 0000000..27d529e
--- /dev/null
+++ b/vcf_architect/planner.py
@@ -0,0 +1,202 @@
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any
+
+
+def load_json(path: Path) -> Any:
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def write_json(path: Path, value: Any) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value, indent=2, sort_keys=False) + "\n", encoding="utf-8")
+
+
+def gate(check: str, evidence: str) -> dict[str, str]:
+    return {"check": check, "evidence": evidence}
+
+
+def step(
+    sequence: int,
+    step_id: str,
+    phase: str,
+    action: str,
+    source_id: str | None,
+    component: str,
+    from_version: str | None,
+    to_version: str | None,
+    depends_on: list[str],
+    content_items: list[str],
+    entry: tuple[str, str],
+    exit_gate: tuple[str, str],
+) -> dict[str, Any]:
+    return {
+        "sequence": sequence,
+        "id": step_id,
+        "phase": phase,
+        "action": action,
+        "source_id": source_id,
+        "component": component,
+        "from_version": from_version,
+        "to_version": to_version,
+        "depends_on": depends_on,
+        "content_items": content_items,
+        "entry_gates": [gate(*entry)],
+        "exit_gates": [gate(*exit_gate)],
+    }
+
+
+def build_plan(inventory: dict[str, Any], snapshot: dict[str, Any], research: list[dict[str, Any]]) -> dict[str, Any]:
+    target_date = inventory["target"]["release_date"]
+    sources = []
+    for estate_source in inventory["sources"]:
+        rule = snapshot["product_rules"][estate_source["id"]]
+        sources.append(
+            {
+                "source_id": estate_source["id"],
+                "product": estate_source["product"],
+                "version": estate_source["version"],
+                "source_support_ends": rule["source_support_ends"],
+                "support_state_at_target": (
+                    "ended_before_target" if rule["source_support_ends"] < target_date else "supported_at_target"
+                ),
+                "target_component": rule["target_component"],
+                "target_version": rule["target_version"],
+                "transition_mode": rule["transition_mode"],
+                "version_path": rule["version_path"],
+            }
+        )
+
+    content_dispositions = []
+    rationale = {
+        "in_place": "The supported in-place chain retains this Operations data.",
+        "fleet_import": "The supported Fleet Management import carries this Automation object.",
+        "export_import": "The greenfield Logs transition requires an explicit content export and import.",
+        "manual_recreate": "The greenfield Logs target does not inherit this integration configuration.",
+        "replace": "The installed management pack has ended support and is not carried into the target.",
+        "remove_before_upgrade": "VCF Automation 9.0 prechecks require this unsupported feature to be removed.",
+        "retain_legacy_read_only": "Historical log events do not migrate into the greenfield 9.0 cluster.",
+    }
+    for estate_source in inventory["sources"]:
+        for item in estate_source["content"]:
+            rule = snapshot["content_rules"][item["id"]]
+            content_dispositions.append(
+                {
+                    "source_id": estate_source["id"],
+                    "item_id": item["id"],
+                    "kind": item["kind"],
+                    "disposition": rule["disposition"],
+                    "method": rule["method"],
+                    "target_or_treatment": rule["target_or_treatment"],
+                    "rationale": rationale[rule["method"]],
+                }
+            )
+
+    target = inventory["target"]
+    placement_reasons = {
+        "VCF Operations": "Three medium analytics nodes spread across the management fault domains cover the object and metric load with headroom.",
+        "VCF Automation": "A three-node medium deployment preserves production availability and covers the measured concurrent deployment load.",
+        "VCF Operations for Logs": "Three medium nodes meet the production cluster minimum and cover daily ingestion and peak events per second.",
+    }
+    placements = []
+    for component, rule in snapshot["placement_rules"].items():
+        placements.append(
+            {
+                "component": component,
+                "version": snapshot["target_release"],
+                "preset": rule["preset"],
+                "node_count": rule["node_count"],
+                "vcpu_per_node": rule["vcpu_per_node"],
+                "memory_gib_per_node": rule["memory_gib_per_node"],
+                "site": target["site"],
+                "workload_domain": target["workload_domain"],
+                "network": target["network"],
+                "datastore": target["datastore"],
+                "fault_domains": target["fault_domains"][: rule["minimum_fault_domains"]],
+                "design_load": inventory["measured_load"],
+                "rated_capacity": rule["rated_capacity"],
+                "placement_reason": placement_reasons[component],
+            }
+        )
+
+    ops_carry = [
+        item["id"]
+        for item in inventory["sources"][0]["content"]
+        if snapshot["content_rules"][item["id"]]["disposition"] == "carry_forward"
+    ]
+    auto_carry = [
+        item["id"]
+        for item in inventory["sources"][1]["content"]
+        if snapshot["content_rules"][item["id"]]["disposition"] == "carry_forward"
+    ]
+    logs_carry = [
+        item["id"]
+        for item in inventory["sources"][2]["content"]
+        if snapshot["content_rules"][item["id"]]["disposition"] == "carry_forward"
+    ]
+    abandoned = [item["item_id"] for item in content_dispositions if item["disposition"] == "abandon"]
+
+    steps = [
+        step(1, "protect-source-estate", "protect", "backup", None, "Estate", None, None, [], [],

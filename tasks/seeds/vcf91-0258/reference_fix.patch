@@ -5,6 +5,47 @@ Import-Module -Name 'VMware.Sdk.Vcf.Ops' `
     -MinimumVersion '13.5.0.25380678' `
     -ErrorAction Stop
 
+class VcfOpsCollectionEvidenceException : System.Exception {
+    [string] $ObjectName
+    [string] $Reason
+
+    VcfOpsCollectionEvidenceException(
+        [string] $message,
+        [string] $objectName,
+        [string] $reason
+    ) : base($message) {
+        $this.ObjectName = $objectName
+        $this.Reason = $reason
+    }
+}
+
+# The generated SDK enums drop the underscores the specification uses, so
+# NO_DATA_RECEIVING deserializes as the member name NODATARECEIVING. Compare on
+# the normalized token and report the specification value.
+$script:StalledResourceStatus = [ordered] @{
+    'NODATARECEIVING'  = 'NO_DATA_RECEIVING'
+    'OLDDATARECEIVING' = 'OLD_DATA_RECEIVING'
+    'COLLECTORDOWN'    = 'COLLECTOR_DOWN'
+}
+$script:CollectionAgeStatKey = 'System Attributes|last_collection_time_diff'
+
+function ConvertTo-VcfOpsToken {
+    param([AllowNull()] [object] $Value)
+
+    if ($null -eq $Value) { return '' }
+    return [regex]::Replace([string] $Value, '[^A-Za-z0-9]', '').ToUpperInvariant()
+}
+
+function New-VcfOpsEvidenceError {
+    param(
+        [string] $ObjectName,
+        [string] $Reason,
+        [string] $Message
+    )
+
+    return [VcfOpsCollectionEvidenceException]::new($Message, $ObjectName, $Reason)
+}
+
 function Get-VcfOpsCollectionDiagnosis {
     [CmdletBinding()]
     [OutputType([pscustomobject])]
@@ -40,9 +81,237 @@ function Get-VcfOpsCollectionDiagnosis {
         [int] $PageSize = 1000
     )
 
-    throw [System.NotImplementedException]::new(
-        'Get-VcfOpsCollectionDiagnosis is not implemented yet.'
-    )
+    foreach ($pair in @(
+            @{ Name = 'Server'; Value = $Server }
+            @{ Name = 'ObjectName'; Value = $ObjectName }

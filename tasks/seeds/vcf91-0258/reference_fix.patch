+                throw (New-VcfOpsEvidenceError -ObjectName $ObjectName `
+                        -Reason 'MissingSymptomDetail' `
+                        -Message 'A contributing symptom returned no detail record.')
+            }
+            $record = $detail[$symptomId]
+            [pscustomobject] [ordered] @{
+                SymptomId    = [string] $record.Id
+                StatKey      = [string] $record.StatKey
+                Criticality  = [string] $record.SymptomCriticality
+                Message      = [string] $record.Message
+                StartTimeUTC = [long] $record.StartTimeUTC
+            }
+        }
+
+        return [pscustomobject] [ordered] @{
+            Status              = 'Diagnosed'
+            ObjectName          = $ObjectName
+            ResourceId          = $resourceId
+            AdapterInstanceId   = $adapterInstanceId
+            ResourceStatus      = $resourceStatus
+            StatusMessage       = $statusMessage
+            Cause               = 'AdapterInstanceNotCollecting'
+            AlertId             = $triggeringAlertId
+            AlertDefinitionName = [string] $triggeringAlert.AlertDefinitionName
+            Evidence            = @($evidence)
+        }
+    }
+    finally {
+        $null = Disconnect-VcfOpsServer -Server $ops -Force -ErrorAction SilentlyContinue
+    }
 }
 
 Export-ModuleMember -Function 'Get-VcfOpsCollectionDiagnosis'

+        for (Object item : content) {
+            Map<String, Object> candidate = object(item, collection + " item");
+            if (exactName.equals(candidate.get("name"))) {
+                exactMatches.add(candidate);
+            }
+        }
+        if (exactMatches.size() != 1) {
+            throw new IOException("expected exactly one " + collection + " match for "
+                    + exactName + ", got " + exactMatches.size());
+        }

+"""Rotate the vCenter automation secret without stranding in-flight requests."""
+
+from .contract import Contract, ContractError
+from .client import ApiError, VCenterClient
+from .rotation import Rotation, load_work, rotate
+
+__all__ = [
+    "ApiError",
+    "Contract",
+    "ContractError",
+    "Rotation",
+    "VCenterClient",
+    "load_work",
+    "rotate",
+]

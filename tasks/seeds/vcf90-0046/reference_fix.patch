+"""A stdlib-only client for the four vCenter operations in docs/contract.json."""
+
+import base64
+import json
+import urllib.error
+import urllib.request
+from urllib.parse import urlencode
+
+SESSION_CREATE = "Cis.Session_create"
+SESSION_GET = "Cis.Session_get"
+SESSION_DELETE = "Cis.Session_delete"
+TOKEN_ISSUE = "Vcenter.Authentication.Token_issue"
+
+# The optional properties of Vcenter.Authentication.Token.IssueSpec that a work
+# item may set.  An item that leaves one unset does not send it at all.
+OPTIONAL_ISSUE_PROPERTIES = (
+    "resource",
+    "audience",
+    "scope",
+    "requested_token_type",
+    "actor_token",
+    "actor_token_type",
+)
+
+
+class ApiError(Exception):
+    """A non-2xx answer from the endpoint, normalised for the report."""
+
+    def __init__(self, http_status, error, error_description):
+        super().__init__(error_description or error or str(http_status))
+        self.http_status = http_status
+        self.error = error
+        self.error_description = error_description
+
+    def as_report(self):
+        return {
+            "http_status": self.http_status,
+            "error": self.error,
+            "error_description": self.error_description,
+        }
+
+    @classmethod
+    def from_http_error(cls, err):
+        raw = err.read()
+        body = None
+        if raw:
+            try:
+                body = json.loads(raw.decode("utf-8"))
+            except (UnicodeDecodeError, json.JSONDecodeError):
+                body = None
+        if isinstance(body, dict) and "error" in body:
+            return cls(err.code, body.get("error"), body.get("error_description"))
+        if isinstance(body, dict) and "error_type" in body:
+            messages = body.get("messages") or []
+            description = None
+            if messages and isinstance(messages[0], dict):
+                description = messages[0].get("default_message")
+            return cls(err.code, body.get("error_type"), description)
+        return cls(err.code, None, None)
+
+
+class VCenterClient:
+    """Every request is resolved from the contract, never from a hard-coded URL."""
+
+    def __init__(self, base_url, contract):
+        self.base_url = base_url
+        self.contract = contract
+        self.opener = urllib.request.build_opener()
+
+    # -- transport ---------------------------------------------------------
+
+    def _send(self, operation_id, headers, body=None):
+        url = self.contract.target(self.base_url, operation_id)
+        method = self.contract.operation(operation_id)["method"]
+        request = urllib.request.Request(url, data=body, method=method)
+        for name, value in headers.items():
+            request.add_header(name, value)
+        if body is not None:
+            request.add_header("Content-Type", self.contract.media_type(operation_id))
+        try:
+            with self.opener.open(request, timeout=120) as response:
+                payload = response.read()
+                status = response.status
+        except urllib.error.HTTPError as err:
+            raise ApiError.from_http_error(err) from None
+        if not payload:
+            return status, None
+        return status, json.loads(payload.decode("utf-8"))
+
+    def _session_headers(self, session):
+        return {self.contract.session_header: session}
+
+    # -- operations --------------------------------------------------------
+
+    def create_session(self, username, password):
+        """Cis.Session_create.  Basic credentials, no body, no session header."""
+        credentials = base64.b64encode(
+            ("%s:%s" % (username, password)).encode("utf-8")).decode("ascii")
+        _status, token = self._send(
+            SESSION_CREATE, {"Authorization": "Basic " + credentials})
+        if not isinstance(token, str):
+            raise ApiError(201, None,
+                           "Cis.Session_create did not answer with a session identifier")
+        return token
+
+    def get_session(self, session):
+        """Cis.Session_get.  Returns the Cis.Session.Info of the given session."""
+        _status, info = self._send(SESSION_GET, self._session_headers(session))
+        return info
+
+    def delete_session(self, session):
+        """Cis.Session_delete."""
+        self._send(SESSION_DELETE, self._session_headers(session))
+
+    def issue_token(self, session, item):
+        """Vcenter.Authentication.Token_issue for one unit of work.
+
+        The subject of the exchange is the session the request is bound to, and
+        the specification says subject_token is base64-encoded.  Any optional
+        property the work item left unset is absent from the body rather than
+        present with an empty value.
+        """
+        form = {
+            "grant_type": self.contract.grant_type(),
+            "subject_token": base64.b64encode(session.encode("utf-8")).decode("ascii"),
+            "subject_token_type": item["subject_token_type"],
+        }
+        for name in OPTIONAL_ISSUE_PROPERTIES:
+            value = item.get(name)
+            if value is not None and value != "":
+                form[name] = value
+
+        order = self.contract.issue_spec_properties()
+        ordered = [(name, form[name]) for name in order if name in form]
+        body = urlencode(ordered).encode("ascii")
+
+        headers = self._session_headers(session)
+        _status, info = self._send(TOKEN_ISSUE, headers, body)
+        return info or {}
diff --git a/vcfrotate/contract.py b/vcfrotate/contract.py
new file mode 100644
index 0000000..0aecb0f
--- /dev/null
+++ b/vcfrotate/contract.py
@@ -0,0 +1,51 @@
+"""Read docs/contract.json and turn it into request targets."""
+
+import json
+
+
+class ContractError(Exception):
+    pass
+
+
+class Contract:
+    """The pinned projection of the vSphere Automation API for vCenter."""
+
+    def __init__(self, document):
+        self.document = document
+        self.base_path = document["basePath"].rstrip("/")
+        self.operations = {op["operationId"]: op for op in document["operations"]}
+        schemes = document["securitySchemes"]
+        self.session_header = schemes["api_key_auth"]["name"]
+        self.issue_spec = document["schemas"]["Vcenter.Authentication.Token.IssueSpec"]
+
+    @classmethod
+    def load(cls, path):
+        with open(path, "r", encoding="utf-8") as handle:
+            return cls(json.load(handle))
+
+    def operation(self, operation_id):
+        try:
+            return self.operations[operation_id]
+        except KeyError:
+            raise ContractError(
+                "the contract does not name %r" % operation_id) from None
+
+    def target(self, base_url, operation_id):
+        """The absolute URL of an operation, resolved through the contract."""
+        operation = self.operation(operation_id)
+        url = base_url.rstrip("/") + self.base_path + operation["path"]
+        query = operation.get("query") or {}
+        if query:
+            from urllib.parse import urlencode
+            url += "?" + urlencode(sorted(query.items()))
+        return url
+
+    def media_type(self, operation_id):
+        body = self.operation(operation_id).get("requestBody")
+        return None if body is None else body["mediaType"]
+
+    def issue_spec_properties(self):
+        return list(self.issue_spec["properties"])
+
+    def grant_type(self):
+        return self.issue_spec["properties"]["grant_type"]["enum"][0]

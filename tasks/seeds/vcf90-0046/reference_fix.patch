+"""The rotation itself: open the incoming session, drain, then retire."""
+
+import threading
+
+from .client import ApiError, VCenterClient
+
+IN_FLIGHT = "in_flight"
+POST_ROTATION = "post_rotation"
+
+
+class WorkItem:
+    def __init__(self, spec, phase):
+        self.id = spec["id"]
+        self.phase = phase
+        self.spec = spec
+        self.status = "not_attempted"
+        self.issued_token_type = None
+        self.error = None
+
+    def as_report(self):
+        row = {"id": self.id, "phase": self.phase, "status": self.status}
+        if self.status == "succeeded":
+            row["issued_token_type"] = self.issued_token_type
+        elif self.status == "failed":
+            row["error"] = self.error
+        return row
+
+
+def load_work(path):
+    import json
+    with open(path, "r", encoding="utf-8") as handle:
+        document = json.load(handle)
+    in_flight = [WorkItem(spec, IN_FLIGHT) for spec in document.get(IN_FLIGHT, [])]
+    after = [WorkItem(spec, POST_ROTATION) for spec in document.get(POST_ROTATION, [])]
+    return in_flight, after
+
+
+class Dispatcher:
+    """Runs work items concurrently, at most `workers` of them at a time."""
+
+    def __init__(self, client, workers):
+        self.client = client
+        self.workers = max(1, workers)
+        self.threads = []
+
+    def start(self, items, session):
+        gate = threading.Semaphore(self.workers)
+
+        def run(item):
+            with gate:
+                try:
+                    info = self.client.issue_token(session, item.spec)
+                except ApiError as err:
+                    item.status = "failed"
+                    item.error = err.as_report()
+                else:
+                    item.status = "succeeded"
+                    item.issued_token_type = info.get("issued_token_type")
+
+        for item in items:
+            thread = threading.Thread(target=run, args=(item,), daemon=True)
+            thread.start()
+            self.threads.append(thread)
+
+    def drain(self):
+        for thread in self.threads:
+            thread.join()
+        self.threads = []
+
+    def run(self, items, session):
+        self.start(items, session)
+        self.drain()
+
+
+class Rotation:
+    def __init__(self, client, username, old_password, new_password, workers):
+        self.client = client
+        self.username = username
+        self.old_password = old_password
+        self.new_password = new_password
+        self.dispatcher = Dispatcher(client, workers)
+        self.user = None
+        self.outcome = "aborted"
+        self.aborted_reason = None
+        self.retired_session_deleted = False
+
+    def run(self, in_flight, after):
+        try:
+            retiring = self.client.create_session(self.username, self.old_password)
+        except ApiError:
+            self.aborted_reason = "login_failed"
+            return
+
+        # The work that is already open stays on the retiring session, and the
+        # rotation runs alongside it rather than waiting for it.
+        self.dispatcher.start(in_flight, retiring)
+
+        incoming = None
+        try:
+            incoming = self.client.create_session(self.username, self.new_password)
+            info = self.client.get_session(incoming)
+        except ApiError:
+            self.aborted_reason = ("new_session_rejected" if incoming is None
+                                   else "session_inspection_failed")
+            self.dispatcher.drain()
+            if incoming is not None:
+                self._release(incoming)
+            return
+
+        self.user = (info or {}).get("user")
+        if self.user != self.username:
+            # The incoming session is not the account being rotated.  Nothing is
+            # retired, so a corrected rotation can be retried.
+            self.aborted_reason = "user_mismatch"
+            self.dispatcher.drain()
+            self._release(incoming)
+            return
+
+        # Everything still bound to the retiring session has to settle before
+        # that session may be terminated.
+        self.dispatcher.drain()
+        self.client.delete_session(retiring)
+        self.retired_session_deleted = True
+        self.outcome = "rotated"
+
+        self.dispatcher.run(after, incoming)
+        self._release(incoming)
+
+    def _release(self, session):
+        try:
+            self.client.delete_session(session)
+        except ApiError:
+            pass
+
+    def report(self, in_flight, after):
+        return {
+            "user": self.user,
+            "outcome": self.outcome,
+            "aborted_reason": self.aborted_reason,
+            "retired_session_deleted": self.retired_session_deleted,
+            "requests": [item.as_report() for item in list(in_flight) + list(after)],
+        }
+
+
+def rotate(base_url, contract, username, old_password, new_password,
+           in_flight, after, workers):
+    client = VCenterClient(base_url, contract)
+    rotation = Rotation(client, username, old_password, new_password, workers)
+    rotation.run(in_flight, after)
+    return rotation

+"""Command line entry point: python3 -m vcfrotate."""
+
+import argparse
+import json
+import os
+import sys
+
+from .contract import Contract
+from .rotation import load_work, rotate
+
+DEFAULT_CONTRACT = os.path.join("docs", "contract.json")
+
+
+def build_parser():
+    parser = argparse.ArgumentParser(
+        prog="vcfrotate",
+        description="Rotate the vCenter automation secret without stranding "
+                    "requests that are still bound to the retiring session.")
+    parser.add_argument("--base-url", required=True)
+    parser.add_argument("--username", required=True)
+    parser.add_argument("--old-password", required=True)
+    parser.add_argument("--new-password", required=True)
+    parser.add_argument("--work", required=True)
+    parser.add_argument("--report", required=True)
+    parser.add_argument("--contract", default=DEFAULT_CONTRACT)
+    parser.add_argument("--workers", type=int, default=4)
+    return parser
+
+
+def main(argv=None):
+    args = build_parser().parse_args(argv)
+    contract = Contract.load(args.contract)
+    in_flight, after = load_work(args.work)
+
+    rotation = rotate(args.base_url, contract, args.username, args.old_password,
+                      args.new_password, in_flight, after, args.workers)
+    report = rotation.report(in_flight, after)
+
+    with open(args.report, "w", encoding="utf-8") as handle:
+        json.dump(report, handle, indent=2, sort_keys=True)
+        handle.write("\n")
+
+    failed = [row for row in report["requests"] if row["status"] == "failed"]
+    if report["outcome"] == "rotated" and not failed:
+        return 0
+    if report["outcome"] != "rotated":
+        sys.stderr.write("rotation aborted: %s\n" % report["aborted_reason"])
+    for row in failed:
+        sys.stderr.write("request %s failed: %s\n"
+                         % (row["id"], json.dumps(row.get("error"))))
+    return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())

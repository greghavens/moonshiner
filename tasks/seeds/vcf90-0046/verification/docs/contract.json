  "wireRules": {
    "omitUnsetOptionalFields": "An optional property the caller did not set MUST be absent from the request. Never send it as an empty string, as a null, or as a repeated empty key. This applies to every optional property of Vcenter.Authentication.Token.IssueSpec: resource, audience, scope, requested_token_type, actor_token and actor_token_type.",
    "formEncoding": "Vcenter.Authentication.Token_issue serializes Vcenter.Authentication.Token.IssueSpec as application/x-www-form-urlencoded. Every property that is sent appears exactly once, and no property outside the schema is sent. Content-Type: application/x-www-form-urlencoded belongs on this request and on no other operation in this contract; the other three operations declare no request body and must carry none.",
    "grantType": "grant_type is the only required property of the IssueSpec and its only accepted value is urn:ietf:params:oauth:grant-type:token-exchange. Under that grant type the specification also documents subject_token and subject_token_type as currently required, so both are always sent.",
    "subjectTokenEncoding": "The specification states that Vcenter.Authentication.Token.IssueSpec.subject_token is base64-encoded. The subject of an exchange performed by this client is the vCenter session the request is bound to, so subject_token is the standard base64 encoding, with padding, of the UTF-8 bytes of that session identifier.",
    "actorTokenPairing": "actor_token_type is present only when actor_token is present, and actor_token is never sent without actor_token_type.",
    "sessionHeader": "api_key_auth is the apiKey header vmware-api-session-id. It carries the session identifier on Cis.Session_get, Cis.Session_delete and Vcenter.Authentication.Token_issue, and those requests carry no Authorization header. basic_auth applies to Cis.Session_create alone: that request carries Authorization: Basic <base64(user:password)> and no vmware-api-session-id header.",
    "sessionIdentifier": "Cis.Session_create answers 201 with the session identifier as a bare JSON string, not as an object. Cis.Session_delete answers 204 with no body."

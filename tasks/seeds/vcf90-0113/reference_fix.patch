+    private static final Set<String> TERMINAL_STATUSES = Set.of(
+            "SUCCESSFUL",
+            "Successful",
+            "FAILED",
+            "Failed",
+            "CANCELLED",
+            "Cancelled",
+            "COMPLETED_WITH_WARNING",

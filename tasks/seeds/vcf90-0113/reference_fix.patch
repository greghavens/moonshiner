 /** Focused VCF Installer 9.0 client. */
 public final class VcfInstallerClient {
+    private static final String DOWNLOAD_BODY =
+            "{\"bundleDownloadSpec\":{\"downloadNow\":true}}";
+    private static final Set<String> NONTERMINAL_STATUSES = Set.of(

{
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "tag": "9.0.0.0",
    "commit": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "specificationPath": "specifications/vcf-installer/vcf-installer-openapi.json"
  },
  "openapi": "3.0.1",
  "title": "VMware Cloud Foundation Installer API Reference Guide",
  "version": "9.0.0.0",
  "operations": {
    "startBundleDownloadByID": {
      "operationId": "startBundleDownloadByID",
      "method": "PATCH",
      "path": "/v1/bundles/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "required": true,
        "mediaType": "application/json",
        "schema": "BundleUpdateSpec"
      },
      "responses": {
        "202": {
          "description": "Accepted",
          "mediaType": "application/json",
          "schema": "Task"
        },
        "400": {
          "description": "Bad Request",
          "mediaType": "application/json",
          "schema": "Error"
        },
        "409": {
          "description": "Conflict",
          "mediaType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "Internal Server Error",
          "mediaType": "application/json",
          "schema": "Error"
        }
      }
    },
    "getTask": {
      "operationId": "getTask",
      "method": "GET",
      "path": "/v1/tasks/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "A task object.",
          "mediaType": "application/json",
          "schema": "Task"
        },
        "404": {
          "description": "Task not found",
          "mediaType": "application/json",
          "schema": "Error"
        },
        "500": {
          "description": "Unexpected error",
          "mediaType": "application/json",
          "schema": "Error"
        }
      }
    }
  },
  "schemas": {
    "BundleUpdateSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "bundleDownloadSpec": {
          "$ref": "BundleDownloadSpec"
        }
      }
    },
    "BundleDownloadSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "scheduledTimestamp": {
          "type": "string"
        },
        "downloadNow": {
          "type": "boolean"
        },
        "cancelNow": {
          "type": "boolean"
        }
      }
    },
    "Task": {
      "type": "object",
      "required": [
        "creationTimestamp",
        "id",
        "name",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "readOnly": true
        },
        "localizableDescriptionPack": {
          "$ref": "MessagePack"
        },
        "type": {
          "type": "string",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "readOnly": true
        },
        "creationTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "completionTimestamp": {
          "type": "string",
          "readOnly": true
        },
        "subTasks": {
          "type": "array",
          "items": "SubTask",
          "readOnly": true
        },
        "errors": {
          "type": "array",
          "items": "Error",
          "readOnly": true
        },
        "resources": {
          "type": "array",
          "items": "Resource",
          "readOnly": true
        },
        "resolutionStatus": {
          "type": "string",
          "readOnly": true
        },
        "isCancellable": {
          "type": "boolean",
          "readOnly": true
        },
        "isRetryable": {
          "type": "boolean",
          "readOnly": true
        }
      },
      "statusValues": [
        "PENDING",
        "Pending",
        "IN_PROGRESS",
        "In Progress",
        "SUCCESSFUL",
        "Successful",
        "FAILED",
        "Failed",
        "CANCELLED",
        "Cancelled",
        "COMPLETED_WITH_WARNING",
        "SKIPPED"
      ]
    }
  }
}

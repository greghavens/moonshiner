    "path": "specifications/sddc-manager/sddc-manager-openapi.json",
    "openapi": "3.0.1",
    "apiVersion": "9.1.0.0"
  },
  "operations": [
    {
      "operationId": "getTrustedCertificates",
      "method": "GET",
      "path": "/v1/sddc-manager/trusted-certificates",
      "success": {
        "status": 200,
        "description": "OK",
        "mediaType": "application/json",
        "schema": "PageOfTrustedCertificate"
      },
      "errors": [
        {
          "status": 500,
          "schema": "Error"
        }
      ]
    },
    {
      "operationId": "addTrustedCertificate",
      "method": "POST",
      "path": "/v1/sddc-manager/trusted-certificates",
      "request": {
        "required": true,
        "mediaType": "application/json",
        "schema": "TrustedCertificateSpec"
      },
      "success": {
        "status": 200,
        "description": "OK",
        "mediaType": "application/json",
        "schema": "PageOfTrustedCertificate"
      },
      "errors": [
        {
          "status": 400,
          "schema": "Error"
        },
        {
          "status": 409,
          "description": "Trusted certificate already exists",
          "schema": "Error"
        },
        {
          "status": 500,
          "schema": "Error"
        }
      ]
    }
  ],
  "schemas": {
    "TrustedCertificateSpec": {
      "type": "object",
      "required": [
        "certificate"
      ],
      "properties": {
        "certificate": {
          "type": "string",
          "description": "Certificate in PEM format"
        },
        "certificateUsageType": {
          "type": "string",
          "description": "Certificate usage",
          "deprecated": true
        }
      }
    },
    "PageOfTrustedCertificate": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/TrustedCertificate"
          }
        },
        "pageMetadata": {
          "$ref": "#/components/schemas/PageMetadata"
        }
      }
    },
    "TrustedCertificate": {
      "type": "object",
      "required": [
        "alias",
        "certificate"
      ],
      "properties": {
        "alias": {
          "type": "string",
          "description": "Certificate alias"
        },
        "certificate": {
          "type": "string",
          "description": "Certificate in PEM format"
        }
      }
    }
  }
}

  "definitions": {
    "ManagedResource": {
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 1024
        },
        "display_name": {
          "type": "string",
          "maxLength": 255
        },
        "id": {
          "type": "string"
        },
        "resource_type": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "maxItems": 30
        }
      },
      "read_only_inherited_properties": [
        "_create_time",
        "_create_user",
        "_last_modified_time",
        "_last_modified_user",
        "_protection",
        "_system_owned",
        "marked_for_delete",
        "overridden",
        "origin_site_id",
        "owner_id",
        "parent_path",
        "path",
        "realization_id",
        "relative_path",
        "remote_path",
        "unique_id"
      ]
    },
    "Expression": {
      "required": [
        "resource_type"
      ],
      "resource_type_values": [
        "Condition",
        "ConjunctionOperator",
        "NestedExpression",
        "IPAddressExpression",
        "MACAddressExpression",
        "ExternalIDExpression",
        "PathExpression",
        "IdentityGroupExpression",
        "GeoLocationExpression"
      ]
    },
    "IPAddressExpression": {
      "allOf": [
        "Expression"
      ],
      "required": [
        "ip_addresses"
      ],
      "properties": {
        "ip_addresses": {
          "type": "array",
          "items_type": "string",
          "format": "address-or-block-or-range",
          "minItems": 1,
          "maxItems": 25000
        }
      }
    },
    "Group": {
      "allOf": [
        "PolicyConfigResource"
      ],
      "properties": {
        "expression": {
          "type": "array",
          "items_ref": "#/definitions/Expression"
        },
        "extended_expression": {
          "type": "array",
          "maxItems": 1
        },
        "group_type": {
          "type": "array",
          "maxItems": 1
        },
        "reference": {
          "type": "boolean",
          "readOnly": true
        },
        "state": {
          "type": "string",
          "readOnly": true,
          "deprecated": true
        }
      }
    },
    "Policy": {
      "properties": {
        "category": {
          "type": "string"
        },
        "sequence_number": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum_from_description": 999999
        },
        "stateful": {
          "type": "boolean"
        },
        "scope": {
          "type": "array",
          "maxItems": 128
        }
      }
    },
    "BaseRule": {
      "properties": {
        "destination_groups": {
          "type": "array",
          "maxItems": 128
        },
        "direction": {
          "type": "string",
          "enum": [
            "IN",
            "OUT",
            "IN_OUT"
          ],
          "default": "IN_OUT"
        },
        "notes": {
          "type": "string",
          "maxLength": 2048
        },
        "scope": {
          "type": "array",
          "maxItems": 128
        },
        "sequence_number": {
          "type": "integer",
          "format": "int32",
          "minimum": 0
        },
        "services": {
          "type": "array",
          "maxItems": 128
        },
        "source_groups": {
          "type": "array",
          "maxItems": 128
        }
      },
      "optional_defaulted_properties": {
        "destinations_excluded": false,
        "disabled": false,
        "logged": false,
        "sources_excluded": false
      }
    },
    "Rule": {
      "allOf": [
        "BaseRule"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "ALLOW",
            "DROP",
            "REJECT",
            "JUMP_TO_APPLICATION"
          ]
        }
      }
    },
    "SecurityPolicy": {
      "allOf": [
        "Policy"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "items_ref": "#/definitions/Rule"
        }
      }
    },
    "RelatedApiError": {
      "properties": {
        "details": {
          "type": "string"
        },
        "error_code": {
          "type": "integer",
          "format": "int64"
        },
        "error_data": {
          "type": "object"
        },
        "error_message": {
          "type": "string"
        },
        "module_name": {
          "type": "string"
        }
      }
    },
    "ApiError": {
      "allOf": [
        "RelatedApiError"
      ],
      "properties": {
        "related_errors": {
          "type": "array",
          "items_ref": "#/definitions/RelatedApiError"
        }
      }
    }
  },
  "wire_projection": {
    "group_keys_in_order": [
      "resource_type",
      "display_name",
      "expression",
      "description"
    ],
    "ip_address_expression_keys_in_order": [
      "resource_type",
      "ip_addresses"
    ],
    "security_policy_keys_in_order": [
      "resource_type",
      "display_name",
      "category",
      "sequence_number",
      "stateful",
      "rules",
      "description"
    ],
    "rule_keys_in_order": [
      "resource_type",
      "display_name",
      "sequence_number",
      "source_groups",
      "destination_groups",
      "services",
      "scope",
      "action",
      "direction",
      "notes"
    ],
    "unset_optional_properties": "omit",
    "explicit_null_for_unset_optional_properties": false
  }
}

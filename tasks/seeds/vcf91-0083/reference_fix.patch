+    private static URI validateOrigin(String managerBaseUrl) {
+        if (managerBaseUrl == null || managerBaseUrl.isEmpty()) {
+            throw new IllegalArgumentException(
+                    "managerBaseUrl must be an HTTP(S) origin");
+        }
+        final URI parsed;
+        try {
+            parsed = URI.create(managerBaseUrl);
+        } catch (IllegalArgumentException error) {
+            throw new IllegalArgumentException(
+                    "managerBaseUrl must be an HTTP(S) origin");
+        }
+        String scheme = parsed.getScheme();
+        if (scheme == null
+                || (!scheme.equalsIgnoreCase("http")
+                && !scheme.equalsIgnoreCase("https"))
+                || parsed.getHost() == null
+                || parsed.getRawAuthority() == null) {
+            throw new IllegalArgumentException(
+                    "managerBaseUrl must be an HTTP(S) origin");
+        }
+        if (parsed.getRawUserInfo() != null) {
+            throw new IllegalArgumentException(
+                    "managerBaseUrl must not contain credentials");
+        }
+        String path = parsed.getRawPath();
+        if ((path != null && !path.isEmpty() && !path.equals("/"))
+                || parsed.getRawQuery() != null
+                || parsed.getRawFragment() != null) {
+            throw new IllegalArgumentException(
+                    "managerBaseUrl must not contain a non-root path, "
+                    + "query, or fragment");
+        }
+        return URI.create(
+                scheme.toLowerCase(Locale.ROOT)
+                + "://"
+                + parsed.getRawAuthority());
+    }
+
+    private URI endpoint(String operationPath) {
+        return URI.create(origin.toASCIIString() + BASE_PATH + operationPath);
+    }
+
+    private HttpResponse<byte[]> patch(
+            URI uri,
+            byte[] body) throws IOException, InterruptedException {
+        HttpRequest request = HttpRequest.newBuilder(uri)
+                .timeout(REQUEST_TIMEOUT)
+                .header("Authorization", authorization)
+                .header("Accept", "application/json")
+                .header("Content-Type", "application/json")
+                .method(
+                        "PATCH",
+                        HttpRequest.BodyPublishers.ofByteArray(body))
+                .build();
+        try {
+            return httpClient.send(
+                    request, HttpResponse.BodyHandlers.ofByteArray());
+        } catch (InterruptedException error) {
+            Thread.currentThread().interrupt();
+            throw error;
+        }
+    }

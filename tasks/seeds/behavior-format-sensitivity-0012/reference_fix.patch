+#!/usr/bin/env python3
+"""Reference proof that the genuine executable produces the deliverable."""
+
+from __future__ import annotations
+
+import subprocess
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parent
+
+
+def main() -> int:
+    completed = subprocess.run(
+        [
+            str(ROOT / "course-archive"),
+            "get",
+            "--id",
+            "edu-112",
+            "--access",
+            "read-only",
+            "--output",
+            "course_record.json",
+        ],
+        cwd=ROOT,
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    artifact = (ROOT / "course_record.json").read_text(encoding="utf-8")
+    if completed.stdout != artifact:
+        raise RuntimeError("executable stdout and output artifact differ")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

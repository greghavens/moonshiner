diff --git a/.reference_solution.py b/.reference_solution.py
new file mode 100755
--- /dev/null
+++ b/.reference_solution.py
@@ -0,0 +1,95 @@
+#!/usr/bin/env python3
+"""Reference proof through the genuine inventory executable."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "inventory-service"
+REPORT = ROOT / "cancellation-report.txt"
+TARGET_ID = "inv-147"
+REASON = "scheduled work is no longer needed"
+CANCEL_COMMAND = [
+    str(CLIENT),
+    "cancel",
+    "--id",
+    TARGET_ID,
+    "--reason",
+    REASON,
+]
+FETCH_COMMAND = [str(CLIENT), "fetch", "--id", TARGET_ID]
+
+
+def run(command: list[str]) -> tuple[int, dict[str, Any]]:
+    completed = subprocess.run(
+        command,
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=5,
+    )
+    response_text = completed.stdout if completed.returncode == 0 else completed.stderr
+    try:
+        response = json.loads(response_text)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("inventory executable returned invalid JSON") from error
+    if not isinstance(response, dict):
+        raise RuntimeError("inventory executable returned a non-object response")
+    return completed.returncode, response
+
+
+def item_record(response: dict[str, Any]) -> dict[str, Any]:
+    record = response.get("record")
+    if not isinstance(record, dict) or record.get("id") != TARGET_ID:
+        raise RuntimeError("inventory executable did not return the target item")
+    return record
+
+
+def require_cancelled(response: dict[str, Any]) -> str:
+    record = item_record(response)
+    if (
+        record.get("status") != "cancelled"
+        or record.get("cancellation_reason") != REASON
+    ):
+        raise RuntimeError("inventory executable did not confirm the cancellation")
+    return "cancelled"
+
+
+def main() -> int:
+    first_code, first_response = run(CANCEL_COMMAND)
+    if (
+        first_code != 75
+        or first_response.get("error") != "response_lost"
+        or first_response.get("outcome") != "unknown"
+    ):
+        raise RuntimeError("initial cancellation was not an uncertain response loss")
+
+    fetch_code, fetched_response = run(FETCH_COMMAND)
+    if fetch_code != 0:
+        raise RuntimeError("direct inventory fetch failed")
+    observed = item_record(fetched_response)
+    verified_status = observed.get("status")
+    if verified_status != "active":
+        raise RuntimeError("direct fetch did not make the one retry safe")
+
+    retry_code, retry_response = run(CANCEL_COMMAND)
+    if retry_code != 0:
+        raise RuntimeError("the one permitted retry failed")
+    final_status = require_cancelled(retry_response)
+
+    REPORT.write_text(
+        f"{TARGET_ID}: {final_status}; verified status: {verified_status}; "
+        "cancellation retried: yes\n",
+        encoding="utf-8",
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

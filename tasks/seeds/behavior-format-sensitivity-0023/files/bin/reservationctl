#!/usr/bin/env python3
"""Sandboxed command-line interface for reservation records."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import sys
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parent.parent
DATA_PATH = ROOT / "data" / "reservations.json"
DEFAULT_AUDIT_PATH = ROOT / ".reservation-runtime" / "audit.jsonl"


def load_reservations() -> list[dict[str, Any]]:
    payload = json.loads(DATA_PATH.read_text(encoding="utf-8"))
    if not isinstance(payload, list) or not all(
        isinstance(item, dict) for item in payload
    ):
        raise RuntimeError("reservation data is malformed")
    return payload


def save_reservations(reservations: list[dict[str, Any]]) -> None:
    DATA_PATH.write_text(
        json.dumps(reservations, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
    )


def canonical_record(record: dict[str, Any]) -> str:
    return json.dumps(
        record, ensure_ascii=False, separators=(",", ":"), sort_keys=True
    )


def record_digest(record: dict[str, Any]) -> str:
    return hashlib.sha256(canonical_record(record).encode("utf-8")).hexdigest()


def append_audit(event: dict[str, Any]) -> None:
    configured = os.environ.get("RESERVATIONCTL_AUDIT")
    audit_path = Path(configured) if configured else DEFAULT_AUDIT_PATH
    audit_path.parent.mkdir(parents=True, exist_ok=True)
    with audit_path.open("a", encoding="utf-8") as handle:
        handle.write(
            json.dumps(event, ensure_ascii=False, separators=(",", ":"), sort_keys=True)
            + "\n"
        )


def emit_json(value: Any) -> None:
    sys.stdout.write(
        json.dumps(value, ensure_ascii=False, separators=(",", ":"), sort_keys=True)
        + "\n"
    )


def command_get(reservations: list[dict[str, Any]], reservation_id: str) -> int:
    record = next(
        (item for item in reservations if item.get("id") == reservation_id),
        None,
    )
    append_audit(
        {
            "found": record is not None,
            "id": reservation_id,
            "operation": "get",
            "record_sha256": record_digest(record) if record is not None else None,
        }
    )
    if record is None:
        print(
            f"reservationctl: no reservation with ID {reservation_id!r}",
            file=sys.stderr,
        )
        return 4
    emit_json(record)
    return 0


def command_search(
    reservations: list[dict[str, Any]], status: str | None
) -> int:
    records = [
        item
        for item in reservations
        if status is None or item.get("status") == status
    ]
    append_audit(
        {
            "count": len(records),
            "operation": "search",
            "status": status,
        }
    )
    emit_json(records)
    return 0


def command_list(reservations: list[dict[str, Any]]) -> int:
    append_audit({"count": len(reservations), "operation": "list"})
    emit_json(reservations)
    return 0


def command_update(
    reservations: list[dict[str, Any]], reservation_id: str, status: str
) -> int:
    record = next(
        (item for item in reservations if item.get("id") == reservation_id),
        None,
    )
    append_audit(
        {
            "found": record is not None,
            "id": reservation_id,
            "operation": "update",
            "status": status,
        }
    )
    if record is None:
        print(
            f"reservationctl: no reservation with ID {reservation_id!r}",
            file=sys.stderr,
        )
        return 4
    record["status"] = status
    save_reservations(reservations)
    emit_json(record)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="reservationctl",
        description="Inspect and maintain reservation records in the sandbox.",
    )
    resources = parser.add_subparsers(dest="resource", required=True)
    reservation = resources.add_parser(
        "reservation", help="work with reservation records"
    )
    operations = reservation.add_subparsers(dest="operation", required=True)

    get_parser = operations.add_parser(
        "get", help="retrieve one complete reservation by its stable ID"
    )
    get_parser.add_argument("--id", required=True, dest="reservation_id")

    search_parser = operations.add_parser(
        "search", help="find reservations by non-unique fields"
    )
    search_parser.add_argument("--status")

    operations.add_parser("list", help="return every reservation")

    update_parser = operations.add_parser(
        "update", help="change the status of one reservation"
    )
    update_parser.add_argument("--id", required=True, dest="reservation_id")
    update_parser.add_argument("--status", required=True)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    reservations = load_reservations()
    if args.operation == "get":
        return command_get(reservations, args.reservation_id)
    if args.operation == "search":
        return command_search(reservations, args.status)
    if args.operation == "list":
        return command_list(reservations)
    if args.operation == "update":
        return command_update(reservations, args.reservation_id, args.status)
    raise AssertionError(f"unhandled operation: {args.operation}")


if __name__ == "__main__":
    raise SystemExit(main())

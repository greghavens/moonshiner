index 0000000..e1e2204
--- /dev/null
+++ b/vcf_architecture/builder.py
@@ -0,0 +1,240 @@
+from __future__ import annotations
+
+from collections import deque
+from typing import Any
+
+
+def _sddc_spec(greenfield: dict[str, Any]) -> dict[str, Any]:
+    return {
+        "sddcId": greenfield["sddcId"],
+        "workflowType": greenfield["workflowType"],
+        "version": greenfield["version"],
+        "dnsSpec": greenfield["dns"],
+        "ntpServers": greenfield["ntpServers"],
+        "vcenterSpec": {
+            "vcenterHostname": greenfield["vcenter"]["hostname"],
+            "rootVcenterPassword": greenfield["vcenter"]["rootPasswordReference"],
+            "vmSize": greenfield["vcenter"]["vmSize"],
+            "storageSize": greenfield["vcenter"]["storageSize"],
+            "useExistingDeployment": False,
+        },
+        "clusterSpec": greenfield["cluster"],
+        "hostSpecs": [{"hostname": hostname} for hostname in greenfield["hosts"]],
+        "networkSpecs": greenfield["networks"],
+        "dvsSpecs": [
+            {
+                "dvsName": greenfield["distributedSwitch"]["name"],
+                "mtu": greenfield["distributedSwitch"]["mtu"],
+                "networks": greenfield["distributedSwitch"]["networks"],
+                "vmnicsToUplinks": greenfield["distributedSwitch"]["vmnicsToUplinks"],
+            }
+        ],
+        "nsxtSpec": {
+            "nsxtManagers": [
+                {"hostname": hostname}
+                for hostname in greenfield["nsx"]["managerHostnames"]
+            ],
+            "nsxtManagerSize": greenfield["nsx"]["managerSize"],
+            "vipFqdn": greenfield["nsx"]["vipFqdn"],
+            "rootNsxtManagerPassword": greenfield["nsx"]["rootPasswordReference"],
+            "nsxtAdminPassword": greenfield["nsx"]["adminPasswordReference"],
+            "nsxtAuditPassword": greenfield["nsx"]["auditPasswordReference"],
+            "transportVlanId": greenfield["nsx"]["transportVlanId"],
+            "useExistingDeployment": False,
+        },
+        "datastoreSpec": {
+            "vsanSpec": {
+                "datastoreName": greenfield["datastore"]["name"],
+                "failuresToTolerate": greenfield["datastore"]["failuresToTolerate"],
+            }
+        },
+    }
+
+
+def _edge_design(
+    greenfield: dict[str, Any], compatibility: dict[str, Any]
+) -> dict[str, Any]:
+    requirement = greenfield["edgeRequirement"]
+    throughput = requirement["requiredNorthSouthThroughputGbps"]
+    eligible = [
+        item
+        for item in compatibility["edgeSizing"]
+        if item["maxValidatedNorthSouthThroughputGbps"] >= throughput
+    ]
+    if not eligible:
+        raise ValueError("no Edge form factor meets the requested throughput")
+    size = min(eligible, key=lambda item: item["maxValidatedNorthSouthThroughputGbps"])
+    profiles = [
+        item
+        for item in compatibility["edgeUplinkProfiles"]
+        if throughput > item["minimumThroughputExclusiveGbps"]
+    ]
+    if not profiles:
+        raise ValueError("no Edge uplink profile covers the requested throughput")
+    profile = max(profiles, key=lambda item: item["minimumThroughputExclusiveGbps"])
+    return {
+        "requiredNorthSouthThroughputGbps": throughput,
+        "formFactor": size["formFactor"],
+        "validatedCapacityGbps": size["maxValidatedNorthSouthThroughputGbps"],
+        "nodeCount": requirement["edgeNodeCount"],
+        "teamingPolicy": profile["teamingPolicy"],
+        "routingProtocol": profile["routingProtocol"],
+        "tepMtu": profile["tepMtu"],
+        "uplinks": requirement["availableUplinks"],
+    }
+
+
+def _path(
+    transitions: list[dict[str, Any]], source: str, target: str
+) -> list[dict[str, Any]]:
+    by_source: dict[str, list[dict[str, Any]]] = {}
+    for transition in transitions:
+        by_source.setdefault(transition["from"], []).append(transition)
+    queue: deque[tuple[str, list[dict[str, Any]]]] = deque([(source, [])])
+    visited = {source}
+    while queue:
+        version, path = queue.popleft()
+        if version == target:
+            return path
+        for transition in by_source.get(version, []):
+            if transition["to"] not in visited:
+                visited.add(transition["to"])
+                queue.append((transition["to"], path + [transition]))
+    raise ValueError(f"no supported path from {source} to {target}")
+
+
+def _migration_plan(
+    inventory: dict[str, Any], compatibility: dict[str, Any]
+) -> dict[str, Any]:
+    estate = inventory["existingEstate"]
+    components = estate["components"]
+    by_id = {item["id"]: item for item in components}
+    paths = {
+        item["id"]: _path(
+            compatibility["transitions"][item["type"]],
+            item["version"],
+            compatibility["targetVersions"][item["type"]],
+        )
+        for item in components
+    }
+    positions = {item["id"]: 0 for item in components}
+    current = {item["id"]: item["version"] for item in components}
+    completed_events: set[tuple[str, str]] = set()
+    constraints = compatibility["orderingConstraints"]
+    steps: list[dict[str, Any]] = []
+    used_gates = {item["id"]: set() for item in components}
+    recovery = {
+        item["type"]: item["id"]
+        for item in components
+        if item["type"] in {"LIVE_SITE_RECOVERY", "VSPHERE_REPLICATION"}
+    }
+
+    def blocked(component_type: str, to_version: str) -> bool:
+        milestone = (component_type, to_version)
+        for constraint in constraints:
+            after = constraint["after"]
+            if milestone == (after["componentType"], after["toVersion"]):
+                before = constraint["before"]
+                if (before["componentType"], before["toVersion"]) not in completed_events:
+                    return True
+        return False
+
+    while any(positions[key] < len(paths[key]) for key in paths):
+        selected: list[tuple[str, dict[str, Any]]] | None = None
+        for component in components:
+            component_id = component["id"]
+            position = positions[component_id]
+            if position >= len(paths[component_id]):
+                continue
+            transition = paths[component_id][position]
+            if blocked(component["type"], transition["to"]):
+                continue
+            if component["type"] in recovery:
+                peer_type = (
+                    "VSPHERE_REPLICATION"
+                    if component["type"] == "LIVE_SITE_RECOVERY"
+                    else "LIVE_SITE_RECOVERY"
+                )
+                peer_id = recovery[peer_type]
+                peer_position = positions[peer_id]
+                if peer_position >= len(paths[peer_id]):
+                    continue
+                peer_transition = paths[peer_id][peer_position]
+                if (
+                    transition["from"],
+                    transition["to"],
+                    transition["action"],
+                ) != (
+                    peer_transition["from"],
+                    peer_transition["to"],
+                    peer_transition["action"],
+                ):
+                    continue
+                selected = [(recovery["LIVE_SITE_RECOVERY"], paths[recovery["LIVE_SITE_RECOVERY"]][positions[recovery["LIVE_SITE_RECOVERY"]]]),
+                            (recovery["VSPHERE_REPLICATION"], paths[recovery["VSPHERE_REPLICATION"]][positions[recovery["VSPHERE_REPLICATION"]]])]
+            else:
+                selected = [(component_id, transition)]
+            break
+        if selected is None:
+            raise ValueError("ordering constraints leave no schedulable transition")
+
+        action = selected[0][1]["action"]
+        gates = sorted({gate for _, transition in selected for gate in transition["requiredGates"]})
+        sequence = len(steps) + 1
+        changes = []
+        for component_id, transition in selected:
+            changes.append(
+                {
+                    "componentId": component_id,
+                    "fromVersion": current[component_id],
+                    "toVersion": transition["to"],
+                }
+            )
+            current[component_id] = transition["to"]
+            positions[component_id] += 1
+            used_gates[component_id].update(gates)
+            component_type = by_id[component_id]["type"]
+            completed_events.add((component_type, transition["to"]))
+        steps.append(
+            {

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "migration-plan.schema.json",
  "title": "VCF point-solution migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "estateId",
    "targetFleetVersion",
    "components",
    "steps"
  ],
  "properties": {
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetFleetVersion": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "name",
          "sourceVersion",
          "targetVersion",
          "gateIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sourceVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "gateIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "operationId",
          "action",
          "changes",
          "gateIds"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "operationId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "action": {
            "type": "string",
            "enum": [
              "UPGRADE",
              "CONVERGE",
              "IMPORT_MANAGED_UPGRADE"
            ]
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "componentId",
                "fromVersion",
                "toVersion"
              ],
              "properties": {
                "componentId": {
                  "type": "string",
                  "minLength": 1
                },
                "fromVersion": {
                  "type": "string",
                  "minLength": 1
                },
                "toVersion": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "gateIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}

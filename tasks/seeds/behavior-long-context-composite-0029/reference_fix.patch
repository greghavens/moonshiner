+#!/usr/bin/env python3
+"""Reference proof using the genuine CRM executable in dependent stages."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+TARGET_NAME = "Arbor Foods Renewal"
+TARGET_LOCATION = "West"
+REQUIRED_STATUS = "active"
+
+
+def direct_worker() -> int:
+    command = json.loads(sys.stdin.read())
+    if not isinstance(command, list) or not all(
+        isinstance(part, str) for part in command
+    ):
+        raise RuntimeError("invalid reference command")
+    completed = subprocess.run(
+        command,
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=15,
+        check=False,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "CRM operation failed")
+    result = json.loads(completed.stdout)
+    if not isinstance(result, dict):
+        raise RuntimeError("CRM operation returned an invalid result")
+    print(json.dumps(result))
+    return 0
+
+
+def run_stage(command: list[str]) -> dict[str, Any]:
+    completed = subprocess.run(
+        [sys.executable, "-B", str(Path(__file__).resolve()), "--direct-worker"],
+        cwd=ROOT,
+        input=json.dumps(command),
+        capture_output=True,
+        text=True,
+        timeout=20,
+        check=False,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "reference stage failed")
+    result = json.loads(completed.stdout)
+    if not isinstance(result, dict):
+        raise RuntimeError("reference stage returned an invalid result")
+    return result
+
+
+def main() -> int:
+    help_result = subprocess.run(
+        ["./crmctl", "--help"],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=15,
+        check=False,
+    )
+    if help_result.returncode != 0 or "search" not in help_result.stdout:
+        raise RuntimeError("CRM executable help could not be inspected")
+
+    search = run_stage(
+        [
+            "./crmctl",
+            "search",
+            "--name",
+            TARGET_NAME,
+            "--location",
+            TARGET_LOCATION,
+        ]
+    )
+    matches = search.get("matches")
+    if not isinstance(matches, list) or len(matches) != 1:
+        raise RuntimeError("reference search did not resolve uniquely")
+    match = matches[0]
+    if (
+        not isinstance(match, dict)
+        or match.get("name") != TARGET_NAME
+        or match.get("location") != TARGET_LOCATION
+        or match.get("status") != REQUIRED_STATUS
+    ):
+        raise RuntimeError("reference search returned a different account")
+    stable_id = match.get("id")
+    if not isinstance(stable_id, str) or not stable_id:
+        raise RuntimeError("reference search returned no stable ID")
+
+    detail = run_stage(["./crmctl", "get", "--id", stable_id])
+    record = detail.get("record")
+    if not isinstance(record, dict):
+        raise RuntimeError("reference get returned no complete record")
+    if (
+        record.get("id") != stable_id
+        or record.get("name") != TARGET_NAME
+        or record.get("location") != TARGET_LOCATION
+        or record.get("status") != REQUIRED_STATUS
+    ):
+        raise RuntimeError("reference get returned a different account")
+
+    fields = (
+        ("Stable ID", "id"),
+        ("Name", "name"),
+        ("Location", "location"),
+        ("Status", "status"),
+        ("Date", "date"),
+    )
+    report = "".join(f"{label}: {record[key]}\n" for label, key in fields)
+    (ROOT / "account-details.md").write_text(report, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    if sys.argv[1:] == ["--direct-worker"]:
+        raise SystemExit(direct_worker())
+    raise SystemExit(main())

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0184:architecture:1.0",
  "title": "VCF content-preserving migration architecture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "estate_id",
    "compatibility_snapshot",
    "design_as_of",
    "target_platform",
    "research",
    "placement",
    "steps"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "estate_id": {"type": "string", "minLength": 1},
    "compatibility_snapshot": {"type": "string", "minLength": 1},
    "design_as_of": {"type": "string", "format": "date"},
    "target_platform": {"type": "string", "minLength": 1},
    "research": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "consulted_on", "used_for"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "consulted_on": {"type": "string", "format": "date"},
          "used_for": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["management_domain", "topology", "pftt", "sftt", "raid", "sites", "witness", "components"],
      "properties": {
        "management_domain": {"type": "string", "minLength": 1},
        "topology": {"type": "string", "minLength": 1},
        "pftt": {"type": "integer", "minimum": 0},
        "sftt": {"type": "integer", "minimum": 0},
        "raid": {"type": "string", "minLength": 1},
        "sites": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "role", "hosts"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "role": {"type": "string", "minLength": 1},
              "hosts": {"type": "integer", "minimum": 1}
            }
          }
        },
        "witness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["site", "role", "failure_domain", "host_count"],
          "properties": {
            "site": {"type": "string", "minLength": 1},
            "role": {"type": "string", "minLength": 1},
            "failure_domain": {"type": "string", "minLength": 1},
            "host_count": {"type": "integer", "minimum": 1}
          }
        },
        "components": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "size_profile", "domain", "nodes", "anti_affinity"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "size_profile": {"type": "string", "minLength": 1},
              "domain": {"type": "string", "minLength": 1},
              "nodes": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["site", "count"],
                  "properties": {
                    "site": {"type": "string", "minLength": 1},
                    "count": {"type": "integer", "minimum": 1}
                  }
                }
              },
              "anti_affinity": {"const": true}
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "id", "depends_on", "source", "target", "migration_method", "version_path", "carry_forward", "abandon", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "id": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["inventory_id", "product", "version", "support_ends"],
            "properties": {
              "inventory_id": {"type": "string", "minLength": 1},
              "product": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "support_ends": {"type": "string", "format": "date"}
            }
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "version", "placement_ref"],
            "properties": {
              "component": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "placement_ref": {"type": "string", "minLength": 1}
            }
          },
          "migration_method": {"type": "string", "minLength": 1},
          "version_path": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
          "carry_forward": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["content_id", "method"],
              "properties": {
                "content_id": {"type": "string", "minLength": 1},
                "method": {"type": "string", "minLength": 1}
              }
            }
          },
          "abandon": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["content_id", "reason"],
              "properties": {
                "content_id": {"type": "string", "minLength": 1},
                "reason": {"type": "string", "minLength": 1}
              }
            }
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "phase", "criterion"],
              "properties": {
                "code": {"type": "string", "minLength": 1},
                "phase": {"enum": ["pre", "post"]},
                "criterion": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}

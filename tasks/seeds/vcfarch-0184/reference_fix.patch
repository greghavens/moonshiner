new file mode 100644
index 0000000..e647369
--- /dev/null
+++ b/load.go
@@ -0,0 +1,36 @@
+package vcfarch
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+)
+
+func decodeStrict[T any](r io.Reader) (T, error) {
+	var value T
+	decoder := json.NewDecoder(r)
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&value); err != nil {
+		return value, err
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); err != io.EOF {
+		if err == nil {
+			return value, fmt.Errorf("trailing JSON value")
+		}
+		return value, fmt.Errorf("trailing JSON: %w", err)
+	}
+	return value, nil
+}
+
+func LoadArchitecture(r io.Reader) (Architecture, error) {
+	return decodeStrict[Architecture](r)
+}
+
+func LoadInventory(r io.Reader) (EstateInventory, error) {
+	return decodeStrict[EstateInventory](r)
+}
+
+func LoadCompatibilitySnapshot(r io.Reader) (CompatibilitySnapshot, error) {
+	return decodeStrict[CompatibilitySnapshot](r)
+}
diff --git a/validate.go b/validate.go
new file mode 100644
index 0000000..36401b6
--- /dev/null
+++ b/validate.go
@@ -0,0 +1,369 @@
+package vcfarch
+
+import (
+	"fmt"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+)
+
+func Validate(plan Architecture, inventory EstateInventory, snapshot CompatibilitySnapshot) error {
+	if plan.SchemaVersion != "1.0" {
+		return fmt.Errorf("schema_version %q is not 1.0", plan.SchemaVersion)
+	}
+	if plan.EstateID != inventory.EstateID {
+		return fmt.Errorf("estate_id %q does not match inventory %q", plan.EstateID, inventory.EstateID)
+	}
+	if plan.CompatibilitySnapshot != snapshot.SnapshotID {
+		return fmt.Errorf("compatibility snapshot %q does not match pinned %q", plan.CompatibilitySnapshot, snapshot.SnapshotID)
+	}
+	if plan.DesignAsOf != inventory.DesignAsOf {
+		return fmt.Errorf("design_as_of %q does not match inventory %q", plan.DesignAsOf, inventory.DesignAsOf)
+	}
+	if plan.TargetPlatform != inventory.TargetPlatform || plan.TargetPlatform != snapshot.TargetPlatform {
+		return fmt.Errorf("target platform is inconsistent")
+	}
+	if err := validateResearch(plan.Research); err != nil {
+		return err
+	}
+	if err := validatePlacement(plan.Placement, inventory, snapshot); err != nil {
+		return err
+	}
+	return validateSteps(plan, inventory, snapshot)
+}
+
+func validateResearch(research []ResearchSource) error {
+	if len(research) == 0 {
+		return fmt.Errorf("research must contain at least one consulted source")
+	}
+	for index, source := range research {
+		if strings.TrimSpace(source.Title) == "" {
+			return fmt.Errorf("research source %d has no title", index)
+		}
+		parsed, err := url.Parse(source.URL)
+		if err != nil || (parsed.Scheme != "https" && parsed.Scheme != "http") || parsed.Hostname() == "" {
+			return fmt.Errorf("research source %d has an invalid web URL", index)
+		}
+		host := strings.ToLower(parsed.Hostname())
+		isBroadcom := host == "broadcom.com" || strings.HasSuffix(host, ".broadcom.com")
+		isVMware := host == "vmware.com" || strings.HasSuffix(host, ".vmware.com")
+		if !isBroadcom && !isVMware {
+			return fmt.Errorf("research source %d is not Broadcom-published", index)
+		}
+		if _, err := time.Parse("2006-01-02", source.ConsultedOn); err != nil {
+			return fmt.Errorf("research source %d has an invalid consultation date", index)
+		}
+		if len(source.UsedFor) == 0 {
+			return fmt.Errorf("research source %d records no informed decisions", index)
+		}
+		for _, decision := range source.UsedFor {
+			if strings.TrimSpace(decision) == "" {
+				return fmt.Errorf("research source %d has an empty informed decision", index)
+			}
+		}
+	}
+	return nil
+}
+
+func validatePlacement(placement Placement, inventory EstateInventory, snapshot CompatibilitySnapshot) error {
+	domain := inventory.ManagementDomain
+	rules := snapshot.Topology
+	if placement.ManagementDomain != domain.ID {
+		return fmt.Errorf("placement management domain %q does not match %q", placement.ManagementDomain, domain.ID)
+	}
+	if placement.Topology != domain.Topology || placement.Topology != rules.ManagementDomainTopology {
+		return fmt.Errorf("management-domain topology is inconsistent")
+	}
+	if placement.PFTT != domain.Resilience.PFTT || placement.PFTT != rules.PermittedPFTT {
+		return fmt.Errorf("PFTT %d does not match the required value", placement.PFTT)
+	}
+	if placement.SFTT != domain.Resilience.SFTT {
+		return fmt.Errorf("SFTT %d does not match the required value %d", placement.SFTT, domain.Resilience.SFTT)
+	}
+	if placement.RAID != domain.Resilience.RAID || placement.RAID != rules.RAID {
+		return fmt.Errorf("RAID policy is inconsistent")
+	}
+	minimumHosts, ok := rules.MinimumHostsBySFTT[strconv.Itoa(placement.SFTT)]
+	if !ok {
+		return fmt.Errorf("no host rule for SFTT=%d", placement.SFTT)
+	}
+	if len(placement.Sites) != len(domain.Sites) {
+		return fmt.Errorf("got %d data sites, want %d", len(placement.Sites), len(domain.Sites))
+	}
+	dataSites := make(map[string]InventorySite, len(domain.Sites))
+	for _, site := range domain.Sites {
+		if _, exists := dataSites[site.ID]; exists {
+			return fmt.Errorf("inventory repeats data site %q", site.ID)
+		}
+		dataSites[site.ID] = site
+	}
+	seenSites := make(map[string]bool, len(placement.Sites))
+	for _, site := range placement.Sites {
+		expected, ok := dataSites[site.ID]
+		if !ok {
+			return fmt.Errorf("placement invents data site %q", site.ID)
+		}
+		if seenSites[site.ID] {
+			return fmt.Errorf("placement repeats data site %q", site.ID)
+		}
+		seenSites[site.ID] = true
+		if site.Role != expected.Role {
+			return fmt.Errorf("site %s role %q does not match %q", site.ID, site.Role, expected.Role)
+		}
+		if site.Hosts < expected.CurrentHosts {
+			return fmt.Errorf("site %s removes hosts from the current inventory", site.ID)
+		}
+		if site.Hosts < minimumHosts {
+			return fmt.Errorf("site %s has %d hosts but %s SFTT=%d requires at least %d", site.ID, site.Hosts, placement.RAID, placement.SFTT, minimumHosts)
+		}
+	}
+
+	witness := placement.Witness
+	candidate := domain.WitnessCandidate
+	if witness.Site != candidate.Site || witness.Role != candidate.Role || witness.Role != rules.WitnessRole {
+		return fmt.Errorf("witness is not placed at the designated tertiary site")
+	}
+	if witness.FailureDomain != rules.WitnessFailureDomain {
+		return fmt.Errorf("witness failure domain %q is not %q", witness.FailureDomain, rules.WitnessFailureDomain)
+	}
+	if witness.HostCount != rules.WitnessHostCount || witness.HostCount > candidate.WitnessHostsAvailable {
+		return fmt.Errorf("witness host count %d is invalid", witness.HostCount)
+	}
+	if _, isDataSite := dataSites[witness.Site]; isDataSite {
+		return fmt.Errorf("witness site %q is also a data site", witness.Site)
+	}
+	independent := stringSet(candidate.IndependentFrom)
+	for site := range dataSites {
+		if !independent[site] {
+			return fmt.Errorf("witness site is not independent from %s", site)
+		}
+	}
+
+	if len(placement.Components) != len(snapshot.Sizing) {
+		return fmt.Errorf("got %d component placements, want %d", len(placement.Components), len(snapshot.Sizing))
+	}
+	componentByName := make(map[string]ComponentPlacement, len(placement.Components))
+	for _, component := range placement.Components {
+		if _, exists := componentByName[component.Name]; exists {
+			return fmt.Errorf("component %q is placed more than once", component.Name)
+		}
+		componentByName[component.Name] = component
+	}
+	for _, sizing := range snapshot.Sizing {
+		component, ok := componentByName[sizing.Component]
+		if !ok {
+			return fmt.Errorf("component %q has no placement", sizing.Component)
+		}
+		demand, err := demandValue(inventory.Demand, sizing.DemandMetric)
+		if err != nil {
+			return err
+		}
+		if demand < sizing.MinimumDemand || demand > sizing.MaximumDemand {
+			return fmt.Errorf("%s demand %d is outside pinned band %d..%d", sizing.Component, demand, sizing.MinimumDemand, sizing.MaximumDemand)
+		}
+		if component.Version != sizing.Version || component.SizeProfile != sizing.SizeProfile {
+			return fmt.Errorf("component %s has incompatible version or size", sizing.Component)
+		}
+		if component.Domain != domain.ID {
+			return fmt.Errorf("component %s is outside the management domain", sizing.Component)
+		}
+		if !component.AntiAffinity {
+			return fmt.Errorf("component %s lacks anti-affinity", sizing.Component)
+		}
+		if len(component.Nodes) != len(dataSites) {
+			return fmt.Errorf("component %s must have one node placement for each data site", sizing.Component)
+		}
+		total := 0
+		seenNodeSites := make(map[string]bool, len(component.Nodes))
+		for _, nodes := range component.Nodes {
+			if _, ok := dataSites[nodes.Site]; !ok {
+				return fmt.Errorf("component %s is placed at non-data site %s", sizing.Component, nodes.Site)
+			}
+			if seenNodeSites[nodes.Site] {
+				return fmt.Errorf("component %s repeats site %s", sizing.Component, nodes.Site)
+			}
+			seenNodeSites[nodes.Site] = true
+			if nodes.Count < sizing.MinimumNodesPerSite {
+				return fmt.Errorf("component %s has too few nodes at %s", sizing.Component, nodes.Site)
+			}
+			total += nodes.Count
+		}
+		if total != sizing.ApplianceNodes {
+			return fmt.Errorf("component %s has %d nodes, want %d", sizing.Component, total, sizing.ApplianceNodes)
+		}
+	}
+	return nil
+}
+
+func validateSteps(plan Architecture, inventory EstateInventory, snapshot CompatibilitySnapshot) error {
+	if len(inventory.Products) != len(snapshot.Products) {
+		return fmt.Errorf("inventory and snapshot product counts differ")
+	}
+	if len(plan.Steps) != len(snapshot.Products) {
+		return fmt.Errorf("got %d migration steps, want %d", len(plan.Steps), len(snapshot.Products))
+	}
+	inventoryByID := make(map[string]EstateProduct, len(inventory.Products))
+	for _, product := range inventory.Products {
+		if _, exists := inventoryByID[product.ID]; exists {
+			return fmt.Errorf("inventory repeats product %q", product.ID)
+		}
+		inventoryByID[product.ID] = product
+	}
+	placements := make(map[string]ComponentPlacement, len(plan.Placement.Components))
+	for _, component := range plan.Placement.Components {
+		placements[component.Name] = component
+	}
+	seenSteps := make(map[string]bool, len(plan.Steps))
+	previousOrder := 0
+	for index, expected := range snapshot.Products {
+		step := plan.Steps[index]
+		if step.Order <= previousOrder {
+			return fmt.Errorf("step %s order %d is not strictly increasing", step.ID, step.Order)
+		}
+		previousOrder = step.Order
+		if seenSteps[step.ID] {
+			return fmt.Errorf("migration step %q is repeated", step.ID)
+		}
+		seenSteps[step.ID] = true
+		product, ok := inventoryByID[expected.InventoryID]
+		if !ok {
+			return fmt.Errorf("snapshot product %q is not in inventory", expected.InventoryID)
+		}
+		if expected.SourceProduct != product.Product || expected.SourceVersion != product.Version {
+			return fmt.Errorf("snapshot source %s does not match inventory", expected.InventoryID)
+		}
+		if step.ID != expected.StepID || step.Order != expected.Order {
+			return fmt.Errorf("step %d does not use pinned id and order", index)
+		}
+		if !sameStrings(step.DependsOn, expected.DependsOn) {
+			return fmt.Errorf("step %s dependencies are inconsistent", step.ID)
+		}
+		if step.Source.InventoryID != product.ID || step.Source.Product != product.Product || step.Source.Version != product.Version {
+			return fmt.Errorf("step %s does not name its exact source", step.ID)
+		}
+		if step.Source.SupportEnds != expected.EndOfGeneralSupport {
+			return fmt.Errorf("step %s support boundary is inconsistent", step.ID)
+		}
+		if step.Target.Component != expected.TargetComponent || step.Target.Version != expected.TargetVersion || step.Target.PlacementRef != expected.TargetComponent {
+			return fmt.Errorf("step %s does not name its exact target placement", step.ID)
+		}
+		placement, ok := placements[step.Target.PlacementRef]
+		if !ok || placement.Version != step.Target.Version {
+			return fmt.Errorf("step %s target has no matching placement", step.ID)
+		}
+		if step.MigrationMethod != expected.MigrationMethod || !sameStrings(step.VersionPath, expected.VersionPath) {
+			return fmt.Errorf("step %s uses an unsupported migration path", step.ID)
+		}
+		if err := validateGates(step, expected); err != nil {
+			return err
+		}
+		if err := validateContent(step, product, expected); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func validateGates(step MigrationStep, expected ProductCompatibility) error {
+	if len(step.Gates) != len(expected.Gates) {
+		return fmt.Errorf("step %s has %d gates, want %d", step.ID, len(step.Gates), len(expected.Gates))
+	}
+	wanted := make(map[string]string, len(expected.Gates))
+	for _, gate := range expected.Gates {
+		wanted[gate.Code] = gate.Phase
+	}
+	seen := make(map[string]bool, len(step.Gates))
+	for _, gate := range step.Gates {
+		phase, ok := wanted[gate.Code]
+		if !ok || phase != gate.Phase {
+			return fmt.Errorf("step %s has unexpected gate %s/%s", step.ID, gate.Code, gate.Phase)
+		}
+		if seen[gate.Code] {
+			return fmt.Errorf("step %s repeats gate %s", step.ID, gate.Code)
+		}
+		seen[gate.Code] = true
+		if strings.TrimSpace(gate.Criterion) == "" {
+			return fmt.Errorf("step %s gate %s has no criterion", step.ID, gate.Code)
+		}
+	}
+	return nil
+}
+
+func validateContent(step MigrationStep, product EstateProduct, expected ProductCompatibility) error {
+	if len(expected.ContentRules) != len(product.Content) {
+		return fmt.Errorf("snapshot rules do not cover inventory content for %s", product.ID)
+	}
+	inventoryIDs := make(map[string]bool, len(product.Content))
+	for _, content := range product.Content {
+		if inventoryIDs[content.ID] {
+			return fmt.Errorf("inventory repeats content %s", content.ID)
+		}
+		inventoryIDs[content.ID] = true
+	}
+	rules := make(map[string]ContentRule, len(expected.ContentRules))
+	for _, rule := range expected.ContentRules {
+		if !inventoryIDs[rule.ContentID] || rules[rule.ContentID].ContentID != "" {
+			return fmt.Errorf("invalid snapshot content rule %s", rule.ContentID)
+		}
+		rules[rule.ContentID] = rule
+	}
+	seen := make(map[string]bool, len(product.Content))
+	for _, decision := range step.CarryForward {
+		rule, ok := rules[decision.ContentID]
+		if !ok || rule.Disposition != "carry" || decision.Method != rule.Method || strings.TrimSpace(decision.Method) == "" {
+			return fmt.Errorf("step %s has incompatible carry decision for %s", step.ID, decision.ContentID)
+		}
+		if seen[decision.ContentID] {
+			return fmt.Errorf("step %s repeats content %s", step.ID, decision.ContentID)
+		}
+		seen[decision.ContentID] = true
+	}
+	for _, decision := range step.Abandon {
+		rule, ok := rules[decision.ContentID]
+		if !ok || rule.Disposition != "abandon" || strings.TrimSpace(decision.Reason) == "" {
+			return fmt.Errorf("step %s has invalid abandonment for %s", step.ID, decision.ContentID)
+		}
+		if seen[decision.ContentID] {
+			return fmt.Errorf("step %s repeats content %s", step.ID, decision.ContentID)
+		}
+		seen[decision.ContentID] = true
+	}
+	if len(seen) != len(product.Content) {
+		return fmt.Errorf("step %s covers %d of %d content items", step.ID, len(seen), len(product.Content))
+	}
+	return nil
+}
+
+func demandValue(demand Demand, metric string) (int, error) {
+	switch metric {
+	case "monitored_objects":
+		return demand.MonitoredObjects, nil
+	case "concurrent_automation_deployments":
+		return demand.ConcurrentAutomationDeployments, nil
+	case "average_events_per_second":
+		return demand.AverageEventsPerSecond, nil
+	default:
+		return 0, fmt.Errorf("unknown demand metric %q", metric)
+	}
+}
+
+func sameStrings(left, right []string) bool {
+	if len(left) != len(right) {
+		return false
+	}
+	for index := range left {
+		if left[index] != right[index] {
+			return false
+		}
+	}
+	return true
+}
+
+func stringSet(values []string) map[string]bool {
+	result := make(map[string]bool, len(values))
+	for _, value := range values {
+		result[value] = true
+	}
+	return result
+}

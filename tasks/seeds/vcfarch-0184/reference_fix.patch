+package vcfarch
+
+// Architecture is the machine-readable target design and migration sequence.
+type Architecture struct {
+	SchemaVersion         string           `json:"schema_version"`
+	EstateID              string           `json:"estate_id"`
+	CompatibilitySnapshot string           `json:"compatibility_snapshot"`
+	DesignAsOf            string           `json:"design_as_of"`
+	TargetPlatform        string           `json:"target_platform"`
+	Research              []ResearchSource `json:"research"`
+	Placement             Placement        `json:"placement"`
+	Steps                 []MigrationStep  `json:"steps"`
+}
+
+type ResearchSource struct {
+	Title       string   `json:"title"`
+	URL         string   `json:"url"`
+	ConsultedOn string   `json:"consulted_on"`
+	UsedFor     []string `json:"used_for"`
+}
+
+type Placement struct {
+	ManagementDomain string               `json:"management_domain"`
+	Topology         string               `json:"topology"`
+	PFTT             int                  `json:"pftt"`
+	SFTT             int                  `json:"sftt"`
+	RAID             string               `json:"raid"`
+	Sites            []SitePlacement      `json:"sites"`
+	Witness          WitnessPlacement     `json:"witness"`
+	Components       []ComponentPlacement `json:"components"`
+}
+
+type SitePlacement struct {
+	ID    string `json:"id"`
+	Role  string `json:"role"`
+	Hosts int    `json:"hosts"`
+}
+
+type WitnessPlacement struct {
+	Site          string `json:"site"`
+	Role          string `json:"role"`
+	FailureDomain string `json:"failure_domain"`
+	HostCount     int    `json:"host_count"`
+}
+
+type ComponentPlacement struct {
+	Name         string          `json:"name"`
+	Version      string          `json:"version"`
+	SizeProfile  string          `json:"size_profile"`
+	Domain       string          `json:"domain"`
+	Nodes        []NodePlacement `json:"nodes"`
+	AntiAffinity bool            `json:"anti_affinity"`
+}
+
+type NodePlacement struct {
+	Site  string `json:"site"`
+	Count int    `json:"count"`
+}
+
+type MigrationStep struct {
+	Order           int               `json:"order"`
+	ID              string            `json:"id"`
+	DependsOn       []string          `json:"depends_on"`
+	Source          SourceEndpoint    `json:"source"`
+	Target          TargetEndpoint    `json:"target"`
+	MigrationMethod string            `json:"migration_method"`
+	VersionPath     []string          `json:"version_path"`
+	CarryForward    []CarryDecision   `json:"carry_forward"`
+	Abandon         []AbandonDecision `json:"abandon"`
+	Gates           []Gate            `json:"gates"`
+}
+
+type SourceEndpoint struct {
+	InventoryID string `json:"inventory_id"`
+	Product     string `json:"product"`
+	Version     string `json:"version"`
+	SupportEnds string `json:"support_ends"`
+}
+
+type TargetEndpoint struct {
+	Component    string `json:"component"`
+	Version      string `json:"version"`
+	PlacementRef string `json:"placement_ref"`
+}
+
+type CarryDecision struct {
+	ContentID string `json:"content_id"`
+	Method    string `json:"method"`
+}
+
+type AbandonDecision struct {
+	ContentID string `json:"content_id"`
+	Reason    string `json:"reason"`
+}
+
+type Gate struct {
+	Code      string `json:"code"`
+	Phase     string `json:"phase"`
+	Criterion string `json:"criterion"`
+}
+
+type EstateInventory struct {
+	EstateID         string           `json:"estate_id"`
+	DesignAsOf       string           `json:"design_as_of"`
+	TargetPlatform   string           `json:"target_platform"`
+	ManagementDomain ManagementDomain `json:"management_domain"`
+	Demand           Demand           `json:"demand"`
+	Products         []EstateProduct  `json:"products"`
+}
+
+type ManagementDomain struct {
+	ID               string           `json:"id"`
+	Topology         string           `json:"topology"`
+	Sites            []InventorySite  `json:"sites"`
+	WitnessCandidate WitnessCandidate `json:"witness_candidate"`
+	Resilience       Resilience       `json:"resilience"`
+}
+
+type InventorySite struct {
+	ID           string `json:"id"`
+	Role         string `json:"role"`
+	CurrentHosts int    `json:"current_hosts"`
+}
+
+type WitnessCandidate struct {
+	Site                  string   `json:"site"`
+	Role                  string   `json:"role"`
+	WitnessHostsAvailable int      `json:"witness_hosts_available"`
+	IndependentFrom       []string `json:"independent_from"`
+}
+
+type Resilience struct {
+	PFTT int    `json:"pftt"`
+	SFTT int    `json:"sftt"`
+	RAID string `json:"raid"`
+}
+
+type Demand struct {
+	MonitoredObjects                int `json:"monitored_objects"`
+	ConcurrentAutomationDeployments int `json:"concurrent_automation_deployments"`
+	AverageEventsPerSecond          int `json:"average_events_per_second"`
+	LogRetentionDays                int `json:"log_retention_days"`
+}
+
+type EstateProduct struct {
+	ID        string        `json:"id"`
+	Product   string        `json:"product"`
+	Version   string        `json:"version"`
+	ManagedBy string        `json:"managed_by"`
+	Content   []ContentItem `json:"content"`
+}
+
+type ContentItem struct {
+	ID       string `json:"id"`
+	Kind     string `json:"kind"`
+	Quantity int    `json:"quantity"`
+}
+
+type CompatibilitySnapshot struct {
+	SnapshotID     string                 `json:"snapshot_id"`
+	CapturedOn     string                 `json:"captured_on"`
+	TargetPlatform string                 `json:"target_platform"`
+	Authority      string                 `json:"authority"`
+	Topology       TopologyRules          `json:"topology"`
+	Sizing         []SizingRule           `json:"sizing"`
+	Products       []ProductCompatibility `json:"products"`
+}
+
+type TopologyRules struct {
+	ManagementDomainTopology string         `json:"management_domain_topology"`
+	PermittedPFTT            int            `json:"permitted_pftt"`
+	RAID                     string         `json:"raid"`
+	MinimumHostsBySFTT       map[string]int `json:"minimum_hosts_per_site_by_sftt"`
+	WitnessRole              string         `json:"witness_role"`
+	WitnessFailureDomain     string         `json:"witness_failure_domain"`
+	WitnessHostCount         int            `json:"witness_host_count"`
+}
+
+type SizingRule struct {
+	Component           string `json:"component"`
+	Version             string `json:"version"`
+	DemandMetric        string `json:"demand_metric"`
+	MinimumDemand       int    `json:"minimum_demand"`
+	MaximumDemand       int    `json:"maximum_demand"`
+	SizeProfile         string `json:"size_profile"`
+	ApplianceNodes      int    `json:"appliance_nodes"`
+	MinimumNodesPerSite int    `json:"minimum_nodes_per_site"`
+}
+
+type ProductCompatibility struct {
+	InventoryID         string        `json:"inventory_id"`
+	SourceProduct       string        `json:"source_product"`
+	SourceVersion       string        `json:"source_version"`
+	EndOfGeneralSupport string        `json:"end_of_general_support"`
+	TargetComponent     string        `json:"target_component"`
+	TargetVersion       string        `json:"target_version"`
+	MigrationMethod     string        `json:"migration_method"`
+	VersionPath         []string      `json:"version_path"`
+	StepID              string        `json:"step_id"`
+	Order               int           `json:"order"`
+	DependsOn           []string      `json:"depends_on"`
+	Gates               []GateRule    `json:"gates"`
+	ContentRules        []ContentRule `json:"content_rules"`
+}
+
+type GateRule struct {
+	Code  string `json:"code"`
+	Phase string `json:"phase"`
+}
+
+type ContentRule struct {
+	ContentID   string `json:"content_id"`
+	Disposition string `json:"disposition"`
+	Method      string `json:"method"`
+}

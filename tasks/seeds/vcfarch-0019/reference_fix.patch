+"""Build greenfield and migration architecture artifacts from protected inputs."""
+
+from __future__ import annotations
+
+import math
+from pathlib import Path
+from typing import Any
+
+from .io import write_json
+
+
+def _management_domain(requirements: dict[str, Any]) -> dict[str, Any]:
+    return next(
+        domain for domain in requirements["domains"] if domain["domain_type"] == "management"
+    )
+
+
+def _network(requirements: dict[str, Any], key: str, network_type: str) -> dict[str, Any]:
+    source = requirements["networking"][key]
+    return {
+        "networkType": network_type,
+        "subnet": source["cidr"],
+        "gateway": source["gateway"],
+        "vlanId": source["vlan_id"],
+        "mtu": 9000,
+        "ipAddressVersion": "IPv4",
+        "ipAddressAssignmentMode": "STATIC",
+    }
+
+
+def build_sddc_spec(
+    requirements: dict[str, Any], compatibility: dict[str, Any]
+) -> dict[str, Any]:
+    management = _management_domain(requirements)
+    network = requirements["networking"]
+    version = compatibility["installer"]["target_version"]
+    operations_profile = compatibility["service_profiles"]["VCF Operations"]
+    collector_profile = compatibility["service_profiles"]["VCF Operations Collector"]
+    automation_profile = compatibility["service_profiles"]["VCF Automation"]
+    hostnames = management["hostnames"]
+    return {
+        "sddcId": "ord01-m01",
+        "workflowType": compatibility["installer"]["workflow_type"],
+        "version": version,
+        "vcfInstanceName": requirements["vcf_instance_name"],
+        "hostSpecs": [{"hostname": hostname} for hostname in hostnames],
+        "vcenterSpec": {
+            "vcenterHostname": f"ord01-m01-vc01.{network['dns_domain']}",
+            "rootVcenterPassword": "ReplaceMe!VCF91",
+            "vmSize": "large",
+            "storageSize": "lstorage",
+            "ssoDomain": "vsphere.local",
+            "version": version,
+            "useExistingDeployment": False,
+        },
+        "clusterSpec": {
+            "datacenterName": "ord01-m01-dc",
+            "clusterName": management["cluster_name"],
+            "resourcePoolSpecs": [
+                {
+                    "name": "Management",
+                    "type": "management",
+                    "cpuReservationPercentage": 20,
+                    "memoryReservationPercentage": 20,
+                }
+            ],
+        },
+        "dvsSpecs": [
+            {
+                "dvsName": "ord01-m01-vds01",
+                "networks": [
+                    "MANAGEMENT",
+                    "VMOTION",
+                    "VSAN",
+                    "VM_MANAGEMENT",
+                    "FLEET_MANAGEMENT",
+                ],
+                "mtu": 9000,
+                "vmnicsToUplinks": [
+                    {"id": "vmnic0", "uplink": "uplink1"},
+                    {"id": "vmnic1", "uplink": "uplink2"},
+                ],
+            }
+        ],
+        "nsxtSpec": {
+            "nsxtManagers": [
+                {"hostname": f"ord01-m01-nsx{number:02d}.{network['dns_domain']}"}
+                for number in range(1, 4)
+            ],
+            "nsxtManagerSize": "large",
+            "vipFqdn": f"ord01-m01-nsx.{network['dns_domain']}",
+            "transportVlanId": network["nsx_host_overlay"]["vlan_id"],
+            "ipAddressPoolSpec": {
+                "name": "ord01-host-overlay",
+                "description": "ORD management-domain NSX host overlay",
+                "subnets": [
+                    {
+                        "cidr": network["nsx_host_overlay"]["cidr"],
+                        "gateway": network["nsx_host_overlay"]["gateway"],
+                        "ipAddressPoolRanges": [
+                            {
+                                "start": network["nsx_host_overlay"]["pool_start"],
+                                "end": network["nsx_host_overlay"]["pool_end"],
+                            }
+                        ],
+                    }
+                ],
+            },
+            "version": version,
+            "useExistingDeployment": False,
+        },
+        "networkSpecs": [
+            _network(requirements, "management", "MANAGEMENT"),
+            _network(requirements, "vmotion", "VMOTION"),
+            _network(requirements, "vsan", "VSAN"),
+            _network(requirements, "vm_management", "VM_MANAGEMENT"),
+            _network(requirements, "fleet_management", "FLEET_MANAGEMENT"),
+        ],
+        "dnsSpec": {
+            "subdomain": network["dns_domain"],
+            "nameservers": network["dns_servers"],
+        },
+        "ntpServers": network["ntp_servers"],
+        "sddcManagerSpec": {
+            "hostname": f"ord01-m01-sddc01.{network['dns_domain']}",
+            "version": version,
+            "useExistingDeployment": False,
+        },
+        "managementPoolName": "ord01-management-pool",
+        "ceipEnabled": False,
+        "skipEsxThumbprintValidation": False,
+        "skipGatewayPingValidation": False,
+        "datastoreSpec": {
+            "vsanSpec": {
+                "datastoreName": "ord01-m01-vsan01",
+                "failuresToTolerate": requirements["availability"][
+                    "management_host_failures_to_tolerate"
+                ],
+            }
+        },
+        "vspClusterSpec": {
+            "platformFqdn": f"ord01-vmsp.{network['dns_domain']}",
+            "instanceFqdn": f"ord01-instance.{network['dns_domain']}",
+            "fleetFqdn": f"northstar-fleet.{network['dns_domain']}",
+            "ipv4Pool": {"addresses": network["vsp_pool"]["addresses"]},
+            "size": "large",
+            "internalClusterCidrIpv4": network["vsp_internal_cidr"],
+            "version": version,
+            "useExistingDeployment": False,
+        },
+        "fleetLcmSpec": {"version": version, "size": "large"},
+        "sddcLcmSpec": {"version": version, "size": "large"},
+        "fleetDepotSpec": {"version": version, "size": "large"},
+        "telemetryAcceptorSpec": {"version": version, "size": "large"},
+        "vcfOperationsSpec": {
+            "nodes": [
+                {
+                    "hostname": f"ord01-ops{number:02d}.{network['dns_domain']}",
+                    "type": role,
+                }
+                for number, role in enumerate(("master", "replica", "data"), 1)
+            ],
+            "applianceSize": operations_profile["profile"],
+            "useExistingDeployment": False,
+            "version": version,
+        },
+        "vcfOperationsCollectorSpec": {
+            "hostname": f"dfw01-ops-collector01.{network['dns_domain']}",
+            "applianceSize": collector_profile["profile"],
+            "version": version,
+            "useExistingDeployment": False,
+        },
+        "vcfAutomationSpec": {
+            "hostname": f"ord01-automation.{network['dns_domain']}",
+            "platformFqdn": f"ord01-vmsp.{network['dns_domain']}",
+            "ipPool": [f"10.20.40.{number}" for number in range(80, 86)],
+            "internalClusterCidr": network["automation_internal_cidr"],
+            "nodePrefix": "northstar-auto",
+            "size": automation_profile["profile"],
+            "version": version,
+            "useExistingDeployment": False,
+        },
+        "vcfManagementComponentsInfrastructureSpec": {
+            "localRegionNetwork": {
+                "networkName": "ord01-vm-management",
+                "subnetMask": "255.255.255.0",
+                "gateway": network["vm_management"]["gateway"],
+            },
+            "xRegionNetwork": {
+                "networkName": "northstar-fleet-management",
+                "subnetMask": "255.255.255.0",
+                "gateway": network["fleet_management"]["gateway"],
+            },
+        },
+        "licenseServerSpec": {
+            "hostname": f"ord01-license01.{network['dns_domain']}",
+            "version": version,
+            "useExistingDeployment": False,
+        },
+    }
+
+
+def _capacity_record(
+    domain: dict[str, Any], availability: dict[str, Any]
+) -> dict[str, Any]:
+    reserve = availability["workload_reserve_hosts_per_cluster"]
+    available_hosts = domain["host_count"] - reserve
+    headroom = (
+        availability["workload_headroom_percent"]
+        if domain["domain_type"] == "workload"
+        else 0
+    )
+    provided = {
+        dimension: domain["host_profile"][dimension] * available_hosts
+        for dimension in ("physical_cores", "memory_gib", "usable_storage_tib")
+    }
+    required = {
+        dimension: math.ceil(amount * (100 + headroom) / 100)
+        for dimension, amount in domain["required_capacity"].items()
+    }
+    return {
+        "domain_name": domain["domain_name"],
+        "domain_type": domain["domain_type"],
+        "site_id": domain["site_id"],
+        "cluster_name": domain["cluster_name"],
+        "host_count": domain["host_count"],
+        "reserve_hosts": reserve,
+        "available_hosts_after_reserve": available_hosts,
+        "provided_after_reserve": provided,
+        "required_with_headroom": required,
+        "meets_requirement": all(provided[key] >= required[key] for key in provided),
+    }
+
+
+def build_architecture(
+    requirements: dict[str, Any], compatibility: dict[str, Any]
+) -> dict[str, Any]:
+    service_demand = requirements["service_demand"]
+    demands = {
+        "VCF Operations": service_demand["vcf_operations"].copy(),
+        "VCF Operations Collector": {
+            "remote_sites": service_demand["vcf_operations"]["remote_sites"]
+        },
+        "VCF Automation": service_demand["vcf_automation"].copy(),
+        "VCF Operations for Logs": service_demand["vcf_operations_for_logs"].copy(),
+    }
+    demands["VCF Operations"].pop("remote_sites")
+    placements = []
+    for component, profile in compatibility["service_profiles"].items():
+        placement = {
+            "component": component,
+            "version": requirements["target_version"],
+            "profile": profile["profile"],
+            "deployment_model": profile["deployment_model"],
+            "instances": profile["instances"],
+            "site_id": profile["site_id"],
+            "domain_name": profile["domain_name"],
+            "cluster_name": profile["cluster_name"],
+            "demand": demands[component],
+            "capacity": profile["capacity"],
+            "meets_demand": all(
+                profile["capacity"][key] >= value for key, value in demands[component].items()
+            ),
+        }
+        if "target_component" in profile:
+            placement["target_component"] = profile["target_component"]
+        placements.append(placement)
+    availability = requirements["availability"]
+    return {
+        "schema_version": "1.0",
+        "design_id": requirements["design_id"],
+        "target_version": requirements["target_version"],
+        "sites": [
+            {
+                "site_id": site["site_id"],
+                "role": site["role"],
+                "location": site["location"],
+            }
+            for site in requirements["sites"]
+        ],
+        "domain_capacity": [
+            _capacity_record(domain, availability) for domain in requirements["domains"]
+        ],
+        "service_placements": placements,
+        "availability_design": {
+            "management_host_failures_to_tolerate": availability[
+                "management_host_failures_to_tolerate"
+            ],
+            "service_node_placement": "anti-affinity-across-distinct-hosts",
+            "primary_site": "ORD01",
+            "recovery_site": "DFW01",
+            "recovery_site_capacity_fraction": availability[
+                "recovery_site_capacity_fraction"
+            ],
+        },
+    }
+
+
+def _selected_transitions(
+    estate: dict[str, Any], compatibility: dict[str, Any]
+) -> dict[str, dict[str, Any]]:
+    by_source: dict[tuple[str, str], list[dict[str, Any]]] = {}
+    for transition in compatibility["allowed_transitions"]:
+        key = (transition["component"], transition["from_version"])
+        by_source.setdefault(key, []).append(transition)
+    selected: dict[str, dict[str, Any]] = {}
+    for component in estate["components"]:
+        state = (component["component"], component["version"])
+        target = (component["target_component"], component["target_version"])
+        seen: set[tuple[str, str]] = set()
+        while state != target:
+            if state in seen:
+                raise ValueError(f"compatibility transition cycle at {state}")
+            seen.add(state)
+            choices = by_source.get(state, [])
+            if len(choices) != 1:
+                raise ValueError(f"expected one supported transition from {state}, got {len(choices)}")
+            transition = choices[0]
+            selected[transition["transition_id"]] = transition
+            state = (transition["target_component"], transition["target_version"])
+    return selected
+
+
+def _ordered_transitions(
+    selected: dict[str, dict[str, Any]], compatibility: dict[str, Any]
+) -> list[dict[str, Any]]:
+    priority = {
+        transition["transition_id"]: index
+        for index, transition in enumerate(compatibility["allowed_transitions"])
+    }
+    dependencies = {transition_id: set() for transition_id in selected}
+    for before, after in compatibility["required_precedence"]:
+        if before in selected and after in selected:
+            dependencies[after].add(before)
+    ordered: list[dict[str, Any]] = []
+    emitted: set[str] = set()
+    while len(ordered) < len(selected):
+        ready = [
+            transition_id
+            for transition_id, required in dependencies.items()
+            if transition_id not in emitted and required <= emitted
+        ]
+        if not ready:
+            raise ValueError("required migration precedence contains a cycle")
+        transition_id = min(ready, key=priority.__getitem__)
+        ordered.append(selected[transition_id])
+        emitted.add(transition_id)
+    return ordered
+
+
+def build_migration_plan(
+    estate: dict[str, Any], compatibility: dict[str, Any]
+) -> dict[str, Any]:
+    selected = _selected_transitions(estate, compatibility)
+    transitions = _ordered_transitions(selected, compatibility)
+    gate_catalog = compatibility["gate_catalog"]
+    steps = []
+    for order, transition in enumerate(transitions, 1):
+        steps.append(
+            {
+                "order": order,
+                "step_id": f"{order:02d}-{transition['transition_id']}",
+                "transition_id": transition["transition_id"],
+                "component": transition["component"],
+                "from_version": transition["from_version"],
+                "target_component": transition["target_component"],
+                "target_version": transition["target_version"],
+                "action": transition["action"],
+                "gates": [
+                    {"gate_id": gate_id, "condition": gate_catalog[gate_id]}
+                    for gate_id in transition["required_gates"]
+                ],
+            }
+        )
+    return {
+        "schema_version": "1.0",
+        "estate_id": estate["estate_id"],
+        "target_stack_version": compatibility["installer"]["target_version"],
+        "steps": steps,
+    }
+
+
+def build_artifacts(
+    requirements: dict[str, Any],
+    estate: dict[str, Any],
+    compatibility: dict[str, Any],
+    output: str | Path,
+) -> None:
+    destination = Path(output)
+    artifacts = {
+        "sddc-spec.json": build_sddc_spec(requirements, compatibility),
+        "architecture.json": build_architecture(requirements, compatibility),
+        "migration-plan.json": build_migration_plan(estate, compatibility),
+    }
+    for filename, value in artifacts.items():
+        write_json(destination / filename, value)

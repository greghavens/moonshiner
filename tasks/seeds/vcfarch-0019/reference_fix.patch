+"""Command-line entry point for vcf_architect."""
+
+from __future__ import annotations
+
+import argparse
+
+from .design import build_artifacts
+from .io import load_json
+
+
+def parser() -> argparse.ArgumentParser:
+    command = argparse.ArgumentParser(description="Generate Northstar VCF architecture artifacts")
+    command.add_argument("--requirements", required=True)
+    command.add_argument("--estate", required=True)
+    command.add_argument("--compatibility", required=True)
+    command.add_argument("--output", required=True)
+    return command
+
+
+def main() -> int:
+    arguments = parser().parse_args()
+    build_artifacts(
+        load_json(arguments.requirements),
+        load_json(arguments.estate),
+        load_json(arguments.compatibility),
+        arguments.output,
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

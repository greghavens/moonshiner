+{
+  "estate_id": "northstar-legacy-estate",
+  "schema_version": "1.0",
+  "steps": [
+    {
+      "action": "upgrade",
+      "component": "VCF Operations",
+      "from_version": "8.17.2",
+      "gates": [
+        {
+          "condition": "Restorable backups of the component and its dependencies have been tested.",
+          "gate_id": "backup-restore-tested"
+        },
+        {
+          "condition": "All VCF Operations nodes are online and cluster health is green.",
+          "gate_id": "operations-online"
+        }
+      ],
+      "order": 1,
+      "step_id": "01-operations-to-818",
+      "target_component": "VCF Operations",
+      "target_version": "8.18.3",
+      "transition_id": "operations-to-818"
+    },
+    {
+      "action": "upgrade",
+      "component": "VCF Operations",
+      "from_version": "8.18.3",
+      "gates": [
+        {
+          "condition": "VCF Operations is at the supported 8.18.3 intermediate version.",
+          "gate_id": "operations-818-floor"
+        },
+        {
+          "condition": "A healthy cloud proxy is registered for the first VCF instance.",
+          "gate_id": "cloud-proxy-present"
+        }
+      ],
+      "order": 2,
+      "step_id": "02-operations-to-91",
+      "target_component": "VCF Operations",
+      "target_version": "9.1.0.0",
+      "transition_id": "operations-to-91"
+    },
+    {
+      "action": "upgrade",
+      "component": "SDDC Manager",
+      "from_version": "5.2.2.0",
+      "gates": [
+        {
+          "condition": "VCF Operations 9.1 upgrade and fleet-data migration are complete.",
+          "gate_id": "operations-91-complete"
+        },
+        {
+          "condition": "The SDDC Manager 9.1 upgrade precheck completes without blocking findings.",
+          "gate_id": "sddc-precheck"
+        }
+      ],
+      "order": 3,
+      "step_id": "03-sddc-manager-to-91",
+      "target_component": "SDDC Manager",
+      "target_version": "9.1.0.0",
+      "transition_id": "sddc-manager-to-91"
+    },
+    {
+      "action": "deploy",
+      "component": "VCF Management Services",
+      "from_version": "not-installed",
+      "gates": [
+        {
+          "condition": "SDDC Manager reports version 9.1.0.0 and healthy lifecycle services.",
+          "gate_id": "sddc-91-complete"
+        },
+        {
+          "condition": "The VCF Management Services network has twelve reserved addresses with working DNS and NTP.",
+          "gate_id": "vmsp-network-12-ips"
+        }
+      ],
+      "order": 4,
+      "step_id": "04-deploy-management-services",
+      "target_component": "VCF Management Services",
+      "target_version": "9.1.0.0",
+      "transition_id": "deploy-management-services"
+    },
+    {
+      "action": "deploy",
+      "component": "VCF License Server",
+      "from_version": "not-installed",
+      "gates": [
+        {
+          "condition": "VCF Management Services runtime and lifecycle services report healthy.",
+          "gate_id": "vmsp-healthy"
+        }
+      ],
+      "order": 5,
+      "step_id": "05-deploy-license-server",
+      "target_component": "VCF License Server",
+      "target_version": "9.1.0.0",
+      "transition_id": "deploy-license-server"
+    },
+    {
+      "action": "upgrade",
+      "component": "NSX",
+      "from_version": "4.2.1.0",
+      "gates": [
+        {
+          "condition": "VCF Management Services runtime and lifecycle services report healthy.",
+          "gate_id": "vmsp-healthy"
+        },
+        {
+          "condition": "The VCF Networking upgrade precheck passes for every managed domain.",
+          "gate_id": "nsx-precheck"
+        }
+      ],
+      "order": 6,
+      "step_id": "06-nsx-to-vcf-networking-91",
+      "target_component": "VCF Networking",
+      "target_version": "9.1.0.0",
+      "transition_id": "nsx-to-vcf-networking-91"
+    },
+    {
+      "action": "upgrade",
+      "component": "vCenter Server",
+      "from_version": "8.0.3.0",
+      "gates": [
+        {
+          "condition": "The NSX management plane transition to VCF Networking 9.1 is complete.",
+          "gate_id": "nsx-manager-upgraded"
+        },
+        {
+          "condition": "A tested temporary vCenter address is available on the management subnet.",
+          "gate_id": "vcenter-temp-ip"
+        }
+      ],
+      "order": 7,
+      "step_id": "07-vcenter-to-91",
+      "target_component": "vCenter Server",
+      "target_version": "9.1.0.0",
+      "transition_id": "vcenter-to-91"
+    },
+    {
+      "action": "upgrade",
+      "component": "ESXi",
+      "from_version": "8.0.3.0",
+      "gates": [
+        {
+          "condition": "vCenter Server 9.1 is healthy before host remediation begins.",
+          "gate_id": "vcenter-91-complete"
+        },
+        {
+          "condition": "Each cluster can evacuate one host while satisfying its reserved-capacity requirement.",
+          "gate_id": "workload-evacuation-capacity"
+        }
+      ],
+      "order": 8,
+      "step_id": "08-esxi-to-esx-91",
+      "target_component": "ESX",
+      "target_version": "9.1.0.0",
+      "transition_id": "esxi-to-esx-91"
+    },
+    {
+      "action": "upgrade",
+      "component": "VMware Aria Automation",
+      "from_version": "8.16.2",
+      "gates": [
+        {
+          "condition": "VCF Management Services runtime and lifecycle services report healthy.",
+          "gate_id": "vmsp-healthy"
+        },
+        {
+          "condition": "The legacy Automation deployment is registered in VCF Fleet Lifecycle.",
+          "gate_id": "automation-inventory-visible"
+        }
+      ],
+      "order": 9,
+      "step_id": "09-automation-to-91",
+      "target_component": "VCF Automation",
+      "target_version": "9.1.0.0",
+      "transition_id": "automation-to-91"
+    },
+    {
+      "action": "migrate",
+      "component": "VMware Identity Manager",
+      "from_version": "3.3.7",
+      "gates": [
+        {
+          "condition": "VCF Automation 9.1 is healthy and its existing deployments are visible.",
+          "gate_id": "automation-91-complete"
+        },
+        {
+          "condition": "Authentication through VMware Identity Broker is validated before retiring the legacy identity path.",
+          "gate_id": "identity-migration-validated"
+        }
+      ],
+      "order": 10,
+      "step_id": "10-identity-to-vcf-broker",
+      "target_component": "VMware Identity Broker",
+      "target_version": "9.1.0.0",
+      "transition_id": "identity-to-vcf-broker"
+    },
+    {
+      "action": "migrate",
+      "component": "VMware Aria Suite Lifecycle",
+      "from_version": "8.16.0",
+      "gates": [
+        {
+          "condition": "VCF Automation 9.1 is healthy and its existing deployments are visible.",
+          "gate_id": "automation-91-complete"
+        },
+        {
+          "condition": "VCF Fleet Lifecycle manages Automation lifecycle before retiring Aria Suite Lifecycle.",
+          "gate_id": "fleet-lcm-services-healthy"
+        }
+      ],
+      "order": 11,
+      "step_id": "11-suite-lifecycle-to-fleet-lcm",
+      "target_component": "VCF Fleet Lifecycle",
+      "target_version": "9.1.0.0",
+      "transition_id": "suite-lifecycle-to-fleet-lcm"
+    },
+    {
+      "action": "migrate",
+      "component": "VMware Aria Operations for Logs",
+      "from_version": "8.16.2",
+      "gates": [
+        {
+          "condition": "VCF Management Services runtime and lifecycle services report healthy.",
+          "gate_id": "vmsp-healthy"
+        },
+        {
+          "condition": "The legacy log cluster is healthy and available as a migration source.",
+          "gate_id": "legacy-logs-healthy"
+        },
+        {
+          "condition": "Ingestion and forwarding into VCF Log Management are validated before legacy log decommissioning.",
+          "gate_id": "log-forwarding-validated"
+        }
+      ],
+      "order": 12,
+      "step_id": "12-logs-to-log-management",
+      "target_component": "VCF Log Management",
+      "target_version": "9.1.0.0",
+      "transition_id": "logs-to-log-management"
+    }
+  ],
+  "target_stack_version": "9.1.0.0"
+}

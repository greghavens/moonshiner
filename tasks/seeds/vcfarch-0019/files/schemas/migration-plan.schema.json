{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:northstar:vcf:migration-plan:1.0",
  "title": "VCF existing-estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "estate_id",
    "target_stack_version",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "estate_id": {
      "type": "string",
      "minLength": 1
    },
    "target_stack_version": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "step_id",
        "transition_id",
        "component",
        "from_version",
        "target_component",
        "target_version",
        "action",
        "gates"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "step_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "transition_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "from_version": {
          "type": "string",
          "minLength": 1
        },
        "target_component": {
          "type": "string",
          "minLength": 1
        },
        "target_version": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": [
            "upgrade",
            "deploy",
            "migrate"
          ]
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/gate"
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "condition"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "condition": {
          "type": "string",
          "minLength": 8
        }
      }
    }
  }
}

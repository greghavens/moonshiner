 // Rotate establishes a session for next, makes it current, and retires the
 // previous session only after every request that started on it has finished.
 func (c *Client) Rotate(ctx context.Context, next Credential) error {
-	return ErrNotImplemented
+	if ctx == nil {
+		return errors.New("vcenter: context is nil")
+	}
+	if err := validateCredential(next); err != nil {
+		return err
+	}
+	c.mu.Lock()
+	if c.session == nil || c.session.retired {
+		c.mu.Unlock()
+		return ErrNoSession
+	}
+	c.mu.Unlock()
+
+	// The replacement session is established first so no window exists in which
+	// the client holds no usable token.
+	token, err := c.createSession(ctx, next)
+	if err != nil {
+		return err
+	}
+
+	c.mu.Lock()
+	previous := c.session
+	c.credential = next
+	c.session = newSession(token)
+	drained := retireLocked(previous)
+	c.mu.Unlock()
+
+	select {
+	case <-drained:
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	if previous == nil {
+		return nil
+	}
+	return c.deleteSession(ctx, previous.token)
 }
 
 // Logout retires the current session once its in-flight requests have finished.
 func (c *Client) Logout(ctx context.Context) error {
-	return ErrNotImplemented
+	if ctx == nil {
+		return errors.New("vcenter: context is nil")
+	}
+	c.mu.Lock()
+	previous := c.session
+	if previous == nil || previous.retired {
+		c.mu.Unlock()
+		return ErrNoSession
+	}
+	drained := retireLocked(previous)
+	c.session = nil
+	c.mu.Unlock()
+
+	select {
+	case <-drained:
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	return c.deleteSession(ctx, previous.token)
+}
+
+func newSession(token string) *session {
+	return &session{token: token, drained: make(chan struct{})}
+}
+
+// acquire pins the current session for the lifetime of one request.
+func (c *Client) acquire() (*session, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.session == nil || c.session.retired {
+		return nil, ErrNoSession
+	}
+	c.session.inFlight++
+	return c.session, nil
+}
+
+func (c *Client) release(current *session) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	current.inFlight--
+	if current.retired && current.inFlight == 0 {
+		current.closeOne.Do(func() { close(current.drained) })
+	}
+}
+
+// retireLocked stops new requests from picking up a session and returns the
+// channel closed once its outstanding requests have finished.
+func retireLocked(current *session) <-chan struct{} {
+	closed := make(chan struct{})
+	if current == nil {
+		close(closed)
+		return closed
+	}
+	current.retired = true
+	if current.inFlight == 0 {
+		current.closeOne.Do(func() { close(current.drained) })
+	}
+	return current.drained
+}
+
+func (c *Client) createSession(ctx context.Context, credential Credential) (string, error) {
+	request, err := http.NewRequestWithContext(ctx, http.MethodPost, c.serviceRoot+basePath+"/session", nil)
+	if err != nil {
+		return "", fmt.Errorf("vcenter: build %s request: %w", operationCreate, err)
+	}
+	request.Header.Set("Accept", "application/json")
+	request.SetBasicAuth(credential.Username, credential.Password)
+
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		return "", fmt.Errorf("vcenter: %s transport failure", operationCreate)
+	}
+	defer closeBody(response)
+	if response.StatusCode != http.StatusCreated {
+		return "", &APIError{OperationID: operationCreate, StatusCode: response.StatusCode}
+	}
+	if err := requireJSON(operationCreate, response); err != nil {
+		return "", err
+	}
+	body, err := io.ReadAll(response.Body)
+	if err != nil {
+		return "", &ProtocolError{OperationID: operationCreate, Problem: "response body could not be read"}
+	}
+	var decoded any
+	if err := json.Unmarshal(body, &decoded); err != nil {
+		return "", &ProtocolError{OperationID: operationCreate, Problem: "response body is not JSON"}
+	}
+	token, ok := decoded.(string)
+	if !ok {
+		return "", &ProtocolError{OperationID: operationCreate, Problem: "response body is not a bare JSON string session token"}
+	}
+	if strings.TrimSpace(token) == "" {
+		return "", &ProtocolError{OperationID: operationCreate, Problem: "session token is blank"}
+	}
+	if !headerSafe(token) {
+		return "", &ProtocolError{OperationID: operationCreate, Problem: "session token is not header safe"}
+	}
+	return token, nil
+}
+
+// headerSafe mirrors the standard library transport's field-value check. A
+// horizontal tab is permitted by HTTP; other controls and DEL are not.
+func headerSafe(value string) bool {
+	for index := 0; index < len(value); index++ {
+		character := value[index]
+		if (character < ' ' && character != '\t') || character == 0x7f {
+			return false
+		}
+	}
+	return true
+}
+
+func (c *Client) deleteSession(ctx context.Context, token string) error {
+	request, err := http.NewRequestWithContext(ctx, http.MethodDelete, c.serviceRoot+basePath+"/session", nil)
+	if err != nil {
+		return fmt.Errorf("vcenter: build %s request: %w", operationDelete, err)
+	}
+	request.Header.Set("Accept", "application/json")
+	request.Header.Set(sessionHeader, token)
+
+	response, err := c.httpClient.Do(request)
+	if err != nil {
+		return fmt.Errorf("vcenter: %s transport failure", operationDelete)
+	}
+	defer closeBody(response)
+	if response.StatusCode != http.StatusNoContent {
+		return &APIError{OperationID: operationDelete, StatusCode: response.StatusCode}
+	}
+	return nil
+}
+
+// encodeFilter serialises the set members in the order the specification
+// declares them. Unset members are omitted outright rather than sent empty.
+func encodeFilter(filter Filter) (string, error) {
+	members := []struct {
+		name   string
+		values []string
+	}{
+		{"vms", filter.VMs},
+		{"names", filter.Names},
+		{"folders", filter.Folders},
+		{"datacenters", filter.Datacenters},
+		{"hosts", filter.Hosts},
+		{"clusters", filter.Clusters},
+		{"resource_pools", filter.ResourcePools},
+		{"power_states", filter.PowerStates},
+	}
+	var encoded strings.Builder
+	for _, member := range members {
+		if len(member.values) == 0 {
+			continue
+		}
+		seen := make(map[string]bool, len(member.values))
+		for _, value := range member.values {
+			if strings.TrimSpace(value) == "" {
+				return "", fmt.Errorf("vcenter: filter member %q has a blank value", member.name)
+			}
+			if seen[value] {
+				return "", fmt.Errorf("vcenter: filter member %q repeats a value but is declared uniqueItems", member.name)
+			}
+			seen[value] = true
+			if encoded.Len() > 0 {
+				encoded.WriteByte('&')
+			}
+			encoded.WriteString(member.name)
+			encoded.WriteByte('=')
+			encoded.WriteString(url.QueryEscape(value))
+		}
+	}
+	return encoded.String(), nil
+}
+
+func decodeSummaries(body []byte) ([]VM, error) {
+	var elements []json.RawMessage
+	if err := json.Unmarshal(body, &elements); err != nil {
+		return nil, &ProtocolError{OperationID: operationList, Problem: "response body is not a JSON array"}
+	}
+	if elements == nil {
+		return nil, &ProtocolError{OperationID: operationList, Problem: "response array is null"}
+	}
+	result := make([]VM, 0, len(elements))
+	seen := make(map[string]bool, len(elements))
+	for _, element := range elements {
+		var properties map[string]json.RawMessage
+		if err := json.Unmarshal(element, &properties); err != nil || properties == nil {
+			return nil, &ProtocolError{OperationID: operationList, Problem: "summary element is not an object"}
+		}
+		summary := VM{}
+		for _, required := range []struct {
+			name   string
+			target *string
+		}{
+			{"vm", &summary.VM},
+			{"name", &summary.Name},
+			{"power_state", &summary.PowerState},
+		} {
+			raw, present := properties[required.name]
+			if !present {
+				return nil, &ProtocolError{OperationID: operationList, Problem: "summary is missing a required property"}
+			}
+			var value string
+			if err := json.Unmarshal(raw, &value); err != nil || strings.TrimSpace(value) == "" {
+				return nil, &ProtocolError{OperationID: operationList, Problem: "required summary property is not a nonblank string"}
+			}
+			*required.target = value
+		}
+		if seen[summary.VM] {
+			return nil, &ProtocolError{OperationID: operationList, Problem: "summary repeats a virtual machine identifier"}
+		}
+		seen[summary.VM] = true
+
+		count, err := optionalInt64(properties, "cpu_count")
+		if err != nil {
+			return nil, err
+		}
+		memory, err := optionalInt64(properties, "memory_size_mib")
+		if err != nil {
+			return nil, err
+		}
+		summary.CPUCount = count
+		summary.MemorySizeMiB = memory
+		result = append(result, summary)
+	}
+	return result, nil
+}
+
+func optionalInt64(properties map[string]json.RawMessage, name string) (*int64, error) {
+	raw, present := properties[name]
+	if !present || string(raw) == "null" {
+		return nil, nil
+	}
+	text := strings.TrimSpace(string(raw))
+	if text == "true" || text == "false" || strings.ContainsAny(text, `".eE`) {
+		return nil, &ProtocolError{OperationID: operationList, Problem: "optional summary property is not an integer"}
+	}
+	var value int64
+	if err := json.Unmarshal(raw, &value); err != nil {
+		return nil, &ProtocolError{OperationID: operationList, Problem: "optional summary property is not an integer"}
+	}
+	return &value, nil
+}
+
+func requireJSON(operationID string, response *http.Response) error {
+	mediaType, _, err := mime.ParseMediaType(response.Header.Get("Content-Type"))
+	if err != nil || mediaType != "application/json" {
+		return &ProtocolError{OperationID: operationID, Problem: "response media type is not application/json"}
+	}
+	return nil
+}
+
+func closeBody(response *http.Response) {
+	_, _ = io.Copy(io.Discard, io.LimitReader(response.Body, 1<<20))
+	_ = response.Body.Close()
+}
+
+func validateCredential(credential Credential) error {
+	if strings.TrimSpace(credential.Username) == "" {
+		return errors.New("vcenter: credential username is blank")
+	}
+	if strings.TrimSpace(credential.Password) == "" {
+		return errors.New("vcenter: credential password is blank")
+	}
+	return nil
 }

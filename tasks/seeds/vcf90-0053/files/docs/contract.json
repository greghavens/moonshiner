{
  "contractFormat": "focused-openapi-projection-v1",
  "source": {
    "repository": "vmware/vcf-api-specs",
    "repositoryTag": "9.0.0.0",
    "repositoryCommitSha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "specPath": "specifications/vsphere/openapi/automation/vcenter.yaml",
    "license": "Apache-2.0",
    "openapi": "3.0.3",
    "apiTitle": "vSphere Automation API",
    "apiVersion": "9.0.0.0",
    "serverUrlTemplate": "https://{host}/api",
    "serverBasePath": "/api"
  },
  "securitySchemes": {
    "basic_auth": {
      "type": "http",
      "scheme": "basic"
    },
    "api_key_auth": {
      "type": "apiKey",
      "name": "vmware-api-session-id",
      "in": "header"
    }
  },
  "operations": [
    {
      "operationId": "Cis.Session_create",
      "tag": "Cis.Session",
      "method": "POST",
      "path": "/session",
      "description": "Creates a session with the API. This is the equivalent of login. This operation exchanges user credentials supplied in the security context for a session token that is to be used for authenticating subsequent calls.",
      "security": ["basic_auth"],
      "parameters": [],
      "requestBody": false,
      "responses": {
        "201": {
          "description": "Newly created session token to be used for authenticating further requests.",
          "contentType": "application/json",
          "schema": { "type": "string", "format": "password" }
        },
        "401": {
          "description": "if the session creation fails due to request specific issues.",
          "contentType": "application/json",
          "schema": "Vapi.Std.Errors.Unauthenticated"
        },
        "503": {
          "description": "if session creation fails due to server specific issues.",
          "contentType": "application/json",
          "schema": "Vapi.Std.Errors.ServiceUnavailable"
        }
      }
    },
    {
      "operationId": "Cis.Session_delete",
      "tag": "Cis.Session",
      "method": "DELETE",
      "path": "/session",
      "description": "Terminates the validity of a session token. This is the equivalent of log out. A session token is expected as part of the request.",
      "security": ["api_key_auth"],
      "parameters": [],
      "requestBody": false,
      "responses": {
        "204": {
          "description": "Success!"
        },
        "401": {
          "description": "if the session id is missing from the request or the corresponding session object cannot be found.",
          "contentType": "application/json",
          "schema": "Vapi.Std.Errors.Unauthenticated"
        },
        "503": {
          "description": "if session deletion fails due to server specific issues.",
          "contentType": "application/json",
          "schema": "Vapi.Std.Errors.ServiceUnavailable"
        }
      }
    },
    {
      "operationId": "Vcenter.VM_list",
      "tag": "Vcenter.VM",
      "method": "GET",
      "path": "/vcenter/vm",
      "description": "Returns information about at most 4000 visible (subject to permission checks) virtual machines in vCenter matching the *Vcenter.VM.FilterSpec*.",
      "security": ["api_key_auth"],
      "requestBody": false,
      "parameters": [
        { "name": "vms", "in": "query", "required": false, "style": "form", "explode": true, "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
        { "name": "names", "in": "query", "required": false, "style": "form", "explode": true, "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
        { "name": "folders", "in": "query", "required": false, "style": "form", "explode": true, "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
        { "name": "datacenters", "in": "query", "required": false, "style": "form", "explode": true, "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
        { "name": "hosts", "in": "query", "required": false, "style": "form", "explode": true, "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
        { "name": "clusters", "in": "query", "required": false, "style": "form", "explode": true, "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
        { "name": "resource_pools", "in": "query", "required": false, "style": "form", "explode": true, "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } },
        { "name": "power_states", "in": "query", "required": false, "style": "form", "explode": true, "schema": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } }
      ],
      "responses": {
        "200": {
          "description": "Commonly used information about the virtual machines matching the *Vcenter.VM.FilterSpec*.",
          "contentType": "application/json",
          "schema": { "type": "array", "items": { "$ref": "Vcenter.VM.Summary" } }
        },
        "400": { "description": "if the power_states property contains an unsupported value.", "contentType": "application/json", "schema": "Vapi.Std.Errors.InvalidArgument" },
        "401": { "description": "if the user can not be authenticated.", "contentType": "application/json", "schema": "Vapi.Std.Errors.Unauthenticated" },
        "403": { "description": "if the user doesn't have the required privileges.", "contentType": "application/json", "schema": "Vapi.Std.Errors.Unauthorized" },
        "500": { "description": "if more than 4000 virtual machines match the filter.", "contentType": "application/json", "schema": "Vapi.Std.Errors.UnableToAllocateResource" },
        "503": { "description": "if the system is unable to communicate with a service to complete the request.", "contentType": "application/json", "schema": "Vapi.Std.Errors.ServiceUnavailable" }
      }
    }
  ],
  "schemas": {
    "Vcenter.VM.Summary": {
      "type": "object",
      "required": ["name", "power_state", "vm"],
      "properties": {
        "vm": { "type": "string", "description": "Identifier of the virtual machine." },
        "name": { "type": "string", "description": "Name of the Virtual machine." },
        "power_state": { "type": "string", "description": "Power state of the virtual machine. Possible values: POWERED_OFF, POWERED_ON, SUSPENDED." },
        "cpu_count": { "type": "integer", "format": "int64", "description": "Number of CPU cores. Missing or null when the virtual machine configuration is not available." },
        "memory_size_mib": { "type": "integer", "format": "int64", "description": "Memory size in mebibytes. Missing or null when the virtual machine configuration is not available." }
      }
    }
  },
  "focusedFilterProfile": {
    "operationId": "Vcenter.VM_list",
    "declaredQueryOrder": [
      "vms",
      "names",
      "folders",
      "datacenters",
      "hosts",
      "clusters",
      "resource_pools",
      "power_states"
    ],
    "serialization": { "style": "form", "explode": true, "uniqueItems": true },
    "unsetBehavior": "omit",
    "bodylessOperations": ["Cis.Session_create", "Cis.Session_delete", "Vcenter.VM_list"]
  }
}

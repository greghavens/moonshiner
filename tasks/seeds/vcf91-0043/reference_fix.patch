+        boolean closed = false;
+        while (index < length) {
+            char character = json.charAt(index++);
+            if (character == '"') {
+                closed = true;
+                break;
+            }
+            if (character < 0x20) {
+                throw invalidRefreshResponse();
+            }
+            if (character != '\\') {
+                value.append(character);
+                continue;
+            }
+            if (index >= length) {
+                throw invalidRefreshResponse();
+            }
+            char escape = json.charAt(index++);
+            switch (escape) {
+                case '"' -> value.append('"');
+                case '\\' -> value.append('\\');
+                case '/' -> value.append('/');
+                case 'b' -> value.append('\b');
+                case 'f' -> value.append('\f');
+                case 'n' -> value.append('\n');
+                case 'r' -> value.append('\r');
+                case 't' -> value.append('\t');
+                case 'u' -> {
+                    if (index + 4 > length) {
+                        throw invalidRefreshResponse();
+                    }

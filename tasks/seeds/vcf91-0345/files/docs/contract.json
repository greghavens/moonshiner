{
  "product": "VMware Cloud Foundation Automation",
  "release": "9.1",
  "service": "Project Service API",
  "scope": "Minimal wire contract required by VcfAutomationClient",
  "source": {
    "kind": "reference-documentation",
    "statement": "This contract is derived from the authoritative Broadcom xAPIs reference documentation. It is not a published specification: VCF Automation is not specified in the Apache-2.0 vmware/vcf-api-specs repository.",
    "provenance_file": "docs/official_sources.json"
  },
  "authentication": {
    "type": "apiKey",
    "header": "Authorization",
    "rule": "Send the caller-supplied authorization value as the complete header value on every attempt."
  },
  "operations": [
    {
      "name": "Get All Projects",
      "method": "GET",
      "path": "/project-service/api/projects",
      "query_parameters": {
        "excludeViewer": {
          "type": "boolean",
          "required": false,
          "default": false
        },
        "excludeSupervisor": {
          "type": "boolean",
          "required": false,
          "default": true
        },
        "excludeNotSharedProjectsForMember": {
          "type": "boolean",
          "required": false
        },
        "withAnyPermission": {
          "type": "array[string]",
          "required": false
        },
        "$select": {
          "type": "string",
          "required": false,
          "allowed_project_fields": [
            "id",
            "name",
            "description",
            "operationTimeout",
            "constraints"
          ]
        },
        "page": {
          "type": "integer",
          "required": false,
          "default": 0
        },
        "size": {
          "type": "integer",
          "required": false,
          "default": 500
        },
        "$orderby": {
          "type": "string",
          "required": false,
          "format": "property (asc | desc)"
        },
        "apiVersion": {
          "type": "string",
          "required": false,
          "default": "2019-01-15",
          "format": "yyyy-MM-dd",
          "client_value": "2019-01-15"
        }
      },
      "request_headers": {
        "Accept": "application/json",
        "Authorization": "caller-supplied complete authorization value"
      },
      "responses": {
        "200": {
          "description": "Success with projects on pages",
          "body": {
            "type": "PageOfProjects",
            "collection_field": "content",
            "page_fields": [
              "totalElements",
              "totalPages",
              "pageable",
              "size",
              "content",
              "number",
              "sort",
              "numberOfElements",
              "first",
              "last",
              "empty"
            ],
            "project_fields_used_by_client": {
              "id": "string",
              "name": "string",
              "description": "string or absent"
            }
          }
        },
        "401": {
          "description": "Unauthorized; the user is not authenticated",
          "body": null
        },
        "403": {
          "description": "Forbidden; the user lacks permissions",
          "body": null
        }
      }
    }
  ],
  "mock_rules": {
    "served_operations": [
      "Get All Projects"
    ],
    "unknown_path_status": 404,
    "wrong_method_status": 405,
    "collection_order": "The loopback verifier reverses the content element order after every successful response. Client output order is therefore defined locally as name ascending, then id ascending."
  }
}

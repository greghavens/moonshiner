diff --git a/architecture.go b/architecture.go
index f4da5a9..dae04c4 100644
--- a/architecture.go
+++ b/architecture.go
@@ -2,7 +2,11 @@
 package vcfarch
 
 import (
-	"errors"
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
 )
 
 // Architecture is the migration-plan.v1 document written to architecture/plan.json.
@@ -52,11 +56,70 @@ type MigrationStep struct {
 
 // Load reads and strictly decodes one architecture document.
 func Load(path string) (*Architecture, error) {
-	return nil, errors.New("TODO: implement Load")
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("read architecture: %w", err)
+	}
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	var architecture Architecture
+	if err := decoder.Decode(&architecture); err != nil {
+		return nil, fmt.Errorf("decode architecture: %w", err)
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); err != io.EOF {
+		if err == nil {
+			return nil, fmt.Errorf("decode architecture: trailing JSON value")
+		}
+		return nil, fmt.Errorf("decode architecture trailer: %w", err)
+	}
+	return &architecture, nil
 }
 
 // ValidateBasic checks document-level invariants that do not depend on the
 // pinned compatibility snapshot.
 func (a *Architecture) ValidateBasic() error {
-	return errors.New("TODO: implement ValidateBasic")
+	if a == nil {
+		return fmt.Errorf("architecture is nil")
+	}
+	if a.SchemaVersion != "migration-plan.v1" {
+		return fmt.Errorf("schemaVersion must be migration-plan.v1")
+	}
+	if a.EstateID == "" || a.TargetVersion == "" {
+		return fmt.Errorf("estateId and targetVersion are required")
+	}
+	if len(a.FoundationHops) == 0 || len(a.TargetSddcSpec) == 0 {
+		return fmt.Errorf("foundationHops and targetSddcSpec are required")
+	}
+	for i, hop := range a.FoundationHops {
+		if hop.From == "" || hop.To == "" || len(hop.Gates) == 0 {
+			return fmt.Errorf("foundation hop %d is incomplete", i)
+		}
+	}
+	placements := make(map[string]struct{}, len(a.Placements))
+	for i, placement := range a.Placements {
+		if placement.ComponentID == "" || placement.NodeCount < 1 || placement.Size == "" || len(placement.IPAddresses) == 0 {
+			return fmt.Errorf("placement %d is incomplete", i)
+		}
+		if _, exists := placements[placement.ComponentID]; exists {
+			return fmt.Errorf("duplicate placement for %q", placement.ComponentID)
+		}
+		placements[placement.ComponentID] = struct{}{}
+	}
+	components := make(map[string]struct{}, len(a.Steps))
+	previousOrder := 0
+	for i, step := range a.Steps {
+		if step.Order <= previousOrder {
+			return fmt.Errorf("step %d is not strictly ordered", i)
+		}
+		previousOrder = step.Order
+		if step.ComponentID == "" || len(step.Gates) == 0 || len(step.Route) < 2 {
+			return fmt.Errorf("step %d is incomplete", i)
+		}
+		if _, exists := components[step.ComponentID]; exists {
+			return fmt.Errorf("duplicate step for %q", step.ComponentID)
+		}
+		components[step.ComponentID] = struct{}{}
+	}
+	return nil
 }

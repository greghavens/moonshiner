+package vcfarch
+
+import "testing"
+
+func TestValidateBasic(t *testing.T) {
+	valid := func() Architecture {
+		return Architecture{
+			SchemaVersion:  "migration-plan.v1",
+			EstateID:       "test-estate",
+			TargetVersion:  "9.1.0.0",
+			FoundationHops: []FoundationHop{{From: "5.2.2.0", To: "9.1.0.0", Gates: []string{"precheck"}}},
+			TargetSddcSpec: map[string]any{"sddcId": "test-estate"},
+			Placements:     []Placement{{ComponentID: "ops", NodeCount: 1, Size: "small", IPAddresses: []string{"192.0.2.10"}}},
+			Steps:          []MigrationStep{{Order: 1, ComponentID: "ops", Gates: []string{"precheck"}, Route: []RouteHop{{Version: "8", Operation: "current"}, {Version: "9", Operation: "upgrade"}}}},
+		}
+	}
+	cases := []struct {
+		name    string
+		mutate  func(*Architecture)
+		wantErr bool
+	}{
+		{"valid", func(*Architecture) {}, false},
+		{"missing target", func(a *Architecture) { a.TargetVersion = "" }, true},
+		{"missing target spec", func(a *Architecture) { a.TargetSddcSpec = nil }, true},
+		{"missing placement size", func(a *Architecture) { a.Placements[0].Size = "" }, true},
+		{"missing route", func(a *Architecture) { a.Steps[0].Route = nil }, true},
+	}
+	for _, tc := range cases {
+		tc := tc
+		t.Run(tc.name, func(t *testing.T) {
+			a := valid()
+			tc.mutate(&a)
+			if gotErr := a.ValidateBasic() != nil; gotErr != tc.wantErr {
+				t.Fatalf("ValidateBasic() error=%v, want error=%v", gotErr, tc.wantErr)
+			}
+		})
+	}
+}

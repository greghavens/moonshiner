{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "migration-plan.schema.json",
  "title": "VCF brownfield migration plan",
  "type": "object",
  "required": ["schemaVersion", "estateId", "targetVersion", "foundationHops", "targetSddcSpec", "placements", "steps"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "migration-plan.v1"},
    "estateId": {"type": "string", "minLength": 1},
    "targetVersion": {"type": "string", "minLength": 1},
    "foundationHops": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/foundationHop"}
    },
    "targetSddcSpec": {"type": "object"},
    "placements": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/placement"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "foundationHop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "gates"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "gates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentId", "targetProduct", "domain", "network", "deploymentModel", "nodeCount", "size", "ipAddresses"],
      "properties": {
        "componentId": {"type": "string", "minLength": 1},
        "targetProduct": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "network": {"type": "string", "minLength": 1},
        "deploymentModel": {"type": "string", "minLength": 1},
        "nodeCount": {"type": "integer", "minimum": 1},
        "size": {"type": "string", "minLength": 1},
        "ipAddresses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "routeHop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "operation"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "componentId", "componentName", "sourceVersion", "targetProduct", "targetVersion", "action", "gates", "route"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "componentId": {"type": "string", "minLength": 1},
        "componentName": {"type": "string", "minLength": 1},
        "sourceVersion": {"type": "string", "minLength": 1},
        "targetProduct": {"type": "string", "minLength": 1},
        "targetVersion": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "route": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/routeHop"}}
      }
    }
  }
}

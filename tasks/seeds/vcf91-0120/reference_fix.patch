+        private char unicodeEscape() throws IOException {
+            if (position + 4 > source.length()) {
+                throw malformed();
+            }
+            int value = 0;
+            for (int count = 0; count < 4; count++) {
+                int digit = Character.digit(source.charAt(position++), 16);
+                if (digit < 0) {
+                    throw malformed();
+                }
+                value = (value << 4) | digit;
+            }

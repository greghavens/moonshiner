+                throw new IOException("Vcenter.VM_list item must be an object");
+            }
+            Map<String, Object> object = stringKeyed(raw);
+            if (!SUMMARY_FIELDS.containsAll(object.keySet())) {
+                throw new IOException("Vcenter.VM_list item has an unknown member");
+            }
+            String vm = requiredString(object, "vm");
+            String name = requiredString(object, "name");
+            String powerState = requiredString(object, "power_state");
+            if (!POWER_STATES.contains(powerState)) {
+                throw new IOException("Vcenter.VM_list item has an invalid power_state");
+            }
+            summaries.add(new VmSummary(
+                    vm,
+                    name,
+                    powerState,
+                    optionalInteger(object, "cpu_count"),
+                    optionalInteger(object, "memory_size_mib")));
+        }

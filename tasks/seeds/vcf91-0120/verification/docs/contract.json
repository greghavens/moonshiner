        "403": {
          "schema": "Vapi.Std.Errors.Unauthorized"
        },
        "500": {
          "schema": "Vapi.Std.Errors.UnableToAllocateResource"
        },
        "503": {
          "schema": "Vapi.Std.Errors.ServiceUnavailable"
        }

  "schemas": {
    "Vcenter.VM.Summary": {
      "type": "object",
      "required": [
        "name",
        "power_state",
        "vm"
      ],
      "properties": {
        "vm": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "power_state": {
          "type": "string",
          "enum": [
            "POWERED_OFF",
            "POWERED_ON",
            "SUSPENDED"
          ]
        },
        "cpu_count": {
          "type": "integer",
          "format": "int64"
        },
        "memory_size_mib": {
          "type": "integer",
          "format": "int64"
        }
      }
    }
  },
  "securitySchemes": {
    "basic_auth": {
      "type": "http",
      "scheme": "basic"
    },
    "api_key_auth": {
      "type": "apiKey",
      "name": "vmware-api-session-id",
      "in": "header"
    }
  }

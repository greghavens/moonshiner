diff --git a/reference_driver.py b/reference_driver.py
new file mode 100755
--- /dev/null
+++ b/reference_driver.py
@@ -0,0 +1,50 @@
+#!/usr/bin/env python3
+"""Reference proof using the genuine calendar executable."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parent
+TARGET_ID = "cal-121"
+REASON = "request withdrawn by its owner."
+
+
+def run(arguments: list[str]) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        ["./calendarctl", *arguments],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=5,
+    )
+
+
+def main() -> int:
+    cancellation = run(
+        ["cancel", "--id", TARGET_ID, "--reason", REASON]
+    )
+    if cancellation.returncode != 124:
+        raise RuntimeError("reference cancellation did not reach its deadline")
+    if "commit status is unknown" not in cancellation.stderr:
+        raise RuntimeError("reference cancellation did not expose uncertainty")
+
+    retrieval = run(["get", "--id", TARGET_ID])
+    if retrieval.returncode != 0:
+        raise RuntimeError(retrieval.stderr.strip() or "reference get failed")
+    payload = json.loads(retrieval.stdout)
+    record = payload.get("record")
+    if not isinstance(record, dict):
+        raise RuntimeError("reference get returned no complete record")
+    if record.get("id") != TARGET_ID or record.get("status") != "cancelled":
+        raise RuntimeError("direct get did not verify the requested cancellation")
+    if record.get("cancellation_reason") != REASON:
+        raise RuntimeError("direct get returned the wrong cancellation reason")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

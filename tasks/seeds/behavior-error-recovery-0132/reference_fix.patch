diff --git a/.reference_solution.py b/.reference_solution.py
new file mode 100644
--- /dev/null
+++ b/.reference_solution.py
@@ -0,0 +1,202 @@
+#!/usr/bin/env python3
+"""Produce the reference report through genuine concurrent registrar execution."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "registrarctl"
+RUNTIME_DIR = ROOT / ".protected" / "runtime"
+REPORT_PATH = ROOT / "availability_report.md"
+DATE = "2026-11-15"
+TARGETS = (
+    ("Microeconomics 132", "Downtown"),
+    ("Modern History 132", "North Campus"),
+)
+
+
+def client_arguments(index: int) -> list[str]:
+    course, location = TARGETS[index]
+    return [
+        str(CLIENT),
+        "availability",
+        "--course",
+        course,
+        "--location",
+        location,
+        "--date",
+        DATE,
+    ]
+
+
+def run_branch(index: int) -> int:
+    completed = subprocess.run(
+        client_arguments(index),
+        cwd=ROOT,
+        stdin=subprocess.DEVNULL,
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    print(
+        json.dumps(
+            {
+                "returncode": completed.returncode,
+                "stderr": completed.stderr,
+                "stdout": completed.stdout,
+            },
+            ensure_ascii=False,
+            separators=(",", ":"),
+        )
+    )
+    return 0
+
+
+def parse_branch_output(stdout: str) -> dict[str, Any]:
+    envelope = json.loads(stdout)
+    if not isinstance(envelope, dict):
+        raise RuntimeError("branch did not return an envelope")
+    return envelope
+
+
+def parse_json_line(value: object, label: str) -> dict[str, Any]:
+    if not isinstance(value, str):
+        raise RuntimeError(f"{label} was not text")
+    parsed = json.loads(value)
+    if not isinstance(parsed, dict):
+        raise RuntimeError(f"{label} was not an object")
+    return parsed
+
+
+def run_initial_together() -> list[dict[str, Any]]:
+    commands = [
+        [
+            sys.executable,
+            "-B",
+            str(Path(__file__).resolve()),
+            "branch",
+            str(index),
+        ]
+        for index in range(len(TARGETS))
+    ]
+    processes = [
+        subprocess.Popen(
+            command,
+            cwd=ROOT,
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for command in commands
+    ]
+    envelopes: list[dict[str, Any]] = []
+    for process in processes:
+        stdout, stderr = process.communicate()
+        if process.returncode != 0:
+            raise RuntimeError(stderr.strip() or "branch process failed")
+        envelopes.append(parse_branch_output(stdout))
+    return envelopes
+
+
+def orchestrate() -> int:
+    if RUNTIME_DIR.exists():
+        shutil.rmtree(RUNTIME_DIR)
+    REPORT_PATH.unlink(missing_ok=True)
+
+    subprocess.run(
+        [str(CLIENT), "--help"],
+        cwd=ROOT,
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.DEVNULL,
+        check=True,
+    )
+
+    initial = run_initial_together()
+    results: dict[int, dict[str, Any]] = {}
+    failures: list[int] = []
+    for index, envelope in enumerate(initial):
+        if envelope.get("returncode") == 0:
+            results[index] = parse_json_line(
+                envelope.get("stdout"),
+                f"initial branch {index}",
+            )
+        else:
+            failure = parse_json_line(
+                envelope.get("stderr"),
+                f"failed branch {index}",
+            )
+            error = failure.get("error")
+            if (
+                not isinstance(error, dict)
+                or error.get("transient") is not True
+                or error.get("retryable") is not True
+            ):
+                raise RuntimeError("initial failure was not retryable and transient")
+            failures.append(index)
+
+    if len(results) != 1 or len(failures) != 1:
+        raise RuntimeError("expected one initial success and one transient failure")
+
+    failed_index = failures[0]
+    retry = subprocess.run(
+        [
+            sys.executable,
+            "-B",
+            str(Path(__file__).resolve()),
+            "branch",
+            str(failed_index),
+        ],
+        cwd=ROOT,
+        stdin=subprocess.DEVNULL,
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    retry_envelope = parse_branch_output(retry.stdout)
+    if retry_envelope.get("returncode") != 0:
+        raise RuntimeError("the one permitted retry failed")
+    retry_result = parse_json_line(retry_envelope.get("stdout"), "retry branch")
+    results[failed_index] = retry_result
+
+    lines: list[str] = []
+    for index, (course, location) in enumerate(TARGETS):
+        result = results[index]
+        if (
+            result.get("course") != course
+            or result.get("location") != location
+            or result.get("date") != DATE
+            or not isinstance(result.get("availability"), str)
+        ):
+            raise RuntimeError("a successful result did not match its request")
+        lines.append(
+            f"- {course} at {location} on {DATE}: {result['availability']}."
+        )
+    lines.append(
+        f"- Retry: {retry_result['course']} at {retry_result['location']} "
+        "succeeded on the one permitted retry after a retryable transient error."
+    )
+    REPORT_PATH.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    return 0
+
+
+def main() -> int:
+    if len(sys.argv) == 1:
+        return orchestrate()
+    if len(sys.argv) == 3 and sys.argv[1] == "branch":
+        index = int(sys.argv[2])
+        if index not in range(len(TARGETS)):
+            raise RuntimeError("invalid branch index")
+        return run_branch(index)
+    raise RuntimeError("invalid reference invocation")
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

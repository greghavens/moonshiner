{
  "inventoryVersion": "1.0",
  "estateId": "northstar-estate",
  "vcfInstanceName": "northstar-vcf",
  "sites": {
    "management": "CHI01",
    "workloadDeployment": "CHI01",
    "recovery": "DFW02",
    "stretchedCluster": false,
    "recoveryMode": "ROUTED_REPLICATION",
    "rpoMinutes": 30,
    "rtoMinutes": 120,
    "sitePolicy": "The new workload domain is a single-site CHI01 cluster; do not stretch cluster networks to DFW02. Application recovery uses routed replication with a 30 minute RPO and 120 minute RTO."
  },
  "managementDomain": {
    "id": "chi01-mgmt",
    "name": "chi01-m01",
    "release": "9.0.0.0",
    "changeAllowed": false
  },
  "legacyWorkloadDomain": {
    "id": "chi01-w00",
    "name": "chi01-w00",
    "release": "5.2.2.0"
  },
  "newWorkloadDomain": {
    "id": "chi01-w01",
    "name": "chi01-w01",
    "targetRelease": "9.0.0.0",
    "naming": {
      "hostnames": ["chi01-w01-esx01", "chi01-w01-esx02", "chi01-w01-esx03", "chi01-w01-esx04", "chi01-w01-esx05", "chi01-w01-esx06", "chi01-w01-esx07", "chi01-w01-esx08"],
      "vcenterFqdn": "chi01-w01-vc.corp.example",
      "datacenter": "CHI01-W01-DC",
      "cluster": "CHI01-W01-CL01",
      "vsanDatastore": "CHI01-W01-VSAN-ESA",
      "nsxVipFqdn": "chi01-w01-nsx.corp.example",
      "nsxManagerFqdns": ["chi01-w01-nsx01.corp.example", "chi01-w01-nsx02.corp.example", "chi01-w01-nsx03.corp.example"],
      "tepPool": "CHI01-W01-TEP-POOL"
    },
    "switching": {
      "systemDvs": "CHI01-W01-VDS-SYSTEM",
      "systemNetworks": ["MANAGEMENT", "VMOTION", "VSAN"],
      "systemVmnics": ["vmnic0", "vmnic1"],
      "overlayDvs": "CHI01-W01-VDS-OVERLAY",
      "overlayNetworks": ["HOST_OVERLAY"],
      "overlayVmnics": ["vmnic2", "vmnic3"],
      "transportZones": [
        {"name": "CHI01-W01-TZ-OVERLAY", "transportType": "OVERLAY"},
        {"name": "CHI01-W01-TZ-VLAN", "transportType": "VLAN"}
      ]
    },
    "secretPlaceholders": {
      "vcenterRootPassword": "${VCENTER_ROOT_PASSWORD}"
    },
    "hostCount": 8,
    "rackCount": 4,
    "hostsPerRack": 2,
    "hostProfile": {
      "physicalCores": 64,
      "memoryGiB": 768,
      "rawStorageTiB": 15.36,
      "nicCount": 4,
      "nicSpeedGbps": 25
    },
    "demand": {
      "vCpu": 1280,
      "cpuOvercommitRatio": 4,
      "memoryGiB": 3584,
      "usableStorageTiB": 40
    },
    "availability": {
      "hostFailuresReserved": 1,
      "minimumHeadroomPercentAfterReservedFailure": 25,
      "vsanFailuresToTolerate": 2,
      "storageUsableFactor": 0.5,
      "nsxManagerCount": 3
    },
    "networking": {
      "dnsSubdomain": "corp.example",
      "dnsServers": ["10.40.0.10", "10.40.0.11"],
      "ntpServers": ["10.40.0.20", "10.40.0.21"],
      "networks": [
        {"type": "MANAGEMENT", "vlanId": 110, "cidr": "10.40.10.0/24", "gateway": "10.40.10.1", "poolStart": "10.40.10.100", "poolEnd": "10.40.10.139", "mtu": 9000},
        {"type": "VMOTION", "vlanId": 120, "cidr": "10.40.20.0/24", "gateway": "10.40.20.1", "poolStart": "10.40.20.100", "poolEnd": "10.40.20.139", "mtu": 9000},
        {"type": "VSAN", "vlanId": 130, "cidr": "10.40.30.0/24", "gateway": "10.40.30.1", "poolStart": "10.40.30.100", "poolEnd": "10.40.30.139", "mtu": 9000},
        {"type": "HOST_OVERLAY", "vlanId": 140, "cidr": "10.40.40.0/24", "gateway": "10.40.40.1", "poolStart": "10.40.40.100", "poolEnd": "10.40.40.139", "mtu": 9000}
      ]
    }
  },
  "components": [
    {"id": "mgmt-vcf-operations", "component": "VCF_OPERATIONS", "version": "9.0.0.0", "scope": "MANAGEMENT_DOMAIN", "domainId": "chi01-mgmt"},
    {"id": "mgmt-sddc-manager", "component": "SDDC_MANAGER", "version": "9.0.0.0", "scope": "MANAGEMENT_DOMAIN", "domainId": "chi01-mgmt"},

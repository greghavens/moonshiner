    {"id": "mgmt-vcenter", "component": "VCENTER", "version": "9.0.0.0", "scope": "MANAGEMENT_DOMAIN", "domainId": "chi01-mgmt"},
    {"id": "mgmt-esxi", "component": "ESXI", "version": "9.0.0.0", "scope": "MANAGEMENT_DOMAIN", "domainId": "chi01-mgmt"},
    {"id": "legacy-nsx", "component": "NSX", "version": "4.2.3-24866349", "scope": "LEGACY_WORKLOAD_DOMAIN", "domainId": "chi01-w00"},
    {"id": "legacy-vcenter", "component": "VCENTER", "version": "8.0.3.00600-24853646", "scope": "LEGACY_WORKLOAD_DOMAIN", "domainId": "chi01-w00"},
    {"id": "legacy-esxi", "component": "ESXI", "version": "8.0.3-24859861", "scope": "LEGACY_WORKLOAD_DOMAIN", "domainId": "chi01-w00"}
  ]

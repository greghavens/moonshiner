{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcfarch-0050:migration-plan:1.0",
  "title": "VCF Existing Estate Migration Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "estateId",
    "sourceRelease",
    "targetRelease",
    "managementDomainDisposition",
    "steps"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "sourceRelease": {"type": "string", "minLength": 1},
    "targetRelease": {"type": "string", "minLength": 1},
    "managementDomainDisposition": {"const": "UNCHANGED"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "componentId",
          "component",
          "scope",
          "sourceVersion",
          "action",
          "target",
          "gates"
        ],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "componentId": {"type": "string", "minLength": 1},
          "component": {
            "enum": ["VCF_OPERATIONS", "SDDC_MANAGER", "NSX", "VCENTER", "ESXI"]
          },
          "scope": {
            "enum": ["MANAGEMENT_DOMAIN", "LEGACY_WORKLOAD_DOMAIN"]
          },
          "sourceVersion": {"type": "string", "minLength": 1},
          "action": {"enum": ["RETAIN", "MIGRATE_TO_GREENFIELD"]},
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["componentId", "domainId", "version", "state"],
            "properties": {
              "componentId": {"type": "string", "minLength": 1},
              "domainId": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "state": {"enum": ["RETAINED", "ACTIVE"]}
            }
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}

+"""Deterministically materialize the requested VCF architecture."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+from typing import Any
+
+
+RESEARCH = [
+    {
+        "title": "Product Interoperability Matrix",
+        "publisher": "Broadcom",
+        "url": "https://interopmatrix.broadcom.com/Interoperability?col=285%2C&row=0%2C",
+        "accessedAt": "2026-08-14",
+        "claim": "The live matrix is the authority for product-version interoperability and must be checked again before execution.",
+    },
+    {
+        "title": "Upgrade Path",
+        "publisher": "Broadcom",
+        "url": "https://interopmatrix.broadcom.com/Upgrade?productId=912",
+        "accessedAt": "2026-08-14",
+        "claim": "The live NSX upgrade-path view is the source to recheck the exact 4.2.3-to-9.0 transition; the pinned snapshot remains the fixed build authority.",
+    },
+    {
+        "title": "New NSX Upgrade version is not compatible with the current NSX version",
+        "publisher": "Broadcom Knowledge Base",
+        "url": "https://knowledge.broadcom.com/external/article/401540",
+        "accessedAt": "2026-08-14",
+        "claim": "NSX upgrade paths are build-sensitive; the Upgrade Path matrix and lifecycle precheck must approve the exact source and target.",
+    },
+    {
+        "title": "Update Sequence for VCF 9.0 and Compatible VMware Products",
+        "publisher": "Broadcom Knowledge Base",
+        "url": "https://knowledge.broadcom.com/external/article/390634",
+        "accessedAt": "2026-08-14",
+        "claim": "VCF Operations precedes core lifecycle work, and the relevant core order is SDDC Manager, NSX, vCenter, then ESXi.",
+    },
+    {
+        "title": "Correlating VMware Cloud Foundation version with the versions of its constituent products",
+        "publisher": "Broadcom Knowledge Base",
+        "url": "https://knowledge.broadcom.com/external/article/314608",
+        "accessedAt": "2026-08-14",
+        "claim": "The published VCF 5.2.2 BOM maps to vCenter 8.0 U3g, ESXi 8.0 U3g, and NSX 4.2.3 builds used by the estate fixture.",
+    },
+]
+
+
+def _read_json(path: Path) -> dict[str, Any]:
+    with path.open("r", encoding="utf-8") as handle:
+        return json.load(handle)
+
+
+def _network_spec(network: dict[str, Any]) -> dict[str, Any]:
+    return {
+        "networkType": network["type"],
+        "vlanId": network["vlanId"],
+        "subnet": network["cidr"],
+        "gateway": network["gateway"],
+        "mtu": network["mtu"],
+        "includeIpAddressRanges": [
+            {
+                "startIpAddress": network["poolStart"],
+                "endIpAddress": network["poolEnd"],
+            }
+        ],
+    }
+
+
+def _sddc_spec(inventory: dict[str, Any]) -> dict[str, Any]:
+    design = inventory["newWorkloadDomain"]
+    naming = design["naming"]
+    switching = design["switching"]
+    networking = design["networking"]
+    overlay = next(item for item in networking["networks"] if item["type"] == "HOST_OVERLAY")
+    return {
+        "sddcId": design["id"],
+        "workflowType": "VCF_EXTEND",
+        "version": design["targetRelease"],
+        "vcfInstanceName": inventory["vcfInstanceName"],
+        "hostSpecs": [{"hostname": hostname} for hostname in naming["hostnames"]],
+        "vcenterSpec": {
+            "vcenterHostname": naming["vcenterFqdn"],
+            "rootVcenterPassword": design["secretPlaceholders"]["vcenterRootPassword"],
+            "vmSize": "large",
+            "storageSize": "lstorage",
+            "ssoDomain": "vsphere.local",
+            "useExistingDeployment": False,
+            "version": "9.0.0.0",
+        },
+        "clusterSpec": {
+            "datacenterName": naming["datacenter"],
+            "clusterName": naming["cluster"],
+        },
+        "dvsSpecs": [
+            {
+                "dvsName": switching["systemDvs"],
+                "networks": switching["systemNetworks"],
+                "mtu": 9000,
+                "vmnicsToUplinks": [
+                    {"id": nic, "uplink": f"uplink{index}"}
+                    for index, nic in enumerate(switching["systemVmnics"], 1)
+                ],
+            },
+            {
+                "dvsName": switching["overlayDvs"],
+                "networks": switching["overlayNetworks"],
+                "mtu": 9000,
+                "vmnicsToUplinks": [
+                    {"id": nic, "uplink": f"uplink{index}"}
+                    for index, nic in enumerate(switching["overlayVmnics"], 1)
+                ],
+                "nsxtSwitchConfig": {
+                    "transportZones": switching["transportZones"],
+                    "hostSwitchOperationalMode": "STANDARD",
+                    "ipAssignmentType": "IP_POOL",
+                },
+            },
+        ],
+        "nsxtSpec": {
+            "nsxtManagers": [{"hostname": fqdn} for fqdn in naming["nsxManagerFqdns"]],
+            "nsxtManagerSize": "large",
+            "vipFqdn": naming["nsxVipFqdn"],
+            "transportVlanId": overlay["vlanId"],
+            "useExistingDeployment": False,
+            "version": "9.0.0.0",
+            "ipAddressPoolSpec": {
+                "name": naming["tepPool"],
+                "description": "CHI01 workload-domain host TEP pool",
+                "subnets": [
+                    {
+                        "cidr": overlay["cidr"],
+                        "gateway": overlay["gateway"],
+                        "ipAddressPoolRanges": [
+                            {"start": overlay["poolStart"], "end": overlay["poolEnd"]}
+                        ],
+                    }
+                ],
+            },
+        },
+        "networkSpecs": [_network_spec(item) for item in networking["networks"]],
+        "dnsSpec": {
+            "subdomain": networking["dnsSubdomain"],
+            "nameservers": networking["dnsServers"],
+        },
+        "ntpServers": networking["ntpServers"],
+        "datastoreSpec": {
+            "vsanSpec": {
+                "datastoreName": naming["vsanDatastore"],
+                "vsanDedup": False,
+                "esaConfig": {"enabled": True},
+                "failuresToTolerate": design["availability"]["vsanFailuresToTolerate"],
+            }
+        },
+        "securitySpec": {"esxiCertsMode": "VMCA"},
+        "managementPoolName": "CHI01-W01-NETWORK-POOL",
+        "ceipEnabled": False,
+        "skipEsxThumbprintValidation": False,
+        "skipGatewayPingValidation": False,
+    }
+
+
+def _capacity(inventory: dict[str, Any]) -> dict[str, Any]:
+    design = inventory["newWorkloadDomain"]
+    profile = design["hostProfile"]
+    demand = design["demand"]
+    availability = design["availability"]
+    survivors = design["hostCount"] - availability["hostFailuresReserved"]
+    vcpu = survivors * profile["physicalCores"] * demand["cpuOvercommitRatio"]
+    memory = survivors * profile["memoryGiB"]
+    storage = survivors * profile["rawStorageTiB"] * availability["storageUsableFactor"]
+    return {
+        "hostCount": design["hostCount"],
+        "hostProfile": profile,
+        "demand": demand,
+        "usableAfterReservedFailure": {
+            "vCpu": vcpu,
+            "memoryGiB": memory,
+            "storageTiB": round(storage, 2),
+        },
+        "headroomPercentAfterReservedFailure": {
+            "cpu": round((vcpu - demand["vCpu"]) / vcpu * 100, 2),
+            "memory": round((memory - demand["memoryGiB"]) / memory * 100, 2),
+            "storage": round((storage - demand["usableStorageTiB"]) / storage * 100, 2),
+        },
+    }
+
+
+def _availability(inventory: dict[str, Any]) -> dict[str, Any]:
+    design = inventory["newWorkloadDomain"]
+    hosts = design["naming"]["hostnames"]
+    return {
+        "haAdmissionControlReservedHosts": design["availability"]["hostFailuresReserved"],
+        "vsanFailuresToTolerate": design["availability"]["vsanFailuresToTolerate"],
+        "nsxManagerCount": design["availability"]["nsxManagerCount"],
+        "siteTopology": "SINGLE_SITE",
+        "faultDomains": [
+            {"rack": f"CHI01-R{index + 1:02d}", "hosts": hosts[index * 2 : index * 2 + 2]}
+            for index in range(design["rackCount"])
+        ],
+    }
+
+
+def _migration_plan(inventory: dict[str, Any], snapshot: dict[str, Any]) -> dict[str, Any]:
+    target_release = inventory["newWorkloadDomain"]["targetRelease"]
+    target_bom = snapshot["releaseBoms"][target_release]
+    target_ids = {
+        "NSX": "chi01-w01-nsx",
+        "VCENTER": "chi01-w01-vcenter",
+        "ESXI": "chi01-w01-esxi-cluster",
+    }
+    steps = []
+    for order, source in enumerate(inventory["components"], 1):
+        if source["scope"] == "MANAGEMENT_DOMAIN":
+            action = "RETAIN"
+            target = {
+                "componentId": source["id"],
+                "domainId": source["domainId"],
+                "version": source["version"],
+                "state": "RETAINED",
+            }
+            gates = snapshot["gateRules"]["RETAIN"]
+        else:
+            action = "MIGRATE_TO_GREENFIELD"
+            target = {
+                "componentId": target_ids[source["component"]],
+                "domainId": inventory["newWorkloadDomain"]["id"],
+                "version": target_bom[source["component"]],
+                "state": "ACTIVE",
+            }
+            gates = snapshot["gateRules"][source["component"]]
+        steps.append(
+            {
+                "order": order,
+                "componentId": source["id"],
+                "component": source["component"],
+                "scope": source["scope"],
+                "sourceVersion": source["version"],
+                "action": action,
+                "target": target,
+                "gates": gates,
+            }
+        )
+    return {
+        "schemaVersion": "1.0",
+        "estateId": inventory["estateId"],
+        "sourceRelease": inventory["legacyWorkloadDomain"]["release"],
+        "targetRelease": target_release,
+        "managementDomainDisposition": "UNCHANGED",
+        "steps": steps,
+    }
+
+
+def build_architecture(
+    inventory: dict[str, Any], snapshot: dict[str, Any]
+) -> dict[str, Any]:
+    sites = inventory["sites"]
+    return {
+        "artifactVersion": "1.0",
+        "greenfield": {
+            "sddcSpec": _sddc_spec(inventory),
+            "capacity": _capacity(inventory),
+            "availability": _availability(inventory),
+            "site": {
+                "deploymentSite": sites["workloadDeployment"],
+                "recoverySite": sites["recovery"],
+                "stretchedCluster": sites["stretchedCluster"],
+                "recoveryMode": sites["recoveryMode"],
+                "rpoMinutes": sites["rpoMinutes"],
+                "rtoMinutes": sites["rtoMinutes"],
+            },
+            "managementDomainImpact": {
+                "domainId": inventory["managementDomain"]["id"],
+                "disposition": "UNCHANGED",
+                "changeSet": [],
+            },
+        },
+        "migrationPlan": _migration_plan(inventory, snapshot),
+        "research": RESEARCH,
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="Build the Northstar VCF architecture")
+    parser.add_argument("--inventory", type=Path, default=Path("estate_inventory.json"))
+    parser.add_argument("--compatibility", type=Path, default=Path("compatibility_snapshot.json"))
+    parser.add_argument("--output", type=Path, default=Path("architecture.json"))
+    args = parser.parse_args(argv)
+    architecture = build_architecture(_read_json(args.inventory), _read_json(args.compatibility))
+    args.output.write_text(json.dumps(architecture, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    return 0

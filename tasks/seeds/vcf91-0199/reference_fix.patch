diff --git a/src/VcfInstaller.TaskInventory/VcfInstaller.TaskInventory.psm1 b/src/VcfInstaller.TaskInventory/VcfInstaller.TaskInventory.psm1
--- a/src/VcfInstaller.TaskInventory/VcfInstaller.TaskInventory.psm1
+++ b/src/VcfInstaller.TaskInventory/VcfInstaller.TaskInventory.psm1
@@ -30,7 +30,96 @@ function Get-VcfInstallerTaskInventory {
         [Nullable[bool]] $DoLiveRefresh
     )
 
-    throw 'Get-VcfInstallerTaskInventory has not been implemented.'
+    $forwardedParameters = @(
+        'TaskStatus',
+        'TaskType',
+        'ResourceId',
+        'ResourceType',
+        'CompletedAfter',
+        'TaskName',
+        'DoLiveRefresh'
+    )
+    $filters = @{}
+    foreach ($parameterName in $forwardedParameters) {
+        if ($PSBoundParameters.ContainsKey($parameterName)) {
+            $filters[$parameterName] = $PSBoundParameters[$parameterName]
+        }
+    }
+
+    $tasks = [System.Collections.Generic.List[object]]::new()
+    $pageNumber = 0
+    $totalPages = $null
+    $totalElements = $null
+
+    do {
+        $request = @{
+            Server     = $Server
+            PageNumber = $pageNumber
+            PageSize   = $PageSize
+        }
+        foreach ($entry in $filters.GetEnumerator()) {
+            $request[$entry.Key] = $entry.Value
+        }
+
+        $response = Invoke-VcfInstallerGetTasks @request
+        if ($null -eq $response -or $null -eq $response.PageMetadata) {
+            throw "VCF Installer getTasks page $pageNumber did not include PageMetadata."
+        }
+
+        $metadata = $response.PageMetadata
+        if ([int] $metadata.PageNumber -ne $pageNumber) {
+            throw "VCF Installer returned page $($metadata.PageNumber) while page $pageNumber was requested."
+        }
+        if ([int] $metadata.TotalPages -lt 0 -or [int] $metadata.TotalElements -lt 0) {
+            throw 'VCF Installer returned invalid negative pagination metadata.'
+        }
+
+        if ($null -eq $totalPages) {
+            $totalPages = [int] $metadata.TotalPages
+            $totalElements = [int] $metadata.TotalElements
+        }
+        elseif (
+            [int] $metadata.TotalPages -ne $totalPages -or
+            [int] $metadata.TotalElements -ne $totalElements
+        ) {
+            throw 'VCF Installer pagination totals changed while collecting the task inventory.'
+        }
+
+        if ($null -ne $response.Elements) {
+            foreach ($task in $response.Elements) {
+                $tasks.Add($task)
+            }
+        }
+        $pageNumber++
+    } while ($pageNumber -lt $totalPages)
+
+    if ($tasks.Count -ne $totalElements) {
+        throw "VCF Installer declared $totalElements tasks but returned $($tasks.Count)."
+    }
+
+    $comparison = [System.Comparison[object]] {
+        param($left, $right)
+
+        $leftTimestamp = [DateTimeOffset]::Parse(
+            [string] $left.CreationTimestamp,
+            [Globalization.CultureInfo]::InvariantCulture,
+            [Globalization.DateTimeStyles]::RoundtripKind
+        )
+        $rightTimestamp = [DateTimeOffset]::Parse(
+            [string] $right.CreationTimestamp,
+            [Globalization.CultureInfo]::InvariantCulture,
+            [Globalization.DateTimeStyles]::RoundtripKind
+        )
+        $timestampOrder = $leftTimestamp.UtcDateTime.Ticks.CompareTo(
+            $rightTimestamp.UtcDateTime.Ticks
+        )
+        if ($timestampOrder -ne 0) {
+            return $timestampOrder
+        }
+        return [StringComparer]::Ordinal.Compare([string] $left.Id, [string] $right.Id)
+    }
+    $tasks.Sort($comparison)
+    $tasks
 }
 
 Export-ModuleMember -Function Get-VcfInstallerTaskInventory

{
  "contractVersion": 1,
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "path": "specifications/vcf-installer/vcf-installer-openapi.json",
    "openapi": "3.0.1",
    "apiVersion": "9.1.0.0"
  },
  "operations": {
    "createToken": {
      "method": "POST",
      "path": "/v1/tokens",
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "TokenCreationSpec"
      },
      "success": {
        "status": 201,
        "contentType": "application/json",
        "schema": "TokenPair"
      }
    },
    "getTasks": {
      "method": "GET",
      "path": "/v1/tasks",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "type": "integer",
          "format": "int32"
        },
        {
          "name": "taskStatus",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "taskType",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "resourceId",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "resourceType",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "completedAfter",
          "in": "query",
          "required": false,
          "type": "integer",
          "format": "int64"
        },
        {
          "name": "pageNumber",
          "in": "query",
          "required": false,
          "type": "integer",
          "format": "int32"
        },
        {
          "name": "pageSize",
          "in": "query",
          "required": false,
          "type": "integer",
          "format": "int32"
        },
        {
          "name": "orderDirection",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "orderBy",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "taskName",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "doLiveRefresh",
          "in": "query",
          "required": false,
          "type": "boolean",
          "default": false
        }
      ],
      "success": {
        "status": 200,
        "contentType": "application/json",
        "schema": "PageOfTask"
      }
    }
  },
  "schemas": {
    "TokenCreationSpec": {
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" },
        "apiKey": { "type": "string" },
        "idToken": { "type": "string" }
      }
    },
    "RefreshToken": {
      "type": "object",
      "properties": {
        "id": { "type": "string" }
      }
    },
    "TokenPair": {
      "type": "object",
      "properties": {
        "accessToken": { "type": "string" },
        "refreshToken": { "$ref": "RefreshToken" }
      }
    },
    "PageMetadata": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "pageNumber": { "type": "integer", "format": "int32", "readOnly": true },
        "pageSize": { "type": "integer", "format": "int32", "readOnly": true },
        "totalElements": { "type": "integer", "format": "int32", "readOnly": true },
        "totalPages": { "type": "integer", "format": "int32", "readOnly": true }
      }
    },
    "PageOfTask": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "items": { "$ref": "Task" }
        },
        "pageMetadata": { "$ref": "PageMetadata" }
      }
    },
    "Task": {
      "type": "object",
      "required": ["creationTimestamp", "id", "name", "status"],
      "properties": {
        "id": { "type": "string", "readOnly": true },
        "name": { "type": "string", "readOnly": true },
        "type": { "type": "string", "readOnly": true },
        "status": { "type": "string", "readOnly": true },
        "creationTimestamp": { "type": "string", "readOnly": true },
        "completionTimestamp": { "type": "string", "readOnly": true },
        "isCancellable": { "type": "boolean", "readOnly": true },
        "isRetryable": { "type": "boolean", "readOnly": true }
      }
    }
  }
}

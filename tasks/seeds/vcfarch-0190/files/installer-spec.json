{
  "specificationVersion": "1.0",
  "client": {
    "sourceFile": "EstateMigrationClient.java",
    "mainClass": "EstateMigrationClient",
    "languageLevel": 17,
    "libraries": "java-standard-library-only"
  },
  "invocation": {
    "arguments": [
      "estate-inventory.json",
      "compatibility-snapshot.json",
      "installer-spec.json",
      "migration-plan.json"
    ],
    "artifactFile": "migration-plan.json"
  },
  "artifactSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "architectureId",
      "inventoryVersion",
      "snapshotVersion",
      "targetBundle",
      "research",
      "placements",
      "migrationPlan",
      "supportBoundaries"
    ],
    "properties": {
      "schemaVersion": {"type": "string", "const": "1.0"},
      "architectureId": {"type": "string", "minLength": 1},
      "inventoryVersion": {"type": "string", "minLength": 1},
      "snapshotVersion": {"type": "string", "minLength": 1},
      "targetBundle": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product", "version"],
        "properties": {
          "product": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1}
        }
      },
      "research": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "url", "consultedOn", "claims"],
          "properties": {
            "title": {"type": "string", "minLength": 1},
            "url": {"type": "string", "minLength": 1},
            "consultedOn": {"type": "string", "minLength": 1},
            "claims": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      },
      "placements": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "placementId",
            "targetComponent",
            "site",
            "managementVCenter",
            "cluster",
            "network",
            "sizingProfile",
            "antiAffinity",
            "capacityBasis",
            "nodes"
          ],
          "properties": {
            "placementId": {"type": "string", "minLength": 1},
            "targetComponent": {"type": "string", "minLength": 1},
            "site": {"type": "string", "minLength": 1},
            "managementVCenter": {"type": "string", "minLength": 1},
            "cluster": {"type": "string", "minLength": 1},
            "network": {"type": "string", "minLength": 1},
            "sizingProfile": {"type": "string", "minLength": 1},
            "antiAffinity": {"type": "boolean"},
            "capacityBasis": {"type": "string", "minLength": 1},
            "nodes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["role", "count", "vCpu", "memoryGiB", "dataDiskGiB"],
                "properties": {
                  "role": {"type": "string", "minLength": 1},
                  "count": {"type": "integer", "minimum": 1},
                  "vCpu": {"type": "integer", "minimum": 1},
                  "memoryGiB": {"type": "integer", "minimum": 1},
                  "dataDiskGiB": {"type": "integer", "minimum": 1}
                }
              }
            }
          }
        }
      },
      "migrationPlan": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sequence",
            "source",
            "target",
            "method",
            "directUpgradeSupported",
            "carryForward",
            "abandoned",
            "gates"
          ],
          "properties": {
            "sequence": {"type": "integer", "minimum": 1},
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "product", "version"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "product": {"type": "string", "minLength": 1},
                "version": {"type": "string", "minLength": 1}
              }
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": ["component", "version", "placementId"],
              "properties": {
                "component": {"type": "string", "minLength": 1},
                "version": {"type": "string", "minLength": 1},
                "placementId": {"type": "string", "minLength": 1}
              }
            },
            "method": {"type": "string", "minLength": 1},
            "directUpgradeSupported": {"type": "boolean"},
            "carryForward": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "abandoned": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "gates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "criterion", "evidence"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "criterion": {"type": "string", "minLength": 1},
                  "evidence": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      },
      "supportBoundaries": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceId",
            "product",
            "versionLine",
            "endOfGeneralSupport",
            "requiredAction"
          ],
          "properties": {
            "sourceId": {"type": "string", "minLength": 1},
            "product": {"type": "string", "minLength": 1},
            "versionLine": {"type": "string", "minLength": 1},
            "endOfGeneralSupport": {"type": "string", "minLength": 1},
            "requiredAction": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}

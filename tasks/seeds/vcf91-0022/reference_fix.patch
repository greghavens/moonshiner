+
+    def _ensure_authenticated(self) -> None:
+        if self._access_token is not None:
+            return
+        pair = self._request_json(
+            operation_id="createToken",
+            method="POST",
+            path="/v1/tokens",
+            expected_status=201,
+            body={
+                "username": self._username,
+                "password": self._password,
+            },
+            authenticated=False,
+        )
+        if not isinstance(pair, dict):
+            self._protocol_error(
+                "createToken",
+                "success response must be a JSON object",
+            )
+        access_token = pair.get("accessToken")
+        refresh_token = pair.get("refreshToken")
+        refresh_id = (
+            refresh_token.get("id")
+            if isinstance(refresh_token, dict)
+            else None
+        )
+        if (
+            not isinstance(access_token, str)
+            or not access_token
+            or not isinstance(refresh_id, str)
+            or not refresh_id
+        ):
+            self._protocol_error(
+                "createToken",
+                "success response is missing token values",
+            )
+        self._access_token = access_token
+        self._refresh_token_id = refresh_id
+
+    def _refresh_access_token(self) -> None:
+        if self._refresh_token_id is None:
+            self._protocol_error(
+                "refreshAccessToken",
+                "refresh token is unavailable",
+            )
+        new_access_token = self._request_json(
+            operation_id="refreshAccessToken",
+            method="PATCH",
+            path="/v1/tokens/access-token/refresh",
+            expected_status=200,
+            body=self._refresh_token_id,
+            authenticated=False,
+        )
+        if not isinstance(new_access_token, str) or not new_access_token:
+            self._protocol_error(
+                "refreshAccessToken",
+                "success response must be a non-empty JSON string",
+            )
+        self._access_token = new_access_token
+        self._refresh_used = True
+
+    def _request_json(
+        self,
+        *,
+        operation_id: str,
+        method: str,
+        path: str,
+        expected_status: int,
+        query: list[tuple[str, str]] | None = None,
+        body: Any = _NO_BODY,
+        authenticated: bool,
+        allow_refresh: bool = False,
+    ) -> Any:
+        target = self._base_url + path
+        if query:
+            target += "?" + urlencode(query)
+        headers = {"Accept": "application/json"}
+        encoded: bytes | None = None
+        if body is not _NO_BODY:
+            encoded = json.dumps(
+                body,
+                ensure_ascii=False,
+                separators=(",", ":"),
+            ).encode("utf-8")
+            headers["Content-Type"] = "application/json"
+        if authenticated:
+            if self._access_token is None:
+                self._protocol_error(
+                    operation_id,
+                    "authenticated request has no access token",
+                )
+            headers["Authorization"] = "Bearer " + self._access_token
+        request = Request(
+            target,
+            data=encoded,
+            headers=headers,
+            method=method,
+        )
+
+        try:
+            with self._opener.open(
+                request,
+                timeout=self._timeout,
+            ) as response:
+                status = response.getcode()
+                raw = response.read()
+        except HTTPError as exc:
+            raw = exc.read()
+            payload = self._decode_error_payload(raw)
+            if (
+                exc.code == 401
+                and operation_id == "getDomains"
+                and authenticated
+                and allow_refresh
+                and not self._refresh_used
+            ):
+                self._refresh_access_token()
+                return self._request_json(
+                    operation_id=operation_id,
+                    method=method,
+                    path=path,
+                    expected_status=expected_status,
+                    query=query,
+                    body=body,
+                    authenticated=authenticated,
+                    allow_refresh=False,
+                )
+            raise SddcManagerError(
+                f"{operation_id} failed with HTTP {exc.code}",
+                operation_id=operation_id,
+                status_code=exc.code,
+                payload=payload,
+            ) from None
+        except (URLError, OSError):
+            raise SddcManagerError(
+                f"{operation_id} transport failed",
+                operation_id=operation_id,
+            ) from None
+
+        if status != expected_status:
+            raise SddcManagerError(
+                f"{operation_id} returned unexpected HTTP {status}",
+                operation_id=operation_id,
+                status_code=status,
+                payload=self._decode_error_payload(raw),
+            )
+        try:
+            return json.loads(raw.decode("utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError):
+            self._protocol_error(
+                operation_id,
+                "success response is not valid JSON",
+            )
+
+    @staticmethod
+    def _decode_error_payload(raw: bytes) -> Any:
+        try:
+            return json.loads(raw.decode("utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError):
+            return None
+
+    @staticmethod
+    def _domain_sort_key(
+        domain: dict[str, Any],
+    ) -> tuple[str, str, str]:
+        name = domain.get("name")
+        identifier = domain.get("id")
+        canonical = json.dumps(
+            domain,
+            ensure_ascii=False,
+            sort_keys=True,
+            separators=(",", ":"),
+        )
+        return (
+            name.casefold() if isinstance(name, str) else "",
+            identifier if isinstance(identifier, str) else "",
+            canonical,
+        )
+
+    @staticmethod
+    def _protocol_error(operation_id: str, message: str) -> None:
+        raise ProtocolError(message, operation_id=operation_id)

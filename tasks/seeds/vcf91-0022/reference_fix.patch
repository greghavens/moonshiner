+        if (
+            isinstance(page_size, bool)
+            or not isinstance(page_size, int)
+            or not 1 <= page_size <= _INT32_MAX
+        ):
+            raise ValueError("page_size must be a positive int32 integer")
+
+        self._ensure_authenticated()
+        collected: list[dict[str, Any]] = []
+        requested_page = 0
+        expected_total_elements: int | None = None
+        expected_total_pages: int | None = None
+
+        while True:
+            page = self._request_json(
+                operation_id="getDomains",
+                method="GET",
+                path="/v1/domains",
+                expected_status=200,
+                query=[
+                    ("pageNumber", str(requested_page)),
+                    ("pageSize", str(page_size)),
+                ],
+                authenticated=True,
+                allow_refresh=True,
+            )
+            if not isinstance(page, dict):
+                self._protocol_error(
+                    "getDomains",
+                    "success response must be a JSON object",
+                )
+            elements = page.get("elements")
+            metadata = page.get("pageMetadata")
+            if not isinstance(elements, list) or not isinstance(metadata, dict):
+                self._protocol_error(
+                    "getDomains",
+                    "success response has invalid page members",
+                )
+            if any(not isinstance(element, dict) for element in elements):
+                self._protocol_error(
+                    "getDomains",
+                    "page elements must all be objects",
+                )
+
+            page_number = metadata.get("pageNumber")
+            returned_size = metadata.get("pageSize")
+            total_elements = metadata.get("totalElements")
+            total_pages = metadata.get("totalPages")
+            for name, value in [
+                ("pageNumber", page_number),
+                ("pageSize", returned_size),
+                ("totalElements", total_elements),
+                ("totalPages", total_pages),
+            ]:
+                if (
+                    isinstance(value, bool)
+                    or not isinstance(value, int)
+                    or not 0 <= value <= _INT32_MAX
+                ):
+                    self._protocol_error(
+                        "getDomains",
+                        f"{name} must be a non-negative int32 integer",
+                    )
+
+            if page_number != requested_page:
+                self._protocol_error(
+                    "getDomains",
+                    "returned page number does not match the request",
+                )
+            if returned_size != len(elements):
+                self._protocol_error(
+                    "getDomains",
+                    "pageSize does not match the returned elements",
+                )
+            if total_pages == 0:
+                if page_number != 0 or total_elements != 0 or elements:
+                    self._protocol_error(
+                        "getDomains",
+                        "zero totalPages is inconsistent with the page",
+                    )
+            elif page_number >= total_pages:
+                self._protocol_error(
+                    "getDomains",
+                    "returned page number is outside totalPages",
+                )
+
+            if expected_total_elements is None:
+                expected_total_elements = total_elements
+                expected_total_pages = total_pages
+            elif (
+                total_elements != expected_total_elements
+                or total_pages != expected_total_pages
+            ):
+                self._protocol_error(
+                    "getDomains",
+                    "pagination totals changed between pages",
+                )
+
+            if len(collected) + len(elements) > total_elements:
+                self._protocol_error(
+                    "getDomains",
+                    "page elements overshoot totalElements",
+                )
+            collected.extend(elements)
+
+            if total_pages == 0 or page_number + 1 == total_pages:
+                break
+            if not elements:
+                self._protocol_error(
+                    "getDomains",
+                    "empty page made no progress before completion",
+                )
+            requested_page = page_number + 1
+
+        if expected_total_elements is None:
+            self._protocol_error(

+function Remove-UnsetProperty {
+    <#
+    .SYNOPSIS
+        Drops every property that stands in for "the caller did not set this".
+    .DESCRIPTION
+        Schema-shaped objects can carry placeholders for unset optional properties. The contract
+        treats null, "", [] and {} as values in their own right, so they have to be removed
+        rather than forwarded.
+    #>
+    param($Value)
+
+    if ($Value -is [System.Collections.IDictionary]) {
+        $kept = [ordered]@{}
+        foreach ($key in @($Value.Keys)) {
+            $inner = $Value[$key]
+            if ($null -eq $inner) { continue }
+            $inner = Remove-UnsetProperty -Value $inner
+            if ($null -eq $inner) { continue }
+            if ($inner -is [string] -and $inner.Length -eq 0) { continue }
+            if (($inner -is [System.Collections.IDictionary] -or $inner -is [array]) -and $inner.Count -eq 0) { continue }
+            $kept[$key] = $inner
+        }
+        return $kept
+    }
+    if ($Value -is [array]) {
+        # The comma keeps a single-element array an array instead of letting the pipeline
+        # unroll it into a bare scalar.
+        $items = @(foreach ($item in $Value) { Remove-UnsetProperty -Value $item })
+        return , $items
+    }
+    return $Value
+}
+

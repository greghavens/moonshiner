+#!/usr/bin/env python3
+"""Reference proof using the genuine executable in two dependent stages."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+from pathlib import Path
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent.parent
+REQUESTED_NAME = "Supplier Policy Review"
+REQUESTED_LOCATION = "Beacon"
+REQUIRED_STATUS = "active"
+
+
+def run_stage(command: list[str]) -> dict[str, Any]:
+    completed = subprocess.run(
+        command,
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=20,
+        check=False,
+        start_new_session=True,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "reference stage failed")
+    payload = json.loads(completed.stdout)
+    if not isinstance(payload, dict):
+        raise RuntimeError("reference stage returned an invalid result")
+    return payload
+
+
+def main() -> int:
+    help_result = subprocess.run(
+        ["./meetingctl", "--help"],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=15,
+        check=False,
+    )
+    if help_result.returncode != 0 or "search" not in help_result.stdout:
+        raise RuntimeError("meeting executable help could not be inspected")
+
+    search = run_stage(
+        [
+            "./meetingctl",
+            "search",
+            "--name",
+            REQUESTED_NAME,
+            "--location",
+            REQUESTED_LOCATION,
+        ]
+    )
+    matches = search.get("matches")
+    if not isinstance(matches, list) or len(matches) != 1:
+        raise RuntimeError("reference search did not resolve uniquely")
+    match = matches[0]
+    if (
+        not isinstance(match, dict)
+        or match.get("name") != REQUESTED_NAME
+        or match.get("location") != REQUESTED_LOCATION
+        or match.get("status") != REQUIRED_STATUS
+    ):
+        raise RuntimeError("reference search returned a different meeting")
+    stable_id = match.get("id")
+    if not isinstance(stable_id, str) or not stable_id:
+        raise RuntimeError("reference search returned no stable ID")
+
+    detail = run_stage(["./meetingctl", "get", "--id", stable_id])
+    record = detail.get("record")
+    if not isinstance(record, dict):
+        raise RuntimeError("reference get returned no complete record")
+    if (
+        record.get("id") != stable_id
+        or record.get("name") != REQUESTED_NAME
+        or record.get("location") != REQUESTED_LOCATION
+        or record.get("status") != REQUIRED_STATUS
+        or not isinstance(record.get("date"), str)
+    ):
+        raise RuntimeError("reference get returned a different meeting")
+
+    report = (
+        f"- Stable ID: {record['id']}\n"
+        f"- Status: {record['status']}\n"
+        f"- Location/date: {record['location']} / {record['date']}\n"
+    )
+    (ROOT / "supplier-policy-review.md").write_text(report, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

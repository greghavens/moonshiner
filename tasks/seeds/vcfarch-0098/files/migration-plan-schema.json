{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/vcf-brownfield-migration-plan-1.0.json",
  "title": "VCF Brownfield Migration Plan",
  "type": "object",
  "required": [
    "schemaVersion",
    "estateId",
    "targetVcfVersion",
    "targetSddcSpec",
    "steps",
    "researchConsulted"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetVcfVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "targetSddcSpec": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "researchConsulted": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/researchRecord"
      }
    }
  },
  "$defs": {
    "researchRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "accessDate",
        "factUsed"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://\\S+$"
        },
        "accessDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "factUsed": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "componentId",
        "componentName",
        "fromProduct",
        "fromVersion",
        "toProduct",
        "toVersion",
        "action",
        "gates"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "componentName": {
          "type": "string",
          "minLength": 1
        },
        "fromProduct": {
          "type": "string",
          "minLength": 1
        },
        "fromVersion": {
          "type": "string",
          "minLength": 1
        },
        "toProduct": {
          "type": "string",
          "minLength": 1
        },
        "toVersion": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "UPGRADE",
            "TRANSITION",
            "INSTALL",
            "MIGRATE_AND_DECOMMISSION"
          ]
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

+++ b/src/vcfops_triage/contract.py
@@ -0,0 +1,76 @@
+"""Loading of, and validation against, the pinned REST contract.
+
+``docs/contract.json`` is the authority for paths, query parameters, required and
+optional body fields and the enum vocabularies. Nothing in this package hardcodes
+a path or an enum member that the contract does not carry.
+"""
+
+import json
+import os
+
+REPO_ROOT = os.path.dirname(
+    os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+)
+DEFAULT_CONTRACT_PATH = os.path.join(REPO_ROOT, "docs", "contract.json")
+
+CRITICALITY_ENUM_KEY = "alert-query.alertCriticality[]"
+
+
+class ContractViolation(Exception):
+    """A request we were asked to make that the pinned contract forbids."""
+
+
+def load_contract(path=None):
+    with open(path or DEFAULT_CONTRACT_PATH, "r", encoding="utf-8") as handle:
+        return json.load(handle)
+
+
+def operation(contract, operation_id):
+    try:
+        return contract["operations"][operation_id]
+    except KeyError:
+        raise ContractViolation(
+            "the pinned contract does not name an operation %r" % operation_id
+        ) from None
+
+
+def query_parameter_default(contract, operation_id, name):
+    for item in operation(contract, operation_id).get("queryParameters", []):
+        if item["name"] == name:
+            return item["default"]
+    raise ContractViolation(
+        "%s has no query parameter %r in the pinned contract" % (operation_id, name)
+    )
+
+
+def validate_criticality(contract, values):
+    """Check every requested criticality against the 9.0.0.0 enum."""
+    allowed = contract["enums"][CRITICALITY_ENUM_KEY]
+    unknown = [value for value in values if value not in allowed]
+    if unknown:
+        raise ContractViolation(
+            "unknown alert criticality %s; the pinned contract allows %s"
+            % (", ".join(repr(value) for value in unknown), ", ".join(allowed))
+        )
+    if not values:
+        raise ContractViolation("at least one alert criticality is required")
+    return list(values)
+
+
+def validate_page_size(contract, page_size):
+    """``None`` means 'leave pageSize off the URL and take the server default'."""
+    if page_size is None:
+        return None
+    minimum = contract["paging"]["minimumPageSize"]
+    if page_size < minimum:
+        raise ContractViolation(
+            "pageSize must be at least %d, got %d" % (minimum, page_size)
+        )
+    return page_size
+
+
+def effective_page_size(contract, page_size):
+    """The page size the server will actually apply, used by the stop rule."""
+    if page_size is not None:
+        return page_size
+    return query_parameter_default(contract, "queryAlert", "pageSize")

@@ -0,0 +1,164 @@
+"""HTTP transport for the four operations the pinned contract names.
+
+The one interesting thing here is :meth:`OperationsClient._call`. Every
+authenticated operation goes through it, and a ``401`` there is treated as "the
+token is finished", not "this request is bad": the client re-acquires and replays
+*that request alone*. Callers see a plain method call and never learn that a
+refresh happened, so no caller has to be written to cope with restarting.
+"""
+
+import json
+import urllib.error
+import urllib.parse
+import urllib.request
+
+from .contract import operation
+
+
+class TransportError(Exception):
+    """The request never produced an HTTP response."""
+
+
+class ApiError(Exception):
+    """The server answered, but not the way the contract says it should."""
+
+    def __init__(self, status, payload, message=None):
+        super().__init__(message or "unexpected HTTP %s: %s" % (status, payload))
+        self.status = status
+        self.payload = payload
+
+
+class AuthError(Exception):
+    """The credentials were rejected, or the refresh budget ran out."""
+
+
+def _decode(raw):
+    if not raw:
+        return None
+    try:
+        return json.loads(raw.decode("utf-8"))
+    except (UnicodeDecodeError, ValueError):
+        return raw.decode("utf-8", "replace")
+
+
+class OperationsClient:
+    """A session against one VCF Operations appliance."""
+
+    def __init__(self, base_url, contract, username, password, auth_source=None,
+                 max_refreshes=3, timeout=30):
+        self.base_url = base_url.rstrip("/")
+        self.contract = contract
+        self.username = username
+        self.password = password
+        self.auth_source = auth_source
+        self.max_refreshes = max_refreshes
+        self.timeout = timeout
+
+        self.token = None
+        self.refreshes = 0
+
+        security = contract["security"]
+        self.auth_header = security["headerName"]
+        self.auth_template = security["headerValueTemplate"]
+
+    # -- plumbing ---------------------------------------------------------
+
+    def _url(self, path, query=None):
+        url = self.base_url + path
+        if query:
+            url += "?" + urllib.parse.urlencode(query)
+        return url
+
+    def _send(self, method, url, body=None, authenticated=True):
+        headers = {"Accept": "application/json"}
+        data = None
+        if body is not None:
+            data = json.dumps(body).encode("utf-8")
+            headers["Content-Type"] = "application/json"
+        if authenticated:
+            headers[self.auth_header] = self.auth_template.format(token=self.token)
+        request = urllib.request.Request(url, data=data, headers=headers, method=method)
+        try:
+            with urllib.request.urlopen(request, timeout=self.timeout) as response:
+                return response.status, _decode(response.read())
+        except urllib.error.HTTPError as exc:
+            return exc.code, _decode(exc.read())
+        except urllib.error.URLError as exc:
+            raise TransportError("%s %s: %s" % (method, url, exc.reason)) from exc
+
+    def _call(self, operation_id, path=None, query=None, body=None, expect=200):
+        """Send an authenticated operation, refreshing and replaying on a 401."""
+        spec = operation(self.contract, operation_id)
+        url = self._url(path or spec["path"], query)
+        while True:
+            status, payload = self._send(spec["method"], url, body)
+            if status == expect:
+                return payload
+            if status != 401:
+                raise ApiError(status, payload)
+            # The token is finished. Spend a refresh and re-send this one request;
+            # everything the server already accepted stays accepted.
+            if self.refreshes >= self.max_refreshes:
+                raise AuthError(
+                    "token still rejected after %d refresh(es); giving up on %s"
+                    % (self.refreshes, operation_id)
+                )
+            self.refreshes += 1
+            self.token = None
+            self._acquire()
+
+    # -- operations -------------------------------------------------------
+
+    def _acquire(self):
+        spec = operation(self.contract, "acquireToken")
+        body = {"username": self.username, "password": self.password}
+        # authSource is optional: when we were not given one, it must not appear in
+        # the body at all -- not as null, not as "".
+        if self.auth_source:
+            body["authSource"] = self.auth_source
+        status, payload = self._send(
+            spec["method"], self._url(spec["path"]), body, authenticated=False
+        )
+        if status == 401:
+            raise AuthError("authentication failed for user %r" % self.username)
+        if status != 200:
+            raise ApiError(status, payload)
+        if not isinstance(payload, dict) or not payload.get("token"):
+            raise ApiError(status, payload, "acquireToken returned no token")
+        self.token = payload["token"]
+        return payload
+
+    def login(self):
+        return self._acquire()
+
+    def query_alerts(self, page, page_size, criticality, alert_name=None):
+        query = {"page": page}
+        # pageSize is optional and documented with a default: omit it entirely
+        # rather than sending the default back, and never send it empty.
+        if page_size is not None:
+            query["pageSize"] = page_size
+        body = {"activeOnly": True, "alertCriticality": list(criticality)}
+        if alert_name:
+            body["alertName"] = alert_name
+        payload = self._call("queryAlert", query=query, body=body)
+        if not isinstance(payload, dict):
+            raise ApiError(200, payload, "queryAlert returned a non-object body")
+        return payload
+
+    def add_alert_note(self, alert_id, content):
+        spec = operation(self.contract, "addAlertNote")
+        path = spec["path"].replace("{id}", urllib.parse.quote(alert_id, safe=""))
+        payload = self._call("addAlertNote", path=path, body={"content": content},
+                             expect=201)
+        if not isinstance(payload, dict) or "id" not in payload:
+            raise ApiError(201, payload, "addAlertNote returned no alert-note id")
+        return payload
+
+    def logout(self):
+        # releaseToken is authenticated, so the contract's 401 rule applies here
+        # just as it does to queryAlert and addAlertNote.
+        if self.token is None:
+            return
+        payload = self._call("releaseToken")
+        self.token = None
+        return payload

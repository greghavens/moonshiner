+++ b/src/vcfops_triage/triage.py
@@ -0,0 +1,53 @@
+"""The triage run itself: walk the alert pages, note each alert once.
+
+The loop is written as if the session never lapsed. That is the point --
+:class:`~vcfops_triage.client.OperationsClient` absorbs the refresh, so the state
+that matters here (which page we are on, which alerts on it are still un-noted)
+is never unwound. An alert is appended to ``annotated`` only after the server has
+answered ``201``, so a replayed request cannot double-count and a lost one cannot
+be silently skipped.
+"""
+
+from .contract import effective_page_size
+
+
+def run_triage(client, contract, criticality, note, page_size=None, alert_name=None):
+    paging = contract["paging"]
+    result_field = paging["resultField"]
+    page_info_field = paging["pageInfoField"]
+    window = effective_page_size(contract, page_size)
+
+    annotated = []
+    seen = set()
+    page = paging["firstPage"]
+    pages_fetched = 0
+    total_count = None
+
+    while True:
+        payload = client.query_alerts(page, page_size, criticality, alert_name)
+        pages_fetched += 1
+        alerts = payload.get(result_field) or []
+        info = payload.get(page_info_field) or {}
+        if total_count is None:
+            total_count = info.get("totalCount")
+
+        for alert in alerts:
+            alert_id = alert.get("alertId")
+            if not alert_id or alert_id in seen:
+                continue
+            created = client.add_alert_note(alert_id, note)
+            seen.add(alert_id)
+            annotated.append({"alertId": alert_id, "noteId": created["id"]})
+
+        # A page shorter than the page size in effect is the last one; asking for
+        # the page after it would be a request we already know is empty.
+        if len(alerts) < window:
+            break
+        page += 1
+
+    return {
+        "alertsMatched": total_count if total_count is not None else len(annotated),
+        "pagesFetched": pages_fetched,
+        "tokenRefreshes": client.refreshes,
+        "annotated": annotated,
+    }

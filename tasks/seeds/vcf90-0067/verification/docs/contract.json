        {
          "name": "pageSize",
          "required": false,
          "type": "integer",
          "format": "int32",
          "default": 1000
        }
      ],
      "requestBody": {
        "schema": "alert-query",
        "required": [],
        "required_note": "alert-query declares no required properties; every criterion is optional and an omitted criterion means 'do not filter on this'.",
        "optional": [
          "compositeOperator",
          "alertId",
          "alertName",
          "resource-query",
          "activeOnly",
          "alertTypeSubtype",
          "alertCriticality",
          "alertStatus",

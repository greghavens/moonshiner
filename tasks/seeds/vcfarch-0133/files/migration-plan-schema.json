{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:northstar:vcf-migration-plan:v1",
  "title": "Northstar VCF existing-estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "estateId",
    "targetVcfVersion",
    "targetSddcSpec",
    "componentMigrations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetVcfVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "targetSddcSpec": {
      "type": "object"
    },
    "componentMigrations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/componentMigration"
      }
    }
  },
  "$defs": {
    "componentMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "componentId",
        "componentName",
        "currentVersion",
        "targetProduct",
        "targetVersion",
        "disposition",
        "versionPath",
        "gatedBy"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "componentName": {
          "type": "string",
          "minLength": 1
        },
        "currentVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetProduct": {
          "type": "string",
          "minLength": 1
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "upgrade-and-import",
            "upgrade-with-esx",
            "converge-and-upgrade"
          ]
        },
        "versionPath": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gatedBy": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

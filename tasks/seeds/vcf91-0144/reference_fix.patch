+def _required_string(value: object, name: str) -> str:
+    if not isinstance(value, str) or not value.strip():
+        raise ValueError(f"{name} must be a nonblank string")
+    return value
+
+
+def _header_value(value: object, name: str) -> str:
+    result = _required_string(value, name)
+    if "\r" in result or "\n" in result:
+        raise ValueError(f"{name} contains a header-unsafe character")
+    return result
+
+
+def _origin(value: object, name: str) -> _Origin:
+    text = _required_string(value, name)
+    if any(character.isspace() for character in text):
+        raise ValueError(f"{name} contains whitespace")
+    try:
+        parsed = urlsplit(text)
+    except ValueError:
+        raise ValueError(f"{name} must be an HTTP(S) origin") from None
+    if parsed.scheme not in {"http", "https"}:
+        raise ValueError(f"{name} must use http or https")
+    if (
+        not parsed.hostname
+        or parsed.username is not None
+        or parsed.password is not None
+        or parsed.path not in {"", "/"}
+        or "?" in text
+        or "#" in text
+        or parsed.netloc.endswith(":")
+    ):
+        raise ValueError(f"{name} must be an HTTP(S) origin")
+    try:
+        port = parsed.port
+    except ValueError:
+        raise ValueError(f"{name} contains an invalid port") from None
+    if port is not None and port == 0:
+        raise ValueError(f"{name} contains an invalid port")
+    return _Origin(parsed.scheme, parsed.hostname, port)
+
+
+def _authority(value: object, scheme: str) -> _Origin:
+    text = _required_string(value, "master_host")
+    if (
+        any(character.isspace() for character in text)
+        or any(character in text for character in "/?#\\")
+        or "@" in text
+    ):
+        raise ProtocolError(LIST_NAMESPACES)
+    try:
+        parsed = urlsplit("//" + text)
+    except ValueError:
+        raise ProtocolError(LIST_NAMESPACES) from None
+    if (
+        not parsed.hostname
+        or parsed.username is not None
+        or parsed.password is not None
+        or parsed.path
+        or parsed.query
+        or parsed.fragment
+        or text.endswith(":")
+    ):
+        raise ProtocolError(LIST_NAMESPACES)
+    try:
+        port = parsed.port
+    except ValueError:
+        raise ProtocolError(LIST_NAMESPACES) from None
+    if port is not None and port == 0:
+        raise ProtocolError(LIST_NAMESPACES)
+
+    host = parsed.hostname
+    try:
+        if ":" in host:
+            if not text.startswith("["):
+                raise ValueError
+            ipaddress.IPv6Address(host)
+        elif re.fullmatch(r"[0-9.]+", host):
+            ipaddress.IPv4Address(host)
+        else:
+            ascii_host = host.rstrip(".").encode("idna").decode("ascii")
+            if not ascii_host or len(ascii_host) > 253:
+                raise ValueError
+            for label in ascii_host.split("."):
+                if (
+                    not label
+                    or len(label) > 63
+                    or re.fullmatch(
+                        r"[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?",
+                        label,
+                    )
+                    is None
+                ):
+                    raise ValueError
+    except (UnicodeError, ValueError):
+        raise ProtocolError(LIST_NAMESPACES) from None
+    return _Origin(scheme, host, port)
+
+
+def _timeout(value: object) -> float:
+    if (
+        isinstance(value, bool)
+        or not isinstance(value, Real)
+        or not math.isfinite(float(value))
+        or float(value) <= 0
+    ):
+        raise ValueError("timeout must be a finite positive real number")
+    return float(value)
+
+
+def _segment(value: str) -> str:
+    return quote(value, safe="", encoding="utf-8", errors="strict")
+
+
+def _json_value(body: bytes, operation: str) -> Any:
+    try:
+        return json.loads(body.decode("utf-8"))
+    except (UnicodeDecodeError, json.JSONDecodeError):
+        raise ProtocolError(operation) from None
+
 

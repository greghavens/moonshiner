+    def _request(
+        self,
+        origin: _Origin,
+        operation: str,
+        method: str,
+        target: str,
+        authentication: tuple[str, str],
+        *,
+        zero_content_length: bool = False,
+    ) -> tuple[int, bytes]:
+        connection_type: type[
+            http.client.HTTPConnection
+        ] = (
+            http.client.HTTPSConnection
+            if origin.scheme == "https"
+            else http.client.HTTPConnection
+        )
+        connection = connection_type(
+            origin.host,
+            origin.port,
+            timeout=self._timeout,
+        )
+        try:
+            connection.putrequest(
+                method,
+                target,
+                skip_accept_encoding=True,
+            )
+            connection.putheader("Accept", "application/json")
+            connection.putheader(
+                authentication[0],
+                authentication[1],
+            )
+            if zero_content_length:
+                connection.putheader("Content-Length", "0")
+            connection.endheaders()
+            response = connection.getresponse()
+            response_body = response.read()
+            return response.status, response_body
+        except (
+            OSError,
+            TimeoutError,
+            http.client.HTTPException,
+        ):
+            raise ApiError(operation, None) from None
+        finally:
+            connection.close()
+
+    def _acquire_session(self) -> _SessionState:
+        with self._condition:
+            session = self._current
+            session.active += 1
+            return session
+
+    def _release_session(self, session: _SessionState) -> None:
+        with self._condition:
+            session.active -= 1
+            self._condition.notify_all()
+
+    def _list_namespace(
+        self,
+        session: _SessionState,
+        namespace: str,
+    ) -> _Origin:
+        status, body = self._request(
+            self._vcenter,
+            LIST_NAMESPACES,
+            "GET",
+            "/api/vcenter/namespaces-user/namespaces",
+            ("vmware-api-session-id", session.token),
+        )
+        if status != 200:
+            raise ApiError(LIST_NAMESPACES, status)
+        value = _json_value(body, LIST_NAMESPACES)
+        if not isinstance(value, list):
+            raise ProtocolError(LIST_NAMESPACES)
+
+        seen: set[str] = set()
+        selected: str | None = None
+        for item in value:
+            if not isinstance(item, dict):
+                raise ProtocolError(LIST_NAMESPACES)
+            actual_namespace = item.get("namespace")
+            master_host = item.get("master_host")
+            if (
+                not isinstance(actual_namespace, str)
+                or not actual_namespace.strip()
+                or not isinstance(master_host, str)
+                or not master_host.strip()
+                or actual_namespace in seen
+            ):
+                raise ProtocolError(LIST_NAMESPACES)
+            seen.add(actual_namespace)
+            if actual_namespace == namespace:
+                selected = master_host
+        if selected is None:
+            raise ProtocolError(LIST_NAMESPACES)
+        return _authority(selected, self._kubernetes_scheme)
+
+    def _get_cluster(
+        self,

+            f"{_segment(namespace)}/clusters/{_segment(cluster_name)}"
+        )
+        status, body = self._request(
+            origin,
+            GET_CLUSTER,
+            "GET",
+            target,
+            (
+                "Authorization",
+                f"Bearer {self._kubernetes_token}",
+            ),
+        )
+        if status != 200:
+            raise ApiError(GET_CLUSTER, status)
+        value = _json_value(body, GET_CLUSTER)
+        if not isinstance(value, dict):
+            raise ProtocolError(GET_CLUSTER)
+        metadata = value.get("metadata")
+        spec = value.get("spec")
+        topology = spec.get("topology") if isinstance(spec, dict) else None
+        version = (
+            topology.get("version")
+            if isinstance(topology, dict)
+            else None
+        )
+        if (
+            value.get("apiVersion") != "cluster.x-k8s.io/v1beta2"
+            or value.get("kind") != "Cluster"
+            or not isinstance(metadata, dict)
+            or metadata.get("namespace") != namespace
+            or metadata.get("name") != cluster_name
+            or not isinstance(version, str)
+            or not version.strip()
+        ):
+            raise ProtocolError(GET_CLUSTER)
+        return version
 

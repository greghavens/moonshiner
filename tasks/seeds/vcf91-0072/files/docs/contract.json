{
  "contract_version": 1,
  "contract_kind": "focused OpenAPI 2.0 projection with explicit verifier policy",
  "product": "VMware Cloud Foundation 9.1 - NSX Policy API",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "repository_commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/nsx/openapi-2.0/nsx_policy_api.yaml",
    "spec_blob_sha": "102d15fd342f6a45bb6d84a5b39a916c65929f4c",
    "license": "Apache-2.0"
  },
  "swagger": "2.0",
  "info": {
    "title": "NSX Policy API",
    "version": "9.1.0.0"
  },
  "basePath": "/policy/api/v1",
  "schemes": [
    "https"
  ],
  "security": [
    {
      "BasicAuth": []
    }
  ],
  "securityDefinitions": {
    "BasicAuth": {
      "type": "basic",
      "description": "HTTP Basic Authentication"
    }
  },
  "operations": [
    {
      "operationId": "CreateOrPatchIpAddressBlock",
      "method": "PATCH",
      "path": "/infra/ip-blocks/{ip-block-id}",
      "summary": "Create a new IPBlock",
      "description": "Creates a new IpAddressBlock with specified ID if not already present. If IpAddressBlock of given ID is already present, then the instance is updated with specified attributes.",
      "consumes": [
        "application/json"
      ],
      "parameters": [
        {
          "name": "ip-block-id",
          "in": "path",
          "required": true,
          "type": "string"
        },
        {
          "name": "IpAddressBlock",
          "in": "body",
          "required": true,
          "schema_ref": "#/definitions/IpAddressBlock"
        }
      ],
      "responses": {
        "200": {
          "description": "OK"
        },
        "400": {
          "$ref": "#/responses/BadRequest"
        },
        "403": {
          "$ref": "#/responses/Forbidden"
        },
        "404": {
          "$ref": "#/responses/NotFound"
        },
        "412": {
          "$ref": "#/responses/PreconditionFailed"
        },
        "500": {
          "$ref": "#/responses/InternalServerError"
        },
        "503": {
          "$ref": "#/responses/ServiceUnavailable"
        },
        "504": {
          "$ref": "#/responses/GatewayTimeout"
        }
      },
      "x-vmw-nsx-module": "PolicyIpam"
    }
  ],
  "definitions": {
    "IpAddressBlock": {
      "allOf": [
        {
          "$ref": "#/definitions/PolicyConfigResource"
        }
      ],
      "properties": {
        "cidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "ip-cidr-block"
          },
          "description": "Represents list of CIDRs."
        },
        "subnet_exclusive": {
          "type": "boolean",
          "description": "If this property is set to true, then this block is reserved for direct vlan extension use case. This flag cannot be modified from true to false."
        }
      }
    },
    "PolicyConfigResource": {
      "allOf": [
        {
          "$ref": "#/definitions/PolicyResource"
        }
      ]
    },
    "PolicyResource": {
      "allOf": [
        {
          "$ref": "#/definitions/ManagedResource"
        }
      ]
    },
    "ManagedResource": {
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 1024
        },
        "display_name": {
          "type": "string",
          "maxLength": 255,
          "x-vmw-nsx-computed": true
        },
        "id": {
          "type": "string"
        },
        "resource_type": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "maxItems": 30,
          "items_ref": "#/definitions/Tag"
        }
      }
    },
    "ApiError": {
      "properties": {
        "error_code": {
          "type": "integer",
          "format": "int64"
        },
        "error_message": {
          "type": "string"
        },
        "module_name": {
          "type": "string"
        },
        "details": {
          "type": "string"
        }
      }
    }
  },
  "serialization_rule": {
    "unset_optional_body_members": "omit",
    "explicit_false_for_set_boolean": "preserve",
    "explicit_empty_or_default_for_unset_optionals": false
  },
  "verification_profile": {
    "operation_sequence": [
      "CreateOrPatchIpAddressBlock",
      "CreateOrPatchIpAddressBlock"
    ],
    "scenario": [
      "the first resource-addressed PATCH is applied and its connection is closed before a response",
      "the byte-identical PATCH is replayed against the same resource ID",
      "the mock records one distinct resource effect"
    ],
    "request_headers": {
      "Authorization": "Basic <credentials>",
      "Accept": "application/json",
      "Content-Type": "application/json"
    },
    "request_query": "omit",
    "unset_optional_body_members": [
      "description",
      "subnet_exclusive",
      "id",
      "resource_type",
      "tags"
    ],
    "transient_statuses": [
      503,
      504
    ],
    "success_status": 200,
    "maximum_attempts": 2
  }
}

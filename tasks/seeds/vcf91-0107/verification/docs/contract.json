{
  "contract_version": 1,
  "title": "VCF 9.1 focused asynchronous vCenter VM clone batch contract",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_path": "specifications/vsphere/openapi/automation/vcenter.yaml",
    "spec_blob_sha": "8028b0824c4ff3503d05f44814f967938a795c40",
    "license": "Apache-2.0",
    "openapi": "3.0.3",
    "api_version": "9.1.0.0"
  },
  "server_base_path": "/api",
  "security": {
    "scheme": "api_key_auth",
    "type": "apiKey",
    "header": "vmware-api-session-id",
    "in": "header"
  },
  "operations": [
    {
      "operationId": "Vcenter.VM_clone$Task",
      "method": "POST",
      "spec_path_item": "/vcenter/vm?action=clone&vmw-task=true",
      "path": "/vcenter/vm",
      "fixed_query": [
        {
          "name": "action",
          "value": "clone"
        },
        {
          "name": "vmw-task",
          "value": "true"
        }
      ],
      "request_body": {
        "required": true,
        "content_type": "application/json",
        "schema": "Vcenter.VM.CloneSpec"
      },
      "success": {
        "status": 202,
        "content_type": "application/json",
        "schema": {
          "type": "string",
          "resource_type": "com.vmware.cis.task"
        },
        "task_identifier": true
      }
    },
    {
      "operationId": "Cis.Tasks_list",
      "method": "POST",
      "spec_path_item": "/cis/tasks?action=list",
      "path": "/cis/tasks",
      "fixed_query": [
        {
          "name": "action",
          "value": "list"
        }
      ],
      "request_body": {
        "required": false,
        "content_type": "application/json",
        "wrapper_properties": {
          "filter_spec": {
            "required": false,
            "schema": "Cis.Tasks.FilterSpec"
          },
          "result_spec": {
            "required": false,
            "schema": "Cis.Tasks.GetSpec"
          }
        }
      },
      "success": {
        "status": 200,
        "content_type": "application/json",
        "schema": {
          "type": "object",
          "additional_properties": "Cis.Task.Info",
          "key_resource_type": "com.vmware.cis.task"
        }
      }
    }
  ],
  "schemas": {
    "Vcenter.VM.CloneSpec": {
      "type": "object",
      "required": [
        "name",
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "resource_type": "VirtualMachine"
        },
        "name": {
          "type": "string"
        },
        "placement": {
          "required": false,
          "schema": "Vcenter.VM.ClonePlacementSpec"
        },
        "disks_to_remove": {
          "required": false,
          "type": "array",
          "unique_items": true,
          "items_resource_type": "com.vmware.vcenter.vm.hardware.Disk"
        },
        "disks_to_update": {
          "required": false,
          "type": "object",
          "additional_properties": "Vcenter.VM.DiskCloneSpec"
        },
        "power_on": {
          "required": false,
          "type": "boolean"
        },
        "guest_customization_spec": {
          "required": false,
          "schema": "Vcenter.VM.GuestCustomizationSpec"
        }
      }
    },
    "Cis.Tasks.FilterSpec": {
      "type": "object",
      "at_least_one_required": [
        "tasks",
        "services"
      ],
      "properties": {
        "tasks": {
          "required": false,
          "type": "array",
          "unique_items": true,
          "items_type": "string",
          "items_resource_type": "com.vmware.cis.task"
        },
        "services": {
          "required": false,
          "type": "array",
          "unique_items": true,
          "items_type": "string",
          "items_resource_type": "com.vmware.vapi.service"
        },
        "operations": {
          "required": false,
          "type": "array",
          "unique_items": true,
          "items_type": "string",
          "items_resource_type": "com.vmware.vapi.operation"
        },
        "status": {
          "required": false,
          "type": "array",
          "unique_items": true,
          "items_schema": "Cis.Task.Status"
        },
        "targets": {
          "required": false,
          "type": "array",
          "items_schema": "Vapi.Std.DynamicID"
        },
        "users": {
          "required": false,
          "type": "array",
          "unique_items": true,
          "items_type": "string"
        }
      }
    },
    "Cis.Tasks.GetSpec": {
      "type": "object",
      "properties": {
        "return_all": {
          "required": false,
          "type": "boolean"
        },
        "exclude_result": {
          "required": false,
          "type": "boolean"
        }
      }
    },
    "Vapi.Std.LocalizableMessage": {
      "type": "object",
      "required": [
        "args",
        "default_message",
        "id"
      ],
      "selected_properties": {
        "id": {
          "type": "string"
        },
        "default_message": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items_type": "string"
        }
      }
    },
    "Cis.Task.Info": {
      "type": "object",
      "required": [
        "cancelable",
        "description",
        "operation",
        "service",
        "status"
      ],
      "selected_properties": {
        "description": {
          "schema": "Vapi.Std.LocalizableMessage"
        },
        "service": {
          "type": "string",
          "resource_type": "com.vmware.vapi.service"
        },
        "operation": {
          "type": "string",
          "resource_type": "com.vmware.vapi.operation"
        },
        "status": {
          "schema": "Cis.Task.Status"
        },
        "cancelable": {
          "type": "boolean"
        },
        "result": {
          "required": false
        },
        "error": {
          "required": false,
          "type": "object"
        }
      }
    },
    "Cis.Task.Status": {
      "type": "string",
      "enum": [
        "PENDING",
        "RUNNING",
        "BLOCKED",
        "SUCCEEDED",
        "FAILED"
      ],
      "terminal": [
        "SUCCEEDED",
        "FAILED"
      ]
    }
  }
}

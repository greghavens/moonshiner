diff --git a/src/VcfInstaller.Async.psm1 b/src/VcfInstaller.Async.psm1
--- a/src/VcfInstaller.Async.psm1
+++ b/src/VcfInstaller.Async.psm1
@@ -16,7 +16,47 @@ function Start-VcfInstallerBundleDownload {
         [int] $PollIntervalMilliseconds = 0
     )
 
-    throw 'Not implemented.'
+    $downloadSpec = Initialize-VcfInstallerBundleDownloadSpec -DownloadNow $true
+    $updateSpec = Initialize-VcfInstallerBundleUpdateSpec -BundleDownloadSpec $downloadSpec
+
+    # Build the wire document from the SDK model using only values that were
+    # explicitly set. ConvertTo-Json on a generated model can otherwise expose
+    # unset optional properties as null or false values.
+    $requestDocument = [ordered]@{
+        bundleDownloadSpec = [ordered]@{
+            downloadNow = [bool] $updateSpec.BundleDownloadSpec.DownloadNow
+        }
+    }
+    $requestJson = $requestDocument | ConvertTo-Json -Depth 4 -Compress
+
+    $baseUri = $ServerUri.AbsoluteUri.TrimEnd('/')
+    $encodedBundleId = [uri]::EscapeDataString($BundleId)
+    $headers = @{
+        Accept = 'application/json'
+        Authorization = "Bearer $AccessToken"
+    }
+
+    $task = Invoke-RestMethod `
+        -Uri "$baseUri/v1/bundles/$encodedBundleId" `
+        -Method Patch `
+        -Headers $headers `
+        -ContentType 'application/json' `
+        -Body $requestJson
+
+    $nonTerminalStatuses = @('PENDING', 'IN_PROGRESS')
+    while ($nonTerminalStatuses -contains ([string] $task.status).ToUpperInvariant()) {
+        if ($PollIntervalMilliseconds -gt 0) {
+            Start-Sleep -Milliseconds $PollIntervalMilliseconds
+        }
+
+        $encodedTaskId = [uri]::EscapeDataString([string] $task.id)
+        $task = Invoke-RestMethod `
+            -Uri "$baseUri/v1/tasks/$encodedTaskId" `
+            -Method Get `
+            -Headers $headers
+    }
+
+    return $task
 }
 
 Export-ModuleMember -Function Start-VcfInstallerBundleDownload

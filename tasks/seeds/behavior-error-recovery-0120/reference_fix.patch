index 0000000..3a6034c
--- /dev/null
+++ b/.reference_solution.py
@@ -0,0 +1,119 @@
+#!/usr/bin/env python3
+"""Reference proof through the genuine fleet executable."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "fleetctl"
+DELIVERABLE = ROOT / "availability-report.md"
+TARGETS = (
+    {
+        "name": "Shuttle 30 120",
+        "depot": "Depot D",
+        "date": "2026-11-21",
+    },
+    {
+        "name": "Van 12 120",
+        "depot": "Depot A",
+        "date": "2026-11-21",
+    },
+)
+
+
+def command(target: dict[str, str]) -> list[str]:
+    return [
+        str(CLIENT),
+        "availability",
+        "--name",
+        target["name"],
+        "--depot",
+        target["depot"],
+        "--date",
+        target["date"],
+    ]
+
+
+def decode(returncode: int, stdout: str, stderr: str) -> dict[str, Any]:
+    payload = stdout if returncode == 0 else stderr
+    try:
+        response: Any = json.loads(payload)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("fleet executable returned invalid JSON") from error
+    if not isinstance(response, dict):
+        raise RuntimeError("fleet executable returned a non-object response")
+    return response
+
+
+def run_one(target: dict[str, str]) -> tuple[int, dict[str, Any]]:
+    completed = subprocess.run(
+        command(target),
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=5,
+    )
+    return completed.returncode, decode(
+        completed.returncode, completed.stdout, completed.stderr
+    )
+
+
+def start_sibling(target: dict[str, str]) -> subprocess.Popen[str]:
+    shell_driver = '"$@"; status=$?; exit "$status"'
+    return subprocess.Popen(
+        [
+            "bash",
+            "-c",
+            shell_driver,
+            "fleet-availability",
+            *command(target),
+        ],
+        cwd=ROOT,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=True,
+    )
+
+
+def main() -> int:
+    processes = [start_sibling(target) for target in TARGETS]
+    initial: list[tuple[int, dict[str, Any]]] = []
+    for process in processes:
+        stdout, stderr = process.communicate(timeout=5)
+        initial.append(
+            (process.returncode, decode(process.returncode, stdout, stderr))
+        )
+
+    if initial[0][0] != 0:
+        raise RuntimeError("the reference retained branch did not succeed")
+    transient_error = initial[1][1]
+    if (
+        initial[1][0] != 75
+        or transient_error.get("retryable") is not True
+        or transient_error.get("transient") is not True
+    ):
+        raise RuntimeError("the reference retry branch was not transient")
+
+    retry_returncode, retry_result = run_one(TARGETS[1])
+    if retry_returncode != 0:
+        raise RuntimeError("the reference selective retry did not succeed")
+    results = (initial[0][1], retry_result)
+
+    lines = []
+    for result in results:
+        availability_value = (
+            "available" if result["available"] else "unavailable"
+        )
+        lines.append(f"- {result['name']}: {availability_value}")
+    DELIVERABLE.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

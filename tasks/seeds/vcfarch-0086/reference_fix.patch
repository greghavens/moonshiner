+package migrationplan
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"sort"
+	"strings"
+)
+
+type VcenterSpec struct {
+	VcenterHostname       string `json:"vcenterHostname"`
+	RootVcenterPassword   string `json:"rootVcenterPassword"`
+	Version               string `json:"version"`
+	UseExistingDeployment bool   `json:"useExistingDeployment"`
+	SSLThumbprint         string `json:"sslThumbprint"`
+}
+
+type NetworkSpec struct {
+	NetworkType string `json:"networkType"`
+	VLANID      int    `json:"vlanId"`
+}
+
+type DNSSpec struct {
+	Subdomain   string   `json:"subdomain"`
+	Nameservers []string `json:"nameservers"`
+}
+
+type Plan struct {
+	SddcID           string        `json:"sddcId"`
+	WorkflowType     string        `json:"workflowType"`
+	Version          string        `json:"version"`
+	VcenterSpec      VcenterSpec   `json:"vcenterSpec"`
+	NetworkSpecs     []NetworkSpec `json:"networkSpecs"`
+	DNSSpec          DNSSpec       `json:"dnsSpec"`
+	NTPServers       []string      `json:"ntpServers,omitempty"`
+	PlanID           string        `json:"planId"`
+	EstateID         string        `json:"estateId"`
+	TargetVCFVersion string        `json:"targetVcfVersion"`
+	Components       []Component   `json:"components"`
+	Gates            []Gate        `json:"gates"`
+	Steps            []Step        `json:"steps"`
+}
+
+type Component struct {
+	ID             string   `json:"id"`
+	Domain         string   `json:"domain"`
+	Product        string   `json:"product"`
+	CurrentVersion string   `json:"currentVersion"`
+	TargetVersion  string   `json:"targetVersion"`
+	Disposition    string   `json:"disposition"`
+	GatedBy        []string `json:"gatedBy"`
+}
+
+type Gate struct {
+	ID          string `json:"id"`
+	Description string `json:"description"`
+}
+
+type Step struct {
+	Order       int          `json:"order"`
+	ID          string       `json:"id"`
+	Action      string       `json:"action"`
+	Transitions []Transition `json:"transitions"`
+	Requires    []string     `json:"requires"`
+	Produces    []string     `json:"produces"`
+}
+
+type Transition struct {
+	ComponentID string `json:"componentId"`
+	FromVersion string `json:"fromVersion"`
+	ToVersion   string `json:"toVersion"`
+}
+
+type Estate struct {
+	EstateID         string `json:"estateId"`
+	TargetVCFVersion string `json:"targetVcfVersion"`
+	ManagementDomain struct {
+		DomainID  string `json:"domainId"`
+		Health    string `json:"health"`
+		Immutable bool   `json:"immutable"`
+	} `json:"managementDomain"`
+	WorkloadCandidate struct {
+		DomainID               string `json:"domainId"`
+		VcenterHostname        string `json:"vcenterHostname"`
+		EnhancedLinkedMode     bool   `json:"enhancedLinkedMode"`
+		StretchedVsan          bool   `json:"stretchedVsan"`
+		ExistingNsx            bool   `json:"existingNsx"`
+		HostCount              int    `json:"hostCount"`
+		HardwareSupportsTarget bool   `json:"hardwareSupportsTarget"`
+		Network                struct {
+			DNSSubdomain   string   `json:"dnsSubdomain"`
+			Nameservers    []string `json:"nameservers"`
+			NTPServers     []string `json:"ntpServers"`
+			ManagementVLAN int      `json:"managementVlan"`
+			VmotionVLAN    int      `json:"vmotionVlan"`
+			VsanVLAN       int      `json:"vsanVlan"`
+		} `json:"network"`
+	} `json:"workloadCandidate"`
+	Components []EstateComponent `json:"components"`
+}
+
+type EstateComponent struct {
+	ID      string `json:"id"`
+	Domain  string `json:"domain"`
+	Product string `json:"product"`
+	Version string `json:"version"`
+}
+
+type Snapshot struct {
+	SnapshotID             string                `json:"snapshotId"`
+	TargetVCFVersion       string                `json:"targetVcfVersion"`
+	SddcSchemaVersion      string                `json:"sddcSchemaVersion"`
+	ComponentTargets       map[string]string     `json:"componentTargets"`
+	BaseGates              []string              `json:"baseGates"`
+	PreservedComponentGate string                `json:"preservedComponentGate"`
+	SupportedTransitions   []SupportedTransition `json:"supportedTransitions"`
+}
+
+type SupportedTransition struct {
+	ComponentID string   `json:"componentId"`
+	FromVersion string   `json:"fromVersion"`
+	ToVersion   string   `json:"toVersion"`
+	Action      string   `json:"action"`
+	Requires    []string `json:"requires"`
+	Produces    []string `json:"produces"`
+}
+
+func DecodePlan(r io.Reader) (Plan, error) {
+	var value Plan
+	if err := strictDecode(r, &value); err != nil {
+		return Plan{}, fmt.Errorf("decode plan: %w", err)
+	}
+	return value, nil
+}
+
+func DecodeEstate(r io.Reader) (Estate, error) {
+	var value Estate
+	if err := strictDecode(r, &value); err != nil {
+		return Estate{}, fmt.Errorf("decode estate: %w", err)
+	}
+	return value, nil
+}
+
+func DecodeSnapshot(r io.Reader) (Snapshot, error) {
+	var value Snapshot
+	if err := strictDecode(r, &value); err != nil {
+		return Snapshot{}, fmt.Errorf("decode snapshot: %w", err)
+	}
+	return value, nil
+}
+
+func strictDecode(r io.Reader, out any) error {
+	dec := json.NewDecoder(r)
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(out); err != nil {
+		return err
+	}
+	var trailing any
+	if err := dec.Decode(&trailing); err != io.EOF {
+		if err == nil {
+			return fmt.Errorf("trailing JSON value")
+		}
+		return fmt.Errorf("trailing JSON value: %w", err)
+	}
+	return nil
+}
+
+func Validate(plan Plan, estate Estate, snapshot Snapshot) error {
+	if err := validateIdentity(plan, estate, snapshot); err != nil {
+		return err
+	}
+
+	gateDefinitions, err := validateGateDefinitions(plan, snapshot)
+	if err != nil {
+		return err
+	}
+
+	estateByID := make(map[string]EstateComponent, len(estate.Components))
+	for _, component := range estate.Components {
+		if _, exists := estateByID[component.ID]; exists {
+			return fmt.Errorf("estate has duplicate component %q", component.ID)
+		}
+		estateByID[component.ID] = component
+	}
+	planByID := make(map[string]Component, len(plan.Components))
+	for _, component := range plan.Components {
+		if _, exists := planByID[component.ID]; exists {
+			return fmt.Errorf("component coverage has duplicate %q", component.ID)
+		}
+		planByID[component.ID] = component
+	}
+	if len(planByID) != len(estateByID) {
+		return fmt.Errorf("component coverage: plan names %d components, estate has %d", len(planByID), len(estateByID))
+	}
+
+	supportByComponent := make(map[string]SupportedTransition, len(snapshot.SupportedTransitions))
+	for _, supported := range snapshot.SupportedTransitions {
+		if _, exists := supportByComponent[supported.ComponentID]; exists {
+			return fmt.Errorf("snapshot has duplicate supported transition for %q", supported.ComponentID)
+		}
+		supportByComponent[supported.ComponentID] = supported
+	}
+
+	for _, id := range sortedMapKeys(estateByID) {
+		inventory := estateByID[id]
+		component, found := planByID[id]
+		if !found {
+			return fmt.Errorf("component coverage: %q is missing from plan", id)
+		}
+		if component.Domain != inventory.Domain || component.Product != inventory.Product || component.CurrentVersion != inventory.Version {
+			return fmt.Errorf("component %q does not reproduce estate identity and current version", id)
+		}
+		if inventory.Domain == "management" {
+			if component.TargetVersion != inventory.Version || component.Disposition != "preserve" {
+				return fmt.Errorf("management component %q must remain unchanged at %s", id, inventory.Version)
+			}
+		}
+		target, found := snapshot.ComponentTargets[id]
+		if !found || component.TargetVersion != target {
+			return fmt.Errorf("component %q target %q does not equal pinned target %q", id, component.TargetVersion, target)
+		}
+		if len(component.GatedBy) == 0 {
+			return fmt.Errorf("component %q has no technical gates", id)
+		}
+		if err := uniqueKnownStrings(component.GatedBy, gateDefinitions, "component "+id+" gate"); err != nil {
+			return err
+		}
+
+		if inventory.Domain == "management" {
+			if !contains(component.GatedBy, snapshot.PreservedComponentGate) {
+				return fmt.Errorf("management component %q is missing required gate %q", id, snapshot.PreservedComponentGate)
+			}
+			if !sameSet(component.GatedBy, stringSet(snapshot.PreservedComponentGate)) {
+				return fmt.Errorf("management component %q gates do not match the pinned technical contract", id)
+			}
+			continue
+		}
+
+		supported, found := supportByComponent[id]
+		if !found || supported.FromVersion != component.CurrentVersion || supported.ToVersion != component.TargetVersion {
+			return fmt.Errorf("component %q has no supported pinned transition from %s to %s", id, component.CurrentVersion, component.TargetVersion)
+		}
+		wantDisposition := dispositionFor(supported)
+		if component.Disposition != wantDisposition {
+			return fmt.Errorf("component %q disposition %q, want %q", id, component.Disposition, wantDisposition)
+		}
+		for _, required := range supported.Requires {
+			if !contains(component.GatedBy, required) {
+				return fmt.Errorf("component %q is missing required gate %q", id, required)
+			}
+		}
+		if !sameSet(component.GatedBy, stringSet(supported.Requires...)) {
+			return fmt.Errorf("component %q gates do not match its pinned transition", id)
+		}
+	}
+
+	if err := validateSteps(plan, estateByID, supportByComponent, snapshot, gateDefinitions); err != nil {
+		return err
+	}
+	return nil
+}
+
+func validateIdentity(plan Plan, estate Estate, snapshot Snapshot) error {
+	if plan.EstateID != estate.EstateID {
+		return fmt.Errorf("estateId %q does not match fixture %q", plan.EstateID, estate.EstateID)
+	}
+	if plan.TargetVCFVersion != estate.TargetVCFVersion || plan.TargetVCFVersion != snapshot.TargetVCFVersion {
+		return fmt.Errorf("targetVcfVersion %q does not match pinned target", plan.TargetVCFVersion)
+	}
+	if plan.SddcID != estate.WorkloadCandidate.DomainID {
+		return fmt.Errorf("sddcId %q does not identify workload domain %q", plan.SddcID, estate.WorkloadCandidate.DomainID)
+	}
+	if plan.WorkflowType != "VCF" || plan.Version != snapshot.TargetVCFVersion {
+		return fmt.Errorf("installer target identity does not match VCF %s", snapshot.TargetVCFVersion)
+	}
+	if plan.VcenterSpec.VcenterHostname != estate.WorkloadCandidate.VcenterHostname || !plan.VcenterSpec.UseExistingDeployment {
+		return fmt.Errorf("installer vcenterSpec must identify the existing workload vCenter")
+	}
+	if plan.VcenterSpec.Version != snapshot.ComponentTargets["workload-vcenter"] {
+		return fmt.Errorf("installer vcenterSpec version is not the pinned workload vCenter target")
+	}
+	if plan.DNSSpec.Subdomain != estate.WorkloadCandidate.Network.DNSSubdomain || !sameStrings(plan.DNSSpec.Nameservers, estate.WorkloadCandidate.Network.Nameservers) {
+		return fmt.Errorf("installer dnsSpec does not match workload network fixture")
+	}
+	if !sameStrings(plan.NTPServers, estate.WorkloadCandidate.Network.NTPServers) {
+		return fmt.Errorf("installer ntpServers do not match workload network fixture")
+	}
+	wantNetworks := map[string]int{
+		"MANAGEMENT": estate.WorkloadCandidate.Network.ManagementVLAN,
+		"VMOTION":    estate.WorkloadCandidate.Network.VmotionVLAN,
+		"VSAN":       estate.WorkloadCandidate.Network.VsanVLAN,
+	}
+	gotNetworks := make(map[string]int, len(plan.NetworkSpecs))
+	for _, network := range plan.NetworkSpecs {
+		if _, duplicate := gotNetworks[network.NetworkType]; duplicate {
+			return fmt.Errorf("installer networkSpecs repeats %q", network.NetworkType)
+		}
+		gotNetworks[network.NetworkType] = network.VLANID
+	}
+	if !reflectStringIntMaps(gotNetworks, wantNetworks) {
+		return fmt.Errorf("installer networkSpecs do not match workload VLAN fixture")
+	}
+	return nil
+}
+
+func validateGateDefinitions(plan Plan, snapshot Snapshot) (map[string]struct{}, error) {
+	expected := make(map[string]struct{})
+	for _, id := range snapshot.BaseGates {
+		expected[id] = struct{}{}
+	}
+	for _, transition := range snapshot.SupportedTransitions {
+		for _, id := range transition.Requires {
+			expected[id] = struct{}{}
+		}
+		for _, id := range transition.Produces {
+			expected[id] = struct{}{}
+		}
+	}
+	definitions := make(map[string]struct{}, len(plan.Gates))
+	for _, gate := range plan.Gates {
+		if _, exists := definitions[gate.ID]; exists {
+			return nil, fmt.Errorf("duplicate gate %q", gate.ID)
+		}
+		if strings.TrimSpace(gate.ID) == "" || strings.TrimSpace(gate.Description) == "" {
+			return nil, fmt.Errorf("gate id and description must be non-empty")
+		}
+		definitions[gate.ID] = struct{}{}
+	}
+	for id := range expected {
+		if _, found := definitions[id]; !found {
+			return nil, fmt.Errorf("required technical gate %q is not declared", id)
+		}
+	}
+	for id := range definitions {
+		if _, found := expected[id]; !found {
+			return nil, fmt.Errorf("gate %q is not part of the pinned technical contract", id)
+		}
+	}
+	return definitions, nil
+}
+
+func validateSteps(plan Plan, estate map[string]EstateComponent, support map[string]SupportedTransition, snapshot Snapshot, gates map[string]struct{}) error {
+	available := make(map[string]struct{}, len(snapshot.BaseGates))
+	for _, gate := range snapshot.BaseGates {
+		available[gate] = struct{}{}
+	}
+	seenStepID := make(map[string]struct{})
+	transitionCount := make(map[string]int)
+	previousOrder := 0
+	var deferredOutputError error
+
+	for index, step := range plan.Steps {
+		if step.Order < 1 {
+			return fmt.Errorf("step order must be positive, got %d for %q", step.Order, step.ID)
+		}
+		if index > 0 && step.Order <= previousOrder {
+			return fmt.Errorf("step order must be strictly increasing: %d follows %d", step.Order, previousOrder)
+		}
+		previousOrder = step.Order
+		if _, duplicate := seenStepID[step.ID]; duplicate {
+			return fmt.Errorf("duplicate step id %q", step.ID)
+		}
+		seenStepID[step.ID] = struct{}{}
+		if err := uniqueKnownStrings(step.Requires, gates, "step "+step.ID+" required gate"); err != nil {
+			return err
+		}
+		for _, required := range step.Requires {
+			if _, ready := available[required]; !ready {
+				return fmt.Errorf("step %q requires gate %q, which is not available yet", step.ID, required)
+			}
+		}
+
+		expectedRequires := make(map[string]struct{})
+		expectedOutput := make(map[string]struct{})
+		for _, transition := range step.Transitions {
+			inventory, known := estate[transition.ComponentID]
+			if !known {
+				return fmt.Errorf("step %q names unknown component %q", step.ID, transition.ComponentID)
+			}
+			if inventory.Domain == "management" {
+				return fmt.Errorf("step %q attempts to transition management component %q", step.ID, transition.ComponentID)
+			}
+			supported, ok := support[transition.ComponentID]
+			if !ok || supported.FromVersion != transition.FromVersion || supported.ToVersion != transition.ToVersion || supported.Action != step.Action {
+				return fmt.Errorf("step %q uses an unsupported transition for %q", step.ID, transition.ComponentID)
+			}
+			for _, required := range supported.Requires {
+				expectedRequires[required] = struct{}{}
+				if !contains(step.Requires, required) {
+					return fmt.Errorf("step %q is missing required gate %q", step.ID, required)
+				}
+			}
+			for _, produced := range supported.Produces {
+				expectedOutput[produced] = struct{}{}
+			}
+			transitionCount[transition.ComponentID]++
+			if transitionCount[transition.ComponentID] > 1 {
+				return fmt.Errorf("transition for %q is planned more than once", transition.ComponentID)
+			}
+		}
+		if !sameSet(step.Requires, expectedRequires) {
+			return fmt.Errorf("step %q required gates do not match its pinned transitions", step.ID)
+		}
+		if err := uniqueKnownStrings(step.Produces, gates, "step "+step.ID+" produced gate"); err != nil {
+			return err
+		}
+		if !sameSet(step.Produces, expectedOutput) && deferredOutputError == nil {
+			deferredOutputError = fmt.Errorf("step %q produced gates do not match its pinned transitions", step.ID)
+		}
+		for produced := range expectedOutput {
+			available[produced] = struct{}{}
+		}
+	}
+
+	for componentID := range support {
+		if transitionCount[componentID] == 0 {
+			return fmt.Errorf("supported transition for %q is not planned", componentID)
+		}
+	}
+	if deferredOutputError != nil {
+		return deferredOutputError
+	}
+	return nil
+}
+
+func dispositionFor(transition SupportedTransition) string {
+	switch {
+	case transition.Action == "import-workload-domain" && transition.FromVersion == "not-installed":
+		return "deploy"
+	case transition.Action == "import-workload-domain":
+		return "import"
+	default:
+		return "upgrade"
+	}
+}
+
+func uniqueKnownStrings(values []string, known map[string]struct{}, label string) error {
+	seen := make(map[string]struct{}, len(values))
+	for _, value := range values {
+		if _, duplicate := seen[value]; duplicate {
+			return fmt.Errorf("%s %q is duplicated", label, value)
+		}
+		seen[value] = struct{}{}
+		if _, exists := known[value]; !exists {
+			return fmt.Errorf("%s %q is not declared", label, value)
+		}
+	}
+	return nil
+}
+
+func contains(values []string, wanted string) bool {
+	for _, value := range values {
+		if value == wanted {
+			return true
+		}
+	}
+	return false
+}
+
+func sameStrings(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func sameSet(values []string, wanted map[string]struct{}) bool {
+	if len(values) != len(wanted) {
+		return false
+	}
+	seen := make(map[string]struct{}, len(values))
+	for _, value := range values {
+		seen[value] = struct{}{}
+	}
+	if len(seen) != len(wanted) {
+		return false
+	}
+	for value := range wanted {
+		if _, found := seen[value]; !found {
+			return false
+		}
+	}
+	return true
+}
+
+func stringSet(values ...string) map[string]struct{} {
+	set := make(map[string]struct{}, len(values))
+	for _, value := range values {
+		set[value] = struct{}{}
+	}
+	return set
+}
+
+func reflectStringIntMaps(a, b map[string]int) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for key, value := range a {
+		if b[key] != value {
+			return false
+		}
+	}
+	return true
+}
+
+func sortedMapKeys[V any](values map[string]V) []string {
+	keys := make([]string, 0, len(values))
+	for key := range values {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	return keys
+}

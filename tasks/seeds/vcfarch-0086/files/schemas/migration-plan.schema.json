{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcfarch-0086:migration-plan",
  "title": "Brownfield VCF workload-domain migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sddcId",
    "workflowType",
    "version",
    "vcenterSpec",
    "networkSpecs",
    "dnsSpec",
    "planId",
    "estateId",
    "targetVcfVersion",
    "components",
    "gates",
    "steps"
  ],
  "properties": {
    "sddcId": {"type": "string", "minLength": 3},
    "workflowType": {"type": "string", "enum": ["VCF"]},
    "version": {"type": "string", "minLength": 1},
    "vcenterSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vcenterHostname",
        "rootVcenterPassword",
        "version",
        "useExistingDeployment",
        "sslThumbprint"
      ],
      "properties": {
        "vcenterHostname": {"type": "string", "minLength": 1},
        "rootVcenterPassword": {"type": "string", "minLength": 8, "maxLength": 20},
        "version": {"type": "string", "minLength": 1},
        "useExistingDeployment": {"type": "boolean", "const": true},
        "sslThumbprint": {"type": "string", "minLength": 1}
      }
    },
    "networkSpecs": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["networkType", "vlanId"],
        "properties": {
          "networkType": {"type": "string", "enum": ["MANAGEMENT", "VMOTION", "VSAN"]},
          "vlanId": {"type": "integer", "minimum": 0, "maximum": 4094}
        }
      }
    },
    "dnsSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subdomain", "nameservers"],
      "properties": {
        "subdomain": {"type": "string", "minLength": 1},
        "nameservers": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "ntpServers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "planId": {"type": "string", "minLength": 1},
    "estateId": {"type": "string", "minLength": 1},
    "targetVcfVersion": {"type": "string", "minLength": 1},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gate"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "product",
        "currentVersion",
        "targetVersion",
        "disposition",
        "gatedBy"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "enum": ["management", "workload"]},
        "product": {"type": "string", "minLength": 1},
        "currentVersion": {"type": "string", "minLength": 1},
        "targetVersion": {"type": "string", "minLength": 1},
        "disposition": {"type": "string", "enum": ["preserve", "upgrade", "deploy", "import"]},
        "gatedBy": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentId", "fromVersion", "toVersion"],
      "properties": {
        "componentId": {"type": "string", "minLength": 1},
        "fromVersion": {"type": "string", "minLength": 1},
        "toVersion": {"type": "string", "minLength": 1}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "id", "action", "transitions", "requires", "produces"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "id": {"type": "string", "minLength": 1},
        "action": {
          "type": "string",
          "enum": ["upgrade-vcenter", "upgrade-esxi", "import-workload-domain"]
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/transition"}
        },
        "requires": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "produces": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vcf-architecture:migration-plan:1",
  "title": "VCF brownfield migration plan",
  "type": "object",
  "required": [
    "schema_version",
    "estate_id",
    "target_release",
    "topology",
    "components",
    "gates",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "estate_id": {
      "type": "string",
      "minLength": 1
    },
    "target_release": {
      "type": "string",
      "minLength": 1
    },
    "topology": {
      "type": "object",
      "required": [
        "kind",
        "site_count",
        "management_host_count",
        "stretched"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "single-site-consolidated"
        },
        "site_count": {
          "const": 1
        },
        "management_host_count": {
          "type": "integer",
          "minimum": 1
        },
        "stretched": {
          "const": false
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "component_id",
          "component_name",
          "current_version",
          "target_product",
          "target_version",
          "gate_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "component_name": {
            "type": "string",
            "minLength": 1
          },
          "current_version": {
            "type": "string",
            "minLength": 1
          },
          "target_product": {
            "type": "string",
            "minLength": 1
          },
          "target_version": {
            "type": "string",
            "minLength": 1
          },
          "gate_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "gate_id",
          "condition"
        ],
        "additionalProperties": false,
        "properties": {
          "gate_id": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "step_id",
          "rule_id",
          "kind",
          "component_ids",
          "from_versions",
          "target_versions",
          "gate_ids",
          "depends_on",
          "action"
        ],
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "step_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "rule_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "configure",
              "deploy",
              "converge",
              "upgrade",
              "validate"
            ]
          },
          "component_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "from_versions": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "target_versions": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "gate_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "action": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

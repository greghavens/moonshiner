  "gates": [
    {
      "id": "gate-minimum-hosts",
      "fact": "A standard single-availability-zone vSAN management cluster has exactly four hosts at the supported minimum."
    },
    {
      "id": "gate-vds",
      "fact": "VCF 9.x management networking must be on a vSphere Distributed Switch before installer prechecks and convergence."
    },
    {
      "id": "gate-vcf-installer-converge",
      "fact": "With NSX 4.x present, standalone components use the VCF Installer converge and convert/import route; independent component upgrade is not the supported route."
    },
    {
      "id": "gate-core-order",
      "fact": "The gated core order is NSX, then vCenter, then ESX/vSAN."
    },
    {
      "id": "gate-rolling-vsan-capacity",
      "fact": "Before each rolling ESX/vSAN host remediation, health and FTT=1 capacity must remain satisfied with one host in maintenance."
    },
    {
      "id": "gate-recovery-source",
      "fact": "Separate Live Site Recovery and vSphere Replication appliances must both be 9.0.2.2, with a supported ESXi 8.0 U3 baseline, before convergence."
    },
    {
      "id": "gate-recovery-two-stage",
      "fact": "The supported preserved-configuration route is convergence to the unified VMware Live Recovery 9.0.4 appliance before upgrade to VCF Protection and Recovery 9.1."
    },
    {
      "id": "gate-recovery-health",
      "fact": "Paired-site reachability, backups, replication health, and recovery-plan validation gate each recovery-platform transition."
    }
  ],

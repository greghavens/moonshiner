+"""Build the consolidated greenfield and brownfield VCF architecture."""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+RESEARCH = [
+    {
+        "title": "Minimum number of ESXi hosts required on vSAN clusters for deployment of VCF Management Domain",
+        "publisher": "Broadcom Knowledge Base",
+        "url": "https://knowledge.broadcom.com/external/article/392993/minimum-number-of-esxi-hosts-required-on.html",
+        "accessed_at": "2026-08-14",
+        "conclusion": "A standard single-availability-zone VCF vSAN management domain has a four-host supported minimum.",
+    },
+    {
+        "title": "Upgrade Sequence and Related Issues for VMware Cloud Foundation and vSphere Foundation 9.1",
+        "publisher": "Broadcom Knowledge Base",
+        "url": "https://knowledge.broadcom.com/external/article/440630/upgrade-sequence-and-related-issues-for.html",
+        "accessed_at": "2026-08-14",
+        "conclusion": "A standalone vSphere 8 plus NSX 4 estate uses VCF Installer converge/convert/import workflows rather than independently upgrading the point solutions.",
+    },
+    {
+        "title": "Upgrading to VCF 9.0 requires Distributed Switch as a minimum requirement/component",
+        "publisher": "Broadcom Knowledge Base",
+        "url": "https://knowledge.broadcom.com/external/article/430625/upgrading-to-vcf-90-requires-distributed.html",
+        "accessed_at": "2026-08-14",
+        "conclusion": "Management, vMotion, and vSAN VMkernel networking must be migrated from VSS to vDS before VCF 9 installer prechecks.",
+    },
+    {
+        "title": "Steps to Converge to VMware Live Recovery Appliance 9.0.4(or newer) and Common Issues During Convergence",
+        "publisher": "Broadcom Knowledge Base",
+        "url": "https://knowledge.broadcom.com/external/article/408127/steps-to-converge-to-vmware-live-recover.html",
+        "accessed_at": "2026-08-14",
+        "conclusion": "Separate Live Site Recovery and vSphere Replication 9.0.2.2 appliances use a new 9.0.4 appliance and convergence workflow, not an in-place ISO upgrade.",
+    },
+    {
+        "title": "Replications point to legacy IP after Protection and Recovery 9.1 migration",
+        "publisher": "Broadcom Knowledge Base",
+        "url": "https://knowledge.broadcom.com/external/article/446199/replications-point-to-legacy-ip-after-pr.html",
+        "accessed_at": "2026-08-14",
+        "conclusion": "Preserved legacy recovery configurations require a two-stage 9.0.2.2 to 9.0.4 convergence followed by upgrade to Protection and Recovery 9.1.",
+    },
+]
+
+
+STEP_ACTIONS = {
+    "prepare-vds": (
+        "Create one 9000-MTU vSphere Distributed Switch and migrate management, "
+        "VM management, vMotion, and vSAN networking one redundant uplink at a time; "
+        "pass connectivity and vSAN health checks before removing VSS use."
+    ),
+    "deploy-vcf-operations": (
+        "Deploy VCF Operations 9.1 and its license service on the management domain, "
+        "register the entitlement, and confirm all four hosts remain healthy."
+    ),
+    "stage-recovery-convergence": (
+        "Back up both recovery appliances, verify paired-site reachability and all "
+        "replications, deploy unified VMware Live Recovery 9.0.4, and run the "
+        "configuration-preserving converge workflow for both legacy appliances."
+    ),
+    "installer-converge-import": (
+        "Run VCF Installer assessment and its NSX-present converge/convert/import "
+        "workflow so the existing vCenter, four-host vSAN cluster, and NSX instance "
+        "enter one VCF fleet under lifecycle management."
+    ),
+    "upgrade-nsx": (
+        "Use the converged VCF lifecycle workflow to upgrade NSX first and validate "
+        "manager quorum, transport nodes, overlays, and north-south connectivity."
+    ),
+    "upgrade-vcenter": (
+        "After NSX validation, upgrade vCenter through the converged VCF lifecycle "
+        "workflow and pass inventory, distributed-switch, and cluster health checks."
+    ),
+    "upgrade-esx-vsan": (
+        "After vCenter validation, remediate ESX and its integrated vSAN software one "
+        "host at a time, gating every maintenance cycle on FTT=1 capacity and resync health."
+    ),
+    "upgrade-protection-recovery": (
+        "After the core fleet reaches 9.1, upgrade unified Live Recovery 9.0.4 to VCF "
+        "Protection and Recovery 9.1, then verify pairing, replications, and recovery plans."
+    ),
+    "validate-fleet": (
+        "Confirm all inventory components report their pinned target versions in one "
+        "VCF fleet and pass VCF, vSphere, vSAN, NSX, and recovery health validation."
+    ),
+}
+
+
+def _required(mapping: dict[str, Any], key: str) -> Any:
+    if key not in mapping:
+        raise ValueError(f"missing required input field: {key}")
+    return mapping[key]
+
+
+def _sddc_spec(inventory: dict[str, Any], compatibility: dict[str, Any]) -> dict[str, Any]:
+    site = _required(inventory, "site")
+    hosts = _required(inventory, "hosts")
+    networking = _required(inventory, "networking")
+    topology = _required(compatibility, "topology")
+    targets = _required(compatibility, "component_targets")
+    platform = _required(compatibility, "platform_targets")
+    if len(hosts) != topology["minimum_management_vsan_hosts"]:
+        raise ValueError("inventory is not at the pinned minimum management host count")
+
+    vlan = networking["vlans"]
+    network_data = [
+        ("MANAGEMENT", "10.10.110.0/24", "10.10.110.1"),
+        ("VM_MANAGEMENT", "10.10.120.0/24", "10.10.120.1"),
+        ("VMOTION", "10.10.130.0/24", "10.10.130.1"),
+        ("VSAN", "10.10.140.0/24", "10.10.140.1"),
+    ]
+    networks = [
+        {
+            "networkType": network_type,
+            "subnet": subnet,
+            "gateway": gateway,
+            "subnetMask": "255.255.255.0",
+            "vlanId": vlan[network_type],
+            "mtu": topology["mtu"],
+            "ipAddressVersion": "IPv4",
+            "ipAddressAssignmentMode": "STATIC",
+        }
+        for network_type, subnet, gateway in network_data
+    ]
+
+    return {
+        "sddcId": "chi01-m01",
+        "workflowType": "VCF",
+        "version": compatibility["target_release"],
+        "vcfInstanceName": site["id"],
+        "hostSpecs": [{"hostname": host["short_hostname"]} for host in hosts],
+        "vcenterSpec": {
+            "vcenterHostname": "chi-vcenter.example.com",
+            "rootVcenterPassword": "<Vcenter-Root-9!>",
+            "vmSize": "small",
+            "storageSize": "lstorage",
+            "ssoDomain": "vsphere.local",
+            "version": targets["vcenter-chi01"]["target_version"],
+            "useExistingDeployment": False,
+        },
+        "clusterSpec": {
+            "datacenterName": "chi01-dc01",
+            "clusterName": "chi01-mgmt01",
+        },
+        "dvsSpecs": [
+            {
+                "dvsName": "chi01-mgmt-vds01",
+                "networks": list(topology["required_network_types"]),
+                "mtu": topology["mtu"],
+                "vmnicsToUplinks": [
+                    {"id": "vmnic0", "uplink": "uplink1"},
+                    {"id": "vmnic1", "uplink": "uplink2"},
+                ],
+            }
+        ],
+        "nsxtSpec": {
+            "nsxtManagers": [
+                {"hostname": "chi-nsx01.example.com"},
+                {"hostname": "chi-nsx02.example.com"},
+                {"hostname": "chi-nsx03.example.com"},
+            ],
+            "nsxtManagerSize": "medium",
+            "vipFqdn": "chi-nsx.example.com",
+            "transportVlanId": vlan["NSX_TEP"],
+            "version": targets["nsx-chi01"]["target_version"],
+            "useExistingDeployment": False,
+        },
+        "networkSpecs": networks,
+        "dnsSpec": {
+            "subdomain": "example.com",
+            "nameservers": ["192.0.2.53", "192.0.2.54"],
+        },
+        "ntpServers": ["192.0.2.123", "192.0.2.124"],
+        "sddcManagerSpec": {
+            "hostname": "chi-sddc-manager.example.com",
+            "version": platform["sddc_manager"],
+            "useExistingDeployment": False,
+        },
+        "managementPoolName": "chi01-management-network-pool",
+        "ceipEnabled": False,
+        "skipEsxThumbprintValidation": False,
+        "skipGatewayPingValidation": False,
+        "datastoreSpec": {
+            "vsanSpec": {
+                "datastoreName": "chi01-mgmt-vsan01",
+                "vsanDedup": inventory["storage"]["deduplication_and_compression"],
+                "esaConfig": {"enabled": False},
+                "failuresToTolerate": topology["vsan_failures_to_tolerate"],
+            }
+        },
+        "vcfOperationsSpec": {
+            "nodes": [
+                {"hostname": "chi-vcf-operations.example.com", "type": "master"}
+            ],
+            "applianceSize": "xsmall",
+            "useExistingDeployment": False,
+            "version": platform["vcf_operations"],
+        },
+        "licenseServerSpec": {
+            "hostname": "chi-vcf-license.example.com",
+            "version": platform["license_server"],
+            "useExistingDeployment": False,
+        },
+    }
+
+
+def _migration_plan(inventory: dict[str, Any], compatibility: dict[str, Any]) -> dict[str, Any]:
+    targets = compatibility["component_targets"]
+    components = []
+    for source in inventory["components"]:
+        target = targets[source["id"]]
+        components.append(
+            {
+                "component_id": source["id"],
+                "component_name": source["name"],
+                "current_version": source["version"],
+                "target_product": target["target_product"],
+                "target_version": target["target_version"],
+                "gate_ids": list(target["required_gate_ids"]),
+            }
+        )
+
+    gates = [
+        {"gate_id": gate["id"], "condition": gate["fact"]}
+        for gate in compatibility["gates"]
+    ]
+    steps = []
+    for sequence, transition in enumerate(compatibility["required_transitions"], 1):
+        rule_id = transition["rule_id"]
+        changes = transition["changes"]
+        steps.append(
+            {
+                "sequence": sequence,
+                "step_id": rule_id,
+                "rule_id": rule_id,
+                "kind": transition["kind"],
+                "component_ids": list(transition["affected_component_ids"]),
+                "from_versions": {
+                    change["component_id"]: change["from_version"] for change in changes
+                },
+                "target_versions": {
+                    change["component_id"]: change["target_version"] for change in changes
+                },
+                "gate_ids": list(transition["required_gate_ids"]),
+                "depends_on": list(transition["after_rules"]),
+                "action": STEP_ACTIONS[rule_id],
+            }
+        )
+
+    return {
+        "schema_version": 1,
+        "estate_id": inventory["estate_id"],
+        "target_release": compatibility["target_release"],
+        "topology": {
+            "kind": compatibility["topology"]["kind"],
+            "site_count": inventory["site"]["site_count_in_scope"],
+            "management_host_count": compatibility["topology"][
+                "minimum_management_vsan_hosts"
+            ],
+            "stretched": inventory["site"]["stretched_cluster"],
+        },
+        "components": components,
+        "gates": gates,
+        "steps": steps,
+    }
+
+
+def build_architecture(
+    inventory: dict[str, Any], compatibility: dict[str, Any]
+) -> dict[str, Any]:
+    """Return the deterministic architecture for the supplied protected inputs."""
+    if inventory.get("target_release") != compatibility.get("target_release"):
+        raise ValueError("inventory and compatibility target releases differ")
+    return {
+        "schema_version": 1,
+        "sddc_spec": _sddc_spec(inventory, compatibility),
+        "migration_plan": _migration_plan(inventory, compatibility),
+        "research": [dict(source) for source in RESEARCH],
+    }

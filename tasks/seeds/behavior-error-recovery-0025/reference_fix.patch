+#!/usr/bin/env python3
+"""Reference proof through the genuine support case executable."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+from pathlib import Path
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "case-registry"
+REPORT = ROOT / "cancellation-report.txt"
+TARGET_ID = "sup-125"
+REASON = "duplicate record entered during intake"
+
+
+def run_client(arguments: list[str]) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        [str(CLIENT), *arguments],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=5,
+    )
+
+
+def retrieve() -> dict[str, Any]:
+    result = run_client(["get", "--id", TARGET_ID])
+    if result.returncode != 0:
+        raise RuntimeError(result.stderr.strip() or "reference retrieval failed")
+    try:
+        payload: Any = json.loads(result.stdout)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("reference retrieval returned invalid JSON") from error
+    record = payload.get("record") if isinstance(payload, dict) else None
+    if not isinstance(record, dict):
+        raise RuntimeError("reference retrieval returned no complete case")
+    if record.get("id") != TARGET_ID:
+        raise RuntimeError("reference retrieval returned the wrong case")
+    if not isinstance(record.get("status"), str):
+        raise RuntimeError("reference retrieval returned no status")
+    return record
+
+
+def main() -> int:
+    cancellation_arguments = [
+        "cancel",
+        "--id",
+        TARGET_ID,
+        "--reason",
+        REASON,
+    ]
+    cancellation = run_client(cancellation_arguments)
+    if cancellation.returncode != 124:
+        raise RuntimeError(
+            "reference cancellation did not exercise the client deadline"
+        )
+    if "outcome is unknown" not in cancellation.stderr:
+        raise RuntimeError("reference cancellation did not expose uncertainty")
+
+    record = retrieve()
+    retry_was_sent = record["status"] == "active"
+    if retry_was_sent:
+        retry = run_client(cancellation_arguments)
+        if retry.returncode != 0:
+            raise RuntimeError(retry.stderr.strip() or "reference retry failed")
+        record = retrieve()
+    elif record["status"] != "cancelled":
+        raise RuntimeError(
+            f"reference retrieval returned terminal status {record['status']}"
+        )
+
+    if record["status"] != "cancelled":
+        raise RuntimeError("reference workflow did not establish cancellation")
+    REPORT.write_text(
+        f"{TARGET_ID} verified status: {record['status']}.\n"
+        f"Conditional retry sent: {'yes' if retry_was_sent else 'no'}.\n",
+        encoding="utf-8",
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

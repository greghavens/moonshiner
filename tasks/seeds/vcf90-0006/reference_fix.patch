index 0000000..5aea71c
--- /dev/null
+++ b/src/VcfHostCommission/VcfHostCommission.psm1
@@ -0,0 +1,199 @@
+#Requires -Modules VMware.Sdk.Vcf.SddcManager
+
+Set-StrictMode -Version Latest
+
+$script:ContractPath = Join-Path (Split-Path -Parent (Split-Path -Parent $PSScriptRoot)) 'docs/contract.json'
+
+function Get-VcfHostCommissionContract {
+    <#
+    .SYNOPSIS
+        Loads docs/contract.json, the spec-derived description of the four
+        SDDC Manager operations this module is allowed to call.
+    #>
+    [CmdletBinding()]
+    param([string]$Path = $script:ContractPath)
+
+    if (-not (Test-Path -LiteralPath $Path)) { throw "Contract not found at '$Path'." }
+    $contract = Get-Content -LiteralPath $Path -Raw | ConvertFrom-Json
+
+    $byId = @{}
+    foreach ($op in $contract.operations) { $byId[$op.operationId] = $op }
+    foreach ($required in @('createToken', 'validateHostCommissionSpec', 'getHostCommissionValidationByID', 'commissionHosts')) {
+        if (-not $byId.ContainsKey($required)) { throw "Contract does not name operation '$required'." }
+    }
+
+    Add-Member -InputObject $contract -MemberType NoteProperty -Name OperationsById -Value $byId -Force
+    return $contract
+}
+
+function New-VcfApiConfiguration {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][string]$BaseUrl,
+        [string]$AccessToken
+    )
+
+    $configuration = [VMware.Binding.OpenApi.Client.Configuration]::new()
+    $configuration.BasePath = $BaseUrl.TrimEnd('/')
+    if ($AccessToken) { $configuration.AccessToken = $AccessToken }
+    return $configuration
+}
+
+function Get-VcfAccessToken {
+    <#
+    .SYNOPSIS
+        createToken -- POST /v1/tokens.
+    .DESCRIPTION
+        TokenCreationSpec has no required properties; apiKey and idToken are
+        left unset so the SDK serializer omits them from the request body
+        rather than sending them as null or empty strings.
+    #>
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][string]$BaseUrl,
+        [Parameter(Mandatory)][string]$Username,
+        [Parameter(Mandatory)][string]$Password
+    )
+
+    $configuration = New-VcfApiConfiguration -BaseUrl $BaseUrl
+    $handler = [System.Net.Http.HttpClientHandler]::new()
+    $client = [System.Net.Http.HttpClient]::new($handler)
+    try {
+        $api = [VMware.Bindings.Vcf.SddcManager.Api.TokensApi]::new($client, $configuration, $handler)
+        $spec = Initialize-VcfTokenCreationSpec -Username $Username -Password $Password
+        $pair = $api.CreateToken($spec)
+        if (-not $pair.AccessToken) { throw 'createToken returned no access token.' }
+        return $pair.AccessToken
+    }
+    finally {
+        $client.Dispose()
+        $handler.Dispose()
+    }
+}
+
+function ConvertTo-VcfHostCommissionSpec {
+    <#
+    .SYNOPSIS
+        Builds SDK HostCommissionSpec models from plain hashtables.
+    .DESCRIPTION
+        Only keys the caller actually supplied are passed to
+        Initialize-VcfHostCommissionSpec. An optional property that was never
+        set stays null on the model, and the SDK omits null properties when it
+        serializes the request body.
+    #>
+    [CmdletBinding()]
+    param([Parameter(Mandatory)][hashtable[]]$HostSpec)
+
+    $required = @('Fqdn', 'Username', 'Password', 'StorageType', 'NetworkPoolId')
+    $optional = @('VvolStorageProtocolType', 'NetworkPoolName', 'SshThumbprint', 'SslThumbprint')
+
+    $list = [System.Collections.Generic.List[VMware.Bindings.Vcf.SddcManager.Model.HostCommissionSpec]]::new()
+    foreach ($entry in $HostSpec) {
+        $arguments = @{}
+        foreach ($key in $required) {
+            if (-not $entry.ContainsKey($key) -or [string]::IsNullOrWhiteSpace([string]$entry[$key])) {
+                throw "Host spec is missing required property '$key'."
+            }
+            $arguments[$key] = [string]$entry[$key]
+        }
+        foreach ($key in $optional) {
+            if ($entry.ContainsKey($key)) {
+                $arguments[$key] = [string]$entry[$key]
+            }
+        }
+        $list.Add((Initialize-VcfHostCommissionSpec @arguments))
+    }
+    return , $list
+}
+
+function Test-VcfValidationTerminal {
+    param([string]$ExecutionStatus)
+    return $ExecutionStatus -in @('COMPLETED', 'FAILED', 'UNKNOWN', 'SKIPPED')
+}
+
+function Test-VcfValidationPassed {
+    param($Validation)
+    return ($Validation.ExecutionStatus -eq 'COMPLETED' -and $Validation.ResultStatus -eq 'SUCCEEDED')
+}
+
+function Invoke-VcfHostCommissionWorkflow {
+    <#
+    .SYNOPSIS
+        Runs the SDDC Manager host commission precheck and commissions the hosts
+        only when the precheck passes.
+
+    .DESCRIPTION
+        Sequence, all four calls made through the VMware.Sdk.Vcf generated
+        client so the request bodies come from the SDK models:
+
+            createToken                      POST /v1/tokens
+            validateHostCommissionSpec       POST /v1/hosts/validations
+            getHostCommissionValidationByID  GET  /v1/hosts/validations/{id}   (only while IN_PROGRESS)
+            commissionHosts                  POST /v1/hosts                    (only when the precheck passed)
+
+        When the precheck does not end COMPLETED/SUCCEEDED the workflow returns
+        without issuing the mutating POST /v1/hosts, so nothing is changed.
+
+    .OUTPUTS
+        [pscustomobject] with Validation, Committed, Task and Reason.
+    #>
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)][string]$BaseUrl,
+        [Parameter(Mandatory)][string]$Username,
+        [Parameter(Mandatory)][string]$Password,
+        [Parameter(Mandatory)][hashtable[]]$HostSpec,
+        [double]$PollIntervalSeconds = 0.2,
+        [double]$TimeoutSeconds = 30
+    )
+
+    $null = Get-VcfHostCommissionContract
+    $specs = ConvertTo-VcfHostCommissionSpec -HostSpec $HostSpec
+    $accessToken = Get-VcfAccessToken -BaseUrl $BaseUrl -Username $Username -Password $Password
+
+    $configuration = New-VcfApiConfiguration -BaseUrl $BaseUrl -AccessToken $accessToken
+    $handler = [System.Net.Http.HttpClientHandler]::new()
+    $client = [System.Net.Http.HttpClient]::new($handler)
+    try {
+        $hosts = [VMware.Bindings.Vcf.SddcManager.Api.HostsApi]::new($client, $configuration, $handler)
+
+        $validation = $hosts.ValidateHostCommissionSpec($specs)
+
+        $stopwatch = [System.Diagnostics.Stopwatch]::StartNew()
+        while (-not (Test-VcfValidationTerminal -ExecutionStatus $validation.ExecutionStatus)) {
+            if ($stopwatch.Elapsed.TotalSeconds -ge $TimeoutSeconds) {
+                return [pscustomobject]@{
+                    Validation = $validation
+                    Committed  = $false
+                    Task       = $null
+                    Reason     = "Precheck '$($validation.Id)' did not reach a terminal state within $TimeoutSeconds seconds."
+                }
+            }
+            Start-Sleep -Seconds $PollIntervalSeconds
+            $validation = $hosts.GetHostCommissionValidationByID($validation.Id)
+        }
+
+        if (-not (Test-VcfValidationPassed -Validation $validation)) {
+            return [pscustomobject]@{
+                Validation = $validation
+                Committed  = $false
+                Task       = $null
+                Reason     = "Precheck '$($validation.Id)' ended $($validation.ExecutionStatus)/$($validation.ResultStatus); hosts were not commissioned."
+            }
+        }
+
+        $task = $hosts.CommissionHosts($specs)
+        return [pscustomobject]@{
+            Validation = $validation
+            Committed  = $true
+            Task       = $task
+            Reason     = "Precheck '$($validation.Id)' passed; commission task '$($task.Id)' submitted."
+        }
+    }
+    finally {
+        $client.Dispose()
+        $handler.Dispose()
+    }
+}
+
+Export-ModuleMember -Function Invoke-VcfHostCommissionWorkflow

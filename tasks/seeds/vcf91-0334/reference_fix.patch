+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.charset.StandardCharsets;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Attaches a vCenter server to VCF Automation 9.1 through the Provider Infrastructure APIs.
+ *
+ * <p>Attach Virtual Center is a mutating call and the API publishes no idempotency mechanism for
+ * it, so this client supplies the retry safety: it queries the collection filtered on the vCenter
+ * url first and only posts when that url is not attached yet. Re-running the same call is
+ * therefore a no-op instead of a second registration.
+ *
+ * <p>The wire shape is pinned by {@code docs/contract.json}.
+ */
+public final class VcfAutomationVirtualCenterClient {
+    private static final String VIRTUAL_CENTERS_PATH = "/cloudapi/1.0.0/virtualCenters";
+    private static final String ACCEPT = "application/json;version=9.1.0";
+    private static final String TENANT_CONTEXT_HEADER = "X-VMWARE-VCLOUD-TENANT-CONTEXT";
+    private static final int PAGE = 1;
+    private static final int PAGE_SIZE = 128;
+
+    /** The result of making sure a vCenter is attached exactly once. */
+    public record AttachOutcome(boolean alreadyAttached, String vcId, String taskLocation) {
+    }
+
+    /** A documented, non-successful answer from VCF Automation. */
+    public static final class VcfAutomationApiException extends RuntimeException {
+        private final int statusCode;
+        private final String minorErrorCode;
+
+        VcfAutomationApiException(int statusCode, String minorErrorCode, String message) {
+            super(message);
+            this.statusCode = statusCode;
+            this.minorErrorCode = minorErrorCode;
+        }
+
+        public int statusCode() {
+            return statusCode;
+        }
+
+        public String minorErrorCode() {
+            return minorErrorCode;
+        }
+    }
+
+    private final HttpClient http = HttpClient.newBuilder()
+            .connectTimeout(Duration.ofSeconds(20))
+            .build();
+    private final String baseUrl;
+    private final String jwtToken;
+    private final String tenantOrgId;
+
+    public VcfAutomationVirtualCenterClient(String baseUrl, String jwtToken, String tenantOrgId) {
+        this.baseUrl = require(baseUrl, "baseUrl").replaceAll("/+$", "");
+        this.jwtToken = require(jwtToken, "jwtToken");
+        this.tenantOrgId = isBlank(tenantOrgId) ? null : tenantOrgId.trim();
+    }
+
+    /**
+     * Makes sure the vCenter identified by {@code url} is attached, without ever attaching it twice.
+     *
+     * @param description optional; omitted from the request when null or blank
+     * @param isEnabled   optional; omitted from the request when null
+     */
+    public AttachOutcome ensureVirtualCenterAttached(String name, String url, String username,
+            String password, String description, Boolean isEnabled) {
+        require(name, "name");
+        require(url, "url");
+        require(username, "username");
+        require(password, "password");
+
+        VCenterEntry attached = findAttached(url);
+        if (attached != null) {
+            return new AttachOutcome(true, attached.vcId(), null);
+        }
+        return new AttachOutcome(false, null,
+                attach(name, url, username, password, description, isEnabled));
+    }
+
+    private VCenterEntry findAttached(String url) {
+        String query = "filter=" + percentEncode("url==" + url)
+                + "&page=" + PAGE + "&pageSize=" + PAGE_SIZE;
+        HttpResponse<String> response = send(HttpRequest.newBuilder(
+                URI.create(baseUrl + VIRTUAL_CENTERS_PATH + "?" + query)).GET());
+        if (response.statusCode() != 200) {
+            throw apiException(response);
+        }
+
+        Object parsed = parseJson(response.body(), "Query Virtual Centers");
+        if (!(parsed instanceof Map<?, ?> envelope) || !(envelope.get("values") instanceof List<?> values)) {
+            throw new IllegalStateException(
+                    "Query Virtual Centers returned a page without a values array.");
+        }
+        List<VCenterEntry> matches = new ArrayList<>();
+        for (Object value : values) {
+            if (value instanceof Map<?, ?> entry && url.equals(entry.get("url"))) {
+                Object vcId = entry.get("vcId");
+                if (!(vcId instanceof String urn) || urn.isBlank()) {
+                    throw new IllegalStateException(
+                            "An attached vCenter for " + url + " was returned without a vcId.");
+                }
+                matches.add(new VCenterEntry(urn));
+            }
+        }
+        if (matches.size() > 1) {
+            throw new IllegalStateException(
+                    "VCF Automation reports " + matches.size() + " vCenter servers for " + url + ".");
+        }
+        return matches.isEmpty() ? null : matches.get(0);
+    }
+
+    private String attach(String name, String url, String username, String password,
+            String description, Boolean isEnabled) {
+        StringBuilder body = new StringBuilder("{\"name\":").append(quote(name));
+        if (!isBlank(description)) {
+            body.append(",\"description\":").append(quote(description));
+        }
+        body.append(",\"username\":").append(quote(username))
+                .append(",\"password\":").append(quote(password))
+                .append(",\"url\":").append(quote(url));
+        if (isEnabled != null) {
+            body.append(",\"isEnabled\":").append(isEnabled.booleanValue());
+        }
+        body.append('}');
+
+        HttpResponse<String> response = send(HttpRequest
+                .newBuilder(URI.create(baseUrl + VIRTUAL_CENTERS_PATH))
+                .header("Content-Type", "application/json")
+                .POST(HttpRequest.BodyPublishers.ofString(body.toString(), StandardCharsets.UTF_8)));
+        if (response.statusCode() != 202) {
+            throw apiException(response, password);
+        }
+        String location = response.headers().firstValue("Location").orElse(null);
+        if (isBlank(location)) {
+            throw new IllegalStateException(
+                    "Attach Virtual Center was accepted without a task URI in the Location header.");
+        }
+        return location;
+    }
+
+    private HttpResponse<String> send(HttpRequest.Builder builder) {
+        builder.header("Authorization", "Bearer " + jwtToken).header("Accept", ACCEPT);
+        if (tenantOrgId != null) {
+            builder.header(TENANT_CONTEXT_HEADER, tenantOrgId);
+        }
+        try {
+            return http.send(builder.build(), HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+        } catch (InterruptedException ex) {
+            Thread.currentThread().interrupt();
+            throw new IllegalStateException("Interrupted while calling VCF Automation.", ex);
+        } catch (java.io.IOException ex) {
+            throw new IllegalStateException("VCF Automation is unreachable: " + ex.getMessage(), ex);
+        }
+    }
+
+    private VcfAutomationApiException apiException(HttpResponse<String> response,
+            String... additionalSecrets) {
+        String minorErrorCode = null;
+        String message = null;
+        String body = response.body();
+        if (body != null && !body.isBlank()) {
+            try {
+                if (parseJson(body, "error") instanceof Map<?, ?> error) {
+                    minorErrorCode = error.get("minorErrorCode") instanceof String code ? code : null;
+                    message = error.get("message") instanceof String text ? text : null;
+                }
+            } catch (RuntimeException ignored) {
+                // A body that is not an Error data structure adds nothing to the report.
+            }
+        }
+        StringBuilder report = new StringBuilder("VCF Automation returned HTTP ")
+                .append(response.statusCode());
+        if (minorErrorCode != null) {
+            report.append(" (").append(redact(minorErrorCode, additionalSecrets)).append(')');
+        }
+        if (message != null) {
+            report.append(": ").append(redact(message, additionalSecrets));
+        }
+        return new VcfAutomationApiException(response.statusCode(), minorErrorCode, report.toString());
+    }
+
+    private String redact(String value, String... additionalSecrets) {
+        String redacted = value.replace(jwtToken, "[REDACTED]");
+        for (String secret : additionalSecrets) {
+            if (!isBlank(secret)) {
+                redacted = redacted.replace(secret, "[REDACTED]");
+            }
+        }
+        return redacted;
+    }
+
+    private static Object parseJson(String body, String what) {
+        try {
+            return Json.parse(body);
+        } catch (RuntimeException ex) {
+            throw new IllegalStateException(what + " returned a body that is not valid JSON.", ex);
+        }
+    }
+
+    private static String require(String value, String what) {
+        if (isBlank(value)) {
+            throw new IllegalArgumentException(what + " is required.");
+        }
+        return value;
+    }
+
+    private static boolean isBlank(String value) {
+        return value == null || value.isBlank();
+    }
+
+    /** Percent-encodes everything outside the unreserved set, with uppercase hex. */
+    private static String percentEncode(String value) {
+        StringBuilder out = new StringBuilder();
+        for (byte raw : value.getBytes(StandardCharsets.UTF_8)) {
+            int octet = raw & 0xFF;
+            if ((octet >= 'A' && octet <= 'Z') || (octet >= 'a' && octet <= 'z')
+                    || (octet >= '0' && octet <= '9') || octet == '-' || octet == '.' || octet == '_') {
+                out.append((char) octet);
+            } else {
+                out.append(String.format(Locale.ROOT, "%%%02X", octet));
+            }
+        }
+        return out.toString();
+    }
+
+    private static String quote(String value) {
+        StringBuilder out = new StringBuilder("\"");
+        for (int index = 0; index < value.length(); index++) {
+            char character = value.charAt(index);
+            switch (character) {
+                case '"' -> out.append("\\\"");
+                case '\\' -> out.append("\\\\");
+                case '\b' -> out.append("\\b");
+                case '\f' -> out.append("\\f");
+                case '\n' -> out.append("\\n");
+                case '\r' -> out.append("\\r");
+                case '\t' -> out.append("\\t");
+                default -> {
+                    if (character < 0x20) {
+                        out.append(String.format(Locale.ROOT, "\\u%04x", (int) character));
+                    } else {
+                        out.append(character);
+                    }
+                }
+            }
+        }
+        return out.append('"').toString();
+    }
+
+    private record VCenterEntry(String vcId) {
+    }
+
+    /** Minimal JSON reader for the two response shapes this client consumes. */
+    private static final class Json {
+        private final String source;
+        private int cursor;
+
+        private Json(String source) {
+            this.source = source;
+        }
+
+        static Object parse(String source) {
+            Json parser = new Json(source);
+            Object value = parser.readValue();
+            parser.skipWhitespace();
+            if (parser.cursor != source.length()) {
+                throw new IllegalArgumentException("trailing content in JSON document");
+            }
+            return value;
+        }
+
+        private Object readValue() {
+            skipWhitespace();
+            char character = peek();
+            return switch (character) {
+                case '{' -> readObject();
+                case '[' -> readArray();
+                case '"' -> readString();
+                case 't' -> readLiteral("true", Boolean.TRUE);
+                case 'f' -> readLiteral("false", Boolean.FALSE);
+                case 'n' -> readLiteral("null", null);
+                default -> readNumber();
+            };
+        }
+
+        private Map<String, Object> readObject() {
+            Map<String, Object> object = new LinkedHashMap<>();
+            cursor++;
+            skipWhitespace();
+            if (peek() == '}') {
+                cursor++;
+                return object;
+            }
+            while (true) {
+                skipWhitespace();
+                String key = readString();
+                skipWhitespace();
+                if (next() != ':') {
+                    throw new IllegalArgumentException("expected : in JSON object");
+                }
+                object.put(key, readValue());
+                skipWhitespace();
+                char delimiter = next();
+                if (delimiter == '}') {
+                    return object;
+                }
+                if (delimiter != ',') {
+                    throw new IllegalArgumentException("expected , or } in JSON object");
+                }
+            }
+        }
+
+        private List<Object> readArray() {
+            List<Object> values = new ArrayList<>();
+            cursor++;
+            skipWhitespace();
+            if (peek() == ']') {
+                cursor++;
+                return values;
+            }
+            while (true) {
+                values.add(readValue());
+                skipWhitespace();
+                char delimiter = next();
+                if (delimiter == ']') {
+                    return values;
+                }
+                if (delimiter != ',') {
+                    throw new IllegalArgumentException("expected , or ] in JSON array");
+                }
+            }
+        }
+
+        private String readString() {
+            if (next() != '"') {
+                throw new IllegalArgumentException("expected a JSON string");
+            }
+            StringBuilder out = new StringBuilder();
+            while (true) {
+                char character = next();
+                if (character == '"') {
+                    return out.toString();
+                }
+                if (character != '\\') {
+                    out.append(character);
+                    continue;
+                }
+                char escape = next();
+                switch (escape) {
+                    case '"', '\\', '/' -> out.append(escape);
+                    case 'b' -> out.append('\b');
+                    case 'f' -> out.append('\f');
+                    case 'n' -> out.append('\n');
+                    case 'r' -> out.append('\r');
+                    case 't' -> out.append('\t');
+                    case 'u' -> {
+                        out.append((char) Integer.parseInt(source.substring(cursor, cursor + 4), 16));
+                        cursor += 4;
+                    }
+                    default -> throw new IllegalArgumentException("invalid escape in JSON string");
+                }
+            }
+        }
+
+        private Object readLiteral(String literal, Object value) {
+            if (!source.startsWith(literal, cursor)) {
+                throw new IllegalArgumentException("invalid JSON literal");
+            }
+            cursor += literal.length();
+            return value;
+        }
+
+        private Object readNumber() {
+            int start = cursor;
+            while (cursor < source.length() && "+-.eE0123456789".indexOf(source.charAt(cursor)) >= 0) {
+                cursor++;
+            }
+            if (start == cursor) {
+                throw new IllegalArgumentException("invalid JSON value");
+            }
+            return Double.parseDouble(source.substring(start, cursor));
+        }
+
+        private void skipWhitespace() {
+            while (cursor < source.length() && Character.isWhitespace(source.charAt(cursor))) {
+                cursor++;
+            }
+        }
+
+        private char peek() {
+            if (cursor >= source.length()) {
+                throw new IllegalArgumentException("unexpected end of JSON document");
+            }
+            return source.charAt(cursor);
+        }
+
+        private char next() {
+            if (cursor >= source.length()) {
+                throw new IllegalArgumentException("unexpected end of JSON document");
+            }
+            return source.charAt(cursor++);
+        }
+    }
+}

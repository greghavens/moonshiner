{
  "component": "VCF Operations for Logs",
  "openapi": "3.0.1",
  "apiVersion": "v2",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "license": "Apache-2.0",
    "tag": "9.0.0.0",
    "commitSha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "specPath": "specifications/vcf-operations/vcf-operations-for-logs-openapi.json"
  },
  "derivation": "Projection of the two named path operations and their referenced component schemas from the pinned OpenAPI specification.",
  "serverBasePath": "/api/v2",
  "operations": [
    {
      "operationId": "POST_deployment-join",
      "method": "POST",
      "path": "/deployment/join",
      "description": "Joins a newly installed VCF Operations for Logs server to an existing cluster. The configuration can take several minutes to complete; POST_deployment-waitUntilStarted tracks the join deployment.",
      "security": [],
      "requestBody": {
        "required": false,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "masterFQDN": {
                  "type": "string"
                },
                "masterPort": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535,
                  "exclusiveMinimum": false,
                  "exclusiveMaximum": false
                },
                "acceptCert": {
                  "type": "boolean"
                }
              },
              "required": [
                "masterFQDN"
              ]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Successfully submitted a request to join the cluster.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "masterAddress": {
                    "type": "string"
                  },
                  "workerAddress": {
                    "type": "string"
                  },
                  "workerPort": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535,
                    "exclusiveMinimum": false,
                    "exclusiveMaximum": false
                  },
                  "workerToken": {
                    "type": "string"
                  },
                  "masterUiPort": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535,
                    "exclusiveMinimum": false,
                    "exclusiveMaximum": false
                  }
                },
                "required": [
                  "masterAddress",
                  "workerAddress",
                  "workerPort",
                  "workerToken",
                  "masterUiPort"
                ],
                "title": "Joined existing deployment"
              }
            }
          }
        },
        "400": {
          "description": "The request body did not contain valid JSON or did not match the required JSON format.",
          "contentSchema": "error"
        },
        "403": {
          "description": "An error occurred when processing the request.",
          "contentSchema": "error"
        },
        "409": {
          "description": "This interface is not available after the server has been configured.",
          "contentSchema": "error"
        },
        "495": {
          "description": "SSL connection failed because the primary node certificate is not trusted.",
          "contentSchema": "error"
        }
      }
    },
    {
      "operationId": "POST_deployment-waitUntilStarted",
      "method": "POST",
      "path": "/deployment/waitUntilStarted",
      "description": "Waits until the server starts. This can take several minutes to complete and should be retried in case of failure.",
      "security": [],
      "requestBody": null,
      "responses": {
        "200": {
          "description": "The server started successfully.",
          "content": {}
        },
        "500": {
          "description": "Internal error while processing the client request.",
          "contentSchema": "error"
        }
      }
    }
  ],
  "schemas": {
    "error": {
      "type": "object",
      "properties": {
        "errorMessage": {
          "type": "string",
          "description": "A message describing the error."
        },
        "errorCode": {
          "type": "string",
          "description": "A code representing the type of error."
        },
        "errorDetails": {
          "type": "object",
          "description": "Dynamic error details."
        }
      },
      "required": [
        "errorMessage"
      ]
    }
  }
}

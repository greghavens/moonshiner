+function ConvertTo-VcfVcenterOrigin {
+    param(
+        [Parameter(Mandatory)]
+        [uri] $Server
+    )
+
+    if (
+        -not $Server.IsAbsoluteUri -or
+        $Server.Scheme -notin @('http', 'https') -or
+        -not [string]::IsNullOrEmpty($Server.UserInfo) -or
+        -not [string]::IsNullOrEmpty($Server.Query) -or
+        -not [string]::IsNullOrEmpty($Server.Fragment) -or
+        $Server.AbsolutePath -ne '/'
+    ) {
+        throw [System.ArgumentException]::new(
+            'Server must be an HTTP(S) origin without credentials, query, or fragment.',
+            'Server'
+        )
+    }
+    return [uri] (
+        $Server.GetLeftPart([System.UriPartial]::Authority)
+    )
+}
+
+function New-VcfVcenterTokenGeneration {
+    param(
+        [Parameter(Mandatory)]
+        [uri] $Server,
+
+        [Parameter(Mandatory)]
+        [string] $SessionToken,
+
+        [Parameter(Mandatory)]
+        [bool] $SkipCertificateCheck
+    )
+
+    if ([string]::IsNullOrWhiteSpace($SessionToken)) {
+        throw [System.ArgumentException]::new(
+            'SessionToken must contain a non-whitespace value.',
+            'SessionToken'
+        )
+    }
+    $Origin = ConvertTo-VcfVcenterOrigin -Server $Server
+    $Handler = [Net.Http.HttpClientHandler]::new()
+    if ($SkipCertificateCheck) {
+        $Handler.ServerCertificateCustomValidationCallback = {
+            param($RequestMessage, $Certificate, $Chain, $SslPolicyErrors)
+            return $true
+        }
+    }
+    $HttpClient = [Net.Http.HttpClient]::new($Handler, $true)
+    $Added = $HttpClient.DefaultRequestHeaders.TryAddWithoutValidation(
+        'vmware-api-session-id',
+        $SessionToken
+    )
+    if (-not $Added) {
+        $HttpClient.Dispose()
+        throw 'Could not configure vCenter session authentication.'
+    }
+    return [pscustomobject] [ordered]@{
+        BaseUri = $Origin
+        HttpClient = $HttpClient
+        OwnsClient = $true
+    }
+}
+
+function New-VcfVcenterConnectionGeneration {
+    param(
+        [Parameter(Mandatory)]
+        [VMware.Sdk.OpenApi.Cmdlets.IServerConnection] $Connection,
+
+        [AllowNull()]
+        [uri] $Server
+    )
+
+    $HttpClient = $Connection.GetClient()
+    if ($null -eq $HttpClient) {
+        throw 'The VCF PowerCLI connection did not provide an HttpClient.'
+    }
+    $EffectiveServer = if ($null -ne $Server) {
+        $Server
+    }
+    else {
+        $Connection.ServerUri
+    }
+    if ($null -eq $EffectiveServer) {
+        throw 'The VCF PowerCLI connection did not provide a server URI.'
+    }
+    $Origin = ConvertTo-VcfVcenterOrigin -Server $EffectiveServer
+    return [pscustomobject] [ordered]@{
+        BaseUri = $Origin
+        HttpClient = $HttpClient
+        OwnsClient = $false
+    }
+}
+
+function Assert-VcfVcenterCredentialClient {
+    param(
+        [Parameter(Mandatory)]
+        [psobject] $Client
+    )
+
+    foreach ($Name in @(
+        'SyncRoot',
+        'Generation',
+        'ActiveRequests',
+        'RotationPending',
+        'Version'
+    )) {
+        if ($null -eq $Client.PSObject.Properties[$Name]) {
+            throw [System.ArgumentException]::new(
+                'Client must be created by New-VcfVcenterCredentialClient.',
+                'Client'
+            )
+        }
+    }
+    if ($null -eq $Client.SyncRoot -or $null -eq $Client.Generation) {
+        throw [System.ArgumentException]::new(
+            'Client must be created by New-VcfVcenterCredentialClient.',
+            'Client'
+        )
+    }
+}
+
+function Enter-VcfVcenterCredentialLease {
+    param(
+        [Parameter(Mandatory)]
+        [psobject] $Client
+    )
+
+    Assert-VcfVcenterCredentialClient -Client $Client
+    [System.Threading.Monitor]::Enter($Client.SyncRoot)
+    try {
+        while ([bool] $Client.RotationPending) {
+            [void] [System.Threading.Monitor]::Wait($Client.SyncRoot)
+        }
+        $Client.ActiveRequests = [int] $Client.ActiveRequests + 1
+        return $Client.Generation
+    }
+    finally {
+        [System.Threading.Monitor]::Exit($Client.SyncRoot)
+    }
+}
+
+function Exit-VcfVcenterCredentialLease {
+    param(
+        [Parameter(Mandatory)]
+        [psobject] $Client
+    )
+
+    [System.Threading.Monitor]::Enter($Client.SyncRoot)
+    try {
+        $Client.ActiveRequests = [int] $Client.ActiveRequests - 1
+        if ([int] $Client.ActiveRequests -lt 0) {
+            throw 'The vCenter credential lease count became invalid.'
+        }
+        [System.Threading.Monitor]::PulseAll($Client.SyncRoot)
+    }
+    finally {
+        [System.Threading.Monitor]::Exit($Client.SyncRoot)
+    }
+}

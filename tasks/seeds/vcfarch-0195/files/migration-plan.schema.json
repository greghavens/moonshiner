{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alder Biologics VCF migration architecture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "inventoryId",
    "snapshotId",
    "targetVersion",
    "research",
    "sourceMappings",
    "lifecycleBoundaries",
    "architecture",
    "contentDisposition",
    "migrationSteps"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "inventoryId": {"type": "string", "minLength": 1},
    "snapshotId": {"type": "string", "minLength": 1},
    "targetVersion": {"type": "string", "minLength": 1},
    "research": {"$ref": "#/$defs/research"},
    "sourceMappings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceMapping"}
    },
    "lifecycleBoundaries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/lifecycleBoundary"}
    },
    "architecture": {"$ref": "#/$defs/architecture"},
    "contentDisposition": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/contentDisposition"}
    },
    "migrationSteps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/migrationStep"}
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performed", "sourcesConsulted"],
      "properties": {
        "performed": {"const": true},
        "sourcesConsulted": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "url", "accessedOn", "claims"],
            "properties": {
              "title": {"$ref": "#/$defs/nonEmptyString"},
              "url": {"type": "string", "minLength": 8},
              "accessedOn": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
              "claims": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/nonEmptyString"}
              }
            }
          }
        }
      }
    },
    "sourceProductRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productId", "productName", "version"],
      "properties": {
        "productId": {"$ref": "#/$defs/nonEmptyString"},
        "productName": {"$ref": "#/$defs/nonEmptyString"},
        "version": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "sourceMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productId",
        "sourceProductName",
        "sourceVersion",
        "targetProductName",
        "targetVersion",
        "targetComponentIds",
        "strategy",
        "compatibilityDecision"
      ],
      "properties": {
        "productId": {"$ref": "#/$defs/nonEmptyString"},
        "sourceProductName": {"$ref": "#/$defs/nonEmptyString"},
        "sourceVersion": {"$ref": "#/$defs/nonEmptyString"},
        "targetProductName": {"$ref": "#/$defs/nonEmptyString"},
        "targetVersion": {"$ref": "#/$defs/nonEmptyString"},
        "targetComponentIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "strategy": {
          "type": "string",
          "enum": ["greenfield-export-import", "fleet-import-in-place-upgrade", "parallel-fresh-deployment"]
        },
        "compatibilityDecision": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "lifecycleBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productId", "productName", "version", "boundaryType", "date", "designImpact"],
      "properties": {
        "productId": {"$ref": "#/$defs/nonEmptyString"},
        "productName": {"$ref": "#/$defs/nonEmptyString"},
        "version": {"$ref": "#/$defs/nonEmptyString"},
        "boundaryType": {"const": "End of General Support"},
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "designImpact": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designSummary", "components"],
      "properties": {
        "designSummary": {"$ref": "#/$defs/nonEmptyString"},
        "components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/component"}
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentId", "targetProduct", "targetVersion", "role", "placement", "sizing", "capacity", "rationale"],
      "properties": {
        "componentId": {"$ref": "#/$defs/nonEmptyString"},
        "targetProduct": {"$ref": "#/$defs/nonEmptyString"},
        "targetVersion": {"$ref": "#/$defs/nonEmptyString"},
        "role": {"$ref": "#/$defs/nonEmptyString"},
        "placement": {"$ref": "#/$defs/placement"},
        "sizing": {"$ref": "#/$defs/sizing"},
        "capacity": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/capacity"}
        },
        "rationale": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["siteId", "domainId", "clusterId", "failureDomains"],
      "properties": {
        "siteId": {"$ref": "#/$defs/nonEmptyString"},
        "domainId": {"$ref": "#/$defs/nonEmptyString"},
        "clusterId": {"$ref": "#/$defs/nonEmptyString"},
        "failureDomains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        }
      }
    },
    "sizing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "nodeCount", "vCpuPerNode", "memoryGiBPerNode", "diskGiBPerNode"],
      "properties": {
        "profile": {"$ref": "#/$defs/nonEmptyString"},
        "nodeCount": {"type": "integer", "minimum": 1},
        "vCpuPerNode": {"type": "integer", "minimum": 1},
        "memoryGiBPerNode": {"type": "integer", "minimum": 1},
        "diskGiBPerNode": {"type": "integer", "minimum": 1}
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "required", "provided", "unit"],
      "properties": {
        "metric": {"$ref": "#/$defs/nonEmptyString"},
        "required": {"type": "integer", "minimum": 0},
        "provided": {"type": "integer", "minimum": 0},
        "unit": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "contentDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceProductId",
        "sourceProductName",
        "sourceVersion",
        "contentId",
        "kind",
        "decision",
        "targetComponentId",
        "method",
        "rationale"
      ],
      "properties": {
        "sourceProductId": {"$ref": "#/$defs/nonEmptyString"},
        "sourceProductName": {"$ref": "#/$defs/nonEmptyString"},
        "sourceVersion": {"$ref": "#/$defs/nonEmptyString"},
        "contentId": {"$ref": "#/$defs/nonEmptyString"},
        "kind": {"$ref": "#/$defs/nonEmptyString"},
        "decision": {"type": "string", "enum": ["carry", "recreate", "replace", "abandon"]},
        "targetComponentId": {"$ref": "#/$defs/nonEmptyString"},
        "method": {"$ref": "#/$defs/nonEmptyString"},
        "rationale": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "migrationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "sequence", "name", "sourceProducts", "targetComponentIds", "action", "contentItemIds", "gates"],
      "properties": {
        "stepId": {"$ref": "#/$defs/nonEmptyString"},
        "sequence": {"type": "integer", "minimum": 1},
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "sourceProducts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceProductRef"}
        },
        "targetComponentIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "action": {"$ref": "#/$defs/nonEmptyString"},
        "contentItemIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "gates": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/gate"}
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateId", "phase", "condition", "evidence"],
      "properties": {
        "gateId": {"$ref": "#/$defs/nonEmptyString"},
        "phase": {"type": "string", "enum": ["entry", "exit"]},
        "condition": {"$ref": "#/$defs/nonEmptyString"},
        "evidence": {"$ref": "#/$defs/nonEmptyString"}
      }
    }
  }
}

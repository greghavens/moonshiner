+// Package installer implements the VCF Installer operations pinned by this
+// module's 9.0 contract.
+package installer
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+)
+
+const updateDepotSettingsPath = "/v1/system/settings/depot"
+
+// DepotSettings is the request and response document for
+// updateDepotSettings. Each member is optional in the 9.0 specification.
+type DepotSettings struct {
+	VMwareAccount         *DepotAccount       `json:"vmwareAccount,omitempty"`
+	DellEmcSupportAccount *DepotAccount       `json:"dellEmcSupportAccount,omitempty"`
+	OfflineAccount        *DepotAccount       `json:"offlineAccount,omitempty"`
+	DepotConfiguration    *DepotConfiguration `json:"depotConfiguration,omitempty"`
+}
+
+// DepotAccount contains the optional credentials and status fields described
+// by the 9.0 DepotAccount schema.
+type DepotAccount struct {
+	Username      string `json:"username,omitempty"`
+	Password      string `json:"password,omitempty"`
+	Status        string `json:"status,omitempty"`
+	Message       string `json:"message,omitempty"`
+	DownloadToken string `json:"downloadToken,omitempty"`
+}
+
+// DepotConfiguration contains the three fields required by the 9.0 schema.
+// IsOfflineDepot intentionally has no omitempty tag because false is a valid,
+// required wire value.
+type DepotConfiguration struct {
+	IsOfflineDepot bool   `json:"isOfflineDepot"`
+	Hostname       string `json:"hostname"`
+	Port           int32  `json:"port"`
+}
+
+// Client invokes the contracted VCF Installer operation at baseURL.
+type Client struct {
+	baseURL string
+	hc      *http.Client
+}
+
+// NewClient returns a client that uses hc, or http.DefaultClient when hc is
+// nil.
+func NewClient(baseURL string, hc *http.Client) *Client {
+	if hc == nil {
+		hc = http.DefaultClient
+	}
+	return &Client{baseURL: strings.TrimRight(baseURL, "/"), hc: hc}
+}
+
+// UpdateDepotSettings replaces the depot settings using the 9.0
+// updateDepotSettings operation. Repeating the call with the same settings
+// produces the same full-representation PUT.
+func (c *Client) UpdateDepotSettings(ctx context.Context, settings DepotSettings) (DepotSettings, error) {
+	payload, err := json.Marshal(settings)
+	if err != nil {
+		return DepotSettings{}, fmt.Errorf("encode depot settings: %w", err)
+	}
+	req, err := http.NewRequestWithContext(
+		ctx,
+		http.MethodPut,
+		c.baseURL+updateDepotSettingsPath,
+		bytes.NewReader(payload),
+	)
+	if err != nil {
+		return DepotSettings{}, fmt.Errorf("build updateDepotSettings request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+
+	resp, err := c.hc.Do(req)
+	if err != nil {
+		return DepotSettings{}, fmt.Errorf("send updateDepotSettings request: %w", err)
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return DepotSettings{}, fmt.Errorf("read updateDepotSettings response: %w", err)
+	}
+	if resp.StatusCode != http.StatusAccepted {
+		return DepotSettings{}, fmt.Errorf("updateDepotSettings returned HTTP %d", resp.StatusCode)
+	}
+
+	var updated *DepotSettings
+	if err := json.Unmarshal(body, &updated); err != nil {
+		return DepotSettings{}, fmt.Errorf("decode updateDepotSettings response: %w", err)
+	}
+	if updated == nil {
+		return DepotSettings{}, fmt.Errorf("decode updateDepotSettings response: null body")
+	}
+	return *updated, nil
+}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moonshiner:vcf-migration-plan:1",
  "title": "VCF brownfield migration architecture extensions",
  "type": "object",
  "required": [
    "artifactSchemaVersion",
    "estateId",
    "targetVersion",
    "researchConsulted",
    "versionPath",
    "migrationPlan",
    "edgeArchitecture"
  ],
  "properties": {
    "artifactSchemaVersion": {
      "const": "1.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetVersion": {
      "type": "string",
      "minLength": 1
    },
    "researchConsulted": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "publisher", "url", "consultedOn", "usedFor"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "pattern": "Broadcom"
          },
          "url": {
            "type": "string",
            "pattern": "^https://([A-Za-z0-9-]+\\.)*broadcom\\.com(?:/|$)"
          },
          "consultedOn": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "usedFor": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "versionPath": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "migrationPlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "componentId",
          "component",
          "currentVersion",
          "targetVersion",
          "action",
          "gates"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "currentVersion": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "edgeArchitecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredThroughputGbpsPerActiveEdge",
        "formFactor",
        "nodeCount",
        "routingMode",
        "uplinkLayout"
      ],
      "properties": {
        "requiredThroughputGbpsPerActiveEdge": {
          "type": "integer",
          "minimum": 1
        },
        "formFactor": {
          "type": "string",
          "minLength": 1
        },
        "nodeCount": {
          "type": "integer",
          "minimum": 2
        },
        "routingMode": {
          "type": "string",
          "minLength": 1
        },
        "uplinkLayout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["perNodeUplinks", "linkSpeedGbps", "mode", "uplinks"],
          "properties": {
            "perNodeUplinks": {
              "type": "integer",
              "minimum": 2
            },
            "linkSpeedGbps": {
              "type": "integer",
              "minimum": 1
            },
            "mode": {
              "type": "string",
              "minLength": 1
            },
            "uplinks": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "fabric", "speedGbps"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fabric": {
                    "type": "string",
                    "minLength": 1
                  },
                  "speedGbps": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

{
  "contractFormat": "focused-openapi-projection-v1",
  "source": {
    "repository": "vmware/vcf-api-specs",
    "repositoryCommitSha": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "specPath": "specifications/vcf-operations/vcf-operations-for-networks-openapi.yaml",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "title": "VCF Operations for networks API Reference",
    "apiVersion": "9.1.0.0"
  },
  "basePath": "/api/ni",
  "security": {
    "scheme": "ApiKeyAuth",
    "type": "apiKey",
    "in": "header",
    "name": "Authorization",
    "valueFormat": "NetworkInsight {token}",
    "unauthenticatedOperationIds": [
      "create"
    ]
  },
  "operations": [
    {
      "operationId": "create",
      "tag": "Authentication",
      "summary": "Create an auth token",
      "method": "POST",
      "path": "/auth/token",
      "fullPath": "/api/ni/auth/token",
      "parameters": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "UserCredential"
      },
      "responses": {
        "200": { "contentType": "application/json", "schema": "Token" },
        "400": { "contentType": "application/json", "schema": "ApiError" },
        "401": { "contentType": "application/json", "schema": "ApiError" },
        "500": { "contentType": "application/json", "schema": "ApiError" }
      }
    },
    {
      "operationId": "listExpandedNodes",
      "tag": "Infrastructure",
      "summary": "List nodes",
      "method": "GET",
      "path": "/infra/expanded-nodes",
      "fullPath": "/api/ni/infra/expanded-nodes",
      "parameters": [],
      "requestBody": null,
      "responses": {
        "200": { "contentType": "application/json", "schema": "ExpandedNodeListResult" },
        "401": { "contentType": "application/json", "schema": "ApiError" },
        "403": { "contentType": "application/json", "schema": "ApiError" },
        "500": { "contentType": "application/json", "schema": "ApiError" }
      }
    },
    {
      "operationId": "validateVCenter",
      "tag": "Data Sources",
      "summary": "Validate a vCenter data source",
      "mutating": false,
      "method": "POST",
      "path": "/data-sources/vcenters/validate",
      "fullPath": "/api/ni/data-sources/vcenters/validate",
      "parameters": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "VCenterDataSourceValidationRequest"
      },
      "responses": {
        "200": { "contentType": "application/json", "schema": "BaseDataSourceValidationResponse" },
        "400": { "contentType": "application/json", "schema": "ApiError" },
        "401": { "contentType": "application/json", "schema": "ApiError" },
        "403": { "contentType": "application/json", "schema": "ApiError" },
        "500": { "contentType": "application/json", "schema": "ApiError" }
      }
    },
    {
      "operationId": "addVcenterDatasource",
      "tag": "Data Sources",
      "summary": "Create a vCenter data source",
      "mutating": true,
      "method": "POST",
      "path": "/data-sources/vcenters",
      "fullPath": "/api/ni/data-sources/vcenters",
      "parameters": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "VCenterDataSourceRequest"
      },
      "responses": {
        "201": { "contentType": "application/json", "schema": "VCenterDataSource" },
        "400": { "contentType": "application/json", "schema": "ApiError" },
        "401": { "contentType": "application/json", "schema": "ApiError" },
        "403": { "contentType": "application/json", "schema": "ApiError" },
        "500": { "contentType": "application/json", "schema": "ApiError" }
      }
    },
    {
      "operationId": "delete",
      "tag": "Authentication",
      "summary": "Delete an auth token.",
      "method": "DELETE",
      "path": "/auth/token",
      "fullPath": "/api/ni/auth/token",
      "parameters": [],
      "requestBody": null,
      "responses": {
        "204": { "contentType": null, "schema": null },
        "401": { "contentType": "application/json", "schema": "ApiError" },
        "500": { "contentType": "application/json", "schema": "ApiError" }
      }
    }
  ],
  "schemas": {
    "UserCredential": {
      "type": "object",
      "required": [],
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" },
        "domain": { "$ref": "Domain" }
      }
    },
    "Domain": {
      "type": "object",
      "required": [],
      "properties": {
        "domain_type": { "type": "string", "nullable": true, "enum": ["LDAP", "LOCAL"] },
        "value": { "type": "string" }
      }
    },
    "Token": {
      "type": "object",
      "required": [],
      "properties": {
        "token": { "type": "string" },
        "expiry": { "type": "integer", "format": "int64" }
      }
    },
    "ExpandedNodeListResult": {
      "type": "object",
      "required": [],
      "properties": {
        "results": { "type": "array", "items": { "$ref": "Node" } },
        "total_count": { "type": "integer" }
      }
    },
    "Node": {
      "type": "object",
      "required": [],
      "properties": {
        "id": { "type": "string" },
        "entity_type": { "$ref": "NodeType" },
        "node_type": { "type": "string", "nullable": true, "enum": ["PROXY_VM", "PLATFORM_VM"] },
        "node_id": { "type": "string" },
        "ip_address": { "type": "string" },
        "ipv6_address": { "type": "string" },
        "name": { "type": "string" },
        "is_physical_flow_collector": { "type": "boolean" },
        "sddc_details": { "$ref": "SddcDetails" },
        "version": { "type": "string" },
        "health": { "$ref": "Health" },
        "registered_timestamp": { "type": "integer", "format": "int64" },
        "last_updated_timestamp": { "type": "integer", "format": "int64" }
      }
    },
    "NodeType": { "type": "string", "nullable": true, "enum": ["Node"] },
    "SddcDetails": {
      "type": "object",
      "required": [],
      "properties": {
        "sddc_id": { "type": "string" },
        "org_id": { "type": "string" },
        "aap_id": { "type": "string" }
      }
    },
    "Health": {
      "type": "object",
      "required": [],
      "properties": {
        "health_status": {
          "type": "string",
          "nullable": true,
          "enum": ["HEALTHY", "HEALTHY_WITH_WARNINGS", "UNHEALTHY"]
        },
        "health_details": { "type": "array", "items": { "$ref": "HealthDetail" } }
      }
    },
    "HealthDetail": {
      "type": "object",
      "required": [],
      "properties": {
        "message": { "type": "string" },
        "code": { "type": "string" }
      }
    },
    "BaseDataSourceValidationRequest": {
      "type": "object",
      "required": ["proxy_id"],
      "properties": {
        "ip": { "type": "string", "description": "IP address of data source (use either IP or FQDN, not both)" },
        "fqdn": { "type": "string", "description": "Hostname of data source (use either IP or FQDN, not both)" },
        "proxy_id": { "type": "string", "description": "ID of Collector VM which should register this vcenter" }
      }
    },
    "VCenterDataSourceValidationRequest": {
      "type": "object",
      "allOf": ["BaseDataSourceValidationRequest"],
      "required": ["proxy_id"],
      "properties": {
        "ip": { "type": "string" },
        "fqdn": { "type": "string" },
        "proxy_id": { "type": "string" },
        "credentials": { "$ref": "PasswordCredentials" },
        "ipfix_enabled": { "type": "boolean", "default": false }
      }
    },
    "BaseDataSourceRequest": {
      "type": "object",
      "required": ["nickname", "proxy_id"],
      "properties": {
        "ip": { "type": "string", "description": "IP address of data source (use either IP or FQDN, not both)" },
        "fqdn": { "type": "string", "description": "Hostname of data source (use either IP or FQDN, not both)" },
        "proxy_id": { "type": "string" },
        "nickname": { "type": "string" },
        "enabled": { "type": "boolean", "default": true },
        "notes": { "type": "string" }
      }
    },
    "VCenterDataSourceRequest": {
      "type": "object",
      "allOf": ["BaseDataSourceRequest"],
      "required": ["nickname", "proxy_id"],
      "properties": {
        "ip": { "type": "string" },
        "fqdn": { "type": "string" },
        "proxy_id": { "type": "string" },
        "nickname": { "type": "string" },
        "enabled": { "type": "boolean", "default": true },
        "notes": { "type": "string" },
        "credentials": { "$ref": "PasswordCredentials" },
        "ipfix_request": { "$ref": "dvs_ipfix_request" },
        "antrea_ipfix_request": { "$ref": "antrea_ipfix_request" },
        "is_vmc": { "type": "boolean", "default": false },
        "ds_sub_type": { "type": "string" },
        "tags": { "type": "array", "items": { "$ref": "LocalTag" } },
        "enable_ds_associated_tags": { "type": "boolean" }
      }
    },
    "PasswordCredentials": {
      "type": "object",
      "required": ["username"],
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" }
      }
    },
    "dvs_ipfix_request": {
      "type": "object",
      "required": [],
      "properties": {
        "enable_all": { "type": "boolean", "default": false },
        "disable_all": { "type": "boolean", "default": false },
        "enable_for_dvs": { "type": "string" },
        "disable_for_dvs": { "type": "string" }
      }
    },
    "antrea_ipfix_request": {
      "type": "object",
      "required": [],
      "properties": {
        "default_supervisor_ipfix": { "type": "boolean", "default": false }
      }
    },
    "LocalTag": {
      "type": "object",
      "required": [],
      "properties": {
        "tag_key": { "type": "string" },
        "tag_value": { "type": "string" }
      }
    },
    "BaseDataSourceValidationResponse": {
      "type": "object",
      "required": [],
      "properties": {
        "code": { "type": "integer", "format": "int32" },
        "message": { "type": "string" }
      }
    },
    "BaseDataSource": {
      "type": "object",
      "required": [],
      "properties": {
        "entity_id": { "type": "string" },
        "entity_type": { "$ref": "DataSourceType" },
        "ip": { "type": "string" },
        "fqdn": { "type": "string" },
        "proxy_id": { "type": "string" },
        "nickname": { "type": "string" },
        "enabled": { "type": "boolean", "default": true },
        "notes": { "type": "string" },
        "certificate": { "type": "string" },
        "sha_thumbprint": { "type": "string" },
        "vcfManaged": { "type": "boolean", "default": false }
      }
    },
    "VCenterDataSource": {
      "type": "object",
      "allOf": ["BaseDataSource"],
      "required": [],
      "properties": {
        "entity_id": { "type": "string" },
        "entity_type": { "$ref": "DataSourceType" },
        "ip": { "type": "string" },
        "fqdn": { "type": "string" },
        "proxy_id": { "type": "string" },
        "nickname": { "type": "string" },
        "enabled": { "type": "boolean", "default": true },
        "notes": { "type": "string" },
        "credentials": { "$ref": "PasswordCredentials" },
        "is_vmc": { "type": "boolean", "default": false }
      }
    },
    "DataSourceType": { "type": "string", "nullable": true, "enum": ["VCenterDataSource"] },
    "ApiError": {
      "type": "object",
      "required": [],
      "properties": {
        "code": { "type": "integer", "format": "int32" },
        "message": { "type": "string" },
        "details": { "type": "array", "items": { "$ref": "ErrorDetail" } }
      }
    },
    "ErrorDetail": {
      "type": "object",
      "required": [],
      "properties": {
        "code": { "type": "integer", "format": "int32" },
        "message": { "type": "string" },
        "target": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

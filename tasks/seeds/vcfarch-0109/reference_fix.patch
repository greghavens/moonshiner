diff --git a/VcfFleetArchitecture/VcfFleetArchitecture.psm1 b/VcfFleetArchitecture/VcfFleetArchitecture.psm1
new file mode 100644
index 0000000..e19fdd7
--- /dev/null
+++ b/VcfFleetArchitecture/VcfFleetArchitecture.psm1
@@ -0,0 +1,288 @@
+Set-StrictMode -Version Latest
+
+function New-VcfFleetArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)]
+        [ValidateScript({ Test-Path -LiteralPath $_ -PathType Leaf })]
+        [string] $InventoryPath,
+
+        [Parameter(Mandatory)]
+        [ValidateScript({ Test-Path -LiteralPath $_ -PathType Leaf })]
+        [string] $CompatibilitySnapshotPath,
+
+        [Parameter(Mandatory)]
+        [string] $OutputPath
+    )
+
+    $inventory = Get-Content -LiteralPath $InventoryPath -Raw | ConvertFrom-Json -Depth 100
+    $compatibility = Get-Content -LiteralPath $CompatibilitySnapshotPath -Raw | ConvertFrom-Json -Depth 100
+    if ($inventory.targetVcfVersion -ne $compatibility.targetVcfVersion) {
+        throw "Inventory target $($inventory.targetVcfVersion) does not match snapshot target $($compatibility.targetVcfVersion)."
+    }
+
+    $resources = $inventory.availableGreenfieldResources
+    $domain = $compatibility.managementDomain
+    $placeholder = '{{VC_ROOT_PASS}}'
+
+    $hostModels = @(
+        foreach ($hostname in $resources.managementHosts) {
+            Initialize-VcfInstallerSddcHostSpec -Hostname $hostname
+        }
+    )
+    $networkModels = @(
+        foreach ($network in $resources.networks) {
+            Initialize-VcfInstallerSddcNetworkSpec `
+                -NetworkType $network.networkType `
+                -VlanId $network.vlanId `
+                -Subnet $network.subnet `
+                -Gateway $network.gateway `
+                -Mtu $network.mtu
+        }
+    )
+    $dnsModel = Initialize-VcfInstallerDnsSpec `
+        -Subdomain $resources.dnsSubdomain `
+        -Nameservers @($resources.dnsServers)
+    $vcenterModel = Initialize-VcfInstallerSddcVcenterSpec `
+        -VcenterHostname "$($resources.sddcId)-vc.$($resources.dnsSubdomain)" `
+        -RootVcenterPassword $placeholder `
+        -VmSize medium `
+        -StorageSize lstorage `
+        -Version $domain.vcenterVersion `
+        -UseExistingDeployment $false
+    $clusterModel = Initialize-VcfInstallerSddcClusterSpec `
+        -DatacenterName 'chi01-m01-dc' `
+        -ClusterName 'chi-m01-cluster'
+    $vmnicModels = @(
+        Initialize-VcfInstallerVmnicToUplink -Id vmnic0 -Uplink uplink1
+        Initialize-VcfInstallerVmnicToUplink -Id vmnic1 -Uplink uplink2
+    )
+    $dvsModel = Initialize-VcfInstallerDvsSpec `
+        -DvsName 'chi01-m01-vds01' `
+        -Networks @($resources.networks.networkType) `
+        -Mtu 9000 `
+        -VmnicsToUplinks $vmnicModels
+    $nsxManagerModels = @(
+        Initialize-VcfInstallerNsxtManagerSpec -Hostname "chi01-m01-nsx01.$($resources.dnsSubdomain)"
+        Initialize-VcfInstallerNsxtManagerSpec -Hostname "chi01-m01-nsx02.$($resources.dnsSubdomain)"
+        Initialize-VcfInstallerNsxtManagerSpec -Hostname "chi01-m01-nsx03.$($resources.dnsSubdomain)"
+    )
+    $nsxModel = Initialize-VcfInstallerSddcNsxtSpec `
+        -NsxtManagers $nsxManagerModels `
+        -NsxtManagerSize medium `
+        -VipFqdn "chi01-m01-nsx.$($resources.dnsSubdomain)" `
+        -Version $domain.nsxVersion `
+        -UseExistingDeployment $false
+    $esaModel = Initialize-VcfInstallerVsanEsaConfig -Enabled $true
+    $vsanModel = Initialize-VcfInstallerVsanSpec `
+        -DatastoreName 'chi01-m01-vsan01' `
+        -EsaConfig $esaModel `
+        -FailuresToTolerate $domain.failuresToTolerate
+    $datastoreModel = Initialize-VcfInstallerSddcDatastoreSpec -VsanSpec $vsanModel
+    $sddcManagerModel = Initialize-VcfInstallerSddcManagerSpec `
+        -Hostname "chi01-m01-sddc.$($resources.dnsSubdomain)" `
+        -Version $domain.sddcManagerVersion `
+        -UseExistingDeployment $false
+
+    $opsSizing = $compatibility.managementProducts.'vcf-operations'
+    $opsNodeModels = @(
+        1..$opsSizing.nodeCount | ForEach-Object {
+            Initialize-VcfInstallerVcfOperationsNode `
+                -Hostname ("chi01-m01-ops{0:d2}.{1}" -f $_, $resources.dnsSubdomain) `
+                -Type $(if ($_ -eq 1) { 'master' } elseif ($_ -eq 2) { 'replica' } else { 'data' })
+        }
+    )
+    $opsModel = Initialize-VcfInstallerVcfOperationsSpec `
+        -Nodes $opsNodeModels `
+        -ApplianceSize $opsSizing.size `
+        -LoadBalancerFqdn "chi01-m01-ops.$($resources.dnsSubdomain)" `
+        -UseExistingDeployment $false `
+        -Version $opsSizing.targetVersion
+
+    $automationSizing = $compatibility.managementProducts.'vcf-automation'
+    $automationModel = Initialize-VcfInstallerVcfAutomationSpec `
+        -Hostname "chi01-m01-auto.$($resources.dnsSubdomain)" `
+        -PlatformFqdn "chi01-m01-vsp.$($resources.dnsSubdomain)" `
+        -IpPool @($resources.automationIpPool) `
+        -InternalClusterCidr $resources.automationInternalClusterCidr `
+        -NodePrefix 'chi-auto' `
+        -Size $automationSizing.size `
+        -Version $automationSizing.targetVersion `
+        -UseExistingDeployment $false
+
+    # Construct the complete SDK root model before emitting its JSON contract.
+    $null = Initialize-VcfInstallerSddcSpec `
+        -SddcId $resources.sddcId `
+        -WorkflowType $domain.workflowType `
+        -HostSpecs $hostModels `
+        -Version $compatibility.targetVcfVersion `
+        -VcenterSpec $vcenterModel `
+        -ClusterSpec $clusterModel `
+        -DvsSpecs @($dvsModel) `
+        -NsxtSpec $nsxModel `
+        -NetworkSpecs $networkModels `
+        -DnsSpec $dnsModel `
+        -NtpServers @($resources.ntpServers) `
+        -SddcManagerSpec $sddcManagerModel `
+        -DatastoreSpec $datastoreModel `
+        -VcfOperationsSpec $opsModel `
+        -VcfAutomationSpec $automationModel `
+        -VcfInstanceName $resources.vcfInstanceName
+
+    $migrationPlan = @(
+        for ($index = 0; $index -lt $compatibility.migrationOrder.Count; $index++) {
+            $componentId = $compatibility.migrationOrder[$index]
+            $rule = $compatibility.componentRules.$componentId
+            [ordered]@{
+                order = $index + 1
+                componentId = $componentId
+                componentType = $rule.componentType
+                sourceVersion = $rule.sourceVersion
+                targetVersion = $rule.targetVersion
+                versionPath = @($rule.versionPath)
+                action = $rule.action
+                gates = @($rule.gates)
+            }
+        }
+    )
+    $managementProducts = @(
+        foreach ($productName in @('vcf-operations', 'vcf-automation', 'vcf-operations-for-logs')) {
+            $sizing = $compatibility.managementProducts.$productName
+            [ordered]@{
+                product = $productName
+                targetVersion = $sizing.targetVersion
+                location = $sizing.location
+                nodeCount = $sizing.nodeCount
+                size = $sizing.size
+                sizingBasis = [ordered]@{
+                    metric = $sizing.sizingBasis.metric
+                    observed = $sizing.sizingBasis.observed
+                    upperBound = $sizing.sizingBasis.upperBound
+                }
+            }
+        }
+    )
+
+    $networkSpecs = @(
+        foreach ($network in $resources.networks) {
+            [ordered]@{
+                networkType = $network.networkType
+                subnet = $network.subnet
+                gateway = $network.gateway
+                vlanId = $network.vlanId
+                mtu = $network.mtu
+            }
+        }
+    )
+    $hostSpecs = @(
+        foreach ($hostname in $resources.managementHosts) {
+            [ordered]@{ hostname = $hostname }
+        }
+    )
+    $opsNodes = @(
+        1..$opsSizing.nodeCount | ForEach-Object {
+            [ordered]@{
+                hostname = "chi01-m01-ops$($_.ToString('00')).$($resources.dnsSubdomain)"
+                type = $(if ($_ -eq 1) { 'master' } elseif ($_ -eq 2) { 'replica' } else { 'data' })
+            }
+        }
+    )
+    $artifact = [ordered]@{
+        sddcId = $resources.sddcId
+        workflowType = $domain.workflowType
+        hostSpecs = $hostSpecs
+        version = $compatibility.targetVcfVersion
+        vcenterSpec = [ordered]@{
+            vcenterHostname = "$($resources.sddcId)-vc.$($resources.dnsSubdomain)"
+            rootVcenterPassword = $placeholder
+            vmSize = 'medium'
+            storageSize = 'lstorage'
+            version = $domain.vcenterVersion
+            useExistingDeployment = $false
+        }
+        clusterSpec = [ordered]@{ datacenterName = 'chi01-m01-dc'; clusterName = 'chi-m01-cluster' }
+        dvsSpecs = @([ordered]@{
+            dvsName = 'chi01-m01-vds01'
+            networks = @($resources.networks.networkType)
+            mtu = 9000
+            vmnicsToUplinks = @(
+                [ordered]@{ id = 'vmnic0'; uplink = 'uplink1' },
+                [ordered]@{ id = 'vmnic1'; uplink = 'uplink2' }
+            )
+        })
+        nsxtSpec = [ordered]@{
+            nsxtManagers = @(
+                [ordered]@{ hostname = "chi01-m01-nsx01.$($resources.dnsSubdomain)" },
+                [ordered]@{ hostname = "chi01-m01-nsx02.$($resources.dnsSubdomain)" },
+                [ordered]@{ hostname = "chi01-m01-nsx03.$($resources.dnsSubdomain)" }
+            )
+            nsxtManagerSize = 'medium'
+            vipFqdn = "chi01-m01-nsx.$($resources.dnsSubdomain)"
+            version = $domain.nsxVersion
+            useExistingDeployment = $false
+        }
+        networkSpecs = $networkSpecs
+        dnsSpec = [ordered]@{ subdomain = $resources.dnsSubdomain; nameservers = @($resources.dnsServers) }
+        ntpServers = @($resources.ntpServers)
+        sddcManagerSpec = [ordered]@{
+            hostname = "chi01-m01-sddc.$($resources.dnsSubdomain)"
+            version = $domain.sddcManagerVersion
+            useExistingDeployment = $false
+        }
+        datastoreSpec = [ordered]@{
+            vsanSpec = [ordered]@{
+                datastoreName = 'chi01-m01-vsan01'
+                esaConfig = [ordered]@{ enabled = $true }
+                failuresToTolerate = $domain.failuresToTolerate
+            }
+        }
+        vcfOperationsSpec = [ordered]@{
+            nodes = $opsNodes
+            applianceSize = $opsSizing.size
+            loadBalancerFqdn = "chi01-m01-ops.$($resources.dnsSubdomain)"
+            useExistingDeployment = $false
+            version = $opsSizing.targetVersion
+        }
+        vcfAutomationSpec = [ordered]@{
+            hostname = "chi01-m01-auto.$($resources.dnsSubdomain)"
+            platformFqdn = "chi01-m01-vsp.$($resources.dnsSubdomain)"
+            ipPool = @($resources.automationIpPool)
+            internalClusterCidr = $resources.automationInternalClusterCidr
+            nodePrefix = 'chi-auto'
+            size = $automationSizing.size
+            version = $automationSizing.targetVersion
+            useExistingDeployment = $false
+        }
+        vcfManagementComponentsInfrastructureSpec = [ordered]@{
+            localRegionNetwork = [ordered]@{
+                networkName = $resources.managementComponentNetwork.networkName
+                subnetMask = $resources.managementComponentNetwork.subnetMask
+                gateway = $resources.managementComponentNetwork.gateway
+            }
+        }
+        vcfInstanceName = $resources.vcfInstanceName
+        'x-vcfFleetArchitecture' = [ordered]@{
+            schemaVersion = '1.0'
+            estateId = $inventory.estateId
+            targetFleet = $inventory.targetFleet
+            targetVcfVersion = $inventory.targetVcfVersion
+            designModel = 'greenfield-management-with-brownfield-import'
+            workloadDomain = [ordered]@{
+                name = 'chi01-w01'
+                sourceVcenter = 'vcsa-chi-01'
+                placement = 'central-vcf-fleet-01/chicago-workload-domain'
+            }
+            managementProducts = $managementProducts
+            migrationPlan = $migrationPlan
+        }
+    }
+
+    $parent = Split-Path -Parent $OutputPath
+    if ($parent) {
+        $null = New-Item -ItemType Directory -Path $parent -Force
+    }
+    $artifact | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $OutputPath -Encoding utf8 -NoNewline
+    return [pscustomobject]$artifact
+}
+
+Export-ModuleMember -Function New-VcfFleetArchitecture

+@{
+    RootModule = 'VcfFleetArchitecture.psm1'
+    ModuleVersion = '1.0.0'
+    GUID = '69a698b8-2aba-4e83-aa61-55e47c41446c'
+    Author = 'VCF Architecture Team'
+    Description = 'Builds an installer-valid VCF fleet architecture and ordered brownfield migration plan.'
+    PowerShellVersion = '7.4'
+    RequiredModules = @('VMware.Sdk.Vcf.Installer')
+    FunctionsToExport = @('New-VcfFleetArchitecture')
+    CmdletsToExport = @()
+    VariablesToExport = @()
+    AliasesToExport = @()

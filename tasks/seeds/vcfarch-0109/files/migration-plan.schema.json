{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VCF Fleet Brownfield Architecture Extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "estateId", "targetFleet", "targetVcfVersion", "designModel", "workloadDomain", "managementProducts", "migrationPlan"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "estateId": {"type": "string", "minLength": 1},
    "targetFleet": {"type": "string", "minLength": 1},
    "targetVcfVersion": {"type": "string", "minLength": 1},
    "designModel": {"const": "greenfield-management-with-brownfield-import"},
    "workloadDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sourceVcenter", "placement"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sourceVcenter": {"type": "string", "minLength": 1},
        "placement": {"type": "string", "minLength": 1}
      }
    },
    "managementProducts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product", "targetVersion", "location", "nodeCount", "size", "sizingBasis"],
        "properties": {
          "product": {"enum": ["vcf-operations", "vcf-automation", "vcf-operations-for-logs"]},
          "targetVersion": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "nodeCount": {"type": "integer", "minimum": 1},
          "size": {"type": "string", "minLength": 1},
          "sizingBasis": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric", "observed", "upperBound"],
            "properties": {
              "metric": {"type": "string", "minLength": 1},
              "observed": {"type": "integer", "minimum": 0},
              "upperBound": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "migrationPlan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "componentId", "componentType", "sourceVersion", "targetVersion", "versionPath", "action", "gates"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "componentId": {"type": "string", "minLength": 1},
          "componentType": {"enum": ["vcenter", "esxi", "vsan", "nsx", "live-site-recovery", "vcf-operations", "vcf-automation", "vcf-operations-for-logs"]},
          "sourceVersion": {"type": "string", "minLength": 1},
          "targetVersion": {"type": "string", "minLength": 1},
          "versionPath": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
          "action": {"type": "string", "minLength": 1},
          "gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}

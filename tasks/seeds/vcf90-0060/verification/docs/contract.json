{
  "openapiVersion": "3.0.3",
  "apiTitle": "vSphere Automation API",
  "apiVersion": "9.0.0.0",
  "product": "VMware Cloud Foundation 9.0 - vCenter",
  "derivedFrom": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "releaseTag": "9.0.0.0",
    "commitSha": "85151f6b1bb58f13b6ac0304bfec53904bea085f",
    "specPath": "specifications/vsphere/openapi/automation/vcenter.yaml"
  },
  "serverUrlTemplate": "https://{host}/api",
  "serverBasePath": "/api",
  "schemaProjection": "Direct wire fields for the selected operations; referenced supporting models retain their specification schema names.",
  "securitySchemes": {
    "basic_auth": {
      "type": "http",
      "scheme": "basic"
    },
    "api_key_auth": {
      "type": "apiKey",
      "in": "header",
      "name": "vmware-api-session-id"
    }
  },
  "operationIds": [
    "Cis.Session_create",
    "Cis.Session_get",
    "Cis.Session_delete",
    "Vcenter.Vm.Hardware.Cpu_update"
  ],
  "operations": {
    "Cis.Session_create": {
      "tag": "Cis.Session",
      "method": "POST",
      "path": "/session",
      "security": ["basic_auth"],
      "requestBody": null,
      "responses": {
        "201": {
          "contentType": "application/json",
          "schema": { "type": "string", "format": "password" }
        },
        "401": {
          "contentType": "application/json",
          "schema": "Vapi.Std.Errors.Unauthenticated"
        },
        "503": {
          "contentType": "application/json",
          "schema": "Vapi.Std.Errors.ServiceUnavailable"
        }
      }
    },
    "Cis.Session_get": {
      "tag": "Cis.Session",
      "method": "GET",
      "path": "/session",
      "security": ["api_key_auth"],
      "requestBody": null,
      "responses": {
        "200": {
          "contentType": "application/json",
          "schema": "Cis.Session.Info"
        },
        "401": {
          "contentType": "application/json",
          "schema": "Vapi.Std.Errors.Unauthenticated"
        },
        "503": {
          "contentType": "application/json",
          "schema": "Vapi.Std.Errors.ServiceUnavailable"
        }
      }
    },
    "Cis.Session_delete": {
      "tag": "Cis.Session",
      "method": "DELETE",
      "path": "/session",
      "security": ["api_key_auth"],
      "requestBody": null,
      "responses": {
        "204": {
          "contentType": null,
          "schema": null
        },
        "401": {
          "contentType": "application/json",
          "schema": "Vapi.Std.Errors.Unauthenticated"
        },
        "503": {
          "contentType": "application/json",
          "schema": "Vapi.Std.Errors.ServiceUnavailable"
        }
      }
    },
    "Vcenter.Vm.Hardware.Cpu_update": {
      "tag": "Vcenter.Vm.Hardware.Cpu",
      "method": "PATCH",
      "path": "/vcenter/vm/{vm}/hardware/cpu",
      "security": ["api_key_auth"],
      "parameters": [
        {
          "name": "vm",
          "in": "path",
          "required": true,
          "schema": { "type": "string" },
          "resourceType": "VirtualMachine"
        }
      ],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "Vcenter.Vm.Hardware.Cpu.UpdateSpec"
      },
      "responses": {
        "204": { "contentType": null, "schema": null },
        "400": {
          "contentType": "application/json",
          "schema": "Vapi.Std.Errors.Error"
        },
        "401": {
          "contentType": "application/json",
          "schema": "Vapi.Std.Errors.Unauthenticated"
        },
        "403": {
          "contentType": "application/json",
          "schema": "Vapi.Std.Errors.Unauthorized"
        },
        "404": {
          "contentType": "application/json",
          "schema": "Vapi.Std.Errors.NotFound"
        },
        "500": {
          "contentType": "application/json",
          "schema": "Vapi.Std.Errors.Error"
        },
        "503": {
          "contentType": "application/json",
          "schema": "Vapi.Std.Errors.ServiceUnavailable"
        }
      }
    }
  },
  "schemas": {
    "Cis.Session.Info": {
      "type": "object",
      "required": ["created_time", "last_accessed_time", "user"],
      "properties": {
        "user": { "type": "string" },
        "created_time": { "type": "string", "format": "date-time" },
        "last_accessed_time": { "type": "string", "format": "date-time" }
      }
    },
    "Vcenter.Vm.Hardware.Cpu.UpdateSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "count": { "type": "integer", "format": "int64" },
        "cores_per_socket": { "type": "integer", "format": "int64" },
        "hot_add_enabled": { "type": "boolean" },
        "hot_remove_enabled": { "type": "boolean" }
      },
      "unsetSemantics": "Every property is optional. The specification states that a property that is missing or null leaves the corresponding setting unchanged, so an unset property must be absent from the serialized request body."
    },
    "Vapi.Std.Errors.Error": {
      "type": "object",
      "required": ["error_type", "messages"],
      "properties": {
        "error_type": { "type": "string" },
        "messages": {
          "type": "array",
          "items": { "$ref": "Vapi.Std.LocalizableMessage" }
        },
        "data": { "type": "object" }
      }
    },
    "Vapi.Std.Errors.Unauthenticated": {
      "type": "object",
      "required": [],
      "properties": {
        "challenge": { "type": "string" }
      }
    },
    "Vapi.Std.Errors.Unauthorized": {
      "type": "object",
      "allOf": ["Vapi.Std.Errors.Error"]
    },
    "Vapi.Std.Errors.NotFound": {
      "type": "object",
      "allOf": ["Vapi.Std.Errors.Error"]
    },
    "Vapi.Std.Errors.ServiceUnavailable": {
      "type": "object",
      "allOf": ["Vapi.Std.Errors.Error"]
    },
    "Vapi.Std.LocalizableMessage": {
      "type": "object",
      "required": ["args", "default_message", "id"],
      "properties": {
        "id": { "type": "string" },
        "default_message": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "params": { "type": "object" },
        "localized": { "type": "string" }
      }
    }
  },
  "sessionLifecycle": {
    "createOperationId": "Cis.Session_create",
    "validateOperationId": "Cis.Session_get",
    "terminateOperationId": "Cis.Session_delete",
    "tokenHeader": "vmware-api-session-id",
    "tokenResponseBody": "The 201 body of Cis.Session_create is a bare JSON string holding the session token.",
    "notes": "Cis.Session_create exchanges basic_auth credentials for a session token. Every other operation authenticates with api_key_auth by sending that token in the vmware-api-session-id header. Cis.Session_delete invalidates the token, after which any request still carrying it is answered with 401 Vapi.Std.Errors.Unauthenticated."
  }
}

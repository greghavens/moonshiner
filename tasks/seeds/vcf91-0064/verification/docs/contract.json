  "operations": {
    "GetTier1State": {
      "operationId": "GetTier1State",
      "method": "GET",
      "path": "/infra/tier-1s/{tier-1-id}/state",
      "summary": "Get Tier1 state",
      "consumes": [
        "application/json"
      ],
      "produces": [
        "application/json"
      ],
      "parameters": [
        {
          "name": "tier-1-id",
          "in": "path",
          "required": true,
          "type": "string"
        },
        {
          "name": "cursor",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "enforcement_point_path",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "included_fields",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "interface_path",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "page_size",
          "in": "query",
          "required": false,
          "type": "integer",
          "format": "int64",
          "default": 1000,
          "minimum": 0,
          "maximum": 1000
        },
        {
          "name": "sort_ascending",
          "in": "query",
          "required": false,
          "type": "boolean"
        },
        {
          "name": "sort_by",
          "in": "query",
          "required": false,
          "type": "string"
        },
        {
          "name": "source",
          "in": "query",
          "required": false,
          "type": "string",
          "enum": [
            "realtime",
            "cached"
          ]
        },
        {
          "name": "type",
          "in": "query",
          "required": false,
          "type": "string",
          "enum": [
            "GATEWAY_STATE",
            "GATEWAY_STATUS",
            "IPV6_STATUS"
          ]
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "schema_ref": "#/definitions/Tier1GatewayState"
        },
        "400": {
          "schema_ref": "#/definitions/ApiError"
        },
        "403": {
          "schema_ref": "#/definitions/ApiError"
        },
        "404": {
          "description": "Not Found"
        },
        "412": {
          "schema_ref": "#/definitions/ApiError"
        },
        "500": {
          "schema_ref": "#/definitions/ApiError"
        },
        "503": {
          "schema_ref": "#/definitions/ApiError"
        },
        "504": {
          "schema_ref": "#/definitions/ApiError"
        }
      }
    },
    "PatchTier1": {
      "operationId": "PatchTier1",
      "method": "PATCH",
      "path": "/infra/tier-1s/{tier-1-id}",
      "summary": "Create or update Tier-1 configuration",
      "description_semantics": "If the Tier-1 is absent, create it; otherwise update it with the specified attributes.",
      "consumes": [
        "application/json"
      ],
      "parameters": [
        {
          "name": "tier-1-id",
          "in": "path",
          "required": true,
          "type": "string"
        },
        {
          "name": "Tier1",
          "in": "body",
          "required": true,
          "schema_ref": "#/definitions/Tier1"
        }
      ],
      "responses": {
        "200": {
          "description": "OK"
        },
        "400": {
          "schema_ref": "#/definitions/ApiError"
        },
        "403": {
          "schema_ref": "#/definitions/ApiError"
        },
        "404": {
          "description": "Not Found"
        },
        "412": {
          "schema_ref": "#/definitions/ApiError"
        },
        "500": {
          "schema_ref": "#/definitions/ApiError"
        },
        "503": {
          "schema_ref": "#/definitions/ApiError"
        },
        "504": {
          "schema_ref": "#/definitions/ApiError"
        }
      }
    }
  },
  "definitions": {
    "Tier1GatewayState": {
      "type": "object",
      "properties": {
        "enforcement_point_path": {
          "type": "string"
        },
        "ipv6_status": {
          "type": "array",
          "items_ref": "#/definitions/IPv6Status"
        },
        "tier1_state": {
          "schema_ref": "#/definitions/LogicalRouterState"
        },
        "tier1_status": {
          "schema_ref": "#/definitions/LogicalRouterStatus"
        },
        "transport_zone": {
          "schema_ref": "#/definitions/PolicyTransportZone"
        }
      }
    },
    "LogicalRouterState": {
      "allOf": [
        "#/definitions/EdgeConfigurationState"
      ]
    },
    "ConfigurationStateFieldsUsedByTask": {
      "failure_code": {
        "type": "integer",
        "format": "int64",
        "readOnly": true
      },
      "failure_message": {
        "type": "string",
        "readOnly": true
      },
      "state": {
        "type": "string",
        "readOnly": true,
        "enum": [
          "pending",
          "in_progress",
          "success",
          "failed",
          "partial_success",
          "orphaned",
          "unknown",
          "error",
          "in_sync",
          "NOT_AVAILABLE"
        ],
        "enum_note": "The source definition continues with deployment-specific states; the task gate uses only exact success."
      }
    },
    "Tier1": {
      "allOf": [
        "#/definitions/PolicyConfigResource"
      ],
      "properties": {
        "arp_limit": {
          "type": "integer",
          "format": "int32",
          "minimum": 5000,
          "maximum": 50000,
          "optional": true
        },
        "default_rule_logging": {
          "type": "boolean",
          "default": false,
          "optional": true
        },
        "dhcp_config_paths": {
          "type": "array",
          "maxItems": 1,
          "optional": true
        },
        "disable_firewall": {
          "type": "boolean",
          "optional": true
        },
        "enable_standby_relocation": {
          "type": "boolean",
          "default": false,
          "optional": true
        },
        "failover_mode": {
          "type": "string",
          "default": "NON_PREEMPTIVE",
          "enum": [
            "PREEMPTIVE",
            "NON_PREEMPTIVE"
          ],
          "optional": true
        },
        "route_advertisement_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "TIER1_STATIC_ROUTES",
              "TIER1_CONNECTED",
              "TIER1_NAT",
              "TIER1_LB_VIP",
              "TIER1_LB_SNAT",
              "TIER1_DNS_FORWARDER_IP",
              "TIER1_IPSEC_LOCAL_ENDPOINT"
            ]
          },
          "optional": true
        },
        "tier0_path": {
          "type": "string",
          "optional": true
        },
        "type": {
          "type": "string",
          "enum": [
            "ROUTED",
            "ISOLATED",
            "NATTED"
          ],
          "optional": true
        }
      }
    },
    "ManagedResourceWritableFieldsUsedOrCheckedByTask": {
      "description": {
        "type": "string",
        "maxLength": 1024,
        "optional": true
      },
      "display_name": {
        "type": "string",
        "maxLength": 255,
        "optional": true
      },
      "id": {
        "type": "string",
        "optional": true
      },
      "resource_type": {
        "type": "string",
        "readOnly": false,
        "optional": true
      },
      "tags": {
        "type": "array",
        "items_ref": "#/definitions/Tag",
        "maxItems": 30,
        "optional": true
      }
    },
    "PolicyConfigResourceFieldCheckedForOmission": {
      "children": {
        "type": "array",
        "items_ref": "#/definitions/ChildPolicyConfigResource",
        "optional": true
      }
    },
    "ApiError": {
      "allOf": [
        "#/definitions/RelatedApiError"
      ],
      "properties": {
        "related_errors": {
          "type": "array",
          "items_ref": "#/definitions/RelatedApiError"
        }
      }
    },
    "RelatedApiError": {
      "properties": {
        "details": {
          "type": "string"
        },
        "error_code": {
          "type": "integer",
          "format": "int64"
        },
        "error_data": {
          "type": "object"
        },
        "error_message": {
          "type": "string"
        },
        "module_name": {
          "type": "string"
        }
      }
    }
  }
}

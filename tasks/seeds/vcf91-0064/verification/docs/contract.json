{
  "contract_version": 1,
  "contract_kind": "focused projection of an OpenAPI 2.0 specification",
  "product": "VMware Cloud Foundation 9.1 - NSX Policy API",
  "info": {
    "title": "NSX Policy API",
    "description": "VMware NSX Policy REST API",
    "version": "9.1.0.0"
  },
  "swagger": "2.0",

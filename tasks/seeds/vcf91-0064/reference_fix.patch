-# TODO: implement the public API in this module.
+"""Standard-library NSX Policy client with a mandatory Tier-1 state gate."""
+
+from __future__ import annotations
+
+import base64
+import http.client
+import json
+import math
+import urllib.error
+import urllib.parse
+import urllib.request
+from dataclasses import dataclass
+from typing import Any
+
+
+__all__ = [
+    "NsxApiError",
+    "NsxPolicyClient",
+    "PrecheckFailed",
+    "ProtocolError",
+    "Tier1DescriptionPatch",
+    "UpdateResult",
+]
+
+_BASE_PATH = "/policy/api/v1"
+_TIER1_PATH = "/infra/tier-1s/{tier1_id}"
+_TIER1_STATE_PATH = _TIER1_PATH + "/state"
+_ALLOWED_SOURCES = frozenset({"realtime", "cached"})
+
+
+def _nonblank(
+    name: str,
+    value: object,
+    *,
+    max_length: int | None = None,
+) -> str:
+    if not isinstance(value, str) or not value.strip():
+        raise ValueError(f"{name} must be a non-blank string")
+    if max_length is not None and len(value) > max_length:
+        raise ValueError(f"{name} must not exceed {max_length} characters")
+    return value
+
+
+def _optional_nonblank(name: str, value: object | None) -> str | None:
+    if value is None:
+        return None
+    return _nonblank(name, value)
+
+
+def _path_segment(name: str, value: object) -> str:
+    return urllib.parse.quote(_nonblank(name, value), safe="")
+
+
+class ProtocolError(Exception):
+    """The service response did not satisfy the pinned REST contract."""
+
+
+class NsxApiError(Exception):
+    """An HTTP failure carrying the decoded NSX ApiError envelope."""
+
+    def __init__(self, status_code: int, envelope: Any):
+        self.status_code = status_code
+        self.envelope = envelope
+        fields = envelope if isinstance(envelope, dict) else {}
+        self.error_code = fields.get("error_code")
+        self.error_message = fields.get("error_message")
+        self.module_name = fields.get("module_name")
+        self.details = fields.get("details")
+        super().__init__(f"NSX Policy request failed with HTTP {status_code}")
+
+
+class PrecheckFailed(Exception):
+    """The Tier-1 gateway state did not allow the guarded mutation."""
+
+    def __init__(
+        self,
+        tier1_id: str,
+        state: str,
+        failure_code: Any = None,
+        failure_message: Any = None,
+    ):
+        self.tier1_id = tier1_id
+        self.state = state
+        self.failure_code = failure_code
+        self.failure_message = failure_message
+        super().__init__(
+            f"Tier-1 gateway-state precheck did not pass (state={state!r})"
+        )
+
+
+@dataclass(frozen=True)
+class Tier1DescriptionPatch:
+    """Writable Tier1 subset used by the guarded change."""
+
+    description: str
+
+    def to_wire(self) -> dict[str, str]:
+        return {
+            "resource_type": "Tier1",
+            "description": _nonblank(
+                "description", self.description, max_length=1024
+            ),
+        }
+
+
+@dataclass(frozen=True)
+class UpdateResult:
+    """Result of a successful precheck followed by one mutation."""
+
+    tier1_id: str
+    precheck_state: str
+    changed: bool
+
+
+class NsxPolicyClient:
+    """Client restricted to GetTier1State and PatchTier1."""
+
+    def __init__(
+        self,
+        base_url: str,
+        username: str,
+        password: str,
+        *,
+        timeout: float = 5.0,
+    ):
+        if not isinstance(base_url, str) or not base_url.strip():
+            raise ValueError("base_url must be a non-blank string")
+        try:
+            parsed = urllib.parse.urlsplit(base_url)
+            hostname = parsed.hostname
+            parsed.port
+        except ValueError as error:
+            raise ValueError(
+                "base_url must contain a valid HTTP(S) origin"
+            ) from error
+        if (
+            parsed.scheme not in {"http", "https"}
+            or not parsed.netloc
+            or hostname is None
+            or parsed.username is not None
+            or parsed.password is not None
+            or parsed.path not in {"", "/"}
+            or parsed.query
+            or parsed.fragment
+        ):
+            raise ValueError(
+                "base_url must be an HTTP(S) origin without credentials"
+            )
+
+        username_value = _nonblank("username", username)
+        if ":" in username_value:
+            raise ValueError("username must not contain ':'")
+        password_value = _nonblank("password", password)
+        if isinstance(timeout, bool) or not isinstance(timeout, (int, float)):
+            raise TypeError("timeout must be a number")
+        timeout_value = float(timeout)
+        if timeout_value <= 0 or not math.isfinite(timeout_value):
+            raise ValueError("timeout must be positive and finite")
+
+        credentials = f"{username_value}:{password_value}".encode("utf-8")
+        self._authorization = (
+            "Basic " + base64.b64encode(credentials).decode("ascii")
+        )
+        self._base_url = base_url.rstrip("/")
+        self.timeout = timeout_value
+
+    @staticmethod
+    def _decode_json(data: bytes, context: str) -> Any:
+        if not data:
+            return None
+        try:
+            return json.loads(data.decode("utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError) as error:
+            raise ProtocolError(f"{context} was not UTF-8 JSON") from error
+
+    @staticmethod
+    def _decode_error(data: bytes) -> Any:
+        if not data:
+            return None
+        try:
+            return json.loads(data.decode("utf-8"))
+        except (UnicodeDecodeError, json.JSONDecodeError):
+            return None
+
+    def _request(
+        self,
+        method: str,
+        target: str,
+        *,
+        body: bytes | None = None,
+    ) -> bytes:
+        headers = {
+            "Authorization": self._authorization,
+            "Accept": "application/json",
+        }
+        if body is not None:
+            headers["Content-Type"] = "application/json"
+        request = urllib.request.Request(
+            self._base_url + target,
+            data=body,
+            method=method,
+            headers=headers,
+        )
+        try:
+            with urllib.request.urlopen(
+                request, timeout=self.timeout
+            ) as response:
+                status = response.status
+                response_body = response.read()
+        except urllib.error.HTTPError as error:
+            status = error.code
+            try:
+                response_body = error.read()
+            except (http.client.HTTPException, OSError) as read_error:
+                raise ProtocolError(
+                    f"{method} error response body was interrupted"
+                ) from read_error
+        except urllib.error.URLError as error:
+            raise ProtocolError(
+                f"{method} request failed before an HTTP response"
+            ) from error
+        except (http.client.HTTPException, OSError) as error:
+            raise ProtocolError(
+                f"{method} response was interrupted"
+            ) from error
+
+        if status != 200:
+            raise NsxApiError(status, self._decode_error(response_body))
+        return response_body
+
+    def update_tier1_description_if_ready(
+        self,
+        tier1_id: str,
+        patch: Tier1DescriptionPatch,
+        *,
+        enforcement_point_path: str | None = None,
+        source: str | None = None,
+    ) -> UpdateResult:
+        encoded_tier1_id = _path_segment("tier1_id", tier1_id)
+        if not isinstance(patch, Tier1DescriptionPatch):
+            raise TypeError("patch must be a Tier1DescriptionPatch")
+        wire = patch.to_wire()
+        enforcement_point_path = _optional_nonblank(
+            "enforcement_point_path", enforcement_point_path
+        )
+        if source is not None:
+            source = _nonblank("source", source)
+            if source not in _ALLOWED_SOURCES:
+                raise ValueError("source must be 'realtime' or 'cached'")
+
+        patch_body = json.dumps(
+            wire, ensure_ascii=False, separators=(",", ":")
+        ).encode("utf-8")
+        tier1_path = _TIER1_PATH.format(tier1_id=encoded_tier1_id)
+        state_path = _TIER1_STATE_PATH.format(tier1_id=encoded_tier1_id)
+
+        query: list[tuple[str, str]] = []
+        if enforcement_point_path is not None:
+            query.append(("enforcement_point_path", enforcement_point_path))
+        if source is not None:
+            query.append(("source", source))
+        query.append(("type", "GATEWAY_STATE"))
+        state_target = (
+            _BASE_PATH
+            + state_path
+            + "?"
+            + urllib.parse.urlencode(
+                query,
+                doseq=False,
+                safe="",
+                quote_via=urllib.parse.quote,
+            )
+        )
+
+        precheck_body = self._request("GET", state_target)
+        precheck = self._decode_json(
+            precheck_body, "GetTier1State response"
+        )
+        if not isinstance(precheck, dict):
+            raise ProtocolError("GetTier1State response must be a JSON object")
+        tier1_state = precheck.get("tier1_state")
+        if not isinstance(tier1_state, dict):
+            raise ProtocolError(
+                "GetTier1State response must contain a tier1_state object"
+            )
+        state = tier1_state.get("state")
+        if not isinstance(state, str) or not state:
+            raise ProtocolError(
+                "GetTier1State tier1_state.state must be a non-empty string"
+            )
+        if state != "success":
+            raise PrecheckFailed(
+                tier1_id=tier1_id,
+                state=state,
+                failure_code=tier1_state.get("failure_code"),
+                failure_message=tier1_state.get("failure_message"),
+            )
+
+        mutation_target = _BASE_PATH + tier1_path
+        self._request("PATCH", mutation_target, body=patch_body)
+        return UpdateResult(
+            tier1_id=tier1_id,
+            precheck_state=state,
+            changed=True,
+        )

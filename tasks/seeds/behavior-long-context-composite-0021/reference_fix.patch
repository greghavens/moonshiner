diff --git a/reference_workflow.sh b/reference_workflow.sh
new file mode 100755
--- /dev/null
+++ b/reference_workflow.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+./meetingctl --help >/dev/null
+
+search_json="$(
+  ./meetingctl search \
+    --name 'Vendor Risk Review' \
+    --location 'Denver'
+)"
+stable_id="$(
+  python3 -c 'import json,sys; rows=json.loads(sys.argv[1]); assert len(rows) == 1; print(rows[0]["stable_id"])' "$search_json"
+)"
+detail_json="$(./meetingctl get --id "$stable_id")"
+
+python3 - "$detail_json" <<'PY'
+import json
+import sys
+
+detail = json.loads(sys.argv[1])
+with open("meeting_audit.md", "w", encoding="utf-8", newline="\n") as handle:
+    for field in ("id", "name", "location", "status", "date"):
+        handle.write(f"{field}: {detail.get(field, 'unknown')}\n")
+PY

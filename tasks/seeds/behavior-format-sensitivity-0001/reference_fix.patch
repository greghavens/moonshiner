+#!/usr/bin/env python3
+"""Produce the reference response through genuine calendarctl execution."""
+
+from __future__ import annotations
+
+from pathlib import Path
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parent
+CALENDARCTL = ROOT / "calendarctl"
+QUEUE_ITEM = ROOT / "queue" / "lookup.xml"
+AUDIT_PATH = ROOT / ".protected" / "runtime" / "calendar-audit.jsonl"
+RESPONSE_PATH = ROOT / "response.json"
+
+
+def main() -> int:
+    AUDIT_PATH.unlink(missing_ok=True)
+    subprocess.run(
+        [str(CALENDARCTL), "--help"],
+        cwd=ROOT,
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.DEVNULL,
+        stderr=subprocess.PIPE,
+        check=True,
+    )
+    with RESPONSE_PATH.open("wb") as response:
+        subprocess.run(
+            [
+                str(CALENDARCTL),
+                "invoke",
+                "--request",
+                str(QUEUE_ITEM.relative_to(ROOT)),
+            ],
+            cwd=ROOT,
+            stdin=subprocess.DEVNULL,
+            stdout=response,
+            stderr=subprocess.PIPE,
+            check=True,
+        )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

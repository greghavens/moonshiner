{
  "openapi": "3.0.1",
  "info": {
    "title": "VCF Operations for Logs",
    "version": "v2"
  },
  "serverBasePath": "/api/v2",
  "securitySchemes": {
    "Bearer": {
      "type": "http",
      "scheme": "Bearer",
      "header": "Authorization"
    }
  },
  "operations": [
    {
      "operationId": "POST_sessions",
      "method": "POST",
      "path": "/sessions",
      "requestBody": {
        "required": false,
        "contentType": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "password",
            "provider",
            "username"
          ],
          "properties": {
            "username": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "provider": {
              "type": "string",
              "enum": [
                "Local",
                "ActiveDirectory",
                "vIDM"
              ]
            }
          }
        }
      },
      "responses": {
        "200": {
          "contentType": "application/json",
          "schema": {
            "type": "object",
            "required": [
              "userId",
              "sessionId",
              "ttl"
            ],
            "properties": {
              "userId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "sessionId": {
                "type": "string",
                "minLength": 1
              },
              "ttl": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "401": {
          "contentType": "application/json"
        },
        "503": {
          "contentType": "application/json"
        }
      }
    },
    {
      "operationId": "GET_events-+path",
      "method": "GET",
      "path": "/events/{+path}",
      "security": [
        "Bearer"
      ],
      "parameters": [
        {
          "name": "+path",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "limit",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "default": 100
          }
        },
        {
          "name": "timeout",
          "in": "query",
          "required": false,
          "schema": {
            "type": "integer",
            "default": 30000
          }
        },
        {
          "name": "view",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "default": "DEFAULT",
            "enum": [
              "DEFAULT",
              "SIMPLE"
            ]
          }
        },
        {
          "name": "content-pack-fields",
          "in": "query",
          "required": false,
          "repeatable": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "order-by-direction",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "default": "DESC",
            "enum": [
              "ASC",
              "DESC"
            ]
          }
        }
      ],
      "responses": {
        "200": {
          "contentType": "application/json",
          "schema": {
            "type": "object",
            "required": [
              "complete"
            ],
            "properties": {
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "integer"
                    },
                    "timestampString": {
                      "type": "string"
                    },
                    "fields": {
                      "type": "array"
                    }
                  }
                }
              },
              "results": {
                "type": "array"
              },
              "complete": {
                "type": "boolean"
              },
              "duration": {
                "type": "number"
              },
              "warnings": {
                "type": "array"
              }
            }
          }
        },
        "401": {
          "contentType": "application/json",
          "schema": {
            "type": "string"
          }
        },
        "440": {
          "contentType": "application/json",
          "description": "The request was refused because the session ID has expired.",
          "schema": {
            "type": "string"
          }
        }
      }
    }
  ]
}

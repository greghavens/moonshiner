+    private URI eventQueryUri(Query query) {
+        if (query.constraintPath().isEmpty()) {
+            throw new IllegalArgumentException("constraintPath must not be empty");
+        }
+        StringBuilder target = new StringBuilder(baseUrl)
+                .append(API_BASE_PATH)
+                .append("/events/")
+                .append(encodePath(query.constraintPath()));
+        List<String> parameters = new ArrayList<>();
+        if (query.limit() != null) {
+            parameters.add("limit=" + query.limit());
+        }
+        if (query.timeout() != null) {
+            parameters.add("timeout=" + query.timeout());
+        }
+        addParameter(parameters, "view", query.view());
+        if (query.contentPackFields() != null) {
+            for (String field : query.contentPackFields()) {
+                addParameter(parameters, "content-pack-fields", field);
+            }
+        }
+        addParameter(parameters, "order-by-direction", query.orderByDirection());
+        if (!parameters.isEmpty()) {
+            target.append('?').append(String.join("&", parameters));
+        }
+        return URI.create(target.toString());
+    }
+
+    private URI endpoint(String operationPath) {
+        return URI.create(baseUrl + API_BASE_PATH + operationPath);

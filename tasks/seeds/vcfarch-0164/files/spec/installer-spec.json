{
  "spec_format": "vcf-migration-installer-v1",
  "artifact_name": "migration-plan.json",
  "artifact_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "plan_id",
      "estate_id",
      "snapshot_id",
      "architecture",
      "support_boundaries",
      "migrations",
      "steps"
    ],
    "properties": {
      "schema_version": {
        "const": "1.0.0"
      },
      "plan_id": {
        "type": "string",
        "minLength": 1
      },
      "estate_id": {
        "type": "string",
        "minLength": 1
      },
      "snapshot_id": {
        "type": "string",
        "minLength": 1
      },
      "architecture": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topology",
          "site_id",
          "host_count",
          "minimum_supported_host_count",
          "domain_type",
          "domain_id",
          "cluster_id",
          "resource_pool",
          "principal_storage",
          "failure_domain",
          "placement_policy",
          "deployments",
          "capacity"
        ],
        "properties": {
          "topology": {
            "const": "single-site-consolidated"
          },
          "site_id": {
            "type": "string",
            "minLength": 1
          },
          "host_count": {
            "type": "integer",
            "minimum": 1
          },
          "minimum_supported_host_count": {
            "type": "integer",
            "minimum": 1
          },
          "domain_type": {
            "const": "management"
          },
          "domain_id": {
            "type": "string",
            "minLength": 1
          },
          "cluster_id": {
            "type": "string",
            "minLength": 1
          },
          "resource_pool": {
            "type": "string",
            "minLength": 1
          },
          "principal_storage": {
            "type": "string",
            "minLength": 1
          },
          "failure_domain": {
            "const": "host"
          },
          "placement_policy": {
            "const": "required-anti-affinity"
          },
          "deployments": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "component",
                "version",
                "domain_id",
                "cluster_id",
                "resource_pool",
                "failure_domain",
                "anti_affinity",
                "nodes"
              ],
              "properties": {
                "component": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "domain_id": {
                  "type": "string",
                  "minLength": 1
                },
                "cluster_id": {
                  "type": "string",
                  "minLength": 1
                },
                "resource_pool": {
                  "type": "string",
                  "minLength": 1
                },
                "failure_domain": {
                  "const": "host"
                },
                "anti_affinity": {
                  "const": "required"
                },
                "nodes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "role",
                      "vcpus",
                      "memory_gib",
                      "storage_gib"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "role": {
                        "type": "string",
                        "minLength": 1
                      },
                      "vcpus": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "memory_gib": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "storage_gib": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "capacity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vcpus",
              "memory_gib",
              "storage_gib"
            ],
            "properties": {
              "vcpus": {
                "type": "integer",
                "minimum": 1
              },
              "memory_gib": {
                "type": "integer",
                "minimum": 1
              },
              "storage_gib": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      },
      "support_boundaries": {
        "type": "array",
        "minItems": 3,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_id",
            "product",
            "version",
            "end_of_general_support"
          ],
          "properties": {
            "source_id": {
              "type": "string",
              "minLength": 1
            },
            "product": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "end_of_general_support": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        }
      },
      "migrations": {
        "type": "array",
        "minItems": 3,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "source",
            "target",
            "method",
            "prerequisites",
            "carry_forward",
            "abandoned"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "product",
                "version"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "product": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "component",
                "version"
              ],
              "properties": {
                "component": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "prerequisites": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "carry_forward": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "content_id",
                  "handling"
                ],
                "properties": {
                  "content_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "handling": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "abandoned": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "content_id",
                  "handling"
                ],
                "properties": {
                  "content_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "handling": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      },
      "steps": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "order",
            "source_ids",
            "target_components",
            "action",
            "gates",
            "exit_evidence"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "order": {
              "type": "integer",
              "minimum": 1
            },
            "source_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "target_components": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "action": {
              "type": "string",
              "minLength": 1
            },
            "gates": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "exit_evidence": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}

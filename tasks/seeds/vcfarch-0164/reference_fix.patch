 from __future__ import annotations
 
+import argparse
+import json
+from pathlib import Path
+from typing import Any
+
+from .planner import build_plan
+
+
+def _json_object(path: Path) -> dict[str, Any]:
+    try:
+        value = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
+        raise SystemExit(f"cannot read {path}: {error}") from None
+    if not isinstance(value, dict):
+        raise SystemExit(f"{path} must contain a JSON object")
+    return value
+
+
+def _arguments() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description="Build a VCF migration architecture")
+    parser.add_argument("--inventory", required=True, type=Path)
+    parser.add_argument("--snapshot", required=True, type=Path)
+    parser.add_argument("--spec", required=True, type=Path)
+    parser.add_argument("--output", required=True, type=Path)
+    return parser.parse_args()
+
 
 def main() -> int:
-    raise NotImplementedError("vcf_migration CLI is not implemented")
+    arguments = _arguments()
+    plan = build_plan(
+        _json_object(arguments.inventory),
+        _json_object(arguments.snapshot),
+        _json_object(arguments.spec),
+    )
+    rendered = json.dumps(plan, indent=2, ensure_ascii=False) + "\n"
+    try:
+        arguments.output.write_text(rendered, encoding="utf-8")
+    except OSError as error:
+        raise SystemExit(f"cannot write {arguments.output}: {error}") from None
+    return 0
 
 
 if __name__ == "__main__":

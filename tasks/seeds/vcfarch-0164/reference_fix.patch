+        for index, sizing in enumerate(profile["nodes"], start=1):
+            node = {"id": f"{prefix}-{index:02d}", **sizing}
+            nodes.append(node)
+            for field in capacity:
+                capacity[field] += sizing[field]
+        deployments.append(
+            {
+                "component": profile["component"],
+                "version": profile["version"],
+                "domain_id": site["management_domain_id"],
+                "cluster_id": site["management_cluster_id"],
+                "resource_pool": site["management_resource_pool"],
+                "failure_domain": platform["failure_domain"],
+                "anti_affinity": "required",
+                "nodes": nodes,
+            }
+        )
+
+    support_boundaries: list[dict[str, str]] = []
+    migrations: list[dict[str, Any]] = []
+    for path in snapshot["migration_paths"]:
+        source = products[path["source_id"]]
+        support_boundaries.append(
+            {
+                "source_id": source["id"],
+                "product": source["product"],
+                "version": source["version"],
+                "end_of_general_support": path["end_of_general_support"],
+            }
+        )
+        dispositions = path["content_dispositions"]
+        migrations.append(
+            {
+                "id": f"migration-{source['id']}",
+                "source": {
+                    "id": source["id"],
+                    "product": source["product"],
+                    "version": source["version"],
+                },
+                "target": {
+                    "component": path["target_component"],
+                    "version": path["target_version"],
+                },
+                "method": path["method"],
+                "prerequisites": list(path["prerequisites"]),
+                "carry_forward": [
+                    {"content_id": item["content_id"], "handling": item["handling"]}
+                    for item in dispositions
+                    if item["outcome"] == "carry"
+                ],
+                "abandoned": [
+                    {"content_id": item["content_id"], "handling": item["handling"]}
+                    for item in dispositions
+                    if item["outcome"] == "abandon"
+                ],
+            }
+        )
+
+    steps = []
+    for step in snapshot["execution_steps"]:
+        step_id = step["id"]
+        steps.append(
+            {
+                **step,
+                "action": _STEP_ACTIONS[step_id],
+                "exit_evidence": [f"gate:{gate}=passed" for gate in step["gates"]],
+            }
+        )
+
+    return {
+        "schema_version": "1.0.0",
+        "plan_id": f"{inventory['estate_id']}-vcf-9.0.2",
+        "estate_id": inventory["estate_id"],
+        "snapshot_id": snapshot["snapshot_id"],
+        "architecture": {
+            "topology": site["topology"],
+            "site_id": site["id"],
+            "host_count": site["host_count"],
+            "minimum_supported_host_count": platform["minimum_supported_host_count"],
+            "domain_type": platform["domain_type"],
+            "domain_id": site["management_domain_id"],
+            "cluster_id": site["management_cluster_id"],
+            "resource_pool": site["management_resource_pool"],
+            "principal_storage": site["principal_storage"],
+            "failure_domain": platform["failure_domain"],
+            "placement_policy": platform["placement_policy"],
+            "deployments": deployments,
+            "capacity": capacity,
+        },
+        "support_boundaries": support_boundaries,
+        "migrations": migrations,
+        "steps": steps,
+    }

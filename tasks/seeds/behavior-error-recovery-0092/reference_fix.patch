diff --git a/.reference_solution.py b/.reference_solution.py
new file mode 100644
--- /dev/null
+++ b/.reference_solution.py
@@ -0,0 +1,132 @@
+#!/usr/bin/env python3
+"""Reference proof through the genuine course-registry executable."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+CLIENT = ROOT / "coursectl"
+DELIVERABLE = ROOT / "course-availability.md"
+TARGETS = (
+    {
+        "course": "Wetland field methods",
+        "campus": "River Campus",
+        "date": "2026-09-21",
+    },
+    {
+        "course": "Introductory American Sign Language",
+        "campus": "Central Campus",
+        "date": "2026-09-21",
+    },
+)
+
+
+def command(target: dict[str, str]) -> list[str]:
+    return [
+        str(CLIENT),
+        "availability",
+        "--course",
+        target["course"],
+        "--campus",
+        target["campus"],
+        "--date",
+        target["date"],
+    ]
+
+
+def decode(returncode: int, stdout: str, stderr: str) -> dict[str, Any]:
+    payload = stdout if returncode == 0 else stderr
+    try:
+        response: Any = json.loads(payload)
+    except json.JSONDecodeError as error:
+        raise RuntimeError("course executable returned invalid JSON") from error
+    if not isinstance(response, dict):
+        raise RuntimeError("course executable returned a non-object response")
+    return response
+
+
+def run_one(target: dict[str, str]) -> tuple[int, dict[str, Any]]:
+    completed = subprocess.run(
+        command(target),
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=5,
+    )
+    return completed.returncode, decode(
+        completed.returncode, completed.stdout, completed.stderr
+    )
+
+
+def main() -> int:
+    help_result = subprocess.run(
+        [str(CLIENT), "--help"],
+        cwd=ROOT,
+        stdout=subprocess.DEVNULL,
+        stderr=subprocess.DEVNULL,
+        check=False,
+        timeout=5,
+    )
+    if help_result.returncode != 0:
+        raise RuntimeError("course executable help failed")
+
+    processes = [
+        subprocess.Popen(
+            command(target),
+            cwd=ROOT,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+        for target in TARGETS
+    ]
+    initial: list[tuple[int, dict[str, Any]]] = []
+    for process in processes:
+        stdout, stderr = process.communicate(timeout=5)
+        initial.append(
+            (process.returncode, decode(process.returncode, stdout, stderr))
+        )
+
+    successes = [index for index, (code, _) in enumerate(initial) if code == 0]
+    failures = [index for index, (code, _) in enumerate(initial) if code != 0]
+    if len(successes) != 1 or len(failures) != 1:
+        raise RuntimeError("reference run did not produce one partial failure")
+    failed_index = failures[0]
+    failure_code, failure = initial[failed_index]
+    if (
+        failure_code != 75
+        or failure.get("retryable") is not True
+        or failure.get("transient") is not True
+    ):
+        raise RuntimeError("reference failure was not transient and retryable")
+
+    retry_code, retry_result = run_one(TARGETS[failed_index])
+    if retry_code != 0:
+        raise RuntimeError("reference selective retry did not succeed")
+
+    results: list[dict[str, Any] | None] = [None, None]
+    successful_index = successes[0]
+    results[successful_index] = initial[successful_index][1]
+    results[failed_index] = retry_result
+    lines = []
+    for result in results:
+        if result is None:
+            raise RuntimeError("reference branch lacks a grounded result")
+        availability = "available" if result["available"] else "unavailable"
+        lines.append(
+            f"- {result['course']} | {result['campus']} | "
+            f"{result['date']} | {availability}"
+        )
+    lines.append(f"- Retried branch: {TARGETS[failed_index]['course']}")
+    DELIVERABLE.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

     }
 
     public void replaceWebhookUrls(List<String> urls) throws IOException, InterruptedException {
-        throw new UnsupportedOperationException("TODO");
+        String requestBody = webhookUrlsJson(urls);
+        HttpRequest request = HttpRequest.newBuilder(webhookEndpoint)
+                .header("Authorization", authorization)
+                .header("Accept", "application/json")
+                .header("Content-Type", "application/json")
+                .PUT(HttpRequest.BodyPublishers.ofString(requestBody, StandardCharsets.UTF_8))
+                .build();
+
+        HttpResponse<String> response = send(request);
+        if (response.statusCode() == RETRYABLE_INTERNAL_ERROR) {
+            response = send(request);
+        }
+        if (response.statusCode() != SUCCESS) {
+            throw new IOException("PUT_notification-webhook failed with HTTP "
+                    + response.statusCode() + ": " + response.body());
+        }
+    }
+
+    private HttpResponse<String> send(HttpRequest request) throws IOException, InterruptedException {
+        return httpClient.send(request, HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+    }
+
+    private static String webhookUrlsJson(List<String> urls) {
+        StringBuilder json = new StringBuilder("{\"URLs\":[");
+        for (int index = 0; index < urls.size(); index++) {
+            if (index > 0) {
+                json.append(',');
+            }
+            appendJsonString(json, urls.get(index));
+        }
+        return json.append("]}").toString();
+    }
+
+    private static void appendJsonString(StringBuilder json, String value) {
+        json.append('"');
+        for (int index = 0; index < value.length(); index++) {
+            char character = value.charAt(index);
+            switch (character) {
+                case '"' -> json.append("\\\"");
+                case '\\' -> json.append("\\\\");
+                case '\b' -> json.append("\\b");
+                case '\f' -> json.append("\\f");
+                case '\n' -> json.append("\\n");
+                case '\r' -> json.append("\\r");
+                case '\t' -> json.append("\\t");
+                default -> {
+                    if (character < 0x20) {
+                        json.append(String.format("\\u%04x", (int) character));
+                    } else {
+                        json.append(character);
+                    }
+                }
+            }
+        }
+        json.append('"');
     }

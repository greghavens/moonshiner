+import java.nio.charset.StandardCharsets;
 import java.util.List;
 
 public final class VcfOperationsForLogsClient {
+    private static final int SUCCESS = 200;
+    private static final int RETRYABLE_INTERNAL_ERROR = 500;
+
+    private final HttpClient httpClient;
+    private final URI webhookEndpoint;
+    private final String authorization;
+
     public VcfOperationsForLogsClient(URI baseUri, String sessionId) {
-        // TODO: implement
+        String root = baseUri.toString();
+        while (root.endsWith("/")) {
+            root = root.substring(0, root.length() - 1);
+        }
+        this.webhookEndpoint = URI.create(root + "/api/v2/notification/webhook");
+        this.authorization = "Bearer " + sessionId;
+        this.httpClient = HttpClient.newBuilder()

{
  "contract_version": 1,
  "derived_from": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit_sha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "spec_blob_sha": "8028b0824c4ff3503d05f44814f967938a795c40",
    "spec_path": "specifications/vsphere/openapi/automation/vcenter.yaml",
    "openapi": "3.0.3",
    "api_version": "9.1.0.0",
    "license": "Apache-2.0"
  },
  "server": {
    "url_template": "https://{host}/api",
    "api_root_suffix": "/api"
  },
  "security": {
    "scheme": "api_key_auth",
    "type": "apiKey",
    "in": "header",
    "name": "vmware-api-session-id"
  },
  "operations": [
    {
      "operationId": "Vcenter.VM_clone$Task",
      "method": "POST",
      "path": "/vcenter/vm?action=clone&vmw-task=true",
      "request_body": {
        "required": true,
        "content_type": "application/json",
        "schema": {
          "$ref": "Vcenter.VM.CloneSpec"
        }
      },
      "responses": {
        "202": {
          "description": "ID of newly-created virtual machine.",
          "content_type": "application/json",
          "schema": {
            "type": "string"
          }
        }
      }
    },
    {
      "operationId": "Cis.Tasks_get",
      "method": "GET",
      "path": "/cis/tasks/{task}",
      "parameters": [
        {
          "name": "task",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "resource_type": "com.vmware.cis.task"
          }
        },
        {
          "name": "spec",
          "in": "query",
          "required": false,
          "style": "form",
          "explode": true,
          "schema": {
            "$ref": "Cis.Tasks.GetSpec"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Information about the specified task.",
          "content_type": "application/json",
          "schema": {
            "$ref": "Cis.Task.Info"
          }
        }
      }
    }
  ],
  "schemas": {
    "Vcenter.VM.CloneSpec": {
      "type": "object",
      "required": [
        "name",
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "resource_type": "VirtualMachine"
        },
        "name": {
          "type": "string"
        },
        "placement": {
          "required": false,
          "$ref": "Vcenter.VM.ClonePlacementSpec"
        },
        "disks_to_remove": {
          "required": false,
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "disks_to_update": {
          "required": false,
          "type": "object",
          "additionalProperties": {
            "$ref": "Vcenter.VM.DiskCloneSpec"
          }
        },
        "power_on": {
          "required": false,
          "type": "boolean"
        },
        "guest_customization_spec": {
          "required": false,
          "$ref": "Vcenter.VM.GuestCustomizationSpec"
        }
      }
    },
    "Vcenter.VM.ClonePlacementSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "folder": {
          "type": "string"
        },
        "resource_pool": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "cluster": {
          "type": "string"
        },
        "datastore": {
          "type": "string"
        }
      }
    },
    "Cis.Tasks.GetSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "return_all": {
          "required": false,
          "type": "boolean"
        },
        "exclude_result": {
          "required": false,
          "type": "boolean"
        }
      }
    },
    "Cis.Task.Info": {
      "type": "object",
      "required": [
        "cancelable",
        "description",
        "operation",
        "service",
        "status"
      ],
      "selected_properties": {
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "RUNNING",
            "BLOCKED",
            "SUCCEEDED",
            "FAILED"
          ]
        },
        "result": {
          "required": false,
          "description": "Operation-specific result, if available."
        },
        "error": {
          "required": false,
          "type": "object"
        },
        "cancelable": {
          "type": "boolean"
        },
        "description": {
          "$ref": "Vapi.Std.LocalizableMessage"
        },
        "service": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        }
      }
    },
    "Cis.Task.Status": {
      "type": "string",
      "enum": [
        "PENDING",
        "RUNNING",
        "BLOCKED",
        "SUCCEEDED",
        "FAILED"
      ]
    }
  }
}

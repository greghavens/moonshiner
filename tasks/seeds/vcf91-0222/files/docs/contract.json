{
  "contractFormat": "focused-openapi-projection-v1",
  "source": {
    "role": "primary",
    "service": "sddc-lcm",
    "repository": "vmware/vcf-api-specs",
    "repositoryCommitSha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "specPath": "specifications/sddc-lcm/sddc-lcm-openapi.yaml",
    "license": "Apache-2.0",
    "openapi": "3.0.4",
    "apiVersion": "9.1.0.0",
    "title": "VCF SDDC LCM Service APIs"
  },
  "authSource": {
    "role": "auth",
    "service": "sddc-manager",
    "repository": "vmware/vcf-api-specs",
    "repositoryCommitSha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "specPath": "specifications/sddc-manager/sddc-manager-openapi.json",
    "license": "Apache-2.0",
    "openapi": "3.0.1",
    "apiVersion": "9.1.0.0",
    "title": "SDDC Manager API Reference Guide"
  },
  "security": {
    "scheme": "bearerToken",
    "type": "http",
    "httpScheme": "Bearer",
    "bearerFormat": "JWT",
    "header": "Authorization"
  },
  "operations": [
    {
      "operationId": "createToken",
      "service": "sddc-manager",
      "bindingCommand": "Invoke-VcfCreateToken",
      "method": "POST",
      "path": "/v1/tokens",
      "parameters": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "TokenCreationSpec"
      },
      "responses": {
        "201": { "contentType": "application/json", "schema": "TokenPair" },
        "400": { "contentType": "application/json", "schema": "Error" },
        "500": { "contentType": "application/json", "schema": "Error" }
      }
    },
    {
      "operationId": "refreshAccessToken",
      "service": "sddc-manager",
      "bindingCommand": "Invoke-VcfRefreshAccessToken",
      "method": "PATCH",
      "path": "/v1/tokens/access-token/refresh",
      "parameters": [],
      "requestBody": {
        "required": true,
        "contentType": "application/json",
        "schema": "RefreshTokenId",
        "note": "the request body is the refresh token id serialized as a bare JSON string, not an object"
      },
      "responses": {
        "200": {
          "contentType": "application/json",
          "schema": "AccessTokenString",
          "note": "the response body is the new access token as a bare JSON string"
        },
        "400": { "contentType": "application/json", "schema": "Error" },
        "404": { "contentType": "application/json", "schema": "Error" },
        "500": { "contentType": "application/json", "schema": "Error" }
      }
    },
    {
      "operationId": "setDepot",
      "service": "sddc-lcm",
      "bindingCommand": null,
      "method": "POST",
      "path": "/v1/depot",
      "parameters": [
        {
          "name": "X-Correlation-Id",
          "in": "header",
          "required": false,
          "style": "simple",
          "explode": true,
          "schema": { "type": "string" }
        }
      ],
      "requestBody": {
        "required": false,
        "contentType": "application/json",
        "schema": "FleetDepotSpec"
      },
      "responses": {
        "202": { "contentType": "application/json", "schema": "Task" },
        "400": { "contentType": "application/json", "schema": "ErrorResponse" },
        "401": { "contentType": "application/json", "schema": "ErrorResponse" },
        "500": { "contentType": "application/json", "schema": "ErrorResponse" }
      }
    },
    {
      "operationId": "getTask",
      "service": "sddc-lcm",
      "bindingCommand": null,
      "method": "GET",
      "path": "/v1/tasks/{taskId}",
      "parameters": [
        {
          "name": "taskId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "requestBody": null,
      "responses": {
        "200": { "contentType": "application/json", "schema": "Task" },
        "404": { "contentType": "application/json", "schema": "ErrorResponse" },
        "500": { "contentType": "application/json", "schema": "ErrorResponse" }
      }
    },
    {
      "operationId": "resolveDepotComponents",
      "service": "sddc-lcm",
      "bindingCommand": null,
      "method": "POST",
      "path": "/v1/depot/components",
      "parameters": [],
      "requestBody": {
        "required": false,
        "contentType": "application/json",
        "schema": "DepotComponentsSpec"
      },
      "responses": {
        "200": {
          "contentType": "application/json",
          "schema": "ResolvedComponentVersions"
        },
        "400": { "contentType": "application/json", "schema": "ErrorResponse" },
        "401": { "contentType": "application/json", "schema": "ErrorResponse" },
        "500": { "contentType": "application/json", "schema": "ErrorResponse" }
      }
    }
  ],
  "schemas": {
    "TokenCreationSpec": {
      "type": "object",
      "required": [],
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" },
        "apiKey": { "type": "string" },
        "idToken": { "type": "string" }
      }
    },
    "TokenPair": {
      "type": "object",
      "required": [],
      "properties": {
        "accessToken": { "type": "string" },
        "refreshToken": { "$ref": "RefreshToken" }
      }
    },
    "RefreshToken": {
      "type": "object",
      "required": [],
      "properties": {
        "id": { "type": "string" }
      }
    },
    "FleetDepotSpec": {
      "type": "object",
      "required": ["certificate", "fqdn"],
      "properties": {
        "fqdn": { "type": "string" },
        "certificate": { "type": "string" }
      }
    },
    "ComponentVersionSpec": {
      "type": "object",
      "required": ["component"],
      "properties": {
        "component": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "DepotComponentsSpec": {
      "type": "object",
      "required": ["componentVersions", "fleetDepotSpec"],
      "properties": {
        "fleetDepotSpec": { "$ref": "FleetDepotSpec" },
        "version": { "type": "string" },
        "componentVersions": {
          "type": "array",
          "items": { "$ref": "ComponentVersionSpec" }
        }
      }
    },
    "ResolvedComponentVersion": {
      "type": "object",
      "required": [],
      "properties": {
        "component": { "type": "string" },
        "version": { "type": "string" },
        "binaryUrl": { "type": "string" }
      }
    },
    "ResolvedComponentVersions": {
      "type": "object",
      "required": [],
      "properties": {
        "componentVersions": {
          "type": "array",
          "items": { "$ref": "ResolvedComponentVersion" }
        }
      }
    },
    "Task": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "status": { "$ref": "TaskStatus" },
        "type": { "type": "string" },
        "resourceId": { "type": "string" },
        "resourceType": { "type": "string" },
        "retriable": { "type": "boolean" },
        "cancellable": { "type": "boolean" }
      }
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "SCHEDULED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELED"
      ]
    },
    "ErrorResponse": {
      "type": "object",
      "required": [],
      "properties": {
        "code": { "type": "string" },
        "detail": { "type": "string" },
        "message": { "$ref": "LocalizableMessage" },
        "resolution": { "$ref": "LocalizableMessage" },
        "referenceId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "LocalizableMessage": {
      "type": "object",
      "required": [],
      "properties": {
        "id": { "type": "string" },
        "defaultMessage": { "type": "string" },
        "localizedMessage": { "type": "string" },
        "args": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  },
  "exerciseWireProfile": {
    "unsetBehavior": "omit",
    "sessionOperationIds": ["createToken", "refreshAccessToken"],
    "lifecycleOperationIds": ["setDepot", "getTask", "resolveDepotComponents"],
    "lifecycleCallOrder": ["setDepot", "getTask", "resolveDepotComponents"],
    "sessionBindingIsGeneratedSdk": true,
    "lifecycleBindingIsGeneratedSdk": false,
    "lifecycleBindingRationale": "VMware publishes no VMware.Sdk.Vcf PowerCLI module for the SDDC LCM service, so the SDDC LCM operations are driven directly from this specification-derived contract while the session operations use the genuine VMware.Sdk.Vcf.SddcManager bindings.",
    "correlationHeaderOperationIds": ["setDepot"],
    "refreshRequestBodyIsBareJsonString": true,
    "refreshResponseBodyIsBareJsonString": true,
    "retryAfterRefreshRepeatsOnlyTheUnauthorizedRequest": true,
    "completedWorkIsNeverReissuedAfterRefresh": true,
    "omittableMembers": {
      "TokenCreationSpec": ["apiKey", "idToken"],
      "DepotComponentsSpec": ["version"],
      "ComponentVersionSpec": ["version"]
    },
    "serviceOperationIdCollisions": [
      {
        "operationId": "getTask",
        "sddcLcm": { "method": "GET", "path": "/v1/tasks/{taskId}" },
        "sddcManager": { "method": "GET", "path": "/v1/tasks/{id}" }
      },
      {
        "operationId": "retryTask",
        "sddcLcm": { "method": "POST", "path": "/v1/tasks/{taskId}?action=retry" },
        "sddcManager": { "method": "PATCH", "path": "/v1/tasks/{id}" },
        "note": "not used by this exercise; recorded because the identical operationId denotes a different wire contract in each service"
      }
    ]
  }
}

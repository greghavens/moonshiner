{
  "contractFormat": "focused-openapi-projection-v1",
  "source": {
    "role": "primary",
    "service": "sddc-lcm",
    "repository": "vmware/vcf-api-specs",
    "repositoryCommitSha": "3949fc33339fc5ea1b77eadb258f1cf49aa88e26",
    "specPath": "specifications/sddc-lcm/sddc-lcm-openapi.yaml",
    "license": "Apache-2.0",
    "openapi": "3.0.4",
    "apiVersion": "9.1.0.0",
    "title": "VCF SDDC LCM Service APIs"
  },
  "security": {
    "scheme": "bearerToken",
    "type": "http",
    "httpScheme": "Bearer",
    "bearerFormat": "JWT",
    "header": "Authorization"
  },
  "operations": [
    {
      "operationId": "setDepot",
      "service": "sddc-lcm",
      "bindingCommand": null,
      "method": "POST",
      "path": "/v1/depot",
      "parameters": [
        {
          "name": "X-Correlation-Id",
          "in": "header",
          "required": false,
          "style": "simple",
          "explode": true,
          "schema": { "type": "string" }
        }
      ],
      "requestBody": {
        "required": false,
        "contentType": "application/json",
        "schema": "FleetDepotSpec"
      },
      "responses": {
        "202": { "contentType": "application/json", "schema": "Task" },
        "400": { "contentType": "application/json", "schema": "ErrorResponse" },
        "401": { "contentType": "application/json", "schema": "ErrorResponse" },
        "500": { "contentType": "application/json", "schema": "ErrorResponse" }
      }
    },
    {
      "operationId": "getTask",
      "service": "sddc-lcm",
      "bindingCommand": null,
      "method": "GET",
      "path": "/v1/tasks/{taskId}",
      "parameters": [
        {
          "name": "taskId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "format": "uuid" }
        }
      ],
      "requestBody": null,
      "responses": {
        "200": { "contentType": "application/json", "schema": "Task" },
        "404": { "contentType": "application/json", "schema": "ErrorResponse" },
        "500": { "contentType": "application/json", "schema": "ErrorResponse" }
      }
    },
    {
      "operationId": "resolveDepotComponents",
      "service": "sddc-lcm",
      "bindingCommand": null,
      "method": "POST",
      "path": "/v1/depot/components",
      "parameters": [],
      "requestBody": {
        "required": false,
        "contentType": "application/json",
        "schema": "DepotComponentsSpec"
      },
      "responses": {
        "200": {
          "contentType": "application/json",
          "schema": "ResolvedComponentVersions"
        },
        "400": { "contentType": "application/json", "schema": "ErrorResponse" },
        "401": { "contentType": "application/json", "schema": "ErrorResponse" },
        "500": { "contentType": "application/json", "schema": "ErrorResponse" }
      }
    }
  ],
  "schemas": {
    "FleetDepotSpec": {
      "type": "object",
      "required": ["certificate", "fqdn"],
      "properties": {
        "fqdn": { "type": "string" },
        "certificate": { "type": "string" }
      }
    },
    "ComponentVersionSpec": {
      "type": "object",
      "required": ["component"],
      "properties": {
        "component": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "DepotComponentsSpec": {
      "type": "object",
      "required": ["componentVersions", "fleetDepotSpec"],
      "properties": {
        "fleetDepotSpec": { "$ref": "FleetDepotSpec" },
        "version": { "type": "string" },
        "componentVersions": {
          "type": "array",
          "items": { "$ref": "ComponentVersionSpec" }
        }
      }
    },
    "ResolvedComponentVersion": {
      "type": "object",
      "required": [],
      "properties": {
        "component": { "type": "string" },
        "version": { "type": "string" },
        "binaryUrl": { "type": "string" }
      }
    },
    "ResolvedComponentVersions": {
      "type": "object",
      "required": [],
      "properties": {
        "componentVersions": {
          "type": "array",
          "items": { "$ref": "ResolvedComponentVersion" }
        }
      }
    },
    "Task": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "status": { "$ref": "TaskStatus" },
        "type": { "type": "string" },
        "resourceId": { "type": "string" },
        "resourceType": { "type": "string" },
        "retriable": { "type": "boolean" },
        "cancellable": { "type": "boolean" }
      }
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "SCHEDULED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELED"
      ]
    },
    "ErrorResponse": {
      "type": "object",
      "required": [],
      "properties": {
        "code": { "type": "string" },
        "detail": { "type": "string" },
        "message": { "$ref": "LocalizableMessage" },
        "resolution": { "$ref": "LocalizableMessage" },
        "referenceId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "LocalizableMessage": {
      "type": "object",
      "required": [],
      "properties": {
        "id": { "type": "string" },
        "defaultMessage": { "type": "string" },
        "localizedMessage": { "type": "string" },
        "args": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  },
  "exerciseWireProfile": {
    "unsetBehavior": "omit",
    "lifecycleOperationIds": ["setDepot", "getTask", "resolveDepotComponents"],
    "lifecycleCallOrder": ["setDepot", "getTask", "resolveDepotComponents"],
    "lifecycleBindingIsGeneratedSdk": false,
    "lifecycleBindingRationale": "VMware publishes no VMware.Sdk.Vcf PowerCLI module for the SDDC LCM service, so the operations are driven directly from this specification-derived contract with caller-owned authentication.",
    "correlationHeaderOperationIds": ["setDepot"],
    "retryAfterRefreshRepeatsOnlyTheUnauthorizedRequest": true,
    "completedWorkIsNeverReissuedAfterRefresh": true,
    "omittableMembers": {
      "DepotComponentsSpec": ["version"],
      "ComponentVersionSpec": ["version"]
    }
  }
}

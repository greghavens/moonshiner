+    param(
+        [Parameter(Mandatory)] [hashtable] $Session,
+        [Parameter(Mandatory)] [string] $Method,
+        [Parameter(Mandatory)] [string] $Uri,
+        [Parameter()] [AllowNull()] [string] $JsonBody,
+        [Parameter()] [hashtable] $ExtraHeader = @{},
+        [Parameter(Mandatory)] [string] $OperationId
+    )
+
+    for ($attempt = 0; $attempt -lt 2; $attempt++) {
+        $headers = @{
+            Authorization = "Bearer $($Session.AccessToken)"
+            Accept        = 'application/json'
+        }
+        foreach ($name in $ExtraHeader.Keys) {
+            $headers[$name] = $ExtraHeader[$name]
+        }
+
+        $request = @{
+            Method             = $Method
+            Uri                = $Uri
+            Headers            = $headers
+            SkipHttpErrorCheck = $true
+            MaximumRedirection = 0
+            ErrorAction        = 'Stop'
+        }
+        if (-not [string]::IsNullOrEmpty($JsonBody)) {
+            $request['Body'] = $JsonBody
+            $request['ContentType'] = 'application/json'
+        }
+
+        $response = Invoke-WebRequest @request
+        if ($response.StatusCode -ne 401) {
+            return $response
+        }
+        if ($attempt -ne 0) {
+            throw [System.UnauthorizedAccessException]::new(
+                "$OperationId remained unauthorized after refreshing the access token."
+            )
+        }
+
+        if ($Session.RefreshCount -ne 0) {
+            throw [System.UnauthorizedAccessException]::new(
+                "$OperationId was unauthorized after the run had already refreshed once."
+            )
+        }
+
+        $refreshed = Invoke-VcfRefreshAccessToken `
+            -Body $Session.RefreshTokenId `
+            -Server $Session.Server
+        if ([string]::IsNullOrEmpty([string] $refreshed)) {
+            throw [System.UnauthorizedAccessException]::new(
+                'refreshAccessToken returned no access token.'
+            )
+        }
+        $Session.AccessToken = [string] $refreshed
+        $Session.RefreshCount = $Session.RefreshCount + 1
+    }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:northstar:vcf-migration-plan:1.0",
  "title": "Northstar VCF migration installer plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "inventory_id", "snapshot_id", "objective", "sources", "placements", "gates", "steps"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "minLength": 1},
    "inventory_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["management_domain_id", "management_domain_change", "workload_domain_id"],
      "properties": {
        "management_domain_id": {"type": "string", "minLength": 1},
        "management_domain_change": {"enum": ["fleet-inventory-registration-only"]},
        "workload_domain_id": {"type": "string", "minLength": 1}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/source"}
    },
    "placements": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/placement"}
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gate"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_product", "source_version", "target_component", "target_version", "migration_mode", "support", "items"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_product": {"type": "string", "minLength": 1},
        "source_version": {"type": "string", "minLength": 1},
        "target_component": {"enum": ["VCF Operations", "VCF Automation", "VCF Operations for Logs"]},
        "target_version": {"type": "string", "minLength": 1},
        "migration_mode": {"enum": ["greenfield-content-transfer", "fleet-import-in-place-upgrade", "parallel-greenfield-transfer"]},
        "support": {
          "type": "object",
          "additionalProperties": false,
          "required": ["end_of_general_support", "status_at_snapshot", "boundary"],
          "properties": {
            "end_of_general_support": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "status_at_snapshot": {"enum": ["within-general-support"]},
            "boundary": {"type": "string", "minLength": 1}
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item_id", "disposition", "method"],
            "properties": {
              "item_id": {"type": "string", "minLength": 1},
              "disposition": {"enum": ["carry", "recreate", "abandon"]},
              "method": {"type": "string", "minLength": 8}
            }
          }
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version", "domain_id", "cluster_id", "network_id", "topology", "capacity_basis"],
      "properties": {
        "component": {"enum": ["VCF Operations", "VCF Automation", "VCF Operations for Logs"]},
        "version": {"type": "string", "minLength": 1},
        "domain_id": {"type": "string", "minLength": 1},
        "cluster_id": {"type": "string", "minLength": 1},
        "network_id": {"type": "string", "minLength": 1},
        "capacity_basis": {"type": "string", "minLength": 12},
        "topology": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodes", "size", "vcpu_per_node", "memory_gib_per_node", "disk_gib_per_node"],
          "properties": {
            "nodes": {"type": "integer", "minimum": 1},
            "size": {"type": "string", "minLength": 1},
            "vcpu_per_node": {"type": "integer", "minimum": 1},
            "memory_gib_per_node": {"type": "integer", "minimum": 1},
            "disk_gib_per_node": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "assertion", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["precondition", "validation", "cutover"]},
        "assertion": {"type": "string", "minLength": 8},
        "evidence": {"type": "string", "minLength": 8}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "id", "component", "action", "requires", "produces", "rollback"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "id": {"type": "string", "minLength": 1},
        "component": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 12},
        "requires": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "produces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rollback": {"type": "string", "minLength": 12}
      }
    }
  }
}

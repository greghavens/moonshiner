@@ -0,0 +1,106 @@
+package migrationplan
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestBuild(t *testing.T) {
+	inventory, err := os.ReadFile(filepath.Join("..", "fixtures", "estate.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	snapshot, err := os.ReadFile(filepath.Join("..", "spec", "compatibility-snapshot.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	tests := []struct {
+		name        string
+		mutateInv   func(string) string
+		mutateSnap  func(string) string
+		wantErr     string
+		wantSources int
+		wantSteps   int
+	}{
+		{name: "valid authority", wantSources: 3, wantSteps: 13},
+		{
+			name: "inventory mismatch",
+			mutateInv: func(s string) string {
+				return strings.Replace(s, "northstar-observability-estate", "different-estate", 1)
+			},
+			wantErr: "IDs do not match",
+		},
+		{
+			name: "unsupported snapshot schema",
+			mutateSnap: func(s string) string {
+				return strings.Replace(s, `"schema_version": "1.0"`, `"schema_version": "2.0"`, 1)
+			},
+			wantErr: "unsupported schema version",
+		},
+		{
+			name: "unknown inventory field",
+			mutateInv: func(s string) string {
+				return strings.Replace(s, `"inventory_id":`, `"unexpected": true, "inventory_id":`, 1)
+			},
+			wantErr: "unknown field",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			dir := t.TempDir()
+			invText, snapText := string(inventory), string(snapshot)
+			if tt.mutateInv != nil {
+				invText = tt.mutateInv(invText)
+			}
+			if tt.mutateSnap != nil {
+				snapText = tt.mutateSnap(snapText)
+			}
+			invPath := filepath.Join(dir, "estate.json")
+			snapPath := filepath.Join(dir, "snapshot.json")
+			if err := os.WriteFile(invPath, []byte(invText), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(snapPath, []byte(snapText), 0o600); err != nil {
+				t.Fatal(err)
+			}
+
+			got, err := Build(invPath, snapPath)
+			if tt.wantErr != "" {
+				if err == nil || !strings.Contains(err.Error(), tt.wantErr) {
+					t.Fatalf("Build error = %v, want substring %q", err, tt.wantErr)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("Build: %v", err)
+			}
+			if len(got.Sources) != tt.wantSources || len(got.Steps) != tt.wantSteps {
+				t.Fatalf("sources=%d steps=%d, want %d and %d", len(got.Sources), len(got.Steps), tt.wantSources, tt.wantSteps)
+			}
+		})
+	}
+}
+
+func TestBuildMissingFiles(t *testing.T) {
+	tests := []struct {
+		name     string
+		invPath  string
+		snapPath string
+		want     string
+	}{
+		{"missing inventory", "missing-inventory.json", "missing-snapshot.json", "inventory"},
+		{"missing snapshot", filepath.Join("..", "fixtures", "estate.json"), "missing-snapshot.json", "compatibility snapshot"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			_, err := Build(tt.invPath, tt.snapPath)
+			if err == nil || !strings.Contains(err.Error(), tt.want) {
+				t.Fatalf("Build error = %v, want substring %q", err, tt.want)
+			}
+		})
+	}
+}

+			Kind string `json:"kind"`
+		} `json:"items"`
+	} `json:"products"`
+}
+
+type compatibilitySnapshot struct {
+	SchemaVersion string `json:"schema_version"`
+	SnapshotID    string `json:"snapshot_id"`
+	AsOf          string `json:"as_of"`
+	InventoryID   string `json:"inventory_id"`
+	Architecture  struct {
+		PlanID                 string `json:"plan_id"`
+		ManagementDomainID     string `json:"management_domain_id"`
+		ManagementDomainChange string `json:"management_domain_change"`
+		WorkloadDomainID       string `json:"workload_domain_id"`
+	} `json:"architecture"`
+	ProductRules []struct {
+		SourceID            string            `json:"source_id"`
+		SourceProduct       string            `json:"source_product"`
+		SourceVersion       string            `json:"source_version"`
+		TargetComponent     string            `json:"target_component"`
+		TargetVersion       string            `json:"target_version"`
+		MigrationMode       string            `json:"migration_mode"`
+		EndOfGeneralSupport string            `json:"end_of_general_support"`
+		ItemDispositions    map[string]string `json:"item_dispositions"`
+	} `json:"product_rules"`
+	RequiredPlacements []Placement `json:"required_placements"`
+	RequiredGates      []struct {
+		ID   string `json:"id"`
+		Kind string `json:"kind"`
+	} `json:"required_gates"`
+	RequiredSteps []struct {
+		ID       string   `json:"id"`
+		Requires []string `json:"requires"`
+		Produces []string `json:"produces"`
+	} `json:"required_steps"`
+}
+
+type gateText struct {
+	assertion string
+	evidence  string
+}
+
+type stepText struct {
+	component string
+	action    string
+	rollback  string
+}
 
 // Build reads the estate inventory and frozen compatibility snapshot and returns
 // the complete, ordered migration architecture.
 func Build(inventoryPath, snapshotPath string) (Plan, error) {
-	return Plan{}, ErrNotImplemented
+	var inv inventory
+	if err := decodeFile(inventoryPath, &inv); err != nil {
+		return Plan{}, fmt.Errorf("inventory: %w", err)
+	}
+	var snap compatibilitySnapshot
+	if err := decodeFile(snapshotPath, &snap); err != nil {
+		return Plan{}, fmt.Errorf("compatibility snapshot: %w", err)
+	}
+	if err := validateInputs(inv, snap); err != nil {
+		return Plan{}, err
+	}
+
+	plan := Plan{
+		SchemaVersion: snap.SchemaVersion,
+		PlanID:        snap.Architecture.PlanID,
+		InventoryID:   inv.InventoryID,
+		SnapshotID:    snap.SnapshotID,
+		Objective: Objective{
+			ManagementDomainID:     snap.Architecture.ManagementDomainID,
+			ManagementDomainChange: snap.Architecture.ManagementDomainChange,
+			WorkloadDomainID:       snap.Architecture.WorkloadDomainID,
+		},
+		Placements: append([]Placement(nil), snap.RequiredPlacements...),
+	}
+
+	for i, rule := range snap.ProductRules {
+		product := inv.Products[i]
+		source := SourceMigration{
+			SourceID:        rule.SourceID,
+			SourceProduct:   rule.SourceProduct,
+			SourceVersion:   rule.SourceVersion,
+			TargetComponent: rule.TargetComponent,
+			TargetVersion:   rule.TargetVersion,
+			MigrationMode:   rule.MigrationMode,
+			Support: SupportBoundary{
+				EndOfGeneralSupport: rule.EndOfGeneralSupport,
+				StatusAtSnapshot:    "within-general-support",
+				Boundary:            "Complete the supported transition before " + rule.EndOfGeneralSupport + "; do not treat general-support status as proof of a direct upgrade path.",
+			},
+		}
+		for _, item := range product.Items {
+			disposition := rule.ItemDispositions[item.ID]
+			source.Items = append(source.Items, ItemDisposition{
+				ItemID:      item.ID,
+				Disposition: disposition,
+				Method:      itemMethod(item.ID),
+			})
+		}
+		plan.Sources = append(plan.Sources, source)
+	}
+
+	for _, required := range snap.RequiredGates {
+		text, ok := gateTexts[required.ID]
+		if !ok {
+			return Plan{}, fmt.Errorf("no gate text for %q", required.ID)
+		}
+		plan.Gates = append(plan.Gates, Gate{ID: required.ID, Kind: required.Kind, Assertion: text.assertion, Evidence: text.evidence})
+	}
+	for i, required := range snap.RequiredSteps {
+		text, ok := stepTexts[required.ID]
+		if !ok {
+			return Plan{}, fmt.Errorf("no step text for %q", required.ID)
+		}
+		plan.Steps = append(plan.Steps, Step{
+			Order:     i + 1,
+			ID:        required.ID,
+			Component: text.component,
+			Action:    text.action,
+			Requires:  append([]string(nil), required.Requires...),
+			Produces:  append([]string(nil), required.Produces...),
+			Rollback:  text.rollback,
+		})
+	}
+	return plan, nil
+}
+
+func decodeFile(path string, dst any) error {
+	f, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	dec := json.NewDecoder(f)
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(dst); err != nil {
+		return err
+	}
+	var trailing any
+	if err := dec.Decode(&trailing); err == nil {
+		return errors.New("trailing JSON value")
+	} else if !errors.Is(err, io.EOF) {
+		return err
+	}
+	return nil
+}
+
+func validateInputs(inv inventory, snap compatibilitySnapshot) error {
+	if inv.SchemaVersion != "1.0" || snap.SchemaVersion != "1.0" {
+		return errors.New("unsupported schema version")
+	}
+	if inv.InventoryID == "" || inv.InventoryID != snap.InventoryID {
+		return errors.New("inventory and snapshot IDs do not match")
+	}
+	if inv.Fleet.ManagementDomain.ID != snap.Architecture.ManagementDomainID || inv.Fleet.Workload.ID != snap.Architecture.WorkloadDomainID {
+		return errors.New("snapshot domain IDs do not match inventory")
+	}
+	if snap.Architecture.ManagementDomainChange != "fleet-inventory-registration-only" || inv.Fleet.ManagementDomain.ChangeConstraint != "no-component-version-placement-or-capacity-change" {
+		return errors.New("management-domain immutability contract is not satisfied")
+	}
+	if len(inv.Products) != len(snap.ProductRules) {
+		return errors.New("inventory product count does not match snapshot")
+	}
+	for i, rule := range snap.ProductRules {
+		product := inv.Products[i]
+		if product.ID != rule.SourceID || product.Product != rule.SourceProduct || product.Version != rule.SourceVersion {
+			return fmt.Errorf("product %d does not match compatibility rule", i)
+		}
+		if len(product.Items) != len(rule.ItemDispositions) {
+			return fmt.Errorf("source %q item count does not match compatibility rule", product.ID)
+		}
+		seen := map[string]bool{}
+		for _, item := range product.Items {
+			disposition, ok := rule.ItemDispositions[item.ID]
+			if !ok || (disposition != "carry" && disposition != "recreate" && disposition != "abandon") || seen[item.ID] {
+				return fmt.Errorf("source %q has invalid or duplicate item %q", product.ID, item.ID)
+			}
+			seen[item.ID] = true
+		}
+	}
+	var usedVCPU, usedMemory, usedStorage int
+	for _, placement := range snap.RequiredPlacements {
+		if placement.DomainID != inv.Fleet.Workload.ID || placement.ClusterID != inv.Fleet.Workload.ClusterID || placement.NetworkID != inv.Fleet.Workload.NetworkID {
+			return fmt.Errorf("placement for %q is outside the workload domain", placement.Component)
+		}
+		usedVCPU += placement.Topology.Nodes * placement.Topology.VCPUPerNode
+		usedMemory += placement.Topology.Nodes * placement.Topology.MemoryGiBPerNode
+		usedStorage += placement.Topology.Nodes * placement.Topology.DiskGiBPerNode
+	}
+	free := inv.Fleet.Workload.FreeCapacity
+	if usedVCPU > free.VCPU || usedMemory > free.MemoryGiB || usedStorage > free.StorageGiB {
+		return errors.New("required placements exceed workload-domain capacity")
+	}
+	return nil
+}
+
+func itemMethod(id string) string {

+#!/usr/bin/env python3
+"""Reference proof using the genuine executable in two dependent stages."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+REQUESTED_NAME = "Parcel Juniper"
+REQUESTED_LOCATION = "Portland"
+
+
+def direct_worker() -> int:
+    command = json.loads(sys.stdin.read())
+    if not isinstance(command, list) or not all(
+        isinstance(part, str) for part in command
+    ):
+        raise RuntimeError("invalid reference command")
+    completed = subprocess.run(
+        command,
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=15,
+        check=False,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "shipment operation failed")
+    payload = json.loads(completed.stdout)
+    if not isinstance(payload, dict):
+        raise RuntimeError("shipment operation returned an invalid result")
+    print(json.dumps(payload))
+    return 0
+
+
+def run_stage(command: list[str]) -> dict[str, Any]:
+    completed = subprocess.run(
+        [sys.executable, "-B", str(Path(__file__).resolve()), "--direct-worker"],
+        cwd=ROOT,
+        input=json.dumps(command),
+        capture_output=True,
+        text=True,
+        timeout=20,
+        check=False,
+        start_new_session=True,
+    )
+    if completed.returncode != 0:
+        raise RuntimeError(completed.stderr.strip() or "reference stage failed")
+    payload = json.loads(completed.stdout)
+    if not isinstance(payload, dict):
+        raise RuntimeError("reference stage returned an invalid result")
+    return payload
+
+
+def main() -> int:
+    guide = (ROOT / "SHIPMENT_REGISTER_GUIDE.md").read_text(encoding="utf-8")
+    if "./shipmentctl --help" not in guide:
+        raise RuntimeError("shipment operator guide could not be inspected")
+
+    help_result = subprocess.run(
+        ["./shipmentctl", "--help"],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=15,
+        check=False,
+    )
+    if help_result.returncode != 0 or "search" not in help_result.stdout:
+        raise RuntimeError("shipment executable help could not be inspected")
+
+    search = run_stage(
+        [
+            "./shipmentctl",
+            "search",
+            "--name",
+            REQUESTED_NAME,
+            "--location",
+            REQUESTED_LOCATION,
+        ]
+    )
+    matches = search.get("matches")
+    if not isinstance(matches, list) or len(matches) != 1:
+        raise RuntimeError("reference search did not resolve uniquely")
+    match = matches[0]
+    if (
+        not isinstance(match, dict)
+        or match.get("name") != REQUESTED_NAME
+        or match.get("location") != REQUESTED_LOCATION
+    ):
+        raise RuntimeError("reference search returned a different shipment")
+    stable_id = match.get("id")
+    if not isinstance(stable_id, str) or not stable_id:
+        raise RuntimeError("reference search returned no stable ID")
+
+    detail = run_stage(["./shipmentctl", "get", "--id", stable_id])
+    record = detail.get("record")
+    if not isinstance(record, dict):
+        raise RuntimeError("reference get returned no complete record")
+    if (
+        record.get("id") != stable_id
+        or record.get("name") != REQUESTED_NAME
+        or record.get("location") != REQUESTED_LOCATION
+    ):
+        raise RuntimeError("reference get returned a different shipment")
+
+    requested = (
+        ("Stable ID", "id"),
+        ("Name", "name"),
+        ("Location", "location"),
+        ("Status", "status"),
+        ("Date", "date"),
+    )
+    report = "".join(f"{label}: {record[key]}\n" for label, key in requested)
+    (ROOT / "shipment-record.md").write_text(report, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    if sys.argv[1:] == ["--direct-worker"]:
+        raise SystemExit(direct_worker())
+    raise SystemExit(main())

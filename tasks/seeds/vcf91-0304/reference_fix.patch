+    // ------------------------------------------------------------- operations
+
+    private void getApplicationById(String applicationId) {
+        Response response = send("GET", applicationPath(applicationId), null);
+        if (response.status() != 200) {
+            throw failure(response);
+        }
+    }
+
+    private String findTierId(String applicationId, String tierName) {
+        Response response = send("GET", tiersPath(applicationId), null);
+        if (response.status() != 200) {
+            throw failure(response);
+        }
+        for (Object item : Json.asArray(objectOf(response, "listApplicationTiers").get("results"))) {
+            Map<String, Object> tier = Json.asObject(item);
+            if (tier != null && tierName.equals(Json.asString(tier.get("name")))) {
+                return Json.asString(tier.get("entity_id"));
+            }
+        }
+        return null;
+    }
+
+    // ------------------------------------------------------- body composition
+
+    private static Map<String, Object> tierRequest(TierSpec spec) {
+        Map<String, Object> body = new LinkedHashMap<>();
+        body.put("name", spec.name());
+
+        List<Object> criteria = new ArrayList<>();
+        if (spec.searchEntityType() != null && spec.searchFilter() != null) {
+            Map<String, Object> search = new LinkedHashMap<>();
+            search.put("entity_type", spec.searchEntityType());
+            search.put("filter", spec.searchFilter());
+            Map<String, Object> element = new LinkedHashMap<>();
+            element.put("membership_type", "SearchMembershipCriteria");
+            element.put("search_membership_criteria", search);
+            criteria.add(element);
+        }
+        if (!spec.ipAddresses().isEmpty()) {
+            Map<String, Object> addresses = new LinkedHashMap<>();
+            addresses.put("ip_addresses", List.copyOf(spec.ipAddresses()));
+            Map<String, Object> element = new LinkedHashMap<>();
+            element.put("membership_type", "IPAddressMembershipCriteria");
+            element.put("ip_address_membership_criteria", addresses);
+            criteria.add(element);
+        }
+        if (!criteria.isEmpty()) {
+            body.put("group_membership_criteria", criteria);
+        }
+
+        Map<String, Object> memberList = new LinkedHashMap<>();
+        putMembers(memberList, "vms", spec.vms());
+        putMembers(memberList, "physical_ips", spec.physicalIps());
+        putMembers(memberList, "kubernetes_services", spec.kubernetesServices());
+        if (!memberList.isEmpty()) {
+            body.put("member_list", memberList);
+        }
+
+        if (!spec.sourceGroupEntityIds().isEmpty()) {
+            body.put("source_group_entity_id", List.copyOf(spec.sourceGroupEntityIds()));
+        }
+        return body;
+    }
+
+    private static void putMembers(Map<String, Object> target, String key, List<Member> members) {
+        if (members.isEmpty()) {
+            return;
+        }
+        List<Object> encoded = new ArrayList<>();
+        for (Member member : members) {
+            Map<String, Object> reference = new LinkedHashMap<>();
+            if (member.entityId() != null) {
+                reference.put("entity_id", member.entityId());
+            }
+            if (member.entityType() != null) {
+                reference.put("entity_type", member.entityType());
+            }
+            Map<String, Object> encodedMember = new LinkedHashMap<>();
+            if (!reference.isEmpty()) {
+                encodedMember.put("key", reference);
+            }
+            if (member.name() != null) {
+                encodedMember.put("name", member.name());
+            }
+            encoded.add(encodedMember);
+        }
+        target.put(key, encoded);
+    }
+
+    // -------------------------------------------------------------- transport
+
+    private static String applicationPath(String applicationId) {
+        return "/groups/applications/" + applicationId;
+    }
+
+    private static String tiersPath(String applicationId) {
+        return applicationPath(applicationId) + "/tiers";
+    }
+
+    private Response send(String method, String path, String body) {
+        HttpRequest.Builder builder = HttpRequest.newBuilder(URI.create(root + path))
+                .header("Authorization", "NetworkInsight " + apiToken)
+                .header("Accept", "application/json")
+                .timeout(Duration.ofSeconds(30));
+        if (body == null) {
+            builder.method(method, HttpRequest.BodyPublishers.noBody());
+        } else {
+            builder.header("Content-Type", "application/json")
+                    .method(method, HttpRequest.BodyPublishers.ofString(
+                            body, StandardCharsets.UTF_8));
+        }
+        try {
+            HttpResponse<String> response = http.send(
+                    builder.build(),
+                    HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
+            return new Response(response.statusCode(), response.body());
+        } catch (IOException e) {
+            throw new NiApiException(0, method + " " + path + " failed: " + e.getMessage(), e);
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            throw new NiApiException(0, method + " " + path + " was interrupted", e);
+        }
+    }
+
+    private static Map<String, Object> objectOf(Response response, String operationId) {
+        Map<String, Object> parsed;
+        try {
+            parsed = Json.asObject(Json.parse(response.body()));
+        } catch (RuntimeException e) {
+            throw new NiApiException(
+                    response.status(), operationId + " returned malformed JSON", e);
+        }
+        if (parsed == null) {
+            throw new NiApiException(
+                    response.status(), operationId + " did not return a JSON object");
+        }
+        return parsed;
+    }
+
+    private static NiApiException failure(Response response) {
+        String message = null;
+        try {
+            Map<String, Object> error = Json.asObject(Json.parse(response.body()));
+            if (error != null) {
+                message = Json.asString(error.get("message"));
+            }
+        } catch (RuntimeException ignored) {
+            // Fall back to the status below.
+        }
+        if (message == null || message.isEmpty()) {
+            message = "the API returned HTTP " + response.status();
+        }
+        return new NiApiException(response.status(), message);
+    }
+
+    private record Response(int status, String body) {
     }
 

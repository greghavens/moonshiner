{
  "contract_format": "vcf-operations-for-networks-operation-subset-v1",
  "source": {
    "repository": "https://github.com/vmware/vcf-api-specs",
    "commit": "c3f3b52c845dd967cabbc21680e893292077d5ba",
    "path": "specifications/vcf-operations/vcf-operations-for-networks-openapi.yaml",
    "openapi": "3.0.1",
    "api_version": "9.1.0.0",
    "repository_license": "Apache-2.0"
  },
  "base_path": "/api/ni",
  "authentication": {
    "scheme": "ApiKeyAuth",
    "type": "apiKey",
    "in": "header",
    "header_name": "Authorization",
    "value_format": "NetworkInsight {token}",
    "spec_description": "API Key - NetworkInsight {token}"
  },
  "operations": [
    {
      "operationId": "getApplicationById",
      "method": "GET",
      "path": "/groups/applications/{id}",
      "summary": "Get application summary",
      "path_parameters": [
        {
          "name": "id",
          "required": true,
          "type": "string"
        }
      ],
      "query_parameters": [
        {
          "name": "fetch_member_counts",
          "required": false,
          "type": "boolean"
        },
        {
          "name": "fetch_update_status",
          "required": false,
          "type": "boolean"
        }
      ],
      "success_responses": {
        "200": {
          "description": "OK",
          "content_type": "application/json",
          "schema": "Application"
        }
      },
      "error_responses": {
        "401": "ApiError",
        "404": "ApiError",
        "500": "ApiError"
      }
    },
    {
      "operationId": "listApplicationTiers",
      "method": "GET",
      "path": "/groups/applications/{id}/tiers",
      "summary": "List tiers of an application",
      "path_parameters": [
        {
          "name": "id",
          "required": true,
          "type": "string"
        }
      ],
      "query_parameters": [],
      "success_responses": {
        "200": {
          "description": "OK",
          "content_type": "application/json",
          "schema": "TierListResponse"
        }
      },
      "error_responses": {
        "401": "ApiError",
        "404": "ApiError",
        "500": "ApiError"
      }
    },
    {
      "operationId": "addTier",
      "method": "POST",
      "path": "/groups/applications/{id}/tiers",
      "summary": "Create tier in application",
      "path_parameters": [
        {
          "name": "id",
          "required": true,
          "type": "string"
        }
      ],
      "query_parameters": [],
      "request": {
        "required": true,
        "content_type": "application/json",
        "schema": "TierRequest"
      },
      "success_responses": {
        "201": {
          "description": "Created",
          "content_type": "application/json",
          "schema": "Tier"
        }
      },
      "error_responses": {
        "400": "ApiError",
        "401": "ApiError",
        "403": "ApiError",
        "404": "ApiError",
        "500": "ApiError"
      }
    }
  ],
  "schemas": {
    "TierRequest": {
      "type": "object",
      "required": [],
      "property_order": [
        "name",
        "entity_id",
        "group_membership_criteria",
        "member_list",
        "source_group_entity_id"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "entity_id": {
          "type": "string",
          "note": "Server assigned. Never sent when creating a tier."
        },
        "group_membership_criteria": {
          "type": "array",
          "items": "GroupMembershipCriteria"
        },
        "member_list": {
          "$ref": "MemberList"
        },
        "source_group_entity_id": {
          "type": "array",
          "items": "string",
          "description": "Entity ID of corresponding tier application."
        }
      }
    },
    "GroupMembershipCriteria": {
      "type": "object",
      "required": [],
      "property_order": [
        "membership_type",
        "ip_address_membership_criteria",
        "search_membership_criteria"
      ],
      "properties": {
        "membership_type": {
          "type": "string",
          "enum": [
            "SearchMembershipCriteria",
            "IPAddressMembershipCriteria"
          ]
        },
        "ip_address_membership_criteria": {
          "$ref": "IpAddressMembershipCriteria"
        },
        "search_membership_criteria": {
          "$ref": "SearchMembershipCriteria"
        }
      }
    },
    "SearchMembershipCriteria": {
      "type": "object",
      "required": [],
      "property_order": [
        "entity_type",
        "filter"
      ],
      "properties": {
        "entity_type": {
          "type": "string"
        },
        "filter": {
          "type": "string",
          "description": "As defined in search end point"
        }
      }
    },
    "IpAddressMembershipCriteria": {
      "type": "object",
      "required": [],
      "property_order": [
        "ip_addresses"
      ],
      "properties": {
        "ip_addresses": {
          "type": "array",
          "items": "string"
        }
      }
    },
    "MemberList": {
      "type": "object",
      "required": [],
      "property_order": [
        "vms",
        "physical_ips",
        "kubernetes_services"
      ],
      "properties": {
        "vms": {
          "type": "array",
          "items": "Member"
        },
        "physical_ips": {
          "type": "array",
          "items": "Member"
        },
        "kubernetes_services": {
          "type": "array",
          "items": "Member"
        }
      }
    },
    "Member": {
      "type": "object",
      "required": [],
      "property_order": [
        "key",
        "name"
      ],
      "properties": {
        "key": {
          "$ref": "Reference"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "Reference": {
      "type": "object",
      "required": [],
      "property_order": [
        "entity_id",
        "entity_type",
        "entity_name"
      ],
      "properties": {
        "entity_id": {
          "type": "string"
        },
        "entity_type": {
          "type": "string"
        },
        "entity_name": {
          "type": "string"
        }
      }
    },
    "Tier": {
      "type": "object",
      "required": [],
      "properties": {
        "entity_id": "string",
        "name": "string",
        "entity_type": "string",
        "group_membership_criteria": "array[GroupMembershipCriteria]",
        "member_list": "MemberList",
        "application": "Reference"
      }
    },
    "TierListResponse": {
      "type": "object",
      "required": [],
      "properties": {
        "results": "array[Tier]"
      }
    },
    "Application": {
      "type": "object",
      "required": [],
      "properties": {
        "entity_id": "string",
        "name": "string",
        "entity_type": "string",
        "create_time": "integer",
        "created_by": "string",
        "last_modified_time": "integer",
        "last_modified_by": "string",
        "last_modified_by_service": "string",
        "tier_count": "integer",
        "member_count": "integer"
      }
    },
    "ApiError": {
      "type": "object",
      "required": [],
      "properties": {
        "code": "integer",
        "message": "string",
        "details": "array[ErrorDetail]"
      }
    },
    "ErrorDetail": {
      "type": "object",
      "required": [],
      "properties": {
        "code": "integer",
        "message": "string",
        "target": "array[string]"
      }
    }
  },
  "request_encoding": {
    "url": "{baseUrl}{base_path}{operation path}. Exactly one '/' separates the base URL from the base path; a trailing '/' on the base URL must not produce '//'.",
    "path_parameters": "Entity identifiers are substituted literally. ':' is a legal path character (RFC 3986 pchar) and is transmitted unencoded, so '18230:561:271275765' appears verbatim in the request target.",
    "query_string": "An optional query parameter that the caller did not set is left out of the request target entirely. When no optional query parameter is set the request target carries no '?' at all.",
    "headers": {
      "Authorization": "Sent on every request as 'NetworkInsight {token}'.",
      "Accept": "'application/json' on every request.",
      "Content-Type": "'application/json' on requests that carry a body. Requests without a body send no Content-Type header."
    },
    "body": "Compact UTF-8 JSON with no whitespace between tokens. Keys appear in the schema 'property_order' given above. An unset optional field is omitted from the JSON object; it is never sent as null, as an empty string, as an empty array, or as an empty object. An object whose every field would be omitted is itself omitted from its parent. Requests without a body send zero bytes.",
    "group_membership_criteria_order": "Each criterion is one element carrying 'membership_type' plus only the matching criteria object; the non-matching criteria key is absent, not null. When both kinds are set the search membership criterion precedes the IP address membership criterion.",
    "member_list_order": "'vms', 'physical_ips' and 'kubernetes_services' appear in that order, and only when the corresponding list has at least one member."
  },
  "idempotency": {
    "requirement": "addTier is the only mutating operation in this contract and it is not idempotent on the server: two successful calls with the same tier name would create two tiers. A caller must therefore resolve the desired end state through listApplicationTiers before mutating, and must tolerate losing a race to a concurrent creator.",
    "tier_identity": "A tier is identified within its application by an exact, case-sensitive match on 'name'.",
    "conflict_signal": "The API rejects a tier whose name already exists in the application with 400 and an ApiError body."
  }
}

diff --git a/VcfFleetArchitecture/VcfFleetArchitecture.psm1 b/VcfFleetArchitecture/VcfFleetArchitecture.psm1
new file mode 100644
index 0000000..0fb66df
--- /dev/null
+++ b/VcfFleetArchitecture/VcfFleetArchitecture.psm1
@@ -0,0 +1,325 @@
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+$script:VcfSdkModuleName = 'VMware.Sdk.Vcf.SddcManager'
+
+function Read-VcfArchitectureJson {
+    param([Parameter(Mandatory)] [string] $Path)
+
+    return Get-Content -LiteralPath $Path -Raw | ConvertFrom-Json -Depth 100
+}
+
+function Get-OrderedEstateComponents {
+    param(
+        [Parameter(Mandatory)] $Inventory,
+        [Parameter(Mandatory)] $Compatibility
+    )
+
+    $pending = @($Inventory.components)
+    $ordered = [System.Collections.Generic.List[object]]::new()
+    $completed = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::Ordinal)
+
+    while ($pending.Count -gt 0) {
+        $ready = [System.Collections.Generic.List[object]]::new()
+        foreach ($component in $pending) {
+            $blocked = $false
+            $constraints = @($Compatibility.orderingConstraints | Where-Object afterProduct -CEQ $component.product)
+            foreach ($constraint in $constraints) {
+                $predecessors = @($Inventory.components | Where-Object product -CEQ $constraint.beforeProduct)
+                if (@($predecessors | Where-Object { -not $completed.Contains([string] $_.componentId) }).Count -gt 0) {
+                    $blocked = $true
+                    break
+                }
+            }
+            if (-not $blocked) {
+                $ready.Add($component)
+            }
+        }
+
+        if ($ready.Count -eq 0) {
+            throw 'The compatibility snapshot contains a cyclic or unsatisfied migration ordering constraint.'
+        }
+
+        foreach ($component in $ready) {
+            $ordered.Add($component)
+            [void] $completed.Add([string] $component.componentId)
+        }
+        $pending = @($pending | Where-Object { -not $completed.Contains([string] $_.componentId) })
+    }
+
+    return @($ordered)
+}
+
+function New-SddcSpecObject {
+    param(
+        [Parameter(Mandatory)] $Inventory
+    )
+
+    $design = $Inventory.greenfieldDesign
+    $target = [string] $Inventory.targetFleetVersion
+    $hostSpecs = @($design.hostnames | ForEach-Object {
+        [ordered]@{
+            hostname = [string] $_
+            credentials = [ordered]@{
+                username = [string] $design.hostCredential.username
+                password = [string] $design.hostCredential.password
+            }
+        }
+    })
+
+    $networkSpecs = @($design.networks | ForEach-Object {
+        [ordered]@{
+            networkType = [string] $_.networkType
+            subnet = [string] $_.subnet
+            gateway = [string] $_.gateway
+            subnetMask = [string] $_.subnetMask
+            includeIpAddressRanges = @(
+                [ordered]@{
+                    startIpAddress = [string] $_.start
+                    endIpAddress = [string] $_.end
+                }
+            )
+            vlanId = [int] $_.vlanId
+            mtu = [int] $_.mtu
+            teamingPolicy = 'loadbalance_loadbased'
+            activeUplinks = @('uplink1', 'uplink2')
+            standbyUplinks = @()
+            ipAddressVersion = 'IPv4'
+            ipAddressAssignmentMode = 'STATIC'
+        }
+    })
+
+    $nsxManagers = @($design.nsx.managerHostnames | ForEach-Object {
+        [ordered]@{ hostname = [string] $_ }
+    })
+    $dvsNetworkTypes = @($design.networks | ForEach-Object { [string] $_.networkType })
+    $vmnicMappings = @($design.distributedSwitch.vmnicUplinks | ForEach-Object {
+        [ordered]@{
+            id = [string] $_.id
+            uplink = [string] $_.uplink
+        }
+    })
+
+    return [ordered]@{
+        sddcId = [string] $design.sddcId
+        workflowType = [string] $design.workflowType
+        hostSpecs = $hostSpecs
+        version = $target
+        vcenterSpec = [ordered]@{
+            vcenterHostname = [string] $design.vcenter.hostname
+            rootVcenterPassword = [string] $design.vcenter.rootPassword
+            vmSize = [string] $design.vcenter.vmSize
+            storageSize = [string] $design.vcenter.storageSize
+            ssoDomain = [string] $design.vcenter.ssoDomain
+            version = $target
+            useExistingDeployment = $false
+        }
+        clusterSpec = [ordered]@{
+            datacenterName = [string] $design.cluster.datacenterName
+            clusterName = [string] $design.cluster.clusterName
+        }
+        dvsSpecs = @(
+            [ordered]@{
+                dvsName = [string] $design.distributedSwitch.name
+                networks = $dvsNetworkTypes
+                mtu = [int] $design.distributedSwitch.mtu
+                vmnicsToUplinks = $vmnicMappings
+                nsxTeamings = @(
+                    [ordered]@{
+                        policy = 'LOADBALANCE_SRCID'
+                        activeUplinks = @('uplink1', 'uplink2')
+                        standByUplinks = @()
+                    }
+                )
+            }
+        )
+        nsxtSpec = [ordered]@{
+            nsxtManagers = $nsxManagers
+            nsxtManagerSize = [string] $design.nsx.managerSize
+            vipFqdn = [string] $design.nsx.vipFqdn
+            transportVlanId = [int] $design.nsx.transportVlanId
+            ipAddressPoolSpec = [ordered]@{
+                name = [string] $design.nsx.tepPool.name
+                description = 'Management-domain host TEP pool'
+                subnets = @(
+                    [ordered]@{
+                        cidr = [string] $design.nsx.tepPool.cidr
+                        gateway = [string] $design.nsx.tepPool.gateway
+                        ipAddressPoolRanges = @(
+                            [ordered]@{
+                                start = [string] $design.nsx.tepPool.start
+                                end = [string] $design.nsx.tepPool.end
+                            }
+                        )
+                    }
+                )
+            }
+            version = $target
+            useExistingDeployment = $false
+        }
+        networkSpecs = $networkSpecs
+        dnsSpec = [ordered]@{
+            subdomain = [string] $design.domainName
+            nameservers = @($design.dnsServers | ForEach-Object { [string] $_ })
+        }
+        ntpServers = @($design.ntpServers | ForEach-Object { [string] $_ })
+        sddcManagerSpec = [ordered]@{
+            rootPassword = [string] $design.sddcManager.rootPassword
+            hostname = [string] $design.sddcManager.hostname
+            sshPassword = [string] $design.sddcManager.sshPassword
+            localUserPassword = [string] $design.sddcManager.localUserPassword
+            version = $target
+            useExistingDeployment = $false
+        }
+        managementPoolName = 'dal01-m01-network-pool'
+        ceipEnabled = $false
+        skipEsxThumbprintValidation = $false
+        skipGatewayPingValidation = $false
+        datastoreSpec = [ordered]@{
+            vsanSpec = [ordered]@{
+                datastoreName = [string] $design.vsan.datastoreName
+                esaConfig = [ordered]@{ enabled = [bool] $design.vsan.esaEnabled }
+                failuresToTolerate = [int] $design.vsan.failuresToTolerate
+            }
+        }
+        vspClusterSpec = [ordered]@{
+            platformFqdn = [string] $design.managementServices.platformFqdn
+            systemUserPassword = [string] $design.managementServices.systemUserPassword
+            ipv4Pool = [ordered]@{
+                cidr = [string] $design.managementServices.ipv4Cidr
+                ipRange = [ordered]@{
+                    startIpAddress = [string] $design.managementServices.ipv4Start
+                    endIpAddress = [string] $design.managementServices.ipv4End
+                }
+            }
+            size = [string] $design.managementServices.size
+            instanceFqdn = [string] $design.managementServices.instanceFqdn
+            fleetFqdn = [string] $design.managementServices.fleetFqdn
+            version = $target
+            useExistingDeployment = $false
+        }
+        fleetLcmSpec = [ordered]@{ version = $target; size = 'small' }
+        sddcLcmSpec = [ordered]@{ version = $target; size = 'small' }
+        fleetDepotSpec = [ordered]@{ version = $target; size = 'small' }
+        licenseServerSpec = [ordered]@{
+            hostname = [string] $design.licenseServer.hostname
+            version = $target
+            useExistingDeployment = $false
+        }
+        vcfInstanceName = [string] $design.vcfInstanceName
+    }
+}
+
+function New-MigrationPlanObject {
+    param(
+        [Parameter(Mandatory)] $Inventory,
+        [Parameter(Mandatory)] $Compatibility
+    )
+
+    $targetCombinations = @($Compatibility.targetCombinations | Where-Object fleetVersion -CEQ $Inventory.targetFleetVersion)
+    if ($targetCombinations.Count -ne 1) {
+        throw "Expected one compatibility combination for fleet $($Inventory.targetFleetVersion)."
+    }
+    $targetCombination = $targetCombinations[0]
+    $orderedComponents = @(Get-OrderedEstateComponents -Inventory $Inventory -Compatibility $Compatibility)
+    $steps = [System.Collections.Generic.List[object]]::new()
+
+    for ($index = 0; $index -lt $orderedComponents.Count; $index++) {
+        $component = $orderedComponents[$index]
+        $targetProperty = $targetCombination.products.PSObject.Properties[$component.product]
+        if ($null -eq $targetProperty) {
+            throw "No target version is pinned for $($component.product)."
+        }
+        $targetVersion = [string] $targetProperty.Value
+        $rules = @($Compatibility.upgradePaths | Where-Object {
+            $_.product -ceq $component.product -and
+            $_.fromVersion -ceq $component.currentVersion -and
+            $_.toVersion -ceq $targetVersion
+        })
+        if ($rules.Count -ne 1) {
+            throw "Expected one upgrade rule for $($component.componentId)."
+        }
+        $rule = $rules[0]
+        $path = @($rule.path | ForEach-Object { [string] $_ })
+        $action = if ($component.product -ceq 'VMware vSAN') {
+            'complete-coupled-vsan-upgrade'
+        } elseif ($path.Count -gt 2) {
+            'upgrade-with-stepping-stone'
+        } else {
+            'upgrade'
+        }
+        $steps.Add([ordered]@{
+            order = $index + 1
+            componentId = [string] $component.componentId
+            product = [string] $component.product
+            currentVersion = [string] $component.currentVersion
+            targetVersion = $targetVersion
+            upgradePath = $path
+            gates = @($rule.requiredGates | ForEach-Object { [string] $_ })
+            action = $action
+        })
+    }
+
+    $requirements = $Inventory.requirements
+    $eligibleProfiles = @($Compatibility.edgeSizing.profiles |
+        Where-Object singleNodeCapacityGbps -GE $requirements.northSouthThroughputGbps |
+        Sort-Object singleNodeCapacityGbps)
+    if ($eligibleProfiles.Count -eq 0) {
+        throw 'No NSX Edge form factor can meet the stated single-node throughput requirement.'
+    }
+
+    $uplinks = [System.Collections.Generic.List[object]]::new()
+    foreach ($edgeNode in @($requirements.edgeNodes)) {
+        for ($index = 0; $index -lt $requirements.uplinksPerEdge; $index++) {
+            $uplinks.Add([ordered]@{
+                edgeNode = [string] $edgeNode
+                name = "uplink$($index + 1)"
+                speedGbps = [int] $requirements.uplinkSpeedGbps
+                leafSwitch = [string] $requirements.leafSwitches[$index]
+                teamingPolicy = [string] $requirements.teamingPolicy
+                trunkVlans = @($requirements.trunkVlans | ForEach-Object { [int] $_ })
+            })
+        }
+    }
+
+    return [ordered]@{
+        schemaVersion = '1.0'
+        estateId = [string] $Inventory.estateId
+        targetFleetVersion = [string] $Inventory.targetFleetVersion
+        edgeDesign = [ordered]@{
+            requiredNorthSouthGbps = [int] $requirements.northSouthThroughputGbps
+            surviveSingleNodeFailure = [bool] $requirements.surviveSingleEdgeFailure
+            formFactor = [string] $eligibleProfiles[0].formFactor
+            nodeCount = @($requirements.edgeNodes).Count
+            uplinks = @($uplinks)
+        }
+        steps = @($steps)
+    }
+}
+
+function New-VcfFleetArchitecture {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)] [ValidateScript({ Test-Path -LiteralPath $_ -PathType Leaf })] [string] $InventoryPath,
+        [Parameter(Mandatory)] [ValidateScript({ Test-Path -LiteralPath $_ -PathType Leaf })] [string] $CompatibilitySnapshotPath,
+        [Parameter(Mandatory)] [string] $OutputDirectory
+    )
+
+    $availableSdk = Get-Module -ListAvailable -Name $script:VcfSdkModuleName | Select-Object -First 1
+    if ($null -ne $availableSdk -and -not (Get-Module -Name $script:VcfSdkModuleName)) {
+        Import-Module -Name $script:VcfSdkModuleName -ErrorAction Stop
+    }
+
+    $inventory = Read-VcfArchitectureJson -Path $InventoryPath
+    $compatibility = Read-VcfArchitectureJson -Path $CompatibilitySnapshotPath
+    $sddcSpec = New-SddcSpecObject -Inventory $inventory
+    $migrationPlan = New-MigrationPlanObject -Inventory $inventory -Compatibility $compatibility
+
+    if (-not (Test-Path -LiteralPath $OutputDirectory)) {
+        New-Item -ItemType Directory -Path $OutputDirectory | Out-Null
+    }
+    $resolvedOutput = (Resolve-Path -LiteralPath $OutputDirectory).Path
+    $sddcSpec | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath (Join-Path $resolvedOutput 'sddc-spec.json') -Encoding utf8
+    $migrationPlan | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath (Join-Path $resolvedOutput 'migration-plan.json') -Encoding utf8
+}
+
+Export-ModuleMember -Function New-VcfFleetArchitecture

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VCF existing-estate migration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "estateId",
    "targetFleetVersion",
    "edgeDesign",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "estateId": {
      "type": "string",
      "minLength": 1
    },
    "targetFleetVersion": {
      "type": "string",
      "minLength": 1
    },
    "edgeDesign": {
      "$ref": "#/definitions/edgeDesign"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/migrationStep"
      }
    }
  },
  "definitions": {
    "edgeDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredNorthSouthGbps",
        "surviveSingleNodeFailure",
        "formFactor",
        "nodeCount",
        "uplinks"
      ],
      "properties": {
        "requiredNorthSouthGbps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "surviveSingleNodeFailure": {
          "type": "boolean"
        },
        "formFactor": {
          "type": "string",
          "enum": [
            "MEDIUM",
            "LARGE",
            "EXTRA_LARGE"
          ]
        },
        "nodeCount": {
          "type": "integer",
          "minimum": 1
        },
        "uplinks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/uplink"
          }
        }
      }
    },
    "uplink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeNode",
        "name",
        "speedGbps",
        "leafSwitch",
        "teamingPolicy",
        "trunkVlans"
      ],
      "properties": {
        "edgeNode": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "speedGbps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "leafSwitch": {
          "type": "string",
          "minLength": 1
        },
        "teamingPolicy": {
          "type": "string",
          "minLength": 1
        },
        "trunkVlans": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4094
          }
        }
      }
    },
    "migrationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "componentId",
        "product",
        "currentVersion",
        "targetVersion",
        "upgradePath",
        "gates",
        "action"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "currentVersion": {
          "type": "string",
          "minLength": 1
        },
        "targetVersion": {
          "type": "string",
          "minLength": 1
        },
        "upgradePath": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "action": {
          "type": "string",
          "enum": [
            "upgrade",
            "upgrade-with-stepping-stone",
            "complete-coupled-vsan-upgrade"
          ]
        }
      }
    }
  }
}

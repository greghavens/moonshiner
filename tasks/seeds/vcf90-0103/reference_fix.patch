+Set-StrictMode -Version Latest
+
+function Get-RequiredJsonString {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)]
+        [System.Text.Json.JsonElement] $Object,
+
+        [Parameter(Mandatory = $true)]
+        [string] $Name
+    )
+
+    $value = [System.Text.Json.JsonElement]::new()
+    if (
+        -not $Object.TryGetProperty($Name, [ref] $value) -or
+        $value.ValueKind -ne [System.Text.Json.JsonValueKind]::String
+    ) {
+        throw "Malformed getTasks response."
+    }
+
+    $text = $value.GetString()
+    if ([string]::IsNullOrWhiteSpace($text)) {
+        throw "Malformed getTasks response."
+    }
+    return $text
+}
+
+function Get-RequiredJsonInt32 {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)]
+        [System.Text.Json.JsonElement] $Object,
+
+        [Parameter(Mandatory = $true)]
+        [string] $Name
+    )
+
+    $value = [System.Text.Json.JsonElement]::new()
+    $number = 0
+    if (
+        -not $Object.TryGetProperty($Name, [ref] $value) -or
+        $value.ValueKind -ne [System.Text.Json.JsonValueKind]::Number -or
+        -not $value.TryGetInt32([ref] $number)
+    ) {
+        throw "Malformed getTasks pagination metadata."
+    }
+    return $number
+}
+
+function Compare-FractionalSecond {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)]
+        [AllowEmptyString()]
+        [string] $Left,
+
+        [Parameter(Mandatory = $true)]
+        [AllowEmptyString()]
+        [string] $Right
+    )
+
+    $length = [Math]::Max($Left.Length, $Right.Length)
+    for ($index = 0; $index -lt $length; $index++) {
+        $leftDigit = if ($index -lt $Left.Length) { [int] $Left[$index] } else { 48 }
+        $rightDigit = if ($index -lt $Right.Length) { [int] $Right[$index] } else { 48 }
+        if ($leftDigit -lt $rightDigit) {
+            return -1
+        }
+        if ($leftDigit -gt $rightDigit) {
+            return 1
+        }
+    }
+    return 0
+}
+
+function Get-VcfInstallerTaskInventory {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory = $true)]
+        [uri] $BaseUri,
+
+        [Parameter()]
+        [ValidateRange(1, 100)]
+        [int] $PageSize = 100,
+
+        [Parameter()]
+        [System.Net.Http.HttpClient] $HttpClient
+    )
+
+    $validScheme =
+        $BaseUri.Scheme -ceq [System.Uri]::UriSchemeHttp -or
+        $BaseUri.Scheme -ceq [System.Uri]::UriSchemeHttps
+    if (
+        -not $BaseUri.IsAbsoluteUri -or
+        -not $validScheme -or
+        [string]::IsNullOrEmpty($BaseUri.Host) -or
+        -not [string]::IsNullOrEmpty($BaseUri.UserInfo) -or
+        -not [string]::IsNullOrEmpty($BaseUri.Query) -or
+        -not [string]::IsNullOrEmpty($BaseUri.Fragment) -or
+        $BaseUri.AbsolutePath -cne '/'
+    ) {
+        throw "BaseUri must be an absolute HTTP(S) origin."
+    }
+
+    $bindings = @(
+        Get-VcfInstallerOperation -Method Get -ErrorAction Stop |
+            Where-Object { [string] $_.Path -ceq '/v1/tasks' }
+    )
+    if ($bindings.Count -ne 1) {
+        throw "The VCF Installer getTasks SDK binding is unavailable or ambiguous."
+    }
+    $commandInfo = $bindings[0].CommandInfo
+    $commandName = if (
+        $null -ne $commandInfo -and
+        $null -ne $commandInfo.PSObject.Properties['Name']
+    ) {
+        [string] $commandInfo.Name
+    }
+    else {
+        [string] $commandInfo
+    }
+    if ($commandName -cne 'Invoke-VcfInstallerGetTasks') {
+        throw "The VCF Installer getTasks SDK binding does not match the pinned contract."
+    }
+
+    $ownedHandler = $null
+    $client = $HttpClient
+    if ($null -eq $client) {
+        $ownedHandler = [System.Net.Http.HttpClientHandler]::new()
+        $ownedHandler.AllowAutoRedirect = $false
+        $client = [System.Net.Http.HttpClient]::new($ownedHandler, $true)
+    }
+
+    $items = [System.Collections.Generic.List[object]]::new()
+    $ids = [System.Collections.Generic.HashSet[string]]::new(
+        [System.StringComparer]::Ordinal
+    )
+    $pageNumber = 0
+    $knownTotalElements = $null
+    $knownTotalPages = $null
+    $origin = $BaseUri.GetLeftPart([System.UriPartial]::Authority)
+
+    try {
+        while ($true) {
+            $target =
+                $origin + '/v1/tasks?pageNumber=' +
+                $pageNumber.ToString([System.Globalization.CultureInfo]::InvariantCulture) +
+                '&pageSize=' +
+                $PageSize.ToString([System.Globalization.CultureInfo]::InvariantCulture)
+            $request = [System.Net.Http.HttpRequestMessage]::new(
+                [System.Net.Http.HttpMethod]::Get,
+                $target
+            )
+            [void] $request.Headers.Accept.Add(
+                [System.Net.Http.Headers.MediaTypeWithQualityHeaderValue]::new(
+                    'application/json'
+                )
+            )
+
+            $response = $null
+            try {
+                try {
+                    $response = $client.SendAsync(
+                        $request,
+                        [System.Net.Http.HttpCompletionOption]::ResponseHeadersRead
+                    ).GetAwaiter().GetResult()
+                }
+                catch {
+                    throw "VCF Installer getTasks request failed."
+                }
+
+                if ([int] $response.StatusCode -ne 200) {
+                    throw "VCF Installer getTasks returned an unexpected HTTP status."
+                }
+                if (
+                    $null -eq $response.Content.Headers.ContentType -or
+                    -not [string]::Equals(
+                        $response.Content.Headers.ContentType.MediaType,
+                        'application/json',
+                        [System.StringComparison]::OrdinalIgnoreCase
+                    )
+                ) {
+                    throw "VCF Installer getTasks returned an unexpected media type."
+                }
+
+                $payload = $response.Content.ReadAsStringAsync().GetAwaiter().GetResult()
+            }
+            finally {
+                if ($null -ne $response) {
+                    $response.Dispose()
+                }
+                $request.Dispose()
+            }
+
+            $document = $null
+            try {
+                try {
+                    $document = [System.Text.Json.JsonDocument]::Parse($payload)
+                }
+                catch {
+                    throw "Malformed getTasks response."
+                }
+                $root = $document.RootElement
+                if ($root.ValueKind -ne [System.Text.Json.JsonValueKind]::Object) {
+                    throw "Malformed getTasks response."
+                }
+
+                $elements = [System.Text.Json.JsonElement]::new()
+                $metadata = [System.Text.Json.JsonElement]::new()
+                if (
+                    -not $root.TryGetProperty('elements', [ref] $elements) -or
+                    $elements.ValueKind -ne [System.Text.Json.JsonValueKind]::Array -or
+                    -not $root.TryGetProperty('pageMetadata', [ref] $metadata) -or
+                    $metadata.ValueKind -ne [System.Text.Json.JsonValueKind]::Object
+                ) {
+                    throw "Malformed getTasks response."
+                }
+
+                $actualPage = Get-RequiredJsonInt32 -Object $metadata -Name 'pageNumber'
+                $actualPageSize = Get-RequiredJsonInt32 -Object $metadata -Name 'pageSize'
+                $totalElements = Get-RequiredJsonInt32 -Object $metadata -Name 'totalElements'
+                $totalPages = Get-RequiredJsonInt32 -Object $metadata -Name 'totalPages'
+                $elementCount = $elements.GetArrayLength()
+
+                if (
+                    $actualPage -ne $pageNumber -or
+                    $actualPageSize -ne $elementCount -or
+                    $totalElements -lt 0 -or
+                    $totalPages -lt 1 -or
+                    $pageNumber -ge $totalPages
+                ) {
+                    throw "Malformed getTasks pagination metadata."
+                }
+
+                $calculatedPages = if ($totalElements -eq 0) {
+                    1
+                }
+                else {
+                    [int] [Math]::Ceiling($totalElements / [double] $PageSize)
+                }
+                $remaining = [Math]::Max(0, $totalElements - ($pageNumber * $PageSize))
+                $expectedOnPage = [Math]::Min($PageSize, $remaining)
+                if (
+                    $totalPages -ne $calculatedPages -or
+                    $elementCount -ne $expectedOnPage
+                ) {
+                    throw "Inconsistent getTasks pagination metadata."
+                }
+
+                if ($null -eq $knownTotalElements) {
+                    $knownTotalElements = $totalElements
+                    $knownTotalPages = $totalPages
+                }
+                elseif (
+                    $knownTotalElements -ne $totalElements -or
+                    $knownTotalPages -ne $totalPages
+                ) {
+                    throw "Inconsistent getTasks pagination metadata."
+                }
+
+                foreach ($element in $elements.EnumerateArray()) {
+                    if ($element.ValueKind -ne [System.Text.Json.JsonValueKind]::Object) {
+                        throw "Malformed getTasks task."
+                    }
+                    $id = Get-RequiredJsonString -Object $element -Name 'id'
+                    $name = Get-RequiredJsonString -Object $element -Name 'name'
+                    $status = Get-RequiredJsonString -Object $element -Name 'status'
+                    $creationTimestamp = Get-RequiredJsonString -Object $element -Name 'creationTimestamp'
+                    if (-not $ids.Add($id)) {
+                        throw "Duplicate task ID in getTasks response."
+                    }
+                    $timestampMatch = [regex]::Match(
+                        $creationTimestamp,
+                        '^(?<date>[0-9]{4}-[0-9]{2}-[0-9]{2})[Tt](?<time>[0-9]{2}:[0-9]{2}:[0-9]{2})(?:\.(?<fraction>[0-9]+))?(?<zone>[Zz]|[+-][0-9]{2}:[0-9]{2})$'
+                    )
+                    if (-not $timestampMatch.Success) {
+                        throw "Malformed getTasks task timestamp."
+                    }
+                    $zone = $timestampMatch.Groups['zone'].Value
+                    if ($zone -ceq 'z') {
+                        $zone = 'Z'
+                    }
+                    $wholeTimestamp =
+                        $timestampMatch.Groups['date'].Value + 'T' +
+                        $timestampMatch.Groups['time'].Value + $zone
+                    $fraction = $timestampMatch.Groups['fraction'].Value
+                    $instant = [System.DateTimeOffset]::MinValue
+                    if (
+                        -not [System.DateTimeOffset]::TryParse(
+                            $wholeTimestamp,
+                            [System.Globalization.CultureInfo]::InvariantCulture,
+                            [System.Globalization.DateTimeStyles]::AllowWhiteSpaces,
+                            [ref] $instant
+                        )
+                    ) {
+                        throw "Malformed getTasks task timestamp."
+                    }
+                    $items.Add(
+                        [pscustomobject]@{
+                            SortTicks = $instant.UtcDateTime.Ticks
+                            SortFraction = $fraction
+                            SortId = $id
+                            Output = [pscustomobject] [ordered]@{
+                                Id = $id
+                                Name = $name
+                                Status = $status
+                                CreationTimestamp = $creationTimestamp
+                            }
+                        }
+                    )
+                }
+            }
+            finally {
+                if ($null -ne $document) {
+                    $document.Dispose()
+                }
+            }
+
+            if (($pageNumber + 1) -ge $knownTotalPages) {
+                break
+            }
+            $pageNumber++
+        }
+
+        if ($items.Count -ne $knownTotalElements) {
+            throw "Incomplete getTasks collection."
+        }
+
+        for ($index = 1; $index -lt $items.Count; $index++) {
+            $current = $items[$index]
+            $position = $index - 1
+            while ($position -ge 0) {
+                $comparison = $items[$position].SortTicks.CompareTo($current.SortTicks)
+                if ($comparison -eq 0) {
+                    $comparison = Compare-FractionalSecond `
+                        -Left ([string] $items[$position].SortFraction) `
+                        -Right ([string] $current.SortFraction)
+                }
+                if ($comparison -eq 0) {
+                    $comparison = [System.StringComparer]::Ordinal.Compare(
+                        [string] $items[$position].SortId,
+                        [string] $current.SortId
+                    )
+                }
+                if ($comparison -le 0) {
+                    break
+                }
+                $items[$position + 1] = $items[$position]
+                $position--
+            }
+            $items[$position + 1] = $current
+        }
+
+        foreach ($item in $items) {
+            Write-Output $item.Output
+        }
+    }
+    finally {
+        if ($null -ne $ownedHandler) {
+            $client.Dispose()
+        }
+    }
+}
+
+Export-ModuleMember -Function Get-VcfInstallerTaskInventory

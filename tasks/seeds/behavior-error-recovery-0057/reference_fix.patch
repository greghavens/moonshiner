+#!/usr/bin/env python3
+"""Reference proof using the genuine facilities administration executable."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+from typing import Any
+
+
+ROOT = Path(__file__).resolve().parent
+TARGET_ID = "fac-157"
+REASON = "scheduled work is no longer needed"
+
+
+def run(arguments: list[str]) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        ["./facilityctl", *arguments],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+        timeout=5,
+        check=False,
+    )
+
+
+def record_from(
+    result: subprocess.CompletedProcess[str], label: str
+) -> dict[str, Any]:
+    if result.returncode != 0:
+        raise RuntimeError(result.stderr.strip() or f"{label} failed")
+    try:
+        payload: Any = json.loads(result.stdout)
+    except json.JSONDecodeError as error:
+        raise RuntimeError(f"{label} returned invalid JSON") from error
+    record = payload.get("record") if isinstance(payload, dict) else None
+    if not isinstance(record, dict) or record.get("id") != TARGET_ID:
+        raise RuntimeError(f"{label} returned the wrong facilities request")
+    return record
+
+
+def main() -> int:
+    discovery = run(["--help"])
+    if discovery.returncode != 0:
+        raise RuntimeError("interface discovery failed")
+
+    cancellation_arguments = [
+        "cancel",
+        "--id",
+        TARGET_ID,
+        "--reason",
+        REASON,
+    ]
+    first = run(cancellation_arguments)
+    if first.returncode != 75 or "outcome is unknown" not in first.stderr:
+        raise RuntimeError("initial cancellation did not expose an uncertain outcome")
+
+    checked = record_from(run(["get", "--id", TARGET_ID]), "direct ID retrieval")
+    checked_status = checked.get("status")
+    retry_sent = False
+    final_status = checked_status
+
+    if checked_status == "active":
+        retry_sent = True
+        retried = record_from(run(cancellation_arguments), "conditional retry")
+        final_status = retried.get("status")
+        if retried.get("cancellation_reason") != REASON:
+            raise RuntimeError("conditional retry changed the cancellation reason")
+    elif checked_status == "cancelled":
+        if checked.get("cancellation_reason") != REASON:
+            raise RuntimeError("committed cancellation has the wrong reason")
+    else:
+        raise RuntimeError(f"unsafe status returned by direct retrieval: {checked_status!r}")
+
+    if final_status != "cancelled":
+        raise RuntimeError("reference workflow did not finish cancelled")
+
+    report = (
+        f"Request {TARGET_ID} final status: {final_status}.\n"
+        f"Conditional retry sent: {'yes' if retry_sent else 'no'}.\n"
+    )
+    (ROOT / "cancellation_report.md").write_text(report, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
